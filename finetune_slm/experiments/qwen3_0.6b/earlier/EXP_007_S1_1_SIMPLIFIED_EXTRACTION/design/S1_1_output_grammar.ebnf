root ::= "{" "\"chief_complaint\":" str1 "," "\"symptoms\":" ("[" (r_symptoms_item ("," r_symptoms_item)*)? "]") "," "\"negative_findings\":" ("[" (r_negative_findings_item ("," r_negative_findings_item)*)? "]") "," "\"medical_history\":" ("[" (r_medical_history_item ("," r_medical_history_item)*)? "]") "," "\"surgical_history\":" ("[" (r_surgical_history_item ("," r_surgical_history_item)*)? "]") "," "\"family_history\":" ("[" (r_family_history_item ("," r_family_history_item)*)? "]") "," "\"social_history\":" ("[" (r_social_history_item ("," r_social_history_item)*)? "]") "," "\"medications\":" ("[" (r_medications_item ("," r_medications_item)*)? "]") "," "\"allergy_status\":" ("\"reported\"" | "\"none_stated\"" | "\"unknown\"" | "\"not_asked\"") "," "\"allergies\":" ("[" (r_allergies_item ("," r_allergies_item)*)? "]") "," "\"vital_signs\":" ("[" (r_vital_signs_item ("," r_vital_signs_item)*)? "]") "," "\"physical_examination\":" ("[" (r_physical_examination_item ("," r_physical_examination_item)*)? "]") "," "\"review_of_systems\":" ("[" (r_review_of_systems_item ("," r_review_of_systems_item)*)? "]") "," "\"clinical_assessment\":" ("[" (r_clinical_assessment_item ("," r_clinical_assessment_item)*)? "]") "," "\"investigations\":" ("[" (r_investigations_item ("," r_investigations_item)*)? "]") "," "\"procedures\":" ("[" (r_procedures_item ("," r_procedures_item)*)? "]") "," "\"clinical_actions\":" ("[" (r_clinical_actions_item ("," r_clinical_actions_item)*)? "]") "," "\"follow_up\":" ("[" (r_follow_up_item ("," r_follow_up_item)*)? "]") "}"
r_symptoms_item ::= "{" "\"name\":" str1 "," "\"status\":" ("\"present\"" | "\"resolved\"") ("," "\"duration\":" str)? "," "\"reported_by\":" ("\"doctor\"" | "\"patient\"" | "\"nurse\"" | "\"caregiver\"" | "\"family_member\"" | "\"clinical_staff\"" | "\"unknown\"") "}"
r_negative_findings_item ::= "{" "\"finding\":" str1 "," "\"reported_by\":" ("\"doctor\"" | "\"patient\"" | "\"nurse\"" | "\"caregiver\"" | "\"family_member\"" | "\"clinical_staff\"" | "\"unknown\"") "}"
r_medical_history_item ::= "{" "\"condition\":" str1 ("," "\"duration\":" str)? "," "\"reported_by\":" ("\"doctor\"" | "\"patient\"" | "\"nurse\"" | "\"caregiver\"" | "\"family_member\"" | "\"clinical_staff\"" | "\"unknown\"") "}"
r_surgical_history_item ::= "{" "\"procedure\":" str1 ("," "\"when\":" str)? "," "\"reported_by\":" ("\"doctor\"" | "\"patient\"" | "\"nurse\"" | "\"caregiver\"" | "\"family_member\"" | "\"clinical_staff\"" | "\"unknown\"") "}"
r_family_history_item ::= "{" "\"condition\":" str1 "," "\"relation\":" str1 "," "\"reported_by\":" ("\"doctor\"" | "\"patient\"" | "\"nurse\"" | "\"caregiver\"" | "\"family_member\"" | "\"clinical_staff\"" | "\"unknown\"") "}"
r_social_history_item ::= "{" "\"category\":" ("\"smoking\"" | "\"alcohol\"" | "\"occupation\"" | "\"exercise\"" | "\"diet\"" | "\"living\"") ("," "\"status\":" ("\"current\"" | "\"former\"" | "\"never\"" | "\"none\"" | "\"retired\""))? ("," "\"detail\":" str)? "," "\"reported_by\":" ("\"doctor\"" | "\"patient\"" | "\"nurse\"" | "\"caregiver\"" | "\"family_member\"" | "\"clinical_staff\"" | "\"unknown\"") "}"
r_medications_item ::= "{" "\"name\":" str1 ("," "\"dose\":" str)? ("," "\"route\":" str)? ("," "\"frequency\":" str)? "," "\"status\":" ("\"current\"" | "\"stopped\"" | "\"new\"") "," "\"reported_by\":" ("\"doctor\"" | "\"patient\"" | "\"nurse\"" | "\"caregiver\"" | "\"family_member\"" | "\"clinical_staff\"" | "\"unknown\"") "}"
r_allergies_item ::= "{" "\"substance\":" str1 ("," "\"reaction\":" str)? "," "\"reported_by\":" ("\"doctor\"" | "\"patient\"" | "\"nurse\"" | "\"caregiver\"" | "\"family_member\"" | "\"clinical_staff\"" | "\"unknown\"") "}"
r_vital_signs_item ::= "{" "\"name\":" ("\"blood pressure\"" | "\"pulse\"" | "\"temperature\"" | "\"respiratory rate\"" | "\"oxygen saturation\"" | "\"weight\"" | "\"height\"" | "\"BMI\"") "," "\"value\":" str1 ("," "\"unit\":" str)? "," "\"reported_by\":" ("\"doctor\"" | "\"patient\"" | "\"nurse\"" | "\"caregiver\"" | "\"family_member\"" | "\"clinical_staff\"" | "\"unknown\"") "}"
r_physical_examination_item ::= "{" "\"finding\":" str1 ("," "\"body_site\":" str)? "," "\"reported_by\":" ("\"doctor\"" | "\"patient\"" | "\"nurse\"" | "\"caregiver\"" | "\"family_member\"" | "\"clinical_staff\"" | "\"unknown\"") "}"
r_review_of_systems_item ::= "{" "\"system\":" str1 ("," "\"details\":" str)? "," "\"reported_by\":" ("\"doctor\"" | "\"patient\"" | "\"nurse\"" | "\"caregiver\"" | "\"family_member\"" | "\"clinical_staff\"" | "\"unknown\"") "}"
r_clinical_assessment_item ::= "{" "\"assessment\":" str1 "," "\"certainty\":" ("\"provisional\"" | "\"differential\"") "}"
r_investigations_item ::= "{" "\"name\":" str1 ("," "\"type\":" ("\"laboratory\"" | "\"imaging\"" | "\"cardiac\"" | "\"other\""))? "," "\"status\":" ("\"planned\"" | "\"done\"" | "\"conditional\"") "}"
r_procedures_item ::= "{" "\"name\":" str1 "," "\"status\":" ("\"planned\"" | "\"done\"" | "\"conditional\"") "}"
r_clinical_actions_item ::= "{" "\"type\":" ("\"medication\"" | "\"investigation\"" | "\"counselling\"" | "\"referral\"" | "\"follow_up\"" | "\"other\"") "," "\"description\":" str1 "}"
r_follow_up_item ::= "{" "\"when\":" str1 "," "\"status\":" ("\"planned\"" | "\"conditional\"") "}"
str ::= "\"" [^"\\\n\r\t]* "\""
str1 ::= "\"" [^"\\\n\r\t]+ "\""