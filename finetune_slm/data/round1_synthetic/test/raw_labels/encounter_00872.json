    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you for telling me. When was the seizure?",
      "start_timestamp": "00:20",
      "end_timestamp": "00:26",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Six weeks ago, on a Tuesday night. I was asleep, my husband woke up and I was shaking. It lasted about two minutes, he said.",
      "start_timestamp": "00:29",
      "end_timestamp": "00:42",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How did you feel afterwards?",
      "start_timestamp": "00:45",
      "end_timestamp": "00:49",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Awful. Confused, exhausted, a headache, and I'd bitten my tongue. I slept for twelve hours.",
      "start_timestamp": "00:52",
      "end_timestamp": "00:59",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's an honest answer, thank you. Any other seizures, or odd episodes like staring or jerking?",
