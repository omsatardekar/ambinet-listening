    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hi, doctor! I'm Priya, and I'm here for my epilepsy review, I've got so much to tell you, because I had a seizure, one, since my last visit, and I haven't stopped worrying about it.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:17",
