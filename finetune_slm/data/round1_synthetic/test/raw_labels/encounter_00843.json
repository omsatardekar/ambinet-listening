    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It can't be diagnosed by listening alone. The picture, forty years of smoking, a morning cough with phlegm, and getting puffed on stairs, makes me think of COPD, but I can't be sure until we've tested.",
      "start_timestamp": "03:02",
      "end_timestamp": "03:24",
