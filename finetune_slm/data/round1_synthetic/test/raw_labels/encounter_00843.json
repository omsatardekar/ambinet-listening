    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Doctor, I'm Ian, Frank's brother. He won't ask, so I will. He's got a cough every morning, and he's been a smoker for forty years.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:15",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Frank, I'd like to hear it from you. Tell me about the morning cough.",
      "start_timestamp": "00:22",
      "end_timestamp": "00:30",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I cough when I get up. Bring up some phlegm. Then it's gone by mid-morning.",
      "start_timestamp": "00:33",
