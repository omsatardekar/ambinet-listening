      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "There's a bit of wheeze when you breathe out, and your breathing out takes longer than normal, otherwise clear.",
      "start_timestamp": "02:46",
      "end_timestamp": "02:56",
      "supports": [
        "physical_examination[0]"
