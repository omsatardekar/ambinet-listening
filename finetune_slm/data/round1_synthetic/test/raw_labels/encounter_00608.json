  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I found a lump in my left breast, in the shower last week. I wrote down the date, and the time.",
      "start_timestamp": "00:48",
      "end_timestamp": "00:59",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
