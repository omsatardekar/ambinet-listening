      "end_timestamp": "01:05",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[2]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Three weeks, sir. I am counting from the day you stopped walking to the park.",
