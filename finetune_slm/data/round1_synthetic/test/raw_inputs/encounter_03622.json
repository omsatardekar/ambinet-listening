{
  "schema_version": "1.0",
  "encounter_id": "03622",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.93,
      "end_seconds": 5.92,
      "duration_seconds": 4.99,
      "text": "Afternoon, doctor. They're in and comfortable, and I have the measurements ready."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.96,
      "end_seconds": 11.3,
      "duration_seconds": 4.34,
      "text": "okay, thanks, that's helpful hello, please sit what's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 13.35,
      "end_seconds": 17.56,
      "duration_seconds": 4.21,
      "text": "So, um, I've been feeling tired, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.72,
      "end_seconds": 22.12,
      "duration_seconds": 3.4,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 23.03,
      "end_seconds": 24.97,
      "duration_seconds": 1.94,
      "text": "About... well, ten days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.96,
      "end_seconds": 29.68,
      "duration_seconds": 3.72,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 30.96,
      "end_seconds": 42.6,
      "duration_seconds": 11.64,
      "text": "Mostly moderate. I've had mild bloating too, for ten days. With mild bloating, maybe a five out of ten on a bad day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.37,
      "end_seconds": 48.69,
      "duration_seconds": 4.32,
      "text": "What about tingling in your feet, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 50.12,
      "end_seconds": 56.34,
      "duration_seconds": 6.22,
      "text": "yeah, that too. I've also had being unsteady, for four weeks"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.94,
      "end_seconds": 70.72,
      "duration_seconds": 1.78,
      "text": "do you drink alcohol?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 72.66,
      "end_seconds": 77.84,
      "duration_seconds": 5.18,
      "text": "I used to drink heavily but I stopped four years ago"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.56,
      "end_seconds": 79.9,
      "duration_seconds": 1.34,
      "text": "do you smoke?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 81.03,
      "end_seconds": 83.53,
      "duration_seconds": 2.5,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.06,
      "end_seconds": 85.82,
      "duration_seconds": 1.76,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 87.91,
      "end_seconds": 90.6,
      "duration_seconds": 2.69,
      "text": "My partner and our baby"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.53,
      "end_seconds": 94.61,
      "duration_seconds": 2.08,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 95.36,
      "end_seconds": 101.55,
      "duration_seconds": 6.19,
      "text": "I drink a lot of tea and snack through the day"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.78,
      "end_seconds": 106.05,
      "duration_seconds": 3.27,
      "text": "Okay, what line of work are you in?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 107.65,
      "end_seconds": 112.9,
      "duration_seconds": 5.25,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.55,
      "end_seconds": 116.01,
      "duration_seconds": 2.46,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 117.29,
      "end_seconds": 122.07,
      "duration_seconds": 4.78,
      "text": "I've had anxiety, yes. I've had heart disease, yes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.78,
      "end_seconds": 133.38,
      "duration_seconds": 9.6,
      "text": "Yes, anxiety is known to us, good to have that clear. Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 134.84,
      "end_seconds": 138.18,
      "duration_seconds": 3.34,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.75,
      "end_seconds": 145.09,
      "duration_seconds": 2.34,
      "text": "tell me your medicines, please"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 145.7,
      "end_seconds": 151.7,
      "duration_seconds": 6.0,
      "text": "I'm on aspirin, 75 milligrams, once a day for my heart"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 152.99,
      "end_seconds": 158.0,
      "duration_seconds": 5.01,
      "text": "Doctor, our chart from the last visit lists it as 37.5 milligrams."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.93,
      "end_seconds": 164.8,
      "duration_seconds": 5.87,
      "text": "Okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 165.38,
      "end_seconds": 174.46,
      "duration_seconds": 9.08,
      "text": "Not with me. I'll bring it next time. I'd been on metoprolol, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.95,
      "end_seconds": 188.13,
      "duration_seconds": 3.18,
      "text": "does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 189.14,
      "end_seconds": 191.18,
      "duration_seconds": 2.04,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.17,
      "end_seconds": 195.7,
      "duration_seconds": 2.53,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 198.96,
      "end_seconds": 203.53,
      "duration_seconds": 4.57,
      "text": "I had an operation for a hernia last spring"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.3,
      "end_seconds": 208.9,
      "duration_seconds": 4.6,
      "text": "Any weight loss, diarrhoea, bladder problems or back pain?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 209.72,
      "end_seconds": 216.72,
      "duration_seconds": 7.0,
      "text": "okay, so no, no weight loss, diarrhoea, bladder problems or back pain"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.48,
      "end_seconds": 221.89,
      "duration_seconds": 3.41,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 222.58,
      "end_seconds": 224.28,
      "duration_seconds": 1.7,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.25,
      "end_seconds": 228.4,
      "duration_seconds": 2.15,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 232.99,
      "end_seconds": 234.53,
      "duration_seconds": 1.54,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 235.8,
      "end_seconds": 243.74,
      "duration_seconds": 7.94,
      "text": "Okay, so the vitals from earlier. Temperature 36.4, heart rate 83. Saturation 97 percent, blood pressure 112 over 79."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.73,
      "end_seconds": 245.43,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.88,
      "end_seconds": 251.32,
      "duration_seconds": 3.44,
      "text": "now I'm gonna do a short physical check"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 253.16,
      "end_seconds": 254.07,
      "duration_seconds": 0.91,
      "text": "of course"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.58,
      "end_seconds": 258.14,
      "duration_seconds": 2.56,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.32,
      "end_seconds": 274.49,
      "duration_seconds": 7.17,
      "text": "The feeling in your feet is reduced and your balance with the eyes closed is poor."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.94,
      "end_seconds": 280.36,
      "duration_seconds": 2.42,
      "text": "okay, that's enough for me"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.3,
      "end_seconds": 310.7,
      "duration_seconds": 22.4,
      "text": "From what you've told me and what I found, it's hard to to say. A possible gut-related cause of nerve symptoms is one possibility and a vitamin B12 deficiency another, and I'd rather not commit yet. So, to recap quickly. You've been feeling tired for ten days, moderate, and no back pain or bladder problems."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 311.8,
      "end_seconds": 313.71,
      "duration_seconds": 1.91,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.5,
      "end_seconds": 341.35,
      "duration_seconds": 26.85,
      "text": "I'd like to arrange a B12 level for neuropathy. I'd rather check than guess, and this is the quickest way to know more. I'd like to arrange an HbA1c for neuropathy. Please keep eating gluten normally until the coeliac test is done. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.73,
      "end_seconds": 352.62,
      "duration_seconds": 9.89,
      "text": "If it hasn't settled in a month, we'd think about a coeliac blood test, but not now. Book a review after the results."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 353.64,
      "end_seconds": 354.34,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.45,
      "end_seconds": 358.25,
      "duration_seconds": 2.8,
      "text": "does all of that make sense?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 359.7,
      "end_seconds": 361.64,
      "duration_seconds": 1.94,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.49,
      "end_seconds": 364.42,
      "duration_seconds": 1.93,
      "text": "Okay, look after yourself."
    }
  ]
}