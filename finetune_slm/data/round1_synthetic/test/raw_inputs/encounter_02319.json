{
  "schema_version": "1.0",
  "encounter_id": "02319",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.51,
      "end_seconds": 3.04,
      "duration_seconds": 2.53,
      "text": "Right then, come on in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 3.92,
      "end_seconds": 9.16,
      "duration_seconds": 5.24,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.95,
      "end_seconds": 15.81,
      "duration_seconds": 2.86,
      "text": "Okay, have you been waiting long?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 16.66,
      "end_seconds": 19.74,
      "duration_seconds": 3.08,
      "text": "Only about ten minutes, no trouble."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.76,
      "end_seconds": 25.05,
      "duration_seconds": 3.29,
      "text": "So what can I do for you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 25.74,
      "end_seconds": 32.61,
      "duration_seconds": 6.87,
      "text": "Yeah, it's spots on my forehead and chin. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.71,
      "end_seconds": 37.08,
      "duration_seconds": 3.37,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 38.12,
      "end_seconds": 43.26,
      "duration_seconds": 5.14,
      "text": "Probably two weeks. Yeah. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.73,
      "end_seconds": 52.6,
      "duration_seconds": 8.87,
      "text": "Understood. Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 53.52,
      "end_seconds": 58.02,
      "duration_seconds": 4.5,
      "text": "Mostly moderate. It's worse with stress and before periods."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.04,
      "end_seconds": 62.15,
      "duration_seconds": 2.11,
      "text": "Any oily skin as well?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 63.65,
      "end_seconds": 72.52,
      "duration_seconds": 8.87,
      "text": "Yes, um, about the same, one week. And there's a few blackheads as well, ten days now."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.03,
      "end_seconds": 75.88,
      "duration_seconds": 2.85,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.39,
      "end_seconds": 92.13,
      "duration_seconds": 2.74,
      "text": "Right, nearly done with the readings..."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.55,
      "end_seconds": 120.45,
      "duration_seconds": 9.9,
      "text": "Okay: pulse is 82 beats a minute, pressure 120 over 81, SpO2 97 percent on room air, respiratory rate 15."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 121.85,
      "end_seconds": 123.42,
      "duration_seconds": 1.57,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.99,
      "end_seconds": 129.83,
      "duration_seconds": 4.84,
      "text": "Alright, they help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.37,
      "end_seconds": 135.93,
      "duration_seconds": 3.56,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.07,
      "end_seconds": 138.37,
      "duration_seconds": 1.3,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.33,
      "end_seconds": 161.72,
      "duration_seconds": 5.39,
      "text": "There are small blackheads and a few red spots with no deep cysts."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.17,
      "end_seconds": 169.66,
      "duration_seconds": 2.49,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.72,
      "end_seconds": 190.73,
      "duration_seconds": 4.01,
      "text": "Any low mood, painful cysts or scarring at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 191.6,
      "end_seconds": 196.64,
      "duration_seconds": 5.04,
      "text": "Oh, no, no low mood, painful cysts or scarring."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.95,
      "end_seconds": 199.54,
      "duration_seconds": 1.59,
      "text": "What about irregular periods?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 200.44,
      "end_seconds": 203.72,
      "duration_seconds": 3.28,
      "text": "No, I haven't had any irregular periods."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.64,
      "end_seconds": 210.02,
      "duration_seconds": 4.38,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 211.56,
      "end_seconds": 213.41,
      "duration_seconds": 1.85,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.67,
      "end_seconds": 216.29,
      "duration_seconds": 1.62,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 216.97,
      "end_seconds": 221.41,
      "duration_seconds": 4.44,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.05,
      "end_seconds": 226.61,
      "duration_seconds": 3.56,
      "text": "Right, are you on your own at home?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 227.48,
      "end_seconds": 230.39,
      "duration_seconds": 2.91,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.08,
      "end_seconds": 233.6,
      "duration_seconds": 2.52,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 235.93,
      "end_seconds": 239.31,
      "duration_seconds": 3.38,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.27,
      "end_seconds": 245.89,
      "duration_seconds": 4.62,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 250.35,
      "end_seconds": 253.07,
      "duration_seconds": 2.72,
      "text": "COPD, for nearly five years."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.63,
      "end_seconds": 255.07,
      "duration_seconds": 1.44,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.78,
      "end_seconds": 268.93,
      "duration_seconds": 2.15,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 269.57,
      "end_seconds": 277.83,
      "duration_seconds": 8.26,
      "text": "Tiotropium inhaler. I take it once a day for my chest. It's a face wash, twice a day."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.22,
      "end_seconds": 281.81,
      "duration_seconds": 3.59,
      "text": "Mm, okay. Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 282.61,
      "end_seconds": 288.57,
      "duration_seconds": 5.96,
      "text": "Yes, I had a meniscus repair on my knee, four years ago."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 289.29,
      "end_seconds": 293.21,
      "duration_seconds": 3.92,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 294.88,
      "end_seconds": 298.2,
      "duration_seconds": 3.32,
      "text": "I'm allergic to kiwi, I get hives."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.78,
      "end_seconds": 302.41,
      "duration_seconds": 3.63,
      "text": "Having listened and examined, it points towards mild acne."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 316.2,
      "end_seconds": 339.6,
      "duration_seconds": 23.4,
      "text": "The treatment will be benzoyl peroxide gel, 5%, once a day, eight weeks. It's for acne. Wash gently twice a day and don't squeeze the spots. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. I'll want another look in eight weeks."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 340.83,
      "end_seconds": 341.53,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 346.17,
      "end_seconds": 349.47,
      "duration_seconds": 3.3,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 350.9,
      "end_seconds": 353.93,
      "duration_seconds": 3.03,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}