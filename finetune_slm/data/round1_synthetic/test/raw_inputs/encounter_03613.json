{
  "schema_version": "1.0",
  "encounter_id": "03613",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.52,
      "end_seconds": 4.17,
      "duration_seconds": 3.65,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.07,
      "end_seconds": 10.52,
      "duration_seconds": 4.45,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.05,
      "end_seconds": 17.74,
      "duration_seconds": 6.69,
      "text": "Well, honestly, it's breathlessness during sport, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.41,
      "end_seconds": 22.97,
      "duration_seconds": 3.56,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.31,
      "end_seconds": 30.99,
      "duration_seconds": 3.68,
      "text": "It's been one week, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.87,
      "end_seconds": 39.5,
      "duration_seconds": 7.63,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.37,
      "end_seconds": 53.32,
      "duration_seconds": 11.95,
      "text": "Well, yes, sport. That makes it worse. Severe, I'd say. And there's a flutter now and then as well, ten days now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.25,
      "end_seconds": 57.64,
      "duration_seconds": 3.39,
      "text": "Right, how often do you get it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.62,
      "end_seconds": 61.98,
      "duration_seconds": 2.36,
      "text": "Honestly, every other day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.83,
      "end_seconds": 66.79,
      "duration_seconds": 3.96,
      "text": "Has there been chest tightness when pushing hard too?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.0,
      "end_seconds": 72.8,
      "duration_seconds": 1.8,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.71,
      "end_seconds": 79.28,
      "duration_seconds": 5.57,
      "text": "Have you had breathlessness during sport before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.31,
      "end_seconds": 87.63,
      "duration_seconds": 7.32,
      "text": "A bit, a couple of years ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.5,
      "end_seconds": 99.13,
      "duration_seconds": 3.63,
      "text": "Have you had any fever or leg swelling?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.85,
      "end_seconds": 103.91,
      "duration_seconds": 3.06,
      "text": "No, no fever or leg swelling."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.44,
      "end_seconds": 108.17,
      "duration_seconds": 2.73,
      "text": "Any fainting or cough at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.56,
      "end_seconds": 113.6,
      "duration_seconds": 4.04,
      "text": "I haven't had fainting or cough, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.2,
      "end_seconds": 117.16,
      "duration_seconds": 1.96,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.11,
      "end_seconds": 121.17,
      "duration_seconds": 2.06,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.48,
      "end_seconds": 123.95,
      "duration_seconds": 1.47,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.87,
      "end_seconds": 128.44,
      "duration_seconds": 3.57,
      "text": "Mm, no, I've never been operated on."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.3,
      "end_seconds": 134.54,
      "duration_seconds": 4.24,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.46,
      "end_seconds": 138.29,
      "duration_seconds": 2.83,
      "text": "I have gout, for five years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.18,
      "end_seconds": 145.15,
      "duration_seconds": 4.97,
      "text": "Okay, go on. Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.24,
      "end_seconds": 148.27,
      "duration_seconds": 2.03,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.69,
      "end_seconds": 154.8,
      "duration_seconds": 5.11,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.48,
      "end_seconds": 171.89,
      "duration_seconds": 15.41,
      "text": "Allopurinol. I take it 100 milligrams, once a day for the gout. I didn't want to bother you but it keeps coming back. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.76,
      "end_seconds": 177.28,
      "duration_seconds": 3.52,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.64,
      "end_seconds": 182.37,
      "duration_seconds": 3.73,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.83,
      "end_seconds": 189.27,
      "duration_seconds": 2.44,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.39,
      "end_seconds": 194.52,
      "duration_seconds": 4.13,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.0,
      "end_seconds": 200.79,
      "duration_seconds": 4.79,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.5,
      "end_seconds": 215.04,
      "duration_seconds": 2.54,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.27,
      "end_seconds": 235.16,
      "duration_seconds": 9.89,
      "text": "Okay: BP is 114 over 75, pulse is 72 beats a minute, SpO2 97 percent on room air. And temperature is 36.8 degrees."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.53,
      "end_seconds": 238.11,
      "duration_seconds": 1.58,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.7,
      "end_seconds": 242.42,
      "duration_seconds": 2.72,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.96,
      "end_seconds": 249.58,
      "duration_seconds": 4.62,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.42,
      "end_seconds": 251.36,
      "duration_seconds": 0.94,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.15,
      "end_seconds": 255.28,
      "duration_seconds": 2.13,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.15,
      "end_seconds": 274.84,
      "duration_seconds": 4.69,
      "text": "There is a harsh murmur that gets louder when you stand up."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.76,
      "end_seconds": 281.55,
      "duration_seconds": 1.79,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.69,
      "end_seconds": 297.43,
      "duration_seconds": 4.74,
      "text": "So where does that leave us? I'd lean towards possible hypertrophic cardiomyopathy."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.22,
      "end_seconds": 320.05,
      "duration_seconds": 11.83,
      "text": "Let's book an ECG to look into murmur and family history. The result will help us decide whether anything more is needed. Let's get a heart monitor, for palpitations."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.13,
      "end_seconds": 324.14,
      "duration_seconds": 2.01,
      "text": "Okay, I'll do it."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.35,
      "end_seconds": 329.23,
      "duration_seconds": 3.88,
      "text": "I'm going to order an echocardiogram, for murmur."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.6,
      "end_seconds": 332.65,
      "duration_seconds": 2.05,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.62,
      "end_seconds": 364.83,
      "duration_seconds": 29.21,
      "text": "No competitive sport until the heart scan, and we will check your close family. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. I'm going to send a referral to the inherited cardiac conditions clinic. Let's review you after the scan. Alright, is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 365.6,
      "end_seconds": 368.78,
      "duration_seconds": 3.18,
      "text": "Great, thank you for your help."
    }
  ]
}