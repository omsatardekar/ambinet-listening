{
  "schema_version": "1.0",
  "encounter_id": "01531",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.07,
      "end_seconds": 3.8,
      "duration_seconds": 2.73,
      "text": "Hello, come in. Mind the step."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.67,
      "end_seconds": 8.86,
      "duration_seconds": 4.19,
      "text": "Good morning, you know, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.23,
      "end_seconds": 12.95,
      "duration_seconds": 2.72,
      "text": "Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.82,
      "end_seconds": 19.91,
      "duration_seconds": 6.09,
      "text": "It's a fall and pain in my left hip, mostly."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.28,
      "end_seconds": 22.76,
      "duration_seconds": 1.48,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.98,
      "end_seconds": 27.3,
      "duration_seconds": 3.32,
      "text": "ever since... since last weekend, really"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.25,
      "end_seconds": 39.14,
      "duration_seconds": 9.89,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 40.76,
      "end_seconds": 59.5,
      "duration_seconds": 18.74,
      "text": "well, it comes and goes. It's worse with moving. Lying still helps a bit. I've been reading about it online and it worried me. Actually, there was not being able to stand, yes, but that went away"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.29,
      "end_seconds": 64.19,
      "duration_seconds": 3.9,
      "text": "let me get the readings out of the way"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.1,
      "end_seconds": 79.58,
      "duration_seconds": 2.48,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.24,
      "end_seconds": 105.88,
      "duration_seconds": 8.64,
      "text": "Okay: temp 36.5 degrees, pulse is 83 beats a minute. And pressure 111 over 74, oxygen saturation is 98 percent."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.54,
      "end_seconds": 109.17,
      "duration_seconds": 1.63,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.44,
      "end_seconds": 115.34,
      "duration_seconds": 2.9,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.72,
      "end_seconds": 122.48,
      "duration_seconds": 4.76,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.5,
      "end_seconds": 124.72,
      "duration_seconds": 1.22,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.08,
      "end_seconds": 146.85,
      "duration_seconds": 6.77,
      "text": "The left leg is shortened and turned outwards, and it is very painful to move."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.88,
      "end_seconds": 155.03,
      "duration_seconds": 5.15,
      "text": "Okay, that's enough for me. Right, how about loss of consciousness?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.99,
      "end_seconds": 158.55,
      "duration_seconds": 2.56,
      "text": "no loss of consciousness, thankfully"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.1,
      "end_seconds": 168.16,
      "duration_seconds": 4.06,
      "text": "have you had any head injury, chest pain or numbness?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.12,
      "end_seconds": 175.3,
      "duration_seconds": 6.18,
      "text": "yeah, I haven't had head injury, chest pain or numbness, no"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.04,
      "end_seconds": 179.38,
      "duration_seconds": 3.34,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 180.77,
      "end_seconds": 183.47,
      "duration_seconds": 2.7,
      "text": "ah, no, nothing like that"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.24,
      "end_seconds": 187.68,
      "duration_seconds": 3.44,
      "text": "a few questions about your lifestyle now"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 189.25,
      "end_seconds": 199.67,
      "duration_seconds": 10.42,
      "text": "I swim twice a week. My husband and I live above the shop. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.29,
      "end_seconds": 205.18,
      "duration_seconds": 4.89,
      "text": "Alright, are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.09,
      "end_seconds": 211.58,
      "duration_seconds": 4.49,
      "text": "Actually, no, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.68,
      "end_seconds": 217.37,
      "duration_seconds": 4.69,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 218.84,
      "end_seconds": 242.08,
      "duration_seconds": 23.24,
      "text": "Erm, I've had thin bones for two years now. Work has been very busy so I kept ignoring it. It's the not knowing that gets to me. I have gout, for about ten years. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.64,
      "end_seconds": 248.07,
      "duration_seconds": 5.43,
      "text": "yes, thin bones is known to us, good to have that clear"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.15,
      "end_seconds": 264.04,
      "duration_seconds": 2.89,
      "text": "any past operations I should know about?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 265.04,
      "end_seconds": 271.3,
      "duration_seconds": 6.26,
      "text": "Mm, yes, I had part of my thyroid removed, years back."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.73,
      "end_seconds": 281.07,
      "duration_seconds": 2.34,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 283.13,
      "end_seconds": 294.98,
      "duration_seconds": 11.85,
      "text": "Alendronate, 70 milligrams, once a week for my bones. I take allopurinol, 100 milligrams, once a day. Paracetamol. I take it when needed."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.92,
      "end_seconds": 299.18,
      "duration_seconds": 2.26,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 300.18,
      "end_seconds": 305.03,
      "duration_seconds": 4.85,
      "text": "1 gram, I think that's what's on the box"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.02,
      "end_seconds": 309.83,
      "duration_seconds": 3.81,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 310.82,
      "end_seconds": 313.53,
      "duration_seconds": 2.71,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 325.76,
      "end_seconds": 344.07,
      "duration_seconds": 18.31,
      "text": "Let me tell you where I've got to. It points towards a probable hip fracture. That's my thinking for now, and it may change as we learn more. I want an X-ray of the hip done, that's for hip fracture."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 344.66,
      "end_seconds": 350.15,
      "duration_seconds": 5.49,
      "text": "erm, do I need blood tests? I read it might help"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 350.74,
      "end_seconds": 357.1,
      "duration_seconds": 6.36,
      "text": "Not at this point, no. It isn't indicated yet. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 359.04,
      "end_seconds": 362.84,
      "duration_seconds": 3.8,
      "text": "okay, that makes sense thanks for explaining"
    }
  ]
}