{
  "schema_version": "1.0",
  "encounter_id": "03356",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.98,
      "end_seconds": 4.8,
      "duration_seconds": 3.82,
      "text": "well, hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.37,
      "end_seconds": 9.42,
      "duration_seconds": 4.05,
      "text": "no problem at all, come in what's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.36,
      "end_seconds": 16.25,
      "duration_seconds": 4.89,
      "text": "yeah, it's confusion i don't know what's causing it"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.04,
      "end_seconds": 19.93,
      "duration_seconds": 2.89,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.63,
      "end_seconds": 27.61,
      "duration_seconds": 6.98,
      "text": "It's been going on for five days. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.65,
      "end_seconds": 32.44,
      "duration_seconds": 2.79,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.98,
      "end_seconds": 55.88,
      "duration_seconds": 21.9,
      "text": "A seven out of ten, you know, I suppose. And there's pain in the lower tummy as well, about a week now. With pain in the lower tummy, maybe a seven out of ten on a bad day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.74,
      "end_seconds": 60.22,
      "duration_seconds": 3.48,
      "text": "alright, has there been fever and shivers too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.9,
      "end_seconds": 75.23,
      "duration_seconds": 10.33,
      "text": "yeah. About two weeks, I'd say. Um, as for fever and shivers, severe, really. I'd say every other day"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.18,
      "end_seconds": 80.66,
      "duration_seconds": 4.48,
      "text": "Have you had confusion before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.35,
      "end_seconds": 89.01,
      "duration_seconds": 6.66,
      "text": "Yes, something like this happened last year, and it went away on its own."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.67,
      "end_seconds": 108.63,
      "duration_seconds": 1.96,
      "text": "I'll do your observations first"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.38,
      "end_seconds": 121.84,
      "duration_seconds": 2.46,
      "text": "bear with me while this finishes.."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.89,
      "end_seconds": 148.74,
      "duration_seconds": 13.85,
      "text": "Okay: height 168 centimetres, blood pressure 110 over 68, weight 88 kilos, respiratory rate 19, temperature 38.2, SpO2 98 percent on room air, pulse is 108 beats a minute."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.82,
      "end_seconds": 151.26,
      "duration_seconds": 1.44,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.0,
      "end_seconds": 154.33,
      "duration_seconds": 2.33,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.66,
      "end_seconds": 160.03,
      "duration_seconds": 4.37,
      "text": "alright, over here please and I'll take a look"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.99,
      "end_seconds": 163.07,
      "duration_seconds": 1.08,
      "text": "that's alright"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.06,
      "end_seconds": 165.76,
      "duration_seconds": 1.7,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.49,
      "end_seconds": 181.68,
      "duration_seconds": 6.19,
      "text": "the catheter bag has cloudy urine and there is tenderness above the pubic bone"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.99,
      "end_seconds": 189.48,
      "duration_seconds": 5.49,
      "text": "You can sit up now. Any vomiting, fall or back pain?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.39,
      "end_seconds": 193.56,
      "duration_seconds": 3.17,
      "text": "None of those, you know, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.53,
      "end_seconds": 195.48,
      "duration_seconds": 0.95,
      "text": "Any cough?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.25,
      "end_seconds": 200.88,
      "duration_seconds": 1.63,
      "text": "Definitely no cough."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.56,
      "end_seconds": 204.49,
      "duration_seconds": 2.93,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.01,
      "end_seconds": 206.49,
      "duration_seconds": 1.48,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.35,
      "end_seconds": 215.3,
      "duration_seconds": 6.95,
      "text": "Do you have any long-term conditions? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.85,
      "end_seconds": 223.36,
      "duration_seconds": 7.51,
      "text": "Uh, I have heart disease, for about a year. Epilepsy, for five years."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.02,
      "end_seconds": 237.85,
      "duration_seconds": 12.83,
      "text": "Right, right. Right, so epilepsy is already on your record. We'll keep that that in mind today. Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.4,
      "end_seconds": 252.16,
      "duration_seconds": 13.76,
      "text": "okay, so I'm on metoprolol, 50 milligrams, twice a day though honestly, some days I forget to take it i take sodium valproate, 500 milligrams, twice a day"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.95,
      "end_seconds": 258.58,
      "duration_seconds": 2.63,
      "text": "have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.31,
      "end_seconds": 266.01,
      "duration_seconds": 5.7,
      "text": "Yes, I had part of my thyroid removed, years back."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.17,
      "end_seconds": 283.96,
      "duration_seconds": 2.79,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.59,
      "end_seconds": 288.37,
      "duration_seconds": 3.78,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.93,
      "end_seconds": 293.32,
      "duration_seconds": 4.39,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.3,
      "end_seconds": 298.87,
      "duration_seconds": 3.57,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.97,
      "end_seconds": 304.56,
      "duration_seconds": 4.59,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.68,
      "end_seconds": 307.24,
      "duration_seconds": 1.56,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.91,
      "end_seconds": 342.51,
      "duration_seconds": 25.6,
      "text": "Right, here's what I'm thinking. I'm honestly not certain yet. It could be a catheter-related urinary infection, or it it might be urosepsis. We should do a urine culture for possible urinary infection. I'd like to arrange blood tests for fever. What I'm giving you is co-amoxiclav, 625 milligrams, three times a day, seven days. That should help with catheter urinary infection."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.36,
      "end_seconds": 345.73,
      "duration_seconds": 2.37,
      "text": "How soon will it work?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.38,
      "end_seconds": 353.73,
      "duration_seconds": 7.35,
      "text": "Change the catheter and drink plenty. Do get help quickly if the symptoms get worse."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 355.45,
      "end_seconds": 356.96,
      "duration_seconds": 1.51,
      "text": "yes, will do"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.36,
      "end_seconds": 368.82,
      "duration_seconds": 6.46,
      "text": "We'll catch up in two days. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 369.37,
      "end_seconds": 372.9,
      "duration_seconds": 3.53,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}