{
  "schema_version": "1.0",
  "encounter_id": "03561",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.29,
      "end_seconds": 9.21,
      "duration_seconds": 7.92,
      "text": "Doctor, your next patient is here. I've done the basics, I'll read them out in a moment."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.13,
      "end_seconds": 14.1,
      "duration_seconds": 2.97,
      "text": "Thank you. Right, hello, what's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.84,
      "end_seconds": 20.53,
      "duration_seconds": 5.69,
      "text": "Doctor, I'll sit in if that's okay, I know what's been happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.53,
      "end_seconds": 25.38,
      "duration_seconds": 2.85,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 26.84,
      "end_seconds": 30.84,
      "duration_seconds": 4.0,
      "text": "She's been having been feeling muddled and unsteady, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.23,
      "end_seconds": 35.86,
      "duration_seconds": 3.63,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 37.25,
      "end_seconds": 40.26,
      "duration_seconds": 3.01,
      "text": "About three weeks, give or take."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 41.42,
      "end_seconds": 44.92,
      "duration_seconds": 3.5,
      "text": "Hm, I'd say more like a month."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.73,
      "end_seconds": 50.31,
      "duration_seconds": 4.58,
      "text": "Okay, so roughly three to four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 52.36,
      "end_seconds": 54.19,
      "duration_seconds": 1.83,
      "text": "That sounds about right."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.57,
      "end_seconds": 58.27,
      "duration_seconds": 2.7,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 59.95,
      "end_seconds": 61.67,
      "duration_seconds": 1.72,
      "text": "It's mild, honestly."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.66,
      "end_seconds": 68.24,
      "duration_seconds": 1.58,
      "text": "Have you had cramps?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 69.56,
      "end_seconds": 70.8,
      "duration_seconds": 1.24,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.74,
      "end_seconds": 74.15,
      "duration_seconds": 2.41,
      "text": "Have you been feeling sick?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 76.09,
      "end_seconds": 84.22,
      "duration_seconds": 8.13,
      "text": "Yes, about the same, two months. A headache was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.14,
      "end_seconds": 88.97,
      "duration_seconds": 2.83,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 90.07,
      "end_seconds": 93.4,
      "duration_seconds": 3.33,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.48,
      "end_seconds": 100.05,
      "duration_seconds": 2.57,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 101.02,
      "end_seconds": 110.32,
      "duration_seconds": 9.3,
      "text": "Mirtazapine. I take it 15 milligrams, at night. I'm on valsartan, 80 milligrams, once a day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 112.12,
      "end_seconds": 119.58,
      "duration_seconds": 7.46,
      "text": "She is supposed to take it once a day, but I can't say she always does."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.38,
      "end_seconds": 142.46,
      "duration_seconds": 4.08,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 143.71,
      "end_seconds": 148.63,
      "duration_seconds": 4.92,
      "text": "Ah, I've had depression for nearly five years now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.76,
      "end_seconds": 151.19,
      "duration_seconds": 1.43,
      "text": "Is that everything?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 151.75,
      "end_seconds": 156.79,
      "duration_seconds": 5.04,
      "text": "I have high blood pressure, for about ten years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.66,
      "end_seconds": 175.62,
      "duration_seconds": 0.96,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 177.17,
      "end_seconds": 181.58,
      "duration_seconds": 4.41,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.77,
      "end_seconds": 184.72,
      "duration_seconds": 1.95,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 186.55,
      "end_seconds": 190.8,
      "duration_seconds": 4.25,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.43,
      "end_seconds": 194.03,
      "duration_seconds": 1.6,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 194.56,
      "end_seconds": 197.31,
      "duration_seconds": 2.75,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.03,
      "end_seconds": 202.4,
      "duration_seconds": 3.37,
      "text": "Right, are you in work at the moment?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 204.42,
      "end_seconds": 208.56,
      "duration_seconds": 4.14,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.6,
      "end_seconds": 213.46,
      "duration_seconds": 3.86,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 216.96,
      "end_seconds": 221.79,
      "duration_seconds": 4.83,
      "text": "My brother has epilepsy. My mother had a stroke."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.29,
      "end_seconds": 227.8,
      "duration_seconds": 2.51,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 229.04,
      "end_seconds": 233.3,
      "duration_seconds": 4.26,
      "text": "Yes, I had a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.38,
      "end_seconds": 241.7,
      "duration_seconds": 6.32,
      "text": "Okay, have you had any weakness on one side, seizure, fever or fall?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 242.86,
      "end_seconds": 250.69,
      "duration_seconds": 7.83,
      "text": "I mean, no weakness on one side, seizure, fever or fall, none of it."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.2,
      "end_seconds": 259.69,
      "duration_seconds": 3.49,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 263.02,
      "end_seconds": 264.99,
      "duration_seconds": 1.97,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 282.67,
      "end_seconds": 293.19,
      "duration_seconds": 10.52,
      "text": "Doctor, I've got the readings for you. Pulse 79, pressure 123 over 79. SpO2 97 percent on room air, respiratory rate 15, temp 36.4 degrees."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.9,
      "end_seconds": 296.29,
      "duration_seconds": 1.39,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.48,
      "end_seconds": 301.52,
      "duration_seconds": 4.04,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.95,
      "end_seconds": 305.48,
      "duration_seconds": 2.53,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.72,
      "end_seconds": 325.67,
      "duration_seconds": 7.95,
      "text": "You are a bit slow and unsteady, but there is no weakness and your blood pressure is fine."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.89,
      "end_seconds": 341.9,
      "duration_seconds": 12.01,
      "text": "Thank you, you can get dressed. Taking everything into account, it fits best with a low salt level, possibly from the new antidepressant. Another possibility is a urine infection."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 342.9,
      "end_seconds": 344.47,
      "duration_seconds": 1.57,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.52,
      "end_seconds": 378.33,
      "duration_seconds": 32.81,
      "text": "I can't promise yet, but most people with a low salt level, possibly from the new antidepressant do well once it's treated properly. I think blood tests makes sense here, for confusion. I think a urine test makes sense here, for confusion. It's a routine test and it'll give us a much clearer picture. We will stop the new tablet and not drink excess water until we have the result."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.29,
      "end_seconds": 382.95,
      "duration_seconds": 3.66,
      "text": "I'll also refer you to the older people's clinic."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 384.89,
      "end_seconds": 386.48,
      "duration_seconds": 1.59,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 387.4,
      "end_seconds": 393.91,
      "duration_seconds": 6.51,
      "text": "One warning sign to remember: the symptoms get worse. In that case don't wait."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 394.8,
      "end_seconds": 396.38,
      "duration_seconds": 1.58,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 397.45,
      "end_seconds": 405.36,
      "duration_seconds": 7.91,
      "text": "Please come and see me in two days. Okay, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 406.13,
      "end_seconds": 410.9,
      "duration_seconds": 4.77,
      "text": "So, okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 411.86,
      "end_seconds": 413.21,
      "duration_seconds": 1.35,
      "text": "Take care now."
    }
  ]
}