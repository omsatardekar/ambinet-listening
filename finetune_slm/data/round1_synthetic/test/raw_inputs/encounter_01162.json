{
  "schema_version": "1.0",
  "encounter_id": "01162",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.06,
      "end_seconds": 2.72,
      "duration_seconds": 1.66,
      "text": "Welcome. Make yourself comfortable."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.49,
      "end_seconds": 4.51,
      "duration_seconds": 1.02,
      "text": "Evening, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.45,
      "end_seconds": 13.02,
      "duration_seconds": 3.57,
      "text": "Right, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.61,
      "end_seconds": 28.08,
      "duration_seconds": 14.47,
      "text": "Doctor, it's scaly red plaques on my elbows. It's getting on my nerves now. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.28,
      "end_seconds": 32.68,
      "duration_seconds": 3.4,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.25,
      "end_seconds": 43.07,
      "duration_seconds": 8.82,
      "text": "Oh, just since yesterday. Sorry, I know I'm rambling a bit. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.38,
      "end_seconds": 47.23,
      "duration_seconds": 2.85,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.01,
      "end_seconds": 52.79,
      "duration_seconds": 3.78,
      "text": "A eight out of ten, I suppose."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.22,
      "end_seconds": 57.96,
      "duration_seconds": 3.74,
      "text": "And what about fever, pus or joint pain?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 59.81,
      "end_seconds": 64.96,
      "duration_seconds": 5.15,
      "text": "Mm, I haven't had fever, pus or joint pain, no."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.53,
      "end_seconds": 69.44,
      "duration_seconds": 2.91,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.83,
      "end_seconds": 73.6,
      "duration_seconds": 2.77,
      "text": "Yeah, no, that's been fine."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.41,
      "end_seconds": 93.47,
      "duration_seconds": 3.06,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.32,
      "end_seconds": 97.38,
      "duration_seconds": 3.06,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.5,
      "end_seconds": 102.14,
      "duration_seconds": 3.64,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.77,
      "end_seconds": 105.39,
      "duration_seconds": 2.62,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.42,
      "end_seconds": 110.86,
      "duration_seconds": 3.44,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 112.12,
      "end_seconds": 115.89,
      "duration_seconds": 3.77,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.76,
      "end_seconds": 119.38,
      "duration_seconds": 1.62,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.05,
      "end_seconds": 123.19,
      "duration_seconds": 3.14,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.27,
      "end_seconds": 128.32,
      "duration_seconds": 4.05,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.84,
      "end_seconds": 132.27,
      "duration_seconds": 3.43,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.09,
      "end_seconds": 141.41,
      "duration_seconds": 4.32,
      "text": "So, any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.31,
      "end_seconds": 144.78,
      "duration_seconds": 1.47,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.26,
      "end_seconds": 159.04,
      "duration_seconds": 2.78,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.02,
      "end_seconds": 165.54,
      "duration_seconds": 5.52,
      "text": "I had a meniscus repair on my knee four years ago."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.83,
      "end_seconds": 171.48,
      "duration_seconds": 4.65,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.21,
      "end_seconds": 175.15,
      "duration_seconds": 1.94,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.9,
      "end_seconds": 192.45,
      "duration_seconds": 3.55,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.92,
      "end_seconds": 206.32,
      "duration_seconds": 2.4,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.88,
      "end_seconds": 234.39,
      "duration_seconds": 8.51,
      "text": "Okay: blood pressure 123 over 72, temperature is 36.9 degrees, pulse 66, oxygen saturation is 97 percent."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 234.98,
      "end_seconds": 236.51,
      "duration_seconds": 1.53,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.08,
      "end_seconds": 241.2,
      "duration_seconds": 3.12,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.86,
      "end_seconds": 246.99,
      "duration_seconds": 4.13,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.96,
      "end_seconds": 250.63,
      "duration_seconds": 2.67,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.61,
      "end_seconds": 269.91,
      "duration_seconds": 7.3,
      "text": "There are well-defined silvery plaques on both elbows and a few pits in the nails."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 271.3,
      "end_seconds": 272.41,
      "duration_seconds": 1.11,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 277.16,
      "end_seconds": 285.09,
      "duration_seconds": 7.93,
      "text": "Right, please sit back down. Having listened and examined, I think we're dealing with plaque psoriasis at this stage."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 286.38,
      "end_seconds": 291.1,
      "duration_seconds": 4.72,
      "text": "Let me think, is there something to worry about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 292.9,
      "end_seconds": 298.46,
      "duration_seconds": 5.56,
      "text": "Nothing I've seen today points to an emergency. It looks like plaque psoriasis."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.71,
      "end_seconds": 325.27,
      "duration_seconds": 15.56,
      "text": "I'll start you on calcipotriol and betamethasone, 50 micrograms/0.5 mg per g, once a day, four weeks. That's for psoriasis. Keep the skin well moisturised and avoid picking the plaques."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 325.53,
      "end_seconds": 330.42,
      "duration_seconds": 4.89,
      "text": "Yes, carry on. I'll want another look in four weeks."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 331.39,
      "end_seconds": 335.06,
      "duration_seconds": 3.67,
      "text": "I, I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 336.05,
      "end_seconds": 338.56,
      "duration_seconds": 2.51,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 339.41,
      "end_seconds": 342.39,
      "duration_seconds": 2.98,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 343.6,
      "end_seconds": 345.05,
      "duration_seconds": 1.45,
      "text": "Take care now."
    }
  ]
}