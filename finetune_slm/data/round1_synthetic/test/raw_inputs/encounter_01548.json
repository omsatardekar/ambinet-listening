{
  "schema_version": "1.0",
  "encounter_id": "01548",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.94,
      "end_seconds": 4.24,
      "duration_seconds": 3.3,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.48,
      "end_seconds": 9.38,
      "duration_seconds": 3.9,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.78,
      "end_seconds": 18.62,
      "duration_seconds": 7.84,
      "text": "Honestly, it's neck pain after a car crash, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.47,
      "end_seconds": 22.39,
      "duration_seconds": 2.92,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.29,
      "end_seconds": 28.34,
      "duration_seconds": 4.05,
      "text": "I take ibuprofen, 400 milligrams, with food."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.3,
      "end_seconds": 38.87,
      "duration_seconds": 2.57,
      "text": "So, when did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.68,
      "end_seconds": 42.69,
      "duration_seconds": 3.01,
      "text": "Since Monday, that's when it began."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.61,
      "end_seconds": 45.99,
      "duration_seconds": 2.38,
      "text": "Have you had a headache?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.87,
      "end_seconds": 48.07,
      "duration_seconds": 1.2,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.93,
      "end_seconds": 69.81,
      "duration_seconds": 6.88,
      "text": "Let me check a few things. Any loss of consciousness, weakness or chest pain?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.05,
      "end_seconds": 73.99,
      "duration_seconds": 2.94,
      "text": "Well, no, not a single one."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.89,
      "end_seconds": 78.9,
      "duration_seconds": 3.01,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.22,
      "end_seconds": 82.5,
      "duration_seconds": 2.28,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.5,
      "end_seconds": 86.47,
      "duration_seconds": 2.97,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.32,
      "end_seconds": 93.5,
      "duration_seconds": 5.18,
      "text": "Yes, I had a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.1,
      "end_seconds": 102.33,
      "duration_seconds": 4.23,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.99,
      "end_seconds": 104.87,
      "duration_seconds": 1.88,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.37,
      "end_seconds": 112.73,
      "duration_seconds": 4.36,
      "text": "Alright, any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.98,
      "end_seconds": 116.85,
      "duration_seconds": 2.87,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.77,
      "end_seconds": 137.27,
      "duration_seconds": 5.5,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.91,
      "end_seconds": 150.9,
      "duration_seconds": 9.99,
      "text": "My husband and I live above the shop. I look after my grandchildren most days. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.91,
      "end_seconds": 155.08,
      "duration_seconds": 3.17,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.12,
      "end_seconds": 166.48,
      "duration_seconds": 2.36,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.52,
      "end_seconds": 203.3,
      "duration_seconds": 15.78,
      "text": "Okay: BMI works out to 21.9, pulse is 78 beats a minute, saturation 99 percent. And height 184 centimetres, weight 74 kilos, temperature is 36.8 degrees, pressure 115 over 76."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.51,
      "end_seconds": 207.73,
      "duration_seconds": 2.22,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.46,
      "end_seconds": 209.39,
      "duration_seconds": 0.93,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.63,
      "end_seconds": 212.85,
      "duration_seconds": 2.22,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.85,
      "end_seconds": 236.58,
      "duration_seconds": 6.73,
      "text": "There is muscle tenderness either side of the neck and no tenderness over the bones."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.41,
      "end_seconds": 238.36,
      "duration_seconds": 0.95,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.38,
      "end_seconds": 242.94,
      "duration_seconds": 1.56,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.29,
      "end_seconds": 256.47,
      "duration_seconds": 6.18,
      "text": "Let me tell you where I've got to. My working impression is whiplash-type neck strain."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.27,
      "end_seconds": 262.32,
      "duration_seconds": 4.05,
      "text": "Erm, what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.4,
      "end_seconds": 285.51,
      "duration_seconds": 22.11,
      "text": "Nothing I've seen today points to an emergency. It looks like whiplash-type neck strain. Keep your neck moving gently and avoid a collar. The thing that would worry me is if you get numbness or weakness in your arms. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.17,
      "end_seconds": 289.19,
      "duration_seconds": 3.02,
      "text": "Okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.09,
      "end_seconds": 298.77,
      "duration_seconds": 7.68,
      "text": "Come back if not better in two weeks. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.54,
      "end_seconds": 302.62,
      "duration_seconds": 3.08,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}