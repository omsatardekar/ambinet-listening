{
  "schema_version": "1.0",
  "encounter_id": "03440",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.98,
      "end_seconds": 2.57,
      "duration_seconds": 1.59,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.36,
      "end_seconds": 8.03,
      "duration_seconds": 3.67,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 8.84,
      "end_seconds": 12.71,
      "duration_seconds": 3.87,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.51,
      "end_seconds": 17.8,
      "duration_seconds": 3.29,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.96,
      "end_seconds": 25.1,
      "duration_seconds": 6.14,
      "text": "Doctor, you know, it's cloudy smelly urine. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.3,
      "end_seconds": 32.92,
      "duration_seconds": 6.62,
      "text": "How many days or weeks has it been? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.43,
      "end_seconds": 41.85,
      "duration_seconds": 7.42,
      "text": "About... well, about four days. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.06,
      "end_seconds": 43.07,
      "duration_seconds": 1.01,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.83,
      "end_seconds": 51.18,
      "duration_seconds": 7.35,
      "text": "Oh, and the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 51.28,
      "end_seconds": 57.11,
      "duration_seconds": 5.83,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.48,
      "end_seconds": 71.17,
      "duration_seconds": 8.69,
      "text": "I was getting to that! I've also had pain in the lower tummy, since last weekend."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.93,
      "end_seconds": 77.29,
      "duration_seconds": 3.36,
      "text": "Okay, is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.3,
      "end_seconds": 92.67,
      "duration_seconds": 13.37,
      "text": "It comes and goes. I've also had confusion, for about three months. I did have fever and shivers at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.47,
      "end_seconds": 98.56,
      "duration_seconds": 4.09,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.75,
      "end_seconds": 113.31,
      "duration_seconds": 10.56,
      "text": "I take omeprazole, 20 milligrams, once a day for the reflux. Foracort inhaler. I take it twice a day for my asthma."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 116.99,
      "end_seconds": 123.12,
      "duration_seconds": 6.13,
      "text": "Mm, that's what's prescribed, but I'm not sure he takes it every day."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.92,
      "end_seconds": 127.56,
      "duration_seconds": 2.64,
      "text": "Diclofenac, 50 milligrams, when needed."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.09,
      "end_seconds": 129.36,
      "duration_seconds": 1.27,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.03,
      "end_seconds": 132.53,
      "duration_seconds": 1.5,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.89,
      "end_seconds": 135.7,
      "duration_seconds": 1.81,
      "text": "Alright, what's your work?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.06,
      "end_seconds": 141.64,
      "duration_seconds": 4.58,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.99,
      "end_seconds": 146.56,
      "duration_seconds": 3.57,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.39,
      "end_seconds": 156.6,
      "duration_seconds": 9.21,
      "text": "Yes, an enlarged prostate. Acid reflux, for two years. I've had asthma for two years now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.6,
      "end_seconds": 159.3,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.41,
      "end_seconds": 165.78,
      "duration_seconds": 5.37,
      "text": "I have arthritis in my knees, for nearly five years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.91,
      "end_seconds": 179.25,
      "duration_seconds": 12.34,
      "text": "Right, so an enlarged prostate and asthma are already on your record. We'll keep that in mind today. Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.22,
      "end_seconds": 183.71,
      "duration_seconds": 2.49,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.94,
      "end_seconds": 194.48,
      "duration_seconds": 3.54,
      "text": "Okay, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.78,
      "end_seconds": 202.14,
      "duration_seconds": 3.36,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.11,
      "end_seconds": 207.93,
      "duration_seconds": 3.82,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.37,
      "end_seconds": 219.46,
      "duration_seconds": 5.09,
      "text": "Plasters. I come out in... well, a red itchy rash."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.08,
      "end_seconds": 224.44,
      "duration_seconds": 3.36,
      "text": "And what about cough, vomiting or fall?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.97,
      "end_seconds": 229.87,
      "duration_seconds": 4.9,
      "text": "Um, no cough, vomiting or fall, none of it."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.57,
      "end_seconds": 233.13,
      "duration_seconds": 2.56,
      "text": "Has there been any back pain?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.8,
      "end_seconds": 239.44,
      "duration_seconds": 4.64,
      "text": "Yeah, no, I haven't had any back pain."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.83,
      "end_seconds": 243.2,
      "duration_seconds": 2.37,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.5,
      "end_seconds": 247.89,
      "duration_seconds": 3.39,
      "text": "Erm, bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.99,
      "end_seconds": 272.59,
      "duration_seconds": 10.6,
      "text": "Let me tell you where I've got to. This looks most like a catheter-related urinary infection. We shouldn't forget urosepsis. We should do blood tests for fever."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.58,
      "end_seconds": 274.6,
      "duration_seconds": 1.02,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.32,
      "end_seconds": 300.4,
      "duration_seconds": 21.08,
      "text": "We should do a urine culture for possible urinary infection. We'll begin with co-amoxiclav, 625 milligrams, three times a day, seven days. That should help with catheter urinary infection. Change the catheter and drink plenty. I'll want another look in two days."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.01,
      "end_seconds": 308.08,
      "duration_seconds": 2.07,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.32,
      "end_seconds": 312.28,
      "duration_seconds": 2.96,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.26,
      "end_seconds": 316.71,
      "duration_seconds": 3.45,
      "text": "Thank you, uh, doctor, goodbye."
    }
  ]
}