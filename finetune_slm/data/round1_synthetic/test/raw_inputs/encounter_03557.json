{
  "schema_version": "1.0",
  "encounter_id": "03557",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.93,
      "end_seconds": 3.89,
      "duration_seconds": 2.96,
      "text": "Hi there, the chair's free, sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.78,
      "end_seconds": 7.03,
      "duration_seconds": 1.25,
      "text": "Hi, thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.26,
      "end_seconds": 11.31,
      "duration_seconds": 3.05,
      "text": "Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.61,
      "end_seconds": 27.38,
      "duration_seconds": 14.77,
      "text": "I've been dealing with blacking out when I stand quickly. I told my wife I'd come today. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.15,
      "end_seconds": 31.24,
      "duration_seconds": 3.09,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.82,
      "end_seconds": 39.57,
      "duration_seconds": 6.75,
      "text": "Yesterday, it came on out of nowhere. I've also had a new prostate tablet."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.72,
      "end_seconds": 55.3,
      "duration_seconds": 3.58,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.12,
      "end_seconds": 69.15,
      "duration_seconds": 3.03,
      "text": "Right, keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.82,
      "end_seconds": 97.45,
      "duration_seconds": 11.63,
      "text": "Okay: height 160 centimetres, pulse 109. And saturation 96 percent, weight 53 kilos, pressure 101 over 62, temperature is 37.0 degrees, BMI works out to 20.7."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.85,
      "end_seconds": 102.21,
      "duration_seconds": 2.36,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.29,
      "end_seconds": 104.2,
      "duration_seconds": 0.91,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.13,
      "end_seconds": 107.19,
      "duration_seconds": 2.06,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.51,
      "end_seconds": 127.16,
      "duration_seconds": 6.65,
      "text": "Your blood pressure drops a long way when you stand and your heart sounds are normal."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.75,
      "end_seconds": 137.08,
      "duration_seconds": 6.33,
      "text": "You can sit up now. Have you had any palpitations, head injury or chest pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 138.86,
      "end_seconds": 140.87,
      "duration_seconds": 2.01,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.88,
      "end_seconds": 145.73,
      "duration_seconds": 2.85,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.37,
      "end_seconds": 149.83,
      "duration_seconds": 3.46,
      "text": "I mean, I move fine otherwise."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.35,
      "end_seconds": 152.8,
      "duration_seconds": 2.45,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 154.29,
      "end_seconds": 157.08,
      "duration_seconds": 2.79,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.72,
      "end_seconds": 160.03,
      "duration_seconds": 1.31,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.18,
      "end_seconds": 163.99,
      "duration_seconds": 2.81,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.14,
      "end_seconds": 168.54,
      "duration_seconds": 3.4,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.49,
      "end_seconds": 172.36,
      "duration_seconds": 2.87,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.33,
      "end_seconds": 177.56,
      "duration_seconds": 3.23,
      "text": "Right, what do you do during the day?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 183.35,
      "end_seconds": 186.82,
      "duration_seconds": 3.47,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.2,
      "end_seconds": 200.63,
      "duration_seconds": 2.43,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 201.91,
      "end_seconds": 204.93,
      "duration_seconds": 3.02,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.1,
      "end_seconds": 209.83,
      "duration_seconds": 3.73,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 211.67,
      "end_seconds": 216.02,
      "duration_seconds": 4.35,
      "text": "Lisinopril. I take it 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.07,
      "end_seconds": 222.64,
      "duration_seconds": 5.57,
      "text": "What about your medical history? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 223.4,
      "end_seconds": 225.71,
      "duration_seconds": 2.31,
      "text": "I have high blood pressure."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.08,
      "end_seconds": 235.26,
      "duration_seconds": 8.18,
      "text": "Right, right. Okay, I can see high blood pressure in your file as well. Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 236.43,
      "end_seconds": 240.0,
      "duration_seconds": 3.57,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.4,
      "end_seconds": 262.49,
      "duration_seconds": 14.09,
      "text": "From what you've told me and what I found, I think we're dealing with medicine-induced postural hypotension at this stage. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 263.66,
      "end_seconds": 265.68,
      "duration_seconds": 2.02,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.26,
      "end_seconds": 273.87,
      "duration_seconds": 7.61,
      "text": "Nothing I've seen today points to an emergency. It looks like medicine-induced postural hypotension, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 292.71,
      "end_seconds": 303.61,
      "duration_seconds": 10.9,
      "text": "I'd like to arrange blood tests for syncope. We will move the prostate tablet to bedtime and you should rise slowly. I'll want another look in two weeks."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 307.34,
      "end_seconds": 309.42,
      "duration_seconds": 2.08,
      "text": "Okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 311.48,
      "end_seconds": 313.92,
      "duration_seconds": 2.44,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 315.09,
      "end_seconds": 318.88,
      "duration_seconds": 3.79,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}