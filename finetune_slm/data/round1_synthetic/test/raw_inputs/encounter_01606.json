{
  "schema_version": "1.0",
  "encounter_id": "01606",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.07,
      "end_seconds": 5.03,
      "duration_seconds": 3.96,
      "text": "Uh, sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.88,
      "end_seconds": 10.73,
      "duration_seconds": 3.85,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.34,
      "end_seconds": 21.5,
      "duration_seconds": 9.16,
      "text": "It's, It's coming on in seconds. I thought I'd wait, um, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.74,
      "end_seconds": 24.9,
      "duration_seconds": 2.16,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.47,
      "end_seconds": 28.35,
      "duration_seconds": 1.88,
      "text": "Probably three days. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.94,
      "end_seconds": 32.7,
      "duration_seconds": 2.76,
      "text": "Any a stiff neck as well?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.46,
      "end_seconds": 47.34,
      "duration_seconds": 13.88,
      "text": "Yeah, I've had that since Friday. As for stiff neck, it happens once or twice a day. There was vomiting, yes, but that went away."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.36,
      "end_seconds": 59.77,
      "duration_seconds": 4.41,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.23,
      "end_seconds": 69.19,
      "duration_seconds": 1.96,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.66,
      "end_seconds": 91.54,
      "duration_seconds": 7.88,
      "text": "Okay: SpO2 96 percent on room air, pressure 150 over 100, temperature 36.9. And heart rate 90."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.61,
      "end_seconds": 94.98,
      "duration_seconds": 2.37,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.5,
      "end_seconds": 111.17,
      "duration_seconds": 1.67,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.68,
      "end_seconds": 113.98,
      "duration_seconds": 1.3,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.88,
      "end_seconds": 131.71,
      "duration_seconds": 4.83,
      "text": "Your neck is stiff and you are very sensitive to light."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.01,
      "end_seconds": 135.71,
      "duration_seconds": 1.7,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.15,
      "end_seconds": 148.0,
      "duration_seconds": 0.85,
      "text": "Any fever?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.15,
      "end_seconds": 150.72,
      "duration_seconds": 1.57,
      "text": "No, no fever."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.75,
      "end_seconds": 155.01,
      "duration_seconds": 3.26,
      "text": "Any head injury or weakness at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.82,
      "end_seconds": 159.04,
      "duration_seconds": 3.22,
      "text": "Yeah, no, none that I've noticed."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.1,
      "end_seconds": 163.4,
      "duration_seconds": 2.3,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.86,
      "end_seconds": 165.91,
      "duration_seconds": 1.05,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.24,
      "end_seconds": 169.47,
      "duration_seconds": 2.23,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.49,
      "end_seconds": 173.58,
      "duration_seconds": 3.09,
      "text": "Actually, no, my breathing's been fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.64,
      "end_seconds": 180.08,
      "duration_seconds": 4.44,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.7,
      "end_seconds": 186.42,
      "duration_seconds": 4.72,
      "text": "I have acid reflux, for five years. Yes, migraines."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.51,
      "end_seconds": 194.5,
      "duration_seconds": 6.99,
      "text": "Okay, I can see acid reflux in your file as well. Let's run through your medicines."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.78,
      "end_seconds": 204.75,
      "duration_seconds": 8.97,
      "text": "Lansoprazole. I take it 30 milligrams, before breakfast. I, I take sumatriptan, 50 milligrams, when needed."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.37,
      "end_seconds": 208.29,
      "duration_seconds": 2.92,
      "text": "Roughly how long on that one?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.87,
      "end_seconds": 214.68,
      "duration_seconds": 5.81,
      "text": "Nearly five years now. I was on pantoprazole before. I stopped taking it."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.18,
      "end_seconds": 218.95,
      "duration_seconds": 2.77,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.83,
      "end_seconds": 223.63,
      "duration_seconds": 3.8,
      "text": "Just part of my thyroid removed, years back."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.68,
      "end_seconds": 227.82,
      "duration_seconds": 3.14,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.87,
      "end_seconds": 233.46,
      "duration_seconds": 3.59,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.25,
      "end_seconds": 236.68,
      "duration_seconds": 2.43,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.43,
      "end_seconds": 241.69,
      "duration_seconds": 3.26,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.02,
      "end_seconds": 247.59,
      "duration_seconds": 4.57,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.61,
      "end_seconds": 255.44,
      "duration_seconds": 6.83,
      "text": "I was told I'm allergic to erythromycin, but I don't remember what reaction I had."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.04,
      "end_seconds": 266.99,
      "duration_seconds": 9.95,
      "text": "Putting it all together, this is probably a possible bleed around the brain. I can't rule out a migraine yet."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.32,
      "end_seconds": 271.74,
      "duration_seconds": 3.42,
      "text": "I mean, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.39,
      "end_seconds": 296.9,
      "duration_seconds": 23.51,
      "text": "It's reasonable to be concerned, but right now a possible bleed around the brain is my leading thought, not anything worse. We should do an urgent CT scan of the head for thunderclap headache. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 298.1,
      "end_seconds": 302.12,
      "duration_seconds": 4.02,
      "text": "I can book that for Friday at 11:30 am."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.7,
      "end_seconds": 318.28,
      "duration_seconds": 15.58,
      "text": "I'm going to order a lumbar puncture, for thunderclap headache. It's a routine test and it'll give us a much clearer picture. This needs an emergency scan, an ambulance is on its way. Come back straight away."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.42,
      "end_seconds": 321.84,
      "duration_seconds": 2.42,
      "text": "Ah, that's fine with me."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.74,
      "end_seconds": 328.17,
      "duration_seconds": 4.43,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.26,
      "end_seconds": 334.66,
      "duration_seconds": 5.4,
      "text": "Right, you know, I'll do that. Thank you, doctor."
    }
  ]
}