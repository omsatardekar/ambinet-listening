{
  "schema_version": "1.0",
  "encounter_id": "01904",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.65,
      "end_seconds": 4.04,
      "duration_seconds": 3.39,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.06,
      "end_seconds": 10.55,
      "duration_seconds": 5.49,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.14,
      "end_seconds": 14.18,
      "duration_seconds": 2.04,
      "text": "It's chest pressure, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.67,
      "end_seconds": 18.85,
      "duration_seconds": 3.18,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.75,
      "end_seconds": 25.91,
      "duration_seconds": 3.16,
      "text": "Since Monday, that's when it began."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.4,
      "end_seconds": 31.14,
      "duration_seconds": 4.74,
      "text": "I follow. Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.93,
      "end_seconds": 34.49,
      "duration_seconds": 1.56,
      "text": "Severe, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.58,
      "end_seconds": 38.17,
      "duration_seconds": 1.59,
      "text": "Have you been sweating?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.25,
      "end_seconds": 47.09,
      "duration_seconds": 7.84,
      "text": "Erm, yes, about the same, three weeks. I've been feeling faint too, for ten days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.29,
      "end_seconds": 57.1,
      "duration_seconds": 4.81,
      "text": "Let me check a few things. Any fever, cough or leg swelling?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.54,
      "end_seconds": 62.04,
      "duration_seconds": 3.5,
      "text": "None of those, you know, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.0,
      "end_seconds": 66.07,
      "duration_seconds": 2.07,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.98,
      "end_seconds": 70.36,
      "duration_seconds": 2.38,
      "text": "Ah, no problems with breathing."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.48,
      "end_seconds": 75.43,
      "duration_seconds": 3.95,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.35,
      "end_seconds": 80.89,
      "duration_seconds": 4.54,
      "text": "I have heart disease, for nearly five years."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.73,
      "end_seconds": 83.32,
      "duration_seconds": 1.59,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.28,
      "end_seconds": 86.9,
      "duration_seconds": 2.62,
      "text": "Oh, I've had diabetes, yes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.1,
      "end_seconds": 95.09,
      "duration_seconds": 6.99,
      "text": "Okay, I can see heart disease and diabetes in your file as well. Any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.71,
      "end_seconds": 98.62,
      "duration_seconds": 1.91,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.16,
      "end_seconds": 117.2,
      "duration_seconds": 2.04,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.23,
      "end_seconds": 124.29,
      "duration_seconds": 6.06,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.53,
      "end_seconds": 130.73,
      "duration_seconds": 1.2,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.39,
      "end_seconds": 137.19,
      "duration_seconds": 2.8,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.01,
      "end_seconds": 140.75,
      "duration_seconds": 2.74,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.71,
      "end_seconds": 146.83,
      "duration_seconds": 4.12,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.57,
      "end_seconds": 168.62,
      "duration_seconds": 4.05,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.59,
      "end_seconds": 173.82,
      "duration_seconds": 3.23,
      "text": "Ah, not to my knowledge, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.68,
      "end_seconds": 178.27,
      "duration_seconds": 3.59,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.17,
      "end_seconds": 185.78,
      "duration_seconds": 3.61,
      "text": "Metoprolol. I take it twice a day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.63,
      "end_seconds": 192.6,
      "duration_seconds": 1.97,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.7,
      "end_seconds": 200.88,
      "duration_seconds": 6.18,
      "text": "50 milligrams, I think that's what's on the box. Glycomet, twice a day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.18,
      "end_seconds": 204.61,
      "duration_seconds": 2.43,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.45,
      "end_seconds": 208.5,
      "duration_seconds": 2.05,
      "text": "It's, It's 500 milligrams."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.37,
      "end_seconds": 212.81,
      "duration_seconds": 2.44,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.85,
      "end_seconds": 227.03,
      "duration_seconds": 2.18,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.0,
      "end_seconds": 245.77,
      "duration_seconds": 5.77,
      "text": "Okay: heart rate 107, pressure 104 over 62, temperature is 36.8 degrees."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.97,
      "end_seconds": 251.12,
      "duration_seconds": 4.15,
      "text": "Alright, I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.0,
      "end_seconds": 255.46,
      "duration_seconds": 2.46,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.81,
      "end_seconds": 268.9,
      "duration_seconds": 6.09,
      "text": "Your pulse is over one hundred and eighty and your blood pressure is low."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.96,
      "end_seconds": 272.81,
      "duration_seconds": 1.85,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.04,
      "end_seconds": 297.07,
      "duration_seconds": 9.03,
      "text": "Right, here's what I'm thinking. I'd lean towards a dangerous fast heart rhythm. I'll request blood tests, it'll help with arrhythmia."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.59,
      "end_seconds": 299.93,
      "duration_seconds": 2.34,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.1,
      "end_seconds": 326.57,
      "duration_seconds": 25.47,
      "text": "I'd like to arrange an urgent ECG for fast heart rhythm. Lie flat, I am calling the emergency team and preparing to shock the heart. I think the emergency team should see you too. Please come and see me straight away. Can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.1,
      "end_seconds": 332.32,
      "duration_seconds": 5.22,
      "text": "So, I come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.77,
      "end_seconds": 339.63,
      "duration_seconds": 5.86,
      "text": "Yes, exactly right. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.08,
      "end_seconds": 344.46,
      "duration_seconds": 3.38,
      "text": "Okay, so alright, thanks, take care."
    }
  ]
}