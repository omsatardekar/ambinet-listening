{
  "schema_version": "1.0",
  "encounter_id": "02810",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.88,
      "end_seconds": 4.4,
      "duration_seconds": 3.52,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.48,
      "end_seconds": 10.66,
      "duration_seconds": 4.18,
      "text": "of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.9,
      "end_seconds": 23.73,
      "duration_seconds": 11.83,
      "text": "I've been dealing with severe tummy pain out of proportion to the examination. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.41,
      "end_seconds": 28.78,
      "duration_seconds": 3.37,
      "text": "Right, how long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.03,
      "end_seconds": 37.77,
      "duration_seconds": 7.74,
      "text": "Probably about three months. Yeah. Work has been very busy so I kept ignoring it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.68,
      "end_seconds": 47.99,
      "duration_seconds": 9.31,
      "text": "So, can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.59,
      "end_seconds": 57.3,
      "duration_seconds": 8.71,
      "text": "It's a few times a day. I'd give it a six, uh, out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.14,
      "end_seconds": 60.32,
      "duration_seconds": 2.18,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.95,
      "end_seconds": 68.07,
      "duration_seconds": 7.12,
      "text": "When it starts I tend to get vomiting as well. About vomiting, severe, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.28,
      "end_seconds": 73.57,
      "duration_seconds": 5.29,
      "text": "Yes, carry on. What do you take on a a normal day?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.57,
      "end_seconds": 80.76,
      "duration_seconds": 6.19,
      "text": "It's apixaban, 5 milligrams, maybe, twice a day for the heart rhythm."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.67,
      "end_seconds": 87.07,
      "duration_seconds": 4.4,
      "text": "have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.45,
      "end_seconds": 92.87,
      "duration_seconds": 4.42,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.34,
      "end_seconds": 95.67,
      "duration_seconds": 1.33,
      "text": "what about alcohol?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.59,
      "end_seconds": 102.9,
      "duration_seconds": 5.31,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.86,
      "end_seconds": 105.75,
      "duration_seconds": 0.89,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.83,
      "end_seconds": 116.08,
      "duration_seconds": 4.25,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.99,
      "end_seconds": 121.87,
      "duration_seconds": 3.88,
      "text": "right, what do you do during the day?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.97,
      "end_seconds": 126.7,
      "duration_seconds": 3.73,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.08,
      "end_seconds": 130.5,
      "duration_seconds": 2.42,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.66,
      "end_seconds": 140.34,
      "duration_seconds": 3.68,
      "text": "I'm vegetarian and have been for years"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.24,
      "end_seconds": 151.56,
      "duration_seconds": 3.32,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.49,
      "end_seconds": 157.29,
      "duration_seconds": 2.8,
      "text": "My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.1,
      "end_seconds": 167.41,
      "duration_seconds": 8.31,
      "text": "Are you allergic to anything? Any allergies to medicines or foods? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.66,
      "end_seconds": 176.93,
      "duration_seconds": 8.27,
      "text": "I had a reaction to amoxicillin when I was younger, hives, and I've avoided it since."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.09,
      "end_seconds": 181.48,
      "duration_seconds": 3.39,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.42,
      "end_seconds": 200.99,
      "duration_seconds": 18.57,
      "text": "I had a cataract operation in my left eye about a year ago. A neighbour of mine said I should see someone about it. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.45,
      "end_seconds": 206.35,
      "duration_seconds": 3.9,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.59,
      "end_seconds": 224.63,
      "duration_seconds": 17.04,
      "text": "I've had an irregular heartbeat for two years now. Let me think, yes, diabetes. I've been reading about it online and and it worried me. My family kept telling me to get it checked"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.67,
      "end_seconds": 235.9,
      "duration_seconds": 10.23,
      "text": "Yes, carry on. Okay, I can see diabetes in your file as well. Have you noticed chest pain, hernia or fever?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.1,
      "end_seconds": 240.48,
      "duration_seconds": 3.38,
      "text": "No, nothing to to report there."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.34,
      "end_seconds": 245.39,
      "duration_seconds": 4.05,
      "text": "Alright, how about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.25,
      "end_seconds": 249.03,
      "duration_seconds": 2.78,
      "text": "no, nothing with my heart"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.97,
      "end_seconds": 253.33,
      "duration_seconds": 3.36,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.11,
      "end_seconds": 256.04,
      "duration_seconds": 1.93,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.32,
      "end_seconds": 272.0,
      "duration_seconds": 2.68,
      "text": "let me take your readings now"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.85,
      "end_seconds": 287.76,
      "duration_seconds": 2.91,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.05,
      "end_seconds": 309.13,
      "duration_seconds": 10.08,
      "text": "okay: temperature is 36.8 degrees, heart rate 121, oxygen saturation is 98 percent. And blood pressure 122 over 73, respiratory rate 17."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.99,
      "end_seconds": 311.58,
      "duration_seconds": 1.59,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.51,
      "end_seconds": 316.09,
      "duration_seconds": 3.58,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.28,
      "end_seconds": 323.14,
      "duration_seconds": 4.86,
      "text": "so, I'd like to check you over now, if that's alright"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.9,
      "end_seconds": 325.54,
      "duration_seconds": 1.64,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.67,
      "end_seconds": 329.8,
      "duration_seconds": 3.13,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.19,
      "end_seconds": 347.03,
      "duration_seconds": 8.84,
      "text": "Your pulse is irregular, the tummy is soft but terribly painful, and the pain is out of proportion to what I find."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.38,
      "end_seconds": 358.41,
      "duration_seconds": 8.03,
      "text": "Thank you, you can get dressed. Putting it all together, my working impression is possible bowel ischaemia."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 374.95,
      "end_seconds": 378.75,
      "duration_seconds": 3.8,
      "text": "Let's get urgent blood tests, for severe abdominal pain."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 380.33,
      "end_seconds": 382.97,
      "duration_seconds": 2.64,
      "text": "The earliest is Monday, 11:30 am."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 384.73,
      "end_seconds": 398.96,
      "duration_seconds": 14.23,
      "text": "This is an emergency, you are gonna hospital now. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 400.34,
      "end_seconds": 401.87,
      "duration_seconds": 1.53,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 403.0,
      "end_seconds": 409.04,
      "duration_seconds": 6.04,
      "text": "Come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 410.12,
      "end_seconds": 413.14,
      "duration_seconds": 3.02,
      "text": "yes, I'll bear that in mind"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 413.85,
      "end_seconds": 420.21,
      "duration_seconds": 6.36,
      "text": "I'll want another look straight away. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 420.94,
      "end_seconds": 423.35,
      "duration_seconds": 2.41,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 424.1,
      "end_seconds": 425.37,
      "duration_seconds": 1.27,
      "text": "all the best"
    }
  ]
}