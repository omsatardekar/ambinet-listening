{
  "schema_version": "1.0",
  "encounter_id": "01062",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.2,
      "end_seconds": 6.08,
      "duration_seconds": 4.88,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.9,
      "end_seconds": 16.29,
      "duration_seconds": 4.39,
      "text": "not at all please sit what seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.95,
      "end_seconds": 28.12,
      "duration_seconds": 11.17,
      "text": "I wanted to get scaly red plaques on my elbows looked at. I didn't wanna make a fuss you know"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.95,
      "end_seconds": 36.29,
      "duration_seconds": 3.34,
      "text": "can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.72,
      "end_seconds": 40.04,
      "duration_seconds": 2.32,
      "text": "About... well about four days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.82,
      "end_seconds": 49.68,
      "duration_seconds": 8.86,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.57,
      "end_seconds": 56.66,
      "duration_seconds": 6.09,
      "text": "it settles a little with moisturiser i notice it more with stress"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.45,
      "end_seconds": 60.25,
      "duration_seconds": 2.8,
      "text": "Has there been pitted nails too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.64,
      "end_seconds": 64.34,
      "duration_seconds": 2.7,
      "text": "yeah. Four weeks, I'd say"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.9,
      "end_seconds": 68.63,
      "duration_seconds": 3.73,
      "text": "shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.21,
      "end_seconds": 81.76,
      "duration_seconds": 2.55,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.54,
      "end_seconds": 109.07,
      "duration_seconds": 8.53,
      "text": "Okay: pulse 73, oxygen saturation is 99 percent, respiratory rate 15, temperature 36.4, pressure 112 over 82."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.07,
      "end_seconds": 112.5,
      "duration_seconds": 1.43,
      "text": "is that normal?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.59,
      "end_seconds": 116.64,
      "duration_seconds": 2.05,
      "text": "we'll go over that shortly"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.3,
      "end_seconds": 121.86,
      "duration_seconds": 3.56,
      "text": "let me look at the area I'll be gentle"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.5,
      "end_seconds": 124.95,
      "duration_seconds": 1.45,
      "text": "breathe out slowly"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.99,
      "end_seconds": 148.3,
      "duration_seconds": 6.31,
      "text": "there are well-defined silvery plaques on both elbows and a few pits in the nails"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.88,
      "end_seconds": 159.95,
      "duration_seconds": 8.07,
      "text": "that's all I needed to check let me check a few things any joint pain or fever?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.75,
      "end_seconds": 163.56,
      "duration_seconds": 2.81,
      "text": "no, no joint pain or fever"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.58,
      "end_seconds": 166.48,
      "duration_seconds": 0.9,
      "text": "any pus?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.14,
      "end_seconds": 169.51,
      "duration_seconds": 1.37,
      "text": "no no pus"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.82,
      "end_seconds": 172.82,
      "duration_seconds": 2.0,
      "text": "your breathing any trouble there?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.79,
      "end_seconds": 176.71,
      "duration_seconds": 1.92,
      "text": "no problems with breathing"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.99,
      "end_seconds": 179.48,
      "duration_seconds": 1.49,
      "text": "neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.04,
      "end_seconds": 182.16,
      "duration_seconds": 2.12,
      "text": "no that's all normal"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.05,
      "end_seconds": 200.62,
      "duration_seconds": 2.57,
      "text": "Okay tell me your medicines please."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.96,
      "end_seconds": 221.02,
      "duration_seconds": 15.06,
      "text": "Metoprolol i take it 50 milligrams, twice a day for my pressure it's aspirin, 75 milligrams, once a day i take a plain emollient, twice a day"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.09,
      "end_seconds": 237.51,
      "duration_seconds": 2.42,
      "text": "before we go further any allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.53,
      "end_seconds": 240.73,
      "duration_seconds": 2.2,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.25,
      "end_seconds": 257.21,
      "duration_seconds": 2.96,
      "text": "have you been to theatre before?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.21,
      "end_seconds": 268.56,
      "duration_seconds": 9.35,
      "text": "yes I had a triple bypass eight years ago. I didn't want to bother you but it keeps coming back"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.2,
      "end_seconds": 272.28,
      "duration_seconds": 2.08,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.39,
      "end_seconds": 279.52,
      "duration_seconds": 6.13,
      "text": "I've had high blood pressure for five years now. I have heart disease."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.24,
      "end_seconds": 285.24,
      "duration_seconds": 5.0,
      "text": "okay, I can see high blood pressure in your file as well"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.74,
      "end_seconds": 300.08,
      "duration_seconds": 3.34,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.99,
      "end_seconds": 314.24,
      "duration_seconds": 13.25,
      "text": "I only drink at family occasions. I'm vegetarian and have been for years. Not much, I mostly stay in these days. My partner and our baby"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.47,
      "end_seconds": 340.8,
      "duration_seconds": 25.33,
      "text": "Let me tell you where I've got to. This is probably plaque psoriasis. I want to be honest that this is an impression, not a final answer. I'm prescribing calcipotriol and betamethasone, 50 micrograms/0.5 mg per g, once a day, four weeks. That's for psoriasis. Keep the skin well moisturised and avoid picking the plaques. Let's plan a check in four weeks."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.46,
      "end_seconds": 343.27,
      "duration_seconds": 1.81,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.82,
      "end_seconds": 347.76,
      "duration_seconds": 2.94,
      "text": "does all of that make sense?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.44,
      "end_seconds": 351.25,
      "duration_seconds": 2.81,
      "text": "that's clear, um, thanks"
    }
  ]
}