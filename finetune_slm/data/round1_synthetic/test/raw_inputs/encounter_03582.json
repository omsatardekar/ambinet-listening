{
  "schema_version": "1.0",
  "encounter_id": "03582",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.18,
      "end_seconds": 9.02,
      "duration_seconds": 7.84,
      "text": "Doctor, you know, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.87,
      "end_seconds": 14.53,
      "duration_seconds": 3.66,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.71,
      "end_seconds": 21.88,
      "duration_seconds": 4.17,
      "text": "I've been feeling tired and run down."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.79,
      "end_seconds": 27.98,
      "duration_seconds": 4.19,
      "text": "Are you taking anything regularly, including from the the pharmacy?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.34,
      "end_seconds": 33.92,
      "duration_seconds": 4.58,
      "text": "I take febuxostat, 80 milligrams, once a day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 34.86,
      "end_seconds": 39.88,
      "duration_seconds": 5.02,
      "text": "doctor, our chart from the last visit lists it as 160 milligrams"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.98,
      "end_seconds": 45.14,
      "duration_seconds": 4.16,
      "text": "I see. Is the most recent prescription on you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.57,
      "end_seconds": 53.5,
      "duration_seconds": 6.93,
      "text": "ah, no, I left it at home. It's furosemide, 40 milligrams, every morning"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.22,
      "end_seconds": 60.24,
      "duration_seconds": 5.02,
      "text": "when did this begin? These questions might sound routine, but they matter"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.86,
      "end_seconds": 64.96,
      "duration_seconds": 4.1,
      "text": "Mm, it's been like this since this morning."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.95,
      "end_seconds": 68.62,
      "duration_seconds": 2.67,
      "text": "does anything else come with it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.49,
      "end_seconds": 76.25,
      "duration_seconds": 5.76,
      "text": "Night sweats goes along with it, most of the time"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.88,
      "end_seconds": 80.82,
      "duration_seconds": 3.94,
      "text": "Any back pain that doesn't go away as well?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.2,
      "end_seconds": 89.39,
      "duration_seconds": 7.19,
      "text": "Mm, yes. I'd been losing a bit of weight, but that went away."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.84,
      "end_seconds": 93.6,
      "duration_seconds": 2.76,
      "text": "Any leg weakness or high fever?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.42,
      "end_seconds": 99.6,
      "duration_seconds": 5.18,
      "text": "No leg weakness or high fever, none of it."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.75,
      "end_seconds": 104.18,
      "duration_seconds": 3.43,
      "text": "have you had any breathlessness or chest pain?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.28,
      "end_seconds": 109.65,
      "duration_seconds": 3.37,
      "text": "No, no breathlessness or chest pain."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.41,
      "end_seconds": 114.78,
      "duration_seconds": 3.37,
      "text": "So, is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.3,
      "end_seconds": 120.19,
      "duration_seconds": 3.89,
      "text": "that's normal as far as I know"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.49,
      "end_seconds": 131.24,
      "duration_seconds": 2.75,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.31,
      "end_seconds": 142.1,
      "duration_seconds": 9.79,
      "text": "yes, diclofenac, it gives me swelling of my lips. Plasters. I come out in... well, a red itchy rash"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.88,
      "end_seconds": 158.74,
      "duration_seconds": 4.86,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.63,
      "end_seconds": 162.94,
      "duration_seconds": 3.31,
      "text": "Yes, thin bones. I've got gout."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.49,
      "end_seconds": 165.19,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.57,
      "end_seconds": 168.68,
      "duration_seconds": 2.11,
      "text": "I've got heart failure."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.91,
      "end_seconds": 179.74,
      "duration_seconds": 9.83,
      "text": "yes, heart failure is known to us, good to to have that clear. Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.78,
      "end_seconds": 185.64,
      "duration_seconds": 4.86,
      "text": "my sister had breast cancer. My grandfather had a stroke"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.0,
      "end_seconds": 188.31,
      "duration_seconds": 1.31,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.21,
      "end_seconds": 192.14,
      "duration_seconds": 1.93,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.34,
      "end_seconds": 194.6,
      "duration_seconds": 1.26,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.33,
      "end_seconds": 199.01,
      "duration_seconds": 3.68,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.27,
      "end_seconds": 205.68,
      "duration_seconds": 2.41,
      "text": "tell me about your eating"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.98,
      "end_seconds": 213.69,
      "duration_seconds": 6.71,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.27,
      "end_seconds": 218.42,
      "duration_seconds": 3.15,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.33,
      "end_seconds": 222.5,
      "duration_seconds": 3.17,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.28,
      "end_seconds": 226.16,
      "duration_seconds": 2.88,
      "text": "anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.73,
      "end_seconds": 235.74,
      "duration_seconds": 4.01,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 236.45,
      "end_seconds": 250.92,
      "duration_seconds": 14.47,
      "text": "Doctor, I've got the readings for you. Temperature 38.2, weight 60 kilos. Pulse is 98 beats a minute, height 182 centimetres, BMI works out to 18.1, blood pressure 120 over 77."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.7,
      "end_seconds": 253.76,
      "duration_seconds": 1.06,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.58,
      "end_seconds": 260.94,
      "duration_seconds": 5.36,
      "text": "Right, I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.52,
      "end_seconds": 262.62,
      "duration_seconds": 1.1,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.25,
      "end_seconds": 266.67,
      "duration_seconds": 2.42,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.52,
      "end_seconds": 286.95,
      "duration_seconds": 7.43,
      "text": "There is a soft heart murmur you've not had before and a small tender spot on the fingertip."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.42,
      "end_seconds": 307.69,
      "duration_seconds": 15.27,
      "text": "all finished, thank you let me tell you where I've got to i'm honestly not certain yet it could be possible infection of the heart valve causing back and general symptoms, or it might be a muscle strain"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.08,
      "end_seconds": 312.54,
      "duration_seconds": 3.46,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.7,
      "end_seconds": 327.29,
      "duration_seconds": 10.59,
      "text": "it's reasonable to be concerned, but right now possible infection of the heart valve causing back and general symptoms is my leading thought, not anything worse"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.37,
      "end_seconds": 374.64,
      "duration_seconds": 30.27,
      "text": "Let's get blood cultures, for possible endocarditis. I want an echocardiogram done, that's for new murmur. Let's get an MRI of the spine, for persistent back pain with systemic symptoms. This is not an ordinary back strain, so I want tests today. We'll refer you to the medical admissions unit. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 375.32,
      "end_seconds": 379.31,
      "duration_seconds": 3.99,
      "text": "Okay, um, I'll look out for that."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.66,
      "end_seconds": 385.85,
      "duration_seconds": 5.19,
      "text": "come back or go to emergency straight away if the symptoms get worse"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 389.38,
      "end_seconds": 394.28,
      "duration_seconds": 4.9,
      "text": "um, okay, I'll look out for that"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 395.84,
      "end_seconds": 400.53,
      "duration_seconds": 4.69,
      "text": "I'll want another look straight away. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 401.17,
      "end_seconds": 405.31,
      "duration_seconds": 4.14,
      "text": "Okay, so great, thank you for your help."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 405.82,
      "end_seconds": 407.09,
      "duration_seconds": 1.27,
      "text": "Take care now."
    }
  ]
}