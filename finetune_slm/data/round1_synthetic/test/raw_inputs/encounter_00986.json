{
  "schema_version": "1.0",
  "encounter_id": "00986",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 0.48,
      "end_seconds": 6.74,
      "duration_seconds": 6.26,
      "text": "Hello Tamsin, come in. How far along are you now? ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 8.44,
      "end_seconds": 17.64,
      "duration_seconds": 9.2,
      "text": "Twenty-four weeks. I'm here for the asthma, the midwife said I should have a review."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.84,
      "end_seconds": 22.75,
      "duration_seconds": 3.91,
      "text": "Good plan. How's your breathing been?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.87,
      "end_seconds": 29.99,
      "duration_seconds": 5.12,
      "text": "A bit wheezy at night. Not every night."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.41,
      "end_seconds": 33.99,
      "duration_seconds": 2.58,
      "text": "And during the day?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.92,
      "end_seconds": 40.89,
      "duration_seconds": 4.97,
      "text": "A little short of breath on the stairs at work."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "UNKNOWN",
      "start_seconds": 43.1,
      "end_seconds": 47.72,
      "duration_seconds": 4.62,
      "text": "[from the corridor] She's been coughing all week!"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.66,
      "end_seconds": 53.89,
      "duration_seconds": 3.23,
      "text": "Sorry, who was that? ~"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.6,
      "end_seconds": 59.25,
      "duration_seconds": 3.65,
      "text": "No idea, doctor. Someone passing. ~"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.28,
      "end_seconds": 69.35,
      "duration_seconds": 8.07,
      "text": "I'll note a voice from the corridor says you've coughed all week. Is that right?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.06,
      "end_seconds": 73.68,
      "duration_seconds": 3.62,
      "text": "A bit, yes. A dry tickly one."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.53,
      "end_seconds": 76.79,
      "duration_seconds": 2.26,
      "text": "Any chest pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.52,
      "end_seconds": 80.74,
      "duration_seconds": 2.22,
      "text": "No chest pain."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.73,
      "end_seconds": 85.2,
      "duration_seconds": 1.47,
      "text": "Fever?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.11,
      "end_seconds": 87.59,
      "duration_seconds": 1.48,
      "text": "No fever."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.25,
      "end_seconds": 92.66,
      "duration_seconds": 3.41,
      "text": "Any swelling in your legs?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.42,
      "end_seconds": 96.16,
      "duration_seconds": 1.74,
      "text": "No swelling."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.65,
      "end_seconds": 100.87,
      "duration_seconds": 3.22,
      "text": "What do you use for it?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.55,
      "end_seconds": 108.56,
      "duration_seconds": 6.01,
      "text": "Budesonide, 200 micrograms, twice a day, and salbutamol when I'm wheezy."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.46,
      "end_seconds": 112.91,
      "duration_seconds": 1.45,
      "text": "And allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.2,
      "end_seconds": 117.57,
      "duration_seconds": 3.37,
      "text": "Penicillin. I get a rash."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.16,
      "end_seconds": 122.75,
      "duration_seconds": 2.59,
      "text": "Any other conditions?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.64,
      "end_seconds": 130.72,
      "duration_seconds": 6.08,
      "text": "Asthma, since I was a kid, and hay fever."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.73,
      "end_seconds": 133.75,
      "duration_seconds": 1.02,
      "text": "Operations?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.27,
      "end_seconds": 138.32,
      "duration_seconds": 3.05,
      "text": "Tonsils, when I was ten."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.13,
      "end_seconds": 143.83,
      "duration_seconds": 3.7,
      "text": "Asthma or allergies in the family?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.48,
      "end_seconds": 150.34,
      "duration_seconds": 4.86,
      "text": "My mum has asthma, and my sister has eczema."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.26,
      "end_seconds": 153.6,
      "duration_seconds": 2.34,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.82,
      "end_seconds": 156.76,
      "duration_seconds": 0.94,
      "text": "Never."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.92,
      "end_seconds": 162.46,
      "duration_seconds": 3.54,
      "text": "What do you do for work?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.64,
      "end_seconds": 167.25,
      "duration_seconds": 2.61,
      "text": "I'm a physiotherapist."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.35,
      "end_seconds": 170.18,
      "duration_seconds": 1.83,
      "text": "And exercise?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.05,
      "end_seconds": 173.82,
      "duration_seconds": 2.77,
      "text": "Prenatal yoga, twice a week."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.26,
      "end_seconds": 204.31,
      "duration_seconds": 13.05,
      "text": "Let me check you. Pulse 84, blood pressure 112 over 68, temperature 36.7, oxygen 98 percent, breathing 18, and weight 72 kilos."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.69,
      "end_seconds": 207.27,
      "duration_seconds": 1.58,
      "text": "Good? ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.08,
      "end_seconds": 226.12,
      "duration_seconds": 6.04,
      "text": "Good. Take a deep breath in and out for me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.89,
      "end_seconds": 235.91,
      "duration_seconds": 7.02,
      "text": "I can hear a little wheeze at the end of each breath out."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.39,
      "end_seconds": 241.02,
      "duration_seconds": 2.63,
      "text": "That's the one. ~"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.99,
      "end_seconds": 252.06,
      "duration_seconds": 8.07,
      "text": "Your chest is moving equally on both sides, and your heart sounds are normal."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.41,
      "end_seconds": 254.69,
      "duration_seconds": 1.28,
      "text": "Good. ~"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.47,
      "end_seconds": 259.44,
      "duration_seconds": 3.97,
      "text": "And there's no swelling in your ankles."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.73,
      "end_seconds": 264.37,
      "duration_seconds": 2.64,
      "text": "That's a relief. ~"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.57,
      "end_seconds": 269.22,
      "duration_seconds": 2.65,
      "text": "Any palpitations, any fluttering?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.63,
      "end_seconds": 273.96,
      "duration_seconds": 2.33,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.67,
      "end_seconds": 284.99,
      "duration_seconds": 9.32,
      "text": "What I'm hearing is that your asthma control is a little worse in pregnancy, which is common."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.01,
      "end_seconds": 290.64,
      "duration_seconds": 3.63,
      "text": "Is it safe for the baby? ~"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.62,
      "end_seconds": 302.33,
      "duration_seconds": 9.71,
      "text": "Yes, the biggest risk to the baby is uncontrolled asthma, not the medicine. Keep using your inhalers."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.79,
      "end_seconds": 306.12,
      "duration_seconds": 2.33,
      "text": "That's reassuring. ~"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.46,
      "end_seconds": 318.78,
      "duration_seconds": 10.32,
      "text": "I'd like to arrange spirometry to check your lungs, and a blood count, since you're in the second trimester."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.55,
      "end_seconds": 321.62,
      "duration_seconds": 2.07,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.5,
      "end_seconds": 328.09,
      "duration_seconds": 5.59,
      "text": "I'd like to see you again in four weeks."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.08,
      "end_seconds": 334.74,
      "duration_seconds": 3.66,
      "text": "Four weeks. Thanks, doctor. ~"
    }
  ]
}
