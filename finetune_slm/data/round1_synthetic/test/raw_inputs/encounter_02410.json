{
  "schema_version": "1.0",
  "encounter_id": "02410",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.56,
      "end_seconds": 4.44,
      "duration_seconds": 3.88,
      "text": "morning, doctor. I've settled them in, ready when you are"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.36,
      "end_seconds": 10.64,
      "duration_seconds": 5.28,
      "text": "okay thank you good morning tell me what's been going on"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.67,
      "end_seconds": 16.51,
      "duration_seconds": 4.84,
      "text": "Well good morning doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.27,
      "end_seconds": 20.66,
      "duration_seconds": 3.39,
      "text": "Good that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 22.33,
      "end_seconds": 27.61,
      "duration_seconds": 5.28,
      "text": "So I'm here because of a very fast heartbeat."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.35,
      "end_seconds": 33.7,
      "duration_seconds": 4.35,
      "text": "so what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 34.8,
      "end_seconds": 44.22,
      "duration_seconds": 9.42,
      "text": "I'm on atorvastatin 20 milligrams at night. I take hydrocortisone cream when needed. I take propranolol twice a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.7,
      "end_seconds": 50.96,
      "duration_seconds": 2.26,
      "text": "how much do you take?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 53.0,
      "end_seconds": 63.2,
      "duration_seconds": 10.2,
      "text": "It's, It's 40 milligrams. I'm on Asthalin inhaler, when needed. Before this I was on Seretide inhaler; that's been stopped."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.23,
      "end_seconds": 68.89,
      "duration_seconds": 3.66,
      "text": "What's the timeline, when did it it begin?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 69.73,
      "end_seconds": 73.42,
      "duration_seconds": 3.69,
      "text": "erm, it's been one week now"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.42,
      "end_seconds": 78.21,
      "duration_seconds": 2.79,
      "text": "Would you say mild moderate or severe?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 79.45,
      "end_seconds": 86.14,
      "duration_seconds": 6.69,
      "text": "Let me think, maybe a eight out of ten on a bad day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 86.66,
      "end_seconds": 93.57,
      "duration_seconds": 6.91,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 93.67,
      "end_seconds": 100.75,
      "duration_seconds": 7.08,
      "text": "sorry to cut in doctor quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.53,
      "end_seconds": 104.77,
      "duration_seconds": 2.24,
      "text": "later, thanks. Please go on"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 106.42,
      "end_seconds": 118.44,
      "duration_seconds": 12.02,
      "text": "oh, and agitation that's been about the same, three days oh, about agitation, maybe a seven out of ten on a bad day"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.05,
      "end_seconds": 124.14,
      "duration_seconds": 4.09,
      "text": "have you had any chest pain or recent infection?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 126.23,
      "end_seconds": 139.93,
      "duration_seconds": 13.7,
      "text": "Oh, no, no chest pain, no recent infection. I did have vomiting and diarrhoea at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.61,
      "end_seconds": 144.24,
      "duration_seconds": 2.63,
      "text": "any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 144.78,
      "end_seconds": 145.82,
      "duration_seconds": 1.04,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.38,
      "end_seconds": 147.82,
      "duration_seconds": 1.44,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 149.35,
      "end_seconds": 150.97,
      "duration_seconds": 1.62,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.69,
      "end_seconds": 153.64,
      "duration_seconds": 1.95,
      "text": "and alcohol, how much?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 155.15,
      "end_seconds": 160.71,
      "duration_seconds": 5.56,
      "text": "I used to drink heavily but I stopped four years ago"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.21,
      "end_seconds": 163.05,
      "duration_seconds": 0.84,
      "text": "any smoking?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 163.92,
      "end_seconds": 167.02,
      "duration_seconds": 3.1,
      "text": "I gave up cigarettes last spring"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.89,
      "end_seconds": 169.14,
      "duration_seconds": 1.25,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 171.1,
      "end_seconds": 175.82,
      "duration_seconds": 4.72,
      "text": "I'm a plumber, lots of bending and kneeling"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.37,
      "end_seconds": 181.97,
      "duration_seconds": 4.6,
      "text": "any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 182.85,
      "end_seconds": 185.39,
      "duration_seconds": 2.54,
      "text": "my sister had breast cancer"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.66,
      "end_seconds": 190.76,
      "duration_seconds": 4.1,
      "text": "any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 191.78,
      "end_seconds": 196.24,
      "duration_seconds": 4.46,
      "text": "yes, wheat, it gives me itchy skin"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.16,
      "end_seconds": 200.76,
      "duration_seconds": 3.6,
      "text": "tell me about any past illnesses or ongoing conditions"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 202.72,
      "end_seconds": 208.8,
      "duration_seconds": 6.08,
      "text": "High cholesterol for two years. Let me think I've had eczema yes."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.36,
      "end_seconds": 210.15,
      "duration_seconds": 0.79,
      "text": "Mm okay."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 211.45,
      "end_seconds": 231.09,
      "duration_seconds": 19.64,
      "text": "ah, you know, I've had migraines for nearly five years now i wasn't sure whether to come in at all, to be honest i didn't want to make a fuss, you know"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.05,
      "end_seconds": 233.75,
      "duration_seconds": 0.7,
      "text": "sure"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 234.52,
      "end_seconds": 241.31,
      "duration_seconds": 6.79,
      "text": "Sorry what was I saying I've had asthma for about ten years now."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.4,
      "end_seconds": 249.06,
      "duration_seconds": 6.66,
      "text": "Okay, I can see asthma in your file as well. Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 249.77,
      "end_seconds": 261.44,
      "duration_seconds": 11.67,
      "text": "yes, I had keyhole surgery on my gallbladder, two years back i'm not great at remembering details, so bear with me"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 262.66,
      "end_seconds": 272.15,
      "duration_seconds": 9.49,
      "text": "doctor, I've got the readings for you saturation 98 percent, pressure 113 over 71, pulse 106, temperature is 39.2 degrees, respiratory rate 21."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.94,
      "end_seconds": 274.9,
      "duration_seconds": 0.96,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.8,
      "end_seconds": 279.91,
      "duration_seconds": 2.11,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 281.77,
      "end_seconds": 282.47,
      "duration_seconds": 0.7,
      "text": "right"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.71,
      "end_seconds": 285.18,
      "duration_seconds": 1.47,
      "text": "look straight ahead"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.27,
      "end_seconds": 308.43,
      "duration_seconds": 7.16,
      "text": "you are hot, shaking, and your pulse is over one hundred and forty and irregular"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.25,
      "end_seconds": 315.32,
      "duration_seconds": 2.07,
      "text": "you can sit up now"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.93,
      "end_seconds": 333.42,
      "duration_seconds": 8.49,
      "text": "From what you've told me and what I found, this is probably a thyroid storm. Sepsis is also on my list."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 339.18,
      "end_seconds": 341.35,
      "duration_seconds": 2.17,
      "text": "is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.24,
      "end_seconds": 351.4,
      "duration_seconds": 9.16,
      "text": "Nothing I've seen today points to an emergency. It looks like a thyroid storm, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.34,
      "end_seconds": 374.99,
      "duration_seconds": 8.65,
      "text": "let's book an ECG to look into fast heart rhythm. I think urgent blood tests makes sense here, for thyroid storm"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 376.45,
      "end_seconds": 379.01,
      "duration_seconds": 2.56,
      "text": "how long will it take?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.23,
      "end_seconds": 399.9,
      "duration_seconds": 19.67,
      "text": "this is an emergency, you will be treated in high dependency try to get to bed and wake up at the same time each day, and keep your phone away from the bed the emergency team would be the the right next step, I'll refer you"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 403.25,
      "end_seconds": 406.42,
      "duration_seconds": 3.17,
      "text": "oh, sure, where do I go?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 407.18,
      "end_seconds": 409.08,
      "duration_seconds": 1.9,
      "text": "come back straight away"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 409.99,
      "end_seconds": 412.2,
      "duration_seconds": 2.21,
      "text": "Okay I'll arrange it."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 417.53,
      "end_seconds": 421.38,
      "duration_seconds": 3.85,
      "text": "that's everything on my side anything you're unsure about?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 422.09,
      "end_seconds": 425.3,
      "duration_seconds": 3.21,
      "text": "good, thanks, I'll see you then"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 427.13,
      "end_seconds": 428.43,
      "duration_seconds": 1.3,
      "text": "look after yourself"
    }
  ]
}