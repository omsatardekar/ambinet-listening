{
  "schema_version": "1.0",
  "encounter_id": "03580",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.59,
      "end_seconds": 5.02,
      "duration_seconds": 4.43,
      "text": "Morning, uh, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.77,
      "end_seconds": 10.07,
      "duration_seconds": 4.3,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.68,
      "end_seconds": 17.46,
      "duration_seconds": 5.78,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.23,
      "end_seconds": 23.29,
      "duration_seconds": 4.06,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 24.54,
      "end_seconds": 29.29,
      "duration_seconds": 4.75,
      "text": "Doctor, it's been feeling tired. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.73,
      "end_seconds": 34.65,
      "duration_seconds": 2.92,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.98,
      "end_seconds": 42.16,
      "duration_seconds": 3.18,
      "text": "Around about a month, I think."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 43.44,
      "end_seconds": 48.09,
      "duration_seconds": 4.65,
      "text": "I think it's been nearer about two months, actually."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.23,
      "end_seconds": 54.28,
      "duration_seconds": 5.05,
      "text": "Okay, so roughly one to two months. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.78,
      "end_seconds": 56.88,
      "duration_seconds": 2.1,
      "text": "I suppose so, yes."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.41,
      "end_seconds": 60.78,
      "duration_seconds": 3.37,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.49,
      "end_seconds": 77.16,
      "duration_seconds": 14.67,
      "text": "It feels moderate to me. I've also had tingling in my feet, since this morning. Being unsteady was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.67,
      "end_seconds": 100.67,
      "duration_seconds": 5.0,
      "text": "A few quick ones: diarrhoea, weight loss, back pain or bladder problems?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.9,
      "end_seconds": 108.27,
      "duration_seconds": 6.37,
      "text": "Actually, no, no diarrhoea, weight loss, back pain or bladder problems."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.88,
      "end_seconds": 112.32,
      "duration_seconds": 2.44,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.86,
      "end_seconds": 114.96,
      "duration_seconds": 2.1,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.87,
      "end_seconds": 119.07,
      "duration_seconds": 3.2,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.1,
      "end_seconds": 122.68,
      "duration_seconds": 2.58,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.86,
      "end_seconds": 127.11,
      "duration_seconds": 3.25,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.17,
      "end_seconds": 135.44,
      "duration_seconds": 6.27,
      "text": "Yes, I had a mole taken off my arm, a few years ago."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.23,
      "end_seconds": 151.86,
      "duration_seconds": 2.63,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.61,
      "end_seconds": 167.86,
      "duration_seconds": 14.25,
      "text": "I used to drink heavily but I stopped four years ago. I hardly move around during the day. I'm a hairdresser, on my feet all day. My partner and our baby."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.71,
      "end_seconds": 173.24,
      "duration_seconds": 4.53,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.91,
      "end_seconds": 177.29,
      "duration_seconds": 3.38,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.46,
      "end_seconds": 180.92,
      "duration_seconds": 2.46,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.39,
      "end_seconds": 188.0,
      "duration_seconds": 5.61,
      "text": "I have gout. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.34,
      "end_seconds": 190.11,
      "duration_seconds": 0.77,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.35,
      "end_seconds": 196.03,
      "duration_seconds": 4.68,
      "text": "I have arthritis in my knees, for five years."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.55,
      "end_seconds": 208.97,
      "duration_seconds": 11.42,
      "text": "Right, so gout and arthritis in your knees are already on your record. We'll keep that in mind today. Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.74,
      "end_seconds": 226.41,
      "duration_seconds": 11.67,
      "text": "Allopurinol, 100 milligrams, once a day. I'm on diclofenac, 50 milligrams, when needed. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.66,
      "end_seconds": 230.98,
      "duration_seconds": 3.32,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.14,
      "end_seconds": 242.11,
      "duration_seconds": 1.97,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.24,
      "end_seconds": 261.01,
      "duration_seconds": 6.77,
      "text": "Okay: temperature is 36.7 degrees, pulse is 80 beats a minute, pressure 124 over 68."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.77,
      "end_seconds": 268.14,
      "duration_seconds": 4.37,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.82,
      "end_seconds": 270.77,
      "duration_seconds": 0.95,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.82,
      "end_seconds": 274.08,
      "duration_seconds": 2.26,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.06,
      "end_seconds": 299.81,
      "duration_seconds": 7.75,
      "text": "The feeling in your feet is reduced and your balance with the eyes closed is poor."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.25,
      "end_seconds": 306.17,
      "duration_seconds": 0.92,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.17,
      "end_seconds": 322.51,
      "duration_seconds": 12.34,
      "text": "Thank you, you can get dressed. From what you've told me and what I found, this looks most like a possible gut-related cause of nerve symptoms."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.2,
      "end_seconds": 328.69,
      "duration_seconds": 3.49,
      "text": "Yeah, is there something to worry about?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.65,
      "end_seconds": 340.01,
      "duration_seconds": 9.36,
      "text": "Nothing I've seen today points to an emergency. It looks like a possible gut-related cause of nerve symptoms, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.14,
      "end_seconds": 366.18,
      "duration_seconds": 10.04,
      "text": "Let's book a B12 level to look into neuropathy. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 368.0,
      "end_seconds": 371.72,
      "duration_seconds": 3.72,
      "text": "Should I have an HbA1c as well?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 372.81,
      "end_seconds": 384.01,
      "duration_seconds": 11.2,
      "text": "Not right now, it wouldn't change what we do today. Do get help quickly if the symptoms get worse. So, does all of that make sense?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 386.03,
      "end_seconds": 388.38,
      "duration_seconds": 2.35,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 389.55,
      "end_seconds": 391.26,
      "duration_seconds": 1.71,
      "text": "Okay, look after yourself."
    }
  ]
}