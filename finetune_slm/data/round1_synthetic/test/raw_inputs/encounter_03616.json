{
  "schema_version": "1.0",
  "encounter_id": "03616",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.73,
      "end_seconds": 4.86,
      "duration_seconds": 4.13,
      "text": "Yeah hi is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.73,
      "end_seconds": 12.53,
      "duration_seconds": 3.8,
      "text": "Yes have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 17.63,
      "end_seconds": 22.59,
      "duration_seconds": 4.96,
      "text": "Hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.48,
      "end_seconds": 33.39,
      "duration_seconds": 9.91,
      "text": "Yeah it's not remembering the last hours. I don't know what's causing it. I didn't wanna make a fuss you know."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.37,
      "end_seconds": 39.11,
      "duration_seconds": 3.74,
      "text": "when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.2,
      "end_seconds": 44.25,
      "duration_seconds": 3.05,
      "text": "Erm, around a week, I think."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 45.22,
      "end_seconds": 48.38,
      "duration_seconds": 3.16,
      "text": "It was closer to two weeks, doctor."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.6,
      "end_seconds": 54.49,
      "duration_seconds": 4.89,
      "text": "okay, so roughly one to two weeks is that right?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.2,
      "end_seconds": 58.55,
      "duration_seconds": 2.35,
      "text": "That That sounds about right."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.11,
      "end_seconds": 63.22,
      "duration_seconds": 3.11,
      "text": "how troublesome is it day to to day?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.37,
      "end_seconds": 65.3,
      "duration_seconds": 0.93,
      "text": "Mild really."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.23,
      "end_seconds": 73.21,
      "duration_seconds": 6.98,
      "text": "and the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 73.31,
      "end_seconds": 79.83,
      "duration_seconds": 6.52,
      "text": "Let me think, tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.83,
      "end_seconds": 90.74,
      "duration_seconds": 8.91,
      "text": "Oh I was getting to that! I've had asking the same questions repeatedly too for three weeks."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.26,
      "end_seconds": 93.96,
      "duration_seconds": 1.7,
      "text": "alright, how about headache?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.22,
      "end_seconds": 98.63,
      "duration_seconds": 1.41,
      "text": "nope no headache"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.14,
      "end_seconds": 103.93,
      "duration_seconds": 3.79,
      "text": "A few quick ones: seizure, weakness or slurred speech?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.79,
      "end_seconds": 120.41,
      "duration_seconds": 14.62,
      "text": "sorry, what was I saying, no, no seizure, no weakness, no slurred speech i was feeling fine otherwise at one point, but that that went away on its own"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.18,
      "end_seconds": 124.13,
      "duration_seconds": 1.95,
      "text": "any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.9,
      "end_seconds": 133.18,
      "duration_seconds": 3.28,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.53,
      "end_seconds": 137.44,
      "duration_seconds": 2.91,
      "text": "has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.02,
      "end_seconds": 139.37,
      "duration_seconds": 1.35,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.92,
      "end_seconds": 143.37,
      "duration_seconds": 2.45,
      "text": "anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.11,
      "end_seconds": 148.3,
      "duration_seconds": 3.19,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.4,
      "end_seconds": 152.77,
      "duration_seconds": 2.37,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.11,
      "end_seconds": 159.03,
      "duration_seconds": 4.92,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.89,
      "end_seconds": 163.38,
      "duration_seconds": 2.49,
      "text": "what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.27,
      "end_seconds": 167.72,
      "duration_seconds": 3.45,
      "text": "Spironolactone, 25 milligrams, once a day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.77,
      "end_seconds": 175.54,
      "duration_seconds": 6.77,
      "text": "It's a... um I can't remember what it's called. It's a round yellow one."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.08,
      "end_seconds": 179.02,
      "duration_seconds": 2.94,
      "text": "do you remember what it's for?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.84,
      "end_seconds": 189.33,
      "duration_seconds": 8.49,
      "text": "For the gout, I believe. My husband sets them out for me, I just take what I'm given."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.4,
      "end_seconds": 193.79,
      "duration_seconds": 3.39,
      "text": "has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.71,
      "end_seconds": 209.39,
      "duration_seconds": 13.68,
      "text": "I've, I've had heart failure for nearly five years now. I've, I've had gout for five years now. My neighbour said I should get it it looked at."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.17,
      "end_seconds": 219.88,
      "duration_seconds": 9.71,
      "text": "mm-hmm. Yes heart failure and gout are known to us good to have that clear. Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.35,
      "end_seconds": 235.06,
      "duration_seconds": 11.71,
      "text": "I think I reacted to some antibiotic once, you know, years ago i don't remember which one, or what happened exactly"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.9,
      "end_seconds": 238.35,
      "duration_seconds": 2.45,
      "text": "let me take your readings now"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.29,
      "end_seconds": 253.62,
      "duration_seconds": 2.33,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.23,
      "end_seconds": 281.08,
      "duration_seconds": 6.85,
      "text": "Okay: pulse is 85 beats a minute temperature 36.5 BP is 110 over 76."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.16,
      "end_seconds": 286.71,
      "duration_seconds": 4.55,
      "text": "right, I'll examine you in a second, make yourself comfortable"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.04,
      "end_seconds": 289.63,
      "duration_seconds": 1.59,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.55,
      "end_seconds": 310.47,
      "duration_seconds": 7.92,
      "text": "You know who you are but not what happened this morning and and the examination otherwise is normal."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.21,
      "end_seconds": 318.27,
      "duration_seconds": 2.06,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.69,
      "end_seconds": 350.11,
      "duration_seconds": 19.42,
      "text": "Okay thinking it through it points towards transient global amnesia. That's my thinking for now and it may change as we learn more. I can't rule out a seizure yet. We shouldn't forget a stroke. Let's book a CT scan of the head to look into acute memory loss."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.73,
      "end_seconds": 353.63,
      "duration_seconds": 1.9,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.77,
      "end_seconds": 375.37,
      "duration_seconds": 18.6,
      "text": "I'm going to order a blood sugar, for confusion. This usually clears in a day with no lasting effect, but we do a scan first to be safe. Come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 375.93,
      "end_seconds": 377.63,
      "duration_seconds": 1.7,
      "text": "alright I follow"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.54,
      "end_seconds": 382.77,
      "duration_seconds": 3.23,
      "text": "I'd like to see you again tomorrow"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 383.86,
      "end_seconds": 387.74,
      "duration_seconds": 3.88,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 389.7,
      "end_seconds": 392.25,
      "duration_seconds": 2.55,
      "text": "have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 392.79,
      "end_seconds": 395.03,
      "duration_seconds": 2.24,
      "text": "thank you, doctor, goodbye"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 396.07,
      "end_seconds": 397.53,
      "duration_seconds": 1.46,
      "text": "Goodbye for now."
    }
  ]
}