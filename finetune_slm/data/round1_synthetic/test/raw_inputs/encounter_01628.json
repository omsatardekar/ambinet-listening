{
  "schema_version": "1.0",
  "encounter_id": "01628",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.29,
      "end_seconds": 4.75,
      "duration_seconds": 3.46,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.54,
      "end_seconds": 13.38,
      "duration_seconds": 4.84,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.64,
      "end_seconds": 27.01,
      "duration_seconds": 12.37,
      "text": "doctor, I'm just here to help with the details it's neck pain after a car crash, doctor she didn't want to come, but I insisted"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.09,
      "end_seconds": 32.38,
      "duration_seconds": 3.29,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.16,
      "end_seconds": 47.56,
      "duration_seconds": 11.4,
      "text": "I've had it since Friday work has been very busy so I kept ignoring it i did try to ignore it for a while"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.56,
      "end_seconds": 51.23,
      "duration_seconds": 2.67,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.02,
      "end_seconds": 54.24,
      "duration_seconds": 2.22,
      "text": "Honestly, every other day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.97,
      "end_seconds": 58.32,
      "duration_seconds": 3.35,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.63,
      "end_seconds": 61.42,
      "duration_seconds": 1.79,
      "text": "it's severe, honestly"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.23,
      "end_seconds": 71.06,
      "duration_seconds": 3.83,
      "text": "What do you do to make it better?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.13,
      "end_seconds": 81.62,
      "duration_seconds": 8.49,
      "text": "I get some relief from heat. I did have a headache at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.89,
      "end_seconds": 94.73,
      "duration_seconds": 3.84,
      "text": "is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.82,
      "end_seconds": 99.09,
      "duration_seconds": 2.27,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.05,
      "end_seconds": 103.3,
      "duration_seconds": 3.25,
      "text": "Okay, what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 109.56,
      "end_seconds": 122.44,
      "duration_seconds": 12.88,
      "text": "she is on bisoprolol, 2.5 milligrams, once a day for the heart rhythm, I give it to her. It's ibuprofen, with food, doctor"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.01,
      "end_seconds": 129.9,
      "duration_seconds": 2.89,
      "text": "Okay, and what strength is that?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 131.83,
      "end_seconds": 136.18,
      "duration_seconds": 4.35,
      "text": "400 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.8,
      "end_seconds": 139.7,
      "duration_seconds": 2.9,
      "text": "how long have you taken that?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 140.52,
      "end_seconds": 141.92,
      "duration_seconds": 1.4,
      "text": "Six months now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.56,
      "end_seconds": 145.23,
      "duration_seconds": 2.67,
      "text": "now some background about your lifestyle"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.92,
      "end_seconds": 164.52,
      "duration_seconds": 17.6,
      "text": "I only drink at family occasions. No, I've never smoked in my life. I live with my elderly mother. I do a yoga class on Thursdays. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.74,
      "end_seconds": 172.65,
      "duration_seconds": 2.91,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.13,
      "end_seconds": 178.4,
      "duration_seconds": 4.27,
      "text": "I had part of my thyroid removed years back"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.06,
      "end_seconds": 184.13,
      "duration_seconds": 5.07,
      "text": "Any allergies to to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.34,
      "end_seconds": 188.25,
      "duration_seconds": 2.91,
      "text": "no, I'm not allergic to anything"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.75,
      "end_seconds": 192.18,
      "duration_seconds": 3.43,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.8,
      "end_seconds": 204.01,
      "duration_seconds": 10.21,
      "text": "oh, I have an irregular heartbeat, for about ten years. I've been reading about it online and it worried me"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.1,
      "end_seconds": 216.48,
      "duration_seconds": 11.38,
      "text": "I follow. Yes, an irregular heartbeat is known to us, good to have that clear. Did you get chest pain, loss of consciousness or numbness in the arms?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.33,
      "end_seconds": 225.01,
      "duration_seconds": 6.68,
      "text": "I haven't had chest pain, loss of consciousness or numbness in the arms, no"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.74,
      "end_seconds": 228.66,
      "duration_seconds": 0.92,
      "text": "Any weakness?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.5,
      "end_seconds": 232.09,
      "duration_seconds": 1.59,
      "text": "Definitely no weakness."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.43,
      "end_seconds": 237.11,
      "duration_seconds": 3.68,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.98,
      "end_seconds": 241.02,
      "duration_seconds": 2.04,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.25,
      "end_seconds": 246.86,
      "duration_seconds": 2.61,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.2,
      "end_seconds": 249.73,
      "duration_seconds": 1.53,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.73,
      "end_seconds": 255.05,
      "duration_seconds": 3.32,
      "text": "Right, I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.6,
      "end_seconds": 268.86,
      "duration_seconds": 2.26,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.41,
      "end_seconds": 291.63,
      "duration_seconds": 9.22,
      "text": "Okay: saturation 98 percent, heart rate 76, temperature is 36.7 degrees. And And BP is 128 over 82."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.41,
      "end_seconds": 297.87,
      "duration_seconds": 4.46,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.18,
      "end_seconds": 301.46,
      "duration_seconds": 2.28,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.22,
      "end_seconds": 320.36,
      "duration_seconds": 6.14,
      "text": "There is muscle tenderness either side of the neck and no tenderness over the bones."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.59,
      "end_seconds": 325.17,
      "duration_seconds": 2.58,
      "text": "that's all I needed to check"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.51,
      "end_seconds": 357.91,
      "duration_seconds": 25.4,
      "text": "putting it all together, I don't have a clear answer today: whiplash-type neck strain is possible, and so is a cervical spine injury let me just check I've got this right you've had neck pain after a car crash, since Friday, severe, and no chest pain or numbness in the arms"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.71,
      "end_seconds": 361.71,
      "duration_seconds": 2.0,
      "text": "That's what happened, yes."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 370.81,
      "end_seconds": 379.84,
      "duration_seconds": 9.03,
      "text": "Keep your neck moving gently and avoid a collar. Please come and see me if not better in two weeks."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 383.38,
      "end_seconds": 387.9,
      "duration_seconds": 4.52,
      "text": "Erm, you know, I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 391.0,
      "end_seconds": 393.69,
      "duration_seconds": 2.69,
      "text": "have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 394.47,
      "end_seconds": 398.44,
      "duration_seconds": 3.97,
      "text": "Uh, good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 400.04,
      "end_seconds": 401.38,
      "duration_seconds": 1.34,
      "text": "Look after yourself."
    }
  ]
}