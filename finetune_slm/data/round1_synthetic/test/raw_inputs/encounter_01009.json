{
  "schema_version": "1.0",
  "encounter_id": "01009",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.66,
      "end_seconds": 2.16,
      "duration_seconds": 1.5,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.06,
      "end_seconds": 8.56,
      "duration_seconds": 4.5,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.29,
      "end_seconds": 20.17,
      "duration_seconds": 10.88,
      "text": "So the thing is, I've got sudden hearing loss in one ear. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.27,
      "end_seconds": 25.66,
      "duration_seconds": 3.39,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.62,
      "end_seconds": 37.22,
      "duration_seconds": 2.6,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.12,
      "end_seconds": 68.18,
      "duration_seconds": 14.06,
      "text": "Okay: weight 52 kilos, temp 36.6 degrees, BMI works out to 16.2, height 179 centimetres, pulse 68, blood pressure 121 over 81, saturation 99 percent."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.25,
      "end_seconds": 72.42,
      "duration_seconds": 2.17,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.03,
      "end_seconds": 75.6,
      "duration_seconds": 2.57,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.09,
      "end_seconds": 90.35,
      "duration_seconds": 1.26,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.45,
      "end_seconds": 96.14,
      "duration_seconds": 3.69,
      "text": "I mean, it's been four weeks now."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.35,
      "end_seconds": 100.59,
      "duration_seconds": 4.24,
      "text": "Mm, okay. Have you noticed dizziness or facial weakness?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.47,
      "end_seconds": 105.52,
      "duration_seconds": 3.05,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.54,
      "end_seconds": 109.08,
      "duration_seconds": 2.54,
      "text": "Okay, how about ear pain?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.2,
      "end_seconds": 114.01,
      "duration_seconds": 2.81,
      "text": "I haven't noticed any ear pain."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.87,
      "end_seconds": 117.16,
      "duration_seconds": 2.29,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.04,
      "end_seconds": 120.14,
      "duration_seconds": 1.1,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.6,
      "end_seconds": 135.49,
      "duration_seconds": 2.89,
      "text": "So, have you got any known allergies?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.32,
      "end_seconds": 144.12,
      "duration_seconds": 3.8,
      "text": "Hmm, no, not that I know of."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.67,
      "end_seconds": 146.98,
      "duration_seconds": 2.31,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.0,
      "end_seconds": 154.28,
      "duration_seconds": 6.28,
      "text": "Sorry, what was I saying, it's ramipril, every morning for my blood pressure."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.07,
      "end_seconds": 157.06,
      "duration_seconds": 1.99,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.55,
      "end_seconds": 162.97,
      "duration_seconds": 1.42,
      "text": "It's 5 milligrams."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.22,
      "end_seconds": 167.5,
      "duration_seconds": 3.28,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.54,
      "end_seconds": 181.37,
      "duration_seconds": 11.83,
      "text": "I look after my grandchildren most days. I drink a lot of tea and snack through the day. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.71,
      "end_seconds": 198.58,
      "duration_seconds": 3.87,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.77,
      "end_seconds": 203.33,
      "duration_seconds": 3.56,
      "text": "High blood pressure, for about ten years."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.11,
      "end_seconds": 204.9,
      "duration_seconds": 0.79,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.46,
      "end_seconds": 210.84,
      "duration_seconds": 4.38,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.7,
      "end_seconds": 217.22,
      "duration_seconds": 1.52,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.4,
      "end_seconds": 220.25,
      "duration_seconds": 1.85,
      "text": "Alright, does that hurt?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.56,
      "end_seconds": 243.79,
      "duration_seconds": 6.23,
      "text": "The ear drum looks normal and the tuning fork is heard louder in the other ear."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.75,
      "end_seconds": 245.84,
      "duration_seconds": 1.09,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.01,
      "end_seconds": 251.76,
      "duration_seconds": 1.75,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.47,
      "end_seconds": 274.44,
      "duration_seconds": 7.97,
      "text": "So, based on the history and the examination, I'd lean towards sudden hearing loss needing urgent treatment."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.55,
      "end_seconds": 279.83,
      "duration_seconds": 4.28,
      "text": "Oh, uh, what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.9,
      "end_seconds": 308.07,
      "duration_seconds": 27.17,
      "text": "Nothing I've seen today points to an emergency. It looks like sudden hearing loss needing urgent treatment, but I'd like to confirm. We should do an MRI scan for sudden hearing loss. An urgent hearing test is what I'd like next, for sudden hearing loss. Let's use prednisolone, 60 milligrams, once a day, seven days. You take it by mouth. That should help with sudden hearing loss."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.78,
      "end_seconds": 311.31,
      "duration_seconds": 1.53,
      "text": "That's simple enough."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.22,
      "end_seconds": 322.42,
      "duration_seconds": 9.2,
      "text": "This is time-critical, so I'm starting treatment today. I'd like you to see the ENT team as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.94,
      "end_seconds": 323.64,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.01,
      "end_seconds": 335.13,
      "duration_seconds": 6.12,
      "text": "One warning sign to remember: the symptoms get worse. In that case don't wait."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.16,
      "end_seconds": 339.05,
      "duration_seconds": 2.89,
      "text": "I know what to watch for."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.57,
      "end_seconds": 343.63,
      "duration_seconds": 4.06,
      "text": "I'd like to see you again in one week."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.46,
      "end_seconds": 346.16,
      "duration_seconds": 1.7,
      "text": "Yes, that's manageable."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.45,
      "end_seconds": 350.25,
      "duration_seconds": 2.8,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.06,
      "end_seconds": 354.11,
      "duration_seconds": 3.05,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.82,
      "end_seconds": 356.15,
      "duration_seconds": 1.33,
      "text": "All the best."
    }
  ]
}