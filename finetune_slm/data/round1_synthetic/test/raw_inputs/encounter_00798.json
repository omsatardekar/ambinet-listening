{
  "schema_version": "1.0",
  "encounter_id": "00798",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.8,
      "end_seconds": 5.34,
      "duration_seconds": 4.54,
      "text": "It's the toenail. Thick and yellow. Six months."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 8.26,
      "end_seconds": 15.67,
      "duration_seconds": 7.41,
      "text": "He won't say, but it's embarrassing him, doctor. I'm his wife, Basia. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.75,
      "end_seconds": 19.93,
      "duration_seconds": 3.18,
      "text": "Hello, both. Which toe? ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.72,
      "end_seconds": 22.89,
      "duration_seconds": 2.17,
      "text": "Right big toe."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.53,
      "end_seconds": 26.7,
      "duration_seconds": 2.17,
      "text": "Is it crumbling?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.35,
      "end_seconds": 33.04,
      "duration_seconds": 4.69,
      "text": "Yes. Bits come off in my socks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.28,
      "end_seconds": 37.7,
      "duration_seconds": 2.42,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.93,
      "end_seconds": 42.2,
      "duration_seconds": 3.27,
      "text": "In shoes, yes. Sore."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 44.84,
      "end_seconds": 49.26,
      "duration_seconds": 4.42,
      "text": "He limps when he wears the brown ones. ~"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.76,
      "end_seconds": 54.66,
      "duration_seconds": 2.9,
      "text": "Any itching between the toes?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.56,
      "end_seconds": 59.2,
      "duration_seconds": 3.64,
      "text": "A bit. Between the little ones."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.09,
      "end_seconds": 63.11,
      "duration_seconds": 1.02,
      "text": "Smell?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 64.31,
      "end_seconds": 66.95,
      "duration_seconds": 2.64,
      "text": "Terrible, I'll say it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.04,
      "end_seconds": 70.65,
      "duration_seconds": 1.61,
      "text": "Basia. ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.45,
      "end_seconds": 74.92,
      "duration_seconds": 3.47,
      "text": "Any redness spreading up the foot?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.22,
      "end_seconds": 77.15,
      "duration_seconds": 0.93,
      "text": "No."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.48,
      "end_seconds": 80.84,
      "duration_seconds": 1.36,
      "text": "Fever?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.06,
      "end_seconds": 84.59,
      "duration_seconds": 1.53,
      "text": "No fever."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.67,
      "end_seconds": 90.69,
      "duration_seconds": 4.02,
      "text": "Nurse, did you get his obs?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 92.5,
      "end_seconds": 99.26,
      "duration_seconds": 6.76,
      "text": "Yes, blood pressure 136 over 82, pulse 70, weight 78 kilos."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.6,
      "end_seconds": 105.19,
      "duration_seconds": 4.59,
      "text": "Thanks. Has he tried anything on it?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.61,
      "end_seconds": 110.98,
      "duration_seconds": 3.37,
      "text": "Nothing. Just cutting it. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.07,
      "end_seconds": 116.37,
      "duration_seconds": 3.3,
      "text": "Any allergies, to medicines or anything?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.51,
      "end_seconds": 119.98,
      "duration_seconds": 1.47,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 122.67,
      "end_seconds": 134.75,
      "duration_seconds": 12.08,
      "text": "What about that tablet for the toenail, years ago? He came out in a rash. I don't remember its name."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.68,
      "end_seconds": 140.71,
      "duration_seconds": 3.03,
      "text": "That wasn't an allergy."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.1,
      "end_seconds": 146.69,
      "duration_seconds": 3.59,
      "text": "I'll note both. Medical history?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.33,
      "end_seconds": 151.14,
      "duration_seconds": 2.81,
      "text": "Athlete's foot. Psoriasis. Gout."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.65,
      "end_seconds": 154.96,
      "duration_seconds": 1.31,
      "text": "Operations?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.75,
      "end_seconds": 159.01,
      "duration_seconds": 3.26,
      "text": "Knee replacement, 2017. Cataract, 2020."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.62,
      "end_seconds": 164.74,
      "duration_seconds": 3.12,
      "text": "Skin problems in the family?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.59,
      "end_seconds": 170.51,
      "duration_seconds": 2.92,
      "text": "My brother has psoriasis."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.92,
      "end_seconds": 175.36,
      "duration_seconds": 2.44,
      "text": "And your work?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.27,
      "end_seconds": 179.8,
      "duration_seconds": 1.53,
      "text": "Retired. Postman."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.55,
      "end_seconds": 183.51,
      "duration_seconds": 0.96,
      "text": "Smoke?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.14,
      "end_seconds": 186.94,
      "duration_seconds": 1.8,
      "text": "Never smoked."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.47,
      "end_seconds": 189.87,
      "duration_seconds": 1.4,
      "text": "Drink?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.27,
      "end_seconds": 196.18,
      "duration_seconds": 3.91,
      "text": "A pint at the pub on Fridays."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.6,
      "end_seconds": 199.62,
      "duration_seconds": 1.02,
      "text": "Exercise?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 201.89,
      "end_seconds": 206.13,
      "duration_seconds": 4.24,
      "text": "He walks the dog every morning."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.0,
      "end_seconds": 222.01,
      "duration_seconds": 5.01,
      "text": "Let me see the foot. Take the sock off."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.24,
      "end_seconds": 225.87,
      "duration_seconds": 1.63,
      "text": "There. ~"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.47,
      "end_seconds": 234.32,
      "duration_seconds": 6.85,
      "text": "The right big toenail is thick and yellow, and there's crumbly debris underneath it."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 235.51,
      "end_seconds": 238.24,
      "duration_seconds": 2.73,
      "text": "Is it bad? ~"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.1,
      "end_seconds": 245.23,
      "duration_seconds": 5.13,
      "text": "And there's scaling between the toes on the same foot."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.15,
      "end_seconds": 248.46,
      "duration_seconds": 2.31,
      "text": "Told you. ~"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.99,
      "end_seconds": 254.38,
      "duration_seconds": 4.39,
      "text": "Any problem with the circulation, cold feet?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.73,
      "end_seconds": 259.17,
      "duration_seconds": 3.44,
      "text": "No, nothing, my feet are warm."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.27,
      "end_seconds": 264.07,
      "duration_seconds": 2.8,
      "text": "Any numbness in the feet?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.55,
      "end_seconds": 269.12,
      "duration_seconds": 2.57,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.65,
      "end_seconds": 279.96,
      "duration_seconds": 9.31,
      "text": "This could well be a fungal infection of the nail, but I can't rule out nail psoriasis, given your history."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 282.04,
      "end_seconds": 285.36,
      "duration_seconds": 3.32,
      "text": "How do we tell? ~"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.81,
      "end_seconds": 299.32,
      "duration_seconds": 11.51,
      "text": "I'd like to send a nail clipping to the lab, and I'd also like to do a skin scraping from between the toes."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.52,
      "end_seconds": 303.06,
      "duration_seconds": 1.54,
      "text": "Fine. ~"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.7,
      "end_seconds": 313.71,
      "duration_seconds": 8.01,
      "text": "And I'd like to arrange a liver blood test, in case we need tablets later."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 316.16,
      "end_seconds": 321.32,
      "duration_seconds": 5.16,
      "text": "Not the tablet that gave him the rash? ~"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.24,
      "end_seconds": 331.28,
      "duration_seconds": 7.04,
      "text": "No, let's start with a nail lacquer, amorolfine, painted on once a week."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.59,
      "end_seconds": 335.34,
      "duration_seconds": 1.75,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.08,
      "end_seconds": 343.03,
      "duration_seconds": 4.95,
      "text": "I'd like to see you again in six weeks."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 344.63,
      "end_seconds": 347.74,
      "duration_seconds": 3.11,
      "text": "We'll be here. ~"
    }
  ]
}
