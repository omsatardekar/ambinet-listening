{
  "schema_version": "1.0",
  "encounter_id": "03531",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.96,
      "end_seconds": 2.59,
      "duration_seconds": 1.63,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.27,
      "end_seconds": 8.87,
      "duration_seconds": 4.6,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.49,
      "end_seconds": 19.02,
      "duration_seconds": 5.53,
      "text": "Good morning, uh, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.8,
      "end_seconds": 26.52,
      "duration_seconds": 2.72,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.12,
      "end_seconds": 36.24,
      "duration_seconds": 5.12,
      "text": "I wanted to get tingling in my feet looked at."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.41,
      "end_seconds": 40.75,
      "duration_seconds": 3.34,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.74,
      "end_seconds": 46.91,
      "duration_seconds": 3.17,
      "text": "I, I'd say three weeks, maybe"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 52.08,
      "end_seconds": 55.76,
      "duration_seconds": 3.68,
      "text": "it was closer to a month, doctor"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.35,
      "end_seconds": 60.85,
      "duration_seconds": 4.5,
      "text": "okay, so roughly three to four weeks is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.73,
      "end_seconds": 63.82,
      "duration_seconds": 2.09,
      "text": "I suppose so, yes."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.63,
      "end_seconds": 75.85,
      "duration_seconds": 11.22,
      "text": "Alright, tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.79,
      "end_seconds": 86.02,
      "duration_seconds": 5.23,
      "text": "I'd say severe. I'd say once or twice a day."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.05,
      "end_seconds": 89.27,
      "duration_seconds": 2.22,
      "text": "Have you been feeling tired?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.96,
      "end_seconds": 93.78,
      "duration_seconds": 2.82,
      "text": "Yes, for about three months."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.7,
      "end_seconds": 97.69,
      "duration_seconds": 2.99,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.3,
      "end_seconds": 107.23,
      "duration_seconds": 2.93,
      "text": "Alright, keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.15,
      "end_seconds": 137.82,
      "duration_seconds": 9.67,
      "text": "okay: temperature 36.6, respiratory rate 14, pulse 73, SpO2 97 percent on room air, BP is 124 over 80."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.8,
      "end_seconds": 142.22,
      "duration_seconds": 2.42,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.75,
      "end_seconds": 144.95,
      "duration_seconds": 1.2,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.52,
      "end_seconds": 165.06,
      "duration_seconds": 6.54,
      "text": "The feeling in your feet is reduced and your balance with the eyes closed is poor."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.1,
      "end_seconds": 175.16,
      "duration_seconds": 8.06,
      "text": "Good, you can sit up again. Have you noticed bladder problems, diarrhoea, back pain or weight loss?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.85,
      "end_seconds": 183.79,
      "duration_seconds": 6.94,
      "text": "no bladder problems, diarrhoea, back pain or weight loss, none of it"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.39,
      "end_seconds": 189.75,
      "duration_seconds": 4.36,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.01,
      "end_seconds": 193.93,
      "duration_seconds": 2.92,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.29,
      "end_seconds": 197.29,
      "duration_seconds": 2.0,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.38,
      "end_seconds": 203.21,
      "duration_seconds": 4.83,
      "text": "Sorry, what was I saying, no, skin's been fine."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.08,
      "end_seconds": 209.26,
      "duration_seconds": 1.18,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.68,
      "end_seconds": 216.09,
      "duration_seconds": 3.41,
      "text": "so, no, I've never been operated on"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.51,
      "end_seconds": 219.55,
      "duration_seconds": 2.04,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.11,
      "end_seconds": 223.49,
      "duration_seconds": 2.38,
      "text": "I've had depression, yes."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.71,
      "end_seconds": 237.98,
      "duration_seconds": 10.27,
      "text": "Right, so depression is already on your record. We'll keep that in mind today. So, is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.31,
      "end_seconds": 241.84,
      "duration_seconds": 2.53,
      "text": "no, nothing at the moment"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.83,
      "end_seconds": 265.5,
      "duration_seconds": 4.67,
      "text": "let's talk a little about your daily life and habits"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.66,
      "end_seconds": 281.05,
      "duration_seconds": 14.39,
      "text": "I've never touched a cigarette. No, I share a house with my brother. I'm a hairdresser, on my feet all day. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.83,
      "end_seconds": 286.16,
      "duration_seconds": 4.33,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.07,
      "end_seconds": 291.0,
      "duration_seconds": 2.93,
      "text": "no, not that I know of"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.54,
      "end_seconds": 309.96,
      "duration_seconds": 3.42,
      "text": "I want an HbA1c done, that's for neuropathy"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.46,
      "end_seconds": 315.71,
      "duration_seconds": 5.25,
      "text": "Right, should I have a a coeliac blood test as well?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.12,
      "end_seconds": 325.24,
      "duration_seconds": 8.12,
      "text": "Not right now, it it wouldn't change what we do today. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.11,
      "end_seconds": 328.67,
      "duration_seconds": 1.56,
      "text": "That's clear, thanks."
    }
  ]
}