{
  "schema_version": "1.0",
  "encounter_id": "03646",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.6,
      "end_seconds": 5.28,
      "duration_seconds": 4.68,
      "text": "Hello, sorry about the delay, do sit. What's the problem?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.22,
      "end_seconds": 11.94,
      "duration_seconds": 5.72,
      "text": "So the thing is, I've got tingling in my feet."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.5,
      "end_seconds": 15.45,
      "duration_seconds": 2.95,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 17.33,
      "end_seconds": 20.04,
      "duration_seconds": 2.71,
      "text": "For ten days, I'd say."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.78,
      "end_seconds": 24.44,
      "duration_seconds": 3.66,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.2,
      "end_seconds": 28.71,
      "duration_seconds": 3.51,
      "text": "A four out of ten, I suppose."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.56,
      "end_seconds": 32.01,
      "duration_seconds": 2.45,
      "text": "Has there been being unsteady too?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.71,
      "end_seconds": 33.97,
      "duration_seconds": 1.26,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.17,
      "end_seconds": 38.29,
      "duration_seconds": 3.12,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 39.61,
      "end_seconds": 45.28,
      "duration_seconds": 5.67,
      "text": "Maybe a eight out of ten on a bad day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.73,
      "end_seconds": 47.06,
      "duration_seconds": 1.33,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.48,
      "end_seconds": 57.16,
      "duration_seconds": 2.68,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 58.89,
      "end_seconds": 63.27,
      "duration_seconds": 4.38,
      "text": "I've had asthma for nearly five years now."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.97,
      "end_seconds": 66.15,
      "duration_seconds": 1.18,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.67,
      "end_seconds": 67.74,
      "duration_seconds": 1.07,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.56,
      "end_seconds": 73.52,
      "duration_seconds": 4.96,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 74.54,
      "end_seconds": 78.49,
      "duration_seconds": 3.95,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.87,
      "end_seconds": 83.77,
      "duration_seconds": 3.9,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 85.57,
      "end_seconds": 87.57,
      "duration_seconds": 2.0,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.2,
      "end_seconds": 90.31,
      "duration_seconds": 2.11,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.3,
      "end_seconds": 97.77,
      "duration_seconds": 5.47,
      "text": "Foracort inhaler. I take it twice a day for my asthma."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.32,
      "end_seconds": 102.76,
      "duration_seconds": 3.44,
      "text": "So, a few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.3,
      "end_seconds": 114.32,
      "duration_seconds": 11.02,
      "text": "I work in accounts at a hospital. I walk the dog every morning. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.79,
      "end_seconds": 133.97,
      "duration_seconds": 5.18,
      "text": "Okay, have you had any weight loss, back pain or diarrhoea?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.89,
      "end_seconds": 138.47,
      "duration_seconds": 2.58,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.66,
      "end_seconds": 144.2,
      "duration_seconds": 2.54,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.71,
      "end_seconds": 146.78,
      "duration_seconds": 2.07,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.9,
      "end_seconds": 149.91,
      "duration_seconds": 2.01,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.57,
      "end_seconds": 153.49,
      "duration_seconds": 1.92,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.43,
      "end_seconds": 156.96,
      "duration_seconds": 2.53,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.51,
      "end_seconds": 168.1,
      "duration_seconds": 2.59,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.58,
      "end_seconds": 190.31,
      "duration_seconds": 11.73,
      "text": "Okay: height 179 centimetres, weight 62 kilos, blood pressure 127 over 80, BMI works out to 19.4, pulse 68, temp 36.8 degrees."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.27,
      "end_seconds": 194.27,
      "duration_seconds": 2.0,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.15,
      "end_seconds": 198.48,
      "duration_seconds": 2.33,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.61,
      "end_seconds": 215.95,
      "duration_seconds": 6.34,
      "text": "The feeling in your feet is reduced and your balance with the eyes closed is poor."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.89,
      "end_seconds": 222.74,
      "duration_seconds": 1.85,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.08,
      "end_seconds": 240.41,
      "duration_seconds": 8.33,
      "text": "Right, here's what I'm thinking. The most likely explanation is a possible gut-related cause of nerve symptoms."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 242.05,
      "end_seconds": 244.97,
      "duration_seconds": 2.92,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.67,
      "end_seconds": 265.27,
      "duration_seconds": 19.6,
      "text": "Nothing I've seen today points to an emergency. It looks like a possible gut-related cause of nerve symptoms, but I'd like to confirm. Let me just check I've got this right. You've had tingling in your feet for ten days, and no weight loss or diarrhoea."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 266.6,
      "end_seconds": 268.22,
      "duration_seconds": 1.62,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 279.52,
      "end_seconds": 283.49,
      "duration_seconds": 3.97,
      "text": "I'd like to arrange a coeliac blood test for neuropathy."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 284.79,
      "end_seconds": 287.37,
      "duration_seconds": 2.58,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.29,
      "end_seconds": 310.79,
      "duration_seconds": 22.5,
      "text": "I want a B12 level done, that's for neuropathy. Please keep eating gluten normally until the coeliac test is done. If it hasn't settled next month, we'd think about an HbA1c, but not now. Come back after the results. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 311.39,
      "end_seconds": 314.74,
      "duration_seconds": 3.35,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.13,
      "end_seconds": 319.37,
      "duration_seconds": 1.24,
      "text": "See you soon."
    }
  ]
}