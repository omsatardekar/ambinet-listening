{
  "schema_version": "1.0",
  "encounter_id": "03584",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.2,
      "end_seconds": 4.41,
      "duration_seconds": 3.21,
      "text": "sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.25,
      "end_seconds": 9.09,
      "duration_seconds": 3.84,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 9.91,
      "end_seconds": 16.04,
      "duration_seconds": 6.13,
      "text": "I mean, you know, thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.51,
      "end_seconds": 21.57,
      "duration_seconds": 4.06,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 23.43,
      "end_seconds": 31.78,
      "duration_seconds": 8.35,
      "text": "It's a sore spot on the front of my shin, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.5,
      "end_seconds": 34.75,
      "duration_seconds": 1.25,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.28,
      "end_seconds": 39.15,
      "duration_seconds": 2.87,
      "text": "for about three months, I'd say"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.06,
      "end_seconds": 43.16,
      "duration_seconds": 2.1,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.15,
      "end_seconds": 46.73,
      "duration_seconds": 2.58,
      "text": "It happens on and off."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.26,
      "end_seconds": 50.64,
      "duration_seconds": 2.38,
      "text": "any pain at night as well?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.65,
      "end_seconds": 55.07,
      "duration_seconds": 2.42,
      "text": "Yes, for about a week."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.89,
      "end_seconds": 60.05,
      "duration_seconds": 3.16,
      "text": "would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.57,
      "end_seconds": 64.7,
      "duration_seconds": 4.13,
      "text": "Okay, uh, so I'd call it mild."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.91,
      "end_seconds": 76.79,
      "duration_seconds": 2.88,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.59,
      "end_seconds": 91.89,
      "duration_seconds": 2.3,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.2,
      "end_seconds": 118.27,
      "duration_seconds": 7.07,
      "text": "Okay: pulse 72, temperature 36.5. And saturation 98 percent, pressure 112 over 70."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.14,
      "end_seconds": 122.32,
      "duration_seconds": 2.18,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.65,
      "end_seconds": 125.73,
      "duration_seconds": 2.08,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.36,
      "end_seconds": 140.75,
      "duration_seconds": 6.39,
      "text": "there is a very localised tender spot on the bone and hopping on that leg hurts"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.79,
      "end_seconds": 154.28,
      "duration_seconds": 8.49,
      "text": "You can sit up now. Let me check a few things. Any swelling, numbness, injury or fever?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.15,
      "end_seconds": 161.08,
      "duration_seconds": 4.93,
      "text": "Sorry, what was I saying, no, nothing to report there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.21,
      "end_seconds": 164.32,
      "duration_seconds": 2.11,
      "text": "anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.23,
      "end_seconds": 169.49,
      "duration_seconds": 3.26,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.3,
      "end_seconds": 176.08,
      "duration_seconds": 4.78,
      "text": "Alright, anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.13,
      "end_seconds": 180.67,
      "duration_seconds": 3.54,
      "text": "Yeah, you know, no, that's been fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.47,
      "end_seconds": 185.44,
      "duration_seconds": 2.97,
      "text": "Alright, what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.53,
      "end_seconds": 208.48,
      "duration_seconds": 21.95,
      "text": "Warfarin. I take it 3 milligrams, in the evening for the blood thinning. I took the morning off to come in today. My family kept telling me to get it checked. I take something called pant... pantoprazole, 40 milligrams, maybe, before breakfast."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.99,
      "end_seconds": 215.18,
      "duration_seconds": 5.19,
      "text": "right, do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.94,
      "end_seconds": 223.81,
      "duration_seconds": 6.87,
      "text": "No, it's at home. Ibuprofen, 400 milligrams, when needed. Apixaban I don't take anymore."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.59,
      "end_seconds": 229.33,
      "duration_seconds": 3.74,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.86,
      "end_seconds": 238.96,
      "duration_seconds": 9.1,
      "text": "I have an irregular heartbeat, for about ten years. Well, I have acid reflux, for two years."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.85,
      "end_seconds": 248.55,
      "duration_seconds": 8.7,
      "text": "Alright, an irregular heartbeat and acid reflux, that matches what I have here. Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.49,
      "end_seconds": 251.97,
      "duration_seconds": 1.48,
      "text": "no known allergies"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.01,
      "end_seconds": 255.83,
      "duration_seconds": 2.82,
      "text": "are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.06,
      "end_seconds": 261.43,
      "duration_seconds": 4.37,
      "text": "oh, you know, my mother had a stroke"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.36,
      "end_seconds": 265.2,
      "duration_seconds": 2.84,
      "text": "what line of work are you in?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.16,
      "end_seconds": 272.39,
      "duration_seconds": 5.23,
      "text": "I'm a bus driver, so I sit for long hours"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.09,
      "end_seconds": 277.88,
      "duration_seconds": 2.79,
      "text": "Alright, do you do any exercise?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.41,
      "end_seconds": 281.08,
      "duration_seconds": 2.67,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.16,
      "end_seconds": 285.12,
      "duration_seconds": 1.96,
      "text": "who lives with you?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.21,
      "end_seconds": 289.6,
      "duration_seconds": 2.39,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.78,
      "end_seconds": 292.77,
      "duration_seconds": 1.99,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.68,
      "end_seconds": 298.67,
      "duration_seconds": 4.99,
      "text": "Just a meniscus repair on my knee, four years ago."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.47,
      "end_seconds": 320.5,
      "duration_seconds": 7.03,
      "text": "Taking everything into account, the most likely explanation is a possible stress fracture rather than shin splints."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.12,
      "end_seconds": 325.49,
      "duration_seconds": 3.37,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.06,
      "end_seconds": 350.04,
      "duration_seconds": 23.98,
      "text": "I can't promise yet, but most people with a possible stress fracture rather than shin splints do well once it's treated properly stop me if I've got anything wrong you've had a sore spot on the front of your shin for about three months, and no swelling or fever"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.92,
      "end_seconds": 353.43,
      "duration_seconds": 1.51,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.88,
      "end_seconds": 383.94,
      "duration_seconds": 20.06,
      "text": "An MRI of the shin is what I'd like next, for possible stress fracture. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 384.65,
      "end_seconds": 387.73,
      "duration_seconds": 3.08,
      "text": "Great, thank you for your help."
    }
  ]
}