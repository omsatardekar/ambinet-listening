{
  "schema_version": "1.0",
  "encounter_id": "01538",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.7,
      "end_seconds": 5.88,
      "duration_seconds": 5.18,
      "text": "Hello, um, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.8,
      "end_seconds": 12.41,
      "duration_seconds": 4.61,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.03,
      "end_seconds": 22.86,
      "duration_seconds": 9.83,
      "text": "Yeah, it's a fall and pain in my left hip. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.72,
      "end_seconds": 26.95,
      "duration_seconds": 3.23,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.12,
      "end_seconds": 38.69,
      "duration_seconds": 2.57,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.63,
      "end_seconds": 67.0,
      "duration_seconds": 14.37,
      "text": "Okay: respiratory rate 18, BP is 126 over 71. And pulse is 67 beats a minute, SpO2 98 percent on room air. Alright, has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.34,
      "end_seconds": 70.08,
      "duration_seconds": 1.74,
      "text": "Just since yesterday."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.41,
      "end_seconds": 74.97,
      "duration_seconds": 3.56,
      "text": "So, how strong would you say it is?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.46,
      "end_seconds": 80.13,
      "duration_seconds": 3.67,
      "text": "Pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.52,
      "end_seconds": 84.41,
      "duration_seconds": 2.89,
      "text": "Okay, is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.73,
      "end_seconds": 106.83,
      "duration_seconds": 21.1,
      "text": "When it starts I tend to get pain in my groin as well. So, as for pain in my groin, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.47,
      "end_seconds": 111.25,
      "duration_seconds": 2.78,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.77,
      "end_seconds": 116.96,
      "duration_seconds": 4.19,
      "text": "I'd say a couple of times a week."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.22,
      "end_seconds": 122.71,
      "duration_seconds": 4.49,
      "text": "Alright, have you had head injury, by any chance?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.06,
      "end_seconds": 126.22,
      "duration_seconds": 2.16,
      "text": "No head injury, thankfully."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.73,
      "end_seconds": 132.24,
      "duration_seconds": 5.51,
      "text": "Understood. Did you get numbness, loss of consciousness or chest pain?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.16,
      "end_seconds": 141.62,
      "duration_seconds": 7.46,
      "text": "So, no numbness, loss of consciousness or chest pain, none of it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.59,
      "end_seconds": 146.37,
      "duration_seconds": 2.78,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.19,
      "end_seconds": 152.6,
      "duration_seconds": 5.41,
      "text": "Mm, um, that's normal as far as I know."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.44,
      "end_seconds": 156.13,
      "duration_seconds": 2.69,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.88,
      "end_seconds": 160.2,
      "duration_seconds": 2.32,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.83,
      "end_seconds": 175.86,
      "duration_seconds": 3.03,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.9,
      "end_seconds": 183.28,
      "duration_seconds": 5.38,
      "text": "Just a wisdom tooth extraction under sedation, five years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.91,
      "end_seconds": 188.29,
      "duration_seconds": 3.38,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.62,
      "end_seconds": 204.99,
      "duration_seconds": 15.37,
      "text": "I've had thin bones for nearly five years now. I kept putting it off, which I know isn't sensible. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.86,
      "end_seconds": 211.32,
      "duration_seconds": 4.46,
      "text": "Hm, okay. Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.97,
      "end_seconds": 218.79,
      "duration_seconds": 6.82,
      "text": "I, I take alendronate, 70 milligrams, once a week for my bones."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.62,
      "end_seconds": 223.99,
      "duration_seconds": 3.37,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.65,
      "end_seconds": 233.06,
      "duration_seconds": 7.41,
      "text": "For about a month. Paracetamol. I take it 1 gram, when needed."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.01,
      "end_seconds": 244.65,
      "duration_seconds": 1.64,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.42,
      "end_seconds": 250.17,
      "duration_seconds": 4.75,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.45,
      "end_seconds": 252.62,
      "duration_seconds": 1.17,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.9,
      "end_seconds": 257.13,
      "duration_seconds": 3.23,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.03,
      "end_seconds": 280.35,
      "duration_seconds": 4.32,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.87,
      "end_seconds": 285.26,
      "duration_seconds": 3.39,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.23,
      "end_seconds": 288.93,
      "duration_seconds": 2.7,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.62,
      "end_seconds": 296.52,
      "duration_seconds": 5.9,
      "text": "Plasters. I come out in... well, a red itchy rash."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.49,
      "end_seconds": 303.13,
      "duration_seconds": 3.64,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.5,
      "end_seconds": 308.31,
      "duration_seconds": 1.81,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.34,
      "end_seconds": 311.36,
      "duration_seconds": 2.02,
      "text": "So, breathe out slowly."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.8,
      "end_seconds": 329.81,
      "duration_seconds": 6.01,
      "text": "The left leg is shortened and turned outwards, and it is very painful to move."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.04,
      "end_seconds": 349.66,
      "duration_seconds": 16.62,
      "text": "That's the examination finished. So where does that leave us? I'm honestly not certain yet. It could be a probable hip fracture, or it might be a pelvic fracture. I'll request an X-ray of the hip, it'll help with hip fracture."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 351.36,
      "end_seconds": 354.37,
      "duration_seconds": 3.01,
      "text": "The earliest is Thursday, 3:30 pm."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.4,
      "end_seconds": 387.18,
      "duration_seconds": 30.78,
      "text": "I'll request blood tests, it'll help with pre-operative. For this, morphine, 2.5 milligrams, now, single dose. That's for hip pain. The pharmacy will go through the details again when you pick it up. Lie still, I am arranging an ambulance and pain relief. A short walk every day, even twenty minutes, will help more than you'd think. I'll also refer you to the orthopaedic team."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 388.31,
      "end_seconds": 391.34,
      "duration_seconds": 3.03,
      "text": "Alright, you know, thank you."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 391.87,
      "end_seconds": 393.51,
      "duration_seconds": 1.64,
      "text": "Come back straight away."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 394.3,
      "end_seconds": 397.48,
      "duration_seconds": 3.18,
      "text": "I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 399.02,
      "end_seconds": 401.54,
      "duration_seconds": 2.52,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 402.56,
      "end_seconds": 406.2,
      "duration_seconds": 3.64,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 407.58,
      "end_seconds": 408.78,
      "duration_seconds": 1.2,
      "text": "Take care now."
    }
  ]
}