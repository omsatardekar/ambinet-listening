{
  "schema_version": "1.0",
  "encounter_id": "02073",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.87,
      "end_seconds": 4.75,
      "duration_seconds": 3.88,
      "text": "Uh, hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.38,
      "end_seconds": 10.8,
      "duration_seconds": 4.42,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.85,
      "end_seconds": 17.36,
      "duration_seconds": 5.51,
      "text": "Doctor, you know, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.11,
      "end_seconds": 22.27,
      "duration_seconds": 4.16,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.75,
      "end_seconds": 27.98,
      "duration_seconds": 4.23,
      "text": "It's spots on my forehead and chin, mostly."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.55,
      "end_seconds": 31.86,
      "duration_seconds": 3.31,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 33.24,
      "end_seconds": 37.03,
      "duration_seconds": 3.79,
      "text": "It's a face wash, twice a day, doctor."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.91,
      "end_seconds": 42.75,
      "duration_seconds": 3.84,
      "text": "Okay, how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.64,
      "end_seconds": 48.36,
      "duration_seconds": 3.72,
      "text": "It's been four weeks, I'm fairly sure."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.1,
      "end_seconds": 54.86,
      "duration_seconds": 4.76,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.72,
      "end_seconds": 63.62,
      "duration_seconds": 7.9,
      "text": "It's worse with before periods and stress. I'd give it a five, you know, out of ten."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.72,
      "end_seconds": 67.14,
      "duration_seconds": 2.42,
      "text": "Has there been oily skin too?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.0,
      "end_seconds": 70.65,
      "duration_seconds": 2.65,
      "text": "Yeah. Two days, I'd say."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.39,
      "end_seconds": 75.74,
      "duration_seconds": 3.35,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.9,
      "end_seconds": 78.51,
      "duration_seconds": 1.61,
      "text": "It's mild, honestly."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.97,
      "end_seconds": 94.8,
      "duration_seconds": 1.83,
      "text": "How about irregular periods?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.87,
      "end_seconds": 98.87,
      "duration_seconds": 2.0,
      "text": "No irregular periods, thankfully."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.44,
      "end_seconds": 103.97,
      "duration_seconds": 4.53,
      "text": "Any low mood, painful cysts or scarring at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.69,
      "end_seconds": 107.86,
      "duration_seconds": 3.17,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.03,
      "end_seconds": 111.95,
      "duration_seconds": 2.92,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.7,
      "end_seconds": 121.63,
      "duration_seconds": 4.93,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.71,
      "end_seconds": 127.95,
      "duration_seconds": 5.24,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.02,
      "end_seconds": 131.07,
      "duration_seconds": 2.05,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.71,
      "end_seconds": 135.25,
      "duration_seconds": 3.54,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.28,
      "end_seconds": 138.14,
      "duration_seconds": 1.86,
      "text": "I have thin bones."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.15,
      "end_seconds": 148.6,
      "duration_seconds": 9.45,
      "text": "Okay, I can see thin bones in your file as well. Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.6,
      "end_seconds": 154.75,
      "duration_seconds": 4.15,
      "text": "Yes, grass pollen, it gives me itchy eyes."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.39,
      "end_seconds": 157.83,
      "duration_seconds": 2.44,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.14,
      "end_seconds": 166.17,
      "duration_seconds": 7.03,
      "text": "I had a cataract operation in my left eye about a year ago."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.37,
      "end_seconds": 169.2,
      "duration_seconds": 1.83,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.78,
      "end_seconds": 173.38,
      "duration_seconds": 2.6,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.23,
      "end_seconds": 176.19,
      "duration_seconds": 1.96,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.0,
      "end_seconds": 179.36,
      "duration_seconds": 2.36,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.16,
      "end_seconds": 185.31,
      "duration_seconds": 4.15,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.96,
      "end_seconds": 192.82,
      "duration_seconds": 3.86,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.6,
      "end_seconds": 199.78,
      "duration_seconds": 2.18,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.94,
      "end_seconds": 210.77,
      "duration_seconds": 2.83,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.19,
      "end_seconds": 230.76,
      "duration_seconds": 9.57,
      "text": "Okay: BP is 126 over 76, saturation 98 percent, heart rate 67, temp 36.7 degrees, respiratory rate 15."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.83,
      "end_seconds": 235.84,
      "duration_seconds": 4.01,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.76,
      "end_seconds": 240.87,
      "duration_seconds": 3.11,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.32,
      "end_seconds": 257.56,
      "duration_seconds": 5.24,
      "text": "There are small blackheads and a few red spots with no deep cysts."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.05,
      "end_seconds": 269.12,
      "duration_seconds": 1.07,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.01,
      "end_seconds": 276.73,
      "duration_seconds": 1.72,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.09,
      "end_seconds": 293.16,
      "duration_seconds": 5.07,
      "text": "Taking everything into account, the most likely explanation is mild acne."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.64,
      "end_seconds": 296.76,
      "duration_seconds": 2.12,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.88,
      "end_seconds": 318.59,
      "duration_seconds": 16.71,
      "text": "Nothing I've seen today points to an emergency. It looks like mild acne. I'll start you on benzoyl peroxide gel, 5%, once a day, eight weeks. That's for acne. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.36,
      "end_seconds": 322.43,
      "duration_seconds": 3.07,
      "text": "I think I understand everything. Thanks."
    }
  ]
}