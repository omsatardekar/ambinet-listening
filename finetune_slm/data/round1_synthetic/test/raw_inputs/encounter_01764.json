{
  "schema_version": "1.0",
  "encounter_id": "01764",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.15,
      "end_seconds": 6.8,
      "duration_seconds": 5.65,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.51,
      "end_seconds": 12.56,
      "duration_seconds": 4.05,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.52,
      "end_seconds": 18.72,
      "duration_seconds": 4.2,
      "text": "I wanted to get painful periods looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.69,
      "end_seconds": 24.34,
      "duration_seconds": 3.65,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.11,
      "end_seconds": 28.64,
      "duration_seconds": 2.53,
      "text": "Ever since... since yesterday, really."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.09,
      "end_seconds": 38.42,
      "duration_seconds": 9.33,
      "text": "Understood. Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.28,
      "end_seconds": 48.69,
      "duration_seconds": 8.41,
      "text": "I notice it more with first two days. I'd say a few times a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.34,
      "end_seconds": 52.48,
      "duration_seconds": 3.14,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.07,
      "end_seconds": 64.51,
      "duration_seconds": 7.44,
      "text": "A dull ache in my back goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.48,
      "end_seconds": 70.48,
      "duration_seconds": 5.0,
      "text": "Have you had painful periods before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.02,
      "end_seconds": 77.78,
      "duration_seconds": 5.76,
      "text": "A bit, about six months ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.29,
      "end_seconds": 94.79,
      "duration_seconds": 3.5,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.82,
      "end_seconds": 99.88,
      "duration_seconds": 4.06,
      "text": "I had a bunion operation six years ago."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.73,
      "end_seconds": 103.36,
      "duration_seconds": 2.63,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.07,
      "end_seconds": 113.58,
      "duration_seconds": 8.51,
      "text": "Losartan. I take it 50 milligrams, once a day. I'm on ibuprofen, with food when needed."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.18,
      "end_seconds": 116.31,
      "duration_seconds": 2.13,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.15,
      "end_seconds": 118.85,
      "duration_seconds": 1.7,
      "text": "It's 400 milligrams."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.23,
      "end_seconds": 130.56,
      "duration_seconds": 2.33,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.41,
      "end_seconds": 135.43,
      "duration_seconds": 4.02,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.52,
      "end_seconds": 140.65,
      "duration_seconds": 4.13,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.49,
      "end_seconds": 146.76,
      "duration_seconds": 5.27,
      "text": "I've had high blood pressure for about a year now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.77,
      "end_seconds": 150.11,
      "duration_seconds": 1.34,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.77,
      "end_seconds": 153.8,
      "duration_seconds": 3.03,
      "text": "I have gout, for two years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.43,
      "end_seconds": 166.32,
      "duration_seconds": 10.89,
      "text": "Right, so high blood pressure is already on your record. We'll keep that in mind today. Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.02,
      "end_seconds": 170.25,
      "duration_seconds": 3.23,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.47,
      "end_seconds": 173.89,
      "duration_seconds": 2.42,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.24,
      "end_seconds": 179.3,
      "duration_seconds": 4.06,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.07,
      "end_seconds": 182.71,
      "duration_seconds": 1.64,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.27,
      "end_seconds": 186.93,
      "duration_seconds": 3.66,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.02,
      "end_seconds": 191.2,
      "duration_seconds": 3.18,
      "text": "Have you had any pain with sex?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.54,
      "end_seconds": 196.97,
      "duration_seconds": 4.43,
      "text": "Not that I've noticed, no pain with sex."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.87,
      "end_seconds": 203.56,
      "duration_seconds": 4.69,
      "text": "Did you get bleeding between periods, fever or heavy bleeding?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.61,
      "end_seconds": 207.19,
      "duration_seconds": 2.58,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.71,
      "end_seconds": 210.55,
      "duration_seconds": 2.84,
      "text": "Alright, any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.98,
      "end_seconds": 214.24,
      "duration_seconds": 2.26,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.16,
      "end_seconds": 220.1,
      "duration_seconds": 3.94,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.62,
      "end_seconds": 232.38,
      "duration_seconds": 2.76,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.24,
      "end_seconds": 258.67,
      "duration_seconds": 9.43,
      "text": "Okay: saturation 98 percent, BP is 119 over 77. And respiratory rate 15, temp 36.6 degrees, pulse is 82 beats a minute."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.48,
      "end_seconds": 265.7,
      "duration_seconds": 4.22,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.49,
      "end_seconds": 269.31,
      "duration_seconds": 1.82,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.75,
      "end_seconds": 284.37,
      "duration_seconds": 3.62,
      "text": "Your tummy is soft and not tender between periods."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.12,
      "end_seconds": 293.07,
      "duration_seconds": 2.95,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.82,
      "end_seconds": 321.86,
      "duration_seconds": 16.04,
      "text": "From what you've told me and what I found, this looks most like primary dysmenorrhoea. Heat, gentle exercise, and start the tablet at the first sign of pain. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.84,
      "end_seconds": 325.76,
      "duration_seconds": 2.92,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.32,
      "end_seconds": 329.65,
      "duration_seconds": 1.33,
      "text": "All the best."
    }
  ]
}