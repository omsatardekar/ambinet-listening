{
  "schema_version": "1.0",
  "encounter_id": "03574",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.71,
      "end_seconds": 3.72,
      "duration_seconds": 3.01,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.45,
      "end_seconds": 9.83,
      "duration_seconds": 4.38,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.89,
      "end_seconds": 16.78,
      "duration_seconds": 4.89,
      "text": "So, I've been feeling tired and run down, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.81,
      "end_seconds": 21.9,
      "duration_seconds": 3.09,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.9,
      "end_seconds": 26.56,
      "duration_seconds": 3.66,
      "text": "It's been going on for about three months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.45,
      "end_seconds": 31.53,
      "duration_seconds": 3.08,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.18,
      "end_seconds": 34.36,
      "duration_seconds": 1.18,
      "text": "Mild, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.04,
      "end_seconds": 37.85,
      "duration_seconds": 2.81,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.86,
      "end_seconds": 42.82,
      "duration_seconds": 2.96,
      "text": "It usually comes with night sweats."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.02,
      "end_seconds": 46.04,
      "duration_seconds": 2.02,
      "text": "Any breathlessness or high fever?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.58,
      "end_seconds": 49.87,
      "duration_seconds": 3.29,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.37,
      "end_seconds": 54.01,
      "duration_seconds": 2.64,
      "text": "Any chest pain or leg weakness?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.62,
      "end_seconds": 58.18,
      "duration_seconds": 2.56,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.5,
      "end_seconds": 61.88,
      "duration_seconds": 2.38,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.55,
      "end_seconds": 64.33,
      "duration_seconds": 1.78,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.84,
      "end_seconds": 69.52,
      "duration_seconds": 3.68,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.32,
      "end_seconds": 77.22,
      "duration_seconds": 6.9,
      "text": "Oh, I've had COPD for five years now. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.99,
      "end_seconds": 83.69,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.28,
      "end_seconds": 89.14,
      "duration_seconds": 3.86,
      "text": "Arthritis in my knees, for about a year."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.7,
      "end_seconds": 98.33,
      "duration_seconds": 8.63,
      "text": "Yes, COPD is known to us, good to have that clear. Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.92,
      "end_seconds": 102.58,
      "duration_seconds": 3.66,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.68,
      "end_seconds": 110.26,
      "duration_seconds": 6.58,
      "text": "Can you list what you take, tablets, creams or inhalers? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.9,
      "end_seconds": 124.89,
      "duration_seconds": 9.99,
      "text": "Tiotropium inhaler, once a day for my chest. I take naproxen, twice a day for the knee pain."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.6,
      "end_seconds": 128.8,
      "duration_seconds": 2.2,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.79,
      "end_seconds": 134.89,
      "duration_seconds": 5.1,
      "text": "250 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.51,
      "end_seconds": 139.1,
      "duration_seconds": 2.59,
      "text": "Roughly how long on that one?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.78,
      "end_seconds": 142.25,
      "duration_seconds": 1.47,
      "text": "Two months now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.87,
      "end_seconds": 150.18,
      "duration_seconds": 3.31,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.97,
      "end_seconds": 153.32,
      "duration_seconds": 2.35,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.16,
      "end_seconds": 165.05,
      "duration_seconds": 2.89,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.83,
      "end_seconds": 171.07,
      "duration_seconds": 4.24,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.77,
      "end_seconds": 174.74,
      "duration_seconds": 1.97,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.86,
      "end_seconds": 178.2,
      "duration_seconds": 2.34,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.16,
      "end_seconds": 181.27,
      "duration_seconds": 2.11,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.04,
      "end_seconds": 186.24,
      "duration_seconds": 4.2,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.35,
      "end_seconds": 206.24,
      "duration_seconds": 3.89,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.06,
      "end_seconds": 215.16,
      "duration_seconds": 2.1,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.44,
      "end_seconds": 248.83,
      "duration_seconds": 14.39,
      "text": "Okay: pressure 116 over 70, height 180 centimetres, weight 62 kilos, pulse is 92 beats a minute, respiratory rate 18, temperature 38.6, oxygen saturation is 97 percent, BMI works out to 19.1."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.46,
      "end_seconds": 250.88,
      "duration_seconds": 1.42,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.52,
      "end_seconds": 255.19,
      "duration_seconds": 3.67,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.15,
      "end_seconds": 260.9,
      "duration_seconds": 3.75,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.55,
      "end_seconds": 272.61,
      "duration_seconds": 1.06,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.48,
      "end_seconds": 275.74,
      "duration_seconds": 2.26,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.06,
      "end_seconds": 295.55,
      "duration_seconds": 7.49,
      "text": "There is a soft heart murmur you've not had before and a small tender spot on the fingertip."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.83,
      "end_seconds": 328.93,
      "duration_seconds": 30.1,
      "text": "That's the examination finished. From what you've told me and what I found, the most likely explanation is possible infection of the heart valve causing back and general symptoms. I'd also keep a muscle strain in mind. I'm going to order an MRI of the spine, for persistent back pain with systemic symptoms. That will help us see what's going on underneath and decide the next step. Let's get an echocardiogram, for new murmur."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.41,
      "end_seconds": 349.58,
      "duration_seconds": 19.17,
      "text": "This is not an ordinary back strain, so I want tests today. We'll refer you to the medical admissions unit. Please don't wait if the symptoms get worse. That's when to be seen urgently. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.4,
      "end_seconds": 354.32,
      "duration_seconds": 2.92,
      "text": "Thank you, uh, that's helpful."
    }
  ]
}