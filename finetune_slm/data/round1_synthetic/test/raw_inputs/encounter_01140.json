{
  "schema_version": "1.0",
  "encounter_id": "01140",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.57,
      "end_seconds": 7.09,
      "duration_seconds": 6.52,
      "text": "Let me think, you know, sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.09,
      "end_seconds": 14.09,
      "duration_seconds": 5.0,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.96,
      "end_seconds": 23.4,
      "duration_seconds": 8.44,
      "text": "Doctor, it's a dry cough in the evenings. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.28,
      "end_seconds": 27.72,
      "duration_seconds": 3.44,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.88,
      "end_seconds": 31.78,
      "duration_seconds": 2.9,
      "text": "About... well, about two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.35,
      "end_seconds": 36.0,
      "duration_seconds": 2.65,
      "text": "Have you tried anything for it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.92,
      "end_seconds": 47.56,
      "duration_seconds": 9.64,
      "text": "I mean, antihistamine helps a bit. Oh, you know, and there's sneezing fits as well, six months now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.91,
      "end_seconds": 51.65,
      "duration_seconds": 2.74,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.69,
      "end_seconds": 56.18,
      "duration_seconds": 3.49,
      "text": "It happens a few times a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.05,
      "end_seconds": 62.87,
      "duration_seconds": 4.82,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.68,
      "end_seconds": 66.06,
      "duration_seconds": 1.38,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.44,
      "end_seconds": 90.02,
      "duration_seconds": 5.58,
      "text": "your chest is clear and your nose looks a little swollen inside"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.78,
      "end_seconds": 95.26,
      "duration_seconds": 2.48,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.38,
      "end_seconds": 108.24,
      "duration_seconds": 3.86,
      "text": "Any shortness of breath, wheeze or fever at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.52,
      "end_seconds": 113.55,
      "duration_seconds": 4.03,
      "text": "No, um, none that I've noticed."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.12,
      "end_seconds": 117.21,
      "duration_seconds": 3.09,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.38,
      "end_seconds": 119.98,
      "duration_seconds": 1.6,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.74,
      "end_seconds": 128.29,
      "duration_seconds": 3.55,
      "text": "right, a few questions about your lifestyle now"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.84,
      "end_seconds": 142.45,
      "duration_seconds": 12.61,
      "text": "I'm vegetarian and have been for years. I hardly move around during the day. I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.42,
      "end_seconds": 158.55,
      "duration_seconds": 5.13,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.13,
      "end_seconds": 161.84,
      "duration_seconds": 1.71,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.76,
      "end_seconds": 165.71,
      "duration_seconds": 1.95,
      "text": "what about your medical history?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.85,
      "end_seconds": 172.34,
      "duration_seconds": 5.49,
      "text": "Yes, COPD. I've had eczema for nearly five years now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.02,
      "end_seconds": 181.67,
      "duration_seconds": 8.65,
      "text": "mm-hmm yes, eczema is known to us, good to have that that clear have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.72,
      "end_seconds": 186.36,
      "duration_seconds": 3.64,
      "text": "Uh, no, not at all."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.05,
      "end_seconds": 191.74,
      "duration_seconds": 3.69,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.63,
      "end_seconds": 198.72,
      "duration_seconds": 5.09,
      "text": "Uh, I take Tiotropium inhaler, once a day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.21,
      "end_seconds": 200.16,
      "duration_seconds": 0.95,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.92,
      "end_seconds": 208.09,
      "duration_seconds": 6.17,
      "text": "Hydrocortisone cream i take it when needed for the eczema"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.04,
      "end_seconds": 213.99,
      "duration_seconds": 3.95,
      "text": "So, how long have you been on it?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.28,
      "end_seconds": 221.99,
      "duration_seconds": 6.71,
      "text": "About about three months. So, I take loratadine, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.74,
      "end_seconds": 224.8,
      "duration_seconds": 2.06,
      "text": "Right, is that long-standing?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.0,
      "end_seconds": 230.84,
      "duration_seconds": 1.84,
      "text": "For two months."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.74,
      "end_seconds": 238.16,
      "duration_seconds": 6.42,
      "text": "Right, here's what I'm thinking. This is probably seasonal hay fever causing the cough."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.67,
      "end_seconds": 241.79,
      "duration_seconds": 3.12,
      "text": "Hmm, is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.35,
      "end_seconds": 265.13,
      "duration_seconds": 22.78,
      "text": "I understand the worry. At the moment I'd say it's seasonal hay fever causing the cough, and we'll watch how it goes. Just to be sure I understood. You've had a dry cough in the evenings for about two weeks, and no wheeze or shortness of breath."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.85,
      "end_seconds": 269.0,
      "duration_seconds": 2.15,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.51,
      "end_seconds": 286.49,
      "duration_seconds": 8.98,
      "text": "You'll be taking fluticasone nasal spray, 50 micrograms, once a day, for the season. It's for hay fever."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.46,
      "end_seconds": 293.39,
      "duration_seconds": 1.93,
      "text": "thank you, doctor"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.44,
      "end_seconds": 305.39,
      "duration_seconds": 9.95,
      "text": "Keep windows closed on high-pollen days and wash your hair at night. Book a review in a month. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.47,
      "end_seconds": 311.14,
      "duration_seconds": 3.67,
      "text": "okay, that makes sense thanks for explaining"
    }
  ]
}