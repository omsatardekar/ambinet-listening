{
  "schema_version": "1.0",
  "encounter_id": "01963",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.09,
      "end_seconds": 5.14,
      "duration_seconds": 4.05,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.57,
      "end_seconds": 12.86,
      "duration_seconds": 4.29,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.16,
      "end_seconds": 18.67,
      "duration_seconds": 4.51,
      "text": "Um, so... painful periods. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.3,
      "end_seconds": 22.11,
      "duration_seconds": 2.81,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.93,
      "end_seconds": 29.92,
      "duration_seconds": 5.99,
      "text": "Around about three months... no wait, it's more like six months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.19,
      "end_seconds": 43.78,
      "duration_seconds": 9.59,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.71,
      "end_seconds": 67.99,
      "duration_seconds": 23.28,
      "text": "It's every other day. About a four out of ten. First two days definitely sets it off. I've been feeling sick on the first day too, for three weeks. I've had a dull ache in my back too, for four weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.26,
      "end_seconds": 74.52,
      "duration_seconds": 5.26,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.46,
      "end_seconds": 78.13,
      "duration_seconds": 2.67,
      "text": "It happens all the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.01,
      "end_seconds": 84.36,
      "duration_seconds": 5.35,
      "text": "Have you noticed heavy bleeding, bleeding between periods or pain with sex?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.06,
      "end_seconds": 92.94,
      "duration_seconds": 3.88,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.61,
      "end_seconds": 94.79,
      "duration_seconds": 1.18,
      "text": "What about fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.96,
      "end_seconds": 99.2,
      "duration_seconds": 3.24,
      "text": "No, I haven't had any fever."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.35,
      "end_seconds": 101.81,
      "duration_seconds": 1.46,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.84,
      "end_seconds": 104.79,
      "duration_seconds": 1.95,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.9,
      "end_seconds": 109.35,
      "duration_seconds": 3.45,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.09,
      "end_seconds": 112.76,
      "duration_seconds": 1.67,
      "text": "Yes, heart disease."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.79,
      "end_seconds": 123.38,
      "duration_seconds": 9.59,
      "text": "Okay, I can see heart disease in your file as well. Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.12,
      "end_seconds": 136.77,
      "duration_seconds": 12.65,
      "text": "I retired from the post office two years ago. I swim twice a week. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.44,
      "end_seconds": 141.51,
      "duration_seconds": 3.07,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.49,
      "end_seconds": 150.2,
      "duration_seconds": 6.71,
      "text": "Just a cataract operation in my left eye, about a year ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.31,
      "end_seconds": 155.21,
      "duration_seconds": 3.9,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.18,
      "end_seconds": 165.61,
      "duration_seconds": 9.43,
      "text": "I had a reaction to naproxen when I was younger, a rash, and I've avoided it since."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.39,
      "end_seconds": 171.89,
      "duration_seconds": 4.5,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.13,
      "end_seconds": 182.51,
      "duration_seconds": 9.38,
      "text": "Metoprolol, 50 milligrams, twice a day for my heart. Ibuprofen. I take it 400 milligrams, with food when needed."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.77,
      "end_seconds": 196.88,
      "duration_seconds": 2.11,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.95,
      "end_seconds": 212.85,
      "duration_seconds": 2.9,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.38,
      "end_seconds": 232.21,
      "duration_seconds": 9.83,
      "text": "Okay: oxygen saturation is 99 percent, BP is 117 over 73. And pulse is 78 beats a minute, temperature is 37.0 degrees."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.1,
      "end_seconds": 235.45,
      "duration_seconds": 1.35,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.05,
      "end_seconds": 238.46,
      "duration_seconds": 2.41,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.22,
      "end_seconds": 245.41,
      "duration_seconds": 4.19,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.07,
      "end_seconds": 249.49,
      "duration_seconds": 2.42,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.38,
      "end_seconds": 271.66,
      "duration_seconds": 4.28,
      "text": "Your tummy is soft and not tender between periods."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.61,
      "end_seconds": 277.96,
      "duration_seconds": 2.35,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.76,
      "end_seconds": 299.48,
      "duration_seconds": 10.72,
      "text": "So where does that leave us? This looks most like primary dysmenorrhoea. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.23,
      "end_seconds": 320.4,
      "duration_seconds": 8.17,
      "text": "Heat, gentle exercise, and start the tablet at the first sign of pain. Come back in three months."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 322.27,
      "end_seconds": 326.27,
      "duration_seconds": 4.0,
      "text": "I can put that appointment in for you now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.59,
      "end_seconds": 331.66,
      "duration_seconds": 4.07,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.93,
      "end_seconds": 335.88,
      "duration_seconds": 2.95,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}