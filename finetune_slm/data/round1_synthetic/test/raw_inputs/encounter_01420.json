{
  "schema_version": "1.0",
  "encounter_id": "01420",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.92,
      "end_seconds": 3.62,
      "duration_seconds": 2.7,
      "text": "Good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.76,
      "end_seconds": 5.87,
      "duration_seconds": 1.11,
      "text": "Hi, thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.93,
      "end_seconds": 10.84,
      "duration_seconds": 2.91,
      "text": "Did you take the bus in?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.48,
      "end_seconds": 15.4,
      "duration_seconds": 3.92,
      "text": "I drove. The roads were quiet today."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.9,
      "end_seconds": 17.76,
      "duration_seconds": 1.86,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.59,
      "end_seconds": 27.67,
      "duration_seconds": 6.08,
      "text": "I've been feeling a bit muddled, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 29.4,
      "end_seconds": 41.02,
      "duration_seconds": 11.62,
      "text": "Here are the numbers, doctor. Heart rate 102, saturation 99 percent, blood pressure 97 over 56, temperature is 36.9 degrees, height 176 centimetres, weight 55 kilos."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.89,
      "end_seconds": 43.49,
      "duration_seconds": 1.6,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.13,
      "end_seconds": 64.16,
      "duration_seconds": 2.03,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.81,
      "end_seconds": 68.62,
      "duration_seconds": 2.81,
      "text": "Since Monday, that's when it began."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.85,
      "end_seconds": 72.42,
      "duration_seconds": 2.57,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 74.36,
      "end_seconds": 78.95,
      "duration_seconds": 4.59,
      "text": "Maybe a eight out of ten on a bad day."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.42,
      "end_seconds": 80.16,
      "duration_seconds": 0.74,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.89,
      "end_seconds": 91.24,
      "duration_seconds": 10.35,
      "text": "Oh, and dizziness on standing. Right, as for dizziness on standing, it just comes and goes. I get some relief from sitting."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.29,
      "end_seconds": 111.12,
      "duration_seconds": 4.83,
      "text": "Let me check a few things. Any falls, fever or chest pain?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 112.36,
      "end_seconds": 115.11,
      "duration_seconds": 2.75,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.32,
      "end_seconds": 119.02,
      "duration_seconds": 2.7,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.21,
      "end_seconds": 122.53,
      "duration_seconds": 2.32,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.55,
      "end_seconds": 128.62,
      "duration_seconds": 4.07,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.43,
      "end_seconds": 131.11,
      "duration_seconds": 1.68,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.09,
      "end_seconds": 136.36,
      "duration_seconds": 3.27,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.31,
      "end_seconds": 140.47,
      "duration_seconds": 3.16,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.56,
      "end_seconds": 145.8,
      "duration_seconds": 3.24,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 147.87,
      "end_seconds": 150.46,
      "duration_seconds": 2.59,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 151.21,
      "end_seconds": 154.48,
      "duration_seconds": 3.27,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.84,
      "end_seconds": 167.6,
      "duration_seconds": 11.76,
      "text": "I hardly move around during the day. I'm a bus driver, so I sit for long hours. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.51,
      "end_seconds": 174.62,
      "duration_seconds": 4.11,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.25,
      "end_seconds": 179.09,
      "duration_seconds": 2.84,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.49,
      "end_seconds": 199.98,
      "duration_seconds": 3.49,
      "text": "Your blood pressure drops a little on standing."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.45,
      "end_seconds": 207.54,
      "duration_seconds": 2.09,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.14,
      "end_seconds": 225.69,
      "duration_seconds": 10.55,
      "text": "Okay, thinking it through, I'm honestly not certain yet. It could be side effects from several medicines taken together, or it might be dehydration."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 227.62,
      "end_seconds": 229.22,
      "duration_seconds": 1.6,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.78,
      "end_seconds": 240.13,
      "duration_seconds": 9.35,
      "text": "Nothing I've seen today points to an emergency. It looks like side effects from several medicines taken together, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.96,
      "end_seconds": 262.35,
      "duration_seconds": 11.39,
      "text": "I think a medication review makes sense here, for polypharmacy. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 263.44,
      "end_seconds": 265.6,
      "duration_seconds": 2.16,
      "text": "Is that done today?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.64,
      "end_seconds": 288.46,
      "duration_seconds": 20.82,
      "text": "I'm sending you for blood tests because of dizziness. We will stop the sleeping tablet slowly over two weeks. A short walk every day, even twenty minutes, will help more than you'd think. Let's get you seen by the pharmacist, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 290.19,
      "end_seconds": 290.89,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.4,
      "end_seconds": 297.44,
      "duration_seconds": 6.04,
      "text": "Please don't wait if the symptoms get worse. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 299.2,
      "end_seconds": 300.54,
      "duration_seconds": 1.34,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.05,
      "end_seconds": 308.31,
      "duration_seconds": 6.26,
      "text": "Let's plan a check in two weeks. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 310.96,
      "end_seconds": 314.3,
      "duration_seconds": 3.34,
      "text": "I think I understand everything. Thanks."
    }
  ]
}