{
  "schema_version": "1.0",
  "encounter_id": "03258",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.53,
      "end_seconds": 4.71,
      "duration_seconds": 4.18,
      "text": "Hi doctor, you know, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.33,
      "end_seconds": 9.41,
      "duration_seconds": 4.08,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.27,
      "end_seconds": 20.43,
      "duration_seconds": 9.16,
      "text": "Mainly hearing getting worse in both ears. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.53,
      "end_seconds": 27.81,
      "duration_seconds": 3.28,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.6,
      "end_seconds": 39.88,
      "duration_seconds": 2.28,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.65,
      "end_seconds": 67.84,
      "duration_seconds": 10.19,
      "text": "Okay: pulse 75, BP is 116 over 73, SpO2 99 percent on room air, temperature 36.8. What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.8,
      "end_seconds": 72.41,
      "duration_seconds": 3.61,
      "text": "It's been like this since last night."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.49,
      "end_seconds": 77.61,
      "duration_seconds": 3.12,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.59,
      "end_seconds": 96.82,
      "duration_seconds": 17.23,
      "text": "Maybe a eight out of ten on a bad day. And there's hearing better in a noisy room as well, about a week now. With hearing better in a noisy room, I'd call it moderate."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.76,
      "end_seconds": 116.91,
      "duration_seconds": 2.15,
      "text": "Did you notice any vertigo?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.59,
      "end_seconds": 119.07,
      "duration_seconds": 1.48,
      "text": "Nope, no vertigo."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.61,
      "end_seconds": 122.54,
      "duration_seconds": 2.93,
      "text": "Any facial weakness, ear pain or discharge?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.68,
      "end_seconds": 128.03,
      "duration_seconds": 4.35,
      "text": "No, no facial weakness, ear pain or discharge."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.29,
      "end_seconds": 132.81,
      "duration_seconds": 3.52,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.41,
      "end_seconds": 134.96,
      "duration_seconds": 1.55,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.67,
      "end_seconds": 151.31,
      "duration_seconds": 2.64,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.64,
      "end_seconds": 168.21,
      "duration_seconds": 15.57,
      "text": "I quit smoking around ten years ago. I'm a bus driver, so I sit for long hours. I grab fast food at lunch most days. I swim twice a week."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.31,
      "end_seconds": 172.05,
      "duration_seconds": 2.74,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.03,
      "end_seconds": 179.51,
      "duration_seconds": 1.48,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.22,
      "end_seconds": 200.27,
      "duration_seconds": 3.05,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.8,
      "end_seconds": 203.39,
      "duration_seconds": 1.59,
      "text": "I have depression."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.06,
      "end_seconds": 204.76,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.38,
      "end_seconds": 209.54,
      "duration_seconds": 3.16,
      "text": "I've had migraines for two years now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.47,
      "end_seconds": 218.16,
      "duration_seconds": 7.69,
      "text": "Yes, depression is known to us, good to have that clear. What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.96,
      "end_seconds": 229.17,
      "duration_seconds": 9.21,
      "text": "I'm on mirtazapine, 15 milligrams, at night for my mood. Propranolol. I take it 40 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.75,
      "end_seconds": 235.22,
      "duration_seconds": 4.47,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.25,
      "end_seconds": 238.64,
      "duration_seconds": 2.39,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.35,
      "end_seconds": 260.03,
      "duration_seconds": 6.68,
      "text": "Both ear drums look normal and the tuning fork is heard better through the bone."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.73,
      "end_seconds": 263.92,
      "duration_seconds": 1.19,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.01,
      "end_seconds": 291.17,
      "duration_seconds": 24.16,
      "text": "So, that's the examination finished. Right, here's what I'm thinking. I'd lean towards a conductive hearing loss, possibly otosclerosis. It could also be wax, so we'll keep that open. I'll request a CT scan of the ears, it'll help with possible otosclerosis. A hearing aid or an operation are both options after the tests."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.56,
      "end_seconds": 302.81,
      "duration_seconds": 11.25,
      "text": "Sure. I'd like you to see the ENT clinic as well, and I'll write the referral. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.08,
      "end_seconds": 306.97,
      "duration_seconds": 2.89,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.2,
      "end_seconds": 309.62,
      "duration_seconds": 1.42,
      "text": "Goodbye for now."
    }
  ]
}