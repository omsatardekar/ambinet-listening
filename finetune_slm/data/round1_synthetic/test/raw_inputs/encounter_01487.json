{
  "schema_version": "1.0",
  "encounter_id": "01487",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.63,
      "end_seconds": 3.76,
      "duration_seconds": 3.13,
      "text": "sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.66,
      "end_seconds": 14.86,
      "duration_seconds": 5.2,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.68,
      "end_seconds": 25.2,
      "duration_seconds": 5.52,
      "text": "I'm here cos of a red warm patch on my shin."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.88,
      "end_seconds": 29.13,
      "duration_seconds": 3.25,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.99,
      "end_seconds": 31.98,
      "duration_seconds": 1.99,
      "text": "Probably four weeks. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.97,
      "end_seconds": 35.3,
      "duration_seconds": 2.33,
      "text": "what eases it, if anything?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.87,
      "end_seconds": 41.68,
      "duration_seconds": 1.81,
      "text": "Elevation helps a bit"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.67,
      "end_seconds": 45.94,
      "duration_seconds": 2.27,
      "text": "any other symptoms with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.66,
      "end_seconds": 54.69,
      "duration_seconds": 6.03,
      "text": "A sore leg goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.99,
      "end_seconds": 65.44,
      "duration_seconds": 3.45,
      "text": "And And shortness of breath, any of that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.51,
      "end_seconds": 69.36,
      "duration_seconds": 2.85,
      "text": "Nope, no shortness of breath."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.9,
      "end_seconds": 74.28,
      "duration_seconds": 3.38,
      "text": "A few quick ones: cut or rash elsewhere?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.93,
      "end_seconds": 82.24,
      "duration_seconds": 4.31,
      "text": "I haven't had cut or rash elsewhere, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.64,
      "end_seconds": 87.63,
      "duration_seconds": 3.99,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.59,
      "end_seconds": 94.97,
      "duration_seconds": 2.38,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.87,
      "end_seconds": 99.13,
      "duration_seconds": 3.26,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.11,
      "end_seconds": 103.35,
      "duration_seconds": 3.24,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.78,
      "end_seconds": 113.28,
      "duration_seconds": 2.5,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.86,
      "end_seconds": 116.86,
      "duration_seconds": 3.0,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.7,
      "end_seconds": 136.66,
      "duration_seconds": 2.96,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.43,
      "end_seconds": 140.13,
      "duration_seconds": 2.7,
      "text": "no, nothing at the moment"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.18,
      "end_seconds": 143.68,
      "duration_seconds": 2.5,
      "text": "Alright, do you do any exercise?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.2,
      "end_seconds": 147.47,
      "duration_seconds": 2.27,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.76,
      "end_seconds": 154.76,
      "duration_seconds": 2.0,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.74,
      "end_seconds": 161.09,
      "duration_seconds": 4.35,
      "text": "My husband and I live above the shop"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.69,
      "end_seconds": 164.96,
      "duration_seconds": 3.27,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.04,
      "end_seconds": 172.59,
      "duration_seconds": 5.55,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.98,
      "end_seconds": 187.17,
      "duration_seconds": 4.19,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.75,
      "end_seconds": 201.87,
      "duration_seconds": 2.12,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.19,
      "end_seconds": 226.09,
      "duration_seconds": 8.9,
      "text": "Okay: pulse is 92 beats a minute, temp 39.0 degrees, blood pressure 123 over 77, saturation 97 percent."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.1,
      "end_seconds": 229.79,
      "duration_seconds": 1.69,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.75,
      "end_seconds": 235.03,
      "duration_seconds": 3.28,
      "text": "don't worry, we'll discuss it in a second"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.46,
      "end_seconds": 242.6,
      "duration_seconds": 5.14,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.98,
      "end_seconds": 245.98,
      "duration_seconds": 2.0,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.68,
      "end_seconds": 263.22,
      "duration_seconds": 8.54,
      "text": "The shin is red, warm and tender with a clear edge, and I've marked it with a pen."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.21,
      "end_seconds": 266.23,
      "duration_seconds": 1.02,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.57,
      "end_seconds": 279.16,
      "duration_seconds": 8.59,
      "text": "thank you, you can get dressed okay, so my impression is this: This looks most like cellulitis of the leg"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.01,
      "end_seconds": 282.81,
      "duration_seconds": 1.8,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.07,
      "end_seconds": 317.4,
      "duration_seconds": 30.33,
      "text": "Nothing I've seen today points to an emergency. It looks like cellulitis of the leg, but I'd like to confirm. I want blood tests done, that's for cellulitis. What I'm giving you is flucloxacillin, 500 milligrams, four times a day, seven days. You take it by mouth. That's for cellulitis. Keep the leg raised and come back if the redness goes past the pen line."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.33,
      "end_seconds": 328.63,
      "duration_seconds": 10.3,
      "text": "If the symptoms get worse, or you feel really unwell, please come to the emergency department. Let's review you in two days."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.69,
      "end_seconds": 331.36,
      "duration_seconds": 1.67,
      "text": "Yes, that's manageable."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.36,
      "end_seconds": 335.98,
      "duration_seconds": 2.62,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.15,
      "end_seconds": 341.01,
      "duration_seconds": 3.86,
      "text": "erm, good, thanks, I'll see you then"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.96,
      "end_seconds": 343.29,
      "duration_seconds": 1.33,
      "text": "Goodbye for now."
    }
  ]
}