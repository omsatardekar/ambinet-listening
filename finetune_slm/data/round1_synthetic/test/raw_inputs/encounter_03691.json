{
  "schema_version": "1.0",
  "encounter_id": "03691",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.64,
      "end_seconds": 2.36,
      "duration_seconds": 1.72,
      "text": "good afternoon, doctor"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.1,
      "end_seconds": 8.38,
      "duration_seconds": 4.28,
      "text": "Yes come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.78,
      "end_seconds": 20.48,
      "duration_seconds": 7.7,
      "text": "Honestly, it's not remembering the last hours, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.74,
      "end_seconds": 23.87,
      "duration_seconds": 2.13,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.83,
      "end_seconds": 36.96,
      "duration_seconds": 2.13,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.75,
      "end_seconds": 57.62,
      "duration_seconds": 7.87,
      "text": "Okay: pressure 125 over 75, heart rate 64, oxygen saturation is 98 percent. Did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.98,
      "end_seconds": 75.68,
      "duration_seconds": 16.7,
      "text": "ever since... since last weekend, really i wasn't sure whether to come in at all, to be honest ah, you know, I've also been feeling fine otherwise, since last weekend"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.81,
      "end_seconds": 80.29,
      "duration_seconds": 3.48,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.65,
      "end_seconds": 83.25,
      "duration_seconds": 1.6,
      "text": "I'd say mild"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.78,
      "end_seconds": 84.48,
      "duration_seconds": 0.7,
      "text": "understood"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.48,
      "end_seconds": 101.07,
      "duration_seconds": 2.59,
      "text": "Any seizure, slurred speech or weakness?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.19,
      "end_seconds": 107.11,
      "duration_seconds": 4.92,
      "text": "no seizure slurred speech or weakness none of it it"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.82,
      "end_seconds": 109.17,
      "duration_seconds": 1.35,
      "text": "nothing like headache?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.24,
      "end_seconds": 111.93,
      "duration_seconds": 1.69,
      "text": "Definitely no headache."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.72,
      "end_seconds": 117.47,
      "duration_seconds": 3.75,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.71,
      "end_seconds": 122.27,
      "duration_seconds": 3.56,
      "text": "I mean, no, skin's been fine"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.28,
      "end_seconds": 128.62,
      "duration_seconds": 3.34,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.54,
      "end_seconds": 134.66,
      "duration_seconds": 5.12,
      "text": "I'm on metoprolol 50 milligrams maybe twice a day"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.56,
      "end_seconds": 138.86,
      "duration_seconds": 3.3,
      "text": "is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.18,
      "end_seconds": 142.59,
      "duration_seconds": 2.41,
      "text": "no, it's at home"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.79,
      "end_seconds": 159.69,
      "duration_seconds": 2.9,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.85,
      "end_seconds": 163.8,
      "duration_seconds": 2.95,
      "text": "I've I've got an irregular heartbeat"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.72,
      "end_seconds": 170.62,
      "duration_seconds": 4.9,
      "text": "do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.13,
      "end_seconds": 179.02,
      "duration_seconds": 3.89,
      "text": "Not to my knowledge, um, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.76,
      "end_seconds": 182.04,
      "duration_seconds": 1.28,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.87,
      "end_seconds": 186.69,
      "duration_seconds": 2.82,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.33,
      "end_seconds": 192.6,
      "duration_seconds": 4.27,
      "text": "what does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.2,
      "end_seconds": 196.94,
      "duration_seconds": 3.74,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.89,
      "end_seconds": 202.34,
      "duration_seconds": 3.45,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.42,
      "end_seconds": 207.83,
      "duration_seconds": 3.41,
      "text": "I look after my grandchildren most days"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.34,
      "end_seconds": 211.61,
      "duration_seconds": 3.27,
      "text": "Right, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.05,
      "end_seconds": 220.04,
      "duration_seconds": 4.99,
      "text": "oh uh no I've never been operated on"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.98,
      "end_seconds": 226.54,
      "duration_seconds": 4.56,
      "text": "I'd like to check you over now, if that's alright"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.43,
      "end_seconds": 231.17,
      "duration_seconds": 2.74,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.82,
      "end_seconds": 256.78,
      "duration_seconds": 7.96,
      "text": "you know who you are but not what happened this morning, and the examination otherwise is normal"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.26,
      "end_seconds": 265.06,
      "duration_seconds": 2.8,
      "text": "good you can sit up again"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.89,
      "end_seconds": 288.07,
      "duration_seconds": 11.18,
      "text": "taking everything into account, I'd lean towards transient global amnesia. I want to be honest that this is an impression, not a final answer"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.32,
      "end_seconds": 292.84,
      "duration_seconds": 3.52,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.17,
      "end_seconds": 313.52,
      "duration_seconds": 19.35,
      "text": "Nothing I've seen today points to an emergency. It looks like transient global amnesia, but I'd like to confirm. Just to be sure I understood. You've had not remembering the last hours, since last weekend, and no slurred speech or weakness."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.52,
      "end_seconds": 317.76,
      "duration_seconds": 3.24,
      "text": "hmm, that's what happened, yes"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.33,
      "end_seconds": 349.44,
      "duration_seconds": 31.11,
      "text": "I'm sending you for a CT scan of the head because of acute memory loss. I'm sending you for a blood sugar because of confusion. It's a routine test and it'll give us a much clearer picture. This usually clears in a day with no lasting effect, but we do a scan first to be safe. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.39,
      "end_seconds": 351.59,
      "duration_seconds": 1.2,
      "text": "I understand"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.76,
      "end_seconds": 358.02,
      "duration_seconds": 5.26,
      "text": "we'll catch up tomorrow. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.58,
      "end_seconds": 361.99,
      "duration_seconds": 3.41,
      "text": "great thank you for your help"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.91,
      "end_seconds": 364.47,
      "duration_seconds": 1.56,
      "text": "have a good day"
    }
  ]
}