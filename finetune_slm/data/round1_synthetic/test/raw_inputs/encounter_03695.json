{
  "schema_version": "1.0",
  "encounter_id": "03695",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.09,
      "end_seconds": 6.07,
      "duration_seconds": 4.98,
      "text": "Doctor, we're ready in room two, I've already taken the observations."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.82,
      "end_seconds": 10.99,
      "duration_seconds": 4.17,
      "text": "Thank you. Good morning, tell me what's been going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.33,
      "end_seconds": 18.14,
      "duration_seconds": 5.81,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.42,
      "end_seconds": 22.82,
      "duration_seconds": 3.4,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 24.12,
      "end_seconds": 28.84,
      "duration_seconds": 4.72,
      "text": "We came because of back pain that doesn't go away."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.32,
      "end_seconds": 32.99,
      "duration_seconds": 2.67,
      "text": "So, did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 34.56,
      "end_seconds": 36.51,
      "duration_seconds": 1.95,
      "text": "About... well, three weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.89,
      "end_seconds": 39.99,
      "duration_seconds": 3.1,
      "text": "Mm-hmm. Does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 41.77,
      "end_seconds": 52.67,
      "duration_seconds": 10.9,
      "text": "Night sweats goes along with it, most of the time. And I've been feeling tired and run down as well, since Friday."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.32,
      "end_seconds": 56.78,
      "duration_seconds": 3.46,
      "text": "Have you been losing a bit of weight?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 58.06,
      "end_seconds": 65.0,
      "duration_seconds": 6.94,
      "text": "Yeah. Four weeks, I'd say. The night sweats? That's been for three weeks."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.39,
      "end_seconds": 74.28,
      "duration_seconds": 3.89,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 75.99,
      "end_seconds": 79.4,
      "duration_seconds": 3.41,
      "text": "I mean, my sister had breast cancer."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.6,
      "end_seconds": 87.1,
      "duration_seconds": 2.5,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 87.61,
      "end_seconds": 91.3,
      "duration_seconds": 3.69,
      "text": "Just my tonsils removed, as a teenager."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.26,
      "end_seconds": 94.74,
      "duration_seconds": 2.48,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 95.7,
      "end_seconds": 98.18,
      "duration_seconds": 2.48,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 99.51,
      "end_seconds": 106.16,
      "duration_seconds": 6.65,
      "text": "I'm not sure that's right. I seem to recall a problem with naproxen."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 109.15,
      "end_seconds": 111.47,
      "duration_seconds": 2.32,
      "text": "Really? I don't think so."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.28,
      "end_seconds": 115.38,
      "duration_seconds": 3.1,
      "text": "Fair enough, I'll write down both versions."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.62,
      "end_seconds": 133.54,
      "duration_seconds": 2.92,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 135.44,
      "end_seconds": 140.6,
      "duration_seconds": 5.16,
      "text": "Propranolol. I take it 40 milligrams, maybe, twice a day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.21,
      "end_seconds": 146.64,
      "duration_seconds": 4.43,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 148.19,
      "end_seconds": 154.59,
      "duration_seconds": 6.4,
      "text": "No, it's at home. I'm on escitalopram, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.19,
      "end_seconds": 156.51,
      "duration_seconds": 1.32,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 160.31,
      "end_seconds": 165.16,
      "duration_seconds": 4.85,
      "text": "I, I used to take sumatriptan, but I stopped it."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.13,
      "end_seconds": 177.98,
      "duration_seconds": 2.85,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 178.73,
      "end_seconds": 182.34,
      "duration_seconds": 3.61,
      "text": "I have migraines, for about ten years."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.17,
      "end_seconds": 185.92,
      "duration_seconds": 2.75,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 187.74,
      "end_seconds": 190.7,
      "duration_seconds": 2.96,
      "text": "I have anxiety, for two years."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.73,
      "end_seconds": 204.66,
      "duration_seconds": 8.93,
      "text": "Yes, anxiety is known to us, good to have that clear. Okay, are you on your own at home?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 206.06,
      "end_seconds": 208.76,
      "duration_seconds": 2.7,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.61,
      "end_seconds": 212.56,
      "duration_seconds": 2.95,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 214.38,
      "end_seconds": 218.3,
      "duration_seconds": 3.92,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.11,
      "end_seconds": 224.73,
      "duration_seconds": 5.62,
      "text": "And what about high fever, breathlessness, leg weakness or chest pain?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 228.77,
      "end_seconds": 235.56,
      "duration_seconds": 6.79,
      "text": "No high fever, breathlessness, leg weakness or chest pain, none of it."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.18,
      "end_seconds": 240.41,
      "duration_seconds": 3.23,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 241.16,
      "end_seconds": 245.97,
      "duration_seconds": 4.81,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 247.34,
      "end_seconds": 259.13,
      "duration_seconds": 11.79,
      "text": "Doctor, I've got the readings for you. Weight 66 kilos, BMI works out to 25.8, height 160 centimetres. Pressure 111 over 71, pulse 98, temp 38.3 degrees."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.58,
      "end_seconds": 262.69,
      "duration_seconds": 2.11,
      "text": "Alright, good, thank you."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.25,
      "end_seconds": 268.33,
      "duration_seconds": 3.08,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 269.88,
      "end_seconds": 271.28,
      "duration_seconds": 1.4,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.31,
      "end_seconds": 274.85,
      "duration_seconds": 2.54,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.16,
      "end_seconds": 294.21,
      "duration_seconds": 8.05,
      "text": "There is a soft heart murmur you've not had before and a small tender spot on the fingertip."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.91,
      "end_seconds": 302.7,
      "duration_seconds": 2.79,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.38,
      "end_seconds": 327.4,
      "duration_seconds": 13.02,
      "text": "Okay, thinking it through, this is probably possible infection of the heart valve causing back and general symptoms. It could also be a muscle strain, so we'll keep that open."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 328.0,
      "end_seconds": 329.98,
      "duration_seconds": 1.98,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.92,
      "end_seconds": 346.08,
      "duration_seconds": 14.16,
      "text": "Nothing I've seen today points to an emergency. It looks like possible infection of the heart valve causing back and general symptoms, but I'd like to confirm. Have you had any tests for this so far?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 346.87,
      "end_seconds": 356.85,
      "duration_seconds": 9.98,
      "text": "Yeah, you know, I did have blood cultures done a few months ago, but the paper's at home."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.8,
      "end_seconds": 386.23,
      "duration_seconds": 28.43,
      "text": "I'm going to order an MRI of the spine, for persistent back pain with systemic symptoms. It's a routine test and it'll give us a much clearer picture. Let's book an echocardiogram to look into new murmur. This is not an ordinary back strain, so I want tests today. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 388.04,
      "end_seconds": 390.26,
      "duration_seconds": 2.22,
      "text": "Thank you, that's clear."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 392.01,
      "end_seconds": 396.97,
      "duration_seconds": 4.96,
      "text": "See me again straight away. Alright, does all of that make sense?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 398.96,
      "end_seconds": 402.14,
      "duration_seconds": 3.18,
      "text": "I think I understand everything. Thanks."
    }
  ]
}