{
  "schema_version": "1.0",
  "encounter_id": "01574",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.78,
      "end_seconds": 4.62,
      "duration_seconds": 3.84,
      "text": "sorry I'm a little late, um, doctor"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.93,
      "end_seconds": 11.35,
      "duration_seconds": 5.42,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.05,
      "end_seconds": 18.78,
      "duration_seconds": 5.73,
      "text": "Doctor, I've come along cos I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.62,
      "end_seconds": 23.12,
      "duration_seconds": 2.5,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.98,
      "end_seconds": 40.19,
      "duration_seconds": 14.21,
      "text": "um, I'm here because of a barking cough. I wasn't sure whether to come in at all, to be honest. I've been putting this off for weeks"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.69,
      "end_seconds": 44.66,
      "duration_seconds": 2.97,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.8,
      "end_seconds": 59.17,
      "duration_seconds": 2.37,
      "text": "nearly done with the readings.."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.97,
      "end_seconds": 84.61,
      "duration_seconds": 7.64,
      "text": "Okay: pressure 111 over 80, temperature 36.7, pulse 80, oxygen saturation is 98 percent, respiratory rate 14."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.18,
      "end_seconds": 99.12,
      "duration_seconds": 2.94,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.4,
      "end_seconds": 109.55,
      "duration_seconds": 9.15,
      "text": "Actually, I've had it for ten days. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.03,
      "end_seconds": 113.76,
      "duration_seconds": 2.73,
      "text": "is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.27,
      "end_seconds": 117.52,
      "duration_seconds": 3.25,
      "text": "honestly, once or twice a day"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.41,
      "end_seconds": 122.71,
      "duration_seconds": 3.3,
      "text": "Has there been a hoarse voice too?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.6,
      "end_seconds": 125.3,
      "duration_seconds": 1.7,
      "text": "Yeah, that too."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.68,
      "end_seconds": 129.7,
      "duration_seconds": 3.02,
      "text": "okay, any a runny nose as well?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.33,
      "end_seconds": 133.74,
      "duration_seconds": 3.41,
      "text": "Yes, about the same, about two weeks."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.82,
      "end_seconds": 140.66,
      "duration_seconds": 5.84,
      "text": "Any difficulty swallowing, blue lips, noisy breathing when resting or drooling at all?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.82,
      "end_seconds": 144.22,
      "duration_seconds": 2.4,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.64,
      "end_seconds": 151.27,
      "duration_seconds": 2.63,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.3,
      "end_seconds": 158.57,
      "duration_seconds": 2.27,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.65,
      "end_seconds": 164.7,
      "duration_seconds": 4.05,
      "text": "Alright, anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.47,
      "end_seconds": 174.8,
      "duration_seconds": 9.33,
      "text": "Ah, I've had asthma for five years now. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.17,
      "end_seconds": 180.78,
      "duration_seconds": 2.61,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.34,
      "end_seconds": 192.24,
      "duration_seconds": 9.9,
      "text": "Right, I've had acid reflux for nearly five years now. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.78,
      "end_seconds": 201.44,
      "duration_seconds": 7.66,
      "text": "Alright, asthma and acid reflux, that that matches what I have here. Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.9,
      "end_seconds": 205.33,
      "duration_seconds": 2.43,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.33,
      "end_seconds": 211.89,
      "duration_seconds": 4.56,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.4,
      "end_seconds": 226.15,
      "duration_seconds": 13.75,
      "text": "I drink a lot of tea and snack through the day. Not much, I mostly stay in these days. I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.45,
      "end_seconds": 232.32,
      "duration_seconds": 4.87,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.58,
      "end_seconds": 238.75,
      "duration_seconds": 5.17,
      "text": "Nickel i come out in... well, a rash on my skin"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.18,
      "end_seconds": 242.52,
      "duration_seconds": 2.34,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.76,
      "end_seconds": 250.26,
      "duration_seconds": 6.5,
      "text": "Right, I had a meniscus repair on my knee four years ago."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.94,
      "end_seconds": 254.54,
      "duration_seconds": 3.6,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 256.24,
      "end_seconds": 264.1,
      "duration_seconds": 7.86,
      "text": "He takes Asthalin inhaler, when needed. He takes omeprazole, 20 milligrams, once a day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.62,
      "end_seconds": 272.07,
      "duration_seconds": 2.45,
      "text": "Pantoprazole I don't take anymore"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.26,
      "end_seconds": 286.57,
      "duration_seconds": 4.31,
      "text": "Right, here's what I'm thinking. It points towards mild croup."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.89,
      "end_seconds": 307.93,
      "duration_seconds": 9.04,
      "text": "let's use dexamethasone, 0.15 mg per kg, once, single dose. You take it by mouth. That should help with croup"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.63,
      "end_seconds": 311.99,
      "duration_seconds": 3.36,
      "text": "Alright, I'll pick it up today."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.04,
      "end_seconds": 330.16,
      "duration_seconds": 13.12,
      "text": "Keep him calm, sit him upright, and give fluids. Let's plan a check if no better in two days. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.74,
      "end_seconds": 338.72,
      "duration_seconds": 2.98,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.09,
      "end_seconds": 344.43,
      "duration_seconds": 1.34,
      "text": "Goodbye for now."
    }
  ]
}