{
  "schema_version": "1.0",
  "encounter_id": "03191",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.67,
      "end_seconds": 2.84,
      "duration_seconds": 2.17,
      "text": "Right then, come on in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.5,
      "end_seconds": 8.07,
      "duration_seconds": 3.57,
      "text": "Hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.64,
      "end_seconds": 12.5,
      "duration_seconds": 2.86,
      "text": "How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.44,
      "end_seconds": 18.3,
      "duration_seconds": 3.86,
      "text": "I've been dealing with a yellow discharge."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.01,
      "end_seconds": 22.38,
      "duration_seconds": 3.37,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.07,
      "end_seconds": 27.23,
      "duration_seconds": 4.16,
      "text": "Okay, so it's been about three months now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.26,
      "end_seconds": 34.15,
      "duration_seconds": 4.89,
      "text": "Any a red sore wound after your operation as well?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 35.65,
      "end_seconds": 55.47,
      "duration_seconds": 19.82,
      "text": "Yeah, yes, for two weeks. As for red sore wound after my operation, moderate, I'd say. As for pain around the wound, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 56.16,
      "end_seconds": 59.42,
      "duration_seconds": 3.26,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 61.08,
      "end_seconds": 64.32,
      "duration_seconds": 3.24,
      "text": "About a five out of ten."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.03,
      "end_seconds": 66.81,
      "duration_seconds": 0.78,
      "text": "Any vomiting?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 67.61,
      "end_seconds": 69.18,
      "duration_seconds": 1.57,
      "text": "No. No vomiting."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.12,
      "end_seconds": 74.95,
      "duration_seconds": 3.83,
      "text": "Did you get breathlessness, calf pain or chest pain?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.99,
      "end_seconds": 80.97,
      "duration_seconds": 3.98,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.88,
      "end_seconds": 85.9,
      "duration_seconds": 4.02,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.61,
      "end_seconds": 88.7,
      "duration_seconds": 2.09,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.25,
      "end_seconds": 93.09,
      "duration_seconds": 3.84,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.59,
      "end_seconds": 97.48,
      "duration_seconds": 2.89,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.53,
      "end_seconds": 102.12,
      "duration_seconds": 3.59,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.94,
      "end_seconds": 117.21,
      "duration_seconds": 13.27,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.54,
      "end_seconds": 122.59,
      "duration_seconds": 2.05,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.27,
      "end_seconds": 126.97,
      "duration_seconds": 3.7,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.6,
      "end_seconds": 128.97,
      "duration_seconds": 1.37,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.86,
      "end_seconds": 133.68,
      "duration_seconds": 3.82,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.45,
      "end_seconds": 137.28,
      "duration_seconds": 2.83,
      "text": "Right, do you do any exercise?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 138.19,
      "end_seconds": 141.19,
      "duration_seconds": 3.0,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.26,
      "end_seconds": 145.43,
      "duration_seconds": 3.17,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 145.97,
      "end_seconds": 149.6,
      "duration_seconds": 3.63,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.7,
      "end_seconds": 162.69,
      "duration_seconds": 2.99,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 164.39,
      "end_seconds": 168.8,
      "duration_seconds": 4.41,
      "text": "Erm, just a bunion operation, six years ago."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.63,
      "end_seconds": 174.61,
      "duration_seconds": 3.98,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.79,
      "end_seconds": 182.63,
      "duration_seconds": 6.84,
      "text": "COPD, for about ten years. I've had low haemoglobin for two years now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.22,
      "end_seconds": 193.8,
      "duration_seconds": 6.58,
      "text": "Right, so low haemoglobin is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.05,
      "end_seconds": 205.34,
      "duration_seconds": 3.29,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.05,
      "end_seconds": 214.25,
      "duration_seconds": 7.2,
      "text": "Iron tablets, once a day. Paracetamol. I take it 1 gram, maybe, when needed."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.22,
      "end_seconds": 220.79,
      "duration_seconds": 4.57,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 221.73,
      "end_seconds": 225.96,
      "duration_seconds": 4.23,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.37,
      "end_seconds": 240.17,
      "duration_seconds": 2.8,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.31,
      "end_seconds": 248.39,
      "duration_seconds": 2.08,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.02,
      "end_seconds": 267.16,
      "duration_seconds": 9.14,
      "text": "Okay: blood pressure 115 over 72, heart rate 98, temperature is 38.4 degrees. And SpO2 98 percent on room air."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.28,
      "end_seconds": 273.37,
      "duration_seconds": 5.09,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.24,
      "end_seconds": 275.72,
      "duration_seconds": 1.48,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.89,
      "end_seconds": 290.61,
      "duration_seconds": 7.72,
      "text": "The lower part of the wound is red, hot and weeping pus, and the edges have not come together."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 292.77,
      "end_seconds": 302.15,
      "duration_seconds": 9.38,
      "text": "You can sit up now. Having listened and examined, I'd lean towards a surgical wound infection. Another possibility is a stitch abscess."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 305.86,
      "end_seconds": 309.11,
      "duration_seconds": 3.25,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.09,
      "end_seconds": 330.22,
      "duration_seconds": 20.13,
      "text": "It's reasonable to be concerned, but right now a surgical wound infection is my leading thought, not anything worse. Let me just check I've got this right. You've had a yellow discharge for about three months, and no calf pain or chest pain."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 331.43,
      "end_seconds": 334.73,
      "duration_seconds": 3.3,
      "text": "That's what happened, um, yes."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 339.14,
      "end_seconds": 343.22,
      "duration_seconds": 4.08,
      "text": "We should do a wound swab for wound infection."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 344.11,
      "end_seconds": 346.92,
      "duration_seconds": 2.81,
      "text": "The earliest is Tuesday, 11:30 am."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 347.74,
      "end_seconds": 373.44,
      "duration_seconds": 25.7,
      "text": "Let's get blood tests, for wound infection. The result will help us decide whether anything more is needed. For this, flucloxacillin, 500 milligrams, four times a day, seven days. You take it by mouth. That should help with wound infection. The pharmacy will go through the details again when you pick it up."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 374.32,
      "end_seconds": 379.4,
      "duration_seconds": 5.08,
      "text": "I mean, alright, I'll pick it up today."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 381.25,
      "end_seconds": 395.67,
      "duration_seconds": 14.42,
      "text": "Keep it clean and dry and use fresh dressings daily. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 399.67,
      "end_seconds": 403.99,
      "duration_seconds": 4.32,
      "text": "Oh, yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 404.52,
      "end_seconds": 412.29,
      "duration_seconds": 7.77,
      "text": "I'd like you back in two days. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 412.87,
      "end_seconds": 417.6,
      "duration_seconds": 4.73,
      "text": "So, okay, that makes sense. Thanks for explaining."
    }
  ]
}