{
  "schema_version": "1.0",
  "encounter_id": "03653",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.66,
      "end_seconds": 6.4,
      "duration_seconds": 5.74,
      "text": "Okay, so hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.59,
      "end_seconds": 11.39,
      "duration_seconds": 3.8,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.92,
      "end_seconds": 17.94,
      "duration_seconds": 5.02,
      "text": "Ah, morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.94,
      "end_seconds": 22.21,
      "duration_seconds": 3.27,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.97,
      "end_seconds": 27.38,
      "duration_seconds": 4.41,
      "text": "So the thing is, I've got breathlessness during sport."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.83,
      "end_seconds": 32.19,
      "duration_seconds": 3.36,
      "text": "So, how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.25,
      "end_seconds": 36.8,
      "duration_seconds": 2.55,
      "text": "I'd say a week, maybe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 38.35,
      "end_seconds": 42.38,
      "duration_seconds": 4.03,
      "text": "I think it's been nearer two weeks, actually."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.68,
      "end_seconds": 48.19,
      "duration_seconds": 4.51,
      "text": "Okay, so roughly one to two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.84,
      "end_seconds": 53.66,
      "duration_seconds": 4.82,
      "text": "Sorry, what was I saying, I suppose so, yes."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.54,
      "end_seconds": 58.07,
      "duration_seconds": 2.53,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.6,
      "end_seconds": 66.53,
      "duration_seconds": 6.93,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.24,
      "end_seconds": 73.64,
      "duration_seconds": 5.4,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.27,
      "end_seconds": 76.27,
      "duration_seconds": 2.0,
      "text": "I'd call it severe."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.21,
      "end_seconds": 80.27,
      "duration_seconds": 2.06,
      "text": "Is anything making it worse?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.81,
      "end_seconds": 85.05,
      "duration_seconds": 2.24,
      "text": "It's worse with sport."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.83,
      "end_seconds": 92.41,
      "duration_seconds": 6.58,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 92.51,
      "end_seconds": 99.5,
      "duration_seconds": 6.99,
      "text": "Uh, uh, tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.58,
      "end_seconds": 104.34,
      "duration_seconds": 2.76,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.05,
      "end_seconds": 110.33,
      "duration_seconds": 4.28,
      "text": "That's fine, one at a time. I'll ask about everything."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.11,
      "end_seconds": 121.02,
      "duration_seconds": 8.91,
      "text": "Oh, you know, and chest tightness when pushing hard. That's been about the same, ten days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.8,
      "end_seconds": 127.38,
      "duration_seconds": 5.58,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.03,
      "end_seconds": 131.81,
      "duration_seconds": 2.78,
      "text": "I'd say every other day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.54,
      "end_seconds": 139.04,
      "duration_seconds": 5.5,
      "text": "Let me check a few things. Any cough, fainting or leg swelling?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.68,
      "end_seconds": 154.57,
      "duration_seconds": 14.89,
      "text": "No, no cough, no fainting, no leg swelling. I did have a flutter now and then at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.31,
      "end_seconds": 159.39,
      "duration_seconds": 3.08,
      "text": "Have you had fever, by any chance?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.73,
      "end_seconds": 162.22,
      "duration_seconds": 1.49,
      "text": "Nope, no fever."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 163.24,
      "end_seconds": 168.22,
      "duration_seconds": 4.98,
      "text": "Actually, doctor, I did notice fever. She doesn't always say."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.93,
      "end_seconds": 174.84,
      "duration_seconds": 5.91,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.92,
      "end_seconds": 185.04,
      "duration_seconds": 8.12,
      "text": "Alright, I'll note both what you've said and what you've noticed. Right, anything different when you pass water?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.91,
      "end_seconds": 189.21,
      "duration_seconds": 3.3,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.25,
      "end_seconds": 193.18,
      "duration_seconds": 2.93,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.19,
      "end_seconds": 199.53,
      "duration_seconds": 2.34,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.6,
      "end_seconds": 216.27,
      "duration_seconds": 3.67,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.0,
      "end_seconds": 220.05,
      "duration_seconds": 2.05,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.9,
      "end_seconds": 223.56,
      "duration_seconds": 1.66,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.77,
      "end_seconds": 229.22,
      "duration_seconds": 4.45,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.74,
      "end_seconds": 232.91,
      "duration_seconds": 2.17,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.81,
      "end_seconds": 237.84,
      "duration_seconds": 4.03,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.45,
      "end_seconds": 250.65,
      "duration_seconds": 3.2,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.8,
      "end_seconds": 254.16,
      "duration_seconds": 2.36,
      "text": "I've got high blood pressure."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.94,
      "end_seconds": 256.64,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.29,
      "end_seconds": 264.7,
      "duration_seconds": 7.41,
      "text": "I have an irregular heartbeat, for two years. I've had heart failure, yes."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.42,
      "end_seconds": 267.43,
      "duration_seconds": 1.01,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.94,
      "end_seconds": 274.76,
      "duration_seconds": 5.82,
      "text": "I've had high cholesterol, yes. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.16,
      "end_seconds": 286.2,
      "duration_seconds": 10.04,
      "text": "Alright, heart failure and high cholesterol, that matches what I have here. Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.97,
      "end_seconds": 299.71,
      "duration_seconds": 8.74,
      "text": "Sorry, what was I saying, yes, I'm allergic to grass pollen. Trimethoprim. I come out in... well, itching."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.12,
      "end_seconds": 304.62,
      "duration_seconds": 3.5,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.03,
      "end_seconds": 317.64,
      "duration_seconds": 11.61,
      "text": "Lisinopril. I take it 10 milligrams, once a day for my pressure. I'm on metoprolol, 50 milligrams, twice a day for the heart rhythm."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.92,
      "end_seconds": 328.83,
      "duration_seconds": 9.91,
      "text": "Ah, um, it's a... um, I can't remember what it's called. It's a little pink tablet."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.58,
      "end_seconds": 333.37,
      "duration_seconds": 2.79,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.06,
      "end_seconds": 343.36,
      "duration_seconds": 9.3,
      "text": "For my cholesterol, I believe. My wife sets them out for me, I just take what I'm given."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 345.39,
      "end_seconds": 353.5,
      "duration_seconds": 8.11,
      "text": "Okay, so the vitals from earlier. Temperature is 36.6 degrees, heart rate 68, saturation 97 percent. Pressure 119 over 76."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.21,
      "end_seconds": 354.91,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.3,
      "end_seconds": 359.35,
      "duration_seconds": 2.05,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.19,
      "end_seconds": 363.05,
      "duration_seconds": 2.86,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 374.53,
      "end_seconds": 379.87,
      "duration_seconds": 5.34,
      "text": "There is a harsh murmur that gets louder when you stand up."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 383.81,
      "end_seconds": 410.75,
      "duration_seconds": 26.94,
      "text": "You can relax now. Okay, thinking it through, this is probably possible hypertrophic cardiomyopathy. I want to be honest that this is an impression, not a final answer. It could also be athlete's heart, so we'll keep that open. An innocent flow murmur is also on my list. I'd like to arrange an echocardiogram for murmur."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 411.53,
      "end_seconds": 415.12,
      "duration_seconds": 3.59,
      "text": "We've already done an ECG this morning, doctor."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 416.16,
      "end_seconds": 432.22,
      "duration_seconds": 16.06,
      "text": "Okay, I'll take a look at that. I'd like to arrange a heart monitor for palpitations. No competitive sport until the heart scan, and we will check your close family. We'll refer you to the inherited cardiac conditions clinic."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 432.92,
      "end_seconds": 433.62,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 434.99,
      "end_seconds": 443.63,
      "duration_seconds": 8.64,
      "text": "If the symptoms get worse, that's the point to come in urgently. Please come and see me after the scan."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 444.33,
      "end_seconds": 446.37,
      "duration_seconds": 2.04,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 448.3,
      "end_seconds": 453.84,
      "duration_seconds": 5.54,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 455.81,
      "end_seconds": 458.81,
      "duration_seconds": 3.0,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 459.46,
      "end_seconds": 460.83,
      "duration_seconds": 1.37,
      "text": "Goodbye for now."
    }
  ]
}