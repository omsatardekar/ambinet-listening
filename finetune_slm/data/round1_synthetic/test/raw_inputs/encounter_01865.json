{
  "schema_version": "1.0",
  "encounter_id": "01865",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.07,
      "end_seconds": 7.75,
      "duration_seconds": 6.68,
      "text": "Doctor, your next patient is here. I've done the basics, I'll read them out in a moment."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.54,
      "end_seconds": 12.93,
      "duration_seconds": 3.39,
      "text": "Okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.84,
      "end_seconds": 18.25,
      "duration_seconds": 3.41,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.8,
      "end_seconds": 21.53,
      "duration_seconds": 2.73,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 23.37,
      "end_seconds": 27.17,
      "duration_seconds": 3.8,
      "text": "We came because of loose stools with blood."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.12,
      "end_seconds": 32.9,
      "duration_seconds": 3.78,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 34.07,
      "end_seconds": 40.36,
      "duration_seconds": 6.29,
      "text": "Hydrocortisone cream, when needed for the eczema. It's Thyronorm, every morning."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.92,
      "end_seconds": 44.22,
      "duration_seconds": 2.3,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 45.5,
      "end_seconds": 54.64,
      "duration_seconds": 9.14,
      "text": "50 micrograms, I think that's what's on the box. Sodium valproate. I take it 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.72,
      "end_seconds": 59.58,
      "duration_seconds": 2.86,
      "text": "Roughly how long on that one?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 61.48,
      "end_seconds": 63.47,
      "duration_seconds": 1.99,
      "text": "For about a year."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.95,
      "end_seconds": 67.91,
      "duration_seconds": 2.96,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 69.37,
      "end_seconds": 71.88,
      "duration_seconds": 2.51,
      "text": "I'd say three days, maybe."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 77.72,
      "end_seconds": 80.88,
      "duration_seconds": 3.16,
      "text": "It was closer to five days, doctor."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.91,
      "end_seconds": 87.82,
      "duration_seconds": 4.91,
      "text": "Okay, so roughly three to five days. Is that right?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 89.7,
      "end_seconds": 90.85,
      "duration_seconds": 1.15,
      "text": "Yeah, roughly."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.28,
      "end_seconds": 95.89,
      "duration_seconds": 3.61,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 99.63,
      "end_seconds": 104.23,
      "duration_seconds": 4.6,
      "text": "I'd give it a four, out of ten."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.29,
      "end_seconds": 109.06,
      "duration_seconds": 2.77,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 114.2,
      "end_seconds": 116.58,
      "duration_seconds": 2.38,
      "text": "Honestly, every other day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.38,
      "end_seconds": 120.1,
      "duration_seconds": 2.72,
      "text": "Have you had cramping tummy pain?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 121.96,
      "end_seconds": 129.89,
      "duration_seconds": 7.93,
      "text": "Yes, about the same, two days. About cramping tummy pain, it happens on and off."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.98,
      "end_seconds": 134.4,
      "duration_seconds": 3.42,
      "text": "What about mouth ulcers, have you noticed that?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 136.15,
      "end_seconds": 137.77,
      "duration_seconds": 1.62,
      "text": "Yeah, that too."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.28,
      "end_seconds": 138.98,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 142.84,
      "end_seconds": 144.45,
      "duration_seconds": 1.61,
      "text": "Oh, and tiredness."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.36,
      "end_seconds": 146.2,
      "duration_seconds": 0.84,
      "text": "Any fever?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 147.5,
      "end_seconds": 150.58,
      "duration_seconds": 3.08,
      "text": "Not that I've noticed, no fever."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 152.04,
      "end_seconds": 156.86,
      "duration_seconds": 4.82,
      "text": "Actually, doctor, I did notice fever. He doesn't always say."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 158.33,
      "end_seconds": 165.23,
      "duration_seconds": 6.9,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.04,
      "end_seconds": 176.44,
      "duration_seconds": 9.4,
      "text": "Alright, I'll note both what you've said and what you've noticed. And what about vomiting, weight loss or joint pain?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 177.61,
      "end_seconds": 180.56,
      "duration_seconds": 2.95,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.34,
      "end_seconds": 184.2,
      "duration_seconds": 2.86,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 188.02,
      "end_seconds": 190.53,
      "duration_seconds": 2.51,
      "text": "Oh, no, that's all fine."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.28,
      "end_seconds": 195.71,
      "duration_seconds": 4.43,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 196.29,
      "end_seconds": 197.67,
      "duration_seconds": 1.38,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.23,
      "end_seconds": 199.56,
      "duration_seconds": 1.33,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 200.21,
      "end_seconds": 203.06,
      "duration_seconds": 2.85,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.35,
      "end_seconds": 208.55,
      "duration_seconds": 4.2,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 209.85,
      "end_seconds": 219.1,
      "duration_seconds": 9.25,
      "text": "I have eczema, for about a year. I have an underactive thyroid, for about ten years. I've got epilepsy."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.06,
      "end_seconds": 226.63,
      "duration_seconds": 5.57,
      "text": "Okay, I can see eczema in your file as well. Do you smoke?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 230.8,
      "end_seconds": 235.21,
      "duration_seconds": 4.41,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.52,
      "end_seconds": 238.82,
      "duration_seconds": 2.3,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 239.89,
      "end_seconds": 243.9,
      "duration_seconds": 4.01,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.47,
      "end_seconds": 247.46,
      "duration_seconds": 1.99,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 248.2,
      "end_seconds": 250.56,
      "duration_seconds": 2.36,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.19,
      "end_seconds": 253.83,
      "duration_seconds": 2.64,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 255.41,
      "end_seconds": 259.42,
      "duration_seconds": 4.01,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 260.16,
      "end_seconds": 271.0,
      "duration_seconds": 10.84,
      "text": "Doctor, I've got the readings for you. Temperature 36.9, BP is 118 over 78, respiratory rate 15, pulse 66, oxygen saturation is 98 percent."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.16,
      "end_seconds": 273.06,
      "duration_seconds": 0.9,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.93,
      "end_seconds": 279.48,
      "duration_seconds": 4.55,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 294.05,
      "end_seconds": 295.15,
      "duration_seconds": 1.1,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.94,
      "end_seconds": 298.29,
      "duration_seconds": 1.35,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.35,
      "end_seconds": 318.41,
      "duration_seconds": 5.06,
      "text": "There is tenderness in the lower right tummy and no guarding."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.96,
      "end_seconds": 325.72,
      "duration_seconds": 2.76,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.01,
      "end_seconds": 349.52,
      "duration_seconds": 8.51,
      "text": "Putting it all together, this is probably a flare of inflammatory bowel disease. I can't rule out an infection yet."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 351.24,
      "end_seconds": 354.6,
      "duration_seconds": 3.36,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.49,
      "end_seconds": 363.89,
      "duration_seconds": 8.4,
      "text": "It's reasonable to be concerned, but right now a flare of inflammatory bowel disease is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.3,
      "end_seconds": 382.41,
      "duration_seconds": 9.11,
      "text": "I'd like to arrange blood tests for flare. I think a stool test makes sense here, for bloody diarrhoea."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 384.29,
      "end_seconds": 386.17,
      "duration_seconds": 1.88,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 387.95,
      "end_seconds": 396.86,
      "duration_seconds": 8.91,
      "text": "I'd like you to take prednisolone, 40 milligrams, once a day, one week then reduce. It's for inflammatory bowel flare."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 397.73,
      "end_seconds": 400.61,
      "duration_seconds": 2.88,
      "text": "Alright, I'll pick it up today."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 401.41,
      "end_seconds": 413.76,
      "duration_seconds": 12.35,
      "text": "Keep up your fluids and call the IBD nurse if you get a fever. Please come and see me in two weeks. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 415.68,
      "end_seconds": 417.88,
      "duration_seconds": 2.2,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 418.73,
      "end_seconds": 420.43,
      "duration_seconds": 1.7,
      "text": "Right, look after yourself."
    }
  ]
}