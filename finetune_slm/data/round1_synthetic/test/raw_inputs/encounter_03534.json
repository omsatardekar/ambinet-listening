{
  "schema_version": "1.0",
  "encounter_id": "03534",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.05,
      "end_seconds": 4.96,
      "duration_seconds": 3.91,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.26,
      "end_seconds": 11.17,
      "duration_seconds": 4.91,
      "text": "Okay, yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.75,
      "end_seconds": 24.73,
      "duration_seconds": 11.98,
      "text": "Mainly a headache. There's a couple of other things, but that's the main one. Work has been very busy so I kept ignoring it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.82,
      "end_seconds": 31.61,
      "duration_seconds": 3.79,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.42,
      "end_seconds": 37.15,
      "duration_seconds": 3.73,
      "text": "It's been going on for four weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.73,
      "end_seconds": 42.61,
      "duration_seconds": 3.88,
      "text": "Alright, how strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.4,
      "end_seconds": 54.9,
      "duration_seconds": 10.5,
      "text": "It's mild, honestly. I've had cramps too, for about a week. With cramps, it happens all the time."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.61,
      "end_seconds": 60.56,
      "duration_seconds": 3.95,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.81,
      "end_seconds": 73.63,
      "duration_seconds": 11.82,
      "text": "I walk the dog every morning. I'm a hairdresser, on my feet all day. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.49,
      "end_seconds": 75.83,
      "duration_seconds": 1.34,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.76,
      "end_seconds": 82.06,
      "duration_seconds": 4.3,
      "text": "Nothing, um, I haven't had any operations."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.81,
      "end_seconds": 87.46,
      "duration_seconds": 3.65,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.39,
      "end_seconds": 94.43,
      "duration_seconds": 3.04,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.15,
      "end_seconds": 98.77,
      "duration_seconds": 3.62,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.4,
      "end_seconds": 106.75,
      "duration_seconds": 6.35,
      "text": "Sorry, what was I saying, no, nothing as far as I know."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.57,
      "end_seconds": 111.82,
      "duration_seconds": 3.25,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.85,
      "end_seconds": 116.66,
      "duration_seconds": 2.81,
      "text": "My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.2,
      "end_seconds": 134.42,
      "duration_seconds": 2.22,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.39,
      "end_seconds": 137.87,
      "duration_seconds": 1.48,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.35,
      "end_seconds": 156.46,
      "duration_seconds": 4.11,
      "text": "Have you noticed weakness on one side, fever or seizure?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.44,
      "end_seconds": 165.19,
      "duration_seconds": 4.75,
      "text": "No, no weakness on one side, fever or seizure."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.11,
      "end_seconds": 168.7,
      "duration_seconds": 2.59,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.47,
      "end_seconds": 171.25,
      "duration_seconds": 1.78,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.71,
      "end_seconds": 175.63,
      "duration_seconds": 2.92,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.15,
      "end_seconds": 179.13,
      "duration_seconds": 1.98,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 180.26,
      "end_seconds": 190.41,
      "duration_seconds": 10.15,
      "text": "Okay, so the vitals from earlier. Pressure 128 over 77, oxygen saturation is 99 percent, temp 36.7 degrees. Heart rate 85."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.37,
      "end_seconds": 192.9,
      "duration_seconds": 1.53,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.09,
      "end_seconds": 197.41,
      "duration_seconds": 3.32,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.25,
      "end_seconds": 200.72,
      "duration_seconds": 1.47,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.71,
      "end_seconds": 203.98,
      "duration_seconds": 1.27,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.36,
      "end_seconds": 227.09,
      "duration_seconds": 8.73,
      "text": "You are a bit slow and unsteady, but there is no weakness and your blood pressure is fine."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.86,
      "end_seconds": 232.9,
      "duration_seconds": 3.04,
      "text": "Alright, that's all I needed to check."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.86,
      "end_seconds": 249.93,
      "duration_seconds": 7.07,
      "text": "Having listened and examined, my working impression is a low salt level, possibly from the new antidepressant."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.56,
      "end_seconds": 296.77,
      "duration_seconds": 28.21,
      "text": "I want blood tests done, that's for confusion. We will stop the new tablet and not drink excess water until we have the result. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. Please don't wait if the symptoms get worse. That's when to be seen urgently. I'd like to see you again in two days."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.24,
      "end_seconds": 300.28,
      "duration_seconds": 2.04,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.28,
      "end_seconds": 304.89,
      "duration_seconds": 2.61,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.74,
      "end_seconds": 309.88,
      "duration_seconds": 4.14,
      "text": "Good, uh, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.89,
      "end_seconds": 312.63,
      "duration_seconds": 1.74,
      "text": "Have a good day."
    }
  ]
}