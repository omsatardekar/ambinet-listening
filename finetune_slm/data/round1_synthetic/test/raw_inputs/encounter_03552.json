  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.71,
      "end_seconds": 4.36,
      "duration_seconds": 3.65,
      "text": "Hello, sorry about the delay, do sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.14,
      "end_seconds": 6.14,
      "duration_seconds": 1.0,
      "text": "Hi thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.05,
      "end_seconds": 9.72,
      "duration_seconds": 2.67,
      "text": "What do you need help with?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.51,
      "end_seconds": 19.98,
      "duration_seconds": 9.47,
      "text": "Well mainly a bit breathless since. There's a couple of other things but that's the main one."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.3,
      "end_seconds": 24.28,
      "duration_seconds": 2.98,
      "text": "how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.87,
      "end_seconds": 27.7,
      "duration_seconds": 2.83,
      "text": "it's been five days now"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.63,
      "end_seconds": 32.4,
      "duration_seconds": 2.77,
      "text": "how much does it limit you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.27,
      "end_seconds": 38.11,
      "duration_seconds": 4.84,
      "text": "I'd give it it a six out of ten."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 38.36,
      "end_seconds": 39.06,
      "duration_seconds": 0.7,
      "text": "ah"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 39.8,
      "end_seconds": 44.57,
      "duration_seconds": 4.77,
      "text": "oh and a faster heartbeat had that since last night"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.13,
      "end_seconds": 48.14,
      "duration_seconds": 3.01,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.83,
      "end_seconds": 51.28,
      "duration_seconds": 1.45,
      "text": "It's mild honestly."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.71,
      "end_seconds": 56.28,
      "duration_seconds": 4.57,
      "text": "I follow. Right, I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.15,
      "end_seconds": 67.88,
      "duration_seconds": 2.73,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.49,
      "end_seconds": 94.54,
      "duration_seconds": 8.05,
      "text": "Okay: pulse 124, blood pressure 135 over 70. And respiratory rate 18, temperature 37.1, saturation 99 percent."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.13,
      "end_seconds": 101.73,
      "duration_seconds": 1.6,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.33,
      "end_seconds": 107.34,
      "duration_seconds": 4.01,
      "text": "don't worry, we'll discuss it in a second"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.79,
      "end_seconds": 113.17,
      "duration_seconds": 4.38,
      "text": "I'll examine you in a second make yourself comfortable."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.88,
      "end_seconds": 123.49,
      "duration_seconds": 1.61,
      "text": "fine by me"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.16,
      "end_seconds": 126.96,
      "duration_seconds": 1.8,
      "text": "okay, nearly finished here"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.14,
      "end_seconds": 146.0,
      "duration_seconds": 8.86,
      "text": "Your oxygen is lower than expected for someone so young and the left calf is a little swollen."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 151.05,
      "end_seconds": 157.74,
      "duration_seconds": 6.69,
      "text": "That's all I needed to check. Have you noticed coughing up blood, fever or chest pain?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.63,
      "end_seconds": 163.61,
      "duration_seconds": 4.98,
      "text": "I haven't had coughing up blood fever or chest pain no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.54,
      "end_seconds": 168.69,
      "duration_seconds": 3.15,
      "text": "how are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.43,
      "end_seconds": 172.24,
      "duration_seconds": 1.81,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.42,
      "end_seconds": 178.83,
      "duration_seconds": 3.41,
      "text": "anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 183.94,
      "end_seconds": 186.07,
      "duration_seconds": 2.13,
      "text": "No skin's been fine."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.66,
      "end_seconds": 191.31,
      "duration_seconds": 3.65,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.69,
      "end_seconds": 196.42,
      "duration_seconds": 3.73,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.75,
      "end_seconds": 199.35,
      "duration_seconds": 1.6,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.88,
      "end_seconds": 203.41,
      "duration_seconds": 2.53,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.18,
      "end_seconds": 217.51,
      "duration_seconds": 2.33,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 219.46,
      "end_seconds": 220.59,
      "duration_seconds": 1.13,
      "text": "no, none"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.52,
      "end_seconds": 227.3,
      "duration_seconds": 5.78,
      "text": "so has anything ever caused you a reaction? I mean any allergies"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 228.3,
      "end_seconds": 235.3,
      "duration_seconds": 7.0,
      "text": "years back I got a rash from naproxen, so I stay away from it now"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.29,
      "end_seconds": 243.26,
      "duration_seconds": 3.97,
      "text": "do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 245.09,
      "end_seconds": 246.52,
      "duration_seconds": 1.43,
      "text": "not really no"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.84,
      "end_seconds": 277.31,
      "duration_seconds": 14.47,
      "text": "Let me tell you where I've got to. It fits best with possible pulmonary embolism without chest pain. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.09,
      "end_seconds": 298.66,
      "duration_seconds": 4.57,
      "text": "I'm gonna order a CT pulmonary angiogram, for possible embolus"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 303.1,
      "end_seconds": 307.12,
      "duration_seconds": 4.02,
      "text": "we have a slot Wednesday at 9 am if that works"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 312.24,
      "end_seconds": 314.34,
      "duration_seconds": 2.1,
      "text": "okay, I'll be there"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 315.86,
      "end_seconds": 320.3,
      "duration_seconds": 4.44,
      "text": "We should do a D-dimer for syncope and calf swelling."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 322.1,
      "end_seconds": 324.37,
      "duration_seconds": 2.27,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 325.53,
      "end_seconds": 338.47,
      "duration_seconds": 12.94,
      "text": "Even without chest pain this needs a scan today, so please go to hospital. Please don't wait if the symptoms get worse. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 339.1,
      "end_seconds": 340.96,
      "duration_seconds": 1.86,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 346.81,
      "end_seconds": 351.19,
      "duration_seconds": 4.38,
      "text": "See me again straight away. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 353.21,
      "end_seconds": 357.01,
      "duration_seconds": 3.8,
      "text": "Okay that that makes sense. Thanks for explaining."
    }
  ]
