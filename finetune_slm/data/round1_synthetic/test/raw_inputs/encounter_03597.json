  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.26,
      "end_seconds": 5.13,
      "duration_seconds": 3.87,
      "text": "Hello, uh, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.64,
      "end_seconds": 10.9,
      "duration_seconds": 4.26,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.24,
      "end_seconds": 18.14,
      "duration_seconds": 3.9,
      "text": "It's back pain that doesn't go away, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.8,
      "end_seconds": 22.44,
      "duration_seconds": 3.64,
      "text": "what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.25,
      "end_seconds": 37.46,
      "duration_seconds": 9.21,
      "text": "I take Eltroxin, 100 micrograms, every morning for my thyroid. I take clopidogrel, once a day for the stent."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.08,
      "end_seconds": 40.38,
      "duration_seconds": 2.3,
      "text": "do you know the dose?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.08,
      "end_seconds": 42.05,
      "duration_seconds": 0.97,
      "text": "75 milligrams."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.47,
      "end_seconds": 46.83,
      "duration_seconds": 1.36,
      "text": "since when exactly?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.81,
      "end_seconds": 50.65,
      "duration_seconds": 2.84,
      "text": "For about a week, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.39,
      "end_seconds": 55.37,
      "duration_seconds": 2.98,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.95,
      "end_seconds": 58.16,
      "duration_seconds": 1.21,
      "text": "Severe, really."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.4,
      "end_seconds": 66.7,
      "duration_seconds": 3.3,
      "text": "have you noticed breathlessness or high fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.64,
      "end_seconds": 72.79,
      "duration_seconds": 3.15,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.71,
      "end_seconds": 77.03,
      "duration_seconds": 3.32,
      "text": "have you noticed chest pain or leg weakness?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.79,
      "end_seconds": 81.08,
      "duration_seconds": 3.29,
      "text": "no, none of those at all"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.62,
      "end_seconds": 85.52,
      "duration_seconds": 2.9,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.6,
      "end_seconds": 89.25,
      "duration_seconds": 1.65,
      "text": "no changes there"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.79,
      "end_seconds": 92.86,
      "duration_seconds": 3.07,
      "text": "Alright, what about your medical history?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.05,
      "end_seconds": 100.83,
      "duration_seconds": 3.78,
      "text": "Yes, an underactive thyroid. Yes, heart disease."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.81,
      "end_seconds": 108.51,
      "duration_seconds": 5.7,
      "text": "Yes, an underactive thyroid is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.08,
      "end_seconds": 128.63,
      "duration_seconds": 3.55,
      "text": "let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.57,
      "end_seconds": 133.81,
      "duration_seconds": 3.24,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.13,
      "end_seconds": 152.03,
      "duration_seconds": 2.9,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.82,
      "end_seconds": 165.96,
      "duration_seconds": 13.14,
      "text": "I retired from the post office two years ago. I swim twice a week. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.53,
      "end_seconds": 169.99,
      "duration_seconds": 2.46,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.38,
      "end_seconds": 184.82,
      "duration_seconds": 2.44,
      "text": "okay, this won't take long.."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.52,
      "end_seconds": 211.1,
      "duration_seconds": 9.58,
      "text": "Okay: respiratory rate 21, temperature is 38.4 degrees, SpO2 97 percent on room air, pressure 113 over 76, pulse 105."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.89,
      "end_seconds": 217.44,
      "duration_seconds": 1.55,
      "text": "is that okay?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.17,
      "end_seconds": 220.88,
      "duration_seconds": 2.71,
      "text": "I'll come back to the numbers"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.51,
      "end_seconds": 227.63,
      "duration_seconds": 4.12,
      "text": "alright, now I'm going to do a short physical check"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.4,
      "end_seconds": 246.63,
      "duration_seconds": 1.23,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.41,
      "end_seconds": 250.46,
      "duration_seconds": 2.05,
      "text": "tell me if that's sore"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.7,
      "end_seconds": 271.76,
      "duration_seconds": 7.06,
      "text": "there is a soft heart murmur you've not had before and a small tender spot on the fingertip"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.26,
      "end_seconds": 275.87,
      "duration_seconds": 1.61,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.44,
      "end_seconds": 312.55,
      "duration_seconds": 28.11,
      "text": "Putting it all together, the most likely explanation is possible infection of the heart valve causing back and general symptoms. I want to be honest that this is an impression, not a final answer. I'm going to order an MRI of the spine, for persistent back pain with systemic symptoms. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 313.73,
      "end_seconds": 318.4,
      "duration_seconds": 4.67,
      "text": "We have a slot Monday at 10 am, if that works."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.21,
      "end_seconds": 332.93,
      "duration_seconds": 13.72,
      "text": "this is not an ordinary back strain, so I want tests today cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle come back straight away"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.64,
      "end_seconds": 336.54,
      "duration_seconds": 1.9,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.08,
      "end_seconds": 343.22,
      "duration_seconds": 5.14,
      "text": "right, that's the plan do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.85,
      "end_seconds": 348.58,
      "duration_seconds": 3.73,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}