      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.36,
      "end_seconds": 141.18,
      "duration_seconds": 1.82,
      "text": "and alcohol, how much?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.79,
      "end_seconds": 145.75,
      "duration_seconds": 2.96,
      "text": "I only drink at family occasions"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.52,
      "end_seconds": 148.8,
      "duration_seconds": 1.28,
      "text": "and your job?"
    },
