      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.8,
      "end_seconds": 153.66,
      "duration_seconds": 3.86,
      "text": "I work in accounts at a hospital"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.97,
      "end_seconds": 156.67,
      "duration_seconds": 1.7,
      "text": "who lives with you?"
    },
