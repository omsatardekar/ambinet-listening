      "role": "PATIENT",
      "start_seconds": 1.35,
      "end_seconds": 4.53,
      "duration_seconds": 3.18,
      "text": "sorry I'm a little late, doctor"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.87,
      "end_seconds": 10.15,
      "duration_seconds": 4.28,
      "text": "yes, have a seat. Tell me what's going on"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.73,
      "end_seconds": 16.33,
      "duration_seconds": 4.6,
      "text": "I've been dealing with a whooshing noise in my ears."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.58,
      "end_seconds": 18.8,
      "duration_seconds": 1.22,
      "text": "since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.12,
      "end_seconds": 28.78,
      "duration_seconds": 8.66,
      "text": "it's been about four days now i've been reading about it online and it worried me"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.85,
      "end_seconds": 33.78,
      "duration_seconds": 3.93,
      "text": "Is it a a lot or only a little?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.14,
      "end_seconds": 38.5,
      "duration_seconds": 3.36,
      "text": "about a five out of ten"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.06,
      "end_seconds": 42.67,
      "duration_seconds": 2.61,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.35,
      "end_seconds": 47.69,
      "duration_seconds": 3.34,
      "text": "it usually comes with gaining weight"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.09,
      "end_seconds": 51.05,
      "duration_seconds": 1.96,
      "text": "any sign of stiff neck?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.24,
      "end_seconds": 54.78,
      "duration_seconds": 2.54,
      "text": "No, none, no stiff neck."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.72,
      "end_seconds": 59.98,
      "duration_seconds": 3.26,
      "text": "And what about fever, head injury or weakness?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.74,
      "end_seconds": 65.05,
      "duration_seconds": 4.31,
      "text": "I haven't had fever, head injury or weakness, no"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.07,
      "end_seconds": 69.18,
      "duration_seconds": 2.11,
      "text": "your breathing any trouble there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.25,
      "end_seconds": 74.04,
      "duration_seconds": 2.79,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.14,
      "end_seconds": 84.54,
      "duration_seconds": 2.4,
      "text": "do you take any regular medication?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.18,
      "end_seconds": 88.51,
      "duration_seconds": 2.33,
      "text": "No nothing at the moment."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.06,
      "end_seconds": 104.13,
      "duration_seconds": 4.07,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.34,
      "end_seconds": 106.8,
      "duration_seconds": 1.46,
      "text": "not really, no"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.79,
      "end_seconds": 112.07,
      "duration_seconds": 4.28,
      "text": "Any allergies to tablets food or anything in the environment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.65,
      "end_seconds": 114.44,
      "duration_seconds": 1.79,
      "text": "no allergies at all"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.48,
      "end_seconds": 133.42,
      "duration_seconds": 1.94,
      "text": "Alright, do you smoke?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.93,
      "end_seconds": 138.81,
      "duration_seconds": 3.88,
      "text": "I quit smoking around ten years ago."
    },
