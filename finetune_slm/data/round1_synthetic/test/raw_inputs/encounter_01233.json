{
  "schema_version": "1.0",
  "encounter_id": "01233",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.89,
      "end_seconds": 4.12,
      "duration_seconds": 3.23,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.57,
      "end_seconds": 9.91,
      "duration_seconds": 4.34,
      "text": "yes come in and sit down what brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 10.79,
      "end_seconds": 15.09,
      "duration_seconds": 4.3,
      "text": "doctor, I'm just here to help with the details"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.99,
      "end_seconds": 20.84,
      "duration_seconds": 3.85,
      "text": "that's fine, sit down we'll go through it together"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 22.09,
      "end_seconds": 30.11,
      "duration_seconds": 8.02,
      "text": "It's scaly red plaques on my elbows, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.51,
      "end_seconds": 34.02,
      "duration_seconds": 2.51,
      "text": "okay, when did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.37,
      "end_seconds": 38.67,
      "duration_seconds": 3.3,
      "text": "about three days, give or take"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 40.03,
      "end_seconds": 44.08,
      "duration_seconds": 4.05,
      "text": "I think it's been nearer five days actually."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.96,
      "end_seconds": 50.59,
      "duration_seconds": 4.63,
      "text": "Okay, so roughly three to five days. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.82,
      "end_seconds": 54.13,
      "duration_seconds": 2.31,
      "text": "yes, somewhere around that"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.94,
      "end_seconds": 58.3,
      "duration_seconds": 2.36,
      "text": "Have you noticed any triggers?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.2,
      "end_seconds": 70.68,
      "duration_seconds": 11.48,
      "text": "it's worse with stress i've had pitted nails too, for three weeks oh, and itching that's been about the same, about four days"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.63,
      "end_seconds": 81.85,
      "duration_seconds": 10.22,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.45,
      "end_seconds": 92.17,
      "duration_seconds": 5.72,
      "text": "Pretty mild if I'm being honest. It happens on and off."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.63,
      "end_seconds": 97.57,
      "duration_seconds": 3.94,
      "text": "and what about fever, pus or joint pain?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.89,
      "end_seconds": 102.92,
      "duration_seconds": 4.03,
      "text": "No, no fever, pus or joint pain."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.86,
      "end_seconds": 108.1,
      "duration_seconds": 3.24,
      "text": "has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.82,
      "end_seconds": 111.73,
      "duration_seconds": 1.91,
      "text": "no, that's been fine"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.78,
      "end_seconds": 114.29,
      "duration_seconds": 1.51,
      "text": "neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.06,
      "end_seconds": 121.3,
      "duration_seconds": 2.24,
      "text": "no, that's all normal"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.07,
      "end_seconds": 139.65,
      "duration_seconds": 2.58,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.27,
      "end_seconds": 144.72,
      "duration_seconds": 3.45,
      "text": "I do a yoga class on Thursdays"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.52,
      "end_seconds": 148.42,
      "duration_seconds": 1.9,
      "text": "how are your meals?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.23,
      "end_seconds": 154.21,
      "duration_seconds": 3.98,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.1,
      "end_seconds": 158.95,
      "duration_seconds": 2.85,
      "text": "what line of work are you in?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.68,
      "end_seconds": 165.49,
      "duration_seconds": 4.81,
      "text": "I'm a bus driver, so I sit for long hours"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.16,
      "end_seconds": 182.37,
      "duration_seconds": 7.21,
      "text": "What do you take on a normal day? Just so I get the the full picture."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 183.34,
      "end_seconds": 192.62,
      "duration_seconds": 9.28,
      "text": "he takes hydrocortisone cream, when needed for the eczema he takes rosuvastatin, 10 milligrams, at night for my cholesterol"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.38,
      "end_seconds": 206.37,
      "duration_seconds": 3.99,
      "text": "let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.99,
      "end_seconds": 208.89,
      "duration_seconds": 1.9,
      "text": "no allergies at all"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.87,
      "end_seconds": 213.11,
      "duration_seconds": 3.24,
      "text": "any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.18,
      "end_seconds": 221.55,
      "duration_seconds": 7.37,
      "text": "I've got eczema i'm hoping you can tell me something definite yes high cholesterol"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.63,
      "end_seconds": 230.0,
      "duration_seconds": 7.37,
      "text": "Alright high cholesterol that matches what I have here. What about your parents brothers or sisters any conditions?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.59,
      "end_seconds": 233.94,
      "duration_seconds": 3.35,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.01,
      "end_seconds": 239.13,
      "duration_seconds": 3.12,
      "text": "I'll just record a a few vital signs."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.88,
      "end_seconds": 248.61,
      "duration_seconds": 2.73,
      "text": "that's it just a little longer.."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.4,
      "end_seconds": 277.82,
      "duration_seconds": 9.42,
      "text": "Okay: pressure 116 over 75, SpO2 99 percent on room air, pulse is 70 beats a minute, temperature 36.8."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.72,
      "end_seconds": 284.59,
      "duration_seconds": 1.87,
      "text": "Is that that okay?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.5,
      "end_seconds": 289.77,
      "duration_seconds": 3.27,
      "text": "don't worry, we'll discuss it in a second"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.49,
      "end_seconds": 296.46,
      "duration_seconds": 3.97,
      "text": "Let me look at the area I'll be gentle."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.8,
      "end_seconds": 299.15,
      "duration_seconds": 1.35,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.88,
      "end_seconds": 320.18,
      "duration_seconds": 6.3,
      "text": "there are well-defined silvery plaques on both elbows and a few pits in the nails"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.34,
      "end_seconds": 335.16,
      "duration_seconds": 12.82,
      "text": "Please sit back down. Taking everything into account this looks most like plaque psoriasis. There's nothing new for me to start or arrange today. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.22,
      "end_seconds": 339.44,
      "duration_seconds": 2.22,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.15,
      "end_seconds": 344.61,
      "duration_seconds": 1.46,
      "text": "look after yourself"
    }
  ]
}