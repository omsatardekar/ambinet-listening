{
  "schema_version": "1.0",
  "encounter_id": "02790",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.99,
      "end_seconds": 4.66,
      "duration_seconds": 3.67,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.93,
      "end_seconds": 12.59,
      "duration_seconds": 4.66,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.66,
      "end_seconds": 26.56,
      "duration_seconds": 11.9,
      "text": "Yeah, it's severe tummy pain out of proportion to the examination. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.09,
      "end_seconds": 30.31,
      "duration_seconds": 3.22,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.92,
      "end_seconds": 38.35,
      "duration_seconds": 6.43,
      "text": "Around six months... no wait, it's more like about three months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.8,
      "end_seconds": 44.55,
      "duration_seconds": 2.75,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.55,
      "end_seconds": 48.34,
      "duration_seconds": 2.79,
      "text": "I'd say all the time."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.87,
      "end_seconds": 52.67,
      "duration_seconds": 2.8,
      "text": "Have you been feeling very unwell?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.47,
      "end_seconds": 71.82,
      "duration_seconds": 17.35,
      "text": "So, yeah. Two weeks, I'd say. Sorry, what was I saying, about feeling very unwell, pretty moderate, if I'm being honest. There was bloody diarrhoea, yes, but that went away."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.23,
      "end_seconds": 84.16,
      "duration_seconds": 2.93,
      "text": "Right, has there been any hernia?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.84,
      "end_seconds": 89.49,
      "duration_seconds": 3.65,
      "text": "I mean, no, none, no hernia."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.04,
      "end_seconds": 93.29,
      "duration_seconds": 3.25,
      "text": "Did you get chest pain or fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.8,
      "end_seconds": 97.96,
      "duration_seconds": 4.16,
      "text": "I haven't had chest pain or fever, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.94,
      "end_seconds": 101.94,
      "duration_seconds": 3.0,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.86,
      "end_seconds": 105.45,
      "duration_seconds": 2.59,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.0,
      "end_seconds": 110.51,
      "duration_seconds": 3.51,
      "text": "Right, did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.41,
      "end_seconds": 115.51,
      "duration_seconds": 4.1,
      "text": "Just my womb taken out, fifteen years ago."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.53,
      "end_seconds": 121.91,
      "duration_seconds": 5.38,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.64,
      "end_seconds": 125.08,
      "duration_seconds": 2.44,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.85,
      "end_seconds": 133.89,
      "duration_seconds": 4.04,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.97,
      "end_seconds": 138.15,
      "duration_seconds": 2.18,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.94,
      "end_seconds": 150.3,
      "duration_seconds": 2.36,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.23,
      "end_seconds": 163.07,
      "duration_seconds": 11.84,
      "text": "My partner and our baby. Not much, I mostly stay in these days. Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.71,
      "end_seconds": 180.04,
      "duration_seconds": 3.33,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.66,
      "end_seconds": 196.36,
      "duration_seconds": 10.7,
      "text": "Uh, I have an irregular heartbeat, for five years. I've had heart failure for about ten years now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.26,
      "end_seconds": 201.55,
      "duration_seconds": 4.29,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.66,
      "end_seconds": 212.37,
      "duration_seconds": 9.71,
      "text": "I'm on warfarin, 3 milligrams, in the evening. I'm on carvedilol, twice a day for my heart."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.24,
      "end_seconds": 215.27,
      "duration_seconds": 2.03,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.19,
      "end_seconds": 234.82,
      "duration_seconds": 16.63,
      "text": "6.25 milligrams, I think that's what's on the box. A blood thinner, 5 milligrams, stopped last month. Yeah, uh, I had bisoprolol at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.41,
      "end_seconds": 241.64,
      "duration_seconds": 4.23,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.56,
      "end_seconds": 244.13,
      "duration_seconds": 1.57,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.1,
      "end_seconds": 248.75,
      "duration_seconds": 2.65,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.08,
      "end_seconds": 270.01,
      "duration_seconds": 8.93,
      "text": "Your pulse is irregular, the tummy is soft but terribly painful, and the pain is out of proportion to what I find."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.17,
      "end_seconds": 272.95,
      "duration_seconds": 1.78,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.21,
      "end_seconds": 290.02,
      "duration_seconds": 11.81,
      "text": "That's the examination finished. From what you've told me and what I found, it fits best with possible bowel ischaemia. A bowel obstruction is still possible."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.39,
      "end_seconds": 293.08,
      "duration_seconds": 1.69,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.61,
      "end_seconds": 304.74,
      "duration_seconds": 11.13,
      "text": "I can't promise yet, but most people with possible bowel ischaemia do well once it's treated properly. Let's book urgent blood tests to look into severe abdominal pain."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.61,
      "end_seconds": 309.44,
      "duration_seconds": 1.83,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.16,
      "end_seconds": 315.94,
      "duration_seconds": 4.78,
      "text": "I'll request an urgent CT angiogram, it'll help with possible bowel ischaemia."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.84,
      "end_seconds": 320.11,
      "duration_seconds": 3.27,
      "text": "So, when would that take place?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.63,
      "end_seconds": 331.02,
      "duration_seconds": 10.39,
      "text": "This is an emergency, you are going to hospital now. Please don't wait if the symptoms get worse. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.31,
      "end_seconds": 334.01,
      "duration_seconds": 1.7,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.91,
      "end_seconds": 342.49,
      "duration_seconds": 6.58,
      "text": "Let's review you straight away. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.12,
      "end_seconds": 348.94,
      "duration_seconds": 4.82,
      "text": "Good, uh, thanks, I'll see you then."
    }
  ]
}