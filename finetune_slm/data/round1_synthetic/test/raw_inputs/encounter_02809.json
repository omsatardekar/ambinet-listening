{
  "schema_version": "1.0",
  "encounter_id": "02809",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.13,
      "end_seconds": 3.76,
      "duration_seconds": 2.63,
      "text": "Good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 5.56,
      "end_seconds": 11.06,
      "duration_seconds": 5.5,
      "text": "Hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.9,
      "end_seconds": 15.96,
      "duration_seconds": 4.06,
      "text": "Sorry about the wait, we're running a bit behind."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 17.49,
      "end_seconds": 22.97,
      "duration_seconds": 5.48,
      "text": "Oh, that's fine. I was just reading something on my phone."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.71,
      "end_seconds": 27.98,
      "duration_seconds": 4.27,
      "text": "Alright, what would you like to start with today?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 29.65,
      "end_seconds": 33.32,
      "duration_seconds": 3.67,
      "text": "I'm here because of a severe headache."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.81,
      "end_seconds": 36.26,
      "duration_seconds": 1.45,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 37.99,
      "end_seconds": 41.75,
      "duration_seconds": 3.76,
      "text": "Around a week, um, I think."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 42.57,
      "end_seconds": 46.43,
      "duration_seconds": 3.86,
      "text": "I think it's been nearer two weeks, actually."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.0,
      "end_seconds": 51.67,
      "duration_seconds": 4.67,
      "text": "Okay, so roughly one to two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 56.12,
      "end_seconds": 58.94,
      "duration_seconds": 2.82,
      "text": "Well, yes, somewhere around that."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.24,
      "end_seconds": 62.66,
      "duration_seconds": 2.42,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 63.62,
      "end_seconds": 66.6,
      "duration_seconds": 2.98,
      "text": "Honestly, once or twice a day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.57,
      "end_seconds": 71.84,
      "duration_seconds": 3.27,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 72.56,
      "end_seconds": 73.56,
      "duration_seconds": 1.0,
      "text": "Mostly mild."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 74.0,
      "end_seconds": 81.34,
      "duration_seconds": 7.34,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 81.44,
      "end_seconds": 86.32,
      "duration_seconds": 4.88,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 89.65,
      "end_seconds": 98.59,
      "duration_seconds": 8.94,
      "text": "I was getting to that! I've also had swollen face and hands, for about a week."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.69,
      "end_seconds": 106.14,
      "duration_seconds": 5.45,
      "text": "Have you had a severe headache before, or is this the first time?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 107.88,
      "end_seconds": 114.43,
      "duration_seconds": 6.55,
      "text": "I had a similar thing about six months ago. It went away."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.68,
      "end_seconds": 117.86,
      "duration_seconds": 2.18,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 118.8,
      "end_seconds": 124.6,
      "duration_seconds": 5.8,
      "text": "Uh, yes, I had my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.3,
      "end_seconds": 128.7,
      "duration_seconds": 3.4,
      "text": "Right, what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 130.06,
      "end_seconds": 140.85,
      "duration_seconds": 10.79,
      "text": "She is on lamotrigine, 100 milligrams, twice a day, I give it to her. It's alendronate, once a week for my bones, doctor."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.48,
      "end_seconds": 143.73,
      "duration_seconds": 2.25,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 144.3,
      "end_seconds": 152.76,
      "duration_seconds": 8.46,
      "text": "70 milligrams, I think that's what's on the box. Um, she takes Eltroxin, 100 micrograms, every morning."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 153.72,
      "end_seconds": 158.63,
      "duration_seconds": 4.91,
      "text": "I'd been on carbamazepine, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.25,
      "end_seconds": 163.65,
      "duration_seconds": 3.4,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 164.96,
      "end_seconds": 178.02,
      "duration_seconds": 13.06,
      "text": "I've got epilepsy. I've had thin bones for two years now. I kept putting it off, which I know isn't sensible. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.6,
      "end_seconds": 180.94,
      "duration_seconds": 1.34,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 181.78,
      "end_seconds": 184.35,
      "duration_seconds": 2.57,
      "text": "I've got an underactive thyroid."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.36,
      "end_seconds": 194.89,
      "duration_seconds": 8.53,
      "text": "Right, so an underactive thyroid is already on your record. We'll keep that in mind today. Any smoking?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 196.64,
      "end_seconds": 199.35,
      "duration_seconds": 2.71,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.98,
      "end_seconds": 203.14,
      "duration_seconds": 3.16,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 204.56,
      "end_seconds": 208.64,
      "duration_seconds": 4.08,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.5,
      "end_seconds": 211.5,
      "duration_seconds": 2.0,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 212.58,
      "end_seconds": 217.69,
      "duration_seconds": 5.11,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.17,
      "end_seconds": 240.15,
      "duration_seconds": 4.98,
      "text": "Right, do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 240.72,
      "end_seconds": 247.35,
      "duration_seconds": 6.63,
      "text": "Yes, tramadol, it gives me vomiting. Walnuts. I come out in... well, hives."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.76,
      "end_seconds": 253.55,
      "duration_seconds": 4.79,
      "text": "Any vaginal bleeding, leaking fluid or reduced baby movements at all?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 255.29,
      "end_seconds": 270.84,
      "duration_seconds": 15.55,
      "text": "No, no vaginal bleeding, no leaking fluid, no reduced baby movements. I did have pain under the right ribs at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.96,
      "end_seconds": 274.56,
      "duration_seconds": 2.6,
      "text": "Alright, has your skin been okay?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 275.8,
      "end_seconds": 276.76,
      "duration_seconds": 0.96,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 285.91,
      "end_seconds": 293.61,
      "duration_seconds": 7.7,
      "text": "Doctor, I've got the readings for you. Blood pressure 163 over 95, respiratory rate 16, saturation 96 percent. Pulse 79."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.6,
      "end_seconds": 305.27,
      "duration_seconds": 10.67,
      "text": "Thanks. So, based on your history, it's hard to say. Severe pre-eclampsia is one possibility and a migraine another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 306.29,
      "end_seconds": 309.32,
      "duration_seconds": 3.03,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.84,
      "end_seconds": 326.91,
      "duration_seconds": 16.07,
      "text": "Nothing I've seen today points to an emergency. It looks like severe pre-eclampsia, but I'd like to confirm. So, to recap quickly. You've had a severe headache, mild, and no reduced baby movements or vaginal bleeding."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 327.42,
      "end_seconds": 331.2,
      "duration_seconds": 3.78,
      "text": "Hmm, um, that's what happened, yes."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 332.24,
      "end_seconds": 336.39,
      "duration_seconds": 4.15,
      "text": "I'm going to order a urine protein test, for pre-eclampsia."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 338.31,
      "end_seconds": 340.97,
      "duration_seconds": 2.66,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 341.62,
      "end_seconds": 375.27,
      "duration_seconds": 33.65,
      "text": "I'll request urgent blood tests, it'll help with pre-eclampsia. I'll start you on labetalol, 200 milligrams, once now, single dose. You take it by mouth. That should help with severe hypertension. You need to go to the maternity unit straight away. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. One warning sign to remember: the symptoms get worse. In that case don't wait."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 375.87,
      "end_seconds": 378.29,
      "duration_seconds": 2.42,
      "text": "Book a review straight away."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 378.95,
      "end_seconds": 381.93,
      "duration_seconds": 2.98,
      "text": "Right, good, I'll return then."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 383.24,
      "end_seconds": 386.99,
      "duration_seconds": 3.75,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 387.88,
      "end_seconds": 389.69,
      "duration_seconds": 1.81,
      "text": "That's clear, thanks."
    }
  ]
}