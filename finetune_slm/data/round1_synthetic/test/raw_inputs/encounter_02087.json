{
  "schema_version": "1.0",
  "encounter_id": "02087",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.37,
      "end_seconds": 5.04,
      "duration_seconds": 3.67,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.61,
      "end_seconds": 10.05,
      "duration_seconds": 4.44,
      "text": "Right, that's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.78,
      "end_seconds": 31.37,
      "duration_seconds": 19.59,
      "text": "Um, honestly, it's a hot red swollen big toe, and my family pushed me to come. Work has been very busy so I kept ignoring it. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.0,
      "end_seconds": 36.24,
      "duration_seconds": 4.24,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.22,
      "end_seconds": 46.72,
      "duration_seconds": 2.5,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.0,
      "end_seconds": 75.96,
      "duration_seconds": 7.96,
      "text": "Okay: heart rate 70, blood pressure 123 over 78, SpO2 97 percent on room air, temperature 36.9."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.63,
      "end_seconds": 77.97,
      "duration_seconds": 1.34,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.4,
      "end_seconds": 81.9,
      "duration_seconds": 2.5,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.65,
      "end_seconds": 100.14,
      "duration_seconds": 3.49,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.22,
      "end_seconds": 110.13,
      "duration_seconds": 7.91,
      "text": "It's been about two weeks now. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.6,
      "end_seconds": 120.92,
      "duration_seconds": 9.32,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.23,
      "end_seconds": 127.06,
      "duration_seconds": 4.83,
      "text": "Uh, yes, touch. That makes it worse. Mostly severe."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.26,
      "end_seconds": 133.65,
      "duration_seconds": 5.39,
      "text": "Let me check a few things. Any injury, rash or fever?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.18,
      "end_seconds": 139.18,
      "duration_seconds": 4.0,
      "text": "No injury, rash or fever, none of it."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.88,
      "end_seconds": 145.39,
      "duration_seconds": 4.51,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.06,
      "end_seconds": 153.04,
      "duration_seconds": 1.98,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.31,
      "end_seconds": 155.93,
      "duration_seconds": 1.62,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.83,
      "end_seconds": 159.19,
      "duration_seconds": 2.36,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.4,
      "end_seconds": 163.96,
      "duration_seconds": 3.56,
      "text": "So, what do you do during the day?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.79,
      "end_seconds": 169.25,
      "duration_seconds": 3.46,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.15,
      "end_seconds": 173.85,
      "duration_seconds": 3.7,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.86,
      "end_seconds": 179.12,
      "duration_seconds": 3.26,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.25,
      "end_seconds": 182.3,
      "duration_seconds": 2.05,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.03,
      "end_seconds": 191.13,
      "duration_seconds": 8.1,
      "text": "Yes, high blood pressure. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.05,
      "end_seconds": 197.73,
      "duration_seconds": 5.68,
      "text": "Okay, I can see high blood pressure in your file as well."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.9,
      "end_seconds": 210.0,
      "duration_seconds": 2.1,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.52,
      "end_seconds": 232.6,
      "duration_seconds": 22.08,
      "text": "It's ramipril, 5 milligrams, every morning for my blood pressure. Ibuprofen. I take it 400 milligrams, three times a day. I looked a few things up online, and that probably didn't help. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.61,
      "end_seconds": 251.04,
      "duration_seconds": 2.43,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.27,
      "end_seconds": 255.35,
      "duration_seconds": 3.08,
      "text": "Erm, no, not at all."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.24,
      "end_seconds": 261.04,
      "duration_seconds": 4.8,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.87,
      "end_seconds": 268.38,
      "duration_seconds": 5.51,
      "text": "I'm allergic to diclofenac, I get swelling of my lips."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.83,
      "end_seconds": 273.76,
      "duration_seconds": 2.93,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.55,
      "end_seconds": 278.39,
      "duration_seconds": 2.84,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.68,
      "end_seconds": 300.11,
      "duration_seconds": 5.43,
      "text": "The big toe joint is red, hot, swollen and exquisitely tender."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.55,
      "end_seconds": 320.42,
      "duration_seconds": 14.87,
      "text": "Okay, that's enough for me. Okay, thinking it through, I'd lean towards an acute gout attack. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.07,
      "end_seconds": 324.3,
      "duration_seconds": 3.23,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.64,
      "end_seconds": 344.65,
      "duration_seconds": 19.01,
      "text": "I can't promise yet, but most people with an acute gout attack do well once it's treated properly. Stop me if I've got anything wrong. You've had a hot red swollen big toe for about two weeks, severe, and no rash or injury."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.97,
      "end_seconds": 347.63,
      "duration_seconds": 1.66,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.0,
      "end_seconds": 388.15,
      "duration_seconds": 22.15,
      "text": "I'm sending you for a uric acid blood test because of gout. Rest the foot, ice it, and drink plenty of water; limit beer and red meat. A short walk every day, even twenty minutes, will help more than you'd think. We'll catch up in two weeks. Okay, does all of that make sense?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 389.49,
      "end_seconds": 393.24,
      "duration_seconds": 3.75,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 394.03,
      "end_seconds": 395.39,
      "duration_seconds": 1.36,
      "text": "Goodbye for now."
    }
  ]
}