{
  "schema_version": "1.0",
  "encounter_id": "01220",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.57,
      "end_seconds": 4.26,
      "duration_seconds": 3.69,
      "text": "So, hi there, the chair's free, sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.69,
      "end_seconds": 11.2,
      "duration_seconds": 5.51,
      "text": "Let me think, you know, hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.22,
      "end_seconds": 15.09,
      "duration_seconds": 1.87,
      "text": "Weather's turned, hasn't it?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 16.0,
      "end_seconds": 21.32,
      "duration_seconds": 5.32,
      "text": "It has. I got caught in the rain walking over."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.56,
      "end_seconds": 23.8,
      "duration_seconds": 1.24,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.89,
      "end_seconds": 42.42,
      "duration_seconds": 17.53,
      "text": "Mainly I've been feeling sick. That's why I came. I didn't want to bother you but it keeps coming back. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.53,
      "end_seconds": 47.2,
      "duration_seconds": 3.67,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 53.4,
      "end_seconds": 56.27,
      "duration_seconds": 2.87,
      "text": "For two months, I'd say."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 56.98,
      "end_seconds": 64.62,
      "duration_seconds": 7.64,
      "text": "Okay, give me more detail on it, whatever comes to mind. Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.98,
      "end_seconds": 69.26,
      "duration_seconds": 3.28,
      "text": "Severe, really. It's on and off."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.25,
      "end_seconds": 82.34,
      "duration_seconds": 5.09,
      "text": "Let me check a few things. Any drowsiness or chest pain?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.02,
      "end_seconds": 87.56,
      "duration_seconds": 4.54,
      "text": "Mm, I haven't had drowsiness or chest pain, no."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.27,
      "end_seconds": 90.58,
      "duration_seconds": 2.31,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.3,
      "end_seconds": 95.93,
      "duration_seconds": 3.63,
      "text": "No, you know, joints are fine."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.7,
      "end_seconds": 99.05,
      "duration_seconds": 2.35,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.08,
      "end_seconds": 102.24,
      "duration_seconds": 1.16,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.04,
      "end_seconds": 119.9,
      "duration_seconds": 2.86,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.45,
      "end_seconds": 124.64,
      "duration_seconds": 3.19,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.27,
      "end_seconds": 127.27,
      "duration_seconds": 2.0,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 127.89,
      "end_seconds": 131.75,
      "duration_seconds": 3.86,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.57,
      "end_seconds": 149.21,
      "duration_seconds": 4.64,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.33,
      "end_seconds": 153.36,
      "duration_seconds": 3.03,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.7,
      "end_seconds": 174.64,
      "duration_seconds": 2.94,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.62,
      "end_seconds": 179.47,
      "duration_seconds": 2.85,
      "text": "Yes, cat fur. I get wheezing."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.54,
      "end_seconds": 184.08,
      "duration_seconds": 2.54,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.63,
      "end_seconds": 195.13,
      "duration_seconds": 2.5,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.26,
      "end_seconds": 215.09,
      "duration_seconds": 5.83,
      "text": "Okay: BP is 110 over 71, heart rate 83, temperature is 36.5 degrees."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.17,
      "end_seconds": 220.0,
      "duration_seconds": 3.83,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 225.38,
      "end_seconds": 226.6,
      "duration_seconds": 1.22,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.15,
      "end_seconds": 230.51,
      "duration_seconds": 2.36,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.65,
      "end_seconds": 251.13,
      "duration_seconds": 5.48,
      "text": "You are awake and alert, with some tenderness under the right ribs."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 252.8,
      "end_seconds": 254.02,
      "duration_seconds": 1.22,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.12,
      "end_seconds": 267.59,
      "duration_seconds": 11.47,
      "text": "All finished, thank you. From what you've told me and what I found, I think we're dealing with a significant paracetamol overdose needing urgent treatment at this stage."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 269.36,
      "end_seconds": 273.4,
      "duration_seconds": 4.04,
      "text": "Well, what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.91,
      "end_seconds": 303.59,
      "duration_seconds": 28.68,
      "text": "It's reasonable to be concerned, but right now a significant paracetamol overdose needing urgent treatment is my leading thought, not anything worse. Let's get a paracetamol level, for overdose. That will help us see what's going on underneath and decide the next step. I'd like you to take acetylcysteine, per protocol, over 21 hours, per protocol. That's for paracetamol overdose."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.52,
      "end_seconds": 324.48,
      "duration_seconds": 14.96,
      "text": "You need to stay in hospital for treatment, and someone will speak to you about how you are feeling. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 326.05,
      "end_seconds": 329.69,
      "duration_seconds": 3.64,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 331.67,
      "end_seconds": 333.38,
      "duration_seconds": 1.71,
      "text": "Have a good day."
    }
  ]
}