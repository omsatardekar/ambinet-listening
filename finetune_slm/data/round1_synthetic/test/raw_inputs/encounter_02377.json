{
  "schema_version": "1.0",
  "encounter_id": "02377",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.6,
      "end_seconds": 4.35,
      "duration_seconds": 3.75,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.3,
      "end_seconds": 10.36,
      "duration_seconds": 4.06,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.05,
      "end_seconds": 20.07,
      "duration_seconds": 6.02,
      "text": "Hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.94,
      "end_seconds": 36.6,
      "duration_seconds": 14.66,
      "text": "Honestly, it's spots on my forehead and chin, and my family pushed me to come. It's the not knowing that gets to me. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.25,
      "end_seconds": 41.05,
      "duration_seconds": 2.8,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.81,
      "end_seconds": 45.38,
      "duration_seconds": 2.57,
      "text": "It's been one week now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.59,
      "end_seconds": 55.67,
      "duration_seconds": 9.08,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.59,
      "end_seconds": 67.48,
      "duration_seconds": 10.89,
      "text": "I'd say severe. It's worse with before periods. Oh, and oily skin. I've also had a few blackheads, for about a month."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.46,
      "end_seconds": 74.98,
      "duration_seconds": 6.52,
      "text": "Have you had spots on your forehead and chin before, or is this the first time?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.8,
      "end_seconds": 84.22,
      "duration_seconds": 7.42,
      "text": "Yeah, I had a similar thing a couple of years ago. It went away."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.06,
      "end_seconds": 88.01,
      "duration_seconds": 2.95,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.09,
      "end_seconds": 103.63,
      "duration_seconds": 2.54,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.98,
      "end_seconds": 130.75,
      "duration_seconds": 12.77,
      "text": "Okay: temp 36.6 degrees, height 171 centimetres. And weight 94 kilos, pressure 120 over 75, heart rate 64, oxygen saturation is 98 percent, BMI works out to 32.1."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.56,
      "end_seconds": 134.02,
      "duration_seconds": 1.46,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.37,
      "end_seconds": 139.09,
      "duration_seconds": 3.72,
      "text": "Okay, I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.59,
      "end_seconds": 142.6,
      "duration_seconds": 2.01,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.02,
      "end_seconds": 145.68,
      "duration_seconds": 1.66,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.64,
      "end_seconds": 149.68,
      "duration_seconds": 3.04,
      "text": "Right, raise your arm for me."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.23,
      "end_seconds": 172.26,
      "duration_seconds": 6.03,
      "text": "There are small blackheads and a few red spots with no deep cysts."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.22,
      "end_seconds": 183.31,
      "duration_seconds": 6.09,
      "text": "Okay, that's enough for me. Have you had irregular periods, by any chance?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.01,
      "end_seconds": 186.02,
      "duration_seconds": 2.01,
      "text": "No, no irregular periods."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.86,
      "end_seconds": 191.88,
      "duration_seconds": 4.02,
      "text": "Did you get low mood, painful cysts or scarring?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.49,
      "end_seconds": 199.9,
      "duration_seconds": 2.41,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.94,
      "end_seconds": 203.97,
      "duration_seconds": 3.03,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.08,
      "end_seconds": 206.84,
      "duration_seconds": 1.76,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.53,
      "end_seconds": 211.43,
      "duration_seconds": 3.9,
      "text": "Right, on the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.43,
      "end_seconds": 216.25,
      "duration_seconds": 3.82,
      "text": "No, uh, nothing with my heart."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.29,
      "end_seconds": 236.88,
      "duration_seconds": 2.59,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.35,
      "end_seconds": 244.12,
      "duration_seconds": 5.77,
      "text": "Yes, I had a caesarean for my second baby, nine years ago."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.76,
      "end_seconds": 246.93,
      "duration_seconds": 2.17,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.55,
      "end_seconds": 251.62,
      "duration_seconds": 4.07,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.72,
      "end_seconds": 254.74,
      "duration_seconds": 2.02,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.63,
      "end_seconds": 260.27,
      "duration_seconds": 3.64,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.67,
      "end_seconds": 276.64,
      "duration_seconds": 2.97,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.55,
      "end_seconds": 281.61,
      "duration_seconds": 4.06,
      "text": "Yes, naproxen, it gives me stomach pain."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.14,
      "end_seconds": 287.68,
      "duration_seconds": 4.54,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.94,
      "end_seconds": 305.68,
      "duration_seconds": 16.74,
      "text": "I've got high blood pressure. I have COPD, for nearly five years. I told myself I'd wait and see, and here I am. I've had eczema for about a year now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.49,
      "end_seconds": 315.92,
      "duration_seconds": 9.43,
      "text": "Mm-hmm. Yes, COPD is known to us, good to have that clear. Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.15,
      "end_seconds": 322.98,
      "duration_seconds": 5.83,
      "text": "I take ramipril, 5 milligrams, every morning for my blood pressure."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.24,
      "end_seconds": 324.59,
      "duration_seconds": 1.35,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.65,
      "end_seconds": 329.95,
      "duration_seconds": 4.3,
      "text": "Tiotropium inhaler. I take it once a day."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 335.04,
      "end_seconds": 341.58,
      "duration_seconds": 6.54,
      "text": "That's what's prescribed, but I'm not sure she takes it every day."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.0,
      "end_seconds": 352.2,
      "duration_seconds": 8.2,
      "text": "I'm on hydrocortisone cream, when needed for the eczema. I'm on a face wash, twice a day."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.08,
      "end_seconds": 354.28,
      "duration_seconds": 1.2,
      "text": "Is that long-standing?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 355.27,
      "end_seconds": 356.64,
      "duration_seconds": 1.37,
      "text": "Two years now."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.94,
      "end_seconds": 371.62,
      "duration_seconds": 11.68,
      "text": "Having listened and examined, it fits best with mild acne. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 372.99,
      "end_seconds": 375.23,
      "duration_seconds": 2.24,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 376.46,
      "end_seconds": 381.83,
      "duration_seconds": 5.37,
      "text": "Nothing I've seen today points to an emergency. It looks like mild acne."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 395.76,
      "end_seconds": 414.04,
      "duration_seconds": 18.28,
      "text": "I'd like you to take benzoyl peroxide gel, 5%, once a day, eight weeks. That should help with acne. Wash gently twice a day and don't squeeze the spots. Come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 415.66,
      "end_seconds": 417.21,
      "duration_seconds": 1.55,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 420.5,
      "end_seconds": 426.17,
      "duration_seconds": 5.67,
      "text": "We'll catch up in eight weeks. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 427.68,
      "end_seconds": 430.61,
      "duration_seconds": 2.93,
      "text": "Great, thank you for your help."
    }
  ]
}