{
  "schema_version": "1.0",
  "encounter_id": "01193",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.54,
      "end_seconds": 6.65,
      "duration_seconds": 6.11,
      "text": "Doctor, if you're free, we can start. I've got the numbers noted down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.87,
      "end_seconds": 12.19,
      "duration_seconds": 4.32,
      "text": "Thank you. Good morning, tell me what's been going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 14.26,
      "end_seconds": 26.67,
      "duration_seconds": 12.41,
      "text": "Honestly, uh, it's being thirsty, and my family pushed me to come. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.29,
      "end_seconds": 31.62,
      "duration_seconds": 3.33,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 33.23,
      "end_seconds": 36.32,
      "duration_seconds": 3.09,
      "text": "Since Monday, that's when it began."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.87,
      "end_seconds": 41.68,
      "duration_seconds": 4.81,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 45.7,
      "end_seconds": 53.61,
      "duration_seconds": 7.91,
      "text": "I get some relief from water. Maybe a seven out of ten on a bad day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.66,
      "end_seconds": 60.75,
      "duration_seconds": 3.09,
      "text": "Right, does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 62.33,
      "end_seconds": 71.55,
      "duration_seconds": 9.22,
      "text": "Recurrent thrush goes along with it, most of the time. The recurrent thrush? That's been for about a week."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.75,
      "end_seconds": 79.95,
      "duration_seconds": 3.2,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 81.59,
      "end_seconds": 84.39,
      "duration_seconds": 2.8,
      "text": "About a five out of ten."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 100.28,
      "end_seconds": 113.27,
      "duration_seconds": 12.99,
      "text": "Okay, so the vitals from earlier. Height 153 centimetres, pulse 88. Pressure 167 over 90, SpO2 97 percent on room air, temp 36.9 degrees, weight 79 kilos."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.41,
      "end_seconds": 115.31,
      "duration_seconds": 0.9,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.47,
      "end_seconds": 118.73,
      "duration_seconds": 2.26,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.85,
      "end_seconds": 121.93,
      "duration_seconds": 2.08,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.54,
      "end_seconds": 143.02,
      "duration_seconds": 6.48,
      "text": "The feeling at the tips of your toes is reduced and the foot pulses are present."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.35,
      "end_seconds": 148.86,
      "duration_seconds": 2.51,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.08,
      "end_seconds": 164.2,
      "duration_seconds": 4.12,
      "text": "Have you had any chest pain, vomiting or foot ulcers?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 165.95,
      "end_seconds": 171.08,
      "duration_seconds": 5.13,
      "text": "No chest pain, vomiting or foot ulcers, none of it."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.11,
      "end_seconds": 174.82,
      "duration_seconds": 2.71,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 175.9,
      "end_seconds": 176.86,
      "duration_seconds": 0.96,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.46,
      "end_seconds": 190.5,
      "duration_seconds": 5.04,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 191.21,
      "end_seconds": 193.62,
      "duration_seconds": 2.41,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.7,
      "end_seconds": 213.09,
      "duration_seconds": 2.39,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 214.22,
      "end_seconds": 218.21,
      "duration_seconds": 3.99,
      "text": "Well, no, I don't take any tablets."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.12,
      "end_seconds": 223.87,
      "duration_seconds": 3.75,
      "text": "Right, any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 225.73,
      "end_seconds": 228.76,
      "duration_seconds": 3.03,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.55,
      "end_seconds": 231.49,
      "duration_seconds": 1.94,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 232.43,
      "end_seconds": 238.09,
      "duration_seconds": 5.66,
      "text": "Well, I had part of my thyroid removed years back."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.93,
      "end_seconds": 242.34,
      "duration_seconds": 2.41,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 245.8,
      "end_seconds": 249.89,
      "duration_seconds": 4.09,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.19,
      "end_seconds": 257.85,
      "duration_seconds": 3.66,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 259.55,
      "end_seconds": 262.83,
      "duration_seconds": 3.28,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.71,
      "end_seconds": 300.72,
      "duration_seconds": 36.01,
      "text": "Let's book kidney function tests to look into diabetes review. We'll begin with gliclazide, 40 milligrams, once a day with breakfast, long term. That should help with diabetes. Check your feet daily and book the eye screening. If it hasn't settled in two weeks, we'd think about an HbA1c, but not now. If the symptoms get worse, or you feel really unwell, please come to the emergency department. Alright, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 301.37,
      "end_seconds": 304.75,
      "duration_seconds": 3.38,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.44,
      "end_seconds": 307.83,
      "duration_seconds": 1.39,
      "text": "Take care now."
    }
  ]
}