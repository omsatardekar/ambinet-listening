{
  "schema_version": "1.0",
  "encounter_id": "03674",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.39,
      "end_seconds": 4.43,
      "duration_seconds": 3.04,
      "text": "Right, good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.47,
      "end_seconds": 7.59,
      "duration_seconds": 1.12,
      "text": "Hello, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 9.33,
      "end_seconds": 14.98,
      "duration_seconds": 5.65,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.29,
      "end_seconds": 22.41,
      "duration_seconds": 6.12,
      "text": "Of course, please stay. It's helpful to have you here. What's been worrying you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 23.7,
      "end_seconds": 29.1,
      "duration_seconds": 5.4,
      "text": "Doctor, it's an ache in my jaw. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.27,
      "end_seconds": 34.5,
      "duration_seconds": 4.23,
      "text": "So, when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 35.61,
      "end_seconds": 39.34,
      "duration_seconds": 3.73,
      "text": "Right, I'd say about a month, maybe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 40.38,
      "end_seconds": 44.06,
      "duration_seconds": 3.68,
      "text": "Hm, I'd say more like about two months."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.54,
      "end_seconds": 50.3,
      "duration_seconds": 4.76,
      "text": "Okay, so roughly one to two months. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 52.0,
      "end_seconds": 55.35,
      "duration_seconds": 3.35,
      "text": "So, um, that sounds about right."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 56.21,
      "end_seconds": 66.54,
      "duration_seconds": 10.33,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 67.56,
      "end_seconds": 72.85,
      "duration_seconds": 5.29,
      "text": "I get some relief from rest. It comes and goes."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 73.51,
      "end_seconds": 79.5,
      "duration_seconds": 5.99,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 79.6,
      "end_seconds": 86.89,
      "duration_seconds": 7.29,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.93,
      "end_seconds": 93.67,
      "duration_seconds": 4.74,
      "text": "Later, thanks. Please go on. Have you been feeling unusually tired?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.74,
      "end_seconds": 99.15,
      "duration_seconds": 3.41,
      "text": "Yeah, I've had that since last Tuesday."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.59,
      "end_seconds": 103.32,
      "duration_seconds": 2.73,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 105.26,
      "end_seconds": 111.02,
      "duration_seconds": 5.76,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.22,
      "end_seconds": 118.14,
      "duration_seconds": 5.92,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.13,
      "end_seconds": 121.04,
      "duration_seconds": 0.91,
      "text": "Mostly moderate."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.34,
      "end_seconds": 122.3,
      "duration_seconds": 0.96,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.65,
      "end_seconds": 128.28,
      "duration_seconds": 4.63,
      "text": "Uh, I've also been sweating, for three days."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.94,
      "end_seconds": 131.37,
      "duration_seconds": 2.43,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.17,
      "end_seconds": 135.48,
      "duration_seconds": 3.31,
      "text": "I'd say once or twice a day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.52,
      "end_seconds": 140.1,
      "duration_seconds": 2.58,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.86,
      "end_seconds": 149.17,
      "duration_seconds": 4.31,
      "text": "So, I had my septum straightened in my thirties."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.91,
      "end_seconds": 154.13,
      "duration_seconds": 3.22,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.73,
      "end_seconds": 162.0,
      "duration_seconds": 6.27,
      "text": "I've got high blood pressure. Diabetes, for five years. Yes, an irregular heartbeat."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.48,
      "end_seconds": 168.91,
      "duration_seconds": 5.43,
      "text": "Yes. Okay, I can see diabetes in your file as well."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.43,
      "end_seconds": 191.7,
      "duration_seconds": 6.27,
      "text": "Let's run through your medicines. It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.96,
      "end_seconds": 200.45,
      "duration_seconds": 7.49,
      "text": "It's a... um, I can't remember what it's called. It's a little pink tablet."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.03,
      "end_seconds": 205.12,
      "duration_seconds": 3.09,
      "text": "Alright, do you remember what it's for?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 205.65,
      "end_seconds": 223.41,
      "duration_seconds": 17.76,
      "text": "For my sugar, I believe. My wife sets them out for me, I just take what I'm given. It's, It's bisoprolol, 2.5 milligrams, once a day for the heart rhythm."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 224.7,
      "end_seconds": 231.73,
      "duration_seconds": 7.03,
      "text": "It's meant to be once a day, though I don't see he take it every time."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 233.8,
      "end_seconds": 238.18,
      "duration_seconds": 4.38,
      "text": "I'm on antacid liquid, 10 ml, when needed."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.64,
      "end_seconds": 241.98,
      "duration_seconds": 2.34,
      "text": "So, how active are you?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 243.75,
      "end_seconds": 247.09,
      "duration_seconds": 3.34,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.67,
      "end_seconds": 250.03,
      "duration_seconds": 2.36,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 251.84,
      "end_seconds": 256.42,
      "duration_seconds": 4.58,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.32,
      "end_seconds": 260.95,
      "duration_seconds": 3.63,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 262.19,
      "end_seconds": 265.03,
      "duration_seconds": 2.84,
      "text": "Right, my son has asthma."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.71,
      "end_seconds": 268.11,
      "duration_seconds": 2.4,
      "text": "And fever, any of that?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 269.19,
      "end_seconds": 271.74,
      "duration_seconds": 2.55,
      "text": "I haven't noticed any fever."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 272.35,
      "end_seconds": 277.48,
      "duration_seconds": 5.13,
      "text": "Actually, doctor, I did notice fever. He doesn't always say."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 278.13,
      "end_seconds": 285.59,
      "duration_seconds": 7.46,
      "text": "No, um, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.82,
      "end_seconds": 296.28,
      "duration_seconds": 9.46,
      "text": "Alright, I'll note both what you've said and what you've noticed. Okay, a few quick ones: crushing chest pain, cough or leg swelling?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 298.12,
      "end_seconds": 309.49,
      "duration_seconds": 11.37,
      "text": "No, no crushing chest pain, no cough, no leg swelling. I did have indigestion at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.93,
      "end_seconds": 313.39,
      "duration_seconds": 2.46,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 314.78,
      "end_seconds": 316.3,
      "duration_seconds": 1.52,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 316.88,
      "end_seconds": 327.23,
      "duration_seconds": 10.35,
      "text": "Okay, so the vitals from earlier. Temp 36.6 degrees, BP is 133 over 79, respiratory rate 17, saturation 96 percent, pulse is 124 beats a minute."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 328.87,
      "end_seconds": 329.9,
      "duration_seconds": 1.03,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 331.07,
      "end_seconds": 334.8,
      "duration_seconds": 3.73,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 336.45,
      "end_seconds": 337.48,
      "duration_seconds": 1.03,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 338.47,
      "end_seconds": 340.77,
      "duration_seconds": 2.3,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 357.06,
      "end_seconds": 365.56,
      "duration_seconds": 8.5,
      "text": "Your heart sounds are normal and your tummy is soft, but your pulse is a little fast."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 370.7,
      "end_seconds": 386.51,
      "duration_seconds": 15.81,
      "text": "Thank you, you can get dressed. Having listened and examined, my working impression is possible heart attack despite no classic chest pain. Reflux is still possible. A jaw problem is still possible."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 387.99,
      "end_seconds": 389.9,
      "duration_seconds": 1.91,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 392.2,
      "end_seconds": 400.93,
      "duration_seconds": 8.73,
      "text": "I can't promise yet, but most people with possible heart attack despite no classic chest pain do well once it's treated properly."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 416.59,
      "end_seconds": 420.91,
      "duration_seconds": 4.32,
      "text": "We should do a troponin test for possible heart attack."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 421.44,
      "end_seconds": 427.66,
      "duration_seconds": 6.22,
      "text": "Doctor, I did an ECG before they came in, the result's on your screen."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 429.0,
      "end_seconds": 452.57,
      "duration_seconds": 23.57,
      "text": "Thanks, that helps. For this, aspirin, 300 milligrams, once now, single dose. That should help with possible heart attack. Diabetes can hide the usual pain, so I am treating this as a heart problem until proven otherwise. Let's review you straight away. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 454.2,
      "end_seconds": 456.64,
      "duration_seconds": 2.44,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 457.67,
      "end_seconds": 459.02,
      "duration_seconds": 1.35,
      "text": "Goodbye for now."
    }
  ]
}