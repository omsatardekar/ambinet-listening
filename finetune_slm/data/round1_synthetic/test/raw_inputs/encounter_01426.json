      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.06,
      "end_seconds": 87.79,
      "duration_seconds": 13.73,
      "text": "Okay: heart rate 82, height 172 centimetres, weight 54 kilos, BMI works out to 18.3, temperature 36.4, oxygen saturation is 98 percent, blood pressure 112 over 69."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.12,
      "end_seconds": 93.32,
      "duration_seconds": 4.2,
      "text": "Alright, over here please and I'll take a look."
