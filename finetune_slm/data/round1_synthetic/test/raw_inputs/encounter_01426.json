      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.72,
      "end_seconds": 124.83,
      "duration_seconds": 2.11,
      "text": "okay, that's enough for me"
