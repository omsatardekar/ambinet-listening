    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 285.4,
      "end_seconds": 288.53,
      "duration_seconds": 3.13,
      "text": "do you think it's something serious?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 289.15,
      "end_seconds": 308.12,
      "duration_seconds": 18.97,
      "text": "nothing I've seen today points to an emergency it looks like a significant paracetamol overdose needing urgent treatment you need to stay in hospital for treatment, and someone will speak to you about how you are feeling that's everything on my side anything you're unsure about?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 309.53,
      "end_seconds": 312.78,
