      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.28,
      "end_seconds": 96.61,
      "duration_seconds": 2.33,
      "text": "I'm just checking this side."
