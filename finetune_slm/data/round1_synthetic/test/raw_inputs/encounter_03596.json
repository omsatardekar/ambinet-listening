{
  "schema_version": "1.0",
  "encounter_id": "03596",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.32,
      "end_seconds": 4.79,
      "duration_seconds": 3.47,
      "text": "hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.2,
      "end_seconds": 9.85,
      "duration_seconds": 3.65,
      "text": "that's fine, sit down. Tell me why you came"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.76,
      "end_seconds": 18.25,
      "duration_seconds": 6.49,
      "text": "doctor, it's periods stopped for four months it's getting on my nerves now"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.29,
      "end_seconds": 22.2,
      "duration_seconds": 2.91,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.31,
      "end_seconds": 33.41,
      "duration_seconds": 7.1,
      "text": "Since this morning, that's when it began. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.82,
      "end_seconds": 37.57,
      "duration_seconds": 3.75,
      "text": "Sure. Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.51,
      "end_seconds": 41.7,
      "duration_seconds": 2.19,
      "text": "I'd call it mild."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.7,
      "end_seconds": 45.67,
      "duration_seconds": 1.97,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.57,
      "end_seconds": 58.62,
      "duration_seconds": 11.05,
      "text": "It usually comes with a milky discharge from my breasts. Hmm, and being told it was just stress as well, since yesterday."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.39,
      "end_seconds": 67.53,
      "duration_seconds": 7.14,
      "text": "So, have you had periods stopped for four months before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.21,
      "end_seconds": 76.04,
      "duration_seconds": 6.83,
      "text": "A bit, about six months ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.96,
      "end_seconds": 97.98,
      "duration_seconds": 6.02,
      "text": "Let me check a few things. Any positive pregnancy test, visual changes or weight change?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.4,
      "end_seconds": 101.64,
      "duration_seconds": 2.24,
      "text": "none of those, no"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.74,
      "end_seconds": 104.08,
      "duration_seconds": 1.34,
      "text": "Any hot flushes?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.71,
      "end_seconds": 109.2,
      "duration_seconds": 3.49,
      "text": "No, I haven't had any hot flushes."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.55,
      "end_seconds": 114.56,
      "duration_seconds": 4.01,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.35,
      "end_seconds": 121.65,
      "duration_seconds": 3.3,
      "text": "No, um, nothing like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.97,
      "end_seconds": 136.89,
      "duration_seconds": 2.92,
      "text": "what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.19,
      "end_seconds": 144.79,
      "duration_seconds": 6.6,
      "text": "it's bisoprolol, 2.5 milligrams, once a day. Thyroxine, 75 micrograms, every morning"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.02,
      "end_seconds": 148.94,
      "duration_seconds": 2.92,
      "text": "are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.02,
      "end_seconds": 153.41,
      "duration_seconds": 2.39,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.07,
      "end_seconds": 157.25,
      "duration_seconds": 3.18,
      "text": "Alright, have you been to theatre before?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.0,
      "end_seconds": 162.69,
      "duration_seconds": 3.69,
      "text": "Just a bunion operation, six years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.44,
      "end_seconds": 167.35,
      "duration_seconds": 3.91,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.23,
      "end_seconds": 171.58,
      "duration_seconds": 2.35,
      "text": "Yes, an irregular heartbeat."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.49,
      "end_seconds": 173.35,
      "duration_seconds": 0.86,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.15,
      "end_seconds": 178.91,
      "duration_seconds": 4.76,
      "text": "actually, I have an underactive thyroid, for about ten years"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.67,
      "end_seconds": 181.97,
      "duration_seconds": 1.3,
      "text": "And besides that?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.53,
      "end_seconds": 188.68,
      "duration_seconds": 6.15,
      "text": "alright, an irregular heartbeat, that matches what I have here how are your meals?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.95,
      "end_seconds": 197.6,
      "duration_seconds": 3.65,
      "text": "I grab fast food at lunch most days"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.39,
      "end_seconds": 201.76,
      "duration_seconds": 3.37,
      "text": "Anything you do to to stay fit?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.99,
      "end_seconds": 206.94,
      "duration_seconds": 3.95,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.04,
      "end_seconds": 210.48,
      "duration_seconds": 2.44,
      "text": "let me quickly check your readings"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.66,
      "end_seconds": 219.94,
      "duration_seconds": 2.28,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.06,
      "end_seconds": 238.03,
      "duration_seconds": 6.97,
      "text": "Okay: pressure 125 over 79, saturation 99 percent, temperature is 36.6 degrees, pulse 86."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.26,
      "end_seconds": 243.97,
      "duration_seconds": 4.71,
      "text": "Alright, now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.8,
      "end_seconds": 246.13,
      "duration_seconds": 1.33,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.93,
      "end_seconds": 269.49,
      "duration_seconds": 9.56,
      "text": "You are not pregnant by the urine test, the breasts express a little milk, and and there is no visual field loss."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.24,
      "end_seconds": 276.81,
      "duration_seconds": 1.57,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.33,
      "end_seconds": 306.38,
      "duration_seconds": 13.05,
      "text": "Let's get a prolactin and thyroid blood test, for galactorrhoea. We should do an MRI of the pituitary for possible prolactinoma. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.94,
      "end_seconds": 309.56,
      "duration_seconds": 1.62,
      "text": "that makes sense"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.4,
      "end_seconds": 322.36,
      "duration_seconds": 10.96,
      "text": "don't stress about stress as the cause, the tests will tell us. Let's get you seen by the endocrine clinic, I'll arrange the letter"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.28,
      "end_seconds": 326.93,
      "duration_seconds": 2.65,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.57,
      "end_seconds": 331.12,
      "duration_seconds": 2.55,
      "text": "we'll catch up after the results"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.72,
      "end_seconds": 334.39,
      "duration_seconds": 1.67,
      "text": "yes, that's manageable"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.39,
      "end_seconds": 339.53,
      "duration_seconds": 3.14,
      "text": "Alright, does all of that make sense?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.11,
      "end_seconds": 342.25,
      "duration_seconds": 2.14,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.54,
      "end_seconds": 344.93,
      "duration_seconds": 1.39,
      "text": "Take care now."
    }
  ]
}