{
  "schema_version": "1.0",
  "encounter_id": "02712",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.51,
      "end_seconds": 2.67,
      "duration_seconds": 2.16,
      "text": "Good morning, grab a seat."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 4.27,
      "end_seconds": 10.31,
      "duration_seconds": 6.04,
      "text": "Good afternoon, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.31,
      "end_seconds": 14.95,
      "duration_seconds": 2.64,
      "text": "How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 16.25,
      "end_seconds": 22.49,
      "duration_seconds": 6.24,
      "text": "Yeah, it's seeing flashing lights. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.27,
      "end_seconds": 27.66,
      "duration_seconds": 3.39,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 28.66,
      "end_seconds": 33.07,
      "duration_seconds": 4.41,
      "text": "Okay, so I've had it for one week."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.77,
      "end_seconds": 37.56,
      "duration_seconds": 3.79,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 39.12,
      "end_seconds": 46.01,
      "duration_seconds": 6.89,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.65,
      "end_seconds": 53.36,
      "duration_seconds": 5.71,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 57.27,
      "end_seconds": 58.93,
      "duration_seconds": 1.66,
      "text": "Mild, I'd say."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 59.8,
      "end_seconds": 66.12,
      "duration_seconds": 6.32,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 66.22,
      "end_seconds": 71.11,
      "duration_seconds": 4.89,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 71.93,
      "end_seconds": 81.09,
      "duration_seconds": 9.16,
      "text": "I was getting to that! I've also had pain under the right ribs, for about a week."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.44,
      "end_seconds": 88.74,
      "duration_seconds": 6.3,
      "text": "So, have you had seeing flashing lights before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 90.21,
      "end_seconds": 98.37,
      "duration_seconds": 8.16,
      "text": "Yes, something like this happened a couple of years ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "UNKNOWN",
      "start_seconds": 99.88,
      "end_seconds": 103.45,
      "duration_seconds": 3.57,
      "text": "Yes, that's right, that's how it was."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.05,
      "end_seconds": 110.11,
      "duration_seconds": 5.06,
      "text": "Did you get reduced baby movements, leaking fluid or vaginal bleeding?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 111.11,
      "end_seconds": 124.76,
      "duration_seconds": 13.65,
      "text": "No, no reduced baby movements, no leaking fluid, no vaginal bleeding. I did have swollen face and hands at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.11,
      "end_seconds": 129.33,
      "duration_seconds": 3.22,
      "text": "Alright, any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 131.1,
      "end_seconds": 133.2,
      "duration_seconds": 2.1,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.78,
      "end_seconds": 135.23,
      "duration_seconds": 1.45,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 136.46,
      "end_seconds": 137.85,
      "duration_seconds": 1.39,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.73,
      "end_seconds": 139.99,
      "duration_seconds": 1.26,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 141.2,
      "end_seconds": 144.29,
      "duration_seconds": 3.09,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.04,
      "end_seconds": 149.01,
      "duration_seconds": 3.97,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 153.7,
      "end_seconds": 157.77,
      "duration_seconds": 4.07,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.51,
      "end_seconds": 162.59,
      "duration_seconds": 4.08,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 163.57,
      "end_seconds": 170.74,
      "duration_seconds": 7.17,
      "text": "I was told I'm allergic to plasters, but I don't remember what reaction I had."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.19,
      "end_seconds": 182.98,
      "duration_seconds": 3.79,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 183.56,
      "end_seconds": 189.6,
      "duration_seconds": 6.04,
      "text": "My mother has an underactive thyroid. My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.29,
      "end_seconds": 193.42,
      "duration_seconds": 2.13,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 194.29,
      "end_seconds": 199.3,
      "duration_seconds": 5.01,
      "text": "I have epilepsy. I have diabetes, for about ten years."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.3,
      "end_seconds": 201.17,
      "duration_seconds": 0.87,
      "text": "Anything else?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.17,
      "end_seconds": 212.58,
      "duration_seconds": 10.41,
      "text": "Yes, epilepsy and diabetes are known to us, good to have that clear. What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 214.07,
      "end_seconds": 226.04,
      "duration_seconds": 11.97,
      "text": "It's lamotrigine, 100 milligrams, twice a day for the fits. I take something called glim... glimepiride, 2 milligrams, maybe, before breakfast."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.59,
      "end_seconds": 230.57,
      "duration_seconds": 3.98,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 232.4,
      "end_seconds": 235.99,
      "duration_seconds": 3.59,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.66,
      "end_seconds": 240.82,
      "duration_seconds": 3.16,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 241.74,
      "end_seconds": 247.35,
      "duration_seconds": 5.61,
      "text": "I had my appendix taken out when I was in my twenties."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.88,
      "end_seconds": 252.56,
      "duration_seconds": 3.68,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.5,
      "end_seconds": 256.53,
      "duration_seconds": 2.03,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.54,
      "end_seconds": 270.03,
      "duration_seconds": 4.49,
      "text": "Your blood pressure is very high and your reflexes are brisk."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.78,
      "end_seconds": 275.49,
      "duration_seconds": 1.71,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.86,
      "end_seconds": 286.98,
      "duration_seconds": 4.12,
      "text": "I'd like to arrange urgent blood tests for pre-eclampsia."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 287.99,
      "end_seconds": 291.97,
      "duration_seconds": 3.98,
      "text": "I can book that for Tuesday at 3:30 pm."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.51,
      "end_seconds": 298.15,
      "duration_seconds": 4.64,
      "text": "A urine protein test is what I'd like next, for pre-eclampsia."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 299.77,
      "end_seconds": 302.37,
      "duration_seconds": 2.6,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 303.69,
      "end_seconds": 336.32,
      "duration_seconds": 32.63,
      "text": "We'll begin with labetalol, 200 milligrams, once now, single dose. It's for severe hypertension. You need to go to the maternity unit straight away. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 337.04,
      "end_seconds": 339.39,
      "duration_seconds": 2.35,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 340.97,
      "end_seconds": 342.43,
      "duration_seconds": 1.46,
      "text": "See you soon."
    }
  ]
}