{
  "schema_version": "1.0",
  "encounter_id": "00891",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 2.18,
      "end_seconds": 10.5,
      "duration_seconds": 8.32,
      "text": "Hello, I'm Dr Reyes. What would you like me to call you, Mr Tran, or Henry? ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.43,
      "end_seconds": 22.34,
      "duration_seconds": 7.91,
      "text": "Henry's fine. My legs are a bit puffy, that's all, but Marisol made me come."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_4",
      "role": "CAREGIVER",
      "start_seconds": 25.72,
      "end_seconds": 41.57,
      "duration_seconds": 15.85,
      "text": "I'm his carer, Marisol, I live in. His ankles have been swollen for three weeks, and last night he couldn't lie down, he slept in the chair."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.37,
      "end_seconds": 51.22,
      "duration_seconds": 5.85,
      "text": "Three weeks, no. One week. It's been one week."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.24,
      "end_seconds": 65.43,
      "duration_seconds": 11.19,
      "text": "One week or three weeks. We'll record that as somewhere between one and three weeks. And last night, Henry?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.42,
      "end_seconds": 76.72,
      "duration_seconds": 7.3,
      "text": "Couldn't breathe lying flat. I had to prop up on three pillows, then the chair."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.23,
      "end_seconds": 82.4,
      "duration_seconds": 2.17,
      "text": "Any chest pain?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.22,
      "end_seconds": 87.46,
      "duration_seconds": 2.24,
      "text": "No chest pain."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.54,
      "end_seconds": 94.47,
      "duration_seconds": 3.93,
      "text": "Nurse, can we get his obs?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 112.25,
      "end_seconds": 121.4,
      "duration_seconds": 9.15,
      "text": "Sure. Oxygen 92 percent, blood pressure 156 over 92, pulse 96, breathing 22, temperature 36.8, and weight 88 kilos."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.42,
      "end_seconds": 128.81,
      "duration_seconds": 4.39,
      "text": "Thank you. Henry, what medications do you take?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.82,
      "end_seconds": 145.09,
      "duration_seconds": 13.27,
      "text": "Metoprolol, 50 mg, twice a day. And a little white water pill, I take it every morning. I couldn't tell you the name."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "CAREGIVER",
      "start_seconds": 148.24,
      "end_seconds": 157.19,
      "duration_seconds": 8.95,
      "text": "I'll bring the box tomorrow, doctor. It's small and white, but I've not got the name written down."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.03,
      "end_seconds": 166.16,
      "duration_seconds": 6.13,
      "text": "That's fine, we'll find it on the pharmacy record. Any heart history?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.81,
      "end_seconds": 172.14,
      "duration_seconds": 3.33,
      "text": "High blood pressure, for thirty years."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.1,
      "end_seconds": 176.28,
      "duration_seconds": 1.18,
      "text": "Operations?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.91,
      "end_seconds": 182.17,
      "duration_seconds": 2.26,
      "text": "Bypass surgery, in 2016."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.71,
      "end_seconds": 190.09,
      "duration_seconds": 4.38,
      "text": "Who looks after you at home?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "CAREGIVER",
      "start_seconds": 192.85,
      "end_seconds": 197.02,
      "duration_seconds": 4.17,
      "text": "I do, I live in with him."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.48,
      "end_seconds": 214.61,
      "duration_seconds": 5.13,
      "text": "Let me look at your legs. Press here."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.42,
      "end_seconds": 219.99,
      "duration_seconds": 2.57,
      "text": "Cold hands, doc. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.61,
      "end_seconds": 229.26,
      "duration_seconds": 6.65,
      "text": "There's pitting swelling in both legs, up to the knees."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "CAREGIVER",
      "start_seconds": 232.26,
      "end_seconds": 235.64,
      "duration_seconds": 3.38,
      "text": "It wasn't that high yesterday. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.55,
      "end_seconds": 243.05,
      "duration_seconds": 3.5,
      "text": "Any palpitations, fluttering in the chest?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.0,
      "end_seconds": 248.47,
      "duration_seconds": 1.47,
      "text": "No, nothing."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.67,
      "end_seconds": 259.46,
      "duration_seconds": 7.79,
      "text": "What I'm seeing looks like fluid backing up, probably from the heart, but let's confirm."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "CAREGIVER",
      "start_seconds": 261.86,
      "end_seconds": 264.8,
      "duration_seconds": 2.94,
      "text": "Is it serious? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.49,
      "end_seconds": 279.71,
      "duration_seconds": 12.22,
      "text": "It needs treatment today. I'd like to arrange a chest X-ray, an ECG, and blood tests including a heart-strain marker."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 283.01,
      "end_seconds": 288.1,
      "duration_seconds": 5.09,
      "text": "I'll take him for the ECG now. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.5,
      "end_seconds": 299.22,
      "duration_seconds": 8.72,
      "text": "Thank you, nurse. If the swelling isn't coming down after three days of the treatment, come straight back."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "CAREGIVER",
      "start_seconds": 303.04,
      "end_seconds": 306.03,
      "duration_seconds": 2.99,
      "text": "I'll watch his legs. ~"
    }
  ]
}
