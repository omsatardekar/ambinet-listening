{
  "schema_version": "1.0",
  "encounter_id": "01819",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.25,
      "end_seconds": 4.47,
      "duration_seconds": 3.22,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.21,
      "end_seconds": 10.23,
      "duration_seconds": 4.02,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.22,
      "end_seconds": 22.43,
      "duration_seconds": 8.21,
      "text": "Mainly cramping tummy pain. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.32,
      "end_seconds": 26.53,
      "duration_seconds": 3.21,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.44,
      "end_seconds": 32.04,
      "duration_seconds": 3.6,
      "text": "It's been going on for about a month."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.39,
      "end_seconds": 36.18,
      "duration_seconds": 2.79,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.75,
      "end_seconds": 37.93,
      "duration_seconds": 1.18,
      "text": "Severe, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.62,
      "end_seconds": 40.76,
      "duration_seconds": 2.14,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.42,
      "end_seconds": 45.11,
      "duration_seconds": 2.69,
      "text": "I'd say every other day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.43,
      "end_seconds": 58.63,
      "duration_seconds": 4.2,
      "text": "A few quick ones: fever, vomiting or joint pain?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.34,
      "end_seconds": 62.01,
      "duration_seconds": 2.67,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.13,
      "end_seconds": 65.26,
      "duration_seconds": 2.13,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.95,
      "end_seconds": 71.03,
      "duration_seconds": 2.08,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.92,
      "end_seconds": 76.29,
      "duration_seconds": 3.37,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.78,
      "end_seconds": 82.41,
      "duration_seconds": 4.63,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.93,
      "end_seconds": 88.5,
      "duration_seconds": 3.57,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.09,
      "end_seconds": 93.73,
      "duration_seconds": 3.64,
      "text": "I have heart disease, for two years."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.56,
      "end_seconds": 97.92,
      "duration_seconds": 2.36,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.7,
      "end_seconds": 103.16,
      "duration_seconds": 3.46,
      "text": "It's aspirin, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.86,
      "end_seconds": 106.27,
      "duration_seconds": 2.41,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.36,
      "end_seconds": 111.73,
      "duration_seconds": 3.37,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.71,
      "end_seconds": 118.92,
      "duration_seconds": 5.21,
      "text": "Right, are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.72,
      "end_seconds": 126.14,
      "duration_seconds": 3.42,
      "text": "Well, not to my knowledge, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.27,
      "end_seconds": 132.06,
      "duration_seconds": 4.79,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.47,
      "end_seconds": 146.01,
      "duration_seconds": 12.54,
      "text": "Not much, I mostly stay in these days. I grab fast food at lunch most days. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.07,
      "end_seconds": 162.76,
      "duration_seconds": 3.69,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.68,
      "end_seconds": 177.05,
      "duration_seconds": 2.37,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.51,
      "end_seconds": 205.39,
      "duration_seconds": 9.88,
      "text": "Okay: temp 36.5 degrees, pulse is 68 beats a minute, SpO2 99 percent on room air, BP is 114 over 81."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.94,
      "end_seconds": 211.98,
      "duration_seconds": 4.04,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.81,
      "end_seconds": 214.51,
      "duration_seconds": 1.7,
      "text": "Alright, does that hurt?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.54,
      "end_seconds": 235.05,
      "duration_seconds": 4.51,
      "text": "There is tenderness in the lower right tummy and no guarding."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.03,
      "end_seconds": 242.73,
      "duration_seconds": 1.7,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.83,
      "end_seconds": 262.38,
      "duration_seconds": 9.55,
      "text": "Okay, so my impression is this: I can't pin this down yet. We're looking at a flare of inflammatory bowel disease or an infection."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.5,
      "end_seconds": 304.31,
      "duration_seconds": 23.81,
      "text": "I'm sending you for a stool test because of bloody diarrhoea. I'll start you on prednisolone, 40 milligrams, once a day, one week then reduce. You take it by mouth. That should help with inflammatory bowel flare. I'll put all of this in writing so you don't have to remember it."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.97,
      "end_seconds": 309.73,
      "duration_seconds": 3.76,
      "text": "Should I carry on if I feel better?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.5,
      "end_seconds": 330.11,
      "duration_seconds": 19.61,
      "text": "Keep up your fluids and call the IBD nurse if you get a fever. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. The IBD nurse would be the right next step, I'll refer you. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.05,
      "end_seconds": 334.56,
      "duration_seconds": 3.51,
      "text": "Erm, great, thank you for your help."
    }
  ]
}