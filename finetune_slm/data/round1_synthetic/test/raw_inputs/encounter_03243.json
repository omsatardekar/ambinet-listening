{
  "schema_version": "1.0",
  "encounter_id": "03243",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.34,
      "end_seconds": 3.85,
      "duration_seconds": 2.51,
      "text": "Good afternoon, uh, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.86,
      "end_seconds": 10.5,
      "duration_seconds": 4.64,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.68,
      "end_seconds": 16.75,
      "duration_seconds": 5.07,
      "text": "Um, doctor, it's confusion. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.25,
      "end_seconds": 21.9,
      "duration_seconds": 3.65,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.82,
      "end_seconds": 30.23,
      "duration_seconds": 6.41,
      "text": "It's been about a month now. I've also had cloudy smelly urine."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.77,
      "end_seconds": 34.65,
      "duration_seconds": 2.88,
      "text": "So, do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.97,
      "end_seconds": 42.44,
      "duration_seconds": 4.47,
      "text": "I have an irregular heartbeat, for five years."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.15,
      "end_seconds": 45.52,
      "duration_seconds": 1.37,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.24,
      "end_seconds": 48.16,
      "duration_seconds": 1.92,
      "text": "I've got thin bones."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.15,
      "end_seconds": 61.86,
      "duration_seconds": 12.71,
      "text": "Yes, an irregular heartbeat and thin bones are known to us, good to have that clear. Alright, before we go further, any allergies? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.55,
      "end_seconds": 66.89,
      "duration_seconds": 4.34,
      "text": "Yes, plasters, it gives me a red itchy rash."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.6,
      "end_seconds": 70.04,
      "duration_seconds": 1.44,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.25,
      "end_seconds": 73.28,
      "duration_seconds": 2.03,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.01,
      "end_seconds": 77.65,
      "duration_seconds": 2.64,
      "text": "Right, tell me your medicines, please."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.0,
      "end_seconds": 91.46,
      "duration_seconds": 8.46,
      "text": "I'm on bisoprolol, 2.5 milligrams, once a day. Alendronate. I take it 70 milligrams, once a week."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.45,
      "end_seconds": 95.92,
      "duration_seconds": 2.47,
      "text": "When did you start it?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.92,
      "end_seconds": 98.6,
      "duration_seconds": 1.68,
      "text": "About six months."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.42,
      "end_seconds": 111.24,
      "duration_seconds": 2.82,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.68,
      "end_seconds": 116.75,
      "duration_seconds": 4.07,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.26,
      "end_seconds": 119.57,
      "duration_seconds": 2.31,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.37,
      "end_seconds": 123.66,
      "duration_seconds": 2.29,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.19,
      "end_seconds": 126.65,
      "duration_seconds": 2.46,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.05,
      "end_seconds": 131.51,
      "duration_seconds": 3.46,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.08,
      "end_seconds": 133.25,
      "duration_seconds": 1.17,
      "text": "How about fall?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.37,
      "end_seconds": 137.14,
      "duration_seconds": 2.77,
      "text": "I haven't noticed any fall."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.23,
      "end_seconds": 142.73,
      "duration_seconds": 4.5,
      "text": "Alright, did you get vomiting, back pain or cough?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.91,
      "end_seconds": 148.26,
      "duration_seconds": 4.35,
      "text": "Uh, no, no vomiting, back pain or cough."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.88,
      "end_seconds": 153.51,
      "duration_seconds": 3.63,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.28,
      "end_seconds": 156.81,
      "duration_seconds": 1.53,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.22,
      "end_seconds": 162.51,
      "duration_seconds": 2.29,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.1,
      "end_seconds": 165.12,
      "duration_seconds": 1.02,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.03,
      "end_seconds": 170.53,
      "duration_seconds": 3.5,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.99,
      "end_seconds": 186.06,
      "duration_seconds": 2.07,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.41,
      "end_seconds": 203.24,
      "duration_seconds": 7.83,
      "text": "Okay: pulse 95, blood pressure 108 over 73, respiratory rate 17, temperature is 38.0 degrees."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.13,
      "end_seconds": 205.67,
      "duration_seconds": 1.54,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.37,
      "end_seconds": 211.31,
      "duration_seconds": 3.94,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.42,
      "end_seconds": 214.8,
      "duration_seconds": 2.38,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.66,
      "end_seconds": 227.42,
      "duration_seconds": 1.76,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.25,
      "end_seconds": 230.57,
      "duration_seconds": 1.32,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.65,
      "end_seconds": 253.87,
      "duration_seconds": 6.22,
      "text": "The catheter bag has cloudy urine and there is tenderness above the pubic bone."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.08,
      "end_seconds": 261.26,
      "duration_seconds": 2.18,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.24,
      "end_seconds": 284.31,
      "duration_seconds": 5.07,
      "text": "I'm going to order a urine culture, for possible urinary infection."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 285.59,
      "end_seconds": 289.28,
      "duration_seconds": 3.69,
      "text": "I can book that for Monday at 3:30 pm."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.93,
      "end_seconds": 302.82,
      "duration_seconds": 12.89,
      "text": "I'm prescribing co-amoxiclav, 625 milligrams, three times a day, seven days. It's for catheter urinary infection. Change the catheter and drink plenty. I'd like to see you again in two days."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.25,
      "end_seconds": 306.41,
      "duration_seconds": 2.16,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.74,
      "end_seconds": 314.49,
      "duration_seconds": 3.75,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.21,
      "end_seconds": 319.47,
      "duration_seconds": 3.26,
      "text": "I mean, thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.45,
      "end_seconds": 321.88,
      "duration_seconds": 1.43,
      "text": "Goodbye for now."
    }
  ]
}