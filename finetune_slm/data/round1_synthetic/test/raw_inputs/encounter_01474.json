{
  "schema_version": "1.0",
  "encounter_id": "01474",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.89,
      "end_seconds": 4.53,
      "duration_seconds": 3.64,
      "text": "Right, hello, sorry about the delay, do sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.62,
      "end_seconds": 8.81,
      "duration_seconds": 1.19,
      "text": "hi, thanks"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.94,
      "end_seconds": 13.17,
      "duration_seconds": 3.23,
      "text": "Right, you came on your own today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.57,
      "end_seconds": 17.77,
      "duration_seconds": 3.2,
      "text": "Yes, I managed on my own."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.66,
      "end_seconds": 20.83,
      "duration_seconds": 1.17,
      "text": "what's the problem?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.6,
      "end_seconds": 28.94,
      "duration_seconds": 3.34,
      "text": "Well, I've been having being thirsty."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.71,
      "end_seconds": 31.14,
      "duration_seconds": 1.43,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.67,
      "end_seconds": 34.98,
      "duration_seconds": 2.31,
      "text": "About... well, two weeks."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.22,
      "end_seconds": 38.98,
      "duration_seconds": 3.76,
      "text": "understood how troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 40.2,
      "end_seconds": 48.66,
      "duration_seconds": 8.46,
      "text": "It's moderate, honestly. Oh, and recurrent thrush. That's been about the same, about a month."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 49.85,
      "end_seconds": 51.56,
      "duration_seconds": 1.71,
      "text": "any tiredness as well?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 52.31,
      "end_seconds": 56.0,
      "duration_seconds": 3.69,
      "text": "Mm, yes, for about four days."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 56.67,
      "end_seconds": 62.64,
      "duration_seconds": 5.97,
      "text": "Have you had being thirsty before, or is this the first time?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.1,
      "end_seconds": 71.37,
      "duration_seconds": 5.27,
      "text": "A bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.04,
      "end_seconds": 76.4,
      "duration_seconds": 2.36,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.86,
      "end_seconds": 88.74,
      "duration_seconds": 2.88,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.9,
      "end_seconds": 111.79,
      "duration_seconds": 12.89,
      "text": "Okay: BMI works out to 27.8, pressure 145 over 98. And height 154 centimetres, temperature 37.0, heart rate 94, weight 66 kilos, SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.77,
      "end_seconds": 118.01,
      "duration_seconds": 2.24,
      "text": "Is that that okay?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.33,
      "end_seconds": 121.69,
      "duration_seconds": 2.36,
      "text": "we'll look at it together shortly"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.05,
      "end_seconds": 126.94,
      "duration_seconds": 3.89,
      "text": "right, let's have a proper look at you"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.43,
      "end_seconds": 129.62,
      "duration_seconds": 1.19,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.64,
      "end_seconds": 153.46,
      "duration_seconds": 7.82,
      "text": "The feeling at the tips of your toes is reduced and the foot pulses are present."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.38,
      "end_seconds": 159.15,
      "duration_seconds": 2.77,
      "text": "that's all I needed to check"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.28,
      "end_seconds": 173.89,
      "duration_seconds": 4.61,
      "text": "Okay, and what about foot ulcers, chest pain or vomiting?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 177.12,
      "end_seconds": 181.92,
      "duration_seconds": 4.8,
      "text": "No, no foot ulcers, chest pain or vomiting."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.87,
      "end_seconds": 188.34,
      "duration_seconds": 3.47,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 189.36,
      "end_seconds": 190.83,
      "duration_seconds": 1.47,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.53,
      "end_seconds": 194.84,
      "duration_seconds": 3.31,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 196.11,
      "end_seconds": 202.39,
      "duration_seconds": 6.28,
      "text": "Mm, my heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.0,
      "end_seconds": 205.64,
      "duration_seconds": 2.64,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.13,
      "end_seconds": 212.41,
      "duration_seconds": 5.28,
      "text": "I have diabetes. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.2,
      "end_seconds": 214.9,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 216.71,
      "end_seconds": 229.15,
      "duration_seconds": 12.44,
      "text": "Yes, high blood pressure. Work has been very busy so I kept ignoring it. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.67,
      "end_seconds": 233.5,
      "duration_seconds": 2.83,
      "text": "any surgery in the the past?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 234.16,
      "end_seconds": 243.35,
      "duration_seconds": 9.19,
      "text": "Uh, yes, I had my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.35,
      "end_seconds": 247.37,
      "duration_seconds": 3.02,
      "text": "before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 248.09,
      "end_seconds": 251.06,
      "duration_seconds": 2.97,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.85,
      "end_seconds": 255.82,
      "duration_seconds": 2.97,
      "text": "Right, now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 257.59,
      "end_seconds": 271.29,
      "duration_seconds": 13.7,
      "text": "I hardly move around during the day. I grab fast food at lunch most days. I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.8,
      "end_seconds": 274.87,
      "duration_seconds": 2.07,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 279.66,
      "end_seconds": 285.1,
      "duration_seconds": 5.44,
      "text": "It's amlodipine, 5 milligrams, once a day for my pressure."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.01,
      "end_seconds": 289.02,
      "duration_seconds": 3.01,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 290.19,
      "end_seconds": 291.87,
      "duration_seconds": 1.68,
      "text": "For six months."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.33,
      "end_seconds": 307.02,
      "duration_seconds": 7.69,
      "text": "Let me tell you where I've got to. This looks most like diabetes not well controlled on current treatment."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 317.39,
      "end_seconds": 321.69,
      "duration_seconds": 4.3,
      "text": "I'm sending you for kidney function tests because of diabetes review."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 323.35,
      "end_seconds": 328.02,
      "duration_seconds": 4.67,
      "text": "We have a slot Monday at 9 am, if that that works."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 330.1,
      "end_seconds": 353.05,
      "duration_seconds": 22.95,
      "text": "I'm sending you for an HbA1c because of diabetes review. We'll begin with gliclazide, 40 milligrams, once a day with breakfast, long term. You take it by mouth. That's for diabetes. Check your feet daily and book the the eye screening. Let's get you seen by the diabetes educator, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 357.89,
      "end_seconds": 359.83,
      "duration_seconds": 1.94,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 360.55,
      "end_seconds": 364.41,
      "duration_seconds": 3.86,
      "text": "I think we're done unless you have questions"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 368.84,
      "end_seconds": 371.42,
      "duration_seconds": 2.58,
      "text": "thank you, doctor, goodbye"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 372.44,
      "end_seconds": 373.8,
      "duration_seconds": 1.36,
      "text": "all the best"
    }
  ]
}