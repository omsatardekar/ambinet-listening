{
  "schema_version": "1.0",
  "encounter_id": "03541",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.8,
      "end_seconds": 2.47,
      "duration_seconds": 1.67,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.59,
      "end_seconds": 8.55,
      "duration_seconds": 4.96,
      "text": "Alright, yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 10.12,
      "end_seconds": 14.32,
      "duration_seconds": 4.2,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.33,
      "end_seconds": 22.51,
      "duration_seconds": 6.18,
      "text": "So the thing is, I've got not remembering the last hours."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.59,
      "end_seconds": 27.31,
      "duration_seconds": 3.72,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.64,
      "end_seconds": 31.3,
      "duration_seconds": 2.66,
      "text": "I'd say three weeks, maybe."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 33.38,
      "end_seconds": 36.97,
      "duration_seconds": 3.59,
      "text": "It was closer to a month, doctor."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.91,
      "end_seconds": 43.65,
      "duration_seconds": 4.74,
      "text": "Okay, so roughly three to four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.53,
      "end_seconds": 46.92,
      "duration_seconds": 2.39,
      "text": "I suppose so, yes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.85,
      "end_seconds": 50.88,
      "duration_seconds": 3.03,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.61,
      "end_seconds": 54.05,
      "duration_seconds": 2.44,
      "text": "It feels mild to me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.44,
      "end_seconds": 58.58,
      "duration_seconds": 3.14,
      "text": "Any asking the same questions repeatedly as well?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.52,
      "end_seconds": 67.17,
      "duration_seconds": 7.65,
      "text": "Yes, about the same, five days. I've been feeling fine otherwise too, for two months."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.79,
      "end_seconds": 70.59,
      "duration_seconds": 2.8,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.34,
      "end_seconds": 76.57,
      "duration_seconds": 1.23,
      "text": "Moderate, really."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.15,
      "end_seconds": 95.92,
      "duration_seconds": 2.77,
      "text": "Did you get slurred speech or weakness?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.44,
      "end_seconds": 100.55,
      "duration_seconds": 3.11,
      "text": "No, no slurred speech or weakness."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.02,
      "end_seconds": 103.69,
      "duration_seconds": 1.67,
      "text": "Any sign of headache?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.49,
      "end_seconds": 107.68,
      "duration_seconds": 3.19,
      "text": "No, I haven't had any headache."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 108.81,
      "end_seconds": 113.48,
      "duration_seconds": 4.67,
      "text": "Actually, doctor, I did notice headache. He doesn't always say."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.21,
      "end_seconds": 121.15,
      "duration_seconds": 6.94,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.97,
      "end_seconds": 127.12,
      "duration_seconds": 5.15,
      "text": "Alright, I'll note both what you've said and what you've noticed."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.62,
      "end_seconds": 131.37,
      "duration_seconds": 3.75,
      "text": "I see, go ahead. Any sign of seizure?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.67,
      "end_seconds": 135.64,
      "duration_seconds": 2.97,
      "text": "No, I haven't had any seizure."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.01,
      "end_seconds": 139.85,
      "duration_seconds": 3.84,
      "text": "Okay, go on. Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.5,
      "end_seconds": 145.43,
      "duration_seconds": 0.93,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.33,
      "end_seconds": 148.77,
      "duration_seconds": 2.44,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.59,
      "end_seconds": 158.48,
      "duration_seconds": 7.89,
      "text": "I have heart disease, for about ten years. I've had an irregular heartbeat, yes."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.29,
      "end_seconds": 161.01,
      "duration_seconds": 1.72,
      "text": "Alright, and besides that?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.64,
      "end_seconds": 167.74,
      "duration_seconds": 5.1,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.48,
      "end_seconds": 174.5,
      "duration_seconds": 5.02,
      "text": "Metoprolol, 50 milligrams, maybe, twice a day for my heart."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.1,
      "end_seconds": 184.6,
      "duration_seconds": 4.5,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.14,
      "end_seconds": 187.24,
      "duration_seconds": 2.1,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.67,
      "end_seconds": 191.1,
      "duration_seconds": 2.43,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.17,
      "end_seconds": 202.49,
      "duration_seconds": 9.32,
      "text": "I've never touched a cigarette. I do a yoga class on Thursdays. I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.0,
      "end_seconds": 207.32,
      "duration_seconds": 4.32,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.59,
      "end_seconds": 221.51,
      "duration_seconds": 12.92,
      "text": "Yes, amoxicillin. I've no idea what the reaction was, only that I'm not supposed to have it. Grass pollen. I come out in... well, sneezing."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.33,
      "end_seconds": 226.04,
      "duration_seconds": 2.71,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.23,
      "end_seconds": 231.31,
      "duration_seconds": 4.08,
      "text": "Just a bunion operation, six years ago."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.2,
      "end_seconds": 243.3,
      "duration_seconds": 3.1,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.81,
      "end_seconds": 256.8,
      "duration_seconds": 1.99,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.29,
      "end_seconds": 293.67,
      "duration_seconds": 16.38,
      "text": "Okay: temp 36.8 degrees, pulse 67, respiratory rate 18. And pressure 108 over 79. Right, here's what I'm thinking. It points towards transient global amnesia. I'd also keep a stroke in mind."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.0,
      "end_seconds": 298.86,
      "duration_seconds": 3.86,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.24,
      "end_seconds": 311.68,
      "duration_seconds": 11.44,
      "text": "I understand the worry. At the moment I'd say it's transient global amnesia, and we'll know more once the a blood sugar is back."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.77,
      "end_seconds": 357.04,
      "duration_seconds": 29.27,
      "text": "I'll request a blood sugar, it'll help with confusion. I'll request a CT scan of the head, it'll help with acute memory loss. This usually clears in a day with no lasting effect, but we do a scan first to be safe. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 357.68,
      "end_seconds": 360.38,
      "duration_seconds": 2.7,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.42,
      "end_seconds": 363.8,
      "duration_seconds": 1.38,
      "text": "Goodbye for now."
    }
  ]
}