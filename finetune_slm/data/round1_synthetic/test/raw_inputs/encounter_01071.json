{
  "schema_version": "1.0",
  "encounter_id": "01071",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.35,
      "end_seconds": 7.24,
      "duration_seconds": 5.89,
      "text": "Okay, so hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.53,
      "end_seconds": 13.54,
      "duration_seconds": 5.01,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.52,
      "end_seconds": 35.08,
      "duration_seconds": 19.56,
      "text": "Well, uh, I've been having sudden hearing loss in one ear. I wasn't sure whether to come in at all, to be honest. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.91,
      "end_seconds": 40.23,
      "duration_seconds": 3.32,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.14,
      "end_seconds": 51.51,
      "duration_seconds": 10.37,
      "text": "So, it's been ten days, I'm fairly sure. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.42,
      "end_seconds": 57.39,
      "duration_seconds": 4.97,
      "text": "Have you had any dizziness, ear pain or facial weakness?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.26,
      "end_seconds": 64.95,
      "duration_seconds": 5.69,
      "text": "No dizziness, ear pain or facial weakness, none of it."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.58,
      "end_seconds": 68.69,
      "duration_seconds": 2.11,
      "text": "Have you had any discharge?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.22,
      "end_seconds": 71.26,
      "duration_seconds": 2.04,
      "text": "No, none, no discharge."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.33,
      "end_seconds": 76.32,
      "duration_seconds": 3.99,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.17,
      "end_seconds": 79.82,
      "duration_seconds": 1.65,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.96,
      "end_seconds": 84.9,
      "duration_seconds": 3.94,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.58,
      "end_seconds": 88.98,
      "duration_seconds": 2.4,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.38,
      "end_seconds": 109.05,
      "duration_seconds": 2.67,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.15,
      "end_seconds": 125.97,
      "duration_seconds": 15.82,
      "text": "I had my tonsils removed as a teenager. A neighbour of mine said I should see someone about it. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.75,
      "end_seconds": 130.08,
      "duration_seconds": 2.33,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.16,
      "end_seconds": 132.37,
      "duration_seconds": 1.21,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.99,
      "end_seconds": 136.06,
      "duration_seconds": 2.07,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.84,
      "end_seconds": 141.22,
      "duration_seconds": 3.38,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.01,
      "end_seconds": 142.86,
      "duration_seconds": 0.85,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.88,
      "end_seconds": 146.7,
      "duration_seconds": 2.82,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.93,
      "end_seconds": 150.86,
      "duration_seconds": 2.93,
      "text": "So, do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.49,
      "end_seconds": 155.25,
      "duration_seconds": 3.76,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.76,
      "end_seconds": 157.12,
      "duration_seconds": 1.36,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.12,
      "end_seconds": 161.92,
      "duration_seconds": 2.8,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.93,
      "end_seconds": 166.81,
      "duration_seconds": 3.88,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.94,
      "end_seconds": 170.99,
      "duration_seconds": 3.05,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 189.72,
      "end_seconds": 201.39,
      "duration_seconds": 11.67,
      "text": "Okay, so the vitals from earlier. Pulse 69, respiratory rate 16, temp 36.8 degrees, SpO2 99 percent on room air, BP is 124 over 77."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.1,
      "end_seconds": 202.8,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.57,
      "end_seconds": 206.53,
      "duration_seconds": 1.96,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.37,
      "end_seconds": 209.65,
      "duration_seconds": 1.28,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.08,
      "end_seconds": 225.2,
      "duration_seconds": 7.12,
      "text": "The ear drum looks normal and the tuning fork is heard louder in the other ear."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.97,
      "end_seconds": 233.14,
      "duration_seconds": 3.17,
      "text": "Okay, good, you can sit up again."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.2,
      "end_seconds": 249.6,
      "duration_seconds": 6.4,
      "text": "Right, here's what I'm thinking. This is probably sudden hearing loss needing urgent treatment."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.14,
      "end_seconds": 263.28,
      "duration_seconds": 5.14,
      "text": "I want an urgent hearing test done, that's for sudden hearing loss."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.21,
      "end_seconds": 265.41,
      "duration_seconds": 1.2,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.41,
      "end_seconds": 286.32,
      "duration_seconds": 19.91,
      "text": "I'm prescribing prednisolone, 60 milligrams, once a day, seven days. That's for sudden hearing loss. I'll put all of this in writing so you don't have to remember it. This is time-critical, so I'm starting treatment today. See me again in one week."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.89,
      "end_seconds": 288.63,
      "duration_seconds": 1.74,
      "text": "Yes, that's manageable."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.85,
      "end_seconds": 293.68,
      "duration_seconds": 3.83,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.77,
      "end_seconds": 298.91,
      "duration_seconds": 3.14,
      "text": "Alright, um, thanks, take care."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.98,
      "end_seconds": 302.31,
      "duration_seconds": 1.33,
      "text": "See you soon."
    }
  ]
}