{
  "schema_version": "1.0",
  "encounter_id": "01480",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.51,
      "end_seconds": 3.76,
      "duration_seconds": 3.25,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.12,
      "end_seconds": 9.41,
      "duration_seconds": 4.29,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.11,
      "end_seconds": 15.84,
      "duration_seconds": 5.73,
      "text": "I've been feeling sick, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.21,
      "end_seconds": 25.71,
      "duration_seconds": 8.5,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.75,
      "end_seconds": 35.67,
      "duration_seconds": 4.92,
      "text": "I'd say moderate. Honestly, a few times a day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.46,
      "end_seconds": 38.46,
      "duration_seconds": 2.0,
      "text": "Any tummy pain as well?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.05,
      "end_seconds": 56.37,
      "duration_seconds": 16.32,
      "text": "Yeah, uh, that too. About tummy pain, honestly, a few times a day. I've been feeling very low too, for about a month. Ah, about feeling very low, moderate, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.15,
      "end_seconds": 61.21,
      "duration_seconds": 3.06,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.22,
      "end_seconds": 67.48,
      "duration_seconds": 5.26,
      "text": "Yes, I had my tonsils removed, as a teenager."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.54,
      "end_seconds": 72.33,
      "duration_seconds": 2.79,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.02,
      "end_seconds": 78.74,
      "duration_seconds": 4.72,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.81,
      "end_seconds": 81.9,
      "duration_seconds": 2.09,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.77,
      "end_seconds": 87.43,
      "duration_seconds": 3.66,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.99,
      "end_seconds": 92.1,
      "duration_seconds": 4.11,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.14,
      "end_seconds": 98.13,
      "duration_seconds": 3.99,
      "text": "Well, uh, my grandfather had a stroke."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.01,
      "end_seconds": 104.03,
      "duration_seconds": 4.02,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.45,
      "end_seconds": 107.38,
      "duration_seconds": 1.93,
      "text": "Depression, for two years."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.94,
      "end_seconds": 114.02,
      "duration_seconds": 5.08,
      "text": "Mm, okay. Okay, I can see depression in your file as well."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.43,
      "end_seconds": 129.7,
      "duration_seconds": 3.27,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.61,
      "end_seconds": 134.57,
      "duration_seconds": 2.96,
      "text": "Yes, walnuts, it gives me hives."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.62,
      "end_seconds": 139.48,
      "duration_seconds": 2.86,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.16,
      "end_seconds": 144.73,
      "duration_seconds": 3.57,
      "text": "It's mirtazapine, 15 milligrams, at night."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.66,
      "end_seconds": 156.09,
      "duration_seconds": 3.43,
      "text": "Did you get chest pain or drowsiness?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.92,
      "end_seconds": 159.06,
      "duration_seconds": 2.14,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.8,
      "end_seconds": 162.66,
      "duration_seconds": 2.86,
      "text": "Right, anything different when you pass water?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.92,
      "end_seconds": 169.31,
      "duration_seconds": 3.39,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.7,
      "end_seconds": 173.51,
      "duration_seconds": 2.81,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.03,
      "end_seconds": 175.4,
      "duration_seconds": 1.37,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.3,
      "end_seconds": 180.71,
      "duration_seconds": 3.41,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.93,
      "end_seconds": 190.33,
      "duration_seconds": 2.4,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.37,
      "end_seconds": 210.09,
      "duration_seconds": 8.72,
      "text": "Okay: respiratory rate 17, saturation 98 percent, heart rate 64, temperature is 36.7 degrees, blood pressure 112 over 76."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.52,
      "end_seconds": 214.42,
      "duration_seconds": 2.9,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.63,
      "end_seconds": 226.33,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.84,
      "end_seconds": 229.28,
      "duration_seconds": 1.44,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.74,
      "end_seconds": 247.24,
      "duration_seconds": 5.5,
      "text": "You are awake and alert, with some tenderness under the right ribs."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.58,
      "end_seconds": 250.16,
      "duration_seconds": 1.58,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.22,
      "end_seconds": 272.58,
      "duration_seconds": 17.36,
      "text": "You can relax now. Okay, so my impression is this: The most likely explanation is a significant paracetamol overdose needing urgent treatment. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.81,
      "end_seconds": 277.77,
      "duration_seconds": 3.96,
      "text": "Let me think, is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.5,
      "end_seconds": 292.9,
      "duration_seconds": 14.4,
      "text": "It's reasonable to be concerned, but right now a significant paracetamol overdose needing urgent treatment is my leading thought, not anything worse. I want liver function tests done, that's for overdose."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 294.05,
      "end_seconds": 297.89,
      "duration_seconds": 3.84,
      "text": "I can book that for Thursday at 10 am."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.13,
      "end_seconds": 322.88,
      "duration_seconds": 23.75,
      "text": "Let's book a paracetamol level to look into overdose. You'll be taking acetylcysteine, per protocol, over 21 hours, per protocol. That should help with paracetamol overdose. You need to stay in hospital for treatment, and someone will speak to you about how you are feeling. Come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.76,
      "end_seconds": 325.47,
      "duration_seconds": 1.71,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.23,
      "end_seconds": 329.68,
      "duration_seconds": 2.45,
      "text": "Let's plan a check straight away."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.26,
      "end_seconds": 337.08,
      "duration_seconds": 1.82,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.01,
      "end_seconds": 340.91,
      "duration_seconds": 2.9,
      "text": "Alright, does all of that make sense?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.86,
      "end_seconds": 346.89,
      "duration_seconds": 5.03,
      "text": "Okay, so okay, that makes sense. Thanks for explaining."
    }
  ]
}