{
  "schema_version": "1.0",
  "encounter_id": "02022",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.91,
      "end_seconds": 3.87,
      "duration_seconds": 2.96,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.16,
      "end_seconds": 9.69,
      "duration_seconds": 4.53,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.24,
      "end_seconds": 15.23,
      "duration_seconds": 3.99,
      "text": "Erm, doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.8,
      "end_seconds": 21.33,
      "duration_seconds": 4.53,
      "text": "Alright, of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.94,
      "end_seconds": 25.48,
      "duration_seconds": 3.54,
      "text": "Well, I've been having a high temperature."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.98,
      "end_seconds": 30.88,
      "duration_seconds": 3.9,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 32.66,
      "end_seconds": 37.31,
      "duration_seconds": 4.65,
      "text": "He takes Tiotropium inhaler, once a day for my chest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.53,
      "end_seconds": 41.28,
      "duration_seconds": 3.75,
      "text": "Okay, go on. Okay, did it come on recently?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.62,
      "end_seconds": 45.33,
      "duration_seconds": 2.71,
      "text": "Ever since... since Friday, really."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.22,
      "end_seconds": 49.08,
      "duration_seconds": 2.86,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.01,
      "end_seconds": 54.02,
      "duration_seconds": 4.01,
      "text": "Right, a six out of ten, I suppose."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.49,
      "end_seconds": 58.38,
      "duration_seconds": 2.89,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.32,
      "end_seconds": 80.27,
      "duration_seconds": 19.95,
      "text": "Well, when it starts I tend to get vomiting and diarrhoea as well. So, uh, I've also had agitation, for four weeks. About agitation, I'd call it moderate. As for vomiting and diarrhoea, I'd call it moderate."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.12,
      "end_seconds": 85.07,
      "duration_seconds": 3.95,
      "text": "Did you get recent infection or chest pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.95,
      "end_seconds": 90.79,
      "duration_seconds": 3.84,
      "text": "No, no recent infection or chest pain."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.42,
      "end_seconds": 96.05,
      "duration_seconds": 3.63,
      "text": "Okay, any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.34,
      "end_seconds": 99.58,
      "duration_seconds": 2.24,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.16,
      "end_seconds": 120.16,
      "duration_seconds": 3.0,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.7,
      "end_seconds": 127.24,
      "duration_seconds": 5.54,
      "text": "Sorry, um, what was I saying, I've had gout, yes."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.8,
      "end_seconds": 129.18,
      "duration_seconds": 1.38,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.81,
      "end_seconds": 136.58,
      "duration_seconds": 3.77,
      "text": "I've had COPD for about ten years now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.21,
      "end_seconds": 146.22,
      "duration_seconds": 8.01,
      "text": "Okay, I can see gout in your file as well. Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.8,
      "end_seconds": 149.3,
      "duration_seconds": 1.5,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.74,
      "end_seconds": 162.53,
      "duration_seconds": 2.79,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.2,
      "end_seconds": 169.51,
      "duration_seconds": 6.31,
      "text": "Uh, I had keyhole surgery on my gallbladder two years back."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.73,
      "end_seconds": 174.47,
      "duration_seconds": 3.74,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.36,
      "end_seconds": 177.85,
      "duration_seconds": 2.49,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.07,
      "end_seconds": 193.58,
      "duration_seconds": 3.51,
      "text": "So, now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.52,
      "end_seconds": 206.76,
      "duration_seconds": 10.24,
      "text": "Lots of rice, lentils and some fruit. My partner and our baby. I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.52,
      "end_seconds": 210.93,
      "duration_seconds": 3.41,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.08,
      "end_seconds": 223.81,
      "duration_seconds": 2.73,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.99,
      "end_seconds": 250.3,
      "duration_seconds": 6.31,
      "text": "Okay: blood pressure 111 over 79, pulse 102, temperature is 38.3 degrees."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.85,
      "end_seconds": 255.76,
      "duration_seconds": 3.91,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.8,
      "end_seconds": 258.92,
      "duration_seconds": 2.12,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.1,
      "end_seconds": 274.78,
      "duration_seconds": 6.68,
      "text": "You are hot, shaking, and your pulse is over one hundred and forty and irregular."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.18,
      "end_seconds": 296.6,
      "duration_seconds": 16.42,
      "text": "Okay, please sit back down. We should do urgent blood tests for thyroid storm. I'll request an ECG, it'll help with fast heart rhythm. Let's use propranolol, 1 milligrams, now, single dose. That should help with thyroid storm."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.67,
      "end_seconds": 299.12,
      "duration_seconds": 1.45,
      "text": "That's simple enough."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.1,
      "end_seconds": 320.62,
      "duration_seconds": 20.52,
      "text": "This is an emergency, you will be treated in high dependency. I'm going to send a referral to the emergency team. Come back or go to emergency straight away if the symptoms get worse. We'll catch up straight away. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.46,
      "end_seconds": 326.09,
      "duration_seconds": 3.63,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.77,
      "end_seconds": 329.06,
      "duration_seconds": 1.29,
      "text": "All the best."
    }
  ]
}