{
  "schema_version": "1.0",
  "encounter_id": "00766",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 0.72,
      "end_seconds": 10.22,
      "duration_seconds": 9.5,
      "text": "Morning, doctor. I'm Dad's daughter, Kate. He's here for his repeat prescription review, he says he feels well."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.31,
      "end_seconds": 19.48,
      "duration_seconds": 7.17,
      "text": "I do feel well. I don't see why we had to come. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.19,
      "end_seconds": 28.4,
      "duration_seconds": 8.21,
      "text": "It's good to hear, Mr Sutcliffe. It's a routine check, so don't worry. How's your breathing?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.82,
      "end_seconds": 34.84,
      "duration_seconds": 5.02,
      "text": "Fine. A bit puffed on the hill, that's all."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 37.82,
      "end_seconds": 42.06,
      "duration_seconds": 4.24,
      "text": "Dad, you stop three times on the hill."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.02,
      "end_seconds": 50.49,
      "duration_seconds": 6.47,
      "text": "Kate, thanks for saying so. Any swelling in your ankles, Mr Sutcliffe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.6,
      "end_seconds": 56.95,
      "duration_seconds": 5.35,
      "text": "A little at night, maybe. It goes by morning."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.05,
      "end_seconds": 61.41,
      "duration_seconds": 2.36,
      "text": "Any chest pain?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.96,
      "end_seconds": 64.87,
      "duration_seconds": 1.91,
      "text": "No. None."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.53,
      "end_seconds": 70.01,
      "duration_seconds": 2.48,
      "text": "Dizziness, or fainting?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.09,
      "end_seconds": 74.5,
      "duration_seconds": 2.41,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.85,
      "end_seconds": 80.65,
      "duration_seconds": 3.8,
      "text": "Waking at night short of breath?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.43,
      "end_seconds": 84.6,
      "duration_seconds": 3.17,
      "text": "No. I sleep like a baby."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.67,
      "end_seconds": 90.4,
      "duration_seconds": 4.73,
      "text": "What tablets are you taking at the moment?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 92.97,
      "end_seconds": 101.31,
      "duration_seconds": 8.34,
      "text": "Furosemide, 40 mg, once a day, in the morning. That's the water tablet."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.53,
      "end_seconds": 105.34,
      "duration_seconds": 1.81,
      "text": "Any allergies?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.98,
      "end_seconds": 112.52,
      "duration_seconds": 4.54,
      "text": "Codeine, it makes me sick as a dog."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.24,
      "end_seconds": 115.78,
      "duration_seconds": 1.54,
      "text": "Your conditions?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 117.35,
      "end_seconds": 123.36,
      "duration_seconds": 6.01,
      "text": "He has heart failure, diagnosed two years ago, and high blood pressure."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.12,
      "end_seconds": 129.71,
      "duration_seconds": 3.59,
      "text": "Any heart problems in the family?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.41,
      "end_seconds": 135.43,
      "duration_seconds": 5.02,
      "text": "My father died of a heart attack at sixty."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.2,
      "end_seconds": 141.45,
      "duration_seconds": 4.25,
      "text": "And who looks after you at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.91,
      "end_seconds": 148.95,
      "duration_seconds": 6.04,
      "text": "I live with Kate and her husband now, since my wife died."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.76,
      "end_seconds": 156.46,
      "duration_seconds": 5.7,
      "text": "Let me check you. Pulse, pressure, and your weight. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.45,
      "end_seconds": 160.48,
      "duration_seconds": 2.03,
      "text": "Go on. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.32,
      "end_seconds": 187.73,
      "duration_seconds": 7.41,
      "text": "Pulse 74, blood pressure 128 over 76, oxygen 96 percent, weight 82 kilos."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 190.63,
      "end_seconds": 194.29,
      "duration_seconds": 3.66,
      "text": "Is that more than last time? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.02,
      "end_seconds": 208.06,
      "duration_seconds": 13.04,
      "text": "It's up by two kilos from three months ago, which could be fluid. Let me look at your ankles and listen to your chest. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.9,
      "end_seconds": 225.93,
      "duration_seconds": 1.03,
      "text": "Fine."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.8,
      "end_seconds": 238.05,
      "duration_seconds": 11.25,
      "text": "There's mild swelling above both ankles, and your chest has a few crackles at the bottom of both lungs."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 240.86,
      "end_seconds": 243.4,
      "duration_seconds": 2.54,
      "text": "Is that bad? ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.44,
      "end_seconds": 258.69,
      "duration_seconds": 13.25,
      "text": "It's mild, but it fits with a little fluid build-up, so I'd say your heart failure is stable but slightly fluid-overloaded."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.77,
      "end_seconds": 263.49,
      "duration_seconds": 2.72,
      "text": "I feel fine. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.87,
      "end_seconds": 277.73,
      "duration_seconds": 11.86,
      "text": "Many people do, until it builds. I'd like to keep the same tablets for now, and ask you to weigh yourself every morning."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 279.94,
      "end_seconds": 283.28,
      "duration_seconds": 3.34,
      "text": "Should I write it down? ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.59,
      "end_seconds": 297.26,
      "duration_seconds": 11.67,
      "text": "Yes, same scales, same time, after the toilet. If your weight goes up by two kilos in three days, ring us."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 300.11,
      "end_seconds": 303.41,
      "duration_seconds": 3.3,
      "text": "I'll keep a chart. ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.36,
      "end_seconds": 310.46,
      "duration_seconds": 6.1,
      "text": "Cut down on salt, and don't add any at the table."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.82,
      "end_seconds": 315.95,
      "duration_seconds": 4.13,
      "text": "My wife used to say that. ~"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.35,
      "end_seconds": 327.42,
      "duration_seconds": 10.07,
      "text": "She was right. I'd like to see you again in four weeks, to check your weight and your ankles."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.09,
      "end_seconds": 333.24,
      "duration_seconds": 3.15,
      "text": "Four weeks. Fine. Thank you. ~"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 334.78,
      "end_seconds": 336.96,
      "duration_seconds": 2.18,
      "text": "Thanks, doctor. ~"
    }
  ]
}
