{
  "schema_version": "1.0",
  "encounter_id": "01608",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.75,
      "end_seconds": 4.05,
      "duration_seconds": 3.3,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.0,
      "end_seconds": 10.53,
      "duration_seconds": 4.53,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.72,
      "end_seconds": 15.84,
      "duration_seconds": 4.12,
      "text": "Um, so... a headache. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.54,
      "end_seconds": 26.29,
      "duration_seconds": 8.75,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.56,
      "end_seconds": 32.16,
      "duration_seconds": 4.6,
      "text": "Honestly, on and off. About a three out of ten."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.66,
      "end_seconds": 35.85,
      "duration_seconds": 2.19,
      "text": "Have you been feeling shaken?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.69,
      "end_seconds": 42.94,
      "duration_seconds": 6.25,
      "text": "Yes, actually. And there's shoulder tightness as well, about two weeks now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.45,
      "end_seconds": 49.8,
      "duration_seconds": 6.35,
      "text": "okay, go on. What about neck pain after a car crash, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.83,
      "end_seconds": 61.32,
      "duration_seconds": 9.49,
      "text": "Yes, for three days. About neck pain after a car crash, it settles a little with heat."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.83,
      "end_seconds": 82.42,
      "duration_seconds": 2.59,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.7,
      "end_seconds": 94.15,
      "duration_seconds": 2.45,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.7,
      "end_seconds": 120.3,
      "duration_seconds": 6.6,
      "text": "Okay: BP is 111 over 74, temp 36.8 degrees, pulse 78, saturation 97 percent."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.44,
      "end_seconds": 123.46,
      "duration_seconds": 2.02,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.13,
      "end_seconds": 126.47,
      "duration_seconds": 2.34,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.57,
      "end_seconds": 132.53,
      "duration_seconds": 3.96,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.29,
      "end_seconds": 134.95,
      "duration_seconds": 1.66,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.78,
      "end_seconds": 139.5,
      "duration_seconds": 2.72,
      "text": "Take a a deep breath for me."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.27,
      "end_seconds": 165.65,
      "duration_seconds": 7.38,
      "text": "there is muscle tenderness either side of the neck and no tenderness over the bones"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.68,
      "end_seconds": 168.42,
      "duration_seconds": 1.74,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.33,
      "end_seconds": 179.68,
      "duration_seconds": 7.35,
      "text": "Please sit back down. Any weakness, chest pain, numbness in the arms or loss of consciousness at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.15,
      "end_seconds": 184.53,
      "duration_seconds": 3.38,
      "text": "no, none of those at all"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.3,
      "end_seconds": 187.87,
      "duration_seconds": 1.57,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.62,
      "end_seconds": 189.59,
      "duration_seconds": 0.97,
      "text": "breathing's normal"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.5,
      "end_seconds": 199.22,
      "duration_seconds": 3.72,
      "text": "on the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.14,
      "end_seconds": 203.54,
      "duration_seconds": 2.4,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.88,
      "end_seconds": 211.16,
      "duration_seconds": 3.28,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.11,
      "end_seconds": 215.85,
      "duration_seconds": 2.74,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.53,
      "end_seconds": 218.47,
      "duration_seconds": 1.94,
      "text": "do you get out much?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.16,
      "end_seconds": 223.51,
      "duration_seconds": 4.35,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.18,
      "end_seconds": 225.39,
      "duration_seconds": 1.21,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.1,
      "end_seconds": 233.52,
      "duration_seconds": 4.42,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.99,
      "end_seconds": 248.36,
      "duration_seconds": 1.37,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.85,
      "end_seconds": 251.51,
      "duration_seconds": 1.66,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.84,
      "end_seconds": 258.42,
      "duration_seconds": 5.58,
      "text": "What about your medical history? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.01,
      "end_seconds": 261.62,
      "duration_seconds": 1.61,
      "text": "I have migraines"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.04,
      "end_seconds": 264.39,
      "duration_seconds": 1.35,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.8,
      "end_seconds": 277.6,
      "duration_seconds": 11.8,
      "text": "I've had low haemoglobin for about a year now. I've had diabetes for about a year now. Yes, high blood pressure"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.51,
      "end_seconds": 287.21,
      "duration_seconds": 8.7,
      "text": "Okay, go on. Alright, low haemoglobin, that matches what I have here. Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.29,
      "end_seconds": 302.02,
      "duration_seconds": 13.73,
      "text": "I'm on iron tablets, once a day. I take sitagliptin, 100 milligrams, once a day. It's amlodipine, 5 milligrams, maybe, once a day for my pressure."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.49,
      "end_seconds": 307.18,
      "duration_seconds": 3.69,
      "text": "Is the the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.88,
      "end_seconds": 315.86,
      "duration_seconds": 6.98,
      "text": "No, it's at home. I'd been on hydrochlorothiazide, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.2,
      "end_seconds": 327.21,
      "duration_seconds": 8.01,
      "text": "Let me just check I've got this right. You've had a headache, and no weakness or numbness in the arms."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.87,
      "end_seconds": 329.57,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.54,
      "end_seconds": 363.91,
      "duration_seconds": 26.37,
      "text": "I'll start you on naproxen, 500 milligrams, twice a day with food, one week. You take it by mouth. That should help with neck pain. Keep your neck moving gently and avoid a collar. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 367.95,
      "end_seconds": 372.37,
      "duration_seconds": 4.42,
      "text": "okay, uh, I'll look out for that"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.65,
      "end_seconds": 380.77,
      "duration_seconds": 7.12,
      "text": "Book a review if not better in two weeks. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 381.33,
      "end_seconds": 383.37,
      "duration_seconds": 2.04,
      "text": "thank you, doctor, goodbye"
    }
  ]
}