{
  "schema_version": "1.0",
  "encounter_id": "02422",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.15,
      "end_seconds": 2.86,
      "duration_seconds": 1.71,
      "text": "Morning, come on through."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.62,
      "end_seconds": 7.63,
      "duration_seconds": 4.01,
      "text": "afternoon, um, is this seat fine?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 9.29,
      "end_seconds": 15.5,
      "duration_seconds": 6.21,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.8,
      "end_seconds": 23.3,
      "duration_seconds": 6.5,
      "text": "That's fine, sit down. We'll go through it together. How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 24.64,
      "end_seconds": 32.39,
      "duration_seconds": 7.75,
      "text": "Right, doctor, it's spots on my forehead and chin. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.94,
      "end_seconds": 36.18,
      "duration_seconds": 3.24,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.17,
      "end_seconds": 41.12,
      "duration_seconds": 2.95,
      "text": "I've had it since Friday."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.55,
      "end_seconds": 47.76,
      "duration_seconds": 3.21,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.65,
      "end_seconds": 52.0,
      "duration_seconds": 2.35,
      "text": "I'd call it severe."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.42,
      "end_seconds": 56.12,
      "duration_seconds": 3.7,
      "text": "I follow. Is there anything else with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.05,
      "end_seconds": 62.55,
      "duration_seconds": 5.5,
      "text": "A few blackheads goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 63.27,
      "end_seconds": 69.64,
      "duration_seconds": 6.37,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 69.74,
      "end_seconds": 76.14,
      "duration_seconds": 6.4,
      "text": "sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.89,
      "end_seconds": 80.16,
      "duration_seconds": 2.27,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.04,
      "end_seconds": 87.62,
      "duration_seconds": 5.58,
      "text": "Okay, so the few blackheads? That's been for two weeks."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.68,
      "end_seconds": 91.45,
      "duration_seconds": 1.77,
      "text": "nothing like painful cysts?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 93.07,
      "end_seconds": 96.82,
      "duration_seconds": 3.75,
      "text": "No, I haven't had any painful cysts."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.41,
      "end_seconds": 102.71,
      "duration_seconds": 4.3,
      "text": "Did you get irregular periods, scarring or low mood?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 104.27,
      "end_seconds": 117.87,
      "duration_seconds": 13.6,
      "text": "Oh, no, no irregular periods, no scarring, no low mood. I did have oily skin at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.95,
      "end_seconds": 124.43,
      "duration_seconds": 5.48,
      "text": "Right, any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.24,
      "end_seconds": 128.44,
      "duration_seconds": 3.2,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.4,
      "end_seconds": 132.01,
      "duration_seconds": 2.61,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 133.84,
      "end_seconds": 136.23,
      "duration_seconds": 2.39,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.76,
      "end_seconds": 140.33,
      "duration_seconds": 3.57,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 141.55,
      "end_seconds": 147.87,
      "duration_seconds": 6.32,
      "text": "My uncle has high cholesterol. My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.27,
      "end_seconds": 152.89,
      "duration_seconds": 3.62,
      "text": "anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 153.53,
      "end_seconds": 157.65,
      "duration_seconds": 4.12,
      "text": "I have asthma. Thin bones, for two years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.92,
      "end_seconds": 161.27,
      "duration_seconds": 2.35,
      "text": "Right, is that that everything?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.97,
      "end_seconds": 165.37,
      "duration_seconds": 3.4,
      "text": "High blood pressure, for two years."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.22,
      "end_seconds": 168.47,
      "duration_seconds": 1.25,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.7,
      "end_seconds": 173.85,
      "duration_seconds": 4.15,
      "text": "well, uh, no, not at all"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.52,
      "end_seconds": 179.57,
      "duration_seconds": 5.05,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 180.25,
      "end_seconds": 190.36,
      "duration_seconds": 10.11,
      "text": "well, I take Foracort inhaler, twice a day. It's, It's alendronate, 70 milligrams, once a week for my bones"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 192.04,
      "end_seconds": 196.75,
      "duration_seconds": 4.71,
      "text": "doctor, our chart from the last visit lists it as 35 milligrams"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.59,
      "end_seconds": 202.79,
      "duration_seconds": 5.2,
      "text": "Okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 203.98,
      "end_seconds": 220.95,
      "duration_seconds": 16.97,
      "text": "Not with me. I'll bring it next time. I'm, I'm on telmisartan, 40 milligrams, once a day for my pressure. So, I'm on a face wash, twice a day."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.8,
      "end_seconds": 236.51,
      "duration_seconds": 2.71,
      "text": "Right, do you live by yourself?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 237.2,
      "end_seconds": 242.16,
      "duration_seconds": 4.96,
      "text": "No, I share a house with my brother"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.16,
      "end_seconds": 246.36,
      "duration_seconds": 2.2,
      "text": "Okay, how active are you?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 247.1,
      "end_seconds": 251.2,
      "duration_seconds": 4.1,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.17,
      "end_seconds": 256.98,
      "duration_seconds": 4.81,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 258.03,
      "end_seconds": 268.14,
      "duration_seconds": 10.11,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 269.09,
      "end_seconds": 277.35,
      "duration_seconds": 8.26,
      "text": "Doctor, I've got the readings for you. Pressure 123 over 79, temperature 36.5, saturation 98 percent, heart rate 85."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.39,
      "end_seconds": 280.38,
      "duration_seconds": 1.99,
      "text": "So, good, thank you."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.46,
      "end_seconds": 286.05,
      "duration_seconds": 4.59,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 286.65,
      "end_seconds": 287.68,
      "duration_seconds": 1.03,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 289.14,
      "end_seconds": 290.4,
      "duration_seconds": 1.26,
      "text": "does that hurt?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.08,
      "end_seconds": 307.66,
      "duration_seconds": 5.58,
      "text": "There are small blackheads and a few red spots with no deep cysts."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.92,
      "end_seconds": 312.41,
      "duration_seconds": 2.49,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 324.24,
      "end_seconds": 359.46,
      "duration_seconds": 35.22,
      "text": "right, here's what I'm thinking this looks most like mild acne what I'm giving you is benzoyl peroxide gel, 5%, once a day, eight weeks that's for acne wash gently twice a day and don't squeeze the spots and please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose one warning sign to remember: the symptoms get worse in that case don't wait"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 361.3,
      "end_seconds": 362.4,
      "duration_seconds": 1.1,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 363.94,
      "end_seconds": 367.29,
      "duration_seconds": 3.35,
      "text": "I'd like you back in eight weeks."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 369.34,
      "end_seconds": 374.76,
      "duration_seconds": 5.42,
      "text": "I'll book your follow-up at the the front desk on your way out."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 375.64,
      "end_seconds": 379.56,
      "duration_seconds": 3.92,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 381.27,
      "end_seconds": 385.76,
      "duration_seconds": 4.49,
      "text": "Hmm, okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 387.1,
      "end_seconds": 388.41,
      "duration_seconds": 1.31,
      "text": "See you soon."
    }
  ]
}