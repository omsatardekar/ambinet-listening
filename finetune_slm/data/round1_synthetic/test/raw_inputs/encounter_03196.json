{
  "schema_version": "1.0",
  "encounter_id": "03196",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.77,
      "end_seconds": 5.73,
      "duration_seconds": 4.96,
      "text": "Hello, take a a seat, I'll be with you in a second."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.77,
      "end_seconds": 10.87,
      "duration_seconds": 3.1,
      "text": "Morning, doctor, sorry about the rush."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.79,
      "end_seconds": 14.35,
      "duration_seconds": 2.56,
      "text": "tell me what's brought you in"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.6,
      "end_seconds": 23.13,
      "duration_seconds": 7.53,
      "text": "I'm here because of a yellow discharge sorry, I know I'm rambling a bit"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.66,
      "end_seconds": 31.28,
      "duration_seconds": 3.62,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.04,
      "end_seconds": 35.88,
      "duration_seconds": 2.84,
      "text": "For three weeks, I'd say."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.9,
      "end_seconds": 40.45,
      "duration_seconds": 3.55,
      "text": "So, have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.17,
      "end_seconds": 58.7,
      "duration_seconds": 16.53,
      "text": "it usually comes with a temperature. Oh, and a red sore wound after my operation. That's been about the same, about two weeks. The temperature? That's been for about four days"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.13,
      "end_seconds": 66.08,
      "duration_seconds": 5.95,
      "text": "have you had a yellow discharge before, or is this the first time?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 67.46,
      "end_seconds": 73.16,
      "duration_seconds": 5.7,
      "text": "A bit, about six months ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.25,
      "end_seconds": 81.39,
      "duration_seconds": 7.14,
      "text": "Let me check a few things. Any chest pain, breathlessness, calf pain or vomiting?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.09,
      "end_seconds": 84.41,
      "duration_seconds": 2.32,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.94,
      "end_seconds": 89.29,
      "duration_seconds": 3.35,
      "text": "has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 93.61,
      "end_seconds": 94.99,
      "duration_seconds": 1.38,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.36,
      "end_seconds": 98.7,
      "duration_seconds": 2.34,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.3,
      "end_seconds": 104.93,
      "duration_seconds": 1.63,
      "text": "no changes there"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.26,
      "end_seconds": 113.15,
      "duration_seconds": 3.89,
      "text": "tell me about any past illnesses or ongoing conditions"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.15,
      "end_seconds": 131.87,
      "duration_seconds": 14.72,
      "text": "I have diabetes, for about ten years. I, I have high cholesterol, for about ten years. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.08,
      "end_seconds": 141.61,
      "duration_seconds": 8.53,
      "text": "alright, diabetes and high cholesterol, that matches what I have here what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.6,
      "end_seconds": 146.11,
      "duration_seconds": 2.51,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.06,
      "end_seconds": 157.87,
      "duration_seconds": 2.81,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.55,
      "end_seconds": 163.84,
      "duration_seconds": 5.29,
      "text": "I take metformin, 500 milligrams, twice a day for my sugar."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 164.76,
      "end_seconds": 170.19,
      "duration_seconds": 5.43,
      "text": "Doctor, our chart from the last visit lists it as 1000 milligrams."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.15,
      "end_seconds": 176.34,
      "duration_seconds": 4.19,
      "text": "Right. Do you happen to have the current prescription here?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 177.93,
      "end_seconds": 184.52,
      "duration_seconds": 6.59,
      "text": "no, I left it at home i take rosuvastatin, 10 milligrams, at night"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.2,
      "end_seconds": 188.22,
      "duration_seconds": 3.02,
      "text": "Since when have you been taking it?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 189.88,
      "end_seconds": 192.0,
      "duration_seconds": 2.12,
      "text": "For about a year."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.85,
      "end_seconds": 194.77,
      "duration_seconds": 0.92,
      "text": "any smoking?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 195.85,
      "end_seconds": 199.79,
      "duration_seconds": 3.94,
      "text": "I have about eight cigarettes in a day"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.72,
      "end_seconds": 205.85,
      "duration_seconds": 2.13,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 206.88,
      "end_seconds": 210.65,
      "duration_seconds": 3.77,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.87,
      "end_seconds": 213.95,
      "duration_seconds": 2.08,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 214.62,
      "end_seconds": 218.65,
      "duration_seconds": 4.03,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.34,
      "end_seconds": 223.03,
      "duration_seconds": 3.69,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 223.84,
      "end_seconds": 227.54,
      "duration_seconds": 3.7,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.53,
      "end_seconds": 243.33,
      "duration_seconds": 2.8,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 244.2,
      "end_seconds": 250.64,
      "duration_seconds": 6.44,
      "text": "Yes, I had a meniscus repair on my knee, four years ago."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.44,
      "end_seconds": 256.87,
      "duration_seconds": 4.43,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 257.94,
      "end_seconds": 264.47,
      "duration_seconds": 6.53,
      "text": "yes, cat fur. I get wheezing. I'm allergic to wheat, I get bloating"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 266.13,
      "end_seconds": 273.17,
      "duration_seconds": 7.04,
      "text": "Okay, so the vitals from earlier. Respiratory rate 21, pulse 104, blood pressure 123 over 69."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.07,
      "end_seconds": 275.17,
      "duration_seconds": 1.1,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 276.99,
      "end_seconds": 279.07,
      "duration_seconds": 2.08,
      "text": "may I examine you now?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 280.27,
      "end_seconds": 281.62,
      "duration_seconds": 1.35,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.52,
      "end_seconds": 284.73,
      "duration_seconds": 1.21,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.12,
      "end_seconds": 309.38,
      "duration_seconds": 8.26,
      "text": "the lower part of the wound is red, hot and weeping pus, and the edges have not come together"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 314.56,
      "end_seconds": 326.28,
      "duration_seconds": 11.72,
      "text": "That's the examination finished. So, based on the history and the examination, I can't pin this down yet. We're looking at a surgical wound infection or a stitch abscess."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 335.53,
      "end_seconds": 345.63,
      "duration_seconds": 10.1,
      "text": "I think blood tests makes sense here, for wound infection. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 347.29,
      "end_seconds": 350.55,
      "duration_seconds": 3.26,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 351.97,
      "end_seconds": 356.51,
      "duration_seconds": 4.54,
      "text": "I think a wound swab makes sense here, for wound infection."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 357.81,
      "end_seconds": 358.94,
      "duration_seconds": 1.13,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 360.46,
      "end_seconds": 369.65,
      "duration_seconds": 9.19,
      "text": "We'll begin with flucloxacillin, 500 milligrams, four times a day, seven days. That should help with wound infection."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 370.49,
      "end_seconds": 372.64,
      "duration_seconds": 2.15,
      "text": "Fine, I'll begin it."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 373.15,
      "end_seconds": 391.62,
      "duration_seconds": 18.47,
      "text": "keep it clean and dry and use fresh dressings daily don't skip meals, and try to eat smaller portions more often through the day and please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 392.47,
      "end_seconds": 393.84,
      "duration_seconds": 1.37,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 395.79,
      "end_seconds": 398.37,
      "duration_seconds": 2.58,
      "text": "See me again in two days."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 402.78,
      "end_seconds": 404.71,
      "duration_seconds": 1.93,
      "text": "that's fine with me"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 405.71,
      "end_seconds": 408.97,
      "duration_seconds": 3.26,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 410.31,
      "end_seconds": 413.36,
      "duration_seconds": 3.05,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 415.13,
      "end_seconds": 417.02,
      "duration_seconds": 1.89,
      "text": "Okay, all the best."
    }
  ]
}