{
  "schema_version": "1.0",
  "encounter_id": "03668",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.37,
      "end_seconds": 8.86,
      "duration_seconds": 7.49,
      "text": "Okay, doctor, we're all set in here. I'll give you the numbers when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.33,
      "end_seconds": 14.33,
      "duration_seconds": 4.0,
      "text": "Thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 15.64,
      "end_seconds": 21.63,
      "duration_seconds": 5.99,
      "text": "I wanted to get an ache in my jaw looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.96,
      "end_seconds": 25.71,
      "duration_seconds": 2.75,
      "text": "how long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 27.15,
      "end_seconds": 38.22,
      "duration_seconds": 11.07,
      "text": "About... well, about a week. I took the morning off to come in today. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.41,
      "end_seconds": 52.03,
      "duration_seconds": 9.62,
      "text": "tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 57.27,
      "end_seconds": 61.28,
      "duration_seconds": 4.01,
      "text": "Mild, I'd say. I'd say all the time."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.04,
      "end_seconds": 64.49,
      "duration_seconds": 2.45,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 66.04,
      "end_seconds": 69.27,
      "duration_seconds": 3.23,
      "text": "It It usually comes with indigestion."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.34,
      "end_seconds": 82.23,
      "duration_seconds": 0.89,
      "text": "Any cough?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 82.94,
      "end_seconds": 84.29,
      "duration_seconds": 1.35,
      "text": "Definitely no cough."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.73,
      "end_seconds": 89.19,
      "duration_seconds": 3.46,
      "text": "Have you noticed leg swelling or fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 89.7,
      "end_seconds": 94.38,
      "duration_seconds": 4.68,
      "text": "sorry, what was I saying, nope, nothing like that"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.46,
      "end_seconds": 97.93,
      "duration_seconds": 2.47,
      "text": "anything different when you pass water?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 98.5,
      "end_seconds": 100.15,
      "duration_seconds": 1.65,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.3,
      "end_seconds": 102.64,
      "duration_seconds": 1.34,
      "text": "neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 103.73,
      "end_seconds": 107.02,
      "duration_seconds": 3.29,
      "text": "No, uh, nothing like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.27,
      "end_seconds": 112.67,
      "duration_seconds": 4.4,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 113.27,
      "end_seconds": 117.16,
      "duration_seconds": 3.89,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.78,
      "end_seconds": 120.52,
      "duration_seconds": 2.74,
      "text": "have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 125.86,
      "end_seconds": 127.0,
      "duration_seconds": 1.14,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.3,
      "end_seconds": 140.6,
      "duration_seconds": 6.3,
      "text": "Okay, tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 142.58,
      "end_seconds": 156.09,
      "duration_seconds": 13.51,
      "text": "I gave up cigarettes last spring. My husband and I live above the shop. I'm vegetarian and have been for years. Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.74,
      "end_seconds": 161.95,
      "duration_seconds": 4.21,
      "text": "Okay, any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 163.83,
      "end_seconds": 167.67,
      "duration_seconds": 3.84,
      "text": "Well, no, nothing I can think of."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.67,
      "end_seconds": 184.72,
      "duration_seconds": 3.05,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 185.32,
      "end_seconds": 186.8,
      "duration_seconds": 1.48,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 188.63,
      "end_seconds": 197.31,
      "duration_seconds": 8.68,
      "text": "Doctor, I've got the readings for you. BP is 125 over 82, saturation 98 percent, pulse is 110 beats a minute."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.38,
      "end_seconds": 200.36,
      "duration_seconds": 0.98,
      "text": "Right, thanks."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.79,
      "end_seconds": 205.92,
      "duration_seconds": 4.13,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.31,
      "end_seconds": 209.31,
      "duration_seconds": 2.0,
      "text": "tell me if that's sore"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.8,
      "end_seconds": 225.16,
      "duration_seconds": 7.36,
      "text": "your heart sounds are normal and your tummy is soft, but your pulse is a little fast"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.44,
      "end_seconds": 230.01,
      "duration_seconds": 2.57,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.88,
      "end_seconds": 270.8,
      "duration_seconds": 26.92,
      "text": "So where does that leave us? This looks most like possible heart attack despite no classic chest pain. We should do a troponin test for possible heart attack. I'd like you to take aspirin, 300 milligrams, once now, single dose. You take it by mouth. It's for possible heart attack. Diabetes can hide the usual pain, so I am treating this as a heart problem until proven otherwise."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.51,
      "end_seconds": 285.71,
      "duration_seconds": 13.2,
      "text": "I'm not ordering an ECG today. If things carry on in two weeks, we'll consider it. One warning sign to remember: the symptoms get worse. In that case don't wait."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 286.9,
      "end_seconds": 288.52,
      "duration_seconds": 1.62,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.63,
      "end_seconds": 291.73,
      "duration_seconds": 2.1,
      "text": "see me again straight away"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 294.05,
      "end_seconds": 296.4,
      "duration_seconds": 2.35,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.69,
      "end_seconds": 300.31,
      "duration_seconds": 2.62,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 301.64,
      "end_seconds": 305.69,
      "duration_seconds": 4.05,
      "text": "Great, um, thank you for your help."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.32,
      "end_seconds": 307.64,
      "duration_seconds": 1.32,
      "text": "Look after yourself."
    }
  ]
}