{
  "schema_version": "1.0",
  "encounter_id": "03210",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.96,
      "end_seconds": 7.18,
      "duration_seconds": 6.22,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.63,
      "end_seconds": 12.83,
      "duration_seconds": 4.2,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.07,
      "end_seconds": 19.26,
      "duration_seconds": 5.19,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.79,
      "end_seconds": 23.86,
      "duration_seconds": 4.07,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.82,
      "end_seconds": 35.77,
      "duration_seconds": 10.95,
      "text": "Let me think, it's a red sore wound after my operation. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.26,
      "end_seconds": 40.7,
      "duration_seconds": 3.44,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.44,
      "end_seconds": 46.56,
      "duration_seconds": 4.12,
      "text": "It's been going on for about three months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.77,
      "end_seconds": 51.06,
      "duration_seconds": 4.29,
      "text": "Mm-hmm. So, does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.93,
      "end_seconds": 81.06,
      "duration_seconds": 28.13,
      "text": "Pain around the wound goes along with it, most of the time. About pain around the wound, maybe a three out of ten on a bad day. And there's a temperature as well, three days now. With temperature, a three out of ten, I suppose. I've also had a yellow discharge, for five days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.61,
      "end_seconds": 90.2,
      "duration_seconds": 7.59,
      "text": "Have you had a red sore wound after your operation before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.35,
      "end_seconds": 98.81,
      "duration_seconds": 7.46,
      "text": "A bit, a couple of years ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.05,
      "end_seconds": 102.16,
      "duration_seconds": 2.11,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.85,
      "end_seconds": 114.08,
      "duration_seconds": 11.23,
      "text": "Aspirin. I take it 75 milligrams, once a day. I'm on something called febu... febuxostat, 80 milligrams, maybe, once a day for the gout."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.45,
      "end_seconds": 119.69,
      "duration_seconds": 4.24,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.22,
      "end_seconds": 125.87,
      "duration_seconds": 4.65,
      "text": "Actually, not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.46,
      "end_seconds": 139.03,
      "duration_seconds": 3.57,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.11,
      "end_seconds": 150.86,
      "duration_seconds": 10.75,
      "text": "Yes, grass pollen. I get sneezing. I was told I'm allergic to walnuts, but I don't remember what reaction I had."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.86,
      "end_seconds": 154.73,
      "duration_seconds": 2.87,
      "text": "Alright, any surgery in the past?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.57,
      "end_seconds": 161.96,
      "duration_seconds": 5.39,
      "text": "Uh, yes, I had a triple bypass, eight years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.42,
      "end_seconds": 179.58,
      "duration_seconds": 4.16,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.52,
      "end_seconds": 187.18,
      "duration_seconds": 5.66,
      "text": "My brother has epilepsy. Well, my grandfather had a stroke."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.39,
      "end_seconds": 190.33,
      "duration_seconds": 1.94,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.91,
      "end_seconds": 197.04,
      "duration_seconds": 5.13,
      "text": "Yes, heart disease. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.0,
      "end_seconds": 199.96,
      "duration_seconds": 0.96,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.47,
      "end_seconds": 202.81,
      "duration_seconds": 1.34,
      "text": "I have gout."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.62,
      "end_seconds": 209.85,
      "duration_seconds": 5.23,
      "text": "Alright, gout, that matches what I have here. What's your work?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.57,
      "end_seconds": 215.86,
      "duration_seconds": 4.29,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.17,
      "end_seconds": 219.73,
      "duration_seconds": 2.56,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.55,
      "end_seconds": 224.8,
      "duration_seconds": 3.25,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.46,
      "end_seconds": 229.48,
      "duration_seconds": 3.02,
      "text": "And calf pain, any of that?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.83,
      "end_seconds": 233.18,
      "duration_seconds": 2.35,
      "text": "No calf pain, thankfully."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.04,
      "end_seconds": 239.53,
      "duration_seconds": 4.49,
      "text": "Have you had any vomiting, breathlessness or chest pain?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.12,
      "end_seconds": 245.46,
      "duration_seconds": 5.34,
      "text": "I haven't had vomiting, breathlessness or chest pain, no."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.97,
      "end_seconds": 249.71,
      "duration_seconds": 3.74,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.93,
      "end_seconds": 253.02,
      "duration_seconds": 2.09,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 268.51,
      "end_seconds": 276.8,
      "duration_seconds": 8.29,
      "text": "Okay, so the vitals from earlier. Pulse is 89 beats a minute, pressure 116 over 78, temperature is 39.3 degrees."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.14,
      "end_seconds": 279.05,
      "duration_seconds": 0.91,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.75,
      "end_seconds": 286.77,
      "duration_seconds": 5.02,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.25,
      "end_seconds": 290.25,
      "duration_seconds": 2.0,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.99,
      "end_seconds": 310.21,
      "duration_seconds": 8.22,
      "text": "The lower part of the wound is red, hot and weeping pus, and the edges have not come together."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.33,
      "end_seconds": 331.35,
      "duration_seconds": 18.02,
      "text": "That's all I needed to check. Let me tell you where I've got to. The most likely explanation is a surgical wound infection. Another possibility is a stitch abscess. I'd like to arrange blood tests for wound infection."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.95,
      "end_seconds": 336.62,
      "duration_seconds": 1.67,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.17,
      "end_seconds": 354.94,
      "duration_seconds": 17.77,
      "text": "A wound swab is what I'd like next, for wound infection. I'll start you on flucloxacillin, 500 milligrams, four times a day, seven days. That's for wound infection. Keep it clean and dry and use fresh dressings daily."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.48,
      "end_seconds": 372.65,
      "duration_seconds": 17.17,
      "text": "Mm-hmm. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Do get help quickly if the symptoms get worse. I'd like to see you again in two days."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 374.67,
      "end_seconds": 378.08,
      "duration_seconds": 3.41,
      "text": "Alright, uh, I'll be back."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.99,
      "end_seconds": 383.92,
      "duration_seconds": 2.93,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 385.53,
      "end_seconds": 387.85,
      "duration_seconds": 2.32,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 389.92,
      "end_seconds": 391.35,
      "duration_seconds": 1.43,
      "text": "Look after yourself."
    }
  ]
}