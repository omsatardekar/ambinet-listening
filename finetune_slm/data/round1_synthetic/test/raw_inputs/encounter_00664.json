{
  "schema_version": "1.0",
  "encounter_id": "00664",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.3,
      "end_seconds": 15.05,
      "duration_seconds": 13.75,
      "text": "Right, I've got my notes. My hands have been swelling for two weeks and my rings won't come off, and I'm twenty-eight weeks, so I wanted it looked at."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.81,
      "end_seconds": 23.85,
      "duration_seconds": 6.04,
      "text": "Good call. Tell me about the swelling, is it both hands?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.8,
      "end_seconds": 35.25,
      "duration_seconds": 10.45,
      "text": "Both, worse in the morning. I also get puffy ankles by the evening, that's been about a week."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.55,
      "end_seconds": 38.68,
      "duration_seconds": 2.13,
      "text": "What about headaches?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.37,
      "end_seconds": 50.78,
      "duration_seconds": 10.41,
      "text": "Most afternoons, a band across the front. I wrote them down, five days out of the last seven."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.53,
      "end_seconds": 54.55,
      "duration_seconds": 3.02,
      "text": "Anything else bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.78,
      "end_seconds": 65.79,
      "duration_seconds": 9.01,
      "text": "Heartburn, mainly at night, and a bit of backache. Nothing unusual for this stage, I'd have thought."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.22,
      "end_seconds": 70.45,
      "duration_seconds": 3.23,
      "text": "Any blurred vision or flashing lights?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.67,
      "end_seconds": 74.93,
      "duration_seconds": 3.26,
      "text": "No, my vision's been normal."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.76,
      "end_seconds": 80.74,
      "duration_seconds": 3.98,
      "text": "Pain under the ribs on the right?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.88,
      "end_seconds": 85.19,
      "duration_seconds": 2.31,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.76,
      "end_seconds": 89.65,
      "duration_seconds": 1.89,
      "text": "Any bleeding?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.98,
      "end_seconds": 94.79,
      "duration_seconds": 2.81,
      "text": "No bleeding at all."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.58,
      "end_seconds": 98.63,
      "duration_seconds": 3.05,
      "text": "And any fluid leaking?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.62,
      "end_seconds": 103.45,
      "duration_seconds": 1.83,
      "text": "No, nothing's leaked."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.84,
      "end_seconds": 108.7,
      "duration_seconds": 2.86,
      "text": "What tablets are you taking?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.3,
      "end_seconds": 132.11,
      "duration_seconds": 20.81,
      "text": "Ferrous sulfate, 200 mg, once a day. A low-dose aspirin, maybe 75 mg? I'd need to check. And a little orange capsule, I can't remember what it's called, my midwife said it's for my bones."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.1,
      "end_seconds": 141.29,
      "duration_seconds": 6.19,
      "text": "Okay. We'll note the orange capsule as you describe it. Any allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.53,
      "end_seconds": 149.48,
      "duration_seconds": 5.95,
      "text": "Latex. I get an itchy rash from the gloves."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.21,
      "end_seconds": 157.25,
      "duration_seconds": 5.04,
      "text": "Thanks, I'll tell the team. Any medical conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.28,
      "end_seconds": 166.14,
      "duration_seconds": 7.86,
      "text": "Asthma, since I was a teenager. And migraines, but those have been quiet."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.05,
      "end_seconds": 170.94,
      "duration_seconds": 1.89,
      "text": "Previous operations?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.07,
      "end_seconds": 178.52,
      "duration_seconds": 5.45,
      "text": "A caesarean, three years ago, with my first."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.37,
      "end_seconds": 184.38,
      "duration_seconds": 4.01,
      "text": "Any pregnancy problems in your family?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.31,
      "end_seconds": 192.3,
      "duration_seconds": 6.99,
      "text": "My mum had pre-eclampsia with me. That's what's worrying me, honestly."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.53,
      "end_seconds": 197.61,
      "duration_seconds": 4.08,
      "text": "That's useful. What do you do for work?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.9,
      "end_seconds": 206.67,
      "duration_seconds": 6.77,
      "text": "I'm a primary school teacher. On my feet most of the day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.81,
      "end_seconds": 210.71,
      "duration_seconds": 1.9,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.95,
      "end_seconds": 215.11,
      "duration_seconds": 2.16,
      "text": "I've never smoked."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.03,
      "end_seconds": 218.57,
      "duration_seconds": 1.54,
      "text": "And alcohol?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.72,
      "end_seconds": 226.33,
      "duration_seconds": 5.61,
      "text": "I haven't had a drink since I found out."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.85,
      "end_seconds": 230.97,
      "duration_seconds": 3.12,
      "text": "Can I take your numbers?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 243.24,
      "end_seconds": 253.6,
      "duration_seconds": 10.36,
      "text": "Sorry to interrupt, doctor, I've got the blood pressure cuff ready. Pop it on the left arm, Priya."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.66,
      "end_seconds": 282.06,
      "duration_seconds": 12.4,
      "text": "Thanks. Your blood pressure is 138 over 88, pulse 84, temperature 36.7, oxygen 98 percent, breathing 18, weight 71 kilos."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.45,
      "end_seconds": 287.08,
      "duration_seconds": 2.63,
      "text": "Is the pressure high? ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.38,
      "end_seconds": 308.25,
      "duration_seconds": 11.87,
      "text": "It's a little up for you, so I want to be careful. Let me look at your hands. They're puffy, pitting at the fingers."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.49,
      "end_seconds": 314.17,
      "duration_seconds": 4.68,
      "text": "That's what the rings are doing. ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.81,
      "end_seconds": 320.83,
      "duration_seconds": 4.02,
      "text": "And the ankles look swollen on both sides."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.13,
      "end_seconds": 327.85,
      "duration_seconds": 4.72,
      "text": "Yes, they get worse by evening. ~"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.69,
      "end_seconds": 333.86,
      "duration_seconds": 4.17,
      "text": "Any trouble with your breathing at the moment?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.22,
      "end_seconds": 339.34,
      "duration_seconds": 4.12,
      "text": "No, it's fine, even with the asthma."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.53,
      "end_seconds": 347.08,
      "duration_seconds": 6.55,
      "text": "This could be early pre-eclampsia, but I wouldn't want to call it yet."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.29,
      "end_seconds": 353.53,
      "duration_seconds": 4.24,
      "text": "What do I do about that? ~"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.54,
      "end_seconds": 363.38,
      "duration_seconds": 7.84,
      "text": "I'd like to test your urine for protein, and arrange blood tests including liver function and platelets."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 365.62,
      "end_seconds": 374.22,
      "duration_seconds": 8.6,
      "text": "I can take the urine sample now if you like. The toilet's just down the hall. ~"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 376.71,
      "end_seconds": 378.67,
      "duration_seconds": 1.96,
      "text": "Sure, thanks. ~"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.99,
      "end_seconds": 386.46,
      "duration_seconds": 5.47,
      "text": "And I'd like an ultrasound scan of the baby's growth."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 388.75,
      "end_seconds": 392.14,
      "duration_seconds": 3.39,
      "text": "When would the scan be? ~"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 394.36,
      "end_seconds": 399.72,
      "duration_seconds": 5.36,
      "text": "Within the next few days. Reception will phone you. ~"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 400.5,
      "end_seconds": 405.01,
      "duration_seconds": 4.51,
      "text": "We'll book it before you leave. ~"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 406.61,
      "end_seconds": 416.25,
      "duration_seconds": 9.64,
      "text": "I'd like to see you again in a week, sooner if you get a bad headache or your vision changes."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 417.45,
      "end_seconds": 421.86,
      "duration_seconds": 4.41,
      "text": "A week. Okay, I'll be here. ~"
    }
  ]
}
