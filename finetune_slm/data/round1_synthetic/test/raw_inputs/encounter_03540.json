{
  "schema_version": "1.0",
  "encounter_id": "03540",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.61,
      "end_seconds": 5.56,
      "duration_seconds": 4.95,
      "text": "Hello, take a seat, I'll be with you in a second."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.0,
      "end_seconds": 10.91,
      "duration_seconds": 3.91,
      "text": "morning, doctor, sorry about the the rush"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.92,
      "end_seconds": 14.85,
      "duration_seconds": 1.93,
      "text": "what's been worrying you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.81,
      "end_seconds": 24.32,
      "duration_seconds": 4.51,
      "text": "I've been dealing with periods stopped for four months"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.6,
      "end_seconds": 29.39,
      "duration_seconds": 3.79,
      "text": "How many days or weeks has it it been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.15,
      "end_seconds": 39.38,
      "duration_seconds": 8.23,
      "text": "About... well, about four days. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.66,
      "end_seconds": 40.64,
      "duration_seconds": 0.98,
      "text": "mm, okay"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 41.74,
      "end_seconds": 43.63,
      "duration_seconds": 1.89,
      "text": "I've also had headaches"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.78,
      "end_seconds": 51.89,
      "duration_seconds": 4.11,
      "text": "Right, is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 52.65,
      "end_seconds": 55.49,
      "duration_seconds": 2.84,
      "text": "It, It feels severe to me."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 56.52,
      "end_seconds": 59.39,
      "duration_seconds": 2.87,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 61.27,
      "end_seconds": 63.31,
      "duration_seconds": 2.04,
      "text": "honestly, every other day"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.39,
      "end_seconds": 69.44,
      "duration_seconds": 5.05,
      "text": "What about a milky discharge from your breasts, have you noticed that?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.91,
      "end_seconds": 78.27,
      "duration_seconds": 7.36,
      "text": "Sorry, um, what was I saying, yes, about the same, about a week."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.78,
      "end_seconds": 86.41,
      "duration_seconds": 6.63,
      "text": "Have you had periods stopped for four months before, or is this the first time?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.19,
      "end_seconds": 94.31,
      "duration_seconds": 6.12,
      "text": "A bit, about six months ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.06,
      "end_seconds": 100.11,
      "duration_seconds": 5.05,
      "text": "let me check a few things. Any visual changes or weight change?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.92,
      "end_seconds": 104.76,
      "duration_seconds": 2.84,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.01,
      "end_seconds": 112.3,
      "duration_seconds": 6.29,
      "text": "let me check a few things. Any positive pregnancy test or hot flushes?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 113.81,
      "end_seconds": 119.8,
      "duration_seconds": 5.99,
      "text": "Uh, I haven't had positive pregnancy test or hot flushes, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.9,
      "end_seconds": 123.78,
      "duration_seconds": 2.88,
      "text": "how are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.11,
      "end_seconds": 128.38,
      "duration_seconds": 3.27,
      "text": "Well, bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.31,
      "end_seconds": 131.37,
      "duration_seconds": 2.06,
      "text": "is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.63,
      "end_seconds": 135.17,
      "duration_seconds": 2.54,
      "text": "erm, I move fine otherwise"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.32,
      "end_seconds": 141.93,
      "duration_seconds": 5.61,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.96,
      "end_seconds": 152.45,
      "duration_seconds": 9.49,
      "text": "I look after my grandchildren most days. I grab fast food at lunch most days. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.7,
      "end_seconds": 171.73,
      "duration_seconds": 5.03,
      "text": "Tell me your medicines, please. I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.77,
      "end_seconds": 177.07,
      "duration_seconds": 3.3,
      "text": "Escitalopram, 10 milligrams, once a day"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.91,
      "end_seconds": 182.88,
      "duration_seconds": 2.97,
      "text": "how long have you been on it?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 183.7,
      "end_seconds": 194.94,
      "duration_seconds": 11.24,
      "text": "For two months. Apixaban, 5 milligrams, twice a day for the heart rhythm. I used to take metoprolol, but I stopped it."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.1,
      "end_seconds": 197.29,
      "duration_seconds": 1.19,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 201.18,
      "end_seconds": 203.37,
      "duration_seconds": 2.19,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.39,
      "end_seconds": 207.91,
      "duration_seconds": 2.52,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 208.71,
      "end_seconds": 214.33,
      "duration_seconds": 5.62,
      "text": "Diclofenac. I come out in... well, swelling of my lips."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.97,
      "end_seconds": 229.27,
      "duration_seconds": 3.3,
      "text": "has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 230.42,
      "end_seconds": 231.78,
      "duration_seconds": 1.36,
      "text": "I've got anxiety."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.79,
      "end_seconds": 234.49,
      "duration_seconds": 0.7,
      "text": "ah"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 236.55,
      "end_seconds": 241.95,
      "duration_seconds": 5.4,
      "text": "Erm, I've had an irregular heartbeat for nearly five years now."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.18,
      "end_seconds": 255.05,
      "duration_seconds": 9.87,
      "text": "Right, yes, anxiety and an irregular heartbeat are known to us, good to have that clear. Okay, I'll do your observations first."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.9,
      "end_seconds": 264.36,
      "duration_seconds": 2.46,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.47,
      "end_seconds": 291.4,
      "duration_seconds": 15.93,
      "text": "Okay: heart rate 71, height 168 centimetres. And SpO2 98 percent on room air, BMI works out to 18.8, temperature 36.4, respiratory rate 18, pressure 125 over 78, weight 53 kilos."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.81,
      "end_seconds": 297.99,
      "duration_seconds": 4.18,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.19,
      "end_seconds": 301.96,
      "duration_seconds": 2.77,
      "text": "stay as you are for a moment"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 320.48,
      "end_seconds": 330.16,
      "duration_seconds": 9.68,
      "text": "you are not pregnant by the urine test, the breasts express a little milk, and there is no visual field loss"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 336.12,
      "end_seconds": 338.64,
      "duration_seconds": 2.52,
      "text": "thank you, you can get dressed"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 345.75,
      "end_seconds": 373.14,
      "duration_seconds": 27.39,
      "text": "Okay, so my impression is this: My working impression is raised prolactin or a thyroid problem rather than stress. The reason I say that is that your story and my examination fit together. I'd also keep polycystic ovary syndrome in mind. I'm sending you for a pregnancy test because of amenorrhoea. We'll catch up after the results. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 375.83,
      "end_seconds": 377.9,
      "duration_seconds": 2.07,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 378.59,
      "end_seconds": 380.31,
      "duration_seconds": 1.72,
      "text": "Have a good day."
    }
  ]
}