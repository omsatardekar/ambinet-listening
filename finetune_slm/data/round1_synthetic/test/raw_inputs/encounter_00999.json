{
  "schema_version": "1.0",
  "encounter_id": "00999",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 1.48,
      "end_seconds": 19.27,
      "duration_seconds": 17.79,
      "text": "Hi, doctor. This is Oscar, he's seven. His eczema's flared, and I'm worried about the steroid cream, I've read it thins the skin, and I'm not sure we should keep using it."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.35,
      "end_seconds": 26.37,
      "duration_seconds": 4.02,
      "text": "Understandable. Oscar, where's the itchiest bit?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.52,
      "end_seconds": 31.78,
      "duration_seconds": 3.26,
      "text": "Elbows. And behind the knees."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.61,
      "end_seconds": 37.19,
      "duration_seconds": 2.58,
      "text": "Is your skin dry?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.02,
      "end_seconds": 41.3,
      "duration_seconds": 1.28,
      "text": "Very."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.83,
      "end_seconds": 47.83,
      "duration_seconds": 3.0,
      "text": "Does it keep you awake?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 50.83,
      "end_seconds": 55.48,
      "duration_seconds": 4.65,
      "text": "He scratches in his sleep, he wakes up crying."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.11,
      "end_seconds": 60.93,
      "duration_seconds": 2.82,
      "text": "Any weeping or crusting?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 63.29,
      "end_seconds": 66.01,
      "duration_seconds": 2.72,
      "text": "No, nothing wet."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.86,
      "end_seconds": 71.53,
      "duration_seconds": 2.67,
      "text": "What are you using?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 73.57,
      "end_seconds": 80.84,
      "duration_seconds": 7.27,
      "text": "Hydrocortisone cream, once a day, on the red bits. And cetirizine syrup."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.2,
      "end_seconds": 87.07,
      "duration_seconds": 2.87,
      "text": "I have 5 ml."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 89.04,
      "end_seconds": 93.48,
      "duration_seconds": 4.44,
      "text": "It's 10 ml, Oscar. I measure it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.71,
      "end_seconds": 102.61,
      "duration_seconds": 5.9,
      "text": "I'll check the label. Oscar, any allergies? Anything you can't eat?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.94,
      "end_seconds": 107.91,
      "duration_seconds": 2.97,
      "text": "I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 111.25,
      "end_seconds": 119.92,
      "duration_seconds": 8.67,
      "text": "Well, the egg, last year, he came up in hives, I'm not sure it was an allergy though."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.22,
      "end_seconds": 125.55,
      "duration_seconds": 3.33,
      "text": "I'll record both. Any other history?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 128.39,
      "end_seconds": 132.83,
      "duration_seconds": 4.44,
      "text": "Just the eczema, since a baby."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.48,
      "end_seconds": 137.04,
      "duration_seconds": 1.56,
      "text": "And school?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.97,
      "end_seconds": 141.04,
      "duration_seconds": 2.07,
      "text": "Year two."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.72,
      "end_seconds": 143.66,
      "duration_seconds": 0.94,
      "text": "Swimming?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 145.75,
      "end_seconds": 149.7,
      "duration_seconds": 3.95,
      "text": "Lessons on Saturday. The chlorine stings him."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.32,
      "end_seconds": 178.39,
      "duration_seconds": 11.07,
      "text": "Let me check him. Temperature 36.7, pulse 90, breathing 20, oxygen 99 percent, weight 24 kilos, height 120 centimetres."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 180.41,
      "end_seconds": 182.7,
      "duration_seconds": 2.29,
      "text": "All fine? ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.51,
      "end_seconds": 196.84,
      "duration_seconds": 4.33,
      "text": "All good. Oscar, show me your elbows."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.81,
      "end_seconds": 200.5,
      "duration_seconds": 1.69,
      "text": "Here. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.22,
      "end_seconds": 210.32,
      "duration_seconds": 7.1,
      "text": "Dry, red, scaly patches in both elbow creases and behind the knees."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 213.41,
      "end_seconds": 216.75,
      "duration_seconds": 3.34,
      "text": "That's what I see. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.88,
      "end_seconds": 224.67,
      "duration_seconds": 5.79,
      "text": "And some scratch marks, but no sign of crusting."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 227.12,
      "end_seconds": 228.81,
      "duration_seconds": 1.69,
      "text": "Good. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.57,
      "end_seconds": 233.2,
      "duration_seconds": 2.63,
      "text": "Any wheeze or cough?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 236.8,
      "end_seconds": 239.49,
      "duration_seconds": 2.69,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.73,
      "end_seconds": 256.26,
      "duration_seconds": 13.53,
      "text": "This looks like an eczema flare, but I can't rule out a skin infection on top, so I'd like to arrange a skin swab."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 258.74,
      "end_seconds": 263.13,
      "duration_seconds": 4.39,
      "text": "Is the steroid cream safe? ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.75,
      "end_seconds": 274.27,
      "duration_seconds": 8.52,
      "text": "Used the way I describe, yes. Short bursts on red areas only, thinning happens with long, heavy use."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 277.79,
      "end_seconds": 280.23,
      "duration_seconds": 2.44,
      "text": "That's reassuring. ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.53,
      "end_seconds": 286.67,
      "duration_seconds": 4.14,
      "text": "Moisturise generously, several times a day."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 289.67,
      "end_seconds": 291.49,
      "duration_seconds": 1.82,
      "text": "Will do. ~"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.11,
      "end_seconds": 299.87,
      "duration_seconds": 5.76,
      "text": "I'd like to see you again in two weeks."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 302.97,
      "end_seconds": 306.0,
      "duration_seconds": 3.03,
      "text": "Two weeks. Thank you. ~"
    }
  ]
}
