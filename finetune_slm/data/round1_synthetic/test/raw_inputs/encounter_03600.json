{
  "schema_version": "1.0",
  "encounter_id": "03600",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.77,
      "end_seconds": 6.08,
      "duration_seconds": 5.31,
      "text": "Doctor, if you're free, we can start. I've got the numbers noted down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.86,
      "end_seconds": 11.44,
      "duration_seconds": 4.58,
      "text": "Good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 11.97,
      "end_seconds": 19.35,
      "duration_seconds": 7.38,
      "text": "So the thing is, I've got an itchy red rash on the chest."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.4,
      "end_seconds": 23.94,
      "duration_seconds": 2.54,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 25.88,
      "end_seconds": 31.16,
      "duration_seconds": 5.28,
      "text": "I take allopurinol, 100 milligrams, started three weeks ago."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.42,
      "end_seconds": 35.52,
      "duration_seconds": 3.1,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 36.53,
      "end_seconds": 39.83,
      "duration_seconds": 3.3,
      "text": "Since Friday, that's when it began."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.38,
      "end_seconds": 49.19,
      "duration_seconds": 7.81,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 50.5,
      "end_seconds": 58.29,
      "duration_seconds": 7.79,
      "text": "It's moderate, honestly. It happens all the time. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.54,
      "end_seconds": 62.72,
      "duration_seconds": 3.18,
      "text": "Has there been spreading over a week too?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 64.69,
      "end_seconds": 74.1,
      "duration_seconds": 9.41,
      "text": "Yeah, I've had that since last weekend. About spreading over a week, I'd give it a six, out of ten."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.85,
      "end_seconds": 87.97,
      "duration_seconds": 3.12,
      "text": "Have you had blistering, by any chance?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 88.9,
      "end_seconds": 90.38,
      "duration_seconds": 1.48,
      "text": "Nope, no blistering."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.39,
      "end_seconds": 96.68,
      "duration_seconds": 4.29,
      "text": "Did you get facial swelling, breathing difficulty or mouth sores?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 97.33,
      "end_seconds": 99.69,
      "duration_seconds": 2.36,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.89,
      "end_seconds": 105.62,
      "duration_seconds": 4.73,
      "text": "Right, anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 106.78,
      "end_seconds": 108.74,
      "duration_seconds": 1.96,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.46,
      "end_seconds": 113.22,
      "duration_seconds": 2.76,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 114.35,
      "end_seconds": 119.55,
      "duration_seconds": 5.2,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.96,
      "end_seconds": 123.86,
      "duration_seconds": 2.9,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 125.8,
      "end_seconds": 128.55,
      "duration_seconds": 2.75,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.38,
      "end_seconds": 135.77,
      "duration_seconds": 3.39,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 136.5,
      "end_seconds": 138.62,
      "duration_seconds": 2.12,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.7,
      "end_seconds": 159.66,
      "duration_seconds": 2.96,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 161.31,
      "end_seconds": 166.11,
      "duration_seconds": 4.8,
      "text": "Just a wisdom tooth extraction under sedation, five years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.87,
      "end_seconds": 170.8,
      "duration_seconds": 3.93,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 172.25,
      "end_seconds": 174.36,
      "duration_seconds": 2.11,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.97,
      "end_seconds": 180.13,
      "duration_seconds": 3.16,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 181.73,
      "end_seconds": 183.77,
      "duration_seconds": 2.04,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 185.52,
      "end_seconds": 193.93,
      "duration_seconds": 8.41,
      "text": "Here are the numbers, doctor. Heart rate 68, pressure 121 over 76, saturation 97 percent, temperature 36.9."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.53,
      "end_seconds": 195.54,
      "duration_seconds": 1.01,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.81,
      "end_seconds": 199.93,
      "duration_seconds": 2.12,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 201.14,
      "end_seconds": 202.2,
      "duration_seconds": 1.06,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.4,
      "end_seconds": 205.13,
      "duration_seconds": 1.73,
      "text": "So, nearly finished here."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.13,
      "end_seconds": 222.56,
      "duration_seconds": 9.43,
      "text": "There is a fine pink rash across the chest and arms, with no blistering and the mouth is clear."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.11,
      "end_seconds": 240.08,
      "duration_seconds": 12.97,
      "text": "Good, you can sit up again. Having listened and examined, it fits best with a drug rash probably from allopurinol. A viral rash is also on my list."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.14,
      "end_seconds": 262.51,
      "duration_seconds": 4.37,
      "text": "I'm sending you for blood tests because of drug rash."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 264.02,
      "end_seconds": 266.71,
      "duration_seconds": 2.69,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.8,
      "end_seconds": 301.15,
      "duration_seconds": 33.35,
      "text": "I'd like you to take cetirizine, 10 milligrams, once a day, one week. It's for itch. Please stop the allopurinol and don't restart it until we've spoken to the clinic. Keep an eye out, and if you develop blisters, mouth sores or facial swelling, call us the same day or go to emergency. I'd like to see you again in three days. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 302.5,
      "end_seconds": 304.49,
      "duration_seconds": 1.99,
      "text": "Thank you, that's helpful."
    }
  ]
}