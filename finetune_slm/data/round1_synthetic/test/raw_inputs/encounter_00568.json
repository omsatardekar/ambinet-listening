{
  "schema_version": "1.0",
  "encounter_id": "00568",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 0.71,
      "end_seconds": 5.09,
      "duration_seconds": 4.38,
      "text": "Good morning. Mr Gopal Rathore, correct? And you are...?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 6.03,
      "end_seconds": 15.95,
      "duration_seconds": 9.92,
      "text": "Good morning, doctor. I am Sunita, I stay with him as his carer. Yes, he is Mr Rathore."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.03,
      "end_seconds": 30.3,
      "duration_seconds": 12.27,
      "text": "Yes, yes, Gopal Rathore. You know, the lift downstairs was not working, so we took the stairs very slowly, and that itself shows the problem."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.77,
      "end_seconds": 37.71,
      "duration_seconds": 4.94,
      "text": "Let us start there, then. What is the problem?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.23,
      "end_seconds": 52.18,
      "duration_seconds": 12.95,
      "text": "I am more breathless than last winter, doctor. Last winter also I was breathless, but this time it is more, and my grandson's wedding is in March, so I told Sunita..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.17,
      "end_seconds": 59.69,
      "duration_seconds": 6.52,
      "text": "One thing at a time, please. How long has this extra breathlessness been going on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.62,
      "end_seconds": 65.59,
      "duration_seconds": 3.97,
      "text": "Two weeks, I think. Only two weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 66.48,
      "end_seconds": 73.43,
      "duration_seconds": 6.95,
      "text": "Three weeks, sir. I am counting from the day you stopped walking to the park."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.57,
      "end_seconds": 83.93,
      "duration_seconds": 8.36,
      "text": "Two, three weeks. So roughly two to three weeks, let us say. Any cough with it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.07,
      "end_seconds": 95.22,
      "duration_seconds": 9.15,
      "text": "Yes, cough also, every morning, with some white phlegm. That one is old, it is always there."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.95,
      "end_seconds": 101.74,
      "duration_seconds": 4.79,
      "text": "White phlegm, fine. Any wheezing, any whistling sound in the chest?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.55,
      "end_seconds": 110.75,
      "duration_seconds": 7.2,
      "text": "Wheezing, yes, at night, when I lie down. I hear it myself, and Sunita also hears."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.42,
      "end_seconds": 113.35,
      "duration_seconds": 1.93,
      "text": "Any chest pain?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.95,
      "end_seconds": 120.03,
      "duration_seconds": 5.08,
      "text": "No chest pain, doctor. That I would have told you immediately."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.13,
      "end_seconds": 124.36,
      "duration_seconds": 3.23,
      "text": "Good. Coughing up any blood?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.21,
      "end_seconds": 129.79,
      "duration_seconds": 3.58,
      "text": "No blood, no. Only the white phlegm."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.14,
      "end_seconds": 136.42,
      "duration_seconds": 4.28,
      "text": "Fine. Any swelling in your legs or ankles?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.64,
      "end_seconds": 144.41,
      "duration_seconds": 6.77,
      "text": "No swelling in my legs, doctor. These legs are the same as always."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 147.03,
      "end_seconds": 157.43,
      "duration_seconds": 10.4,
      "text": "Sir, his ankles are swollen in the evenings, doctor. When I take off his socks they leave deep marks."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.42,
      "end_seconds": 165.91,
      "duration_seconds": 7.49,
      "text": "Noted. We will come back to that. Now medicines. Which inhalers and tablets are you on?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.89,
      "end_seconds": 176.56,
      "duration_seconds": 9.67,
      "text": "Tiotropium inhaler, once a day in the morning. And the blue inhaler, salbutamol, when I am breathless, which is many times now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.27,
      "end_seconds": 178.97,
      "duration_seconds": 1.7,
      "text": "And tablets?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.47,
      "end_seconds": 189.85,
      "duration_seconds": 9.38,
      "text": "One small white tablet for the pressure. The name I cannot recall, my daughter wrote it somewhere. Sunita, what is it?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 192.17,
      "end_seconds": 204.44,
      "duration_seconds": 12.27,
      "text": "I am sorry, doctor, only the box has the name and it is at home. White, small, round, once in the morning."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.07,
      "end_seconds": 209.83,
      "duration_seconds": 2.76,
      "text": "Okay. Any other health problems?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.87,
      "end_seconds": 225.42,
      "duration_seconds": 13.55,
      "text": "COPD, ten years now. Also high blood pressure, and diabetes, controlled by diet only. Arthritis in the knees also, that is why I do not walk much."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.02,
      "end_seconds": 229.9,
      "duration_seconds": 2.88,
      "text": "Any operations in the past?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.59,
      "end_seconds": 237.21,
      "duration_seconds": 6.62,
      "text": "Cataract operation, five years ago, left eye. And my appendix, in 1988."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.14,
      "end_seconds": 240.75,
      "duration_seconds": 2.61,
      "text": "Any allergies to medicines?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.16,
      "end_seconds": 250.77,
      "duration_seconds": 8.61,
      "text": "Yes, penicillin. I get a rash all over. A doctor in 1990 told me never to take it."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.85,
      "end_seconds": 257.6,
      "duration_seconds": 4.75,
      "text": "Noted. In the family, any chest or heart problems?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.41,
      "end_seconds": 268.94,
      "duration_seconds": 9.53,
      "text": "My father died of a heart attack at sixty. My brother has asthma, he lives in Pune, a funny man, once he..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.47,
      "end_seconds": 273.49,
      "duration_seconds": 3.02,
      "text": "Thank you. Did you ever smoke?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.99,
      "end_seconds": 280.97,
      "duration_seconds": 4.98,
      "text": "Yes, thirty years I smoked, beedis. I stopped eight years back."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.14,
      "end_seconds": 283.65,
      "duration_seconds": 1.51,
      "text": "And alcohol?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.1,
      "end_seconds": 296.71,
      "duration_seconds": 10.61,
      "text": "I do not drink alcohol at all. I was a bank clerk, retired now, and bank people are careful, you know."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.65,
      "end_seconds": 303.78,
      "duration_seconds": 6.13,
      "text": "Okay. Let me check your vitals, then listen to your chest."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.2,
      "end_seconds": 310.0,
      "duration_seconds": 3.8,
      "text": "Yes, of course. Sunita, hold my shawl."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.41,
      "end_seconds": 330.8,
      "duration_seconds": 8.39,
      "text": "Blood pressure 138 over 82, pulse 96, oxygen 91 percent, breathing rate 22, temperature 37.2 degrees."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.83,
      "end_seconds": 337.13,
      "duration_seconds": 4.3,
      "text": "Is the oxygen low? My neighbour had oxygen once..."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.73,
      "end_seconds": 346.83,
      "duration_seconds": 8.1,
      "text": "A little low for a normal person, but you have COPD. Now deep breaths in and out, mouth open."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.34,
      "end_seconds": 350.75,
      "duration_seconds": 2.41,
      "text": "Okay. Like this? Cough, sorry."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.94,
      "end_seconds": 375.23,
      "duration_seconds": 14.29,
      "text": "There is wheeze on both sides, and the air entry is reduced at the bottom of both lungs. Your lips are not blue, which is good."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 376.6,
      "end_seconds": 381.91,
      "duration_seconds": 5.31,
      "text": "Quickly, how are your stomach and bowels? And passing urine?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 383.06,
      "end_seconds": 387.04,
      "duration_seconds": 3.98,
      "text": "Stomach is fine, fine. Urine also normal."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 389.41,
      "end_seconds": 401.18,
      "duration_seconds": 11.77,
      "text": "So this looks like a COPD flare-up, probably an infection on top of the old problem. But I cannot rule out fluid on the lungs yet."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 402.43,
      "end_seconds": 407.27,
      "duration_seconds": 4.84,
      "text": "Fluid? In my lungs? My uncle also had fluid and..."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 408.84,
      "end_seconds": 418.66,
      "duration_seconds": 9.82,
      "text": "Please, Mr Rathore, listen. I will order a chest X-ray and blood tests today, and a lung function test, spirometry."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 419.4,
      "end_seconds": 424.16,
      "duration_seconds": 4.76,
      "text": "All today? Sunita has to cook lunch at one o'clock."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 425.99,
      "end_seconds": 435.29,
      "duration_seconds": 9.3,
      "text": "X-ray and blood tests today. Spirometry I am booking for next week, reception will give you the date."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 437.73,
      "end_seconds": 448.2,
      "duration_seconds": 10.47,
      "text": "And if the swelling in the ankles continues, I might arrange an echocardiogram, a heart scan, to look at the heart."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 449.17,
      "end_seconds": 453.21,
      "duration_seconds": 4.04,
      "text": "Heart scan? My heart is strong, doctor."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 454.6,
      "end_seconds": 468.33,
      "duration_seconds": 13.73,
      "text": "Continue both inhalers as you are, and use the blue one when needed. I want to see you again if you are not better in one week."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 470.74,
      "end_seconds": 477.09,
      "duration_seconds": 6.35,
      "text": "And if he is worse in the night, doctor? Should I call you?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 477.95,
      "end_seconds": 486.97,
      "duration_seconds": 9.02,
      "text": "If he cannot speak full sentences, or his lips turn blue, call an ambulance straight away."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 488.15,
      "end_seconds": 495.35,
      "duration_seconds": 7.2,
      "text": "Doctor, can I bathe in cold water? My grandson says it is good for health."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 496.95,
      "end_seconds": 505.37,
      "duration_seconds": 8.42,
      "text": "Warm water is fine, Mr Rathore. Avoid very cold air and keep the windows shut at night."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 506.63,
      "end_seconds": 510.95,
      "duration_seconds": 4.32,
      "text": "I will make sure, doctor. Thank you."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 512.64,
      "end_seconds": 519.45,
      "duration_seconds": 6.81,
      "text": "Thank you, doctor. And please come to the wedding also, there will be good food."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 520.37,
      "end_seconds": 525.01,
      "duration_seconds": 4.64,
      "text": "Ha, we shall see. Take care, both of you."
    }
  ]
}
