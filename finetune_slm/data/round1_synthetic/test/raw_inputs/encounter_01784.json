{
  "schema_version": "1.0",
  "encounter_id": "01784",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.79,
      "end_seconds": 2.55,
      "duration_seconds": 1.76,
      "text": "Evening. Let's get started."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.25,
      "end_seconds": 14.21,
      "duration_seconds": 6.96,
      "text": "Hi doctor, you know, I got here as fast as I could."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.11,
      "end_seconds": 18.66,
      "duration_seconds": 2.55,
      "text": "What do you need help with?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.3,
      "end_seconds": 23.44,
      "duration_seconds": 4.14,
      "text": "I've been dealing with coming on in seconds."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.0,
      "end_seconds": 25.89,
      "duration_seconds": 1.89,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 27.62,
      "end_seconds": 41.3,
      "duration_seconds": 13.68,
      "text": "Around three weeks... no wait, it's more like four weeks. I'm hoping you can tell me something definite. There's the worst headache of my life as well."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.47,
      "end_seconds": 47.62,
      "duration_seconds": 5.15,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 48.96,
      "end_seconds": 50.91,
      "duration_seconds": 1.95,
      "text": "It's all the time."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.73,
      "end_seconds": 58.11,
      "duration_seconds": 2.38,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 60.08,
      "end_seconds": 63.5,
      "duration_seconds": 3.42,
      "text": "Yes, milk, it gives me a rash."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.36,
      "end_seconds": 68.91,
      "duration_seconds": 4.55,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 69.68,
      "end_seconds": 74.99,
      "duration_seconds": 5.31,
      "text": "I take carvedilol, 6.25 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.99,
      "end_seconds": 79.63,
      "duration_seconds": 3.64,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.83,
      "end_seconds": 84.93,
      "duration_seconds": 4.1,
      "text": "Let me think, my father had bowel cancer."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.65,
      "end_seconds": 90.71,
      "duration_seconds": 5.06,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.39,
      "end_seconds": 103.15,
      "duration_seconds": 11.76,
      "text": "I've never touched a cigarette. I swim twice a week. My husband and I live above the shop. I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.54,
      "end_seconds": 111.19,
      "duration_seconds": 4.65,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.8,
      "end_seconds": 115.81,
      "duration_seconds": 4.01,
      "text": "I have heart failure, for five years."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.47,
      "end_seconds": 132.68,
      "duration_seconds": 1.21,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 133.95,
      "end_seconds": 137.32,
      "duration_seconds": 3.37,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.26,
      "end_seconds": 142.23,
      "duration_seconds": 2.97,
      "text": "Any weakness, head injury or fever?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.02,
      "end_seconds": 147.32,
      "duration_seconds": 4.3,
      "text": "No weakness, head injury or fever, none of it."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.98,
      "end_seconds": 151.43,
      "duration_seconds": 2.45,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 153.2,
      "end_seconds": 154.24,
      "duration_seconds": 1.04,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.99,
      "end_seconds": 159.42,
      "duration_seconds": 4.43,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.69,
      "end_seconds": 165.32,
      "duration_seconds": 4.63,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.35,
      "end_seconds": 171.16,
      "duration_seconds": 2.81,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.07,
      "end_seconds": 180.26,
      "duration_seconds": 2.19,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.41,
      "end_seconds": 208.5,
      "duration_seconds": 9.09,
      "text": "Okay: BP is 171 over 96, temperature 36.6. And respiratory rate 15, pulse is 90 beats a minute."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.25,
      "end_seconds": 214.17,
      "duration_seconds": 3.92,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 214.7,
      "end_seconds": 215.64,
      "duration_seconds": 0.94,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.49,
      "end_seconds": 219.57,
      "duration_seconds": 2.08,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.66,
      "end_seconds": 239.62,
      "duration_seconds": 4.96,
      "text": "Your neck is stiff and you are very sensitive to light."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.36,
      "end_seconds": 244.59,
      "duration_seconds": 2.23,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.64,
      "end_seconds": 261.79,
      "duration_seconds": 8.15,
      "text": "Taking everything into account, it fits best with a possible bleed around the brain. Another possibility is a migraine."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 263.39,
      "end_seconds": 265.69,
      "duration_seconds": 2.3,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.56,
      "end_seconds": 279.1,
      "duration_seconds": 12.54,
      "text": "I understand the worry. At the moment I'd say it's a possible bleed around the brain, and we'll know more once the an urgent CT scan of the head is back."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.93,
      "end_seconds": 325.2,
      "duration_seconds": 31.27,
      "text": "I'd like to arrange an urgent CT scan of the head for thunderclap headache. This needs an emergency scan, an ambulance is on its way. Cut down on salt and fried food for now, it really does make a difference. I'm going to send a referral to the emergency team. I'd like to see you again straight away. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 326.55,
      "end_seconds": 328.72,
      "duration_seconds": 2.17,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}