{
  "schema_version": "1.0",
  "encounter_id": "01850",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.21,
      "end_seconds": 4.3,
      "duration_seconds": 3.09,
      "text": "Hi there, the chair's free, sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.61,
      "end_seconds": 8.51,
      "duration_seconds": 2.9,
      "text": "Afternoon, is this seat fine?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 9.09,
      "end_seconds": 14.08,
      "duration_seconds": 4.99,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.31,
      "end_seconds": 17.28,
      "duration_seconds": 1.97,
      "text": "What's been worrying you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 19.06,
      "end_seconds": 23.51,
      "duration_seconds": 4.45,
      "text": "He's been having the worst headache of my life, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.39,
      "end_seconds": 27.6,
      "duration_seconds": 2.21,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.49,
      "end_seconds": 33.32,
      "duration_seconds": 4.83,
      "text": "I'm on sodium valproate, 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 33.82,
      "end_seconds": 43.79,
      "duration_seconds": 9.97,
      "text": "Doctor, I think the last prescription for the sodium valproate was 250 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.99,
      "end_seconds": 48.98,
      "duration_seconds": 3.99,
      "text": "Hm. Do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.84,
      "end_seconds": 57.84,
      "duration_seconds": 7.0,
      "text": "No, I left it at home. Allopurinol. I take it 100 milligrams, once a day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.64,
      "end_seconds": 62.4,
      "duration_seconds": 2.76,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.25,
      "end_seconds": 65.69,
      "duration_seconds": 1.44,
      "text": "Two years now."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.74,
      "end_seconds": 71.39,
      "duration_seconds": 3.65,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 71.9,
      "end_seconds": 82.45,
      "duration_seconds": 10.55,
      "text": "Um, it's been two weeks now. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.48,
      "end_seconds": 87.28,
      "duration_seconds": 2.8,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 89.09,
      "end_seconds": 92.32,
      "duration_seconds": 3.23,
      "text": "Hmm, it feels mild to me."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.35,
      "end_seconds": 95.88,
      "duration_seconds": 2.53,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.84,
      "end_seconds": 117.99,
      "duration_seconds": 21.15,
      "text": "It's every other day. There's vomiting as well. About vomiting, a six out of ten, I suppose. As for coming on in seconds, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.27,
      "end_seconds": 126.15,
      "duration_seconds": 6.88,
      "text": "Have you had the worst headache of your life before, or is this the first time?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 127.39,
      "end_seconds": 135.24,
      "duration_seconds": 7.85,
      "text": "Yes, something like this happened about six months ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.99,
      "end_seconds": 156.23,
      "duration_seconds": 3.24,
      "text": "A few quick ones: head injury or weakness?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 157.71,
      "end_seconds": 162.25,
      "duration_seconds": 4.54,
      "text": "No head injury or weakness, none of it."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.59,
      "end_seconds": 164.46,
      "duration_seconds": 0.87,
      "text": "Any fever?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.4,
      "end_seconds": 168.22,
      "duration_seconds": 2.82,
      "text": "Not that I've noticed, no fever."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.9,
      "end_seconds": 175.65,
      "duration_seconds": 2.75,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.52,
      "end_seconds": 177.45,
      "duration_seconds": 0.93,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.48,
      "end_seconds": 182.07,
      "duration_seconds": 3.59,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 182.99,
      "end_seconds": 187.89,
      "duration_seconds": 4.9,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.79,
      "end_seconds": 196.38,
      "duration_seconds": 2.59,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 196.91,
      "end_seconds": 203.92,
      "duration_seconds": 7.01,
      "text": "Years back I got a rash from naproxen, so I stay away from it now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.99,
      "end_seconds": 212.51,
      "duration_seconds": 3.52,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 213.79,
      "end_seconds": 217.63,
      "duration_seconds": 3.84,
      "text": "Yes, epilepsy. I have depression, for five years."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.34,
      "end_seconds": 220.04,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 220.86,
      "end_seconds": 222.38,
      "duration_seconds": 1.52,
      "text": "I've got gout."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.79,
      "end_seconds": 232.26,
      "duration_seconds": 8.47,
      "text": "Alright, depression and gout, that matches what I have here. What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 234.11,
      "end_seconds": 236.48,
      "duration_seconds": 2.37,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.32,
      "end_seconds": 253.4,
      "duration_seconds": 2.08,
      "text": "Right, what's your work?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 255.37,
      "end_seconds": 259.52,
      "duration_seconds": 4.15,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.15,
      "end_seconds": 262.04,
      "duration_seconds": 1.89,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 263.5,
      "end_seconds": 266.95,
      "duration_seconds": 3.45,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.65,
      "end_seconds": 269.95,
      "duration_seconds": 2.3,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 270.53,
      "end_seconds": 275.43,
      "duration_seconds": 4.9,
      "text": "Yes, I had my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.55,
      "end_seconds": 295.97,
      "duration_seconds": 2.42,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.35,
      "end_seconds": 310.08,
      "duration_seconds": 2.73,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 322.83,
      "end_seconds": 331.28,
      "duration_seconds": 8.45,
      "text": "Okay: pulse is 92 beats a minute, oxygen saturation is 98 percent. And temp 36.9 degrees, pressure 171 over 93."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 332.23,
      "end_seconds": 333.81,
      "duration_seconds": 1.58,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 335.23,
      "end_seconds": 357.4,
      "duration_seconds": 22.17,
      "text": "I'll explain what these mean in a moment. Let me tell you where I've got to. It points towards a possible bleed around the brain. A migraine is still possible. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 358.81,
      "end_seconds": 361.69,
      "duration_seconds": 2.88,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 362.26,
      "end_seconds": 368.22,
      "duration_seconds": 5.96,
      "text": "For now, no new medicines or tests are needed. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 370.07,
      "end_seconds": 373.74,
      "duration_seconds": 3.67,
      "text": "I, I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 374.45,
      "end_seconds": 376.36,
      "duration_seconds": 1.91,
      "text": "Alright, look after yourself."
    }
  ]
}