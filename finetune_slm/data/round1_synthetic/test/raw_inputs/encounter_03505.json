{
  "schema_version": "1.0",
  "encounter_id": "03505",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.54,
      "end_seconds": 2.69,
      "duration_seconds": 2.15,
      "text": "Good morning, grab a seat."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.53,
      "end_seconds": 4.46,
      "duration_seconds": 0.93,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 5.95,
      "end_seconds": 11.57,
      "duration_seconds": 5.62,
      "text": "Doctor, I'll sit in if that's okay, I know what's been happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.68,
      "end_seconds": 14.65,
      "duration_seconds": 1.97,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 16.1,
      "end_seconds": 18.89,
      "duration_seconds": 2.79,
      "text": "He's been having fainting once, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.63,
      "end_seconds": 26.03,
      "duration_seconds": 6.4,
      "text": "Actually, and there's a bit breathless since as well, about three months now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.97,
      "end_seconds": 32.75,
      "duration_seconds": 5.78,
      "text": "So, is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.68,
      "end_seconds": 36.67,
      "duration_seconds": 1.99,
      "text": "It comes and goes."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 38.27,
      "end_seconds": 42.06,
      "duration_seconds": 3.79,
      "text": "What about a faster heartbeat, have you noticed that?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.75,
      "end_seconds": 45.02,
      "duration_seconds": 2.27,
      "text": "Yes, um, actually."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.61,
      "end_seconds": 51.76,
      "duration_seconds": 5.15,
      "text": "Right, any a swollen calf after a long drive as well?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 53.27,
      "end_seconds": 56.3,
      "duration_seconds": 3.03,
      "text": "Actually, yeah. Three weeks, I'd say."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 58.32,
      "end_seconds": 64.22,
      "duration_seconds": 5.9,
      "text": "Have you had fainting once before, or is this the first time?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.28,
      "end_seconds": 71.03,
      "duration_seconds": 4.75,
      "text": "A bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.02,
      "end_seconds": 75.17,
      "duration_seconds": 3.15,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.16,
      "end_seconds": 83.66,
      "duration_seconds": 6.5,
      "text": "It's iron tablets, once a day. Eltroxin, 100 micrograms, maybe, every morning."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.66,
      "end_seconds": 88.78,
      "duration_seconds": 4.12,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 89.97,
      "end_seconds": 96.81,
      "duration_seconds": 6.84,
      "text": "No, you know, it's at home. The contraceptive pill. I take it daily."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.05,
      "end_seconds": 110.21,
      "duration_seconds": 2.16,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.24,
      "end_seconds": 123.88,
      "duration_seconds": 12.64,
      "text": "Low haemoglobin, for five years. High cholesterol, for nearly five years. I've had an underactive thyroid, yes. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.01,
      "end_seconds": 129.66,
      "duration_seconds": 4.65,
      "text": "Alright, an underactive thyroid, that matches what I have here."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.33,
      "end_seconds": 144.52,
      "duration_seconds": 3.19,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.1,
      "end_seconds": 148.94,
      "duration_seconds": 2.84,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.32,
      "end_seconds": 152.06,
      "duration_seconds": 1.74,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 153.75,
      "end_seconds": 157.22,
      "duration_seconds": 3.47,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.9,
      "end_seconds": 161.54,
      "duration_seconds": 2.64,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 162.53,
      "end_seconds": 167.0,
      "duration_seconds": 4.47,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.02,
      "end_seconds": 189.32,
      "duration_seconds": 4.3,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 190.25,
      "end_seconds": 203.52,
      "duration_seconds": 13.27,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.1,
      "end_seconds": 210.23,
      "duration_seconds": 6.13,
      "text": "Okay, any coughing up blood, cough, fever or chest pain at all?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 210.93,
      "end_seconds": 213.65,
      "duration_seconds": 2.72,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.47,
      "end_seconds": 216.99,
      "duration_seconds": 2.52,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 217.82,
      "end_seconds": 219.97,
      "duration_seconds": 2.15,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.36,
      "end_seconds": 225.3,
      "duration_seconds": 3.94,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 227.2,
      "end_seconds": 230.82,
      "duration_seconds": 3.62,
      "text": "Hmm, bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.22,
      "end_seconds": 234.69,
      "duration_seconds": 2.47,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.29,
      "end_seconds": 250.41,
      "duration_seconds": 2.12,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.11,
      "end_seconds": 276.05,
      "duration_seconds": 9.94,
      "text": "Okay: temperature is 36.8 degrees, respiratory rate 20, saturation 99 percent. And heart rate 113, blood pressure 115 over 74."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.04,
      "end_seconds": 280.15,
      "duration_seconds": 2.11,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.81,
      "end_seconds": 283.02,
      "duration_seconds": 1.21,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.15,
      "end_seconds": 301.75,
      "duration_seconds": 8.6,
      "text": "Your oxygen is lower than expected for someone so young and the left calf is a little swollen."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 305.02,
      "end_seconds": 317.0,
      "duration_seconds": 11.98,
      "text": "You can sit up now. Okay, thinking it through, my working impression is possible pulmonary embolism without chest pain. I'd also keep a simple faint in mind."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 318.7,
      "end_seconds": 321.46,
      "duration_seconds": 2.76,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 322.84,
      "end_seconds": 336.04,
      "duration_seconds": 13.2,
      "text": "Nothing I've seen today points to an emergency. It looks like possible pulmonary embolism without chest pain, but I'd like to confirm. I'm going to order a CT pulmonary angiogram, for possible embolus."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 337.29,
      "end_seconds": 342.13,
      "duration_seconds": 4.84,
      "text": "Sorry, what was I saying, okay, I'll do it."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 343.29,
      "end_seconds": 364.08,
      "duration_seconds": 20.79,
      "text": "I'm going to order a D-dimer, for syncope and calf swelling. Even without chest pain this needs a scan today, so please go to hospital. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 368.63,
      "end_seconds": 370.16,
      "duration_seconds": 1.53,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 371.83,
      "end_seconds": 378.15,
      "duration_seconds": 6.32,
      "text": "I'll want another look straight away. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 379.71,
      "end_seconds": 384.54,
      "duration_seconds": 4.83,
      "text": "Yeah, uh, good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 385.18,
      "end_seconds": 386.45,
      "duration_seconds": 1.27,
      "text": "See you soon."
    }
  ]
}