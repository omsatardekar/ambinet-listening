{
  "schema_version": "1.0",
  "encounter_id": "02188",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.89,
      "end_seconds": 4.38,
      "duration_seconds": 3.49,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.2,
      "end_seconds": 14.62,
      "duration_seconds": 4.42,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.72,
      "end_seconds": 24.99,
      "duration_seconds": 9.27,
      "text": "Oh, honestly, it's a hot red swollen big toe, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.41,
      "end_seconds": 29.78,
      "duration_seconds": 3.37,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.6,
      "end_seconds": 33.02,
      "duration_seconds": 1.42,
      "text": "Just since yesterday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.57,
      "end_seconds": 39.34,
      "duration_seconds": 5.77,
      "text": "Mm, okay. Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.14,
      "end_seconds": 48.63,
      "duration_seconds": 7.49,
      "text": "Only ice, and it's not much. Yes, touch. That makes it worse. Mostly mild."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.34,
      "end_seconds": 53.35,
      "duration_seconds": 3.01,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.12,
      "end_seconds": 67.05,
      "duration_seconds": 11.93,
      "text": "It usually comes with not being able to wear a shoe. I've also had pain that woke me, for two days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.13,
      "end_seconds": 73.83,
      "duration_seconds": 5.7,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.8,
      "end_seconds": 87.96,
      "duration_seconds": 10.16,
      "text": "It, It just comes and goes. The not being able to wear a shoe? That's been for five days."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.32,
      "end_seconds": 89.61,
      "duration_seconds": 1.29,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.9,
      "end_seconds": 107.63,
      "duration_seconds": 2.73,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.2,
      "end_seconds": 123.26,
      "duration_seconds": 2.06,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.07,
      "end_seconds": 145.94,
      "duration_seconds": 5.87,
      "text": "Okay: pressure 115 over 69, saturation 97 percent, pulse 81. And temperature 36.9."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.45,
      "end_seconds": 152.46,
      "duration_seconds": 4.01,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.05,
      "end_seconds": 157.09,
      "duration_seconds": 3.04,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.93,
      "end_seconds": 170.9,
      "duration_seconds": 4.97,
      "text": "The big toe joint is red, hot, swollen and exquisitely tender."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.16,
      "end_seconds": 174.86,
      "duration_seconds": 1.7,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.98,
      "end_seconds": 186.07,
      "duration_seconds": 2.09,
      "text": "Any injury, fever or rash?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.62,
      "end_seconds": 191.27,
      "duration_seconds": 3.65,
      "text": "No, you know, not a single one."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.81,
      "end_seconds": 196.77,
      "duration_seconds": 3.96,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.71,
      "end_seconds": 201.36,
      "duration_seconds": 3.65,
      "text": "So, no, nothing with my heart."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.2,
      "end_seconds": 208.04,
      "duration_seconds": 2.84,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.17,
      "end_seconds": 215.73,
      "duration_seconds": 1.56,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.4,
      "end_seconds": 218.95,
      "duration_seconds": 2.55,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.19,
      "end_seconds": 223.63,
      "duration_seconds": 3.44,
      "text": "Tramadol. I come out in... well, vomiting."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.36,
      "end_seconds": 242.07,
      "duration_seconds": 5.71,
      "text": "Let's run through your medicines. Just so I get the full picture."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.89,
      "end_seconds": 248.47,
      "duration_seconds": 4.58,
      "text": "I'm on ibuprofen, 400 milligrams, three times a day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.8,
      "end_seconds": 253.29,
      "duration_seconds": 3.49,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.98,
      "end_seconds": 258.23,
      "duration_seconds": 3.25,
      "text": "Ah, my father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.32,
      "end_seconds": 262.43,
      "duration_seconds": 2.11,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.31,
      "end_seconds": 268.19,
      "duration_seconds": 3.88,
      "text": "Just a bunion operation, six years ago."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.45,
      "end_seconds": 271.23,
      "duration_seconds": 1.78,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.16,
      "end_seconds": 275.96,
      "duration_seconds": 3.8,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.01,
      "end_seconds": 280.89,
      "duration_seconds": 3.88,
      "text": "Okay, what do you do during the day?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.03,
      "end_seconds": 287.78,
      "duration_seconds": 3.75,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.87,
      "end_seconds": 291.41,
      "duration_seconds": 2.54,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.93,
      "end_seconds": 295.49,
      "duration_seconds": 3.56,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.84,
      "end_seconds": 301.42,
      "duration_seconds": 4.58,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.45,
      "end_seconds": 305.02,
      "duration_seconds": 1.57,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.67,
      "end_seconds": 340.1,
      "duration_seconds": 34.43,
      "text": "So, based on the history and the examination, this looks most like an acute gout attack. Another possibility is a septic joint. Let's get kidney function tests, for gout treatment. Let's get a uric acid blood test, for gout. Rest the foot, ice it, and drink plenty of water; limit beer and red meat. One warning sign to remember: the symptoms get worse. In that case don't wait. I'd like you back in two weeks."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.08,
      "end_seconds": 345.02,
      "duration_seconds": 3.94,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.68,
      "end_seconds": 350.21,
      "duration_seconds": 4.53,
      "text": "Right, um, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.87,
      "end_seconds": 357.88,
      "duration_seconds": 2.01,
      "text": "Okay, see you soon."
    }
  ]
}