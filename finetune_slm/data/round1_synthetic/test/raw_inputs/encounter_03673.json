{
  "schema_version": "1.0",
  "encounter_id": "03673",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.12,
      "end_seconds": 4.45,
      "duration_seconds": 3.33,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.47,
      "end_seconds": 10.67,
      "duration_seconds": 5.2,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.51,
      "end_seconds": 29.03,
      "duration_seconds": 16.52,
      "text": "Mainly not remembering the last hours. There's a couple of other things, uh, but that's the main one. I told my wife I'd come today. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.7,
      "end_seconds": 32.69,
      "duration_seconds": 2.99,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.18,
      "end_seconds": 44.86,
      "duration_seconds": 2.68,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.84,
      "end_seconds": 75.25,
      "duration_seconds": 12.41,
      "text": "Okay: respiratory rate 17, temperature is 36.7 degrees, blood pressure 108 over 77, pulse is 64 beats a minute, oxygen saturation is 98 percent. When did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.31,
      "end_seconds": 82.44,
      "duration_seconds": 6.13,
      "text": "About... well, about four days. I've also had asking the same questions repeatedly."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.14,
      "end_seconds": 86.52,
      "duration_seconds": 3.38,
      "text": "a few quick ones: seizure or headache?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.26,
      "end_seconds": 90.78,
      "duration_seconds": 3.52,
      "text": "I haven't had seizure or headache, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.79,
      "end_seconds": 98.01,
      "duration_seconds": 5.22,
      "text": "Let me check a few things. Any slurred speech or weakness?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.56,
      "end_seconds": 101.54,
      "duration_seconds": 1.98,
      "text": "nope, nothing like that"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.26,
      "end_seconds": 107.36,
      "duration_seconds": 2.1,
      "text": "has your skin been okay?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.9,
      "end_seconds": 110.38,
      "duration_seconds": 2.48,
      "text": "nothing on the skin, no"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.88,
      "end_seconds": 114.02,
      "duration_seconds": 3.14,
      "text": "alright, how are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.91,
      "end_seconds": 117.51,
      "duration_seconds": 1.6,
      "text": "nothing unusual, no"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.35,
      "end_seconds": 121.57,
      "duration_seconds": 3.22,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.16,
      "end_seconds": 125.0,
      "duration_seconds": 2.84,
      "text": "Well, my sister had breast cancer."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.11,
      "end_seconds": 130.11,
      "duration_seconds": 4.0,
      "text": "do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.11,
      "end_seconds": 135.25,
      "duration_seconds": 3.14,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.17,
      "end_seconds": 144.55,
      "duration_seconds": 1.38,
      "text": "what about alcohol?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.99,
      "end_seconds": 147.61,
      "duration_seconds": 1.62,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.45,
      "end_seconds": 149.41,
      "duration_seconds": 0.96,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.0,
      "end_seconds": 154.74,
      "duration_seconds": 3.74,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.34,
      "end_seconds": 156.58,
      "duration_seconds": 1.24,
      "text": "and your job?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.54,
      "end_seconds": 160.96,
      "duration_seconds": 3.42,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.76,
      "end_seconds": 163.68,
      "duration_seconds": 1.92,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.53,
      "end_seconds": 167.85,
      "duration_seconds": 2.32,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.48,
      "end_seconds": 171.26,
      "duration_seconds": 1.78,
      "text": "how active are you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.69,
      "end_seconds": 175.82,
      "duration_seconds": 3.13,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.47,
      "end_seconds": 191.18,
      "duration_seconds": 2.71,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.79,
      "end_seconds": 196.39,
      "duration_seconds": 4.6,
      "text": "I'm on apixaban, 5 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.16,
      "end_seconds": 204.42,
      "duration_seconds": 4.26,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.37,
      "end_seconds": 210.38,
      "duration_seconds": 4.01,
      "text": "I, I have arthritis in my knees"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.36,
      "end_seconds": 213.58,
      "duration_seconds": 1.22,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.1,
      "end_seconds": 226.47,
      "duration_seconds": 11.37,
      "text": "I've had an irregular heartbeat, yes. I've never really been one for hospitals. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.1,
      "end_seconds": 235.88,
      "duration_seconds": 7.78,
      "text": "Yes, an irregular heartbeat is known to us, good to have that clear. Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.83,
      "end_seconds": 239.63,
      "duration_seconds": 1.8,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.06,
      "end_seconds": 246.25,
      "duration_seconds": 4.19,
      "text": "let me look at the area, I'll be gentle"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.65,
      "end_seconds": 249.02,
      "duration_seconds": 1.37,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.97,
      "end_seconds": 254.24,
      "duration_seconds": 3.27,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.66,
      "end_seconds": 274.61,
      "duration_seconds": 6.95,
      "text": "You know who you are but not what happened this morning, and the examination otherwise is normal."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.49,
      "end_seconds": 281.92,
      "duration_seconds": 2.43,
      "text": "Right, please sit back down."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.0,
      "end_seconds": 303.37,
      "duration_seconds": 6.37,
      "text": "I think a CT scan of the head makes sense here, for acute memory loss"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 304.06,
      "end_seconds": 306.7,
      "duration_seconds": 2.64,
      "text": "The earliest is Monday, 11:30 am."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.43,
      "end_seconds": 310.22,
      "duration_seconds": 2.79,
      "text": "Monday, that works for me"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.18,
      "end_seconds": 330.31,
      "duration_seconds": 19.13,
      "text": "I'd like to arrange a blood sugar for confusion. This usually clears in a day with no lasting effect, but we do a scan first to be safe. Let's plan a check tomorrow. Tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.36,
      "end_seconds": 335.64,
      "duration_seconds": 4.28,
      "text": "so, I come back tomorrow is that right?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.12,
      "end_seconds": 342.89,
      "duration_seconds": 5.77,
      "text": "yes, exactly right right, that's the plan do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.73,
      "end_seconds": 346.68,
      "duration_seconds": 2.95,
      "text": "I think I understand everything thanks"
    }
  ]
}