{
  "schema_version": "1.0",
  "encounter_id": "03525",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.57,
      "end_seconds": 5.03,
      "duration_seconds": 4.46,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.43,
      "end_seconds": 10.34,
      "duration_seconds": 3.91,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.5,
      "end_seconds": 23.13,
      "duration_seconds": 8.63,
      "text": "Yeah, it's a bump on the head yesterday. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.65,
      "end_seconds": 27.11,
      "duration_seconds": 3.46,
      "text": "Okay, what's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.12,
      "end_seconds": 42.68,
      "duration_seconds": 14.56,
      "text": "Yesterday, it came on out of nowhere. I've also been feeling fine otherwise, since this morning. As for feeling fine otherwise, I'd give it a five, out of ten."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.63,
      "end_seconds": 44.86,
      "duration_seconds": 1.23,
      "text": "Nothing like vomiting?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.49,
      "end_seconds": 50.1,
      "duration_seconds": 3.61,
      "text": "No, I haven't had any vomiting."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.88,
      "end_seconds": 54.21,
      "duration_seconds": 3.33,
      "text": "Any seizure, confusion or drowsiness at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.32,
      "end_seconds": 60.42,
      "duration_seconds": 5.1,
      "text": "I haven't had seizure, confusion or drowsiness, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.32,
      "end_seconds": 65.0,
      "duration_seconds": 2.68,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.54,
      "end_seconds": 68.5,
      "duration_seconds": 1.96,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.96,
      "end_seconds": 72.89,
      "duration_seconds": 2.93,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.67,
      "end_seconds": 75.75,
      "duration_seconds": 2.08,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.01,
      "end_seconds": 89.33,
      "duration_seconds": 3.32,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.5,
      "end_seconds": 96.74,
      "duration_seconds": 6.24,
      "text": "I had a wisdom tooth extraction under sedation five years ago."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.33,
      "end_seconds": 101.58,
      "duration_seconds": 3.25,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.68,
      "end_seconds": 106.45,
      "duration_seconds": 3.77,
      "text": "An irregular heartbeat, for two years."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.42,
      "end_seconds": 126.83,
      "duration_seconds": 4.41,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.41,
      "end_seconds": 139.96,
      "duration_seconds": 10.55,
      "text": "It's, It's metoprolol, 50 milligrams, twice a day. A blood thinner. I take it twice a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.03,
      "end_seconds": 143.24,
      "duration_seconds": 2.21,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.76,
      "end_seconds": 149.91,
      "duration_seconds": 1.15,
      "text": "5 milligrams."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.83,
      "end_seconds": 154.96,
      "duration_seconds": 4.13,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.06,
      "end_seconds": 158.9,
      "duration_seconds": 2.84,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.9,
      "end_seconds": 165.34,
      "duration_seconds": 4.44,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.14,
      "end_seconds": 171.27,
      "duration_seconds": 5.13,
      "text": "Mm, no, nothing as far as I know."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.76,
      "end_seconds": 185.05,
      "duration_seconds": 3.29,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.4,
      "end_seconds": 197.71,
      "duration_seconds": 11.31,
      "text": "I'm a bus driver, so I sit for long hours. I live with my elderly mother. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.25,
      "end_seconds": 202.46,
      "duration_seconds": 3.21,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.61,
      "end_seconds": 210.87,
      "duration_seconds": 2.26,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.92,
      "end_seconds": 232.87,
      "duration_seconds": 11.95,
      "text": "Okay: oxygen saturation is 99 percent, pulse is 66 beats a minute, temp 36.8 degrees, BP is 123 over 75, respiratory rate 17."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.92,
      "end_seconds": 238.43,
      "duration_seconds": 3.51,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.27,
      "end_seconds": 242.61,
      "duration_seconds": 2.34,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.08,
      "end_seconds": 261.23,
      "duration_seconds": 7.15,
      "text": "You are alert and orientated with a small bruise on the forehead and normal limb strength."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.04,
      "end_seconds": 293.63,
      "duration_seconds": 27.59,
      "text": "Thank you, you can get dressed. Okay, so my impression is this: I can't pin this down yet. We're looking at a minor head injury but on a blood thinner, which needs a scan or a simple bump. Let me just check I've got this right. You've had a bump on the head yesterday, yesterday, and no confusion or drowsiness."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.04,
      "end_seconds": 297.29,
      "duration_seconds": 2.25,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.39,
      "end_seconds": 305.45,
      "duration_seconds": 7.06,
      "text": "Even though you feel fine, a blood thinner means we scan, delayed bleeding can happen."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.88,
      "end_seconds": 310.35,
      "duration_seconds": 4.47,
      "text": "Yes. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.11,
      "end_seconds": 315.08,
      "duration_seconds": 3.97,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}