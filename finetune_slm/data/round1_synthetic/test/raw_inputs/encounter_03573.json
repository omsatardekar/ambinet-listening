{
  "schema_version": "1.0",
  "encounter_id": "03573",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.22,
      "end_seconds": 7.68,
      "duration_seconds": 6.46,
      "text": "Doctor, this one's ready for you. Everything's on the chart, but I'll go through it."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.76,
      "end_seconds": 13.3,
      "duration_seconds": 3.54,
      "text": "Alright, thank you. Right, hello, what's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 13.82,
      "end_seconds": 20.36,
      "duration_seconds": 6.54,
      "text": "I've been feeling muddled and unsteady, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.58,
      "end_seconds": 24.77,
      "duration_seconds": 3.19,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 26.36,
      "end_seconds": 28.92,
      "duration_seconds": 2.56,
      "text": "Probably about three months. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.67,
      "end_seconds": 32.58,
      "duration_seconds": 2.91,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 34.46,
      "end_seconds": 39.48,
      "duration_seconds": 5.02,
      "text": "Let me think, a eight out of ten, I suppose."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 40.07,
      "end_seconds": 46.78,
      "duration_seconds": 6.71,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 46.88,
      "end_seconds": 52.99,
      "duration_seconds": 6.11,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.45,
      "end_seconds": 59.3,
      "duration_seconds": 4.85,
      "text": "Later, thanks. Please go on. Right, have you had cramps?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 60.43,
      "end_seconds": 61.64,
      "duration_seconds": 1.21,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.74,
      "end_seconds": 66.78,
      "duration_seconds": 4.04,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 68.13,
      "end_seconds": 74.13,
      "duration_seconds": 6.0,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.14,
      "end_seconds": 80.24,
      "duration_seconds": 5.1,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 85.46,
      "end_seconds": 88.71,
      "duration_seconds": 3.25,
      "text": "A four out of ten, I suppose."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "UNKNOWN",
      "start_seconds": 89.48,
      "end_seconds": 91.51,
      "duration_seconds": 2.03,
      "text": "Yes, exactly like that."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.27,
      "end_seconds": 98.15,
      "duration_seconds": 4.88,
      "text": "Let me check a few things. Any fever, seizure or fall?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 100.08,
      "end_seconds": 110.61,
      "duration_seconds": 10.53,
      "text": "No, no fever, no seizure, no fall. I was feeling sick at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.48,
      "end_seconds": 117.27,
      "duration_seconds": 4.79,
      "text": "Have you had weakness on one side, by any chance?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 118.18,
      "end_seconds": 121.98,
      "duration_seconds": 3.8,
      "text": "No, none, no weakness on one side."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.07,
      "end_seconds": 127.29,
      "duration_seconds": 4.22,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 128.64,
      "end_seconds": 133.76,
      "duration_seconds": 5.12,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.6,
      "end_seconds": 139.74,
      "duration_seconds": 4.14,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 140.29,
      "end_seconds": 142.08,
      "duration_seconds": 1.79,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.12,
      "end_seconds": 146.11,
      "duration_seconds": 2.99,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 147.21,
      "end_seconds": 157.22,
      "duration_seconds": 10.01,
      "text": "I have high blood pressure, for two years. I've had depression, yes. Arthritis in my knees, for about ten years."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.97,
      "end_seconds": 164.5,
      "duration_seconds": 5.53,
      "text": "Okay, I can see arthritis in your knees in your file as well."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.93,
      "end_seconds": 184.85,
      "duration_seconds": 2.92,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 185.49,
      "end_seconds": 188.45,
      "duration_seconds": 2.96,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.48,
      "end_seconds": 193.83,
      "duration_seconds": 4.35,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 195.5,
      "end_seconds": 199.55,
      "duration_seconds": 4.05,
      "text": "I mean, no, not that I know of."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.63,
      "end_seconds": 204.96,
      "duration_seconds": 3.33,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 206.68,
      "end_seconds": 214.03,
      "duration_seconds": 7.35,
      "text": "It's a... um, I can't remember what it's called. It's a little pink tablet."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.01,
      "end_seconds": 218.8,
      "duration_seconds": 2.79,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 219.56,
      "end_seconds": 238.4,
      "duration_seconds": 18.84,
      "text": "For my pressure, I believe. My husband sets them out for me, I just take what I'm given. I'm on sertraline, 50 milligrams, once a day for my mood. It's naproxen, 250 milligrams, twice a day for the knee pain."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 239.7,
      "end_seconds": 244.86,
      "duration_seconds": 5.16,
      "text": "Doctor, our chart from the last visit lists it as 500 milligrams."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.59,
      "end_seconds": 250.74,
      "duration_seconds": 4.15,
      "text": "I see. Is the most recent prescription on you?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 251.94,
      "end_seconds": 255.81,
      "duration_seconds": 3.87,
      "text": "I don't think I have it with me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.69,
      "end_seconds": 260.12,
      "duration_seconds": 2.43,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 260.78,
      "end_seconds": 262.27,
      "duration_seconds": 1.49,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 264.16,
      "end_seconds": 280.47,
      "duration_seconds": 16.31,
      "text": "Doctor, I've got the readings for you. SpO2 99 percent on room air, pulse is 66 beats a minute. BP is 123 over 77, height 152 centimetres, weight 69 kilos, BMI works out to 29.9."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.87,
      "end_seconds": 283.57,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.98,
      "end_seconds": 289.36,
      "duration_seconds": 4.38,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 290.91,
      "end_seconds": 291.9,
      "duration_seconds": 0.99,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.01,
      "end_seconds": 295.12,
      "duration_seconds": 2.11,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.92,
      "end_seconds": 317.36,
      "duration_seconds": 7.44,
      "text": "You are a bit slow and unsteady, but there is no weakness and your blood pressure is fine."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.2,
      "end_seconds": 325.0,
      "duration_seconds": 1.8,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.5,
      "end_seconds": 358.44,
      "duration_seconds": 18.94,
      "text": "Right, here's what I'm thinking. This is probably a low salt level, possibly from the new antidepressant. We shouldn't forget dehydration. I'd also keep a urine infection in mind. I think blood tests makes sense here, for confusion."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 360.41,
      "end_seconds": 364.85,
      "duration_seconds": 4.44,
      "text": "We have a slot Friday at 11:30 am, if that works."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.35,
      "end_seconds": 392.58,
      "duration_seconds": 26.23,
      "text": "I'd like to arrange a urine test for confusion. We will stop the new tablet and not drink excess water until we have the result. I'm going to send a referral to the older people's clinic. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 394.19,
      "end_seconds": 396.27,
      "duration_seconds": 2.08,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 396.79,
      "end_seconds": 403.13,
      "duration_seconds": 6.34,
      "text": "Let's plan a check in two days. What are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 404.1,
      "end_seconds": 409.5,
      "duration_seconds": 5.4,
      "text": "So, I come back in two days. Is that right?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 410.09,
      "end_seconds": 415.83,
      "duration_seconds": 5.74,
      "text": "Yes, exactly right. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 417.3,
      "end_seconds": 420.52,
      "duration_seconds": 3.22,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 421.69,
      "end_seconds": 423.13,
      "duration_seconds": 1.44,
      "text": "See you soon."
    }
  ]
}