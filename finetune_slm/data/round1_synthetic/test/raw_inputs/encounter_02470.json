{
  "schema_version": "1.0",
  "encounter_id": "02470",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.13,
      "end_seconds": 5.41,
      "duration_seconds": 4.28,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.98,
      "end_seconds": 12.24,
      "duration_seconds": 4.26,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.85,
      "end_seconds": 21.25,
      "duration_seconds": 8.4,
      "text": "Doctor, it's a hot red swollen big toe. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.43,
      "end_seconds": 27.65,
      "duration_seconds": 5.22,
      "text": "Alright, can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.9,
      "end_seconds": 41.97,
      "duration_seconds": 2.07,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.5,
      "end_seconds": 75.87,
      "duration_seconds": 13.37,
      "text": "Okay: blood pressure 125 over 76, heart rate 76, weight 64 kilos, height 157 centimetres, respiratory rate 16, SpO2 98 percent on room air. When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.81,
      "end_seconds": 82.24,
      "duration_seconds": 5.43,
      "text": "I'd say two weeks. Actually, no, closer to four weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.77,
      "end_seconds": 84.73,
      "duration_seconds": 1.96,
      "text": "Have you noticed any triggers?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.57,
      "end_seconds": 89.22,
      "duration_seconds": 2.65,
      "text": "Touch definitely sets it off."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.27,
      "end_seconds": 95.18,
      "duration_seconds": 3.91,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.67,
      "end_seconds": 101.93,
      "duration_seconds": 5.26,
      "text": "A four out of ten, you know, I suppose."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.45,
      "end_seconds": 108.65,
      "duration_seconds": 6.2,
      "text": "What about not being able to wear a shoe, have you noticed that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.72,
      "end_seconds": 114.14,
      "duration_seconds": 4.42,
      "text": "Let me think, yes, since last Tuesday."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.15,
      "end_seconds": 118.4,
      "duration_seconds": 3.25,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.25,
      "end_seconds": 120.96,
      "duration_seconds": 1.71,
      "text": "Severe, I'd say."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.62,
      "end_seconds": 126.73,
      "duration_seconds": 4.11,
      "text": "Alright, has there been pain that woke you too?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.27,
      "end_seconds": 130.03,
      "duration_seconds": 1.76,
      "text": "Yeah, that too."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.72,
      "end_seconds": 133.69,
      "duration_seconds": 2.97,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.05,
      "end_seconds": 140.29,
      "duration_seconds": 5.24,
      "text": "Maybe a six out of ten on a bad day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.59,
      "end_seconds": 145.16,
      "duration_seconds": 3.57,
      "text": "A few quick ones: injury, rash or fever?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.04,
      "end_seconds": 151.47,
      "duration_seconds": 4.43,
      "text": "No, you know, nothing to report there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.79,
      "end_seconds": 154.77,
      "duration_seconds": 2.98,
      "text": "Yes. Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.3,
      "end_seconds": 160.48,
      "duration_seconds": 4.18,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.82,
      "end_seconds": 165.63,
      "duration_seconds": 3.81,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.73,
      "end_seconds": 169.74,
      "duration_seconds": 3.01,
      "text": "Nothing unusual, um, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.48,
      "end_seconds": 190.03,
      "duration_seconds": 3.55,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.73,
      "end_seconds": 192.39,
      "duration_seconds": 1.66,
      "text": "I have gout."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.64,
      "end_seconds": 194.81,
      "duration_seconds": 1.17,
      "text": "Is that everything?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.67,
      "end_seconds": 203.01,
      "duration_seconds": 6.34,
      "text": "Uh, I've had high blood pressure for about a year now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.85,
      "end_seconds": 210.56,
      "duration_seconds": 5.71,
      "text": "Right, so gout is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.64,
      "end_seconds": 227.28,
      "duration_seconds": 1.64,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.41,
      "end_seconds": 232.99,
      "duration_seconds": 4.58,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.96,
      "end_seconds": 236.04,
      "duration_seconds": 2.08,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.12,
      "end_seconds": 241.16,
      "duration_seconds": 4.04,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.26,
      "end_seconds": 244.69,
      "duration_seconds": 2.43,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.59,
      "end_seconds": 258.59,
      "duration_seconds": 13.0,
      "text": "Oh, you know, yes, I had my tonsils removed, as a teenager. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.84,
      "end_seconds": 279.04,
      "duration_seconds": 4.2,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.75,
      "end_seconds": 288.44,
      "duration_seconds": 7.69,
      "text": "I'm, I'm on something called febu... febuxostat, 80 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.4,
      "end_seconds": 295.82,
      "duration_seconds": 4.42,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.64,
      "end_seconds": 310.56,
      "duration_seconds": 12.92,
      "text": "No, uh, it's at home. Well, I'm on metoprolol, 50 milligrams, twice a day. I'm on ibuprofen, 400 milligrams, three times a day."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.39,
      "end_seconds": 314.84,
      "duration_seconds": 2.45,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.38,
      "end_seconds": 316.41,
      "duration_seconds": 1.03,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.89,
      "end_seconds": 319.13,
      "duration_seconds": 1.24,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.86,
      "end_seconds": 336.91,
      "duration_seconds": 5.05,
      "text": "The big toe joint is red, hot, swollen and exquisitely tender."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.13,
      "end_seconds": 349.14,
      "duration_seconds": 10.01,
      "text": "Right, please sit back down. So, based on the history and the examination, I'd lean towards an acute gout attack."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.77,
      "end_seconds": 352.78,
      "duration_seconds": 3.01,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.87,
      "end_seconds": 379.5,
      "duration_seconds": 24.63,
      "text": "It's reasonable to be concerned, but right now an acute gout attack is my leading thought, not anything worse. I'll request a uric acid blood test, it'll help with gout. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 380.59,
      "end_seconds": 382.27,
      "duration_seconds": 1.68,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 383.37,
      "end_seconds": 384.56,
      "duration_seconds": 1.19,
      "text": "See you soon."
    }
  ]
}