{
  "schema_version": "1.0",
  "encounter_id": "00843",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 1.19,
      "end_seconds": 15.01,
      "duration_seconds": 13.82,
      "text": "Doctor, I'm Ian, Frank's brother. He won't ask, so I will. He's got a cough every morning, and he's been a smoker for forty years."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.86,
      "end_seconds": 20.18,
      "duration_seconds": 3.32,
      "text": "It's just a smoker's cough. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.23,
      "end_seconds": 30.26,
      "duration_seconds": 8.03,
      "text": "Frank, I'd like to hear it from you. Tell me about the morning cough."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.06,
      "end_seconds": 40.87,
      "duration_seconds": 7.81,
      "text": "I cough when I get up. Bring up some phlegm. Then it's gone by mid-morning."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.55,
      "end_seconds": 46.68,
      "duration_seconds": 3.13,
      "text": "What colour is the phlegm?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.83,
      "end_seconds": 54.05,
      "duration_seconds": 5.22,
      "text": "White, mostly. A bit grey at times. ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.32,
      "end_seconds": 61.43,
      "duration_seconds": 5.11,
      "text": "How many years has this been going on? ~"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.59,
      "end_seconds": 69.04,
      "duration_seconds": 4.45,
      "text": "Years. I can't say exactly. Ten, maybe. ~"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.29,
      "end_seconds": 73.43,
      "duration_seconds": 3.14,
      "text": "Any breathlessness, or wheeze? ~"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.98,
      "end_seconds": 82.26,
      "duration_seconds": 7.28,
      "text": "Going up the stairs, I get puffed. But I'm fifty-eight. ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 84.16,
      "end_seconds": 89.04,
      "duration_seconds": 4.88,
      "text": "He's been puffed for a good while. ~"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.08,
      "end_seconds": 95.39,
      "duration_seconds": 3.31,
      "text": "Any blood in the phlegm?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.5,
      "end_seconds": 100.21,
      "duration_seconds": 1.71,
      "text": "No. Never."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.73,
      "end_seconds": 106.59,
      "duration_seconds": 3.86,
      "text": "How much do you smoke?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.61,
      "end_seconds": 113.13,
      "duration_seconds": 4.52,
      "text": "Twenty a day. Since I was eighteen."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.15,
      "end_seconds": 117.93,
      "duration_seconds": 2.78,
      "text": "What are you taking?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.06,
      "end_seconds": 127.63,
      "duration_seconds": 7.57,
      "text": "A blue inhaler. Salbutamol. Two puffs, when I need it. Not often."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.57,
      "end_seconds": 131.37,
      "duration_seconds": 1.8,
      "text": "Any other conditions?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.56,
      "end_seconds": 136.69,
      "duration_seconds": 2.13,
      "text": "High blood pressure."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.36,
      "end_seconds": 142.3,
      "duration_seconds": 3.94,
      "text": "I'll listen to your chest. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.28,
      "end_seconds": 164.08,
      "duration_seconds": 1.8,
      "text": "Go on."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.14,
      "end_seconds": 176.0,
      "duration_seconds": 9.86,
      "text": "There's a bit of wheeze when you breathe out, and your breathing out takes longer than normal, otherwise clear."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 177.25,
      "end_seconds": 179.96,
      "duration_seconds": 2.71,
      "text": "Is it serious? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.6,
      "end_seconds": 204.15,
      "duration_seconds": 21.55,
      "text": "It can't be diagnosed by listening alone. The picture, forty years of smoking, a morning cough with phlegm, and getting puffed on stairs, makes me think of COPD, but I can't be sure until we've tested."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.14,
      "end_seconds": 211.57,
      "duration_seconds": 5.43,
      "text": "COPD. Is that the one my father had? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.34,
      "end_seconds": 223.71,
      "duration_seconds": 10.37,
      "text": "It's a chronic lung condition caused mostly by smoking. It's treatable. The best treatment is stopping smoking. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.19,
      "end_seconds": 229.47,
      "duration_seconds": 3.28,
      "text": "I know. I've tried. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.69,
      "end_seconds": 237.62,
      "duration_seconds": 6.93,
      "text": "I'd like to arrange a breathing test, spirometry, and a chest X-ray."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 240.28,
      "end_seconds": 242.07,
      "duration_seconds": 1.79,
      "text": "When? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.01,
      "end_seconds": 250.32,
      "duration_seconds": 5.31,
      "text": "This week or next. The surgery will ring you. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.52,
      "end_seconds": 255.11,
      "duration_seconds": 1.59,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.62,
      "end_seconds": 268.02,
      "duration_seconds": 10.4,
      "text": "And I can help you stop, with a stop-smoking service, and medicines that make it much easier. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.66,
      "end_seconds": 272.35,
      "duration_seconds": 1.69,
      "text": "Maybe. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.91,
      "end_seconds": 282.71,
      "duration_seconds": 8.8,
      "text": "Think about it, no pressure. I'd like to see you once the tests are done, in two weeks."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 285.01,
      "end_seconds": 288.92,
      "duration_seconds": 3.91,
      "text": "I'll make sure he comes. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.98,
      "end_seconds": 301.12,
      "duration_seconds": 9.14,
      "text": "If you cough up blood, have chest pain, or get very breathless, come at once."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.52,
      "end_seconds": 306.04,
      "duration_seconds": 2.52,
      "text": "Right. Thank you. ~"
    }
  ]
}
