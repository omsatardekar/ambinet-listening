{
  "schema_version": "1.0",
  "encounter_id": "01519",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.63,
      "end_seconds": 4.58,
      "duration_seconds": 3.95,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.47,
      "end_seconds": 10.56,
      "duration_seconds": 5.09,
      "text": "Alright, not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.26,
      "end_seconds": 23.17,
      "duration_seconds": 10.91,
      "text": "I'm here because of a fall and pain in my left hip. Work has been very busy so I kept ignoring it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.07,
      "end_seconds": 31.35,
      "duration_seconds": 3.28,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.29,
      "end_seconds": 36.02,
      "duration_seconds": 2.73,
      "text": "I've had it for five days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.01,
      "end_seconds": 46.55,
      "duration_seconds": 8.54,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.75,
      "end_seconds": 57.35,
      "duration_seconds": 9.6,
      "text": "A eight out of ten, I suppose. Honestly, on and off. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.94,
      "end_seconds": 62.79,
      "duration_seconds": 3.85,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.77,
      "end_seconds": 74.07,
      "duration_seconds": 2.3,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.3,
      "end_seconds": 91.1,
      "duration_seconds": 7.8,
      "text": "Okay: pressure 125 over 74, temp 37.0 degrees, heart rate 64, oxygen saturation is 99 percent."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.55,
      "end_seconds": 97.12,
      "duration_seconds": 3.57,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.41,
      "end_seconds": 100.39,
      "duration_seconds": 1.98,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.34,
      "end_seconds": 119.62,
      "duration_seconds": 6.28,
      "text": "The left leg is shortened and turned outwards, and it is very painful to move."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.28,
      "end_seconds": 128.89,
      "duration_seconds": 3.61,
      "text": "Please sit back down. And numbness, any of that?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.86,
      "end_seconds": 132.51,
      "duration_seconds": 1.65,
      "text": "No, no numbness."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.63,
      "end_seconds": 139.97,
      "duration_seconds": 6.34,
      "text": "Alright, have you had any chest pain, head injury or loss of consciousness?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.81,
      "end_seconds": 148.57,
      "duration_seconds": 6.76,
      "text": "Okay, so no chest pain, head injury or loss of consciousness, none of it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.01,
      "end_seconds": 152.17,
      "duration_seconds": 3.16,
      "text": "I follow. Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.67,
      "end_seconds": 155.61,
      "duration_seconds": 1.94,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.55,
      "end_seconds": 160.47,
      "duration_seconds": 3.92,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.49,
      "end_seconds": 163.84,
      "duration_seconds": 1.35,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.09,
      "end_seconds": 178.26,
      "duration_seconds": 1.17,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.99,
      "end_seconds": 183.27,
      "duration_seconds": 3.28,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.8,
      "end_seconds": 186.25,
      "duration_seconds": 2.45,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.49,
      "end_seconds": 191.68,
      "duration_seconds": 4.19,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.67,
      "end_seconds": 211.2,
      "duration_seconds": 3.53,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.04,
      "end_seconds": 214.07,
      "duration_seconds": 2.03,
      "text": "I've got thin bones."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.91,
      "end_seconds": 216.65,
      "duration_seconds": 1.74,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.61,
      "end_seconds": 232.41,
      "duration_seconds": 2.8,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.29,
      "end_seconds": 248.86,
      "duration_seconds": 14.57,
      "text": "It's alendronate, 70 milligrams, once a week. I didn't want to make a fuss, you know. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.26,
      "end_seconds": 267.21,
      "duration_seconds": 16.95,
      "text": "Putting it all together, I'd lean towards a probable hip fracture. Just to be sure I understood. You've had a fall and pain in your left hip for five days, and no numbness or loss of consciousness."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.13,
      "end_seconds": 271.47,
      "duration_seconds": 2.34,
      "text": "That's what happened, yes."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.49,
      "end_seconds": 319.13,
      "duration_seconds": 33.64,
      "text": "I'm going to order blood tests, for pre-operative. An X-ray of the hip is what I'd like next, for hip fracture. We'll begin with morphine, 2.5 milligrams, now, single dose. That should help with hip pain. The pharmacy will go through the details again when you pick it up. Lie still, I am arranging an ambulance and pain relief. Let's get you seen by the orthopaedic team, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.92,
      "end_seconds": 323.58,
      "duration_seconds": 2.66,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.82,
      "end_seconds": 339.44,
      "duration_seconds": 14.62,
      "text": "If the symptoms get worse, or you feel really unwell, please come to the emergency department. I'll want another look straight away. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.38,
      "end_seconds": 345.43,
      "duration_seconds": 4.05,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.28,
      "end_seconds": 347.57,
      "duration_seconds": 1.29,
      "text": "Look after yourself."
    }
  ]
}