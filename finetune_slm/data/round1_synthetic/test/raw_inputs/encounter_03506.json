{
  "schema_version": "1.0",
  "encounter_id": "03506",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.34,
      "end_seconds": 3.72,
      "duration_seconds": 2.38,
      "text": "Good afternoon, uh, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.75,
      "end_seconds": 9.71,
      "duration_seconds": 3.96,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.53,
      "end_seconds": 15.54,
      "duration_seconds": 5.01,
      "text": "I've been dealing with an itchy red rash on the chest."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.13,
      "end_seconds": 19.97,
      "duration_seconds": 2.84,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.56,
      "end_seconds": 23.36,
      "duration_seconds": 2.8,
      "text": "Ever since... since yesterday, really."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.55,
      "end_seconds": 29.16,
      "duration_seconds": 4.61,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.74,
      "end_seconds": 37.57,
      "duration_seconds": 6.83,
      "text": "Erm, you know, it happens on and off. Pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.31,
      "end_seconds": 40.74,
      "duration_seconds": 2.43,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.81,
      "end_seconds": 49.54,
      "duration_seconds": 7.73,
      "text": "It usually comes with a mild temperature. The mild temperature? That's been for three weeks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.59,
      "end_seconds": 54.22,
      "duration_seconds": 2.63,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.19,
      "end_seconds": 57.42,
      "duration_seconds": 1.23,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.79,
      "end_seconds": 76.24,
      "duration_seconds": 1.45,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.33,
      "end_seconds": 80.11,
      "duration_seconds": 2.78,
      "text": "Erm, no, not at all."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.28,
      "end_seconds": 96.94,
      "duration_seconds": 7.66,
      "text": "Do you have any medical conditions I should know about? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.24,
      "end_seconds": 99.98,
      "duration_seconds": 1.74,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.7,
      "end_seconds": 104.08,
      "duration_seconds": 2.38,
      "text": "Right, how are your meals?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.59,
      "end_seconds": 109.74,
      "duration_seconds": 4.15,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.21,
      "end_seconds": 112.42,
      "duration_seconds": 1.21,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.1,
      "end_seconds": 117.47,
      "duration_seconds": 3.37,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.33,
      "end_seconds": 136.84,
      "duration_seconds": 4.51,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.46,
      "end_seconds": 140.77,
      "duration_seconds": 2.31,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.3,
      "end_seconds": 143.49,
      "duration_seconds": 1.19,
      "text": "What about blistering?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.45,
      "end_seconds": 149.2,
      "duration_seconds": 3.75,
      "text": "Okay, so not at all, no blistering."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.9,
      "end_seconds": 154.67,
      "duration_seconds": 4.77,
      "text": "Have you had any mouth sores, facial swelling or breathing difficulty?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.52,
      "end_seconds": 159.49,
      "duration_seconds": 3.97,
      "text": "No, uh, none of those at all."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.92,
      "end_seconds": 163.85,
      "duration_seconds": 3.93,
      "text": "I follow. Alright, how are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.5,
      "end_seconds": 168.25,
      "duration_seconds": 3.75,
      "text": "Bowels are regular, uh, nothing odd."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.09,
      "end_seconds": 172.96,
      "duration_seconds": 3.87,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.47,
      "end_seconds": 185.27,
      "duration_seconds": 2.8,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.71,
      "end_seconds": 208.5,
      "duration_seconds": 8.79,
      "text": "Okay: respiratory rate 18, oxygen saturation is 97 percent. And heart rate 78, BP is 120 over 68, temperature 36.5."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.52,
      "end_seconds": 214.29,
      "duration_seconds": 4.77,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.2,
      "end_seconds": 216.9,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.02,
      "end_seconds": 220.44,
      "duration_seconds": 2.42,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.31,
      "end_seconds": 246.38,
      "duration_seconds": 8.07,
      "text": "There is a fine pink rash across the chest and arms, with no blistering and the mouth is clear."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.55,
      "end_seconds": 251.21,
      "duration_seconds": 1.66,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.43,
      "end_seconds": 265.86,
      "duration_seconds": 6.43,
      "text": "Putting it all together, this looks most like a drug rash probably from allopurinol."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.17,
      "end_seconds": 269.23,
      "duration_seconds": 2.06,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.95,
      "end_seconds": 293.18,
      "duration_seconds": 22.23,
      "text": "I understand the worry. At the moment I'd say it's a drug rash probably from allopurinol, and we'll know more once the blood tests is back. I'm sending you for blood tests because of drug rash. You'll be taking cetirizine, 10 milligrams, once a day, one week. That's for itch."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.17,
      "end_seconds": 300.18,
      "duration_seconds": 2.01,
      "text": "Mm, uh, alright."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.01,
      "end_seconds": 311.45,
      "duration_seconds": 10.44,
      "text": "Please stop the allopurinol and don't restart it until we've spoken to the clinic. Please come and see me in three days."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.0,
      "end_seconds": 313.7,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.91,
      "end_seconds": 318.51,
      "duration_seconds": 3.6,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.48,
      "end_seconds": 323.42,
      "duration_seconds": 2.94,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}