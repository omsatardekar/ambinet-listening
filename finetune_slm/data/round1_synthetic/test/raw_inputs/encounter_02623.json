{
  "schema_version": "1.0",
  "encounter_id": "02623",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.08,
      "end_seconds": 6.82,
      "duration_seconds": 5.74,
      "text": "doctor, this one's ready for you everything's on the chart, but I'll go through it"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.72,
      "end_seconds": 10.99,
      "duration_seconds": 3.27,
      "text": "Thank you. Right, hello, what's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.62,
      "end_seconds": 19.09,
      "duration_seconds": 6.47,
      "text": "doctor, you know, I'm just here to help with the details"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.39,
      "end_seconds": 22.84,
      "duration_seconds": 2.45,
      "text": "absolutely, come and sit beside them"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 24.72,
      "end_seconds": 32.86,
      "duration_seconds": 8.14,
      "text": "erm, doctor, it's severe tummy pain out of proportion to the examination that's what we're worried about"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.69,
      "end_seconds": 38.11,
      "duration_seconds": 3.42,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 39.16,
      "end_seconds": 48.59,
      "duration_seconds": 9.43,
      "text": "Since Friday, that's when it began. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.31,
      "end_seconds": 52.09,
      "duration_seconds": 2.78,
      "text": "how strong would you say it is?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 53.04,
      "end_seconds": 54.31,
      "duration_seconds": 1.27,
      "text": "Mild, really"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 54.91,
      "end_seconds": 62.14,
      "duration_seconds": 7.23,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 62.24,
      "end_seconds": 68.44,
      "duration_seconds": 6.2,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.7,
      "end_seconds": 78.02,
      "duration_seconds": 4.32,
      "text": "Later, thanks. Please go on. Has there been vomiting too?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 81.33,
      "end_seconds": 82.92,
      "duration_seconds": 1.59,
      "text": "yeah, that too"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.89,
      "end_seconds": 86.65,
      "duration_seconds": 2.76,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 87.92,
      "end_seconds": 90.99,
      "duration_seconds": 3.07,
      "text": "About a four out of ten."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.55,
      "end_seconds": 97.89,
      "duration_seconds": 3.34,
      "text": "have you noticed chest pain, hernia or fever?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 98.67,
      "end_seconds": 111.91,
      "duration_seconds": 13.24,
      "text": "No, no chest pain, no hernia, no fever. I did have bloody diarrhoea at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.09,
      "end_seconds": 114.69,
      "duration_seconds": 1.6,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 116.74,
      "end_seconds": 118.76,
      "duration_seconds": 2.02,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.7,
      "end_seconds": 122.71,
      "duration_seconds": 3.01,
      "text": "So, has your skin been okay?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 123.35,
      "end_seconds": 126.99,
      "duration_seconds": 3.64,
      "text": "Nothing on the skin, um, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.89,
      "end_seconds": 147.72,
      "duration_seconds": 4.83,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 149.37,
      "end_seconds": 162.33,
      "duration_seconds": 12.96,
      "text": "I, I think I reacted to some antibiotic once, um, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.53,
      "end_seconds": 164.83,
      "duration_seconds": 1.3,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 166.77,
      "end_seconds": 171.26,
      "duration_seconds": 4.49,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.48,
      "end_seconds": 175.69,
      "duration_seconds": 3.21,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 177.41,
      "end_seconds": 180.34,
      "duration_seconds": 2.93,
      "text": "I live with my elderly mother"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.74,
      "end_seconds": 184.55,
      "duration_seconds": 2.81,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 186.07,
      "end_seconds": 191.84,
      "duration_seconds": 5.77,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.81,
      "end_seconds": 196.53,
      "duration_seconds": 2.72,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 197.92,
      "end_seconds": 208.71,
      "duration_seconds": 10.79,
      "text": "Yeah, I've got an irregular heartbeat. I kept putting it off, which I know isn't sensible. Yes, eczema."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.97,
      "end_seconds": 212.1,
      "duration_seconds": 2.13,
      "text": "okay, is there anything more?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.23,
      "end_seconds": 222.84,
      "duration_seconds": 9.61,
      "text": "Okay, I can see eczema in your file as well. Okay, can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 224.83,
      "end_seconds": 227.11,
      "duration_seconds": 2.28,
      "text": "Hydrocortisone cream, when needed."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 228.62,
      "end_seconds": 236.65,
      "duration_seconds": 8.03,
      "text": "She is supposed to take it when needed, but I can't say she always does."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 238.43,
      "end_seconds": 246.21,
      "duration_seconds": 7.78,
      "text": "Okay, so the vitals from earlier. BP is 121 over 72, heart rate 112, oxygen saturation is 99 percent."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.97,
      "end_seconds": 248.67,
      "duration_seconds": 0.7,
      "text": "thanks"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.19,
      "end_seconds": 252.16,
      "duration_seconds": 1.97,
      "text": "may I examine you now?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.61,
      "end_seconds": 254.83,
      "duration_seconds": 1.22,
      "text": "look straight ahead"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.77,
      "end_seconds": 273.99,
      "duration_seconds": 10.22,
      "text": "Your pulse is irregular, the tummy is soft but terribly painful, and the pain is out of proportion to what I find."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.24,
      "end_seconds": 281.82,
      "duration_seconds": 2.58,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.25,
      "end_seconds": 316.91,
      "duration_seconds": 25.66,
      "text": "I think urgent blood tests makes sense here, for severe abdominal pain. I think an urgent CT angiogram makes sense here, for possible bowel ischaemia. This is an emergency, you are going to hospital now. Let's get you seen by the surgical team, I'll arrange the letter. If the symptoms get worse, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 318.67,
      "end_seconds": 322.31,
      "duration_seconds": 3.64,
      "text": "Okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.56,
      "end_seconds": 326.24,
      "duration_seconds": 2.68,
      "text": "I'll want another look straight away"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 328.16,
      "end_seconds": 329.92,
      "duration_seconds": 1.76,
      "text": "yes, that's manageable"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.68,
      "end_seconds": 333.87,
      "duration_seconds": 3.19,
      "text": "anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 335.95,
      "end_seconds": 339.74,
      "duration_seconds": 3.79,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.26,
      "end_seconds": 342.48,
      "duration_seconds": 1.22,
      "text": "Look after yourself."
    }
  ]
}