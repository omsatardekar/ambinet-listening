{
  "schema_version": "1.0",
  "encounter_id": "03686",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.38,
      "end_seconds": 7.05,
      "duration_seconds": 5.67,
      "text": "Hi, you know, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.09,
      "end_seconds": 14.22,
      "duration_seconds": 4.13,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.28,
      "end_seconds": 21.5,
      "duration_seconds": 6.22,
      "text": "I wanted to get a milky discharge from my breasts looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.81,
      "end_seconds": 27.35,
      "duration_seconds": 4.54,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.44,
      "end_seconds": 32.22,
      "duration_seconds": 3.78,
      "text": "It's escitalopram, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.44,
      "end_seconds": 49.37,
      "duration_seconds": 3.93,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.0,
      "end_seconds": 52.79,
      "duration_seconds": 2.79,
      "text": "I've had it since last weekend."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.25,
      "end_seconds": 58.01,
      "duration_seconds": 4.76,
      "text": "Mm, okay. Have you had periods stopped for four months?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.88,
      "end_seconds": 65.96,
      "duration_seconds": 7.08,
      "text": "Yeah, I've had that since Friday. About periods stopped for four months, severe, really."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.04,
      "end_seconds": 71.82,
      "duration_seconds": 3.78,
      "text": "Have you had weight change, by any chance?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.4,
      "end_seconds": 77.78,
      "duration_seconds": 4.38,
      "text": "Let me think, not at all, no weight change."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.15,
      "end_seconds": 84.56,
      "duration_seconds": 5.41,
      "text": "Have you had any visual changes, hot flushes or positive pregnancy test?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.38,
      "end_seconds": 92.01,
      "duration_seconds": 6.63,
      "text": "No visual changes, hot flushes or positive pregnancy test, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.46,
      "end_seconds": 95.38,
      "duration_seconds": 2.92,
      "text": "Sure. Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.76,
      "end_seconds": 97.66,
      "duration_seconds": 0.9,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.3,
      "end_seconds": 120.92,
      "duration_seconds": 4.62,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.39,
      "end_seconds": 134.7,
      "duration_seconds": 12.31,
      "text": "Lots of rice, lentils and some fruit. I live with my elderly mother. I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.47,
      "end_seconds": 141.23,
      "duration_seconds": 4.76,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.21,
      "end_seconds": 146.19,
      "duration_seconds": 3.98,
      "text": "I have anxiety, for nearly five years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.08,
      "end_seconds": 149.84,
      "duration_seconds": 1.76,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.3,
      "end_seconds": 170.55,
      "duration_seconds": 3.25,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.63,
      "end_seconds": 179.82,
      "duration_seconds": 4.19,
      "text": "I'm allergic to walnuts, I get my lips swelling."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.12,
      "end_seconds": 193.95,
      "duration_seconds": 2.83,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.8,
      "end_seconds": 208.87,
      "duration_seconds": 3.07,
      "text": "So, bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.93,
      "end_seconds": 236.55,
      "duration_seconds": 7.62,
      "text": "Okay: pulse is 75 beats a minute, temperature 36.6, respiratory rate 17. And blood pressure 126 over 71."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.43,
      "end_seconds": 243.38,
      "duration_seconds": 3.95,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.83,
      "end_seconds": 248.06,
      "duration_seconds": 1.23,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.86,
      "end_seconds": 252.56,
      "duration_seconds": 2.7,
      "text": "Okay, raise your arm for me."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.85,
      "end_seconds": 274.24,
      "duration_seconds": 10.39,
      "text": "You are not pregnant by the urine test, the breasts express a little milk, and there is no visual field loss."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.37,
      "end_seconds": 279.96,
      "duration_seconds": 1.59,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.0,
      "end_seconds": 294.96,
      "duration_seconds": 9.96,
      "text": "That's all I needed to check. Okay, thinking it through, it fits best with raised prolactin or a thyroid problem rather than stress."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.37,
      "end_seconds": 299.62,
      "duration_seconds": 3.25,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.63,
      "end_seconds": 314.17,
      "duration_seconds": 13.54,
      "text": "Nothing I've seen today points to an emergency. It looks like raised prolactin or a thyroid problem rather than stress. Today I'm not changing anything. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.7,
      "end_seconds": 321.46,
      "duration_seconds": 3.76,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.99,
      "end_seconds": 324.93,
      "duration_seconds": 1.94,
      "text": "Have a good day."
    }
  ]
}