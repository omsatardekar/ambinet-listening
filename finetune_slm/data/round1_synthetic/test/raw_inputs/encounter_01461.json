{
  "schema_version": "1.0",
  "encounter_id": "01461",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.84,
      "end_seconds": 4.4,
      "duration_seconds": 3.56,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.85,
      "end_seconds": 11.12,
      "duration_seconds": 5.27,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.9,
      "end_seconds": 20.99,
      "duration_seconds": 7.09,
      "text": "Um, so... my face drooping on one side. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.9,
      "end_seconds": 24.88,
      "duration_seconds": 2.98,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.7,
      "end_seconds": 28.35,
      "duration_seconds": 1.65,
      "text": "Just since yesterday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.44,
      "end_seconds": 32.23,
      "duration_seconds": 2.79,
      "text": "Have you had a sudden headache?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.17,
      "end_seconds": 41.81,
      "duration_seconds": 7.64,
      "text": "Yeah. One week, I'd say. About sudden headache, I'd say a few times a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.73,
      "end_seconds": 50.21,
      "duration_seconds": 6.48,
      "text": "Have you had your face drooping on one side before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.03,
      "end_seconds": 56.21,
      "duration_seconds": 5.18,
      "text": "I had a similar thing last winter. It went away."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.22,
      "end_seconds": 76.96,
      "duration_seconds": 2.74,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.73,
      "end_seconds": 87.07,
      "duration_seconds": 2.34,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.62,
      "end_seconds": 123.8,
      "duration_seconds": 16.18,
      "text": "Okay: temperature is 36.6 degrees, blood pressure 144 over 88, pulse is 86 beats a minute, BMI works out to 19.9, weight 69 kilos, saturation 96 percent, height 186 centimetres."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.87,
      "end_seconds": 127.03,
      "duration_seconds": 2.16,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.92,
      "end_seconds": 128.9,
      "duration_seconds": 0.98,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.37,
      "end_seconds": 131.56,
      "duration_seconds": 1.19,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.05,
      "end_seconds": 152.77,
      "duration_seconds": 5.72,
      "text": "Your right face droops, your right arm is weak and your speech is slurred."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.05,
      "end_seconds": 155.54,
      "duration_seconds": 1.49,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.64,
      "end_seconds": 164.94,
      "duration_seconds": 6.3,
      "text": "You can sit up now. Have you had any fever, seizure or loss of consciousness?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.63,
      "end_seconds": 169.05,
      "duration_seconds": 2.42,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.46,
      "end_seconds": 174.43,
      "duration_seconds": 1.97,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.47,
      "end_seconds": 178.25,
      "duration_seconds": 2.78,
      "text": "Well, no, joints are fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.35,
      "end_seconds": 181.6,
      "duration_seconds": 2.25,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.1,
      "end_seconds": 184.49,
      "duration_seconds": 1.39,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.01,
      "end_seconds": 196.41,
      "duration_seconds": 1.4,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.01,
      "end_seconds": 199.59,
      "duration_seconds": 1.58,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.38,
      "end_seconds": 202.37,
      "duration_seconds": 1.99,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.2,
      "end_seconds": 207.6,
      "duration_seconds": 4.4,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.15,
      "end_seconds": 212.17,
      "duration_seconds": 3.02,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.83,
      "end_seconds": 216.07,
      "duration_seconds": 3.24,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.64,
      "end_seconds": 219.67,
      "duration_seconds": 2.03,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.48,
      "end_seconds": 224.03,
      "duration_seconds": 2.55,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.93,
      "end_seconds": 229.19,
      "duration_seconds": 3.26,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.27,
      "end_seconds": 234.71,
      "duration_seconds": 4.44,
      "text": "Yes, grass pollen, it gives me itchy eyes."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.63,
      "end_seconds": 239.28,
      "duration_seconds": 3.65,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.92,
      "end_seconds": 250.41,
      "duration_seconds": 9.49,
      "text": "Actually, uh, I take something called hydr... hydrochlorothiazide, 12.5 milligrams, maybe, every morning for my pressure."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.24,
      "end_seconds": 256.42,
      "duration_seconds": 4.18,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.46,
      "end_seconds": 262.5,
      "duration_seconds": 5.04,
      "text": "No, it's at home. Telmisartan I don't take anymore."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.56,
      "end_seconds": 284.0,
      "duration_seconds": 4.44,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.89,
      "end_seconds": 287.73,
      "duration_seconds": 2.84,
      "text": "I've had high blood pressure, yes."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.24,
      "end_seconds": 302.29,
      "duration_seconds": 14.05,
      "text": "Okay, go on. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Today I'm not changing anything. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.39,
      "end_seconds": 310.17,
      "duration_seconds": 5.78,
      "text": "Sorry, what was I saying, okay, that makes sense. Thanks for explaining."
    }
  ]
}