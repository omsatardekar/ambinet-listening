{
  "schema_version": "1.0",
  "encounter_id": "03569",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.83,
      "end_seconds": 6.75,
      "duration_seconds": 5.92,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.44,
      "end_seconds": 11.81,
      "duration_seconds": 4.37,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.97,
      "end_seconds": 22.03,
      "duration_seconds": 9.06,
      "text": "So, um, I've been losing weight, doctor. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.03,
      "end_seconds": 26.6,
      "duration_seconds": 3.57,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.22,
      "end_seconds": 34.75,
      "duration_seconds": 7.53,
      "text": "It's been going on for two days. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.54,
      "end_seconds": 40.06,
      "duration_seconds": 4.52,
      "text": "What about a poor appetite, have you noticed that?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.0,
      "end_seconds": 42.17,
      "duration_seconds": 1.17,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.2,
      "end_seconds": 45.88,
      "duration_seconds": 2.68,
      "text": "Any heat intolerance, sweating or tremor?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.57,
      "end_seconds": 53.1,
      "duration_seconds": 5.53,
      "text": "I, I haven't had heat intolerance, sweating or tremor, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.02,
      "end_seconds": 57.06,
      "duration_seconds": 2.04,
      "text": "Has there been any diarrhoea?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.41,
      "end_seconds": 62.86,
      "duration_seconds": 4.45,
      "text": "Not that I've noticed, you know, no diarrhoea."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.96,
      "end_seconds": 66.85,
      "duration_seconds": 2.89,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.61,
      "end_seconds": 68.59,
      "duration_seconds": 0.98,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.67,
      "end_seconds": 73.02,
      "duration_seconds": 2.35,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.25,
      "end_seconds": 75.88,
      "duration_seconds": 1.63,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.7,
      "end_seconds": 78.64,
      "duration_seconds": 1.94,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.7,
      "end_seconds": 83.47,
      "duration_seconds": 2.77,
      "text": "Eczema, for about a year."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.97,
      "end_seconds": 84.67,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.92,
      "end_seconds": 102.78,
      "duration_seconds": 2.86,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.4,
      "end_seconds": 116.9,
      "duration_seconds": 12.5,
      "text": "I'm a bus driver, so I sit for long hours. I swim twice a week. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.28,
      "end_seconds": 134.54,
      "duration_seconds": 5.26,
      "text": "Let's run through your medicines. I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.39,
      "end_seconds": 141.33,
      "duration_seconds": 4.94,
      "text": "I'm on hydrocortisone cream, when needed for the eczema."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.56,
      "end_seconds": 142.26,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.2,
      "end_seconds": 159.45,
      "duration_seconds": 3.25,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.77,
      "end_seconds": 174.89,
      "duration_seconds": 2.12,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.65,
      "end_seconds": 200.89,
      "duration_seconds": 7.24,
      "text": "Okay: pressure 123 over 85, weight 56 kilos, pulse 126. And respiratory rate 20, height 180 centimetres."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.63,
      "end_seconds": 203.63,
      "duration_seconds": 2.0,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.63,
      "end_seconds": 207.76,
      "duration_seconds": 2.13,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.79,
      "end_seconds": 211.96,
      "duration_seconds": 2.17,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.4,
      "end_seconds": 216.48,
      "duration_seconds": 3.08,
      "text": "Okay, I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.89,
      "end_seconds": 238.68,
      "duration_seconds": 4.79,
      "text": "Your pulse is fast and irregular and the thyroid feels slightly enlarged."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.26,
      "end_seconds": 245.24,
      "duration_seconds": 2.98,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.55,
      "end_seconds": 291.32,
      "duration_seconds": 34.77,
      "text": "Taking everything into account, I'd lean towards an overactive thyroid with atrial fibrillation, in an apathetic older patient. Let's book an ECG to look into irregular pulse. It is easy to miss in older people because they seem sleepy rather than hot and shaky. If it hasn't settled next month, we'd think about a thyroid test, but not now. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.77,
      "end_seconds": 301.16,
      "duration_seconds": 8.39,
      "text": "Please come and see me after the results. Before we finish, can you repeat the plan back to me?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.48,
      "end_seconds": 307.34,
      "duration_seconds": 4.86,
      "text": "So, I come back after the results. Is that right?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.89,
      "end_seconds": 314.25,
      "duration_seconds": 5.36,
      "text": "Yes, exactly right. Okay, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.87,
      "end_seconds": 316.51,
      "duration_seconds": 1.64,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.33,
      "end_seconds": 319.69,
      "duration_seconds": 1.36,
      "text": "Goodbye for now."
    }
  ]
}