{
  "schema_version": "1.0",
  "encounter_id": "03296",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.63,
      "end_seconds": 6.39,
      "duration_seconds": 5.76,
      "text": "Hi there, the chair's free, sit down. Did you find the place alright?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.76,
      "end_seconds": 13.99,
      "duration_seconds": 6.23,
      "text": "yes, it was easy enough the parking was the hard part"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.06,
      "end_seconds": 18.43,
      "duration_seconds": 2.37,
      "text": "what's the the main thing today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 20.35,
      "end_seconds": 27.29,
      "duration_seconds": 6.94,
      "text": "It's a yellow discharge. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.7,
      "end_seconds": 31.81,
      "duration_seconds": 3.11,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.44,
      "end_seconds": 42.74,
      "duration_seconds": 9.3,
      "text": "Erm, it's been going on for two weeks. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.54,
      "end_seconds": 48.53,
      "duration_seconds": 3.99,
      "text": "Any a red sore wound after your operation as well?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.48,
      "end_seconds": 58.62,
      "duration_seconds": 9.14,
      "text": "yes, you know, for two months. I had pain around the wound before. That's settled now, though"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.22,
      "end_seconds": 64.67,
      "duration_seconds": 4.45,
      "text": "What conditions have you been treated for in the the past?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.51,
      "end_seconds": 68.11,
      "duration_seconds": 1.6,
      "text": "Yes, acid reflux."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.03,
      "end_seconds": 79.76,
      "duration_seconds": 2.73,
      "text": "do you work outside the home?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 81.1,
      "end_seconds": 85.62,
      "duration_seconds": 4.52,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.42,
      "end_seconds": 89.28,
      "duration_seconds": 1.86,
      "text": "how active are you?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 90.25,
      "end_seconds": 94.23,
      "duration_seconds": 3.98,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.31,
      "end_seconds": 99.75,
      "duration_seconds": 4.44,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.04,
      "end_seconds": 106.1,
      "duration_seconds": 5.06,
      "text": "Yes, plasters, it gives me a red itchy rash."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.31,
      "end_seconds": 109.38,
      "duration_seconds": 2.07,
      "text": "tell me your medicines, please"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.38,
      "end_seconds": 114.1,
      "duration_seconds": 3.72,
      "text": "I take pantoprazole, 40 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.86,
      "end_seconds": 117.23,
      "duration_seconds": 1.37,
      "text": "is that long-standing?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.05,
      "end_seconds": 125.57,
      "duration_seconds": 6.52,
      "text": "About about a year. Let me think, I take paracetamol, when needed."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.12,
      "end_seconds": 129.1,
      "duration_seconds": 1.98,
      "text": "how much do you take?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.51,
      "end_seconds": 132.57,
      "duration_seconds": 2.06,
      "text": "It's, It's 1 gram."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.52,
      "end_seconds": 137.34,
      "duration_seconds": 2.82,
      "text": "How long have you taken that?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.25,
      "end_seconds": 146.69,
      "duration_seconds": 7.44,
      "text": "Nearly five years now. Ah, I used to take lansoprazole, but I stopped it."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.95,
      "end_seconds": 159.28,
      "duration_seconds": 1.33,
      "text": "any chest pain?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.47,
      "end_seconds": 162.72,
      "duration_seconds": 2.25,
      "text": "No chest pain, thankfully."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.42,
      "end_seconds": 168.41,
      "duration_seconds": 4.99,
      "text": "Let me check a few things. Any vomiting, breathlessness or calf pain?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.77,
      "end_seconds": 175.32,
      "duration_seconds": 5.55,
      "text": "I haven't had vomiting, breathlessness or calf pain, no."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.58,
      "end_seconds": 179.17,
      "duration_seconds": 2.59,
      "text": "okay, your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 183.13,
      "end_seconds": 187.04,
      "duration_seconds": 3.91,
      "text": "I mean, no, my breathing's been fine"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.09,
      "end_seconds": 190.98,
      "duration_seconds": 2.89,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.72,
      "end_seconds": 205.78,
      "duration_seconds": 3.06,
      "text": "That's it, just a a little longer..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.34,
      "end_seconds": 226.08,
      "duration_seconds": 7.74,
      "text": "Okay: respiratory rate 19, blood pressure 123 over 74, heart rate 99, temperature is 38.5 degrees."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.18,
      "end_seconds": 231.94,
      "duration_seconds": 4.76,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.63,
      "end_seconds": 236.7,
      "duration_seconds": 3.07,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.64,
      "end_seconds": 253.87,
      "duration_seconds": 8.23,
      "text": "The lower part of the wound is red, hot and weeping pus, and and the edges have not come together."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.41,
      "end_seconds": 267.33,
      "duration_seconds": 10.92,
      "text": "That's the examination finished. Having listened and examined, the most likely explanation is a surgical wound infection. A stitch abscess is still possible."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 268.36,
      "end_seconds": 271.36,
      "duration_seconds": 3.0,
      "text": "Erm, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.92,
      "end_seconds": 293.08,
      "duration_seconds": 21.16,
      "text": "I understand the worry. At the moment I'd say it's a surgical wound infection, and we'll know more once the a wound swab is back. So, to recap quickly. You've had a yellow discharge for two weeks, and no vomiting or calf pain."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 295.07,
      "end_seconds": 295.77,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.26,
      "end_seconds": 338.83,
      "duration_seconds": 32.57,
      "text": "A wound swab is what I'd like next, for wound infection. I'd rather check than guess, and this is the quickest way to know more. We should do blood tests for wound infection. I'll start you on flucloxacillin, 500 milligrams, four times a day, seven days. That should help with wound infection. It's a commonly used medicine and most people tolerate it well. Keep it clean and dry and use fresh dressings daily."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 339.84,
      "end_seconds": 359.08,
      "duration_seconds": 19.24,
      "text": "don't skip meals, and try to eat smaller portions more often through the day please don't wait if the symptoms get worse that's when to be seen urgently right, that's the plan do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 360.11,
      "end_seconds": 363.36,
      "duration_seconds": 3.25,
      "text": "uh, thank you, doctor, goodbye"
    }
  ]
}