{
  "schema_version": "1.0",
  "encounter_id": "01360",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.0,
      "end_seconds": 8.17,
      "duration_seconds": 7.17,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.97,
      "end_seconds": 14.28,
      "duration_seconds": 5.31,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.86,
      "end_seconds": 18.17,
      "duration_seconds": 3.31,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.36,
      "end_seconds": 23.8,
      "duration_seconds": 4.44,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 25.19,
      "end_seconds": 31.02,
      "duration_seconds": 5.83,
      "text": "Well, we came because of a dry cough in the evenings."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.08,
      "end_seconds": 34.74,
      "duration_seconds": 2.66,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.44,
      "end_seconds": 44.44,
      "duration_seconds": 3.0,
      "text": "Right, that's it, just a little longer..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.84,
      "end_seconds": 69.98,
      "duration_seconds": 8.14,
      "text": "Okay: BP is 111 over 76, temperature 36.9, heart rate 84, saturation 97 percent, respiratory rate 18."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.77,
      "end_seconds": 89.35,
      "duration_seconds": 3.58,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.1,
      "end_seconds": 92.66,
      "duration_seconds": 2.56,
      "text": "It's been six months now."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.06,
      "end_seconds": 103.01,
      "duration_seconds": 8.95,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.78,
      "end_seconds": 129.05,
      "duration_seconds": 24.27,
      "text": "It's every other day. A seven out of ten, I suppose. I get some relief from antihistamine. Pollen season definitely sets it off. And itchy eyes, too. I did have sneezing fits at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.95,
      "end_seconds": 138.91,
      "duration_seconds": 7.96,
      "text": "Alright, have you had a dry cough in the evenings before, or is this the first time?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.91,
      "end_seconds": 147.28,
      "duration_seconds": 7.37,
      "text": "A bit, a couple of years ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.02,
      "end_seconds": 152.19,
      "duration_seconds": 4.17,
      "text": "So, have you noticed fever, wheeze or shortness of breath?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.08,
      "end_seconds": 159.75,
      "duration_seconds": 5.67,
      "text": "No fever, wheeze or shortness of breath, none of it."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.55,
      "end_seconds": 165.06,
      "duration_seconds": 4.51,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.12,
      "end_seconds": 169.22,
      "duration_seconds": 3.1,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.02,
      "end_seconds": 175.8,
      "duration_seconds": 4.78,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.64,
      "end_seconds": 181.83,
      "duration_seconds": 4.19,
      "text": "Let me think, no, nothing like that."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.7,
      "end_seconds": 186.45,
      "duration_seconds": 2.75,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.1,
      "end_seconds": 189.93,
      "duration_seconds": 1.83,
      "text": "Yes, acid reflux."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.72,
      "end_seconds": 196.66,
      "duration_seconds": 4.94,
      "text": "Okay, I can see acid reflux in your file as well."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.76,
      "end_seconds": 215.05,
      "duration_seconds": 3.29,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.08,
      "end_seconds": 227.17,
      "duration_seconds": 11.09,
      "text": "Pantoprazole, 40 milligrams, before breakfast for my acidity. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.22,
      "end_seconds": 230.47,
      "duration_seconds": 1.25,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.33,
      "end_seconds": 236.46,
      "duration_seconds": 4.13,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.84,
      "end_seconds": 243.81,
      "duration_seconds": 3.97,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.12,
      "end_seconds": 253.52,
      "duration_seconds": 4.4,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.67,
      "end_seconds": 256.5,
      "duration_seconds": 1.83,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.05,
      "end_seconds": 261.86,
      "duration_seconds": 3.81,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.45,
      "end_seconds": 270.1,
      "duration_seconds": 2.65,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.12,
      "end_seconds": 276.62,
      "duration_seconds": 5.5,
      "text": "I had keyhole surgery on my gallbladder two years back."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.88,
      "end_seconds": 281.18,
      "duration_seconds": 3.3,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.87,
      "end_seconds": 284.04,
      "duration_seconds": 1.17,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.08,
      "end_seconds": 296.45,
      "duration_seconds": 5.37,
      "text": "Your chest is clear and your nose looks a little swollen inside."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.72,
      "end_seconds": 321.03,
      "duration_seconds": 19.31,
      "text": "That's the examination finished. Right, here's what I'm thinking. I think we're dealing with seasonal hay fever causing the cough at this stage. I'd like you to take fluticasone nasal spray, 50 micrograms, once a day, for the season. That should help with hay fever."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.14,
      "end_seconds": 324.99,
      "duration_seconds": 2.85,
      "text": "Thank you, um, doctor."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.99,
      "end_seconds": 328.4,
      "duration_seconds": 2.41,
      "text": "Book a review in a month."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.21,
      "end_seconds": 331.17,
      "duration_seconds": 1.96,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.36,
      "end_seconds": 335.73,
      "duration_seconds": 3.37,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.15,
      "end_seconds": 340.39,
      "duration_seconds": 3.24,
      "text": "So, thank you, that's helpful."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.18,
      "end_seconds": 342.45,
      "duration_seconds": 1.27,
      "text": "Take care now."
    }
  ]
}