{
  "schema_version": "1.0",
  "encounter_id": "03556",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.84,
      "end_seconds": 4.98,
      "duration_seconds": 4.14,
      "text": "Morning, come on through. How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.98,
      "end_seconds": 13.05,
      "duration_seconds": 7.07,
      "text": "Ah, you know, so the thing is, I've got breathlessness during sport."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.53,
      "end_seconds": 17.53,
      "duration_seconds": 3.0,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.33,
      "end_seconds": 22.59,
      "duration_seconds": 3.26,
      "text": "Since Monday, that's when it began."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.31,
      "end_seconds": 25.25,
      "duration_seconds": 1.94,
      "text": "What brings it on?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.24,
      "end_seconds": 30.55,
      "duration_seconds": 4.31,
      "text": "Hmm, yes, sport. That makes it worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.18,
      "end_seconds": 38.02,
      "duration_seconds": 2.84,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 39.86,
      "end_seconds": 41.04,
      "duration_seconds": 1.18,
      "text": "Mild, really."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.05,
      "end_seconds": 46.36,
      "duration_seconds": 3.31,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.94,
      "end_seconds": 54.74,
      "duration_seconds": 7.8,
      "text": "When it starts I tend to get a cousin who died suddenly as well."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.3,
      "end_seconds": 63.14,
      "duration_seconds": 2.84,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.2,
      "end_seconds": 68.04,
      "duration_seconds": 3.84,
      "text": "Just part of my thyroid removed, years back."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.54,
      "end_seconds": 75.23,
      "duration_seconds": 2.69,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.3,
      "end_seconds": 79.14,
      "duration_seconds": 2.84,
      "text": "Low haemoglobin, for about a year."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.06,
      "end_seconds": 80.95,
      "duration_seconds": 0.89,
      "text": "Anything else?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 81.86,
      "end_seconds": 83.23,
      "duration_seconds": 1.37,
      "text": "I have depression."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.27,
      "end_seconds": 90.67,
      "duration_seconds": 6.4,
      "text": "Mm, okay. Alright, low haemoglobin and depression, that matches what I have here."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.55,
      "end_seconds": 110.79,
      "duration_seconds": 4.24,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.38,
      "end_seconds": 114.11,
      "duration_seconds": 2.73,
      "text": "Iron tablets, once a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.57,
      "end_seconds": 115.27,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.21,
      "end_seconds": 122.12,
      "duration_seconds": 4.91,
      "text": "Mirtazapine. I take it at night for my mood."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.43,
      "end_seconds": 125.76,
      "duration_seconds": 2.33,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 127.44,
      "end_seconds": 128.91,
      "duration_seconds": 1.47,
      "text": "It's 15 milligrams."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.67,
      "end_seconds": 147.5,
      "duration_seconds": 4.83,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.16,
      "end_seconds": 160.91,
      "duration_seconds": 12.75,
      "text": "I do a yoga class on Thursdays. I work in accounts at a hospital. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.69,
      "end_seconds": 168.91,
      "duration_seconds": 4.22,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.96,
      "end_seconds": 174.08,
      "duration_seconds": 3.12,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.74,
      "end_seconds": 178.36,
      "duration_seconds": 3.62,
      "text": "Did you get leg swelling, fever or fainting?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 179.29,
      "end_seconds": 181.92,
      "duration_seconds": 2.63,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 183.07,
      "end_seconds": 186.15,
      "duration_seconds": 3.08,
      "text": "Have you had cough, by any chance?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 186.66,
      "end_seconds": 189.76,
      "duration_seconds": 3.1,
      "text": "Not that I've noticed, no cough."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.64,
      "end_seconds": 193.88,
      "duration_seconds": 2.24,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 195.13,
      "end_seconds": 197.19,
      "duration_seconds": 2.06,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.58,
      "end_seconds": 200.67,
      "duration_seconds": 2.09,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 202.19,
      "end_seconds": 203.77,
      "duration_seconds": 1.58,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.69,
      "end_seconds": 208.57,
      "duration_seconds": 3.88,
      "text": "Alright, time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.81,
      "end_seconds": 224.05,
      "duration_seconds": 2.24,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.43,
      "end_seconds": 257.03,
      "duration_seconds": 16.6,
      "text": "Okay: pulse 73, pressure 108 over 71, temperature 36.6, respiratory rate 17, saturation 97 percent. Okay, so my impression from what you've said is this: This is probably possible hypertrophic cardiomyopathy. We shouldn't forget athlete's heart."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 258.53,
      "end_seconds": 260.65,
      "duration_seconds": 2.12,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.06,
      "end_seconds": 272.4,
      "duration_seconds": 10.34,
      "text": "I understand the worry. At the moment I'd say it's possible hypertrophic cardiomyopathy, and we'll know more once the a heart monitor is back."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 287.27,
      "end_seconds": 293.44,
      "duration_seconds": 6.17,
      "text": "Let's book a heart monitor to look into palpitations. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 294.83,
      "end_seconds": 297.07,
      "duration_seconds": 2.24,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.3,
      "end_seconds": 302.59,
      "duration_seconds": 1.29,
      "text": "Take care now."
    }
  ]
}