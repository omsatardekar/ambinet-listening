{
  "schema_version": "1.0",
  "encounter_id": "03507",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.77,
      "end_seconds": 6.19,
      "duration_seconds": 5.42,
      "text": "Hello, take a seat, I'll be with you in a second."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.3,
      "end_seconds": 8.55,
      "duration_seconds": 1.25,
      "text": "Hello, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.16,
      "end_seconds": 10.73,
      "duration_seconds": 1.57,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.61,
      "end_seconds": 24.44,
      "duration_seconds": 11.83,
      "text": "Um, so the thing is, I've got a sore spot on the front of my shin. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.63,
      "end_seconds": 29.5,
      "duration_seconds": 3.87,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.06,
      "end_seconds": 34.5,
      "duration_seconds": 3.44,
      "text": "Since last weekend, that's when it began."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.71,
      "end_seconds": 45.74,
      "duration_seconds": 11.03,
      "text": "Mm-hmm. Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.15,
      "end_seconds": 56.22,
      "duration_seconds": 6.07,
      "text": "It's once or twice a day. It feels mild to me."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 58.3,
      "end_seconds": 59.76,
      "duration_seconds": 1.46,
      "text": "What about fever?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.43,
      "end_seconds": 67.33,
      "duration_seconds": 2.9,
      "text": "No, I haven't had any fever."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.51,
      "end_seconds": 70.6,
      "duration_seconds": 2.09,
      "text": "Any swelling, injury or numbness?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.26,
      "end_seconds": 79.11,
      "duration_seconds": 3.85,
      "text": "I haven't had swelling, injury or numbness, no."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.72,
      "end_seconds": 84.16,
      "duration_seconds": 4.44,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 85.63,
      "end_seconds": 87.0,
      "duration_seconds": 1.37,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.93,
      "end_seconds": 90.74,
      "duration_seconds": 2.81,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.43,
      "end_seconds": 93.86,
      "duration_seconds": 2.43,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.9,
      "end_seconds": 99.99,
      "duration_seconds": 4.09,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.71,
      "end_seconds": 107.13,
      "duration_seconds": 3.42,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.99,
      "end_seconds": 111.08,
      "duration_seconds": 2.09,
      "text": "Okay, any previous surgeries?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 112.45,
      "end_seconds": 115.37,
      "duration_seconds": 2.92,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.72,
      "end_seconds": 119.71,
      "duration_seconds": 2.99,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.35,
      "end_seconds": 125.6,
      "duration_seconds": 5.25,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.55,
      "end_seconds": 128.93,
      "duration_seconds": 2.38,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.54,
      "end_seconds": 134.53,
      "duration_seconds": 3.99,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.92,
      "end_seconds": 139.22,
      "duration_seconds": 3.3,
      "text": "Alright, do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.96,
      "end_seconds": 143.75,
      "duration_seconds": 3.79,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.56,
      "end_seconds": 165.75,
      "duration_seconds": 4.19,
      "text": "do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.15,
      "end_seconds": 171.1,
      "duration_seconds": 3.95,
      "text": "Trimethoprim. I come out in... well, a rash."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.18,
      "end_seconds": 192.83,
      "duration_seconds": 3.65,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 194.41,
      "end_seconds": 204.87,
      "duration_seconds": 10.46,
      "text": "Ibuprofen. I take it 400 milligrams, when needed. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.93,
      "end_seconds": 218.66,
      "duration_seconds": 3.73,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.99,
      "end_seconds": 229.12,
      "duration_seconds": 2.13,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.37,
      "end_seconds": 252.39,
      "duration_seconds": 10.02,
      "text": "Okay: height 177 centimetres, temp 36.7 degrees, pressure 121 over 77, pulse is 67 beats a minute, weight 88 kilos."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.56,
      "end_seconds": 269.08,
      "duration_seconds": 6.52,
      "text": "putting together what you've described, it points towards a possible stress fracture rather than shin splints"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 269.87,
      "end_seconds": 271.9,
      "duration_seconds": 2.03,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.91,
      "end_seconds": 304.97,
      "duration_seconds": 32.06,
      "text": "I can't promise yet, but most people with a possible stress fracture rather than shin splints do well once it's treated properly. I'll request a vitamin D level, it'll help with stress fracture. Stop running, no impact exercise until the scan, swimming or cycling is fine. If the symptoms get worse, that's the point to come in urgently. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 306.25,
      "end_seconds": 309.13,
      "duration_seconds": 2.88,
      "text": "no, that's all thanks a lot"
    }
  ]
}