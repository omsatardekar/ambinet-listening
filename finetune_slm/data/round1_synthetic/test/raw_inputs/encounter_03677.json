{
  "schema_version": "1.0",
  "encounter_id": "03677",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.35,
      "end_seconds": 8.0,
      "duration_seconds": 6.65,
      "text": "Right, thanks for waiting, come in. What would you like to start with today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.12,
      "end_seconds": 14.37,
      "duration_seconds": 5.25,
      "text": "Doctor, it's a poor appetite. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.31,
      "end_seconds": 18.42,
      "duration_seconds": 2.11,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 20.47,
      "end_seconds": 23.43,
      "duration_seconds": 2.96,
      "text": "I've had it for two days."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.97,
      "end_seconds": 31.16,
      "duration_seconds": 3.19,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.37,
      "end_seconds": 40.19,
      "duration_seconds": 7.82,
      "text": "Ah, it usually comes with an irregular heartbeat. The irregular heartbeat? That's been for ten days."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.95,
      "end_seconds": 44.55,
      "duration_seconds": 2.6,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.4,
      "end_seconds": 60.94,
      "duration_seconds": 14.54,
      "text": "Maybe a six out of ten on a bad day. As for feeling weak, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.35,
      "end_seconds": 65.79,
      "duration_seconds": 3.44,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.66,
      "end_seconds": 73.18,
      "duration_seconds": 2.52,
      "text": "I've had high cholesterol, yes."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.26,
      "end_seconds": 79.63,
      "duration_seconds": 4.37,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.38,
      "end_seconds": 83.99,
      "duration_seconds": 3.61,
      "text": "Uh, I've never had an allergy."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.21,
      "end_seconds": 105.5,
      "duration_seconds": 3.29,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.59,
      "end_seconds": 111.25,
      "duration_seconds": 3.66,
      "text": "It's atorvastatin, 20 milligrams, maybe, at night."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.06,
      "end_seconds": 115.81,
      "duration_seconds": 3.75,
      "text": "So, is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.51,
      "end_seconds": 121.75,
      "duration_seconds": 4.24,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.43,
      "end_seconds": 124.62,
      "duration_seconds": 1.19,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 126.18,
      "end_seconds": 129.14,
      "duration_seconds": 2.96,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.03,
      "end_seconds": 134.08,
      "duration_seconds": 4.05,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.85,
      "end_seconds": 138.15,
      "duration_seconds": 3.3,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.74,
      "end_seconds": 141.53,
      "duration_seconds": 1.79,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.58,
      "end_seconds": 145.93,
      "duration_seconds": 2.35,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.7,
      "end_seconds": 156.93,
      "duration_seconds": 3.23,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.71,
      "end_seconds": 166.43,
      "duration_seconds": 7.72,
      "text": "Yes, I had a cataract operation in my left eye, about a year ago."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.1,
      "end_seconds": 168.91,
      "duration_seconds": 1.81,
      "text": "Any tremor or diarrhoea?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.91,
      "end_seconds": 176.71,
      "duration_seconds": 6.8,
      "text": "Sorry, what was I saying, I haven't had tremor or diarrhoea, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.37,
      "end_seconds": 181.73,
      "duration_seconds": 3.36,
      "text": "Okay, did you get heat intolerance or sweating?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 182.55,
      "end_seconds": 186.5,
      "duration_seconds": 3.95,
      "text": "Let me think, no, none that I've noticed."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.14,
      "end_seconds": 189.52,
      "duration_seconds": 2.38,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 191.45,
      "end_seconds": 194.27,
      "duration_seconds": 2.82,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.1,
      "end_seconds": 198.19,
      "duration_seconds": 2.09,
      "text": "So, how's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 199.07,
      "end_seconds": 201.16,
      "duration_seconds": 2.09,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.02,
      "end_seconds": 205.67,
      "duration_seconds": 2.65,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.78,
      "end_seconds": 219.72,
      "duration_seconds": 2.94,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.98,
      "end_seconds": 241.87,
      "duration_seconds": 10.89,
      "text": "Okay: temperature 36.9, height 162 centimetres, blood pressure 116 over 78, pulse is 121 beats a minute, oxygen saturation is 96 percent, weight 95 kilos."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 243.35,
      "end_seconds": 244.84,
      "duration_seconds": 1.49,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.82,
      "end_seconds": 248.95,
      "duration_seconds": 3.13,
      "text": "So, I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.08,
      "end_seconds": 252.72,
      "duration_seconds": 2.64,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.96,
      "end_seconds": 256.25,
      "duration_seconds": 2.29,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.51,
      "end_seconds": 279.3,
      "duration_seconds": 4.79,
      "text": "Your pulse is fast and irregular and the thyroid feels slightly enlarged."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.98,
      "end_seconds": 287.37,
      "duration_seconds": 2.39,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 305.59,
      "end_seconds": 342.29,
      "duration_seconds": 36.7,
      "text": "I'm sending you for a thyroid test because of weight loss and irregular pulse. I think an ECG makes sense here, for irregular pulse. I'd rather check than guess, and this is the quickest way to know more. It is easy to miss in older people because they seem sleepy rather than hot and shaky. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 346.82,
      "end_seconds": 349.47,
      "duration_seconds": 2.65,
      "text": "Yeah, thank you, that's clear."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 350.68,
      "end_seconds": 357.81,
      "duration_seconds": 7.13,
      "text": "Book a review after the results. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 359.21,
      "end_seconds": 362.39,
      "duration_seconds": 3.18,
      "text": "Thank you, um, doctor, goodbye."
    }
  ]
}