{
  "schema_version": "1.0",
  "encounter_id": "03189",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.89,
      "end_seconds": 4.51,
      "duration_seconds": 3.62,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.4,
      "end_seconds": 11.17,
      "duration_seconds": 4.77,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.2,
      "end_seconds": 18.14,
      "duration_seconds": 4.94,
      "text": "It's a red sore wound after my operation, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.18,
      "end_seconds": 21.12,
      "duration_seconds": 1.94,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.97,
      "end_seconds": 24.8,
      "duration_seconds": 1.83,
      "text": "Probably six months. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.27,
      "end_seconds": 29.55,
      "duration_seconds": 3.28,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.33,
      "end_seconds": 35.3,
      "duration_seconds": 4.97,
      "text": "Actually, I'd give it a three, out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.02,
      "end_seconds": 41.59,
      "duration_seconds": 4.57,
      "text": "Any breathlessness, calf pain or chest pain at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.51,
      "end_seconds": 48.43,
      "duration_seconds": 5.92,
      "text": "I haven't had breathlessness, calf pain or chest pain, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.09,
      "end_seconds": 52.96,
      "duration_seconds": 2.87,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.45,
      "end_seconds": 59.94,
      "duration_seconds": 2.49,
      "text": "Yeah, no problems with breathing."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.58,
      "end_seconds": 73.04,
      "duration_seconds": 2.46,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.63,
      "end_seconds": 77.42,
      "duration_seconds": 2.79,
      "text": "Paracetamol. I take it when needed."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.34,
      "end_seconds": 80.86,
      "duration_seconds": 2.52,
      "text": "Right, do you know the dose?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.78,
      "end_seconds": 83.25,
      "duration_seconds": 1.47,
      "text": "It's 1 gram."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.28,
      "end_seconds": 86.28,
      "duration_seconds": 2.0,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.22,
      "end_seconds": 91.13,
      "duration_seconds": 3.91,
      "text": "I have heart failure, for about ten years."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.98,
      "end_seconds": 93.76,
      "duration_seconds": 1.78,
      "text": "Alright, and besides that?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.45,
      "end_seconds": 99.56,
      "duration_seconds": 4.11,
      "text": "Oh, I have high cholesterol, for two years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.14,
      "end_seconds": 105.46,
      "duration_seconds": 5.32,
      "text": "Okay, I can see heart failure in your file as well."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.56,
      "end_seconds": 120.94,
      "duration_seconds": 4.38,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.72,
      "end_seconds": 128.04,
      "duration_seconds": 5.32,
      "text": "I'm allergic to amoxicillin, I get a rash all over."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.75,
      "end_seconds": 134.37,
      "duration_seconds": 4.62,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.93,
      "end_seconds": 155.28,
      "duration_seconds": 19.35,
      "text": "I'll have a glass of wine with dinner. I've never touched a cigarette. I hardly move around during the day. I drink a lot of tea and snack through the day. I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.02,
      "end_seconds": 175.47,
      "duration_seconds": 3.45,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.84,
      "end_seconds": 186.28,
      "duration_seconds": 2.44,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.2,
      "end_seconds": 212.15,
      "duration_seconds": 13.95,
      "text": "Okay: pulse is 96 beats a minute, BMI works out to 32.8, temp 38.6 degrees, height 160 centimetres, respiratory rate 16, blood pressure 122 over 68, weight 84 kilos."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.67,
      "end_seconds": 215.59,
      "duration_seconds": 2.92,
      "text": "Is that alright, um, doctor?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.58,
      "end_seconds": 221.69,
      "duration_seconds": 2.11,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.59,
      "end_seconds": 225.98,
      "duration_seconds": 2.39,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.99,
      "end_seconds": 228.99,
      "duration_seconds": 2.0,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.54,
      "end_seconds": 249.0,
      "duration_seconds": 9.46,
      "text": "The lower part of the wound is red, hot and weeping pus, and the edges have not come together."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.54,
      "end_seconds": 254.64,
      "duration_seconds": 3.1,
      "text": "Okay, that's all I needed to check."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.73,
      "end_seconds": 269.29,
      "duration_seconds": 4.56,
      "text": "Putting it all together, I'd lean towards a surgical wound infection."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.98,
      "end_seconds": 271.39,
      "duration_seconds": 1.41,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.15,
      "end_seconds": 293.33,
      "duration_seconds": 21.18,
      "text": "Nothing I've seen today points to an emergency. It looks like a surgical wound infection, but I'd like to confirm. We should do a wound swab for wound infection. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.42,
      "end_seconds": 296.71,
      "duration_seconds": 2.29,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.07,
      "end_seconds": 305.86,
      "duration_seconds": 7.79,
      "text": "Keep it clean and dry and use fresh dressings daily. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.49,
      "end_seconds": 315.68,
      "duration_seconds": 4.19,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.44,
      "end_seconds": 319.19,
      "duration_seconds": 1.75,
      "text": "Have a good day."
    }
  ]
}