{
  "schema_version": "1.0",
  "encounter_id": "02849",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.64,
      "end_seconds": 5.84,
      "duration_seconds": 5.2,
      "text": "Um, morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.59,
      "end_seconds": 10.43,
      "duration_seconds": 3.84,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.41,
      "end_seconds": 19.79,
      "duration_seconds": 7.38,
      "text": "Hello, you know, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.97,
      "end_seconds": 38.84,
      "duration_seconds": 14.87,
      "text": "I've been dealing with a severe headache. Work has been very busy so I kept ignoring it. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.47,
      "end_seconds": 43.39,
      "duration_seconds": 2.92,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.56,
      "end_seconds": 49.61,
      "duration_seconds": 5.05,
      "text": "Rosuvastatin, 10 milligrams, maybe, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.84,
      "end_seconds": 54.77,
      "duration_seconds": 3.93,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.68,
      "end_seconds": 59.02,
      "duration_seconds": 2.34,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.05,
      "end_seconds": 69.2,
      "duration_seconds": 3.15,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.11,
      "end_seconds": 75.42,
      "duration_seconds": 4.31,
      "text": "I mean, about a week, give or take."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 76.57,
      "end_seconds": 80.46,
      "duration_seconds": 3.89,
      "text": "I think it's been nearer two weeks, actually."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.49,
      "end_seconds": 86.75,
      "duration_seconds": 4.26,
      "text": "Okay, so roughly one to two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.67,
      "end_seconds": 88.97,
      "duration_seconds": 1.3,
      "text": "Yeah, roughly."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.89,
      "end_seconds": 93.15,
      "duration_seconds": 3.26,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.13,
      "end_seconds": 95.24,
      "duration_seconds": 1.11,
      "text": "Severe, really."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.71,
      "end_seconds": 97.04,
      "duration_seconds": 1.33,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.59,
      "end_seconds": 102.79,
      "duration_seconds": 4.2,
      "text": "There's pain under the right ribs as well."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.3,
      "end_seconds": 108.11,
      "duration_seconds": 4.81,
      "text": "And what about vaginal bleeding, leaking fluid or reduced baby movements?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.19,
      "end_seconds": 112.38,
      "duration_seconds": 3.19,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.89,
      "end_seconds": 116.6,
      "duration_seconds": 2.71,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.42,
      "end_seconds": 120.03,
      "duration_seconds": 2.61,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.91,
      "end_seconds": 133.32,
      "duration_seconds": 2.41,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.27,
      "end_seconds": 150.62,
      "duration_seconds": 15.35,
      "text": "Uh, um, yes, I had a mole taken off my arm, a few years ago. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.6,
      "end_seconds": 172.3,
      "duration_seconds": 3.7,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.62,
      "end_seconds": 178.26,
      "duration_seconds": 4.64,
      "text": "Uh, uh, my uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.75,
      "end_seconds": 182.0,
      "duration_seconds": 2.25,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.12,
      "end_seconds": 187.74,
      "duration_seconds": 4.62,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.0,
      "end_seconds": 190.78,
      "duration_seconds": 1.78,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.1,
      "end_seconds": 195.71,
      "duration_seconds": 3.61,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.58,
      "end_seconds": 199.73,
      "duration_seconds": 2.15,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.5,
      "end_seconds": 213.89,
      "duration_seconds": 12.39,
      "text": "I've got high cholesterol. I've had an underactive thyroid for nearly five years now. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.19,
      "end_seconds": 227.11,
      "duration_seconds": 11.92,
      "text": "Yes, high cholesterol and an underactive thyroid are known to us, good to have that clear. Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.09,
      "end_seconds": 233.69,
      "duration_seconds": 4.6,
      "text": "No, you know, not that I know of."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.22,
      "end_seconds": 236.89,
      "duration_seconds": 2.67,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.92,
      "end_seconds": 248.67,
      "duration_seconds": 2.75,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.25,
      "end_seconds": 269.42,
      "duration_seconds": 9.17,
      "text": "Okay: pulse 73, BP is 150 over 103, weight 70 kilos, SpO2 97 percent on room air, height 176 centimetres."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.45,
      "end_seconds": 275.02,
      "duration_seconds": 4.57,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.23,
      "end_seconds": 276.93,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.02,
      "end_seconds": 280.06,
      "duration_seconds": 2.04,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.95,
      "end_seconds": 304.18,
      "duration_seconds": 5.23,
      "text": "Your blood pressure is very high and your reflexes are brisk."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.07,
      "end_seconds": 331.2,
      "duration_seconds": 22.13,
      "text": "That's the examination finished. So where does that leave us? I think we're dealing with severe pre-eclampsia at this stage. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. There's nothing new for me to start or arrange today. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.89,
      "end_seconds": 337.39,
      "duration_seconds": 4.5,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}