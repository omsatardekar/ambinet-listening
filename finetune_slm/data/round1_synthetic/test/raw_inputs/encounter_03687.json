{
  "schema_version": "1.0",
  "encounter_id": "03687",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.81,
      "end_seconds": 4.27,
      "duration_seconds": 3.46,
      "text": "Hi there, the chair's free, sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.33,
      "end_seconds": 9.12,
      "duration_seconds": 3.79,
      "text": "Actually, hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.16,
      "end_seconds": 14.15,
      "duration_seconds": 1.99,
      "text": "Have you been waiting long?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.29,
      "end_seconds": 22.47,
      "duration_seconds": 3.18,
      "text": "Only about ten minutes, no trouble."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.23,
      "end_seconds": 26.75,
      "duration_seconds": 2.52,
      "text": "What do you need help with?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.63,
      "end_seconds": 41.47,
      "duration_seconds": 12.84,
      "text": "Um, you know, so... blacking out when I stand quickly. That's why I came. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.27,
      "end_seconds": 45.17,
      "duration_seconds": 2.9,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.55,
      "end_seconds": 55.49,
      "duration_seconds": 8.94,
      "text": "Probably four weeks. Yeah. I kept putting it off, you know, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.51,
      "end_seconds": 60.63,
      "duration_seconds": 3.12,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 62.16,
      "end_seconds": 67.56,
      "duration_seconds": 5.4,
      "text": "I, I'd give it a six, out of ten."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.27,
      "end_seconds": 71.79,
      "duration_seconds": 2.52,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 72.83,
      "end_seconds": 76.29,
      "duration_seconds": 3.46,
      "text": "It happens once or twice a day."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.09,
      "end_seconds": 84.89,
      "duration_seconds": 7.8,
      "text": "Hmm, I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 84.99,
      "end_seconds": 91.21,
      "duration_seconds": 6.22,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.89,
      "end_seconds": 94.05,
      "duration_seconds": 2.16,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.05,
      "end_seconds": 106.31,
      "duration_seconds": 10.26,
      "text": "And there's blurred vision on standing as well, two months now. I've also been feeling lightheaded, for about four days."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.65,
      "end_seconds": 111.03,
      "duration_seconds": 3.38,
      "text": "Okay, and what about palpitations or chest pain?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.96,
      "end_seconds": 126.8,
      "duration_seconds": 14.84,
      "text": "No, you know, no palpitations, no chest pain. I did have a new prostate tablet at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.65,
      "end_seconds": 130.92,
      "duration_seconds": 3.27,
      "text": "And what about head injury or seizure?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.22,
      "end_seconds": 137.02,
      "duration_seconds": 4.8,
      "text": "I haven't had head injury or seizure, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.34,
      "end_seconds": 145.87,
      "duration_seconds": 4.53,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.5,
      "end_seconds": 152.1,
      "duration_seconds": 1.6,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.9,
      "end_seconds": 155.63,
      "duration_seconds": 2.73,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 156.91,
      "end_seconds": 163.91,
      "duration_seconds": 7.0,
      "text": "I had a mole taken off my arm a few years ago."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.19,
      "end_seconds": 167.94,
      "duration_seconds": 2.75,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.48,
      "end_seconds": 173.48,
      "duration_seconds": 4.0,
      "text": "An enlarged prostate, for nearly five years."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.4,
      "end_seconds": 180.83,
      "duration_seconds": 5.43,
      "text": "Tell me your medicines, please. I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.86,
      "end_seconds": 190.63,
      "duration_seconds": 8.77,
      "text": "Um, it's a... um, I can't remember what it's called. It's a little pink tablet."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.1,
      "end_seconds": 194.81,
      "duration_seconds": 2.71,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 196.12,
      "end_seconds": 206.46,
      "duration_seconds": 10.34,
      "text": "For the prostate, I believe. My wife sets them out for me, I just take what I'm given."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.03,
      "end_seconds": 212.24,
      "duration_seconds": 4.21,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 213.44,
      "end_seconds": 215.88,
      "duration_seconds": 2.44,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.76,
      "end_seconds": 219.61,
      "duration_seconds": 1.85,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 220.61,
      "end_seconds": 226.48,
      "duration_seconds": 5.87,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.43,
      "end_seconds": 229.79,
      "duration_seconds": 1.36,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 235.92,
      "end_seconds": 239.34,
      "duration_seconds": 3.42,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 241.17,
      "end_seconds": 249.98,
      "duration_seconds": 8.81,
      "text": "Doctor, I've got the readings for you. Oxygen saturation is 99 percent, temp 36.4 degrees, BP is 104 over 65. Pulse 99."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.54,
      "end_seconds": 251.24,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.47,
      "end_seconds": 257.13,
      "duration_seconds": 3.66,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.29,
      "end_seconds": 260.8,
      "duration_seconds": 2.51,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.63,
      "end_seconds": 276.07,
      "duration_seconds": 6.44,
      "text": "Your blood pressure drops a long way when you stand and your heart sounds are normal."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 290.43,
      "end_seconds": 291.49,
      "duration_seconds": 1.06,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.87,
      "end_seconds": 306.51,
      "duration_seconds": 12.64,
      "text": "Okay, you can sit up now. Taking everything into account, this looks most like medicine-induced postural hypotension. It could also be an arrhythmia, so we'll keep that open."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 307.78,
      "end_seconds": 309.38,
      "duration_seconds": 1.6,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 312.65,
      "end_seconds": 329.71,
      "duration_seconds": 17.06,
      "text": "It's reasonable to be concerned, but right now medicine-induced postural hypotension is my leading thought, not anything worse. So, to recap quickly. You've had blacking out when you stand quickly for four weeks, and no chest pain or palpitations."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 331.67,
      "end_seconds": 333.48,
      "duration_seconds": 1.81,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 346.35,
      "end_seconds": 350.45,
      "duration_seconds": 4.1,
      "text": "I've already done an ECG, it's ready for you."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 352.09,
      "end_seconds": 358.03,
      "duration_seconds": 5.94,
      "text": "Thanks, I'll have a look. I'm sending you for blood tests because of syncope."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 359.74,
      "end_seconds": 364.35,
      "duration_seconds": 4.61,
      "text": "We have a slot Wednesday at 2 pm, if that works."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 364.94,
      "end_seconds": 377.37,
      "duration_seconds": 12.43,
      "text": "We will move the prostate tablet to bedtime and you should rise slowly. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 377.6,
      "end_seconds": 384.25,
      "duration_seconds": 6.65,
      "text": "Understood. I'd like you back in two weeks. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 385.03,
      "end_seconds": 389.54,
      "duration_seconds": 4.51,
      "text": "Okay, uh, that makes sense. Thanks for explaining."
    }
  ]
}