{
  "schema_version": "1.0",
  "encounter_id": "00864",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.75,
      "end_seconds": 6.31,
      "duration_seconds": 4.56,
      "text": "Athlete's foot. Between the toes. It's back."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.65,
      "end_seconds": 14.41,
      "duration_seconds": 4.76,
      "text": "How long has it been there this time?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.56,
      "end_seconds": 20.39,
      "duration_seconds": 2.83,
      "text": "Dunno. A while. Weeks."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.77,
      "end_seconds": 24.31,
      "duration_seconds": 1.54,
      "text": "Which foot?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.3,
      "end_seconds": 32.79,
      "duration_seconds": 5.49,
      "text": "Both. Worse on the left. Itchy. Skin's peeling."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.01,
      "end_seconds": 37.49,
      "duration_seconds": 2.48,
      "text": "Have you tried anything?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.27,
      "end_seconds": 46.47,
      "duration_seconds": 6.2,
      "text": "Clotrimazole cream. Twice a day. And a powder in my shoes."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.87,
      "end_seconds": 52.96,
      "duration_seconds": 5.09,
      "text": "How long did you use the cream for? ~"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.77,
      "end_seconds": 60.79,
      "duration_seconds": 6.02,
      "text": "A week. It went. Then it came back. ~"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.21,
      "end_seconds": 66.65,
      "duration_seconds": 4.44,
      "text": "How long should you use it for? ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.03,
      "end_seconds": 69.49,
      "duration_seconds": 1.46,
      "text": "Dunno. ~"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.8,
      "end_seconds": 80.93,
      "duration_seconds": 9.13,
      "text": "Usually another week or two after it looks better. That's why it comes back. Any health conditions?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.19,
      "end_seconds": 86.39,
      "duration_seconds": 2.2,
      "text": "Diabetes. Type 2."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.13,
      "end_seconds": 93.11,
      "duration_seconds": 4.98,
      "text": "Anyone in the family get fungal infections?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.25,
      "end_seconds": 99.36,
      "duration_seconds": 4.11,
      "text": "My dad had it on his nails."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.17,
      "end_seconds": 105.53,
      "duration_seconds": 4.36,
      "text": "Any fever, or redness spreading up the foot?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.22,
      "end_seconds": 110.4,
      "duration_seconds": 3.18,
      "text": "No. Nothing like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.75,
      "end_seconds": 117.25,
      "duration_seconds": 4.5,
      "text": "Any pain, or numbness in your feet?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.26,
      "end_seconds": 120.7,
      "duration_seconds": 1.44,
      "text": "No. Normal."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.12,
      "end_seconds": 125.76,
      "duration_seconds": 3.64,
      "text": "Pulse and temperature, please. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.48,
      "end_seconds": 128.93,
      "duration_seconds": 1.45,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.57,
      "end_seconds": 143.07,
      "duration_seconds": 2.5,
      "text": "Pulse 74, temperature 36.7."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.82,
      "end_seconds": 146.87,
      "duration_seconds": 2.05,
      "text": "Fine? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.67,
      "end_seconds": 170.79,
      "duration_seconds": 5.12,
      "text": "Fine. Take your socks off and let me see."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.17,
      "end_seconds": 173.76,
      "duration_seconds": 1.59,
      "text": "Here. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.51,
      "end_seconds": 189.31,
      "duration_seconds": 13.8,
      "text": "There's white, peeling, soggy skin between the little toes on both feet, and a small crack on the left, but no redness spreading, and no sign of infection. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.25,
      "end_seconds": 195.08,
      "duration_seconds": 2.83,
      "text": "What is it? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.42,
      "end_seconds": 212.9,
      "duration_seconds": 16.48,
      "text": "It's the same fungal infection, athlete's foot, tinea pedis, and I'd say it's recurrent because the treatment was stopped too soon, or the shoes are keeping the feet damp."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.68,
      "end_seconds": 218.24,
      "duration_seconds": 3.56,
      "text": "What do I do? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.02,
      "end_seconds": 231.83,
      "duration_seconds": 10.81,
      "text": "Continue the clotrimazole cream for two weeks after it looks clear, and dry between your toes thoroughly after washing."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.68,
      "end_seconds": 235.5,
      "duration_seconds": 1.82,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.26,
      "end_seconds": 246.15,
      "duration_seconds": 8.89,
      "text": "Wear cotton socks, change them daily, and alternate your shoes. Don't go barefoot in communal showers."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.73,
      "end_seconds": 249.31,
      "duration_seconds": 1.58,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.9,
      "end_seconds": 260.72,
      "duration_seconds": 8.82,
      "text": "And I'd like to take a skin scraping, to confirm the diagnosis, because it's come back."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.51,
      "end_seconds": 274.9,
      "duration_seconds": 1.39,
      "text": "Fine."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.97,
      "end_seconds": 289.32,
      "duration_seconds": 11.35,
      "text": "Done. Because you have diabetes, check your feet daily and see me if there's a blister, a crack that won't heal, or redness."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.72,
      "end_seconds": 292.3,
      "duration_seconds": 1.58,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.62,
      "end_seconds": 302.24,
      "duration_seconds": 7.62,
      "text": "I'd like to see you again in three weeks, with the result."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.53,
      "end_seconds": 306.03,
      "duration_seconds": 2.5,
      "text": "Three weeks. Thanks. ~"
    }
  ]
}
