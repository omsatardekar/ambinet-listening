{
  "schema_version": "1.0",
  "encounter_id": "03064",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.67,
      "end_seconds": 3.23,
      "duration_seconds": 2.56,
      "text": "Hi, sit anywhere you like."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.21,
      "end_seconds": 5.26,
      "duration_seconds": 1.05,
      "text": "Evening, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 6.56,
      "end_seconds": 9.78,
      "duration_seconds": 3.22,
      "text": "Was it a long journey this morning?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.01,
      "end_seconds": 14.64,
      "duration_seconds": 3.63,
      "text": "Not too bad, the roads were quiet."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.57,
      "end_seconds": 18.27,
      "duration_seconds": 1.7,
      "text": "What's been worrying you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.56,
      "end_seconds": 30.22,
      "duration_seconds": 7.66,
      "text": "Honestly, it's hearing getting worse in both ears, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.82,
      "end_seconds": 35.71,
      "duration_seconds": 3.89,
      "text": "Okay, how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.5,
      "end_seconds": 39.97,
      "duration_seconds": 3.47,
      "text": "It's been going on for four weeks."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.68,
      "end_seconds": 44.48,
      "duration_seconds": 2.8,
      "text": "Right, I'll do your observations first."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.38,
      "end_seconds": 56.15,
      "duration_seconds": 2.77,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.49,
      "end_seconds": 78.35,
      "duration_seconds": 7.86,
      "text": "Okay: saturation 97 percent, pulse 75, temperature is 36.7 degrees, blood pressure 117 over 70."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.16,
      "end_seconds": 86.3,
      "duration_seconds": 2.14,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.59,
      "end_seconds": 89.73,
      "duration_seconds": 2.14,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.68,
      "end_seconds": 97.61,
      "duration_seconds": 4.93,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 112.2,
      "end_seconds": 113.33,
      "duration_seconds": 1.13,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.18,
      "end_seconds": 116.21,
      "duration_seconds": 2.03,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.97,
      "end_seconds": 140.37,
      "duration_seconds": 7.4,
      "text": "Both ear drums look normal and the tuning fork is heard better through the bone."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.9,
      "end_seconds": 151.76,
      "duration_seconds": 5.86,
      "text": "Thank you, you can get dressed. And what about ear pain or facial weakness?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 152.49,
      "end_seconds": 155.19,
      "duration_seconds": 2.7,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.74,
      "end_seconds": 158.69,
      "duration_seconds": 2.95,
      "text": "And what about discharge or vertigo?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.36,
      "end_seconds": 161.48,
      "duration_seconds": 2.12,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.2,
      "end_seconds": 164.57,
      "duration_seconds": 2.37,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 166.19,
      "end_seconds": 167.77,
      "duration_seconds": 1.58,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.8,
      "end_seconds": 173.59,
      "duration_seconds": 3.79,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 174.56,
      "end_seconds": 177.86,
      "duration_seconds": 3.3,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.57,
      "end_seconds": 199.69,
      "duration_seconds": 3.12,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.56,
      "end_seconds": 204.41,
      "duration_seconds": 3.85,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.82,
      "end_seconds": 207.57,
      "duration_seconds": 1.75,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 212.36,
      "end_seconds": 216.19,
      "duration_seconds": 3.83,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.08,
      "end_seconds": 226.83,
      "duration_seconds": 2.75,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 227.67,
      "end_seconds": 229.3,
      "duration_seconds": 1.63,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.91,
      "end_seconds": 234.61,
      "duration_seconds": 3.7,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 236.61,
      "end_seconds": 238.56,
      "duration_seconds": 1.95,
      "text": "Eczema, for five years."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.42,
      "end_seconds": 247.19,
      "duration_seconds": 6.77,
      "text": "Right, right. Yes, eczema is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.16,
      "end_seconds": 268.02,
      "duration_seconds": 3.86,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 272.73,
      "end_seconds": 274.77,
      "duration_seconds": 2.04,
      "text": "Hydrocortisone cream, when needed."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.67,
      "end_seconds": 296.9,
      "duration_seconds": 21.23,
      "text": "From what you've told me and what I found, I think we're dealing with a conductive hearing loss, possibly otosclerosis at this stage. We should do a CT scan of the ears for possible otosclerosis. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 297.62,
      "end_seconds": 300.35,
      "duration_seconds": 2.73,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.69,
      "end_seconds": 317.26,
      "duration_seconds": 15.57,
      "text": "A hearing aid or an operation are both options after the tests. The ENT clinic would be the right next step, I'll refer you. Come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 318.13,
      "end_seconds": 319.73,
      "duration_seconds": 1.6,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 320.26,
      "end_seconds": 324.84,
      "duration_seconds": 4.58,
      "text": "Come back after the tests. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 326.01,
      "end_seconds": 329.31,
      "duration_seconds": 3.3,
      "text": "I think I understand everything. Thanks."
    }
  ]
}