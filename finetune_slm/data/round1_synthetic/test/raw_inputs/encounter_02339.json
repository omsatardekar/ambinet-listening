{
  "schema_version": "1.0",
  "encounter_id": "02339",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.9,
      "end_seconds": 3.62,
      "duration_seconds": 2.72,
      "text": "Good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 5.14,
      "end_seconds": 12.91,
      "duration_seconds": 7.77,
      "text": "Okay, you know, so hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.62,
      "end_seconds": 17.79,
      "duration_seconds": 3.17,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 19.42,
      "end_seconds": 27.89,
      "duration_seconds": 8.47,
      "text": "It's, It's a very fast heartbeat, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.76,
      "end_seconds": 31.2,
      "duration_seconds": 1.44,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 32.21,
      "end_seconds": 39.51,
      "duration_seconds": 7.3,
      "text": "I, I'd say about four days. Actually, no, closer to two days."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.78,
      "end_seconds": 43.23,
      "duration_seconds": 3.45,
      "text": "Sure. How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 44.78,
      "end_seconds": 45.96,
      "duration_seconds": 1.18,
      "text": "Mild, really."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 46.74,
      "end_seconds": 56.68,
      "duration_seconds": 9.94,
      "text": "I mean, you know, I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 56.78,
      "end_seconds": 63.15,
      "duration_seconds": 6.37,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.65,
      "end_seconds": 67.02,
      "duration_seconds": 2.37,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 67.97,
      "end_seconds": 74.17,
      "duration_seconds": 6.2,
      "text": "Okay, so I've also had vomiting and diarrhoea, for about a month."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.25,
      "end_seconds": 79.63,
      "duration_seconds": 3.38,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 81.39,
      "end_seconds": 97.88,
      "duration_seconds": 16.49,
      "text": "Mild, I'd say. Erm, um, as for high temperature, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.55,
      "end_seconds": 104.59,
      "duration_seconds": 5.04,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 105.32,
      "end_seconds": 108.52,
      "duration_seconds": 3.2,
      "text": "It sort of comes and goes."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.87,
      "end_seconds": 116.2,
      "duration_seconds": 6.33,
      "text": "Alright, have you had a very fast heartbeat before, or is this the first time?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 117.5,
      "end_seconds": 125.72,
      "duration_seconds": 8.22,
      "text": "Well, yes, something like this happened last winter, and it went away on its own."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 142.81,
      "end_seconds": 152.28,
      "duration_seconds": 9.47,
      "text": "Doctor, I've got the readings for you. Heart rate 97, saturation 95 percent, blood pressure 111 over 70. Temp 38.9 degrees."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.17,
      "end_seconds": 154.27,
      "duration_seconds": 1.1,
      "text": "So, thanks."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.53,
      "end_seconds": 159.73,
      "duration_seconds": 4.2,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 161.53,
      "end_seconds": 164.22,
      "duration_seconds": 2.69,
      "text": "Okay, you know, doctor."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.61,
      "end_seconds": 168.13,
      "duration_seconds": 2.52,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.27,
      "end_seconds": 182.4,
      "duration_seconds": 7.13,
      "text": "You are hot, shaking, and your pulse is over one hundred and forty and irregular."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.04,
      "end_seconds": 190.64,
      "duration_seconds": 5.6,
      "text": "You can sit up now. Any recent infection or chest pain at all?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 191.55,
      "end_seconds": 204.63,
      "duration_seconds": 13.08,
      "text": "Yeah, no, no recent infection, no chest pain. I did have agitation at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.32,
      "end_seconds": 208.32,
      "duration_seconds": 2.0,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 213.93,
      "end_seconds": 218.92,
      "duration_seconds": 4.99,
      "text": "Let me think, you know, no, that's all fine."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.92,
      "end_seconds": 224.29,
      "duration_seconds": 3.37,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 228.67,
      "end_seconds": 232.6,
      "duration_seconds": 3.93,
      "text": "So, um, no, nothing like that."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.3,
      "end_seconds": 235.6,
      "duration_seconds": 2.3,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 236.21,
      "end_seconds": 243.24,
      "duration_seconds": 7.03,
      "text": "I'm on something called esci... escitalopram, 10 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.95,
      "end_seconds": 249.73,
      "duration_seconds": 4.78,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 251.22,
      "end_seconds": 259.11,
      "duration_seconds": 7.89,
      "text": "Not with me. I'll bring it next time. Metoprolol, 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 260.56,
      "end_seconds": 268.39,
      "duration_seconds": 7.83,
      "text": "It's meant to be twice a day, though I don't see she take it every time."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.18,
      "end_seconds": 285.17,
      "duration_seconds": 2.99,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 286.36,
      "end_seconds": 299.86,
      "duration_seconds": 13.5,
      "text": "Gout, for five years. I'm not great at remembering details, so bear with me. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.6,
      "end_seconds": 302.41,
      "duration_seconds": 0.81,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 306.08,
      "end_seconds": 316.19,
      "duration_seconds": 10.11,
      "text": "Anxiety, for nearly five years. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 317.06,
      "end_seconds": 319.67,
      "duration_seconds": 2.61,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 321.49,
      "end_seconds": 330.89,
      "duration_seconds": 9.4,
      "text": "Um, I've got heart disease. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 332.46,
      "end_seconds": 339.73,
      "duration_seconds": 7.27,
      "text": "Alright, anxiety, that matches what I have here. Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 341.07,
      "end_seconds": 348.87,
      "duration_seconds": 7.8,
      "text": "So, my grandmother had dementia. I mean, you know, my cousin has psoriasis."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 349.67,
      "end_seconds": 352.55,
      "duration_seconds": 2.88,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 353.94,
      "end_seconds": 357.16,
      "duration_seconds": 3.22,
      "text": "Actually, yes, walnuts. I get hives."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 358.14,
      "end_seconds": 360.54,
      "duration_seconds": 2.4,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 361.17,
      "end_seconds": 367.29,
      "duration_seconds": 6.12,
      "text": "Just two stents put in my heart, three years ago."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 369.18,
      "end_seconds": 370.37,
      "duration_seconds": 1.19,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 371.54,
      "end_seconds": 375.02,
      "duration_seconds": 3.48,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 376.49,
      "end_seconds": 378.97,
      "duration_seconds": 2.48,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 379.67,
      "end_seconds": 384.05,
      "duration_seconds": 4.38,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 384.8,
      "end_seconds": 387.14,
      "duration_seconds": 2.34,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 388.04,
      "end_seconds": 390.49,
      "duration_seconds": 2.45,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 391.02,
      "end_seconds": 407.47,
      "duration_seconds": 16.45,
      "text": "I think an ECG makes sense here, for fast heart rhythm. I'll request urgent blood tests, it'll help with thyroid storm. This is an emergency, you will be treated in high dependency. I'll also refer you to the emergency team."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 409.4,
      "end_seconds": 412.7,
      "duration_seconds": 3.3,
      "text": "Actually, sure, where do I go?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 414.23,
      "end_seconds": 431.37,
      "duration_seconds": 17.14,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. I'll want another look straight away. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 433.41,
      "end_seconds": 437.63,
      "duration_seconds": 4.22,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}