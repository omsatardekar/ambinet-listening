{
  "schema_version": "1.0",
  "encounter_id": "01664",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.83,
      "end_seconds": 3.97,
      "duration_seconds": 3.14,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.48,
      "end_seconds": 9.21,
      "duration_seconds": 4.73,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.46,
      "end_seconds": 13.21,
      "duration_seconds": 2.75,
      "text": "Well, I've been having tiredness."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.89,
      "end_seconds": 18.75,
      "duration_seconds": 3.86,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.75,
      "end_seconds": 38.72,
      "duration_seconds": 17.97,
      "text": "Um, about... well, three weeks. I looked a few things up online, and that probably didn't help. It's the not knowing that gets to me. I've had loose stools with blood too, for five days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.66,
      "end_seconds": 42.62,
      "duration_seconds": 1.96,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.61,
      "end_seconds": 58.66,
      "duration_seconds": 3.05,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.45,
      "end_seconds": 80.94,
      "duration_seconds": 8.49,
      "text": "Okay: temperature 36.8, saturation 99 percent, respiratory rate 18. And BP is 109 over 78, pulse 81."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.83,
      "end_seconds": 87.31,
      "duration_seconds": 3.48,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.37,
      "end_seconds": 91.09,
      "duration_seconds": 2.72,
      "text": "take a a deep breath for me"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.74,
      "end_seconds": 113.86,
      "duration_seconds": 5.12,
      "text": "there is tenderness in the lower right tummy and no guarding"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.01,
      "end_seconds": 118.93,
      "duration_seconds": 1.92,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.92,
      "end_seconds": 133.48,
      "duration_seconds": 4.56,
      "text": "Have you noticed joint pain, weight loss or vomiting?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.49,
      "end_seconds": 140.11,
      "duration_seconds": 5.62,
      "text": "I haven't had joint pain, weight loss or vomiting, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.42,
      "end_seconds": 143.92,
      "duration_seconds": 2.5,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.81,
      "end_seconds": 146.86,
      "duration_seconds": 1.05,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.72,
      "end_seconds": 152.45,
      "duration_seconds": 3.73,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.47,
      "end_seconds": 155.68,
      "duration_seconds": 2.21,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.19,
      "end_seconds": 169.69,
      "duration_seconds": 4.5,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.04,
      "end_seconds": 174.53,
      "duration_seconds": 3.49,
      "text": "no, I've never reacted to anything"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.47,
      "end_seconds": 182.53,
      "duration_seconds": 4.06,
      "text": "right, is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.51,
      "end_seconds": 186.24,
      "duration_seconds": 2.73,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.99,
      "end_seconds": 191.21,
      "duration_seconds": 2.22,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.06,
      "end_seconds": 196.33,
      "duration_seconds": 4.27,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.33,
      "end_seconds": 200.05,
      "duration_seconds": 1.72,
      "text": "how active are you?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.06,
      "end_seconds": 205.81,
      "duration_seconds": 3.75,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.49,
      "end_seconds": 210.5,
      "duration_seconds": 3.01,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.58,
      "end_seconds": 215.57,
      "duration_seconds": 3.99,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.58,
      "end_seconds": 228.92,
      "duration_seconds": 3.34,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.9,
      "end_seconds": 231.79,
      "duration_seconds": 1.89,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.8,
      "end_seconds": 247.95,
      "duration_seconds": 8.15,
      "text": "so, based on the history and the examination, the most likely explanation is a flare of inflammatory bowel disease"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.6,
      "end_seconds": 253.43,
      "duration_seconds": 2.83,
      "text": "Mm, is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.3,
      "end_seconds": 268.03,
      "duration_seconds": 13.73,
      "text": "It's reasonable to be concerned, but right now a flare of inflammatory bowel disease is my leading thought, not anything worse. I want a stool test done, that's for bloody diarrhoea."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.32,
      "end_seconds": 272.04,
      "duration_seconds": 2.72,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.59,
      "end_seconds": 299.23,
      "duration_seconds": 23.64,
      "text": "I'm prescribing prednisolone, 40 milligrams, once a day, one week then reduce. You take it by mouth. That should help with inflammatory bowel flare. Keep up your fluids and call the IBD nurse if you get a fever. Let's get you seen by the IBD nurse, I'll arrange the letter"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.49,
      "end_seconds": 305.0,
      "duration_seconds": 1.51,
      "text": "alright, thank you"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.77,
      "end_seconds": 308.33,
      "duration_seconds": 2.56,
      "text": "that's all from me any questions?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.36,
      "end_seconds": 313.28,
      "duration_seconds": 2.92,
      "text": "Erm, thank you, that's helpful."
    }
  ]
}