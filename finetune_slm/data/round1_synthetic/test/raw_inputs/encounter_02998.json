{
  "schema_version": "1.0",
  "encounter_id": "02998",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.29,
      "end_seconds": 6.53,
      "duration_seconds": 5.24,
      "text": "Doctor? Hello, uh, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.29,
      "end_seconds": 13.45,
      "duration_seconds": 5.16,
      "text": "you're alright, take a seat what can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.59,
      "end_seconds": 22.12,
      "duration_seconds": 7.53,
      "text": "Mainly a severe headache. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.41,
      "end_seconds": 26.72,
      "duration_seconds": 3.31,
      "text": "Okay, how long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.94,
      "end_seconds": 36.76,
      "duration_seconds": 3.82,
      "text": "It's, It's been going on for three weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.47,
      "end_seconds": 42.38,
      "duration_seconds": 4.91,
      "text": "okay, give me more detail on it, whatever comes to mind"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.89,
      "end_seconds": 59.52,
      "duration_seconds": 12.63,
      "text": "It happens once or twice a day. Severe, really. I'm hoping you can tell me something definite. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.3,
      "end_seconds": 64.83,
      "duration_seconds": 3.53,
      "text": "have you had pain under the right ribs?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.91,
      "end_seconds": 69.08,
      "duration_seconds": 2.17,
      "text": "Yes, for five days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.07,
      "end_seconds": 75.56,
      "duration_seconds": 4.49,
      "text": "any vaginal bleeding, leaking fluid or reduced baby movements?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.06,
      "end_seconds": 79.04,
      "duration_seconds": 1.98,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.87,
      "end_seconds": 81.93,
      "duration_seconds": 2.06,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.22,
      "end_seconds": 86.75,
      "duration_seconds": 3.53,
      "text": "Yeah, nothing on the skin, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.93,
      "end_seconds": 90.41,
      "duration_seconds": 2.48,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.32,
      "end_seconds": 96.72,
      "duration_seconds": 4.4,
      "text": "Yeah, I'm allergic to diclofenac, I get wheezing."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.69,
      "end_seconds": 113.86,
      "duration_seconds": 3.17,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.37,
      "end_seconds": 120.92,
      "duration_seconds": 5.55,
      "text": "I'm on hydrochlorothiazide, 12.5 milligrams, every morning for my pressure."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.38,
      "end_seconds": 124.87,
      "duration_seconds": 2.49,
      "text": "do you work outside the home?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.17,
      "end_seconds": 130.11,
      "duration_seconds": 3.94,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.91,
      "end_seconds": 132.78,
      "duration_seconds": 1.87,
      "text": "how are your meals?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.43,
      "end_seconds": 137.24,
      "duration_seconds": 3.81,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.16,
      "end_seconds": 140.93,
      "duration_seconds": 1.77,
      "text": "So, any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.38,
      "end_seconds": 145.53,
      "duration_seconds": 1.15,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.61,
      "end_seconds": 151.1,
      "duration_seconds": 3.49,
      "text": "Okay, has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.13,
      "end_seconds": 156.43,
      "duration_seconds": 4.3,
      "text": "I have high blood pressure, for about a year."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.67,
      "end_seconds": 166.94,
      "duration_seconds": 7.27,
      "text": "Right, so high blood pressure is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.9,
      "end_seconds": 178.84,
      "duration_seconds": 2.94,
      "text": "time for your numbers, if that's okay"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.76,
      "end_seconds": 189.8,
      "duration_seconds": 2.04,
      "text": "sit still for a moment.."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.85,
      "end_seconds": 214.92,
      "duration_seconds": 5.07,
      "text": "okay: pressure 154 over 101, heart rate 86, temperature 36.9."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.25,
      "end_seconds": 219.57,
      "duration_seconds": 3.32,
      "text": "could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.77,
      "end_seconds": 223.69,
      "duration_seconds": 2.92,
      "text": "I'll listen to your chest now"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.21,
      "end_seconds": 241.26,
      "duration_seconds": 5.05,
      "text": "Your blood pressure is very high and your reflexes are brisk."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.58,
      "end_seconds": 246.88,
      "duration_seconds": 3.3,
      "text": "Okay, thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.84,
      "end_seconds": 265.93,
      "duration_seconds": 11.09,
      "text": "Having listened and examined, my working impression is severe pre-eclampsia. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.85,
      "end_seconds": 271.56,
      "duration_seconds": 3.71,
      "text": "Erm, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.38,
      "end_seconds": 306.07,
      "duration_seconds": 33.69,
      "text": "I understand the worry. At the moment I'd say it's severe pre-eclampsia, and we'll know more once the urgent blood tests is back. I'm going to order urgent blood tests, for pre-eclampsia. It's a routine test and it'll give us a much clearer picture. I'm going to put you on labetalol, 200 milligrams, once now, single dose. That should help with severe hypertension. You need to go to the maternity unit straight away."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.66,
      "end_seconds": 320.48,
      "duration_seconds": 13.82,
      "text": "Okay, go on. Let's get you seen by the obstetric team, I'll arrange the letter. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.45,
      "end_seconds": 324.48,
      "duration_seconds": 2.03,
      "text": "thank you, that's clear"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.85,
      "end_seconds": 332.74,
      "duration_seconds": 2.89,
      "text": "Alright, does all of that make sense?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.44,
      "end_seconds": 337.19,
      "duration_seconds": 3.75,
      "text": "okay, that makes sense. Thanks for explaining"
    }
  ]
}