{
  "schema_version": "1.0",
  "encounter_id": "02321",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.86,
      "end_seconds": 5.32,
      "duration_seconds": 4.46,
      "text": "Right then, come on in. Have you been waiting long?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.24,
      "end_seconds": 10.5,
      "duration_seconds": 3.26,
      "text": "Only about ten minutes, no trouble."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.59,
      "end_seconds": 15.35,
      "duration_seconds": 2.76,
      "text": "Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 17.37,
      "end_seconds": 21.43,
      "duration_seconds": 4.06,
      "text": "I've been dealing with a very fast heartbeat."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.28,
      "end_seconds": 26.33,
      "duration_seconds": 4.05,
      "text": "Alright, how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 27.08,
      "end_seconds": 31.18,
      "duration_seconds": 4.1,
      "text": "It's been about a month, I'm fairly sure."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.89,
      "end_seconds": 35.94,
      "duration_seconds": 4.05,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 37.61,
      "end_seconds": 41.63,
      "duration_seconds": 4.02,
      "text": "Oh, about a five out of ten."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.78,
      "end_seconds": 49.89,
      "duration_seconds": 2.11,
      "text": "Has there been agitation too?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.82,
      "end_seconds": 51.94,
      "duration_seconds": 1.12,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.88,
      "end_seconds": 56.69,
      "duration_seconds": 2.81,
      "text": "So, I'll do your observations first."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.53,
      "end_seconds": 68.6,
      "duration_seconds": 2.07,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.79,
      "end_seconds": 105.39,
      "duration_seconds": 15.6,
      "text": "Okay: pressure 111 over 69, respiratory rate 16. And weight 62 kilos, height 169 centimetres, heart rate 95, temperature is 39.0 degrees. Any chest pain or recent infection at all?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.41,
      "end_seconds": 114.26,
      "duration_seconds": 6.85,
      "text": "Let me think, I haven't had chest pain or recent infection, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.6,
      "end_seconds": 117.0,
      "duration_seconds": 2.4,
      "text": "Right, right. Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.58,
      "end_seconds": 119.46,
      "duration_seconds": 1.88,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.34,
      "end_seconds": 122.59,
      "duration_seconds": 2.25,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.23,
      "end_seconds": 124.7,
      "duration_seconds": 1.47,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.7,
      "end_seconds": 128.21,
      "duration_seconds": 2.51,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.96,
      "end_seconds": 132.86,
      "duration_seconds": 2.9,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.71,
      "end_seconds": 137.13,
      "duration_seconds": 2.42,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.76,
      "end_seconds": 142.15,
      "duration_seconds": 4.39,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.81,
      "end_seconds": 144.16,
      "duration_seconds": 1.35,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.12,
      "end_seconds": 148.84,
      "duration_seconds": 2.72,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.88,
      "end_seconds": 153.03,
      "duration_seconds": 2.15,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 154.72,
      "end_seconds": 158.7,
      "duration_seconds": 3.98,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.37,
      "end_seconds": 163.8,
      "duration_seconds": 4.43,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 164.91,
      "end_seconds": 169.18,
      "duration_seconds": 4.27,
      "text": "Oh, I'm allergic to cat fur, I get sneezing."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.24,
      "end_seconds": 178.87,
      "duration_seconds": 2.63,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 180.14,
      "end_seconds": 181.2,
      "duration_seconds": 1.06,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.92,
      "end_seconds": 194.28,
      "duration_seconds": 4.36,
      "text": "Alright, has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 196.27,
      "end_seconds": 198.12,
      "duration_seconds": 1.85,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.96,
      "end_seconds": 203.6,
      "duration_seconds": 4.64,
      "text": "So, do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 205.27,
      "end_seconds": 207.02,
      "duration_seconds": 1.75,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.74,
      "end_seconds": 230.79,
      "duration_seconds": 5.05,
      "text": "Listening to the whole story, it points towards a thyroid storm."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 231.91,
      "end_seconds": 235.1,
      "duration_seconds": 3.19,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.82,
      "end_seconds": 254.34,
      "duration_seconds": 18.52,
      "text": "Nothing I've seen today points to an emergency. It looks like a thyroid storm, but I'd like to confirm. Stop me if I've got anything wrong. You've had a very fast heartbeat for about a month, and no recent infection or chest pain."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 258.97,
      "end_seconds": 261.74,
      "duration_seconds": 2.77,
      "text": "Right, that's what happened, yes."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 276.84,
      "end_seconds": 281.04,
      "duration_seconds": 4.2,
      "text": "We should do an ECG for fast heart rhythm."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 283.06,
      "end_seconds": 287.28,
      "duration_seconds": 4.22,
      "text": "We have a slot Tuesday at 2 pm, if that works."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.84,
      "end_seconds": 308.38,
      "duration_seconds": 19.54,
      "text": "We'll begin with propranolol, 1 milligrams, now, single dose. That should help with thyroid storm. This is an emergency, you will be treated in high dependency. I'll also refer you to the emergency team. Book a review straight away."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 309.23,
      "end_seconds": 309.93,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 311.17,
      "end_seconds": 314.33,
      "duration_seconds": 3.16,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 320.32,
      "end_seconds": 324.79,
      "duration_seconds": 4.47,
      "text": "Right, uh, I'll do that. Thank you, doctor."
    }
  ]
}