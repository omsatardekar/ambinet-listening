{
  "schema_version": "1.0",
  "encounter_id": "02023",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.98,
      "end_seconds": 4.07,
      "duration_seconds": 3.09,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.69,
      "end_seconds": 8.33,
      "duration_seconds": 3.64,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.2,
      "end_seconds": 13.87,
      "duration_seconds": 3.67,
      "text": "Well, I've been having being very breathless."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.85,
      "end_seconds": 18.66,
      "duration_seconds": 3.81,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.47,
      "end_seconds": 24.94,
      "duration_seconds": 5.47,
      "text": "I'd say one week. Actually, no, closer to about two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.87,
      "end_seconds": 34.87,
      "duration_seconds": 9.0,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.42,
      "end_seconds": 43.97,
      "duration_seconds": 4.55,
      "text": "I'd call it mild. It sort of comes and goes."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.24,
      "end_seconds": 49.76,
      "duration_seconds": 4.52,
      "text": "Let me check a few things. Any fever or calf pain?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.23,
      "end_seconds": 55.27,
      "duration_seconds": 4.04,
      "text": "I haven't had fever or calf pain, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.91,
      "end_seconds": 59.15,
      "duration_seconds": 3.24,
      "text": "Have you had wheeze, by any chance?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.31,
      "end_seconds": 61.93,
      "duration_seconds": 1.62,
      "text": "Definitely no wheeze."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.76,
      "end_seconds": 66.73,
      "duration_seconds": 3.97,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.71,
      "end_seconds": 70.24,
      "duration_seconds": 1.53,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.17,
      "end_seconds": 89.48,
      "duration_seconds": 3.31,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.49,
      "end_seconds": 101.75,
      "duration_seconds": 11.26,
      "text": "My partner and our baby. I hardly move around during the day. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.3,
      "end_seconds": 105.67,
      "duration_seconds": 2.37,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.52,
      "end_seconds": 109.22,
      "duration_seconds": 1.7,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.75,
      "end_seconds": 124.77,
      "duration_seconds": 4.02,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.76,
      "end_seconds": 129.34,
      "duration_seconds": 1.58,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.29,
      "end_seconds": 133.86,
      "duration_seconds": 3.57,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.86,
      "end_seconds": 139.57,
      "duration_seconds": 3.71,
      "text": "Erm, no, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.81,
      "end_seconds": 159.31,
      "duration_seconds": 2.5,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.69,
      "end_seconds": 164.08,
      "duration_seconds": 3.39,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.05,
      "end_seconds": 168.95,
      "duration_seconds": 2.9,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.78,
      "end_seconds": 181.87,
      "duration_seconds": 2.09,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.98,
      "end_seconds": 212.29,
      "duration_seconds": 10.31,
      "text": "Okay: temperature is 36.9 degrees, saturation 92 percent. And blood pressure 130 over 83, pulse is 86 beats a minute, respiratory rate 24."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.99,
      "end_seconds": 219.14,
      "duration_seconds": 4.15,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.54,
      "end_seconds": 222.0,
      "duration_seconds": 1.46,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.98,
      "end_seconds": 241.21,
      "duration_seconds": 6.23,
      "text": "There are crackles all the way up both lungs and you are breathing very fast."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.62,
      "end_seconds": 260.35,
      "duration_seconds": 13.73,
      "text": "All finished, thank you. Okay, so my impression is this: I don't have a clear answer today: acute pulmonary oedema is possible, and so is a severe chest infection."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.85,
      "end_seconds": 298.24,
      "duration_seconds": 21.39,
      "text": "I'm sending you for blood tests because of pulmonary oedema. I'm going to put you on furosemide, 40 milligrams, once now, single dose. That's for fluid on the lungs. Sit upright, I am giving oxygen and a water tablet injection now. Please come and see me straight away."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.74,
      "end_seconds": 302.62,
      "duration_seconds": 2.88,
      "text": "Ah, alright, I'll be back."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.49,
      "end_seconds": 308.05,
      "duration_seconds": 3.56,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.85,
      "end_seconds": 312.1,
      "duration_seconds": 2.25,
      "text": "Thank you, that's helpful."
    }
  ]
}