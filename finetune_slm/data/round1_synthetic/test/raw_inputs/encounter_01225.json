{
  "schema_version": "1.0",
  "encounter_id": "01225",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.78,
      "end_seconds": 3.85,
      "duration_seconds": 3.07,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.79,
      "end_seconds": 9.95,
      "duration_seconds": 5.16,
      "text": "Okay, not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.85,
      "end_seconds": 17.97,
      "duration_seconds": 6.12,
      "text": "So the thing is, I've got taking a lot of tablets."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.61,
      "end_seconds": 22.22,
      "duration_seconds": 2.61,
      "text": "Okay, did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.72,
      "end_seconds": 29.4,
      "duration_seconds": 5.68,
      "text": "Let me think, it's been going on for five days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.43,
      "end_seconds": 34.89,
      "duration_seconds": 3.46,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.63,
      "end_seconds": 39.13,
      "duration_seconds": 2.5,
      "text": "Ah, I'd call it moderate."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.91,
      "end_seconds": 46.31,
      "duration_seconds": 2.4,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.48,
      "end_seconds": 53.4,
      "duration_seconds": 5.92,
      "text": "Uh, when it starts I tend to get tummy pain as well."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.37,
      "end_seconds": 57.18,
      "duration_seconds": 2.81,
      "text": "Have you been feeling very low?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.12,
      "end_seconds": 68.96,
      "duration_seconds": 10.84,
      "text": "Yes, uh, I have. Hmm, you know, about feeling very low, a eight out of ten, I suppose."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.76,
      "end_seconds": 72.84,
      "duration_seconds": 2.08,
      "text": "Have you been feeling sick?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.57,
      "end_seconds": 80.67,
      "duration_seconds": 7.1,
      "text": "Mm, yes. As for feeling sick, a three out of ten, I suppose."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.65,
      "end_seconds": 89.09,
      "duration_seconds": 6.44,
      "text": "Have you had taking a lot of tablets before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.47,
      "end_seconds": 100.74,
      "duration_seconds": 10.27,
      "text": "Sorry, what was I saying, yes, something like this happened last year, and it went away on its own."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.07,
      "end_seconds": 104.92,
      "duration_seconds": 2.85,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.86,
      "end_seconds": 120.6,
      "duration_seconds": 2.74,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.76,
      "end_seconds": 144.98,
      "duration_seconds": 5.22,
      "text": "Okay: BP is 128 over 73, pulse is 84 beats a minute."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.55,
      "end_seconds": 150.66,
      "duration_seconds": 4.11,
      "text": "Okay, uh, so is that alright, doctor?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.24,
      "end_seconds": 155.21,
      "duration_seconds": 2.97,
      "text": "Right, we'll go over that shortly."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.09,
      "end_seconds": 162.87,
      "duration_seconds": 4.78,
      "text": "Okay, I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.41,
      "end_seconds": 167.56,
      "duration_seconds": 3.15,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.3,
      "end_seconds": 191.16,
      "duration_seconds": 5.86,
      "text": "You are awake and alert, with some tenderness under the right ribs."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.54,
      "end_seconds": 195.25,
      "duration_seconds": 1.71,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.64,
      "end_seconds": 213.43,
      "duration_seconds": 2.79,
      "text": "Did you get chest pain or drowsiness?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.75,
      "end_seconds": 217.63,
      "duration_seconds": 2.88,
      "text": "No, no chest pain or drowsiness."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.57,
      "end_seconds": 221.91,
      "duration_seconds": 2.34,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.89,
      "end_seconds": 224.88,
      "duration_seconds": 0.99,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.55,
      "end_seconds": 228.04,
      "duration_seconds": 2.49,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.48,
      "end_seconds": 231.12,
      "duration_seconds": 1.64,
      "text": "I've got depression."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.12,
      "end_seconds": 234.31,
      "duration_seconds": 1.19,
      "text": "And besides that?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.45,
      "end_seconds": 237.72,
      "duration_seconds": 2.27,
      "text": "Yes, an irregular heartbeat."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.11,
      "end_seconds": 240.09,
      "duration_seconds": 0.98,
      "text": "Anything else?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.69,
      "end_seconds": 243.63,
      "duration_seconds": 1.94,
      "text": "I've got heart disease."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.48,
      "end_seconds": 252.86,
      "duration_seconds": 7.38,
      "text": "Right, so depression is already on your record. We'll keep that in mind today. Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.21,
      "end_seconds": 255.74,
      "duration_seconds": 1.53,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.26,
      "end_seconds": 258.7,
      "duration_seconds": 1.44,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.65,
      "end_seconds": 262.38,
      "duration_seconds": 2.73,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.32,
      "end_seconds": 265.96,
      "duration_seconds": 2.64,
      "text": "Right, tell me about your eating."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.92,
      "end_seconds": 273.01,
      "duration_seconds": 6.09,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.66,
      "end_seconds": 278.34,
      "duration_seconds": 4.68,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.52,
      "end_seconds": 287.85,
      "duration_seconds": 4.33,
      "text": "I'm allergic to tramadol, I get feeling very drowsy."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.2,
      "end_seconds": 304.77,
      "duration_seconds": 2.57,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.75,
      "end_seconds": 309.65,
      "duration_seconds": 3.9,
      "text": "Just a triple bypass, eight years ago."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.12,
      "end_seconds": 322.33,
      "duration_seconds": 2.21,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.33,
      "end_seconds": 333.84,
      "duration_seconds": 9.51,
      "text": "Oh, it's mirtazapine, 15 milligrams, at night. Warfarin. I take it 3 milligrams, maybe, in the evening."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.24,
      "end_seconds": 340.35,
      "duration_seconds": 3.11,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.02,
      "end_seconds": 350.49,
      "duration_seconds": 8.47,
      "text": "No, it's at home. Uh, um, before this I was on bisoprolol; that's been stopped."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.34,
      "end_seconds": 375.48,
      "duration_seconds": 23.14,
      "text": "Right, here's what I'm thinking. The most likely explanation is a significant paracetamol overdose needing urgent treatment. That's my thinking for now, and it may change as we learn more. A mixed overdose is still possible. I'll request liver function tests, it'll help with overdose. A paracetamol level is what I'd like next, for overdose."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 376.24,
      "end_seconds": 378.59,
      "duration_seconds": 2.35,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.21,
      "end_seconds": 400.29,
      "duration_seconds": 21.08,
      "text": "I'd like you to take acetylcysteine, per protocol, over 21 hours, per protocol. It's for paracetamol overdose. You need to stay in hospital for treatment, and someone will speak to you about how you are feeling. I'll also refer you to the emergency team."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 402.28,
      "end_seconds": 402.98,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 404.74,
      "end_seconds": 420.05,
      "duration_seconds": 15.31,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. One warning sign to remember: the symptoms get worse. In that case don't wait."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 421.14,
      "end_seconds": 424.18,
      "duration_seconds": 3.04,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 425.59,
      "end_seconds": 427.7,
      "duration_seconds": 2.11,
      "text": "Book a review straight away."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 428.38,
      "end_seconds": 430.29,
      "duration_seconds": 1.91,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 432.36,
      "end_seconds": 434.98,
      "duration_seconds": 2.62,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 436.14,
      "end_seconds": 437.8,
      "duration_seconds": 1.66,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 438.68,
      "end_seconds": 440.09,
      "duration_seconds": 1.41,
      "text": "See you soon."
    }
  ]
}