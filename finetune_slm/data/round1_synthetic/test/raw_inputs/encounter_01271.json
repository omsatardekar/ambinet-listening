{
  "schema_version": "1.0",
  "encounter_id": "01271",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.12,
      "end_seconds": 5.59,
      "duration_seconds": 4.47,
      "text": "Morning, doctor. I've settled them in, ready when you are."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.45,
      "end_seconds": 9.52,
      "duration_seconds": 3.07,
      "text": "Thank you. Right, hello, what's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 11.51,
      "end_seconds": 27.82,
      "duration_seconds": 16.31,
      "text": "Mainly scaly red plaques on my elbows. There's a couple of other things, but that's the main one. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.19,
      "end_seconds": 32.63,
      "duration_seconds": 3.44,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 34.49,
      "end_seconds": 37.93,
      "duration_seconds": 3.44,
      "text": "Erm, it's been about four days now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.63,
      "end_seconds": 41.33,
      "duration_seconds": 1.7,
      "text": "Anything that improves it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 43.3,
      "end_seconds": 46.15,
      "duration_seconds": 2.85,
      "text": "Only moisturiser, and it's not much."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.7,
      "end_seconds": 51.16,
      "duration_seconds": 3.46,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 52.22,
      "end_seconds": 54.72,
      "duration_seconds": 2.5,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.9,
      "end_seconds": 58.27,
      "duration_seconds": 2.37,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 59.06,
      "end_seconds": 62.13,
      "duration_seconds": 3.07,
      "text": "A plain emollient, twice a day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.64,
      "end_seconds": 66.64,
      "duration_seconds": 4.0,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 68.58,
      "end_seconds": 70.7,
      "duration_seconds": 2.12,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.21,
      "end_seconds": 86.87,
      "duration_seconds": 4.66,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 88.11,
      "end_seconds": 89.5,
      "duration_seconds": 1.39,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.44,
      "end_seconds": 95.07,
      "duration_seconds": 4.63,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 96.57,
      "end_seconds": 106.2,
      "duration_seconds": 9.63,
      "text": "I walk the dog every morning. Lots of rice, lentils and some fruit. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.52,
      "end_seconds": 115.99,
      "duration_seconds": 1.47,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 117.9,
      "end_seconds": 119.08,
      "duration_seconds": 1.18,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.78,
      "end_seconds": 122.45,
      "duration_seconds": 1.67,
      "text": "Right, how about fever?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 123.06,
      "end_seconds": 124.44,
      "duration_seconds": 1.38,
      "text": "No. No fever."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.54,
      "end_seconds": 129.92,
      "duration_seconds": 4.38,
      "text": "Let me check a few things. Any joint pain or pus?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 131.29,
      "end_seconds": 134.29,
      "duration_seconds": 3.0,
      "text": "Nope, um, nothing like that."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.8,
      "end_seconds": 139.3,
      "duration_seconds": 3.5,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 140.59,
      "end_seconds": 142.21,
      "duration_seconds": 1.62,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 149.77,
      "end_seconds": 161.55,
      "duration_seconds": 11.78,
      "text": "Doctor, I've got the readings for you. Pulse is 65 beats a minute, BP is 115 over 81, SpO2 98 percent on room air, temperature 36.6."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.9,
      "end_seconds": 163.86,
      "duration_seconds": 0.96,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.37,
      "end_seconds": 167.36,
      "duration_seconds": 1.99,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.44,
      "end_seconds": 170.66,
      "duration_seconds": 2.22,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.89,
      "end_seconds": 191.7,
      "duration_seconds": 6.81,
      "text": "There are well-defined silvery plaques on both elbows and a few pits in the nails."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.47,
      "end_seconds": 198.89,
      "duration_seconds": 2.42,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.1,
      "end_seconds": 228.34,
      "duration_seconds": 11.24,
      "text": "So, based on the history and the examination, my working impression is plaque psoriasis. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 229.66,
      "end_seconds": 233.51,
      "duration_seconds": 3.85,
      "text": "I mean, what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.36,
      "end_seconds": 256.45,
      "duration_seconds": 21.09,
      "text": "I understand the worry. At the moment I'd say it's plaque psoriasis, and we'll watch how it goes. What I'm giving you is calcipotriol and betamethasone, 50 micrograms/0.5 mg per g, once a day, four weeks. That's for psoriasis. It's a commonly used medicine and most people tolerate it well."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 257.04,
      "end_seconds": 258.28,
      "duration_seconds": 1.24,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.03,
      "end_seconds": 282.69,
      "duration_seconds": 22.66,
      "text": "Keep the skin well moisturised and avoid picking the plaques. If you get painful or swollen joints, or you feel really unwell, please come to the emergency department. I'd like to see you again in four weeks. Can you tell me the plan back in your own words, so I know I've explained it clearly?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 283.29,
      "end_seconds": 297.82,
      "duration_seconds": 14.53,
      "text": "So, um, I take the calcipotriol and betamethasone, 50 micrograms/0.5 mg per g, once a day and come back in four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.38,
      "end_seconds": 302.94,
      "duration_seconds": 4.56,
      "text": "Yes, exactly right. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 304.25,
      "end_seconds": 307.18,
      "duration_seconds": 2.93,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}