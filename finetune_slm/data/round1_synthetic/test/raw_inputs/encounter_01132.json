{
  "schema_version": "1.0",
  "encounter_id": "01132",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.77,
      "end_seconds": 3.83,
      "duration_seconds": 3.06,
      "text": "Hi there, the chair's free, sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.41,
      "end_seconds": 9.45,
      "duration_seconds": 4.04,
      "text": "Afternoon, um, is this seat fine?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.31,
      "end_seconds": 15.01,
      "duration_seconds": 4.7,
      "text": "Is the form from the front desk all filled in?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.95,
      "end_seconds": 23.69,
      "duration_seconds": 7.74,
      "text": "Well, um, I think so, I handed it in at the counter."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.51,
      "end_seconds": 29.22,
      "duration_seconds": 3.71,
      "text": "Right, what would you like to start with today?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 30.33,
      "end_seconds": 33.46,
      "duration_seconds": 3.13,
      "text": "I've been feeling a bit muddled."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.96,
      "end_seconds": 42.03,
      "duration_seconds": 7.07,
      "text": "Can you tell me when it first started? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.54,
      "end_seconds": 52.4,
      "duration_seconds": 8.86,
      "text": "Uh, you know, around about two weeks... no wait, it's more like about a week."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.23,
      "end_seconds": 56.45,
      "duration_seconds": 2.22,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.11,
      "end_seconds": 68.0,
      "duration_seconds": 10.89,
      "text": "A dry mouth goes along with it, most of the time. The dry mouth? That's been for three weeks."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.75,
      "end_seconds": 71.31,
      "duration_seconds": 2.56,
      "text": "Is there something that settles it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 71.91,
      "end_seconds": 81.89,
      "duration_seconds": 9.98,
      "text": "Only sipping water, and it's not much. Oh, and constipation. That's been about the same, five days."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.13,
      "end_seconds": 87.92,
      "duration_seconds": 4.79,
      "text": "Have you been feeling a bit muddled at any time before this?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.91,
      "end_seconds": 95.91,
      "duration_seconds": 7.0,
      "text": "A bit, a couple of years ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.83,
      "end_seconds": 100.57,
      "duration_seconds": 3.74,
      "text": "Did you get fever, chest pain or falls?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.72,
      "end_seconds": 106.97,
      "duration_seconds": 5.25,
      "text": "I mean, you know, no, not a single one."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.66,
      "end_seconds": 111.21,
      "duration_seconds": 2.55,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 116.23,
      "end_seconds": 120.12,
      "duration_seconds": 3.89,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.64,
      "end_seconds": 124.62,
      "duration_seconds": 2.98,
      "text": "Right, has your skin been okay?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.62,
      "end_seconds": 126.73,
      "duration_seconds": 1.11,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.97,
      "end_seconds": 130.49,
      "duration_seconds": 2.52,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.33,
      "end_seconds": 137.42,
      "duration_seconds": 6.09,
      "text": "I had two stents put in my heart three years ago."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.88,
      "end_seconds": 154.27,
      "duration_seconds": 3.39,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.93,
      "end_seconds": 159.49,
      "duration_seconds": 3.56,
      "text": "Kiwi. I come out in... well, hives."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.23,
      "end_seconds": 162.88,
      "duration_seconds": 1.65,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.58,
      "end_seconds": 168.35,
      "duration_seconds": 4.77,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.31,
      "end_seconds": 173.39,
      "duration_seconds": 3.08,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.29,
      "end_seconds": 178.29,
      "duration_seconds": 3.0,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.88,
      "end_seconds": 181.19,
      "duration_seconds": 1.31,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 182.56,
      "end_seconds": 187.44,
      "duration_seconds": 4.88,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.09,
      "end_seconds": 192.64,
      "duration_seconds": 4.55,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 193.41,
      "end_seconds": 195.69,
      "duration_seconds": 2.28,
      "text": "Yes, an enlarged prostate."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.39,
      "end_seconds": 199.29,
      "duration_seconds": 0.9,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.08,
      "end_seconds": 202.63,
      "duration_seconds": 2.55,
      "text": "I've had heart disease, yes."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.71,
      "end_seconds": 205.11,
      "duration_seconds": 1.4,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.24,
      "end_seconds": 219.38,
      "duration_seconds": 2.14,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 221.0,
      "end_seconds": 239.58,
      "duration_seconds": 18.58,
      "text": "Right, uh, I'm on tamsulosin, 0.4 milligrams, at night. Um, it's a sleeping tablet, 3.75 milligrams, at night. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.25,
      "end_seconds": 243.34,
      "duration_seconds": 2.09,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.89,
      "end_seconds": 259.84,
      "duration_seconds": 2.95,
      "text": "Okay, nearly done with the readings..."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.91,
      "end_seconds": 288.99,
      "duration_seconds": 10.08,
      "text": "Okay: oxygen saturation is 96 percent, temperature 37.1. And blood pressure 99 over 64, heart rate 105, respiratory rate 17."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.97,
      "end_seconds": 295.64,
      "duration_seconds": 3.67,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 297.36,
      "end_seconds": 299.81,
      "duration_seconds": 2.45,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 314.08,
      "end_seconds": 317.79,
      "duration_seconds": 3.71,
      "text": "Your blood pressure drops a little on standing."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.84,
      "end_seconds": 322.08,
      "duration_seconds": 2.24,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 339.37,
      "end_seconds": 346.77,
      "duration_seconds": 7.4,
      "text": "Okay, so my impression is this: The most likely explanation is side effects from several medicines taken together."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 348.78,
      "end_seconds": 350.33,
      "duration_seconds": 1.55,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 351.37,
      "end_seconds": 373.58,
      "duration_seconds": 22.21,
      "text": "I understand the worry. At the moment I'd say it's side effects from several medicines taken together, and we'll know more once the a medication review is back. I want a medication review done, that's for polypharmacy. We will stop the sleeping tablet slowly over two weeks. I think the pharmacist should see you too."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 374.52,
      "end_seconds": 375.22,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 376.84,
      "end_seconds": 387.45,
      "duration_seconds": 10.61,
      "text": "I'd like to see you again in two weeks. Can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 388.62,
      "end_seconds": 393.7,
      "duration_seconds": 5.08,
      "text": "So, I come back in two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 394.41,
      "end_seconds": 400.25,
      "duration_seconds": 5.84,
      "text": "Yes, exactly right. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 403.96,
      "end_seconds": 409.65,
      "duration_seconds": 5.69,
      "text": "Okay, you know, that makes sense. Thanks for explaining."
    }
  ]
}