{
  "schema_version": "1.0",
  "encounter_id": "01259",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.18,
      "end_seconds": 5.23,
      "duration_seconds": 4.05,
      "text": "Morning doctor. I've settled them in ready when you are."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.58,
      "end_seconds": 10.1,
      "duration_seconds": 3.52,
      "text": "Perfect, thanks. Hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.1,
      "end_seconds": 16.27,
      "duration_seconds": 4.17,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.6,
      "end_seconds": 21.9,
      "duration_seconds": 4.3,
      "text": "of course, please stay it's helpful to have you here"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 22.75,
      "end_seconds": 26.27,
      "duration_seconds": 3.52,
      "text": "I've, I've been feeling a bit muddled"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.36,
      "end_seconds": 32.23,
      "duration_seconds": 3.87,
      "text": "when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 34.05,
      "end_seconds": 37.21,
      "duration_seconds": 3.16,
      "text": "About a week, give or take."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 39.1,
      "end_seconds": 43.32,
      "duration_seconds": 4.22,
      "text": "ah, hm, I'd say more like two weeks"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.3,
      "end_seconds": 49.73,
      "duration_seconds": 4.43,
      "text": "okay so roughly one to two weeks is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 51.37,
      "end_seconds": 53.23,
      "duration_seconds": 1.86,
      "text": "that sounds about right"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.33,
      "end_seconds": 58.2,
      "duration_seconds": 3.87,
      "text": "rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 59.99,
      "end_seconds": 61.12,
      "duration_seconds": 1.13,
      "text": "Mostly mild."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.18,
      "end_seconds": 66.86,
      "duration_seconds": 3.68,
      "text": "what about dizziness on standing, have you noticed that?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 67.44,
      "end_seconds": 70.07,
      "duration_seconds": 2.63,
      "text": "Actually, yes, for six months."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.05,
      "end_seconds": 73.52,
      "duration_seconds": 2.47,
      "text": "is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 74.91,
      "end_seconds": 77.66,
      "duration_seconds": 2.75,
      "text": "I'd say on and off"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 78.99,
      "end_seconds": 81.15,
      "duration_seconds": 2.16,
      "text": "Yes, exactly like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.09,
      "end_seconds": 85.38,
      "duration_seconds": 3.29,
      "text": "Any chest pain or falls at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 86.94,
      "end_seconds": 97.01,
      "duration_seconds": 10.07,
      "text": "No no chest pain no falls. I did have constipation at one point but that went away on its own."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.04,
      "end_seconds": 100.77,
      "duration_seconds": 2.73,
      "text": "have you had fever by any chance?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 102.68,
      "end_seconds": 105.92,
      "duration_seconds": 3.24,
      "text": "no, I haven't had any fever"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.59,
      "end_seconds": 109.7,
      "duration_seconds": 2.11,
      "text": "anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 111.41,
      "end_seconds": 113.55,
      "duration_seconds": 2.14,
      "text": "no that's all fine"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.23,
      "end_seconds": 118.45,
      "duration_seconds": 3.22,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 123.73,
      "end_seconds": 130.5,
      "duration_seconds": 6.77,
      "text": "I've got an enlarged prostate. High blood pressure for nearly five years"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.59,
      "end_seconds": 142.3,
      "duration_seconds": 7.71,
      "text": "Okay, go on. So, yes, an enlarged prostate is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.45,
      "end_seconds": 157.81,
      "duration_seconds": 3.36,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 159.74,
      "end_seconds": 162.1,
      "duration_seconds": 2.36,
      "text": "I take tamsulosin, at night"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.92,
      "end_seconds": 166.34,
      "duration_seconds": 2.42,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 167.89,
      "end_seconds": 185.75,
      "duration_seconds": 17.86,
      "text": "0.4 milligrams, I think that's what's on the box it's lisinopril, 10 milligrams, once a day it's a sleeping tablet, 3.75 milligrams, at night i, I'd been on hydrochlorothiazide, not any more though, I stopped"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.03,
      "end_seconds": 191.42,
      "duration_seconds": 4.39,
      "text": "has anything ever caused you a reaction? I mean any allergies"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 193.27,
      "end_seconds": 205.85,
      "duration_seconds": 12.58,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.53,
      "end_seconds": 210.4,
      "duration_seconds": 2.87,
      "text": "a few questions about your lifestyle now"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 211.91,
      "end_seconds": 222.61,
      "duration_seconds": 10.7,
      "text": "Nothing, I'm teetotal. I quit smoking around ten years ago. Lots of rice, lentils and some fruit. I walk the dog every morning."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.17,
      "end_seconds": 224.39,
      "duration_seconds": 1.22,
      "text": "any previous surgeries?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 226.4,
      "end_seconds": 227.44,
      "duration_seconds": 1.04,
      "text": "no never"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 246.27,
      "end_seconds": 253.75,
      "duration_seconds": 7.48,
      "text": "Here are the the numbers doctor. Pressure 94 over 57 SpO2 99 percent on room air heart rate 111."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.07,
      "end_seconds": 256.01,
      "duration_seconds": 0.94,
      "text": "okay, noted"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.41,
      "end_seconds": 262.91,
      "duration_seconds": 4.5,
      "text": "I'd like to check you over now, if that's alright"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 264.06,
      "end_seconds": 265.5,
      "duration_seconds": 1.44,
      "text": "Yeah no problem."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.16,
      "end_seconds": 268.87,
      "duration_seconds": 1.71,
      "text": "let me feel here"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.89,
      "end_seconds": 287.78,
      "duration_seconds": 3.89,
      "text": "your blood pressure drops a little on standing"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.07,
      "end_seconds": 306.64,
      "duration_seconds": 14.57,
      "text": "thank you you can get dressed. Having listened and examined I'd lean towards side effects from several medicines taken together. It could also be dehydration so we'll keep that open"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 308.12,
      "end_seconds": 310.39,
      "duration_seconds": 2.27,
      "text": "is this serious, doctor?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.75,
      "end_seconds": 329.08,
      "duration_seconds": 17.33,
      "text": "It's reasonable to be concerned, but right now side effects from several medicines taken together is my leading thought, not anything worse. I'm going to order a medication review, for polypharmacy. Blood tests is what I'd like next, for dizziness."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 330.94,
      "end_seconds": 332.05,
      "duration_seconds": 1.11,
      "text": "right, understood"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.57,
      "end_seconds": 351.48,
      "duration_seconds": 17.91,
      "text": "We will stop the sleeping tablet slowly over two weeks. We'll refer you to the pharmacist. One warning sign to remember: the symptoms get worse. In that case don't wait. Please come and see me in two weeks. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 354.81,
      "end_seconds": 358.19,
      "duration_seconds": 3.38,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.43,
      "end_seconds": 360.69,
      "duration_seconds": 1.26,
      "text": "all the best"
    }
  ]
}