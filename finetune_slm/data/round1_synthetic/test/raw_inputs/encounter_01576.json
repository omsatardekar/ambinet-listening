{
  "schema_version": "1.0",
  "encounter_id": "01576",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.13,
      "end_seconds": 7.53,
      "duration_seconds": 6.4,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.94,
      "end_seconds": 13.77,
      "duration_seconds": 4.83,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.73,
      "end_seconds": 25.33,
      "duration_seconds": 10.6,
      "text": "I'm here because of a barking cough. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.11,
      "end_seconds": 28.29,
      "duration_seconds": 1.18,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.62,
      "end_seconds": 37.3,
      "duration_seconds": 7.68,
      "text": "Uh, probably about four days. Yeah. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.35,
      "end_seconds": 47.69,
      "duration_seconds": 9.34,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.65,
      "end_seconds": 58.55,
      "duration_seconds": 9.9,
      "text": "Right, it's worse with night. A eight out of ten, I suppose. It happens on and off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.86,
      "end_seconds": 80.68,
      "duration_seconds": 5.82,
      "text": "And what about blue lips, noisy breathing when resting, difficulty swallowing or drooling?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.63,
      "end_seconds": 85.27,
      "duration_seconds": 2.64,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.26,
      "end_seconds": 88.22,
      "duration_seconds": 1.96,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.58,
      "end_seconds": 91.85,
      "duration_seconds": 2.27,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.9,
      "end_seconds": 96.72,
      "duration_seconds": 3.82,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.59,
      "end_seconds": 101.15,
      "duration_seconds": 1.56,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.86,
      "end_seconds": 104.49,
      "duration_seconds": 2.63,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.99,
      "end_seconds": 111.53,
      "duration_seconds": 5.54,
      "text": "Let me think, um, nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.46,
      "end_seconds": 115.97,
      "duration_seconds": 3.51,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.73,
      "end_seconds": 118.41,
      "duration_seconds": 1.68,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.32,
      "end_seconds": 121.77,
      "duration_seconds": 2.45,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.65,
      "end_seconds": 126.49,
      "duration_seconds": 2.84,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.09,
      "end_seconds": 142.35,
      "duration_seconds": 1.26,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.86,
      "end_seconds": 147.38,
      "duration_seconds": 4.52,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.04,
      "end_seconds": 151.51,
      "duration_seconds": 2.47,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.9,
      "end_seconds": 156.74,
      "duration_seconds": 3.84,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.55,
      "end_seconds": 174.88,
      "duration_seconds": 5.33,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.64,
      "end_seconds": 178.87,
      "duration_seconds": 2.23,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.62,
      "end_seconds": 182.38,
      "duration_seconds": 2.76,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.63,
      "end_seconds": 195.01,
      "duration_seconds": 2.38,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.91,
      "end_seconds": 218.4,
      "duration_seconds": 9.49,
      "text": "Okay: saturation 99 percent, temperature 36.7, pulse is 84 beats a minute, respiratory rate 18, BP is 127 over 74."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.36,
      "end_seconds": 224.03,
      "duration_seconds": 3.67,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.5,
      "end_seconds": 227.63,
      "duration_seconds": 2.13,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.48,
      "end_seconds": 249.78,
      "duration_seconds": 6.3,
      "text": "He is playful, breathing comfortably at rest, and I can't hear any noisy breathing now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.62,
      "end_seconds": 255.22,
      "duration_seconds": 1.6,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.22,
      "end_seconds": 270.22,
      "duration_seconds": 7.0,
      "text": "So, based on the history and the examination, this looks most like mild croup."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.16,
      "end_seconds": 274.11,
      "duration_seconds": 1.95,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.03,
      "end_seconds": 308.65,
      "duration_seconds": 33.62,
      "text": "I understand the worry. At the moment I'd say it's mild croup, and we'll watch how it goes. You'll be taking dexamethasone, 0.15 mg per kg, once, single dose. That should help with croup. Keep him calm, sit him upright, and give fluids. Keep an eye out, and if he makes a noisy sound when resting or struggles to breathe, call us the same day or go to emergency. Book a review if no better in two days."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.0,
      "end_seconds": 315.97,
      "duration_seconds": 5.97,
      "text": "How would you describe the plan, so we're on the same page?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.05,
      "end_seconds": 328.97,
      "duration_seconds": 10.92,
      "text": "So, I take the dexamethasone, 0.15 mg per kg, once and come back if no better in two days. Is that right?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.8,
      "end_seconds": 334.03,
      "duration_seconds": 4.23,
      "text": "Yes, exactly right. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.05,
      "end_seconds": 338.56,
      "duration_seconds": 3.51,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.82,
      "end_seconds": 341.21,
      "duration_seconds": 1.39,
      "text": "Take care now."
    }
  ]
}