{
  "schema_version": "1.0",
  "encounter_id": "02328",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.96,
      "end_seconds": 5.95,
      "duration_seconds": 4.99,
      "text": "Hmm, hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.71,
      "end_seconds": 14.33,
      "duration_seconds": 4.62,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.2,
      "end_seconds": 28.74,
      "duration_seconds": 12.54,
      "text": "I wanted to get a hot red swollen big toe looked at. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.08,
      "end_seconds": 33.67,
      "duration_seconds": 3.59,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.26,
      "end_seconds": 43.1,
      "duration_seconds": 8.84,
      "text": "Yesterday, it came on out of nowhere. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.11,
      "end_seconds": 48.03,
      "duration_seconds": 2.92,
      "text": "Have you tried anything for it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.06,
      "end_seconds": 55.06,
      "duration_seconds": 2.0,
      "text": "Ice helps a bit."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.64,
      "end_seconds": 71.84,
      "duration_seconds": 3.2,
      "text": "Did you get rash, fever or injury?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.76,
      "end_seconds": 78.04,
      "duration_seconds": 4.28,
      "text": "I haven't had rash, fever or injury, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.58,
      "end_seconds": 83.0,
      "duration_seconds": 4.42,
      "text": "Alright, any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.04,
      "end_seconds": 88.27,
      "duration_seconds": 3.23,
      "text": "No, um, that's all normal."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.04,
      "end_seconds": 93.92,
      "duration_seconds": 4.88,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.17,
      "end_seconds": 99.31,
      "duration_seconds": 4.14,
      "text": "It's ibuprofen, 400 milligrams, three times a day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.17,
      "end_seconds": 115.27,
      "duration_seconds": 4.1,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.05,
      "end_seconds": 120.15,
      "duration_seconds": 4.1,
      "text": "Um, no, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.18,
      "end_seconds": 126.5,
      "duration_seconds": 5.32,
      "text": "Alright, do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.1,
      "end_seconds": 130.35,
      "duration_seconds": 3.25,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.02,
      "end_seconds": 151.92,
      "duration_seconds": 3.9,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.06,
      "end_seconds": 156.49,
      "duration_seconds": 3.43,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.35,
      "end_seconds": 161.06,
      "duration_seconds": 2.71,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.25,
      "end_seconds": 165.57,
      "duration_seconds": 3.32,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.46,
      "end_seconds": 173.44,
      "duration_seconds": 2.98,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.75,
      "end_seconds": 184.2,
      "duration_seconds": 2.45,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.77,
      "end_seconds": 203.01,
      "duration_seconds": 7.24,
      "text": "Okay: heart rate 86, pressure 125 over 76, respiratory rate 17. And temperature is 36.9 degrees."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.09,
      "end_seconds": 207.06,
      "duration_seconds": 1.97,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.24,
      "end_seconds": 210.92,
      "duration_seconds": 2.68,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.98,
      "end_seconds": 216.55,
      "duration_seconds": 4.57,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.19,
      "end_seconds": 219.28,
      "duration_seconds": 2.09,
      "text": "Okay, you know, doctor."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.68,
      "end_seconds": 223.02,
      "duration_seconds": 2.34,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.4,
      "end_seconds": 240.67,
      "duration_seconds": 5.27,
      "text": "The big toe joint is red, hot, swollen and exquisitely tender."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.93,
      "end_seconds": 246.03,
      "duration_seconds": 2.1,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.96,
      "end_seconds": 289.71,
      "duration_seconds": 27.75,
      "text": "Taking everything into account, it fits best with an acute gout attack. I'm sending you for a uric acid blood test because of gout. Rest the foot, ice it, and drink plenty of water; limit beer and red meat. Don't skip meals, and try to eat smaller portions more often through the day. I'd like to see you again in two weeks."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.72,
      "end_seconds": 292.42,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.93,
      "end_seconds": 298.59,
      "duration_seconds": 4.66,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.09,
      "end_seconds": 302.48,
      "duration_seconds": 2.39,
      "text": "Alright, thanks, take care."
    }
  ]
}