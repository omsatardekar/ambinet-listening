{
  "schema_version": "1.0",
  "encounter_id": "02467",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.7,
      "end_seconds": 6.9,
      "duration_seconds": 6.2,
      "text": "Hi there, the chair's free, sit down. Is it your first time here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.63,
      "end_seconds": 13.26,
      "duration_seconds": 4.63,
      "text": "No, I came last year for something else."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.91,
      "end_seconds": 17.85,
      "duration_seconds": 3.94,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.63,
      "end_seconds": 25.57,
      "duration_seconds": 5.94,
      "text": "Um, so... spots on my forehead and chin. That's why I came."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.23,
      "end_seconds": 31.48,
      "duration_seconds": 4.25,
      "text": "Right, are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 35.72,
      "end_seconds": 41.71,
      "duration_seconds": 5.99,
      "text": "I take carvedilol, 6.25 milligrams, twice a day for my heart."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.46,
      "end_seconds": 45.9,
      "duration_seconds": 3.44,
      "text": "So, how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.77,
      "end_seconds": 49.16,
      "duration_seconds": 2.39,
      "text": "About... well, about four days."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.08,
      "end_seconds": 52.52,
      "duration_seconds": 2.44,
      "text": "Have you had a few blackheads?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 53.22,
      "end_seconds": 54.72,
      "duration_seconds": 1.5,
      "text": "Yes, since yesterday."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.21,
      "end_seconds": 76.99,
      "duration_seconds": 4.78,
      "text": "Have you noticed scarring, painful cysts, irregular periods or low mood?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.52,
      "end_seconds": 85.72,
      "duration_seconds": 3.2,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.6,
      "end_seconds": 90.0,
      "duration_seconds": 3.4,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.19,
      "end_seconds": 92.9,
      "duration_seconds": 1.71,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.83,
      "end_seconds": 96.25,
      "duration_seconds": 2.42,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.98,
      "end_seconds": 100.85,
      "duration_seconds": 3.87,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.57,
      "end_seconds": 103.92,
      "duration_seconds": 1.35,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 105.43,
      "end_seconds": 108.37,
      "duration_seconds": 2.94,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.15,
      "end_seconds": 113.4,
      "duration_seconds": 3.25,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.05,
      "end_seconds": 121.19,
      "duration_seconds": 6.14,
      "text": "I had a meniscus repair on my knee four years ago."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.71,
      "end_seconds": 137.06,
      "duration_seconds": 3.35,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 138.36,
      "end_seconds": 142.51,
      "duration_seconds": 4.15,
      "text": "I've had heart failure for five years now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.86,
      "end_seconds": 161.41,
      "duration_seconds": 2.55,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.17,
      "end_seconds": 168.42,
      "duration_seconds": 5.25,
      "text": "Nickel. I come out in... well, a rash on my skin."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.84,
      "end_seconds": 176.73,
      "duration_seconds": 2.89,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.07,
      "end_seconds": 190.31,
      "duration_seconds": 2.24,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.99,
      "end_seconds": 210.64,
      "duration_seconds": 7.65,
      "text": "Okay: pulse 71, saturation 98 percent, respiratory rate 17. And temperature 36.5, blood pressure 121 over 75."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.89,
      "end_seconds": 217.37,
      "duration_seconds": 4.48,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 218.32,
      "end_seconds": 219.47,
      "duration_seconds": 1.15,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.36,
      "end_seconds": 223.4,
      "duration_seconds": 2.04,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.12,
      "end_seconds": 239.99,
      "duration_seconds": 5.87,
      "text": "There are small blackheads and a few red spots with no deep cysts."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.46,
      "end_seconds": 251.48,
      "duration_seconds": 7.02,
      "text": "Good, you can sit up again. Okay, thinking it through, it points towards mild acne."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 255.54,
      "end_seconds": 258.26,
      "duration_seconds": 2.72,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.85,
      "end_seconds": 266.47,
      "duration_seconds": 7.62,
      "text": "I understand the worry. At the moment I'd say it's mild acne, and we'll watch how it goes."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 280.87,
      "end_seconds": 310.57,
      "duration_seconds": 29.7,
      "text": "The treatment will be benzoyl peroxide gel, 5%, once a day, eight weeks. That's for acne. I'll put all of this in writing so you don't have to remember it. Wash gently twice a day and don't squeeze the spots. Please take the tablets with food so they don't upset your stomach. I'd like you back in eight weeks. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 312.1,
      "end_seconds": 315.3,
      "duration_seconds": 3.2,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}