{
  "schema_version": "1.0",
  "encounter_id": "01525",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.94,
      "end_seconds": 6.5,
      "duration_seconds": 5.56,
      "text": "Ah, hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.44,
      "end_seconds": 12.21,
      "duration_seconds": 4.77,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.94,
      "end_seconds": 16.44,
      "duration_seconds": 3.5,
      "text": "So, I've been feeling faint, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.03,
      "end_seconds": 19.83,
      "duration_seconds": 2.8,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.7,
      "end_seconds": 32.56,
      "duration_seconds": 11.86,
      "text": "Honestly I can't say exactly when it started. It might have been last month or the month before, I really can't pin it down."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.43,
      "end_seconds": 35.31,
      "duration_seconds": 1.88,
      "text": "Anything that improves it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.83,
      "end_seconds": 39.02,
      "duration_seconds": 3.19,
      "text": "I get some relief from lying down."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.74,
      "end_seconds": 43.34,
      "duration_seconds": 2.6,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.37,
      "end_seconds": 53.89,
      "duration_seconds": 9.52,
      "text": "It usually comes with chest pressure. The chest pressure? That's been for two months. About chest pressure, it's mild, honestly."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.54,
      "end_seconds": 58.24,
      "duration_seconds": 3.7,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.43,
      "end_seconds": 63.93,
      "duration_seconds": 4.5,
      "text": "I take metoprolol, 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.37,
      "end_seconds": 66.85,
      "duration_seconds": 2.48,
      "text": "Mm, okay. What about alcohol?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.76,
      "end_seconds": 71.64,
      "duration_seconds": 2.88,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.42,
      "end_seconds": 74.75,
      "duration_seconds": 2.33,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.33,
      "end_seconds": 80.97,
      "duration_seconds": 4.64,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.72,
      "end_seconds": 85.08,
      "duration_seconds": 2.36,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.43,
      "end_seconds": 91.02,
      "duration_seconds": 4.59,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.97,
      "end_seconds": 95.83,
      "duration_seconds": 2.86,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.85,
      "end_seconds": 101.89,
      "duration_seconds": 4.04,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.86,
      "end_seconds": 122.04,
      "duration_seconds": 3.18,
      "text": "Okay, do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.71,
      "end_seconds": 125.26,
      "duration_seconds": 2.55,
      "text": "I've had heart disease, yes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.85,
      "end_seconds": 129.4,
      "duration_seconds": 2.55,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.45,
      "end_seconds": 135.27,
      "duration_seconds": 4.82,
      "text": "Just keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.48,
      "end_seconds": 143.03,
      "duration_seconds": 4.55,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.1,
      "end_seconds": 147.05,
      "duration_seconds": 1.95,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.7,
      "end_seconds": 152.11,
      "duration_seconds": 3.41,
      "text": "Any leg swelling, cough or fever at all?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.68,
      "end_seconds": 157.2,
      "duration_seconds": 3.52,
      "text": "No, you know, I'd have said so."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.98,
      "end_seconds": 161.56,
      "duration_seconds": 2.58,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.62,
      "end_seconds": 165.88,
      "duration_seconds": 3.26,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.23,
      "end_seconds": 169.81,
      "duration_seconds": 2.58,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.78,
      "end_seconds": 184.19,
      "duration_seconds": 2.41,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.29,
      "end_seconds": 205.48,
      "duration_seconds": 8.19,
      "text": "Okay: BP is 104 over 56, temperature 36.9, SpO2 99 percent on room air, heart rate 102."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.84,
      "end_seconds": 212.4,
      "duration_seconds": 4.56,
      "text": "Right, I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.36,
      "end_seconds": 216.52,
      "duration_seconds": 2.16,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.28,
      "end_seconds": 237.03,
      "duration_seconds": 6.75,
      "text": "Your pulse is over one hundred and eighty and your blood pressure is low."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.18,
      "end_seconds": 254.88,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.67,
      "end_seconds": 270.87,
      "duration_seconds": 10.2,
      "text": "You can relax now. Taking everything into account, this looks most like a dangerous fast heart rhythm. Supraventricular tachycardia is also on my list."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.0,
      "end_seconds": 274.54,
      "duration_seconds": 2.54,
      "text": "Right, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.06,
      "end_seconds": 282.82,
      "duration_seconds": 7.76,
      "text": "I can't promise yet, but most people with a dangerous fast heart rhythm do well once it's treated properly."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.34,
      "end_seconds": 306.25,
      "duration_seconds": 15.91,
      "text": "Let's get an urgent ECG, for fast heart rhythm. Lie flat, I am calling the emergency team and preparing to shock the heart. Book a review straight away. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.2,
      "end_seconds": 310.51,
      "duration_seconds": 3.31,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}