{
  "schema_version": "1.0",
  "encounter_id": "02156",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.53,
      "end_seconds": 4.43,
      "duration_seconds": 3.9,
      "text": "Evening. Let's get started. Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.31,
      "end_seconds": 14.67,
      "duration_seconds": 6.36,
      "text": "So the thing is, I've got spots on my forehead and chin."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.35,
      "end_seconds": 19.11,
      "duration_seconds": 2.76,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 20.1,
      "end_seconds": 31.14,
      "duration_seconds": 11.04,
      "text": "I've had it since last Tuesday. I took the morning off to come in today. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.49,
      "end_seconds": 37.41,
      "duration_seconds": 2.92,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.45,
      "end_seconds": 48.45,
      "duration_seconds": 10.0,
      "text": "I'd give it a seven, you know, out of ten. I've also had oily skin, since last weekend."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 49.54,
      "end_seconds": 53.1,
      "duration_seconds": 3.56,
      "text": "Have you noticed low mood or irregular periods?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 58.41,
      "end_seconds": 61.77,
      "duration_seconds": 3.36,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 63.47,
      "end_seconds": 66.52,
      "duration_seconds": 3.05,
      "text": "Did you get scarring or painful cysts?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.31,
      "end_seconds": 73.05,
      "duration_seconds": 4.74,
      "text": "Hmm, no, I haven't had any of them."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.55,
      "end_seconds": 76.69,
      "duration_seconds": 2.14,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.41,
      "end_seconds": 80.49,
      "duration_seconds": 3.08,
      "text": "Actually, bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.36,
      "end_seconds": 91.93,
      "duration_seconds": 2.57,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 93.97,
      "end_seconds": 100.18,
      "duration_seconds": 6.21,
      "text": "Just a cataract operation in my left eye, about a year ago."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.57,
      "end_seconds": 106.61,
      "duration_seconds": 5.04,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.92,
      "end_seconds": 119.41,
      "duration_seconds": 11.49,
      "text": "My husband and I live above the shop. I'm a plumber, lots of bending and kneeling. I swim twice a week."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.44,
      "end_seconds": 123.37,
      "duration_seconds": 2.93,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 127.8,
      "end_seconds": 133.12,
      "duration_seconds": 5.32,
      "text": "I'm allergic to nickel, I get a rash on my skin."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.29,
      "end_seconds": 148.21,
      "duration_seconds": 2.92,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.18,
      "end_seconds": 152.73,
      "duration_seconds": 2.55,
      "text": "My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.57,
      "end_seconds": 158.9,
      "duration_seconds": 3.33,
      "text": "any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.7,
      "end_seconds": 162.99,
      "duration_seconds": 2.29,
      "text": "yes, high blood pressure"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.87,
      "end_seconds": 167.18,
      "duration_seconds": 2.31,
      "text": "tell me your medicines, please"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 168.95,
      "end_seconds": 171.5,
      "duration_seconds": 2.55,
      "text": "Ramipril, 5 milligrams, every morning."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.51,
      "end_seconds": 176.54,
      "duration_seconds": 3.03,
      "text": "how long have you been on it?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 177.94,
      "end_seconds": 180.02,
      "duration_seconds": 2.08,
      "text": "about nearly five years"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.08,
      "end_seconds": 199.34,
      "duration_seconds": 3.26,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.7,
      "end_seconds": 208.13,
      "duration_seconds": 2.43,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.94,
      "end_seconds": 227.36,
      "duration_seconds": 8.42,
      "text": "okay: pressure 116 over 72, respiratory rate 16. And pulse is 67 beats a minute, temperature 36.8."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.62,
      "end_seconds": 233.9,
      "duration_seconds": 4.28,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 235.76,
      "end_seconds": 237.11,
      "duration_seconds": 1.35,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.79,
      "end_seconds": 240.95,
      "duration_seconds": 2.16,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.3,
      "end_seconds": 255.18,
      "duration_seconds": 5.88,
      "text": "there are small blackheads and a few red spots with no deep cysts"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.47,
      "end_seconds": 279.19,
      "duration_seconds": 19.72,
      "text": "That's all I needed to check. Okay, so my impression is this: The most likely explanation is mild acne. What I'm giving you is benzoyl peroxide gel, 5%, once a day, eight weeks. That should help with acne. It's a commonly used medicine and most people tolerate it well."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 281.21,
      "end_seconds": 283.98,
      "duration_seconds": 2.77,
      "text": "How soon will it work?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.91,
      "end_seconds": 303.09,
      "duration_seconds": 18.18,
      "text": "Wash gently twice a day and don't squeeze the spots. Come back or go to emergency straight away if the symptoms get worse. Please come and see me in eight weeks. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 304.92,
      "end_seconds": 306.96,
      "duration_seconds": 2.04,
      "text": "thank you, doctor, goodbye"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 308.35,
      "end_seconds": 310.06,
      "duration_seconds": 1.71,
      "text": "Have a good day."
    }
  ]
}