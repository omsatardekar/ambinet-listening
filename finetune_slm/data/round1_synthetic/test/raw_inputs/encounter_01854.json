{
  "schema_version": "1.0",
  "encounter_id": "01854",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.25,
      "end_seconds": 6.39,
      "duration_seconds": 5.14,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.8,
      "end_seconds": 12.69,
      "duration_seconds": 4.89,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.52,
      "end_seconds": 17.25,
      "duration_seconds": 3.73,
      "text": "So the thing is, I've got a headache."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.96,
      "end_seconds": 23.2,
      "duration_seconds": 3.24,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.16,
      "end_seconds": 27.44,
      "duration_seconds": 3.28,
      "text": "Ever since... since this morning, really."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.13,
      "end_seconds": 38.2,
      "duration_seconds": 9.07,
      "text": "Okay, give me more detail on it, whatever comes to mind. These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.83,
      "end_seconds": 49.11,
      "duration_seconds": 5.28,
      "text": "Erm, I'd say on and off. It's severe, honestly."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.76,
      "end_seconds": 53.45,
      "duration_seconds": 3.69,
      "text": "What about shoulder tightness, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.12,
      "end_seconds": 61.97,
      "duration_seconds": 6.85,
      "text": "Yeah. One week, I'd say. With shoulder tightness, it just comes and goes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.67,
      "end_seconds": 70.44,
      "duration_seconds": 7.77,
      "text": "Let me check a few things. Any numbness in the arms, loss of consciousness or weakness?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.08,
      "end_seconds": 76.42,
      "duration_seconds": 4.34,
      "text": "Oh, um, no, not a single one."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.12,
      "end_seconds": 79.2,
      "duration_seconds": 2.08,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.31,
      "end_seconds": 83.54,
      "duration_seconds": 3.23,
      "text": "So, bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.95,
      "end_seconds": 101.35,
      "duration_seconds": 3.4,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.41,
      "end_seconds": 109.27,
      "duration_seconds": 4.86,
      "text": "I, I take ibuprofen, 400 milligrams, with food."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.61,
      "end_seconds": 121.36,
      "duration_seconds": 3.75,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.3,
      "end_seconds": 132.42,
      "duration_seconds": 10.12,
      "text": "So, yes, amoxicillin. I've no idea what the reaction was, only that I'm not supposed to have it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.05,
      "end_seconds": 137.19,
      "duration_seconds": 4.14,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.81,
      "end_seconds": 140.77,
      "duration_seconds": 1.96,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.21,
      "end_seconds": 152.98,
      "duration_seconds": 1.77,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.51,
      "end_seconds": 156.77,
      "duration_seconds": 3.26,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.33,
      "end_seconds": 158.66,
      "duration_seconds": 1.33,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.3,
      "end_seconds": 167.1,
      "duration_seconds": 3.8,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.48,
      "end_seconds": 172.12,
      "duration_seconds": 3.64,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.96,
      "end_seconds": 181.52,
      "duration_seconds": 2.56,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.78,
      "end_seconds": 207.05,
      "duration_seconds": 6.27,
      "text": "Okay: blood pressure 126 over 69, saturation 97 percent, pulse is 78 beats a minute."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.76,
      "end_seconds": 212.72,
      "duration_seconds": 3.96,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.23,
      "end_seconds": 216.84,
      "duration_seconds": 2.61,
      "text": "So, tell me if that's sore."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.17,
      "end_seconds": 234.2,
      "duration_seconds": 6.03,
      "text": "There is muscle tenderness either side of the neck and no tenderness over the bones."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.21,
      "end_seconds": 241.61,
      "duration_seconds": 3.4,
      "text": "Okay, thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.23,
      "end_seconds": 258.09,
      "duration_seconds": 6.86,
      "text": "From what you've told me and what I found, my working impression is whiplash-type neck strain."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.04,
      "end_seconds": 260.46,
      "duration_seconds": 1.42,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.05,
      "end_seconds": 279.06,
      "duration_seconds": 18.01,
      "text": "Nothing I've seen today points to an emergency. It looks like whiplash-type neck strain. Keep your neck moving gently and avoid a collar. If you get numbness or weakness in your arms, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.53,
      "end_seconds": 282.17,
      "duration_seconds": 1.64,
      "text": "I, I understand."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.09,
      "end_seconds": 293.79,
      "duration_seconds": 9.7,
      "text": "I'd like to see you again if not better in two weeks. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.87,
      "end_seconds": 298.15,
      "duration_seconds": 3.28,
      "text": "Thank you, uh, doctor, goodbye."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.08,
      "end_seconds": 301.38,
      "duration_seconds": 1.3,
      "text": "See you soon."
    }
  ]
}