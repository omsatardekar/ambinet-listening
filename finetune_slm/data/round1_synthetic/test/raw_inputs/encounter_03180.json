{
  "schema_version": "1.0",
  "encounter_id": "03180",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.39,
      "end_seconds": 5.29,
      "duration_seconds": 3.9,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.17,
      "end_seconds": 11.11,
      "duration_seconds": 3.94,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.96,
      "end_seconds": 22.14,
      "duration_seconds": 10.18,
      "text": "Mainly hearing getting worse in both ears. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.24,
      "end_seconds": 26.46,
      "duration_seconds": 3.22,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.02,
      "end_seconds": 32.93,
      "duration_seconds": 5.91,
      "text": "Sorry, what was I saying, I take Eltroxin, every morning."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.7,
      "end_seconds": 38.85,
      "duration_seconds": 2.15,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.25,
      "end_seconds": 46.79,
      "duration_seconds": 6.54,
      "text": "It's 100 micrograms. I'm, I'm on aspirin, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.86,
      "end_seconds": 51.36,
      "duration_seconds": 3.5,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.4,
      "end_seconds": 68.14,
      "duration_seconds": 15.74,
      "text": "I'd say moderate. Uh, and hearing better in a noisy room as well, since last Tuesday. There was ringing in the ears, yes, but that went away."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.99,
      "end_seconds": 72.56,
      "duration_seconds": 3.57,
      "text": "Any discharge, ear pain or facial weakness?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.36,
      "end_seconds": 79.21,
      "duration_seconds": 4.85,
      "text": "I haven't had discharge, ear pain or facial weakness, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.64,
      "end_seconds": 82.47,
      "duration_seconds": 1.83,
      "text": "Any sign of vertigo?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.27,
      "end_seconds": 84.88,
      "duration_seconds": 1.61,
      "text": "No vertigo, thankfully."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.81,
      "end_seconds": 91.12,
      "duration_seconds": 4.31,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.57,
      "end_seconds": 94.68,
      "duration_seconds": 2.11,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.52,
      "end_seconds": 105.84,
      "duration_seconds": 2.32,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.29,
      "end_seconds": 112.72,
      "duration_seconds": 5.43,
      "text": "Just two stents put in my heart, three years ago."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.31,
      "end_seconds": 116.04,
      "duration_seconds": 2.73,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.99,
      "end_seconds": 129.32,
      "duration_seconds": 12.33,
      "text": "I'm vegetarian and have been for years. Not much, I mostly stay in these days. Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.44,
      "end_seconds": 142.93,
      "duration_seconds": 2.49,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.45,
      "end_seconds": 146.64,
      "duration_seconds": 2.19,
      "text": "Yes, an underactive thyroid."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.39,
      "end_seconds": 149.25,
      "duration_seconds": 0.86,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.57,
      "end_seconds": 152.08,
      "duration_seconds": 1.51,
      "text": "Yes, heart disease."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.33,
      "end_seconds": 171.12,
      "duration_seconds": 3.79,
      "text": "Okay, I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.3,
      "end_seconds": 182.55,
      "duration_seconds": 2.25,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.43,
      "end_seconds": 215.83,
      "duration_seconds": 13.4,
      "text": "Okay: BMI works out to 37.8, pulse 68, height 150 centimetres, weight 85 kilos, saturation 98 percent, temperature is 36.5 degrees, pressure 120 over 70."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.11,
      "end_seconds": 218.52,
      "duration_seconds": 1.41,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.68,
      "end_seconds": 225.59,
      "duration_seconds": 2.91,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.13,
      "end_seconds": 230.34,
      "duration_seconds": 2.21,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.96,
      "end_seconds": 234.24,
      "duration_seconds": 2.28,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.68,
      "end_seconds": 250.12,
      "duration_seconds": 6.44,
      "text": "Both ear drums look normal and the tuning fork is heard better through the bone."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.82,
      "end_seconds": 277.88,
      "duration_seconds": 24.06,
      "text": "That's all I needed to check. Taking everything into account, I can't pin this down yet. We're looking at a conductive hearing loss, possibly otosclerosis or wax. I'm going to order a hearing test, for hearing loss. We should do a CT scan of the ears for possible otosclerosis. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.75,
      "end_seconds": 281.47,
      "duration_seconds": 2.72,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.95,
      "end_seconds": 297.63,
      "duration_seconds": 14.68,
      "text": "A hearing aid or an operation are both options after the tests. I'd like you to see the ENT clinic as well, and I'll write the referral. Do get help quickly if the symptoms get worse."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.71,
      "end_seconds": 300.52,
      "duration_seconds": 1.81,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.32,
      "end_seconds": 303.9,
      "duration_seconds": 2.58,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.02,
      "end_seconds": 308.43,
      "duration_seconds": 3.41,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.46,
      "end_seconds": 312.51,
      "duration_seconds": 2.05,
      "text": "Right, goodbye for now."
    }
  ]
}