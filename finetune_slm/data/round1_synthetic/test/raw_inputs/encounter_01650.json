{
  "schema_version": "1.0",
  "encounter_id": "01650",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.8,
      "end_seconds": 7.05,
      "duration_seconds": 6.25,
      "text": "All set here, doctor. Chart's updated, and I'll read the readings out when you're ready."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.74,
      "end_seconds": 11.94,
      "duration_seconds": 4.2,
      "text": "Alright, perfect, thanks. Hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 12.66,
      "end_seconds": 33.27,
      "duration_seconds": 20.61,
      "text": "So, mainly a fall and pain in my left hip. There's a couple of other things, but that's the main one. A neighbour of mine said I should see someone about it. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 35.12,
      "end_seconds": 43.03,
      "duration_seconds": 7.91,
      "text": "Here are the numbers, doctor. Heart rate 70, saturation 98 percent, temperature is 36.9 degrees. BP is 125 over 80."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.75,
      "end_seconds": 49.41,
      "duration_seconds": 5.66,
      "text": "Okay, noted. Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 50.4,
      "end_seconds": 68.71,
      "duration_seconds": 18.31,
      "text": "Moving definitely sets it off. I get some relief from lying still. It feels mild to me. Not being able to stand was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.61,
      "end_seconds": 77.33,
      "duration_seconds": 3.72,
      "text": "Did you get chest pain or loss of consciousness?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 78.07,
      "end_seconds": 81.27,
      "duration_seconds": 3.2,
      "text": "So, no, I'd have said so."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.01,
      "end_seconds": 86.04,
      "duration_seconds": 3.03,
      "text": "Did you get numbness or head injury?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 87.22,
      "end_seconds": 90.39,
      "duration_seconds": 3.17,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.08,
      "end_seconds": 94.04,
      "duration_seconds": 1.96,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 98.07,
      "end_seconds": 99.06,
      "duration_seconds": 0.99,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.99,
      "end_seconds": 105.33,
      "duration_seconds": 4.34,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 106.69,
      "end_seconds": 111.78,
      "duration_seconds": 5.09,
      "text": "Alendronate. I take it 70 milligrams, maybe, once a week."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.09,
      "end_seconds": 117.37,
      "duration_seconds": 4.28,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 118.95,
      "end_seconds": 130.26,
      "duration_seconds": 11.31,
      "text": "Not with me. I'll bring it next time. I take Asthalin inhaler, when needed for my asthma. Paracetamol, 1 gram, when needed."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.98,
      "end_seconds": 151.8,
      "duration_seconds": 2.82,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 153.54,
      "end_seconds": 162.64,
      "duration_seconds": 9.1,
      "text": "I had a reaction to naproxen when I was younger, stomach pain, and I've avoided it since."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.53,
      "end_seconds": 165.93,
      "duration_seconds": 1.4,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 167.91,
      "end_seconds": 169.68,
      "duration_seconds": 1.77,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.54,
      "end_seconds": 173.94,
      "duration_seconds": 3.4,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 175.69,
      "end_seconds": 180.91,
      "duration_seconds": 5.22,
      "text": "Sorry, what was I saying, my uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.51,
      "end_seconds": 185.59,
      "duration_seconds": 3.08,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 187.63,
      "end_seconds": 198.8,
      "duration_seconds": 11.17,
      "text": "I swim twice a week. No, I share a house with my brother. I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.76,
      "end_seconds": 205.58,
      "duration_seconds": 4.82,
      "text": "Do you have any long-term conditions? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 211.69,
      "end_seconds": 225.55,
      "duration_seconds": 13.86,
      "text": "Actually, I've got thin bones. I looked a few things up online, and that probably didn't help. I've had asthma for five years now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.14,
      "end_seconds": 232.37,
      "duration_seconds": 4.23,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.75,
      "end_seconds": 236.0,
      "duration_seconds": 2.25,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.96,
      "end_seconds": 254.16,
      "duration_seconds": 6.2,
      "text": "The left leg is shortened and turned outwards, and it is very painful to move."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.03,
      "end_seconds": 262.58,
      "duration_seconds": 2.55,
      "text": "Okay, please sit back down."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.17,
      "end_seconds": 283.36,
      "duration_seconds": 11.19,
      "text": "Okay, so my impression is this: It's hard to say. A probable hip fracture is one possibility and a pelvic fracture another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 284.84,
      "end_seconds": 286.39,
      "duration_seconds": 1.55,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.29,
      "end_seconds": 295.96,
      "duration_seconds": 8.67,
      "text": "I can't promise yet, but most people with a probable hip fracture do well once it's treated properly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.7,
      "end_seconds": 329.54,
      "duration_seconds": 15.84,
      "text": "I want blood tests done, that's for pre-operative. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. I'd like to see you again straight away."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 335.39,
      "end_seconds": 338.43,
      "duration_seconds": 3.04,
      "text": "Erm, okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.34,
      "end_seconds": 346.75,
      "duration_seconds": 2.41,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 348.57,
      "end_seconds": 352.87,
      "duration_seconds": 4.3,
      "text": "Oh, you know, alright, thanks, take care."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.65,
      "end_seconds": 356.04,
      "duration_seconds": 1.39,
      "text": "All the best."
    }
  ]
}