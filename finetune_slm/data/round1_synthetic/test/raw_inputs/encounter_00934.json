{
  "schema_version": "1.0",
  "encounter_id": "00934",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.37,
      "end_seconds": 14.45,
      "duration_seconds": 14.08,
      "text": "Hello, doctor! I've had psoriasis for years, but now my joints are hurting, and my nails look terrible. I thought it was time to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.8,
      "end_seconds": 22.64,
      "duration_seconds": 6.84,
      "text": "Good to meet you. Tell me about the joints first. Which ones?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.51,
      "end_seconds": 31.62,
      "duration_seconds": 6.11,
      "text": "Mainly my fingers, and my right knee. They're stiff and swollen."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.75,
      "end_seconds": 36.06,
      "duration_seconds": 2.31,
      "text": "When are they worst?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.24,
      "end_seconds": 45.76,
      "duration_seconds": 7.52,
      "text": "In the morning. It takes me a good hour to get going."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.61,
      "end_seconds": 51.74,
      "duration_seconds": 4.13,
      "text": "How long has this been happening?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.81,
      "end_seconds": 57.04,
      "duration_seconds": 4.23,
      "text": "About four months. It started slowly."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.01,
      "end_seconds": 61.16,
      "duration_seconds": 2.15,
      "text": "And the nails?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.56,
      "end_seconds": 73.23,
      "duration_seconds": 9.67,
      "text": "They're pitted, little dents, and a couple of them have come away from the nail bed."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.97,
      "end_seconds": 79.89,
      "duration_seconds": 4.92,
      "text": "Any eye redness or pain, or back pain at night?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.71,
      "end_seconds": 85.58,
      "duration_seconds": 2.87,
      "text": "No. Not that I've noticed."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.35,
      "end_seconds": 90.7,
      "duration_seconds": 4.35,
      "text": "What do you use for the psoriasis?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.39,
      "end_seconds": 98.46,
      "duration_seconds": 5.07,
      "text": "A steroid cream on my elbows, calcipotriol, once a day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.47,
      "end_seconds": 105.32,
      "duration_seconds": 4.85,
      "text": "Do you take anything for the joint pain? ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.7,
      "end_seconds": 111.93,
      "duration_seconds": 4.23,
      "text": "Just ibuprofen, 400 mg, when it's bad."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.82,
      "end_seconds": 116.15,
      "duration_seconds": 2.33,
      "text": "Any other conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.08,
      "end_seconds": 123.32,
      "duration_seconds": 4.24,
      "text": "Psoriasis since I was twenty. That's all."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.48,
      "end_seconds": 130.84,
      "duration_seconds": 5.36,
      "text": "Does psoriasis or arthritis run in the family? ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.64,
      "end_seconds": 135.35,
      "duration_seconds": 3.71,
      "text": "My father had psoriasis. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.43,
      "end_seconds": 140.18,
      "duration_seconds": 3.75,
      "text": "Do you smoke, or drink alcohol?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.17,
      "end_seconds": 146.48,
      "duration_seconds": 5.31,
      "text": "I smoke ten a day. I'd like to cut down."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.71,
      "end_seconds": 153.0,
      "duration_seconds": 5.29,
      "text": "Let me check your blood pressure and pulse. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.88,
      "end_seconds": 167.65,
      "duration_seconds": 1.77,
      "text": "Go on."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.52,
      "end_seconds": 175.61,
      "duration_seconds": 5.09,
      "text": "Blood pressure 126 over 80, pulse 72, temperature 36.6."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.38,
      "end_seconds": 178.9,
      "duration_seconds": 1.52,
      "text": "Normal? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.1,
      "end_seconds": 186.94,
      "duration_seconds": 6.84,
      "text": "Normal. Now let me look at your hands and your knee. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.69,
      "end_seconds": 207.29,
      "duration_seconds": 1.6,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.78,
      "end_seconds": 222.21,
      "duration_seconds": 13.43,
      "text": "There's swelling and tenderness in several finger joints, and the nails are pitted with lifting. The right knee has a small effusion."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.64,
      "end_seconds": 227.29,
      "duration_seconds": 2.65,
      "text": "What does that mean? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.87,
      "end_seconds": 240.99,
      "duration_seconds": 11.12,
      "text": "It strongly suggests psoriatic arthritis, and the nail changes support it. I'd also like blood tests and X-rays of your hands."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.87,
      "end_seconds": 245.94,
      "duration_seconds": 3.07,
      "text": "Is it serious? ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.82,
      "end_seconds": 256.79,
      "duration_seconds": 7.97,
      "text": "It can damage joints if it is not treated, so early treatment is important. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.06,
      "end_seconds": 261.52,
      "duration_seconds": 2.46,
      "text": "What treatment? ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.59,
      "end_seconds": 277.08,
      "duration_seconds": 14.49,
      "text": "There are several options, and I'd like a rheumatologist to guide it. I'll refer you urgently, and in the meantime take naproxen, 500 mg, twice a day with food."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.75,
      "end_seconds": 280.7,
      "duration_seconds": 1.95,
      "text": "All right. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.99,
      "end_seconds": 292.93,
      "duration_seconds": 9.94,
      "text": "And it would help your joints and skin to stop smoking. I can help you with that."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.78,
      "end_seconds": 297.58,
      "duration_seconds": 2.8,
      "text": "I'd like that. ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.45,
      "end_seconds": 306.69,
      "duration_seconds": 7.24,
      "text": "I'll see you in four weeks, once the tests are back."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.51,
      "end_seconds": 312.32,
      "duration_seconds": 2.81,
      "text": "Thank you, doctor. ~"
    }
  ]
}
