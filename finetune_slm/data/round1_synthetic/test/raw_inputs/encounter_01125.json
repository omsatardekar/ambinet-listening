{
  "schema_version": "1.0",
  "encounter_id": "01125",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.97,
      "end_seconds": 6.3,
      "duration_seconds": 5.33,
      "text": "doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.26,
      "end_seconds": 11.4,
      "duration_seconds": 4.14,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.62,
      "end_seconds": 18.16,
      "duration_seconds": 5.54,
      "text": "It's being thirsty. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.47,
      "end_seconds": 22.43,
      "duration_seconds": 2.96,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.91,
      "end_seconds": 29.0,
      "duration_seconds": 5.09,
      "text": "Around ten days... no wait, it's more like five days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.7,
      "end_seconds": 32.14,
      "duration_seconds": 2.44,
      "text": "What eases it, if anything?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.5,
      "end_seconds": 37.15,
      "duration_seconds": 3.65,
      "text": "only water, and and it's not much"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.43,
      "end_seconds": 40.38,
      "duration_seconds": 1.95,
      "text": "Has there been tiredness too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.89,
      "end_seconds": 42.46,
      "duration_seconds": 1.57,
      "text": "yes, since Monday"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.17,
      "end_seconds": 46.42,
      "duration_seconds": 3.25,
      "text": "Have you had tingling in your toes?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.62,
      "end_seconds": 51.41,
      "duration_seconds": 3.79,
      "text": "Erm, yeah. About four days, I'd say."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.97,
      "end_seconds": 60.48,
      "duration_seconds": 8.51,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.62,
      "end_seconds": 75.46,
      "duration_seconds": 13.84,
      "text": "So, it's worse with night. It's severe, honestly. I told myself I'd wait and see, and here I am. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.68,
      "end_seconds": 81.66,
      "duration_seconds": 4.98,
      "text": "have you had being thirsty before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.53,
      "end_seconds": 90.84,
      "duration_seconds": 7.31,
      "text": "Yes, something like this happened last year, and it went away on its own."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.83,
      "end_seconds": 96.24,
      "duration_seconds": 4.41,
      "text": "Have you had any foot ulcers, vomiting or chest pain?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.85,
      "end_seconds": 98.79,
      "duration_seconds": 1.94,
      "text": "nope, nothing like that"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.88,
      "end_seconds": 103.0,
      "duration_seconds": 3.12,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.02,
      "end_seconds": 106.58,
      "duration_seconds": 1.56,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.32,
      "end_seconds": 109.31,
      "duration_seconds": 1.99,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.0,
      "end_seconds": 113.73,
      "duration_seconds": 2.73,
      "text": "yeah, no, skin's been fine"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.25,
      "end_seconds": 125.73,
      "duration_seconds": 2.48,
      "text": "have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.58,
      "end_seconds": 128.7,
      "duration_seconds": 1.12,
      "text": "no, never"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.15,
      "end_seconds": 133.78,
      "duration_seconds": 3.63,
      "text": "what does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.65,
      "end_seconds": 139.29,
      "duration_seconds": 3.64,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.56,
      "end_seconds": 143.43,
      "duration_seconds": 2.87,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.05,
      "end_seconds": 148.92,
      "duration_seconds": 3.87,
      "text": "I'm a hairdresser, on my feet all day"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.9,
      "end_seconds": 152.94,
      "duration_seconds": 3.04,
      "text": "any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.5,
      "end_seconds": 157.66,
      "duration_seconds": 3.16,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.42,
      "end_seconds": 166.61,
      "duration_seconds": 7.19,
      "text": "Any medical conditions, anything you've been treated for? I ask cos it helps me narrow things down."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.56,
      "end_seconds": 170.64,
      "duration_seconds": 3.08,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.4,
      "end_seconds": 174.69,
      "duration_seconds": 3.29,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.7,
      "end_seconds": 178.04,
      "duration_seconds": 2.34,
      "text": "my father has Parkinson's disease"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.73,
      "end_seconds": 182.2,
      "duration_seconds": 3.47,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.33,
      "end_seconds": 196.35,
      "duration_seconds": 2.02,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.98,
      "end_seconds": 221.36,
      "duration_seconds": 11.38,
      "text": "Okay: saturation 97 percent, weight 66 kilos, height 179 centimetres, BP is 165 over 100, temperature is 36.5 degrees, pulse is 78 beats a minute."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.34,
      "end_seconds": 224.9,
      "duration_seconds": 1.56,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.77,
      "end_seconds": 229.35,
      "duration_seconds": 3.58,
      "text": "I'll explain what these mean in a moment"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.24,
      "end_seconds": 236.0,
      "duration_seconds": 3.76,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.39,
      "end_seconds": 239.41,
      "duration_seconds": 2.02,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.82,
      "end_seconds": 253.8,
      "duration_seconds": 6.98,
      "text": "The feeling at the tips of your toes is reduced and the foot pulses are present."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.53,
      "end_seconds": 259.26,
      "duration_seconds": 1.73,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.37,
      "end_seconds": 283.66,
      "duration_seconds": 13.29,
      "text": "Right, here's what I'm thinking. I'm honestly not certain yet. It could be diabetes not well controlled on current treatment, or it might be early nerve damage."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.78,
      "end_seconds": 331.28,
      "duration_seconds": 29.5,
      "text": "I think a urine albumin test makes sense here, for diabetes review let's get kidney function tests, for diabetes review i'm prescribing gliclazide, 40 milligrams, once a day with breakfast, long term that's for diabetes check your feet daily and book the eye screening a short walk every day, even twenty minutes, will help more than you'd think we'll refer you to the diabetes educator"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.34,
      "end_seconds": 348.73,
      "duration_seconds": 16.39,
      "text": "Let's hold off on an HbA1c for now, and if there's no change in a month we can revisit it. Do get help quickly if the symptoms get worse. We'll catch up in three months."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 353.76,
      "end_seconds": 355.8,
      "duration_seconds": 2.04,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.09,
      "end_seconds": 364.15,
      "duration_seconds": 4.06,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 366.24,
      "end_seconds": 368.31,
      "duration_seconds": 2.07,
      "text": "Thank you, that's helpful."
    }
  ]
}