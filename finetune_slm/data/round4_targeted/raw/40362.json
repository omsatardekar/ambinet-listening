 "spec": {
  "id": "40362",
  "family": "plantar_heel_pain",
  "situation": "Runner or shop worker with heel pain on the first steps in the morning for two months; new shoes mentioned; doctor suggests stretches and insoles; no tests.",
  "difficulty": "hard",
  "traps": [
   {
    "key": "clinical_wording_in_names",
    "happens": "The patient describes things in colourful or sentence-like speech ('I've overdone it', 'I can't hear myself think', 'a frog in my throat', 'my feet feel dead', 'I feel like a wet rag').",
    "label_rule": "Every symptom name is a short clinical noun phrase of 1 to 5 words ('voice fatigue', 'numbness in both feet', 'tiredness'), never a full sentence, never starting with I/we/my. Pure idioms that are not symptoms ('I can't hear myself think' said about classroom noise) are NOT symptoms. The patient's own words stay in the cited turn, not in the name."
   }
  ],
  "allergy_variant": null,
  "features": [
   "doctor_thinks_aloud: the doctor lists possible causes or says what they will not conclude yet. Only record a clinical assessment if the doctor actually states a leading or differential impression; 'let's see what the tests say' is not an assessment.",
   "third_party_medicine: someone mentions a medicine or condition that belongs to a relative or friend (the sister's biotin, the husband's metformin). It must not appear as the patient's own; a relative's illness can only be family history if said as such."
  ],
  "extra_speakers": [
   "CAREGIVER"
  ],
  "patient_style": "terse, one-word answers",
  "doctor_style": "brisk, closed questions",
  "flavour": "South African English",
