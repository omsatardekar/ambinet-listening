{
 "turns_text": [
  "[SEG0001] person_1 (NURSE): Grand. Checks are done. Pulse 78, blood pressure 118 over 74, temperature 36.6, oxygen 98 percent.",
  "[SEG0002] person_2 (DOCTOR): Right so. What brought you?",
  "[SEG0003] person_3 (PATIENT): Lump.",
  "[SEG0004] person_2 (DOCTOR): Neck?",
  "[SEG0005] person_3 (PATIENT): Yeah.",
  "[SEG0006] person_4 (FAMILY_MEMBER): Of. Left side, under the jaw. He only told me last week, sure.",
  "[SEG0007] person_2 (DOCTOR): How long there?",
  "[SEG0008] person_3 (PATIENT): Three weeks, left side.",
  "[SEG0009] person_2 (DOCTOR): Sore to touch?",
  "[SEG0010] person_3 (PATIENT): No.",
  "[SEG0011] person_2 (DOCTOR): Fever at the minute?",
  "[SEG0012] person_3 (PATIENT): No.",
  "[SEG0013] person_2 (DOCTOR): Night sweats?",
  "[SEG0014] person_3 (PATIENT): Once.",
  "[SEG0015] person_2 (DOCTOR): Just the once?",
  "[SEG0016] person_3 (PATIENT): Yeah.",
  "[SEG0017] person_2 (DOCTOR): Weight dropping?",
  "[SEG0018] person_3 (PATIENT): Mm, I suppose.",
  "[SEG0019] person_2 (DOCTOR): Tired?",
  "[SEG0020] person_3 (PATIENT): Sometimes, not really.",
  "[SEG0021] person_2 (DOCTOR): Cough?",
  "[SEG0022] person_3 (PATIENT): No.",
  "[SEG0023] person_4 (FAMILY_MEMBER): The traffic was desperate coming in. His cousin texted, nothing important.",
  "[SEG0024] person_4 (FAMILY_MEMBER): The cat scratched his hand a couple of weeks ago.",
  "[SEG0025] person_2 (DOCTOR): When?",
  "[SEG0026] person_3 (PATIENT): Umm. Last winter, or the one before.",
  "[SEG0027] person_2 (DOCTOR): Scratch still there?",
  "[SEG0028] person_3 (PATIENT): No.",
  "[SEG0029] person_2 (DOCTOR): Tablets?",
  "[SEG0030] person_3 (PATIENT): Err. Omprazole, twenty milligrams, every day.",
  "[SEG0031] person_4 (FAMILY_MEMBER): Mizartan was mine for the pressure. He never took a one of them.",
  "[SEG0032] person_2 (DOCTOR): Allergies?",
  "[SEG0033] person_3 (PATIENT): No.",
  "[SEG0034] person_2 (DOCTOR): Smoke?",
  "[SEG0035] person_3 (PATIENT): No.",
  "[SEG0036] person_2 (DOCTOR): Any other lumps?",
  "[SEG0037] person_3 (PATIENT): No.",
  "[SEG0038] person_2 (DOCTOR): Err, firm node left side, about two centimetres, not tender. Throat clear, no redness.",
  "[SEG0039] person_2 (DOCTOR): Likely a reactive lymph node.",
  "[SEG0040] person_2 (DOCTOR): The nurse takes bloods Thursday morning. Fasting.",
  "[SEG0041] person_1 (NURSE): Thursday half eight. Nothing from midnight.",
  "[SEG0042] person_2 (DOCTOR): Neck ultrasound is booked for Friday week.",
  "[SEG0043] person_2 (DOCTOR): If those bloods are borderline we do a chest x-ray.",
  "[SEG0044] person_2 (DOCTOR): I'll see you in two weeks. Don't poke the lump."
 ],
