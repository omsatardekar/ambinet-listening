{
 "turns_text": [
  "[SEG0001] person_1 (DOCTOR): Come in. Shocking parking out the front, hey.",
  "[SEG0002] person_2 (PATIENT): Yeah.",
  "[SEG0003] person_1 (DOCTOR): What's up?",
  "[SEG0004] person_2 (PATIENT): Burning wee.",
  "[SEG0005] person_1 (DOCTOR): How long?",
  "[SEG0006] person_2 (PATIENT): Four days.",
  "[SEG0007] person_1 (DOCTOR): Going more often, those same four days?",
  "[SEG0008] person_2 (PATIENT): Heaps. Yeah.",
  "[SEG0009] person_1 (DOCTOR): Up at night?",
  "[SEG0010] person_2 (PATIENT): Umm. Three. Maybe four.",
  "[SEG0011] person_1 (DOCTOR): Back sore as well, same time?",
  "[SEG0012] person_2 (PATIENT): Lower. Left. Yeah.",
  "[SEG0013] person_1 (DOCTOR): Fever?",
  "[SEG0014] person_2 (PATIENT): No.",
  "[SEG0015] person_1 (DOCTOR): Discharge from the penis?",
  "[SEG0016] person_2 (PATIENT): No.",
  "[SEG0017] person_1 (DOCTOR): Blood in the wee?",
  "[SEG0018] person_2 (PATIENT): No.",
  "[SEG0019] person_1 (DOCTOR): Nauseous? Vomiting?",
  "[SEG0020] person_2 (PATIENT): No.",
  "[SEG0021] person_1 (DOCTOR): Been overseas?",
  "[SEG0022] person_2 (PATIENT): No.",
  "[SEG0023] person_1 (DOCTOR): Any regular medicine?",
  "[SEG0024] person_2 (PATIENT): No.",
  "[SEG0025] person_1 (DOCTOR): Taken anything for the ache?",
  "[SEG0026] person_2 (PATIENT): Panadol. Two five hundreds. Last night.",
  "[SEG0027] person_1 (DOCTOR): Reactions to drugs ever? Penicillin or other antibiotics?",
  "[SEG0028] person_2 (PATIENT): No. Never. I've taken penicillin and amoxcillin. Everything. Fine.",
  "[SEG0029] person_1 (DOCTOR): Diabetes yourself?",
  "[SEG0030] person_2 (PATIENT): No.",
  "[SEG0031] person_1 (DOCTOR): Diabetes in the family?",
  "[SEG0032] person_2 (PATIENT): Brother. On metformin.",
  "[SEG0033] person_1 (DOCTOR): That's his, yeah?",
  "[SEG0034] person_2 (PATIENT): His.",
  "[SEG0035] person_1 (DOCTOR): Right. Pop on the couch.",
  "[SEG0036] person_2 (PATIENT): Ok.",
  "[SEG0037] person_1 (DOCTOR): Temp's thirty seven point four. Pulse eighty, err, eighty six. Blood pressure one thirty two over eighty four. And you said no fever?",
  "[SEG0038] person_2 (PATIENT): Actually. Last night. Hot. Sweaty. A bit.",
  "[SEG0039] person_1 (DOCTOR): Left loin's tender. Abdomen's soft. No tenderness on the right.",
  "[SEG0040] person_2 (PATIENT): Yep.",
  "[SEG0041] person_1 (DOCTOR): I think this is a urine infection. With the loin I can't rule out a kidney infection.",
  "[SEG0042] person_1 (DOCTOR): I'll dip the urine now and send a midstream sample to the lab.",
  "[SEG0043] person_1 (DOCTOR): If the result shows infection I'll start trimethoprim, three hundred milligrams at night for seven days. We wait for that.",
  "[SEG0044] person_1 (DOCTOR): Drink plenty of water. If you get shakes or you can't keep fluids down, come straight back.",
  "[SEG0045] person_1 (DOCTOR): The desk will book you in three days.",
  "[SEG0046] person_2 (PATIENT): Right."
 ],
