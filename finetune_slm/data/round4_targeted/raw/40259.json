 "spec": {
  "id": "40259",
  "family": "hypoglycaemia_diabetic_elderly",
  "situation": "Older diabetic on gliclazide and metformin with morning sweating and shakiness; skips breakfast; daughter reports confusion once; doctor reviews doses and plans a blood test.",
  "difficulty": "hard",
  "traps": [
   {
