      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Sure. Is anything making it worse?",
      "start_timestamp": "00:42",
      "end_timestamp": "00:45",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "Alcohol definitely sets it off. And daytime sleepiness, too. Sorry, what was I saying, as for stopping breathing at night, I honestly can't say when that began. It might have been last month or the month before.",
      "start_timestamp": "00:47",
      "end_timestamp": "01:05",
      "supports": [
        "symptoms[0]",
        "symptoms[1]",
        "symptoms[2]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Would you say mild, moderate or severe?",
      "start_timestamp": "01:07",
      "end_timestamp": "01:10",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "About a seven out of ten.",
      "start_timestamp": "01:11",
      "end_timestamp": "01:14",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Any choking, leg swelling or chest pain?",
      "start_timestamp": "01:15",
      "end_timestamp": "01:19",
      "supports": [
