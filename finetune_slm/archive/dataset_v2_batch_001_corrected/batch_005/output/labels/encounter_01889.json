    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "Um, no, no choking, no leg swelling, no chest pain. I did have morning headaches at one point, but that went away on its own.",
