      "end_timestamp": "02:22",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Well, I've had an underactive thyroid, yes. My family kept telling me to get it checked. I thought it would sort itself out, but it hasn't.",
