      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes, carry on.",
      "start_timestamp": "02:37",
      "end_timestamp": "02:39",
      "supports": [
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]",
        "medical_history.past_medical_history[3]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, an irregular heartbeat. I told myself I'd wait and see, and here I am. I've never really been one for hospitals. I've, I've had high blood pressure, yes. I've had heart disease, yes. My neighbour said I should get it looked at. It's a relief to finally sit down and talk about it.",
