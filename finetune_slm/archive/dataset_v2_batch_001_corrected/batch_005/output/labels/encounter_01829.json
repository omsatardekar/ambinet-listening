      "end_timestamp": "01:13",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, uh, turning. That makes it worse.",
      "start_timestamp": "01:14",
      "end_timestamp": "01:18",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Before we go further, any allergies?",
      "start_timestamp": "01:38",
      "end_timestamp": "01:40",
      "supports": [
        "allergies[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did.",
      "start_timestamp": "01:41",
      "end_timestamp": "01:55",
      "supports": [
        "allergies[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Are there any illnesses in your family?",
