      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Severe, I'd say. Mm, there's a sore throat again as well. As for sore throat again, moderate, really. Yes, swallowing. That makes it worse. Sorry, what was I saying, I've also had a fever, for two weeks.",
      "start_timestamp": "00:18",
