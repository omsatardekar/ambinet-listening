    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse.",
      "start_timestamp": "00:38",
      "end_timestamp": "00:47",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Moderate, really. Honestly, all the time.",
      "start_timestamp": "00:48",
      "end_timestamp": "00:51",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let me check a few things. Any difficulty breathing, ear pain, rash or drooling?",
