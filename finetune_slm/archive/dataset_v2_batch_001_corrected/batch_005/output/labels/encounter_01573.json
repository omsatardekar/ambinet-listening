    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "The tonsils are large and red with white spots, and the neck glands are tender.",
      "start_timestamp": "03:59",
      "end_timestamp": "04:05",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "All finished, thank you. Having listened and examined, the most likely explanation is tonsillitis.",
      "start_timestamp": "04:10",
      "end_timestamp": "04:17",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let's get a throat swab, for recurrent tonsillitis. I'd like you to take phenoxymethylpenicillin, 250 milligrams, four times a day, ten days. That's for tonsillitis. Plenty of fluids and soft foods, and he can return to school when the fever has gone. I'll also refer you to the ENT clinic. Please don't wait if the symptoms get worse. That's when to be seen urgently.",
