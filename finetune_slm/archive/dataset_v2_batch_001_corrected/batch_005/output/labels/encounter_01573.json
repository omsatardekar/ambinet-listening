        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Has anyone ever diagnosed you with something?",
      "start_timestamp": "02:17",
      "end_timestamp": "02:20",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I mean, I have gout, for five years.",
      "start_timestamp": "02:20",
      "end_timestamp": "02:25",
      "supports": [
        "medical_history.past_medical_history[0]",
        "clinical_conditions[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Okay, go on. Alright, gout, that matches what I have here. Has anything ever caused you a reaction? I mean any allergies.",
      "start_timestamp": "02:28",
      "end_timestamp": "02:38",
      "supports": [
        "medical_history.past_medical_history[0]",
        "allergies[0]",
        "clinical_conditions[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Nickel. I come out in... well, a rash on my skin.",
      "start_timestamp": "02:38",
      "end_timestamp": "02:44",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Okay: temperature is 38.1 degrees, saturation 98 percent, pressure 111 over 70. And pulse is 106 beats a minute.",
      "start_timestamp": "03:19",
      "end_timestamp": "03:27",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
