      "supports": [
        "medical_history.social_history[0]",
        "medical_history.social_history[1]",
        "medical_history.social_history[2]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My husband and I live above the shop. I grab fast food at lunch most days. I walk the dog every morning.",
      "start_timestamp": "01:30",
      "end_timestamp": "01:40",
      "supports": [
        "medical_history.social_history[0]",
        "medical_history.social_history[1]",
        "medical_history.social_history[2]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Tell me your medicines, please.",
      "start_timestamp": "01:42",
      "end_timestamp": "01:44",
      "supports": [
