        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Okay: temp 36.9 degrees, heart rate 70, blood pressure 110 over 75.",
