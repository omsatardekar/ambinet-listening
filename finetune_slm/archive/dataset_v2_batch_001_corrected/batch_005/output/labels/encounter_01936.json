      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is it bearing on you a lot?",
      "start_timestamp": "01:03",
      "end_timestamp": "01:05",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "Well, uh, it's... hard to say, it's kind of... I don't know—",
