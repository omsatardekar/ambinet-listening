      "end_timestamp": "02:16",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "so, honestly, once or twice a day i'd say moderate i'd rather know what's going on than keep guessing well, I've had poor sleep too, for about two weeks",
