      "end_timestamp": "03:05",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Okay: BP is 121 over 71, saturation 97 percent, respiratory rate 21, temperature 38.7, pulse is 108 beats a minute.",
