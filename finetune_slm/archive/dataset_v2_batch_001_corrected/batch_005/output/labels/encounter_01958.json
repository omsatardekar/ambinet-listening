        "medications[0]",
        "clinical_conditions[0]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It's paracetamol, 1 gram, when needed. I did try to ignore it for a while. I took the morning off to come in today.",
