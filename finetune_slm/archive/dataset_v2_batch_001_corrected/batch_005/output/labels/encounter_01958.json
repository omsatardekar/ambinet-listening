        "clinical_actions[1]",
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_027",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Rest, drink plenty, and come back if you are not improving in two days. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency.",
      "start_timestamp": "05:45",
      "end_timestamp": "05:59",
      "supports": [
