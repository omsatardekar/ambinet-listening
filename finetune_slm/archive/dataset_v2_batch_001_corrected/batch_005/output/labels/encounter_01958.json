    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Lots of rice, lentils and some fruit. I'm a plumber, lots of bending and kneeling. I walk the dog every morning.",
