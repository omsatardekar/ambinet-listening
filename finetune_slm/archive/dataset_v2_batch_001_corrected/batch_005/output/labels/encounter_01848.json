    },
    {
      "evidence_id": "EV_024",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I want blood tests done, that's for flare. I want a stool test done, that's for bloody diarrhoea. I'm going to put you on prednisolone, 40 milligrams, once a day, one week then reduce. You take it by mouth. It's for inflammatory bowel flare.",
