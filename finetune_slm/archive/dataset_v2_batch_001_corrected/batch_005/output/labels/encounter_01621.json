  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "We came because of a fever.",
      "start_timestamp": "00:25",
      "end_timestamp": "00:28",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Can you tell me when it first started?",
      "start_timestamp": "00:30",
      "end_timestamp": "00:34",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "Okay, so I'm not sure when it began, to be honest. Some weeks ago, but I can't say how many.",
      "start_timestamp": "00:36",
      "end_timestamp": "00:47",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How much does it limit you?",
      "start_timestamp": "00:49",
      "end_timestamp": "00:52",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "Right, about a five out of ten.",
      "start_timestamp": "00:55",
      "end_timestamp": "00:58",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How often do you get it?",
      "start_timestamp": "01:00",
      "end_timestamp": "01:03",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "It's, um... not exactly... well, hard to explain, I mean—",
      "start_timestamp": "01:04",
      "end_timestamp": "01:10",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let me put it another way: how many times in a typical day or week?",
      "start_timestamp": "01:11",
      "end_timestamp": "01:18",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "It happens every other day.",
      "start_timestamp": "01:20",
      "end_timestamp": "01:22",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "I was getting to that! Mm, I've also had missing school, for two months.",
      "start_timestamp": "01:37",
      "end_timestamp": "01:45",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Okay, how troublesome is it day to day?",
      "start_timestamp": "01:45",
      "end_timestamp": "01:49",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "Maybe a four out of ten on a bad day.",
      "start_timestamp": "01:51",
      "end_timestamp": "01:56",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Sure. Have you had a fever before, or is this the first time?",
      "start_timestamp": "01:56",
      "end_timestamp": "02:01",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "Yes, something like this happened about six months ago, and it went away on its own.",
      "start_timestamp": "02:06",
      "end_timestamp": "02:14",
      "supports": [
        "symptoms[2]"
      ]
    },
