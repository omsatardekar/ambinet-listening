    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good, thank you. Is it constant or in episodes?",
      "start_timestamp": "00:51",
      "end_timestamp": "00:55",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "It's, um... not exactly... well, hard to explain, I mean—",
