      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "nurse",
      "transcript_text": "Okay, so the vitals from earlier. Temperature is 36.9 degrees, SpO2 99 percent on room air. Pressure 126 over 74, pulse is 77 beats a minute.",
