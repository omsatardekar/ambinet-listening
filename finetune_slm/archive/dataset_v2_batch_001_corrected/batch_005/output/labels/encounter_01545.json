      "end_timestamp": "01:47",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "Yes, for about a week.",
      "start_timestamp": "01:51",
      "end_timestamp": "01:54",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
