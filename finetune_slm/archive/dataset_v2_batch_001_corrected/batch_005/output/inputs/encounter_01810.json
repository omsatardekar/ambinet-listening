  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.37,
      "end_seconds": 4.57,
      "duration_seconds": 3.2,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.0,
      "end_seconds": 10.23,
      "duration_seconds": 4.23,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.96,
      "end_seconds": 19.02,
      "duration_seconds": 8.06,
      "text": "Mainly burning on passing urine. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.52,
      "end_seconds": 26.7,
      "duration_seconds": 3.18,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.47,
      "end_seconds": 39.25,
      "duration_seconds": 2.78,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.13,
      "end_seconds": 61.75,
      "duration_seconds": 8.62,
      "text": "Okay: temperature is 38.1 degrees, BP is 113 over 74, pulse is 90 beats a minute."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.48,
      "end_seconds": 65.51,
      "duration_seconds": 3.03,
      "text": "Is that alright, um, doctor?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.89,
      "end_seconds": 68.85,
      "duration_seconds": 1.96,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.05,
      "end_seconds": 87.86,
      "duration_seconds": 1.81,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.65,
      "end_seconds": 95.29,
      "duration_seconds": 1.64,
      "text": "It started yesterday."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.09,
      "end_seconds": 100.0,
      "duration_seconds": 3.91,
      "text": "Okay, have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.62,
      "end_seconds": 117.44,
      "duration_seconds": 16.82,
      "text": "A dull low backache goes along with it, most of the time. Um, you know, as for dull low backache, maybe a five out of ten on a bad day."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.9,
      "end_seconds": 125.66,
      "duration_seconds": 6.76,
      "text": "Let me check a few things. Any leaking fluid, vaginal bleeding or severe back pain?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.16,
      "end_seconds": 133.22,
      "duration_seconds": 6.06,
      "text": "I haven't had leaking fluid, vaginal bleeding or severe back pain, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.58,
      "end_seconds": 137.34,
      "duration_seconds": 2.76,
      "text": "Have you had any reduced baby movements?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.87,
      "end_seconds": 141.11,
      "duration_seconds": 2.24,
      "text": "Definitely no reduced baby movements."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.83,
      "end_seconds": 149.67,
      "duration_seconds": 2.84,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.58,
      "end_seconds": 156.23,
      "duration_seconds": 3.65,
      "text": "No, um, my breathing's been fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.19,
      "end_seconds": 163.38,
      "duration_seconds": 3.19,
      "text": "Okay, and your skin, any changes there?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.15,
      "end_seconds": 166.26,
      "duration_seconds": 1.11,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.18,
      "end_seconds": 188.39,
      "duration_seconds": 3.21,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.17,
      "end_seconds": 192.52,
      "duration_seconds": 3.35,
      "text": "I take aspirin, once a day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.56,
      "end_seconds": 195.91,
      "duration_seconds": 2.35,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.0,
      "end_seconds": 203.17,
      "duration_seconds": 5.17,
      "text": "75 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.92,
      "end_seconds": 210.47,
      "duration_seconds": 6.55,
      "text": "Has anyone ever diagnosed you with something? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.53,
      "end_seconds": 213.32,
      "duration_seconds": 1.79,
      "text": "Yes, heart disease."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.73,
      "end_seconds": 222.56,
      "duration_seconds": 7.83,
      "text": "Okay, I can see heart disease in your file as well. Alright, is there someone at home?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.16,
      "end_seconds": 227.23,
      "duration_seconds": 4.07,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.06,
      "end_seconds": 229.85,
      "duration_seconds": 1.79,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.39,
      "end_seconds": 235.12,
      "duration_seconds": 3.73,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.08,
      "end_seconds": 240.71,
      "duration_seconds": 3.63,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.46,
      "end_seconds": 244.47,
      "duration_seconds": 2.01,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.39,
      "end_seconds": 263.91,
      "duration_seconds": 5.52,
      "text": "There is mild tenderness above the pubic bone and no tenderness in the loins."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.59,
      "end_seconds": 271.9,
      "duration_seconds": 3.31,
      "text": "Okay, good, you can sit up again."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.29,
      "end_seconds": 291.29,
      "duration_seconds": 6.0,
      "text": "Taking everything into account, this looks most like a urinary infection in pregnancy."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.11,
      "end_seconds": 294.94,
      "duration_seconds": 2.83,
      "text": "Yeah, will it clear up?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.78,
      "end_seconds": 306.24,
      "duration_seconds": 10.46,
      "text": "Nothing I've seen today points to an emergency. It looks like a urinary infection in pregnancy, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.84,
      "end_seconds": 349.42,
      "duration_seconds": 30.58,
      "text": "Let's book a urine dipstick to look into burning urine. For this, cefalexin, 500 milligrams, twice a day, seven days. That's for urinary infection in pregnancy. Drink plenty of fluids and tell your midwife. I'd like you to see the midwife as well, and I'll write the referral. Please come and see me in one week. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.94,
      "end_seconds": 354.2,
      "duration_seconds": 3.26,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.82,
      "end_seconds": 357.0,
      "duration_seconds": 1.18,
      "text": "Goodbye for now."
    }
  ]
}