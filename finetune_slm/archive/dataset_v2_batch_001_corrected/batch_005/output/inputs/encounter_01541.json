{
  "schema_version": "1.0",
  "encounter_id": "01541",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.11,
      "end_seconds": 6.81,
      "duration_seconds": 5.7,
      "text": "Mm, um, hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.35,
      "end_seconds": 12.55,
      "duration_seconds": 4.2,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.42,
      "end_seconds": 23.88,
      "duration_seconds": 9.46,
      "text": "Hmm, mainly daytime sleepiness. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.48,
      "end_seconds": 27.96,
      "duration_seconds": 3.48,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.84,
      "end_seconds": 38.26,
      "duration_seconds": 9.42,
      "text": "Ah, um, I'm on losartan, 50 milligrams, once a day. It's iron tablets, once a day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.13,
      "end_seconds": 57.51,
      "duration_seconds": 3.38,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.85,
      "end_seconds": 63.04,
      "duration_seconds": 4.19,
      "text": "Ah, I've had it for one week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.29,
      "end_seconds": 67.64,
      "duration_seconds": 3.35,
      "text": "Okay, have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.4,
      "end_seconds": 99.21,
      "duration_seconds": 29.81,
      "text": "It usually comes with stopping breathing at night. Right, um, the stopping breathing at night? That's been for about three months. Okay, uh, so as for morning headaches, I honestly can't say when that began. It might have been last month or the month before. As for morning headaches, it feels severe to me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.14,
      "end_seconds": 105.29,
      "duration_seconds": 4.15,
      "text": "Okay, any chest pain, choking or leg swelling at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.31,
      "end_seconds": 110.7,
      "duration_seconds": 4.39,
      "text": "Oh, uh, no, not a single one."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.87,
      "end_seconds": 116.48,
      "duration_seconds": 4.61,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.08,
      "end_seconds": 120.18,
      "duration_seconds": 3.1,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.76,
      "end_seconds": 141.22,
      "duration_seconds": 2.46,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.03,
      "end_seconds": 153.17,
      "duration_seconds": 8.14,
      "text": "Years back I got a rash from erythromycin, so I stay away from it now."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.21,
      "end_seconds": 158.22,
      "duration_seconds": 4.01,
      "text": "Alright, a few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.72,
      "end_seconds": 171.45,
      "duration_seconds": 11.73,
      "text": "I retired from the post office two years ago. I live with my elderly mother. Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.45,
      "end_seconds": 177.05,
      "duration_seconds": 3.6,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.86,
      "end_seconds": 181.62,
      "duration_seconds": 2.76,
      "text": "I have high blood pressure."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.14,
      "end_seconds": 184.02,
      "duration_seconds": 0.88,
      "text": "Anything else?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.93,
      "end_seconds": 188.55,
      "duration_seconds": 2.62,
      "text": "Low haemoglobin, for five years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.17,
      "end_seconds": 190.87,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.02,
      "end_seconds": 194.81,
      "duration_seconds": 2.79,
      "text": "I have an underactive thyroid."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.92,
      "end_seconds": 200.78,
      "duration_seconds": 2.86,
      "text": "Right, have you ever had an operation?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.49,
      "end_seconds": 205.99,
      "duration_seconds": 4.5,
      "text": "Well, I had a varicose vein procedure last year."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.46,
      "end_seconds": 210.11,
      "duration_seconds": 2.65,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.11,
      "end_seconds": 220.59,
      "duration_seconds": 2.48,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.02,
      "end_seconds": 245.41,
      "duration_seconds": 15.39,
      "text": "Okay: BMI works out to 22.3, pulse 91, respiratory rate 15, saturation 98 percent, weight 63 kilos, temp 36.6 degrees, height 168 centimetres, BP is 168 over 92."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.93,
      "end_seconds": 252.01,
      "duration_seconds": 4.08,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.01,
      "end_seconds": 253.71,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.15,
      "end_seconds": 257.14,
      "duration_seconds": 1.99,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.63,
      "end_seconds": 275.0,
      "duration_seconds": 4.37,
      "text": "You have a thick neck and a crowded throat."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.42,
      "end_seconds": 292.34,
      "duration_seconds": 13.92,
      "text": "Okay, that's enough for me. Okay, thinking it through, I'm honestly not certain yet. It could be probable obstructive sleep apnoea, or it might be an underactive thyroid."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.91,
      "end_seconds": 296.92,
      "duration_seconds": 3.01,
      "text": "Yeah, will it clear up?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.8,
      "end_seconds": 309.03,
      "duration_seconds": 8.23,
      "text": "Nothing I've seen today points to an emergency. It looks like probable obstructive sleep apnoea, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.76,
      "end_seconds": 343.44,
      "duration_seconds": 25.68,
      "text": "A home sleep study is what I'd like next, for snoring and apnoeas. Let's book a thyroid test to look into tiredness. Avoid alcohol in the evening, lose some weight if you can, and do not drive when drowsy. We'll catch up after the sleep study. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.36,
      "end_seconds": 347.14,
      "duration_seconds": 1.78,
      "text": "That's clear, thanks."
    }
  ]
}