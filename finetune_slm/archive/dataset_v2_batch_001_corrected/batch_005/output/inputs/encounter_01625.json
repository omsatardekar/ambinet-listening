{
  "schema_version": "1.0",
  "encounter_id": "01625",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.14,
      "end_seconds": 6.2,
      "duration_seconds": 5.06,
      "text": "Hello, take a seat, I'll be with you in a second."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.57,
      "end_seconds": 11.08,
      "duration_seconds": 3.51,
      "text": "I mean, good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.79,
      "end_seconds": 19.26,
      "duration_seconds": 6.47,
      "text": "Doctor, you know, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.1,
      "end_seconds": 21.51,
      "duration_seconds": 1.41,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.02,
      "end_seconds": 27.58,
      "duration_seconds": 4.56,
      "text": "So, I've been getting out of breath, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.87,
      "end_seconds": 30.6,
      "duration_seconds": 1.73,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.04,
      "end_seconds": 39.44,
      "duration_seconds": 7.4,
      "text": "Uh, I'd say about four days. Actually, no, closer to five days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.01,
      "end_seconds": 44.08,
      "duration_seconds": 3.07,
      "text": "Alright, is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.92,
      "end_seconds": 56.79,
      "duration_seconds": 11.87,
      "text": "It's every other day. Well, I've been snoring too. And I've been putting on weight over the years as well, since last weekend."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.87,
      "end_seconds": 62.04,
      "duration_seconds": 4.17,
      "text": "And what about palpitations, chest pain or high thirst?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.04,
      "end_seconds": 69.49,
      "duration_seconds": 5.45,
      "text": "No palpitations, chest pain or high thirst, none of it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.81,
      "end_seconds": 72.39,
      "duration_seconds": 1.58,
      "text": "Nothing like low mood?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 73.16,
      "end_seconds": 76.0,
      "duration_seconds": 2.84,
      "text": "Nope, uh, no low mood."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.7,
      "end_seconds": 81.33,
      "duration_seconds": 3.63,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.11,
      "end_seconds": 85.09,
      "duration_seconds": 1.98,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.92,
      "end_seconds": 89.98,
      "duration_seconds": 3.06,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 90.72,
      "end_seconds": 98.65,
      "duration_seconds": 7.93,
      "text": "High blood pressure, for two years. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.72,
      "end_seconds": 101.79,
      "duration_seconds": 1.07,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.34,
      "end_seconds": 114.86,
      "duration_seconds": 12.52,
      "text": "Mm, yes, low haemoglobin. I took the morning off to come in today. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.56,
      "end_seconds": 123.52,
      "duration_seconds": 5.96,
      "text": "So, are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.23,
      "end_seconds": 128.57,
      "duration_seconds": 3.34,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.86,
      "end_seconds": 134.78,
      "duration_seconds": 4.92,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.38,
      "end_seconds": 149.48,
      "duration_seconds": 13.1,
      "text": "I'll have a glass of wine with dinner. I live with my elderly mother. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.48,
      "end_seconds": 165.55,
      "duration_seconds": 2.07,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.01,
      "end_seconds": 171.18,
      "duration_seconds": 4.17,
      "text": "Iron tablets, once a day for my blood count."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 172.23,
      "end_seconds": 179.21,
      "duration_seconds": 6.98,
      "text": "It's meant to be once a day, though I don't see he take it every time."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.02,
      "end_seconds": 187.66,
      "duration_seconds": 6.64,
      "text": "Let me think, I was on telmisartan before. I stopped taking it."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.77,
      "end_seconds": 207.64,
      "duration_seconds": 2.87,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 209.09,
      "end_seconds": 212.6,
      "duration_seconds": 3.51,
      "text": "Yeah, no, I've never been operated on."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.63,
      "end_seconds": 218.04,
      "duration_seconds": 3.41,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.72,
      "end_seconds": 229.85,
      "duration_seconds": 2.13,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.34,
      "end_seconds": 261.12,
      "duration_seconds": 15.78,
      "text": "Okay: respiratory rate 18, weight 90 kilos, height 157 centimetres. And blood pressure 159 over 88, temp 36.6 degrees, oxygen saturation is 98 percent, pulse is 76 beats a minute."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 263.69,
      "end_seconds": 267.65,
      "duration_seconds": 3.96,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.64,
      "end_seconds": 270.34,
      "duration_seconds": 1.7,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.49,
      "end_seconds": 290.81,
      "duration_seconds": 4.32,
      "text": "Your weight and waist measurement are both above the healthy range."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.93,
      "end_seconds": 296.24,
      "duration_seconds": 2.31,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.21,
      "end_seconds": 314.21,
      "duration_seconds": 10.0,
      "text": "Let me just check I've got this right. You've been getting out of breath for five days, and no palpitations or high thirst."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 315.13,
      "end_seconds": 316.76,
      "duration_seconds": 1.63,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.51,
      "end_seconds": 329.17,
      "duration_seconds": 10.66,
      "text": "Let's get a thyroid test, for weight gain. I think a cholesterol test makes sense here, for obesity. Let's get an HbA1c, for obesity."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 330.15,
      "end_seconds": 331.31,
      "duration_seconds": 1.16,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 336.76,
      "end_seconds": 348.38,
      "duration_seconds": 11.62,
      "text": "Aim for a loss of half a kilo a week with smaller portions and a daily thirty-minute walk. We'll refer you to the weight management service."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 350.43,
      "end_seconds": 352.23,
      "duration_seconds": 1.8,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 352.99,
      "end_seconds": 361.73,
      "duration_seconds": 8.74,
      "text": "Please don't wait if the symptoms get worse. That's when to be seen urgently. Book a review in three months."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 366.69,
      "end_seconds": 368.77,
      "duration_seconds": 2.08,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 372.01,
      "end_seconds": 375.26,
      "duration_seconds": 3.25,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 375.9,
      "end_seconds": 379.25,
      "duration_seconds": 3.35,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}