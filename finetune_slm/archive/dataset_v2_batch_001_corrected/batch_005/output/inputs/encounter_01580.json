{
  "schema_version": "1.0",
  "encounter_id": "01580",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.12,
      "end_seconds": 4.03,
      "duration_seconds": 2.91,
      "text": "Right, thanks for waiting, come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.32,
      "end_seconds": 10.37,
      "duration_seconds": 1.05,
      "text": "hello, doctor"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.52,
      "end_seconds": 15.81,
      "duration_seconds": 4.29,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.84,
      "end_seconds": 23.85,
      "duration_seconds": 6.01,
      "text": "Yes, that's no problem at all. Please sit. Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 27.22,
      "end_seconds": 30.44,
      "duration_seconds": 3.22,
      "text": "We came because of itchy raised welts."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.66,
      "end_seconds": 33.45,
      "duration_seconds": 1.79,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 35.47,
      "end_seconds": 39.48,
      "duration_seconds": 4.01,
      "text": "Hmm, about two weeks, give or take."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 40.02,
      "end_seconds": 44.16,
      "duration_seconds": 4.14,
      "text": "uh, hm, I'd say more like three weeks"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.85,
      "end_seconds": 49.24,
      "duration_seconds": 4.39,
      "text": "Okay, so roughly two to three weeks. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.6,
      "end_seconds": 53.81,
      "duration_seconds": 3.21,
      "text": "Uh, I suppose so, yes."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.18,
      "end_seconds": 58.04,
      "duration_seconds": 2.86,
      "text": "would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 59.52,
      "end_seconds": 60.64,
      "duration_seconds": 1.12,
      "text": "Mostly severe."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 61.27,
      "end_seconds": 69.63,
      "duration_seconds": 8.36,
      "text": "Ah, and the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 69.73,
      "end_seconds": 78.02,
      "duration_seconds": 8.29,
      "text": "Sorry, what was I saying, tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.99,
      "end_seconds": 81.64,
      "duration_seconds": 2.65,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.59,
      "end_seconds": 88.43,
      "duration_seconds": 4.84,
      "text": "That's fine, one at a time. I'll ask about everything."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 89.53,
      "end_seconds": 103.45,
      "duration_seconds": 13.92,
      "text": "Oh, and welts that move around. That's been about the same, about a month. Oh, and swollen lips at times. That's been about the same, about four days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.36,
      "end_seconds": 108.24,
      "duration_seconds": 2.88,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.25,
      "end_seconds": 116.65,
      "duration_seconds": 6.4,
      "text": "well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.43,
      "end_seconds": 127.69,
      "duration_seconds": 5.26,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.31,
      "end_seconds": 132.88,
      "duration_seconds": 4.57,
      "text": "maybe a four out of ten on a bad day"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.31,
      "end_seconds": 134.39,
      "duration_seconds": 1.08,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 136.47,
      "end_seconds": 139.18,
      "duration_seconds": 2.71,
      "text": "mm, that's what happened, yes"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.92,
      "end_seconds": 144.22,
      "duration_seconds": 3.3,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.8,
      "end_seconds": 157.71,
      "duration_seconds": 2.91,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.79,
      "end_seconds": 179.64,
      "duration_seconds": 7.85,
      "text": "Okay: temperature 36.8, BP is 128 over 77, oxygen saturation is 97 percent, pulse 65."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.21,
      "end_seconds": 186.06,
      "duration_seconds": 3.85,
      "text": "Now I'm gonna do a short physical check."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.03,
      "end_seconds": 188.24,
      "duration_seconds": 1.21,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.02,
      "end_seconds": 202.58,
      "duration_seconds": 5.56,
      "text": "there are pink raised wheals on the arms and trunk that blanch with pressure"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.68,
      "end_seconds": 211.04,
      "duration_seconds": 5.36,
      "text": "alright, you can sit up now and fever, any of that?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 211.58,
      "end_seconds": 215.65,
      "duration_seconds": 4.07,
      "text": "No, um, I haven't had any fever."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 217.1,
      "end_seconds": 222.28,
      "duration_seconds": 5.18,
      "text": "Actually, doctor, I did notice fever. He doesn't always say."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 223.49,
      "end_seconds": 229.48,
      "duration_seconds": 5.99,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.24,
      "end_seconds": 238.89,
      "duration_seconds": 7.65,
      "text": "Alright, I'll note both what you've said and what you've noticed. Has there been any joint pain?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 239.52,
      "end_seconds": 242.9,
      "duration_seconds": 3.38,
      "text": "Not at all, no joint pain."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.71,
      "end_seconds": 248.24,
      "duration_seconds": 3.53,
      "text": "have you noticed difficulty breathing or throat tightness?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 249.68,
      "end_seconds": 264.65,
      "duration_seconds": 14.97,
      "text": "Sorry, what was I saying, no, no difficulty breathing, no throat tightness. I did have poor sleep from itching at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.67,
      "end_seconds": 269.54,
      "duration_seconds": 2.87,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 270.11,
      "end_seconds": 271.71,
      "duration_seconds": 1.6,
      "text": "nothing else aches"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.56,
      "end_seconds": 275.38,
      "duration_seconds": 2.82,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 277.03,
      "end_seconds": 281.27,
      "duration_seconds": 4.24,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.11,
      "end_seconds": 303.37,
      "duration_seconds": 5.26,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 304.68,
      "end_seconds": 313.32,
      "duration_seconds": 8.64,
      "text": "No, I've never smoked in my life. I'm vegetarian and have been for years. My partner and our baby."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 321.19,
      "end_seconds": 323.83,
      "duration_seconds": 2.64,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 324.51,
      "end_seconds": 331.01,
      "duration_seconds": 6.5,
      "text": "yes, wheat i get itchy skin well, yes, walnuts i get hives"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 332.92,
      "end_seconds": 335.02,
      "duration_seconds": 2.1,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 337.13,
      "end_seconds": 344.02,
      "duration_seconds": 6.89,
      "text": "It's a... um, I can't remember what it's called. It's a round yellow one."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 345.49,
      "end_seconds": 348.35,
      "duration_seconds": 2.86,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 349.86,
      "end_seconds": 361.09,
      "duration_seconds": 11.23,
      "text": "For the prostate, I believe. My daughter sets them out for me, I just take what I'm given. Apixaban, 5 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 362.23,
      "end_seconds": 364.83,
      "duration_seconds": 2.6,
      "text": "How long have you taken that?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 365.75,
      "end_seconds": 372.93,
      "duration_seconds": 7.18,
      "text": "About a year now. Cetirizine, 10 milligrams, once a day. Metoprolol I don't take anymore."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 374.21,
      "end_seconds": 379.12,
      "duration_seconds": 4.91,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 379.95,
      "end_seconds": 388.56,
      "duration_seconds": 8.61,
      "text": "Uh, I have an enlarged prostate. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 390.53,
      "end_seconds": 391.48,
      "duration_seconds": 0.95,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 392.9,
      "end_seconds": 399.86,
      "duration_seconds": 6.96,
      "text": "I have an irregular heartbeat i did try to ignore it for a while"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 405.1,
      "end_seconds": 422.12,
      "duration_seconds": 17.02,
      "text": "alright, an irregular heartbeat, that matches what I have here. So, based on the history and the examination, I'd lean towards chronic spontaneous urticaria. It could also be a food reaction, so we'll keep that open"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 422.74,
      "end_seconds": 424.27,
      "duration_seconds": 1.53,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 425.13,
      "end_seconds": 439.67,
      "duration_seconds": 14.54,
      "text": "Nothing I've seen today points to an emergency. It looks like chronic spontaneous urticaria, but I'd like to confirm. Just to be sure I understood. You've had itchy raised welts, severe, and no difficulty breathing."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 440.54,
      "end_seconds": 442.71,
      "duration_seconds": 2.17,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 443.74,
      "end_seconds": 461.8,
      "duration_seconds": 18.06,
      "text": "I'm going to order blood tests, for chronic urticaria we'll begin with fexofenadine, 180 milligrams, once a day, long term that's for urticaria keep a diary of foods and triggers and avoid hot showers have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 463.78,
      "end_seconds": 465.3,
      "duration_seconds": 1.52,
      "text": "That's clear, thanks."
    }
  ]
}