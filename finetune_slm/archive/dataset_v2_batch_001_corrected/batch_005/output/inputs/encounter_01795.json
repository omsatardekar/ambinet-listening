{
  "schema_version": "1.0",
  "encounter_id": "01795",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.31,
      "end_seconds": 6.95,
      "duration_seconds": 5.64,
      "text": "Afternoon, doctor. They're in and comfortable, and I have the measurements ready."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.83,
      "end_seconds": 14.14,
      "duration_seconds": 5.31,
      "text": "Thanks. Hello, come in, sit down. What brings you in today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 14.99,
      "end_seconds": 22.46,
      "duration_seconds": 7.47,
      "text": "it's sudden severe breathlessness, mostly i didn't wanna bother you but it keeps coming back"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 23.19,
      "end_seconds": 33.55,
      "duration_seconds": 10.36,
      "text": "Here are the numbers, doctor. Pulse 92, respiratory rate 22, BP is 142 over 74. Oxygen saturation is 93 percent, temperature is 37.6 degrees."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.1,
      "end_seconds": 36.61,
      "duration_seconds": 1.51,
      "text": "good, thank you"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.13,
      "end_seconds": 46.97,
      "duration_seconds": 2.84,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 48.09,
      "end_seconds": 77.48,
      "duration_seconds": 29.39,
      "text": "About... well, about a week. I'd rather know what's going on than keep guessing. I'm hoping you can tell me something definite. I've also had sharp chest pain on one side, since Monday. Right, you know, with sharp chest pain on one side, it's a couple of times a week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.96,
      "end_seconds": 87.78,
      "duration_seconds": 4.82,
      "text": "What about being unable to lie flat, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 89.54,
      "end_seconds": 94.16,
      "duration_seconds": 4.62,
      "text": "Yes, uh, about the same, two months."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.21,
      "end_seconds": 98.5,
      "duration_seconds": 3.29,
      "text": "Alright, any leg swelling, fever or cough?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 100.1,
      "end_seconds": 104.94,
      "duration_seconds": 4.84,
      "text": "I haven't had leg swelling, fever or cough, no"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.61,
      "end_seconds": 109.51,
      "duration_seconds": 3.9,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 111.11,
      "end_seconds": 113.35,
      "duration_seconds": 2.24,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.5,
      "end_seconds": 117.67,
      "duration_seconds": 3.17,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 119.66,
      "end_seconds": 129.0,
      "duration_seconds": 9.34,
      "text": "Actually, it's hydrocortisone cream, when needed for the eczema. Levetiracetam, 500 milligrams, maybe, twice a day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.95,
      "end_seconds": 134.28,
      "duration_seconds": 4.33,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 135.29,
      "end_seconds": 138.74,
      "duration_seconds": 3.45,
      "text": "Um, no, it's at home."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.1,
      "end_seconds": 142.35,
      "duration_seconds": 2.25,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 142.89,
      "end_seconds": 156.4,
      "duration_seconds": 13.51,
      "text": "I have eczema, for two years. I'm not great at remembering details, so bear with me. It's the not knowing that gets to me. I have epilepsy."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.33,
      "end_seconds": 159.21,
      "duration_seconds": 0.88,
      "text": "anything else?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.29,
      "end_seconds": 170.87,
      "duration_seconds": 1.58,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 171.73,
      "end_seconds": 175.45,
      "duration_seconds": 3.72,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.53,
      "end_seconds": 179.96,
      "duration_seconds": 2.43,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 180.52,
      "end_seconds": 184.07,
      "duration_seconds": 3.55,
      "text": "I'm vegetarian and have been for years"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.45,
      "end_seconds": 187.08,
      "duration_seconds": 1.63,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 187.8,
      "end_seconds": 190.56,
      "duration_seconds": 2.76,
      "text": "My partner and our baby"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.13,
      "end_seconds": 195.26,
      "duration_seconds": 4.13,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 196.33,
      "end_seconds": 199.96,
      "duration_seconds": 3.63,
      "text": "So, my uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.7,
      "end_seconds": 204.49,
      "duration_seconds": 2.79,
      "text": "have you got any known allergies?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 206.11,
      "end_seconds": 211.45,
      "duration_seconds": 5.34,
      "text": "Hmm, uh, no, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.0,
      "end_seconds": 214.82,
      "duration_seconds": 2.82,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 215.87,
      "end_seconds": 223.13,
      "duration_seconds": 7.26,
      "text": "Hmm, yes, I had part of my thyroid removed, years back."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.81,
      "end_seconds": 253.61,
      "duration_seconds": 11.8,
      "text": "Right, here's what I'm thinking. I don't have a clear answer today: a collapsed lung under pressure is possible, and so is a heart attack."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 254.91,
      "end_seconds": 258.2,
      "duration_seconds": 3.29,
      "text": "so, is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.1,
      "end_seconds": 288.75,
      "duration_seconds": 28.65,
      "text": "Nothing I've seen today points to an emergency. It looks like a collapsed lung under pressure, but I'd like to confirm. Let's get an urgent chest decompression, for tension pneumothorax. Stay sitting up, I need to relieve the pressure in your chest right now. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 289.73,
      "end_seconds": 291.97,
      "duration_seconds": 2.24,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.8,
      "end_seconds": 298.31,
      "duration_seconds": 5.51,
      "text": "Please don't wait if the symptoms get worse. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 299.65,
      "end_seconds": 301.85,
      "duration_seconds": 2.2,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.76,
      "end_seconds": 305.86,
      "duration_seconds": 2.1,
      "text": "let's review you straight away"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 309.13,
      "end_seconds": 309.83,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.73,
      "end_seconds": 319.33,
      "duration_seconds": 4.6,
      "text": "Before we finish, can you repeat the plan back to me?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 320.86,
      "end_seconds": 326.05,
      "duration_seconds": 5.19,
      "text": "So, I come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.88,
      "end_seconds": 332.07,
      "duration_seconds": 4.19,
      "text": "Yes, exactly right. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 333.33,
      "end_seconds": 336.76,
      "duration_seconds": 3.43,
      "text": "no, that's all. Thanks a lot"
    }
  ]
}