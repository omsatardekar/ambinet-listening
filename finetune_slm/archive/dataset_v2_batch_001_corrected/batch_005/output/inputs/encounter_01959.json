  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.01,
      "end_seconds": 4.29,
      "duration_seconds": 3.28,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.26,
      "end_seconds": 9.28,
      "duration_seconds": 4.02,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.21,
      "end_seconds": 25.56,
      "duration_seconds": 14.35,
      "text": "erm, it's chest tightness when I walk uphill. I thought I'd wait, but it it hasn't gone. I wasn't sure whether to come in at all, to be honest"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.22,
      "end_seconds": 29.81,
      "duration_seconds": 3.59,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.16,
      "end_seconds": 38.73,
      "duration_seconds": 2.57,
      "text": "bear with me while this finishes.."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.37,
      "end_seconds": 57.1,
      "duration_seconds": 8.73,
      "text": "okay: heart rate 84, temperature is 36.5 degrees, SpO2 99 percent on room air and pressure 116 over 76."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.91,
      "end_seconds": 59.33,
      "duration_seconds": 1.42,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.66,
      "end_seconds": 67.9,
      "duration_seconds": 7.24,
      "text": "we'll look at it together shortly is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.65,
      "end_seconds": 82.01,
      "duration_seconds": 12.36,
      "text": "It just comes and goes. And breathlessness on exertion as well, since yesterday. As for breathlessness on exertion, I'd say mild. It's a few times a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.0,
      "end_seconds": 87.2,
      "duration_seconds": 3.2,
      "text": "and what about pain at rest or palpitations?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.44,
      "end_seconds": 93.14,
      "duration_seconds": 4.7,
      "text": "No uh no pain at rest or palpitations."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.8,
      "end_seconds": 96.8,
      "duration_seconds": 3.0,
      "text": "Any fainting or leg swelling at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.09,
      "end_seconds": 100.22,
      "duration_seconds": 2.13,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.02,
      "end_seconds": 103.34,
      "duration_seconds": 2.32,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.49,
      "end_seconds": 107.62,
      "duration_seconds": 3.13,
      "text": "no, you know, skin's been fine"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.14,
      "end_seconds": 112.47,
      "duration_seconds": 3.33,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.89,
      "end_seconds": 115.23,
      "duration_seconds": 1.34,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.78,
      "end_seconds": 121.4,
      "duration_seconds": 3.62,
      "text": "has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.46,
      "end_seconds": 127.95,
      "duration_seconds": 2.49,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.51,
      "end_seconds": 129.78,
      "duration_seconds": 1.27,
      "text": "any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.55,
      "end_seconds": 133.66,
      "duration_seconds": 2.11,
      "text": "no, not at all"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.19,
      "end_seconds": 136.51,
      "duration_seconds": 1.32,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.39,
      "end_seconds": 142.13,
      "duration_seconds": 3.74,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.06,
      "end_seconds": 148.67,
      "duration_seconds": 1.61,
      "text": "And alcohol how much?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.55,
      "end_seconds": 152.26,
      "duration_seconds": 1.71,
      "text": "Nothing, I'm teetotal"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.79,
      "end_seconds": 155.62,
      "duration_seconds": 2.83,
      "text": "what line of work are you in?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.33,
      "end_seconds": 162.85,
      "duration_seconds": 5.52,
      "text": "I'm a bus driver, so I sit for long hours"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.35,
      "end_seconds": 168.02,
      "duration_seconds": 1.67,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.55,
      "end_seconds": 171.86,
      "duration_seconds": 3.31,
      "text": "I hardly move around during the day"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.8,
      "end_seconds": 174.71,
      "duration_seconds": 1.91,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.3,
      "end_seconds": 180.82,
      "duration_seconds": 4.52,
      "text": "I grab fast food at lunch most days"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.05,
      "end_seconds": 184.59,
      "duration_seconds": 2.54,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.58,
      "end_seconds": 187.22,
      "duration_seconds": 1.64,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.83,
      "end_seconds": 191.28,
      "duration_seconds": 2.45,
      "text": "do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.38,
      "end_seconds": 195.35,
      "duration_seconds": 1.97,
      "text": "Yes, high blood pressure."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.17,
      "end_seconds": 201.07,
      "duration_seconds": 4.9,
      "text": "Alright high blood pressure that matches what I have here."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.3,
      "end_seconds": 212.76,
      "duration_seconds": 4.46,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.12,
      "end_seconds": 232.32,
      "duration_seconds": 18.2,
      "text": "it's valsartan 80 milligrams once a day for my blood pressure. I'd rather not end up on lots of tablets if I can avoid it. I took the morning off to come in today"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.63,
      "end_seconds": 233.61,
      "duration_seconds": 0.98,
      "text": "I follow"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.81,
      "end_seconds": 239.13,
      "duration_seconds": 3.32,
      "text": "Right let's have a proper look at you."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.22,
      "end_seconds": 242.71,
      "duration_seconds": 2.49,
      "text": "okay, I'm just checking this side"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.17,
      "end_seconds": 263.78,
      "duration_seconds": 4.61,
      "text": "your heart sounds are normal and the pulses are all present"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.96,
      "end_seconds": 267.61,
      "duration_seconds": 1.65,
      "text": "that's the examination finished"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.17,
      "end_seconds": 295.2,
      "duration_seconds": 9.03,
      "text": "from what you've told me and what I found I think we're dealing with stable angina at this stage"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.89,
      "end_seconds": 338.4,
      "duration_seconds": 31.51,
      "text": "I want an ECG done, that's for chest tightness i want a cholesterol test done, that's for heart risk let's use glyceryl trinitrate spray, 400 micrograms, when needed, long term that should help with chest tightness stop and rest when the tightness starts, and use the spray if it does not ease in a few minutes. An exercise test is something we might do if this doesn't improve in two weeks"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.48,
      "end_seconds": 347.11,
      "duration_seconds": 7.63,
      "text": "please come and see me after the tests i think we're done unless you have questions"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.46,
      "end_seconds": 351.82,
      "duration_seconds": 3.36,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}