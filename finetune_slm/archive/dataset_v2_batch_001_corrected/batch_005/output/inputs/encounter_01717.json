{
  "schema_version": "1.0",
  "encounter_id": "01717",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.79,
      "end_seconds": 4.27,
      "duration_seconds": 3.48,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.52,
      "end_seconds": 9.66,
      "duration_seconds": 4.14,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.42,
      "end_seconds": 19.3,
      "duration_seconds": 6.88,
      "text": "Sorry, what was I saying, I'm here because of a swollen tummy."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.17,
      "end_seconds": 23.32,
      "duration_seconds": 3.15,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.35,
      "end_seconds": 29.0,
      "duration_seconds": 3.65,
      "text": "I've had it for about a month."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.32,
      "end_seconds": 34.88,
      "duration_seconds": 5.56,
      "text": "I see, go ahead. Right, how troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.44,
      "end_seconds": 41.2,
      "duration_seconds": 4.76,
      "text": "I'd call it moderate. And colicky tummy pain, too."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.95,
      "end_seconds": 62.93,
      "duration_seconds": 4.98,
      "text": "And what about fever, hernia or blood in the stool?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.84,
      "end_seconds": 67.09,
      "duration_seconds": 2.25,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.03,
      "end_seconds": 70.43,
      "duration_seconds": 2.4,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.67,
      "end_seconds": 78.64,
      "duration_seconds": 1.97,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.38,
      "end_seconds": 97.64,
      "duration_seconds": 1.26,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.05,
      "end_seconds": 100.07,
      "duration_seconds": 1.02,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.44,
      "end_seconds": 105.99,
      "duration_seconds": 4.55,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.06,
      "end_seconds": 110.62,
      "duration_seconds": 3.56,
      "text": "It's diclofenac, 50 milligrams, when needed."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.58,
      "end_seconds": 126.25,
      "duration_seconds": 3.67,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.87,
      "end_seconds": 132.77,
      "duration_seconds": 5.9,
      "text": "I, I have arthritis in my knees, for about ten years."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.78,
      "end_seconds": 140.67,
      "duration_seconds": 5.89,
      "text": "Okay, I can see arthritis in your knees in your file as well."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.43,
      "end_seconds": 155.9,
      "duration_seconds": 2.47,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.49,
      "end_seconds": 161.28,
      "duration_seconds": 4.79,
      "text": "I'm allergic to plasters, I get a red itchy rash."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.04,
      "end_seconds": 165.49,
      "duration_seconds": 3.45,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.36,
      "end_seconds": 178.97,
      "duration_seconds": 12.61,
      "text": "I drink a lot of tea and snack through the day. I hardly move around during the day. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.87,
      "end_seconds": 183.64,
      "duration_seconds": 3.77,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.85,
      "end_seconds": 194.2,
      "duration_seconds": 2.35,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.77,
      "end_seconds": 213.29,
      "duration_seconds": 8.52,
      "text": "Okay: pulse 115, respiratory rate 19, SpO2 97 percent on room air, blood pressure 131 over 76."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.8,
      "end_seconds": 217.08,
      "duration_seconds": 2.28,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.41,
      "end_seconds": 222.03,
      "duration_seconds": 3.62,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.1,
      "end_seconds": 226.61,
      "duration_seconds": 3.51,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.26,
      "end_seconds": 230.34,
      "duration_seconds": 2.08,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.09,
      "end_seconds": 248.26,
      "duration_seconds": 5.17,
      "text": "Your tummy is swollen and tympanic, with high-pitched tinkling bowel sounds."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.66,
      "end_seconds": 266.16,
      "duration_seconds": 14.5,
      "text": "That's all I needed to check. Right, here's what I'm thinking. The most likely explanation is a bowel obstruction needing urgent surgical care. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.96,
      "end_seconds": 270.22,
      "duration_seconds": 3.26,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.86,
      "end_seconds": 286.93,
      "duration_seconds": 16.07,
      "text": "I understand the worry. At the moment I'd say it's a bowel obstruction needing urgent surgical care, and we'll know more once the an abdominal X-ray is back. Let's book an abdominal X-ray to look into possible obstruction."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.68,
      "end_seconds": 290.9,
      "duration_seconds": 2.22,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.28,
      "end_seconds": 307.82,
      "duration_seconds": 15.54,
      "text": "Nothing to eat or drink, and you are going to hospital now. If the symptoms get worse, or you feel really unwell, please come to the emergency department. Let's review you straight away."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.61,
      "end_seconds": 310.31,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.96,
      "end_seconds": 318.4,
      "duration_seconds": 7.44,
      "text": "Can you tell me the plan back in your own words, so I know I've explained it clearly?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.78,
      "end_seconds": 324.98,
      "duration_seconds": 5.2,
      "text": "So, I come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.94,
      "end_seconds": 332.91,
      "duration_seconds": 5.97,
      "text": "Yes, exactly right. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.66,
      "end_seconds": 336.98,
      "duration_seconds": 3.32,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.77,
      "end_seconds": 340.4,
      "duration_seconds": 1.63,
      "text": "Have a good day."
    }
  ]
}