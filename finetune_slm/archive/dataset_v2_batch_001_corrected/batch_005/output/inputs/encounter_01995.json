{
  "schema_version": "1.0",
  "encounter_id": "01995",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.2,
      "end_seconds": 4.27,
      "duration_seconds": 3.07,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.94,
      "end_seconds": 11.19,
      "duration_seconds": 5.25,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.44,
      "end_seconds": 18.69,
      "duration_seconds": 6.25,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.77,
      "end_seconds": 28.12,
      "duration_seconds": 7.35,
      "text": "yeah, it's red sore skin on my shoulders i don't know what's causing it"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.74,
      "end_seconds": 40.68,
      "duration_seconds": 10.94,
      "text": "So, tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.14,
      "end_seconds": 49.01,
      "duration_seconds": 6.87,
      "text": "Only cool showers, and it's not much. I notice it more with clothes rubbing."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.88,
      "end_seconds": 56.56,
      "duration_seconds": 6.68,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 56.66,
      "end_seconds": 63.33,
      "duration_seconds": 6.67,
      "text": "Tell the doctor about the other thing, uh, that's what worries me."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.45,
      "end_seconds": 71.93,
      "duration_seconds": 7.48,
      "text": "I was getting to that! I've had tightness of the skin too, for about four days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.27,
      "end_seconds": 75.41,
      "duration_seconds": 2.14,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.76,
      "end_seconds": 79.94,
      "duration_seconds": 3.18,
      "text": "It sort of comes and goes."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.78,
      "end_seconds": 85.17,
      "duration_seconds": 3.39,
      "text": "how strong would you say it is?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.41,
      "end_seconds": 93.34,
      "duration_seconds": 2.93,
      "text": "Pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.64,
      "end_seconds": 94.34,
      "duration_seconds": 0.7,
      "text": "understood"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "UNKNOWN",
      "start_seconds": 95.56,
      "end_seconds": 97.82,
      "duration_seconds": 2.26,
      "text": "Yes, exactly like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.41,
      "end_seconds": 112.17,
      "duration_seconds": 2.76,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.73,
      "end_seconds": 115.48,
      "duration_seconds": 1.75,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.06,
      "end_seconds": 120.8,
      "duration_seconds": 3.74,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.1,
      "end_seconds": 125.89,
      "duration_seconds": 1.79,
      "text": "yes, low haemoglobin"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.43,
      "end_seconds": 127.23,
      "duration_seconds": 0.8,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.26,
      "end_seconds": 134.54,
      "duration_seconds": 3.28,
      "text": "Yes, thin bones. I've got diabetes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.98,
      "end_seconds": 149.2,
      "duration_seconds": 10.22,
      "text": "Okay, I can see thin bones in your file as well. Right, are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.41,
      "end_seconds": 158.37,
      "duration_seconds": 6.96,
      "text": "It's a... um, I can't remember what it's called. It's a small white one."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.86,
      "end_seconds": 162.22,
      "duration_seconds": 2.36,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.04,
      "end_seconds": 178.87,
      "duration_seconds": 14.83,
      "text": "For my bones, I believe. My husband sets them out for me, I just take what I'm given. Glibenclamide, 5 milligrams, maybe, before breakfast for my sugar."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.18,
      "end_seconds": 184.68,
      "duration_seconds": 4.5,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.0,
      "end_seconds": 197.1,
      "duration_seconds": 11.1,
      "text": "Not with me. I'll bring it next time. It's after-sun lotion, twice a day. I used to take sitagliptin, but I stopped it."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.08,
      "end_seconds": 199.94,
      "duration_seconds": 1.86,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.57,
      "end_seconds": 203.25,
      "duration_seconds": 2.68,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.02,
      "end_seconds": 208.86,
      "duration_seconds": 3.84,
      "text": "Alright, does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.5,
      "end_seconds": 213.75,
      "duration_seconds": 4.25,
      "text": "My cousin has psoriasis. My father had bowel cancer."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.23,
      "end_seconds": 218.51,
      "duration_seconds": 3.28,
      "text": "Have you had any fever, vomiting or headache?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.25,
      "end_seconds": 235.06,
      "duration_seconds": 12.81,
      "text": "no, no fever, no vomiting, no headache i did have a little peeling at one point, but that went away on its own"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.26,
      "end_seconds": 239.11,
      "duration_seconds": 2.85,
      "text": "Have you had blisters, by any chance?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.22,
      "end_seconds": 241.68,
      "duration_seconds": 1.46,
      "text": "no blisters, thankfully"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.25,
      "end_seconds": 247.71,
      "duration_seconds": 2.46,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.68,
      "end_seconds": 253.54,
      "duration_seconds": 3.86,
      "text": "well, uh, bowels are regular, nothing odd"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.03,
      "end_seconds": 260.97,
      "duration_seconds": 3.94,
      "text": "how about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.14,
      "end_seconds": 265.04,
      "duration_seconds": 2.9,
      "text": "So, no, that's been fine."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_5",
      "role": "NURSE",
      "start_seconds": 265.54,
      "end_seconds": 282.91,
      "duration_seconds": 17.37,
      "text": "Here are the numbers, doctor. Weight 77 kilos, height 166 centimetres, BMI works out to 27.9. Pulse 76, BP is 116 over 76, SpO2 98 percent on room air, respiratory rate 17, temp 36.6 degrees."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.89,
      "end_seconds": 284.93,
      "duration_seconds": 1.04,
      "text": "alright, thanks"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.4,
      "end_seconds": 291.07,
      "duration_seconds": 4.67,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.5,
      "end_seconds": 294.59,
      "duration_seconds": 2.09,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.07,
      "end_seconds": 314.85,
      "duration_seconds": 3.78,
      "text": "The skin is pink and tender with no blistering."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.84,
      "end_seconds": 325.56,
      "duration_seconds": 6.72,
      "text": "Okay, that's enough for me. So where does that leave us? This is probably mild sunburn."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.59,
      "end_seconds": 354.24,
      "duration_seconds": 19.65,
      "text": "Cool compresses, moisturiser and stay out of the sun for a few days. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. One warning sign to remember: the symptoms get worse. In that case don't wait."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 355.78,
      "end_seconds": 359.19,
      "duration_seconds": 3.41,
      "text": "okay, I'll look out for that that"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.27,
      "end_seconds": 362.88,
      "duration_seconds": 2.61,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 363.46,
      "end_seconds": 366.87,
      "duration_seconds": 3.41,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}