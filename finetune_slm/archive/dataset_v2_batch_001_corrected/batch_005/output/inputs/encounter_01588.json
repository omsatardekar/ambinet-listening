  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.6,
      "end_seconds": 3.41,
      "duration_seconds": 2.81,
      "text": "sorry I'm a little late doctor"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.92,
      "end_seconds": 8.55,
      "duration_seconds": 4.63,
      "text": "yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.32,
      "end_seconds": 27.81,
      "duration_seconds": 18.49,
      "text": "doctor, it's chest tightness when I walk uphill. It's getting on my nerves now. I wasn't sure whether to come in at all, to be honest. My neighbour said I should get it looked at"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.56,
      "end_seconds": 30.7,
      "duration_seconds": 2.14,
      "text": "any regular medication at all?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.24,
      "end_seconds": 34.03,
      "duration_seconds": 2.79,
      "text": "No I don't take any tablets."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.72,
      "end_seconds": 38.15,
      "duration_seconds": 3.43,
      "text": "how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.33,
      "end_seconds": 45.59,
      "duration_seconds": 3.26,
      "text": "I've had it for six months"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.45,
      "end_seconds": 53.14,
      "duration_seconds": 4.69,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.9,
      "end_seconds": 57.04,
      "duration_seconds": 2.14,
      "text": "it's on and off"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.0,
      "end_seconds": 61.95,
      "duration_seconds": 2.95,
      "text": "What aggravates it it if anything?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.87,
      "end_seconds": 67.25,
      "duration_seconds": 4.38,
      "text": "yeah yes cold weather. That makes it worse"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.27,
      "end_seconds": 71.24,
      "duration_seconds": 1.97,
      "text": "What eases it if anything?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.14,
      "end_seconds": 75.23,
      "duration_seconds": 3.09,
      "text": "It settles a little with resting."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.19,
      "end_seconds": 79.05,
      "duration_seconds": 2.86,
      "text": "how much does it limit you?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.98,
      "end_seconds": 80.89,
      "duration_seconds": 0.91,
      "text": "mostly moderate"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.95,
      "end_seconds": 85.27,
      "duration_seconds": 1.32,
      "text": "What about palpitations?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.81,
      "end_seconds": 92.38,
      "duration_seconds": 1.57,
      "text": "Definitely no palpitations."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.96,
      "end_seconds": 96.67,
      "duration_seconds": 3.71,
      "text": "have you had any fainting or leg swelling?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.46,
      "end_seconds": 101.66,
      "duration_seconds": 4.2,
      "text": "No, um, I haven't had any of them."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.76,
      "end_seconds": 105.0,
      "duration_seconds": 2.24,
      "text": "anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.1,
      "end_seconds": 109.96,
      "duration_seconds": 3.86,
      "text": "mm, that's normal as far as I know"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.51,
      "end_seconds": 129.18,
      "duration_seconds": 4.67,
      "text": "are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.82,
      "end_seconds": 133.23,
      "duration_seconds": 3.41,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.23,
      "end_seconds": 137.23,
      "duration_seconds": 3.0,
      "text": "does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.9,
      "end_seconds": 139.69,
      "duration_seconds": 1.79,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.64,
      "end_seconds": 162.59,
      "duration_seconds": 3.95,
      "text": "any medical conditions anything you've been treated for?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.45,
      "end_seconds": 165.21,
      "duration_seconds": 1.76,
      "text": "no, no conditions"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.45,
      "end_seconds": 171.7,
      "duration_seconds": 5.25,
      "text": "tell me about your routine, work, habits, that sort of thing"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.12,
      "end_seconds": 184.64,
      "duration_seconds": 11.52,
      "text": "I'm a bus driver, so I sit for long hours. I'm vegetarian and have been for years. My partner and our baby."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.55,
      "end_seconds": 189.16,
      "duration_seconds": 2.61,
      "text": "let me quickly check your readings"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.38,
      "end_seconds": 200.99,
      "duration_seconds": 2.61,
      "text": "bear with me while this finishes.."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.81,
      "end_seconds": 226.3,
      "duration_seconds": 7.49,
      "text": "okay: oxygen saturation is 99 percent, blood pressure 125 over 71, pulse is 72 beats a a minute"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.15,
      "end_seconds": 229.49,
      "duration_seconds": 1.34,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.18,
      "end_seconds": 233.4,
      "duration_seconds": 2.22,
      "text": "we'll go over that shortly"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.36,
      "end_seconds": 240.41,
      "duration_seconds": 4.05,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.86,
      "end_seconds": 244.21,
      "duration_seconds": 2.35,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.25,
      "end_seconds": 265.74,
      "duration_seconds": 4.49,
      "text": "Your heart sounds are normal and the pulses are all present."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.79,
      "end_seconds": 271.11,
      "duration_seconds": 2.32,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.75,
      "end_seconds": 301.46,
      "duration_seconds": 17.71,
      "text": "Let me tell you where I've got to. It points towards stable angina. Just to be sure I understood. You've had chest tightness when you walk uphill for six months, moderate, and no leg swelling or fainting."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.22,
      "end_seconds": 304.62,
      "duration_seconds": 2.4,
      "text": "yes um that's right"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.74,
      "end_seconds": 320.47,
      "duration_seconds": 8.73,
      "text": "A cholesterol test is what I'd like next, for heart risk. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.02,
      "end_seconds": 323.67,
      "duration_seconds": 2.65,
      "text": "erm thank you that's helpful"
    }
  ]
