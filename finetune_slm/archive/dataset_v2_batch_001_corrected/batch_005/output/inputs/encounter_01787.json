{
  "schema_version": "1.0",
  "encounter_id": "01787",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.02,
      "end_seconds": 4.42,
      "duration_seconds": 3.4,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.73,
      "end_seconds": 9.55,
      "duration_seconds": 3.82,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.36,
      "end_seconds": 22.91,
      "duration_seconds": 12.55,
      "text": "Let me think, mainly being extremely thirsty. There's a couple of other things, but that's the main one. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.0,
      "end_seconds": 28.6,
      "duration_seconds": 3.6,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.92,
      "end_seconds": 32.12,
      "duration_seconds": 2.2,
      "text": "About... well, two days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.83,
      "end_seconds": 35.3,
      "duration_seconds": 2.47,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.86,
      "end_seconds": 39.28,
      "duration_seconds": 3.42,
      "text": "Ah, pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.45,
      "end_seconds": 46.74,
      "duration_seconds": 3.29,
      "text": "Have you been passing huge amounts of urine?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.59,
      "end_seconds": 63.88,
      "duration_seconds": 15.29,
      "text": "Yes, um, for about two weeks. As for being confused and drowsy, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.54,
      "end_seconds": 68.18,
      "duration_seconds": 3.64,
      "text": "Have you noticed chest pain, vomiting or fever?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.11,
      "end_seconds": 72.82,
      "duration_seconds": 3.71,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.61,
      "end_seconds": 76.87,
      "duration_seconds": 3.26,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.74,
      "end_seconds": 80.43,
      "duration_seconds": 1.69,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.35,
      "end_seconds": 83.54,
      "duration_seconds": 2.19,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.38,
      "end_seconds": 86.32,
      "duration_seconds": 0.94,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.45,
      "end_seconds": 89.54,
      "duration_seconds": 2.09,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.25,
      "end_seconds": 97.57,
      "duration_seconds": 5.32,
      "text": "Well, I'm on Glycomet, 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 98.81,
      "end_seconds": 103.97,
      "duration_seconds": 5.16,
      "text": "Doctor, our chart from the last visit lists it as 250 milligrams."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.88,
      "end_seconds": 109.72,
      "duration_seconds": 4.84,
      "text": "Okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.79,
      "end_seconds": 126.96,
      "duration_seconds": 15.17,
      "text": "I don't think I have it with me. Hmm, I take atorvastatin, 20 milligrams, at night. I've been putting this off for weeks. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.17,
      "end_seconds": 133.79,
      "duration_seconds": 2.62,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.45,
      "end_seconds": 138.69,
      "duration_seconds": 3.24,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.75,
      "end_seconds": 142.65,
      "duration_seconds": 2.9,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.29,
      "end_seconds": 150.79,
      "duration_seconds": 3.5,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.31,
      "end_seconds": 158.67,
      "duration_seconds": 2.36,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.44,
      "end_seconds": 163.3,
      "duration_seconds": 3.86,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.72,
      "end_seconds": 178.0,
      "duration_seconds": 3.28,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.76,
      "end_seconds": 184.15,
      "duration_seconds": 5.39,
      "text": "My sister had breast cancer. My mother had a stroke."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.23,
      "end_seconds": 188.91,
      "duration_seconds": 3.68,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.94,
      "end_seconds": 193.93,
      "duration_seconds": 3.99,
      "text": "I have diabetes, for about ten years."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.67,
      "end_seconds": 197.22,
      "duration_seconds": 1.55,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.46,
      "end_seconds": 202.06,
      "duration_seconds": 3.6,
      "text": "Oh, I've had high cholesterol, yes."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.89,
      "end_seconds": 204.39,
      "duration_seconds": 1.5,
      "text": "Right, anything else?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.62,
      "end_seconds": 212.0,
      "duration_seconds": 6.38,
      "text": "Right, so high cholesterol is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.07,
      "end_seconds": 226.39,
      "duration_seconds": 3.32,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.63,
      "end_seconds": 232.79,
      "duration_seconds": 5.16,
      "text": "I had a meniscus repair on my knee four years ago."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 233.94,
      "end_seconds": 244.29,
      "duration_seconds": 10.35,
      "text": "Here are the numbers, doctor. Heart rate 113, temperature is 36.6 degrees, blood pressure 112 over 70, SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.05,
      "end_seconds": 245.75,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.51,
      "end_seconds": 251.93,
      "duration_seconds": 3.42,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.78,
      "end_seconds": 254.16,
      "duration_seconds": 1.38,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.25,
      "end_seconds": 273.32,
      "duration_seconds": 7.07,
      "text": "You are very dry and drowsy, and your sugar reading is too high to read."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.37,
      "end_seconds": 276.1,
      "duration_seconds": 1.73,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.32,
      "end_seconds": 291.75,
      "duration_seconds": 10.43,
      "text": "Okay, that's enough for me. Okay, so my impression is this: The most likely explanation is a hyperosmolar diabetic emergency. Sepsis is also on my list."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.64,
      "end_seconds": 294.67,
      "duration_seconds": 2.03,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.76,
      "end_seconds": 305.77,
      "duration_seconds": 9.01,
      "text": "It's reasonable to be concerned, but right now a hyperosmolar diabetic emergency is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 315.44,
      "end_seconds": 321.4,
      "duration_seconds": 5.96,
      "text": "Doctor, I did an ECG before they came in, the result's on your screen."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.49,
      "end_seconds": 327.85,
      "duration_seconds": 5.36,
      "text": "Thanks, that helps. I want urgent blood tests done, that's for hyperglycaemic emergency."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.66,
      "end_seconds": 334.28,
      "duration_seconds": 1.62,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.27,
      "end_seconds": 350.87,
      "duration_seconds": 15.6,
      "text": "You need hospital now for fluids and insulin. I think the emergency team should see you too. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.94,
      "end_seconds": 353.43,
      "duration_seconds": 1.49,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.98,
      "end_seconds": 356.73,
      "duration_seconds": 2.75,
      "text": "Let's plan a check straight away."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 357.28,
      "end_seconds": 360.74,
      "duration_seconds": 3.46,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.7,
      "end_seconds": 365.48,
      "duration_seconds": 2.78,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 366.39,
      "end_seconds": 368.69,
      "duration_seconds": 2.3,
      "text": "Alright, thanks, take care."
    }
  ]
}