{
  "schema_version": "1.0",
  "encounter_id": "01902",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.83,
      "end_seconds": 4.93,
      "duration_seconds": 4.1,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.77,
      "end_seconds": 14.15,
      "duration_seconds": 4.38,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.33,
      "end_seconds": 25.49,
      "duration_seconds": 10.16,
      "text": "Sorry, what was I saying, honestly, it's tingling in my thumb and first fingers, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.81,
      "end_seconds": 29.54,
      "duration_seconds": 2.73,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.04,
      "end_seconds": 32.13,
      "duration_seconds": 1.09,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.44,
      "end_seconds": 35.25,
      "duration_seconds": 1.81,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.37,
      "end_seconds": 39.8,
      "duration_seconds": 3.43,
      "text": "It's been going on for three days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.05,
      "end_seconds": 43.07,
      "duration_seconds": 3.02,
      "text": "Ah. How much does it limit you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.88,
      "end_seconds": 45.47,
      "duration_seconds": 1.59,
      "text": "Mild, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.51,
      "end_seconds": 48.72,
      "duration_seconds": 2.21,
      "text": "What eases it, if anything?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.35,
      "end_seconds": 55.16,
      "duration_seconds": 3.81,
      "text": "I get some relief from shaking the hand."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.79,
      "end_seconds": 59.54,
      "duration_seconds": 2.75,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.19,
      "end_seconds": 62.51,
      "duration_seconds": 2.32,
      "text": "Honestly, every other day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.31,
      "end_seconds": 86.92,
      "duration_seconds": 6.61,
      "text": "Have you had any neck pain, weakness in the legs or pain in the shoulder?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.97,
      "end_seconds": 97.32,
      "duration_seconds": 8.35,
      "text": "Um, I haven't had neck pain, weakness in the legs or pain in the shoulder, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.62,
      "end_seconds": 101.17,
      "duration_seconds": 2.55,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.14,
      "end_seconds": 103.89,
      "duration_seconds": 1.75,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.72,
      "end_seconds": 119.45,
      "duration_seconds": 1.73,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.99,
      "end_seconds": 124.58,
      "duration_seconds": 4.59,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.34,
      "end_seconds": 129.11,
      "duration_seconds": 1.77,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.15,
      "end_seconds": 135.16,
      "duration_seconds": 4.01,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.07,
      "end_seconds": 151.55,
      "duration_seconds": 1.48,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.15,
      "end_seconds": 157.11,
      "duration_seconds": 1.96,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.15,
      "end_seconds": 174.39,
      "duration_seconds": 3.24,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.63,
      "end_seconds": 177.6,
      "duration_seconds": 1.97,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.17,
      "end_seconds": 184.16,
      "duration_seconds": 2.99,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.6,
      "end_seconds": 199.24,
      "duration_seconds": 2.64,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.14,
      "end_seconds": 226.9,
      "duration_seconds": 6.76,
      "text": "Okay: heart rate 65, blood pressure 118 over 81. And saturation 99 percent, respiratory rate 17."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.88,
      "end_seconds": 234.76,
      "duration_seconds": 4.88,
      "text": "So, I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.41,
      "end_seconds": 238.6,
      "duration_seconds": 2.19,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.02,
      "end_seconds": 257.16,
      "duration_seconds": 7.14,
      "text": "Tapping over the wrist brings on the tingling and the thumb muscle is slightly thin."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.16,
      "end_seconds": 277.2,
      "duration_seconds": 14.04,
      "text": "That's the examination finished. Taking everything into account, it's hard to say. Carpal tunnel syndrome is one possibility and a pinched nerve in the neck another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.81,
      "end_seconds": 283.11,
      "duration_seconds": 4.3,
      "text": "I mean, what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.73,
      "end_seconds": 315.8,
      "duration_seconds": 32.07,
      "text": "Nothing I've seen today points to an emergency. It looks like carpal tunnel syndrome, but I'd like to confirm. A nerve conduction study is what I'd like next, for carpal tunnel. That will help us see what's going on underneath and decide the next step. Wear a wrist splint at night. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.66,
      "end_seconds": 322.76,
      "duration_seconds": 5.1,
      "text": "If the symptoms get worse, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.27,
      "end_seconds": 325.34,
      "duration_seconds": 1.07,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.42,
      "end_seconds": 333.9,
      "duration_seconds": 6.48,
      "text": "Please come and see me in six weeks. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.42,
      "end_seconds": 337.68,
      "duration_seconds": 2.26,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.35,
      "end_seconds": 339.6,
      "duration_seconds": 1.25,
      "text": "All the best."
    }
  ]
}