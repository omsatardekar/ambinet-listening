{
  "schema_version": "1.0",
  "encounter_id": "01613",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.18,
      "end_seconds": 4.61,
      "duration_seconds": 3.43,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.48,
      "end_seconds": 10.04,
      "duration_seconds": 4.56,
      "text": "Okay, come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.79,
      "end_seconds": 19.81,
      "duration_seconds": 6.02,
      "text": "It's sudden severe breathlessness. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.87,
      "end_seconds": 27.51,
      "duration_seconds": 6.64,
      "text": "How many days or weeks has it been? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.18,
      "end_seconds": 34.47,
      "duration_seconds": 5.29,
      "text": "Right, around two days... no wait, it's more like five days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.26,
      "end_seconds": 38.23,
      "duration_seconds": 1.97,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.85,
      "end_seconds": 41.4,
      "duration_seconds": 2.55,
      "text": "It happens on and off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.79,
      "end_seconds": 58.16,
      "duration_seconds": 3.37,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.1,
      "end_seconds": 61.79,
      "duration_seconds": 2.69,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.51,
      "end_seconds": 66.48,
      "duration_seconds": 3.97,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.49,
      "end_seconds": 73.19,
      "duration_seconds": 2.7,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.61,
      "end_seconds": 79.14,
      "duration_seconds": 4.53,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.18,
      "end_seconds": 81.69,
      "duration_seconds": 1.51,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.55,
      "end_seconds": 84.79,
      "duration_seconds": 1.24,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.65,
      "end_seconds": 89.46,
      "duration_seconds": 2.81,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.35,
      "end_seconds": 94.2,
      "duration_seconds": 2.85,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.52,
      "end_seconds": 99.67,
      "duration_seconds": 4.15,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.65,
      "end_seconds": 104.09,
      "duration_seconds": 2.44,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.69,
      "end_seconds": 111.5,
      "duration_seconds": 5.81,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.07,
      "end_seconds": 129.46,
      "duration_seconds": 4.39,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.07,
      "end_seconds": 134.46,
      "duration_seconds": 3.39,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.62,
      "end_seconds": 138.17,
      "duration_seconds": 2.55,
      "text": "Any leg swelling, cough or fever?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.73,
      "end_seconds": 143.11,
      "duration_seconds": 4.38,
      "text": "Sorry, what was I saying, nope, nothing like that."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.02,
      "end_seconds": 149.1,
      "duration_seconds": 4.08,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.86,
      "end_seconds": 153.52,
      "duration_seconds": 2.66,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.69,
      "end_seconds": 165.51,
      "duration_seconds": 2.82,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.82,
      "end_seconds": 177.24,
      "duration_seconds": 2.42,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.69,
      "end_seconds": 203.82,
      "duration_seconds": 10.13,
      "text": "Okay: BP is 128 over 81, heart rate 86, oxygen saturation is 89 percent, temperature is 37.3 degrees, respiratory rate 24."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.31,
      "end_seconds": 207.92,
      "duration_seconds": 2.61,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.7,
      "end_seconds": 211.74,
      "duration_seconds": 2.04,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.36,
      "end_seconds": 234.72,
      "duration_seconds": 9.36,
      "text": "Your windpipe is pushed to the right, there is no breath sound on the left, and your pressure is dropping."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.81,
      "end_seconds": 253.85,
      "duration_seconds": 15.04,
      "text": "Okay, please sit back down. Taking everything into account, it's hard to say. A collapsed lung under pressure is one possibility and a heart attack another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.79,
      "end_seconds": 256.9,
      "duration_seconds": 2.11,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.3,
      "end_seconds": 275.86,
      "duration_seconds": 17.56,
      "text": "I can't promise yet, but most people with a collapsed lung under pressure do well once it's treated properly. Stop me if I've got anything wrong. You've had sudden severe breathlessness for five days, and no leg swelling or fever."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.24,
      "end_seconds": 278.9,
      "duration_seconds": 1.66,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.53,
      "end_seconds": 293.83,
      "duration_seconds": 4.3,
      "text": "We should do a chest X-ray for chest pain."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.5,
      "end_seconds": 297.89,
      "duration_seconds": 2.39,
      "text": "Okay, I'll do it."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.9,
      "end_seconds": 308.62,
      "duration_seconds": 8.72,
      "text": "Stay sitting up, I need to relieve the pressure in your chest right now. I'll also refer you to the emergency team."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.83,
      "end_seconds": 314.53,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.17,
      "end_seconds": 336.27,
      "duration_seconds": 21.1,
      "text": "I'm not ordering an urgent chest decompression today. If things carry on in two weeks, we'll consider it. Come back or go to emergency straight away if the symptoms get worse. Book a review straight away. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.29,
      "end_seconds": 342.12,
      "duration_seconds": 3.83,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}