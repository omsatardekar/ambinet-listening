{
  "schema_version": "1.0",
  "encounter_id": "01694",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.58,
      "end_seconds": 5.13,
      "duration_seconds": 4.55,
      "text": "Afternoon, doctor. They're in and comfortable, and I have the measurements ready."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.07,
      "end_seconds": 11.23,
      "duration_seconds": 5.16,
      "text": "Good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 13.13,
      "end_seconds": 18.61,
      "duration_seconds": 5.48,
      "text": "It's sudden severe breathlessness. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.59,
      "end_seconds": 22.56,
      "duration_seconds": 1.97,
      "text": "did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 24.13,
      "end_seconds": 51.87,
      "duration_seconds": 27.74,
      "text": "It's been going on for about a month. And I've been feeling very faint as well, for three days. As for feeling very faint, honestly, once or twice a day. I've also had being unable to lie flat, since this morning. And there's sharp chest pain on one side as well, about three months now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.24,
      "end_seconds": 58.82,
      "duration_seconds": 5.58,
      "text": "Have you had sudden severe breathlessness before, or is this the first time?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 59.67,
      "end_seconds": 66.49,
      "duration_seconds": 6.82,
      "text": "yes, something like this happened last winter, and it went away on its own"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 67.02,
      "end_seconds": 81.2,
      "duration_seconds": 14.18,
      "text": "Okay, so the vitals from earlier. Oxygen saturation is 91 percent, height 176 centimetres, pulse 96, respiratory rate 22, BMI works out to 23.9, weight 74 kilos, temp 37.0 degrees, BP is 142 over 78."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.11,
      "end_seconds": 84.11,
      "duration_seconds": 1.0,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.35,
      "end_seconds": 89.27,
      "duration_seconds": 2.92,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.21,
      "end_seconds": 92.38,
      "duration_seconds": 1.17,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.09,
      "end_seconds": 117.42,
      "duration_seconds": 10.33,
      "text": "Your windpipe is pushed to the the right, there is no breath sound on the left, and your pressure is dropping."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.36,
      "end_seconds": 129.73,
      "duration_seconds": 6.37,
      "text": "thank you, you can get dressed. Have you noticed cough, fever or leg swelling?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 131.68,
      "end_seconds": 134.43,
      "duration_seconds": 2.75,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.58,
      "end_seconds": 137.92,
      "duration_seconds": 2.34,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 139.34,
      "end_seconds": 141.02,
      "duration_seconds": 1.68,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.89,
      "end_seconds": 146.15,
      "duration_seconds": 3.26,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 147.24,
      "end_seconds": 149.36,
      "duration_seconds": 2.12,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.86,
      "end_seconds": 154.81,
      "duration_seconds": 3.95,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 155.51,
      "end_seconds": 173.61,
      "duration_seconds": 18.1,
      "text": "No, I've never smoked in my life. I used to drink heavily but I stopped four years ago. I drink a lot of tea and snack through the day. I do a yoga class on Thursdays"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.23,
      "end_seconds": 175.5,
      "duration_seconds": 1.27,
      "text": "any previous surgeries?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 180.3,
      "end_seconds": 183.3,
      "duration_seconds": 3.0,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.63,
      "end_seconds": 188.58,
      "duration_seconds": 3.95,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 189.6,
      "end_seconds": 196.09,
      "duration_seconds": 6.49,
      "text": "Propranolol, 40 milligrams, maybe, twice a day for the migraine prevention."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.42,
      "end_seconds": 202.02,
      "duration_seconds": 4.6,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 204.0,
      "end_seconds": 209.74,
      "duration_seconds": 5.74,
      "text": "No, it's at home. I'm on sertraline, 50 milligrams, once a day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.96,
      "end_seconds": 212.35,
      "duration_seconds": 1.39,
      "text": "Is that long-standing?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 213.8,
      "end_seconds": 215.76,
      "duration_seconds": 1.96,
      "text": "about about three months"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.88,
      "end_seconds": 230.29,
      "duration_seconds": 3.41,
      "text": "has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 231.12,
      "end_seconds": 235.32,
      "duration_seconds": 4.2,
      "text": "I've got migraines hmm, I've had depression, yes"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.22,
      "end_seconds": 242.94,
      "duration_seconds": 5.72,
      "text": "right, right okay, I can see migraines in your file as well"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.64,
      "end_seconds": 260.54,
      "duration_seconds": 2.9,
      "text": "does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 264.73,
      "end_seconds": 266.6,
      "duration_seconds": 1.87,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.97,
      "end_seconds": 286.91,
      "duration_seconds": 18.94,
      "text": "So, based on the history and the examination, it points towards a collapsed lung under pressure. I'd also keep a heart attack in mind. Just to be sure I understood. You've had sudden severe breathlessness for about a month, and no cough or fever."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 287.79,
      "end_seconds": 288.49,
      "duration_seconds": 0.7,
      "text": "correct"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.65,
      "end_seconds": 336.37,
      "duration_seconds": 31.72,
      "text": "I'm going to order a chest X-ray, for chest pain. That will help us see what's going on underneath and decide the next step. I want an urgent chest decompression done, that's for tension pneumothorax. Stay sitting up, I need to relieve the pressure in your chest right now. And please bring the latest prescription or the medicine boxes to the next visit, so so we can settle the dose."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.22,
      "end_seconds": 347.77,
      "duration_seconds": 9.55,
      "text": "please don't wait if the symptoms get worse that's when to be seen urgently i'd like to see you again straight away"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 349.74,
      "end_seconds": 351.93,
      "duration_seconds": 2.19,
      "text": "Alright, I'll be back."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.58,
      "end_seconds": 355.36,
      "duration_seconds": 2.78,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 356.22,
      "end_seconds": 360.27,
      "duration_seconds": 4.05,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.14,
      "end_seconds": 363.33,
      "duration_seconds": 1.19,
      "text": "Goodbye for now."
    }
  ]
}