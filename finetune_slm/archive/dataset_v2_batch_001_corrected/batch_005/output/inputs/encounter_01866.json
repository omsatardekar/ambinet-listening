  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.12,
      "end_seconds": 5.2,
      "duration_seconds": 4.08,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.86,
      "end_seconds": 10.15,
      "duration_seconds": 4.29,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.94,
      "end_seconds": 18.16,
      "duration_seconds": 7.22,
      "text": "Mainly a swollen tummy. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.29,
      "end_seconds": 22.35,
      "duration_seconds": 3.06,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.68,
      "end_seconds": 32.27,
      "duration_seconds": 8.59,
      "text": "It's been five days, I'm fairly sure. I didn't wanna bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.68,
      "end_seconds": 36.91,
      "duration_seconds": 4.23,
      "text": "Hm, okay. How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.61,
      "end_seconds": 42.03,
      "duration_seconds": 3.42,
      "text": "Pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.79,
      "end_seconds": 46.66,
      "duration_seconds": 3.87,
      "text": "What about vomiting green fluid, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.65,
      "end_seconds": 57.4,
      "duration_seconds": 8.75,
      "text": "Yes, about the same, three days. So, with vomiting green fluid, pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.47,
      "end_seconds": 64.19,
      "duration_seconds": 2.72,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.69,
      "end_seconds": 80.74,
      "duration_seconds": 3.05,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.91,
      "end_seconds": 101.8,
      "duration_seconds": 11.89,
      "text": "Okay: temp 37.0 degrees, height 162 centimetres, BMI works out to 29.3, respiratory rate 16, blood pressure 116 over 78, weight 77 kilos, heart rate 117."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.78,
      "end_seconds": 108.07,
      "duration_seconds": 3.29,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.3,
      "end_seconds": 111.78,
      "duration_seconds": 2.48,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.47,
      "end_seconds": 130.95,
      "duration_seconds": 5.48,
      "text": "your tummy is swollen and tympanic, with high-pitched tinkling bowel sounds"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.45,
      "end_seconds": 138.01,
      "duration_seconds": 1.56,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.3,
      "end_seconds": 158.96,
      "duration_seconds": 6.66,
      "text": "Let me check a few things. Any blood in the stool, fever or hernia?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.19,
      "end_seconds": 165.62,
      "duration_seconds": 5.43,
      "text": "So, no, no blood in the stool, fever or hernia."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.48,
      "end_seconds": 170.08,
      "duration_seconds": 3.6,
      "text": "anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.04,
      "end_seconds": 175.43,
      "duration_seconds": 3.39,
      "text": "nothing on the skin, uh, no"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.12,
      "end_seconds": 181.01,
      "duration_seconds": 4.89,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.66,
      "end_seconds": 187.71,
      "duration_seconds": 5.05,
      "text": "Okay, so yes, milk, it gives me a rash."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.16,
      "end_seconds": 194.67,
      "duration_seconds": 5.51,
      "text": "Okay, do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.64,
      "end_seconds": 198.99,
      "duration_seconds": 3.35,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.61,
      "end_seconds": 216.44,
      "duration_seconds": 1.83,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.14,
      "end_seconds": 219.76,
      "duration_seconds": 2.62,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.52,
      "end_seconds": 222.7,
      "duration_seconds": 2.18,
      "text": "tell me about your eating"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.17,
      "end_seconds": 229.09,
      "duration_seconds": 4.92,
      "text": "I drink a lot of tea and snack through the day"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.98,
      "end_seconds": 233.27,
      "duration_seconds": 2.29,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.73,
      "end_seconds": 237.35,
      "duration_seconds": 2.62,
      "text": "I swim twice a week"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.89,
      "end_seconds": 249.53,
      "duration_seconds": 2.64,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.66,
      "end_seconds": 253.1,
      "duration_seconds": 2.44,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.48,
      "end_seconds": 295.31,
      "duration_seconds": 32.83,
      "text": "Having listened and examined, this looks most like a bowel obstruction needing urgent surgical care. An abdominal X-ray is what I'd like next, for possible obstruction. I think urgent blood tests makes sense here, for vomiting. I'd rather check than guess, and this is the quickest way to know more. Nothing to eat or drink, and you are going to hospital now. I'd like to see you again straight away."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.01,
      "end_seconds": 301.06,
      "duration_seconds": 4.05,
      "text": "Okay, I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.75,
      "end_seconds": 304.46,
      "duration_seconds": 1.71,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.47,
      "end_seconds": 306.85,
      "duration_seconds": 1.38,
      "text": "take care now"
    }
  ]
