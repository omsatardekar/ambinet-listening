      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.34,
      "end_seconds": 126.49,
      "duration_seconds": 2.15,
      "text": "Do you live by yourself?"
