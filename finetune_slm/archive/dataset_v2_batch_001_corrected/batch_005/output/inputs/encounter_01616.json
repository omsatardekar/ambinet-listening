    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.6,
      "end_seconds": 155.75,
      "duration_seconds": 3.15,
      "text": "Okay, before we go further, any allergies?"
