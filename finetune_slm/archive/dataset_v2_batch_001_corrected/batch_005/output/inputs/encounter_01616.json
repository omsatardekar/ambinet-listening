      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.6,
      "end_seconds": 123.29,
      "duration_seconds": 2.69,
      "text": "I gave up cigarettes last spring."
