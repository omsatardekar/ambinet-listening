      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.36,
      "end_seconds": 170.56,
      "duration_seconds": 2.2,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.5,
      "end_seconds": 176.75,
      "duration_seconds": 4.25,
      "text": "I've had heart failure for about ten years now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.87,
      "end_seconds": 193.61,
      "duration_seconds": 2.74,
      "text": "are you on any regular medication?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.22,
      "end_seconds": 196.25,
      "duration_seconds": 2.03,
      "text": "no, uh, none"
