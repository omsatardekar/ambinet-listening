    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.76,
      "end_seconds": 200.42,
      "duration_seconds": 3.66,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.2,
      "end_seconds": 215.32,
      "duration_seconds": 2.12,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.77,
      "end_seconds": 240.82,
      "duration_seconds": 8.05,
      "text": "Okay: respiratory rate 14, pulse 80, temperature is 36.5 degrees. And pressure 109 over 71, saturation 98 percent."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.52,
      "end_seconds": 246.3,
      "duration_seconds": 3.78,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.77,
      "end_seconds": 250.52,
      "duration_seconds": 2.75,
      "text": "Yes, you know, that's fine."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.35,
      "end_seconds": 253.7,
      "duration_seconds": 2.35,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.58,
      "end_seconds": 273.09,
      "duration_seconds": 7.51,
      "text": "Tapping over the wrist brings on the tingling and the the thumb muscle is slightly thin."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.75,
      "end_seconds": 295.08,
      "duration_seconds": 18.33,
      "text": "You can relax now. Let me tell you where I've got to. The most likely explanation is carpal tunnel syndrome. The reason I say that is that your story and my examination fit together. A nerve conduction study is what I'd like next, for carpal tunnel."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.71,
      "end_seconds": 297.74,
      "duration_seconds": 1.03,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.68,
      "end_seconds": 311.44,
      "duration_seconds": 12.76,
      "text": "Wear a wrist splint at night. We'll refer you to the hand clinic. I'd like to see you again in six weeks. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.1,
      "end_seconds": 316.1,
      "duration_seconds": 3.0,
      "text": "I think I understand everything. Thanks."
