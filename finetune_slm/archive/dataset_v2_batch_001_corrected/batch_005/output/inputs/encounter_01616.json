      "role": "DOCTOR",
      "start_seconds": 68.77,
      "end_seconds": 75.23,
      "duration_seconds": 6.46,
      "text": "Have you noticed pain in the shoulder, weakness in the legs or neck pain?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.28,
      "end_seconds": 82.99,
      "duration_seconds": 5.71,
      "text": "Sorry, um, what was I saying, nope, nothing like that."
