{
  "schema_version": "1.0",
  "encounter_id": "01572",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.74,
      "end_seconds": 5.15,
      "duration_seconds": 4.41,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.69,
      "end_seconds": 11.08,
      "duration_seconds": 4.39,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.35,
      "end_seconds": 23.92,
      "duration_seconds": 11.57,
      "text": "Yeah, it's a purple rash that does not fade. I don't know what's causing it. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.99,
      "end_seconds": 27.29,
      "duration_seconds": 2.3,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.56,
      "end_seconds": 34.33,
      "duration_seconds": 5.77,
      "text": "Being drowsy goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.16,
      "end_seconds": 38.17,
      "duration_seconds": 2.01,
      "text": "Have you had any cough?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.8,
      "end_seconds": 40.34,
      "duration_seconds": 1.54,
      "text": "No cough, thankfully."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.99,
      "end_seconds": 44.76,
      "duration_seconds": 2.77,
      "text": "Have you noticed stiff neck or diarrhoea?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.48,
      "end_seconds": 49.56,
      "duration_seconds": 3.08,
      "text": "No, no stiff neck or diarrhoea."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.68,
      "end_seconds": 53.56,
      "duration_seconds": 2.88,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.33,
      "end_seconds": 56.88,
      "duration_seconds": 2.55,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.64,
      "end_seconds": 61.13,
      "duration_seconds": 3.49,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.82,
      "end_seconds": 65.06,
      "duration_seconds": 3.24,
      "text": "Um, no, that's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.25,
      "end_seconds": 67.66,
      "duration_seconds": 1.41,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.78,
      "end_seconds": 71.92,
      "duration_seconds": 3.14,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.98,
      "end_seconds": 75.99,
      "duration_seconds": 2.01,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.71,
      "end_seconds": 83.16,
      "duration_seconds": 5.45,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.14,
      "end_seconds": 88.07,
      "duration_seconds": 2.93,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.27,
      "end_seconds": 92.68,
      "duration_seconds": 3.41,
      "text": "My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.97,
      "end_seconds": 108.73,
      "duration_seconds": 3.76,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.23,
      "end_seconds": 116.12,
      "duration_seconds": 6.89,
      "text": "Oh, uh, I'm on diclofenac, 50 milligrams, when needed for the joint pain."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.88,
      "end_seconds": 128.07,
      "duration_seconds": 3.19,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.79,
      "end_seconds": 135.33,
      "duration_seconds": 6.54,
      "text": "Let me think, I have arthritis in my knees, for about ten years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.06,
      "end_seconds": 139.03,
      "duration_seconds": 2.97,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.78,
      "end_seconds": 145.42,
      "duration_seconds": 4.64,
      "text": "Yes, I had a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.72,
      "end_seconds": 151.74,
      "duration_seconds": 5.02,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.84,
      "end_seconds": 154.55,
      "duration_seconds": 1.71,
      "text": "Erythromycin, I'd say."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.17,
      "end_seconds": 173.32,
      "duration_seconds": 4.15,
      "text": "Okay, shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.48,
      "end_seconds": 187.54,
      "duration_seconds": 2.06,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.75,
      "end_seconds": 204.23,
      "duration_seconds": 5.48,
      "text": "Okay: blood pressure 116 over 77, pulse is 98 beats a minute."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.43,
      "end_seconds": 209.69,
      "duration_seconds": 4.26,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.48,
      "end_seconds": 214.01,
      "duration_seconds": 2.53,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.8,
      "end_seconds": 238.38,
      "duration_seconds": 8.58,
      "text": "The purple spots do not fade when I press a glass on them, and he is floppy and drowsy."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.83,
      "end_seconds": 255.13,
      "duration_seconds": 12.3,
      "text": "That's the examination finished. Let me tell you where I've got to. It points towards possible meningococcal sepsis. We should do blood cultures for possible sepsis."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 256.76,
      "end_seconds": 259.98,
      "duration_seconds": 3.22,
      "text": "The earliest is Tuesday, 11:30 am."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.86,
      "end_seconds": 264.18,
      "duration_seconds": 2.32,
      "text": "Okay, I'll be there."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.64,
      "end_seconds": 286.04,
      "duration_seconds": 20.4,
      "text": "We should do urgent blood tests for possible sepsis. Let's use benzylpenicillin, 600 milligrams, once now, single dose. That's for possible meningococcal sepsis. I am giving an antibiotic injection now and calling an ambulance. One warning sign to remember: the symptoms get worse. In that case don't wait."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.6,
      "end_seconds": 289.14,
      "duration_seconds": 1.54,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.19,
      "end_seconds": 296.28,
      "duration_seconds": 5.09,
      "text": "Let's review you straight away. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.3,
      "end_seconds": 300.07,
      "duration_seconds": 2.77,
      "text": "Oh, thank you, that's helpful."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.52,
      "end_seconds": 302.8,
      "duration_seconds": 1.28,
      "text": "See you soon."
    }
  ]
}