  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.91,
      "end_seconds": 5.95,
      "duration_seconds": 5.04,
      "text": "Good evening, um, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.82,
      "end_seconds": 12.42,
      "duration_seconds": 5.6,
      "text": "So, you're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.24,
      "end_seconds": 19.3,
      "duration_seconds": 5.06,
      "text": "Yeah, it's tired muscles. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.86,
      "end_seconds": 22.82,
      "duration_seconds": 2.96,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.88,
      "end_seconds": 35.85,
      "duration_seconds": 10.97,
      "text": "For about a week, I'd say. I've also had not getting outdoors. Yeah, about not getting outdoors, it's severe, honestly."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.62,
      "end_seconds": 40.73,
      "duration_seconds": 3.11,
      "text": "Have you had any fractures or weakness?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.22,
      "end_seconds": 47.89,
      "duration_seconds": 2.67,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.69,
      "end_seconds": 52.06,
      "duration_seconds": 3.37,
      "text": "Any bone pain or weight loss at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.71,
      "end_seconds": 55.97,
      "duration_seconds": 2.26,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.59,
      "end_seconds": 60.76,
      "duration_seconds": 4.17,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.44,
      "end_seconds": 65.94,
      "duration_seconds": 3.5,
      "text": "Ah, no, nothing with my heart."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.34,
      "end_seconds": 70.03,
      "duration_seconds": 2.69,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.87,
      "end_seconds": 73.41,
      "duration_seconds": 1.54,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.19,
      "end_seconds": 80.15,
      "duration_seconds": 3.96,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.64,
      "end_seconds": 83.16,
      "duration_seconds": 1.52,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.72,
      "end_seconds": 87.72,
      "duration_seconds": 3.0,
      "text": "Alright, now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.53,
      "end_seconds": 100.26,
      "duration_seconds": 11.73,
      "text": "Yes, I work in a bakery, early starts. I drink a lot of tea and snack through the day. I swim twice a week."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.42,
      "end_seconds": 120.32,
      "duration_seconds": 2.9,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.93,
      "end_seconds": 128.64,
      "duration_seconds": 2.71,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.26,
      "end_seconds": 133.32,
      "duration_seconds": 3.06,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.25,
      "end_seconds": 143.33,
      "duration_seconds": 5.08,
      "text": "Just keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.6,
      "end_seconds": 152.7,
      "duration_seconds": 2.1,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.95,
      "end_seconds": 161.37,
      "duration_seconds": 3.42,
      "text": "I mean, no, nothing at the moment."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.7,
      "end_seconds": 168.25,
      "duration_seconds": 5.55,
      "text": "So, are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.59,
      "end_seconds": 174.42,
      "duration_seconds": 4.83,
      "text": "Well, yes, plasters, it gives me a red itchy rash."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.32,
      "end_seconds": 188.27,
      "duration_seconds": 2.95,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.11,
      "end_seconds": 203.56,
      "duration_seconds": 2.45,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.43,
      "end_seconds": 223.68,
      "duration_seconds": 8.25,
      "text": "Okay: pressure 120 over 78, pulse is 80 beats a minute, oxygen saturation is 97 percent, respiratory rate 18."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.46,
      "end_seconds": 226.69,
      "duration_seconds": 2.23,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.59,
      "end_seconds": 231.48,
      "duration_seconds": 3.89,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.89,
      "end_seconds": 236.1,
      "duration_seconds": 2.21,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.77,
      "end_seconds": 239.01,
      "duration_seconds": 1.24,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.76,
      "end_seconds": 251.57,
      "duration_seconds": 4.81,
      "text": "Your muscle strength is normal and there is no bone tenderness."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.78,
      "end_seconds": 265.08,
      "duration_seconds": 10.3,
      "text": "You can relax now. From what you've told me and what I found, this looks most like low vitamin D without complications."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.63,
      "end_seconds": 294.82,
      "duration_seconds": 13.19,
      "text": "The treatment will be colecalciferol, 1000 units, once a day, three months. You take it by mouth. That should help with low vitamin D. I'd like to see you again in three months."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.16,
      "end_seconds": 298.39,
      "duration_seconds": 2.23,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.84,
      "end_seconds": 305.47,
      "duration_seconds": 5.63,
      "text": "Let me check I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.64,
      "end_seconds": 321.21,
      "duration_seconds": 10.57,
      "text": "So, I take the colecalciferol, 1000 units, once a day and come back in three months. Is that right?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.72,
      "end_seconds": 331.53,
      "duration_seconds": 5.81,
      "text": "Yes, exactly right. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.17,
      "end_seconds": 335.98,
      "duration_seconds": 3.81,
      "text": "Right, great, thank you for your help."
    }
  ]
