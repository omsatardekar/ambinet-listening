{
  "schema_version": "1.0",
  "encounter_id": "01903",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.08,
      "end_seconds": 5.1,
      "duration_seconds": 4.02,
      "text": "Ah, hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.6,
      "end_seconds": 11.38,
      "duration_seconds": 4.78,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.89,
      "end_seconds": 21.08,
      "duration_seconds": 8.19,
      "text": "It's a seizure last week, mostly. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.91,
      "end_seconds": 24.8,
      "duration_seconds": 2.89,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.74,
      "end_seconds": 40.86,
      "duration_seconds": 15.12,
      "text": "For two weeks, I'd say. A neighbour of mine said I should see someone about it. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.93,
      "end_seconds": 48.35,
      "duration_seconds": 3.42,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.47,
      "end_seconds": 57.03,
      "duration_seconds": 7.56,
      "text": "Mostly mild. I was feeling groggy afterwards at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.27,
      "end_seconds": 63.49,
      "duration_seconds": 5.22,
      "text": "Have you had any loss of bladder control, head injury or fever?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.24,
      "end_seconds": 70.59,
      "duration_seconds": 5.35,
      "text": "No, no loss of bladder control, head injury or fever."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.53,
      "end_seconds": 72.98,
      "duration_seconds": 1.45,
      "text": "Any second seizure?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.41,
      "end_seconds": 78.07,
      "duration_seconds": 3.66,
      "text": "Mm, no, none, no second seizure."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.58,
      "end_seconds": 81.06,
      "duration_seconds": 2.48,
      "text": "Right, is your chest okay generally?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.64,
      "end_seconds": 83.4,
      "duration_seconds": 1.76,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.76,
      "end_seconds": 89.44,
      "duration_seconds": 2.68,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.1,
      "end_seconds": 93.6,
      "duration_seconds": 3.5,
      "text": "Right, nothing on the skin, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.69,
      "end_seconds": 98.02,
      "duration_seconds": 2.33,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.12,
      "end_seconds": 103.86,
      "duration_seconds": 3.74,
      "text": "Well, no, not that I know of."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.62,
      "end_seconds": 108.13,
      "duration_seconds": 3.51,
      "text": "Right, has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.04,
      "end_seconds": 112.71,
      "duration_seconds": 3.67,
      "text": "I have epilepsy, for about a year."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.28,
      "end_seconds": 117.85,
      "duration_seconds": 4.57,
      "text": "Okay, I can see epilepsy in your file as well."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.84,
      "end_seconds": 137.32,
      "duration_seconds": 4.48,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.77,
      "end_seconds": 145.68,
      "duration_seconds": 3.91,
      "text": "Uh, uh, my son has asthma."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.46,
      "end_seconds": 154.73,
      "duration_seconds": 1.27,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.53,
      "end_seconds": 156.78,
      "duration_seconds": 1.25,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.65,
      "end_seconds": 161.89,
      "duration_seconds": 3.24,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.01,
      "end_seconds": 166.29,
      "duration_seconds": 3.28,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.24,
      "end_seconds": 172.47,
      "duration_seconds": 2.23,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.21,
      "end_seconds": 179.63,
      "duration_seconds": 6.42,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.92,
      "end_seconds": 184.5,
      "duration_seconds": 3.58,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.74,
      "end_seconds": 193.78,
      "duration_seconds": 8.04,
      "text": "Actually, I take something called carb... carbamazepine, 200 milligrams, maybe, twice a day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.31,
      "end_seconds": 199.8,
      "duration_seconds": 5.49,
      "text": "Alright, did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.25,
      "end_seconds": 204.54,
      "duration_seconds": 3.29,
      "text": "No, uh, it's at home."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.68,
      "end_seconds": 222.51,
      "duration_seconds": 2.83,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.0,
      "end_seconds": 237.67,
      "duration_seconds": 2.67,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.44,
      "end_seconds": 267.8,
      "duration_seconds": 11.36,
      "text": "Okay: pulse is 81 beats a minute, oxygen saturation is 97 percent, respiratory rate 15, temperature is 36.6 degrees, BP is 118 over 70."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.38,
      "end_seconds": 274.23,
      "duration_seconds": 1.85,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.04,
      "end_seconds": 279.09,
      "duration_seconds": 4.05,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.45,
      "end_seconds": 283.91,
      "duration_seconds": 3.46,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.52,
      "end_seconds": 286.56,
      "duration_seconds": 1.04,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.76,
      "end_seconds": 288.93,
      "duration_seconds": 1.17,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.04,
      "end_seconds": 299.79,
      "duration_seconds": 3.75,
      "text": "You are alert and your neurological examination is normal."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.94,
      "end_seconds": 327.13,
      "duration_seconds": 22.19,
      "text": "You can relax now. Taking everything into account, I'd lean towards a breakthrough seizure after missed medication and poor sleep. I'd like to arrange blood tests for seizure. I'm going to order an anticonvulsant level, for breakthrough seizure. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.4,
      "end_seconds": 331.13,
      "duration_seconds": 2.73,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.5,
      "end_seconds": 349.72,
      "duration_seconds": 17.22,
      "text": "Take your medicine at the same time every day and do not drive until we say so. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.35,
      "end_seconds": 353.27,
      "duration_seconds": 2.92,
      "text": "I know what to watch for."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.02,
      "end_seconds": 358.7,
      "duration_seconds": 3.68,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 360.03,
      "end_seconds": 363.55,
      "duration_seconds": 3.52,
      "text": "Okay, so alright, thanks, take care."
    }
  ]
}