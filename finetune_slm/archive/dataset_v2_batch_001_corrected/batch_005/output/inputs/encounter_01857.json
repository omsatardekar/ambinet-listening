{
  "schema_version": "1.0",
  "encounter_id": "01857",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.9,
      "end_seconds": 2.38,
      "duration_seconds": 1.48,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.57,
      "end_seconds": 9.6,
      "duration_seconds": 4.03,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 10.42,
      "end_seconds": 15.89,
      "duration_seconds": 5.47,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.55,
      "end_seconds": 20.09,
      "duration_seconds": 3.54,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 22.11,
      "end_seconds": 27.57,
      "duration_seconds": 5.46,
      "text": "Doctor, it's a swollen tummy. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.73,
      "end_seconds": 32.39,
      "duration_seconds": 3.66,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.14,
      "end_seconds": 36.76,
      "duration_seconds": 3.62,
      "text": "Uh, it's been about a week now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.06,
      "end_seconds": 41.0,
      "duration_seconds": 2.94,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.91,
      "end_seconds": 44.87,
      "duration_seconds": 2.96,
      "text": "About a seven out of ten."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.72,
      "end_seconds": 48.4,
      "duration_seconds": 2.68,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.23,
      "end_seconds": 55.44,
      "duration_seconds": 5.21,
      "text": "Colicky tummy pain goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.1,
      "end_seconds": 59.89,
      "duration_seconds": 2.79,
      "text": "Has there been vomiting green fluid too?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.86,
      "end_seconds": 70.16,
      "duration_seconds": 8.3,
      "text": "Yes, about the same, one week. About vomiting green fluid, I'd call it moderate."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.4,
      "end_seconds": 81.01,
      "duration_seconds": 2.61,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.92,
      "end_seconds": 94.14,
      "duration_seconds": 12.22,
      "text": "I'm vegetarian and have been for years. My husband and I live above the shop. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.83,
      "end_seconds": 99.73,
      "duration_seconds": 3.9,
      "text": "Alright, are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.97,
      "end_seconds": 107.47,
      "duration_seconds": 2.5,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.67,
      "end_seconds": 111.1,
      "duration_seconds": 2.43,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.61,
      "end_seconds": 126.92,
      "duration_seconds": 10.31,
      "text": "I have an irregular heartbeat, for about a year. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.46,
      "end_seconds": 129.37,
      "duration_seconds": 0.91,
      "text": "Anything else?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.01,
      "end_seconds": 131.91,
      "duration_seconds": 1.9,
      "text": "I have heart failure."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.43,
      "end_seconds": 134.84,
      "duration_seconds": 1.41,
      "text": "Is that everything?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.91,
      "end_seconds": 138.81,
      "duration_seconds": 1.9,
      "text": "I have heart disease."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.35,
      "end_seconds": 143.08,
      "duration_seconds": 3.73,
      "text": "Understood. Okay, have you ever had an operation?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.36,
      "end_seconds": 150.57,
      "duration_seconds": 6.21,
      "text": "I had two stents put in my heart three years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.37,
      "end_seconds": 154.99,
      "duration_seconds": 3.62,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 156.82,
      "end_seconds": 160.97,
      "duration_seconds": 4.15,
      "text": "It's warfarin, 3 milligrams, in the evening, doctor."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.35,
      "end_seconds": 162.19,
      "duration_seconds": 0.84,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 168.37,
      "end_seconds": 173.78,
      "duration_seconds": 5.41,
      "text": "Well, it's carvedilol, 6.25 milligrams, twice a day, doctor."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.08,
      "end_seconds": 175.4,
      "duration_seconds": 1.32,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 176.05,
      "end_seconds": 184.4,
      "duration_seconds": 8.35,
      "text": "He is on metoprolol, 50 milligrams, twice a day for my heart, I give it to him."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.01,
      "end_seconds": 205.23,
      "duration_seconds": 6.22,
      "text": "Before we go further, any allergies? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.6,
      "end_seconds": 208.85,
      "duration_seconds": 2.25,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.76,
      "end_seconds": 213.01,
      "duration_seconds": 3.25,
      "text": "Any fever, blood in the stool or hernia?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.0,
      "end_seconds": 215.99,
      "duration_seconds": 1.99,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.25,
      "end_seconds": 220.54,
      "duration_seconds": 3.29,
      "text": "Right, any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.15,
      "end_seconds": 224.22,
      "duration_seconds": 2.07,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.05,
      "end_seconds": 228.72,
      "duration_seconds": 3.67,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.41,
      "end_seconds": 233.94,
      "duration_seconds": 4.53,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.74,
      "end_seconds": 239.49,
      "duration_seconds": 4.75,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.03,
      "end_seconds": 254.17,
      "duration_seconds": 2.14,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.13,
      "end_seconds": 278.3,
      "duration_seconds": 9.17,
      "text": "Okay: respiratory rate 20, temperature 37.1. And pulse is 124 beats a minute, blood pressure 121 over 73."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.78,
      "end_seconds": 281.26,
      "duration_seconds": 1.48,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.95,
      "end_seconds": 285.73,
      "duration_seconds": 2.78,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.86,
      "end_seconds": 291.63,
      "duration_seconds": 4.77,
      "text": "Alright, I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.57,
      "end_seconds": 295.59,
      "duration_seconds": 2.02,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.22,
      "end_seconds": 311.82,
      "duration_seconds": 4.6,
      "text": "Your tummy is swollen and tympanic, with high-pitched tinkling bowel sounds."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.56,
      "end_seconds": 331.54,
      "duration_seconds": 13.98,
      "text": "Please sit back down. Okay, thinking it through, this looks most like a bowel obstruction needing urgent surgical care. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.64,
      "end_seconds": 343.12,
      "duration_seconds": 4.48,
      "text": "I'll request an abdominal X-ray, it'll help with possible obstruction."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.06,
      "end_seconds": 345.3,
      "duration_seconds": 1.24,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.19,
      "end_seconds": 374.95,
      "duration_seconds": 28.76,
      "text": "I think urgent blood tests makes sense here, for vomiting. Nothing to eat or drink, and you are going to hospital now. A short walk every day, even twenty minutes, will help more than you'd think. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. Please come and see me straight away."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 376.94,
      "end_seconds": 377.64,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.51,
      "end_seconds": 382.74,
      "duration_seconds": 4.23,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 384.64,
      "end_seconds": 388.32,
      "duration_seconds": 3.68,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 390.07,
      "end_seconds": 391.41,
      "duration_seconds": 1.34,
      "text": "Take care now."
    }
  ]
}