{
  "schema_version": "1.0",
  "encounter_id": "01889",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.11,
      "end_seconds": 3.19,
      "duration_seconds": 2.08,
      "text": "Hi, sit anywhere you like."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.97,
      "end_seconds": 7.5,
      "duration_seconds": 2.53,
      "text": "Good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 8.43,
      "end_seconds": 13.65,
      "duration_seconds": 5.22,
      "text": "Hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.02,
      "end_seconds": 22.24,
      "duration_seconds": 7.22,
      "text": "Please do. Extra information is always welcome. What would you like to start with today?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.03,
      "end_seconds": 32.59,
      "duration_seconds": 8.56,
      "text": "It's loud snoring, mostly. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.44,
      "end_seconds": 36.8,
      "duration_seconds": 3.36,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.79,
      "end_seconds": 41.8,
      "duration_seconds": 3.01,
      "text": "I've had it for six months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.39,
      "end_seconds": 45.09,
      "duration_seconds": 2.7,
      "text": "Sure. Is anything making it worse?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.11,
      "end_seconds": 65.5,
      "duration_seconds": 18.39,
      "text": "Alcohol definitely sets it off. And daytime sleepiness, too. Sorry, what was I saying, as for stopping breathing at night, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.52,
      "end_seconds": 70.67,
      "duration_seconds": 3.15,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 71.36,
      "end_seconds": 74.26,
      "duration_seconds": 2.9,
      "text": "About a seven out of ten."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.65,
      "end_seconds": 79.16,
      "duration_seconds": 3.51,
      "text": "Any choking, leg swelling or chest pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.58,
      "end_seconds": 93.66,
      "duration_seconds": 13.08,
      "text": "Um, no, no choking, no leg swelling, no chest pain. I did have morning headaches at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.01,
      "end_seconds": 97.38,
      "duration_seconds": 2.37,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 99.47,
      "end_seconds": 101.14,
      "duration_seconds": 1.67,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.14,
      "end_seconds": 107.16,
      "duration_seconds": 5.02,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.12,
      "end_seconds": 113.48,
      "duration_seconds": 4.36,
      "text": "Yes, amoxicillin. I get a rash all over."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.1,
      "end_seconds": 118.38,
      "duration_seconds": 4.28,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.39,
      "end_seconds": 127.92,
      "duration_seconds": 7.53,
      "text": "Actually, it's a... um, I can't remember what it's called. It's a small white one."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.44,
      "end_seconds": 131.69,
      "duration_seconds": 3.25,
      "text": "Okay, do you remember what it's for?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 133.28,
      "end_seconds": 147.08,
      "duration_seconds": 13.8,
      "text": "For my pressure, I believe. My wife sets them out for me, I just take what I'm given. Glycomet. I take it 500 milligrams, twice a day for my sugar."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 147.66,
      "end_seconds": 153.39,
      "duration_seconds": 5.73,
      "text": "That's what's prescribed, but I'm not sure she takes it every day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.01,
      "end_seconds": 170.61,
      "duration_seconds": 15.6,
      "text": "Clopidogrel. I take it 75 milligrams, once a day for the stent. I take thyroxine, 75 micrograms, every morning. I'd been on hydrochlorothiazide, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.81,
      "end_seconds": 191.94,
      "duration_seconds": 3.13,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 193.33,
      "end_seconds": 195.97,
      "duration_seconds": 2.64,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.9,
      "end_seconds": 200.22,
      "duration_seconds": 2.32,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 202.08,
      "end_seconds": 208.34,
      "duration_seconds": 6.26,
      "text": "Yes, um, I had an operation for a hernia, last spring."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.39,
      "end_seconds": 217.0,
      "duration_seconds": 4.61,
      "text": "Right, anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 218.61,
      "end_seconds": 237.07,
      "duration_seconds": 18.46,
      "text": "High blood pressure, for two years. I've had diabetes, yes. I have heart disease, for about ten years. I have an underactive thyroid. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.57,
      "end_seconds": 240.5,
      "duration_seconds": 2.93,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 241.96,
      "end_seconds": 252.95,
      "duration_seconds": 10.99,
      "text": "I smoke roughly a pack every two days. I'll have a glass of wine with dinner. I swim twice a week."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_5",
      "role": "NURSE",
      "start_seconds": 253.95,
      "end_seconds": 266.24,
      "duration_seconds": 12.29,
      "text": "Here are the numbers, doctor. Blood pressure 164 over 100, temperature is 36.7 degrees, respiratory rate 14, heart rate 90, oxygen saturation is 97 percent."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.04,
      "end_seconds": 267.99,
      "duration_seconds": 0.95,
      "text": "Right, thanks."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.88,
      "end_seconds": 273.75,
      "duration_seconds": 3.87,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 288.37,
      "end_seconds": 289.81,
      "duration_seconds": 1.44,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.47,
      "end_seconds": 292.85,
      "duration_seconds": 1.38,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.85,
      "end_seconds": 315.12,
      "duration_seconds": 4.27,
      "text": "You have a thick neck and a crowded throat."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.85,
      "end_seconds": 339.08,
      "duration_seconds": 19.23,
      "text": "You can relax now. Taking everything into account, I think we're dealing with probable obstructive sleep apnoea at this stage. The reason I say that is that your story and my examination fit together. Another possibility is an underactive thyroid."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 340.32,
      "end_seconds": 343.51,
      "duration_seconds": 3.19,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 344.07,
      "end_seconds": 363.24,
      "duration_seconds": 19.17,
      "text": "Nothing I've seen today points to an emergency. It looks like probable obstructive sleep apnoea, but I'd like to confirm. I'll request a thyroid test, it'll help with tiredness. I'll request a home sleep study, it'll help with snoring and apnoeas."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 363.81,
      "end_seconds": 366.7,
      "duration_seconds": 2.89,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 367.43,
      "end_seconds": 386.5,
      "duration_seconds": 19.07,
      "text": "Avoid alcohol in the evening, lose some weight if you can, and do not drive when drowsy. The sleep clinic would be the right next step, I'll refer you. One warning sign to remember: the symptoms get worse. In that case don't wait."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 387.17,
      "end_seconds": 389.9,
      "duration_seconds": 2.73,
      "text": "Yes, um, will do."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 395.79,
      "end_seconds": 398.66,
      "duration_seconds": 2.87,
      "text": "Come back after the sleep study."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 399.62,
      "end_seconds": 400.32,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 401.7,
      "end_seconds": 405.42,
      "duration_seconds": 3.72,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 406.05,
      "end_seconds": 409.34,
      "duration_seconds": 3.29,
      "text": "I think I understand everything. Thanks."
    }
  ]
}