{
  "schema_version": "1.0",
  "encounter_id": "01659",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.59,
      "end_seconds": 5.93,
      "duration_seconds": 5.34,
      "text": "Doctor, I've brought them through. The observations are done, whenever you need them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.33,
      "end_seconds": 11.4,
      "duration_seconds": 4.07,
      "text": "Perfect, thanks. Hello there, so so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.17,
      "end_seconds": 16.13,
      "duration_seconds": 3.96,
      "text": "yeah, thank you for fitting us in, doctor"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.44,
      "end_seconds": 20.44,
      "duration_seconds": 3.0,
      "text": "please do extra information is always welcome"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 22.24,
      "end_seconds": 29.31,
      "duration_seconds": 7.07,
      "text": "doctor, it's a painful blistering rash on one side. That's what we're worried about"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.37,
      "end_seconds": 33.46,
      "duration_seconds": 2.09,
      "text": "did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 34.97,
      "end_seconds": 50.83,
      "duration_seconds": 15.86,
      "text": "It's been going on for about a month. I just want to get back to normal, really. I've had sensitivity to clothes touching too, for about a week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.55,
      "end_seconds": 64.07,
      "duration_seconds": 3.52,
      "text": "did you get rash across the midline or weakness?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 65.65,
      "end_seconds": 79.07,
      "duration_seconds": 13.42,
      "text": "No, no rash across the midline, no weakness. I did have burning pain before the rash at one point, but that that went away on its own."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.29,
      "end_seconds": 81.68,
      "duration_seconds": 1.39,
      "text": "How about fever?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 82.93,
      "end_seconds": 84.47,
      "duration_seconds": 1.54,
      "text": "Definitely no fever."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 89.41,
      "end_seconds": 94.15,
      "duration_seconds": 4.74,
      "text": "Actually, doctor, I did notice fever. She doesn't always say."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 96.03,
      "end_seconds": 101.64,
      "duration_seconds": 5.61,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.41,
      "end_seconds": 110.77,
      "duration_seconds": 8.36,
      "text": "Alright, I'll note both what you've said and what you've noticed. Right, have you had any eye involvement?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 112.03,
      "end_seconds": 114.54,
      "duration_seconds": 2.51,
      "text": "no, none, no eye involvement"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.68,
      "end_seconds": 118.7,
      "duration_seconds": 3.02,
      "text": "Right, is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 120.11,
      "end_seconds": 121.85,
      "duration_seconds": 1.74,
      "text": "nothing there, no"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.84,
      "end_seconds": 124.94,
      "duration_seconds": 2.1,
      "text": "is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 125.98,
      "end_seconds": 127.64,
      "duration_seconds": 1.66,
      "text": "nothing else aches"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.82,
      "end_seconds": 135.74,
      "duration_seconds": 2.92,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 136.39,
      "end_seconds": 142.64,
      "duration_seconds": 6.25,
      "text": "Mm, just a wisdom tooth extraction under sedation, five years ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.72,
      "end_seconds": 145.27,
      "duration_seconds": 1.55,
      "text": "So, any smoking?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 150.87,
      "end_seconds": 154.24,
      "duration_seconds": 3.37,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.08,
      "end_seconds": 158.56,
      "duration_seconds": 2.48,
      "text": "do you work outside the home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 160.17,
      "end_seconds": 164.63,
      "duration_seconds": 4.46,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.72,
      "end_seconds": 167.73,
      "duration_seconds": 2.01,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 168.36,
      "end_seconds": 172.9,
      "duration_seconds": 4.54,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.12,
      "end_seconds": 189.93,
      "duration_seconds": 3.81,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 191.76,
      "end_seconds": 203.07,
      "duration_seconds": 11.31,
      "text": "sorry, what was I saying, it's sitagliptin, 100 milligrams, once a day. Hydrocortisone cream, when needed it's paracetamol, 1 gram, when needed"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.47,
      "end_seconds": 212.85,
      "duration_seconds": 8.38,
      "text": "Any health conditions I should have on record? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 214.35,
      "end_seconds": 216.48,
      "duration_seconds": 2.13,
      "text": "Diabetes, for two years."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.88,
      "end_seconds": 219.33,
      "duration_seconds": 1.45,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 221.36,
      "end_seconds": 226.61,
      "duration_seconds": 5.25,
      "text": "I've had eczema for about ten years now. I've got migraines."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.71,
      "end_seconds": 239.58,
      "duration_seconds": 10.87,
      "text": "Okay, I can see diabetes and eczema in your file as well. Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 240.58,
      "end_seconds": 242.38,
      "duration_seconds": 1.8,
      "text": "my cousin has psoriasis"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.73,
      "end_seconds": 246.41,
      "duration_seconds": 2.68,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 247.58,
      "end_seconds": 257.09,
      "duration_seconds": 9.51,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 258.42,
      "end_seconds": 270.03,
      "duration_seconds": 11.61,
      "text": "Doctor, I've got the readings for you. Blood pressure 126 over 76, pulse is 75 beats a minute. Saturation 99 percent, height 186 centimetres, weight 90 kilos, temperature 36.9."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.65,
      "end_seconds": 272.35,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.08,
      "end_seconds": 278.84,
      "duration_seconds": 3.76,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 280.62,
      "end_seconds": 281.67,
      "duration_seconds": 1.05,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.46,
      "end_seconds": 286.4,
      "duration_seconds": 2.94,
      "text": "take a deep breath for me"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.64,
      "end_seconds": 305.31,
      "duration_seconds": 9.67,
      "text": "There are grouped blisters on a red base along one band on the right side and none cross the midline."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.81,
      "end_seconds": 342.29,
      "duration_seconds": 33.48,
      "text": "Good, you can sit up again. Let me tell you where I've got to. I can't pin this down yet. We're looking at shingles or contact dermatitis. I'm going to put you on aciclovir, 800 milligrams, five times a day, seven days. You take it by mouth. That's for shingles. Keep the rash covered and stay away from pregnant women and newborn babies until it has crusted."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.48,
      "end_seconds": 350.59,
      "duration_seconds": 7.11,
      "text": "If the rash spreads to to your face or eye, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 351.56,
      "end_seconds": 354.35,
      "duration_seconds": 2.79,
      "text": "alright, uh, I follow"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.33,
      "end_seconds": 358.07,
      "duration_seconds": 2.74,
      "text": "I'll want another look in one week"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 359.14,
      "end_seconds": 362.66,
      "duration_seconds": 3.52,
      "text": "I can put that appointment in for you now."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.35,
      "end_seconds": 369.13,
      "duration_seconds": 4.78,
      "text": "is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 370.27,
      "end_seconds": 373.69,
      "duration_seconds": 3.42,
      "text": "Great, thank you for your help."
    }
  ]
}