{
  "schema_version": "1.0",
  "encounter_id": "01732",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.25,
      "end_seconds": 4.88,
      "duration_seconds": 3.63,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.83,
      "end_seconds": 10.81,
      "duration_seconds": 4.98,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.89,
      "end_seconds": 16.5,
      "duration_seconds": 4.61,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.53,
      "end_seconds": 20.35,
      "duration_seconds": 2.82,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.97,
      "end_seconds": 31.98,
      "duration_seconds": 7.01,
      "text": "It's a pulled muscle in my thigh. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.94,
      "end_seconds": 35.82,
      "duration_seconds": 1.88,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.67,
      "end_seconds": 40.57,
      "duration_seconds": 2.9,
      "text": "I've had it for five days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.56,
      "end_seconds": 44.27,
      "duration_seconds": 1.71,
      "text": "Anything that improves it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.24,
      "end_seconds": 47.14,
      "duration_seconds": 1.9,
      "text": "Ice helps a bit."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.68,
      "end_seconds": 54.51,
      "duration_seconds": 6.83,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 54.61,
      "end_seconds": 61.18,
      "duration_seconds": 6.57,
      "text": "Um, tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.59,
      "end_seconds": 68.29,
      "duration_seconds": 5.7,
      "text": "Erm, I was getting to that! Oh, and a bit of bruising."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "UNKNOWN",
      "start_seconds": 69.91,
      "end_seconds": 74.09,
      "duration_seconds": 4.18,
      "text": "Yes, that's right, that's how it was."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.3,
      "end_seconds": 77.98,
      "duration_seconds": 2.68,
      "text": "Did you get numbness or swelling?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.8,
      "end_seconds": 90.52,
      "duration_seconds": 10.72,
      "text": "No, no numbness, no swelling. I did have tightness at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.06,
      "end_seconds": 96.19,
      "duration_seconds": 4.13,
      "text": "Did you get pop at the time or fall?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.11,
      "end_seconds": 101.12,
      "duration_seconds": 4.01,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.92,
      "end_seconds": 105.12,
      "duration_seconds": 2.2,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.02,
      "end_seconds": 109.27,
      "duration_seconds": 3.25,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.88,
      "end_seconds": 127.61,
      "duration_seconds": 1.73,
      "text": "Alright, any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.96,
      "end_seconds": 131.91,
      "duration_seconds": 2.95,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.67,
      "end_seconds": 139.08,
      "duration_seconds": 5.41,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.8,
      "end_seconds": 143.41,
      "duration_seconds": 2.61,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.63,
      "end_seconds": 146.64,
      "duration_seconds": 2.01,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.51,
      "end_seconds": 154.77,
      "duration_seconds": 3.26,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.24,
      "end_seconds": 158.98,
      "duration_seconds": 2.74,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.78,
      "end_seconds": 164.38,
      "duration_seconds": 3.6,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.17,
      "end_seconds": 171.16,
      "duration_seconds": 4.99,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 172.57,
      "end_seconds": 182.57,
      "duration_seconds": 10.0,
      "text": "She takes hydrocortisone cream, when needed. She is on sertraline, once a day for my mood, I give it to her."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.17,
      "end_seconds": 186.24,
      "duration_seconds": 2.07,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 187.48,
      "end_seconds": 199.26,
      "duration_seconds": 11.78,
      "text": "It's 50 milligrams. She is on pantoprazole, 40 milligrams, before breakfast, I give it to her. She takes ibuprofen gel, three times a day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.78,
      "end_seconds": 202.96,
      "duration_seconds": 3.18,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.82,
      "end_seconds": 205.78,
      "duration_seconds": 1.96,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.55,
      "end_seconds": 223.04,
      "duration_seconds": 4.49,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.74,
      "end_seconds": 227.68,
      "duration_seconds": 3.94,
      "text": "Yeah, I have eczema, for about a year."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.09,
      "end_seconds": 230.04,
      "duration_seconds": 0.95,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.85,
      "end_seconds": 235.98,
      "duration_seconds": 4.13,
      "text": "Hmm, I have depression, for two years."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.62,
      "end_seconds": 237.68,
      "duration_seconds": 1.06,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.43,
      "end_seconds": 243.55,
      "duration_seconds": 4.12,
      "text": "I have acid reflux, for about ten years."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.43,
      "end_seconds": 245.77,
      "duration_seconds": 1.34,
      "text": "And besides that?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.34,
      "end_seconds": 254.16,
      "duration_seconds": 7.82,
      "text": "Okay, I can see acid reflux in your file as well. Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.21,
      "end_seconds": 267.51,
      "duration_seconds": 2.3,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.17,
      "end_seconds": 297.76,
      "duration_seconds": 10.59,
      "text": "Okay: pulse is 83 beats a minute, temperature is 36.7 degrees, oxygen saturation is 97 percent. And BP is 120 over 70."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.94,
      "end_seconds": 300.49,
      "duration_seconds": 1.55,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.08,
      "end_seconds": 305.8,
      "duration_seconds": 3.72,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.0,
      "end_seconds": 309.34,
      "duration_seconds": 2.34,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.77,
      "end_seconds": 311.69,
      "duration_seconds": 0.92,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.37,
      "end_seconds": 315.38,
      "duration_seconds": 2.01,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.64,
      "end_seconds": 332.87,
      "duration_seconds": 7.23,
      "text": "There is mild tenderness in the back of the thigh and you can still straighten the knee fully."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.71,
      "end_seconds": 347.0,
      "duration_seconds": 8.29,
      "text": "All finished, thank you. From what you've told me and what I found, this is probably a mild hamstring strain."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.98,
      "end_seconds": 351.19,
      "duration_seconds": 3.21,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.2,
      "end_seconds": 370.21,
      "duration_seconds": 17.01,
      "text": "Nothing I've seen today points to an emergency. It looks like a mild hamstring strain. Let me just check I've got this right. You've had a pulled muscle in your thigh for five days, and no fall or pop at the time."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 371.22,
      "end_seconds": 372.86,
      "duration_seconds": 1.64,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 374.95,
      "end_seconds": 393.24,
      "duration_seconds": 18.29,
      "text": "Rest for a few days, ice it, and then ease back in with gentle stretching. Come back or go to emergency straight away if the symptoms get worse. Let's plan a check if not better in two weeks."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 394.92,
      "end_seconds": 399.31,
      "duration_seconds": 4.39,
      "text": "I'll book your follow-up at the front desk on your way out."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 401.18,
      "end_seconds": 405.45,
      "duration_seconds": 4.27,
      "text": "Alright, that's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 406.46,
      "end_seconds": 408.41,
      "duration_seconds": 1.95,
      "text": "Thank you, that's helpful."
    }
  ]
}