{
  "schema_version": "1.0",
  "encounter_id": "01725",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.82,
      "end_seconds": 4.09,
      "duration_seconds": 3.27,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.38,
      "end_seconds": 10.12,
      "duration_seconds": 4.74,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.1,
      "end_seconds": 19.57,
      "duration_seconds": 8.47,
      "text": "Okay, so it's chest pain after a crash. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.19,
      "end_seconds": 23.74,
      "duration_seconds": 3.55,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.46,
      "end_seconds": 28.9,
      "duration_seconds": 4.44,
      "text": "Let me think, I've had it since this morning."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.99,
      "end_seconds": 34.87,
      "duration_seconds": 4.88,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.42,
      "end_seconds": 38.68,
      "duration_seconds": 2.26,
      "text": "It just comes and goes."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.6,
      "end_seconds": 41.77,
      "duration_seconds": 2.17,
      "text": "Does anything set it off?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.77,
      "end_seconds": 44.66,
      "duration_seconds": 1.89,
      "text": "It's worse with breathing."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.63,
      "end_seconds": 47.74,
      "duration_seconds": 2.11,
      "text": "Have you been feeling faint?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.43,
      "end_seconds": 52.36,
      "duration_seconds": 3.93,
      "text": "Yes, since Friday. And difficulty breathing, too."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.66,
      "end_seconds": 67.86,
      "duration_seconds": 6.2,
      "text": "Let me check a few things. Any neck pain, loss of consciousness or head injury?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.76,
      "end_seconds": 73.07,
      "duration_seconds": 3.31,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.09,
      "end_seconds": 78.11,
      "duration_seconds": 4.02,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.55,
      "end_seconds": 83.71,
      "duration_seconds": 2.16,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.49,
      "end_seconds": 89.41,
      "duration_seconds": 3.92,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.92,
      "end_seconds": 93.6,
      "duration_seconds": 2.68,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.61,
      "end_seconds": 99.94,
      "duration_seconds": 2.33,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.19,
      "end_seconds": 107.93,
      "duration_seconds": 6.74,
      "text": "High cholesterol, for five years. I've had epilepsy for five years now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.56,
      "end_seconds": 111.14,
      "duration_seconds": 1.58,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.6,
      "end_seconds": 118.78,
      "duration_seconds": 5.18,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.58,
      "end_seconds": 125.91,
      "duration_seconds": 5.33,
      "text": "Atorvastatin. I take it 20 milligrams, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.42,
      "end_seconds": 127.47,
      "duration_seconds": 1.05,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.92,
      "end_seconds": 134.6,
      "duration_seconds": 5.68,
      "text": "I'm on lamotrigine, 100 milligrams, twice a day for the fits."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.51,
      "end_seconds": 139.94,
      "duration_seconds": 3.43,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.85,
      "end_seconds": 144.95,
      "duration_seconds": 3.1,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.67,
      "end_seconds": 148.62,
      "duration_seconds": 1.95,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.43,
      "end_seconds": 152.25,
      "duration_seconds": 2.82,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.73,
      "end_seconds": 156.19,
      "duration_seconds": 2.46,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.5,
      "end_seconds": 158.65,
      "duration_seconds": 1.15,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.51,
      "end_seconds": 164.29,
      "duration_seconds": 3.78,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.25,
      "end_seconds": 170.15,
      "duration_seconds": 3.9,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.53,
      "end_seconds": 185.67,
      "duration_seconds": 3.14,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.93,
      "end_seconds": 200.38,
      "duration_seconds": 2.45,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.99,
      "end_seconds": 225.4,
      "duration_seconds": 8.41,
      "text": "Okay: saturation 98 percent, pressure 98 over 64, pulse is 94 beats a minute. And temp 36.7 degrees."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.2,
      "end_seconds": 231.48,
      "duration_seconds": 3.28,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.3,
      "end_seconds": 237.96,
      "duration_seconds": 1.66,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.61,
      "end_seconds": 241.71,
      "duration_seconds": 2.1,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.82,
      "end_seconds": 262.43,
      "duration_seconds": 7.61,
      "text": "There is bruising across the chest, the left side moves less, and the belly is tender and rigid."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.01,
      "end_seconds": 265.7,
      "duration_seconds": 1.69,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.33,
      "end_seconds": 271.82,
      "duration_seconds": 2.49,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.87,
      "end_seconds": 298.95,
      "duration_seconds": 18.08,
      "text": "So where does that leave us? My working impression is serious chest and abdominal injury. Internal bleeding is also on my list. We should do an urgent blood cross-match for trauma. Do not move, I am activating the trauma team now."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.15,
      "end_seconds": 308.67,
      "duration_seconds": 9.52,
      "text": "Right, right. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.21,
      "end_seconds": 311.18,
      "duration_seconds": 0.97,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.67,
      "end_seconds": 319.96,
      "duration_seconds": 7.29,
      "text": "I'd like to see you again straight away. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.59,
      "end_seconds": 325.74,
      "duration_seconds": 4.15,
      "text": "Uh, no, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.63,
      "end_seconds": 327.85,
      "duration_seconds": 1.22,
      "text": "See you soon."
    }
  ]
}