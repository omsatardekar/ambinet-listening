{
  "schema_version": "1.0",
  "encounter_id": "01875",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.71,
      "end_seconds": 4.74,
      "duration_seconds": 4.03,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.46,
      "end_seconds": 10.95,
      "duration_seconds": 4.49,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.38,
      "end_seconds": 17.36,
      "duration_seconds": 4.98,
      "text": "So, uh, I've been feeling nervous about exertion, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.47,
      "end_seconds": 23.37,
      "duration_seconds": 4.9,
      "text": "Right, can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.15,
      "end_seconds": 35.93,
      "duration_seconds": 2.78,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.31,
      "end_seconds": 60.8,
      "duration_seconds": 9.49,
      "text": "Okay: pressure 111 over 68, pulse 86, temperature is 36.8 degrees. And SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.89,
      "end_seconds": 75.44,
      "duration_seconds": 1.55,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.25,
      "end_seconds": 84.16,
      "duration_seconds": 7.91,
      "text": "Probably three weeks. Yeah. I've also had tiredness. Oh, and an ache in my chest wall."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.02,
      "end_seconds": 91.09,
      "duration_seconds": 5.07,
      "text": "Have you been feeling nervous about exertion at any time before this?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.18,
      "end_seconds": 99.04,
      "duration_seconds": 6.86,
      "text": "Yes, something like this happened last year, and it went away on its own."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.07,
      "end_seconds": 105.54,
      "duration_seconds": 5.47,
      "text": "Okay, any palpitations, fainting, leg swelling or chest pain on exertion at all?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.64,
      "end_seconds": 114.44,
      "duration_seconds": 6.8,
      "text": "No palpitations, fainting, leg swelling or chest pain on exertion, none of it."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.61,
      "end_seconds": 119.5,
      "duration_seconds": 3.89,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.36,
      "end_seconds": 122.95,
      "duration_seconds": 2.59,
      "text": "Erm, no weakness or anything."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.61,
      "end_seconds": 125.74,
      "duration_seconds": 2.13,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.47,
      "end_seconds": 127.92,
      "duration_seconds": 1.45,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.83,
      "end_seconds": 132.46,
      "duration_seconds": 3.63,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.28,
      "end_seconds": 137.69,
      "duration_seconds": 3.41,
      "text": "Yes, amoxicillin, it gives me hives."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.72,
      "end_seconds": 141.5,
      "duration_seconds": 1.78,
      "text": "So, any previous surgeries?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.8,
      "end_seconds": 144.95,
      "duration_seconds": 2.15,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.83,
      "end_seconds": 150.16,
      "duration_seconds": 3.33,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.86,
      "end_seconds": 165.11,
      "duration_seconds": 14.25,
      "text": "It's ramipril, 5 milligrams, every morning for my blood pressure. My family kept telling me to get it checked. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.11,
      "end_seconds": 170.08,
      "duration_seconds": 3.97,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.39,
      "end_seconds": 175.87,
      "duration_seconds": 4.48,
      "text": "Yes, heart disease. I've had high blood pressure, yes."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.63,
      "end_seconds": 183.51,
      "duration_seconds": 5.88,
      "text": "Okay, I can see high blood pressure in your file as well."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.59,
      "end_seconds": 197.51,
      "duration_seconds": 0.92,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.24,
      "end_seconds": 202.36,
      "duration_seconds": 4.12,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.3,
      "end_seconds": 206.66,
      "duration_seconds": 3.36,
      "text": "Right, anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.16,
      "end_seconds": 211.47,
      "duration_seconds": 3.31,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.03,
      "end_seconds": 214.34,
      "duration_seconds": 1.31,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.46,
      "end_seconds": 220.05,
      "duration_seconds": 4.59,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.78,
      "end_seconds": 225.76,
      "duration_seconds": 1.98,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.28,
      "end_seconds": 229.55,
      "duration_seconds": 2.27,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.92,
      "end_seconds": 232.94,
      "duration_seconds": 2.02,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.21,
      "end_seconds": 236.45,
      "duration_seconds": 2.24,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.91,
      "end_seconds": 250.27,
      "duration_seconds": 5.36,
      "text": "Your heart rate and rhythm are regular and the breastbone wound has healed."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.7,
      "end_seconds": 256.71,
      "duration_seconds": 2.01,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.51,
      "end_seconds": 286.04,
      "duration_seconds": 11.53,
      "text": "Okay, so my impression is this: It points towards recovering well after a heart attack. It could also be anxiety, so we'll keep that open."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.28,
      "end_seconds": 290.33,
      "duration_seconds": 3.05,
      "text": "Hmm, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.93,
      "end_seconds": 304.41,
      "duration_seconds": 13.48,
      "text": "It's reasonable to be concerned, but right now recovering well after a heart attack is my leading thought, not anything worse. I want a cholesterol test done, that's for secondary prevention."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 305.06,
      "end_seconds": 309.96,
      "duration_seconds": 4.9,
      "text": "We have a slot Tuesday at 2 pm, if that works."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.02,
      "end_seconds": 319.72,
      "duration_seconds": 8.7,
      "text": "We should do an ECG for post heart attack review. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.81,
      "end_seconds": 321.85,
      "duration_seconds": 1.04,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.64,
      "end_seconds": 327.18,
      "duration_seconds": 3.54,
      "text": "Start the rehabilitation classes and build up walking gradually."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.54,
      "end_seconds": 332.41,
      "duration_seconds": 4.87,
      "text": "Understood. I think the cardiac rehabilitation team should see you too."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.41,
      "end_seconds": 336.09,
      "duration_seconds": 2.68,
      "text": "Alright, um, thank you."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.37,
      "end_seconds": 352.47,
      "duration_seconds": 15.1,
      "text": "If the symptoms get worse, or you feel really unwell, please come to the emergency department. I'll want another look in three months. Alright, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 353.91,
      "end_seconds": 356.92,
      "duration_seconds": 3.01,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}