  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.53,
      "end_seconds": 8.66,
      "duration_seconds": 8.13,
      "text": "Hmm uh hello doctor sorry I took a a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.47,
      "end_seconds": 19.75,
      "duration_seconds": 5.28,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.27,
      "end_seconds": 24.94,
      "duration_seconds": 4.67,
      "text": "Well you know I've been having trouble falling asleep."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.71,
      "end_seconds": 27.97,
      "duration_seconds": 2.26,
      "text": "Tell me your medicines please."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.53,
      "end_seconds": 41.95,
      "duration_seconds": 12.42,
      "text": "Diclofenac i take it 50 milligrams, when needed. Febuxostat i take it 80 milligrams, once a day for the gout"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.16,
      "end_seconds": 43.09,
      "duration_seconds": 0.93,
      "text": "I follow"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.7,
      "end_seconds": 47.93,
      "duration_seconds": 3.23,
      "text": "A herbal sleep tea, at night"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.33,
      "end_seconds": 50.56,
      "duration_seconds": 1.23,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.07,
      "end_seconds": 58.91,
      "duration_seconds": 6.84,
      "text": "About a month, I think... sorry, two months, I got that wrong"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.63,
      "end_seconds": 68.5,
      "duration_seconds": 8.87,
      "text": "So, can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.75,
      "end_seconds": 79.1,
      "duration_seconds": 9.35,
      "text": "I notice it more with screens. Maybe a a four out of ten on a bad day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.37,
      "end_seconds": 82.98,
      "duration_seconds": 2.61,
      "text": "is there anything else with it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.85,
      "end_seconds": 96.82,
      "duration_seconds": 11.97,
      "text": "A busy mind at night goes along with it uh most of the time. I've also been waking tired for four weeks."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.79,
      "end_seconds": 113.48,
      "duration_seconds": 2.69,
      "text": "And chest pain, any of that?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.26,
      "end_seconds": 117.35,
      "duration_seconds": 2.09,
      "text": "no no chest pain"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.45,
      "end_seconds": 122.43,
      "duration_seconds": 3.98,
      "text": "did you get snoring, weight change or low mood?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.09,
      "end_seconds": 127.73,
      "duration_seconds": 3.64,
      "text": "No you know I'd have said so."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.96,
      "end_seconds": 132.58,
      "duration_seconds": 4.62,
      "text": "Okay, go on. Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.44,
      "end_seconds": 138.08,
      "duration_seconds": 3.64,
      "text": "nothing on the skin, um, no"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.33,
      "end_seconds": 142.27,
      "duration_seconds": 2.94,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.9,
      "end_seconds": 163.2,
      "duration_seconds": 19.3,
      "text": "I used to drink heavily but I stopped four years ago. I'm a plumber, lots of bending and kneeling. No, I share a house with my brother. I do a yoga class on Thursdays"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.11,
      "end_seconds": 173.89,
      "duration_seconds": 2.78,
      "text": "did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.56,
      "end_seconds": 179.21,
      "duration_seconds": 4.65,
      "text": "actually just an operation for a hernia last spring"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.89,
      "end_seconds": 191.8,
      "duration_seconds": 4.91,
      "text": "Right, what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.65,
      "end_seconds": 198.42,
      "duration_seconds": 5.77,
      "text": "Well, I have arthritis in my knees, for about a year."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.36,
      "end_seconds": 203.18,
      "duration_seconds": 0.82,
      "text": "I follow"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.62,
      "end_seconds": 206.85,
      "duration_seconds": 2.23,
      "text": "I've had gout yes"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.62,
      "end_seconds": 213.58,
      "duration_seconds": 4.96,
      "text": "right any allergies to tablets food or anything in the environment?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.23,
      "end_seconds": 217.77,
      "duration_seconds": 3.54,
      "text": "no nothing as far as I know"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 218.7,
      "end_seconds": 229.8,
      "duration_seconds": 11.1,
      "text": "Doctor, I've got the the readings for you. Blood pressure 128 over 71, respiratory rate 15, heart rate 82, oxygen saturation is 98 percent, temperature 36.7."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.74,
      "end_seconds": 232.44,
      "duration_seconds": 0.7,
      "text": "thanks"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.02,
      "end_seconds": 239.08,
      "duration_seconds": 4.06,
      "text": "I'll examine you in a second, make yourself comfortable"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.76,
      "end_seconds": 246.45,
      "duration_seconds": 1.69,
      "text": "fine by me"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.42,
      "end_seconds": 250.45,
      "duration_seconds": 2.03,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.91,
      "end_seconds": 262.34,
      "duration_seconds": 3.43,
      "text": "Your blood pressure and pulse are normal."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.81,
      "end_seconds": 274.44,
      "duration_seconds": 9.63,
      "text": "okay all finished thank you taking everything into account the most likely explanation is poor sleep habits. Mild anxiety is still possible"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.89,
      "end_seconds": 280.06,
      "duration_seconds": 4.17,
      "text": "Hmm, do you think it's something serious?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.91,
      "end_seconds": 298.04,
      "duration_seconds": 16.13,
      "text": "I understand the worry. At the moment I'd say it's poor sleep habits, and we'll watch how it goes. I don't need to add any tests or treatment at this point. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.96,
      "end_seconds": 304.08,
      "duration_seconds": 4.12,
      "text": "ah, um, thank you, that's helpful"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.9,
      "end_seconds": 307.31,
      "duration_seconds": 1.41,
      "text": "See you soon."
    }
  ]
