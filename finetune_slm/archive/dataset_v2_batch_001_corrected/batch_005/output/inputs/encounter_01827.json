{
  "schema_version": "1.0",
  "encounter_id": "01827",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.88,
      "end_seconds": 5.02,
      "duration_seconds": 4.14,
      "text": "Yeah, hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.76,
      "end_seconds": 10.54,
      "duration_seconds": 3.78,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.25,
      "end_seconds": 14.64,
      "duration_seconds": 3.39,
      "text": "I'm here because of tired muscles."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.21,
      "end_seconds": 18.57,
      "duration_seconds": 2.36,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.59,
      "end_seconds": 26.02,
      "duration_seconds": 6.43,
      "text": "I'm on alendronate, 70 milligrams, maybe, once a week for my bones."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.13,
      "end_seconds": 30.29,
      "duration_seconds": 3.16,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.37,
      "end_seconds": 34.54,
      "duration_seconds": 2.17,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.93,
      "end_seconds": 40.33,
      "duration_seconds": 1.4,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.68,
      "end_seconds": 45.43,
      "duration_seconds": 3.75,
      "text": "It's been going on for about three months."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.99,
      "end_seconds": 49.55,
      "duration_seconds": 3.56,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.78,
      "end_seconds": 53.66,
      "duration_seconds": 2.88,
      "text": "Pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.74,
      "end_seconds": 57.34,
      "duration_seconds": 2.6,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.47,
      "end_seconds": 76.15,
      "duration_seconds": 17.68,
      "text": "Not getting outdoors goes along with it, most of the time. The, The not getting outdoors? That's been for ten days. As for not getting outdoors, I'd give it a six, out of ten."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.35,
      "end_seconds": 83.22,
      "duration_seconds": 5.87,
      "text": "Have you had tired muscles before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.88,
      "end_seconds": 91.58,
      "duration_seconds": 6.7,
      "text": "Yes, something like this happened last winter, and it went away on its own."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.77,
      "end_seconds": 113.9,
      "duration_seconds": 5.13,
      "text": "And what about weakness, fractures, bone pain or weight loss?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.62,
      "end_seconds": 120.78,
      "duration_seconds": 5.16,
      "text": "No, no weakness, fractures, bone pain or weight loss."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.86,
      "end_seconds": 126.31,
      "duration_seconds": 2.45,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.81,
      "end_seconds": 128.76,
      "duration_seconds": 0.95,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.03,
      "end_seconds": 133.56,
      "duration_seconds": 3.53,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.24,
      "end_seconds": 137.2,
      "duration_seconds": 1.96,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.71,
      "end_seconds": 155.43,
      "duration_seconds": 4.72,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.52,
      "end_seconds": 160.87,
      "duration_seconds": 4.35,
      "text": "Cat fur. I come out in... well, sneezing."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.36,
      "end_seconds": 165.2,
      "duration_seconds": 2.84,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.4,
      "end_seconds": 181.0,
      "duration_seconds": 14.6,
      "text": "I'll have a glass of wine with dinner. I've never touched a cigarette. I'm a bus driver, so I sit for long hours. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.17,
      "end_seconds": 184.2,
      "duration_seconds": 2.03,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.65,
      "end_seconds": 193.89,
      "duration_seconds": 8.24,
      "text": "I've had migraines for nearly five years now. I've had thin bones for about ten years now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.49,
      "end_seconds": 209.75,
      "duration_seconds": 14.26,
      "text": "Okay, go on. Right, so migraines and thin bones are already on your record. We'll keep that in mind today. Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.4,
      "end_seconds": 213.64,
      "duration_seconds": 2.24,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.42,
      "end_seconds": 221.06,
      "duration_seconds": 2.64,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.24,
      "end_seconds": 232.75,
      "duration_seconds": 2.51,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.89,
      "end_seconds": 256.13,
      "duration_seconds": 8.24,
      "text": "Okay: respiratory rate 18, pulse is 74 beats a minute, blood pressure 122 over 76, temp 36.8 degrees."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.7,
      "end_seconds": 260.06,
      "duration_seconds": 2.36,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.79,
      "end_seconds": 264.6,
      "duration_seconds": 3.81,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.91,
      "end_seconds": 270.81,
      "duration_seconds": 3.9,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.86,
      "end_seconds": 273.89,
      "duration_seconds": 1.03,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.78,
      "end_seconds": 278.46,
      "duration_seconds": 2.68,
      "text": "Alright, raise your arm for me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.75,
      "end_seconds": 301.31,
      "duration_seconds": 4.56,
      "text": "Your muscle strength is normal and there is no bone tenderness."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.71,
      "end_seconds": 314.01,
      "duration_seconds": 10.3,
      "text": "Right, you can relax now. Let me tell you where I've got to. It points towards low vitamin D without complications."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.31,
      "end_seconds": 346.11,
      "duration_seconds": 21.8,
      "text": "I'll request a vitamin D level, it'll help with tiredness. It's a routine test and it'll give us a much clearer picture. The treatment will be colecalciferol, 1000 units, once a day, three months. You take it by mouth. That should help with low vitamin D."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.87,
      "end_seconds": 348.67,
      "duration_seconds": 1.8,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.47,
      "end_seconds": 367.32,
      "duration_seconds": 16.85,
      "text": "Get some daily daylight and eat oily fish. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Book a review in three months."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 370.99,
      "end_seconds": 372.96,
      "duration_seconds": 1.97,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.8,
      "end_seconds": 378.37,
      "duration_seconds": 4.57,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 384.45,
      "end_seconds": 387.76,
      "duration_seconds": 3.31,
      "text": "I think I understand everything. Thanks."
    }
  ]
}