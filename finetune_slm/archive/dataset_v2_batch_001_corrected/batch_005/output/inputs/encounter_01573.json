{
  "schema_version": "1.0",
  "encounter_id": "01573",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.54,
      "end_seconds": 4.15,
      "duration_seconds": 3.61,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.18,
      "end_seconds": 10.09,
      "duration_seconds": 3.91,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.01,
      "end_seconds": 13.05,
      "duration_seconds": 2.04,
      "text": "It's bad breath, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.05,
      "end_seconds": 17.79,
      "duration_seconds": 2.74,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.97,
      "end_seconds": 36.61,
      "duration_seconds": 17.64,
      "text": "Severe, I'd say. Mm, there's a sore throat again as well. As for sore throat again, moderate, really. Yes, swallowing. That makes it worse. Sorry, what was I saying, I've also had a fever, for two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.25,
      "end_seconds": 47.55,
      "duration_seconds": 9.3,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.65,
      "end_seconds": 51.83,
      "duration_seconds": 3.18,
      "text": "Moderate, really. Honestly, all the time."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.44,
      "end_seconds": 58.41,
      "duration_seconds": 5.97,
      "text": "Let me check a few things. Any difficulty breathing, ear pain, rash or drooling?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.92,
      "end_seconds": 62.4,
      "duration_seconds": 2.48,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.16,
      "end_seconds": 67.73,
      "duration_seconds": 3.57,
      "text": "So, anything different when you pass water?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.53,
      "end_seconds": 70.06,
      "duration_seconds": 1.53,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.07,
      "end_seconds": 73.49,
      "duration_seconds": 2.42,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.86,
      "end_seconds": 78.28,
      "duration_seconds": 2.42,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.36,
      "end_seconds": 88.99,
      "duration_seconds": 2.63,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.71,
      "end_seconds": 100.8,
      "duration_seconds": 10.09,
      "text": "My husband and I live above the shop. I grab fast food at lunch most days. I walk the dog every morning."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.31,
      "end_seconds": 104.52,
      "duration_seconds": 2.21,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.55,
      "end_seconds": 121.48,
      "duration_seconds": 14.93,
      "text": "Febuxostat, 80 milligrams, once a day. Paracetamol syrup, 10 ml, every six hours. I took the morning off to come in today. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.08,
      "end_seconds": 140.1,
      "duration_seconds": 3.02,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.67,
      "end_seconds": 145.36,
      "duration_seconds": 4.69,
      "text": "I mean, I have gout, for five years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.55,
      "end_seconds": 158.12,
      "duration_seconds": 9.57,
      "text": "Okay, go on. Alright, gout, that matches what I have here. Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.78,
      "end_seconds": 164.8,
      "duration_seconds": 6.02,
      "text": "Nickel. I come out in... well, a rash on my skin."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.44,
      "end_seconds": 168.81,
      "duration_seconds": 3.37,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.65,
      "end_seconds": 184.14,
      "duration_seconds": 2.49,
      "text": "Right, nearly done with the readings..."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.09,
      "end_seconds": 207.5,
      "duration_seconds": 8.41,
      "text": "Okay: temperature is 38.1 degrees, saturation 98 percent, pressure 111 over 70. And pulse is 106 beats a minute."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.58,
      "end_seconds": 210.0,
      "duration_seconds": 1.42,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.22,
      "end_seconds": 217.09,
      "duration_seconds": 2.87,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.66,
      "end_seconds": 222.65,
      "duration_seconds": 2.99,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.77,
      "end_seconds": 225.72,
      "duration_seconds": 1.95,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.3,
      "end_seconds": 245.8,
      "duration_seconds": 6.5,
      "text": "The tonsils are large and red with white spots, and the neck glands are tender."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.64,
      "end_seconds": 248.53,
      "duration_seconds": 0.89,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.9,
      "end_seconds": 257.77,
      "duration_seconds": 6.87,
      "text": "All finished, thank you. Having listened and examined, the most likely explanation is tonsillitis."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.25,
      "end_seconds": 295.75,
      "duration_seconds": 26.5,
      "text": "Let's get a throat swab, for recurrent tonsillitis. I'd like you to take phenoxymethylpenicillin, 250 milligrams, four times a day, ten days. That's for tonsillitis. Plenty of fluids and soft foods, and he can return to school when the fever has gone. I'll also refer you to the ENT clinic. Please don't wait if the symptoms get worse. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.79,
      "end_seconds": 299.37,
      "duration_seconds": 2.58,
      "text": "Yes, um, will do."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.48,
      "end_seconds": 303.28,
      "duration_seconds": 2.8,
      "text": "Come back if recurrent, tonsil review."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.33,
      "end_seconds": 306.53,
      "duration_seconds": 2.2,
      "text": "Alright, I'll be back."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.57,
      "end_seconds": 311.39,
      "duration_seconds": 2.82,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.43,
      "end_seconds": 315.86,
      "duration_seconds": 2.43,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}