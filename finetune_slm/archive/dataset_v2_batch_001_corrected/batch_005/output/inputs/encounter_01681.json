{
  "schema_version": "1.0",
  "encounter_id": "01681",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.86,
      "end_seconds": 4.26,
      "duration_seconds": 3.4,
      "text": "Come in, have a seat by the desk."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.04,
      "end_seconds": 7.21,
      "duration_seconds": 1.17,
      "text": "Evening, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.79,
      "end_seconds": 14.09,
      "duration_seconds": 3.3,
      "text": "So, did you find the place alright?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.86,
      "end_seconds": 21.0,
      "duration_seconds": 5.14,
      "text": "Yes, it was easy enough. The parking was the hard part."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.93,
      "end_seconds": 26.48,
      "duration_seconds": 3.55,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 27.74,
      "end_seconds": 47.26,
      "duration_seconds": 19.52,
      "text": "Mainly burning on passing urine. There's a couple of other things, but that's the main one. I took the morning off to come in today. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 48.68,
      "end_seconds": 52.1,
      "duration_seconds": 3.42,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 56.56,
      "end_seconds": 59.56,
      "duration_seconds": 3.0,
      "text": "I've had it for two weeks."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.75,
      "end_seconds": 64.01,
      "duration_seconds": 3.26,
      "text": "Have you been passing urine very often?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.81,
      "end_seconds": 67.8,
      "duration_seconds": 2.99,
      "text": "Yeah. About a week, I'd say."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.93,
      "end_seconds": 74.11,
      "duration_seconds": 5.18,
      "text": "let me check a few things. Any reduced baby movements or leaking fluid?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 74.77,
      "end_seconds": 80.32,
      "duration_seconds": 5.55,
      "text": "No reduced baby movements or leaking fluid, none of it."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.1,
      "end_seconds": 89.79,
      "duration_seconds": 3.69,
      "text": "And what about severe back pain or vaginal bleeding?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.65,
      "end_seconds": 97.23,
      "duration_seconds": 5.58,
      "text": "No severe back pain or vaginal bleeding, none of it."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.92,
      "end_seconds": 100.3,
      "duration_seconds": 2.38,
      "text": "has your skin been okay?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.33,
      "end_seconds": 103.33,
      "duration_seconds": 1.0,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.87,
      "end_seconds": 107.99,
      "duration_seconds": 4.12,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.68,
      "end_seconds": 113.61,
      "duration_seconds": 3.93,
      "text": "I take hydrochlorothiazide, 12.5 milligrams, every morning"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.54,
      "end_seconds": 117.35,
      "duration_seconds": 2.81,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.16,
      "end_seconds": 126.01,
      "duration_seconds": 7.85,
      "text": "For about a year. I take metoprolol, 50 milligrams, twice a day for the heart rhythm."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.03,
      "end_seconds": 132.27,
      "duration_seconds": 2.24,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.35,
      "end_seconds": 138.34,
      "duration_seconds": 3.99,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.83,
      "end_seconds": 142.45,
      "duration_seconds": 2.62,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.19,
      "end_seconds": 146.69,
      "duration_seconds": 3.5,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.7,
      "end_seconds": 165.97,
      "duration_seconds": 4.27,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.22,
      "end_seconds": 176.04,
      "duration_seconds": 8.82,
      "text": "I have high blood pressure, for five years. I've had an irregular heartbeat for five years now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.26,
      "end_seconds": 184.34,
      "duration_seconds": 7.08,
      "text": "alright, high blood pressure, that matches what I have here anything surgical in your history?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 185.67,
      "end_seconds": 190.24,
      "duration_seconds": 4.57,
      "text": "Yes, I had my tonsils removed, as a teenager."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.58,
      "end_seconds": 195.01,
      "duration_seconds": 3.43,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 199.14,
      "end_seconds": 201.12,
      "duration_seconds": 1.98,
      "text": "my son has asthma"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.71,
      "end_seconds": 205.52,
      "duration_seconds": 2.81,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.25,
      "end_seconds": 211.49,
      "duration_seconds": 4.24,
      "text": "No, um, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.43,
      "end_seconds": 216.1,
      "duration_seconds": 2.67,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.29,
      "end_seconds": 228.75,
      "duration_seconds": 2.46,
      "text": "okay, this won't take long.."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.62,
      "end_seconds": 255.62,
      "duration_seconds": 9.0,
      "text": "Okay: heart rate 90, respiratory rate 18, SpO2 95 percent on room air, BP is 105 over 73."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.11,
      "end_seconds": 262.28,
      "duration_seconds": 4.17,
      "text": "I'd like to check you over now, if that's alright"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 263.16,
      "end_seconds": 264.55,
      "duration_seconds": 1.39,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.32,
      "end_seconds": 289.21,
      "duration_seconds": 5.89,
      "text": "There is mild tenderness above the pubic bone and no tenderness in the loins."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.78,
      "end_seconds": 296.58,
      "duration_seconds": 2.8,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 313.29,
      "end_seconds": 341.23,
      "duration_seconds": 27.94,
      "text": "I'll request a urine dipstick, it'll help with burning urine. I'll request a urine culture, it'll help with urinary infection. You'll be taking cefalexin, 500 milligrams, twice a day, seven days. It's for urinary infection in pregnancy. Drink plenty of fluids and tell your midwife. We'll catch up in one week. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 343.23,
      "end_seconds": 346.05,
      "duration_seconds": 2.82,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}