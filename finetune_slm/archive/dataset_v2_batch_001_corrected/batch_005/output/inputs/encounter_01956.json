{
  "schema_version": "1.0",
  "encounter_id": "01956",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.83,
      "end_seconds": 3.99,
      "duration_seconds": 3.16,
      "text": "Evening. Let's get started. What's been worrying you?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.19,
      "end_seconds": 12.47,
      "duration_seconds": 3.28,
      "text": "So, I've been feeling faint, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.67,
      "end_seconds": 15.87,
      "duration_seconds": 2.2,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 16.46,
      "end_seconds": 18.73,
      "duration_seconds": 2.27,
      "text": "About... well, six months."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.54,
      "end_seconds": 23.29,
      "duration_seconds": 2.75,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.12,
      "end_seconds": 25.59,
      "duration_seconds": 1.47,
      "text": "Severe, I'd say."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.4,
      "end_seconds": 29.87,
      "duration_seconds": 3.47,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.72,
      "end_seconds": 41.85,
      "duration_seconds": 2.13,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.18,
      "end_seconds": 68.16,
      "duration_seconds": 8.98,
      "text": "Okay: heart rate 110, blood pressure 93 over 60, temperature is 36.7 degrees. And saturation 97 percent."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.88,
      "end_seconds": 70.37,
      "duration_seconds": 1.49,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.9,
      "end_seconds": 74.84,
      "duration_seconds": 2.94,
      "text": "Alright, I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.85,
      "end_seconds": 80.99,
      "duration_seconds": 4.14,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.09,
      "end_seconds": 83.63,
      "duration_seconds": 1.54,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.97,
      "end_seconds": 88.35,
      "duration_seconds": 3.38,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.4,
      "end_seconds": 107.03,
      "duration_seconds": 6.63,
      "text": "Your pulse is over one hundred and eighty and your blood pressure is low."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.66,
      "end_seconds": 111.26,
      "duration_seconds": 1.6,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.95,
      "end_seconds": 131.74,
      "duration_seconds": 3.79,
      "text": "Any fever, cough or leg swelling at all?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.36,
      "end_seconds": 134.72,
      "duration_seconds": 2.36,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.53,
      "end_seconds": 139.02,
      "duration_seconds": 3.49,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.62,
      "end_seconds": 142.49,
      "duration_seconds": 2.87,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.04,
      "end_seconds": 165.35,
      "duration_seconds": 4.31,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 166.39,
      "end_seconds": 170.37,
      "duration_seconds": 3.98,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.58,
      "end_seconds": 179.23,
      "duration_seconds": 2.65,
      "text": "So, anything surgical in your history?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 180.22,
      "end_seconds": 183.99,
      "duration_seconds": 3.77,
      "text": "Just a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.53,
      "end_seconds": 205.35,
      "duration_seconds": 3.82,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.44,
      "end_seconds": 210.72,
      "duration_seconds": 3.28,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.51,
      "end_seconds": 219.59,
      "duration_seconds": 4.08,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 220.89,
      "end_seconds": 237.47,
      "duration_seconds": 16.58,
      "text": "I have about eight cigarettes in a day. I'll have a glass of wine with dinner. Yes, I work in a bakery, early starts. I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.25,
      "end_seconds": 255.44,
      "duration_seconds": 2.19,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 256.56,
      "end_seconds": 259.05,
      "duration_seconds": 2.49,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.54,
      "end_seconds": 290.22,
      "duration_seconds": 29.68,
      "text": "From what you've told me and what I found, it points towards a dangerous fast heart rhythm. I'm going to order blood tests, for arrhythmia. Lie flat, I am calling the emergency team and preparing to shock the heart. If you smoke, this is a good moment to think about stopping, and we can help you with that. Come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 291.31,
      "end_seconds": 292.42,
      "duration_seconds": 1.11,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.18,
      "end_seconds": 295.22,
      "duration_seconds": 2.04,
      "text": "Book a review straight away."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 296.45,
      "end_seconds": 298.51,
      "duration_seconds": 2.06,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.14,
      "end_seconds": 301.92,
      "duration_seconds": 2.78,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 303.79,
      "end_seconds": 305.48,
      "duration_seconds": 1.69,
      "text": "That's clear, thanks."
    }
  ]
}