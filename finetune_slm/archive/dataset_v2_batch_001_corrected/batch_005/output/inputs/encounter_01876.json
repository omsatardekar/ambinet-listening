{
  "schema_version": "1.0",
  "encounter_id": "01876",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.57,
      "end_seconds": 9.95,
      "duration_seconds": 9.38,
      "text": "Doctor, the patient's with us now. I did the usual checks at the front, so just say when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 12.91,
      "end_seconds": 16.58,
      "duration_seconds": 3.67,
      "text": "Perfect, thanks. Hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 18.59,
      "end_seconds": 28.19,
      "duration_seconds": 9.6,
      "text": "Hmm, mainly a swollen red eyelid. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.72,
      "end_seconds": 31.56,
      "duration_seconds": 2.84,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 33.24,
      "end_seconds": 36.81,
      "duration_seconds": 3.57,
      "text": "It's been going on for ten days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.18,
      "end_seconds": 46.37,
      "duration_seconds": 8.19,
      "text": "Right, can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 47.04,
      "end_seconds": 52.01,
      "duration_seconds": 4.97,
      "text": "Right, it happens every other day. Mild, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.86,
      "end_seconds": 55.9,
      "duration_seconds": 3.04,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 57.68,
      "end_seconds": 67.75,
      "duration_seconds": 10.07,
      "text": "It usually comes with pain on moving the eye. The pain on moving the eye? That's been for two days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.99,
      "end_seconds": 74.78,
      "duration_seconds": 5.79,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 75.9,
      "end_seconds": 77.87,
      "duration_seconds": 1.97,
      "text": "It's every other day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.88,
      "end_seconds": 84.04,
      "duration_seconds": 5.16,
      "text": "Right, have you noticed recent injury, sinus infection or blurred vision?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 84.96,
      "end_seconds": 88.96,
      "duration_seconds": 4.0,
      "text": "No, you know, not a single one."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.92,
      "end_seconds": 93.81,
      "duration_seconds": 3.89,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 94.36,
      "end_seconds": 99.6,
      "duration_seconds": 5.24,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.33,
      "end_seconds": 103.6,
      "duration_seconds": 3.27,
      "text": "Right, any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 104.96,
      "end_seconds": 105.98,
      "duration_seconds": 1.02,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.92,
      "end_seconds": 111.72,
      "duration_seconds": 3.8,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 112.45,
      "end_seconds": 126.71,
      "duration_seconds": 14.26,
      "text": "Well, you know, I have an irregular heartbeat. My neighbour said I should get it looked at. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.58,
      "end_seconds": 132.19,
      "duration_seconds": 3.61,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 133.46,
      "end_seconds": 137.82,
      "duration_seconds": 4.36,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.63,
      "end_seconds": 158.8,
      "duration_seconds": 4.17,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 159.34,
      "end_seconds": 163.51,
      "duration_seconds": 4.17,
      "text": "Hmm, my mother had a stroke."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.72,
      "end_seconds": 167.97,
      "duration_seconds": 3.25,
      "text": "Alright, now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 168.81,
      "end_seconds": 182.81,
      "duration_seconds": 14.0,
      "text": "I used to drink heavily but I stopped four years ago. I'm a hairdresser, on my feet all day. I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.59,
      "end_seconds": 185.82,
      "duration_seconds": 2.23,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 191.88,
      "end_seconds": 198.58,
      "duration_seconds": 6.7,
      "text": "I had a meniscus repair on my knee four years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.67,
      "end_seconds": 203.83,
      "duration_seconds": 3.16,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 208.48,
      "end_seconds": 220.73,
      "duration_seconds": 12.25,
      "text": "It's, It's warfarin, 3 milligrams, in the evening. Uh, um, I'd been on bisoprolol, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 228.99,
      "end_seconds": 235.84,
      "duration_seconds": 6.85,
      "text": "Okay, so the vitals from earlier. Pulse 94, saturation 97 percent, pressure 124 over 80."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.24,
      "end_seconds": 242.18,
      "duration_seconds": 0.94,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.79,
      "end_seconds": 248.58,
      "duration_seconds": 4.79,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 263.31,
      "end_seconds": 265.24,
      "duration_seconds": 1.93,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.35,
      "end_seconds": 268.93,
      "duration_seconds": 2.58,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.1,
      "end_seconds": 289.8,
      "duration_seconds": 6.7,
      "text": "The eyelid is swollen shut, the eye is bulging and the movements are painful and limited."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 295.33,
      "end_seconds": 296.46,
      "duration_seconds": 1.13,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.38,
      "end_seconds": 318.27,
      "duration_seconds": 16.89,
      "text": "That's the examination finished. So, based on the history and the examination, I'd lean towards orbital cellulitis. That's my thinking for now, and it may change as we learn more. It could also be periorbital cellulitis, so we'll keep that open."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 319.39,
      "end_seconds": 322.58,
      "duration_seconds": 3.19,
      "text": "Okay, so is this serious, doctor?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.04,
      "end_seconds": 345.43,
      "duration_seconds": 17.39,
      "text": "I understand the worry. At the moment I'd say it's orbital cellulitis, and we'll know more once the blood tests is back. I'm going to order blood tests, for orbital cellulitis. You need admission today for intravenous antibiotics."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.73,
      "end_seconds": 359.6,
      "duration_seconds": 13.87,
      "text": "Understood. I'm not ordering an urgent CT scan today. If things carry on in a month, we'll consider it. Let's plan a check straight away. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 360.42,
      "end_seconds": 362.21,
      "duration_seconds": 1.79,
      "text": "That's clear, thanks."
    }
  ]
}