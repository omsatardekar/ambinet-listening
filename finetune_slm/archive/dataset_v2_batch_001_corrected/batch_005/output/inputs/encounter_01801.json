{
  "schema_version": "1.0",
  "encounter_id": "01801",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.98,
      "end_seconds": 7.76,
      "duration_seconds": 6.78,
      "text": "Doctor your next patient is here. I've done the basics I'll read them out in a moment."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.47,
      "end_seconds": 12.38,
      "duration_seconds": 3.91,
      "text": "thanks that's helpful hello please sit what's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 14.04,
      "end_seconds": 21.35,
      "duration_seconds": 7.31,
      "text": "hmm, um, I've been dealing with a tingling lip then a blister"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.41,
      "end_seconds": 27.78,
      "duration_seconds": 4.37,
      "text": "can you tell me when it it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 29.53,
      "end_seconds": 32.48,
      "duration_seconds": 2.95,
      "text": "erm, for five days, I'd say"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.03,
      "end_seconds": 36.09,
      "duration_seconds": 2.06,
      "text": "have you noticed any triggers?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 37.21,
      "end_seconds": 44.6,
      "duration_seconds": 7.39,
      "text": "Yes sunlight. That makes it worse. Oh and crusting. That's been about the same three days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.8,
      "end_seconds": 52.47,
      "duration_seconds": 3.67,
      "text": "how much trouble does it it give you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 54.04,
      "end_seconds": 57.13,
      "duration_seconds": 3.09,
      "text": "erm, I'd call it it severe"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.71,
      "end_seconds": 65.51,
      "duration_seconds": 6.8,
      "text": "have you had a tingling lip then a blister before or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 66.43,
      "end_seconds": 73.12,
      "duration_seconds": 6.69,
      "text": "um, a bit, about six months ago. It settled by itself back then"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "UNKNOWN",
      "start_seconds": 73.68,
      "end_seconds": 75.74,
      "duration_seconds": 2.06,
      "text": "Yes, exactly like that."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.03,
      "end_seconds": 90.25,
      "duration_seconds": 6.22,
      "text": "Have you noticed fever sores in the mouth eye pain or rash elsewhere?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 91.69,
      "end_seconds": 107.71,
      "duration_seconds": 16.02,
      "text": "no, no fever, no sores in the mouth, no eye pain i did have a mild sore feeling at one point, but that went away on its own"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.78,
      "end_seconds": 111.55,
      "duration_seconds": 2.77,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 112.21,
      "end_seconds": 115.76,
      "duration_seconds": 3.55,
      "text": "No, uh, my breathing's been fine."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.59,
      "end_seconds": 120.14,
      "duration_seconds": 3.55,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 120.83,
      "end_seconds": 142.99,
      "duration_seconds": 22.16,
      "text": "I've got gout. I thought it would sort itself out but it it hasn't. Yes acid reflux. I've had eczema yes. I looked a few things up online and that probably didn't help. I told my wife I'd come today. I have diabetes for two years."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.71,
      "end_seconds": 146.23,
      "duration_seconds": 1.52,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.03,
      "end_seconds": 158.23,
      "duration_seconds": 10.2,
      "text": "Right so acid reflux and diabetes are already on your record. We'll keep that in mind today. Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 159.61,
      "end_seconds": 162.22,
      "duration_seconds": 2.61,
      "text": "it's allopurinol, once a day"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.2,
      "end_seconds": 166.55,
      "duration_seconds": 2.35,
      "text": "how much do you take?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 168.26,
      "end_seconds": 169.7,
      "duration_seconds": 1.44,
      "text": "It's 100 milligrams."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 170.75,
      "end_seconds": 178.75,
      "duration_seconds": 8.0,
      "text": "It's a... um I can't remember what it's called. It's a little pink tablet."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.61,
      "end_seconds": 183.13,
      "duration_seconds": 3.52,
      "text": "So So do you remember what it's for?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 185.02,
      "end_seconds": 199.22,
      "duration_seconds": 14.2,
      "text": "for the reflux, I believe. My daughter sets them out for me, I just take what I'm given. I take hydrocortisone cream, when needed for the eczema"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.87,
      "end_seconds": 202.84,
      "duration_seconds": 2.97,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 204.76,
      "end_seconds": 206.91,
      "duration_seconds": 2.15,
      "text": "About a month now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.53,
      "end_seconds": 211.66,
      "duration_seconds": 4.13,
      "text": "any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 216.39,
      "end_seconds": 219.18,
      "duration_seconds": 2.79,
      "text": "my mother had a stroke"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.47,
      "end_seconds": 224.83,
      "duration_seconds": 4.36,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 226.53,
      "end_seconds": 236.68,
      "duration_seconds": 10.15,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.17,
      "end_seconds": 241.1,
      "duration_seconds": 0.93,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 242.02,
      "end_seconds": 245.71,
      "duration_seconds": 3.69,
      "text": "I smoke roughly a pack every two days"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.54,
      "end_seconds": 249.87,
      "duration_seconds": 3.33,
      "text": "are you on your own at home?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 253.47,
      "end_seconds": 256.53,
      "duration_seconds": 3.06,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.39,
      "end_seconds": 259.75,
      "duration_seconds": 2.36,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 261.11,
      "end_seconds": 266.35,
      "duration_seconds": 5.24,
      "text": "yes, I had part of my thyroid removed, years back"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 268.02,
      "end_seconds": 277.74,
      "duration_seconds": 9.72,
      "text": "okay so the vitals from earlier pressure 108 over 75 oxygen saturation is 97 percent temp 36.6 degrees heart rate 77."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.21,
      "end_seconds": 279.91,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.81,
      "end_seconds": 287.42,
      "duration_seconds": 4.61,
      "text": "I'll need to examine you for this it won't take long"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.59,
      "end_seconds": 290.54,
      "duration_seconds": 1.95,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.13,
      "end_seconds": 306.85,
      "duration_seconds": 5.72,
      "text": "There is a small cluster of blisters on the edge of the upper lip."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.43,
      "end_seconds": 312.21,
      "duration_seconds": 1.78,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.7,
      "end_seconds": 341.36,
      "duration_seconds": 11.66,
      "text": "let me repeat that back to make sure. You've had a tingling lip then a blister for five days and no rash elsewhere or fever"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 342.11,
      "end_seconds": 343.72,
      "duration_seconds": 1.61,
      "text": "yes, that's right"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.51,
      "end_seconds": 371.74,
      "duration_seconds": 26.23,
      "text": "let's use aciclovir cream 5% five times a day five days. It's for cold sore. Avoid kissing and sharing towels until it has crusted over. Make sure you're drinking plenty of fluids two to three litres a day if you can and get proper rest. If the symptoms get worse or you feel really unwell please come to the emergency department"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 372.8,
      "end_seconds": 374.19,
      "duration_seconds": 1.39,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 375.9,
      "end_seconds": 379.21,
      "duration_seconds": 3.31,
      "text": "Come back if not healed in ten days."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 380.88,
      "end_seconds": 385.83,
      "duration_seconds": 4.95,
      "text": "I'll book your follow-up at the front desk on your way out."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 386.34,
      "end_seconds": 391.01,
      "duration_seconds": 4.67,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 393.04,
      "end_seconds": 396.37,
      "duration_seconds": 3.33,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 398.15,
      "end_seconds": 399.79,
      "duration_seconds": 1.64,
      "text": "All the the best."
    }
  ]
}