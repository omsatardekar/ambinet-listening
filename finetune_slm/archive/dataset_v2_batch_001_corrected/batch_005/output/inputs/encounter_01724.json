{
  "schema_version": "1.0",
  "encounter_id": "01724",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.75,
      "end_seconds": 4.84,
      "duration_seconds": 4.09,
      "text": "Morning, come on through. What's the main thing today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.85,
      "end_seconds": 23.21,
      "duration_seconds": 17.36,
      "text": "Honestly, it's chest pain after a crash, and my family pushed me to come. I thought it would sort itself out, but it hasn't. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.16,
      "end_seconds": 28.58,
      "duration_seconds": 3.42,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.32,
      "end_seconds": 44.95,
      "duration_seconds": 2.63,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 58.03,
      "end_seconds": 68.85,
      "duration_seconds": 10.82,
      "text": "Okay: temp 36.9 degrees, SpO2 99 percent on room air, pulse is 102 beats a minute. And blood pressure 92 over 63, respiratory rate 18."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.05,
      "end_seconds": 88.22,
      "duration_seconds": 3.17,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 89.69,
      "end_seconds": 104.02,
      "duration_seconds": 14.33,
      "text": "I've had it for about a week. I didn't want to bother you but it keeps coming back. I kept putting it off, um, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.83,
      "end_seconds": 107.71,
      "duration_seconds": 2.88,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.27,
      "end_seconds": 124.66,
      "duration_seconds": 16.39,
      "text": "It happens a few times a day. Oh, and difficulty breathing. That's been about the same, three days. As for difficulty breathing, honestly, a few times a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.98,
      "end_seconds": 125.68,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.02,
      "end_seconds": 142.05,
      "duration_seconds": 5.03,
      "text": "Have you noticed head injury, neck pain or loss of consciousness?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.49,
      "end_seconds": 145.51,
      "duration_seconds": 2.02,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.29,
      "end_seconds": 152.42,
      "duration_seconds": 5.13,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 157.42,
      "end_seconds": 159.48,
      "duration_seconds": 2.06,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.32,
      "end_seconds": 181.75,
      "duration_seconds": 3.43,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 183.13,
      "end_seconds": 185.84,
      "duration_seconds": 2.71,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.74,
      "end_seconds": 189.59,
      "duration_seconds": 1.85,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 190.43,
      "end_seconds": 193.19,
      "duration_seconds": 2.76,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.22,
      "end_seconds": 196.41,
      "duration_seconds": 1.19,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 199.61,
      "end_seconds": 202.88,
      "duration_seconds": 3.27,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.62,
      "end_seconds": 206.8,
      "duration_seconds": 2.18,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.58,
      "end_seconds": 212.02,
      "duration_seconds": 4.44,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.56,
      "end_seconds": 219.99,
      "duration_seconds": 3.43,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 220.63,
      "end_seconds": 225.41,
      "duration_seconds": 4.78,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.5,
      "end_seconds": 229.61,
      "duration_seconds": 2.11,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 231.45,
      "end_seconds": 235.24,
      "duration_seconds": 3.79,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.99,
      "end_seconds": 238.16,
      "duration_seconds": 1.17,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 239.67,
      "end_seconds": 240.76,
      "duration_seconds": 1.09,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.43,
      "end_seconds": 259.99,
      "duration_seconds": 4.56,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 262.08,
      "end_seconds": 264.97,
      "duration_seconds": 2.89,
      "text": "Not really, you know, no."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.9,
      "end_seconds": 268.64,
      "duration_seconds": 2.74,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 269.2,
      "end_seconds": 272.29,
      "duration_seconds": 3.09,
      "text": "Yes, diclofenac, it gives me wheezing."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.78,
      "end_seconds": 278.29,
      "duration_seconds": 4.51,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 279.47,
      "end_seconds": 281.09,
      "duration_seconds": 1.62,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.85,
      "end_seconds": 284.12,
      "duration_seconds": 1.27,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 300.02,
      "end_seconds": 308.52,
      "duration_seconds": 8.5,
      "text": "There is bruising across the chest, the left side moves less, and the belly is tender and rigid."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 312.92,
      "end_seconds": 338.39,
      "duration_seconds": 25.47,
      "text": "Please sit back down. Okay, so my impression is this: It fits best with serious chest and abdominal injury. I'm sending you for a trauma CT scan because of major trauma. Do not move, I am activating the trauma team now. I'm going to send a referral to the trauma team. I'd like you back straight away."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 339.86,
      "end_seconds": 341.47,
      "duration_seconds": 1.61,
      "text": "Yes, that's manageable."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 342.3,
      "end_seconds": 347.18,
      "duration_seconds": 4.88,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 348.64,
      "end_seconds": 352.03,
      "duration_seconds": 3.39,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}