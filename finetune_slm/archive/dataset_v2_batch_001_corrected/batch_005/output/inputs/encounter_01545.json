{
  "schema_version": "1.0",
  "encounter_id": "01545",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.74,
      "end_seconds": 5.08,
      "duration_seconds": 4.34,
      "text": "Ready for you, doctor. I'll stay in case you need anything."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.84,
      "end_seconds": 9.26,
      "duration_seconds": 3.42,
      "text": "Perfect, thanks. Hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.81,
      "end_seconds": 14.45,
      "duration_seconds": 3.64,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.75,
      "end_seconds": 20.87,
      "duration_seconds": 5.12,
      "text": "Alright, of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 26.49,
      "end_seconds": 37.45,
      "duration_seconds": 10.96,
      "text": "I mean, um, it's an upset stomach in the mornings, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 38.43,
      "end_seconds": 50.21,
      "duration_seconds": 11.78,
      "text": "Okay, so the vitals from earlier. Temperature is 36.9 degrees, SpO2 99 percent on room air. Pressure 126 over 74, pulse is 77 beats a minute."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.34,
      "end_seconds": 55.67,
      "duration_seconds": 4.33,
      "text": "Good, thank you. Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 57.43,
      "end_seconds": 63.12,
      "duration_seconds": 5.69,
      "text": "It's, um... not exactly... well, hard to explain, I mean—"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.71,
      "end_seconds": 70.75,
      "duration_seconds": 7.04,
      "text": "Let me put it another way: how many times in a typical day or week?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 73.46,
      "end_seconds": 76.79,
      "duration_seconds": 3.33,
      "text": "It sort of comes and goes."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 77.29,
      "end_seconds": 83.36,
      "duration_seconds": 6.07,
      "text": "I, I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 83.46,
      "end_seconds": 89.98,
      "duration_seconds": 6.52,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.83,
      "end_seconds": 94.29,
      "duration_seconds": 2.46,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 95.02,
      "end_seconds": 99.64,
      "duration_seconds": 4.62,
      "text": "And there's poor sleep as well, two weeks now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.52,
      "end_seconds": 107.12,
      "duration_seconds": 4.6,
      "text": "Okay, what about shaky hands, have you noticed that?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 111.94,
      "end_seconds": 114.41,
      "duration_seconds": 2.47,
      "text": "Yes, for about a week."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.38,
      "end_seconds": 119.13,
      "duration_seconds": 2.75,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 119.79,
      "end_seconds": 122.15,
      "duration_seconds": 2.36,
      "text": "It's, It's every other day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.86,
      "end_seconds": 125.39,
      "duration_seconds": 2.53,
      "text": "Have you had drinking most nights?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 126.51,
      "end_seconds": 127.6,
      "duration_seconds": 1.09,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.38,
      "end_seconds": 134.68,
      "duration_seconds": 3.3,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 135.7,
      "end_seconds": 139.0,
      "duration_seconds": 3.3,
      "text": "About a three out of ten."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.59,
      "end_seconds": 153.7,
      "duration_seconds": 2.11,
      "text": "Any sign of vomiting blood?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 154.99,
      "end_seconds": 156.9,
      "duration_seconds": 1.91,
      "text": "No vomiting blood, thankfully."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.56,
      "end_seconds": 161.59,
      "duration_seconds": 3.03,
      "text": "Any yellow eyes, confusion or black stools?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 162.77,
      "end_seconds": 165.26,
      "duration_seconds": 2.49,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.21,
      "end_seconds": 168.34,
      "duration_seconds": 2.13,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 169.43,
      "end_seconds": 171.01,
      "duration_seconds": 1.58,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.7,
      "end_seconds": 175.94,
      "duration_seconds": 3.24,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 176.78,
      "end_seconds": 178.71,
      "duration_seconds": 1.93,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.81,
      "end_seconds": 182.99,
      "duration_seconds": 3.18,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 184.7,
      "end_seconds": 188.47,
      "duration_seconds": 3.77,
      "text": "I've had asthma for nearly five years now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.89,
      "end_seconds": 191.1,
      "duration_seconds": 1.21,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 193.11,
      "end_seconds": 198.63,
      "duration_seconds": 5.52,
      "text": "I have depression. I've had arthritis in my knees, yes."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.17,
      "end_seconds": 208.6,
      "duration_seconds": 8.43,
      "text": "Yes. Alright, arthritis in your knees, that matches what I have here. Alright, any surgery in the past?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 209.74,
      "end_seconds": 213.73,
      "duration_seconds": 3.99,
      "text": "Just my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.91,
      "end_seconds": 216.31,
      "duration_seconds": 1.4,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 221.92,
      "end_seconds": 225.51,
      "duration_seconds": 3.59,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.32,
      "end_seconds": 227.95,
      "duration_seconds": 1.63,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 229.52,
      "end_seconds": 232.72,
      "duration_seconds": 3.2,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.73,
      "end_seconds": 236.63,
      "duration_seconds": 1.9,
      "text": "Right, what's your work?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 237.56,
      "end_seconds": 241.69,
      "duration_seconds": 4.13,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.77,
      "end_seconds": 245.35,
      "duration_seconds": 1.58,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 246.1,
      "end_seconds": 250.6,
      "duration_seconds": 4.5,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.82,
      "end_seconds": 254.37,
      "duration_seconds": 2.55,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 256.11,
      "end_seconds": 266.29,
      "duration_seconds": 10.18,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.71,
      "end_seconds": 272.41,
      "duration_seconds": 4.7,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 272.96,
      "end_seconds": 281.88,
      "duration_seconds": 8.92,
      "text": "I'm on Asthalin inhaler, when needed for my asthma. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.67,
      "end_seconds": 285.28,
      "duration_seconds": 2.61,
      "text": "Roughly how long on that one?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 290.17,
      "end_seconds": 295.74,
      "duration_seconds": 5.57,
      "text": "For nearly five years. Fluoxetine. I take it 20 milligrams, every morning."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 297.77,
      "end_seconds": 304.48,
      "duration_seconds": 6.71,
      "text": "She is supposed to take it every morning, but I can't say she always does."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 305.0,
      "end_seconds": 312.15,
      "duration_seconds": 7.15,
      "text": "Naproxen. I take it 250 milligrams, maybe, twice a day for the knee pain."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.23,
      "end_seconds": 318.81,
      "duration_seconds": 4.58,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 320.31,
      "end_seconds": 322.29,
      "duration_seconds": 1.98,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.96,
      "end_seconds": 327.77,
      "duration_seconds": 3.81,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 328.33,
      "end_seconds": 333.65,
      "duration_seconds": 5.32,
      "text": "Mm, my uncle has high cholesterol. Right, my grandmother had dementia."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.7,
      "end_seconds": 338.64,
      "duration_seconds": 3.94,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.96,
      "end_seconds": 341.87,
      "duration_seconds": 1.91,
      "text": "Okay, breathe out slowly."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.02,
      "end_seconds": 355.03,
      "duration_seconds": 6.01,
      "text": "Your liver edge is felt slightly below the ribs and there is a fine tremor."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 368.68,
      "end_seconds": 369.61,
      "duration_seconds": 0.93,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 374.57,
      "end_seconds": 397.42,
      "duration_seconds": 22.85,
      "text": "That's all I needed to check. Right, here's what I'm thinking. I'd lean towards harmful alcohol use with liver strain. I'd also keep fatty liver in mind. Just to be sure I understood. You've had an upset stomach in the mornings, and no black stools or confusion."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 399.42,
      "end_seconds": 401.2,
      "duration_seconds": 1.78,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 402.95,
      "end_seconds": 407.38,
      "duration_seconds": 4.43,
      "text": "I'd like to arrange an ultrasound of the liver for hepatomegaly."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 408.85,
      "end_seconds": 413.93,
      "duration_seconds": 5.08,
      "text": "We have a slot Tuesday at 10 am, if that works."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 415.79,
      "end_seconds": 416.81,
      "duration_seconds": 1.02,
      "text": "That's fine."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 417.78,
      "end_seconds": 427.84,
      "duration_seconds": 10.06,
      "text": "We should do liver blood tests for alcohol use. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 428.88,
      "end_seconds": 431.12,
      "duration_seconds": 2.24,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 431.91,
      "end_seconds": 435.66,
      "duration_seconds": 3.75,
      "text": "We should do a blood count for alcohol use."
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 436.44,
      "end_seconds": 439.24,
      "duration_seconds": 2.8,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 439.9,
      "end_seconds": 471.51,
      "duration_seconds": 31.61,
      "text": "The treatment will be thiamine, 100 milligrams, three times a day, long term. You take it by mouth. That's for alcohol-related nutritional deficiency. Cut down gradually and do not stop suddenly on your own if you drink heavily. The alcohol support service would be the right next step, I'll refer you. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0071",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 472.21,
      "end_seconds": 473.69,
      "duration_seconds": 1.48,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0072",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 475.34,
      "end_seconds": 489.21,
      "duration_seconds": 13.87,
      "text": "Please don't wait if the symptoms get worse. That's when to be seen urgently. Let's plan a check after the tests. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0073",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 490.39,
      "end_seconds": 493.64,
      "duration_seconds": 3.25,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}