  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.67,
      "end_seconds": 2.18,
      "duration_seconds": 1.51,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 2.81,
      "end_seconds": 7.78,
      "duration_seconds": 4.97,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 8.39,
      "end_seconds": 20.3,
      "duration_seconds": 11.91,
      "text": "Mainly red sore skin on my shoulders. There's a couple of other things, but that's the main one. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.84,
      "end_seconds": 23.71,
      "duration_seconds": 1.87,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.51,
      "end_seconds": 30.81,
      "duration_seconds": 6.3,
      "text": "Erm, uh, it's been about four days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.08,
      "end_seconds": 48.48,
      "duration_seconds": 3.4,
      "text": "And what about vomiting, fever or headache?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.01,
      "end_seconds": 53.43,
      "duration_seconds": 3.42,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.34,
      "end_seconds": 61.53,
      "duration_seconds": 4.19,
      "text": "Okay, any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.54,
      "end_seconds": 64.66,
      "duration_seconds": 2.12,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.82,
      "end_seconds": 67.95,
      "duration_seconds": 2.13,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.82,
      "end_seconds": 73.25,
      "duration_seconds": 3.43,
      "text": "I take after-sun lotion, twice a day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.89,
      "end_seconds": 77.02,
      "duration_seconds": 2.13,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.02,
      "end_seconds": 83.26,
      "duration_seconds": 4.24,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.38,
      "end_seconds": 87.49,
      "duration_seconds": 3.11,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.44,
      "end_seconds": 91.89,
      "duration_seconds": 3.45,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.69,
      "end_seconds": 108.23,
      "duration_seconds": 3.54,
      "text": "Right, does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.15,
      "end_seconds": 111.92,
      "duration_seconds": 2.77,
      "text": "My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.88,
      "end_seconds": 117.21,
      "duration_seconds": 3.33,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.99,
      "end_seconds": 121.04,
      "duration_seconds": 2.05,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.95,
      "end_seconds": 141.3,
      "duration_seconds": 4.35,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.38,
      "end_seconds": 146.24,
      "duration_seconds": 2.86,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.79,
      "end_seconds": 153.68,
      "duration_seconds": 2.89,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.04,
      "end_seconds": 157.88,
      "duration_seconds": 2.84,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.74,
      "end_seconds": 162.77,
      "duration_seconds": 3.03,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.5,
      "end_seconds": 175.85,
      "duration_seconds": 2.35,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.85,
      "end_seconds": 200.0,
      "duration_seconds": 13.15,
      "text": "Okay: BMI works out to 22.4, temperature 36.8. And saturation 98 percent, blood pressure 115 over 72, height 161 centimetres, pulse 85, weight 58 kilos."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.35,
      "end_seconds": 205.02,
      "duration_seconds": 3.67,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.56,
      "end_seconds": 206.91,
      "duration_seconds": 1.35,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.17,
      "end_seconds": 210.03,
      "duration_seconds": 1.86,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.25,
      "end_seconds": 231.95,
      "duration_seconds": 3.7,
      "text": "The skin is pink and tender with no blistering."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.15,
      "end_seconds": 250.52,
      "duration_seconds": 13.37,
      "text": "That's the examination finished. So where does that leave us? My working impression is mild sunburn. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.87,
      "end_seconds": 277.84,
      "duration_seconds": 8.97,
      "text": "Cool compresses, moisturiser and stay out of the sun for a few days. Do get help quickly if the symptoms get worse."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.71,
      "end_seconds": 281.42,
      "duration_seconds": 1.71,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.23,
      "end_seconds": 291.25,
      "duration_seconds": 4.02,
      "text": "I'd like to see you again if blisters develop."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.6,
      "end_seconds": 294.92,
      "duration_seconds": 2.32,
      "text": "Alright, I'll be back."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.68,
      "end_seconds": 298.41,
      "duration_seconds": 2.73,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.93,
      "end_seconds": 301.69,
      "duration_seconds": 2.76,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.52,
      "end_seconds": 303.8,
      "duration_seconds": 1.28,
      "text": "Look after yourself."
    }
  ]
