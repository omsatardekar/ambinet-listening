{
  "schema_version": "1.0",
  "encounter_id": "01736",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.69,
      "end_seconds": 5.17,
      "duration_seconds": 4.48,
      "text": "Right, hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.1,
      "end_seconds": 10.62,
      "duration_seconds": 4.52,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.08,
      "end_seconds": 15.85,
      "duration_seconds": 3.77,
      "text": "I've been dealing with being extremely thirsty."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.2,
      "end_seconds": 20.71,
      "duration_seconds": 3.51,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.25,
      "end_seconds": 23.81,
      "duration_seconds": 2.56,
      "text": "Probably about a month. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.51,
      "end_seconds": 27.52,
      "duration_seconds": 3.01,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.43,
      "end_seconds": 31.89,
      "duration_seconds": 2.46,
      "text": "It feels moderate to me."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.36,
      "end_seconds": 36.22,
      "duration_seconds": 2.86,
      "text": "Alright, is there anything else with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.12,
      "end_seconds": 52.34,
      "duration_seconds": 15.22,
      "text": "So, it usually comes with weakness. And I've been passing huge amounts of urine as well, since Monday. The weakness? That's been for two weeks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.28,
      "end_seconds": 56.23,
      "duration_seconds": 2.95,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.93,
      "end_seconds": 60.06,
      "duration_seconds": 2.13,
      "text": "I'd call it moderate."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.91,
      "end_seconds": 63.73,
      "duration_seconds": 2.82,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.67,
      "end_seconds": 75.4,
      "duration_seconds": 2.73,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.75,
      "end_seconds": 98.77,
      "duration_seconds": 9.02,
      "text": "Okay: oxygen saturation is 97 percent, heart rate 118. And pressure 131 over 84, weight 65 kilos, height 175 centimetres."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.45,
      "end_seconds": 102.89,
      "duration_seconds": 2.44,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.22,
      "end_seconds": 110.6,
      "duration_seconds": 2.38,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.01,
      "end_seconds": 117.36,
      "duration_seconds": 5.35,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.06,
      "end_seconds": 121.23,
      "duration_seconds": 2.17,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.42,
      "end_seconds": 143.19,
      "duration_seconds": 6.77,
      "text": "You are very dry and drowsy, and your sugar reading is too high to read."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.4,
      "end_seconds": 149.56,
      "duration_seconds": 4.16,
      "text": "You can relax now. Okay, any sign of fever?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.34,
      "end_seconds": 153.17,
      "duration_seconds": 1.83,
      "text": "Definitely no fever."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.78,
      "end_seconds": 158.68,
      "duration_seconds": 3.9,
      "text": "Have you had any vomiting or chest pain?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.19,
      "end_seconds": 166.34,
      "duration_seconds": 3.15,
      "text": "Hmm, nope, nothing like that."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.42,
      "end_seconds": 170.23,
      "duration_seconds": 2.81,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.21,
      "end_seconds": 175.64,
      "duration_seconds": 3.43,
      "text": "No, um, skin's been fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.51,
      "end_seconds": 182.92,
      "duration_seconds": 5.41,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.48,
      "end_seconds": 188.11,
      "duration_seconds": 4.63,
      "text": "Mm, you know, no, nothing like that."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.14,
      "end_seconds": 191.79,
      "duration_seconds": 2.65,
      "text": "Alright, what about your medical history?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.55,
      "end_seconds": 196.04,
      "duration_seconds": 2.49,
      "text": "I've had diabetes, yes."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.01,
      "end_seconds": 197.79,
      "duration_seconds": 0.78,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.65,
      "end_seconds": 199.8,
      "duration_seconds": 1.15,
      "text": "Yes, asthma."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.98,
      "end_seconds": 201.78,
      "duration_seconds": 0.8,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.74,
      "end_seconds": 205.23,
      "duration_seconds": 2.49,
      "text": "Depression, for two years."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.82,
      "end_seconds": 212.44,
      "duration_seconds": 6.62,
      "text": "Okay, yes, diabetes and depression are known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.91,
      "end_seconds": 227.66,
      "duration_seconds": 3.75,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.64,
      "end_seconds": 234.9,
      "duration_seconds": 6.26,
      "text": "I take something called sita... sitagliptin, 100 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.53,
      "end_seconds": 241.41,
      "duration_seconds": 4.88,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.08,
      "end_seconds": 269.65,
      "duration_seconds": 26.57,
      "text": "No, it's at home. Hmm, uh, I take Seretide inhaler, twice a day for my asthma. Let me think, I'm supposed to take it regularly, but I don't always manage. Well, um, I'm on sertraline, 50 milligrams, once a day for my mood."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.91,
      "end_seconds": 272.24,
      "duration_seconds": 1.33,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.09,
      "end_seconds": 279.09,
      "duration_seconds": 3.0,
      "text": "No surgery, you know, no."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.87,
      "end_seconds": 284.58,
      "duration_seconds": 4.71,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.49,
      "end_seconds": 297.22,
      "duration_seconds": 10.73,
      "text": "Mm, I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.27,
      "end_seconds": 318.83,
      "duration_seconds": 4.56,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.53,
      "end_seconds": 338.96,
      "duration_seconds": 18.43,
      "text": "I'll have a glass of wine with dinner. No, I've never smoked in my life. I grab fast food at lunch most days. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.99,
      "end_seconds": 348.36,
      "duration_seconds": 8.37,
      "text": "Taking everything into account, the most likely explanation is a hyperosmolar diabetic emergency. We shouldn't forget sepsis."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.34,
      "end_seconds": 352.1,
      "duration_seconds": 1.76,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.16,
      "end_seconds": 360.89,
      "duration_seconds": 7.73,
      "text": "It's reasonable to be concerned, but right now a hyperosmolar diabetic emergency is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 372.7,
      "end_seconds": 384.03,
      "duration_seconds": 11.33,
      "text": "Let's get an ECG, for hyperglycaemic emergency. I'll request urgent blood tests, it'll help with hyperglycaemic emergency. You need hospital now for fluids and insulin."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 384.62,
      "end_seconds": 407.13,
      "duration_seconds": 22.51,
      "text": "Yes, carry on. If you smoke, this is a good moment to think about stopping, and we can help you with that. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. So, I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 409.16,
      "end_seconds": 412.91,
      "duration_seconds": 3.75,
      "text": "Actually, um, alright, thanks, take care."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 413.45,
      "end_seconds": 414.84,
      "duration_seconds": 1.39,
      "text": "See you soon."
    }
  ]
}