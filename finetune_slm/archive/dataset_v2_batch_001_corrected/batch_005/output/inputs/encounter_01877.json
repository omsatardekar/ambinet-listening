{
  "schema_version": "1.0",
  "encounter_id": "01877",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.03,
      "end_seconds": 4.67,
      "duration_seconds": 3.64,
      "text": "hello? Doctor? I was told to come in"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.71,
      "end_seconds": 10.27,
      "duration_seconds": 4.56,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.62,
      "end_seconds": 21.92,
      "duration_seconds": 9.3,
      "text": "honestly, it's pain under my right ribs after fatty meals, and my family pushed me to come"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.01,
      "end_seconds": 24.98,
      "duration_seconds": 1.97,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.94,
      "end_seconds": 27.93,
      "duration_seconds": 1.99,
      "text": "About... well one week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.41,
      "end_seconds": 31.78,
      "duration_seconds": 2.37,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.17,
      "end_seconds": 39.85,
      "duration_seconds": 3.68,
      "text": "It happens a couple of times a week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.86,
      "end_seconds": 44.2,
      "duration_seconds": 3.34,
      "text": "Rate it for me mild moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.32,
      "end_seconds": 47.95,
      "duration_seconds": 2.63,
      "text": "I'd call it it mild."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.49,
      "end_seconds": 54.2,
      "duration_seconds": 3.71,
      "text": "could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.94,
      "end_seconds": 58.02,
      "duration_seconds": 2.08,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.72,
      "end_seconds": 80.04,
      "duration_seconds": 7.32,
      "text": "it is tender under the right ribs and you stop breathing in when I press"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.78,
      "end_seconds": 84.68,
      "duration_seconds": 1.9,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.81,
      "end_seconds": 105.72,
      "duration_seconds": 3.91,
      "text": "did you get pale stools, fever or yellow eyes?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.56,
      "end_seconds": 112.81,
      "duration_seconds": 5.25,
      "text": "No pale stools, fever or yellow eyes, none of it."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.51,
      "end_seconds": 116.13,
      "duration_seconds": 2.62,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.09,
      "end_seconds": 120.09,
      "duration_seconds": 3.0,
      "text": "right nothing on the skin no"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.92,
      "end_seconds": 125.25,
      "duration_seconds": 3.33,
      "text": "which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.08,
      "end_seconds": 136.13,
      "duration_seconds": 7.05,
      "text": "It's naproxen 250 milligrams twice a day. I take an antacid 10 ml when needed."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.69,
      "end_seconds": 137.94,
      "duration_seconds": 1.25,
      "text": "any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.87,
      "end_seconds": 140.03,
      "duration_seconds": 1.16,
      "text": "no, never"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.11,
      "end_seconds": 144.68,
      "duration_seconds": 2.57,
      "text": "before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.72,
      "end_seconds": 148.61,
      "duration_seconds": 2.89,
      "text": "not to to my knowledge no"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.34,
      "end_seconds": 151.41,
      "duration_seconds": 2.07,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.73,
      "end_seconds": 157.44,
      "duration_seconds": 4.71,
      "text": "I have arthritis in my knees, for nearly five years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.26,
      "end_seconds": 173.06,
      "duration_seconds": 3.8,
      "text": "is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.56,
      "end_seconds": 176.83,
      "duration_seconds": 2.27,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.53,
      "end_seconds": 181.3,
      "duration_seconds": 2.77,
      "text": "are you on your own at home?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.78,
      "end_seconds": 185.69,
      "duration_seconds": 2.91,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.22,
      "end_seconds": 188.9,
      "duration_seconds": 1.68,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.47,
      "end_seconds": 192.69,
      "duration_seconds": 3.22,
      "text": "I hardly move around during the day"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.74,
      "end_seconds": 216.87,
      "duration_seconds": 17.13,
      "text": "from what you've told me and what I found my working impression is gallstone-related pain. Let me just check I've got this right. You've had pain under your right ribs after fatty meals for one week mild and no pale stools or fever"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.71,
      "end_seconds": 219.71,
      "duration_seconds": 2.0,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.14,
      "end_seconds": 234.66,
      "duration_seconds": 3.52,
      "text": "let's get liver blood tests, for biliary pain"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.03,
      "end_seconds": 238.02,
      "duration_seconds": 1.99,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.32,
      "end_seconds": 271.85,
      "duration_seconds": 29.53,
      "text": "let's get an ultrasound of the abdomen, for biliary pain i'm going to put you on paracetamol, 1 gram, four times a day when needed, one week you take it by mouth that's for pain avoid fatty and fried foods until the scan keep an eye out, and if the symptoms get worse, call us the same day or go to emergency"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.08,
      "end_seconds": 276.52,
      "duration_seconds": 3.44,
      "text": "Okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.08,
      "end_seconds": 288.83,
      "duration_seconds": 8.75,
      "text": "please come and see me after the scan how would you describe the plan, so we're on the same page?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.15,
      "end_seconds": 301.27,
      "duration_seconds": 11.12,
      "text": "So, I take the paracetamol, 1 gram, four times a day when needed and come back after the scan. Is that that right?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.66,
      "end_seconds": 311.15,
      "duration_seconds": 5.49,
      "text": "Yes, exactly right. Right, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.49,
      "end_seconds": 316.14,
      "duration_seconds": 3.65,
      "text": "uh good thanks I'll see you then"
    }
  ]
}