{
  "schema_version": "1.0",
  "encounter_id": "01746",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.26,
      "end_seconds": 6.73,
      "duration_seconds": 5.47,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.62,
      "end_seconds": 11.51,
      "duration_seconds": 3.89,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.82,
      "end_seconds": 17.72,
      "duration_seconds": 4.9,
      "text": "I'm here because of a curtain coming across my vision."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.53,
      "end_seconds": 20.12,
      "duration_seconds": 1.59,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.15,
      "end_seconds": 26.68,
      "duration_seconds": 4.53,
      "text": "it's, It's been going on for about three months"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.72,
      "end_seconds": 32.04,
      "duration_seconds": 3.32,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.55,
      "end_seconds": 37.3,
      "duration_seconds": 4.75,
      "text": "It's severe, honestly. And flashes of light, too."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.07,
      "end_seconds": 41.46,
      "duration_seconds": 3.39,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.28,
      "end_seconds": 52.31,
      "duration_seconds": 9.03,
      "text": "Yes, amoxicillin. I've no idea what the reaction was, only that I'm not supposed to have it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.58,
      "end_seconds": 55.0,
      "duration_seconds": 1.42,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.81,
      "end_seconds": 59.81,
      "duration_seconds": 4.0,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.75,
      "end_seconds": 62.62,
      "duration_seconds": 1.87,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.27,
      "end_seconds": 68.02,
      "duration_seconds": 3.75,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.32,
      "end_seconds": 70.49,
      "duration_seconds": 1.17,
      "text": "what's your work?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.31,
      "end_seconds": 76.36,
      "duration_seconds": 4.05,
      "text": "I'm a plumber, lots of bending and kneeling"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.93,
      "end_seconds": 80.09,
      "duration_seconds": 2.16,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.99,
      "end_seconds": 86.16,
      "duration_seconds": 4.17,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.69,
      "end_seconds": 89.04,
      "duration_seconds": 1.35,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.62,
      "end_seconds": 92.46,
      "duration_seconds": 2.84,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.38,
      "end_seconds": 97.98,
      "duration_seconds": 3.6,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.94,
      "end_seconds": 102.32,
      "duration_seconds": 3.38,
      "text": "no, I've always been fairly healthy"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.53,
      "end_seconds": 116.45,
      "duration_seconds": 2.92,
      "text": "So, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.3,
      "end_seconds": 118.8,
      "duration_seconds": 1.5,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.5,
      "end_seconds": 123.78,
      "duration_seconds": 3.28,
      "text": "has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.06,
      "end_seconds": 127.28,
      "duration_seconds": 2.22,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.15,
      "end_seconds": 139.49,
      "duration_seconds": 2.34,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.74,
      "end_seconds": 143.4,
      "duration_seconds": 2.66,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.43,
      "end_seconds": 159.57,
      "duration_seconds": 3.14,
      "text": "and what about red eye or eye pain?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.64,
      "end_seconds": 164.25,
      "duration_seconds": 2.61,
      "text": "no, nothing to report there"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.17,
      "end_seconds": 168.09,
      "duration_seconds": 1.92,
      "text": "what about recent injury?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.92,
      "end_seconds": 171.84,
      "duration_seconds": 2.92,
      "text": "Nope, you know, no recent injury."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.16,
      "end_seconds": 175.18,
      "duration_seconds": 3.02,
      "text": "hm, okay is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.07,
      "end_seconds": 178.19,
      "duration_seconds": 2.12,
      "text": "I move fine otherwise"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.52,
      "end_seconds": 183.46,
      "duration_seconds": 3.94,
      "text": "let me get the readings out of the way"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.43,
      "end_seconds": 196.06,
      "duration_seconds": 2.63,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.59,
      "end_seconds": 223.7,
      "duration_seconds": 7.11,
      "text": "Okay: respiratory rate 17, pressure 116 over 79, temp 36.6 degrees. And pulse 84."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.14,
      "end_seconds": 228.26,
      "duration_seconds": 2.12,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.85,
      "end_seconds": 231.19,
      "duration_seconds": 1.34,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.13,
      "end_seconds": 254.64,
      "duration_seconds": 7.51,
      "text": "The vision in the right eye is much reduced and the field is cut off at the top."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.64,
      "end_seconds": 261.58,
      "duration_seconds": 2.94,
      "text": "So, that's all I needed to check."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.97,
      "end_seconds": 279.42,
      "duration_seconds": 8.45,
      "text": "From what you've told me and what I found, it points towards a possible retinal detachment needing urgent surgery."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.2,
      "end_seconds": 284.01,
      "duration_seconds": 2.81,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.11,
      "end_seconds": 299.46,
      "duration_seconds": 14.35,
      "text": "It's reasonable to be concerned, but right now a possible retinal detachment needing urgent surgery is my leading thought, not anything worse. I want an urgent eye examination done, that's for possible retinal detachment."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.36,
      "end_seconds": 304.46,
      "duration_seconds": 3.1,
      "text": "Okay, you know, I'll do it."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.38,
      "end_seconds": 319.72,
      "duration_seconds": 14.34,
      "text": "you need to be seen by the eye surgeons today, please don't eat or drink book a review straight away is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.54,
      "end_seconds": 323.97,
      "duration_seconds": 2.43,
      "text": "thank you, doctor, goodbye"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.11,
      "end_seconds": 326.59,
      "duration_seconds": 1.48,
      "text": "Look after yourself."
    }
  ]
