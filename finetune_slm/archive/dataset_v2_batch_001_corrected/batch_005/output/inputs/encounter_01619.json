{
  "schema_version": "1.0",
  "encounter_id": "01619",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.21,
      "end_seconds": 5.5,
      "duration_seconds": 4.29,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.38,
      "end_seconds": 11.42,
      "duration_seconds": 4.04,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.23,
      "end_seconds": 25.44,
      "duration_seconds": 13.21,
      "text": "Honestly, you know, it's drinking most nights, and my family pushed me to come. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.07,
      "end_seconds": 29.41,
      "duration_seconds": 2.34,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.02,
      "end_seconds": 38.09,
      "duration_seconds": 2.07,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.99,
      "end_seconds": 66.4,
      "duration_seconds": 8.41,
      "text": "Okay: temperature is 36.9 degrees, pulse is 73 beats a minute. And pressure 126 over 74, saturation 97 percent."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.64,
      "end_seconds": 69.17,
      "duration_seconds": 1.53,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.67,
      "end_seconds": 80.07,
      "duration_seconds": 6.4,
      "text": "I'll come back to the numbers. So, rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.06,
      "end_seconds": 84.22,
      "duration_seconds": 2.16,
      "text": "I, I'd say moderate."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.57,
      "end_seconds": 89.03,
      "duration_seconds": 3.46,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.66,
      "end_seconds": 98.1,
      "duration_seconds": 6.44,
      "text": "When it starts I tend to get poor sleep as well."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.68,
      "end_seconds": 102.1,
      "duration_seconds": 2.42,
      "text": "Have you had any vomiting blood?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.88,
      "end_seconds": 106.73,
      "duration_seconds": 2.85,
      "text": "No, none, no vomiting blood."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.74,
      "end_seconds": 111.44,
      "duration_seconds": 3.7,
      "text": "And what about black stools, yellow eyes or confusion?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.19,
      "end_seconds": 117.77,
      "duration_seconds": 5.58,
      "text": "Actually, no, no black stools, yellow eyes or confusion."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.88,
      "end_seconds": 121.14,
      "duration_seconds": 2.26,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.16,
      "end_seconds": 125.89,
      "duration_seconds": 3.73,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.44,
      "end_seconds": 129.88,
      "duration_seconds": 2.44,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.83,
      "end_seconds": 131.87,
      "duration_seconds": 1.04,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.52,
      "end_seconds": 148.89,
      "duration_seconds": 2.37,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.17,
      "end_seconds": 154.43,
      "duration_seconds": 4.26,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.11,
      "end_seconds": 158.04,
      "duration_seconds": 2.93,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.88,
      "end_seconds": 164.68,
      "duration_seconds": 3.8,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.29,
      "end_seconds": 168.87,
      "duration_seconds": 2.58,
      "text": "Right, anything surgical in your history?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.46,
      "end_seconds": 176.21,
      "duration_seconds": 5.75,
      "text": "Just a wisdom tooth extraction under sedation, five years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.55,
      "end_seconds": 181.06,
      "duration_seconds": 3.51,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.7,
      "end_seconds": 187.65,
      "duration_seconds": 4.95,
      "text": "Mm, I don't think I have any, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.71,
      "end_seconds": 205.87,
      "duration_seconds": 3.16,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.58,
      "end_seconds": 212.52,
      "duration_seconds": 4.94,
      "text": "Hydrocortisone cream. I take it when needed for the eczema."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.5,
      "end_seconds": 217.51,
      "duration_seconds": 3.01,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.17,
      "end_seconds": 223.77,
      "duration_seconds": 5.6,
      "text": "I've, I've had eczema for nearly five years now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.0,
      "end_seconds": 229.45,
      "duration_seconds": 1.45,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.88,
      "end_seconds": 236.18,
      "duration_seconds": 4.3,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.39,
      "end_seconds": 248.58,
      "duration_seconds": 1.19,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.72,
      "end_seconds": 251.06,
      "duration_seconds": 1.34,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.76,
      "end_seconds": 265.41,
      "duration_seconds": 6.65,
      "text": "Your liver edge is felt slightly below the ribs and there is a fine tremor."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.91,
      "end_seconds": 267.61,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.76,
      "end_seconds": 293.94,
      "duration_seconds": 21.18,
      "text": "That's the examination finished. Taking everything into account, my working impression is harmful alcohol use with liver strain. I want to be honest that this is an impression, not a final answer. It could also be fatty liver, so we'll keep that open."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.86,
      "end_seconds": 297.41,
      "duration_seconds": 1.55,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.14,
      "end_seconds": 324.74,
      "duration_seconds": 25.6,
      "text": "It's reasonable to be concerned, but right now harmful alcohol use with liver strain is my leading thought, not anything worse. I'd like to arrange an ultrasound of the liver for hepatomegaly. I'd rather check than guess, and this is the quickest way to know more. I'm sending you for a blood count because of alcohol use."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.81,
      "end_seconds": 342.14,
      "duration_seconds": 15.33,
      "text": "I'm prescribing thiamine, 100 milligrams, three times a day, long term. You take it by mouth. That should help with alcohol-related nutritional deficiency. Cut down gradually and do not stop suddenly on your own if you drink heavily."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.46,
      "end_seconds": 343.34,
      "duration_seconds": 0.88,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.85,
      "end_seconds": 349.12,
      "duration_seconds": 4.27,
      "text": "Can you send me for liver blood tests?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.4,
      "end_seconds": 358.04,
      "duration_seconds": 7.64,
      "text": "Not at this point, no. It isn't indicated yet. I'll want another look after the tests."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.95,
      "end_seconds": 359.65,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.01,
      "end_seconds": 366.2,
      "duration_seconds": 5.19,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 367.2,
      "end_seconds": 369.47,
      "duration_seconds": 2.27,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 370.42,
      "end_seconds": 371.69,
      "duration_seconds": 1.27,
      "text": "Look after yourself."
    }
  ]
}