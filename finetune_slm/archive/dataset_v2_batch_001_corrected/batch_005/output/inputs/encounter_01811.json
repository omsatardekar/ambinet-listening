{
  "schema_version": "1.0",
  "encounter_id": "01811",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.39,
      "end_seconds": 4.88,
      "duration_seconds": 3.49,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.47,
      "end_seconds": 10.65,
      "duration_seconds": 4.18,
      "text": "yes, have a seat tell me what's going on"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.7,
      "end_seconds": 18.21,
      "duration_seconds": 5.51,
      "text": "Actually, I wanted to get a very sore throat looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.89,
      "end_seconds": 21.1,
      "duration_seconds": 1.21,
      "text": "since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.14,
      "end_seconds": 24.98,
      "duration_seconds": 2.84,
      "text": "about... well, about two weeks"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.4,
      "end_seconds": 27.57,
      "duration_seconds": 2.17,
      "text": "Understood. Anything that improves it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.55,
      "end_seconds": 32.58,
      "duration_seconds": 3.03,
      "text": "Only gargles, and it's not much."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.39,
      "end_seconds": 36.5,
      "duration_seconds": 3.11,
      "text": "how troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.47,
      "end_seconds": 38.88,
      "duration_seconds": 1.41,
      "text": "I'd say moderate"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.19,
      "end_seconds": 53.61,
      "duration_seconds": 3.42,
      "text": "right, I'll just record a few vital signs"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.81,
      "end_seconds": 66.1,
      "duration_seconds": 2.29,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.42,
      "end_seconds": 92.59,
      "duration_seconds": 6.17,
      "text": "Okay: BP is 119 over 66, temperature is 39.0 degrees, heart rate 103."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.45,
      "end_seconds": 95.45,
      "duration_seconds": 2.0,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.36,
      "end_seconds": 98.78,
      "duration_seconds": 2.42,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.27,
      "end_seconds": 102.72,
      "duration_seconds": 2.45,
      "text": "let's move on to the examination"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.02,
      "end_seconds": 105.12,
      "duration_seconds": 1.1,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.54,
      "end_seconds": 108.21,
      "duration_seconds": 1.67,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.21,
      "end_seconds": 131.21,
      "duration_seconds": 7.0,
      "text": "Your tonsils are large with white coating and the glands in the neck are tender."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.3,
      "end_seconds": 142.37,
      "duration_seconds": 7.07,
      "text": "Good, you can sit up again. Any rash, tummy pain on the left, jaundice or difficulty breathing?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.54,
      "end_seconds": 147.02,
      "duration_seconds": 3.48,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.1,
      "end_seconds": 151.04,
      "duration_seconds": 1.94,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.0,
      "end_seconds": 153.95,
      "duration_seconds": 0.95,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.04,
      "end_seconds": 159.4,
      "duration_seconds": 4.36,
      "text": "anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.46,
      "end_seconds": 166.03,
      "duration_seconds": 1.57,
      "text": "nothing like that"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.77,
      "end_seconds": 169.89,
      "duration_seconds": 2.12,
      "text": "any regular medication at all?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.09,
      "end_seconds": 172.66,
      "duration_seconds": 1.57,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.99,
      "end_seconds": 178.14,
      "duration_seconds": 4.15,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.97,
      "end_seconds": 182.74,
      "duration_seconds": 2.77,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.31,
      "end_seconds": 187.87,
      "duration_seconds": 4.56,
      "text": "let's talk a little about your daily life and habits"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.68,
      "end_seconds": 203.79,
      "duration_seconds": 15.11,
      "text": "I quit smoking around ten years ago. Nothing, I'm teetotal. I work in accounts at a hospital. I'm vegetarian and have been for years. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.61,
      "end_seconds": 224.23,
      "duration_seconds": 3.62,
      "text": "any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.86,
      "end_seconds": 227.73,
      "duration_seconds": 2.87,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.49,
      "end_seconds": 259.27,
      "duration_seconds": 12.78,
      "text": "From what you've told me and what I found, I'd lean towards glandular fever. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.58,
      "end_seconds": 264.92,
      "duration_seconds": 4.34,
      "text": "I mean, is there something to worry about?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.76,
      "end_seconds": 288.86,
      "duration_seconds": 23.1,
      "text": "I understand the worry. At the moment I'd say it's glandular fever, and we'll know more once the a blood count is back. Let me just check I've got this right. You've had a very sore throat for about two weeks, moderate, and no tummy pain on the left or difficulty breathing."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.33,
      "end_seconds": 295.97,
      "duration_seconds": 1.64,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.32,
      "end_seconds": 317.4,
      "duration_seconds": 11.08,
      "text": "I think a blood count makes sense here, for glandular fever. Rest, plenty of fluids, and and no contact sport for a month because of the spleen."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.68,
      "end_seconds": 330.5,
      "duration_seconds": 12.82,
      "text": "I see, go ahead. Please don't wait if the symptoms get worse. That's when to be seen urgently. Please come and see me in two weeks"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.02,
      "end_seconds": 334.1,
      "duration_seconds": 2.08,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.93,
      "end_seconds": 337.55,
      "duration_seconds": 2.62,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.21,
      "end_seconds": 341.69,
      "duration_seconds": 3.48,
      "text": "Great, thank you for your help."
    }
  ]
}