{
  "schema_version": "1.0",
  "encounter_id": "01737",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.23,
      "end_seconds": 10.52,
      "duration_seconds": 9.29,
      "text": "Doctor, the patient's with us now. I did the usual checks at the front, so just say when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.72,
      "end_seconds": 17.23,
      "duration_seconds": 5.51,
      "text": "thanks. Hello, come in, sit down. What brings you in today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 18.94,
      "end_seconds": 24.98,
      "duration_seconds": 6.04,
      "text": "well, uh, I've been having shaky spells in the afternoon"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.67,
      "end_seconds": 30.18,
      "duration_seconds": 4.51,
      "text": "Alright, can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 31.16,
      "end_seconds": 37.12,
      "duration_seconds": 5.96,
      "text": "it's been four weeks now. It's the not knowing that gets to me"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.65,
      "end_seconds": 40.04,
      "duration_seconds": 2.39,
      "text": "what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 42.1,
      "end_seconds": 44.33,
      "duration_seconds": 2.23,
      "text": "Sitagliptin, once a day"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.62,
      "end_seconds": 47.71,
      "duration_seconds": 2.09,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 48.28,
      "end_seconds": 57.73,
      "duration_seconds": 9.45,
      "text": "it's 100 milligrams. Glucose tablets, 4 tablets, when needed i thought it would sort itself out, but it hasn't"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.53,
      "end_seconds": 62.25,
      "duration_seconds": 2.72,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 63.89,
      "end_seconds": 69.67,
      "duration_seconds": 5.78,
      "text": "Uh, um, no, nothing as far as I know."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.39,
      "end_seconds": 85.04,
      "duration_seconds": 2.65,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 85.94,
      "end_seconds": 89.78,
      "duration_seconds": 3.84,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.44,
      "end_seconds": 92.07,
      "duration_seconds": 1.63,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 93.77,
      "end_seconds": 96.3,
      "duration_seconds": 2.53,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.22,
      "end_seconds": 106.31,
      "duration_seconds": 4.09,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 110.77,
      "end_seconds": 115.57,
      "duration_seconds": 4.8,
      "text": "Sorry, what was I saying, my brother has epilepsy."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.23,
      "end_seconds": 126.99,
      "duration_seconds": 2.76,
      "text": "has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 129.52,
      "end_seconds": 130.89,
      "duration_seconds": 1.37,
      "text": "I've got diabetes."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.46,
      "end_seconds": 152.12,
      "duration_seconds": 4.66,
      "text": "So, did you get loss of consciousness, vomiting or seizure?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 153.21,
      "end_seconds": 158.61,
      "duration_seconds": 5.4,
      "text": "Sorry, what was I saying, no, not a single one."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.11,
      "end_seconds": 162.91,
      "duration_seconds": 3.8,
      "text": "Have you had chest pain, by any chance?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 163.98,
      "end_seconds": 167.03,
      "duration_seconds": 3.05,
      "text": "No, none, no chest pain."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.94,
      "end_seconds": 170.97,
      "duration_seconds": 2.03,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 171.65,
      "end_seconds": 173.12,
      "duration_seconds": 1.47,
      "text": "no changes there"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 173.77,
      "end_seconds": 180.14,
      "duration_seconds": 6.37,
      "text": "Doctor, I've got the readings for you. Pulse 122, pressure 136 over 73, temperature 36.6."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.6,
      "end_seconds": 183.05,
      "duration_seconds": 1.45,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.57,
      "end_seconds": 188.6,
      "duration_seconds": 4.03,
      "text": "now I'm going to do a short physical check"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.12,
      "end_seconds": 192.49,
      "duration_seconds": 2.37,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.21,
      "end_seconds": 211.93,
      "duration_seconds": 7.72,
      "text": "Your sugar reading in clinic is on the low side and your pulse is a little fast."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.1,
      "end_seconds": 217.12,
      "duration_seconds": 3.02,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.01,
      "end_seconds": 232.65,
      "duration_seconds": 6.64,
      "text": "right, here's what I'm thinking. I'd lean towards recurrent low blood sugar on insulin"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 233.51,
      "end_seconds": 236.2,
      "duration_seconds": 2.69,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.72,
      "end_seconds": 269.26,
      "duration_seconds": 31.54,
      "text": "Nothing I've seen today points to an emergency. It looks like recurrent low blood sugar on insulin, but I'd like to confirm. I'm going to order an HbA1c, for diabetes review. I'm prescribing insulin glargine, 16 units, once a day at bedtime, long term. It's for diabetes. Always carry sugar and eat something before exercise. If it hasn't settled in two weeks, we'd think about a download of the glucose meter, but not now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.06,
      "end_seconds": 275.23,
      "duration_seconds": 5.17,
      "text": "If the symptoms get worse, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 277.18,
      "end_seconds": 279.97,
      "duration_seconds": 2.79,
      "text": "alright, um, I follow"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.84,
      "end_seconds": 283.34,
      "duration_seconds": 2.5,
      "text": "Let's review you in two weeks."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 284.06,
      "end_seconds": 287.79,
      "duration_seconds": 3.73,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.0,
      "end_seconds": 293.33,
      "duration_seconds": 4.33,
      "text": "that's everything on my side anything you're unsure about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 295.06,
      "end_seconds": 298.22,
      "duration_seconds": 3.16,
      "text": "well, alright, thanks, take care"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.03,
      "end_seconds": 300.34,
      "duration_seconds": 1.31,
      "text": "goodbye for now"
    }
  ]
}