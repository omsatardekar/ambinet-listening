  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.07,
      "end_seconds": 3.06,
      "duration_seconds": 1.99,
      "text": "Morning, come on through."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.51,
      "end_seconds": 9.16,
      "duration_seconds": 2.65,
      "text": "Good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.02,
      "end_seconds": 11.96,
      "duration_seconds": 1.94,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.54,
      "end_seconds": 16.91,
      "duration_seconds": 3.37,
      "text": "Oh, I've been dealing with night sweats."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.14,
      "end_seconds": 24.96,
      "duration_seconds": 2.82,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.42,
      "end_seconds": 30.66,
      "duration_seconds": 4.24,
      "text": "It's been about four days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.0,
      "end_seconds": 36.42,
      "duration_seconds": 5.42,
      "text": "Hm, okay. Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.96,
      "end_seconds": 46.25,
      "duration_seconds": 9.29,
      "text": "It sort of comes and goes. Severe, I'd say. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.78,
      "end_seconds": 70.58,
      "duration_seconds": 5.8,
      "text": "Let me check a few things. Any fever, HIV or chest pain?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 72.13,
      "end_seconds": 74.63,
      "duration_seconds": 2.5,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.98,
      "end_seconds": 81.73,
      "duration_seconds": 2.75,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.01,
      "end_seconds": 85.84,
      "duration_seconds": 2.83,
      "text": "Hmm, no, skin's been fine."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.85,
      "end_seconds": 91.78,
      "duration_seconds": 3.93,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 93.06,
      "end_seconds": 96.45,
      "duration_seconds": 3.39,
      "text": "Mm, uh, no, all normal there."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.99,
      "end_seconds": 100.67,
      "duration_seconds": 2.68,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.07,
      "end_seconds": 103.28,
      "duration_seconds": 1.21,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.71,
      "end_seconds": 122.39,
      "duration_seconds": 2.68,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.43,
      "end_seconds": 126.79,
      "duration_seconds": 3.36,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.97,
      "end_seconds": 138.95,
      "duration_seconds": 3.98,
      "text": "Alright, is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 140.96,
      "end_seconds": 143.41,
      "duration_seconds": 2.45,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.11,
      "end_seconds": 146.55,
      "duration_seconds": 1.44,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.24,
      "end_seconds": 149.44,
      "duration_seconds": 1.2,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.29,
      "end_seconds": 154.77,
      "duration_seconds": 4.48,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.58,
      "end_seconds": 158.67,
      "duration_seconds": 3.09,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.69,
      "end_seconds": 174.95,
      "duration_seconds": 3.26,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.67,
      "end_seconds": 181.25,
      "duration_seconds": 4.58,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.8,
      "end_seconds": 188.75,
      "duration_seconds": 1.95,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 190.79,
      "end_seconds": 195.24,
      "duration_seconds": 4.45,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.25,
      "end_seconds": 200.16,
      "duration_seconds": 2.91,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.94,
      "end_seconds": 211.81,
      "duration_seconds": 2.87,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.31,
      "end_seconds": 236.81,
      "duration_seconds": 6.5,
      "text": "Okay: pulse is 74 beats a minute, pressure 118 over 80, temperature is 36.4 degrees."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 238.0,
      "end_seconds": 239.46,
      "duration_seconds": 1.46,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.33,
      "end_seconds": 242.33,
      "duration_seconds": 2.0,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.73,
      "end_seconds": 249.24,
      "duration_seconds": 4.51,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 249.86,
      "end_seconds": 251.37,
      "duration_seconds": 1.51,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.35,
      "end_seconds": 254.98,
      "duration_seconds": 1.63,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.32,
      "end_seconds": 271.24,
      "duration_seconds": 4.92,
      "text": "There are some crackles at the top of the right lung."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.94,
      "end_seconds": 285.39,
      "duration_seconds": 10.45,
      "text": "All finished, thank you. Okay, thinking it through, the most likely explanation is possible tuberculosis. I'll request three sputum samples, it'll help with possible tuberculosis."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 285.9,
      "end_seconds": 288.66,
      "duration_seconds": 2.76,
      "text": "The earliest is Monday, 3:30 pm."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 290.29,
      "end_seconds": 291.27,
      "duration_seconds": 0.98,
      "text": "That's fine."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.8,
      "end_seconds": 304.31,
      "duration_seconds": 12.51,
      "text": "Wear a mask in public and cover your mouth when you cough until the results are back. Please don't wait if the symptoms get worse. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 305.06,
      "end_seconds": 308.41,
      "duration_seconds": 3.35,
      "text": "I know what to watch for."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.59,
      "end_seconds": 312.98,
      "duration_seconds": 3.39,
      "text": "I'd like you back after the tests."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 314.79,
      "end_seconds": 319.15,
      "duration_seconds": 4.36,
      "text": "Um, um, good, I'll return then."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 321.04,
      "end_seconds": 323.42,
      "duration_seconds": 2.38,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 325.33,
      "end_seconds": 328.05,
      "duration_seconds": 2.72,
      "text": "That's clear, you know, thanks."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 329.35,
      "end_seconds": 330.57,
      "duration_seconds": 1.22,
      "text": "See you soon."
    }
