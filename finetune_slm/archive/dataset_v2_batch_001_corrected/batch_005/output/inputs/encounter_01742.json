{
  "schema_version": "1.0",
  "encounter_id": "01742",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.76,
      "end_seconds": 5.3,
      "duration_seconds": 4.54,
      "text": "Morning, uh, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.17,
      "end_seconds": 11.37,
      "duration_seconds": 4.2,
      "text": "no problem at all, come in what's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.22,
      "end_seconds": 28.26,
      "duration_seconds": 16.04,
      "text": "Yeah, it's an upset stomach in the mornings. I don't know what's causing it. Work has been very busy so I kept ignoring it. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.38,
      "end_seconds": 34.4,
      "duration_seconds": 3.02,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.05,
      "end_seconds": 45.65,
      "duration_seconds": 9.6,
      "text": "Uh, I've had it for five days. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.04,
      "end_seconds": 46.74,
      "duration_seconds": 0.7,
      "text": "ah"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.95,
      "end_seconds": 53.27,
      "duration_seconds": 5.32,
      "text": "um, there was shaky hands, yes, but that went away"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.09,
      "end_seconds": 61.84,
      "duration_seconds": 6.75,
      "text": "Have you had an upset stomach in the mornings before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.44,
      "end_seconds": 71.09,
      "duration_seconds": 7.65,
      "text": "Uh, uh, a bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.52,
      "end_seconds": 77.09,
      "duration_seconds": 4.57,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.17,
      "end_seconds": 86.73,
      "duration_seconds": 8.56,
      "text": "I had a reaction to erythromycin when I was younger, bad stomach cramps, and I've avoided it since"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.83,
      "end_seconds": 103.37,
      "duration_seconds": 2.54,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.58,
      "end_seconds": 114.08,
      "duration_seconds": 4.5,
      "text": "Yes, I had a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.16,
      "end_seconds": 121.19,
      "duration_seconds": 5.03,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.02,
      "end_seconds": 134.34,
      "duration_seconds": 12.32,
      "text": "I drink a lot of tea and snack through the day. I live with my elderly mother. I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.84,
      "end_seconds": 138.09,
      "duration_seconds": 3.25,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.9,
      "end_seconds": 144.23,
      "duration_seconds": 4.33,
      "text": "I've, I've had asthma for about a year now."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.15,
      "end_seconds": 149.25,
      "duration_seconds": 4.1,
      "text": "alright, asthma, that matches what I have here"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.44,
      "end_seconds": 166.59,
      "duration_seconds": 2.15,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.17,
      "end_seconds": 172.08,
      "duration_seconds": 4.91,
      "text": "I'm on Foracort inhaler, twice a day for my asthma"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.58,
      "end_seconds": 178.04,
      "duration_seconds": 4.46,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.65,
      "end_seconds": 182.42,
      "duration_seconds": 2.77,
      "text": "my aunt has rheumatoid arthritis"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.2,
      "end_seconds": 189.65,
      "duration_seconds": 3.45,
      "text": "Have you had any confusion or black stools?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.51,
      "end_seconds": 193.72,
      "duration_seconds": 3.21,
      "text": "ah, no, none that I've noticed"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.83,
      "end_seconds": 198.46,
      "duration_seconds": 3.63,
      "text": "Have you had any yellow eyes or vomiting blood?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.96,
      "end_seconds": 203.14,
      "duration_seconds": 4.18,
      "text": "I haven't had yellow eyes or vomiting blood, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.65,
      "end_seconds": 208.15,
      "duration_seconds": 3.5,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.0,
      "end_seconds": 212.21,
      "duration_seconds": 2.21,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.81,
      "end_seconds": 218.8,
      "duration_seconds": 2.99,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.03,
      "end_seconds": 230.8,
      "duration_seconds": 2.77,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.95,
      "end_seconds": 250.35,
      "duration_seconds": 7.4,
      "text": "Okay: saturation 97 percent, heart rate 86, temperature is 36.9 degrees, pressure 113 over 77."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.32,
      "end_seconds": 253.41,
      "duration_seconds": 2.09,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.4,
      "end_seconds": 258.82,
      "duration_seconds": 4.42,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.89,
      "end_seconds": 264.32,
      "duration_seconds": 4.43,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.54,
      "end_seconds": 280.67,
      "duration_seconds": 1.13,
      "text": "of course"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.0,
      "end_seconds": 283.88,
      "duration_seconds": 1.88,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.94,
      "end_seconds": 306.88,
      "duration_seconds": 5.94,
      "text": "Your liver edge is felt slightly below the ribs and there is a fine tremor."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.74,
      "end_seconds": 308.87,
      "duration_seconds": 1.13,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.55,
      "end_seconds": 322.62,
      "duration_seconds": 10.07,
      "text": "All finished, thank you. Cut down gradually and do not stop suddenly on your own if you drink heavily. Let's review you after the tests."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.34,
      "end_seconds": 325.69,
      "duration_seconds": 2.35,
      "text": "Alright, I'll be back."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.27,
      "end_seconds": 330.68,
      "duration_seconds": 4.41,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.58,
      "end_seconds": 336.23,
      "duration_seconds": 4.65,
      "text": "no, you know, that's all thanks a lot"
    }
  ]
}