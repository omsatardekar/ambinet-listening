{
  "schema_version": "1.0",
  "encounter_id": "01873",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.28,
      "end_seconds": 6.35,
      "duration_seconds": 5.07,
      "text": "So, hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.13,
      "end_seconds": 11.17,
      "duration_seconds": 4.04,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.09,
      "end_seconds": 17.45,
      "duration_seconds": 4.36,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.87,
      "end_seconds": 24.22,
      "duration_seconds": 5.35,
      "text": "Yeah, it's painful periods. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.29,
      "end_seconds": 28.51,
      "duration_seconds": 3.22,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.53,
      "end_seconds": 41.38,
      "duration_seconds": 10.85,
      "text": "Erm, you know, I take sumatriptan, 50 milligrams, when needed. Ibuprofen, 400 milligrams, with food when needed."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.42,
      "end_seconds": 44.05,
      "duration_seconds": 1.63,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.63,
      "end_seconds": 52.61,
      "duration_seconds": 6.98,
      "text": "Sorry, uh, what was I saying, it's been like this since yesterday."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.1,
      "end_seconds": 55.71,
      "duration_seconds": 1.61,
      "text": "Anything that improves it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.71,
      "end_seconds": 65.07,
      "duration_seconds": 5.36,
      "text": "It settles a little with a hot water bottle."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.11,
      "end_seconds": 69.29,
      "duration_seconds": 2.18,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.09,
      "end_seconds": 84.55,
      "duration_seconds": 14.46,
      "text": "When it starts I tend to get a dull ache in my back as well. Ah, about dull ache in my back, I'd say once or twice a day."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.98,
      "end_seconds": 89.61,
      "duration_seconds": 3.63,
      "text": "Right, have you noticed pain with sex or fever?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.68,
      "end_seconds": 97.55,
      "duration_seconds": 6.87,
      "text": "So, um, no pain with sex or fever, none of it."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.59,
      "end_seconds": 102.13,
      "duration_seconds": 3.54,
      "text": "And what about heavy bleeding or bleeding between periods?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.91,
      "end_seconds": 108.09,
      "duration_seconds": 4.18,
      "text": "No, no heavy bleeding or bleeding between periods."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.98,
      "end_seconds": 112.94,
      "duration_seconds": 2.96,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.45,
      "end_seconds": 115.62,
      "duration_seconds": 1.17,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.19,
      "end_seconds": 118.26,
      "duration_seconds": 2.07,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.22,
      "end_seconds": 123.61,
      "duration_seconds": 3.39,
      "text": "Uh, no, all normal there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.26,
      "end_seconds": 132.62,
      "duration_seconds": 1.36,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.81,
      "end_seconds": 134.97,
      "duration_seconds": 1.16,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.0,
      "end_seconds": 154.84,
      "duration_seconds": 4.84,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.8,
      "end_seconds": 159.21,
      "duration_seconds": 2.41,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.92,
      "end_seconds": 161.23,
      "duration_seconds": 1.31,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.86,
      "end_seconds": 164.95,
      "duration_seconds": 3.09,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.92,
      "end_seconds": 167.11,
      "duration_seconds": 1.19,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.41,
      "end_seconds": 171.55,
      "duration_seconds": 3.14,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.43,
      "end_seconds": 174.04,
      "duration_seconds": 1.61,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.72,
      "end_seconds": 179.37,
      "duration_seconds": 3.65,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.21,
      "end_seconds": 183.93,
      "duration_seconds": 2.72,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.48,
      "end_seconds": 190.05,
      "duration_seconds": 4.57,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.67,
      "end_seconds": 194.35,
      "duration_seconds": 2.68,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.39,
      "end_seconds": 198.69,
      "duration_seconds": 2.3,
      "text": "Migraines, for five years."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.73,
      "end_seconds": 207.56,
      "duration_seconds": 7.83,
      "text": "Right, so migraines is already on your record. We'll keep that in mind today. I'll do your observations first."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.23,
      "end_seconds": 224.03,
      "duration_seconds": 2.8,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.77,
      "end_seconds": 249.15,
      "duration_seconds": 6.38,
      "text": "Okay: saturation 97 percent, BP is 110 over 68, temperature 36.8, pulse 86."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.52,
      "end_seconds": 256.07,
      "duration_seconds": 4.55,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.88,
      "end_seconds": 258.59,
      "duration_seconds": 1.71,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.55,
      "end_seconds": 261.0,
      "duration_seconds": 1.45,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.44,
      "end_seconds": 279.57,
      "duration_seconds": 4.13,
      "text": "Your tummy is soft and not tender between periods."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.02,
      "end_seconds": 297.16,
      "duration_seconds": 12.14,
      "text": "Okay, that's enough for me. Okay, thinking it through, my working impression is primary dysmenorrhoea. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.21,
      "end_seconds": 301.87,
      "duration_seconds": 3.66,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.89,
      "end_seconds": 311.68,
      "duration_seconds": 5.79,
      "text": "Nothing I've seen today points to an emergency. It looks like primary dysmenorrhoea."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.41,
      "end_seconds": 347.57,
      "duration_seconds": 22.16,
      "text": "Heat, gentle exercise, and start the tablet at the first sign of pain. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. Come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.79,
      "end_seconds": 351.88,
      "duration_seconds": 3.09,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.45,
      "end_seconds": 355.69,
      "duration_seconds": 3.24,
      "text": "Let's plan a check in three months."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.14,
      "end_seconds": 362.02,
      "duration_seconds": 2.88,
      "text": "Yes, uh, that's manageable."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.74,
      "end_seconds": 366.91,
      "duration_seconds": 3.17,
      "text": "So, have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 367.92,
      "end_seconds": 372.29,
      "duration_seconds": 4.37,
      "text": "Oh, no, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 372.8,
      "end_seconds": 374.26,
      "duration_seconds": 1.46,
      "text": "Look after yourself."
    }
  ]
}