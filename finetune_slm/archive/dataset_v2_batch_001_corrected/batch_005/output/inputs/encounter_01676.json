{
  "schema_version": "1.0",
  "encounter_id": "01676",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.51,
      "end_seconds": 4.26,
      "duration_seconds": 3.75,
      "text": "evening. Let's get started. Have you been waiting long?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.77,
      "end_seconds": 8.25,
      "duration_seconds": 2.48,
      "text": "only about ten minutes, honestly"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.79,
      "end_seconds": 10.52,
      "duration_seconds": 1.73,
      "text": "what's been worrying you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.05,
      "end_seconds": 19.42,
      "duration_seconds": 7.37,
      "text": "Um, so... pain on the right when I breathe in. That's why I came."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 20.15,
      "end_seconds": 31.99,
      "duration_seconds": 11.84,
      "text": "Okay, so the vitals from earlier. Temperature is 38.9 degrees, weight 82 kilos, heart rate 91. Respiratory rate 19, height 169 centimetres, saturation 96 percent, blood pressure 125 over 80."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.23,
      "end_seconds": 33.93,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.92,
      "end_seconds": 47.65,
      "duration_seconds": 2.73,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.22,
      "end_seconds": 56.87,
      "duration_seconds": 7.65,
      "text": "Probably three weeks. Yeah. And a fever, too. About fever, honestly, all the time."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.8,
      "end_seconds": 62.02,
      "duration_seconds": 4.22,
      "text": "Have you had a productive cough with rusty phlegm?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.03,
      "end_seconds": 80.88,
      "duration_seconds": 16.85,
      "text": "yes, I have with productive cough with rusty phlegm, a six out of ten, I suppose i've been feeling short of breath too, since Monday as for feeling short of breath, honestly, on and off"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.13,
      "end_seconds": 104.14,
      "duration_seconds": 6.01,
      "text": "Alright, did you get recent travel, leg swelling, coughing up blood or confusion?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 106.92,
      "end_seconds": 113.65,
      "duration_seconds": 6.73,
      "text": "no recent travel, leg swelling, coughing up blood or confusion, none of it"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.34,
      "end_seconds": 116.81,
      "duration_seconds": 2.47,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.7,
      "end_seconds": 119.91,
      "duration_seconds": 2.21,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.01,
      "end_seconds": 126.51,
      "duration_seconds": 2.5,
      "text": "Right, is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.34,
      "end_seconds": 130.12,
      "duration_seconds": 1.78,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.51,
      "end_seconds": 150.18,
      "duration_seconds": 6.67,
      "text": "What do you take on a normal day? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.96,
      "end_seconds": 155.32,
      "duration_seconds": 4.36,
      "text": "Naproxen. I take it 250 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.09,
      "end_seconds": 158.92,
      "duration_seconds": 2.83,
      "text": "since when have you been taking it?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.3,
      "end_seconds": 168.73,
      "duration_seconds": 5.43,
      "text": "About nearly five years. I'm on simvastatin, 20 milligrams, at night."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 170.37,
      "end_seconds": 175.46,
      "duration_seconds": 5.09,
      "text": "Doctor, our chart from the last visit lists it as 10 milligrams."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.43,
      "end_seconds": 180.31,
      "duration_seconds": 3.88,
      "text": "Right. Do you happen to have the current prescription here?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.87,
      "end_seconds": 188.14,
      "duration_seconds": 6.27,
      "text": "I don't think I have it with me. Paracetamol, 1 gram, when needed."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.1,
      "end_seconds": 194.85,
      "duration_seconds": 5.75,
      "text": "Has anything ever caused you a a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 198.79,
      "end_seconds": 208.42,
      "duration_seconds": 9.63,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.78,
      "end_seconds": 212.23,
      "duration_seconds": 2.45,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 213.33,
      "end_seconds": 225.22,
      "duration_seconds": 11.89,
      "text": "I've had high blood pressure for about a year now. Arthritis in my knees, for two years. I have high cholesterol, for nearly five years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.45,
      "end_seconds": 229.4,
      "duration_seconds": 2.95,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 230.85,
      "end_seconds": 244.4,
      "duration_seconds": 13.55,
      "text": "I'll have a glass of wine with dinner. No, I've never smoked in my life. I do a yoga class on Thursdays. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.87,
      "end_seconds": 248.44,
      "duration_seconds": 2.57,
      "text": "So, may I examine you now?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.6,
      "end_seconds": 252.37,
      "duration_seconds": 2.77,
      "text": "So, tell me if that's sore."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.01,
      "end_seconds": 275.3,
      "duration_seconds": 6.29,
      "text": "there are crackles at the right base and the breathing is a bit fast"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.83,
      "end_seconds": 306.43,
      "duration_seconds": 27.6,
      "text": "That's the examination finished. Taking everything into account, I think we're dealing with community-acquired pneumonia at this stage. I want to be honest that this is an impression, not a final answer. It could also be acute bronchitis, so we'll keep that open. I'm sending you for blood tests because of pneumonia. I'll request a chest X-ray, it'll help with possible pneumonia."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 307.19,
      "end_seconds": 309.39,
      "duration_seconds": 2.2,
      "text": "Is that done today?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.35,
      "end_seconds": 320.27,
      "duration_seconds": 9.92,
      "text": "What I'm giving you is amoxicillin, 500 milligrams, three times a day, five days. That should help with chest infection."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 321.26,
      "end_seconds": 325.39,
      "duration_seconds": 4.13,
      "text": "can I collect it from my own pharmacy?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 326.34,
      "end_seconds": 340.76,
      "duration_seconds": 14.42,
      "text": "Rest, drink plenty, and come back if you are not improving in two days. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 342.35,
      "end_seconds": 345.29,
      "duration_seconds": 2.94,
      "text": "I know what to watch for."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 347.14,
      "end_seconds": 354.63,
      "duration_seconds": 7.49,
      "text": "we'll catch up in one week okay, I think we're done unless you have questions"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 355.23,
      "end_seconds": 358.58,
      "duration_seconds": 3.35,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 359.18,
      "end_seconds": 361.09,
      "duration_seconds": 1.91,
      "text": "Okay, look after yourself."
    }
  ]
}