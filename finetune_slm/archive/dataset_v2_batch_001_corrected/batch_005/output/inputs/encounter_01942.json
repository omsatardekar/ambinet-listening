{
  "schema_version": "1.0",
  "encounter_id": "01942",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.94,
      "end_seconds": 5.18,
      "duration_seconds": 4.24,
      "text": "Doctor, we're ready in room two, I've already taken the observations."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.11,
      "end_seconds": 11.26,
      "duration_seconds": 4.15,
      "text": "Good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.35,
      "end_seconds": 18.65,
      "duration_seconds": 5.3,
      "text": "Morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 22.36,
      "end_seconds": 30.2,
      "duration_seconds": 7.84,
      "text": "It's heavy bleeding after the birth. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.74,
      "end_seconds": 35.98,
      "duration_seconds": 4.24,
      "text": "so, do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 37.91,
      "end_seconds": 59.47,
      "duration_seconds": 21.56,
      "text": "I'm on alendronate, 70 milligrams, once a week for my bones. I'm on spironolactone, 25 milligrams, once a day. I'm on metformin, 500 milligrams, twice a day for my sugar. It's, It's something called allo... allopurinol, 100 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.82,
      "end_seconds": 64.79,
      "duration_seconds": 3.97,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 70.04,
      "end_seconds": 73.94,
      "duration_seconds": 3.9,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 74.59,
      "end_seconds": 81.63,
      "duration_seconds": 7.04,
      "text": "and the other thing I wanted to mention is that that I can't really—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 81.73,
      "end_seconds": 87.0,
      "duration_seconds": 5.27,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 87.63,
      "end_seconds": 90.29,
      "duration_seconds": 2.66,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.87,
      "end_seconds": 92.83,
      "duration_seconds": 1.96,
      "text": "Have you been feeling faint?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 94.27,
      "end_seconds": 95.93,
      "duration_seconds": 1.66,
      "text": "Yes, since yesterday."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.39,
      "end_seconds": 100.95,
      "duration_seconds": 3.56,
      "text": "so, how much trouble does it give you?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 102.95,
      "end_seconds": 109.3,
      "duration_seconds": 6.35,
      "text": "Well, it's... hard to to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.9,
      "end_seconds": 115.43,
      "duration_seconds": 5.53,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 116.25,
      "end_seconds": 119.97,
      "duration_seconds": 3.72,
      "text": "I'd give it a four, out of ten"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.6,
      "end_seconds": 124.14,
      "duration_seconds": 2.54,
      "text": "Have you been passing large clots?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 125.87,
      "end_seconds": 128.72,
      "duration_seconds": 2.85,
      "text": "Yeah. About a week, I'd say."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.38,
      "end_seconds": 131.93,
      "duration_seconds": 2.55,
      "text": "any severe pain, headache or fever?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 133.14,
      "end_seconds": 136.92,
      "duration_seconds": 3.78,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.81,
      "end_seconds": 139.95,
      "duration_seconds": 2.14,
      "text": "your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 141.36,
      "end_seconds": 144.94,
      "duration_seconds": 3.58,
      "text": "ah, no, my breathing's been fine"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.9,
      "end_seconds": 148.27,
      "duration_seconds": 2.37,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 149.48,
      "end_seconds": 153.63,
      "duration_seconds": 4.15,
      "text": "Nothing on the skin, you know, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.44,
      "end_seconds": 159.01,
      "duration_seconds": 3.57,
      "text": "tell me about any past illnesses or ongoing conditions"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 159.88,
      "end_seconds": 182.0,
      "duration_seconds": 22.12,
      "text": "I've had thin bones for two years now well, uh, I have heart failure, for two years mm, I have diabetes, for nearly five years i'm not great at remembering details, so bear with me it's the not knowing that gets to me"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.71,
      "end_seconds": 184.53,
      "duration_seconds": 0.82,
      "text": "mm-hmm"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 185.13,
      "end_seconds": 187.47,
      "duration_seconds": 2.34,
      "text": "I've got an underactive thyroid."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.29,
      "end_seconds": 190.49,
      "duration_seconds": 1.2,
      "text": "is that everything?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 192.36,
      "end_seconds": 193.99,
      "duration_seconds": 1.63,
      "text": "I've got gout."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.9,
      "end_seconds": 203.8,
      "duration_seconds": 8.9,
      "text": "Alright, heart failure and diabetes, that matches what I have here. Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 205.9,
      "end_seconds": 210.67,
      "duration_seconds": 4.77,
      "text": "Okay, so my brother has epilepsy. My grandmother had dementia."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.74,
      "end_seconds": 218.63,
      "duration_seconds": 2.89,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 219.76,
      "end_seconds": 222.33,
      "duration_seconds": 2.57,
      "text": "I've never had an allergy"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 223.69,
      "end_seconds": 229.66,
      "duration_seconds": 5.97,
      "text": "I'm not sure that's right. I seem to recall a problem with trimethoprim"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 231.03,
      "end_seconds": 234.02,
      "duration_seconds": 2.99,
      "text": "Maybe, but I don't recall it."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.96,
      "end_seconds": 243.07,
      "duration_seconds": 7.11,
      "text": "Alright, so that's unclear. I'll record what each of you said. And alcohol, how much?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 244.49,
      "end_seconds": 247.61,
      "duration_seconds": 3.12,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.52,
      "end_seconds": 250.71,
      "duration_seconds": 1.19,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 251.92,
      "end_seconds": 254.56,
      "duration_seconds": 2.64,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.2,
      "end_seconds": 258.84,
      "duration_seconds": 2.64,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 259.73,
      "end_seconds": 263.57,
      "duration_seconds": 3.84,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.25,
      "end_seconds": 266.47,
      "duration_seconds": 2.22,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 267.65,
      "end_seconds": 270.24,
      "duration_seconds": 2.59,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.08,
      "end_seconds": 273.39,
      "duration_seconds": 2.31,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 274.21,
      "end_seconds": 279.99,
      "duration_seconds": 5.78,
      "text": "Yes, I had an operation for a hernia, last spring."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 297.96,
      "end_seconds": 313.16,
      "duration_seconds": 15.2,
      "text": "Here are the the numbers, doctor. Weight 85 kilos, blood pressure 98 over 64, height 167 centimetres, temperature is 36.7 degrees, BMI works out to 30.5, saturation 98 percent, heart rate 107."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.05,
      "end_seconds": 314.75,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.76,
      "end_seconds": 345.11,
      "duration_seconds": 23.35,
      "text": "from what you've told me, I think we're dealing with a postpartum haemorrhage at this stage. Another possibility is retained tissue. I want urgent blood tests done, that's for haemorrhage. I'd like to arrange an urgent scan for bleeding. I'd rather check than guess, and this is the quickest way to know more"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 345.9,
      "end_seconds": 348.14,
      "duration_seconds": 2.24,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.67,
      "end_seconds": 356.68,
      "duration_seconds": 7.01,
      "text": "What I'm giving you is oxytocin, 10 units, now, single dose. That should help with postpartum bleeding."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 358.76,
      "end_seconds": 362.99,
      "duration_seconds": 4.23,
      "text": "Should I carry on if I feel better?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.82,
      "end_seconds": 374.17,
      "duration_seconds": 10.35,
      "text": "I am rubbing the womb to help it contract, and calling the emergency team. The obstetric team would be the right next step, I'll refer you."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 376.05,
      "end_seconds": 378.73,
      "duration_seconds": 2.68,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.6,
      "end_seconds": 390.59,
      "duration_seconds": 9.99,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Let's review you straight away."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 392.31,
      "end_seconds": 394.79,
      "duration_seconds": 2.48,
      "text": "Oh, I can manage that."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 396.74,
      "end_seconds": 401.84,
      "duration_seconds": 5.1,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 402.91,
      "end_seconds": 406.14,
      "duration_seconds": 3.23,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}