    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.86,
      "end_seconds": 126.57,
      "duration_seconds": 2.71,
      "text": "no, not a single one"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.39,
      "end_seconds": 130.76,
      "duration_seconds": 3.37,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.97,
      "end_seconds": 136.72,
      "duration_seconds": 2.75,
      "text": "Erm, no, joints are fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.04,
      "end_seconds": 143.73,
      "duration_seconds": 5.69,
      "text": "okay, can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.06,
      "end_seconds": 149.21,
      "duration_seconds": 4.15,
      "text": "it's, It's glucose tablets, 4 tablets, when needed"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.52,
      "end_seconds": 165.7,
      "duration_seconds": 4.18,
      "text": "okay any medical conditions anything you've been treated for?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.69,
      "end_seconds": 170.59,
      "duration_seconds": 2.9,
      "text": "no, nothing I can think of"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.7,
      "end_seconds": 184.99,
      "duration_seconds": 1.29,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.72,
      "end_seconds": 188.61,
      "duration_seconds": 2.89,
      "text": "I only drink at family occasions"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.28,
      "end_seconds": 191.11,
      "duration_seconds": 1.83,
      "text": "how active are you?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.7,
      "end_seconds": 195.68,
      "duration_seconds": 3.98,
      "text": "I hardly move around during the day"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.27,
      "end_seconds": 198.69,
      "duration_seconds": 1.42,
      "text": "what's your work?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.68,
      "end_seconds": 204.94,
      "duration_seconds": 4.26,
      "text": "I'm a plumber, lots of bending and kneeling"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.73,
      "end_seconds": 208.67,
      "duration_seconds": 2.94,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.79,
      "end_seconds": 213.06,
      "duration_seconds": 3.27,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.06,
      "end_seconds": 218.59,
      "duration_seconds": 3.53,
      "text": "is there anything relevant on the the family side?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.87,
      "end_seconds": 223.01,
      "duration_seconds": 3.14,
      "text": "My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.32,
      "end_seconds": 231.02,
      "duration_seconds": 4.7,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.74,
      "end_seconds": 237.31,
      "duration_seconds": 5.57,
      "text": "Yes nickel it gives me a rash on my skin."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.2,
      "end_seconds": 243.39,
      "duration_seconds": 4.19,
      "text": "let me look at the the area, I'll be gentle"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.83,
      "end_seconds": 247.51,
      "duration_seconds": 2.68,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.83,
      "end_seconds": 271.44,
      "duration_seconds": 7.61,
      "text": "Your sugar reading in clinic is on the low side and your pulse is a little fast."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.55,
      "end_seconds": 277.75,
      "duration_seconds": 1.2,
      "text": "okay, doctor"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.9,
      "end_seconds": 303.29,
      "duration_seconds": 20.39,
      "text": "that's all I needed to check. Right, here's what I'm thinking. The most likely explanation is recurrent low blood sugar on insulin. A download of the glucose meter is what I'd like next, for hypoglycaemia. I think an HbA1c makes sense here, for diabetes review"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.38,
      "end_seconds": 307.53,
      "duration_seconds": 2.15,
      "text": "okay, I'll do it"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.12,
      "end_seconds": 338.01,
      "duration_seconds": 28.89,
      "text": "I'm going to put you on insulin glargine, 16 units, once a day at bedtime, long term it's for diabetes always carry sugar and eat something before exercise try to get to bed and wake up at the same time each day, and keep your phone away from the bed i'm going to send a referral to the diabetes team we'll catch up in two weeks"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.37,
      "end_seconds": 340.07,
      "duration_seconds": 0.7,
      "text": "sure"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.13,
      "end_seconds": 344.68,
      "duration_seconds": 3.55,
      "text": "that's everything on my side anything you're unsure about?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.57,
      "end_seconds": 350.66,
      "duration_seconds": 2.09,
      "text": "alright thanks take care"
