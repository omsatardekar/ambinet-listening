      "start_seconds": 71.53,
      "end_seconds": 73.95,
      "duration_seconds": 2.42,
      "text": "okay when did this begin?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.03,
      "end_seconds": 80.72,
      "duration_seconds": 5.69,
      "text": "Around about a month... no wait, it's more like two months."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.64,
      "end_seconds": 86.07,
      "duration_seconds": 3.43,
      "text": "is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.01,
      "end_seconds": 94.65,
      "duration_seconds": 6.64,
      "text": "I'd call it severe. I've been sweating too, uh, for six months."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.55,
      "end_seconds": 111.8,
      "duration_seconds": 4.25,
      "text": "have you had any vomiting or loss of consciousness?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.37,
      "end_seconds": 116.64,
      "duration_seconds": 3.27,
      "text": "no, no vomiting or loss of consciousness"
