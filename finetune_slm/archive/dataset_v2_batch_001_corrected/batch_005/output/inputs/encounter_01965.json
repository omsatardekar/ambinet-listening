      "start_seconds": 44.52,
      "end_seconds": 52.6,
      "duration_seconds": 8.08,
      "text": "okay: temperature is 36.7 degrees, weight 91 kilos, pressure 112 over 84, height 182 centimetres, heart rate 118."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
