{
  "schema_version": "1.0",
  "encounter_id": "01535",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.65,
      "end_seconds": 4.01,
      "duration_seconds": 3.36,
      "text": "Come in, have a seat by the desk."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.95,
      "end_seconds": 9.06,
      "duration_seconds": 1.11,
      "text": "Evening, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 10.0,
      "end_seconds": 14.9,
      "duration_seconds": 4.9,
      "text": "So, good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.31,
      "end_seconds": 22.89,
      "duration_seconds": 6.58,
      "text": "Good, that'll be useful. Pull up a chair. Alright, where shall we begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 23.48,
      "end_seconds": 30.18,
      "duration_seconds": 6.7,
      "text": "doctor, it's a sore on my ankle that won't heal that's what we're worried about"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.06,
      "end_seconds": 34.93,
      "duration_seconds": 3.87,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.64,
      "end_seconds": 39.38,
      "duration_seconds": 2.74,
      "text": "I've had it for two weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.5,
      "end_seconds": 42.22,
      "duration_seconds": 1.72,
      "text": "Anything that improves it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.14,
      "end_seconds": 48.26,
      "duration_seconds": 4.12,
      "text": "okay, so only elevation, and it's not much"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.16,
      "end_seconds": 53.39,
      "duration_seconds": 3.23,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 55.19,
      "end_seconds": 56.73,
      "duration_seconds": 1.54,
      "text": "It's severe, honestly."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.39,
      "end_seconds": 59.86,
      "duration_seconds": 2.47,
      "text": "any aching legs as well?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 63.04,
      "end_seconds": 66.2,
      "duration_seconds": 3.16,
      "text": "yeah. About two weeks, I'd say"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.85,
      "end_seconds": 70.67,
      "duration_seconds": 2.82,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 71.32,
      "end_seconds": 74.69,
      "duration_seconds": 3.37,
      "text": "it feels moderate to to me"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.26,
      "end_seconds": 76.71,
      "duration_seconds": 1.45,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.44,
      "end_seconds": 98.13,
      "duration_seconds": 19.69,
      "text": "I've had itchy brown skin on the shin too, uh, for about two weeks. And there's swollen legs by evening as well, two weeks now. With swollen legs by evening, it's a couple of times a week"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.64,
      "end_seconds": 107.18,
      "duration_seconds": 8.54,
      "text": "Have you had a sore on your ankle that won't heal before, or is this the the first time?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.01,
      "end_seconds": 115.33,
      "duration_seconds": 7.32,
      "text": "I had a similar thing a couple of years ago. It went away."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.71,
      "end_seconds": 131.15,
      "duration_seconds": 3.44,
      "text": "A few quick ones: fever or spreading redness?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.46,
      "end_seconds": 135.42,
      "duration_seconds": 2.96,
      "text": "no, no fever or spreading redness"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.2,
      "end_seconds": 140.09,
      "duration_seconds": 3.89,
      "text": "A few quick ones: chest pain or calf pain?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.99,
      "end_seconds": 148.24,
      "duration_seconds": 4.25,
      "text": "No chest pain or calf pain, none of it."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.2,
      "end_seconds": 152.19,
      "duration_seconds": 2.99,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 156.72,
      "end_seconds": 159.7,
      "duration_seconds": 2.98,
      "text": "no, uh, all normal there"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.28,
      "end_seconds": 172.03,
      "duration_seconds": 4.75,
      "text": "tell me about your routine, work, habits, that sort of thing"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.42,
      "end_seconds": 181.92,
      "duration_seconds": 8.5,
      "text": "My partner and our baby. I look after my grandchildren most days. I swim twice a week."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.71,
      "end_seconds": 184.98,
      "duration_seconds": 2.27,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 185.72,
      "end_seconds": 200.44,
      "duration_seconds": 14.72,
      "text": "She is on omeprazole, 20 milligrams, once a day for the reflux, I give it to her. I mean, it's sumatriptan, 50 milligrams, when needed for my migraines, doctor."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.12,
      "end_seconds": 217.25,
      "duration_seconds": 4.13,
      "text": "what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 219.24,
      "end_seconds": 230.14,
      "duration_seconds": 10.9,
      "text": "I've had acid reflux for five years now. My family kept telling me to get it checked. I've had migraines, yes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.52,
      "end_seconds": 243.61,
      "duration_seconds": 12.09,
      "text": "Sure. Right, so acid reflux is already on your record. We'll keep that in mind today. Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 245.17,
      "end_seconds": 249.14,
      "duration_seconds": 3.97,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 249.72,
      "end_seconds": 257.53,
      "duration_seconds": 7.81,
      "text": "Hmm, hold on, doctor, I think she reacted to naproxen once. I'm not certain, though."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 259.15,
      "end_seconds": 262.03,
      "duration_seconds": 2.88,
      "text": "Maybe, but I don't recall it."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.63,
      "end_seconds": 267.06,
      "duration_seconds": 4.43,
      "text": "Alright, so that's unclear. I'll record what each of you said."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.36,
      "end_seconds": 274.82,
      "duration_seconds": 5.46,
      "text": "I'd like to to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 275.93,
      "end_seconds": 277.59,
      "duration_seconds": 1.66,
      "text": "yes, that's fine"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.93,
      "end_seconds": 281.25,
      "duration_seconds": 2.32,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.61,
      "end_seconds": 306.31,
      "duration_seconds": 7.7,
      "text": "there is a shallow ulcer above the inner ankle with brown skin around it and visible varicose veins"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 308.38,
      "end_seconds": 309.44,
      "duration_seconds": 1.06,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 313.59,
      "end_seconds": 327.52,
      "duration_seconds": 13.93,
      "text": "Good, you can sit up again. So, to recap quickly. You've had a sore on your ankle that won't heal for two weeks, severe, and no spreading redness or calf pain."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 329.24,
      "end_seconds": 329.94,
      "duration_seconds": 0.7,
      "text": "exactly"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 331.24,
      "end_seconds": 354.15,
      "duration_seconds": 22.91,
      "text": "I want a wound swab done, that's for leg ulcer. I'll request a doppler test of the leg pulses, it'll help with leg ulcer. Compression bandaging and keeping the leg raised when sitting. Come back in two weeks. Tell me what you've taken from all that, so I can fill in any gaps"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 355.92,
      "end_seconds": 360.51,
      "duration_seconds": 4.59,
      "text": "So, I come back in two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 362.23,
      "end_seconds": 366.52,
      "duration_seconds": 4.29,
      "text": "Yes, exactly right. Does all of that that make sense?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 367.88,
      "end_seconds": 371.29,
      "duration_seconds": 3.41,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 373.16,
      "end_seconds": 375.71,
      "duration_seconds": 2.55,
      "text": "Alright, have a good day."
    }
  ]
}