{
  "schema_version": "1.0",
  "encounter_id": "01633",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.95,
      "end_seconds": 3.53,
      "duration_seconds": 2.58,
      "text": "Alright, hi, sit anywhere you like."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.72,
      "end_seconds": 9.52,
      "duration_seconds": 4.8,
      "text": "Hi doctor, I got here as fast as I could."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.33,
      "end_seconds": 15.95,
      "duration_seconds": 4.62,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.84,
      "end_seconds": 22.05,
      "duration_seconds": 3.21,
      "text": "So what can I do for you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 23.71,
      "end_seconds": 30.06,
      "duration_seconds": 6.35,
      "text": "We came because of a fall and pain in my left hip."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.64,
      "end_seconds": 36.87,
      "duration_seconds": 3.23,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.4,
      "end_seconds": 40.56,
      "duration_seconds": 2.16,
      "text": "About... well, ten days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.44,
      "end_seconds": 51.7,
      "duration_seconds": 9.26,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 53.35,
      "end_seconds": 59.46,
      "duration_seconds": 6.11,
      "text": "Uh, it settles a little with lying still. I'd call it severe."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.87,
      "end_seconds": 64.23,
      "duration_seconds": 3.36,
      "text": "Right, does anything else come with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 69.07,
      "end_seconds": 75.05,
      "duration_seconds": 5.98,
      "text": "Not being able to stand goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.67,
      "end_seconds": 79.7,
      "duration_seconds": 3.03,
      "text": "Have you had pain in your groin?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.77,
      "end_seconds": 94.84,
      "duration_seconds": 14.07,
      "text": "Yeah. One week, I'd say. As for pain in my groin, pretty mild, if I'm being honest. The not being able to stand? That's been for about a month."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.11,
      "end_seconds": 104.0,
      "duration_seconds": 2.89,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.11,
      "end_seconds": 120.57,
      "duration_seconds": 3.46,
      "text": "Okay, bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.51,
      "end_seconds": 137.55,
      "duration_seconds": 6.04,
      "text": "Okay: temp 36.9 degrees, heart rate 70, blood pressure 110 over 75."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.44,
      "end_seconds": 143.4,
      "duration_seconds": 3.96,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.22,
      "end_seconds": 147.89,
      "duration_seconds": 2.67,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.19,
      "end_seconds": 164.59,
      "duration_seconds": 6.4,
      "text": "The left leg is shortened and turned outwards, and it is very painful to move."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.49,
      "end_seconds": 166.55,
      "duration_seconds": 1.06,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.59,
      "end_seconds": 178.04,
      "duration_seconds": 7.45,
      "text": "All finished, thank you. A few quick ones: loss of consciousness, head injury or chest pain?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 179.64,
      "end_seconds": 185.4,
      "duration_seconds": 5.76,
      "text": "No, no loss of consciousness, head injury or chest pain."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.41,
      "end_seconds": 188.41,
      "duration_seconds": 2.0,
      "text": "Has there been any numbness?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 189.25,
      "end_seconds": 190.75,
      "duration_seconds": 1.5,
      "text": "Nope, no numbness."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.54,
      "end_seconds": 195.14,
      "duration_seconds": 2.6,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 196.44,
      "end_seconds": 199.07,
      "duration_seconds": 2.63,
      "text": "No, you know, nothing there."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.84,
      "end_seconds": 218.81,
      "duration_seconds": 2.97,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 219.43,
      "end_seconds": 221.81,
      "duration_seconds": 2.38,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.67,
      "end_seconds": 228.57,
      "duration_seconds": 4.9,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 229.39,
      "end_seconds": 238.33,
      "duration_seconds": 8.94,
      "text": "Alendronate. I take it 70 milligrams, once a week. I'm on paracetamol, 1 gram, when needed."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.1,
      "end_seconds": 242.92,
      "duration_seconds": 2.82,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 243.54,
      "end_seconds": 250.22,
      "duration_seconds": 6.68,
      "text": "Yes, I had a mole taken off my arm, a few years ago."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.84,
      "end_seconds": 262.37,
      "duration_seconds": 4.53,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 262.9,
      "end_seconds": 273.0,
      "duration_seconds": 10.1,
      "text": "I'm a plumber, lots of bending and kneeling. My partner and our baby. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.97,
      "end_seconds": 279.57,
      "duration_seconds": 4.6,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 280.87,
      "end_seconds": 285.02,
      "duration_seconds": 4.15,
      "text": "No, uh, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.21,
      "end_seconds": 290.12,
      "duration_seconds": 3.91,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 291.45,
      "end_seconds": 306.16,
      "duration_seconds": 14.71,
      "text": "Thin bones, for about ten years. I've been reading about it online and it worried me. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 321.53,
      "end_seconds": 325.94,
      "duration_seconds": 4.41,
      "text": "We should do an X-ray of the hip for hip fracture."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 327.4,
      "end_seconds": 328.84,
      "duration_seconds": 1.44,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 332.58,
      "end_seconds": 342.27,
      "duration_seconds": 9.69,
      "text": "I'll request blood tests, it'll help with pre-operative. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 343.66,
      "end_seconds": 345.13,
      "duration_seconds": 1.47,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 346.48,
      "end_seconds": 375.18,
      "duration_seconds": 28.7,
      "text": "What I'm giving you is morphine, 2.5 milligrams, now, single dose. That should help with hip pain. Lie still, I am arranging an ambulance and pain relief. Don't skip meals, and try to eat smaller portions more often through the day. We'll refer you to the orthopaedic team. See me again straight away. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 376.64,
      "end_seconds": 379.59,
      "duration_seconds": 2.95,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}