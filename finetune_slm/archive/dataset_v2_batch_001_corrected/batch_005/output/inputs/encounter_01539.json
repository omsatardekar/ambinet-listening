      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.72,
      "end_seconds": 61.06,
      "duration_seconds": 11.34,
      "text": "When it starts I tend to get being unable to lie flat as well. The being unable to lie flat? That's been for three days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.59,
      "end_seconds": 67.85,
      "duration_seconds": 3.26,
      "text": "okay, any cough, fever or leg swelling?"
