      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.64,
      "end_seconds": 47.93,
      "duration_seconds": 2.29,
      "text": "Is it accompanied by anything?"
