    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.07,
      "end_seconds": 93.06,
      "duration_seconds": 3.99,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.16,
      "end_seconds": 98.85,
      "duration_seconds": 2.69,
      "text": "my grandfather had a stroke"
