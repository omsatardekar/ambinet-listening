    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.73,
      "end_seconds": 237.32,
      "duration_seconds": 2.59,
      "text": "We'll look at it together shortly."
