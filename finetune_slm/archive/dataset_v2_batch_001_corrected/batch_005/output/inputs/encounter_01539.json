      "role": "DOCTOR",
      "start_seconds": 182.16,
      "end_seconds": 184.78,
      "duration_seconds": 2.62,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.56,
      "end_seconds": 187.97,
      "duration_seconds": 2.41,
      "text": "I've never had an allergy."
