      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.06,
      "end_seconds": 119.95,
      "duration_seconds": 3.89,
      "text": "do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.19,
      "end_seconds": 128.21,
