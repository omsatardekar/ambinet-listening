    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.06,
      "end_seconds": 192.75,
      "duration_seconds": 2.69,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.5,
      "end_seconds": 202.46,
      "duration_seconds": 1.96,
      "text": "Nearly done with the readings..."
