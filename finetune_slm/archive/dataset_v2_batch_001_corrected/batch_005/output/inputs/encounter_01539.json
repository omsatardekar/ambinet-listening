    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.4,
      "end_seconds": 242.52,
      "duration_seconds": 4.12,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.92,
      "end_seconds": 245.13,
      "duration_seconds": 1.21,
      "text": "does that hurt?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.38,
      "end_seconds": 263.0,
      "duration_seconds": 8.62,
      "text": "your windpipe is pushed to the right, there is no breath sound on the left, and your pressure is dropping"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.87,
      "end_seconds": 269.06,
      "duration_seconds": 3.19,
      "text": "Right, thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.88,
      "end_seconds": 305.42,
      "duration_seconds": 22.54,
      "text": "Let me tell you where I've got to. My working impression is a collapsed lung under pressure. Let's get an urgent chest decompression, for tension pneumothorax. Stay sitting up, I need to relieve the pressure in your chest right now. We'll catch up straight away. Right, does all of that make sense?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.22,
      "end_seconds": 310.19,
      "duration_seconds": 2.97,
      "text": "Alright, um, thanks, take care."
    }
  ]
