      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.37,
      "end_seconds": 70.74,
      "duration_seconds": 2.37,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.59,
      "end_seconds": 76.18,
