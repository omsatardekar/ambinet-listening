      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.32,
      "end_seconds": 229.54,
      "duration_seconds": 11.22,
      "text": "okay: temperature is 37.4 degrees, SpO2 89 percent on room air and blood pressure 126 over 89, heart rate 85, respiratory rate 26."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.93,
      "end_seconds": 232.95,
      "duration_seconds": 2.02,
      "text": "Is that alright, doctor?"
