      "start_seconds": 147.62,
      "end_seconds": 150.65,
      "duration_seconds": 3.03,
      "text": "are you in work at the moment?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.07,
      "end_seconds": 156.46,
      "duration_seconds": 4.39,
      "text": "Yes, I work in a bakery, early starts."
