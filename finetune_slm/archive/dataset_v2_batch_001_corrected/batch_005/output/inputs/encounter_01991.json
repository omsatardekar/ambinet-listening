  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.55,
      "end_seconds": 2.31,
      "duration_seconds": 1.76,
      "text": "Evening. Let's get started."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 2.95,
      "end_seconds": 6.22,
      "duration_seconds": 3.27,
      "text": "hello, thanks for fitting me in"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.61,
      "end_seconds": 10.12,
      "duration_seconds": 2.51,
      "text": "tell me what's brought you in"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.13,
      "end_seconds": 16.83,
      "duration_seconds": 4.7,
      "text": "I've been dealing with heavy bleeding after the birth."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.66,
      "end_seconds": 22.28,
      "duration_seconds": 3.62,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.67,
      "end_seconds": 37.6,
      "duration_seconds": 2.93,
      "text": "right, sit still for a moment.."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 49.52,
      "end_seconds": 54.9,
      "duration_seconds": 5.38,
      "text": "okay: SpO2 96 percent on room air, pulse 95, pressure 96 over 56."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 56.13,
      "end_seconds": 57.6,
      "duration_seconds": 1.47,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 58.78,
      "end_seconds": 61.69,
      "duration_seconds": 2.91,
      "text": "Alright, we'll look at it together shortly."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.91,
      "end_seconds": 62.61,
      "duration_seconds": 0.7,
      "text": "yes"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.38,
      "end_seconds": 91.4,
      "duration_seconds": 15.02,
      "text": "Oh, and a racing heart. That's been about the same, five days. About racing heart, I'd say moderate. I've been passing large clots too, for four weeks."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.99,
      "end_seconds": 97.01,
      "duration_seconds": 4.02,
      "text": "Have you noticed severe pain, fever or headache?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.65,
      "end_seconds": 103.0,
      "duration_seconds": 4.35,
      "text": "I haven't had severe pain, fever or headache, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.87,
      "end_seconds": 105.38,
      "duration_seconds": 1.51,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 106.57,
      "end_seconds": 108.65,
      "duration_seconds": 2.08,
      "text": "no, nothing like that"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.47,
      "end_seconds": 112.66,
      "duration_seconds": 3.19,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 114.33,
      "end_seconds": 115.39,
      "duration_seconds": 1.06,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.29,
      "end_seconds": 120.57,
      "duration_seconds": 3.28,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.61,
      "end_seconds": 126.33,
      "duration_seconds": 3.72,
      "text": "Just my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.36,
      "end_seconds": 138.45,
      "duration_seconds": 2.09,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.76,
      "end_seconds": 143.89,
      "duration_seconds": 4.13,
      "text": "My husband and I live above the shop"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.95,
      "end_seconds": 147.17,
      "duration_seconds": 1.22,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 149.23,
      "end_seconds": 153.31,
      "duration_seconds": 4.08,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.41,
      "end_seconds": 156.86,
      "duration_seconds": 2.45,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.24,
      "end_seconds": 163.95,
      "duration_seconds": 5.71,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.53,
      "end_seconds": 184.54,
      "duration_seconds": 3.01,
      "text": "has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 186.43,
      "end_seconds": 188.4,
      "duration_seconds": 1.97,
      "text": "Depression, for two years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.19,
      "end_seconds": 202.55,
      "duration_seconds": 10.36,
      "text": "Understood. Yes, depression is known to us, good to have that clear. Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 203.66,
      "end_seconds": 208.68,
      "duration_seconds": 5.02,
      "text": "It's fluoxetine, 20 milligrams, every morning for my mood."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.16,
      "end_seconds": 228.46,
      "duration_seconds": 18.3,
      "text": "Okay, so my impression from what you've said is this: I think we're dealing with a postpartum haemorrhage at this stage. The reason I say that is that the way you describe it fits together. I'd also keep retained tissue in mind."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 229.55,
      "end_seconds": 232.52,
      "duration_seconds": 2.97,
      "text": "is there something to worry about?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.07,
      "end_seconds": 266.36,
      "duration_seconds": 32.29,
      "text": "It's reasonable to be concerned, but right now a postpartum haemorrhage is my leading thought, not anything worse. Urgent blood tests is what I'd like next, for haemorrhage. An urgent scan is what I'd like next, for bleeding. I'd rather check than guess, and this is the quickest way to know more. The treatment will be oxytocin, 10 units, now, single dose. That should help with postpartum bleeding."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 267.53,
      "end_seconds": 269.71,
      "duration_seconds": 2.18,
      "text": "fine, I'll begin it"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.68,
      "end_seconds": 287.26,
      "duration_seconds": 15.58,
      "text": "I am rubbing the womb to help it contract, and calling the emergency team. Come back or go to emergency straight away if the symptoms get worse. Let's review you straight away."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 292.68,
      "end_seconds": 293.38,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.73,
      "end_seconds": 297.68,
      "duration_seconds": 2.95,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 298.37,
      "end_seconds": 301.3,
      "duration_seconds": 2.93,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}