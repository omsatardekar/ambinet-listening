{
  "schema_version": "1.0",
  "encounter_id": "01852",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.1,
      "end_seconds": 5.03,
      "duration_seconds": 3.93,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.82,
      "end_seconds": 10.7,
      "duration_seconds": 4.88,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.66,
      "end_seconds": 13.82,
      "duration_seconds": 2.16,
      "text": "It's a fever, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.53,
      "end_seconds": 19.8,
      "duration_seconds": 4.27,
      "text": "Alright, which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.33,
      "end_seconds": 25.73,
      "duration_seconds": 4.4,
      "text": "I take paracetamol syrup, 10 ml, every six hours."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.53,
      "end_seconds": 35.9,
      "duration_seconds": 1.37,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.78,
      "end_seconds": 41.57,
      "duration_seconds": 3.79,
      "text": "It's been going on for six months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.15,
      "end_seconds": 46.58,
      "duration_seconds": 4.43,
      "text": "Did you get ear pain, rash or difficulty breathing?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.83,
      "end_seconds": 53.31,
      "duration_seconds": 5.48,
      "text": "No ear pain, rash or difficulty breathing, none of it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.04,
      "end_seconds": 58.45,
      "duration_seconds": 3.41,
      "text": "So, and your skin, any changes there?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.03,
      "end_seconds": 61.1,
      "duration_seconds": 1.07,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.99,
      "end_seconds": 65.89,
      "duration_seconds": 2.9,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.99,
      "end_seconds": 70.94,
      "duration_seconds": 0.95,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.75,
      "end_seconds": 91.47,
      "duration_seconds": 2.72,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.24,
      "end_seconds": 96.64,
      "duration_seconds": 4.4,
      "text": "Um, um, my father had bowel cancer."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.35,
      "end_seconds": 101.01,
      "duration_seconds": 2.66,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.9,
      "end_seconds": 107.09,
      "duration_seconds": 4.19,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.5,
      "end_seconds": 109.95,
      "duration_seconds": 1.45,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.82,
      "end_seconds": 113.81,
      "duration_seconds": 2.99,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.64,
      "end_seconds": 117.58,
      "duration_seconds": 1.94,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.32,
      "end_seconds": 120.77,
      "duration_seconds": 2.45,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.48,
      "end_seconds": 138.24,
      "duration_seconds": 3.76,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.76,
      "end_seconds": 143.93,
      "duration_seconds": 5.17,
      "text": "Amoxicillin. I come out in... well, a rash all over."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.78,
      "end_seconds": 156.22,
      "duration_seconds": 3.44,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.83,
      "end_seconds": 161.27,
      "duration_seconds": 3.44,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.24,
      "end_seconds": 165.31,
      "duration_seconds": 2.07,
      "text": "Right, any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.92,
      "end_seconds": 170.85,
      "duration_seconds": 4.93,
      "text": "Um, you know, no, I've never been operated on."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.36,
      "end_seconds": 173.33,
      "duration_seconds": 1.97,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.85,
      "end_seconds": 188.57,
      "duration_seconds": 2.72,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.01,
      "end_seconds": 212.84,
      "duration_seconds": 9.83,
      "text": "Okay: SpO2 98 percent on room air, pulse 95, temperature 39.0, respiratory rate 16, blood pressure 104 over 70."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.51,
      "end_seconds": 216.17,
      "duration_seconds": 1.66,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.06,
      "end_seconds": 221.49,
      "duration_seconds": 3.43,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.74,
      "end_seconds": 227.59,
      "duration_seconds": 4.85,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.9,
      "end_seconds": 231.13,
      "duration_seconds": 2.23,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.15,
      "end_seconds": 249.58,
      "duration_seconds": 7.43,
      "text": "The tonsils are large and red with white spots, and the neck glands are tender."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.2,
      "end_seconds": 288.6,
      "duration_seconds": 33.4,
      "text": "Thank you, you can get dressed. Taking everything into account, I think we're dealing with tonsillitis at this stage. A throat swab is what I'd like next, for recurrent tonsillitis. I'd rather check than guess, and this is the quickest way to know more. Plenty of fluids and soft foods, and he can return to school when the fever has gone. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.41,
      "end_seconds": 292.37,
      "duration_seconds": 2.96,
      "text": "We'll refer you to the ENT clinic."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.07,
      "end_seconds": 293.77,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.54,
      "end_seconds": 301.15,
      "duration_seconds": 5.61,
      "text": "Please don't wait if the symptoms get worse. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.66,
      "end_seconds": 304.4,
      "duration_seconds": 1.74,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.22,
      "end_seconds": 310.61,
      "duration_seconds": 3.39,
      "text": "Book a review if recurrent, tonsil review."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.3,
      "end_seconds": 318.44,
      "duration_seconds": 3.14,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.37,
      "end_seconds": 323.59,
      "duration_seconds": 3.22,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.79,
      "end_seconds": 327.99,
      "duration_seconds": 3.2,
      "text": "Erm, alright, thanks, take care."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.47,
      "end_seconds": 330.82,
      "duration_seconds": 1.35,
      "text": "See you soon."
    }
  ]
}