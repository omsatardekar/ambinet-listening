{
  "schema_version": "1.0",
  "encounter_id": "01990",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.37,
      "end_seconds": 6.3,
      "duration_seconds": 4.93,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.96,
      "end_seconds": 11.44,
      "duration_seconds": 4.48,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.64,
      "end_seconds": 28.43,
      "duration_seconds": 15.79,
      "text": "I wanted to get thoughts of ending my life looked at. I thought it would sort itself out, but it hasn't. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.11,
      "end_seconds": 31.67,
      "duration_seconds": 2.56,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.02,
      "end_seconds": 43.68,
      "duration_seconds": 2.66,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.97,
      "end_seconds": 63.12,
      "duration_seconds": 8.15,
      "text": "Okay: pressure 122 over 69, respiratory rate 14, oxygen saturation is 98 percent, heart rate 69."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.02,
      "end_seconds": 81.93,
      "duration_seconds": 1.91,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.13,
      "end_seconds": 93.33,
      "duration_seconds": 6.2,
      "text": "Three weeks, I think... sorry, about a week, I got that wrong."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.87,
      "end_seconds": 99.03,
      "duration_seconds": 5.16,
      "text": "Hm, okay. Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.83,
      "end_seconds": 110.4,
      "duration_seconds": 9.57,
      "text": "Moderate, I'd say. Oh, uh, and not sleeping for days. As for not sleeping for days, severe, really."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.47,
      "end_seconds": 117.49,
      "duration_seconds": 6.02,
      "text": "Have you had thoughts of ending your life before, or is this the first time?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.77,
      "end_seconds": 125.97,
      "duration_seconds": 7.2,
      "text": "Yes, something like this happened last year, and it went away on its own."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.91,
      "end_seconds": 132.44,
      "duration_seconds": 5.53,
      "text": "A few quick ones: having taken tablets, recent loss, drinking or hearing voices?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.24,
      "end_seconds": 141.05,
      "duration_seconds": 7.81,
      "text": "I, I haven't had having taken tablets, recent loss, drinking or hearing voices, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.21,
      "end_seconds": 144.55,
      "duration_seconds": 2.34,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.25,
      "end_seconds": 147.36,
      "duration_seconds": 1.11,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.02,
      "end_seconds": 155.99,
      "duration_seconds": 2.97,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.22,
      "end_seconds": 158.82,
      "duration_seconds": 1.6,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.23,
      "end_seconds": 162.97,
      "duration_seconds": 2.74,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.93,
      "end_seconds": 167.86,
      "duration_seconds": 3.93,
      "text": "No, um, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.41,
      "end_seconds": 170.49,
      "duration_seconds": 2.08,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.34,
      "end_seconds": 179.86,
      "duration_seconds": 7.52,
      "text": "I take something called sert... sertraline, 50 milligrams, maybe, once a day for my mood."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.24,
      "end_seconds": 185.88,
      "duration_seconds": 4.64,
      "text": "Alright, have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.59,
      "end_seconds": 191.53,
      "duration_seconds": 3.94,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.9,
      "end_seconds": 211.41,
      "duration_seconds": 4.51,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.01,
      "end_seconds": 224.55,
      "duration_seconds": 11.54,
      "text": "My husband and I live above the shop. I grab fast food at lunch most days. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.2,
      "end_seconds": 230.07,
      "duration_seconds": 3.87,
      "text": "Alright, is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.44,
      "end_seconds": 233.55,
      "duration_seconds": 2.11,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.18,
      "end_seconds": 238.28,
      "duration_seconds": 3.1,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.93,
      "end_seconds": 248.55,
      "duration_seconds": 6.62,
      "text": "Yes, I had my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.6,
      "end_seconds": 252.09,
      "duration_seconds": 2.49,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.58,
      "end_seconds": 256.13,
      "duration_seconds": 2.55,
      "text": "Depression, for nearly five years."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.22,
      "end_seconds": 262.76,
      "duration_seconds": 5.54,
      "text": "Yes, depression is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.57,
      "end_seconds": 268.44,
      "duration_seconds": 2.87,
      "text": "Alright, may I examine you now?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.14,
      "end_seconds": 272.02,
      "duration_seconds": 1.88,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.82,
      "end_seconds": 295.97,
      "duration_seconds": 7.15,
      "text": "You are calm but very flat, and you have thought through how you would do it."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.93,
      "end_seconds": 301.39,
      "duration_seconds": 2.46,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.98,
      "end_seconds": 323.47,
      "duration_seconds": 12.49,
      "text": "Taking everything into account, it points towards a high risk of suicide needing urgent assessment. I'd like to arrange an urgent mental health assessment for suicidal thoughts."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 325.2,
      "end_seconds": 330.27,
      "duration_seconds": 5.07,
      "text": "We have a slot Monday at 10 am, if that works."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.1,
      "end_seconds": 345.69,
      "duration_seconds": 11.59,
      "text": "I want you to stay with me while we arrange help, and your family will be called. I think the crisis team should see you too."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.88,
      "end_seconds": 348.59,
      "duration_seconds": 1.71,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.96,
      "end_seconds": 358.28,
      "duration_seconds": 8.32,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.68,
      "end_seconds": 361.14,
      "duration_seconds": 1.46,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.06,
      "end_seconds": 363.91,
      "duration_seconds": 1.85,
      "text": "Come back straight away."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 364.79,
      "end_seconds": 365.49,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.59,
      "end_seconds": 369.27,
      "duration_seconds": 2.68,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 370.75,
      "end_seconds": 372.27,
      "duration_seconds": 1.52,
      "text": "That's clear, thanks."
    }
  ]
}