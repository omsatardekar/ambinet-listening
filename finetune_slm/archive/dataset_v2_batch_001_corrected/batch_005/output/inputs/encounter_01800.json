{
  "schema_version": "1.0",
  "encounter_id": "01800",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.59,
      "end_seconds": 5.56,
      "duration_seconds": 4.97,
      "text": "Doctor, if you're free, we can start. I've got the numbers noted down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.92,
      "end_seconds": 11.06,
      "duration_seconds": 4.14,
      "text": "Okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 12.29,
      "end_seconds": 19.33,
      "duration_seconds": 7.04,
      "text": "Yeah, it's the worst headache of my life. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.82,
      "end_seconds": 27.11,
      "duration_seconds": 3.29,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 28.54,
      "end_seconds": 31.9,
      "duration_seconds": 3.36,
      "text": "For about four days, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.91,
      "end_seconds": 42.25,
      "duration_seconds": 4.34,
      "text": "Okay, is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 42.95,
      "end_seconds": 45.84,
      "duration_seconds": 2.89,
      "text": "Pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.58,
      "end_seconds": 50.01,
      "duration_seconds": 3.43,
      "text": "Has there been coming on in seconds too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 51.03,
      "end_seconds": 55.04,
      "duration_seconds": 4.01,
      "text": "Yeah. Six months, you know, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.26,
      "end_seconds": 59.54,
      "duration_seconds": 3.28,
      "text": "Any head injury, weakness or fever at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 61.1,
      "end_seconds": 63.63,
      "duration_seconds": 2.53,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.36,
      "end_seconds": 67.69,
      "duration_seconds": 2.33,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 73.75,
      "end_seconds": 75.66,
      "duration_seconds": 1.91,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.36,
      "end_seconds": 78.53,
      "duration_seconds": 2.17,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 83.46,
      "end_seconds": 85.56,
      "duration_seconds": 2.1,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.05,
      "end_seconds": 90.68,
      "duration_seconds": 3.63,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 91.63,
      "end_seconds": 95.42,
      "duration_seconds": 3.79,
      "text": "I'm allergic to trimethoprim, I get itching."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.23,
      "end_seconds": 108.35,
      "duration_seconds": 3.12,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 110.23,
      "end_seconds": 114.71,
      "duration_seconds": 4.48,
      "text": "Yes, I had my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.01,
      "end_seconds": 135.62,
      "duration_seconds": 3.61,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 137.5,
      "end_seconds": 139.26,
      "duration_seconds": 1.76,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.82,
      "end_seconds": 142.37,
      "duration_seconds": 2.55,
      "text": "Right, do you do any exercise?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 144.41,
      "end_seconds": 147.17,
      "duration_seconds": 2.76,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.0,
      "end_seconds": 151.21,
      "duration_seconds": 2.21,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 152.84,
      "end_seconds": 156.78,
      "duration_seconds": 3.94,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.41,
      "end_seconds": 175.0,
      "duration_seconds": 2.59,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 176.83,
      "end_seconds": 179.31,
      "duration_seconds": 2.48,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.8,
      "end_seconds": 184.94,
      "duration_seconds": 4.14,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 186.18,
      "end_seconds": 189.56,
      "duration_seconds": 3.38,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 204.25,
      "end_seconds": 217.56,
      "duration_seconds": 13.31,
      "text": "Doctor, I've got the readings for you. SpO2 97 percent on room air, BP is 154 over 97, respiratory rate 14, pulse is 91 beats a minute, temperature 36.8."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.88,
      "end_seconds": 219.85,
      "duration_seconds": 0.97,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.07,
      "end_seconds": 224.71,
      "duration_seconds": 2.64,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.94,
      "end_seconds": 228.45,
      "duration_seconds": 2.51,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.02,
      "end_seconds": 248.01,
      "duration_seconds": 4.99,
      "text": "Your neck is stiff and you are very sensitive to light."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.14,
      "end_seconds": 268.04,
      "duration_seconds": 17.9,
      "text": "Good, you can sit up again. So where does that leave us? This looks most like a possible bleed around the brain. I'll request a lumbar puncture, it'll help with thunderclap headache. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 269.21,
      "end_seconds": 270.34,
      "duration_seconds": 1.13,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.01,
      "end_seconds": 290.26,
      "duration_seconds": 19.25,
      "text": "I'll request an urgent CT scan of the head, it'll help with thunderclap headache. This needs an emergency scan, an ambulance is on its way. I'm going to send a referral to the emergency team. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 292.35,
      "end_seconds": 295.76,
      "duration_seconds": 3.41,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.53,
      "end_seconds": 302.22,
      "duration_seconds": 1.69,
      "text": "Have a good day."
    }
  ]
}