{
  "schema_version": "1.0",
  "encounter_id": "01803",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.22,
      "end_seconds": 4.39,
      "duration_seconds": 3.17,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.39,
      "end_seconds": 11.83,
      "duration_seconds": 5.44,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.71,
      "end_seconds": 17.62,
      "duration_seconds": 3.91,
      "text": "I wanted to get painful periods looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.99,
      "end_seconds": 21.0,
      "duration_seconds": 2.01,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.13,
      "end_seconds": 24.68,
      "duration_seconds": 2.55,
      "text": "For ten days, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.25,
      "end_seconds": 34.4,
      "duration_seconds": 8.15,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.6,
      "end_seconds": 59.77,
      "duration_seconds": 24.17,
      "text": "Yes, first two days. That makes it worse. Mostly severe. I thought it would sort itself out, but it hasn't. I've had a dull ache in my back too, for about two weeks. About dull ache in my back, mostly mild. It's a few times a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.76,
      "end_seconds": 64.52,
      "duration_seconds": 3.76,
      "text": "Have you been feeling sick on the first day?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.38,
      "end_seconds": 67.69,
      "duration_seconds": 1.31,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.78,
      "end_seconds": 71.75,
      "duration_seconds": 1.97,
      "text": "Nothing like bleeding between periods?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.8,
      "end_seconds": 75.93,
      "duration_seconds": 3.13,
      "text": "No bleeding between periods, thankfully."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.57,
      "end_seconds": 82.0,
      "duration_seconds": 4.43,
      "text": "Any pain with sex, heavy bleeding or fever at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.66,
      "end_seconds": 86.43,
      "duration_seconds": 3.77,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.18,
      "end_seconds": 92.23,
      "duration_seconds": 5.05,
      "text": "So, any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.75,
      "end_seconds": 95.13,
      "duration_seconds": 2.38,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.34,
      "end_seconds": 98.45,
      "duration_seconds": 2.11,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.0,
      "end_seconds": 103.18,
      "duration_seconds": 4.18,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.82,
      "end_seconds": 107.54,
      "duration_seconds": 2.72,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.27,
      "end_seconds": 111.67,
      "duration_seconds": 3.4,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.73,
      "end_seconds": 115.8,
      "duration_seconds": 2.07,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.65,
      "end_seconds": 123.66,
      "duration_seconds": 6.01,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.6,
      "end_seconds": 129.79,
      "duration_seconds": 4.19,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.47,
      "end_seconds": 139.64,
      "duration_seconds": 8.17,
      "text": "I've had anxiety, yes. I have arthritis in my knees, for five years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.64,
      "end_seconds": 158.23,
      "duration_seconds": 3.59,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.97,
      "end_seconds": 164.66,
      "duration_seconds": 4.69,
      "text": "No, uh, not that I know of."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.87,
      "end_seconds": 181.42,
      "duration_seconds": 2.55,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.79,
      "end_seconds": 187.43,
      "duration_seconds": 4.64,
      "text": "I had an operation for a hernia last spring."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.65,
      "end_seconds": 190.72,
      "duration_seconds": 2.07,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.9,
      "end_seconds": 194.85,
      "duration_seconds": 2.95,
      "text": "I'm on diclofenac, when needed."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.74,
      "end_seconds": 197.78,
      "duration_seconds": 2.04,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.87,
      "end_seconds": 200.96,
      "duration_seconds": 1.09,
      "text": "50 milligrams."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.37,
      "end_seconds": 205.38,
      "duration_seconds": 3.01,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.88,
      "end_seconds": 214.39,
      "duration_seconds": 2.51,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.88,
      "end_seconds": 243.37,
      "duration_seconds": 9.49,
      "text": "Okay: temperature is 36.9 degrees, pressure 111 over 82. And weight 70 kilos, height 171 centimetres, pulse 82."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.3,
      "end_seconds": 250.29,
      "duration_seconds": 4.99,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.37,
      "end_seconds": 253.37,
      "duration_seconds": 1.0,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.73,
      "end_seconds": 256.51,
      "duration_seconds": 1.78,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.19,
      "end_seconds": 269.84,
      "duration_seconds": 3.65,
      "text": "Your tummy is soft and not tender between periods."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.58,
      "end_seconds": 283.15,
      "duration_seconds": 10.57,
      "text": "That's all I needed to check. So, based on the history and the examination, I think we're dealing with primary dysmenorrhoea at this stage."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.34,
      "end_seconds": 290.76,
      "duration_seconds": 2.42,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.1,
      "end_seconds": 301.32,
      "duration_seconds": 6.22,
      "text": "Nothing I've seen today points to an emergency. It looks like primary dysmenorrhoea."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.23,
      "end_seconds": 328.5,
      "duration_seconds": 19.27,
      "text": "Heat, gentle exercise, and start the tablet at the first sign of pain. Please don't wait if the symptoms get worse. That's when to be seen urgently. I'd like you back in three months. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.47,
      "end_seconds": 333.79,
      "duration_seconds": 3.32,
      "text": "Well, thank you, that's helpful."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.26,
      "end_seconds": 341.21,
      "duration_seconds": 1.95,
      "text": "Have a good day."
    }
  ]
}