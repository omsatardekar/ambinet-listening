{
  "schema_version": "1.0",
  "encounter_id": "01549",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.32,
      "end_seconds": 4.31,
      "duration_seconds": 2.99,
      "text": "Hello, good to see you. Please sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.33,
      "end_seconds": 11.45,
      "duration_seconds": 6.12,
      "text": "Hi doctor, um, I got here as fast as I could."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.18,
      "end_seconds": 16.14,
      "duration_seconds": 2.96,
      "text": "How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 17.2,
      "end_seconds": 21.7,
      "duration_seconds": 4.5,
      "text": "I wanted to get sudden severe breathlessness looked at."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.26,
      "end_seconds": 23.62,
      "duration_seconds": 1.36,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 27.3,
      "end_seconds": 31.16,
      "duration_seconds": 3.86,
      "text": "It's been one week, I'm fairly sure."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.49,
      "end_seconds": 36.09,
      "duration_seconds": 3.6,
      "text": "Any sharp chest pain on one side as well?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.98,
      "end_seconds": 56.79,
      "duration_seconds": 19.81,
      "text": "Yes, uh, about the same, two months. I mean, you know, there's being unable to lie flat as well. As for being unable to lie flat, I get some relief from sitting up."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.53,
      "end_seconds": 64.15,
      "duration_seconds": 2.62,
      "text": "Have you been feeling very faint?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.76,
      "end_seconds": 75.68,
      "duration_seconds": 9.92,
      "text": "Yeah, you know, I've had that since last weekend. As for feeling very faint, it just comes and goes."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.9,
      "end_seconds": 91.06,
      "duration_seconds": 3.16,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.49,
      "end_seconds": 98.5,
      "duration_seconds": 4.01,
      "text": "Omeprazole, 20 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.59,
      "end_seconds": 104.18,
      "duration_seconds": 4.59,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 104.8,
      "end_seconds": 106.87,
      "duration_seconds": 2.07,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.02,
      "end_seconds": 114.38,
      "duration_seconds": 2.36,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.61,
      "end_seconds": 117.28,
      "duration_seconds": 1.67,
      "text": "Yes, acid reflux."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.39,
      "end_seconds": 123.96,
      "duration_seconds": 5.57,
      "text": "Mm-hmm. Right, are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 124.88,
      "end_seconds": 135.33,
      "duration_seconds": 10.45,
      "text": "I think I reacted to some antibiotic once, um, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.41,
      "end_seconds": 143.13,
      "duration_seconds": 5.72,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.22,
      "end_seconds": 158.25,
      "duration_seconds": 14.03,
      "text": "My husband and I live above the shop. I hardly move around during the day. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.06,
      "end_seconds": 171.72,
      "duration_seconds": 3.66,
      "text": "Did you get leg swelling, fever or cough?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 172.32,
      "end_seconds": 177.55,
      "duration_seconds": 5.23,
      "text": "Um, no, no leg swelling, fever or cough."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.77,
      "end_seconds": 182.78,
      "duration_seconds": 5.01,
      "text": "Okay, go on. Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 184.58,
      "end_seconds": 187.48,
      "duration_seconds": 2.9,
      "text": "So, no, that's been fine."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.13,
      "end_seconds": 191.57,
      "duration_seconds": 2.44,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.14,
      "end_seconds": 194.25,
      "duration_seconds": 2.11,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.13,
      "end_seconds": 197.15,
      "duration_seconds": 2.02,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.27,
      "end_seconds": 209.67,
      "duration_seconds": 2.4,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.62,
      "end_seconds": 241.21,
      "duration_seconds": 9.59,
      "text": "Okay: pulse is 99 beats a minute, temperature 36.9, pressure 137 over 89, saturation 92 percent, respiratory rate 23."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 241.77,
      "end_seconds": 243.5,
      "duration_seconds": 1.73,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.25,
      "end_seconds": 247.04,
      "duration_seconds": 2.79,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.51,
      "end_seconds": 251.86,
      "duration_seconds": 3.35,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.29,
      "end_seconds": 255.18,
      "duration_seconds": 1.89,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.2,
      "end_seconds": 279.39,
      "duration_seconds": 8.19,
      "text": "Your windpipe is pushed to the right, there is no breath sound on the left, and your pressure is dropping."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.27,
      "end_seconds": 284.1,
      "duration_seconds": 1.83,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.85,
      "end_seconds": 331.99,
      "duration_seconds": 29.14,
      "text": "Taking everything into account, my working impression is a collapsed lung under pressure. That's my thinking for now, and it may change as we learn more. A heart attack is also on my list. An urgent chest decompression is what I'd like next, for tension pneumothorax. We should do a chest X-ray for chest pain. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 332.55,
      "end_seconds": 357.51,
      "duration_seconds": 24.96,
      "text": "Stay sitting up, I need to relieve the pressure in your chest right now. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 358.27,
      "end_seconds": 361.77,
      "duration_seconds": 3.5,
      "text": "Thank you, um, that's clear."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 362.92,
      "end_seconds": 374.4,
      "duration_seconds": 11.48,
      "text": "Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. Come back straight away."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 380.02,
      "end_seconds": 383.12,
      "duration_seconds": 3.1,
      "text": "Actually, good, I'll return then."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 383.8,
      "end_seconds": 386.31,
      "duration_seconds": 2.51,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 387.76,
      "end_seconds": 392.64,
      "duration_seconds": 4.88,
      "text": "Right, um, no, that's all. Thanks a lot."
    }
  ]
}