{
  "schema_version": "1.0",
  "encounter_id": "01516",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.66,
      "end_seconds": 5.42,
      "duration_seconds": 4.76,
      "text": "Good evening, um, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.0,
      "end_seconds": 11.09,
      "duration_seconds": 5.09,
      "text": "Right, not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.74,
      "end_seconds": 19.35,
      "duration_seconds": 7.61,
      "text": "um, so... a sore on my ankle that won't heal. That's why I came"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.87,
      "end_seconds": 23.11,
      "duration_seconds": 3.24,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.71,
      "end_seconds": 27.24,
      "duration_seconds": 2.53,
      "text": "About... well, about three months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.34,
      "end_seconds": 31.29,
      "duration_seconds": 2.95,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.01,
      "end_seconds": 49.25,
      "duration_seconds": 16.24,
      "text": "Itchy brown skin on the shin goes along with it, most of the time as for Itchy brown skin on the shin, it feels mild to me honestly, on and off"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.93,
      "end_seconds": 62.8,
      "duration_seconds": 2.87,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.69,
      "end_seconds": 66.3,
      "duration_seconds": 2.61,
      "text": "I've had heart disease, yes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.58,
      "end_seconds": 68.97,
      "duration_seconds": 1.39,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.94,
      "end_seconds": 85.23,
      "duration_seconds": 3.29,
      "text": "what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.87,
      "end_seconds": 89.84,
      "duration_seconds": 3.97,
      "text": "I take clopidogrel, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.76,
      "end_seconds": 95.38,
      "duration_seconds": 3.62,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.28,
      "end_seconds": 105.3,
      "duration_seconds": 5.02,
      "text": "Yes, plasters, it gives me a red itchy rash."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.06,
      "end_seconds": 109.1,
      "duration_seconds": 3.04,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.65,
      "end_seconds": 114.6,
      "duration_seconds": 3.95,
      "text": "just a triple bypass, eight years ago"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.25,
      "end_seconds": 118.36,
      "duration_seconds": 2.11,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.5,
      "end_seconds": 123.17,
      "duration_seconds": 3.67,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.54,
      "end_seconds": 127.4,
      "duration_seconds": 2.86,
      "text": "do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.65,
      "end_seconds": 132.05,
      "duration_seconds": 3.4,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.22,
      "end_seconds": 146.87,
      "duration_seconds": 4.65,
      "text": "Did you get spreading redness, chest pain, fever or calf pain?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.84,
      "end_seconds": 153.15,
      "duration_seconds": 2.31,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.5,
      "end_seconds": 158.81,
      "duration_seconds": 5.31,
      "text": "understood any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.2,
      "end_seconds": 162.85,
      "duration_seconds": 2.65,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.35,
      "end_seconds": 168.73,
      "duration_seconds": 1.38,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.42,
      "end_seconds": 171.81,
      "duration_seconds": 1.39,
      "text": "nothing odd there"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.75,
      "end_seconds": 175.54,
      "duration_seconds": 2.79,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.15,
      "end_seconds": 188.46,
      "duration_seconds": 2.31,
      "text": "nearly done with the readings.."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.71,
      "end_seconds": 208.96,
      "duration_seconds": 9.25,
      "text": "Okay: pulse 64, BP is 108 over 70. And oxygen saturation is 97 percent, weight 56 kilos, height 182 centimetres."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.5,
      "end_seconds": 214.88,
      "duration_seconds": 3.38,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.24,
      "end_seconds": 218.69,
      "duration_seconds": 2.45,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.65,
      "end_seconds": 237.76,
      "duration_seconds": 8.11,
      "text": "There is a shallow ulcer above the inner ankle with brown skin around it and visible varicose veins."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.12,
      "end_seconds": 250.0,
      "duration_seconds": 7.88,
      "text": "you can sit up now. So where does that leave us? It points towards a venous leg ulcer"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.04,
      "end_seconds": 254.7,
      "duration_seconds": 3.66,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.45,
      "end_seconds": 264.98,
      "duration_seconds": 8.53,
      "text": "I can't promise yet, but most people with a venous leg ulcer do well once it's treated properly"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.28,
      "end_seconds": 282.51,
      "duration_seconds": 4.23,
      "text": "I'd like to arrange a wound swab for leg ulcer."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.96,
      "end_seconds": 289.45,
      "duration_seconds": 1.49,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.41,
      "end_seconds": 305.15,
      "duration_seconds": 14.74,
      "text": "I think a doppler test of the leg pulses makes sense here, for leg ulcer. Compression bandaging and keeping the leg raised when sitting. Book a review in two weeks. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.71,
      "end_seconds": 308.35,
      "duration_seconds": 1.64,
      "text": "That's clear, thanks."
    }
  ]
}