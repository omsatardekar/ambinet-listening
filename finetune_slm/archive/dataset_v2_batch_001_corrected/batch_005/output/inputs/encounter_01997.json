{
  "schema_version": "1.0",
  "encounter_id": "01997",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.62,
      "end_seconds": 2.16,
      "duration_seconds": 1.54,
      "text": "good afternoon, doctor"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.24,
      "end_seconds": 9.05,
      "duration_seconds": 4.81,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.8,
      "end_seconds": 20.94,
      "duration_seconds": 10.14,
      "text": "It's daytime sleepiness, mostly. Oh, and morning headaches. I had loud snoring before. That's settled now, um, though."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.31,
      "end_seconds": 24.04,
      "duration_seconds": 1.73,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.99,
      "end_seconds": 27.73,
      "duration_seconds": 2.74,
      "text": "My partner and our baby"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.56,
      "end_seconds": 34.74,
      "duration_seconds": 1.18,
      "text": "are you active?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.87,
      "end_seconds": 38.76,
      "duration_seconds": 2.89,
      "text": "I walk the dog every morning"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.74,
      "end_seconds": 59.03,
      "duration_seconds": 2.29,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.82,
      "end_seconds": 66.57,
      "duration_seconds": 6.75,
      "text": "Yeah, yes, I had a wisdom tooth extraction under sedation, five years ago."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.43,
      "end_seconds": 70.13,
      "duration_seconds": 2.7,
      "text": "do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.36,
      "end_seconds": 76.93,
      "duration_seconds": 5.57,
      "text": "Well, I've had high blood pressure for about a year now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.15,
      "end_seconds": 82.72,
      "duration_seconds": 4.57,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.28,
      "end_seconds": 89.09,
      "duration_seconds": 5.81,
      "text": "I'm on telmisartan, 40 milligrams, once a day for my pressure."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.39,
      "end_seconds": 93.67,
      "duration_seconds": 3.28,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.19,
      "end_seconds": 97.9,
      "duration_seconds": 2.71,
      "text": "I've never had an allergy"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.65,
      "end_seconds": 116.06,
      "duration_seconds": 4.41,
      "text": "And what about choking, leg swelling or chest pain?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.21,
      "end_seconds": 123.03,
      "duration_seconds": 5.82,
      "text": "No choking, leg swelling or chest pain, none of it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.55,
      "end_seconds": 129.1,
      "duration_seconds": 4.55,
      "text": "what about your tummy and and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.34,
      "end_seconds": 133.39,
      "duration_seconds": 3.05,
      "text": "no, that that side's been fine"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.01,
      "end_seconds": 138.24,
      "duration_seconds": 3.23,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.34,
      "end_seconds": 149.27,
      "duration_seconds": 2.93,
      "text": "Right, keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.07,
      "end_seconds": 180.41,
      "duration_seconds": 12.34,
      "text": "Okay: saturation 99 percent, weight 83 kilos, pulse 90. And temperature 36.9, respiratory rate 15, pressure 146 over 103, BMI works out to 32.4, height 160 centimetres."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.92,
      "end_seconds": 184.38,
      "duration_seconds": 1.46,
      "text": "is that normal?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.31,
      "end_seconds": 188.55,
      "duration_seconds": 2.24,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.73,
      "end_seconds": 194.06,
      "duration_seconds": 4.33,
      "text": "let me look at the area, I'll be gentle"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.77,
      "end_seconds": 197.38,
      "duration_seconds": 1.61,
      "text": "let me feel here"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.05,
      "end_seconds": 208.57,
      "duration_seconds": 3.52,
      "text": "you have a thick neck and a crowded throat"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.69,
      "end_seconds": 213.6,
      "duration_seconds": 0.91,
      "text": "of course"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.53,
      "end_seconds": 222.54,
      "duration_seconds": 3.01,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.75,
      "end_seconds": 244.38,
      "duration_seconds": 13.63,
      "text": "So where does that leave us? It points towards probable obstructive sleep apnoea. I'd also keep an underactive thyroid in mind. Let's book a home sleep study to look into snoring and apnoeas."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 246.37,
      "end_seconds": 250.25,
      "duration_seconds": 3.88,
      "text": "I can book that for Wednesday at 11:30 am"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.6,
      "end_seconds": 271.76,
      "duration_seconds": 20.16,
      "text": "I'm going to order a thyroid test, for tiredness. That will help us see what's going on underneath and decide the next step. Avoid alcohol in the evening, lose some weight if you can, and do not drive when drowsy. I'll also refer you to the sleep clinic."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.39,
      "end_seconds": 274.1,
      "duration_seconds": 1.71,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.94,
      "end_seconds": 286.88,
      "duration_seconds": 10.94,
      "text": "If the symptoms get worse, or you feel really unwell, please come to the emergency department. Please come and see me after the sleep study."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.2,
      "end_seconds": 288.9,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.54,
      "end_seconds": 297.23,
      "duration_seconds": 7.69,
      "text": "Okay, can you tell me the plan back in your own words, so I know I've explained it clearly?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.64,
      "end_seconds": 305.56,
      "duration_seconds": 6.92,
      "text": "So, I come back after the sleep study. Is that that right?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.65,
      "end_seconds": 311.89,
      "duration_seconds": 4.24,
      "text": "Right, yes, exactly right. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.08,
      "end_seconds": 317.29,
      "duration_seconds": 4.21,
      "text": "Erm, good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.81,
      "end_seconds": 323.5,
      "duration_seconds": 1.69,
      "text": "have a good day"
    }
  ]
}