{
  "schema_version": "1.0",
  "encounter_id": "01828",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.13,
      "end_seconds": 5.26,
      "duration_seconds": 4.13,
      "text": "Hello, uh, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.61,
      "end_seconds": 10.65,
      "duration_seconds": 4.04,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.97,
      "end_seconds": 19.51,
      "duration_seconds": 7.54,
      "text": "Honestly, it's shaky spells in the afternoon, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.3,
      "end_seconds": 23.53,
      "duration_seconds": 3.23,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.52,
      "end_seconds": 31.38,
      "duration_seconds": 2.86,
      "text": "I've had it for five days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.41,
      "end_seconds": 36.88,
      "duration_seconds": 2.47,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.73,
      "end_seconds": 47.22,
      "duration_seconds": 8.49,
      "text": "Mild, I'd say. I've also had being confused for a minute, for about three months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.87,
      "end_seconds": 51.11,
      "duration_seconds": 3.24,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.16,
      "end_seconds": 59.78,
      "duration_seconds": 7.62,
      "text": "I'd give it a five, out of ten. I've been sweating too. About sweating, moderate, really."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.46,
      "end_seconds": 67.41,
      "duration_seconds": 6.95,
      "text": "Have you had shaky spells in the afternoon before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.39,
      "end_seconds": 73.01,
      "duration_seconds": 4.62,
      "text": "I had a similar thing last winter. It went away."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.83,
      "end_seconds": 75.82,
      "duration_seconds": 1.99,
      "text": "Any seizure or chest pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.28,
      "end_seconds": 81.88,
      "duration_seconds": 4.6,
      "text": "I haven't had seizure or chest pain, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.9,
      "end_seconds": 87.08,
      "duration_seconds": 3.18,
      "text": "Have you noticed vomiting or loss of consciousness?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.86,
      "end_seconds": 92.7,
      "duration_seconds": 3.84,
      "text": "No, no vomiting or loss of consciousness."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.81,
      "end_seconds": 96.48,
      "duration_seconds": 2.67,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.76,
      "end_seconds": 101.05,
      "duration_seconds": 3.29,
      "text": "Ah, no, my breathing's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.85,
      "end_seconds": 105.26,
      "duration_seconds": 3.41,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.3,
      "end_seconds": 107.91,
      "duration_seconds": 1.61,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.46,
      "end_seconds": 112.03,
      "duration_seconds": 3.57,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.55,
      "end_seconds": 126.48,
      "duration_seconds": 13.93,
      "text": "Metformin. I take it 500 milligrams, twice a day. Yeah, though honestly, some days I forget to take it. It's sumatriptan, 50 milligrams, maybe, when needed for my migraines."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.07,
      "end_seconds": 131.64,
      "duration_seconds": 4.57,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.84,
      "end_seconds": 140.01,
      "duration_seconds": 7.17,
      "text": "Sorry, what was I saying, no, it's at home. Glucose tablets, when needed."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.56,
      "end_seconds": 144.4,
      "duration_seconds": 2.84,
      "text": "Okay, how much do you take?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.77,
      "end_seconds": 147.21,
      "duration_seconds": 1.44,
      "text": "It's 4 tablets."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.4,
      "end_seconds": 157.6,
      "duration_seconds": 1.2,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.89,
      "end_seconds": 161.64,
      "duration_seconds": 2.75,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.42,
      "end_seconds": 165.36,
      "duration_seconds": 1.94,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.58,
      "end_seconds": 170.37,
      "duration_seconds": 3.79,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.33,
      "end_seconds": 174.29,
      "duration_seconds": 2.96,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.91,
      "end_seconds": 188.2,
      "duration_seconds": 13.29,
      "text": "Yes, I had a bunion operation, six years ago. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.97,
      "end_seconds": 193.06,
      "duration_seconds": 4.09,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.87,
      "end_seconds": 195.92,
      "duration_seconds": 2.05,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.98,
      "end_seconds": 218.41,
      "duration_seconds": 4.43,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.83,
      "end_seconds": 221.72,
      "duration_seconds": 1.89,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.52,
      "end_seconds": 224.94,
      "duration_seconds": 2.42,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.21,
      "end_seconds": 229.52,
      "duration_seconds": 3.31,
      "text": "I have diabetes, for about ten years."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.84,
      "end_seconds": 232.16,
      "duration_seconds": 1.32,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.8,
      "end_seconds": 235.05,
      "duration_seconds": 2.25,
      "text": "Migraines, for five years."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.98,
      "end_seconds": 240.69,
      "duration_seconds": 3.71,
      "text": "Alright, diabetes, that matches what I have here."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 241.41,
      "end_seconds": 258.53,
      "duration_seconds": 17.12,
      "text": "Here are the numbers, doctor. Heart rate 110, temperature is 36.7 degrees, BMI works out to 22.2, height 159 centimetres, weight 56 kilos, oxygen saturation is 99 percent, BP is 112 over 72, respiratory rate 20."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.88,
      "end_seconds": 261.46,
      "duration_seconds": 1.58,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.34,
      "end_seconds": 293.32,
      "duration_seconds": 14.98,
      "text": "A download of the glucose meter is what I'd like next, for hypoglycaemia. I think an HbA1c makes sense here, for diabetes review. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.24,
      "end_seconds": 298.21,
      "duration_seconds": 2.97,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.18,
      "end_seconds": 306.75,
      "duration_seconds": 7.57,
      "text": "I'll start you on insulin glargine, 16 units, once a day at bedtime, long term. It's for diabetes."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.96,
      "end_seconds": 310.25,
      "duration_seconds": 2.29,
      "text": "Fine, I'll begin it."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.14,
      "end_seconds": 333.77,
      "duration_seconds": 22.63,
      "text": "Always carry sugar and eat something before exercise. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. I think the diabetes team should see you too. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.93,
      "end_seconds": 337.0,
      "duration_seconds": 2.07,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.25,
      "end_seconds": 343.84,
      "duration_seconds": 5.59,
      "text": "We'll catch up in two weeks. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.56,
      "end_seconds": 350.67,
      "duration_seconds": 5.11,
      "text": "Okay, you know, that makes sense. Thanks for explaining."
    }
  ]
}