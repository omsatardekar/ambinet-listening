{
  "schema_version": "1.0",
  "encounter_id": "01897",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.88,
      "end_seconds": 4.52,
      "duration_seconds": 3.64,
      "text": "Erm, hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.35,
      "end_seconds": 9.35,
      "duration_seconds": 4.0,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.26,
      "end_seconds": 15.04,
      "duration_seconds": 4.78,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.53,
      "end_seconds": 21.04,
      "duration_seconds": 4.51,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.46,
      "end_seconds": 32.93,
      "duration_seconds": 10.47,
      "text": "Honestly, it's burning on passing urine, and my family pushed me to come. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.6,
      "end_seconds": 37.2,
      "duration_seconds": 3.6,
      "text": "Alright, how long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.92,
      "end_seconds": 51.4,
      "duration_seconds": 13.48,
      "text": "Right, I've had it for about two weeks. I've also been passing urine very often. As for passing urine very often, mostly severe. And a dull low backache, too."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.37,
      "end_seconds": 56.49,
      "duration_seconds": 3.12,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.1,
      "end_seconds": 62.49,
      "duration_seconds": 2.39,
      "text": "It feels moderate to me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.14,
      "end_seconds": 66.87,
      "duration_seconds": 2.73,
      "text": "Have you been feeling a bit feverish?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.09,
      "end_seconds": 70.6,
      "duration_seconds": 2.51,
      "text": "Yeah, um, that too."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.85,
      "end_seconds": 78.35,
      "duration_seconds": 6.5,
      "text": "Have you had burning on passing urine before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.1,
      "end_seconds": 87.83,
      "duration_seconds": 7.73,
      "text": "Yes, something like this happened about six months ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.96,
      "end_seconds": 102.49,
      "duration_seconds": 2.53,
      "text": "Right, I'll do your observations first."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.95,
      "end_seconds": 115.06,
      "duration_seconds": 2.11,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.82,
      "end_seconds": 144.63,
      "duration_seconds": 12.81,
      "text": "Okay: SpO2 96 percent on room air, weight 68 kilos, pulse 100, BMI works out to 19.9, height 185 centimetres, blood pressure 123 over 71, respiratory rate 21."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.21,
      "end_seconds": 148.21,
      "duration_seconds": 2.0,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.24,
      "end_seconds": 151.76,
      "duration_seconds": 2.52,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.62,
      "end_seconds": 166.15,
      "duration_seconds": 6.53,
      "text": "There is mild tenderness above the pubic bone and no tenderness in the loins."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.37,
      "end_seconds": 181.21,
      "duration_seconds": 9.84,
      "text": "Thank you, you can get dressed. Let me check a few things. Any leaking fluid, vaginal bleeding, severe back pain or reduced baby movements?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.71,
      "end_seconds": 185.43,
      "duration_seconds": 2.72,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.69,
      "end_seconds": 189.07,
      "duration_seconds": 2.38,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.45,
      "end_seconds": 193.04,
      "duration_seconds": 2.59,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.93,
      "end_seconds": 196.47,
      "duration_seconds": 2.54,
      "text": "Right, how's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.81,
      "end_seconds": 199.27,
      "duration_seconds": 1.46,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.26,
      "end_seconds": 205.12,
      "duration_seconds": 4.86,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.48,
      "end_seconds": 221.73,
      "duration_seconds": 15.25,
      "text": "I smoke roughly a pack every two days. I'm a bus driver, so I sit for long hours. I'm vegetarian and have been for years. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.35,
      "end_seconds": 225.79,
      "duration_seconds": 3.44,
      "text": "Alright, did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.6,
      "end_seconds": 230.99,
      "duration_seconds": 4.39,
      "text": "I had a bunion operation six years ago."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.01,
      "end_seconds": 250.02,
      "duration_seconds": 4.01,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.02,
      "end_seconds": 255.08,
      "duration_seconds": 3.06,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.07,
      "end_seconds": 260.48,
      "duration_seconds": 4.41,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.1,
      "end_seconds": 263.33,
      "duration_seconds": 2.23,
      "text": "I've got acid reflux."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.38,
      "end_seconds": 266.25,
      "duration_seconds": 0.87,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.62,
      "end_seconds": 269.3,
      "duration_seconds": 1.68,
      "text": "I've got eczema."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.79,
      "end_seconds": 280.37,
      "duration_seconds": 9.58,
      "text": "I follow. Yes, acid reflux and eczema are known to us, good to have that clear. Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.7,
      "end_seconds": 287.16,
      "duration_seconds": 5.46,
      "text": "Lansoprazole. I take it 30 milligrams, before breakfast for my acidity."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 287.85,
      "end_seconds": 297.41,
      "duration_seconds": 9.56,
      "text": "Doctor, I think the last prescription for the lansoprazole was 60 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.64,
      "end_seconds": 302.74,
      "duration_seconds": 4.1,
      "text": "I see. Is the most recent prescription on you?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.29,
      "end_seconds": 319.19,
      "duration_seconds": 15.9,
      "text": "Hmm, no, I left it at home. I'm on hydrocortisone cream, when needed. I've been putting this off for weeks. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.29,
      "end_seconds": 324.55,
      "duration_seconds": 3.26,
      "text": "So, have you got any known allergies?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.2,
      "end_seconds": 332.05,
      "duration_seconds": 5.85,
      "text": "Nickel. I come out in... well, a rash on my skin."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.86,
      "end_seconds": 344.12,
      "duration_seconds": 10.26,
      "text": "Let me tell you where I've got to. I can't pin this down yet. We're looking at a urinary infection in pregnancy or a kidney infection."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.6,
      "end_seconds": 347.66,
      "duration_seconds": 2.06,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.24,
      "end_seconds": 371.47,
      "duration_seconds": 22.23,
      "text": "I understand the worry. At the moment I'd say it's a urinary infection in pregnancy, and we'll know more once the a urine culture is back. Let me just check I've got this right. You've had burning on passing urine for about two weeks, and no severe back pain or reduced baby movements."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 372.64,
      "end_seconds": 374.88,
      "duration_seconds": 2.24,
      "text": "That's what happened, yes."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 393.78,
      "end_seconds": 421.97,
      "duration_seconds": 28.19,
      "text": "Let's book a urine culture to look into urinary infection. I want a urine dipstick done, that's for burning urine. We'll begin with cefalexin, 500 milligrams, twice a day, seven days. It's for urinary infection in pregnancy. Drink plenty of fluids and tell your midwife. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 423.41,
      "end_seconds": 424.53,
      "duration_seconds": 1.12,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 425.28,
      "end_seconds": 428.98,
      "duration_seconds": 3.7,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 430.56,
      "end_seconds": 433.67,
      "duration_seconds": 3.11,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 435.1,
      "end_seconds": 436.34,
      "duration_seconds": 1.24,
      "text": "All the best."
    }
  ]
}