{
  "schema_version": "1.0",
  "encounter_id": "01707",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.82,
      "end_seconds": 4.66,
      "duration_seconds": 3.84,
      "text": "Morning, doctor. I've settled them in, ready when you are."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.35,
      "end_seconds": 8.8,
      "duration_seconds": 3.45,
      "text": "Thank you. Right, hello, what's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 9.44,
      "end_seconds": 11.69,
      "duration_seconds": 2.25,
      "text": "It's tired muscles, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.06,
      "end_seconds": 16.2,
      "duration_seconds": 3.14,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 17.3,
      "end_seconds": 28.63,
      "duration_seconds": 11.33,
      "text": "For ten days, I'd say. My neighbour said I should get it looked at. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.65,
      "end_seconds": 33.62,
      "duration_seconds": 2.97,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 34.63,
      "end_seconds": 35.57,
      "duration_seconds": 0.94,
      "text": "Mostly mild."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.59,
      "end_seconds": 40.45,
      "duration_seconds": 2.86,
      "text": "Alright, does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 41.31,
      "end_seconds": 46.02,
      "duration_seconds": 4.71,
      "text": "It usually comes with a mild ache in my legs."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.86,
      "end_seconds": 49.59,
      "duration_seconds": 2.73,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 50.15,
      "end_seconds": 51.26,
      "duration_seconds": 1.11,
      "text": "Mostly severe."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.01,
      "end_seconds": 55.4,
      "duration_seconds": 3.39,
      "text": "Has there been not getting outdoors too?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 56.59,
      "end_seconds": 58.23,
      "duration_seconds": 1.64,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.93,
      "end_seconds": 63.89,
      "duration_seconds": 4.96,
      "text": "Any bone pain, fractures, weight loss or weakness at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 64.53,
      "end_seconds": 66.81,
      "duration_seconds": 2.28,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.58,
      "end_seconds": 70.77,
      "duration_seconds": 2.19,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 71.92,
      "end_seconds": 73.77,
      "duration_seconds": 1.85,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.35,
      "end_seconds": 76.04,
      "duration_seconds": 1.69,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 78.12,
      "end_seconds": 82.44,
      "duration_seconds": 4.32,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.14,
      "end_seconds": 85.1,
      "duration_seconds": 0.96,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 85.68,
      "end_seconds": 88.64,
      "duration_seconds": 2.96,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.63,
      "end_seconds": 91.3,
      "duration_seconds": 1.67,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 93.3,
      "end_seconds": 95.54,
      "duration_seconds": 2.24,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.27,
      "end_seconds": 97.72,
      "duration_seconds": 1.45,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 99.13,
      "end_seconds": 102.03,
      "duration_seconds": 2.9,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.43,
      "end_seconds": 104.91,
      "duration_seconds": 1.48,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 110.07,
      "end_seconds": 114.08,
      "duration_seconds": 4.01,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.95,
      "end_seconds": 123.26,
      "duration_seconds": 4.31,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 123.85,
      "end_seconds": 130.99,
      "duration_seconds": 7.14,
      "text": "I'm on sumatriptan, 50 milligrams, when needed. I take furosemide, every morning for the fluid."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.91,
      "end_seconds": 133.95,
      "duration_seconds": 2.04,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 135.51,
      "end_seconds": 140.32,
      "duration_seconds": 4.81,
      "text": "40 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.77,
      "end_seconds": 142.62,
      "duration_seconds": 1.85,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.95,
      "end_seconds": 164.43,
      "duration_seconds": 4.48,
      "text": "Alright, are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 165.57,
      "end_seconds": 168.59,
      "duration_seconds": 3.02,
      "text": "Yes, tramadol, it gives me vomiting."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.19,
      "end_seconds": 171.54,
      "duration_seconds": 1.35,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 172.93,
      "end_seconds": 176.2,
      "duration_seconds": 3.27,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.24,
      "end_seconds": 181.98,
      "duration_seconds": 3.74,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 182.98,
      "end_seconds": 197.6,
      "duration_seconds": 14.62,
      "text": "Migraines, for about a year. I wasn't sure whether to come in at all, to be honest. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.64,
      "end_seconds": 200.43,
      "duration_seconds": 1.79,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 201.89,
      "end_seconds": 204.29,
      "duration_seconds": 2.4,
      "text": "I've had heart failure, yes."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.32,
      "end_seconds": 216.75,
      "duration_seconds": 4.43,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 218.42,
      "end_seconds": 220.5,
      "duration_seconds": 2.08,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 222.32,
      "end_seconds": 235.71,
      "duration_seconds": 13.39,
      "text": "Okay, so the vitals from earlier. Blood pressure 116 over 76, heart rate 84. Weight 70 kilos, BMI works out to 22.6, height 176 centimetres, temperature is 36.8 degrees."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.2,
      "end_seconds": 238.28,
      "duration_seconds": 1.08,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.17,
      "end_seconds": 243.79,
      "duration_seconds": 2.62,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 244.67,
      "end_seconds": 246.31,
      "duration_seconds": 1.64,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.63,
      "end_seconds": 249.21,
      "duration_seconds": 1.58,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.71,
      "end_seconds": 268.56,
      "duration_seconds": 4.85,
      "text": "Your muscle strength is normal and there is no bone tenderness."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 270.22,
      "end_seconds": 271.29,
      "duration_seconds": 1.07,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.85,
      "end_seconds": 276.53,
      "duration_seconds": 2.68,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.31,
      "end_seconds": 301.74,
      "duration_seconds": 9.43,
      "text": "Stop me if I've got anything wrong. You've had tired muscles for ten days, mild, and no fractures or bone pain."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 302.6,
      "end_seconds": 304.11,
      "duration_seconds": 1.51,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.67,
      "end_seconds": 311.93,
      "duration_seconds": 7.26,
      "text": "Get some daily daylight and eat oily fish. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 312.69,
      "end_seconds": 316.33,
      "duration_seconds": 3.64,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}