{
  "schema_version": "1.0",
  "encounter_id": "01706",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.07,
      "end_seconds": 4.69,
      "duration_seconds": 3.62,
      "text": "sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.41,
      "end_seconds": 10.5,
      "duration_seconds": 5.09,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.96,
      "end_seconds": 18.85,
      "duration_seconds": 6.89,
      "text": "Yeah, it's a very sore throat. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.49,
      "end_seconds": 24.07,
      "duration_seconds": 3.58,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.66,
      "end_seconds": 28.0,
      "duration_seconds": 2.34,
      "text": "It's been one week now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.82,
      "end_seconds": 34.25,
      "duration_seconds": 2.43,
      "text": "Have you been feeling exhausted?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.58,
      "end_seconds": 46.34,
      "duration_seconds": 10.76,
      "text": "Yeah, I've had that since this morning. There was swollen glands in my neck, yes, but that went away."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.16,
      "end_seconds": 53.16,
      "duration_seconds": 6.0,
      "text": "Have you had a very sore throat before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.27,
      "end_seconds": 60.86,
      "duration_seconds": 6.59,
      "text": "A bit, a couple of years ago. It It settled by itself back then."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.94,
      "end_seconds": 65.23,
      "duration_seconds": 3.29,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.01,
      "end_seconds": 79.57,
      "duration_seconds": 3.56,
      "text": "Right, bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.31,
      "end_seconds": 107.96,
      "duration_seconds": 7.65,
      "text": "Okay: temperature 39.1, saturation 95 percent, blood pressure 110 over 80, pulse is 94 beats a minute."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.43,
      "end_seconds": 113.67,
      "duration_seconds": 3.24,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.78,
      "end_seconds": 116.57,
      "duration_seconds": 1.79,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.49,
      "end_seconds": 138.77,
      "duration_seconds": 6.28,
      "text": "Your tonsils are large with white coating and the glands in the neck are tender."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.09,
      "end_seconds": 145.7,
      "duration_seconds": 1.61,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.38,
      "end_seconds": 168.19,
      "duration_seconds": 5.81,
      "text": "A few quick ones: difficulty breathing, tummy pain on the left or jaundice?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.64,
      "end_seconds": 172.89,
      "duration_seconds": 3.25,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.17,
      "end_seconds": 175.4,
      "duration_seconds": 1.23,
      "text": "Nothing like rash?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.28,
      "end_seconds": 178.95,
      "duration_seconds": 1.67,
      "text": "Nope, no rash."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.94,
      "end_seconds": 183.61,
      "duration_seconds": 3.67,
      "text": "alright, has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.33,
      "end_seconds": 185.81,
      "duration_seconds": 1.48,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.67,
      "end_seconds": 199.49,
      "duration_seconds": 3.82,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.41,
      "end_seconds": 203.33,
      "duration_seconds": 2.92,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.19,
      "end_seconds": 208.99,
      "duration_seconds": 3.8,
      "text": "what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.5,
      "end_seconds": 216.08,
      "duration_seconds": 2.58,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.02,
      "end_seconds": 220.85,
      "duration_seconds": 2.83,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.57,
      "end_seconds": 228.37,
      "duration_seconds": 3.8,
      "text": "I have heart failure. I've got heart disease."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.36,
      "end_seconds": 237.94,
      "duration_seconds": 7.58,
      "text": "Yes, heart failure is known to us, good to have that clear. Any surgery in the past?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.14,
      "end_seconds": 243.73,
      "duration_seconds": 4.59,
      "text": "Yes, I had a triple bypass, eight years ago."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.63,
      "end_seconds": 247.35,
      "duration_seconds": 2.72,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.13,
      "end_seconds": 259.97,
      "duration_seconds": 10.84,
      "text": "I hardly move around during the day. My husband and I live above the shop. I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.16,
      "end_seconds": 264.28,
      "duration_seconds": 3.12,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.17,
      "end_seconds": 279.81,
      "duration_seconds": 11.64,
      "text": "Carvedilol, 6.25 milligrams, twice a day. Metoprolol. I take it 50 milligrams, twice a day. Throat lozenges, when needed."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.76,
      "end_seconds": 291.56,
      "duration_seconds": 9.8,
      "text": "Okay, thinking it through, it's hard to say. Glandular fever is one possibility and streptococcal tonsillitis another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.5,
      "end_seconds": 295.88,
      "duration_seconds": 2.38,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.35,
      "end_seconds": 330.68,
      "duration_seconds": 33.33,
      "text": "I understand the the worry at the moment I'd say it's glandular fever, and we'll know more once the a blood count is back. a blood count is what I'd like next, for glandular fever. A monospot test is what I'd like next, for sore throat and fatigue rest, plenty of fluids, and no contact sport for a month cos of the spleen do get help quickly if the symptoms get worse"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.72,
      "end_seconds": 341.57,
      "duration_seconds": 8.85,
      "text": "I'd like to see you again in two weeks. Can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.41,
      "end_seconds": 351.31,
      "duration_seconds": 4.9,
      "text": "so, I come back in two weeks is that right?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.01,
      "end_seconds": 356.65,
      "duration_seconds": 3.64,
      "text": "yes, exactly right. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.65,
      "end_seconds": 360.7,
      "duration_seconds": 2.05,
      "text": "Alright, thanks, take care."
    }
  ]
}