{
  "schema_version": "1.0",
  "encounter_id": "01677",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.09,
      "end_seconds": 7.72,
      "duration_seconds": 6.63,
      "text": "Doctor, your next patient is here. I've done the basics, I'll read them out in a moment."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.25,
      "end_seconds": 13.47,
      "duration_seconds": 5.22,
      "text": "Thanks. Hello, come in, sit down. What brings you in today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 16.22,
      "end_seconds": 23.61,
      "duration_seconds": 7.39,
      "text": "I mean, hello, doctor i hope it's alright if I stay in for this"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.91,
      "end_seconds": 27.8,
      "duration_seconds": 2.89,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 28.66,
      "end_seconds": 36.46,
      "duration_seconds": 7.8,
      "text": "It's a high reading at the pharmacy, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.16,
      "end_seconds": 40.09,
      "duration_seconds": 2.93,
      "text": "how long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 41.69,
      "end_seconds": 46.84,
      "duration_seconds": 5.15,
      "text": "Let me think, it's been going on for ten days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.95,
      "end_seconds": 50.96,
      "duration_seconds": 3.01,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 51.52,
      "end_seconds": 58.39,
      "duration_seconds": 6.87,
      "text": "let me think, maybe a seven out of ten on a bad day"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 59.06,
      "end_seconds": 68.46,
      "duration_seconds": 9.4,
      "text": "Well, uh, and the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 68.56,
      "end_seconds": 73.83,
      "duration_seconds": 5.27,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 74.46,
      "end_seconds": 82.63,
      "duration_seconds": 8.17,
      "text": "So, uh, I was getting to that! I've also had being a bit nervous at appointments."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 84.37,
      "end_seconds": 87.86,
      "duration_seconds": 3.49,
      "text": "Yes, that's right, that's how it was."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.56,
      "end_seconds": 94.16,
      "duration_seconds": 4.6,
      "text": "A few quick ones: leg swelling, breathlessness or visual changes?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 96.15,
      "end_seconds": 109.7,
      "duration_seconds": 13.55,
      "text": "No, no leg swelling, no breathlessness, no visual changes. I did have an occasional headache at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.92,
      "end_seconds": 113.67,
      "duration_seconds": 2.75,
      "text": "and chest pain, any of that?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 115.17,
      "end_seconds": 118.16,
      "duration_seconds": 2.99,
      "text": "No, um, no chest pain."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.09,
      "end_seconds": 122.55,
      "duration_seconds": 2.46,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 124.55,
      "end_seconds": 125.92,
      "duration_seconds": 1.37,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.0,
      "end_seconds": 131.66,
      "duration_seconds": 3.66,
      "text": "tell me about any past illnesses or ongoing conditions"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 135.48,
      "end_seconds": 150.55,
      "duration_seconds": 15.07,
      "text": "I've had depression for about ten years now. I told myself I'd wait and see, and and here I am. High blood pressure, for about ten years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.65,
      "end_seconds": 153.56,
      "duration_seconds": 0.91,
      "text": "I follow"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 154.31,
      "end_seconds": 161.17,
      "duration_seconds": 6.86,
      "text": "I've had low haemoglobin for nearly five years now. I have heart failure."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.48,
      "end_seconds": 179.66,
      "duration_seconds": 4.18,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 180.54,
      "end_seconds": 185.31,
      "duration_seconds": 4.77,
      "text": "Mm, I take sertraline, 50 milligrams, once a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 186.68,
      "end_seconds": 196.31,
      "duration_seconds": 9.63,
      "text": "doctor, I think the last prescription for the sertraline was 25 milligrams we changed it at the last visit"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.49,
      "end_seconds": 203.25,
      "duration_seconds": 5.76,
      "text": "Okay. Have you got the the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 204.8,
      "end_seconds": 223.08,
      "duration_seconds": 18.28,
      "text": "I don't think I have it with me. Valsartan, 80 milligrams, once a day. Iron tablets. I take it once a day for my blood count. Furosemide. I take it 40 milligrams, every morning."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.51,
      "end_seconds": 227.57,
      "duration_seconds": 3.06,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 228.49,
      "end_seconds": 234.57,
      "duration_seconds": 6.08,
      "text": "for nearly five years i used to take ramipril, but I stopped it"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.38,
      "end_seconds": 237.81,
      "duration_seconds": 2.43,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 238.6,
      "end_seconds": 242.98,
      "duration_seconds": 4.38,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.02,
      "end_seconds": 246.75,
      "duration_seconds": 2.73,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 250.02,
      "end_seconds": 254.91,
      "duration_seconds": 4.89,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.34,
      "end_seconds": 259.79,
      "duration_seconds": 3.45,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 260.5,
      "end_seconds": 263.42,
      "duration_seconds": 2.92,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 265.51,
      "end_seconds": 273.21,
      "duration_seconds": 7.7,
      "text": "Doctor, I've got the readings for you. Heart rate 94, BP is 169 over 94, temp 36.7 degrees."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.84,
      "end_seconds": 274.88,
      "duration_seconds": 1.04,
      "text": "okay, noted"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.6,
      "end_seconds": 316.81,
      "duration_seconds": 23.21,
      "text": "okay, so my impression from what you've said is this: I'd lean towards possible white-coat blood pressure i'd also keep early hypertension in mind let me repeat that back to make sure you've had a high reading at the pharmacy for ten days, and no chest pain or visual changes"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 318.52,
      "end_seconds": 319.22,
      "duration_seconds": 0.7,
      "text": "exactly"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.53,
      "end_seconds": 327.07,
      "duration_seconds": 5.54,
      "text": "let's get a 24-hour blood pressure monitor, for raised clinic blood pressure"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_6",
      "role": "CLINICAL_STAFF",
      "start_seconds": 327.58,
      "end_seconds": 330.42,
      "duration_seconds": 2.84,
      "text": "The earliest is Friday, 3:30 pm."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.78,
      "end_seconds": 369.0,
      "duration_seconds": 37.22,
      "text": "Cut back on salt and do a week of home readings. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. I'll want another look after the monitor."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 372.99,
      "end_seconds": 375.05,
      "duration_seconds": 2.06,
      "text": "Alright, I'll be back."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 376.02,
      "end_seconds": 380.44,
      "duration_seconds": 4.42,
      "text": "right, that's the plan do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 381.98,
      "end_seconds": 386.1,
      "duration_seconds": 4.12,
      "text": "good, you know, thanks, I'll see you then"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 387.7,
      "end_seconds": 389.14,
      "duration_seconds": 1.44,
      "text": "Goodbye for now."
    }
  ]
}