  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.56,
      "end_seconds": 3.35,
      "duration_seconds": 2.79,
      "text": "Good morning. I've just opened your notes."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.7,
      "end_seconds": 7.66,
      "duration_seconds": 0.96,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.39,
      "end_seconds": 11.34,
      "duration_seconds": 1.95,
      "text": "What's been worrying you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.95,
      "end_seconds": 17.86,
      "duration_seconds": 4.91,
      "text": "I've been dealing with a tingling lip then a blister."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.75,
      "end_seconds": 22.61,
      "duration_seconds": 3.86,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.26,
      "end_seconds": 26.89,
      "duration_seconds": 2.63,
      "text": "About... well, about a week."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.83,
      "end_seconds": 32.12,
      "duration_seconds": 3.29,
      "text": "Okay, is it worse at certain times?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.64,
      "end_seconds": 38.97,
      "duration_seconds": 4.33,
      "text": "yes, sunlight and stress. That makes it worse"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.56,
      "end_seconds": 41.55,
      "duration_seconds": 1.99,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.75,
      "end_seconds": 53.1,
      "duration_seconds": 10.35,
      "text": "and a mild sore feeling as well, since yesterday i did have crusting at one point, but that's gone now"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.94,
      "end_seconds": 58.92,
      "duration_seconds": 4.98,
      "text": "And what about sores in the mouth, rash elsewhere or eye pain?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 59.57,
      "end_seconds": 61.95,
      "duration_seconds": 2.38,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 63.98,
      "end_seconds": 66.03,
      "duration_seconds": 2.05,
      "text": "Have you had any fever?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 67.29,
      "end_seconds": 68.78,
      "duration_seconds": 1.49,
      "text": "Nope, no fever."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.41,
      "end_seconds": 72.85,
      "duration_seconds": 2.44,
      "text": "is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 74.73,
      "end_seconds": 78.53,
      "duration_seconds": 3.8,
      "text": "Bowels are regular, you know, nothing odd."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.21,
      "end_seconds": 81.8,
      "duration_seconds": 1.59,
      "text": "neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.8,
      "end_seconds": 85.95,
      "duration_seconds": 2.15,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.5,
      "end_seconds": 105.78,
      "duration_seconds": 1.28,
      "text": "how about smoking?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 106.92,
      "end_seconds": 110.74,
      "duration_seconds": 3.82,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.76,
      "end_seconds": 114.52,
      "duration_seconds": 1.76,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 116.61,
      "end_seconds": 119.46,
      "duration_seconds": 2.85,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.29,
      "end_seconds": 122.24,
      "duration_seconds": 1.95,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.97,
      "end_seconds": 126.72,
      "duration_seconds": 3.75,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.96,
      "end_seconds": 131.84,
      "duration_seconds": 3.88,
      "text": "What do you do during the the day?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.77,
      "end_seconds": 136.45,
      "duration_seconds": 3.68,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.52,
      "end_seconds": 139.74,
      "duration_seconds": 1.22,
      "text": "any previous surgeries?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 141.39,
      "end_seconds": 145.18,
      "duration_seconds": 3.79,
      "text": "let me think, no, not at all"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.77,
      "end_seconds": 149.98,
      "duration_seconds": 4.21,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 154.43,
      "end_seconds": 156.62,
      "duration_seconds": 2.19,
      "text": "no allergies at all"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.79,
      "end_seconds": 162.43,
      "duration_seconds": 4.64,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.06,
      "end_seconds": 167.54,
      "duration_seconds": 4.48,
      "text": "Levetiracetam. I take it 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.63,
      "end_seconds": 171.69,
      "duration_seconds": 2.06,
      "text": "Right, is that long-standing?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.26,
      "end_seconds": 175.44,
      "duration_seconds": 2.18,
      "text": "About about a month."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.25,
      "end_seconds": 183.41,
      "duration_seconds": 3.16,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 184.13,
      "end_seconds": 188.62,
      "duration_seconds": 4.49,
      "text": "I've had epilepsy for nearly five years now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 190.19,
      "end_seconds": 201.05,
      "duration_seconds": 10.86,
      "text": "Doctor, I've got the readings for you. Blood pressure 121 over 82, pulse is 75 beats a minute. Temperature 36.8, SpO2 99 percent on room air."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.72,
      "end_seconds": 203.01,
      "duration_seconds": 1.29,
      "text": "good, thank you"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.72,
      "end_seconds": 208.73,
      "duration_seconds": 4.01,
      "text": "alright, over here please and I'll take a look"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.14,
      "end_seconds": 212.87,
      "duration_seconds": 2.73,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.98,
      "end_seconds": 230.47,
      "duration_seconds": 6.49,
      "text": "there is a small cluster of blisters on the edge of the upper lip"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.51,
      "end_seconds": 236.35,
      "duration_seconds": 2.84,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.43,
      "end_seconds": 255.63,
      "duration_seconds": 5.2,
      "text": "Okay, so my impression is this: This is probably a cold sore."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.43,
      "end_seconds": 290.77,
      "duration_seconds": 18.34,
      "text": "I'm going to put you on aciclovir cream, 5%, five times a day, five days it's for cold sore avoid kissing and sharing towels until it has crusted over come back if not healed in ten days that's everything on my side anything you're unsure about?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 292.19,
      "end_seconds": 296.89,
      "duration_seconds": 4.7,
      "text": "Let me think, great, thank you for your help."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.83,
      "end_seconds": 300.18,
      "duration_seconds": 1.35,
      "text": "See you soon."
    }
  ]
