{
  "schema_version": "1.0",
  "encounter_id": "01760",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.67,
      "end_seconds": 5.9,
      "duration_seconds": 5.23,
      "text": "Hi there, the chair's free, sit down. What's been worrying you?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.77,
      "end_seconds": 12.86,
      "duration_seconds": 5.09,
      "text": "Well, I've been having pain on moving the eye."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.86,
      "end_seconds": 18.3,
      "duration_seconds": 3.44,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.58,
      "end_seconds": 25.93,
      "duration_seconds": 3.35,
      "text": "I've had it since this morning."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.97,
      "end_seconds": 30.86,
      "duration_seconds": 2.89,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.93,
      "end_seconds": 40.94,
      "duration_seconds": 8.01,
      "text": "Well, um, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.6,
      "end_seconds": 48.24,
      "duration_seconds": 5.64,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 48.97,
      "end_seconds": 51.1,
      "duration_seconds": 2.13,
      "text": "I'd call it severe."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 51.62,
      "end_seconds": 58.25,
      "duration_seconds": 6.63,
      "text": "Ah, I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 58.35,
      "end_seconds": 64.34,
      "duration_seconds": 5.99,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.0,
      "end_seconds": 67.72,
      "duration_seconds": 2.72,
      "text": "Alright, later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 69.73,
      "end_seconds": 76.12,
      "duration_seconds": 6.39,
      "text": "Oh, you know, and double vision. Had that since last weekend."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.23,
      "end_seconds": 83.83,
      "duration_seconds": 6.6,
      "text": "Have you had pain on moving the eye before, or is this the first time?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 85.09,
      "end_seconds": 95.33,
      "duration_seconds": 10.24,
      "text": "Yes, something like this happened a couple of years ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "UNKNOWN",
      "start_seconds": 96.69,
      "end_seconds": 99.54,
      "duration_seconds": 2.85,
      "text": "Mm, that's what happened, yes."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.17,
      "end_seconds": 103.16,
      "duration_seconds": 1.99,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 105.25,
      "end_seconds": 110.44,
      "duration_seconds": 5.19,
      "text": "Uh, I had a triple bypass eight years ago."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.95,
      "end_seconds": 115.68,
      "duration_seconds": 4.73,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 116.28,
      "end_seconds": 134.53,
      "duration_seconds": 18.25,
      "text": "I'll have a glass of wine with dinner. I quit smoking around ten years ago. I hardly move around during the day. Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.06,
      "end_seconds": 139.77,
      "duration_seconds": 3.71,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.04,
      "end_seconds": 150.88,
      "duration_seconds": 6.84,
      "text": "Well, my sister had breast cancer. My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.43,
      "end_seconds": 155.58,
      "duration_seconds": 3.15,
      "text": "Right, before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.46,
      "end_seconds": 162.6,
      "duration_seconds": 3.14,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.2,
      "end_seconds": 168.05,
      "duration_seconds": 3.85,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.95,
      "end_seconds": 184.39,
      "duration_seconds": 14.44,
      "text": "Diclofenac, 50 milligrams, when needed. It's lansoprazole, 30 milligrams, before breakfast. Well, I take propranolol, 40 milligrams, twice a day for the migraine prevention."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 186.13,
      "end_seconds": 191.09,
      "duration_seconds": 4.96,
      "text": "Doctor, our chart from the last visit lists it as 80 milligrams."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.76,
      "end_seconds": 196.28,
      "duration_seconds": 3.52,
      "text": "Hm. Do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.78,
      "end_seconds": 220.77,
      "duration_seconds": 19.99,
      "text": "Actually, you know, I don't think I have it with me. Sorry, you know, what was I saying, I take clopidogrel, 75 milligrams, once a day for the stent. Before this I was on sumatriptan; that's been stopped."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.71,
      "end_seconds": 224.56,
      "duration_seconds": 2.85,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 225.76,
      "end_seconds": 237.38,
      "duration_seconds": 11.62,
      "text": "I have arthritis in my knees, for about ten years. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.45,
      "end_seconds": 240.82,
      "duration_seconds": 1.37,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 241.7,
      "end_seconds": 254.74,
      "duration_seconds": 13.04,
      "text": "Mm, I've had acid reflux, yes. I've got migraines. I've been reading about it online and it worried me. I have heart disease."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.92,
      "end_seconds": 265.09,
      "duration_seconds": 9.17,
      "text": "Alright, arthritis in your knees and acid reflux, that matches what I have here. Have you noticed recent injury or sinus infection?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 266.51,
      "end_seconds": 279.77,
      "duration_seconds": 13.26,
      "text": "No, no recent injury, no sinus infection. I did have a swollen red eyelid at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.57,
      "end_seconds": 283.97,
      "duration_seconds": 2.4,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 285.18,
      "end_seconds": 286.28,
      "duration_seconds": 1.1,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 287.23,
      "end_seconds": 296.73,
      "duration_seconds": 9.5,
      "text": "Here are the numbers, doctor. Oxygen saturation is 96 percent, temperature 39.0, pressure 124 over 69, pulse is 106 beats a minute."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 297.9,
      "end_seconds": 299.32,
      "duration_seconds": 1.42,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 316.19,
      "end_seconds": 327.0,
      "duration_seconds": 10.81,
      "text": "Right, here's what I'm thinking. My working impression is orbital cellulitis. I can't rule out periorbital cellulitis yet. I want blood tests done, that's for orbital cellulitis."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 333.04,
      "end_seconds": 337.88,
      "duration_seconds": 4.84,
      "text": "We have a slot Thursday at 2 pm, if that works."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 338.79,
      "end_seconds": 341.56,
      "duration_seconds": 2.77,
      "text": "Thursday, that works for me."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 342.91,
      "end_seconds": 372.17,
      "duration_seconds": 29.26,
      "text": "I'd like to arrange an urgent CT scan for orbital cellulitis. You need admission today for intravenous antibiotics. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Come back or go to emergency straight away if the symptoms get worse. I'd like to see you again straight away. Can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 376.52,
      "end_seconds": 381.19,
      "duration_seconds": 4.67,
      "text": "So, I come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 381.77,
      "end_seconds": 387.28,
      "duration_seconds": 5.51,
      "text": "Yes, exactly right. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 388.17,
      "end_seconds": 391.27,
      "duration_seconds": 3.1,
      "text": "I think I understand everything. Thanks."
    }
  ]
}