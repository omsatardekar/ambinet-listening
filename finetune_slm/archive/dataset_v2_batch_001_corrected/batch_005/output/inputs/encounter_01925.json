{
  "schema_version": "1.0",
  "encounter_id": "01925",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.24,
      "end_seconds": 2.74,
      "duration_seconds": 1.5,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.39,
      "end_seconds": 8.75,
      "duration_seconds": 4.36,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.43,
      "end_seconds": 17.53,
      "duration_seconds": 7.1,
      "text": "So, So the thing is, I've got a pulled muscle in my thigh."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.92,
      "end_seconds": 25.23,
      "duration_seconds": 2.31,
      "text": "Right, when did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.38,
      "end_seconds": 28.99,
      "duration_seconds": 2.61,
      "text": "It's been one week now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.87,
      "end_seconds": 34.13,
      "duration_seconds": 3.26,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.81,
      "end_seconds": 37.97,
      "duration_seconds": 2.16,
      "text": "I'd call it severe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.91,
      "end_seconds": 42.05,
      "duration_seconds": 2.14,
      "text": "Have you noticed any triggers?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.7,
      "end_seconds": 47.41,
      "duration_seconds": 3.71,
      "text": "Yes, running and stretching. That makes it worse."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.27,
      "end_seconds": 50.4,
      "duration_seconds": 2.13,
      "text": "What eases it, if anything?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.11,
      "end_seconds": 59.26,
      "duration_seconds": 8.15,
      "text": "I get some relief from rest. I've had a bit of bruising too, for two months."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.54,
      "end_seconds": 73.38,
      "duration_seconds": 4.84,
      "text": "A few quick ones: pop at the time or swelling?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.54,
      "end_seconds": 80.17,
      "duration_seconds": 5.63,
      "text": "I haven't had pop at the time or swelling, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.04,
      "end_seconds": 86.98,
      "duration_seconds": 1.94,
      "text": "Any sign of numbness?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.74,
      "end_seconds": 89.54,
      "duration_seconds": 1.8,
      "text": "No, no numbness."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.87,
      "end_seconds": 93.36,
      "duration_seconds": 2.49,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.09,
      "end_seconds": 98.03,
      "duration_seconds": 2.94,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.68,
      "end_seconds": 104.42,
      "duration_seconds": 4.74,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.73,
      "end_seconds": 109.49,
      "duration_seconds": 3.76,
      "text": "I have acid reflux, for two years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.0,
      "end_seconds": 113.08,
      "duration_seconds": 2.08,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.28,
      "end_seconds": 118.67,
      "duration_seconds": 4.39,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.35,
      "end_seconds": 122.77,
      "duration_seconds": 2.42,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.61,
      "end_seconds": 127.02,
      "duration_seconds": 2.41,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.76,
      "end_seconds": 132.82,
      "duration_seconds": 4.06,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.41,
      "end_seconds": 135.81,
      "duration_seconds": 2.4,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.22,
      "end_seconds": 155.32,
      "duration_seconds": 2.1,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.1,
      "end_seconds": 165.04,
      "duration_seconds": 8.94,
      "text": "I take omeprazole, 20 milligrams, once a day. I take ibuprofen gel, three times a day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.01,
      "end_seconds": 175.49,
      "duration_seconds": 1.48,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.7,
      "end_seconds": 179.88,
      "duration_seconds": 3.18,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.58,
      "end_seconds": 197.07,
      "duration_seconds": 2.49,
      "text": "So, I'll do your observations first."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.62,
      "end_seconds": 208.82,
      "duration_seconds": 2.2,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.38,
      "end_seconds": 229.0,
      "duration_seconds": 10.62,
      "text": "Okay: respiratory rate 15, heart rate 73, oxygen saturation is 97 percent, blood pressure 127 over 77, temperature is 36.7 degrees."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.78,
      "end_seconds": 234.83,
      "duration_seconds": 4.05,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.61,
      "end_seconds": 236.31,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.03,
      "end_seconds": 241.28,
      "duration_seconds": 3.25,
      "text": "Alright, take a deep breath for me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.92,
      "end_seconds": 261.54,
      "duration_seconds": 8.62,
      "text": "There is mild tenderness in the back of the thigh and you can still straighten the knee fully."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.49,
      "end_seconds": 289.78,
      "duration_seconds": 22.29,
      "text": "Okay, that's enough for me. Let me tell you where I've got to. The most likely explanation is a mild hamstring strain. Rest for a few days, ice it, and then ease back in with gentle stretching. We'll catch up if not better in two weeks."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 291.86,
      "end_seconds": 295.77,
      "duration_seconds": 3.91,
      "text": "Come by reception afterwards and I'll fix the appointment."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.36,
      "end_seconds": 299.84,
      "duration_seconds": 3.48,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.25,
      "end_seconds": 303.31,
      "duration_seconds": 2.06,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}