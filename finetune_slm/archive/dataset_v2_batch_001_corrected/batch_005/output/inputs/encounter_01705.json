{
  "schema_version": "1.0",
  "encounter_id": "01705",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.9,
      "end_seconds": 9.22,
      "duration_seconds": 8.32,
      "text": "doctor the patient's with us now. I did the usual checks at the front so just say when you want them"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.28,
      "end_seconds": 13.66,
      "duration_seconds": 3.38,
      "text": "thank you. Right, hello, what's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.86,
      "end_seconds": 26.06,
      "duration_seconds": 11.2,
      "text": "Morning um doctor. I'll stay and fill in anything that's missed. Doctor it's been feeling nervous about exertion. That's what we're worried about."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.19,
      "end_seconds": 30.42,
      "duration_seconds": 3.23,
      "text": "so how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 32.38,
      "end_seconds": 36.15,
      "duration_seconds": 3.77,
      "text": "I'd say about a month, uh, maybe"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 37.5,
      "end_seconds": 41.38,
      "duration_seconds": 3.88,
      "text": "hm, I'd say more like about two months"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.62,
      "end_seconds": 46.66,
      "duration_seconds": 4.04,
      "text": "Okay, so roughly one to two months. Is that right?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 48.23,
      "end_seconds": 50.26,
      "duration_seconds": 2.03,
      "text": "I suppose so, yes."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.29,
      "end_seconds": 55.36,
      "duration_seconds": 3.07,
      "text": "is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 56.66,
      "end_seconds": 62.36,
      "duration_seconds": 5.7,
      "text": "Sorry, what was I saying, it feels mild to me."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.39,
      "end_seconds": 66.19,
      "duration_seconds": 2.8,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 67.31,
      "end_seconds": 75.13,
      "duration_seconds": 7.82,
      "text": "An ache in my chest wall goes along with it, most of the time"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 76.05,
      "end_seconds": 83.85,
      "duration_seconds": 7.8,
      "text": "And the other thing I wanted to mention is that that I can't really—"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 83.95,
      "end_seconds": 89.54,
      "duration_seconds": 5.59,
      "text": "Tell the doctor about the other thing that's what worries me."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 90.61,
      "end_seconds": 98.79,
      "duration_seconds": 8.18,
      "text": "yeah, I was getting to that! The ache in my chest wall? That's been for two weeks"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.28,
      "end_seconds": 103.58,
      "duration_seconds": 3.3,
      "text": "So, is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 105.26,
      "end_seconds": 110.62,
      "duration_seconds": 5.36,
      "text": "maybe a a eight out of ten on a bad day"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.36,
      "end_seconds": 116.35,
      "duration_seconds": 4.99,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 117.04,
      "end_seconds": 120.29,
      "duration_seconds": 3.25,
      "text": "it sort of comes and goes"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.75,
      "end_seconds": 121.7,
      "duration_seconds": 0.95,
      "text": "right, right"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.22,
      "end_seconds": 134.51,
      "duration_seconds": 1.29,
      "text": "do you smoke?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 136.08,
      "end_seconds": 139.87,
      "duration_seconds": 3.79,
      "text": "No, I've never smoked in my life"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.28,
      "end_seconds": 143.1,
      "duration_seconds": 1.82,
      "text": "Okay, are you active?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 144.22,
      "end_seconds": 147.13,
      "duration_seconds": 2.91,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.81,
      "end_seconds": 153.39,
      "duration_seconds": 4.58,
      "text": "what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 154.21,
      "end_seconds": 167.78,
      "duration_seconds": 13.57,
      "text": "I've got high blood pressure yes high cholesterol i've been reading about it online and it it worried me i've had heart disease for about a year now"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.13,
      "end_seconds": 180.43,
      "duration_seconds": 11.3,
      "text": "Okay I can see high blood pressure and and heart disease in your file as well. So has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 182.46,
      "end_seconds": 185.42,
      "duration_seconds": 2.96,
      "text": "my daughter has type 1 diabetes"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.48,
      "end_seconds": 189.05,
      "duration_seconds": 2.57,
      "text": "Before we go further any allergies?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 190.36,
      "end_seconds": 194.52,
      "duration_seconds": 4.16,
      "text": "I, I don't think I have any, no."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.1,
      "end_seconds": 202.9,
      "duration_seconds": 4.8,
      "text": "can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 204.02,
      "end_seconds": 209.01,
      "duration_seconds": 4.99,
      "text": "Amlodipine. I take it 5 milligrams, once a day"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 210.06,
      "end_seconds": 218.03,
      "duration_seconds": 7.97,
      "text": "erm, it's a... um, I can't remember what it's called. It's a round yellow one"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.15,
      "end_seconds": 222.07,
      "duration_seconds": 2.92,
      "text": "do you remember what it's for?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 223.85,
      "end_seconds": 242.94,
      "duration_seconds": 19.09,
      "text": "for my cholesterol I believe my wife sets them out for me I just take what I'm given. Metoprolol 50 milligrams twice a day i'd been on aspirin not any more though I stopped"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.26,
      "end_seconds": 247.53,
      "duration_seconds": 3.27,
      "text": "And what about leg swelling, fainting or palpitations?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 248.83,
      "end_seconds": 260.12,
      "duration_seconds": 11.29,
      "text": "no no leg swelling no fainting no palpitations. I did have a little breathlessness at one point but that went away on its own"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.92,
      "end_seconds": 266.23,
      "duration_seconds": 4.31,
      "text": "what about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 271.19,
      "end_seconds": 275.46,
      "duration_seconds": 4.27,
      "text": "Sorry what was I saying no all normal there."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 276.24,
      "end_seconds": 284.73,
      "duration_seconds": 8.49,
      "text": "okay so the vitals from earlier blood pressure 109 over 68 temperature is 37.0 degrees oxygen saturation is 97 percent pulse 71."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.93,
      "end_seconds": 290.63,
      "duration_seconds": 0.7,
      "text": "thanks"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.39,
      "end_seconds": 295.05,
      "duration_seconds": 2.66,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 305.12,
      "end_seconds": 306.47,
      "duration_seconds": 1.35,
      "text": "Yeah no problem."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.44,
      "end_seconds": 310.78,
      "duration_seconds": 2.34,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.63,
      "end_seconds": 327.78,
      "duration_seconds": 6.15,
      "text": "Your heart rate and rhythm are regular and the breastbone wound has healed."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.59,
      "end_seconds": 347.8,
      "duration_seconds": 17.21,
      "text": "Please sit back down. Okay, so my impression is this: The most likely explanation is recovering well after a heart attack. The reason I say that is that your story and my examination fit together. Another possibility is anxiety."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 349.86,
      "end_seconds": 351.39,
      "duration_seconds": 1.53,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.1,
      "end_seconds": 361.79,
      "duration_seconds": 9.69,
      "text": "I can't promise yet, but most people with recovering well after a heart attack do well once it's treated properly"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 367.05,
      "end_seconds": 373.35,
      "duration_seconds": 6.3,
      "text": "doctor, I did an ECG before they came in, the result's on your screen"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 375.44,
      "end_seconds": 382.33,
      "duration_seconds": 6.89,
      "text": "thanks, I'll have a look. A cholesterol test is what I'd like next, for secondary prevention"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 384.29,
      "end_seconds": 388.15,
      "duration_seconds": 3.86,
      "text": "Ah, where would I go for that?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 389.26,
      "end_seconds": 408.26,
      "duration_seconds": 19.0,
      "text": "start the rehabilitation classes and build up walking gradually the thing that would worry me is if the symptoms get worse if that happens go to emergency let's review you in three months is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 409.33,
      "end_seconds": 412.57,
      "duration_seconds": 3.24,
      "text": "I think I understand everything thanks"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 413.96,
      "end_seconds": 415.26,
      "duration_seconds": 1.3,
      "text": "look after yourself"
    }
  ]
}