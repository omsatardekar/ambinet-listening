{
  "schema_version": "1.0",
  "encounter_id": "01775",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.7,
      "end_seconds": 2.61,
      "duration_seconds": 1.91,
      "text": "Evening. Let's get started."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.05,
      "end_seconds": 10.57,
      "duration_seconds": 6.52,
      "text": "Hi doctor, uh, I got here as fast as I could."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.2,
      "end_seconds": 14.91,
      "duration_seconds": 2.71,
      "text": "Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.73,
      "end_seconds": 20.38,
      "duration_seconds": 4.65,
      "text": "Well, I've been having a swollen red eyelid."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.25,
      "end_seconds": 24.69,
      "duration_seconds": 2.44,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.23,
      "end_seconds": 28.92,
      "duration_seconds": 3.69,
      "text": "Actually, it's been three weeks now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.53,
      "end_seconds": 38.39,
      "duration_seconds": 8.86,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.38,
      "end_seconds": 50.52,
      "duration_seconds": 6.14,
      "text": "It happens a couple of times a week. It's moderate, honestly."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.1,
      "end_seconds": 54.83,
      "duration_seconds": 3.73,
      "text": "What about double vision, have you noticed that?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 56.41,
      "end_seconds": 59.62,
      "duration_seconds": 3.21,
      "text": "Yes, for about two weeks."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.42,
      "end_seconds": 65.97,
      "duration_seconds": 4.55,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.88,
      "end_seconds": 70.5,
      "duration_seconds": 3.62,
      "text": "Diclofenac. I come out in... well, wheezing."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.68,
      "end_seconds": 75.42,
      "duration_seconds": 3.74,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.2,
      "end_seconds": 93.44,
      "duration_seconds": 16.24,
      "text": "Spironolactone, 25 milligrams, once a day for my heart. Naproxen. I take it 250 milligrams, twice a day. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.26,
      "end_seconds": 97.86,
      "duration_seconds": 2.6,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 99.09,
      "end_seconds": 104.13,
      "duration_seconds": 5.04,
      "text": "So, just my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.02,
      "end_seconds": 111.49,
      "duration_seconds": 5.47,
      "text": "Okay, tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 112.46,
      "end_seconds": 126.11,
      "duration_seconds": 13.65,
      "text": "I walk the dog every morning. I live with my elderly mother. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.71,
      "end_seconds": 143.42,
      "duration_seconds": 2.71,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 145.23,
      "end_seconds": 148.35,
      "duration_seconds": 3.12,
      "text": "I've had heart failure, yes."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.38,
      "end_seconds": 150.08,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.85,
      "end_seconds": 161.5,
      "duration_seconds": 5.65,
      "text": "I have arthritis in my knees, for about ten years."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.51,
      "end_seconds": 166.93,
      "duration_seconds": 4.42,
      "text": "Ah. Any sinus infection or recent injury at all?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.88,
      "end_seconds": 175.08,
      "duration_seconds": 7.2,
      "text": "Ah, um, no sinus infection or recent injury, none of it."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.85,
      "end_seconds": 179.6,
      "duration_seconds": 2.75,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.52,
      "end_seconds": 184.12,
      "duration_seconds": 2.6,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.4,
      "end_seconds": 189.27,
      "duration_seconds": 3.87,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 190.07,
      "end_seconds": 192.61,
      "duration_seconds": 2.54,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 199.91,
      "end_seconds": 207.99,
      "duration_seconds": 8.08,
      "text": "Okay, so the vitals from earlier. Heart rate 100, respiratory rate 20, temperature 39.4, blood pressure 105 over 75."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.73,
      "end_seconds": 210.73,
      "duration_seconds": 1.0,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.89,
      "end_seconds": 216.92,
      "duration_seconds": 4.03,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 218.23,
      "end_seconds": 220.05,
      "duration_seconds": 1.82,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.31,
      "end_seconds": 223.46,
      "duration_seconds": 2.15,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.65,
      "end_seconds": 246.25,
      "duration_seconds": 6.6,
      "text": "The eyelid is swollen shut, the eye is bulging and the movements are painful and limited."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.32,
      "end_seconds": 251.36,
      "duration_seconds": 3.04,
      "text": "So, thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.6,
      "end_seconds": 293.16,
      "duration_seconds": 25.56,
      "text": "Let me tell you where I've got to. It fits best with orbital cellulitis. Let's get an urgent CT scan, for orbital cellulitis. Let's get blood tests, for orbital cellulitis. I'd rather check than guess, and this is the quickest way to know more. You need admission today for intravenous antibiotics. Please come and see me straight away. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 294.38,
      "end_seconds": 297.85,
      "duration_seconds": 3.47,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 300.96,
      "end_seconds": 302.21,
      "duration_seconds": 1.25,
      "text": "Take care now."
    }
  ]
}