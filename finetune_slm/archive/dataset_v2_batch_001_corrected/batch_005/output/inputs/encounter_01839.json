{
  "schema_version": "1.0",
  "encounter_id": "01839",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.74,
      "end_seconds": 6.5,
      "duration_seconds": 5.76,
      "text": "Doctor, if you're free, we can start. I've got the numbers noted down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.77,
      "end_seconds": 13.41,
      "duration_seconds": 5.64,
      "text": "Thanks. Hello, come in, sit down. What brings you in today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.79,
      "end_seconds": 20.95,
      "duration_seconds": 6.16,
      "text": "Hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.28,
      "end_seconds": 25.58,
      "duration_seconds": 3.3,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 26.5,
      "end_seconds": 32.58,
      "duration_seconds": 6.08,
      "text": "Doctor, it's thoughts of ending my life. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.12,
      "end_seconds": 37.03,
      "duration_seconds": 3.91,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 37.84,
      "end_seconds": 42.76,
      "duration_seconds": 4.92,
      "text": "Uh, it's been four weeks, I'm fairly sure."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.7,
      "end_seconds": 47.83,
      "duration_seconds": 3.13,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 51.92,
      "end_seconds": 57.33,
      "duration_seconds": 5.41,
      "text": "Maybe a six out of ten on a bad day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 57.84,
      "end_seconds": 65.02,
      "duration_seconds": 7.18,
      "text": "And, And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 65.12,
      "end_seconds": 70.02,
      "duration_seconds": 4.9,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 71.77,
      "end_seconds": 80.23,
      "duration_seconds": 8.46,
      "text": "I was getting to that! And there's not sleeping for days as well, about two weeks now."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.13,
      "end_seconds": 85.54,
      "duration_seconds": 3.41,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 91.35,
      "end_seconds": 102.74,
      "duration_seconds": 11.39,
      "text": "Mm, I'd give it a three, out of ten. I did have a plan at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.94,
      "end_seconds": 110.23,
      "duration_seconds": 6.29,
      "text": "Have you had thoughts of ending your life before, or is this the first time?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 112.19,
      "end_seconds": 117.87,
      "duration_seconds": 5.68,
      "text": "A bit, about six months ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 118.8,
      "end_seconds": 120.76,
      "duration_seconds": 1.96,
      "text": "Yes, exactly like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 121.31,
      "end_seconds": 130.18,
      "duration_seconds": 8.87,
      "text": "Okay, so the vitals from earlier. Temp 36.7 degrees, pulse is 78 beats a minute, blood pressure 110 over 82."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.69,
      "end_seconds": 132.13,
      "duration_seconds": 1.44,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.91,
      "end_seconds": 136.01,
      "duration_seconds": 2.1,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.57,
      "end_seconds": 140.41,
      "duration_seconds": 2.84,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.11,
      "end_seconds": 158.17,
      "duration_seconds": 7.06,
      "text": "You are calm but very flat, and you have thought through how you would do it."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.73,
      "end_seconds": 167.1,
      "duration_seconds": 6.37,
      "text": "You can sit up now. A few quick ones: recent loss, hearing voices or drinking?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 171.2,
      "end_seconds": 173.92,
      "duration_seconds": 2.72,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.53,
      "end_seconds": 177.28,
      "duration_seconds": 2.75,
      "text": "Any sign of having taken tablets?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 178.63,
      "end_seconds": 181.4,
      "duration_seconds": 2.77,
      "text": "No. No having taken tablets."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.68,
      "end_seconds": 185.82,
      "duration_seconds": 4.14,
      "text": "Okay, go on. Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 186.69,
      "end_seconds": 189.49,
      "duration_seconds": 2.8,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.57,
      "end_seconds": 195.3,
      "duration_seconds": 3.73,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 197.31,
      "end_seconds": 202.72,
      "duration_seconds": 5.41,
      "text": "My sister had breast cancer. My father had bowel cancer."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.58,
      "end_seconds": 211.59,
      "duration_seconds": 5.01,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 213.48,
      "end_seconds": 217.34,
      "duration_seconds": 3.86,
      "text": "Wheat. I come out in... well, itchy skin."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.26,
      "end_seconds": 239.21,
      "duration_seconds": 3.95,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 240.48,
      "end_seconds": 250.94,
      "duration_seconds": 10.46,
      "text": "I quit smoking around ten years ago. I live with my elderly mother. Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.45,
      "end_seconds": 256.83,
      "duration_seconds": 4.38,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 257.37,
      "end_seconds": 265.46,
      "duration_seconds": 8.09,
      "text": "I've had depression for about ten years now. I've got asthma. I've got eczema. Yes, acid reflux."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.57,
      "end_seconds": 270.36,
      "duration_seconds": 3.79,
      "text": "So, what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 272.1,
      "end_seconds": 275.2,
      "duration_seconds": 3.1,
      "text": "It's sertraline, once a day, doctor."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.71,
      "end_seconds": 278.87,
      "duration_seconds": 2.16,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 280.1,
      "end_seconds": 284.39,
      "duration_seconds": 4.29,
      "text": "50 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.68,
      "end_seconds": 285.38,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 285.96,
      "end_seconds": 303.19,
      "duration_seconds": 17.23,
      "text": "She takes Foracort inhaler, twice a day for my asthma. She is on hydrocortisone cream, when needed, I give it to her. She is on omeprazole, 20 milligrams, once a day, I give it to her."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.39,
      "end_seconds": 307.42,
      "duration_seconds": 3.03,
      "text": "Since when have you been taking it?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 309.38,
      "end_seconds": 311.17,
      "duration_seconds": 1.79,
      "text": "For about a month."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 313.04,
      "end_seconds": 318.03,
      "duration_seconds": 4.99,
      "text": "I was on lansoprazole before. I stopped taking it."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.48,
      "end_seconds": 321.81,
      "duration_seconds": 2.33,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 323.63,
      "end_seconds": 328.9,
      "duration_seconds": 5.27,
      "text": "Yes, I had an operation for a hernia, last spring."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.1,
      "end_seconds": 377.69,
      "duration_seconds": 30.59,
      "text": "Having listened and examined, I think we're dealing with a high risk of suicide needing urgent assessment at this stage. That's my thinking for now, and it may change as we learn more. It could also be a severe depressive episode, so we'll keep that open. Just to be sure I understood. You've had thoughts of ending your life for four weeks, and no hearing voices or drinking."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 379.47,
      "end_seconds": 381.22,
      "duration_seconds": 1.75,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 381.95,
      "end_seconds": 391.5,
      "duration_seconds": 9.55,
      "text": "I'd like to arrange an urgent mental health assessment for suicidal thoughts. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_6",
      "role": "CLINICAL_STAFF",
      "start_seconds": 392.93,
      "end_seconds": 395.77,
      "duration_seconds": 2.84,
      "text": "The earliest is Monday, 11:30 am."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 401.48,
      "end_seconds": 412.64,
      "duration_seconds": 11.16,
      "text": "I want you to stay with me while we arrange help, and your family will be called. I'll want another look straight away."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 414.25,
      "end_seconds": 416.12,
      "duration_seconds": 1.87,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 417.42,
      "end_seconds": 420.8,
      "duration_seconds": 3.38,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 422.82,
      "end_seconds": 426.03,
      "duration_seconds": 3.21,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 428.06,
      "end_seconds": 429.27,
      "duration_seconds": 1.21,
      "text": "Goodbye for now."
    }
  ]
}