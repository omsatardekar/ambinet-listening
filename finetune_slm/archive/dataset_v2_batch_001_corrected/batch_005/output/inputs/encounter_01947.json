{
  "schema_version": "1.0",
  "encounter_id": "01947",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.78,
      "end_seconds": 6.8,
      "duration_seconds": 6.02,
      "text": "Right, hello, sorry about the delay, do sit. What's been worrying you?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.01,
      "end_seconds": 16.07,
      "duration_seconds": 8.06,
      "text": "Honestly, it's a stiff neck after sleeping badly, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.24,
      "end_seconds": 20.28,
      "duration_seconds": 3.04,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.14,
      "end_seconds": 26.62,
      "duration_seconds": 2.48,
      "text": "About... well, about two weeks."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.3,
      "end_seconds": 29.65,
      "duration_seconds": 2.35,
      "text": "What eases it, if anything?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.66,
      "end_seconds": 48.42,
      "duration_seconds": 14.76,
      "text": "I get some relief from heat. Oh, and tightness between my shoulders. That's been about the same, six months. With tightness between my shoulders, it happens on and off."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.05,
      "end_seconds": 53.6,
      "duration_seconds": 3.55,
      "text": "Any fever, head injury, headache or arm numbness?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 54.35,
      "end_seconds": 56.93,
      "duration_seconds": 2.58,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 58.01,
      "end_seconds": 60.26,
      "duration_seconds": 2.25,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 61.17,
      "end_seconds": 63.31,
      "duration_seconds": 2.14,
      "text": "no, all normal there"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.87,
      "end_seconds": 81.78,
      "duration_seconds": 4.91,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.47,
      "end_seconds": 87.22,
      "duration_seconds": 3.75,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.55,
      "end_seconds": 98.05,
      "duration_seconds": 3.5,
      "text": "any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.6,
      "end_seconds": 101.93,
      "duration_seconds": 3.33,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.71,
      "end_seconds": 108.47,
      "duration_seconds": 4.76,
      "text": "let's talk a little about your daily life and and habits"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.94,
      "end_seconds": 128.94,
      "duration_seconds": 19.0,
      "text": "I have about eight cigarettes in a day. I only drink at family occasions. I grab fast food at lunch most days. I live with my elderly mother. I hardly move around during the day"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.7,
      "end_seconds": 132.89,
      "duration_seconds": 2.19,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 133.87,
      "end_seconds": 136.53,
      "duration_seconds": 2.66,
      "text": "Nothing regular, um, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.67,
      "end_seconds": 145.64,
      "duration_seconds": 3.97,
      "text": "Alright, does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.66,
      "end_seconds": 148.91,
      "duration_seconds": 2.25,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.8,
      "end_seconds": 167.12,
      "duration_seconds": 4.32,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.9,
      "end_seconds": 181.96,
      "duration_seconds": 2.06,
      "text": "nearly done with the readings.."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.29,
      "end_seconds": 213.12,
      "duration_seconds": 9.83,
      "text": "Okay: pulse is 86 beats a minute, temperature is 36.6 degrees, blood pressure 109 over 68, oxygen saturation is 99 percent."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.2,
      "end_seconds": 217.55,
      "duration_seconds": 3.35,
      "text": "right, let's have a proper look at you"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 218.06,
      "end_seconds": 219.18,
      "duration_seconds": 1.12,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.02,
      "end_seconds": 223.77,
      "duration_seconds": 2.75,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.02,
      "end_seconds": 238.6,
      "duration_seconds": 5.58,
      "text": "The neck muscles on the left are tight and the movements are full."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.38,
      "end_seconds": 250.61,
      "duration_seconds": 8.23,
      "text": "Please sit back down. Okay, thinking it through, it fits best with a simple neck muscle strain."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 252.43,
      "end_seconds": 255.4,
      "duration_seconds": 2.97,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.32,
      "end_seconds": 266.29,
      "duration_seconds": 8.97,
      "text": "I understand the the worry. At the moment I'd say it's a simple neck muscle strain, and we'll watch how it goes."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.07,
      "end_seconds": 297.67,
      "duration_seconds": 15.6,
      "text": "Heat, gentle neck rolls, and a supportive pillow. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. We'll catch up if not better in two weeks."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 302.68,
      "end_seconds": 306.43,
      "duration_seconds": 3.75,
      "text": "Actually, uh, okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.9,
      "end_seconds": 312.28,
      "duration_seconds": 4.38,
      "text": "that's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 317.71,
      "end_seconds": 321.22,
      "duration_seconds": 3.51,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}