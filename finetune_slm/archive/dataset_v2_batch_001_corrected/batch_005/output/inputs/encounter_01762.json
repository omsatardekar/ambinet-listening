{
  "schema_version": "1.0",
  "encounter_id": "01762",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.61,
      "end_seconds": 3.54,
      "duration_seconds": 2.93,
      "text": "Good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 5.54,
      "end_seconds": 8.35,
      "duration_seconds": 2.81,
      "text": "Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.1,
      "end_seconds": 14.11,
      "duration_seconds": 5.01,
      "text": "So So the thing is, I've got a barking cough."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.67,
      "end_seconds": 19.86,
      "duration_seconds": 4.19,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 20.65,
      "end_seconds": 24.73,
      "duration_seconds": 4.08,
      "text": "I was on clopidogrel before. I stopped taking it"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.65,
      "end_seconds": 29.65,
      "duration_seconds": 3.0,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.55,
      "end_seconds": 37.26,
      "duration_seconds": 5.71,
      "text": "I'd say about a week actually, no, closer to three weeks"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 38.84,
      "end_seconds": 41.31,
      "duration_seconds": 2.47,
      "text": "does anything set it off?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.63,
      "end_seconds": 45.32,
      "duration_seconds": 2.69,
      "text": "Night definitely sets it off"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.75,
      "end_seconds": 49.55,
      "duration_seconds": 2.8,
      "text": "does anything else come with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.15,
      "end_seconds": 60.51,
      "duration_seconds": 10.36,
      "text": "A runny nose goes along with it, most of the time. I've also had a hoarse voice, since yesterday."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.58,
      "end_seconds": 71.46,
      "duration_seconds": 5.88,
      "text": "Have you had a barking cough before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 72.4,
      "end_seconds": 77.86,
      "duration_seconds": 5.46,
      "text": "I had a similar thing about six months ago. It went away"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.11,
      "end_seconds": 92.86,
      "duration_seconds": 2.75,
      "text": "And what about drooling or difficulty swallowing?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.78,
      "end_seconds": 97.42,
      "duration_seconds": 2.64,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.9,
      "end_seconds": 103.76,
      "duration_seconds": 4.86,
      "text": "And what about noisy breathing when resting or blue lips?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 105.39,
      "end_seconds": 108.18,
      "duration_seconds": 2.79,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.1,
      "end_seconds": 112.59,
      "duration_seconds": 2.49,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 114.23,
      "end_seconds": 115.27,
      "duration_seconds": 1.04,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.4,
      "end_seconds": 129.35,
      "duration_seconds": 2.95,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.79,
      "end_seconds": 133.74,
      "duration_seconds": 2.95,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.76,
      "end_seconds": 137.59,
      "duration_seconds": 2.83,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 138.68,
      "end_seconds": 142.16,
      "duration_seconds": 3.48,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.2,
      "end_seconds": 146.64,
      "duration_seconds": 3.44,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.51,
      "end_seconds": 154.07,
      "duration_seconds": 5.56,
      "text": "I had my appendix taken out when I was in my twenties"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.0,
      "end_seconds": 160.84,
      "duration_seconds": 2.84,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 162.75,
      "end_seconds": 165.38,
      "duration_seconds": 2.63,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.08,
      "end_seconds": 172.34,
      "duration_seconds": 5.26,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 177.85,
      "end_seconds": 180.78,
      "duration_seconds": 2.93,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.84,
      "end_seconds": 189.57,
      "duration_seconds": 2.73,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 191.33,
      "end_seconds": 194.33,
      "duration_seconds": 3.0,
      "text": "Heart disease, for nearly five years."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.54,
      "end_seconds": 199.12,
      "duration_seconds": 3.58,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.68,
      "end_seconds": 212.13,
      "duration_seconds": 2.45,
      "text": "Sit still for a a moment..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.62,
      "end_seconds": 232.96,
      "duration_seconds": 8.34,
      "text": "Okay: temperature is 36.7 degrees, pulse 78, pressure 116 over 80, respiratory rate 14, saturation 97 percent."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.03,
      "end_seconds": 237.94,
      "duration_seconds": 2.91,
      "text": "okay, time for me to examine you"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.68,
      "end_seconds": 241.63,
      "duration_seconds": 1.95,
      "text": "raise your arm for me"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.22,
      "end_seconds": 260.69,
      "duration_seconds": 7.47,
      "text": "he is playful, breathing comfortably at rest, and and I can't hear any noisy breathing now"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.63,
      "end_seconds": 267.84,
      "duration_seconds": 3.21,
      "text": "okay, that's all I needed to check"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.06,
      "end_seconds": 313.53,
      "duration_seconds": 38.47,
      "text": "Having listened and examined, the most likely explanation is mild croup. I'll start you on dexamethasone, 0.15 mg per kg, once, single dose. That's for croup. The pharmacy will go through the details again when you pick it up. Keep him calm, sit him upright, and give fluids. If he makes a noisy sound when resting or struggles to breathe, that's the point to come in urgently. Please come and see me if no better in two days."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 315.38,
      "end_seconds": 318.43,
      "duration_seconds": 3.05,
      "text": "so, does all of that make sense?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 319.42,
      "end_seconds": 321.58,
      "duration_seconds": 2.16,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}