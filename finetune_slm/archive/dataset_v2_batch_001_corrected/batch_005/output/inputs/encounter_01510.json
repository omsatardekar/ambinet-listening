{
  "schema_version": "1.0",
  "encounter_id": "01510",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.33,
      "end_seconds": 5.66,
      "duration_seconds": 4.33,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.38,
      "end_seconds": 10.85,
      "duration_seconds": 4.47,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.05,
      "end_seconds": 18.88,
      "duration_seconds": 6.83,
      "text": "Let me think, morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.89,
      "end_seconds": 29.81,
      "duration_seconds": 9.92,
      "text": "Doctor, it's pain under my right ribs after fatty meals. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.56,
      "end_seconds": 33.3,
      "duration_seconds": 2.74,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.99,
      "end_seconds": 46.54,
      "duration_seconds": 2.55,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.47,
      "end_seconds": 66.66,
      "duration_seconds": 10.19,
      "text": "Okay: SpO2 99 percent on room air, pressure 124 over 82, pulse 74. And temperature is 36.6 degrees. Since when exactly?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.72,
      "end_seconds": 71.46,
      "duration_seconds": 2.74,
      "text": "It's been ten days now."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.23,
      "end_seconds": 76.51,
      "duration_seconds": 3.28,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.91,
      "end_seconds": 80.15,
      "duration_seconds": 2.24,
      "text": "I'd call it mild."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.01,
      "end_seconds": 83.07,
      "duration_seconds": 2.06,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.42,
      "end_seconds": 101.38,
      "duration_seconds": 16.96,
      "text": "Pain going to my right shoulder goes along with it, um, most of the time. Oh, the pain going to my right shoulder? That's been for five days."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.6,
      "end_seconds": 105.55,
      "duration_seconds": 2.95,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.41,
      "end_seconds": 125.12,
      "duration_seconds": 17.71,
      "text": "I'd say moderate. There's bloating as well. About bloating, I'd say moderate. Actually, and I've been feeling sick as well, since this morning. About feeling sick, I'd call it severe."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.76,
      "end_seconds": 129.16,
      "duration_seconds": 3.4,
      "text": "Have you had any dark urine or fever?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.4,
      "end_seconds": 133.67,
      "duration_seconds": 3.27,
      "text": "Mm, nope, nothing like that."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.6,
      "end_seconds": 139.82,
      "duration_seconds": 4.22,
      "text": "Alright, and what about pale stools or yellow eyes?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.85,
      "end_seconds": 145.22,
      "duration_seconds": 4.37,
      "text": "Ah, um, no, not a single one."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.64,
      "end_seconds": 149.22,
      "duration_seconds": 1.58,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.15,
      "end_seconds": 154.32,
      "duration_seconds": 3.17,
      "text": "Hmm, no, nothing like that."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.92,
      "end_seconds": 157.28,
      "duration_seconds": 1.36,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.18,
      "end_seconds": 161.15,
      "duration_seconds": 1.97,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.37,
      "end_seconds": 166.04,
      "duration_seconds": 3.67,
      "text": "So, what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.97,
      "end_seconds": 170.24,
      "duration_seconds": 3.27,
      "text": "Escitalopram, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 171.22,
      "end_seconds": 179.48,
      "duration_seconds": 8.26,
      "text": "It's, It's meant to be once a day, though I don't see she take it every time."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.59,
      "end_seconds": 188.8,
      "duration_seconds": 5.21,
      "text": "Bisoprolol. I take it 2.5 milligrams, once a day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.75,
      "end_seconds": 194.0,
      "duration_seconds": 3.25,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.85,
      "end_seconds": 201.0,
      "duration_seconds": 5.15,
      "text": "My father has Parkinson's disease. My brother has epilepsy."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.92,
      "end_seconds": 204.88,
      "duration_seconds": 1.96,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.44,
      "end_seconds": 209.87,
      "duration_seconds": 3.43,
      "text": "I've had anxiety for two years now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.6,
      "end_seconds": 213.01,
      "duration_seconds": 1.41,
      "text": "Is that everything?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.2,
      "end_seconds": 224.79,
      "duration_seconds": 10.59,
      "text": "An irregular heartbeat, for about a year. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.45,
      "end_seconds": 226.69,
      "duration_seconds": 1.24,
      "text": "Is that everything?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.11,
      "end_seconds": 240.35,
      "duration_seconds": 3.24,
      "text": "Alright, a few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.0,
      "end_seconds": 263.68,
      "duration_seconds": 17.68,
      "text": "I smoke roughly a pack every two days. I'll have a glass of wine with dinner. I'm vegetarian and have been for years. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.67,
      "end_seconds": 267.28,
      "duration_seconds": 2.61,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.99,
      "end_seconds": 283.32,
      "duration_seconds": 14.33,
      "text": "Hmm, uh, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.01,
      "end_seconds": 287.17,
      "duration_seconds": 2.16,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.55,
      "end_seconds": 289.54,
      "duration_seconds": 0.99,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.71,
      "end_seconds": 292.39,
      "duration_seconds": 1.68,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.97,
      "end_seconds": 314.1,
      "duration_seconds": 7.13,
      "text": "It is tender under the right ribs and you stop breathing in when I press."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.1,
      "end_seconds": 319.96,
      "duration_seconds": 1.86,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.53,
      "end_seconds": 335.75,
      "duration_seconds": 7.22,
      "text": "So where does that leave us? It fits best with gallstone-related pain. Another possibility is a stomach ulcer."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.48,
      "end_seconds": 341.38,
      "duration_seconds": 3.9,
      "text": "Is this serious, you know, doctor?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.83,
      "end_seconds": 353.43,
      "duration_seconds": 7.6,
      "text": "It's reasonable to be concerned, but right now gallstone-related pain is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.02,
      "end_seconds": 368.3,
      "duration_seconds": 5.28,
      "text": "Liver blood tests is what I'd like next, for biliary pain."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 369.37,
      "end_seconds": 373.03,
      "duration_seconds": 3.66,
      "text": "Um, do I need to prepare?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.72,
      "end_seconds": 384.46,
      "duration_seconds": 5.74,
      "text": "I'm going to order an ultrasound of the abdomen, for biliary pain."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 385.19,
      "end_seconds": 388.4,
      "duration_seconds": 3.21,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 391.47,
      "end_seconds": 419.3,
      "duration_seconds": 27.83,
      "text": "I'll start you on paracetamol, 1 gram, four times a day when needed, one week. It's for pain. The pharmacy will go through the details again when you pick it up. Avoid fatty and fried foods until the scan. If the symptoms get worse, that's the point to come in urgently. I'd like to see you again after the scan. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 420.21,
      "end_seconds": 423.44,
      "duration_seconds": 3.23,
      "text": "Okay, so thank you, that's helpful."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 424.09,
      "end_seconds": 425.36,
      "duration_seconds": 1.27,
      "text": "Goodbye for now."
    }
  ]
}