{
  "schema_version": "1.0",
  "encounter_id": "01929",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.99,
      "end_seconds": 4.84,
      "duration_seconds": 3.85,
      "text": "Morning, um, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.85,
      "end_seconds": 9.89,
      "duration_seconds": 4.04,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.93,
      "end_seconds": 20.95,
      "duration_seconds": 10.02,
      "text": "Mainly a productive cough with rusty phlegm. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.47,
      "end_seconds": 23.74,
      "duration_seconds": 1.27,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.38,
      "end_seconds": 28.2,
      "duration_seconds": 2.82,
      "text": "About... well, about three months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.61,
      "end_seconds": 38.69,
      "duration_seconds": 10.08,
      "text": "I follow. Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.4,
      "end_seconds": 72.19,
      "duration_seconds": 28.79,
      "text": "Let me think, about a six out of ten. It just comes and goes. Sorry, I know I'm rambling a bit. Um, I've had a fever too, for two months. As for fever, I'd call it severe. Honestly, a couple of times a week. I've been feeling short of breath too."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.69,
      "end_seconds": 76.06,
      "duration_seconds": 3.37,
      "text": "I see, go ahead. Any recent travel?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.37,
      "end_seconds": 81.53,
      "duration_seconds": 2.16,
      "text": "Definitely no recent travel."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.3,
      "end_seconds": 86.44,
      "duration_seconds": 4.14,
      "text": "Any confusion, leg swelling or coughing up blood at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.49,
      "end_seconds": 92.85,
      "duration_seconds": 4.36,
      "text": "No, no confusion, leg swelling or coughing up blood."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.23,
      "end_seconds": 97.62,
      "duration_seconds": 3.39,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.23,
      "end_seconds": 100.19,
      "duration_seconds": 0.96,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.71,
      "end_seconds": 105.25,
      "duration_seconds": 3.54,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.16,
      "end_seconds": 115.51,
      "duration_seconds": 6.35,
      "text": "Yeah, yes, I had a wisdom tooth extraction under sedation, five years ago."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.12,
      "end_seconds": 119.04,
      "duration_seconds": 2.92,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.67,
      "end_seconds": 126.23,
      "duration_seconds": 5.56,
      "text": "Diabetes, for five years. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.75,
      "end_seconds": 146.07,
      "duration_seconds": 3.32,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.56,
      "end_seconds": 151.74,
      "duration_seconds": 4.18,
      "text": "Yeah, I take paracetamol, 1 gram, when needed."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.28,
      "end_seconds": 164.11,
      "duration_seconds": 3.83,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.92,
      "end_seconds": 167.67,
      "duration_seconds": 2.75,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.56,
      "end_seconds": 171.32,
      "duration_seconds": 2.76,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.58,
      "end_seconds": 188.42,
      "duration_seconds": 15.84,
      "text": "I only drink at family occasions. I drink a lot of tea and snack through the day. My husband and I live above the shop. Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 190.06,
      "end_seconds": 201.0,
      "duration_seconds": 10.94,
      "text": "Okay, so the vitals from earlier. SpO2 96 percent on room air, temp 38.3 degrees, BP is 119 over 80. Heart rate 90, respiratory rate 19."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.41,
      "end_seconds": 204.29,
      "duration_seconds": 1.88,
      "text": "Okay, good, thank you."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.1,
      "end_seconds": 209.44,
      "duration_seconds": 3.34,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.34,
      "end_seconds": 213.58,
      "duration_seconds": 2.24,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.48,
      "end_seconds": 234.17,
      "duration_seconds": 6.69,
      "text": "There are crackles at the right base and the breathing is a bit fast."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.99,
      "end_seconds": 239.79,
      "duration_seconds": 1.8,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.29,
      "end_seconds": 253.36,
      "duration_seconds": 4.07,
      "text": "Putting it all together, my working impression is community-acquired pneumonia."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.08,
      "end_seconds": 257.13,
      "duration_seconds": 2.05,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.8,
      "end_seconds": 292.08,
      "duration_seconds": 33.28,
      "text": "I can't promise yet, but most people with community-acquired pneumonia do well once it's treated properly. We should do blood tests for pneumonia. I want a chest X-ray done, that's for possible pneumonia. I'm prescribing amoxicillin, 500 milligrams, three times a day, five days. It's for chest infection. Rest, drink plenty, and come back if you are not improving in two days. Come back in one week."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.98,
      "end_seconds": 298.9,
      "duration_seconds": 5.92,
      "text": "Can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.92,
      "end_seconds": 309.9,
      "duration_seconds": 9.98,
      "text": "So, I take the amoxicillin, 500 milligrams, three times a day and come back in one week. Is that right?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.92,
      "end_seconds": 317.36,
      "duration_seconds": 5.44,
      "text": "Yes, exactly right. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.62,
      "end_seconds": 322.84,
      "duration_seconds": 2.22,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.86,
      "end_seconds": 325.04,
      "duration_seconds": 1.18,
      "text": "Look after yourself."
    }
  ]
}