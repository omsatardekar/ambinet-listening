{
  "schema_version": "1.0",
  "encounter_id": "01838",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.39,
      "end_seconds": 3.12,
      "duration_seconds": 1.73,
      "text": "Morning, come on through."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.14,
      "end_seconds": 6.15,
      "duration_seconds": 1.01,
      "text": "Evening, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.46,
      "end_seconds": 11.18,
      "duration_seconds": 3.72,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.39,
      "end_seconds": 20.89,
      "duration_seconds": 8.5,
      "text": "It's a stiff neck after sleeping badly. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.54,
      "end_seconds": 25.38,
      "duration_seconds": 3.84,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 27.43,
      "end_seconds": 40.48,
      "duration_seconds": 13.05,
      "text": "Honestly I can't say exactly when it started. It might have been last month or the month before, I really can't pin it down."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.58,
      "end_seconds": 44.84,
      "duration_seconds": 3.26,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.73,
      "end_seconds": 50.0,
      "duration_seconds": 3.27,
      "text": "Pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.83,
      "end_seconds": 56.91,
      "duration_seconds": 6.08,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 57.01,
      "end_seconds": 63.85,
      "duration_seconds": 6.84,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.04,
      "end_seconds": 73.59,
      "duration_seconds": 8.55,
      "text": "Later, thanks. Please go on. Have you had a stiff neck after sleeping badly before, or is this the first time?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.26,
      "end_seconds": 84.05,
      "duration_seconds": 5.79,
      "text": "I, I had a similar thing last winter. It went away."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 85.1,
      "end_seconds": 93.31,
      "duration_seconds": 8.21,
      "text": "Doctor, I've got the readings for you. Pulse 66, blood pressure 122 over 79, respiratory rate 16, temp 36.8 degrees."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.28,
      "end_seconds": 95.35,
      "duration_seconds": 1.07,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.49,
      "end_seconds": 102.39,
      "duration_seconds": 4.9,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.4,
      "end_seconds": 105.5,
      "duration_seconds": 2.1,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.83,
      "end_seconds": 125.17,
      "duration_seconds": 6.34,
      "text": "The neck muscles on the left are tight and the movements are full."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.39,
      "end_seconds": 132.42,
      "duration_seconds": 5.03,
      "text": "Please sit back down. Did you get arm numbness or headache?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 133.8,
      "end_seconds": 144.81,
      "duration_seconds": 11.01,
      "text": "No, no arm numbness, no headache. I did have tightness between my shoulders at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.1,
      "end_seconds": 148.84,
      "duration_seconds": 2.74,
      "text": "Did you get fever or head injury?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.35,
      "end_seconds": 152.75,
      "duration_seconds": 2.4,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.42,
      "end_seconds": 158.88,
      "duration_seconds": 4.46,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.65,
      "end_seconds": 163.16,
      "duration_seconds": 2.51,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.83,
      "end_seconds": 168.59,
      "duration_seconds": 4.76,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.24,
      "end_seconds": 171.15,
      "duration_seconds": 1.91,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.47,
      "end_seconds": 177.47,
      "duration_seconds": 5.0,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 179.09,
      "end_seconds": 185.4,
      "duration_seconds": 6.31,
      "text": "Not currently, but as a youngster trimethoprim gave me a rash."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.02,
      "end_seconds": 191.34,
      "duration_seconds": 1.32,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.72,
      "end_seconds": 195.66,
      "duration_seconds": 2.94,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.34,
      "end_seconds": 200.41,
      "duration_seconds": 3.07,
      "text": "Right, tell me about your eating."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 201.29,
      "end_seconds": 206.73,
      "duration_seconds": 5.44,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.02,
      "end_seconds": 210.82,
      "duration_seconds": 2.8,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 211.62,
      "end_seconds": 218.72,
      "duration_seconds": 7.1,
      "text": "I, I have gout. An irregular heartbeat, for five years. I've got heart disease."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.38,
      "end_seconds": 241.55,
      "duration_seconds": 4.17,
      "text": "Alright, are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 243.25,
      "end_seconds": 260.65,
      "duration_seconds": 17.4,
      "text": "Allopurinol. I take it 100 milligrams, once a day. I'm on metoprolol, 50 milligrams, twice a day. Though honestly, some days I forget to take it. I'm on paracetamol, 1 gram, when needed."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.04,
      "end_seconds": 265.37,
      "duration_seconds": 3.33,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 266.8,
      "end_seconds": 271.02,
      "duration_seconds": 4.22,
      "text": "I had a bunion operation six years ago."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.6,
      "end_seconds": 280.88,
      "duration_seconds": 9.28,
      "text": "Stop me if I've got anything wrong. You've had a stiff neck after sleeping badly, severe, and no headache or head injury."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 282.78,
      "end_seconds": 283.48,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.74,
      "end_seconds": 305.21,
      "duration_seconds": 8.47,
      "text": "Heat, gentle neck rolls, and a supportive pillow. I'd like you back if not better in two weeks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 306.9,
      "end_seconds": 310.43,
      "duration_seconds": 3.53,
      "text": "Come by reception afterwards and I'll fix the appointment."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 311.57,
      "end_seconds": 315.51,
      "duration_seconds": 3.94,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 316.32,
      "end_seconds": 319.31,
      "duration_seconds": 2.99,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 320.63,
      "end_seconds": 322.5,
      "duration_seconds": 1.87,
      "text": "Have a good day."
    }
  ]
}