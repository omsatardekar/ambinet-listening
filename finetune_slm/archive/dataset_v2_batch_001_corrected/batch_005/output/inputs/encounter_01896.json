{
  "schema_version": "1.0",
  "encounter_id": "01896",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.92,
      "end_seconds": 3.86,
      "duration_seconds": 2.94,
      "text": "Hello, good to see you. Please sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.77,
      "end_seconds": 7.31,
      "duration_seconds": 2.54,
      "text": "Good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 8.74,
      "end_seconds": 12.99,
      "duration_seconds": 4.25,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.06,
      "end_seconds": 20.41,
      "duration_seconds": 5.35,
      "text": "Please do. Extra information is always welcome. Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.92,
      "end_seconds": 27.32,
      "duration_seconds": 5.4,
      "text": "I wanted to get a very sore throat looked at."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.93,
      "end_seconds": 31.13,
      "duration_seconds": 3.2,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.89,
      "end_seconds": 33.9,
      "duration_seconds": 2.01,
      "text": "Probably ten days. Yeah."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.99,
      "end_seconds": 44.15,
      "duration_seconds": 9.16,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 45.65,
      "end_seconds": 53.03,
      "duration_seconds": 7.38,
      "text": "It settles a little with gargles. Mostly severe. I've also been feeling exhausted, since last night."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.19,
      "end_seconds": 59.25,
      "duration_seconds": 5.06,
      "text": "Have you had tummy pain on the left, by any chance?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 60.29,
      "end_seconds": 64.54,
      "duration_seconds": 4.25,
      "text": "Not at all, no tummy pain on the left."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.49,
      "end_seconds": 69.35,
      "duration_seconds": 2.86,
      "text": "Any difficulty breathing, rash or jaundice?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 71.14,
      "end_seconds": 75.41,
      "duration_seconds": 4.27,
      "text": "I haven't had difficulty breathing, rash or jaundice, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.68,
      "end_seconds": 79.76,
      "duration_seconds": 4.08,
      "text": "Ah. Okay, any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 81.01,
      "end_seconds": 82.6,
      "duration_seconds": 1.59,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.14,
      "end_seconds": 91.55,
      "duration_seconds": 3.41,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.87,
      "end_seconds": 99.19,
      "duration_seconds": 2.32,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.66,
      "end_seconds": 103.13,
      "duration_seconds": 2.47,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.67,
      "end_seconds": 109.66,
      "duration_seconds": 5.99,
      "text": "Yes, I had a meniscus repair on my knee, four years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.57,
      "end_seconds": 128.99,
      "duration_seconds": 4.42,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.01,
      "end_seconds": 133.03,
      "duration_seconds": 2.02,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.88,
      "end_seconds": 138.24,
      "duration_seconds": 3.36,
      "text": "Alright, have you got any known allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.18,
      "end_seconds": 142.0,
      "duration_seconds": 2.82,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.94,
      "end_seconds": 148.88,
      "duration_seconds": 5.94,
      "text": "Okay, tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.63,
      "end_seconds": 164.77,
      "duration_seconds": 14.14,
      "text": "I only drink at family occasions. I gave up cigarettes last spring. I live with my elderly mother. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.18,
      "end_seconds": 169.82,
      "duration_seconds": 3.64,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.67,
      "end_seconds": 176.14,
      "duration_seconds": 2.47,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.91,
      "end_seconds": 185.66,
      "duration_seconds": 3.75,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 187.39,
      "end_seconds": 190.6,
      "duration_seconds": 3.21,
      "text": "She takes throat lozenges, when needed."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.92,
      "end_seconds": 195.96,
      "duration_seconds": 4.04,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.18,
      "end_seconds": 207.62,
      "duration_seconds": 2.44,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.63,
      "end_seconds": 238.61,
      "duration_seconds": 9.98,
      "text": "Okay: pulse is 99 beats a minute, oxygen saturation is 96 percent. And BP is 104 over 68, temperature is 38.1 degrees."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 240.06,
      "end_seconds": 241.43,
      "duration_seconds": 1.37,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.7,
      "end_seconds": 245.65,
      "duration_seconds": 2.95,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.56,
      "end_seconds": 251.07,
      "duration_seconds": 3.51,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.25,
      "end_seconds": 254.34,
      "duration_seconds": 2.09,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.02,
      "end_seconds": 276.07,
      "duration_seconds": 7.05,
      "text": "Your tonsils are large with white coating and the glands in the neck are tender."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.36,
      "end_seconds": 280.22,
      "duration_seconds": 1.86,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.88,
      "end_seconds": 304.62,
      "duration_seconds": 12.74,
      "text": "Having listened and examined, this looks most like glandular fever. That's my thinking for now, and it may change as we learn more. Another possibility is streptococcal tonsillitis."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 309.41,
      "end_seconds": 311.57,
      "duration_seconds": 2.16,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 313.13,
      "end_seconds": 319.69,
      "duration_seconds": 6.56,
      "text": "I can't promise yet, but most people with glandular fever do well once it's treated properly."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 331.07,
      "end_seconds": 337.1,
      "duration_seconds": 6.03,
      "text": "I'm going to order a monospot test, for sore throat and fatigue."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 338.05,
      "end_seconds": 340.6,
      "duration_seconds": 2.55,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 342.26,
      "end_seconds": 355.45,
      "duration_seconds": 13.19,
      "text": "Rest, plenty of fluids, and no contact sport for a month because of the spleen. Let's review you in two weeks. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 358.97,
      "end_seconds": 362.46,
      "duration_seconds": 3.49,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 363.82,
      "end_seconds": 365.18,
      "duration_seconds": 1.36,
      "text": "Look after yourself."
    }
  ]
}