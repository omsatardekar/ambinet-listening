{
  "schema_version": "1.0",
  "encounter_id": "01551",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.33,
      "end_seconds": 5.37,
      "duration_seconds": 4.04,
      "text": "Come in, have a seat by the desk."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.31,
      "end_seconds": 10.51,
      "duration_seconds": 3.2,
      "text": "Hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.04,
      "end_seconds": 16.43,
      "duration_seconds": 5.39,
      "text": "Doctor, I'll sit in if that's okay, I know what's been happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.74,
      "end_seconds": 24.16,
      "duration_seconds": 6.42,
      "text": "Good, that'll be useful. Pull up a chair. So what can I do for you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.65,
      "end_seconds": 31.26,
      "duration_seconds": 5.61,
      "text": "it's an itchy scalp i thought I'd wait, but it hasn't gone"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.68,
      "end_seconds": 35.03,
      "duration_seconds": 2.35,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 40.18,
      "end_seconds": 43.47,
      "duration_seconds": 3.29,
      "text": "Ever since... since last Tuesday, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.83,
      "end_seconds": 44.53,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.25,
      "end_seconds": 52.5,
      "duration_seconds": 6.25,
      "text": "I've had seeing tiny bugs in the hair too, for about three months"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.36,
      "end_seconds": 67.19,
      "duration_seconds": 6.83,
      "text": "let me check a few things any swollen glands, rash on the body or fever?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 67.78,
      "end_seconds": 71.01,
      "duration_seconds": 3.23,
      "text": "Uh, nope, nothing like that."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.22,
      "end_seconds": 74.8,
      "duration_seconds": 2.58,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.84,
      "end_seconds": 80.19,
      "duration_seconds": 4.35,
      "text": "Erm, that's normal as far as I know."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.71,
      "end_seconds": 83.63,
      "duration_seconds": 1.92,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 85.07,
      "end_seconds": 87.0,
      "duration_seconds": 1.93,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.81,
      "end_seconds": 106.58,
      "duration_seconds": 2.77,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.14,
      "end_seconds": 112.23,
      "duration_seconds": 5.09,
      "text": "yes, I had my septum straightened, in my thirties"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.95,
      "end_seconds": 131.51,
      "duration_seconds": 4.56,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.43,
      "end_seconds": 142.39,
      "duration_seconds": 4.96,
      "text": "Depression, for two years. I have an irregular heartbeat"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.25,
      "end_seconds": 151.92,
      "duration_seconds": 8.67,
      "text": "Alright, an irregular heartbeat, that matches what I have here. Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 153.9,
      "end_seconds": 158.8,
      "duration_seconds": 4.9,
      "text": "It's, It's apixaban, 5 milligrams, twice a day, doctor."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.13,
      "end_seconds": 163.29,
      "duration_seconds": 3.16,
      "text": "Right, roughly how long on that one?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 164.31,
      "end_seconds": 166.34,
      "duration_seconds": 2.03,
      "text": "About three months now"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.24,
      "end_seconds": 171.74,
      "duration_seconds": 3.5,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.12,
      "end_seconds": 176.09,
      "duration_seconds": 2.97,
      "text": "my mother has an underactive thyroid"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.03,
      "end_seconds": 181.06,
      "duration_seconds": 3.03,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 183.15,
      "end_seconds": 187.05,
      "duration_seconds": 3.9,
      "text": "Yes, I work in a bakery, early starts"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.74,
      "end_seconds": 190.7,
      "duration_seconds": 1.96,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.05,
      "end_seconds": 194.35,
      "duration_seconds": 2.3,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.64,
      "end_seconds": 197.23,
      "duration_seconds": 1.59,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 202.85,
      "end_seconds": 206.87,
      "duration_seconds": 4.02,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.76,
      "end_seconds": 211.12,
      "duration_seconds": 2.36,
      "text": "I'll do your observations first"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.1,
      "end_seconds": 224.38,
      "duration_seconds": 3.28,
      "text": "So, bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.19,
      "end_seconds": 251.7,
      "duration_seconds": 6.51,
      "text": "Okay: BP is 127 over 74, temperature is 36.5 degrees, pulse 64."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 253.4,
      "end_seconds": 254.78,
      "duration_seconds": 1.38,
      "text": "is that okay?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.86,
      "end_seconds": 259.57,
      "duration_seconds": 3.71,
      "text": "don't worry, we'll discuss it in a second"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.99,
      "end_seconds": 266.59,
      "duration_seconds": 4.6,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.44,
      "end_seconds": 270.53,
      "duration_seconds": 2.09,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 280.34,
      "end_seconds": 288.21,
      "duration_seconds": 7.87,
      "text": "I can see live lice and small eggs close to the roots behind the the ears."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.32,
      "end_seconds": 316.77,
      "duration_seconds": 26.45,
      "text": "You can relax now. So where does that leave us? The most likely explanation is head lice. I want to be honest that this is an impression, not a final answer. Let me just check I've got this right. You've had an itchy scalp, since last Tuesday, and no fever or rash on the body."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 318.33,
      "end_seconds": 320.33,
      "duration_seconds": 2.0,
      "text": "That's what happened, yes."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 321.16,
      "end_seconds": 339.15,
      "duration_seconds": 17.99,
      "text": "I'm going to put you on dimeticone lotion, 4%, once, repeat after seven days, two applications. That's for head lice. Comb the hair with a fine comb every few days and check the family. I'll want another look if lice persist after two treatments."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 344.5,
      "end_seconds": 346.65,
      "duration_seconds": 2.15,
      "text": "Okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 351.57,
      "end_seconds": 355.43,
      "duration_seconds": 3.86,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 356.54,
      "end_seconds": 360.34,
      "duration_seconds": 3.8,
      "text": "No, that's all. Thanks a a lot."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 361.07,
      "end_seconds": 363.15,
      "duration_seconds": 2.08,
      "text": "So, have a good day."
    }
  ]
}