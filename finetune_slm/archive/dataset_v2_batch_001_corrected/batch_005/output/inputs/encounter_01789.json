{
  "schema_version": "1.0",
  "encounter_id": "01789",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.05,
      "end_seconds": 5.2,
      "duration_seconds": 4.15,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.11,
      "end_seconds": 11.44,
      "duration_seconds": 4.33,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.44,
      "end_seconds": 18.81,
      "duration_seconds": 5.37,
      "text": "Well, you know, I've been having a cough for three weeks."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.34,
      "end_seconds": 24.04,
      "duration_seconds": 3.7,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.59,
      "end_seconds": 26.71,
      "duration_seconds": 2.12,
      "text": "Probably two months. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.33,
      "end_seconds": 30.72,
      "duration_seconds": 3.39,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.33,
      "end_seconds": 37.23,
      "duration_seconds": 4.9,
      "text": "Maybe a seven out of ten on a bad day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.07,
      "end_seconds": 49.67,
      "duration_seconds": 4.6,
      "text": "A few quick ones: fever, HIV or coughing up blood?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.4,
      "end_seconds": 53.67,
      "duration_seconds": 2.27,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.25,
      "end_seconds": 57.77,
      "duration_seconds": 2.52,
      "text": "Did you notice any chest pain?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.4,
      "end_seconds": 62.23,
      "duration_seconds": 3.83,
      "text": "Not that I've noticed, no chest pain."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.31,
      "end_seconds": 66.83,
      "duration_seconds": 2.52,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.58,
      "end_seconds": 72.29,
      "duration_seconds": 1.71,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.06,
      "end_seconds": 76.47,
      "duration_seconds": 2.41,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.87,
      "end_seconds": 89.3,
      "duration_seconds": 11.43,
      "text": "I hardly move around during the day. No, I share a house with my brother. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.95,
      "end_seconds": 99.77,
      "duration_seconds": 2.82,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.53,
      "end_seconds": 106.39,
      "duration_seconds": 2.86,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.41,
      "end_seconds": 120.64,
      "duration_seconds": 3.23,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.65,
      "end_seconds": 124.04,
      "duration_seconds": 2.39,
      "text": "Not really, uh, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.03,
      "end_seconds": 128.4,
      "duration_seconds": 2.37,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.96,
      "end_seconds": 133.39,
      "duration_seconds": 3.43,
      "text": "No, um, nothing at the moment."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.08,
      "end_seconds": 138.81,
      "duration_seconds": 3.73,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.63,
      "end_seconds": 152.62,
      "duration_seconds": 1.99,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.01,
      "end_seconds": 181.84,
      "duration_seconds": 9.83,
      "text": "Okay: oxygen saturation is 98 percent, BP is 119 over 78. And pulse is 84 beats a minute, temperature 36.6."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.79,
      "end_seconds": 187.74,
      "duration_seconds": 1.95,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.69,
      "end_seconds": 191.07,
      "duration_seconds": 2.38,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.42,
      "end_seconds": 195.31,
      "duration_seconds": 2.89,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.34,
      "end_seconds": 198.63,
      "duration_seconds": 2.29,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.85,
      "end_seconds": 215.14,
      "duration_seconds": 4.29,
      "text": "There are some crackles at the top of the right lung."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.16,
      "end_seconds": 219.43,
      "duration_seconds": 2.27,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.1,
      "end_seconds": 252.19,
      "duration_seconds": 14.09,
      "text": "Having listened and examined, the most likely explanation is possible tuberculosis. Let me just check I've got this right. You've had a cough for three weeks for two months, and no chest pain or fever."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.93,
      "end_seconds": 254.53,
      "duration_seconds": 1.6,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.28,
      "end_seconds": 264.18,
      "duration_seconds": 7.9,
      "text": "Let's book a chest X-ray to look into prolonged cough. I'd like to arrange a blood test for TB contact."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.95,
      "end_seconds": 267.48,
      "duration_seconds": 2.53,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.06,
      "end_seconds": 307.27,
      "duration_seconds": 36.21,
      "text": "Wear a mask in public and cover your mouth when you cough until the results are back. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. I'll also refer you to the TB service. If the symptoms get worse, or you feel really unwell, please come to the emergency department. Please come and see me after the tests. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.39,
      "end_seconds": 310.53,
      "duration_seconds": 2.14,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}