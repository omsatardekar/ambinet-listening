{
  "schema_version": "1.0",
  "encounter_id": "01954",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.76,
      "end_seconds": 7.52,
      "duration_seconds": 6.76,
      "text": "hello doctor, sorry, I took a wrong turn on the way here"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.23,
      "end_seconds": 11.95,
      "duration_seconds": 3.72,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 15.98,
      "end_seconds": 29.17,
      "duration_seconds": 13.19,
      "text": "Thank you for fitting us in, doctor. It's a tremor in my right hand at rest, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.86,
      "end_seconds": 46.83,
      "duration_seconds": 1.97,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.75,
      "end_seconds": 50.73,
      "duration_seconds": 2.98,
      "text": "I've, I've had it since Friday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.4,
      "end_seconds": 59.51,
      "duration_seconds": 8.11,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.72,
      "end_seconds": 66.5,
      "duration_seconds": 5.78,
      "text": "I get some relief from using the hand. I'd say severe"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.01,
      "end_seconds": 68.98,
      "duration_seconds": 1.97,
      "text": "is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.47,
      "end_seconds": 81.95,
      "duration_seconds": 8.48,
      "text": "When it starts I tend to get a stiff arm as well. The stiff arm? That's been since Friday."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.99,
      "end_seconds": 86.21,
      "duration_seconds": 3.22,
      "text": "is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.77,
      "end_seconds": 89.08,
      "duration_seconds": 2.31,
      "text": "I, I'd say mild."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.75,
      "end_seconds": 91.69,
      "duration_seconds": 1.94,
      "text": "Any slowness as well?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.45,
      "end_seconds": 95.48,
      "duration_seconds": 2.03,
      "text": "Yes, for one week."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.95,
      "end_seconds": 100.26,
      "duration_seconds": 3.31,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.72,
      "end_seconds": 105.49,
      "duration_seconds": 3.77,
      "text": "About a a five out of ten."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.31,
      "end_seconds": 111.11,
      "duration_seconds": 3.8,
      "text": "A few quick ones: falls or loss of smell?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.86,
      "end_seconds": 114.62,
      "duration_seconds": 2.76,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.93,
      "end_seconds": 121.56,
      "duration_seconds": 5.63,
      "text": "let me check a a few things any constipation or memory problems?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.33,
      "end_seconds": 124.53,
      "duration_seconds": 2.2,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.84,
      "end_seconds": 130.8,
      "duration_seconds": 1.96,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.77,
      "end_seconds": 135.46,
      "duration_seconds": 3.69,
      "text": "I mean, no, my breathing's been fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.8,
      "end_seconds": 143.45,
      "duration_seconds": 2.65,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.0,
      "end_seconds": 147.84,
      "duration_seconds": 2.84,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.92,
      "end_seconds": 151.17,
      "duration_seconds": 2.25,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.22,
      "end_seconds": 158.51,
      "duration_seconds": 5.29,
      "text": "Yes, I had a bunion operation, six years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.02,
      "end_seconds": 172.49,
      "duration_seconds": 3.47,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.32,
      "end_seconds": 176.6,
      "duration_seconds": 2.28,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.86,
      "end_seconds": 180.32,
      "duration_seconds": 2.46,
      "text": "now some background about your lifestyle"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.3,
      "end_seconds": 193.29,
      "duration_seconds": 11.99,
      "text": "I look after my grandchildren most days. I hardly move around during the day. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.56,
      "end_seconds": 198.8,
      "duration_seconds": 4.24,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.99,
      "end_seconds": 207.41,
      "duration_seconds": 4.42,
      "text": "Right, I'm allergic to naproxen, I get stomach pain."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.39,
      "end_seconds": 214.09,
      "duration_seconds": 3.7,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.99,
      "end_seconds": 218.17,
      "duration_seconds": 2.18,
      "text": "tell me if that's sore"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.29,
      "end_seconds": 236.67,
      "duration_seconds": 7.38,
      "text": "There is a pill-rolling tremor at rest on the right and the arm is stiff with a cogwheel feel."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.02,
      "end_seconds": 243.79,
      "duration_seconds": 1.77,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.98,
      "end_seconds": 268.69,
      "duration_seconds": 10.71,
      "text": "taking everything into account, the most likely explanation is possible Parkinson's disease it could also be a drug-induced tremor, so we'll keep that open"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.19,
      "end_seconds": 272.51,
      "duration_seconds": 2.32,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.91,
      "end_seconds": 302.0,
      "duration_seconds": 28.09,
      "text": "I can't promise yet, but most people with possible Parkinson's disease do well once it's treated properly. I'm gonna order a blood test, for tremor. I'm referring you to the specialist and meanwhile keep active. I'd like you to see the movement disorders clinic as well, and I'll write the referral. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.16,
      "end_seconds": 306.96,
      "duration_seconds": 3.8,
      "text": "Hmm, okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.04,
      "end_seconds": 314.57,
      "duration_seconds": 6.53,
      "text": "Let's review you after the specialist. So, I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.78,
      "end_seconds": 319.05,
      "duration_seconds": 3.27,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}