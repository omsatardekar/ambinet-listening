      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 45.41,
      "end_seconds": 46.8,
      "duration_seconds": 1.39,
      "text": "It's 5 milligrams."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.1,
      "end_seconds": 48.63,
      "duration_seconds": 1.53,
      "text": "yes, carry on"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 63.26,
      "end_seconds": 66.41,
      "duration_seconds": 3.15,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 67.14,
      "end_seconds": 70.2,
      "duration_seconds": 3.06,
      "text": "ever since... since last weekend, really"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.45,
      "end_seconds": 72.82,
      "duration_seconds": 2.37,
      "text": "Yes. Is anything making it worse?"
