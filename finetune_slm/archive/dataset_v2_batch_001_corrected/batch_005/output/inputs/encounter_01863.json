      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.14,
      "end_seconds": 135.47,
      "duration_seconds": 2.33,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.45,
      "end_seconds": 149.88,
      "duration_seconds": 12.43,
      "text": "My husband and I live above the shop. I work in accounts at a hospital. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.56,
      "end_seconds": 154.14,
      "duration_seconds": 3.58,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.91,
      "end_seconds": 159.0,
      "duration_seconds": 3.09,
      "text": "no, not that I know of"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.82,
      "end_seconds": 164.03,
      "duration_seconds": 3.21,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.28,
      "end_seconds": 167.48,
      "duration_seconds": 2.2,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.57,
      "end_seconds": 171.91,
      "duration_seconds": 2.34,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 172.57,
      "end_seconds": 175.39,
      "duration_seconds": 2.82,
      "text": "I've had high blood pressure, yes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.35,
      "end_seconds": 186.62,
      "duration_seconds": 10.27,
      "text": "Right, so high blood pressure is already on your record. We'll keep that in mind today. What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 187.88,
      "end_seconds": 191.17,
      "duration_seconds": 3.29,
      "text": "Just a bunion operation, six years ago."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.47,
      "end_seconds": 209.34,
      "duration_seconds": 3.87,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.99,
      "end_seconds": 225.34,
      "duration_seconds": 2.35,
      "text": "Sit still for a moment..."
