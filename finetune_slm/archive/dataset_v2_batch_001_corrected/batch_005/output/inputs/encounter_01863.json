    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.58,
      "end_seconds": 14.2,
      "duration_seconds": 3.62,
      "text": "Sorry about the wait, we're running a bit behind."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.92,
      "end_seconds": 20.43,
      "duration_seconds": 5.51,
      "text": "oh, that's fine i was just reading something on my phone"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.68,
      "end_seconds": 24.52,
      "duration_seconds": 2.84,
      "text": "What do you need help with?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.12,
      "end_seconds": 30.58,
      "duration_seconds": 5.46,
      "text": "Yeah, it's loud snoring. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.01,
      "end_seconds": 35.81,
      "duration_seconds": 2.8,
      "text": "what's on your current medicine list?"
