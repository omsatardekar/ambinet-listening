    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 74.19,
      "end_seconds": 77.3,
      "duration_seconds": 3.11,
      "text": "I notice it more with alcohol."
