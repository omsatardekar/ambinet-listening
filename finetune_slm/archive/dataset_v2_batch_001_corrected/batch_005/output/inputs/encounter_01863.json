    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 105.51,
      "end_seconds": 108.68,
      "duration_seconds": 3.17,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.61,
      "end_seconds": 111.78,
      "duration_seconds": 2.17,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 112.56,
      "end_seconds": 114.75,
      "duration_seconds": 2.19,
      "text": "no, skin's been fine"
