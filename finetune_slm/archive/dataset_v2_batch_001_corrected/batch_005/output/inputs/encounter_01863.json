    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.56,
      "end_seconds": 82.41,
      "duration_seconds": 3.85,
      "text": "Right, what about daytime sleepiness, have you noticed that?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.08,
      "end_seconds": 87.05,
      "duration_seconds": 3.97,
      "text": "Yes, about the same, about three months."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.94,
      "end_seconds": 91.46,
      "duration_seconds": 2.52,
      "text": "Any leg swelling or chest pain?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.9,
      "end_seconds": 101.54,
      "duration_seconds": 4.64,
      "text": "I haven't had leg swelling or chest pain, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.13,
      "end_seconds": 104.79,
      "duration_seconds": 2.66,
      "text": "Anything different when you pass water?"
