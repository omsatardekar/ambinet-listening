    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.61,
      "end_seconds": 254.97,
      "duration_seconds": 9.36,
      "text": "Okay: oxygen saturation is 97 percent, respiratory rate 18, temperature 37.0, pressure 147 over 95, heart rate 86."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.0,
      "end_seconds": 259.61,
      "duration_seconds": 3.61,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 261.57,
      "end_seconds": 262.49,
      "duration_seconds": 0.92,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 263.92,
      "end_seconds": 265.21,
      "duration_seconds": 1.29,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.87,
      "end_seconds": 276.37,
      "duration_seconds": 3.5,
      "text": "you have a thick neck and a crowded throat"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 280.76,
      "end_seconds": 282.32,
      "duration_seconds": 1.56,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 292.02,
      "end_seconds": 311.9,
      "duration_seconds": 19.88,
      "text": "So, based on the history and the examination, I can't pin this down yet. We're looking at probable obstructive sleep apnoea or an underactive thyroid. I'm sending you for a home sleep study cos of snoring and apnoeas. So, have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 312.59,
      "end_seconds": 314.28,
