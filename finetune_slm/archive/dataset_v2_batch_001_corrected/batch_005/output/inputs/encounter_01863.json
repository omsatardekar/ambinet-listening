      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.49,
      "end_seconds": 40.84,
      "duration_seconds": 4.35,
      "text": "I take ramipril, every morning for my blood pressure"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.91,
      "end_seconds": 44.86,
      "duration_seconds": 1.95,
      "text": "And what strength is that?"
