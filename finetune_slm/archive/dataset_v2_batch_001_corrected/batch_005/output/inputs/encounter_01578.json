{
  "schema_version": "1.0",
  "encounter_id": "01578",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.39,
      "end_seconds": 7.18,
      "duration_seconds": 5.79,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.04,
      "end_seconds": 13.93,
      "duration_seconds": 4.89,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.53,
      "end_seconds": 23.3,
      "duration_seconds": 8.77,
      "text": "Thank you for fitting us in, doctor. Doctor, it's chest pain after a crash. That's what we're worried about."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.29,
      "end_seconds": 26.74,
      "duration_seconds": 2.45,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.59,
      "end_seconds": 41.05,
      "duration_seconds": 2.46,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.31,
      "end_seconds": 64.61,
      "duration_seconds": 10.3,
      "text": "Okay: oxygen saturation is 98 percent, BP is 99 over 62, pulse 105, temp 36.5 degrees. How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.85,
      "end_seconds": 74.35,
      "duration_seconds": 6.5,
      "text": "I'd say about a week. Actually, no, closer to about two weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.72,
      "end_seconds": 78.4,
      "duration_seconds": 2.68,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.32,
      "end_seconds": 83.59,
      "duration_seconds": 3.27,
      "text": "It sort of comes and goes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.42,
      "end_seconds": 87.71,
      "duration_seconds": 2.29,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.48,
      "end_seconds": 99.03,
      "duration_seconds": 9.55,
      "text": "Belly pain goes along with it, most of the time. The belly pain? That's been for five days."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.61,
      "end_seconds": 115.79,
      "duration_seconds": 5.18,
      "text": "Right, and what about neck pain, head injury or loss of consciousness?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.19,
      "end_seconds": 123.64,
      "duration_seconds": 6.45,
      "text": "No neck pain, head injury or loss of consciousness, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.8,
      "end_seconds": 127.12,
      "duration_seconds": 2.32,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.68,
      "end_seconds": 130.14,
      "duration_seconds": 1.46,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.73,
      "end_seconds": 137.11,
      "duration_seconds": 5.38,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.02,
      "end_seconds": 140.51,
      "duration_seconds": 1.49,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.73,
      "end_seconds": 151.59,
      "duration_seconds": 2.86,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.25,
      "end_seconds": 162.25,
      "duration_seconds": 9.0,
      "text": "I've never touched a cigarette. I'm a plumber, lots of bending and kneeling. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.04,
      "end_seconds": 167.01,
      "duration_seconds": 3.97,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.77,
      "end_seconds": 170.47,
      "duration_seconds": 2.7,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.99,
      "end_seconds": 174.92,
      "duration_seconds": 3.93,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.37,
      "end_seconds": 180.39,
      "duration_seconds": 4.02,
      "text": "I was on tamsulosin before. I stopped taking it."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.31,
      "end_seconds": 185.1,
      "duration_seconds": 3.79,
      "text": "Alright, any past operations I should know about?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.96,
      "end_seconds": 191.23,
      "duration_seconds": 5.27,
      "text": "I had a meniscus repair on my knee four years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.57,
      "end_seconds": 196.42,
      "duration_seconds": 3.85,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.09,
      "end_seconds": 200.59,
      "duration_seconds": 3.5,
      "text": "I've had an enlarged prostate, yes."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.48,
      "end_seconds": 208.74,
      "duration_seconds": 7.26,
      "text": "Mm, okay. Right, so an enlarged prostate is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.76,
      "end_seconds": 214.91,
      "duration_seconds": 5.15,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.2,
      "end_seconds": 217.39,
      "duration_seconds": 1.19,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.73,
      "end_seconds": 240.04,
      "duration_seconds": 8.31,
      "text": "There is bruising across the chest, the left side moves less, and the belly is tender and rigid."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.82,
      "end_seconds": 258.13,
      "duration_seconds": 14.31,
      "text": "Thank you, you can get dressed. Having listened and examined, I'd lean towards serious chest and abdominal injury. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.0,
      "end_seconds": 262.04,
      "duration_seconds": 2.04,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.52,
      "end_seconds": 275.72,
      "duration_seconds": 12.2,
      "text": "I understand the worry. At the moment I'd say it's serious chest and abdominal injury, and we'll know more once the an urgent blood cross-match is back."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.73,
      "end_seconds": 316.17,
      "duration_seconds": 23.44,
      "text": "I'm sending you for an urgent blood cross-match because of trauma. Do not move, I am activating the trauma team now. If the symptoms get worse, or you feel really unwell, please come to the emergency department. Come back straight away. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.45,
      "end_seconds": 320.92,
      "duration_seconds": 3.47,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.63,
      "end_seconds": 322.82,
      "duration_seconds": 1.19,
      "text": "Take care now."
    }
  ]
}