  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.89,
      "end_seconds": 5.63,
      "duration_seconds": 4.74,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.48,
      "end_seconds": 13.52,
      "duration_seconds": 4.04,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.77,
      "end_seconds": 27.27,
      "duration_seconds": 12.5,
      "text": "Ah, doctor, it's swollen painful finger joints. It's getting on my nerves now. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.77,
      "end_seconds": 32.49,
      "duration_seconds": 2.72,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.93,
      "end_seconds": 37.35,
      "duration_seconds": 3.42,
      "text": "It's been going on for four weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.01,
      "end_seconds": 40.5,
      "duration_seconds": 2.49,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.34,
      "end_seconds": 46.1,
      "duration_seconds": 4.76,
      "text": "It's, It's all the time. Oh, and sore wrists."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.46,
      "end_seconds": 50.52,
      "duration_seconds": 3.06,
      "text": "A few quick ones: fever or rash?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.59,
      "end_seconds": 58.16,
      "duration_seconds": 5.57,
      "text": "Um, um, I haven't had fever or rash, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.21,
      "end_seconds": 63.98,
      "duration_seconds": 3.77,
      "text": "Have you noticed eye redness or chest pain?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.48,
      "end_seconds": 68.43,
      "duration_seconds": 2.95,
      "text": "Actually, no, none that I've noticed."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.01,
      "end_seconds": 72.79,
      "duration_seconds": 2.78,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.77,
      "end_seconds": 75.49,
      "duration_seconds": 1.72,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.76,
      "end_seconds": 82.18,
      "duration_seconds": 5.42,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.8,
      "end_seconds": 92.31,
      "duration_seconds": 9.51,
      "text": "I look after my grandchildren most days. I grab fast food at lunch most days. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.81,
      "end_seconds": 96.95,
      "duration_seconds": 3.14,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.93,
      "end_seconds": 102.19,
      "duration_seconds": 3.26,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.12,
      "end_seconds": 105.58,
      "duration_seconds": 2.46,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.39,
      "end_seconds": 108.17,
      "duration_seconds": 1.78,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.84,
      "end_seconds": 119.14,
      "duration_seconds": 1.3,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.74,
      "end_seconds": 127.45,
      "duration_seconds": 3.71,
      "text": "Ah, no, I've never been operated on."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.31,
      "end_seconds": 132.62,
      "duration_seconds": 3.31,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.37,
      "end_seconds": 135.66,
      "duration_seconds": 2.29,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.27,
      "end_seconds": 158.25,
      "duration_seconds": 3.98,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.92,
      "end_seconds": 161.38,
      "duration_seconds": 1.46,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.09,
      "end_seconds": 174.5,
      "duration_seconds": 2.41,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.26,
      "end_seconds": 189.4,
      "duration_seconds": 2.14,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.56,
      "end_seconds": 213.84,
      "duration_seconds": 7.28,
      "text": "Okay: oxygen saturation is 97 percent, temperature is 36.7 degrees, pulse 69. And pressure 124 over 75."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.23,
      "end_seconds": 217.35,
      "duration_seconds": 2.12,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.41,
      "end_seconds": 220.93,
      "duration_seconds": 2.52,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.79,
      "end_seconds": 228.14,
      "duration_seconds": 5.35,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.73,
      "end_seconds": 230.82,
      "duration_seconds": 1.09,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.54,
      "end_seconds": 235.0,
      "duration_seconds": 2.46,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.15,
      "end_seconds": 258.62,
      "duration_seconds": 6.47,
      "text": "The knuckles and wrists are swollen and warm, and the squeeze test is painful."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.15,
      "end_seconds": 261.23,
      "duration_seconds": 1.08,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.58,
      "end_seconds": 268.75,
      "duration_seconds": 2.17,
      "text": "Okay, you can relax now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.37,
      "end_seconds": 313.59,
      "duration_seconds": 30.22,
      "text": "From what you've told me and what I found, I'd lean towards an inflammatory arthritis flare. I'm going to order X-rays of the hands, for inflammatory arthritis. For this, methotrexate, 10 milligrams, once a week, long term. It's for inflammatory arthritis. Gentle hand exercises and warm water in the morning. I'll want another look in four weeks. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.1,
      "end_seconds": 318.6,
      "duration_seconds": 3.5,
      "text": "Alright, um, thanks, take care."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.01,
      "end_seconds": 322.45,
      "duration_seconds": 1.44,
      "text": "All the best."
    }
  ]
}