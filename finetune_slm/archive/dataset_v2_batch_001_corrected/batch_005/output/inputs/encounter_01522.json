{
  "schema_version": "1.0",
  "encounter_id": "01522",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.73,
      "end_seconds": 5.69,
      "duration_seconds": 4.96,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.21,
      "end_seconds": 10.12,
      "duration_seconds": 3.91,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.46,
      "end_seconds": 20.28,
      "duration_seconds": 5.82,
      "text": "Morning, you know, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.63,
      "end_seconds": 26.01,
      "duration_seconds": 4.38,
      "text": "Alright, that's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 26.84,
      "end_seconds": 35.73,
      "duration_seconds": 8.89,
      "text": "It's a tingling lip then a blister, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.21,
      "end_seconds": 40.75,
      "duration_seconds": 3.54,
      "text": "Alright, how long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.84,
      "end_seconds": 47.1,
      "duration_seconds": 3.26,
      "text": "About three days, give or take."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 48.92,
      "end_seconds": 52.32,
      "duration_seconds": 3.4,
      "text": "Hm, I'd say more like five days."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.68,
      "end_seconds": 58.6,
      "duration_seconds": 4.92,
      "text": "Okay, so roughly three to five days. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.23,
      "end_seconds": 62.32,
      "duration_seconds": 2.09,
      "text": "Yes, somewhere around that."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.89,
      "end_seconds": 65.24,
      "duration_seconds": 2.35,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.78,
      "end_seconds": 67.81,
      "duration_seconds": 2.03,
      "text": "Honestly, every other day."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.62,
      "end_seconds": 74.37,
      "duration_seconds": 4.75,
      "text": "So, what about a mild sore feeling, have you noticed that?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.96,
      "end_seconds": 78.91,
      "duration_seconds": 2.95,
      "text": "Yeah, you know, that too."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.63,
      "end_seconds": 84.72,
      "duration_seconds": 4.09,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.91,
      "end_seconds": 91.32,
      "duration_seconds": 5.41,
      "text": "Mild, I'd say. I had crusting before. That's settled now, though."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.36,
      "end_seconds": 99.57,
      "duration_seconds": 7.21,
      "text": "Have you had a tingling lip then a blister before, or is this the first time?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.95,
      "end_seconds": 109.86,
      "duration_seconds": 8.91,
      "text": "Sorry, you know, what was I saying, a bit, last year. It settled by itself back then."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.17,
      "end_seconds": 114.73,
      "duration_seconds": 3.56,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 115.31,
      "end_seconds": 122.9,
      "duration_seconds": 7.59,
      "text": "She takes Glycomet, 500 milligrams, twice a day. She takes sertraline, 50 milligrams, once a day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.42,
      "end_seconds": 133.09,
      "duration_seconds": 1.67,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.45,
      "end_seconds": 137.24,
      "duration_seconds": 2.79,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.08,
      "end_seconds": 141.45,
      "duration_seconds": 1.37,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.22,
      "end_seconds": 147.36,
      "duration_seconds": 4.14,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.17,
      "end_seconds": 151.4,
      "duration_seconds": 2.23,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.25,
      "end_seconds": 157.35,
      "duration_seconds": 4.1,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.25,
      "end_seconds": 159.73,
      "duration_seconds": 1.48,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.84,
      "end_seconds": 163.92,
      "duration_seconds": 3.08,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.57,
      "end_seconds": 170.68,
      "duration_seconds": 3.11,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.51,
      "end_seconds": 174.58,
      "duration_seconds": 2.07,
      "text": "I've had diabetes, yes."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.6,
      "end_seconds": 177.3,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.04,
      "end_seconds": 181.35,
      "duration_seconds": 3.31,
      "text": "I have depression. I have gout."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.39,
      "end_seconds": 189.44,
      "duration_seconds": 6.05,
      "text": "Right, so gout is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.85,
      "end_seconds": 206.32,
      "duration_seconds": 4.47,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.0,
      "end_seconds": 215.67,
      "duration_seconds": 3.67,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.91,
      "end_seconds": 224.16,
      "duration_seconds": 7.25,
      "text": "Let me check a few things. Any rash elsewhere, sores in the mouth or fever?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.04,
      "end_seconds": 231.99,
      "duration_seconds": 5.95,
      "text": "I haven't had rash elsewhere, sores in the mouth or fever, no."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.86,
      "end_seconds": 234.16,
      "duration_seconds": 1.3,
      "text": "Any eye pain?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.78,
      "end_seconds": 244.72,
      "duration_seconds": 4.94,
      "text": "No, uh, I haven't had any eye pain."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.22,
      "end_seconds": 250.47,
      "duration_seconds": 5.25,
      "text": "Understood. Right, what about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.04,
      "end_seconds": 253.28,
      "duration_seconds": 2.24,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.94,
      "end_seconds": 256.17,
      "duration_seconds": 2.23,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.15,
      "end_seconds": 260.01,
      "duration_seconds": 2.86,
      "text": "Nothing there, um, no."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.72,
      "end_seconds": 263.4,
      "duration_seconds": 2.68,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.1,
      "end_seconds": 276.05,
      "duration_seconds": 2.95,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.04,
      "end_seconds": 296.73,
      "duration_seconds": 4.69,
      "text": "Okay: BP is 121 over 69, pulse 67, temperature 36.6."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.54,
      "end_seconds": 302.45,
      "duration_seconds": 2.91,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.06,
      "end_seconds": 321.76,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.62,
      "end_seconds": 325.92,
      "duration_seconds": 2.3,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.53,
      "end_seconds": 344.81,
      "duration_seconds": 6.28,
      "text": "There is a small cluster of blisters on the edge of the upper lip."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.18,
      "end_seconds": 357.19,
      "duration_seconds": 8.01,
      "text": "That's the examination finished. Okay, so my impression is this: My working impression is a cold sore."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.73,
      "end_seconds": 362.11,
      "duration_seconds": 3.38,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.13,
      "end_seconds": 376.55,
      "duration_seconds": 13.42,
      "text": "Nothing I've seen today points to an emergency. It looks like a cold sore. The treatment will be aciclovir cream, 5%, five times a day, five days. That should help with cold sore."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 380.81,
      "end_seconds": 382.26,
      "duration_seconds": 1.45,
      "text": "That's simple enough."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 386.31,
      "end_seconds": 395.1,
      "duration_seconds": 8.79,
      "text": "Avoid kissing and sharing towels until it has crusted over. I'd like to see you again if not healed in ten days."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 396.62,
      "end_seconds": 398.61,
      "duration_seconds": 1.99,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 399.14,
      "end_seconds": 403.86,
      "duration_seconds": 4.72,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 404.52,
      "end_seconds": 406.59,
      "duration_seconds": 2.07,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 408.61,
      "end_seconds": 409.86,
      "duration_seconds": 1.25,
      "text": "All the best."
    }
  ]
}