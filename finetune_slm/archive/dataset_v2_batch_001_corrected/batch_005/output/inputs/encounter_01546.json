{
  "schema_version": "1.0",
  "encounter_id": "01546",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.11,
      "end_seconds": 7.86,
      "duration_seconds": 6.75,
      "text": "Yeah, doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.85,
      "end_seconds": 13.48,
      "duration_seconds": 3.63,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.19,
      "end_seconds": 18.97,
      "duration_seconds": 4.78,
      "text": "Um, uh, doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.4,
      "end_seconds": 23.16,
      "duration_seconds": 2.76,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 24.78,
      "end_seconds": 29.92,
      "duration_seconds": 5.14,
      "text": "We came because of aching muscles in my thighs."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.52,
      "end_seconds": 35.23,
      "duration_seconds": 3.71,
      "text": "Okay, what's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.71,
      "end_seconds": 42.69,
      "duration_seconds": 5.98,
      "text": "Actually, um, it's been ten days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.76,
      "end_seconds": 47.37,
      "duration_seconds": 2.61,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.75,
      "end_seconds": 50.97,
      "duration_seconds": 2.22,
      "text": "I'd call it severe."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.79,
      "end_seconds": 55.73,
      "duration_seconds": 2.94,
      "text": "Any dark urine once as well?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.53,
      "end_seconds": 64.43,
      "duration_seconds": 7.9,
      "text": "Yes, since yesterday. I had muscle weakness before. That's settled now, you know, though."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.27,
      "end_seconds": 69.97,
      "duration_seconds": 4.7,
      "text": "Have you noticed fever, chest pain, rash or joint swelling?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.82,
      "end_seconds": 77.05,
      "duration_seconds": 5.23,
      "text": "Actually, you know, no, nothing to report there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.99,
      "end_seconds": 82.11,
      "duration_seconds": 3.12,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.84,
      "end_seconds": 86.92,
      "duration_seconds": 3.08,
      "text": "Yeah, no, that's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.61,
      "end_seconds": 90.98,
      "duration_seconds": 3.37,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.91,
      "end_seconds": 96.6,
      "duration_seconds": 4.69,
      "text": "I mean, it's rosuvastatin, 10 milligrams, at night."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.8,
      "end_seconds": 114.55,
      "duration_seconds": 2.75,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.59,
      "end_seconds": 117.99,
      "duration_seconds": 2.4,
      "text": "I have high cholesterol."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.59,
      "end_seconds": 119.64,
      "duration_seconds": 1.05,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.2,
      "end_seconds": 141.7,
      "duration_seconds": 4.5,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.1,
      "end_seconds": 147.1,
      "duration_seconds": 4.0,
      "text": "I mean, yes, trimethoprim. I get itching."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.33,
      "end_seconds": 151.17,
      "duration_seconds": 2.84,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.16,
      "end_seconds": 171.68,
      "duration_seconds": 18.52,
      "text": "I smoke roughly a pack every two days. I only drink at family occasions. My husband and I live above the shop. Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.22,
      "end_seconds": 188.46,
      "duration_seconds": 2.24,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.38,
      "end_seconds": 195.82,
      "duration_seconds": 6.44,
      "text": "I had a cataract operation in my left eye about a year ago."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.36,
      "end_seconds": 198.39,
      "duration_seconds": 2.03,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.34,
      "end_seconds": 215.75,
      "duration_seconds": 3.41,
      "text": "Alright, that's it, just a little longer..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.26,
      "end_seconds": 242.22,
      "duration_seconds": 7.96,
      "text": "Okay: blood pressure 128 over 74, saturation 98 percent, pulse 80, temperature is 36.6 degrees."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.79,
      "end_seconds": 245.48,
      "duration_seconds": 1.69,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.52,
      "end_seconds": 249.75,
      "duration_seconds": 2.23,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.89,
      "end_seconds": 254.67,
      "duration_seconds": 3.78,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.27,
      "end_seconds": 255.97,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.37,
      "end_seconds": 260.81,
      "duration_seconds": 3.44,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.91,
      "end_seconds": 273.51,
      "duration_seconds": 4.6,
      "text": "The thigh muscles are tender and the strength is slightly reduced."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.25,
      "end_seconds": 286.54,
      "duration_seconds": 10.29,
      "text": "Okay, good, you can sit up again. Putting it all together, it points towards muscle symptoms possibly from the cholesterol tablet."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.26,
      "end_seconds": 291.88,
      "duration_seconds": 4.62,
      "text": "So, um, is there something to worry about?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.25,
      "end_seconds": 320.58,
      "duration_seconds": 27.33,
      "text": "I understand the worry. At the moment I'd say it's muscle symptoms possibly from the cholesterol tablet, and we'll know more once the a thyroid test is back. Let's book a thyroid test to look into muscle aches. I'm sending you for a vitamin D level because of muscle aches. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.69,
      "end_seconds": 339.87,
      "duration_seconds": 18.18,
      "text": "We will pause the statin for a few weeks while we check the blood tests. I'm not ordering a creatine kinase test today. If things carry on next month, we'll consider it. Do get help quickly if the symptoms get worse."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.12,
      "end_seconds": 342.86,
      "duration_seconds": 1.74,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.46,
      "end_seconds": 354.11,
      "duration_seconds": 10.65,
      "text": "I'd like you back after the results. Tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 357.98,
      "end_seconds": 365.18,
      "duration_seconds": 7.2,
      "text": "So, uh, I come back after the results. Is that right?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.24,
      "end_seconds": 371.71,
      "duration_seconds": 4.47,
      "text": "Yes, exactly right. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 372.44,
      "end_seconds": 375.0,
      "duration_seconds": 2.56,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}