{
  "schema_version": "1.0",
  "encounter_id": "01609",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.25,
      "end_seconds": 7.55,
      "duration_seconds": 6.3,
      "text": "Okay, doctor, we're all set in here. I'll give you the numbers when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.41,
      "end_seconds": 13.88,
      "duration_seconds": 4.47,
      "text": "Thank you. Good morning, tell me what's been going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 15.49,
      "end_seconds": 18.85,
      "duration_seconds": 3.36,
      "text": "It's, It's itchy raised welts, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.11,
      "end_seconds": 22.39,
      "duration_seconds": 2.28,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 23.98,
      "end_seconds": 33.18,
      "duration_seconds": 9.2,
      "text": "I'm on cetirizine, 10 milligrams, once a day. I used to take allopurinol, but I stopped it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.94,
      "end_seconds": 52.07,
      "duration_seconds": 2.13,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 53.61,
      "end_seconds": 56.2,
      "duration_seconds": 2.59,
      "text": "It's been two days now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.72,
      "end_seconds": 58.36,
      "duration_seconds": 1.64,
      "text": "Anything that improves it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 59.05,
      "end_seconds": 61.88,
      "duration_seconds": 2.83,
      "text": "It settles a little with antihistamine."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.53,
      "end_seconds": 69.09,
      "duration_seconds": 1.56,
      "text": "What brings it on?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 70.8,
      "end_seconds": 74.12,
      "duration_seconds": 3.32,
      "text": "Well, I notice it more with stress."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.83,
      "end_seconds": 78.4,
      "duration_seconds": 2.57,
      "text": "So, how frequently does it come?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 83.59,
      "end_seconds": 97.69,
      "duration_seconds": 14.1,
      "text": "It's a few times a day. And there's swollen lips at times as well, two weeks now. With swollen lips at times, it feels moderate to me."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.3,
      "end_seconds": 102.07,
      "duration_seconds": 2.77,
      "text": "Have you had welts that move around?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 103.86,
      "end_seconds": 105.39,
      "duration_seconds": 1.53,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.15,
      "end_seconds": 112.42,
      "duration_seconds": 6.27,
      "text": "Okay, have you had itchy raised welts before, or is this the first time?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 113.23,
      "end_seconds": 121.03,
      "duration_seconds": 7.8,
      "text": "Yes, something like this happened last year, and it went away on its own."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.65,
      "end_seconds": 125.91,
      "duration_seconds": 3.26,
      "text": "Have you had any joint pain or fever?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 126.76,
      "end_seconds": 131.22,
      "duration_seconds": 4.46,
      "text": "No joint pain or fever, none of it."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.75,
      "end_seconds": 138.43,
      "duration_seconds": 5.68,
      "text": "Let me check a few things. Any throat tightness or difficulty breathing?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 140.24,
      "end_seconds": 142.63,
      "duration_seconds": 2.39,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.2,
      "end_seconds": 146.85,
      "duration_seconds": 2.65,
      "text": "Alright, your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 148.4,
      "end_seconds": 150.31,
      "duration_seconds": 1.91,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.81,
      "end_seconds": 155.38,
      "duration_seconds": 3.57,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 157.46,
      "end_seconds": 158.91,
      "duration_seconds": 1.45,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.57,
      "end_seconds": 163.54,
      "duration_seconds": 2.97,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 164.7,
      "end_seconds": 176.43,
      "duration_seconds": 11.73,
      "text": "Yes, I work in a bakery, early starts. I do a yoga class on Thursdays. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.91,
      "end_seconds": 180.22,
      "duration_seconds": 2.31,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 181.16,
      "end_seconds": 185.79,
      "duration_seconds": 4.63,
      "text": "Just keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.39,
      "end_seconds": 206.25,
      "duration_seconds": 6.86,
      "text": "Has anyone ever diagnosed you with something? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 209.34,
      "end_seconds": 210.84,
      "duration_seconds": 1.5,
      "text": "I have gout."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.36,
      "end_seconds": 212.78,
      "duration_seconds": 1.42,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 213.57,
      "end_seconds": 223.44,
      "duration_seconds": 9.87,
      "text": "Okay, so the vitals from earlier. BP is 112 over 73, oxygen saturation is 97 percent, pulse 81, temperature is 36.9 degrees."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.3,
      "end_seconds": 225.28,
      "duration_seconds": 0.98,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.15,
      "end_seconds": 231.85,
      "duration_seconds": 3.7,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 242.61,
      "end_seconds": 243.69,
      "duration_seconds": 1.08,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.08,
      "end_seconds": 248.0,
      "duration_seconds": 2.92,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.48,
      "end_seconds": 267.43,
      "duration_seconds": 5.95,
      "text": "There are pink raised wheals on the arms and trunk that blanch with pressure."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.67,
      "end_seconds": 299.56,
      "duration_seconds": 28.89,
      "text": "Good, you can sit up again. I'm sending you for blood tests because of chronic urticaria. Let's use fexofenadine, 180 milligrams, once a day, long term. That should help with urticaria. The pharmacy will go through the details again when you pick it up. Keep a diary of foods and triggers and avoid hot showers. See me again in six weeks. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 300.65,
      "end_seconds": 304.43,
      "duration_seconds": 3.78,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}