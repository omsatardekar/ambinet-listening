{
  "schema_version": "1.0",
  "encounter_id": "01777",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.23,
      "end_seconds": 5.73,
      "duration_seconds": 4.5,
      "text": "Good morning, grab a seat. Right, where shall we begin?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.06,
      "end_seconds": 15.44,
      "duration_seconds": 8.38,
      "text": "Um, so... severe pain in the upper tummy going through to the back. That's why I came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.18,
      "end_seconds": 17.92,
      "duration_seconds": 1.74,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.19,
      "end_seconds": 24.41,
      "duration_seconds": 5.22,
      "text": "Uh, um, it's been about four days now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.99,
      "end_seconds": 30.91,
      "duration_seconds": 2.92,
      "text": "Is there something that settles it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.25,
      "end_seconds": 35.72,
      "duration_seconds": 3.47,
      "text": "I get some relief from leaning forward."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.29,
      "end_seconds": 40.18,
      "duration_seconds": 2.89,
      "text": "Any a fast heart as well?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 41.72,
      "end_seconds": 57.45,
      "duration_seconds": 15.73,
      "text": "Yes, since Monday. As for fast heart, it's moderate, honestly. Sorry, what was I saying, I've also been feeling very unwell. About feeling very unwell, about a eight out of ten."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.17,
      "end_seconds": 69.57,
      "duration_seconds": 10.4,
      "text": "Have you had severe pain in the upper tummy going through to the back before, or is this the first time?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 71.08,
      "end_seconds": 77.26,
      "duration_seconds": 6.18,
      "text": "A bit, about six months ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 78.93,
      "end_seconds": 88.15,
      "duration_seconds": 9.22,
      "text": "Okay, so the vitals from earlier. Temp 36.9 degrees, blood pressure 112 over 76, pulse is 114 beats a minute."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.78,
      "end_seconds": 89.48,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.79,
      "end_seconds": 96.01,
      "duration_seconds": 4.22,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.19,
      "end_seconds": 100.1,
      "duration_seconds": 2.91,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.33,
      "end_seconds": 112.79,
      "duration_seconds": 4.46,
      "text": "Your upper tummy is very tender and you look dehydrated."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.33,
      "end_seconds": 117.2,
      "duration_seconds": 1.87,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.66,
      "end_seconds": 132.5,
      "duration_seconds": 0.84,
      "text": "Any fever?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 133.93,
      "end_seconds": 136.95,
      "duration_seconds": 3.02,
      "text": "Ah, I haven't noticed any fever."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.79,
      "end_seconds": 142.09,
      "duration_seconds": 4.3,
      "text": "Did you get chest pain, black stools or yellow eyes?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.9,
      "end_seconds": 146.44,
      "duration_seconds": 2.54,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.82,
      "end_seconds": 151.22,
      "duration_seconds": 3.4,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.72,
      "end_seconds": 157.67,
      "duration_seconds": 1.95,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.65,
      "end_seconds": 162.16,
      "duration_seconds": 2.51,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.73,
      "end_seconds": 164.64,
      "duration_seconds": 0.91,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.22,
      "end_seconds": 169.1,
      "duration_seconds": 3.88,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.96,
      "end_seconds": 173.01,
      "duration_seconds": 3.05,
      "text": "My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.19,
      "end_seconds": 177.69,
      "duration_seconds": 3.5,
      "text": "So, do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 178.54,
      "end_seconds": 180.92,
      "duration_seconds": 2.38,
      "text": "I've had eczema, yes."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.93,
      "end_seconds": 183.8,
      "duration_seconds": 0.87,
      "text": "Anything else?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 185.69,
      "end_seconds": 187.26,
      "duration_seconds": 1.57,
      "text": "I have migraines."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.0,
      "end_seconds": 191.52,
      "duration_seconds": 2.52,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.41,
      "end_seconds": 213.59,
      "duration_seconds": 3.18,
      "text": "Right, now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 214.18,
      "end_seconds": 227.71,
      "duration_seconds": 13.53,
      "text": "I've never touched a cigarette. I only drink at family occasions. Yes, I work in a bakery, early starts. I swim twice a week."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.09,
      "end_seconds": 232.23,
      "duration_seconds": 3.14,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 232.96,
      "end_seconds": 237.07,
      "duration_seconds": 4.11,
      "text": "So, I'm on hydrocortisone cream, when needed."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.63,
      "end_seconds": 239.1,
      "duration_seconds": 1.47,
      "text": "Is that long-standing?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 240.49,
      "end_seconds": 251.07,
      "duration_seconds": 10.58,
      "text": "Two months now. I take ibuprofen, 400 milligrams, when needed. So, I used to take sumatriptan, but I stopped it."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.29,
      "end_seconds": 255.88,
      "duration_seconds": 3.59,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 257.81,
      "end_seconds": 260.66,
      "duration_seconds": 2.85,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.69,
      "end_seconds": 263.12,
      "duration_seconds": 1.43,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 264.57,
      "end_seconds": 268.06,
      "duration_seconds": 3.49,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 279.22,
      "end_seconds": 311.76,
      "duration_seconds": 32.54,
      "text": "Okay, so my impression is this: The most likely explanation is acute pancreatitis. I want to be honest that this is an impression, not a final answer. I'm sending you for an abdominal scan because of pancreatitis. You need admission for fluids and pain relief, nothing to eat for now. Let's get you seen by the surgical team, I'll arrange the letter. If the symptoms get worse, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 313.45,
      "end_seconds": 320.7,
      "duration_seconds": 7.25,
      "text": "I'd like to see you again straight away. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 322.33,
      "end_seconds": 324.68,
      "duration_seconds": 2.35,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}