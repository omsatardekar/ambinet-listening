{
  "schema_version": "1.0",
  "encounter_id": "01818",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.83,
      "end_seconds": 4.51,
      "duration_seconds": 3.68,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.01,
      "end_seconds": 9.54,
      "duration_seconds": 4.53,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.1,
      "end_seconds": 16.98,
      "duration_seconds": 5.88,
      "text": "Actually, doctor, it's tired muscles. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.53,
      "end_seconds": 19.68,
      "duration_seconds": 2.15,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.27,
      "end_seconds": 24.31,
      "duration_seconds": 3.04,
      "text": "It's been ten days now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.36,
      "end_seconds": 29.79,
      "duration_seconds": 3.43,
      "text": "So, would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.02,
      "end_seconds": 39.27,
      "duration_seconds": 8.25,
      "text": "Mostly moderate. There was a mild ache in my legs, yes, but that went away."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.99,
      "end_seconds": 56.19,
      "duration_seconds": 2.2,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.82,
      "end_seconds": 72.4,
      "duration_seconds": 2.58,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.09,
      "end_seconds": 105.58,
      "duration_seconds": 14.49,
      "text": "Okay: oxygen saturation is 99 percent, BMI works out to 35.2, pulse 81, respiratory rate 17, temperature 36.5, weight 90 kilos, height 160 centimetres, pressure 115 over 76."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.76,
      "end_seconds": 109.8,
      "duration_seconds": 2.04,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.35,
      "end_seconds": 113.21,
      "duration_seconds": 1.86,
      "text": "Alright, nearly finished here."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.27,
      "end_seconds": 132.54,
      "duration_seconds": 4.27,
      "text": "Your muscle strength is normal and there is no bone tenderness."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.93,
      "end_seconds": 141.43,
      "duration_seconds": 6.5,
      "text": "Please sit back down. Let me check a few things. Any fractures or weight loss?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.47,
      "end_seconds": 147.28,
      "duration_seconds": 3.81,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.27,
      "end_seconds": 152.11,
      "duration_seconds": 3.84,
      "text": "Have you had any weakness or bone pain?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.92,
      "end_seconds": 156.28,
      "duration_seconds": 3.36,
      "text": "No, no weakness or bone pain."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.91,
      "end_seconds": 161.44,
      "duration_seconds": 3.53,
      "text": "Okay, is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.45,
      "end_seconds": 165.1,
      "duration_seconds": 1.65,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.95,
      "end_seconds": 170.11,
      "duration_seconds": 3.16,
      "text": "Alright, and your skin, any changes there?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.87,
      "end_seconds": 173.37,
      "duration_seconds": 2.5,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.3,
      "end_seconds": 177.67,
      "duration_seconds": 3.37,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.21,
      "end_seconds": 181.75,
      "duration_seconds": 2.54,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.35,
      "end_seconds": 184.36,
      "duration_seconds": 2.01,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.27,
      "end_seconds": 198.94,
      "duration_seconds": 12.67,
      "text": "I, I have anxiety. I have heart failure, for two years. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.43,
      "end_seconds": 209.47,
      "duration_seconds": 9.04,
      "text": "I see, go ahead. Yes, anxiety and heart failure are known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.28,
      "end_seconds": 226.73,
      "duration_seconds": 3.45,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.67,
      "end_seconds": 230.87,
      "duration_seconds": 3.2,
      "text": "It's furosemide, 40 milligrams, every morning."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.46,
      "end_seconds": 232.16,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.21,
      "end_seconds": 249.06,
      "duration_seconds": 3.85,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.71,
      "end_seconds": 253.82,
      "duration_seconds": 4.11,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.86,
      "end_seconds": 257.16,
      "duration_seconds": 1.3,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.35,
      "end_seconds": 262.02,
      "duration_seconds": 3.67,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.71,
      "end_seconds": 264.68,
      "duration_seconds": 1.97,
      "text": "So, are you active?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.53,
      "end_seconds": 271.52,
      "duration_seconds": 2.99,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.26,
      "end_seconds": 298.83,
      "duration_seconds": 26.57,
      "text": "A vitamin D level is what I'd like next, for tiredness. I'll start you on colecalciferol, 1000 units, once a day, three months. That's for low vitamin D. Get some daily daylight and eat oily fish. Please don't wait if the symptoms get worse. That's when to be seen urgently. We'll catch up in three months. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.93,
      "end_seconds": 303.02,
      "duration_seconds": 3.09,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.82,
      "end_seconds": 305.04,
      "duration_seconds": 1.22,
      "text": "Goodbye for now."
    }
  ]
}