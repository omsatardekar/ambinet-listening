{
  "schema_version": "1.0",
  "encounter_id": "01640",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.07,
      "end_seconds": 4.55,
      "duration_seconds": 3.48,
      "text": "come in, have a seat by the desk"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.27,
      "end_seconds": 6.39,
      "duration_seconds": 1.12,
      "text": "Evening, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.34,
      "end_seconds": 11.37,
      "duration_seconds": 3.03,
      "text": "alright, is it your first time here?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.19,
      "end_seconds": 17.73,
      "duration_seconds": 4.54,
      "text": "No, I came last year for something else."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.58,
      "end_seconds": 22.51,
      "duration_seconds": 2.93,
      "text": "What do you need help with?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.83,
      "end_seconds": 28.32,
      "duration_seconds": 4.49,
      "text": "Well, uh, I've been having shoulder tightness."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.04,
      "end_seconds": 32.25,
      "duration_seconds": 3.21,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.81,
      "end_seconds": 34.41,
      "duration_seconds": 1.6,
      "text": "Mild, I'd say."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.8,
      "end_seconds": 38.17,
      "duration_seconds": 2.37,
      "text": "Any a headache as well?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 40.16,
      "end_seconds": 69.67,
      "duration_seconds": 29.51,
      "text": "Mm, you know, yes, for five days. As for headache, pretty moderate, if I'm being honest. I've been feeling shaken too, for four weeks. Erm, with feeling shaken, about a seven out of ten. Honestly, once or twice a day. Neck pain after a car crash was there, you know, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.04,
      "end_seconds": 76.55,
      "duration_seconds": 5.51,
      "text": "right, have you had shoulder tightness before, or is this the first time?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.58,
      "end_seconds": 89.03,
      "duration_seconds": 10.45,
      "text": "yes, something like this happened a couple of years ago, and it went away on its own"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.74,
      "end_seconds": 96.15,
      "duration_seconds": 5.41,
      "text": "have you noticed weakness, loss of consciousness or numbness in the arms?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.01,
      "end_seconds": 101.31,
      "duration_seconds": 3.3,
      "text": "Oh, no, I'd have said so."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.01,
      "end_seconds": 106.05,
      "duration_seconds": 3.04,
      "text": "and chest pain, any of that?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 106.56,
      "end_seconds": 110.12,
      "duration_seconds": 3.56,
      "text": "Nope, um, no chest pain."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.77,
      "end_seconds": 116.47,
      "duration_seconds": 4.7,
      "text": "so, anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.0,
      "end_seconds": 121.95,
      "duration_seconds": 3.95,
      "text": "No, uh, nothing with my heart."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.82,
      "end_seconds": 125.75,
      "duration_seconds": 2.93,
      "text": "is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 127.21,
      "end_seconds": 130.85,
      "duration_seconds": 3.64,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.07,
      "end_seconds": 135.3,
      "duration_seconds": 3.23,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.98,
      "end_seconds": 148.72,
      "duration_seconds": 11.74,
      "text": "Let me think, it's aspirin, 75 milligrams, once a day. Um, I'm supposed to take it regularly, but I don't always manage."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.56,
      "end_seconds": 152.51,
      "duration_seconds": 2.95,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 153.95,
      "end_seconds": 171.69,
      "duration_seconds": 17.74,
      "text": "Mm, uh, just a mole taken off my arm, a few years ago. I took the morning off to come in today. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.29,
      "end_seconds": 176.83,
      "duration_seconds": 3.54,
      "text": "anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 178.71,
      "end_seconds": 185.41,
      "duration_seconds": 6.7,
      "text": "I have heart disease, for about a year. I've had migraines, yes."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.93,
      "end_seconds": 191.35,
      "duration_seconds": 5.42,
      "text": "Understood. Yes, migraines is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.94,
      "end_seconds": 204.73,
      "duration_seconds": 0.79,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 206.14,
      "end_seconds": 210.08,
      "duration_seconds": 3.94,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.15,
      "end_seconds": 215.37,
      "duration_seconds": 4.22,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 216.06,
      "end_seconds": 220.04,
      "duration_seconds": 3.98,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.55,
      "end_seconds": 222.18,
      "duration_seconds": 1.63,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 224.05,
      "end_seconds": 227.75,
      "duration_seconds": 3.7,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.1,
      "end_seconds": 231.5,
      "duration_seconds": 2.4,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.89,
      "end_seconds": 241.47,
      "duration_seconds": 2.58,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.96,
      "end_seconds": 269.48,
      "duration_seconds": 8.52,
      "text": "Okay: pressure 119 over 82, SpO2 98 percent on room air, heart rate 69, temperature 36.4."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 270.57,
      "end_seconds": 272.15,
      "duration_seconds": 1.58,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.15,
      "end_seconds": 275.7,
      "duration_seconds": 2.55,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 277.91,
      "end_seconds": 280.34,
      "duration_seconds": 2.43,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.66,
      "end_seconds": 282.84,
      "duration_seconds": 1.18,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.89,
      "end_seconds": 305.72,
      "duration_seconds": 5.83,
      "text": "There is muscle tenderness either side of the neck and no tenderness over the bones."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 307.5,
      "end_seconds": 308.48,
      "duration_seconds": 0.98,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 313.84,
      "end_seconds": 316.37,
      "duration_seconds": 2.53,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 331.25,
      "end_seconds": 342.08,
      "duration_seconds": 10.83,
      "text": "Taking everything into account, I'm honestly not certain yet. It could be whiplash-type neck strain, or it might be a cervical spine injury."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 343.77,
      "end_seconds": 348.44,
      "duration_seconds": 4.67,
      "text": "Mm, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 348.98,
      "end_seconds": 355.06,
      "duration_seconds": 6.08,
      "text": "Nothing I've seen today points to an emergency. It looks like whiplash-type neck strain."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 371.62,
      "end_seconds": 378.99,
      "duration_seconds": 7.37,
      "text": "I'll start you on naproxen, 500 milligrams, twice a day with food, one week. It's for neck pain."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 380.17,
      "end_seconds": 387.65,
      "duration_seconds": 7.48,
      "text": "Sorry, you know, what was I saying, alright, I'll pick it up today."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 390.35,
      "end_seconds": 404.34,
      "duration_seconds": 13.99,
      "text": "Keep your neck moving gently and avoid a collar. Come back or go to emergency straight away if you get numbness or weakness in your arms. Book a review if not better in two weeks."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 405.64,
      "end_seconds": 409.25,
      "duration_seconds": 3.61,
      "text": "Come by reception afterwards and I'll fix the appointment."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 410.26,
      "end_seconds": 413.75,
      "duration_seconds": 3.49,
      "text": "I think we're done unless you have questions"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 415.36,
      "end_seconds": 420.79,
      "duration_seconds": 5.43,
      "text": "Right, um, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 422.24,
      "end_seconds": 423.43,
      "duration_seconds": 1.19,
      "text": "See you soon."
    }
  ]
}