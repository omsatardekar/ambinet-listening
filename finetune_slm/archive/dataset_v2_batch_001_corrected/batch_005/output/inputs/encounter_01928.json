{
  "schema_version": "1.0",
  "encounter_id": "01928",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.83,
      "end_seconds": 4.34,
      "duration_seconds": 3.51,
      "text": "Hello, sorry about the delay, do sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.27,
      "end_seconds": 7.3,
      "duration_seconds": 1.03,
      "text": "Evening, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 8.7,
      "end_seconds": 14.32,
      "duration_seconds": 5.62,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.21,
      "end_seconds": 22.37,
      "duration_seconds": 7.16,
      "text": "Of course, please stay. It's helpful to have you here. So, what's the main thing today?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.26,
      "end_seconds": 30.38,
      "duration_seconds": 5.12,
      "text": "Doctor, it's muscle weakness. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 31.94,
      "end_seconds": 39.44,
      "duration_seconds": 7.5,
      "text": "Okay, so the vitals from earlier. Pulse is 75 beats a minute, temperature 36.7, pressure 118 over 76."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.54,
      "end_seconds": 44.8,
      "duration_seconds": 4.26,
      "text": "Okay, noted. How long has it been like this?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 45.85,
      "end_seconds": 48.25,
      "duration_seconds": 2.4,
      "text": "I'd say three days, maybe."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 48.78,
      "end_seconds": 52.47,
      "duration_seconds": 3.69,
      "text": "I think it's been nearer five days, actually."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.38,
      "end_seconds": 58.6,
      "duration_seconds": 4.22,
      "text": "Okay, so roughly three to five days. Is that right?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 63.51,
      "end_seconds": 64.58,
      "duration_seconds": 1.07,
      "text": "Yeah, roughly."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.87,
      "end_seconds": 73.01,
      "duration_seconds": 2.14,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 73.92,
      "end_seconds": 84.51,
      "duration_seconds": 10.59,
      "text": "When it starts I tend to get aching muscles in my thighs as well. And I've been feeling tired as well."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.02,
      "end_seconds": 88.37,
      "duration_seconds": 3.35,
      "text": "Right, how much trouble does it give you?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.96,
      "end_seconds": 90.06,
      "duration_seconds": 1.1,
      "text": "Mild, really."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.94,
      "end_seconds": 92.59,
      "duration_seconds": 1.65,
      "text": "Nothing like joint swelling?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.35,
      "end_seconds": 96.34,
      "duration_seconds": 1.99,
      "text": "No joint swelling, thankfully."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.92,
      "end_seconds": 100.6,
      "duration_seconds": 3.68,
      "text": "Ah. Have you noticed rash, chest pain or fever?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.33,
      "end_seconds": 106.22,
      "duration_seconds": 3.89,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.31,
      "end_seconds": 112.34,
      "duration_seconds": 5.03,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 114.12,
      "end_seconds": 115.48,
      "duration_seconds": 1.36,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.14,
      "end_seconds": 137.93,
      "duration_seconds": 3.79,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 138.51,
      "end_seconds": 142.06,
      "duration_seconds": 3.55,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.7,
      "end_seconds": 146.89,
      "duration_seconds": 3.19,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.77,
      "end_seconds": 153.17,
      "duration_seconds": 4.4,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.99,
      "end_seconds": 157.19,
      "duration_seconds": 2.2,
      "text": "So, who lives with you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.01,
      "end_seconds": 161.46,
      "duration_seconds": 2.45,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.78,
      "end_seconds": 164.54,
      "duration_seconds": 1.76,
      "text": "Right, are you active?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.83,
      "end_seconds": 168.73,
      "duration_seconds": 2.9,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.94,
      "end_seconds": 172.28,
      "duration_seconds": 2.34,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.19,
      "end_seconds": 178.66,
      "duration_seconds": 5.47,
      "text": "Just my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.64,
      "end_seconds": 189.73,
      "duration_seconds": 2.09,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 191.46,
      "end_seconds": 195.28,
      "duration_seconds": 3.82,
      "text": "I have high cholesterol. I've, I've got migraines."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.98,
      "end_seconds": 203.72,
      "duration_seconds": 7.74,
      "text": "Okay, I can see high cholesterol in your file as well. Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 204.33,
      "end_seconds": 208.56,
      "duration_seconds": 4.23,
      "text": "Let me think, um, my son has asthma."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.25,
      "end_seconds": 218.14,
      "duration_seconds": 5.89,
      "text": "Let's run through your medicines. I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 219.74,
      "end_seconds": 226.12,
      "duration_seconds": 6.38,
      "text": "Propranolol. I take it 40 milligrams, twice a day for the migraine prevention."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.28,
      "end_seconds": 230.49,
      "duration_seconds": 3.21,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 232.21,
      "end_seconds": 239.79,
      "duration_seconds": 7.58,
      "text": "For about a year. I'm on something called para... paracetamol, 1 gram, maybe, when needed."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.45,
      "end_seconds": 246.9,
      "duration_seconds": 5.45,
      "text": "Alright, did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 248.87,
      "end_seconds": 252.46,
      "duration_seconds": 3.59,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.13,
      "end_seconds": 258.68,
      "duration_seconds": 3.55,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.04,
      "end_seconds": 262.61,
      "duration_seconds": 2.57,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.96,
      "end_seconds": 276.5,
      "duration_seconds": 4.54,
      "text": "The thigh muscles are tender and the strength is slightly reduced."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.48,
      "end_seconds": 283.17,
      "duration_seconds": 1.69,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 292.49,
      "end_seconds": 304.96,
      "duration_seconds": 12.47,
      "text": "Taking everything into account, I think we're dealing with muscle symptoms possibly from the cholesterol tablet at this stage. We shouldn't forget a low thyroid."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 306.05,
      "end_seconds": 308.04,
      "duration_seconds": 1.99,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.44,
      "end_seconds": 333.58,
      "duration_seconds": 24.14,
      "text": "I understand the worry. At the moment I'd say it's muscle symptoms possibly from the cholesterol tablet, and we'll watch how it goes. We will pause the statin for a few weeks while we check the blood tests. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 335.09,
      "end_seconds": 336.72,
      "duration_seconds": 1.63,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 337.84,
      "end_seconds": 339.89,
      "duration_seconds": 2.05,
      "text": "Come back after the results."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 341.24,
      "end_seconds": 343.36,
      "duration_seconds": 2.12,
      "text": "Okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 344.48,
      "end_seconds": 347.34,
      "duration_seconds": 2.86,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 348.57,
      "end_seconds": 351.67,
      "duration_seconds": 3.1,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 352.59,
      "end_seconds": 353.98,
      "duration_seconds": 1.39,
      "text": "Take care now."
    }
  ]
}