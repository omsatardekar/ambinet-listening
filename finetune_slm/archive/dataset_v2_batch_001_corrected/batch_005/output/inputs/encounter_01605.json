{
  "schema_version": "1.0",
  "encounter_id": "01605",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.94,
      "end_seconds": 8.52,
      "duration_seconds": 7.58,
      "text": "hmm, uh, doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.03,
      "end_seconds": 14.81,
      "duration_seconds": 4.78,
      "text": "you're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.36,
      "end_seconds": 24.58,
      "duration_seconds": 5.22,
      "text": "Um, so... a seizure last week. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.67,
      "end_seconds": 30.3,
      "duration_seconds": 3.63,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.03,
      "end_seconds": 35.34,
      "duration_seconds": 3.31,
      "text": "I've had it for three days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.7,
      "end_seconds": 45.71,
      "duration_seconds": 9.01,
      "text": "tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.03,
      "end_seconds": 51.38,
      "duration_seconds": 4.35,
      "text": "Severe, really. It's once or twice a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.98,
      "end_seconds": 55.34,
      "duration_seconds": 2.36,
      "text": "any other symptoms with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.8,
      "end_seconds": 84.21,
      "duration_seconds": 27.41,
      "text": "It usually comes with headache the next day. As for headache the next day, I honestly can't say when that began. It might have been last month or the month before. Let me think, as for headache the next day, about a six out of ten. And I've been feeling groggy afterwards as well."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.73,
      "end_seconds": 87.53,
      "duration_seconds": 2.8,
      "text": "let me take your readings now"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.06,
      "end_seconds": 101.62,
      "duration_seconds": 2.56,
      "text": "that's it, just a little longer.."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.26,
      "end_seconds": 128.54,
      "duration_seconds": 10.28,
      "text": "okay: SpO2 99 percent on room air, blood pressure 123 over 71, temp 36.5 degrees, pulse is 73 beats a minute"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.01,
      "end_seconds": 132.07,
      "duration_seconds": 2.06,
      "text": "may I examine you now?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.37,
      "end_seconds": 134.84,
      "duration_seconds": 1.47,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.28,
      "end_seconds": 148.01,
      "duration_seconds": 3.73,
      "text": "You are alert and your neurological examination is normal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.84,
      "end_seconds": 156.87,
      "duration_seconds": 3.03,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.01,
      "end_seconds": 166.57,
      "duration_seconds": 2.56,
      "text": "and fever, any of that?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.84,
      "end_seconds": 169.57,
      "duration_seconds": 1.73,
      "text": "nope, no fever"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.19,
      "end_seconds": 178.21,
      "duration_seconds": 7.02,
      "text": "Let me check a few things. Any second seizure, head injury or loss of bladder control?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.21,
      "end_seconds": 187.93,
      "duration_seconds": 7.72,
      "text": "so, um, no, no second seizure, head injury or loss of bladder control"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.38,
      "end_seconds": 191.74,
      "duration_seconds": 3.36,
      "text": "yes any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.64,
      "end_seconds": 195.33,
      "duration_seconds": 2.69,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.07,
      "end_seconds": 199.74,
      "duration_seconds": 2.67,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.52,
      "end_seconds": 210.48,
      "duration_seconds": 8.96,
      "text": "I've never touched a cigarette. I grab fast food at lunch most days. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.52,
      "end_seconds": 215.75,
      "duration_seconds": 3.23,
      "text": "Alright, is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.71,
      "end_seconds": 219.94,
      "duration_seconds": 3.23,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.09,
      "end_seconds": 223.48,
      "duration_seconds": 2.39,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.33,
      "end_seconds": 226.35,
      "duration_seconds": 2.02,
      "text": "Epilepsy, for five years."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.06,
      "end_seconds": 239.65,
      "duration_seconds": 2.59,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.27,
      "end_seconds": 241.77,
      "duration_seconds": 1.5,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.9,
      "end_seconds": 254.95,
      "duration_seconds": 3.05,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.24,
      "end_seconds": 260.65,
      "duration_seconds": 4.41,
      "text": "Yes, I had my tonsils removed, as a teenager."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.26,
      "end_seconds": 277.46,
      "duration_seconds": 15.2,
      "text": "Putting it all together, this looks most like a breakthrough seizure after missed medication and poor sleep. It could also be a dose that is too low, so we'll keep that open."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.81,
      "end_seconds": 281.14,
      "duration_seconds": 2.33,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.96,
      "end_seconds": 301.58,
      "duration_seconds": 18.62,
      "text": "Nothing I've seen today points to an emergency. It looks like a breakthrough seizure after missed medication and poor sleep. There's nothing new for me to start or arrange today. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.34,
      "end_seconds": 306.23,
      "duration_seconds": 3.89,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.34,
      "end_seconds": 308.75,
      "duration_seconds": 1.41,
      "text": "Goodbye for now."
    }
  ]
}