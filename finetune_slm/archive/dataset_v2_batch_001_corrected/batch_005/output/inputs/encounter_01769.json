{
  "schema_version": "1.0",
  "encounter_id": "01769",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.24,
      "end_seconds": 3.31,
      "duration_seconds": 2.07,
      "text": "Morning, come on through."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.66,
      "end_seconds": 5.7,
      "duration_seconds": 1.04,
      "text": "Evening, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.63,
      "end_seconds": 10.93,
      "duration_seconds": 3.3,
      "text": "So, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.62,
      "end_seconds": 20.01,
      "duration_seconds": 5.39,
      "text": "Well, I've been having a purple rash that does not fade."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.78,
      "end_seconds": 23.63,
      "duration_seconds": 1.85,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.54,
      "end_seconds": 27.06,
      "duration_seconds": 2.52,
      "text": "Probably about three months. Yeah."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.46,
      "end_seconds": 31.74,
      "duration_seconds": 4.28,
      "text": "Okay, go on. How much does it limit you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.39,
      "end_seconds": 38.72,
      "duration_seconds": 5.33,
      "text": "Mm, maybe a eight out of ten on a bad day."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.93,
      "end_seconds": 42.14,
      "duration_seconds": 2.21,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.82,
      "end_seconds": 50.43,
      "duration_seconds": 6.61,
      "text": "It usually comes with a high fever. The high fever? That's been since yesterday."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.97,
      "end_seconds": 71.42,
      "duration_seconds": 4.45,
      "text": "Have you had any diarrhoea, stiff neck or cough?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 72.69,
      "end_seconds": 75.78,
      "duration_seconds": 3.09,
      "text": "Hmm, nope, nothing like that."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.37,
      "end_seconds": 80.12,
      "duration_seconds": 3.75,
      "text": "Right, right. How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 81.42,
      "end_seconds": 83.81,
      "duration_seconds": 2.39,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.33,
      "end_seconds": 90.19,
      "duration_seconds": 4.86,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.73,
      "end_seconds": 93.69,
      "duration_seconds": 1.96,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.96,
      "end_seconds": 99.84,
      "duration_seconds": 4.88,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.84,
      "end_seconds": 104.14,
      "duration_seconds": 3.3,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.78,
      "end_seconds": 108.57,
      "duration_seconds": 2.79,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.48,
      "end_seconds": 128.96,
      "duration_seconds": 18.48,
      "text": "I'll have a glass of wine with dinner. I hardly move around during the day. I look after my grandchildren most days. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.25,
      "end_seconds": 148.79,
      "duration_seconds": 2.54,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 149.87,
      "end_seconds": 152.64,
      "duration_seconds": 2.77,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.95,
      "end_seconds": 174.83,
      "duration_seconds": 3.88,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.99,
      "end_seconds": 188.64,
      "duration_seconds": 2.65,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.56,
      "end_seconds": 219.35,
      "duration_seconds": 8.79,
      "text": "Okay: pulse 95, respiratory rate 17, oxygen saturation is 98 percent. And temperature is 39.2 degrees, pressure 120 over 68."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 221.42,
      "end_seconds": 222.79,
      "duration_seconds": 1.37,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.57,
      "end_seconds": 226.66,
      "duration_seconds": 2.09,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.19,
      "end_seconds": 233.05,
      "duration_seconds": 4.86,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.19,
      "end_seconds": 237.13,
      "duration_seconds": 2.94,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.62,
      "end_seconds": 255.08,
      "duration_seconds": 9.46,
      "text": "The purple spots do not fade when I press a glass on them, and he is floppy and drowsy."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.0,
      "end_seconds": 260.1,
      "duration_seconds": 2.1,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.08,
      "end_seconds": 291.65,
      "duration_seconds": 17.57,
      "text": "Okay, thinking it through, I think we're dealing with possible meningococcal sepsis at this stage. Just to be sure I understood. You've had a purple rash that does not fade for about three months, and no cough or diarrhoea."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 293.69,
      "end_seconds": 295.86,
      "duration_seconds": 2.17,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.95,
      "end_seconds": 300.15,
      "duration_seconds": 3.2,
      "text": "Let's get blood cultures, for possible sepsis."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 300.67,
      "end_seconds": 302.05,
      "duration_seconds": 1.38,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.85,
      "end_seconds": 327.26,
      "duration_seconds": 24.41,
      "text": "I think urgent blood tests makes sense here, for possible sepsis. For this, benzylpenicillin, 600 milligrams, once now, single dose. It's for possible meningococcal sepsis. I am giving an antibiotic injection now and calling an ambulance. The emergency team would be the right next step, I'll refer you."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 328.72,
      "end_seconds": 329.42,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 330.11,
      "end_seconds": 343.56,
      "duration_seconds": 13.45,
      "text": "Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. We'll catch up straight away. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 344.88,
      "end_seconds": 348.24,
      "duration_seconds": 3.36,
      "text": "Thank you, uh, doctor, goodbye."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 349.24,
      "end_seconds": 351.1,
      "duration_seconds": 1.86,
      "text": "So, see you soon."
    }
  ]
}