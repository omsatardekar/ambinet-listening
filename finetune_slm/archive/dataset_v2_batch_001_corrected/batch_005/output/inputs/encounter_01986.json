{
  "schema_version": "1.0",
  "encounter_id": "01986",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.93,
      "end_seconds": 4.41,
      "duration_seconds": 3.48,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.17,
      "end_seconds": 10.59,
      "duration_seconds": 4.42,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.24,
      "end_seconds": 18.59,
      "duration_seconds": 7.35,
      "text": "Doctor, um, I'll sit in if that's okay, I know what's been happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.78,
      "end_seconds": 23.14,
      "duration_seconds": 3.36,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.09,
      "end_seconds": 30.23,
      "duration_seconds": 5.14,
      "text": "Well, I've been having a cough for three weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.36,
      "end_seconds": 34.49,
      "duration_seconds": 3.13,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.92,
      "end_seconds": 39.8,
      "duration_seconds": 3.88,
      "text": "Yeah, I'd say about a month, maybe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 41.69,
      "end_seconds": 45.79,
      "duration_seconds": 4.1,
      "text": "Hm, I'd say more like about two months."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.95,
      "end_seconds": 51.83,
      "duration_seconds": 4.88,
      "text": "Okay, so roughly one to two months. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.16,
      "end_seconds": 54.36,
      "duration_seconds": 1.2,
      "text": "Yeah, roughly."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.48,
      "end_seconds": 58.31,
      "duration_seconds": 2.83,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.3,
      "end_seconds": 61.98,
      "duration_seconds": 2.68,
      "text": "It sort of comes and goes."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.65,
      "end_seconds": 65.5,
      "duration_seconds": 2.85,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.03,
      "end_seconds": 75.3,
      "duration_seconds": 8.27,
      "text": "I'd give it a three, out of ten. I've also had night sweats. I've also been losing weight."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.04,
      "end_seconds": 79.39,
      "duration_seconds": 2.35,
      "text": "Have you noticed fever or HIV?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.94,
      "end_seconds": 82.98,
      "duration_seconds": 3.04,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.55,
      "end_seconds": 88.46,
      "duration_seconds": 3.91,
      "text": "Have you noticed chest pain or coughing up blood?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.16,
      "end_seconds": 96.03,
      "duration_seconds": 5.87,
      "text": "Sorry, what was I saying, no, I haven't had any of them."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.97,
      "end_seconds": 103.59,
      "duration_seconds": 2.62,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.15,
      "end_seconds": 107.7,
      "duration_seconds": 2.55,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.45,
      "end_seconds": 116.32,
      "duration_seconds": 4.87,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.59,
      "end_seconds": 119.56,
      "duration_seconds": 1.97,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.85,
      "end_seconds": 133.13,
      "duration_seconds": 4.28,
      "text": "So, what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.96,
      "end_seconds": 138.23,
      "duration_seconds": 3.27,
      "text": "Hydrocortisone cream. I take it when needed."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.28,
      "end_seconds": 142.89,
      "duration_seconds": 2.61,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.08,
      "end_seconds": 156.29,
      "duration_seconds": 12.21,
      "text": "I used to drink heavily but I stopped four years ago. I'm a plumber, lots of bending and kneeling. I walk the dog every morning."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.99,
      "end_seconds": 163.68,
      "duration_seconds": 2.69,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.57,
      "end_seconds": 166.75,
      "duration_seconds": 2.18,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.66,
      "end_seconds": 172.63,
      "duration_seconds": 3.97,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.12,
      "end_seconds": 177.91,
      "duration_seconds": 3.79,
      "text": "Tramadol. I come out in... well, vomiting."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.69,
      "end_seconds": 190.77,
      "duration_seconds": 4.08,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.99,
      "end_seconds": 198.12,
      "duration_seconds": 2.13,
      "text": "I've had eczema, yes."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.65,
      "end_seconds": 209.12,
      "duration_seconds": 9.47,
      "text": "I follow. Okay, I can see eczema in your file as well. Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.75,
      "end_seconds": 218.96,
      "duration_seconds": 3.21,
      "text": "So, that's it, just a little longer..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.92,
      "end_seconds": 241.15,
      "duration_seconds": 12.23,
      "text": "Okay: respiratory rate 18, pulse is 72 beats a minute, SpO2 97 percent on room air. And blood pressure 120 over 81, temperature is 36.7 degrees."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.5,
      "end_seconds": 243.97,
      "duration_seconds": 1.47,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.25,
      "end_seconds": 251.39,
      "duration_seconds": 4.14,
      "text": "Alright, they help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.91,
      "end_seconds": 256.81,
      "duration_seconds": 3.9,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.4,
      "end_seconds": 261.34,
      "duration_seconds": 2.94,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.3,
      "end_seconds": 276.98,
      "duration_seconds": 4.68,
      "text": "There are some crackles at the top of the right lung."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.2,
      "end_seconds": 283.53,
      "duration_seconds": 2.33,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.06,
      "end_seconds": 295.61,
      "duration_seconds": 4.55,
      "text": "Putting it all together, this is probably possible tuberculosis."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.94,
      "end_seconds": 298.89,
      "duration_seconds": 1.95,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.81,
      "end_seconds": 316.93,
      "duration_seconds": 17.12,
      "text": "It's reasonable to be concerned, but right now possible tuberculosis is my leading thought, not anything worse. Let's book three sputum samples to look into possible tuberculosis. A chest X-ray is what I'd like next, for prolonged cough."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.68,
      "end_seconds": 320.94,
      "duration_seconds": 3.26,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.8,
      "end_seconds": 340.3,
      "duration_seconds": 17.5,
      "text": "Wear a mask in public and cover your mouth when you cough until the results are back. The TB service would be the right next step, I'll refer you. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.94,
      "end_seconds": 344.5,
      "duration_seconds": 3.56,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.05,
      "end_seconds": 347.39,
      "duration_seconds": 1.34,
      "text": "Goodbye for now."
    }
  ]
}