    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.01,
      "end_seconds": 167.63,
      "duration_seconds": 4.62,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.48,
      "end_seconds": 183.67,
      "duration_seconds": 14.19,
      "text": "I'll have a glass of wine with dinner. Not much, I mostly stay in these days. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.85,
      "end_seconds": 197.55,
      "duration_seconds": 2.7,
      "text": "have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.61,
      "end_seconds": 204.74,
      "duration_seconds": 5.13,
      "text": "I had a caesarean for my second baby nine years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.43,
      "end_seconds": 208.76,
      "duration_seconds": 3.33,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.48,
      "end_seconds": 213.5,
      "duration_seconds": 4.02,
      "text": "I mean, my mother has an underactive thyroid"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.07,
      "end_seconds": 216.8,
      "duration_seconds": 2.73,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.76,
      "end_seconds": 230.84,
      "duration_seconds": 2.08,
      "text": "Nearly done with the readings..."
