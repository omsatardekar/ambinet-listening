    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.78,
      "end_seconds": 148.63,
      "duration_seconds": 12.85,
      "text": "I've had thin bones for about ten years now. Ah, I've got low haemoglobin. I'd rather know what's going on than keep guessing."
    },
