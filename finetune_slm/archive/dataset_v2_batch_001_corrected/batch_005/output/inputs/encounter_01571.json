    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.88,
      "end_seconds": 255.78,
      "duration_seconds": 10.9,
      "text": "okay: temperature is 36.9 degrees, pulse 94. And respiratory rate 16, oxygen saturation is 96 percent, BP is 103 over 63."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.73,
      "end_seconds": 259.95,
      "duration_seconds": 2.22,
      "text": "is that alright doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.56,
      "end_seconds": 264.11,
      "duration_seconds": 3.55,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.75,
      "end_seconds": 269.59,
      "duration_seconds": 2.84,
      "text": "okay, may I examine you now?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.54,
      "end_seconds": 273.55,
      "duration_seconds": 2.01,
      "text": "raise your arm for me"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.4,
      "end_seconds": 287.45,
      "duration_seconds": 5.05,
      "text": "You are pale and clammy and and the womb feels soft and large."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.04,
      "end_seconds": 311.64,
      "duration_seconds": 19.6,
      "text": "that's the examination finished. Right, here's what I'm thinking. I can't pin this down yet. We're looking at a postpartum haemorrhage or retained tissue. Let me just check I've got this right. You've had heavy bleeding after the birth for about a week, and no fever or headache"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.55,
      "end_seconds": 315.21,
      "duration_seconds": 1.66,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.81,
      "end_seconds": 336.02,
      "duration_seconds": 19.21,
      "text": "let's book an urgent scan to look into bleeding i think urgent blood tests makes sense here, for haemorrhage for this, oxytocin, 10 units, now, single dose that's for postpartum bleeding i'll put all of this in writing so you don't have to remember it"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.57,
      "end_seconds": 341.12,
      "duration_seconds": 3.55,
      "text": "is that safe with my other medicines?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.87,
      "end_seconds": 358.32,
      "duration_seconds": 15.45,
      "text": "I am rubbing the womb to help it contract, and calling the emergency team please come and see me straight away right, that's the plan do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.71,
      "end_seconds": 362.14,
