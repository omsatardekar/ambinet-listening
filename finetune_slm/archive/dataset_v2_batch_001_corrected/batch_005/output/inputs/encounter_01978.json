{
  "schema_version": "1.0",
  "encounter_id": "01978",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.63,
      "end_seconds": 5.09,
      "duration_seconds": 4.46,
      "text": "Morning, um, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.53,
      "end_seconds": 11.37,
      "duration_seconds": 4.84,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 16.59,
      "end_seconds": 22.67,
      "duration_seconds": 6.08,
      "text": "Hello, you know, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.72,
      "end_seconds": 27.65,
      "duration_seconds": 3.93,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.05,
      "end_seconds": 43.14,
      "duration_seconds": 14.09,
      "text": "Sorry, uh, what was I saying, mainly a tremor in my right hand at rest. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.77,
      "end_seconds": 47.63,
      "duration_seconds": 2.86,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.31,
      "end_seconds": 63.62,
      "duration_seconds": 2.31,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.16,
      "end_seconds": 83.87,
      "duration_seconds": 9.71,
      "text": "Okay: heart rate 75, pressure 128 over 70. And temperature is 36.7 degrees, saturation 98 percent, respiratory rate 18."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.02,
      "end_seconds": 86.93,
      "duration_seconds": 1.91,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.44,
      "end_seconds": 96.92,
      "duration_seconds": 8.48,
      "text": "So, I'll explain what these mean in a moment. Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.49,
      "end_seconds": 101.82,
      "duration_seconds": 3.33,
      "text": "Around a week, um, I think."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 107.31,
      "end_seconds": 110.63,
      "duration_seconds": 3.32,
      "text": "Hm, I'd say more like two weeks."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.38,
      "end_seconds": 116.8,
      "duration_seconds": 4.42,
      "text": "Okay, so roughly one to two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.58,
      "end_seconds": 119.5,
      "duration_seconds": 1.92,
      "text": "That sounds about right."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.4,
      "end_seconds": 124.67,
      "duration_seconds": 3.27,
      "text": "So, how troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.42,
      "end_seconds": 128.4,
      "duration_seconds": 1.98,
      "text": "I'd call it moderate."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.39,
      "end_seconds": 133.74,
      "duration_seconds": 3.35,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.25,
      "end_seconds": 140.65,
      "duration_seconds": 5.4,
      "text": "Smaller handwriting goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.45,
      "end_seconds": 143.18,
      "duration_seconds": 1.73,
      "text": "Any slowness as well?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.21,
      "end_seconds": 154.28,
      "duration_seconds": 5.07,
      "text": "Mm, yes. The smaller handwriting? That's been since yesterday."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.45,
      "end_seconds": 157.32,
      "duration_seconds": 1.87,
      "text": "Nothing like memory problems?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.88,
      "end_seconds": 160.83,
      "duration_seconds": 2.95,
      "text": "I haven't noticed any memory problems."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.32,
      "end_seconds": 166.53,
      "duration_seconds": 4.21,
      "text": "Any loss of smell, constipation or falls at all?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.24,
      "end_seconds": 171.32,
      "duration_seconds": 3.08,
      "text": "Oh, no, not a single one."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.64,
      "end_seconds": 175.71,
      "duration_seconds": 4.07,
      "text": "Yes, carry on. Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.32,
      "end_seconds": 178.94,
      "duration_seconds": 1.62,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.84,
      "end_seconds": 181.86,
      "duration_seconds": 2.02,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.7,
      "end_seconds": 188.34,
      "duration_seconds": 4.64,
      "text": "Okay, um, so no, my breathing's been fine."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.84,
      "end_seconds": 200.01,
      "duration_seconds": 3.17,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.8,
      "end_seconds": 205.62,
      "duration_seconds": 3.82,
      "text": "I've had arthritis in my knees, yes."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.97,
      "end_seconds": 208.5,
      "duration_seconds": 1.53,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.66,
      "end_seconds": 216.88,
      "duration_seconds": 7.22,
      "text": "I have an underactive thyroid. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.31,
      "end_seconds": 228.07,
      "duration_seconds": 9.76,
      "text": "Yes, carry on. Yes, arthritis in your knees is known to us, good to have that clear. Any previous surgeries?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.2,
      "end_seconds": 231.88,
      "duration_seconds": 2.68,
      "text": "Well, no, not at all."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.46,
      "end_seconds": 252.41,
      "duration_seconds": 4.95,
      "text": "Alright, can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.64,
      "end_seconds": 256.79,
      "duration_seconds": 3.15,
      "text": "Diclofenac, 50 milligrams, maybe, when needed."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.46,
      "end_seconds": 260.83,
      "duration_seconds": 3.37,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.43,
      "end_seconds": 271.54,
      "duration_seconds": 9.11,
      "text": "No, um, it's at home. I'm on thyroxine, 75 micrograms, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.45,
      "end_seconds": 275.91,
      "duration_seconds": 2.46,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.45,
      "end_seconds": 282.15,
      "duration_seconds": 5.7,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.17,
      "end_seconds": 286.25,
      "duration_seconds": 2.08,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.2,
      "end_seconds": 291.82,
      "duration_seconds": 3.62,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.86,
      "end_seconds": 295.59,
      "duration_seconds": 2.73,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.44,
      "end_seconds": 298.92,
      "duration_seconds": 2.48,
      "text": "Yeah, my brother has epilepsy."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.59,
      "end_seconds": 303.96,
      "duration_seconds": 3.37,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.73,
      "end_seconds": 312.77,
      "duration_seconds": 8.04,
      "text": "Yes, erythromycin, it gives me bad stomach cramps. Um, yes, I'm allergic to wheat."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.16,
      "end_seconds": 317.52,
      "duration_seconds": 3.36,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.36,
      "end_seconds": 321.54,
      "duration_seconds": 2.18,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.92,
      "end_seconds": 339.79,
      "duration_seconds": 7.87,
      "text": "There is a pill-rolling tremor at rest on the right and the arm is stiff with a cogwheel feel."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.91,
      "end_seconds": 355.69,
      "duration_seconds": 11.78,
      "text": "That's the examination finished. Right, here's what I'm thinking. My working impression is possible Parkinson's disease. A drug-induced tremor is also on my list."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.14,
      "end_seconds": 363.58,
      "duration_seconds": 4.44,
      "text": "Okay, so I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.48,
      "end_seconds": 373.52,
      "duration_seconds": 8.04,
      "text": "I can't promise yet, but most people with possible Parkinson's disease do well once it's treated properly."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 383.4,
      "end_seconds": 403.46,
      "duration_seconds": 20.06,
      "text": "I'd like to arrange a blood test for tremor. The result will help us decide whether anything more is needed. I'm referring you to the specialist and meanwhile keep active. I'd like you to see the movement disorders clinic as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 404.68,
      "end_seconds": 406.24,
      "duration_seconds": 1.56,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 407.37,
      "end_seconds": 420.42,
      "duration_seconds": 13.05,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. We'll catch up after the specialist. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 422.04,
      "end_seconds": 426.69,
      "duration_seconds": 4.65,
      "text": "Erm, uh, great, thank you for your help."
    }
  ]
}