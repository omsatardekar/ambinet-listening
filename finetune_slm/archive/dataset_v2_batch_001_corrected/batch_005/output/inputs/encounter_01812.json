{
  "schema_version": "1.0",
  "encounter_id": "01812",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.88,
      "end_seconds": 4.18,
      "duration_seconds": 3.3,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.35,
      "end_seconds": 10.36,
      "duration_seconds": 5.01,
      "text": "Yes, have a a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.93,
      "end_seconds": 17.7,
      "duration_seconds": 5.77,
      "text": "hello, you know, doctor, I came in with them, if that's okay"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.45,
      "end_seconds": 20.28,
      "duration_seconds": 1.83,
      "text": "I've been feeling hopeless."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.96,
      "end_seconds": 25.25,
      "duration_seconds": 3.29,
      "text": "How strong would you say it it is?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.8,
      "end_seconds": 29.81,
      "duration_seconds": 3.01,
      "text": "About a four out of ten."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.66,
      "end_seconds": 32.66,
      "duration_seconds": 2.0,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.72,
      "end_seconds": 47.36,
      "duration_seconds": 13.64,
      "text": "Yeah, it usually comes with thoughts of ending my life. I've had a plan too, for five days. And, And not sleeping for days, too."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.91,
      "end_seconds": 52.66,
      "duration_seconds": 2.75,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.48,
      "end_seconds": 64.56,
      "duration_seconds": 3.08,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.23,
      "end_seconds": 92.79,
      "duration_seconds": 7.56,
      "text": "Okay: SpO2 98 percent on room air, temperature 37.0, pulse 66. And BP is 125 over 76."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.51,
      "end_seconds": 97.48,
      "duration_seconds": 1.97,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.55,
      "end_seconds": 108.49,
      "duration_seconds": 0.94,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.49,
      "end_seconds": 111.53,
      "duration_seconds": 2.04,
      "text": "tell me if that's sore"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.6,
      "end_seconds": 125.19,
      "duration_seconds": 6.59,
      "text": "You are calm but very flat, and you have thought through how you would do it."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.98,
      "end_seconds": 135.79,
      "duration_seconds": 5.81,
      "text": "you can relax now. Any hearing voices, recent loss, drinking or having taken tablets?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.81,
      "end_seconds": 141.17,
      "duration_seconds": 3.36,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.34,
      "end_seconds": 145.14,
      "duration_seconds": 2.8,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.81,
      "end_seconds": 149.62,
      "duration_seconds": 2.81,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.29,
      "end_seconds": 153.17,
      "duration_seconds": 2.88,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.85,
      "end_seconds": 157.69,
      "duration_seconds": 3.84,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.3,
      "end_seconds": 162.26,
      "duration_seconds": 2.96,
      "text": "are you on your own at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.09,
      "end_seconds": 170.96,
      "duration_seconds": 2.87,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.56,
      "end_seconds": 177.7,
      "duration_seconds": 6.14,
      "text": "Tell me your medicines, please. These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.53,
      "end_seconds": 184.51,
      "duration_seconds": 4.98,
      "text": "I'd been on sertraline, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.27,
      "end_seconds": 189.27,
      "duration_seconds": 3.0,
      "text": "what operations have you had, if any?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.12,
      "end_seconds": 200.41,
      "duration_seconds": 10.29,
      "text": "I had my appendix taken out when I was in my twenties. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.46,
      "end_seconds": 219.6,
      "duration_seconds": 2.14,
      "text": "what about your medical history?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.66,
      "end_seconds": 222.77,
      "duration_seconds": 2.11,
      "text": "I've had depression, yes."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.32,
      "end_seconds": 224.99,
      "duration_seconds": 1.67,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.47,
      "end_seconds": 230.16,
      "duration_seconds": 3.69,
      "text": "I have asthma, for about a year."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.83,
      "end_seconds": 234.09,
      "duration_seconds": 3.26,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.26,
      "end_seconds": 238.46,
      "duration_seconds": 3.2,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.64,
      "end_seconds": 244.48,
      "duration_seconds": 4.84,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.59,
      "end_seconds": 251.62,
      "duration_seconds": 6.03,
      "text": "not currently, but as a youngster erythromycin gave me a rash"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.18,
      "end_seconds": 270.97,
      "duration_seconds": 18.79,
      "text": "putting it all together, it fits best with a high risk of suicide needing urgent assessment. I'd also keep a severe depressive episode in mind. Let me just check I've got this right. You've been feeling hopeless, and no hearing voices or drinking"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.67,
      "end_seconds": 274.66,
      "duration_seconds": 1.99,
      "text": "That's what happened, yes."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.15,
      "end_seconds": 291.09,
      "duration_seconds": 4.94,
      "text": "let's get an urgent mental health assessment, for suicidal thoughts"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.72,
      "end_seconds": 293.97,
      "duration_seconds": 2.25,
      "text": "do I need to prepare?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.09,
      "end_seconds": 306.37,
      "duration_seconds": 11.28,
      "text": "I want you to stay with me while we arrange help, and your family will be called. I'm going to send a referral to the crisis team"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.76,
      "end_seconds": 310.14,
      "duration_seconds": 2.38,
      "text": "sure, where do I go?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.83,
      "end_seconds": 317.31,
      "duration_seconds": 6.48,
      "text": "I'd like you back straight away. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.23,
      "end_seconds": 323.81,
      "duration_seconds": 4.58,
      "text": "Okay, that that makes sense. Thanks for explaining."
    }
  ]
}