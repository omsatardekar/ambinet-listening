{
  "schema_version": "1.0",
  "encounter_id": "01759",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.57,
      "end_seconds": 4.52,
      "duration_seconds": 3.95,
      "text": "morning, doctor i've settled them in, ready when you are"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.79,
      "end_seconds": 10.22,
      "duration_seconds": 4.43,
      "text": "Great. Hello, come in and sit down. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.51,
      "end_seconds": 17.01,
      "duration_seconds": 5.5,
      "text": "hello, doctor, I came in with them, if that's okay"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.03,
      "end_seconds": 21.03,
      "duration_seconds": 3.0,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 22.97,
      "end_seconds": 27.17,
      "duration_seconds": 4.2,
      "text": "We came because of some soreness from the stitches."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.69,
      "end_seconds": 29.76,
      "duration_seconds": 2.07,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 31.23,
      "end_seconds": 34.72,
      "duration_seconds": 3.49,
      "text": "it's been going on for three days"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.17,
      "end_seconds": 40.21,
      "duration_seconds": 5.04,
      "text": "Okay, go on. Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 41.99,
      "end_seconds": 43.59,
      "duration_seconds": 1.6,
      "text": "It's severe, honestly."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 44.49,
      "end_seconds": 51.96,
      "duration_seconds": 7.47,
      "text": "Uh, and the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 52.06,
      "end_seconds": 56.91,
      "duration_seconds": 4.85,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 58.57,
      "end_seconds": 60.87,
      "duration_seconds": 2.3,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.65,
      "end_seconds": 69.87,
      "duration_seconds": 7.22,
      "text": "That's fine, one at a time. I'll ask about everything. Have you been feeling tearful at times?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 71.96,
      "end_seconds": 74.22,
      "duration_seconds": 2.26,
      "text": "Yes, for two weeks."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.22,
      "end_seconds": 78.35,
      "duration_seconds": 3.13,
      "text": "Have you been feeling tired after the birth?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 79.41,
      "end_seconds": 80.94,
      "duration_seconds": 1.53,
      "text": "yes, I have"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.26,
      "end_seconds": 86.07,
      "duration_seconds": 3.81,
      "text": "is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 87.44,
      "end_seconds": 93.52,
      "duration_seconds": 6.08,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.13,
      "end_seconds": 100.41,
      "duration_seconds": 6.28,
      "text": "take your time mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 102.17,
      "end_seconds": 104.97,
      "duration_seconds": 2.8,
      "text": "about a eight out of ten"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.05,
      "end_seconds": 113.29,
      "duration_seconds": 6.24,
      "text": "okay, any leg swelling, fever or thoughts of harming the baby at all?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 114.74,
      "end_seconds": 130.68,
      "duration_seconds": 15.94,
      "text": "No, uh, no leg swelling, no fever, no thoughts of harming the baby. I did have bleeding that is tailing off at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.71,
      "end_seconds": 135.11,
      "duration_seconds": 2.4,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 138.01,
      "end_seconds": 139.83,
      "duration_seconds": 1.82,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.69,
      "end_seconds": 143.75,
      "duration_seconds": 3.06,
      "text": "has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 144.47,
      "end_seconds": 149.33,
      "duration_seconds": 4.86,
      "text": "my heart's been fine, as far as I know"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.3,
      "end_seconds": 152.88,
      "duration_seconds": 2.58,
      "text": "alright, and alcohol, how much?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 154.93,
      "end_seconds": 159.27,
      "duration_seconds": 4.34,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.79,
      "end_seconds": 163.62,
      "duration_seconds": 3.83,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 164.22,
      "end_seconds": 167.6,
      "duration_seconds": 3.38,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.62,
      "end_seconds": 174.05,
      "duration_seconds": 1.43,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 174.95,
      "end_seconds": 178.07,
      "duration_seconds": 3.12,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.04,
      "end_seconds": 186.85,
      "duration_seconds": 3.81,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 187.41,
      "end_seconds": 195.53,
      "duration_seconds": 8.12,
      "text": "I've got arthritis in my knees. Yes, an irregular heartbeat. High cholesterol, for about ten years"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.23,
      "end_seconds": 212.44,
      "duration_seconds": 12.21,
      "text": "Okay, go on. Alright, arthritis in your knees and an irregular heartbeat, that matches what I have here. Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 213.47,
      "end_seconds": 219.31,
      "duration_seconds": 5.84,
      "text": "I'm on diclofenac, 50 milligrams, when needed for the joint pain."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 220.9,
      "end_seconds": 227.62,
      "duration_seconds": 6.72,
      "text": "It's meant to be when needed, though I don't see she take it every time."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 228.34,
      "end_seconds": 231.17,
      "duration_seconds": 2.83,
      "text": "I'm on paracetamol, when needed"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.09,
      "end_seconds": 234.36,
      "duration_seconds": 2.27,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 235.45,
      "end_seconds": 244.07,
      "duration_seconds": 8.62,
      "text": "1 gram, I think that's what's on the box i used to take rosuvastatin, but I stopped it"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.56,
      "end_seconds": 262.19,
      "duration_seconds": 2.63,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 263.44,
      "end_seconds": 269.1,
      "duration_seconds": 5.66,
      "text": "Diclofenac. I come out in... well, swelling of my lips."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 270.91,
      "end_seconds": 279.8,
      "duration_seconds": 8.89,
      "text": "Here are the numbers, doctor. Pressure 115 over 76, respiratory rate 16, pulse 85, oxygen saturation is 98 percent."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.19,
      "end_seconds": 281.89,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.24,
      "end_seconds": 286.31,
      "duration_seconds": 3.07,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 294.29,
      "end_seconds": 295.84,
      "duration_seconds": 1.55,
      "text": "yes, that's fine"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.33,
      "end_seconds": 299.6,
      "duration_seconds": 2.27,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.77,
      "end_seconds": 315.56,
      "duration_seconds": 6.79,
      "text": "The womb has gone down well and the the stitches are healing, with no redness."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.96,
      "end_seconds": 334.34,
      "duration_seconds": 15.38,
      "text": "All finished, thank you. Having listened and examined, this is probably a normal postnatal recovery. That's my thinking for now, and it may change as we learn more. Another possibility is the baby blues."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 336.3,
      "end_seconds": 337.92,
      "duration_seconds": 1.62,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.6,
      "end_seconds": 359.18,
      "duration_seconds": 20.58,
      "text": "I can't promise yet, but most people with a normal postnatal recovery do well once it's treated properly let me just check I've got this right you've had some soreness from the stitches for three days, severe, and no fever or leg swelling"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 361.13,
      "end_seconds": 362.86,
      "duration_seconds": 1.73,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.67,
      "end_seconds": 367.94,
      "duration_seconds": 4.27,
      "text": "I want a blood count done, that's for postnatal tiredness."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 370.38,
      "end_seconds": 372.77,
      "duration_seconds": 2.39,
      "text": "The earliest is Wednesday, 9 am."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 374.02,
      "end_seconds": 377.37,
      "duration_seconds": 3.35,
      "text": "Wednesday, that that works for me."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 382.34,
      "end_seconds": 401.28,
      "duration_seconds": 18.94,
      "text": "rest when the baby sleeps and ask for help; contraception can be discussed at six weeks please don't wait if the symptoms get worse that's when to be seen urgently i'd like to see you again in four weeks does all of that make sense?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 406.2,
      "end_seconds": 408.37,
      "duration_seconds": 2.17,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}