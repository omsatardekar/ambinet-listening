{
  "schema_version": "1.0",
  "encounter_id": "01878",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.95,
      "end_seconds": 8.2,
      "duration_seconds": 7.25,
      "text": "Hello, take a seat, I'll be with you in a second. Have you been waiting long?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.03,
      "end_seconds": 12.61,
      "duration_seconds": 2.58,
      "text": "Only about ten minutes, honestly."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.38,
      "end_seconds": 15.59,
      "duration_seconds": 1.21,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 17.19,
      "end_seconds": 22.28,
      "duration_seconds": 5.09,
      "text": "So the thing is, I've got a dull low backache."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.69,
      "end_seconds": 31.71,
      "duration_seconds": 4.02,
      "text": "Alright, time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.73,
      "end_seconds": 45.0,
      "duration_seconds": 2.27,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 58.88,
      "end_seconds": 66.29,
      "duration_seconds": 7.41,
      "text": "Okay: pulse 95, temp 39.0 degrees, blood pressure 119 over 68, SpO2 98 percent on room air."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 67.67,
      "end_seconds": 69.3,
      "duration_seconds": 1.63,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.12,
      "end_seconds": 75.66,
      "duration_seconds": 4.54,
      "text": "We'll go over that shortly. Did it come on recently?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.11,
      "end_seconds": 79.04,
      "duration_seconds": 1.93,
      "text": "Probably two weeks. Yeah."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.74,
      "end_seconds": 91.34,
      "duration_seconds": 11.6,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps. I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.9,
      "end_seconds": 99.76,
      "duration_seconds": 6.86,
      "text": "Honestly, a couple of times a week. About a five out of ten."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.81,
      "end_seconds": 115.99,
      "duration_seconds": 5.18,
      "text": "Did you get reduced baby movements, vaginal bleeding or leaking fluid?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 116.77,
      "end_seconds": 119.53,
      "duration_seconds": 2.76,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.22,
      "end_seconds": 124.09,
      "duration_seconds": 2.87,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.6,
      "end_seconds": 127.52,
      "duration_seconds": 1.92,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.09,
      "end_seconds": 132.14,
      "duration_seconds": 4.05,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 133.31,
      "end_seconds": 139.56,
      "duration_seconds": 6.25,
      "text": "Sorry, what was I saying, no, nothing I can think of."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.31,
      "end_seconds": 152.26,
      "duration_seconds": 2.95,
      "text": "Okay, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 153.8,
      "end_seconds": 155.53,
      "duration_seconds": 1.73,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.2,
      "end_seconds": 158.77,
      "duration_seconds": 2.57,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.26,
      "end_seconds": 163.41,
      "duration_seconds": 3.15,
      "text": "Ah, no, I'm not on anything."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.37,
      "end_seconds": 168.37,
      "duration_seconds": 4.0,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.14,
      "end_seconds": 179.86,
      "duration_seconds": 10.72,
      "text": "Not much, I mostly stay in these days. I look after my grandchildren most days. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.96,
      "end_seconds": 194.9,
      "duration_seconds": 3.94,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 196.58,
      "end_seconds": 204.81,
      "duration_seconds": 8.23,
      "text": "Yes, nickel. I've no idea what the reaction was, only that I'm not supposed to have it."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.82,
      "end_seconds": 210.36,
      "duration_seconds": 4.54,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 219.29,
      "end_seconds": 219.99,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.3,
      "end_seconds": 222.67,
      "duration_seconds": 1.37,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.67,
      "end_seconds": 247.34,
      "duration_seconds": 5.67,
      "text": "There is mild tenderness above the pubic bone and no tenderness in the loins."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.98,
      "end_seconds": 268.55,
      "duration_seconds": 16.57,
      "text": "You can sit up now. So, based on the history and the examination, this looks most like a urinary infection in pregnancy. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 270.31,
      "end_seconds": 271.68,
      "duration_seconds": 1.37,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.59,
      "end_seconds": 302.84,
      "duration_seconds": 29.25,
      "text": "Nothing I've seen today points to an emergency. It looks like a urinary infection in pregnancy, but I'd like to confirm. I'm going to order a urine culture, for urinary infection. We should do a urine dipstick for burning urine. Let's use cefalexin, 500 milligrams, twice a day, seven days. You take it by mouth. That should help with urinary infection in pregnancy. Drink plenty of fluids and tell your midwife."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.31,
      "end_seconds": 326.06,
      "duration_seconds": 21.75,
      "text": "I'd like you to see the midwife as well, and I'll write the referral. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency. I'd like you back in one week. Right, have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 327.19,
      "end_seconds": 330.82,
      "duration_seconds": 3.63,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 332.9,
      "end_seconds": 334.1,
      "duration_seconds": 1.2,
      "text": "Take care now."
    }
  ]
}