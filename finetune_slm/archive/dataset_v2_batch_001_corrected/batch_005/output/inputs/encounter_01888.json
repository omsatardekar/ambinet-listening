{
  "schema_version": "1.0",
  "encounter_id": "01888",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.11,
      "end_seconds": 7.75,
      "duration_seconds": 6.64,
      "text": "Come in, have a seat by the desk. Is it your first time here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.24,
      "end_seconds": 13.08,
      "duration_seconds": 3.84,
      "text": "No, I came last year for something else."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.04,
      "end_seconds": 17.94,
      "duration_seconds": 3.9,
      "text": "what would you like to start with today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.12,
      "end_seconds": 32.51,
      "duration_seconds": 13.39,
      "text": "Uh, doctor, it's pain under my right ribs after fatty meals. It's getting on my nerves now. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.41,
      "end_seconds": 37.1,
      "duration_seconds": 3.69,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.57,
      "end_seconds": 41.3,
      "duration_seconds": 2.73,
      "text": "It's been about a week now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.92,
      "end_seconds": 51.3,
      "duration_seconds": 9.38,
      "text": "Alright, can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 53.0,
      "end_seconds": 61.04,
      "duration_seconds": 8.04,
      "text": "It settles a little with lying still. Moderate, I'd say. Yes, fatty meals. That makes it worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 63.12,
      "end_seconds": 67.39,
      "duration_seconds": 4.27,
      "text": "a few quick ones: pale stools, fever or yellow eyes?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.68,
      "end_seconds": 71.14,
      "duration_seconds": 2.46,
      "text": "no, not a single one"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.45,
      "end_seconds": 78.99,
      "duration_seconds": 3.54,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.31,
      "end_seconds": 83.13,
      "duration_seconds": 2.82,
      "text": "Well, no, nothing like that."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.87,
      "end_seconds": 86.26,
      "duration_seconds": 2.39,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.8,
      "end_seconds": 90.26,
      "duration_seconds": 3.46,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.1,
      "end_seconds": 92.32,
      "duration_seconds": 1.22,
      "text": "what's your work?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.26,
      "end_seconds": 98.53,
      "duration_seconds": 4.27,
      "text": "I'm a plumber, lots of bending and kneeling"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.11,
      "end_seconds": 102.18,
      "duration_seconds": 2.07,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.87,
      "end_seconds": 108.11,
      "duration_seconds": 4.24,
      "text": "No, I share a house with my brother"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.55,
      "end_seconds": 123.35,
      "duration_seconds": 2.8,
      "text": "are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 124.48,
      "end_seconds": 127.7,
      "duration_seconds": 3.22,
      "text": "um, my aunt has rheumatoid arthritis"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.57,
      "end_seconds": 138.83,
      "duration_seconds": 3.26,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 140.04,
      "end_seconds": 145.18,
      "duration_seconds": 5.14,
      "text": "I take metoprolol, twice a day for my pressure."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.4,
      "end_seconds": 148.51,
      "duration_seconds": 2.11,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.54,
      "end_seconds": 156.2,
      "duration_seconds": 5.66,
      "text": "It's 50 milligrams. I take an antacid, 10 ml, when needed."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.89,
      "end_seconds": 159.71,
      "duration_seconds": 2.82,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.12,
      "end_seconds": 165.37,
      "duration_seconds": 4.25,
      "text": "I've had high blood pressure for two years now"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.44,
      "end_seconds": 172.82,
      "duration_seconds": 5.38,
      "text": "yes, carry on shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.65,
      "end_seconds": 183.06,
      "duration_seconds": 2.41,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.23,
      "end_seconds": 202.26,
      "duration_seconds": 7.03,
      "text": "Okay: BP is 109 over 70, heart rate 83, temperature 36.7, oxygen saturation is 99 percent."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 203.25,
      "end_seconds": 205.57,
      "duration_seconds": 2.32,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.21,
      "end_seconds": 209.07,
      "duration_seconds": 2.86,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.92,
      "end_seconds": 215.38,
      "duration_seconds": 3.46,
      "text": "right, let's have a proper look at you"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.12,
      "end_seconds": 219.71,
      "duration_seconds": 2.59,
      "text": "take a deep breath for me"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.66,
      "end_seconds": 243.79,
      "duration_seconds": 6.13,
      "text": "It is tender under the right ribs and you stop breathing in when I press."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.13,
      "end_seconds": 249.55,
      "duration_seconds": 2.42,
      "text": "So, that's the examination finished."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.16,
      "end_seconds": 270.7,
      "duration_seconds": 13.54,
      "text": "From what you've told me and what I found, this looks most like gallstone-related pain. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.04,
      "end_seconds": 311.88,
      "duration_seconds": 29.84,
      "text": "I'll request an ultrasound of the abdomen, it'll help with biliary pain. I'd like you to take paracetamol, 1 gram, four times a day when needed, one week. That's for pain. Avoid fatty and fried foods until the scan. Liver blood tests is something we might do if this doesn't improve next month. Let's plan a check after the scan"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 312.63,
      "end_seconds": 314.53,
      "duration_seconds": 1.9,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 316.57,
      "end_seconds": 320.54,
      "duration_seconds": 3.97,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 321.54,
      "end_seconds": 325.39,
      "duration_seconds": 3.85,
      "text": "No, uh, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 326.19,
      "end_seconds": 327.61,
      "duration_seconds": 1.42,
      "text": "All the best."
    }
  ]
}