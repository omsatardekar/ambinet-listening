{
  "schema_version": "1.0",
  "encounter_id": "01985",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.63,
      "end_seconds": 8.04,
      "duration_seconds": 7.41,
      "text": "Doctor, your next patient is here. I've done the basics, I'll read them out in a moment."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.5,
      "end_seconds": 13.52,
      "duration_seconds": 4.02,
      "text": "Thank you. Good morning, tell me what's been going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 15.25,
      "end_seconds": 18.53,
      "duration_seconds": 3.28,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.17,
      "end_seconds": 22.69,
      "duration_seconds": 2.52,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 25.78,
      "end_seconds": 29.05,
      "duration_seconds": 3.27,
      "text": "I wanted to get tiredness looked at."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.95,
      "end_seconds": 35.19,
      "duration_seconds": 3.24,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 38.02,
      "end_seconds": 41.04,
      "duration_seconds": 3.02,
      "text": "About a week, give or take."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 44.91,
      "end_seconds": 48.82,
      "duration_seconds": 3.91,
      "text": "Hm, I'd say more like two weeks."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.71,
      "end_seconds": 54.85,
      "duration_seconds": 4.14,
      "text": "Okay, so roughly one to two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 55.72,
      "end_seconds": 74.24,
      "duration_seconds": 18.52,
      "text": "Yeah, roughly. I've, I've had loose stools with blood too, for ten days. Oh, and mouth ulcers. Had that since this morning. I, I did have cramping tummy pain at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.4,
      "end_seconds": 80.63,
      "duration_seconds": 5.23,
      "text": "Have you had tiredness before, or is this the first time?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 81.81,
      "end_seconds": 90.45,
      "duration_seconds": 8.64,
      "text": "Yes, something like this happened a couple of years ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.04,
      "end_seconds": 107.89,
      "duration_seconds": 2.85,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 109.5,
      "end_seconds": 115.13,
      "duration_seconds": 5.63,
      "text": "Yes, I had a caesarean for my second baby, nine years ago."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.8,
      "end_seconds": 122.66,
      "duration_seconds": 2.86,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 123.75,
      "end_seconds": 127.19,
      "duration_seconds": 3.44,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.21,
      "end_seconds": 138.85,
      "duration_seconds": 1.64,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 139.73,
      "end_seconds": 142.36,
      "duration_seconds": 2.63,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.33,
      "end_seconds": 145.78,
      "duration_seconds": 1.45,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 149.41,
      "end_seconds": 153.52,
      "duration_seconds": 4.11,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.54,
      "end_seconds": 165.74,
      "duration_seconds": 3.2,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 167.69,
      "end_seconds": 183.73,
      "duration_seconds": 16.04,
      "text": "She is on omeprazole, 20 milligrams, once a day, I give it to her. She takes sertraline, 50 milligrams, once a day. It's propranolol, 40 milligrams, twice a day, doctor."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.19,
      "end_seconds": 187.57,
      "duration_seconds": 2.38,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 188.51,
      "end_seconds": 191.51,
      "duration_seconds": 3.0,
      "text": "Acid reflux, for about ten years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.44,
      "end_seconds": 194.14,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 194.67,
      "end_seconds": 199.36,
      "duration_seconds": 4.69,
      "text": "I have depression. I have migraines, for about a year."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.88,
      "end_seconds": 207.9,
      "duration_seconds": 8.02,
      "text": "Okay, I can see depression and migraines in your file as well. And what about joint pain or vomiting?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 209.57,
      "end_seconds": 213.57,
      "duration_seconds": 4.0,
      "text": "I haven't had joint pain or vomiting, no."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.01,
      "end_seconds": 218.22,
      "duration_seconds": 3.21,
      "text": "Did you get weight loss or fever?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 219.4,
      "end_seconds": 222.93,
      "duration_seconds": 3.53,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.83,
      "end_seconds": 228.12,
      "duration_seconds": 3.29,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 230.06,
      "end_seconds": 231.87,
      "duration_seconds": 1.81,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.32,
      "end_seconds": 238.58,
      "duration_seconds": 2.26,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 239.44,
      "end_seconds": 241.16,
      "duration_seconds": 1.72,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 242.44,
      "end_seconds": 252.57,
      "duration_seconds": 10.13,
      "text": "Here are the numbers, doctor. Respiratory rate 18, SpO2 97 percent on room air. Temp 36.5 degrees, pulse 75, blood pressure 128 over 79."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.85,
      "end_seconds": 270.98,
      "duration_seconds": 17.13,
      "text": "Okay, noted. Right, here's what I'm thinking. This is probably a flare of inflammatory bowel disease. I can't rule out an infection yet. Let me just check I've got this right. You've had tiredness, and no vomiting or fever."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 272.05,
      "end_seconds": 274.32,
      "duration_seconds": 2.27,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.12,
      "end_seconds": 305.92,
      "duration_seconds": 30.8,
      "text": "I'd like to arrange a stool test for bloody diarrhoea. I'd like to arrange blood tests for flare. That will help us see what's going on underneath and decide the next step. I'm going to put you on prednisolone, 40 milligrams, once a day, one week then reduce. You take it by mouth. It's for inflammatory bowel flare. Keep up your fluids and call the IBD nurse if you get a fever. Let's review you in two weeks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.84,
      "end_seconds": 312.26,
      "duration_seconds": 5.42,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 313.9,
      "end_seconds": 317.4,
      "duration_seconds": 3.5,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.25,
      "end_seconds": 319.58,
      "duration_seconds": 1.33,
      "text": "Goodbye for now."
    }
  ]
}