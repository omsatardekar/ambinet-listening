{
  "schema_version": "1.0",
  "encounter_id": "01693",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.54,
      "end_seconds": 4.69,
      "duration_seconds": 4.15,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.54,
      "end_seconds": 9.4,
      "duration_seconds": 3.86,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.22,
      "end_seconds": 13.16,
      "duration_seconds": 2.94,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.74,
      "end_seconds": 19.09,
      "duration_seconds": 4.35,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.6,
      "end_seconds": 30.02,
      "duration_seconds": 9.42,
      "text": "Right, honestly, it's a pulled muscle in my thigh, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.24,
      "end_seconds": 35.23,
      "duration_seconds": 1.99,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.19,
      "end_seconds": 47.23,
      "duration_seconds": 3.04,
      "text": "Right, that's it, just a little longer..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.69,
      "end_seconds": 68.16,
      "duration_seconds": 10.47,
      "text": "Okay: temp 36.7 degrees, BP is 119 over 75, SpO2 99 percent on room air, pulse 80, respiratory rate 14. Since when exactly?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.22,
      "end_seconds": 72.99,
      "duration_seconds": 3.77,
      "text": "It's been one week, I'm fairly sure."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.15,
      "end_seconds": 78.71,
      "duration_seconds": 1.56,
      "text": "Does anything help it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.54,
      "end_seconds": 84.49,
      "duration_seconds": 3.95,
      "text": "Um, I get some relief from ice."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.58,
      "end_seconds": 88.94,
      "duration_seconds": 2.36,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.29,
      "end_seconds": 102.89,
      "duration_seconds": 11.6,
      "text": "Tightness goes along with it, most of the time. The tightness? That's been for two months. Oh, you know, and a bit of bruising."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.79,
      "end_seconds": 105.75,
      "duration_seconds": 1.96,
      "text": "Any sign of numbness?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.97,
      "end_seconds": 108.47,
      "duration_seconds": 1.5,
      "text": "No. No numbness."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.96,
      "end_seconds": 114.39,
      "duration_seconds": 4.43,
      "text": "Have you noticed pop at the time, fall or swelling?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.8,
      "end_seconds": 121.18,
      "duration_seconds": 5.38,
      "text": "No, um, no pop at the time, fall or swelling."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.56,
      "end_seconds": 125.43,
      "duration_seconds": 2.87,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.93,
      "end_seconds": 127.42,
      "duration_seconds": 1.49,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.55,
      "end_seconds": 134.35,
      "duration_seconds": 3.8,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.27,
      "end_seconds": 139.27,
      "duration_seconds": 3.0,
      "text": "Oh, no, nothing with my heart."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.19,
      "end_seconds": 144.82,
      "duration_seconds": 3.63,
      "text": "Okay, has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.49,
      "end_seconds": 154.71,
      "duration_seconds": 5.22,
      "text": "Yes, high blood pressure. An underactive thyroid, for five years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.96,
      "end_seconds": 158.84,
      "duration_seconds": 2.88,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.91,
      "end_seconds": 170.27,
      "duration_seconds": 10.36,
      "text": "I've had high cholesterol, yes. My neighbour said I should get it looked at. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.99,
      "end_seconds": 179.9,
      "duration_seconds": 7.91,
      "text": "Okay, go on. Alright, high blood pressure and high cholesterol, that matches what I have here."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.93,
      "end_seconds": 198.1,
      "duration_seconds": 2.17,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.74,
      "end_seconds": 204.91,
      "duration_seconds": 5.17,
      "text": "So, um, I had my tonsils removed as a teenager."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.74,
      "end_seconds": 211.19,
      "duration_seconds": 4.45,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.45,
      "end_seconds": 225.01,
      "duration_seconds": 12.56,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.18,
      "end_seconds": 232.12,
      "duration_seconds": 2.94,
      "text": "Alright, do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.06,
      "end_seconds": 236.93,
      "duration_seconds": 3.87,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.17,
      "end_seconds": 240.18,
      "duration_seconds": 2.01,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.82,
      "end_seconds": 244.36,
      "duration_seconds": 2.54,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.15,
      "end_seconds": 248.87,
      "duration_seconds": 2.72,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.86,
      "end_seconds": 255.42,
      "duration_seconds": 4.56,
      "text": "My mother has an underactive thyroid. My son has asthma."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.48,
      "end_seconds": 258.61,
      "duration_seconds": 2.13,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.74,
      "end_seconds": 271.22,
      "duration_seconds": 7.48,
      "text": "Losartan. I take it 50 milligrams, once a day for my blood pressure."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.36,
      "end_seconds": 278.55,
      "duration_seconds": 2.19,
      "text": "When did you start it?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.07,
      "end_seconds": 285.3,
      "duration_seconds": 5.23,
      "text": "About nearly five years. Eltroxin, 100 micrograms, maybe, every morning."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.99,
      "end_seconds": 290.78,
      "duration_seconds": 4.79,
      "text": "Right, do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.86,
      "end_seconds": 302.45,
      "duration_seconds": 10.59,
      "text": "No, it's at home. I'm on ibuprofen gel, three times a day. Uh, I was on amlodipine before. I stopped taking it."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.87,
      "end_seconds": 307.67,
      "duration_seconds": 2.8,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.74,
      "end_seconds": 310.72,
      "duration_seconds": 0.98,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.39,
      "end_seconds": 314.96,
      "duration_seconds": 2.57,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.43,
      "end_seconds": 338.79,
      "duration_seconds": 7.36,
      "text": "There is mild tenderness in the back of the thigh and you can still straighten the knee fully."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.0,
      "end_seconds": 345.83,
      "duration_seconds": 1.83,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.23,
      "end_seconds": 373.54,
      "duration_seconds": 18.31,
      "text": "So, based on the history and the examination, this looks most like a mild hamstring strain. Let me just check I've got this right. You've had a pulled muscle in your thigh for one week, and no fall or numbness."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 374.32,
      "end_seconds": 375.88,
      "duration_seconds": 1.56,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 385.58,
      "end_seconds": 406.34,
      "duration_seconds": 20.76,
      "text": "Rest for a few days, ice it, and then ease back in with gentle stretching. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 407.53,
      "end_seconds": 409.84,
      "duration_seconds": 2.31,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}