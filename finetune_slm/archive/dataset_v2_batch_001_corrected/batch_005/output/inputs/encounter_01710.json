{
  "schema_version": "1.0",
  "encounter_id": "01710",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.6,
      "end_seconds": 4.75,
      "duration_seconds": 4.15,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.86,
      "end_seconds": 10.33,
      "duration_seconds": 4.47,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.42,
      "end_seconds": 18.78,
      "duration_seconds": 7.36,
      "text": "Honestly, it's loose stools with blood, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.48,
      "end_seconds": 22.74,
      "duration_seconds": 3.26,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.83,
      "end_seconds": 27.17,
      "duration_seconds": 3.34,
      "text": "A four out of ten, I suppose."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.22,
      "end_seconds": 32.34,
      "duration_seconds": 2.12,
      "text": "Any mouth ulcers as well?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.0,
      "end_seconds": 39.09,
      "duration_seconds": 3.09,
      "text": "Yes, about the same, six months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.99,
      "end_seconds": 43.18,
      "duration_seconds": 3.19,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.86,
      "end_seconds": 47.0,
      "duration_seconds": 3.14,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.05,
      "end_seconds": 54.73,
      "duration_seconds": 3.68,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.51,
      "end_seconds": 62.24,
      "duration_seconds": 6.73,
      "text": "Gliclazide. I take it 80 milligrams, twice a day for my sugar."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.91,
      "end_seconds": 69.95,
      "duration_seconds": 3.04,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.08,
      "end_seconds": 72.51,
      "duration_seconds": 1.43,
      "text": "Six months now."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.94,
      "end_seconds": 73.64,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.25,
      "end_seconds": 79.56,
      "duration_seconds": 5.31,
      "text": "Yeah, it's spironolactone, once a day for my heart."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.28,
      "end_seconds": 82.65,
      "duration_seconds": 2.37,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.32,
      "end_seconds": 84.68,
      "duration_seconds": 1.36,
      "text": "It's 25 milligrams."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.39,
      "end_seconds": 90.37,
      "duration_seconds": 4.98,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.46,
      "end_seconds": 94.16,
      "duration_seconds": 2.7,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.21,
      "end_seconds": 110.77,
      "duration_seconds": 2.56,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.42,
      "end_seconds": 117.66,
      "duration_seconds": 6.24,
      "text": "Yes, I had a caesarean for my second baby, nine years ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.58,
      "end_seconds": 121.89,
      "duration_seconds": 3.31,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.06,
      "end_seconds": 124.15,
      "duration_seconds": 1.09,
      "text": "Yes, diabetes."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.74,
      "end_seconds": 126.46,
      "duration_seconds": 1.72,
      "text": "Okay, any other things?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.35,
      "end_seconds": 129.58,
      "duration_seconds": 2.23,
      "text": "Yes, an underactive thyroid."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.12,
      "end_seconds": 132.23,
      "duration_seconds": 1.11,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.28,
      "end_seconds": 137.77,
      "duration_seconds": 3.49,
      "text": "I have heart failure, for two years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.73,
      "end_seconds": 152.39,
      "duration_seconds": 13.66,
      "text": "Right, so diabetes and an underactive thyroid are already on your record. We'll keep that in mind today. Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.26,
      "end_seconds": 166.35,
      "duration_seconds": 12.09,
      "text": "My partner and our baby. I retired from the post office two years ago. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.08,
      "end_seconds": 169.3,
      "duration_seconds": 1.22,
      "text": "How about fever?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.59,
      "end_seconds": 172.84,
      "duration_seconds": 2.25,
      "text": "I haven't noticed any fever."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.97,
      "end_seconds": 178.35,
      "duration_seconds": 4.38,
      "text": "Any vomiting, weight loss or joint pain at all?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.05,
      "end_seconds": 181.36,
      "duration_seconds": 2.31,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.19,
      "end_seconds": 185.19,
      "duration_seconds": 2.0,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.27,
      "end_seconds": 188.06,
      "duration_seconds": 1.79,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.7,
      "end_seconds": 201.15,
      "duration_seconds": 3.45,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.92,
      "end_seconds": 214.1,
      "duration_seconds": 3.18,
      "text": "Right, keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.8,
      "end_seconds": 235.19,
      "duration_seconds": 8.39,
      "text": "Okay: pulse is 86 beats a minute, temperature 36.8. And blood pressure 116 over 80, respiratory rate 16."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.8,
      "end_seconds": 238.33,
      "duration_seconds": 1.53,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.08,
      "end_seconds": 243.97,
      "duration_seconds": 3.89,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.37,
      "end_seconds": 247.7,
      "duration_seconds": 2.33,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.92,
      "end_seconds": 251.32,
      "duration_seconds": 2.4,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.2,
      "end_seconds": 267.89,
      "duration_seconds": 4.69,
      "text": "There is tenderness in the lower right tummy and no guarding."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.24,
      "end_seconds": 286.26,
      "duration_seconds": 15.02,
      "text": "You can relax now. Okay, so my impression is this: I think we're dealing with a flare of inflammatory bowel disease at this stage. It could also be an infection, so we'll keep that open."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.01,
      "end_seconds": 289.73,
      "duration_seconds": 2.72,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.79,
      "end_seconds": 307.23,
      "duration_seconds": 16.44,
      "text": "It's reasonable to be concerned, but right now a flare of inflammatory bowel disease is my leading thought, not anything worse. So, to recap quickly. You've had loose stools with blood, and no joint pain or fever."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.81,
      "end_seconds": 311.59,
      "duration_seconds": 2.78,
      "text": "That's it, you know, yes."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.39,
      "end_seconds": 334.3,
      "duration_seconds": 4.91,
      "text": "I'm sending you for a stool test because of bloody diarrhoea."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 336.09,
      "end_seconds": 339.54,
      "duration_seconds": 3.45,
      "text": "I can book that for Friday at 2 pm."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.25,
      "end_seconds": 377.3,
      "duration_seconds": 36.05,
      "text": "I'll request blood tests, it'll help with flare. I'm going to put you on prednisolone, 40 milligrams, once a day, one week then reduce. It's for inflammatory bowel flare. Keep up your fluids and call the IBD nurse if you get a fever. I'd like you to see the IBD nurse as well, and I'll write the referral. If the symptoms get worse, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 377.98,
      "end_seconds": 385.82,
      "duration_seconds": 7.84,
      "text": "Let's plan a check in two weeks. Right, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 387.33,
      "end_seconds": 390.63,
      "duration_seconds": 3.3,
      "text": "Great, thank you for your help."
    }
  ]
}