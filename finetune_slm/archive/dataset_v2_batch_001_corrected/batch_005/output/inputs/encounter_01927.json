{
  "schema_version": "1.0",
  "encounter_id": "01927",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.86,
      "end_seconds": 5.61,
      "duration_seconds": 4.75,
      "text": "right then, come on in what do you need help with?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.36,
      "end_seconds": 16.52,
      "duration_seconds": 9.16,
      "text": "uh, uh, I wanted to get a tremor in my right hand at rest looked at"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.54,
      "end_seconds": 22.52,
      "duration_seconds": 3.98,
      "text": "right, how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.55,
      "end_seconds": 25.06,
      "duration_seconds": 1.51,
      "text": "Just since yesterday."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.86,
      "end_seconds": 29.39,
      "duration_seconds": 3.53,
      "text": "So, how much trouble does it give you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.25,
      "end_seconds": 41.39,
      "duration_seconds": 10.14,
      "text": "hmm, I'd call it severe oh, and a stiff arm that's been about the same, about two weeks"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.57,
      "end_seconds": 51.22,
      "duration_seconds": 8.65,
      "text": "Have you had a tremor in your right hand at rest before, or is this the first time?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 53.2,
      "end_seconds": 62.21,
      "duration_seconds": 9.01,
      "text": "hmm, yes, something like this happened about six months ago, and it went away on its own"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 63.09,
      "end_seconds": 67.76,
      "duration_seconds": 4.67,
      "text": "Have you had any constipation, falls or loss of smell?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 69.03,
      "end_seconds": 74.74,
      "duration_seconds": 5.71,
      "text": "Yeah, I haven't had constipation, falls or loss of smell, no."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.63,
      "end_seconds": 81.28,
      "duration_seconds": 2.65,
      "text": "has there been any memory problems?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.0,
      "end_seconds": 87.66,
      "duration_seconds": 4.66,
      "text": "not at all, uh, no memory problems"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.68,
      "end_seconds": 94.02,
      "duration_seconds": 4.34,
      "text": "Right, what about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.3,
      "end_seconds": 98.12,
      "duration_seconds": 2.82,
      "text": "Oh, no, all normal there."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.93,
      "end_seconds": 102.97,
      "duration_seconds": 3.04,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 104.14,
      "end_seconds": 106.43,
      "duration_seconds": 2.29,
      "text": "no, joints are fine"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.22,
      "end_seconds": 121.44,
      "duration_seconds": 3.22,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.53,
      "end_seconds": 125.65,
      "duration_seconds": 3.12,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.41,
      "end_seconds": 128.24,
      "duration_seconds": 0.83,
      "text": "any smoking?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.07,
      "end_seconds": 134.48,
      "duration_seconds": 4.41,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.87,
      "end_seconds": 137.95,
      "duration_seconds": 2.08,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 138.54,
      "end_seconds": 142.76,
      "duration_seconds": 4.22,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.43,
      "end_seconds": 145.25,
      "duration_seconds": 1.82,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 145.87,
      "end_seconds": 150.43,
      "duration_seconds": 4.56,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.56,
      "end_seconds": 155.26,
      "duration_seconds": 1.7,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 156.24,
      "end_seconds": 160.0,
      "duration_seconds": 3.76,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.73,
      "end_seconds": 163.95,
      "duration_seconds": 3.22,
      "text": "what line of work are you in?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.74,
      "end_seconds": 171.14,
      "duration_seconds": 5.4,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.15,
      "end_seconds": 177.29,
      "duration_seconds": 4.14,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 178.41,
      "end_seconds": 187.33,
      "duration_seconds": 8.92,
      "text": "Yes, trimethoprim. I've no idea what the reaction was, only that I'm not supposed to have it."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.17,
      "end_seconds": 201.45,
      "duration_seconds": 2.28,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 203.41,
      "end_seconds": 215.53,
      "duration_seconds": 12.12,
      "text": "Simvastatin, 20 milligrams, at night. I'm hoping you can tell me something definite. Before this I was on amlodipine; that's been stopped."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.2,
      "end_seconds": 220.13,
      "duration_seconds": 2.93,
      "text": "Okay, do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 221.88,
      "end_seconds": 229.51,
      "duration_seconds": 7.63,
      "text": "I've had high cholesterol for about a year now yes, high blood pressure"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.14,
      "end_seconds": 239.23,
      "duration_seconds": 9.09,
      "text": "Yes, high blood pressure is known to us, good to have that clear. What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 240.91,
      "end_seconds": 253.47,
      "duration_seconds": 12.56,
      "text": "Let me think, I had a a bunion operation six years ago. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.38,
      "end_seconds": 256.63,
      "duration_seconds": 2.25,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.69,
      "end_seconds": 269.12,
      "duration_seconds": 2.43,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.74,
      "end_seconds": 294.57,
      "duration_seconds": 9.83,
      "text": "Okay: pressure 128 over 72, pulse is 74 beats a minute. And temp 36.7 degrees, oxygen saturation is 99 percent."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 296.46,
      "end_seconds": 298.08,
      "duration_seconds": 1.62,
      "text": "is that normal?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.46,
      "end_seconds": 302.32,
      "duration_seconds": 2.86,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 312.09,
      "end_seconds": 321.87,
      "duration_seconds": 9.78,
      "text": "Listening to the whole story, I can't pin this down yet. We're looking at possible Parkinson's disease or a drug-induced tremor."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 323.2,
      "end_seconds": 328.56,
      "duration_seconds": 5.36,
      "text": "Sorry, what was I saying, will it clear up?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 330.21,
      "end_seconds": 356.76,
      "duration_seconds": 26.55,
      "text": "I can't promise yet, but most people with possible Parkinson's disease do well once it's treated properly. A blood test is what I'd like next, for tremor. I'm referring you to the specialist and meanwhile keep active. Let's get you seen by the movement disorders clinic, I'll arrange the letter. I'd like you back after the specialist."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 357.78,
      "end_seconds": 359.91,
      "duration_seconds": 2.13,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 361.39,
      "end_seconds": 364.05,
      "duration_seconds": 2.66,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 365.04,
      "end_seconds": 368.55,
      "duration_seconds": 3.51,
      "text": "I think I understand everything thanks"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 369.99,
      "end_seconds": 371.25,
      "duration_seconds": 1.26,
      "text": "take care now"
    }
  ]
}