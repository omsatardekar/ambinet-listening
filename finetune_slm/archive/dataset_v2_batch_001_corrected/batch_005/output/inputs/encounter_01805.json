{
  "schema_version": "1.0",
  "encounter_id": "01805",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.95,
      "end_seconds": 5.59,
      "duration_seconds": 4.64,
      "text": "Hello, good to see you. Please sit. Weather's turned, hasn't it?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.83,
      "end_seconds": 11.54,
      "duration_seconds": 4.71,
      "text": "It has. I got caught in the rain walking over."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.69,
      "end_seconds": 14.6,
      "duration_seconds": 1.91,
      "text": "What's been worrying you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 16.19,
      "end_seconds": 23.14,
      "duration_seconds": 6.95,
      "text": "Um, so... neck pain after a car crash. That's why I came."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.79,
      "end_seconds": 28.32,
      "duration_seconds": 3.53,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 29.4,
      "end_seconds": 37.81,
      "duration_seconds": 8.41,
      "text": "It's, It's been two weeks, I'm fairly sure. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.07,
      "end_seconds": 41.67,
      "duration_seconds": 2.6,
      "text": "Have you tried anything for it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.76,
      "end_seconds": 45.82,
      "duration_seconds": 3.06,
      "text": "Only heat, and it's not much."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.04,
      "end_seconds": 48.38,
      "duration_seconds": 2.34,
      "text": "Sure. Is anything making it worse?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.12,
      "end_seconds": 52.27,
      "duration_seconds": 2.15,
      "text": "It's worse with turning."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.87,
      "end_seconds": 57.12,
      "duration_seconds": 3.25,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.82,
      "end_seconds": 68.14,
      "duration_seconds": 10.32,
      "text": "A headache goes along with it, most of the time. The headache? That's been for about two weeks."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.06,
      "end_seconds": 83.75,
      "duration_seconds": 5.69,
      "text": "Any numbness in the arms, weakness, loss of consciousness or chest pain?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 85.1,
      "end_seconds": 87.93,
      "duration_seconds": 2.83,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.24,
      "end_seconds": 92.15,
      "duration_seconds": 2.91,
      "text": "Right, any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 93.61,
      "end_seconds": 96.45,
      "duration_seconds": 2.84,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.34,
      "end_seconds": 100.06,
      "duration_seconds": 2.72,
      "text": "Right, has your skin been okay?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.02,
      "end_seconds": 105.48,
      "duration_seconds": 2.46,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.62,
      "end_seconds": 125.79,
      "duration_seconds": 4.17,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 126.57,
      "end_seconds": 139.87,
      "duration_seconds": 13.3,
      "text": "My husband and I live above the shop. I drink a lot of tea and snack through the day. I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.8,
      "end_seconds": 143.01,
      "duration_seconds": 1.21,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.64,
      "end_seconds": 146.83,
      "duration_seconds": 2.19,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.39,
      "end_seconds": 151.99,
      "duration_seconds": 3.6,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 153.42,
      "end_seconds": 156.27,
      "duration_seconds": 2.85,
      "text": "Ah, I've never had an allergy."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.28,
      "end_seconds": 170.72,
      "duration_seconds": 4.44,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 171.61,
      "end_seconds": 173.22,
      "duration_seconds": 1.61,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.19,
      "end_seconds": 179.21,
      "duration_seconds": 2.02,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 180.57,
      "end_seconds": 183.94,
      "duration_seconds": 3.37,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.18,
      "end_seconds": 189.61,
      "duration_seconds": 4.43,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.52,
      "end_seconds": 206.43,
      "duration_seconds": 2.91,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.86,
      "end_seconds": 229.4,
      "duration_seconds": 12.54,
      "text": "Okay: BP is 118 over 81, weight 69 kilos, pulse 69. And temperature is 36.7 degrees, height 158 centimetres, oxygen saturation is 99 percent."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 230.12,
      "end_seconds": 232.13,
      "duration_seconds": 2.01,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.8,
      "end_seconds": 235.48,
      "duration_seconds": 2.68,
      "text": "So, we'll go over that shortly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.76,
      "end_seconds": 241.44,
      "duration_seconds": 3.68,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.26,
      "end_seconds": 244.68,
      "duration_seconds": 1.42,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.52,
      "end_seconds": 267.08,
      "duration_seconds": 6.56,
      "text": "There is muscle tenderness either side of the neck and no tenderness over the bones."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.33,
      "end_seconds": 273.96,
      "duration_seconds": 2.63,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.1,
      "end_seconds": 306.65,
      "duration_seconds": 24.55,
      "text": "Okay, so my impression is this: The most likely explanation is whiplash-type neck strain. Keep your neck moving gently and avoid a collar. If you get numbness or weakness in your arms, that's the point to come in urgently. Come back if not better in two weeks. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 308.25,
      "end_seconds": 311.65,
      "duration_seconds": 3.4,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}