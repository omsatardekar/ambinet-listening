{
  "schema_version": "1.0",
  "encounter_id": "01768",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.06,
      "end_seconds": 5.09,
      "duration_seconds": 4.03,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.81,
      "end_seconds": 10.43,
      "duration_seconds": 3.62,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.4,
      "end_seconds": 22.11,
      "duration_seconds": 10.71,
      "text": "I've been passing large clots, and I wanted to get it checked. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.18,
      "end_seconds": 25.81,
      "duration_seconds": 1.63,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.75,
      "end_seconds": 30.42,
      "duration_seconds": 3.67,
      "text": "It's been going on for about a week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.55,
      "end_seconds": 34.13,
      "duration_seconds": 2.58,
      "text": "Any a racing heart as well?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.33,
      "end_seconds": 37.61,
      "duration_seconds": 2.28,
      "text": "Yes, for three days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.35,
      "end_seconds": 41.9,
      "duration_seconds": 3.55,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.15,
      "end_seconds": 53.51,
      "duration_seconds": 2.36,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.65,
      "end_seconds": 73.59,
      "duration_seconds": 4.94,
      "text": "Okay: pressure 96 over 65, pulse 109, temp 36.6 degrees."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.18,
      "end_seconds": 79.48,
      "duration_seconds": 4.3,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.78,
      "end_seconds": 83.2,
      "duration_seconds": 2.42,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.42,
      "end_seconds": 97.34,
      "duration_seconds": 5.92,
      "text": "You are pale and clammy and the womb feels soft and large."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.39,
      "end_seconds": 107.45,
      "duration_seconds": 7.06,
      "text": "Okay, that's enough for me. A few quick ones: severe pain, headache or fever?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.74,
      "end_seconds": 112.17,
      "duration_seconds": 3.43,
      "text": "Hmm, no, not a single one."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.33,
      "end_seconds": 117.23,
      "duration_seconds": 2.9,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.1,
      "end_seconds": 122.99,
      "duration_seconds": 3.89,
      "text": "No, uh, that side's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.53,
      "end_seconds": 130.69,
      "duration_seconds": 4.16,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.86,
      "end_seconds": 134.58,
      "duration_seconds": 2.72,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.5,
      "end_seconds": 152.64,
      "duration_seconds": 2.14,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.51,
      "end_seconds": 158.31,
      "duration_seconds": 3.8,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.67,
      "end_seconds": 163.37,
      "duration_seconds": 2.7,
      "text": "Okay, do you get out much?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.17,
      "end_seconds": 169.53,
      "duration_seconds": 4.36,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.25,
      "end_seconds": 173.93,
      "duration_seconds": 2.68,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.71,
      "end_seconds": 178.52,
      "duration_seconds": 2.81,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.76,
      "end_seconds": 198.0,
      "duration_seconds": 3.24,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.42,
      "end_seconds": 204.16,
      "duration_seconds": 4.74,
      "text": "Just a wisdom tooth extraction under sedation, five years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.82,
      "end_seconds": 223.78,
      "duration_seconds": 3.96,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.23,
      "end_seconds": 226.97,
      "duration_seconds": 1.74,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.65,
      "end_seconds": 230.14,
      "duration_seconds": 2.49,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.86,
      "end_seconds": 236.65,
      "duration_seconds": 1.79,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.46,
      "end_seconds": 253.92,
      "duration_seconds": 6.46,
      "text": "So, based on the history and the examination, my working impression is a postpartum haemorrhage."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.79,
      "end_seconds": 257.93,
      "duration_seconds": 2.14,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.62,
      "end_seconds": 279.78,
      "duration_seconds": 21.16,
      "text": "I can't promise yet, but most people with a postpartum haemorrhage do well once it's treated properly. I'll request an urgent scan, it'll help with bleeding. The treatment will be oxytocin, 10 units, now, single dose. That should help with postpartum bleeding."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.64,
      "end_seconds": 283.93,
      "duration_seconds": 2.29,
      "text": "Fine, I'll begin it."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.89,
      "end_seconds": 294.59,
      "duration_seconds": 9.7,
      "text": "I am rubbing the womb to help it contract, and calling the emergency team. I'd like to see you again straight away."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.12,
      "end_seconds": 298.06,
      "duration_seconds": 1.94,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.92,
      "end_seconds": 303.54,
      "duration_seconds": 3.62,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.44,
      "end_seconds": 308.32,
      "duration_seconds": 2.88,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}