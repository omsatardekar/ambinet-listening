{
  "schema_version": "1.0",
  "encounter_id": "01518",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.85,
      "end_seconds": 5.58,
      "duration_seconds": 4.73,
      "text": "Well, hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.12,
      "end_seconds": 12.21,
      "duration_seconds": 5.09,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.99,
      "end_seconds": 25.06,
      "duration_seconds": 11.07,
      "text": "Mainly a curtain coming across my vision. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.21,
      "end_seconds": 28.82,
      "duration_seconds": 2.61,
      "text": "Did it it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.97,
      "end_seconds": 34.51,
      "duration_seconds": 4.54,
      "text": "um, it's been going on for three weeks"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.87,
      "end_seconds": 40.82,
      "duration_seconds": 2.95,
      "text": "is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.21,
      "end_seconds": 44.0,
      "duration_seconds": 1.79,
      "text": "It's mild, honestly."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.41,
      "end_seconds": 47.66,
      "duration_seconds": 3.25,
      "text": "Mm-hmm. So, any blurred vision as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.79,
      "end_seconds": 51.37,
      "duration_seconds": 2.58,
      "text": "yeah. Ten days, I'd say"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.87,
      "end_seconds": 57.64,
      "duration_seconds": 2.77,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.15,
      "end_seconds": 75.58,
      "duration_seconds": 16.43,
      "text": "It's, It's moderate, honestly. Oh, and sudden new floaters. That's been about the same, ten days. I did have flashes of light at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.77,
      "end_seconds": 80.68,
      "duration_seconds": 3.91,
      "text": "any red eye, eye pain or recent injury?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.91,
      "end_seconds": 85.35,
      "duration_seconds": 3.44,
      "text": "Actually, no, none that I've noticed."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.03,
      "end_seconds": 86.9,
      "duration_seconds": 0.87,
      "text": "Any headache?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.04,
      "end_seconds": 89.66,
      "duration_seconds": 1.62,
      "text": "No headache, thankfully."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.45,
      "end_seconds": 94.65,
      "duration_seconds": 3.2,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.48,
      "end_seconds": 98.0,
      "duration_seconds": 1.52,
      "text": "nothing else aches"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.25,
      "end_seconds": 103.68,
      "duration_seconds": 4.43,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.72,
      "end_seconds": 116.83,
      "duration_seconds": 11.11,
      "text": "okay, so I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.75,
      "end_seconds": 120.47,
      "duration_seconds": 2.72,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.02,
      "end_seconds": 127.05,
      "duration_seconds": 6.03,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.78,
      "end_seconds": 132.72,
      "duration_seconds": 3.94,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.57,
      "end_seconds": 138.18,
      "duration_seconds": 3.61,
      "text": "Lots of rice, lentils and some fruit"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.52,
      "end_seconds": 161.1,
      "duration_seconds": 4.58,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.99,
      "end_seconds": 179.82,
      "duration_seconds": 16.83,
      "text": "I'm on lisinopril, 10 milligrams, once a day for my pressure. Oh, I'm on hydrocortisone cream, when needed. Mm, I used to take valsartan, but I stopped it."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.51,
      "end_seconds": 191.44,
      "duration_seconds": 2.93,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.78,
      "end_seconds": 200.42,
      "duration_seconds": 7.64,
      "text": "I have high blood pressure. I've been putting this off for weeks. I have eczema."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.97,
      "end_seconds": 206.82,
      "duration_seconds": 4.85,
      "text": "okay, I can see eczema in your file as well"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.79,
      "end_seconds": 224.52,
      "duration_seconds": 2.73,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.18,
      "end_seconds": 235.89,
      "duration_seconds": 2.71,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.32,
      "end_seconds": 255.97,
      "duration_seconds": 6.65,
      "text": "Okay: respiratory rate 17, temperature 36.8, pressure 119 over 69, heart rate 73."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.02,
      "end_seconds": 259.06,
      "duration_seconds": 2.04,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.02,
      "end_seconds": 261.02,
      "duration_seconds": 1.0,
      "text": "that's alright"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.31,
      "end_seconds": 265.46,
      "duration_seconds": 3.15,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.6,
      "end_seconds": 285.67,
      "duration_seconds": 7.07,
      "text": "the vision in the right eye is much reduced and the field is cut off at the top"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.89,
      "end_seconds": 302.22,
      "duration_seconds": 13.33,
      "text": "okay, that's enough for me right, here's what I'm thinking it points towards a possible retinal detachment needing urgent surgery i'd also keep a vitreous haemorrhage in mind"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.08,
      "end_seconds": 307.21,
      "duration_seconds": 3.13,
      "text": "do you think it's something serious?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.73,
      "end_seconds": 325.1,
      "duration_seconds": 16.37,
      "text": "I understand the worry. At the moment I'd say it's a possible retinal detachment needing urgent surgery, and we'll watch how it goes. You need to be seen by the eye surgeons today, please don't eat or drink"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.73,
      "end_seconds": 334.15,
      "duration_seconds": 7.42,
      "text": "hmm, could I get an urgent eye examination done? A friend had it"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.46,
      "end_seconds": 343.94,
      "duration_seconds": 8.48,
      "text": "I wouldn't order it today. If anything changes, we'll reconsider. Right, is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.01,
      "end_seconds": 348.18,
      "duration_seconds": 3.17,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.93,
      "end_seconds": 350.63,
      "duration_seconds": 1.7,
      "text": "Okay, look after yourself."
    }
  ]
}