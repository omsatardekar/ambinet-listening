{
  "schema_version": "1.0",
  "encounter_id": "01733",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.76,
      "end_seconds": 2.49,
      "duration_seconds": 1.73,
      "text": "Evening. Let's get started."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.17,
      "end_seconds": 6.62,
      "duration_seconds": 3.45,
      "text": "Hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 7.4,
      "end_seconds": 15.87,
      "duration_seconds": 8.47,
      "text": "Mm, um, good afternoon, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.71,
      "end_seconds": 23.61,
      "duration_seconds": 5.9,
      "text": "Please do. Extra information is always welcome. So what can I do for you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.12,
      "end_seconds": 33.43,
      "duration_seconds": 9.31,
      "text": "Mainly being extremely thirsty. There's a couple of other things, uh, but that's the main one."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.57,
      "end_seconds": 38.34,
      "duration_seconds": 3.77,
      "text": "How many days or weeks has it it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 40.36,
      "end_seconds": 44.78,
      "duration_seconds": 4.42,
      "text": "It's been going on for about two weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.45,
      "end_seconds": 48.18,
      "duration_seconds": 2.73,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.16,
      "end_seconds": 50.83,
      "duration_seconds": 1.67,
      "text": "Mild, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.75,
      "end_seconds": 56.08,
      "duration_seconds": 3.33,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.94,
      "end_seconds": 75.98,
      "duration_seconds": 18.04,
      "text": "Um, when it starts I tend to get weakness as well. About weakness, moderate, I'd say. Yeah, uh, I'd been passing huge amounts of urine, but that went away."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.92,
      "end_seconds": 87.22,
      "duration_seconds": 1.3,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.52,
      "end_seconds": 92.71,
      "duration_seconds": 4.19,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.01,
      "end_seconds": 97.42,
      "duration_seconds": 3.41,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.07,
      "end_seconds": 102.01,
      "duration_seconds": 3.94,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.42,
      "end_seconds": 105.77,
      "duration_seconds": 2.35,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.24,
      "end_seconds": 112.14,
      "duration_seconds": 4.9,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.78,
      "end_seconds": 114.82,
      "duration_seconds": 2.04,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 116.05,
      "end_seconds": 120.91,
      "duration_seconds": 4.86,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.28,
      "end_seconds": 133.6,
      "duration_seconds": 4.32,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.47,
      "end_seconds": 140.56,
      "duration_seconds": 6.09,
      "text": "Let me think, I have diabetes, for nearly five years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.31,
      "end_seconds": 143.08,
      "duration_seconds": 0.77,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.69,
      "end_seconds": 154.06,
      "duration_seconds": 9.37,
      "text": "Acid reflux, for two years. I looked a few things up online, and that that probably didn't help."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.25,
      "end_seconds": 161.47,
      "duration_seconds": 6.22,
      "text": "Okay, I can see diabetes in your file as well. Let's run through your medicines."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 162.3,
      "end_seconds": 166.49,
      "duration_seconds": 4.19,
      "text": "Glimepiride, 2 milligrams, before breakfast for my sugar"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 170.34,
      "end_seconds": 180.33,
      "duration_seconds": 9.99,
      "text": "I mean, doctor, I think the last prescription for the glimepiride was 4 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.38,
      "end_seconds": 185.55,
      "duration_seconds": 4.17,
      "text": "hm, that's different is the latest prescription anywhere near you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 187.26,
      "end_seconds": 195.91,
      "duration_seconds": 8.65,
      "text": "No, I left it at home. Lansoprazole, 30 milligrams, before breakfast for my acidity."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.12,
      "end_seconds": 199.63,
      "duration_seconds": 2.51,
      "text": "have you got any known allergies?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 201.21,
      "end_seconds": 215.43,
      "duration_seconds": 14.22,
      "text": "hmm, uh, there was some antibiotic, I was told I was allergic but I couldn't tell you what it was called or what it did"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.31,
      "end_seconds": 223.0,
      "duration_seconds": 5.69,
      "text": "Let me check a a few things. Any fever, vomiting or chest pain?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 223.72,
      "end_seconds": 229.08,
      "duration_seconds": 5.36,
      "text": "no, um, no fever, vomiting or chest pain"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.34,
      "end_seconds": 234.08,
      "duration_seconds": 3.74,
      "text": "what about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 234.61,
      "end_seconds": 236.27,
      "duration_seconds": 1.66,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.89,
      "end_seconds": 242.23,
      "duration_seconds": 3.34,
      "text": "anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 243.39,
      "end_seconds": 244.37,
      "duration_seconds": 0.98,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.79,
      "end_seconds": 249.58,
      "duration_seconds": 3.79,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.72,
      "end_seconds": 258.67,
      "duration_seconds": 1.95,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 280.02,
      "end_seconds": 294.69,
      "duration_seconds": 14.67,
      "text": "Okay: respiratory rate 16, pressure 121 over 83. And temperature 36.5, pulse 111, SpO2 99 percent on room air, weight 98 kilos, BMI works out to 37.8, height 161 centimetres."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 295.49,
      "end_seconds": 297.23,
      "duration_seconds": 1.74,
      "text": "is that normal?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.18,
      "end_seconds": 301.99,
      "duration_seconds": 3.81,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.77,
      "end_seconds": 308.89,
      "duration_seconds": 4.12,
      "text": "I'll examine you in a second, make yourself comfortable"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.03,
      "end_seconds": 312.46,
      "duration_seconds": 2.43,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 328.75,
      "end_seconds": 335.0,
      "duration_seconds": 6.25,
      "text": "you are very dry and drowsy, and your sugar reading is too high to read"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 337.19,
      "end_seconds": 339.63,
      "duration_seconds": 2.44,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 346.64,
      "end_seconds": 377.18,
      "duration_seconds": 30.54,
      "text": "So where does that leave us? I can't pin this down yet. We're looking at a a hyperosmolar diabetic emergency or sepsis. We should do an ECG for hyperglycaemic emergency. We should do urgent blood tests for hyperglycaemic emergency. You need hospital now for fluids and insulin. I'd like you to see the emergency team as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 378.41,
      "end_seconds": 387.8,
      "duration_seconds": 9.39,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 389.79,
      "end_seconds": 391.64,
      "duration_seconds": 1.85,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 392.26,
      "end_seconds": 398.23,
      "duration_seconds": 5.97,
      "text": "Come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 403.8,
      "end_seconds": 405.29,
      "duration_seconds": 1.49,
      "text": "I'll remember that"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 407.2,
      "end_seconds": 411.82,
      "duration_seconds": 4.62,
      "text": "We'll catch up straight away. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 413.79,
      "end_seconds": 417.57,
      "duration_seconds": 3.78,
      "text": "Ah, I think I understand everything. Thanks."
    }
  ]
}