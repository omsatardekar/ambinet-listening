{
  "schema_version": "1.0",
  "encounter_id": "01766",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.36,
      "end_seconds": 4.84,
      "duration_seconds": 3.48,
      "text": "Come in, have a seat by the desk."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.39,
      "end_seconds": 8.81,
      "duration_seconds": 3.42,
      "text": "Hello, thanks for fitting me in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.86,
      "end_seconds": 12.64,
      "duration_seconds": 2.78,
      "text": "Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 18.7,
      "end_seconds": 22.67,
      "duration_seconds": 3.97,
      "text": "It's a curtain coming across my vision, mostly."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.76,
      "end_seconds": 27.23,
      "duration_seconds": 2.47,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 27.81,
      "end_seconds": 30.82,
      "duration_seconds": 3.01,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.33,
      "end_seconds": 35.1,
      "duration_seconds": 3.77,
      "text": "Okay, how long has it been like this?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.36,
      "end_seconds": 39.76,
      "duration_seconds": 3.4,
      "text": "Since Friday, that's when it began."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.62,
      "end_seconds": 43.89,
      "duration_seconds": 3.27,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 45.27,
      "end_seconds": 46.81,
      "duration_seconds": 1.54,
      "text": "Moderate, I'd say."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 58.15,
      "end_seconds": 59.4,
      "duration_seconds": 1.25,
      "text": "How about headache?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 60.0,
      "end_seconds": 64.27,
      "duration_seconds": 4.27,
      "text": "Let me think, no, none, no headache."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.95,
      "end_seconds": 67.66,
      "duration_seconds": 2.71,
      "text": "Any red eye or recent injury?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 69.4,
      "end_seconds": 71.64,
      "duration_seconds": 2.24,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.89,
      "end_seconds": 76.21,
      "duration_seconds": 4.32,
      "text": "Understood. Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.28,
      "end_seconds": 79.67,
      "duration_seconds": 2.39,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.48,
      "end_seconds": 84.97,
      "duration_seconds": 3.49,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 85.8,
      "end_seconds": 89.17,
      "duration_seconds": 3.37,
      "text": "Ah, no, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.22,
      "end_seconds": 104.49,
      "duration_seconds": 1.27,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.87,
      "end_seconds": 110.05,
      "duration_seconds": 1.18,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.14,
      "end_seconds": 113.39,
      "duration_seconds": 1.25,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.37,
      "end_seconds": 119.7,
      "duration_seconds": 4.33,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.48,
      "end_seconds": 123.09,
      "duration_seconds": 1.61,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 124.25,
      "end_seconds": 128.0,
      "duration_seconds": 3.75,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.05,
      "end_seconds": 147.8,
      "duration_seconds": 6.75,
      "text": "Are there any allergies I should be aware of? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.57,
      "end_seconds": 153.2,
      "duration_seconds": 4.63,
      "text": "Okay, you know, so I've never had an allergy."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.04,
      "end_seconds": 158.62,
      "duration_seconds": 2.58,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.29,
      "end_seconds": 169.22,
      "duration_seconds": 2.93,
      "text": "Right, nearly done with the readings..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.22,
      "end_seconds": 197.84,
      "duration_seconds": 8.62,
      "text": "Okay: BP is 118 over 79, pulse is 65 beats a minute, saturation 97 percent, temp 36.6 degrees."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 198.71,
      "end_seconds": 200.19,
      "duration_seconds": 1.48,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.13,
      "end_seconds": 204.76,
      "duration_seconds": 3.63,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.63,
      "end_seconds": 210.2,
      "duration_seconds": 3.57,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.62,
      "end_seconds": 212.98,
      "duration_seconds": 1.36,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.51,
      "end_seconds": 230.7,
      "duration_seconds": 8.19,
      "text": "The vision in the right eye is much reduced and the field is cut off at the top."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.74,
      "end_seconds": 236.26,
      "duration_seconds": 2.52,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.18,
      "end_seconds": 253.87,
      "duration_seconds": 6.69,
      "text": "Okay, thinking it through, I'd lean towards a possible retinal detachment needing urgent surgery."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 255.62,
      "end_seconds": 258.74,
      "duration_seconds": 3.12,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.7,
      "end_seconds": 292.07,
      "duration_seconds": 32.37,
      "text": "I understand the worry. At the moment I'd say it's a possible retinal detachment needing urgent surgery, and we'll know more once the an urgent eye examination is back. Let's book an urgent eye examination to look into possible retinal detachment. You need to be seen by the eye surgeons today, please don't eat or drink. A short walk every day, even twenty minutes, will help more than you'd think."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.27,
      "end_seconds": 312.39,
      "duration_seconds": 19.12,
      "text": "The eye emergency service would be the right next step, I'll refer you. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. Book a review straight away. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 313.82,
      "end_seconds": 315.52,
      "duration_seconds": 1.7,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 316.22,
      "end_seconds": 317.44,
      "duration_seconds": 1.22,
      "text": "Goodbye for now."
    }
  ]
}