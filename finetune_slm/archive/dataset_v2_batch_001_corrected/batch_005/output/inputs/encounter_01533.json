{
  "schema_version": "1.0",
  "encounter_id": "01533",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.58,
      "end_seconds": 3.95,
      "duration_seconds": 3.37,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.04,
      "end_seconds": 11.12,
      "duration_seconds": 4.08,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.12,
      "end_seconds": 18.66,
      "duration_seconds": 6.54,
      "text": "I've been feeling very unwell, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.49,
      "end_seconds": 23.54,
      "duration_seconds": 3.05,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.43,
      "end_seconds": 35.73,
      "duration_seconds": 2.3,
      "text": "okay, this won't take long.."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.19,
      "end_seconds": 57.78,
      "duration_seconds": 6.59,
      "text": "Okay: temperature 36.8, blood pressure 113 over 85, saturation 96 percent, pulse 118."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.69,
      "end_seconds": 61.63,
      "duration_seconds": 1.94,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.16,
      "end_seconds": 64.31,
      "duration_seconds": 2.15,
      "text": "we'll go over that shortly"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.13,
      "end_seconds": 76.69,
      "duration_seconds": 3.56,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.39,
      "end_seconds": 80.29,
      "duration_seconds": 1.9,
      "text": "Probably three days. Yeah."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.25,
      "end_seconds": 84.59,
      "duration_seconds": 3.34,
      "text": "is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.92,
      "end_seconds": 92.46,
      "duration_seconds": 6.54,
      "text": "Moderate, I'd say. I've also had a fast heart, since last night."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.13,
      "end_seconds": 97.6,
      "duration_seconds": 3.47,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.43,
      "end_seconds": 102.2,
      "duration_seconds": 3.77,
      "text": "A five out of ten, I suppose."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.63,
      "end_seconds": 115.34,
      "duration_seconds": 3.71,
      "text": "have you had any yellow eyes or black stools?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.82,
      "end_seconds": 121.71,
      "duration_seconds": 4.89,
      "text": "I haven't had yellow eyes or black stools, no"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.57,
      "end_seconds": 127.25,
      "duration_seconds": 3.68,
      "text": "Have you had any fever or chest pain?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.31,
      "end_seconds": 132.01,
      "duration_seconds": 3.7,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.58,
      "end_seconds": 135.44,
      "duration_seconds": 2.86,
      "text": "any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.8,
      "end_seconds": 137.85,
      "duration_seconds": 1.05,
      "text": "breathing's normal"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.14,
      "end_seconds": 141.27,
      "duration_seconds": 2.13,
      "text": "has your skin been okay?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.98,
      "end_seconds": 145.11,
      "duration_seconds": 2.13,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.82,
      "end_seconds": 151.0,
      "duration_seconds": 4.18,
      "text": "let's talk a little about your daily life and habits"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.55,
      "end_seconds": 161.56,
      "duration_seconds": 10.01,
      "text": "Lots of rice, lentils and some fruit. My husband and I live above the shop. I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.69,
      "end_seconds": 167.61,
      "duration_seconds": 4.92,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.65,
      "end_seconds": 172.58,
      "duration_seconds": 2.93,
      "text": "I have eczema, for five years."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.08,
      "end_seconds": 186.32,
      "duration_seconds": 12.24,
      "text": "Okay, I can see eczema in your file as well. Which medicines do you take at the the moment? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.58,
      "end_seconds": 190.47,
      "duration_seconds": 2.89,
      "text": "I take hydrocortisone cream, when needed."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.05,
      "end_seconds": 197.31,
      "duration_seconds": 6.26,
      "text": "Yes, carry on. Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.5,
      "end_seconds": 201.39,
      "duration_seconds": 2.89,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.69,
      "end_seconds": 205.87,
      "duration_seconds": 3.18,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.31,
      "end_seconds": 216.07,
      "duration_seconds": 5.76,
      "text": "yes, um, I had an operation for a hernia, last spring"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.07,
      "end_seconds": 222.02,
      "duration_seconds": 3.95,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.04,
      "end_seconds": 224.16,
      "duration_seconds": 1.12,
      "text": "sure thing"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.75,
      "end_seconds": 227.74,
      "duration_seconds": 1.99,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.06,
      "end_seconds": 247.98,
      "duration_seconds": 3.92,
      "text": "Your upper tummy is very tender and you look dehydrated."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.23,
      "end_seconds": 263.56,
      "duration_seconds": 12.33,
      "text": "Right, good, you can sit up again. Okay, thinking it through, I'm honestly not certain yet. It could be acute pancreatitis, or it might be a perforated ulcer."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.84,
      "end_seconds": 266.52,
      "duration_seconds": 1.68,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.9,
      "end_seconds": 275.39,
      "duration_seconds": 7.49,
      "text": "Nothing I've seen today points to an emergency. It looks like acute pancreatitis, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.35,
      "end_seconds": 321.34,
      "duration_seconds": 30.99,
      "text": "We should do an abdominal scan for pancreatitis. I'd rather check than guess, and this is the quickest way to know more. We should do an amylase blood test for severe abdominal pain. You need admission for fluids and pain relief, nothing to eat for now. I think the surgical team should see you too. One warning sign to remember: the symptoms get worse. In that case don't wait. See me again straight away."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.78,
      "end_seconds": 329.35,
      "duration_seconds": 6.57,
      "text": "Let me check I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.05,
      "end_seconds": 337.51,
      "duration_seconds": 4.46,
      "text": "so, I come back straight away is that right?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.93,
      "end_seconds": 350.61,
      "duration_seconds": 7.68,
      "text": "So, yes, exactly right. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.1,
      "end_seconds": 354.29,
      "duration_seconds": 2.19,
      "text": "thank you, that's helpful"
    }
  ]
}