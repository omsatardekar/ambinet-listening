{
  "schema_version": "1.0",
  "encounter_id": "01992",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.33,
      "end_seconds": 5.71,
      "duration_seconds": 4.38,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.1,
      "end_seconds": 11.39,
      "duration_seconds": 4.29,
      "text": "Right, no problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.81,
      "end_seconds": 17.85,
      "duration_seconds": 5.04,
      "text": "Erm, uh, thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.65,
      "end_seconds": 26.71,
      "duration_seconds": 5.06,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 28.54,
      "end_seconds": 38.46,
      "duration_seconds": 9.92,
      "text": "Sorry, what was I saying, it's sudden severe breathlessness, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.68,
      "end_seconds": 44.11,
      "duration_seconds": 4.43,
      "text": "Has there been being unable to lie flat too?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.37,
      "end_seconds": 49.5,
      "duration_seconds": 4.13,
      "text": "Yeah, um, I've had that since Friday."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.28,
      "end_seconds": 52.73,
      "duration_seconds": 2.45,
      "text": "Is there something that settles it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.68,
      "end_seconds": 63.83,
      "duration_seconds": 10.15,
      "text": "It settles a little with sitting up. I was feeling very faint at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.51,
      "end_seconds": 70.91,
      "duration_seconds": 5.4,
      "text": "Have you had sudden severe breathlessness before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.75,
      "end_seconds": 80.44,
      "duration_seconds": 4.69,
      "text": "I had a similar thing last winter. It went away."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.53,
      "end_seconds": 98.98,
      "duration_seconds": 2.45,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.05,
      "end_seconds": 104.73,
      "duration_seconds": 3.68,
      "text": "Erm, no, I've never been operated on."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.83,
      "end_seconds": 110.69,
      "duration_seconds": 3.86,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 112.41,
      "end_seconds": 126.2,
      "duration_seconds": 13.79,
      "text": "Yeah, he takes naproxen, 250 milligrams, twice a day for the knee pain. He is on sertraline, once a day for my mood, I give it to him."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.29,
      "end_seconds": 129.93,
      "duration_seconds": 2.64,
      "text": "Right, how much do you take?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 131.6,
      "end_seconds": 138.48,
      "duration_seconds": 6.88,
      "text": "50 milligrams. He is on Thyronorm, 50 micrograms, every morning, I give it to him."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.16,
      "end_seconds": 157.28,
      "duration_seconds": 5.12,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.01,
      "end_seconds": 159.8,
      "duration_seconds": 1.79,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.27,
      "end_seconds": 174.96,
      "duration_seconds": 5.69,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.87,
      "end_seconds": 189.2,
      "duration_seconds": 12.33,
      "text": "I smoke roughly a pack every two days. I'm vegetarian and have been for years. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.02,
      "end_seconds": 193.42,
      "duration_seconds": 2.4,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.5,
      "end_seconds": 210.47,
      "duration_seconds": 15.97,
      "text": "Um, I have arthritis in my knees, for five years. Depression, for about a year. Yes, an underactive thyroid. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.42,
      "end_seconds": 220.46,
      "duration_seconds": 9.04,
      "text": "Okay, I can see arthritis in your knees in your file as well. Any cough, leg swelling or fever at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.78,
      "end_seconds": 225.3,
      "duration_seconds": 3.52,
      "text": "No, no cough, leg swelling or fever."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.28,
      "end_seconds": 229.33,
      "duration_seconds": 3.05,
      "text": "Right, anything different when you pass water?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.39,
      "end_seconds": 232.14,
      "duration_seconds": 1.75,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.33,
      "end_seconds": 235.83,
      "duration_seconds": 2.5,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.49,
      "end_seconds": 241.74,
      "duration_seconds": 2.25,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.64,
      "end_seconds": 247.12,
      "duration_seconds": 3.48,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.78,
      "end_seconds": 257.61,
      "duration_seconds": 2.83,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.13,
      "end_seconds": 279.89,
      "duration_seconds": 10.76,
      "text": "Okay: respiratory rate 20, pulse 102. And oxygen saturation is 93 percent, BP is 139 over 88, temperature is 37.0 degrees."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.58,
      "end_seconds": 282.93,
      "duration_seconds": 1.35,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.68,
      "end_seconds": 287.07,
      "duration_seconds": 2.39,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.62,
      "end_seconds": 293.65,
      "duration_seconds": 4.03,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.93,
      "end_seconds": 296.5,
      "duration_seconds": 1.57,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.98,
      "end_seconds": 300.27,
      "duration_seconds": 2.29,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.92,
      "end_seconds": 319.48,
      "duration_seconds": 9.56,
      "text": "Your windpipe is pushed to the right, there is no breath sound on the left, and your pressure is dropping."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.7,
      "end_seconds": 342.12,
      "duration_seconds": 20.42,
      "text": "You can relax now. Putting it all together, it points towards a collapsed lung under pressure. The reason I say that is that your story and my examination fit together. It could also be a heart attack, so we'll keep that open."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.52,
      "end_seconds": 348.37,
      "duration_seconds": 4.85,
      "text": "Oh, you know, what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.12,
      "end_seconds": 373.46,
      "duration_seconds": 23.34,
      "text": "I understand the worry. At the moment I'd say it's a collapsed lung under pressure, and we'll know more once the an urgent chest decompression is back. Let's book an urgent chest decompression to look into tension pneumothorax. I'm sending you for a chest X-ray because of chest pain."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 374.88,
      "end_seconds": 377.61,
      "duration_seconds": 2.73,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 382.33,
      "end_seconds": 394.82,
      "duration_seconds": 12.49,
      "text": "Stay sitting up, I need to relieve the pressure in your chest right now. Let's get you seen by the emergency team, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 397.64,
      "end_seconds": 398.34,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 399.27,
      "end_seconds": 403.97,
      "duration_seconds": 4.7,
      "text": "I'd like you back straight away. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 405.08,
      "end_seconds": 408.9,
      "duration_seconds": 3.82,
      "text": "Oh, no, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 410.36,
      "end_seconds": 412.74,
      "duration_seconds": 2.38,
      "text": "Right, have a good day."
    }
  ]
}