      "role": "PATIENT",
      "start_seconds": 160.09,
      "end_seconds": 172.97,
      "duration_seconds": 12.88,
      "text": "I drink a lot of tea and snack through the day. I live with my elderly mother. I retired from the post office two years ago."
    },
