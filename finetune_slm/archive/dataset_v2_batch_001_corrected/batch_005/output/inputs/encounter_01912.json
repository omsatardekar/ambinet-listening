      "start_seconds": 120.1,
      "end_seconds": 122.16,
      "duration_seconds": 2.06,
      "text": "I've had gout, yes"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.31,
      "end_seconds": 124.01,
      "duration_seconds": 0.7,
      "text": "Understood."
