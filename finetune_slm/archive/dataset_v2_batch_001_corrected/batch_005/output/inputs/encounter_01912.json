      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 32.21,
      "end_seconds": 46.84,
      "duration_seconds": 14.63,
      "text": "Moving definitely sets it off maybe a eight out of ten on a bad day there was pain in my groin, yes, but that went away"
