{
  "schema_version": "1.0",
  "encounter_id": "01984",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.92,
      "end_seconds": 5.61,
      "duration_seconds": 4.69,
      "text": "Ready for you, doctor. I'll stay in case you need anything."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.14,
      "end_seconds": 11.47,
      "duration_seconds": 5.33,
      "text": "Great. Hello, come in and sit down. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 12.44,
      "end_seconds": 21.54,
      "duration_seconds": 9.1,
      "text": "It's a stiff neck after sleeping badly, mostly. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.08,
      "end_seconds": 25.06,
      "duration_seconds": 1.98,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 26.32,
      "end_seconds": 35.17,
      "duration_seconds": 8.85,
      "text": "Uh, it's been going on for two days. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.93,
      "end_seconds": 39.06,
      "duration_seconds": 2.13,
      "text": "Is anything making it worse?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 41.05,
      "end_seconds": 44.19,
      "duration_seconds": 3.14,
      "text": "Yes, turning. That makes it worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.64,
      "end_seconds": 50.95,
      "duration_seconds": 1.31,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 51.87,
      "end_seconds": 55.51,
      "duration_seconds": 3.64,
      "text": "Right, nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.63,
      "end_seconds": 59.55,
      "duration_seconds": 2.92,
      "text": "does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 60.74,
      "end_seconds": 62.69,
      "duration_seconds": 1.95,
      "text": "my son has asthma"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.18,
      "end_seconds": 74.9,
      "duration_seconds": 5.72,
      "text": "tell me your medicines, please. These questions might sound routine, but they matter"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 76.27,
      "end_seconds": 82.43,
      "duration_seconds": 6.16,
      "text": "It's Foracort inhaler, twice a day. Paracetamol, 1 gram, when needed."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.55,
      "end_seconds": 101.94,
      "duration_seconds": 4.39,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 103.39,
      "end_seconds": 106.73,
      "duration_seconds": 3.34,
      "text": "Lots of rice, lentils and some fruit"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.67,
      "end_seconds": 113.92,
      "duration_seconds": 3.25,
      "text": "do you work outside the the home?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 114.52,
      "end_seconds": 118.42,
      "duration_seconds": 3.9,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.33,
      "end_seconds": 123.78,
      "duration_seconds": 4.45,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 125.18,
      "end_seconds": 128.93,
      "duration_seconds": 3.75,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.55,
      "end_seconds": 150.22,
      "duration_seconds": 4.67,
      "text": "So, tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 153.53,
      "end_seconds": 166.03,
      "duration_seconds": 12.5,
      "text": "yes, asthma i'd rather know what's going on than keep guessing i looked a few things up online, and that probably didn't help"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.37,
      "end_seconds": 173.49,
      "duration_seconds": 4.12,
      "text": "Alright, asthma, that matches what I have here."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.65,
      "end_seconds": 189.59,
      "duration_seconds": 2.94,
      "text": "Did you get fever or arm numbness?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 190.69,
      "end_seconds": 192.71,
      "duration_seconds": 2.02,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.05,
      "end_seconds": 200.09,
      "duration_seconds": 7.04,
      "text": "yes, carry on let me check a a few things any head injury or headache?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 201.33,
      "end_seconds": 204.64,
      "duration_seconds": 3.31,
      "text": "No, no head injury or headache."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.58,
      "end_seconds": 209.39,
      "duration_seconds": 2.81,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 211.36,
      "end_seconds": 213.38,
      "duration_seconds": 2.02,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.29,
      "end_seconds": 217.31,
      "duration_seconds": 3.02,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 219.39,
      "end_seconds": 222.37,
      "duration_seconds": 2.98,
      "text": "Well, no, skin's been fine."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 224.15,
      "end_seconds": 235.96,
      "duration_seconds": 11.81,
      "text": "Okay, so the vitals from earlier. Temperature is 36.9 degrees, SpO2 99 percent on room air. Pulse is 72 beats a minute, pressure 109 over 73."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.79,
      "end_seconds": 239.87,
      "duration_seconds": 2.08,
      "text": "Okay, good, thank you."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.74,
      "end_seconds": 245.43,
      "duration_seconds": 3.69,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.1,
      "end_seconds": 249.98,
      "duration_seconds": 2.88,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.21,
      "end_seconds": 270.33,
      "duration_seconds": 5.12,
      "text": "the neck muscles on the left are tight and the movements are full"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 271.49,
      "end_seconds": 273.03,
      "duration_seconds": 1.54,
      "text": "yes, that's fine"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.17,
      "end_seconds": 279.25,
      "duration_seconds": 3.08,
      "text": "thank you, you can get dressed"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.64,
      "end_seconds": 300.59,
      "duration_seconds": 5.95,
      "text": "having listened and examined, it fits best with a simple neck muscle strain"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 302.6,
      "end_seconds": 304.17,
      "duration_seconds": 1.57,
      "text": "is this permanent?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.2,
      "end_seconds": 316.84,
      "duration_seconds": 10.64,
      "text": "nothing I've seen today points to an emergency. It looks like a simple neck muscle strain. Heat, gentle neck rolls, and a supportive pillow"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.15,
      "end_seconds": 336.42,
      "duration_seconds": 19.27,
      "text": "yes, carry on try to get to bed and wake up at the same time each day, and keep your phone away from the bed come back if not better in two weeks have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 338.03,
      "end_seconds": 341.74,
      "duration_seconds": 3.71,
      "text": "Alright, you know, thanks, take care."
    }
  ]
}