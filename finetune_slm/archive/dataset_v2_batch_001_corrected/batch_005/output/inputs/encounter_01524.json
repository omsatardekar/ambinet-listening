{
  "schema_version": "1.0",
  "encounter_id": "01524",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.04,
      "end_seconds": 4.71,
      "duration_seconds": 3.67,
      "text": "Hello, good to to see you. Please sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.32,
      "end_seconds": 9.93,
      "duration_seconds": 3.61,
      "text": "Um, hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.42,
      "end_seconds": 13.87,
      "duration_seconds": 2.45,
      "text": "Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.23,
      "end_seconds": 20.56,
      "duration_seconds": 5.33,
      "text": "Doctor, it's ear pain. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.18,
      "end_seconds": 24.16,
      "duration_seconds": 2.98,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.39,
      "end_seconds": 29.49,
      "duration_seconds": 4.1,
      "text": "It's been about three months, I'm fairly sure."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.06,
      "end_seconds": 35.67,
      "duration_seconds": 4.61,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 40.77,
      "end_seconds": 51.36,
      "duration_seconds": 10.59,
      "text": "It happens every other day. I get some relief from paracetamol. Moderate, I'd say. I notice it more with lying down."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.39,
      "end_seconds": 54.58,
      "duration_seconds": 2.19,
      "text": "Any not eating as well?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 55.15,
      "end_seconds": 64.17,
      "duration_seconds": 9.02,
      "text": "Yeah. Ten days, I'd say. Pulling at the ear was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.67,
      "end_seconds": 70.35,
      "duration_seconds": 5.68,
      "text": "Any discharge, swelling behind the ear, hearing loss or stiff neck at all?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 73.7,
      "end_seconds": 79.48,
      "duration_seconds": 5.78,
      "text": "No, no discharge, swelling behind the ear, hearing loss or stiff neck."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.02,
      "end_seconds": 86.07,
      "duration_seconds": 5.05,
      "text": "have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.02,
      "end_seconds": 89.69,
      "duration_seconds": 2.67,
      "text": "Erm, no, nothing like that."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.3,
      "end_seconds": 98.7,
      "duration_seconds": 3.4,
      "text": "Alright, how are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.45,
      "end_seconds": 102.45,
      "duration_seconds": 2.0,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.26,
      "end_seconds": 105.48,
      "duration_seconds": 2.22,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 106.12,
      "end_seconds": 114.11,
      "duration_seconds": 7.99,
      "text": "I have an irregular heartbeat, for about ten years. I have high cholesterol, for two years."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.85,
      "end_seconds": 122.43,
      "duration_seconds": 6.58,
      "text": "okay, I can see an irregular heartbeat in your file as well. Do you smoke?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.19,
      "end_seconds": 125.75,
      "duration_seconds": 2.56,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.08,
      "end_seconds": 129.29,
      "duration_seconds": 2.21,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.55,
      "end_seconds": 134.73,
      "duration_seconds": 4.18,
      "text": "Not much, I mostly stay in these days"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.61,
      "end_seconds": 138.63,
      "duration_seconds": 3.02,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.31,
      "end_seconds": 144.29,
      "duration_seconds": 4.98,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.29,
      "end_seconds": 149.35,
      "duration_seconds": 4.06,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.13,
      "end_seconds": 153.47,
      "duration_seconds": 3.34,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.19,
      "end_seconds": 173.79,
      "duration_seconds": 2.6,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 174.33,
      "end_seconds": 177.65,
      "duration_seconds": 3.32,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.49,
      "end_seconds": 192.39,
      "duration_seconds": 3.9,
      "text": "So, what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 194.09,
      "end_seconds": 201.95,
      "duration_seconds": 7.86,
      "text": "I'm, I'm on metoprolol, 50 milligrams, twice a day. It's simvastatin, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.04,
      "end_seconds": 206.43,
      "duration_seconds": 2.39,
      "text": "and what strength is that?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.86,
      "end_seconds": 208.77,
      "duration_seconds": 0.91,
      "text": "20 milligrams."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.15,
      "end_seconds": 215.01,
      "duration_seconds": 4.86,
      "text": "do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 220.3,
      "end_seconds": 221.44,
      "duration_seconds": 1.14,
      "text": "Yes, nickel."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.07,
      "end_seconds": 240.42,
      "duration_seconds": 4.35,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.48,
      "end_seconds": 252.87,
      "duration_seconds": 2.39,
      "text": "keep your arm relaxed for me.."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.59,
      "end_seconds": 278.23,
      "duration_seconds": 6.64,
      "text": "Okay: pulse 93, saturation 95 percent, pressure 116 over 67. And temp 39.0 degrees."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 280.66,
      "end_seconds": 283.26,
      "duration_seconds": 2.6,
      "text": "So, shall I start the examination?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.44,
      "end_seconds": 285.89,
      "duration_seconds": 1.45,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 303.96,
      "end_seconds": 309.58,
      "duration_seconds": 5.62,
      "text": "the right ear drum is red and bulging, and the left is normal"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 312.71,
      "end_seconds": 335.91,
      "duration_seconds": 23.2,
      "text": "That's all I needed to check. Taking everything into account, it points towards acute middle ear infection. That's my thinking for now, and it may change as we learn more. I'll start you on amoxicillin, 250 milligrams, three times a day, five days. That's for ear infection. Give pain relief regularly and plenty to drink."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 336.19,
      "end_seconds": 344.0,
      "duration_seconds": 7.81,
      "text": "Hm, okay. One warning sign to remember: the symptoms get worse. In that case don't wait."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 344.62,
      "end_seconds": 347.85,
      "duration_seconds": 3.23,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 349.82,
      "end_seconds": 354.55,
      "duration_seconds": 4.73,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 356.63,
      "end_seconds": 358.73,
      "duration_seconds": 2.1,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 359.76,
      "end_seconds": 361.63,
      "duration_seconds": 1.87,
      "text": "Have a good day."
    }
  ]
}