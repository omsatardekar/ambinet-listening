{
  "schema_version": "1.0",
  "encounter_id": "01512",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.29,
      "end_seconds": 4.06,
      "duration_seconds": 2.77,
      "text": "Hello, come in. Mind the step."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.87,
      "end_seconds": 8.81,
      "duration_seconds": 2.94,
      "text": "Afternoon, is this seat fine?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.49,
      "end_seconds": 15.09,
      "duration_seconds": 4.6,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.98,
      "end_seconds": 21.59,
      "duration_seconds": 4.61,
      "text": "Please do. Extra information is always welcome. What's been worrying you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.55,
      "end_seconds": 29.15,
      "duration_seconds": 5.6,
      "text": "Actually, I've been dealing with chest tightness when I walk uphill."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.25,
      "end_seconds": 33.12,
      "duration_seconds": 2.87,
      "text": "Okay, are you on any regular medication?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.68,
      "end_seconds": 34.75,
      "duration_seconds": 1.07,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.95,
      "end_seconds": 39.27,
      "duration_seconds": 3.32,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.52,
      "end_seconds": 46.26,
      "duration_seconds": 2.74,
      "text": "Probably about four days. Yeah."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.51,
      "end_seconds": 56.2,
      "duration_seconds": 8.69,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.53,
      "end_seconds": 62.91,
      "duration_seconds": 5.38,
      "text": "Resting helps a bit. Cold weather definitely sets it off."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 63.62,
      "end_seconds": 67.06,
      "duration_seconds": 3.44,
      "text": "Has there been breathlessness on exertion too?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.02,
      "end_seconds": 69.24,
      "duration_seconds": 1.22,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.62,
      "end_seconds": 75.71,
      "duration_seconds": 3.09,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.58,
      "end_seconds": 78.8,
      "duration_seconds": 1.22,
      "text": "Moderate, really."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.72,
      "end_seconds": 93.06,
      "duration_seconds": 3.34,
      "text": "Right, have you noticed palpitations or fainting?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.98,
      "end_seconds": 97.05,
      "duration_seconds": 2.07,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.42,
      "end_seconds": 104.53,
      "duration_seconds": 6.11,
      "text": "Let me check a few things. Any leg swelling or pain at rest?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 106.07,
      "end_seconds": 108.31,
      "duration_seconds": 2.24,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.97,
      "end_seconds": 113.01,
      "duration_seconds": 3.04,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.08,
      "end_seconds": 117.47,
      "duration_seconds": 2.39,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.59,
      "end_seconds": 135.2,
      "duration_seconds": 2.61,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.15,
      "end_seconds": 139.09,
      "duration_seconds": 2.94,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.55,
      "end_seconds": 143.42,
      "duration_seconds": 2.87,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.62,
      "end_seconds": 146.89,
      "duration_seconds": 2.27,
      "text": "No, you know, never."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.71,
      "end_seconds": 152.14,
      "duration_seconds": 1.43,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 154.02,
      "end_seconds": 155.58,
      "duration_seconds": 1.56,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.2,
      "end_seconds": 159.52,
      "duration_seconds": 2.32,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.59,
      "end_seconds": 165.86,
      "duration_seconds": 4.27,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.6,
      "end_seconds": 168.93,
      "duration_seconds": 1.33,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.89,
      "end_seconds": 173.68,
      "duration_seconds": 3.79,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.46,
      "end_seconds": 179.48,
      "duration_seconds": 4.02,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 180.69,
      "end_seconds": 184.84,
      "duration_seconds": 4.15,
      "text": "I have high blood pressure, for five years."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.71,
      "end_seconds": 187.62,
      "duration_seconds": 0.91,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.4,
      "end_seconds": 203.7,
      "duration_seconds": 4.3,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.41,
      "end_seconds": 214.06,
      "duration_seconds": 2.65,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.42,
      "end_seconds": 233.81,
      "duration_seconds": 3.39,
      "text": "Okay: pressure 123 over 78, pulse 70."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.84,
      "end_seconds": 238.3,
      "duration_seconds": 3.46,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.44,
      "end_seconds": 240.67,
      "duration_seconds": 1.23,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.16,
      "end_seconds": 257.7,
      "duration_seconds": 4.54,
      "text": "Your heart sounds are normal and the pulses are all present."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.24,
      "end_seconds": 272.98,
      "duration_seconds": 12.74,
      "text": "That's all I needed to check. Putting it all together, it's hard to say. Stable angina is one possibility and gastro-oesophageal reflux another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 273.86,
      "end_seconds": 275.95,
      "duration_seconds": 2.09,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 280.47,
      "end_seconds": 298.16,
      "duration_seconds": 17.69,
      "text": "It's reasonable to be concerned, but right now stable angina is my leading thought, not anything worse. I want an exercise test done, that's for exertional chest tightness. Let's get an ECG, for chest tightness. Let's get a cholesterol test, for heart risk."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 299.92,
      "end_seconds": 302.15,
      "duration_seconds": 2.23,
      "text": "Is that done today?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.9,
      "end_seconds": 335.74,
      "duration_seconds": 32.84,
      "text": "The treatment will be glyceryl trinitrate spray, 400 micrograms, when needed, long term. That should help with chest tightness. Stop and rest when the tightness starts, and use the spray if it does not ease in a few minutes. I'd like you to see the chest pain clinic as well, and I'll write the referral. Please don't wait if the symptoms get worse. That's when to be seen urgently. Come back after the tests."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 337.25,
      "end_seconds": 342.07,
      "duration_seconds": 4.82,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 346.13,
      "end_seconds": 349.57,
      "duration_seconds": 3.44,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 351.42,
      "end_seconds": 352.62,
      "duration_seconds": 1.2,
      "text": "Take care now."
    }
  ]
}