{
  "schema_version": "1.0",
  "encounter_id": "01971",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.83,
      "end_seconds": 4.23,
      "duration_seconds": 3.4,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.62,
      "end_seconds": 12.22,
      "duration_seconds": 3.6,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.81,
      "end_seconds": 19.99,
      "duration_seconds": 6.18,
      "text": "Hmm, morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.42,
      "end_seconds": 25.13,
      "duration_seconds": 3.71,
      "text": "Alright, please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.84,
      "end_seconds": 30.59,
      "duration_seconds": 3.75,
      "text": "It's, It's drinking most nights, mostly."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.4,
      "end_seconds": 32.57,
      "duration_seconds": 1.17,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.34,
      "end_seconds": 36.6,
      "duration_seconds": 3.26,
      "text": "I've had it for four weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.49,
      "end_seconds": 41.19,
      "duration_seconds": 2.7,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.53,
      "end_seconds": 48.11,
      "duration_seconds": 5.58,
      "text": "I'd give it a seven, you know, out of ten."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.02,
      "end_seconds": 51.45,
      "duration_seconds": 2.43,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.42,
      "end_seconds": 56.61,
      "duration_seconds": 3.19,
      "text": "It usually comes with shaky hands."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.69,
      "end_seconds": 62.77,
      "duration_seconds": 4.08,
      "text": "A few quick ones: black stools, yellow eyes or confusion?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.55,
      "end_seconds": 66.92,
      "duration_seconds": 3.37,
      "text": "Yeah, no, nothing to report there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.28,
      "end_seconds": 74.94,
      "duration_seconds": 3.66,
      "text": "Have you had vomiting blood, by any chance?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.78,
      "end_seconds": 78.79,
      "duration_seconds": 3.01,
      "text": "No, none, no vomiting blood."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.59,
      "end_seconds": 83.49,
      "duration_seconds": 2.9,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.44,
      "end_seconds": 87.01,
      "duration_seconds": 1.57,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.67,
      "end_seconds": 91.12,
      "duration_seconds": 3.45,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 92.92,
      "end_seconds": 98.59,
      "duration_seconds": 5.67,
      "text": "It's allopurinol, 100 milligrams, once a day for the gout, doctor."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.6,
      "end_seconds": 103.18,
      "duration_seconds": 3.58,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.92,
      "end_seconds": 105.13,
      "duration_seconds": 1.21,
      "text": "Yes, gout."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.88,
      "end_seconds": 110.8,
      "duration_seconds": 4.92,
      "text": "Alright, gout, that matches what I have here. Do you smoke?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.49,
      "end_seconds": 115.92,
      "duration_seconds": 4.43,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.94,
      "end_seconds": 118.77,
      "duration_seconds": 1.83,
      "text": "Okay, what about alcohol?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.34,
      "end_seconds": 122.18,
      "duration_seconds": 1.84,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.92,
      "end_seconds": 124.87,
      "duration_seconds": 1.95,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.71,
      "end_seconds": 129.49,
      "duration_seconds": 3.78,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.3,
      "end_seconds": 131.99,
      "duration_seconds": 1.69,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.51,
      "end_seconds": 136.45,
      "duration_seconds": 3.94,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.02,
      "end_seconds": 140.94,
      "duration_seconds": 2.92,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.91,
      "end_seconds": 150.25,
      "duration_seconds": 4.34,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.06,
      "end_seconds": 153.13,
      "duration_seconds": 2.07,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.8,
      "end_seconds": 169.48,
      "duration_seconds": 14.68,
      "text": "Sorry, you know, what was I saying, yes, I had a meniscus repair on my knee, four years ago. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.08,
      "end_seconds": 189.44,
      "duration_seconds": 3.36,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.31,
      "end_seconds": 194.75,
      "duration_seconds": 3.44,
      "text": "Ah, my aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.86,
      "end_seconds": 212.21,
      "duration_seconds": 3.35,
      "text": "Right, time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.19,
      "end_seconds": 227.93,
      "duration_seconds": 2.74,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.77,
      "end_seconds": 252.38,
      "duration_seconds": 6.61,
      "text": "Okay: SpO2 97 percent on room air, blood pressure 126 over 69, pulse 78."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.25,
      "end_seconds": 260.37,
      "duration_seconds": 5.12,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.23,
      "end_seconds": 262.93,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.21,
      "end_seconds": 265.39,
      "duration_seconds": 1.18,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.78,
      "end_seconds": 280.84,
      "duration_seconds": 7.06,
      "text": "Your liver edge is felt slightly below the ribs and there is a fine tremor."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.07,
      "end_seconds": 299.8,
      "duration_seconds": 16.73,
      "text": "Please sit back down. Putting it all together, this is probably harmful alcohol use with liver strain. That's my thinking for now, and it may change as we learn more. Fatty liver is still possible."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.95,
      "end_seconds": 320.61,
      "duration_seconds": 11.66,
      "text": "We'll begin with thiamine, 100 milligrams, three times a day, long term. That should help with alcohol-related nutritional deficiency. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.6,
      "end_seconds": 327.84,
      "duration_seconds": 5.24,
      "text": "Okay, um, that makes sense. Thanks for explaining."
    }
  ]
}