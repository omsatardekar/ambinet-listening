{
  "schema_version": "1.0",
  "encounter_id": "01631",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.25,
      "end_seconds": 6.65,
      "duration_seconds": 5.4,
      "text": "Hi, sit anywhere you like. Is it your first time here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.71,
      "end_seconds": 14.25,
      "duration_seconds": 5.54,
      "text": "So, no, I came last year for something else."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.57,
      "end_seconds": 18.43,
      "duration_seconds": 2.86,
      "text": "Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.73,
      "end_seconds": 34.59,
      "duration_seconds": 14.86,
      "text": "I'm here because of pain under my right ribs after fatty meals. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.94,
      "end_seconds": 39.8,
      "duration_seconds": 3.86,
      "text": "Okay, how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 40.71,
      "end_seconds": 45.0,
      "duration_seconds": 4.29,
      "text": "It's been one week, I'm fairly sure."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.95,
      "end_seconds": 52.01,
      "duration_seconds": 5.06,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 52.73,
      "end_seconds": 87.58,
      "duration_seconds": 34.85,
      "text": "I mean, you know, mostly moderate. Yes, fatty meals. That makes it worse. I kept putting it off, which I know isn't sensible. I've been putting this off for weeks. And there's pain going to my right shoulder as well, you know, about four days now. Mm, you know, with pain going to my right shoulder, mostly severe."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.38,
      "end_seconds": 96.9,
      "duration_seconds": 7.52,
      "text": "Have you had pain under your right ribs after fatty meals before, or is this the first time?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.73,
      "end_seconds": 102.93,
      "duration_seconds": 5.2,
      "text": "A bit, last year. It settled by itself back then."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.6,
      "end_seconds": 105.61,
      "duration_seconds": 2.01,
      "text": "Have you had any fever?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.46,
      "end_seconds": 111.94,
      "duration_seconds": 4.48,
      "text": "I mean, not that I've noticed, no fever."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.16,
      "end_seconds": 117.39,
      "duration_seconds": 4.23,
      "text": "Any yellow eyes, pale stools or dark urine at all?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.4,
      "end_seconds": 122.73,
      "duration_seconds": 3.33,
      "text": "Right, no, none that I've noticed."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.6,
      "end_seconds": 126.01,
      "duration_seconds": 2.41,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 127.59,
      "end_seconds": 131.02,
      "duration_seconds": 3.43,
      "text": "I mean, no, skin's been fine."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.57,
      "end_seconds": 153.2,
      "duration_seconds": 3.63,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.09,
      "end_seconds": 159.12,
      "duration_seconds": 4.03,
      "text": "Asthalin inhaler, when needed for my asthma."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.93,
      "end_seconds": 176.84,
      "duration_seconds": 4.91,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 177.49,
      "end_seconds": 190.62,
      "duration_seconds": 13.13,
      "text": "I smoke roughly a pack every two days. I'm a bus driver, so I sit for long hours. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.79,
      "end_seconds": 196.7,
      "duration_seconds": 4.91,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 198.29,
      "end_seconds": 201.91,
      "duration_seconds": 3.62,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.25,
      "end_seconds": 205.31,
      "duration_seconds": 2.06,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.1,
      "end_seconds": 211.58,
      "duration_seconds": 4.48,
      "text": "Yes, asthma. I've had acid reflux, yes."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.59,
      "end_seconds": 221.88,
      "duration_seconds": 9.29,
      "text": "Right, right. Right, so asthma is already on your record. We'll keep that in mind today. Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.61,
      "end_seconds": 236.09,
      "duration_seconds": 2.48,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.85,
      "end_seconds": 257.83,
      "duration_seconds": 8.98,
      "text": "Okay: temp 36.6 degrees, oxygen saturation is 97 percent, pressure 120 over 76, pulse is 79 beats a minute."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 259.81,
      "end_seconds": 261.42,
      "duration_seconds": 1.61,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 263.32,
      "end_seconds": 266.27,
      "duration_seconds": 2.95,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.04,
      "end_seconds": 270.7,
      "duration_seconds": 2.66,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.74,
      "end_seconds": 274.55,
      "duration_seconds": 2.81,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.03,
      "end_seconds": 299.19,
      "duration_seconds": 6.16,
      "text": "It is tender under the right ribs and you stop breathing in when I press."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 303.71,
      "end_seconds": 305.64,
      "duration_seconds": 1.93,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 314.09,
      "end_seconds": 338.72,
      "duration_seconds": 24.63,
      "text": "Putting it all together, I'd lean towards gallstone-related pain. I can't rule out a stomach ulcer yet. I'm going to order an ultrasound of the abdomen, for biliary pain. Please come and see me after the scan. Can you tell me the plan back in your own words, so I know I've explained it clearly?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 341.26,
      "end_seconds": 346.32,
      "duration_seconds": 5.06,
      "text": "So, I come back after the scan. Is that right?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 346.97,
      "end_seconds": 351.22,
      "duration_seconds": 4.25,
      "text": "Yes, exactly right. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 355.69,
      "end_seconds": 360.22,
      "duration_seconds": 4.53,
      "text": "Great, you know, thank you for your help."
    }
  ]
}