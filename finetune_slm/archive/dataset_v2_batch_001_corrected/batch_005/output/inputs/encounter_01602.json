{
  "schema_version": "1.0",
  "encounter_id": "01602",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.14,
      "end_seconds": 9.67,
      "duration_seconds": 8.53,
      "text": "Right, uh, hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 12.26,
      "end_seconds": 16.66,
      "duration_seconds": 4.4,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.39,
      "end_seconds": 24.6,
      "duration_seconds": 7.21,
      "text": "Doctor, it's shaky spells in the afternoon. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.4,
      "end_seconds": 28.16,
      "duration_seconds": 2.76,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.27,
      "end_seconds": 39.85,
      "duration_seconds": 10.58,
      "text": "I'm on Glycomet, 500 milligrams, twice a day for my sugar. I'm on Seretide inhaler, twice a day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.25,
      "end_seconds": 44.48,
      "duration_seconds": 3.23,
      "text": "Since when have you been taking it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.23,
      "end_seconds": 51.94,
      "duration_seconds": 5.71,
      "text": "For nearly five years. Glucose tablets, 4 tablets, when needed."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.81,
      "end_seconds": 64.14,
      "duration_seconds": 2.33,
      "text": "Okay, when did this begin?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.19,
      "end_seconds": 73.25,
      "duration_seconds": 4.06,
      "text": "Since last Tuesday, that's when it began."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.06,
      "end_seconds": 80.06,
      "duration_seconds": 5.0,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.12,
      "end_seconds": 93.38,
      "duration_seconds": 12.26,
      "text": "Missed lunch definitely sets it off. Sweets helps a bit. Mostly mild. I've, I've been sweating too, for three weeks. About sweating, I'd say mild."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.34,
      "end_seconds": 97.28,
      "duration_seconds": 2.94,
      "text": "Have you had any seizure or vomiting?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.42,
      "end_seconds": 102.33,
      "duration_seconds": 3.91,
      "text": "I haven't had seizure or vomiting, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.08,
      "end_seconds": 107.15,
      "duration_seconds": 4.07,
      "text": "Have you noticed loss of consciousness or chest pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.14,
      "end_seconds": 114.83,
      "duration_seconds": 2.69,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.96,
      "end_seconds": 119.35,
      "duration_seconds": 3.39,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.77,
      "end_seconds": 124.05,
      "duration_seconds": 3.28,
      "text": "Ah, nothing on the skin, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.02,
      "end_seconds": 129.19,
      "duration_seconds": 3.17,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.04,
      "end_seconds": 131.5,
      "duration_seconds": 1.46,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.53,
      "end_seconds": 137.33,
      "duration_seconds": 4.8,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.89,
      "end_seconds": 140.35,
      "duration_seconds": 1.46,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.21,
      "end_seconds": 145.36,
      "duration_seconds": 3.15,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.37,
      "end_seconds": 151.77,
      "duration_seconds": 4.4,
      "text": "I had my tonsils removed as a teenager."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.12,
      "end_seconds": 157.23,
      "duration_seconds": 4.11,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.18,
      "end_seconds": 160.3,
      "duration_seconds": 2.12,
      "text": "I've had diabetes, yes."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.95,
      "end_seconds": 163.78,
      "duration_seconds": 1.83,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.06,
      "end_seconds": 173.17,
      "duration_seconds": 8.11,
      "text": "Asthma, for two years. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.13,
      "end_seconds": 178.61,
      "duration_seconds": 1.48,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.56,
      "end_seconds": 188.51,
      "duration_seconds": 7.95,
      "text": "Yes, diabetes is known to us, good to have that clear. A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.41,
      "end_seconds": 199.38,
      "duration_seconds": 9.97,
      "text": "I look after my grandchildren most days. I grab fast food at lunch most days. My partner and our baby."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.83,
      "end_seconds": 220.07,
      "duration_seconds": 3.24,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.06,
      "end_seconds": 233.68,
      "duration_seconds": 2.62,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.86,
      "end_seconds": 261.92,
      "duration_seconds": 9.06,
      "text": "Okay: pulse 112, temperature 36.9, SpO2 97 percent on room air. And BP is 136 over 79, respiratory rate 19."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.61,
      "end_seconds": 267.86,
      "duration_seconds": 4.25,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.85,
      "end_seconds": 270.77,
      "duration_seconds": 0.92,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.71,
      "end_seconds": 273.46,
      "duration_seconds": 1.75,
      "text": "Alright, look straight ahead."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.22,
      "end_seconds": 300.13,
      "duration_seconds": 7.91,
      "text": "Your sugar reading in clinic is on the low side and your pulse is a little fast."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.8,
      "end_seconds": 308.23,
      "duration_seconds": 2.43,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.21,
      "end_seconds": 334.22,
      "duration_seconds": 14.01,
      "text": "So where does that leave us? I don't have a clear answer today: recurrent low blood sugar on insulin is possible, and so is a dose that is too high."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.38,
      "end_seconds": 338.6,
      "duration_seconds": 3.22,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.76,
      "end_seconds": 354.14,
      "duration_seconds": 14.38,
      "text": "Nothing I've seen today points to an emergency. It looks like recurrent low blood sugar on insulin, but I'd like to confirm. I'm going to order a download of the glucose meter, for hypoglycaemia."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 354.8,
      "end_seconds": 357.21,
      "duration_seconds": 2.41,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.84,
      "end_seconds": 386.17,
      "duration_seconds": 27.33,
      "text": "I'll request an HbA1c, it'll help with diabetes review. I'd rather check than guess, and this is the quickest way to know more. Let's use insulin glargine, 16 units, once a day at bedtime, long term. That should help with diabetes. The pharmacy will go through the details again when you pick it up. Always carry sugar and eat something before exercise. Come back in two weeks."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 387.57,
      "end_seconds": 390.31,
      "duration_seconds": 2.74,
      "text": "I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 392.32,
      "end_seconds": 395.25,
      "duration_seconds": 2.93,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 399.22,
      "end_seconds": 402.94,
      "duration_seconds": 3.72,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}