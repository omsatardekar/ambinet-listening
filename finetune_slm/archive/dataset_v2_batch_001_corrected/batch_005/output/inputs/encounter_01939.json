  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.75,
      "end_seconds": 4.72,
      "duration_seconds": 3.97,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.37,
      "end_seconds": 10.85,
      "duration_seconds": 4.48,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.01,
      "end_seconds": 23.38,
      "duration_seconds": 8.37,
      "text": "so, I've been feeling low most days, doctor my family kept telling me to get it checked"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.1,
      "end_seconds": 26.94,
      "duration_seconds": 2.84,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.7,
      "end_seconds": 32.28,
      "duration_seconds": 2.58,
      "text": "for two days I'd say"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.84,
      "end_seconds": 37.66,
      "duration_seconds": 3.82,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.25,
      "end_seconds": 40.96,
      "duration_seconds": 1.71,
      "text": "it's moderate, honestly"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.57,
      "end_seconds": 44.27,
      "duration_seconds": 2.7,
      "text": "does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.47,
      "end_seconds": 55.66,
      "duration_seconds": 10.19,
      "text": "When it starts I tend to get no energy as well. With no energy, about a four out of ten."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.72,
      "end_seconds": 61.06,
      "duration_seconds": 3.34,
      "text": "what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.51,
      "end_seconds": 70.59,
      "duration_seconds": 4.08,
      "text": "I take tamsulosin, 0.4 milligrams, at night."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.68,
      "end_seconds": 74.14,
      "duration_seconds": 2.46,
      "text": "have you got any known allergies?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.61,
      "end_seconds": 79.47,
      "duration_seconds": 3.86,
      "text": "I mean no I've never reacted to anything."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.64,
      "end_seconds": 85.12,
      "duration_seconds": 4.48,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.66,
      "end_seconds": 87.55,
      "duration_seconds": 1.89,
      "text": "my brother has epilepsy"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.47,
      "end_seconds": 102.49,
      "duration_seconds": 4.02,
      "text": "tell me about any past illnesses or ongoing conditions"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.95,
      "end_seconds": 106.55,
      "duration_seconds": 2.6,
      "text": "I have an enlarged prostate"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.93,
      "end_seconds": 122.15,
      "duration_seconds": 1.22,
      "text": "and your job?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.87,
      "end_seconds": 127.73,
      "duration_seconds": 3.86,
      "text": "I work in accounts at a hospital"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.42,
      "end_seconds": 131.25,
      "duration_seconds": 2.83,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.57,
      "end_seconds": 135.86,
      "duration_seconds": 3.29,
      "text": "I do a yoga class on Thursdays"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.82,
      "end_seconds": 141.63,
      "duration_seconds": 4.81,
      "text": "And what about drinking more thoughts of harming myself or hearing voices?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.24,
      "end_seconds": 149.11,
      "duration_seconds": 5.87,
      "text": "no no drinking more thoughts of harming myself or hearing voices"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.88,
      "end_seconds": 155.21,
      "duration_seconds": 4.33,
      "text": "anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.23,
      "end_seconds": 159.82,
      "duration_seconds": 2.59,
      "text": "no, nothing with my heart"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.87,
      "end_seconds": 164.12,
      "duration_seconds": 3.25,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.43,
      "end_seconds": 174.68,
      "duration_seconds": 3.25,
      "text": "So nearly done with the the readings..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.9,
      "end_seconds": 200.09,
      "duration_seconds": 11.19,
      "text": "Okay: respiratory rate 17 SpO2 97 percent on room air blood pressure 124 over 78 temp 37.0 degrees pulse is 81 beats a minute."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.68,
      "end_seconds": 202.74,
      "duration_seconds": 2.06,
      "text": "is that alright doctor?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.91,
      "end_seconds": 210.46,
      "duration_seconds": 2.55,
      "text": "that's fine, I'll explain it soon"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.81,
      "end_seconds": 216.57,
      "duration_seconds": 3.76,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.49,
      "end_seconds": 219.82,
      "duration_seconds": 1.33,
      "text": "does that hurt?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.62,
      "end_seconds": 244.26,
      "duration_seconds": 5.64,
      "text": "you are tearful and speaking slowly, but you are following everything well"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.3,
      "end_seconds": 252.84,
      "duration_seconds": 1.54,
      "text": "yes that's fine"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.73,
      "end_seconds": 260.58,
      "duration_seconds": 2.85,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.89,
      "end_seconds": 282.2,
      "duration_seconds": 8.31,
      "text": "So where does that leave us? I think we're dealing with a moderate depressive episode at this stage."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.9,
      "end_seconds": 286.16,
      "duration_seconds": 2.26,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.99,
      "end_seconds": 304.34,
      "duration_seconds": 16.35,
      "text": "I can't promise yet, but most people with a moderate depressive episode do well once it's treated properly. I'll request a blood count, it'll help with tiredness. I'd rather check than guess, and this is the quickest way to know more"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.16,
      "end_seconds": 309.08,
      "duration_seconds": 2.92,
      "text": "When would that that take place?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.1,
      "end_seconds": 315.48,
      "duration_seconds": 4.38,
      "text": "A thyroid test is what I'd like next for low mood."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.3,
      "end_seconds": 317.35,
      "duration_seconds": 1.05,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.12,
      "end_seconds": 328.9,
      "duration_seconds": 10.78,
      "text": "we'll begin with sertraline 50 milligrams once a day in the morning long term you take it by mouth that's for low mood"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.1,
      "end_seconds": 333.53,
      "duration_seconds": 3.43,
      "text": "Alright, I'll pick it up today."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.7,
      "end_seconds": 360.18,
      "duration_seconds": 25.48,
      "text": "Try a short walk each day and keep a regular sleep routine. A short walk every day, even twenty minutes, will help more than you'd think. I'd like you to see the talking therapy service as well, and I'll write the referral. If you have thoughts of harming yourself, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 361.09,
      "end_seconds": 362.02,
      "duration_seconds": 0.93,
      "text": "I understand"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.48,
      "end_seconds": 370.42,
      "duration_seconds": 6.94,
      "text": "Let's plan a check in two weeks. Right, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 371.6,
      "end_seconds": 375.2,
      "duration_seconds": 3.6,
      "text": "right I'll do that. Thank you doctor"
    }
  ]
