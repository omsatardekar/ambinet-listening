{
  "schema_version": "1.0",
  "encounter_id": "01765",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.93,
      "end_seconds": 7.06,
      "duration_seconds": 6.13,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.27,
      "end_seconds": 12.13,
      "duration_seconds": 3.86,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.47,
      "end_seconds": 16.07,
      "duration_seconds": 2.6,
      "text": "I've been feeling very weak."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.76,
      "end_seconds": 19.68,
      "duration_seconds": 2.92,
      "text": "Okay, I'll do your observations first."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.17,
      "end_seconds": 30.95,
      "duration_seconds": 2.78,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.92,
      "end_seconds": 56.03,
      "duration_seconds": 8.11,
      "text": "Okay: SpO2 99 percent on room air, temperature 36.9, pressure 96 over 56, heart rate 101."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.47,
      "end_seconds": 74.33,
      "duration_seconds": 2.86,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.72,
      "end_seconds": 90.12,
      "duration_seconds": 10.4,
      "text": "Two weeks, I think... sorry, three weeks, I got that wrong. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.58,
      "end_seconds": 96.26,
      "duration_seconds": 5.68,
      "text": "Mm, okay. Alright, and what about blood in the stool, confusion or fever?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.14,
      "end_seconds": 100.8,
      "duration_seconds": 3.66,
      "text": "I mean, no, none that I've noticed."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.7,
      "end_seconds": 105.72,
      "duration_seconds": 3.02,
      "text": "So, is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.52,
      "end_seconds": 107.91,
      "duration_seconds": 1.39,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.95,
      "end_seconds": 112.52,
      "duration_seconds": 2.57,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.91,
      "end_seconds": 114.99,
      "duration_seconds": 1.08,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.92,
      "end_seconds": 136.49,
      "duration_seconds": 3.57,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.07,
      "end_seconds": 143.65,
      "duration_seconds": 5.58,
      "text": "I take oral rehydration salts, 1 sachet, after each loose stool."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.89,
      "end_seconds": 158.28,
      "duration_seconds": 4.39,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.48,
      "end_seconds": 163.2,
      "duration_seconds": 3.72,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.59,
      "end_seconds": 167.85,
      "duration_seconds": 3.26,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.24,
      "end_seconds": 172.83,
      "duration_seconds": 3.59,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.72,
      "end_seconds": 175.01,
      "duration_seconds": 1.29,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.95,
      "end_seconds": 179.33,
      "duration_seconds": 3.38,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.99,
      "end_seconds": 183.16,
      "duration_seconds": 3.17,
      "text": "So, have you got any known allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.66,
      "end_seconds": 190.14,
      "duration_seconds": 3.48,
      "text": "Yes, cat fur, it gives me wheezing."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.36,
      "end_seconds": 195.38,
      "duration_seconds": 4.02,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.04,
      "end_seconds": 200.44,
      "duration_seconds": 3.4,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.58,
      "end_seconds": 203.9,
      "duration_seconds": 2.32,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.08,
      "end_seconds": 207.19,
      "duration_seconds": 2.11,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.72,
      "end_seconds": 230.45,
      "duration_seconds": 6.73,
      "text": "Your mouth is dry, your skin is slack, and your blood pressure drops when you stand."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.31,
      "end_seconds": 246.39,
      "duration_seconds": 10.08,
      "text": "Thank you, you can get dressed. From what you've told me and what I found, my working impression is dehydration from gastroenteritis."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.92,
      "end_seconds": 249.78,
      "duration_seconds": 1.86,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.81,
      "end_seconds": 258.87,
      "duration_seconds": 8.06,
      "text": "It's reasonable to be concerned, but right now dehydration from gastroenteritis is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.64,
      "end_seconds": 280.26,
      "duration_seconds": 3.62,
      "text": "I'd like to arrange blood tests for dehydration."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.12,
      "end_seconds": 282.53,
      "duration_seconds": 1.41,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.84,
      "end_seconds": 304.04,
      "duration_seconds": 20.2,
      "text": "Sip fluids little and often and hold your water tablet until you are eating again. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. Come back in two days. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.12,
      "end_seconds": 306.63,
      "duration_seconds": 1.51,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.63,
      "end_seconds": 309.01,
      "duration_seconds": 1.38,
      "text": "Take care now."
    }
  ]
}