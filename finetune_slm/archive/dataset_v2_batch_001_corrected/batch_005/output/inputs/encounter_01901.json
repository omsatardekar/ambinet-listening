{
  "schema_version": "1.0",
  "encounter_id": "01901",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.37,
      "end_seconds": 5.3,
      "duration_seconds": 3.93,
      "text": "hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.81,
      "end_seconds": 14.94,
      "duration_seconds": 4.13,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.74,
      "end_seconds": 23.35,
      "duration_seconds": 6.61,
      "text": "actually, I've been passing large clots, and I wanted to get it checked"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.51,
      "end_seconds": 27.28,
      "duration_seconds": 2.77,
      "text": "how long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.47,
      "end_seconds": 36.52,
      "duration_seconds": 8.05,
      "text": "It's, It's been going on for six months. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.98,
      "end_seconds": 41.06,
      "duration_seconds": 3.08,
      "text": "right, any severe pain, headache or fever?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.62,
      "end_seconds": 45.55,
      "duration_seconds": 2.93,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.84,
      "end_seconds": 48.14,
      "duration_seconds": 1.3,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.69,
      "end_seconds": 51.95,
      "duration_seconds": 2.26,
      "text": "no weakness or anything"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.39,
      "end_seconds": 67.9,
      "duration_seconds": 2.51,
      "text": "Right, any regular medication at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.14,
      "end_seconds": 70.26,
      "duration_seconds": 1.12,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.78,
      "end_seconds": 74.7,
      "duration_seconds": 3.92,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.75,
      "end_seconds": 80.16,
      "duration_seconds": 3.41,
      "text": "Erm, my aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.99,
      "end_seconds": 84.44,
      "duration_seconds": 2.45,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.25,
      "end_seconds": 86.31,
      "duration_seconds": 1.06,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.78,
      "end_seconds": 92.39,
      "duration_seconds": 4.61,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.98,
      "end_seconds": 96.47,
      "duration_seconds": 3.49,
      "text": "no, nothing as far as I know"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.55,
      "end_seconds": 109.4,
      "duration_seconds": 4.85,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.75,
      "end_seconds": 113.79,
      "duration_seconds": 3.04,
      "text": "no, I've always been fairly healthy"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.76,
      "end_seconds": 117.55,
      "duration_seconds": 1.79,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.93,
      "end_seconds": 121.84,
      "duration_seconds": 2.91,
      "text": "I only drink at family occasions"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.59,
      "end_seconds": 128.39,
      "duration_seconds": 2.8,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.14,
      "end_seconds": 132.66,
      "duration_seconds": 3.52,
      "text": "I do a yoga class on Thursdays"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.91,
      "end_seconds": 135.52,
      "duration_seconds": 1.61,
      "text": "who lives with you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.59,
      "end_seconds": 142.18,
      "duration_seconds": 2.59,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.57,
      "end_seconds": 146.17,
      "duration_seconds": 2.6,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.15,
      "end_seconds": 158.71,
      "duration_seconds": 2.56,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.82,
      "end_seconds": 178.95,
      "duration_seconds": 8.13,
      "text": "Okay: temperature is 36.4 degrees, pressure 96 over 64, saturation 97 percent. And pulse 111."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.02,
      "end_seconds": 184.18,
      "duration_seconds": 4.16,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.23,
      "end_seconds": 186.55,
      "duration_seconds": 1.32,
      "text": "breathe out slowly"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.79,
      "end_seconds": 205.52,
      "duration_seconds": 4.73,
      "text": "you are pale and clammy and the womb feels soft and large"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.14,
      "end_seconds": 210.91,
      "duration_seconds": 1.77,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.16,
      "end_seconds": 238.43,
      "duration_seconds": 9.27,
      "text": "Having listened and examined, I can't pin this down yet. We're looking at a postpartum haemorrhage or retained tissue."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.09,
      "end_seconds": 243.01,
      "duration_seconds": 3.92,
      "text": "I'm scared it's something bad is it?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.39,
      "end_seconds": 253.84,
      "duration_seconds": 7.45,
      "text": "it's reasonable to be concerned, but right now a postpartum haemorrhage is my leading thought, not anything worse"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.69,
      "end_seconds": 296.34,
      "duration_seconds": 33.65,
      "text": "I want urgent blood tests done, that's for haemorrhage. Let's use oxytocin, 10 units, now, single dose. That should help with postpartum bleeding. It's a commonly used medicine and most people tolerate it well. I am rubbing the womb to help it contract, and calling the emergency team. If it hasn't settled in a month, we'd think about an urgent scan, but not now. Come back straight away."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.11,
      "end_seconds": 298.91,
      "duration_seconds": 1.8,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.2,
      "end_seconds": 305.22,
      "duration_seconds": 5.02,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.88,
      "end_seconds": 308.86,
      "duration_seconds": 2.98,
      "text": "great, thank you for your help"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.24,
      "end_seconds": 311.53,
      "duration_seconds": 1.29,
      "text": "look after yourself"
    }
  ]
}