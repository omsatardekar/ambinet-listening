{
  "schema_version": "1.0",
  "encounter_id": "01847",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.11,
      "end_seconds": 4.47,
      "duration_seconds": 3.36,
      "text": "Hello, sorry about the delay, do sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.62,
      "end_seconds": 11.44,
      "duration_seconds": 2.82,
      "text": "Good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.57,
      "end_seconds": 16.68,
      "duration_seconds": 4.11,
      "text": "Alright, what would you like to start with today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 17.46,
      "end_seconds": 23.02,
      "duration_seconds": 5.56,
      "text": "It's a barking cough. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.86,
      "end_seconds": 28.04,
      "duration_seconds": 3.18,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 29.77,
      "end_seconds": 33.94,
      "duration_seconds": 4.17,
      "text": "It's been about a week, I'm fairly sure."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.9,
      "end_seconds": 45.06,
      "duration_seconds": 9.16,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 45.58,
      "end_seconds": 61.24,
      "duration_seconds": 15.66,
      "text": "Only steamy bathroom, and it's not much. I'd call it severe. I thought it would sort itself out, but it hasn't. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 63.03,
      "end_seconds": 65.47,
      "duration_seconds": 2.44,
      "text": "Any a runny nose as well?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.65,
      "end_seconds": 75.3,
      "duration_seconds": 8.65,
      "text": "Yeah, I've had that since this morning. I've also had a hoarse voice, for two months."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.25,
      "end_seconds": 81.71,
      "duration_seconds": 5.46,
      "text": "Have you had a barking cough before, or is this the first time?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.0,
      "end_seconds": 89.52,
      "duration_seconds": 6.52,
      "text": "Yes, something like this happened last year, and it went away on its own."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.21,
      "end_seconds": 94.06,
      "duration_seconds": 2.85,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.17,
      "end_seconds": 106.22,
      "duration_seconds": 2.05,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.29,
      "end_seconds": 127.56,
      "duration_seconds": 8.27,
      "text": "Okay: temp 37.0 degrees, BP is 115 over 76, heart rate 72, saturation 99 percent, respiratory rate 15."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.42,
      "end_seconds": 130.6,
      "duration_seconds": 2.18,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.8,
      "end_seconds": 135.81,
      "duration_seconds": 4.01,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.92,
      "end_seconds": 140.71,
      "duration_seconds": 3.79,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.07,
      "end_seconds": 143.1,
      "duration_seconds": 1.03,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.55,
      "end_seconds": 146.59,
      "duration_seconds": 2.04,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.06,
      "end_seconds": 170.32,
      "duration_seconds": 6.26,
      "text": "He is playful, breathing comfortably at rest, and I can't hear any noisy breathing now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.88,
      "end_seconds": 177.99,
      "duration_seconds": 4.11,
      "text": "You can relax now. Any drooling or blue lips?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 179.04,
      "end_seconds": 183.2,
      "duration_seconds": 4.16,
      "text": "No, you know, none of those at all."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.9,
      "end_seconds": 189.1,
      "duration_seconds": 4.2,
      "text": "Have you noticed noisy breathing when resting or difficulty swallowing?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 191.16,
      "end_seconds": 194.53,
      "duration_seconds": 3.37,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.07,
      "end_seconds": 200.04,
      "duration_seconds": 4.97,
      "text": "Okay, any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 201.14,
      "end_seconds": 204.52,
      "duration_seconds": 3.38,
      "text": "Uh, no, nothing like that."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.51,
      "end_seconds": 207.87,
      "duration_seconds": 2.36,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 208.8,
      "end_seconds": 212.19,
      "duration_seconds": 3.39,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.76,
      "end_seconds": 215.71,
      "duration_seconds": 2.95,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 216.89,
      "end_seconds": 222.08,
      "duration_seconds": 5.19,
      "text": "My grandmother had dementia. My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.71,
      "end_seconds": 236.14,
      "duration_seconds": 1.43,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 236.71,
      "end_seconds": 238.25,
      "duration_seconds": 1.54,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.26,
      "end_seconds": 242.69,
      "duration_seconds": 3.43,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 244.47,
      "end_seconds": 247.85,
      "duration_seconds": 3.38,
      "text": "I've got gout. Migraines, for five years."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.65,
      "end_seconds": 263.81,
      "duration_seconds": 4.16,
      "text": "So, do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 265.4,
      "end_seconds": 282.35,
      "duration_seconds": 16.95,
      "text": "I take febuxostat, 80 milligrams, once a day for the gout. I do miss it now and then, to be fair. Propranolol. I take it 40 milligrams, maybe, twice a day."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.4,
      "end_seconds": 288.66,
      "duration_seconds": 4.26,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 290.21,
      "end_seconds": 292.46,
      "duration_seconds": 2.25,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 300.62,
      "end_seconds": 304.33,
      "duration_seconds": 3.71,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 305.62,
      "end_seconds": 309.53,
      "duration_seconds": 3.91,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 311.6,
      "end_seconds": 312.8,
      "duration_seconds": 1.2,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 314.34,
      "end_seconds": 317.55,
      "duration_seconds": 3.21,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.37,
      "end_seconds": 321.15,
      "duration_seconds": 1.78,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 322.96,
      "end_seconds": 324.64,
      "duration_seconds": 1.68,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 326.54,
      "end_seconds": 329.6,
      "duration_seconds": 3.06,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 330.15,
      "end_seconds": 334.32,
      "duration_seconds": 4.17,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 334.86,
      "end_seconds": 336.12,
      "duration_seconds": 1.26,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 337.55,
      "end_seconds": 340.4,
      "duration_seconds": 2.85,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 342.22,
      "end_seconds": 350.71,
      "duration_seconds": 8.49,
      "text": "So where does that leave us? The most likely explanation is mild croup. A viral cold is still possible."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 352.13,
      "end_seconds": 355.38,
      "duration_seconds": 3.25,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 357.7,
      "end_seconds": 373.59,
      "duration_seconds": 15.89,
      "text": "Nothing I've seen today points to an emergency. It looks like mild croup. Let me just check I've got this right. You've had a barking cough for about a week, severe, and no drooling or noisy breathing when resting."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 377.89,
      "end_seconds": 379.7,
      "duration_seconds": 1.81,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 381.22,
      "end_seconds": 402.11,
      "duration_seconds": 20.89,
      "text": "I'd like you to take dexamethasone, 0.15 mg per kg, once, single dose. You take it by mouth. That's for croup. Keep him calm, sit him upright, and give fluids. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 403.3,
      "end_seconds": 404.74,
      "duration_seconds": 1.44,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 405.89,
      "end_seconds": 415.59,
      "duration_seconds": 9.7,
      "text": "Please don't wait if he makes a noisy sound when resting or struggles to breathe. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 420.43,
      "end_seconds": 423.35,
      "duration_seconds": 2.92,
      "text": "I know what to watch for."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 424.96,
      "end_seconds": 429.21,
      "duration_seconds": 4.25,
      "text": "See me again if no better in two days."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 430.2,
      "end_seconds": 435.4,
      "duration_seconds": 5.2,
      "text": "I'll book your follow-up at the front desk on your way out."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 437.34,
      "end_seconds": 441.53,
      "duration_seconds": 4.19,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 442.56,
      "end_seconds": 446.65,
      "duration_seconds": 4.09,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}