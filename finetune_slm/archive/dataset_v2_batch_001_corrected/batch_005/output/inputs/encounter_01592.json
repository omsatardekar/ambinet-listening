{
  "schema_version": "1.0",
  "encounter_id": "01592",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.39,
      "end_seconds": 4.99,
      "duration_seconds": 3.6,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.03,
      "end_seconds": 11.57,
      "duration_seconds": 4.54,
      "text": "Alright, not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.11,
      "end_seconds": 18.2,
      "duration_seconds": 6.09,
      "text": "It's flashes of light. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.26,
      "end_seconds": 23.43,
      "duration_seconds": 3.17,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.86,
      "end_seconds": 30.86,
      "duration_seconds": 6.0,
      "text": "About three months, I think... sorry, six months, I got that wrong."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.56,
      "end_seconds": 34.39,
      "duration_seconds": 2.83,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.61,
      "end_seconds": 39.25,
      "duration_seconds": 3.64,
      "text": "Um, it usually comes with blurred vision."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.15,
      "end_seconds": 43.28,
      "duration_seconds": 3.13,
      "text": "Did you get eye pain or recent injury?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.2,
      "end_seconds": 48.49,
      "duration_seconds": 3.29,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.02,
      "end_seconds": 56.55,
      "duration_seconds": 3.53,
      "text": "So, have you had headache, by any chance?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.78,
      "end_seconds": 60.21,
      "duration_seconds": 2.43,
      "text": "Not at all, no headache."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.53,
      "end_seconds": 64.25,
      "duration_seconds": 3.72,
      "text": "I follow. How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.77,
      "end_seconds": 66.4,
      "duration_seconds": 1.63,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.38,
      "end_seconds": 70.51,
      "duration_seconds": 3.13,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.43,
      "end_seconds": 74.8,
      "duration_seconds": 2.37,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.01,
      "end_seconds": 96.46,
      "duration_seconds": 5.45,
      "text": "Alright, are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.01,
      "end_seconds": 100.71,
      "duration_seconds": 3.7,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.13,
      "end_seconds": 117.56,
      "duration_seconds": 4.43,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.38,
      "end_seconds": 122.35,
      "duration_seconds": 2.97,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.65,
      "end_seconds": 142.59,
      "duration_seconds": 2.94,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.06,
      "end_seconds": 147.22,
      "duration_seconds": 3.16,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.45,
      "end_seconds": 149.73,
      "duration_seconds": 1.28,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.79,
      "end_seconds": 154.38,
      "duration_seconds": 2.59,
      "text": "No surgery, uh, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.42,
      "end_seconds": 159.26,
      "duration_seconds": 2.84,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.08,
      "end_seconds": 163.83,
      "duration_seconds": 3.75,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.81,
      "end_seconds": 166.86,
      "duration_seconds": 2.05,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.79,
      "end_seconds": 171.41,
      "duration_seconds": 3.62,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.15,
      "end_seconds": 175.69,
      "duration_seconds": 3.54,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.35,
      "end_seconds": 185.36,
      "duration_seconds": 4.01,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 187.02,
      "end_seconds": 193.82,
      "duration_seconds": 6.8,
      "text": "Doctor, I've got the readings for you. Pulse is 84 beats a minute, BP is 121 over 70."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.9,
      "end_seconds": 196.86,
      "duration_seconds": 0.96,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.42,
      "end_seconds": 200.5,
      "duration_seconds": 2.08,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.6,
      "end_seconds": 203.83,
      "duration_seconds": 2.23,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.65,
      "end_seconds": 221.64,
      "duration_seconds": 6.99,
      "text": "The vision in the right eye is much reduced and the field is cut off at the top."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.7,
      "end_seconds": 226.44,
      "duration_seconds": 1.74,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.02,
      "end_seconds": 257.74,
      "duration_seconds": 14.72,
      "text": "Right, here's what I'm thinking. I think we're dealing with a possible retinal detachment needing urgent surgery at this stage. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.66,
      "end_seconds": 261.99,
      "duration_seconds": 2.33,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.49,
      "end_seconds": 300.11,
      "duration_seconds": 37.62,
      "text": "Nothing I've seen today points to an emergency. It looks like a possible retinal detachment needing urgent surgery, but I'd like to confirm. I think an urgent eye examination makes sense here, for possible retinal detachment. You need to be seen by the eye surgeons today, please don't eat or drink. I'd like you to see the eye emergency service as well, and I'll write the referral. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.74,
      "end_seconds": 304.33,
      "duration_seconds": 3.59,
      "text": "Okay, so alright, thanks, take care."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.1,
      "end_seconds": 307.48,
      "duration_seconds": 1.38,
      "text": "See you soon."
    }
  ]
}