{
  "schema_version": "1.0",
  "encounter_id": "01704",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.97,
      "end_seconds": 5.34,
      "duration_seconds": 4.37,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.36,
      "end_seconds": 10.01,
      "duration_seconds": 3.65,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.98,
      "end_seconds": 15.35,
      "duration_seconds": 4.37,
      "text": "So, I've been feeling tired after the birth, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.66,
      "end_seconds": 20.0,
      "duration_seconds": 3.34,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.08,
      "end_seconds": 28.06,
      "duration_seconds": 5.98,
      "text": "I'd say six months. Actually, no, closer to about three months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.16,
      "end_seconds": 31.83,
      "duration_seconds": 2.67,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.69,
      "end_seconds": 41.44,
      "duration_seconds": 2.75,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.29,
      "end_seconds": 69.01,
      "duration_seconds": 9.72,
      "text": "Okay: BP is 121 over 79, temperature is 36.8 degrees, SpO2 97 percent on room air, pulse is 75 beats a minute."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.76,
      "end_seconds": 72.46,
      "duration_seconds": 1.7,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.0,
      "end_seconds": 76.41,
      "duration_seconds": 2.41,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.49,
      "end_seconds": 79.7,
      "duration_seconds": 2.21,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.25,
      "end_seconds": 84.18,
      "duration_seconds": 2.93,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.49,
      "end_seconds": 102.43,
      "duration_seconds": 5.94,
      "text": "The womb has gone down well and the stitches are healing, with no redness."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.9,
      "end_seconds": 120.45,
      "duration_seconds": 1.55,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.61,
      "end_seconds": 131.68,
      "duration_seconds": 9.07,
      "text": "Thank you, you can get dressed. Did you get fever, leg swelling or thoughts of harming the baby?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.28,
      "end_seconds": 139.39,
      "duration_seconds": 6.11,
      "text": "I haven't had fever, leg swelling or thoughts of harming the baby, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.15,
      "end_seconds": 144.39,
      "duration_seconds": 4.24,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.34,
      "end_seconds": 148.04,
      "duration_seconds": 1.7,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.36,
      "end_seconds": 152.23,
      "duration_seconds": 2.87,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.4,
      "end_seconds": 155.62,
      "duration_seconds": 2.22,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.08,
      "end_seconds": 174.37,
      "duration_seconds": 4.29,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.92,
      "end_seconds": 194.22,
      "duration_seconds": 19.3,
      "text": "I used to drink heavily but I stopped four years ago. I have about eight cigarettes in a day. I'm a hairdresser, on my feet all day. Lots of rice, lentils and some fruit. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.92,
      "end_seconds": 215.83,
      "duration_seconds": 3.91,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.42,
      "end_seconds": 220.15,
      "duration_seconds": 2.73,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.22,
      "end_seconds": 224.9,
      "duration_seconds": 2.68,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.11,
      "end_seconds": 227.79,
      "duration_seconds": 1.68,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.36,
      "end_seconds": 245.29,
      "duration_seconds": 3.93,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.68,
      "end_seconds": 250.06,
      "duration_seconds": 3.38,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.79,
      "end_seconds": 265.85,
      "duration_seconds": 15.06,
      "text": "From what you've told me and what I found, the most likely explanation is a normal postnatal recovery. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.94,
      "end_seconds": 271.0,
      "duration_seconds": 3.06,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.08,
      "end_seconds": 301.34,
      "duration_seconds": 28.26,
      "text": "I can't promise yet, but most people with a normal postnatal recovery do well once it's treated properly. We should do a blood count for postnatal tiredness. Rest when the baby sleeps and ask for help; contraception can be discussed at six weeks. Do get help quickly if the symptoms get worse. I'd like you back in four weeks. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.27,
      "end_seconds": 306.74,
      "duration_seconds": 3.47,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}