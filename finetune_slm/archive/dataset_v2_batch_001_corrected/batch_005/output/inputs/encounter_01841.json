{
  "schema_version": "1.0",
  "encounter_id": "01841",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.53,
      "end_seconds": 5.67,
      "duration_seconds": 5.14,
      "text": "Doctor, we're ready in room two, I've already taken the observations."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.27,
      "end_seconds": 10.75,
      "duration_seconds": 4.48,
      "text": "Good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 11.95,
      "end_seconds": 21.69,
      "duration_seconds": 9.74,
      "text": "Mainly a productive cough with rusty phlegm. There's a couple of other things, um, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.26,
      "end_seconds": 24.93,
      "duration_seconds": 1.67,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 26.19,
      "end_seconds": 38.03,
      "duration_seconds": 11.84,
      "text": "Ever since... since this morning, really. I kept putting it off, which I know isn't sensible. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.87,
      "end_seconds": 41.36,
      "duration_seconds": 2.49,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 42.69,
      "end_seconds": 53.8,
      "duration_seconds": 11.11,
      "text": "Maybe a eight out of ten on a bad day. I've also had pain on the right when I breathe in."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.02,
      "end_seconds": 57.27,
      "duration_seconds": 2.25,
      "text": "Have you had a fever?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 59.13,
      "end_seconds": 65.13,
      "duration_seconds": 6.0,
      "text": "Mm, yes. I've been feeling short of breath too, for ten days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.73,
      "end_seconds": 72.85,
      "duration_seconds": 6.12,
      "text": "So, a few quick ones: recent travel, leg swelling or coughing up blood?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 74.55,
      "end_seconds": 77.4,
      "duration_seconds": 2.85,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.2,
      "end_seconds": 81.22,
      "duration_seconds": 3.02,
      "text": "Have you had confusion, by any chance?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 81.98,
      "end_seconds": 83.44,
      "duration_seconds": 1.46,
      "text": "No. No confusion."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.39,
      "end_seconds": 87.9,
      "duration_seconds": 2.51,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 89.74,
      "end_seconds": 92.6,
      "duration_seconds": 2.86,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.11,
      "end_seconds": 97.22,
      "duration_seconds": 3.11,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 98.38,
      "end_seconds": 100.07,
      "duration_seconds": 1.69,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.98,
      "end_seconds": 108.42,
      "duration_seconds": 3.44,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 109.38,
      "end_seconds": 116.15,
      "duration_seconds": 6.77,
      "text": "I take something called omep... omeprazole, 20 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.87,
      "end_seconds": 122.27,
      "duration_seconds": 4.4,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 123.29,
      "end_seconds": 134.55,
      "duration_seconds": 11.26,
      "text": "Not with me. I'll bring it next time. Sitagliptin. I take it 100 milligrams, once a day for my sugar."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 135.32,
      "end_seconds": 140.33,
      "duration_seconds": 5.01,
      "text": "Doctor, our chart from the last visit lists it as 50 milligrams."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.2,
      "end_seconds": 146.56,
      "duration_seconds": 4.36,
      "text": "Hm. Do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 147.27,
      "end_seconds": 159.15,
      "duration_seconds": 11.88,
      "text": "Not with me. I'll bring it next time. I take hydrocortisone cream, when needed. I do miss it now and then, to be fair."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.17,
      "end_seconds": 163.83,
      "duration_seconds": 2.66,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 164.71,
      "end_seconds": 170.56,
      "duration_seconds": 5.85,
      "text": "I've got acid reflux. Diabetes, for nearly five years. Yes, eczema."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.89,
      "end_seconds": 183.66,
      "duration_seconds": 11.77,
      "text": "Okay, I can see acid reflux and eczema in your file as well. So, tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 185.66,
      "end_seconds": 196.5,
      "duration_seconds": 10.84,
      "text": "I gave up cigarettes last spring. Nothing, I'm teetotal. I look after my grandchildren most days. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.67,
      "end_seconds": 216.01,
      "duration_seconds": 2.34,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 221.81,
      "end_seconds": 227.93,
      "duration_seconds": 6.12,
      "text": "Yes, I had a caesarean for my second baby, nine years ago."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 242.2,
      "end_seconds": 255.24,
      "duration_seconds": 13.04,
      "text": "Here are the numbers, doctor. Oxygen saturation is 96 percent, temperature is 38.8 degrees, pulse is 97 beats a minute, respiratory rate 21, pressure 126 over 74."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.12,
      "end_seconds": 257.11,
      "duration_seconds": 0.99,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.65,
      "end_seconds": 263.47,
      "duration_seconds": 4.82,
      "text": "So, I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.56,
      "end_seconds": 266.83,
      "duration_seconds": 2.27,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.57,
      "end_seconds": 290.79,
      "duration_seconds": 6.22,
      "text": "There are crackles at the right base and the breathing is a bit fast."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.93,
      "end_seconds": 304.7,
      "duration_seconds": 10.77,
      "text": "That's all I needed to check. Having listened and examined, it points towards community-acquired pneumonia. It could also be acute bronchitis, so we'll keep that open."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.36,
      "end_seconds": 323.74,
      "duration_seconds": 7.38,
      "text": "I'm going to order blood tests, for pneumonia. I'm going to order a chest X-ray, for possible pneumonia."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 324.8,
      "end_seconds": 325.86,
      "duration_seconds": 1.06,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.91,
      "end_seconds": 343.94,
      "duration_seconds": 16.03,
      "text": "I'm going to put you on amoxicillin, 500 milligrams, three times a day, five days. That's for chest infection. I'll put all of this in writing so you don't have to remember it."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 344.57,
      "end_seconds": 346.37,
      "duration_seconds": 1.8,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.54,
      "end_seconds": 361.77,
      "duration_seconds": 14.23,
      "text": "Rest, drink plenty, and come back if you are not improving in two days. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 363.58,
      "end_seconds": 365.15,
      "duration_seconds": 1.57,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.21,
      "end_seconds": 372.51,
      "duration_seconds": 5.3,
      "text": "We'll catch up in one week. Alright, does all of that make sense?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 374.57,
      "end_seconds": 379.18,
      "duration_seconds": 4.61,
      "text": "Right, uh, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.69,
      "end_seconds": 380.99,
      "duration_seconds": 1.3,
      "text": "Take care now."
    }
  ]
}