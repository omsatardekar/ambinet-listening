{
  "schema_version": "1.0",
  "encounter_id": "01750",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.7,
      "end_seconds": 3.92,
      "duration_seconds": 3.22,
      "text": "Hello, good to see you. Please sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.44,
      "end_seconds": 8.17,
      "duration_seconds": 3.73,
      "text": "Good morning, um, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.85,
      "end_seconds": 11.01,
      "duration_seconds": 2.16,
      "text": "What's the main thing today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.86,
      "end_seconds": 13.98,
      "duration_seconds": 2.12,
      "text": "It's night sweats, mostly."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.24,
      "end_seconds": 18.59,
      "duration_seconds": 3.35,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 20.59,
      "end_seconds": 23.76,
      "duration_seconds": 3.17,
      "text": "It's been going on for three weeks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.01,
      "end_seconds": 28.45,
      "duration_seconds": 3.44,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 29.18,
      "end_seconds": 30.92,
      "duration_seconds": 1.74,
      "text": "Moderate, I'd say."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.64,
      "end_seconds": 36.49,
      "duration_seconds": 3.85,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.33,
      "end_seconds": 47.76,
      "duration_seconds": 2.43,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.71,
      "end_seconds": 73.73,
      "duration_seconds": 8.02,
      "text": "Okay: pulse 86, temperature is 36.7 degrees. And blood pressure 110 over 73, respiratory rate 17."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.18,
      "end_seconds": 81.94,
      "duration_seconds": 5.76,
      "text": "Okay, I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.22,
      "end_seconds": 84.49,
      "duration_seconds": 1.27,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.66,
      "end_seconds": 98.13,
      "duration_seconds": 4.47,
      "text": "There are some crackles at the top of the right lung."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.33,
      "end_seconds": 108.88,
      "duration_seconds": 6.55,
      "text": "Okay, that's enough for me. Have you had any coughing up blood, HIV or fever?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.4,
      "end_seconds": 111.93,
      "duration_seconds": 2.53,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.77,
      "end_seconds": 117.68,
      "duration_seconds": 4.91,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.42,
      "end_seconds": 121.09,
      "duration_seconds": 1.67,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.04,
      "end_seconds": 125.27,
      "duration_seconds": 2.23,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.98,
      "end_seconds": 130.22,
      "duration_seconds": 4.24,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.93,
      "end_seconds": 133.34,
      "duration_seconds": 1.41,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.44,
      "end_seconds": 138.27,
      "duration_seconds": 3.83,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.75,
      "end_seconds": 141.66,
      "duration_seconds": 1.91,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.45,
      "end_seconds": 146.03,
      "duration_seconds": 3.58,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.74,
      "end_seconds": 152.47,
      "duration_seconds": 3.73,
      "text": "Alright, has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 154.47,
      "end_seconds": 156.31,
      "duration_seconds": 1.84,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.34,
      "end_seconds": 176.13,
      "duration_seconds": 3.79,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.87,
      "end_seconds": 181.43,
      "duration_seconds": 4.56,
      "text": "No, um, nothing as far as I know."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 183.4,
      "end_seconds": 187.63,
      "duration_seconds": 4.23,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.37,
      "end_seconds": 194.71,
      "duration_seconds": 2.34,
      "text": "I've had COPD, yes."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.07,
      "end_seconds": 196.77,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.73,
      "end_seconds": 208.89,
      "duration_seconds": 2.16,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 209.98,
      "end_seconds": 213.63,
      "duration_seconds": 3.65,
      "text": "Tiotropium inhaler. I take it once a day."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.22,
      "end_seconds": 236.71,
      "duration_seconds": 11.49,
      "text": "Having listened and examined, the most likely explanation is possible tuberculosis. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 238.39,
      "end_seconds": 242.3,
      "duration_seconds": 3.91,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.0,
      "end_seconds": 253.89,
      "duration_seconds": 9.89,
      "text": "I understand the worry. At the moment I'd say it's possible tuberculosis, and we'll know more once the three sputum samples is back."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.47,
      "end_seconds": 282.42,
      "duration_seconds": 9.95,
      "text": "I'll request three sputum samples, it'll help with possible tuberculosis. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 283.78,
      "end_seconds": 287.25,
      "duration_seconds": 3.47,
      "text": "I can book that for Wednesday at 9 am."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 289.2,
      "end_seconds": 291.24,
      "duration_seconds": 2.04,
      "text": "Okay, I'll be there."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 292.62,
      "end_seconds": 312.09,
      "duration_seconds": 19.47,
      "text": "I'll request a blood test, it'll help with TB contact. Wear a mask in public and cover your mouth when you cough until the results are back. Let's plan a check after the tests. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 313.3,
      "end_seconds": 316.14,
      "duration_seconds": 2.84,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 317.0,
      "end_seconds": 318.81,
      "duration_seconds": 1.81,
      "text": "Have a good day."
    }
  ]
}