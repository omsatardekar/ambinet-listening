{
  "schema_version": "1.0",
  "encounter_id": "01528",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.23,
      "end_seconds": 4.56,
      "duration_seconds": 3.33,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.35,
      "end_seconds": 10.41,
      "duration_seconds": 4.06,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.59,
      "end_seconds": 19.49,
      "duration_seconds": 7.9,
      "text": "I've been dealing with bad breath. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.7,
      "end_seconds": 23.95,
      "duration_seconds": 3.25,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.54,
      "end_seconds": 30.52,
      "duration_seconds": 4.98,
      "text": "Let me think, for about a month, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.69,
      "end_seconds": 34.68,
      "duration_seconds": 2.99,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.87,
      "end_seconds": 41.1,
      "duration_seconds": 5.23,
      "text": "Maybe a seven out of ten on a bad day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.88,
      "end_seconds": 44.81,
      "duration_seconds": 2.93,
      "text": "Alright, any other symptoms with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.41,
      "end_seconds": 51.69,
      "duration_seconds": 5.28,
      "text": "A fever goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.6,
      "end_seconds": 58.27,
      "duration_seconds": 4.67,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.89,
      "end_seconds": 60.48,
      "duration_seconds": 1.59,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.66,
      "end_seconds": 81.11,
      "duration_seconds": 3.45,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.17,
      "end_seconds": 88.02,
      "duration_seconds": 4.85,
      "text": "I take paracetamol syrup, 10 ml, every six hours."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.2,
      "end_seconds": 107.64,
      "duration_seconds": 1.44,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.32,
      "end_seconds": 112.46,
      "duration_seconds": 4.14,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.37,
      "end_seconds": 118.03,
      "duration_seconds": 4.66,
      "text": "Okay, what does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.31,
      "end_seconds": 122.59,
      "duration_seconds": 3.28,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.11,
      "end_seconds": 127.18,
      "duration_seconds": 3.07,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.73,
      "end_seconds": 132.9,
      "duration_seconds": 5.17,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.79,
      "end_seconds": 151.42,
      "duration_seconds": 2.63,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.44,
      "end_seconds": 158.17,
      "duration_seconds": 4.73,
      "text": "Yes, I had my tonsils removed, as a teenager."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.7,
      "end_seconds": 164.21,
      "duration_seconds": 4.51,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.35,
      "end_seconds": 168.29,
      "duration_seconds": 2.94,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.16,
      "end_seconds": 180.37,
      "duration_seconds": 4.21,
      "text": "A few quick ones: rash, ear pain or drooling?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.82,
      "end_seconds": 185.53,
      "duration_seconds": 3.71,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.26,
      "end_seconds": 190.13,
      "duration_seconds": 3.87,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.83,
      "end_seconds": 195.85,
      "duration_seconds": 4.02,
      "text": "Bowels are regular, you know, nothing odd."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.63,
      "end_seconds": 201.06,
      "duration_seconds": 3.43,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.24,
      "end_seconds": 216.62,
      "duration_seconds": 2.38,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.74,
      "end_seconds": 241.46,
      "duration_seconds": 4.72,
      "text": "Okay: pulse 90, temperature 38.3, BP is 108 over 78."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.8,
      "end_seconds": 245.79,
      "duration_seconds": 1.99,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.61,
      "end_seconds": 247.31,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.17,
      "end_seconds": 251.62,
      "duration_seconds": 2.45,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.63,
      "end_seconds": 265.63,
      "duration_seconds": 6.0,
      "text": "The tonsils are large and red with white spots, and the neck glands are tender."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.42,
      "end_seconds": 279.81,
      "duration_seconds": 11.39,
      "text": "Okay, that's enough for me. So, based on the history and the examination, it fits best with tonsillitis. I'll request a throat swab, it'll help with recurrent tonsillitis."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 280.32,
      "end_seconds": 283.13,
      "duration_seconds": 2.81,
      "text": "The earliest is Tuesday, 2 pm."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.14,
      "end_seconds": 298.56,
      "duration_seconds": 14.42,
      "text": "The treatment will be phenoxymethylpenicillin, 250 milligrams, four times a day, ten days. It's for tonsillitis. Plenty of fluids and soft foods, and he can return to school when the fever has gone."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.14,
      "end_seconds": 316.58,
      "duration_seconds": 17.44,
      "text": "Okay, go on. We'll refer you to the ENT clinic. If the symptoms get worse, or you feel really unwell, please come to the emergency department. See me again if recurrent, tonsil review. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.76,
      "end_seconds": 320.63,
      "duration_seconds": 2.87,
      "text": "Yeah, alright, thanks, take care."
    }
  ]
}