{
  "schema_version": "1.0",
  "encounter_id": "01670",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.25,
      "end_seconds": 4.24,
      "duration_seconds": 2.99,
      "text": "Hello, come in. Mind the step."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.14,
      "end_seconds": 7.17,
      "duration_seconds": 1.03,
      "text": "hi there"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 8.47,
      "end_seconds": 13.15,
      "duration_seconds": 4.68,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.07,
      "end_seconds": 17.99,
      "duration_seconds": 3.92,
      "text": "Is the form from the front desk all filled in?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 18.99,
      "end_seconds": 23.69,
      "duration_seconds": 4.7,
      "text": "I think so, I handed it in at the counter."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.01,
      "end_seconds": 27.43,
      "duration_seconds": 2.42,
      "text": "What's the main thing today?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 28.95,
      "end_seconds": 35.28,
      "duration_seconds": 6.33,
      "text": "doctor, it's a productive cough with rusty phlegm. That's what we're worried about"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.92,
      "end_seconds": 38.62,
      "duration_seconds": 1.7,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 40.64,
      "end_seconds": 44.36,
      "duration_seconds": 3.72,
      "text": "It's been about a week, I'm fairly sure."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.86,
      "end_seconds": 54.28,
      "duration_seconds": 9.42,
      "text": "mm-hmm can you describe it a bit more for me? How strong it is, what the pattern is, what helps"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 55.4,
      "end_seconds": 60.0,
      "duration_seconds": 4.6,
      "text": "It feels moderate to me. It happens every other day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.81,
      "end_seconds": 64.98,
      "duration_seconds": 3.17,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.51,
      "end_seconds": 75.57,
      "duration_seconds": 9.06,
      "text": "When it starts I tend to get pain on the right when I breathe in as well."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.24,
      "end_seconds": 93.47,
      "duration_seconds": 3.23,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.04,
      "end_seconds": 103.18,
      "duration_seconds": 2.14,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.32,
      "end_seconds": 121.7,
      "duration_seconds": 9.38,
      "text": "okay: temperature 38.4, oxygen saturation is 97 percent, pressure 116 over 75, pulse is 92 beats a minute, respiratory rate 17."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.15,
      "end_seconds": 124.73,
      "duration_seconds": 1.58,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.21,
      "end_seconds": 129.13,
      "duration_seconds": 2.92,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.36,
      "end_seconds": 134.7,
      "duration_seconds": 3.34,
      "text": "okay, time for me to examine you"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.54,
      "end_seconds": 136.81,
      "duration_seconds": 1.27,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.15,
      "end_seconds": 158.7,
      "duration_seconds": 6.55,
      "text": "There are crackles at the right base and the breathing is a bit fast."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.88,
      "end_seconds": 162.72,
      "duration_seconds": 1.84,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.52,
      "end_seconds": 176.6,
      "duration_seconds": 6.08,
      "text": "Any confusion, leg swelling, recent travel or coughing up blood at all?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 178.24,
      "end_seconds": 180.75,
      "duration_seconds": 2.51,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.6,
      "end_seconds": 186.45,
      "duration_seconds": 3.85,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 187.82,
      "end_seconds": 191.31,
      "duration_seconds": 3.49,
      "text": "No, you know, all normal there."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.27,
      "end_seconds": 195.29,
      "duration_seconds": 2.02,
      "text": "anything surgical in your history?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 196.21,
      "end_seconds": 201.14,
      "duration_seconds": 4.93,
      "text": "Yes, I had my tonsils removed, as a teenager."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.02,
      "end_seconds": 204.46,
      "duration_seconds": 2.44,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 206.0,
      "end_seconds": 207.2,
      "duration_seconds": 1.2,
      "text": "Yes, COPD."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.74,
      "end_seconds": 208.52,
      "duration_seconds": 0.78,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.15,
      "end_seconds": 222.13,
      "duration_seconds": 4.98,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 223.31,
      "end_seconds": 237.48,
      "duration_seconds": 14.17,
      "text": "Nothing, I'm teetotal. I gave up cigarettes last spring. My husband and I live above the shop. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.39,
      "end_seconds": 242.87,
      "duration_seconds": 3.48,
      "text": "what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 243.5,
      "end_seconds": 246.92,
      "duration_seconds": 3.42,
      "text": "it's paracetamol, 1 gram, when needed, doctor"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.01,
      "end_seconds": 253.26,
      "duration_seconds": 5.25,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 255.05,
      "end_seconds": 257.51,
      "duration_seconds": 2.46,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.9,
      "end_seconds": 277.0,
      "duration_seconds": 15.1,
      "text": "having listened and examined, it fits best with community-acquired pneumonia so, to recap quickly you've had a productive cough with rusty phlegm for about a week, moderate, and no recent travel or coughing up blood"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 278.44,
      "end_seconds": 280.17,
      "duration_seconds": 1.73,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.92,
      "end_seconds": 311.17,
      "duration_seconds": 29.25,
      "text": "I'd like to arrange a chest X-ray for possible pneumonia. I'd like you to take amoxicillin, 500 milligrams, three times a day, five days. That should help with chest infection. Rest, drink plenty, and come back if you are not improving in two days. Don't skip meals, and try to eat smaller portions more often through the day. Please don't wait if the symptoms get worse. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 312.02,
      "end_seconds": 318.2,
      "duration_seconds": 6.18,
      "text": "I'll want another look in one week i think we're done unless you have questions"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 319.68,
      "end_seconds": 323.04,
      "duration_seconds": 3.36,
      "text": "good, thanks, I'll see you then"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 327.05,
      "end_seconds": 328.6,
      "duration_seconds": 1.55,
      "text": "have a good day"
    }
  ]
}