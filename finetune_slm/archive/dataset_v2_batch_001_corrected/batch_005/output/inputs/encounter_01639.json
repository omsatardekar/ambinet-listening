{
  "schema_version": "1.0",
  "encounter_id": "01639",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.28,
      "end_seconds": 6.97,
      "duration_seconds": 5.69,
      "text": "Hi, uh, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.11,
      "end_seconds": 13.23,
      "duration_seconds": 5.12,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.05,
      "end_seconds": 21.92,
      "duration_seconds": 7.87,
      "text": "Actually, um, doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.48,
      "end_seconds": 27.13,
      "duration_seconds": 4.65,
      "text": "Alright, of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.17,
      "end_seconds": 39.34,
      "duration_seconds": 10.17,
      "text": "Sorry, you know, what was I saying, I wanted to get a seizure last week looked at."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.91,
      "end_seconds": 42.17,
      "duration_seconds": 2.26,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.45,
      "end_seconds": 54.14,
      "duration_seconds": 2.69,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.36,
      "end_seconds": 83.98,
      "duration_seconds": 11.62,
      "text": "Okay: SpO2 98 percent on room air, heart rate 64. And pressure 124 over 69, temperature is 36.6 degrees. How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.66,
      "end_seconds": 98.08,
      "duration_seconds": 9.42,
      "text": "It's been two weeks now. I'm not great at remembering details, uh, so bear with me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.19,
      "end_seconds": 107.85,
      "duration_seconds": 8.66,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.81,
      "end_seconds": 120.92,
      "duration_seconds": 12.11,
      "text": "Mostly severe. It's all the time. Yes, missed sleep. That makes it worse. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.52,
      "end_seconds": 123.91,
      "duration_seconds": 2.39,
      "text": "Have you been feeling groggy afterwards?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.9,
      "end_seconds": 128.44,
      "duration_seconds": 3.54,
      "text": "Yes, about the same, five days."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.19,
      "end_seconds": 131.79,
      "duration_seconds": 2.6,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.96,
      "end_seconds": 134.09,
      "duration_seconds": 1.13,
      "text": "Mostly severe."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.81,
      "end_seconds": 141.77,
      "duration_seconds": 6.96,
      "text": "Have you had a seizure last week before, or is this the first time?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.86,
      "end_seconds": 150.93,
      "duration_seconds": 7.07,
      "text": "I, I had a similar thing about six months ago. It went away."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.25,
      "end_seconds": 157.11,
      "duration_seconds": 4.86,
      "text": "Let me check a few things. Any head injury or second seizure?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.07,
      "end_seconds": 163.64,
      "duration_seconds": 5.57,
      "text": "I, I haven't had head injury or second seizure, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.44,
      "end_seconds": 168.38,
      "duration_seconds": 3.94,
      "text": "Have you had any fever or loss of bladder control?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.47,
      "end_seconds": 174.17,
      "duration_seconds": 4.7,
      "text": "Right, no, I haven't had any of them."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.71,
      "end_seconds": 177.73,
      "duration_seconds": 3.02,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.93,
      "end_seconds": 180.05,
      "duration_seconds": 1.12,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.29,
      "end_seconds": 184.65,
      "duration_seconds": 3.36,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.99,
      "end_seconds": 191.54,
      "duration_seconds": 5.55,
      "text": "So, my heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.43,
      "end_seconds": 208.03,
      "duration_seconds": 2.6,
      "text": "Okay, tell me your medicines, please."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.35,
      "end_seconds": 228.75,
      "duration_seconds": 19.4,
      "text": "So, uh, I take sodium valproate, 500 milligrams, twice a day for the fits. I didn't want to make a fuss, you know. Naproxen. I take it 250 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.58,
      "end_seconds": 231.97,
      "duration_seconds": 2.39,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.68,
      "end_seconds": 236.06,
      "duration_seconds": 3.38,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.67,
      "end_seconds": 242.21,
      "duration_seconds": 4.54,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.64,
      "end_seconds": 249.52,
      "duration_seconds": 4.88,
      "text": "I have epilepsy. I've got arthritis in my knees."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.75,
      "end_seconds": 256.99,
      "duration_seconds": 6.24,
      "text": "Yes, arthritis in your knees is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.13,
      "end_seconds": 268.59,
      "duration_seconds": 1.46,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.81,
      "end_seconds": 270.96,
      "duration_seconds": 1.15,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.68,
      "end_seconds": 276.45,
      "duration_seconds": 2.77,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.12,
      "end_seconds": 288.67,
      "duration_seconds": 10.55,
      "text": "I only drink at family occasions. I grab fast food at lunch most days. I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.15,
      "end_seconds": 292.61,
      "duration_seconds": 2.46,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.18,
      "end_seconds": 296.13,
      "duration_seconds": 1.95,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.57,
      "end_seconds": 317.19,
      "duration_seconds": 3.62,
      "text": "You are alert and your neurological examination is normal."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.36,
      "end_seconds": 322.1,
      "duration_seconds": 2.74,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.53,
      "end_seconds": 358.57,
      "duration_seconds": 23.04,
      "text": "Okay, thinking it through, this looks most like a breakthrough seizure after missed medication and poor sleep. I want to be honest that this is an impression, not a final answer. Let me repeat that back to make sure. You've had a seizure last week for two weeks, severe, and no head injury or fever."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 360.02,
      "end_seconds": 361.78,
      "duration_seconds": 1.76,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.98,
      "end_seconds": 366.35,
      "duration_seconds": 3.37,
      "text": "I'm going to order blood tests, for seizure."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 367.66,
      "end_seconds": 369.36,
      "duration_seconds": 1.7,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 370.25,
      "end_seconds": 382.21,
      "duration_seconds": 11.96,
      "text": "I think an anticonvulsant level makes sense here, for breakthrough seizure. Take your medicine at the same time every day and do not drive until we say so."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 382.59,
      "end_seconds": 399.69,
      "duration_seconds": 17.1,
      "text": "I see, go ahead. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. The epilepsy nurse would be the right next step, I'll refer you. Book a review in four weeks."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 402.51,
      "end_seconds": 405.29,
      "duration_seconds": 2.78,
      "text": "Oh, that's fine with me."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 406.39,
      "end_seconds": 411.84,
      "duration_seconds": 5.45,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 414.46,
      "end_seconds": 418.79,
      "duration_seconds": 4.33,
      "text": "Ah, good, thanks, I'll see you then."
    }
  ]
}