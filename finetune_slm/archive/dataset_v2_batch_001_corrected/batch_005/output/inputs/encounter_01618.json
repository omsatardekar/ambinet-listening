{
  "schema_version": "1.0",
  "encounter_id": "01618",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.3,
      "end_seconds": 5.89,
      "duration_seconds": 4.59,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.64,
      "end_seconds": 11.94,
      "duration_seconds": 4.3,
      "text": "Okay, that's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.37,
      "end_seconds": 23.98,
      "duration_seconds": 10.61,
      "text": "Mainly the worst headache of my life. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.71,
      "end_seconds": 29.28,
      "duration_seconds": 3.57,
      "text": "Right, how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.21,
      "end_seconds": 38.59,
      "duration_seconds": 8.38,
      "text": "Probably ten days. Yeah. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.68,
      "end_seconds": 43.49,
      "duration_seconds": 3.81,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.39,
      "end_seconds": 46.7,
      "duration_seconds": 2.31,
      "text": "I'd call it moderate."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.34,
      "end_seconds": 50.12,
      "duration_seconds": 2.78,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.79,
      "end_seconds": 70.21,
      "duration_seconds": 18.42,
      "text": "When it starts I tend to get vomiting as well. As for vomiting, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.82,
      "end_seconds": 76.15,
      "duration_seconds": 5.33,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.75,
      "end_seconds": 79.89,
      "duration_seconds": 2.14,
      "text": "Honestly, all the time."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.74,
      "end_seconds": 89.35,
      "duration_seconds": 7.61,
      "text": "Have you had the worst headache of your life before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.21,
      "end_seconds": 96.09,
      "duration_seconds": 4.88,
      "text": "I had a similar thing last year. It went away."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.67,
      "end_seconds": 100.27,
      "duration_seconds": 3.6,
      "text": "Did you get head injury, fever or weakness?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.05,
      "end_seconds": 109.94,
      "duration_seconds": 4.89,
      "text": "So, you know, no, I'd have said so."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.23,
      "end_seconds": 115.14,
      "duration_seconds": 3.91,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.78,
      "end_seconds": 116.89,
      "duration_seconds": 1.11,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.43,
      "end_seconds": 120.92,
      "duration_seconds": 3.49,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.74,
      "end_seconds": 125.18,
      "duration_seconds": 3.44,
      "text": "No, you know, that's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.53,
      "end_seconds": 130.4,
      "duration_seconds": 1.87,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.3,
      "end_seconds": 138.79,
      "duration_seconds": 2.49,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.3,
      "end_seconds": 142.56,
      "duration_seconds": 2.26,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.42,
      "end_seconds": 146.18,
      "duration_seconds": 2.76,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.4,
      "end_seconds": 150.53,
      "duration_seconds": 3.13,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.66,
      "end_seconds": 165.51,
      "duration_seconds": 13.85,
      "text": "Epilepsy, for about a year. I've been putting this off for weeks. I'm hoping you can tell me something definite. I have depression, for nearly five years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.8,
      "end_seconds": 169.61,
      "duration_seconds": 0.81,
      "text": "Anything else?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.4,
      "end_seconds": 183.46,
      "duration_seconds": 4.06,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.36,
      "end_seconds": 186.15,
      "duration_seconds": 1.79,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.63,
      "end_seconds": 191.39,
      "duration_seconds": 3.76,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.77,
      "end_seconds": 200.78,
      "duration_seconds": 6.01,
      "text": "Levetiracetam. I take it 500 milligrams, twice a day for the seizures."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.27,
      "end_seconds": 202.29,
      "duration_seconds": 1.02,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.45,
      "end_seconds": 206.77,
      "duration_seconds": 3.32,
      "text": "Escitalopram, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.01,
      "end_seconds": 210.02,
      "duration_seconds": 2.01,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.22,
      "end_seconds": 216.44,
      "duration_seconds": 5.22,
      "text": "Uh, just a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.87,
      "end_seconds": 228.69,
      "duration_seconds": 2.82,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.48,
      "end_seconds": 233.74,
      "duration_seconds": 4.26,
      "text": "Erm, um, my grandmother had dementia."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 235.2,
      "end_seconds": 239.83,
      "duration_seconds": 4.63,
      "text": "Here are the numbers, doctor. Pressure 158 over 102, pulse 75."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.79,
      "end_seconds": 242.49,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.61,
      "end_seconds": 248.72,
      "duration_seconds": 4.11,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.55,
      "end_seconds": 252.75,
      "duration_seconds": 2.2,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.73,
      "end_seconds": 266.17,
      "duration_seconds": 4.44,
      "text": "Your neck is stiff and you are very sensitive to light."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.98,
      "end_seconds": 280.35,
      "duration_seconds": 8.37,
      "text": "All finished, thank you. Taking everything into account, my working impression is a possible bleed around the brain."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.33,
      "end_seconds": 283.83,
      "duration_seconds": 1.5,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.94,
      "end_seconds": 293.39,
      "duration_seconds": 8.45,
      "text": "I can't promise yet, but most people with a possible bleed around the brain do well once it's treated properly."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.34,
      "end_seconds": 333.05,
      "duration_seconds": 26.71,
      "text": "I'd like to arrange a lumbar puncture for thunderclap headache. I'd like to arrange an urgent CT scan of the head for thunderclap headache. This needs an emergency scan, an ambulance is on its way. I'm going to send a referral to the emergency team. I'll want another look straight away. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.48,
      "end_seconds": 338.65,
      "duration_seconds": 4.17,
      "text": "Oh, great, thank you for your help."
    }
  ]
}