{
  "schema_version": "1.0",
  "encounter_id": "01906",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.92,
      "end_seconds": 5.34,
      "duration_seconds": 4.42,
      "text": "Hello, um, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.63,
      "end_seconds": 11.51,
      "duration_seconds": 4.88,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.21,
      "end_seconds": 17.4,
      "duration_seconds": 4.19,
      "text": "Yeah, I've been dealing with a sore throat again."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.02,
      "end_seconds": 21.62,
      "duration_seconds": 2.6,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.1,
      "end_seconds": 35.69,
      "duration_seconds": 2.59,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.64,
      "end_seconds": 61.03,
      "duration_seconds": 9.39,
      "text": "Okay: pulse 105, temp 38.6 degrees, blood pressure 112 over 80. How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.56,
      "end_seconds": 69.25,
      "duration_seconds": 7.69,
      "text": "It's been going on for about a month. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.07,
      "end_seconds": 73.86,
      "duration_seconds": 2.79,
      "text": "Right, any other symptoms with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.85,
      "end_seconds": 83.98,
      "duration_seconds": 9.13,
      "text": "Missing school goes along with it, most of the time. Right, the missing school? That's been for five days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.34,
      "end_seconds": 89.06,
      "duration_seconds": 3.72,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.96,
      "end_seconds": 95.56,
      "duration_seconds": 4.6,
      "text": "I'd give it a seven, out of ten."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.67,
      "end_seconds": 110.13,
      "duration_seconds": 3.46,
      "text": "A few quick ones: ear pain or drooling?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.89,
      "end_seconds": 115.93,
      "duration_seconds": 4.04,
      "text": "No ear pain or drooling, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.16,
      "end_seconds": 119.62,
      "duration_seconds": 2.46,
      "text": "Have you had any difficulty breathing?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.42,
      "end_seconds": 126.07,
      "duration_seconds": 5.65,
      "text": "I mean, uh, not that I've noticed, no difficulty breathing."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.07,
      "end_seconds": 129.61,
      "duration_seconds": 2.54,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.15,
      "end_seconds": 131.85,
      "duration_seconds": 1.7,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.93,
      "end_seconds": 139.18,
      "duration_seconds": 1.25,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.85,
      "end_seconds": 144.84,
      "duration_seconds": 3.99,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.87,
      "end_seconds": 148.68,
      "duration_seconds": 1.81,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.27,
      "end_seconds": 152.07,
      "duration_seconds": 2.8,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.88,
      "end_seconds": 155.34,
      "duration_seconds": 2.46,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.92,
      "end_seconds": 158.18,
      "duration_seconds": 2.26,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.76,
      "end_seconds": 164.4,
      "duration_seconds": 4.64,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.19,
      "end_seconds": 170.06,
      "duration_seconds": 4.87,
      "text": "Yes, nickel. I get a rash on my skin."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.51,
      "end_seconds": 180.84,
      "duration_seconds": 3.33,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.91,
      "end_seconds": 193.07,
      "duration_seconds": 10.16,
      "text": "I have high cholesterol, for about ten years. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.1,
      "end_seconds": 198.2,
      "duration_seconds": 3.1,
      "text": "Okay, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.16,
      "end_seconds": 202.74,
      "duration_seconds": 1.58,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.5,
      "end_seconds": 224.61,
      "duration_seconds": 3.11,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.96,
      "end_seconds": 233.22,
      "duration_seconds": 7.26,
      "text": "Rosuvastatin, 10 milligrams, at night. It's paracetamol syrup, 10 ml, every six hours."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.83,
      "end_seconds": 240.33,
      "duration_seconds": 5.5,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.26,
      "end_seconds": 244.14,
      "duration_seconds": 2.88,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.5,
      "end_seconds": 266.64,
      "duration_seconds": 6.14,
      "text": "The tonsils are large and red with white spots, and the neck glands are tender."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.68,
      "end_seconds": 273.21,
      "duration_seconds": 2.53,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.09,
      "end_seconds": 290.24,
      "duration_seconds": 4.15,
      "text": "I'd like to arrange a throat swab for recurrent tonsillitis."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.71,
      "end_seconds": 293.76,
      "duration_seconds": 2.05,
      "text": "Is that done today?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.3,
      "end_seconds": 308.12,
      "duration_seconds": 12.82,
      "text": "I'd like you to take phenoxymethylpenicillin, 250 milligrams, four times a day, ten days. That's for tonsillitis. I'll put all of this in writing so you don't have to remember it."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.23,
      "end_seconds": 310.78,
      "duration_seconds": 1.55,
      "text": "That's simple enough."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.48,
      "end_seconds": 325.02,
      "duration_seconds": 12.54,
      "text": "Plenty of fluids and soft foods, and he can return to school when the fever has gone. I'd like you back if recurrent, tonsil review."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.3,
      "end_seconds": 329.69,
      "duration_seconds": 3.39,
      "text": "Okay, so that's fine with me."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.96,
      "end_seconds": 337.48,
      "duration_seconds": 3.52,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.44,
      "end_seconds": 342.75,
      "duration_seconds": 3.31,
      "text": "I mean, thank you, that's helpful."
    }
  ]
}