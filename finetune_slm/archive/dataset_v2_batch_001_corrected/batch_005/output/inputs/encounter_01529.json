{
  "schema_version": "1.0",
  "encounter_id": "01529",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.96,
      "end_seconds": 4.96,
      "duration_seconds": 4.0,
      "text": "Come in, have a seat by the desk."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.21,
      "end_seconds": 9.48,
      "duration_seconds": 3.27,
      "text": "Hello, thanks for fitting me in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.98,
      "end_seconds": 13.46,
      "duration_seconds": 2.48,
      "text": "Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.68,
      "end_seconds": 19.79,
      "duration_seconds": 5.11,
      "text": "I'm here because of chest tightness when I walk uphill."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.67,
      "end_seconds": 25.58,
      "duration_seconds": 3.91,
      "text": "how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 27.25,
      "end_seconds": 29.23,
      "duration_seconds": 1.98,
      "text": "About... well, two weeks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.22,
      "end_seconds": 32.93,
      "duration_seconds": 2.71,
      "text": "So, what aggravates it, if anything?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.58,
      "end_seconds": 38.7,
      "duration_seconds": 5.12,
      "text": "Yes, cold weather and hills. That makes it worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.65,
      "end_seconds": 43.94,
      "duration_seconds": 3.29,
      "text": "Right, how often do you get it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 45.05,
      "end_seconds": 49.52,
      "duration_seconds": 4.47,
      "text": "I, I'd say a couple of times a week."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.03,
      "end_seconds": 52.61,
      "duration_seconds": 2.58,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 54.44,
      "end_seconds": 55.4,
      "duration_seconds": 0.96,
      "text": "mostly severe"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 56.25,
      "end_seconds": 59.05,
      "duration_seconds": 2.8,
      "text": "Has there been breathlessness on exertion too?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 60.64,
      "end_seconds": 63.5,
      "duration_seconds": 2.86,
      "text": "yeah, um, that too"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.43,
      "end_seconds": 67.76,
      "duration_seconds": 2.33,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.61,
      "end_seconds": 70.9,
      "duration_seconds": 2.29,
      "text": "It happens on and off."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.93,
      "end_seconds": 74.93,
      "duration_seconds": 3.0,
      "text": "have you had pain in your jaw?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.88,
      "end_seconds": 80.15,
      "duration_seconds": 3.27,
      "text": "Yeah. About two weeks, I'd say."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.27,
      "end_seconds": 86.76,
      "duration_seconds": 2.49,
      "text": "how much does it limit you?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.73,
      "end_seconds": 96.93,
      "duration_seconds": 5.2,
      "text": "maybe a six out of ten on a a bad day"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.8,
      "end_seconds": 110.21,
      "duration_seconds": 2.41,
      "text": "let me quickly check your readings"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.73,
      "end_seconds": 126.71,
      "duration_seconds": 2.98,
      "text": "Right, sit still for a a moment..."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.76,
      "end_seconds": 149.14,
      "duration_seconds": 5.38,
      "text": "okay: heart rate 64, pressure 115 over 74, saturation 97 percent"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.08,
      "end_seconds": 152.07,
      "duration_seconds": 1.99,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.96,
      "end_seconds": 156.65,
      "duration_seconds": 2.69,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.18,
      "end_seconds": 162.54,
      "duration_seconds": 3.36,
      "text": "could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.87,
      "end_seconds": 164.88,
      "duration_seconds": 1.01,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.23,
      "end_seconds": 169.22,
      "duration_seconds": 2.99,
      "text": "alright, I'm just checking this side"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.31,
      "end_seconds": 191.46,
      "duration_seconds": 5.15,
      "text": "Your heart sounds are normal and the pulses are all present."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.44,
      "end_seconds": 203.68,
      "duration_seconds": 7.24,
      "text": "That's the examination finished. Any fainting, pain at rest, palpitations or leg swelling at all?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 204.35,
      "end_seconds": 209.57,
      "duration_seconds": 5.22,
      "text": "No, no fainting, pain at rest, palpitations or leg swelling."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.36,
      "end_seconds": 213.37,
      "duration_seconds": 3.01,
      "text": "right, any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 214.81,
      "end_seconds": 218.09,
      "duration_seconds": 3.28,
      "text": "Nothing on the skin, uh, no."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.91,
      "end_seconds": 221.28,
      "duration_seconds": 1.37,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 225.82,
      "end_seconds": 227.76,
      "duration_seconds": 1.94,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.38,
      "end_seconds": 232.78,
      "duration_seconds": 4.4,
      "text": "what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 234.77,
      "end_seconds": 239.02,
      "duration_seconds": 4.25,
      "text": "I have high blood pressure i've got high cholesterol"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.14,
      "end_seconds": 247.92,
      "duration_seconds": 7.78,
      "text": "okay, I can see high blood pressure in your file as well. Do you live by yourself?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 248.93,
      "end_seconds": 252.94,
      "duration_seconds": 4.01,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.61,
      "end_seconds": 254.86,
      "duration_seconds": 1.25,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 255.75,
      "end_seconds": 259.14,
      "duration_seconds": 3.39,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.87,
      "end_seconds": 262.58,
      "duration_seconds": 2.71,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 263.12,
      "end_seconds": 266.46,
      "duration_seconds": 3.34,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.92,
      "end_seconds": 270.69,
      "duration_seconds": 2.77,
      "text": "have you ever had an operation?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 272.32,
      "end_seconds": 276.61,
      "duration_seconds": 4.29,
      "text": "Yes, I had my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 277.93,
      "end_seconds": 282.02,
      "duration_seconds": 4.09,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 282.92,
      "end_seconds": 286.49,
      "duration_seconds": 3.57,
      "text": "Erm, not to my knowledge, no."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 297.91,
      "end_seconds": 300.25,
      "duration_seconds": 2.34,
      "text": "what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 301.69,
      "end_seconds": 309.85,
      "duration_seconds": 8.16,
      "text": "I'm on lisinopril, 10 milligrams, once a day for my pressure. I take rosuvastatin, at night."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.88,
      "end_seconds": 313.22,
      "duration_seconds": 2.34,
      "text": "and and what strength is that?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 314.99,
      "end_seconds": 315.92,
      "duration_seconds": 0.93,
      "text": "10 milligrams"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 316.6,
      "end_seconds": 318.81,
      "duration_seconds": 2.21,
      "text": "When did you start it?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 323.53,
      "end_seconds": 325.49,
      "duration_seconds": 1.96,
      "text": "for about a month"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 327.06,
      "end_seconds": 333.21,
      "duration_seconds": 6.15,
      "text": "so, based on the history and the examination, this is probably stable angina"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 334.94,
      "end_seconds": 336.81,
      "duration_seconds": 1.87,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 338.76,
      "end_seconds": 358.76,
      "duration_seconds": 20.0,
      "text": "It's reasonable to be concerned, but right now stable angina is my leading thought, not anything worse. Just to be sure I understood. You've had chest tightness when you walk uphill for two weeks, severe, and no palpitations or pain at rest."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 360.04,
      "end_seconds": 363.07,
      "duration_seconds": 3.03,
      "text": "Okay, so that's what happened, yes."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 371.58,
      "end_seconds": 375.15,
      "duration_seconds": 3.57,
      "text": "let's get an ECG, for chest tightness"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 376.52,
      "end_seconds": 378.57,
      "duration_seconds": 2.05,
      "text": "Okay, I'll do it."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 379.22,
      "end_seconds": 387.97,
      "duration_seconds": 8.75,
      "text": "Let's get a cholesterol test, for heart risk. The The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 392.75,
      "end_seconds": 394.88,
      "duration_seconds": 2.13,
      "text": "Okay, I'll do it."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 395.6,
      "end_seconds": 425.87,
      "duration_seconds": 30.27,
      "text": "let's book an exercise test to look into exertional chest tightness what I'm giving you is glyceryl trinitrate spray, 400 micrograms, when needed, long term it's for chest tightness stop and rest when the tightness starts, and use the spray if it does not ease in a few minutes i think the chest pain clinic should see you too if the symptoms get worse, or you feel really unwell, please come to the emergency department"
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 427.81,
      "end_seconds": 429.45,
      "duration_seconds": 1.64,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 431.06,
      "end_seconds": 433.24,
      "duration_seconds": 2.18,
      "text": "come back after the tests"
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 435.2,
      "end_seconds": 437.15,
      "duration_seconds": 1.95,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 438.83,
      "end_seconds": 441.82,
      "duration_seconds": 2.99,
      "text": "Right, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 443.79,
      "end_seconds": 446.84,
      "duration_seconds": 3.05,
      "text": "Great, thank you for your help."
    }
  ]
}