{
  "schema_version": "1.0",
  "encounter_id": "01699",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.07,
      "end_seconds": 5.83,
      "duration_seconds": 4.76,
      "text": "Uh, you know, sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.95,
      "end_seconds": 11.29,
      "duration_seconds": 4.34,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.86,
      "end_seconds": 21.44,
      "duration_seconds": 8.58,
      "text": "It's tingling in my thumb and first fingers. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.15,
      "end_seconds": 26.55,
      "duration_seconds": 3.4,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.06,
      "end_seconds": 37.61,
      "duration_seconds": 6.55,
      "text": "I've, I've had it for ten days. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.47,
      "end_seconds": 47.16,
      "duration_seconds": 8.69,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.81,
      "end_seconds": 52.57,
      "duration_seconds": 4.76,
      "text": "Mm, I'd say mild. Shaking the hand helps a bit."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.23,
      "end_seconds": 56.24,
      "duration_seconds": 2.01,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.08,
      "end_seconds": 67.28,
      "duration_seconds": 9.2,
      "text": "Dropping things goes along with it, most of the time. The dropping things? That's been since Friday."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.86,
      "end_seconds": 76.07,
      "duration_seconds": 7.21,
      "text": "Have you had any neck pain, pain in the shoulder or weakness in the legs?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.86,
      "end_seconds": 85.81,
      "duration_seconds": 7.95,
      "text": "I haven't had neck pain, pain in the shoulder or weakness in the legs, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.75,
      "end_seconds": 88.7,
      "duration_seconds": 1.95,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.84,
      "end_seconds": 91.35,
      "duration_seconds": 1.51,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.95,
      "end_seconds": 95.42,
      "duration_seconds": 3.47,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.38,
      "end_seconds": 99.43,
      "duration_seconds": 3.05,
      "text": "I'm on valsartan, once a day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.37,
      "end_seconds": 102.71,
      "duration_seconds": 2.34,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.39,
      "end_seconds": 113.33,
      "duration_seconds": 8.94,
      "text": "80 milligrams, I think that's what's on the box. I'm on allopurinol, 100 milligrams, once a day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.27,
      "end_seconds": 131.59,
      "duration_seconds": 1.32,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.21,
      "end_seconds": 139.47,
      "duration_seconds": 3.26,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.03,
      "end_seconds": 144.39,
      "duration_seconds": 3.36,
      "text": "So, are you on your own at home?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.15,
      "end_seconds": 148.28,
      "duration_seconds": 3.13,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.35,
      "end_seconds": 152.08,
      "duration_seconds": 2.73,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.17,
      "end_seconds": 157.29,
      "duration_seconds": 4.12,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.89,
      "end_seconds": 161.75,
      "duration_seconds": 2.86,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.7,
      "end_seconds": 166.3,
      "duration_seconds": 3.6,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.45,
      "end_seconds": 181.13,
      "duration_seconds": 2.68,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.2,
      "end_seconds": 185.83,
      "duration_seconds": 3.63,
      "text": "Oh, no, not that I know of."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.66,
      "end_seconds": 190.28,
      "duration_seconds": 3.62,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.91,
      "end_seconds": 207.81,
      "duration_seconds": 16.9,
      "text": "I've got high blood pressure. I wasn't sure whether to come in at all, to be honest. Sorry, what was I saying, I've had gout for nearly five years now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.07,
      "end_seconds": 215.31,
      "duration_seconds": 6.24,
      "text": "Yes, high blood pressure is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.65,
      "end_seconds": 236.08,
      "duration_seconds": 2.43,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.5,
      "end_seconds": 246.81,
      "duration_seconds": 3.31,
      "text": "Okay, that's it, just a little longer..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.11,
      "end_seconds": 269.2,
      "duration_seconds": 7.09,
      "text": "Okay: blood pressure 123 over 81, respiratory rate 15. And saturation 97 percent, pulse 68."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.0,
      "end_seconds": 273.96,
      "duration_seconds": 2.96,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.18,
      "end_seconds": 276.5,
      "duration_seconds": 1.32,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.69,
      "end_seconds": 299.7,
      "duration_seconds": 6.01,
      "text": "Tapping over the wrist brings on the tingling and the thumb muscle is slightly thin."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.41,
      "end_seconds": 312.26,
      "duration_seconds": 9.85,
      "text": "That's all I needed to check. So, based on the history and the examination, my working impression is carpal tunnel syndrome."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.74,
      "end_seconds": 321.12,
      "duration_seconds": 3.38,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.1,
      "end_seconds": 345.77,
      "duration_seconds": 23.67,
      "text": "It's reasonable to be concerned, but right now carpal tunnel syndrome is my leading thought, not anything worse. Let me repeat that back to make sure. You've had tingling in your thumb and first fingers for ten days, mild, and no pain in the shoulder or weakness in the legs."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.66,
      "end_seconds": 349.14,
      "duration_seconds": 1.48,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.44,
      "end_seconds": 375.95,
      "duration_seconds": 9.51,
      "text": "I think a nerve conduction study makes sense here, for carpal tunnel. Wear a wrist splint at night. Let's review you in six weeks."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 376.82,
      "end_seconds": 378.85,
      "duration_seconds": 2.03,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.33,
      "end_seconds": 382.83,
      "duration_seconds": 2.5,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 384.73,
      "end_seconds": 387.69,
      "duration_seconds": 2.96,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 389.0,
      "end_seconds": 390.18,
      "duration_seconds": 1.18,
      "text": "See you soon."
    }
  ]
}