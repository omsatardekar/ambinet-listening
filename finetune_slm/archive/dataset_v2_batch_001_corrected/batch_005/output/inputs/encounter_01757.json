  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.83,
      "end_seconds": 4.12,
      "duration_seconds": 3.29,
      "text": "hello, sorry about the delay, do sit"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.75,
      "end_seconds": 13.64,
      "duration_seconds": 7.89,
      "text": "sorry, what was I saying, hi doctor, I got here as fast as I could"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.05,
      "end_seconds": 17.95,
      "duration_seconds": 2.9,
      "text": "What do you need help with?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.67,
      "end_seconds": 36.35,
      "duration_seconds": 14.68,
      "text": "I'm, I'm here because of a purple rash that does not fade. Sorry, I know I'm rambling a bit. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.69,
      "end_seconds": 41.47,
      "duration_seconds": 3.78,
      "text": "are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.82,
      "end_seconds": 57.62,
      "duration_seconds": 10.8,
      "text": "Alendronate, 70 milligrams, once a week for my bones. Um, I'm supposed to take it regularly, but I don't always manage."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.0,
      "end_seconds": 79.24,
      "duration_seconds": 3.24,
      "text": "has this been going on for long?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.81,
      "end_seconds": 83.49,
      "duration_seconds": 2.68,
      "text": "ever since... since Monday, really"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.6,
      "end_seconds": 87.81,
      "duration_seconds": 3.21,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.77,
      "end_seconds": 105.82,
      "duration_seconds": 17.05,
      "text": "Hmm, it feels severe to me. As for high fever, I honestly can't say when that began. It might have been last month or the month before. With high fever, it comes and goes."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.44,
      "end_seconds": 110.8,
      "duration_seconds": 3.36,
      "text": "Did you get cough, stiff neck or diarrhoea?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 112.32,
      "end_seconds": 116.03,
      "duration_seconds": 3.71,
      "text": "no, no cough, stiff neck or diarrhoea"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.76,
      "end_seconds": 121.19,
      "duration_seconds": 3.43,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.75,
      "end_seconds": 123.29,
      "duration_seconds": 1.54,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.48,
      "end_seconds": 131.81,
      "duration_seconds": 4.33,
      "text": "any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.73,
      "end_seconds": 135.93,
      "duration_seconds": 3.2,
      "text": "no, uh, all normal there"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.18,
      "end_seconds": 140.0,
      "duration_seconds": 2.82,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 140.57,
      "end_seconds": 141.71,
      "duration_seconds": 1.14,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.69,
      "end_seconds": 145.95,
      "duration_seconds": 3.26,
      "text": "okay, are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.6,
      "end_seconds": 148.92,
      "duration_seconds": 2.32,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.78,
      "end_seconds": 153.12,
      "duration_seconds": 3.34,
      "text": "alright, has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 154.61,
      "end_seconds": 164.88,
      "duration_seconds": 10.27,
      "text": "I've, I've got thin bones i'm hoping you can tell me something definite i took the morning off to come in today"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.56,
      "end_seconds": 172.75,
      "duration_seconds": 6.19,
      "text": "Right, so thin bones is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.35,
      "end_seconds": 183.72,
      "duration_seconds": 2.37,
      "text": "do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 184.86,
      "end_seconds": 188.19,
      "duration_seconds": 3.33,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.91,
      "end_seconds": 191.67,
      "duration_seconds": 2.76,
      "text": "Right, is there someone at home?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.39,
      "end_seconds": 196.64,
      "duration_seconds": 4.25,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.5,
      "end_seconds": 200.11,
      "duration_seconds": 2.61,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.25,
      "end_seconds": 210.46,
      "duration_seconds": 2.21,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.58,
      "end_seconds": 232.21,
      "duration_seconds": 6.63,
      "text": "okay: pressure 105 over 66, SpO2 97 percent on room air, pulse 104."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.63,
      "end_seconds": 235.71,
      "duration_seconds": 2.08,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.98,
      "end_seconds": 239.32,
      "duration_seconds": 2.34,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.04,
      "end_seconds": 260.99,
      "duration_seconds": 8.95,
      "text": "The purple spots do not fade when I press a glass on them, and he is floppy and drowsy."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.7,
      "end_seconds": 272.41,
      "duration_seconds": 7.71,
      "text": "good, you can sit up again. Putting it all together, this is probably possible meningococcal sepsis"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 273.11,
      "end_seconds": 275.07,
      "duration_seconds": 1.96,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 276.45,
      "end_seconds": 283.19,
      "duration_seconds": 6.74,
      "text": "I can't promise yet, but most people with possible meningococcal sepsis do well once it's treated properly."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.58,
      "end_seconds": 317.87,
      "duration_seconds": 23.29,
      "text": "I want blood cultures done, that's for possible sepsis. It's a routine test and it'll give us a much clearer picture. I'd like to arrange urgent blood tests for possible sepsis. I'm prescribing benzylpenicillin, 600 milligrams, once now, single dose. That should help with possible meningococcal sepsis."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 319.45,
      "end_seconds": 323.28,
      "duration_seconds": 3.83,
      "text": "Should I carry on if I feel better?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 324.76,
      "end_seconds": 332.94,
      "duration_seconds": 8.18,
      "text": "I am giving an antibiotic injection now and calling an ambulance. Come back straight away. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 335.0,
      "end_seconds": 337.91,
      "duration_seconds": 2.91,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 339.94,
      "end_seconds": 341.31,
      "duration_seconds": 1.37,
      "text": "See you soon."
    }
  ]
}