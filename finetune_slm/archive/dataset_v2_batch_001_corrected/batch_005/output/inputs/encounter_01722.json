{
  "schema_version": "1.0",
  "encounter_id": "01722",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.34,
      "end_seconds": 3.46,
      "duration_seconds": 2.12,
      "text": "Afternoon, thanks for coming in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.31,
      "end_seconds": 8.5,
      "duration_seconds": 4.19,
      "text": "Um, morning, doctor, sorry about the rush."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.0,
      "end_seconds": 17.23,
      "duration_seconds": 7.23,
      "text": "Hello, you know, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.95,
      "end_seconds": 22.82,
      "duration_seconds": 3.87,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 23.35,
      "end_seconds": 32.88,
      "duration_seconds": 9.53,
      "text": "It's a purple rash that does not fade, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.0,
      "end_seconds": 37.04,
      "duration_seconds": 3.04,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 37.89,
      "end_seconds": 40.0,
      "duration_seconds": 2.11,
      "text": "About... well, two weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.76,
      "end_seconds": 44.52,
      "duration_seconds": 2.76,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.58,
      "end_seconds": 47.6,
      "duration_seconds": 1.02,
      "text": "Mostly severe."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 49.68,
      "end_seconds": 52.37,
      "duration_seconds": 2.69,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.05,
      "end_seconds": 63.34,
      "duration_seconds": 6.29,
      "text": "Cold hands and feet goes along with it, most of the time"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.24,
      "end_seconds": 71.6,
      "duration_seconds": 7.36,
      "text": "Well, I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 71.7,
      "end_seconds": 78.42,
      "duration_seconds": 6.72,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the the trolley in now or later?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.37,
      "end_seconds": 82.62,
      "duration_seconds": 2.25,
      "text": "later, thanks please go on"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.48,
      "end_seconds": 99.64,
      "duration_seconds": 15.16,
      "text": "And, And being drowsy, too. Right, as for cold hands and feet, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.9,
      "end_seconds": 104.43,
      "duration_seconds": 3.53,
      "text": "So, how much does it limit you?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 106.16,
      "end_seconds": 109.47,
      "duration_seconds": 3.31,
      "text": "pretty severe, if I'm being honest"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 110.96,
      "end_seconds": 114.47,
      "duration_seconds": 3.51,
      "text": "Yes, that's right, that's how it was."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.1,
      "end_seconds": 119.24,
      "duration_seconds": 3.14,
      "text": "So, any cough or diarrhoea at all?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.66,
      "end_seconds": 132.46,
      "duration_seconds": 11.8,
      "text": "no, no cough, no diarrhoea. I did have a high fever at one point, but that that went away on its own"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.81,
      "end_seconds": 135.72,
      "duration_seconds": 1.91,
      "text": "Nothing like stiff neck?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.96,
      "end_seconds": 142.53,
      "duration_seconds": 5.57,
      "text": "Right, not that that I've noticed, no stiff neck."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.39,
      "end_seconds": 148.73,
      "duration_seconds": 5.34,
      "text": "Okay, what about your tummy and and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 149.47,
      "end_seconds": 152.71,
      "duration_seconds": 3.24,
      "text": "No, um, all normal there."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.5,
      "end_seconds": 165.99,
      "duration_seconds": 4.49,
      "text": "right, has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.18,
      "end_seconds": 176.9,
      "duration_seconds": 6.72,
      "text": "Uh, um, my cousin has psoriasis. My sister had breast cancer."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.27,
      "end_seconds": 182.0,
      "duration_seconds": 3.73,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 182.72,
      "end_seconds": 185.89,
      "duration_seconds": 3.17,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.29,
      "end_seconds": 193.46,
      "duration_seconds": 3.17,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 195.36,
      "end_seconds": 200.48,
      "duration_seconds": 5.12,
      "text": "Allopurinol. I take it once a day for the gout."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.06,
      "end_seconds": 203.97,
      "duration_seconds": 2.91,
      "text": "And And what strength is that?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 205.09,
      "end_seconds": 213.51,
      "duration_seconds": 8.42,
      "text": "It's 100 milligrams. Glimepiride. I take it 2 milligrams, before breakfast for my sugar."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.1,
      "end_seconds": 215.51,
      "duration_seconds": 1.41,
      "text": "is that long-standing?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 216.38,
      "end_seconds": 226.67,
      "duration_seconds": 10.29,
      "text": "About about a month. Um, I'm on something called napr... naproxen, 250 milligrams, maybe, twice a day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.59,
      "end_seconds": 231.98,
      "duration_seconds": 4.39,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 232.48,
      "end_seconds": 235.3,
      "duration_seconds": 2.82,
      "text": "Mm, no, it's at home."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.2,
      "end_seconds": 238.83,
      "duration_seconds": 1.63,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 240.39,
      "end_seconds": 244.89,
      "duration_seconds": 4.5,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.82,
      "end_seconds": 250.45,
      "duration_seconds": 3.63,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 252.31,
      "end_seconds": 255.88,
      "duration_seconds": 3.57,
      "text": "I've had migraines for five years now."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.06,
      "end_seconds": 257.76,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 259.83,
      "end_seconds": 263.33,
      "duration_seconds": 3.5,
      "text": "I've had gout for five years now."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.48,
      "end_seconds": 265.18,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 266.16,
      "end_seconds": 268.01,
      "duration_seconds": 1.85,
      "text": "I have diabetes."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.74,
      "end_seconds": 269.93,
      "duration_seconds": 1.19,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 271.46,
      "end_seconds": 274.8,
      "duration_seconds": 3.34,
      "text": "I've got arthritis in my knees."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 276.45,
      "end_seconds": 285.98,
      "duration_seconds": 9.53,
      "text": "here are the numbers, doctor. SpO2 95 percent on room air, temperature 39.1. Pulse 90, blood pressure 122 over 70."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.75,
      "end_seconds": 287.45,
      "duration_seconds": 0.7,
      "text": "thanks"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.19,
      "end_seconds": 292.37,
      "duration_seconds": 2.18,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.57,
      "end_seconds": 295.88,
      "duration_seconds": 2.31,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.02,
      "end_seconds": 316.27,
      "duration_seconds": 9.25,
      "text": "The purple spots do not fade when I press a glass on them, and he is floppy and drowsy."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 321.59,
      "end_seconds": 324.41,
      "duration_seconds": 2.82,
      "text": "good, you can sit up again"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 333.48,
      "end_seconds": 343.62,
      "duration_seconds": 10.14,
      "text": "So, based on the history and the examination, this is probably possible meningococcal sepsis. A viral rash is also on my list."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 345.43,
      "end_seconds": 348.72,
      "duration_seconds": 3.29,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 349.31,
      "end_seconds": 383.32,
      "duration_seconds": 34.01,
      "text": "It's reasonable to be concerned, but right now possible meningococcal sepsis is my leading thought, not anything worse. I want blood cultures done, that's for possible sepsis. I want urgent blood tests done, that's for possible sepsis. I'd like you to take benzylpenicillin, 600 milligrams, once now, single dose. That's for possible meningococcal sepsis. I am giving an antibiotic injection now and calling an ambulance. I'm going to send a referral to the emergency team."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 384.85,
      "end_seconds": 399.65,
      "duration_seconds": 14.8,
      "text": "and please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose right, that's the plan do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 401.26,
      "end_seconds": 403.64,
      "duration_seconds": 2.38,
      "text": "thank you, doctor, goodbye"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 405.45,
      "end_seconds": 407.19,
      "duration_seconds": 1.74,
      "text": "Right, take care now."
    }
  ]
}