{
  "schema_version": "1.0",
  "encounter_id": "01940",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.07,
      "end_seconds": 4.72,
      "duration_seconds": 3.65,
      "text": "Hi there, the chair's free, sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.75,
      "end_seconds": 7.75,
      "duration_seconds": 2.0,
      "text": "Hi, um, thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.95,
      "end_seconds": 10.13,
      "duration_seconds": 1.18,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.03,
      "end_seconds": 20.8,
      "duration_seconds": 9.77,
      "text": "Actually, doctor, it's a fall and pain in my left hip. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.85,
      "end_seconds": 25.53,
      "duration_seconds": 3.68,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.76,
      "end_seconds": 29.88,
      "duration_seconds": 3.12,
      "text": "It's paracetamol, 1 gram, when needed."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.57,
      "end_seconds": 50.67,
      "duration_seconds": 3.1,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 51.61,
      "end_seconds": 54.19,
      "duration_seconds": 2.58,
      "text": "About... well, about a month."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.88,
      "end_seconds": 63.92,
      "duration_seconds": 9.04,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.4,
      "end_seconds": 85.03,
      "duration_seconds": 19.63,
      "text": "Lying still helps a bit. Maybe a eight out of ten on a bad day. I wasn't sure whether to come in at all, to be honest. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.99,
      "end_seconds": 91.52,
      "duration_seconds": 5.53,
      "text": "Have you had any numbness, chest pain or loss of consciousness?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.45,
      "end_seconds": 95.34,
      "duration_seconds": 2.89,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.72,
      "end_seconds": 99.07,
      "duration_seconds": 2.35,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 99.65,
      "end_seconds": 101.77,
      "duration_seconds": 2.12,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.39,
      "end_seconds": 114.83,
      "duration_seconds": 2.44,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 116.58,
      "end_seconds": 119.9,
      "duration_seconds": 3.32,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.57,
      "end_seconds": 124.04,
      "duration_seconds": 2.47,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.72,
      "end_seconds": 129.82,
      "duration_seconds": 4.1,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.42,
      "end_seconds": 133.06,
      "duration_seconds": 2.64,
      "text": "Right, do you live by yourself?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.22,
      "end_seconds": 138.16,
      "duration_seconds": 3.94,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.56,
      "end_seconds": 153.51,
      "duration_seconds": 2.95,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.16,
      "end_seconds": 160.12,
      "duration_seconds": 4.96,
      "text": "Uh, yes, milk, it gives me stomach cramps."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.45,
      "end_seconds": 164.78,
      "duration_seconds": 3.33,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.64,
      "end_seconds": 168.65,
      "duration_seconds": 3.01,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 170.25,
      "end_seconds": 177.9,
      "duration_seconds": 7.65,
      "text": "Doctor, I've got the readings for you. Saturation 98 percent, BP is 121 over 82, pulse 80."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.9,
      "end_seconds": 180.0,
      "duration_seconds": 1.1,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.64,
      "end_seconds": 183.82,
      "duration_seconds": 2.18,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.67,
      "end_seconds": 186.31,
      "duration_seconds": 1.64,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.22,
      "end_seconds": 208.35,
      "duration_seconds": 6.13,
      "text": "The left leg is shortened and turned outwards, and it is very painful to move."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.62,
      "end_seconds": 223.54,
      "duration_seconds": 10.92,
      "text": "Okay, that's enough for me. So, based on the history and the examination, I think we're dealing with a probable hip fracture at this stage."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 225.21,
      "end_seconds": 229.23,
      "duration_seconds": 4.02,
      "text": "Okay, so what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.78,
      "end_seconds": 236.98,
      "duration_seconds": 7.2,
      "text": "I can't promise yet, but most people with a probable hip fracture do well once it's treated properly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.43,
      "end_seconds": 259.02,
      "duration_seconds": 11.59,
      "text": "I'll request blood tests, it'll help with pre-operative. We'll begin with morphine, 2.5 milligrams, now, single dose. That should help with hip pain."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 260.23,
      "end_seconds": 262.38,
      "duration_seconds": 2.15,
      "text": "Fine, I'll begin it."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.22,
      "end_seconds": 291.08,
      "duration_seconds": 26.86,
      "text": "Lie still, I am arranging an ambulance and pain relief. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. We'll refer you to the orthopaedic team. An X-ray of the hip is something we might do if this doesn't improve in two weeks. Please come and see me straight away."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 292.24,
      "end_seconds": 295.59,
      "duration_seconds": 3.35,
      "text": "Hmm, good, I'll return then."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 297.64,
      "end_seconds": 301.79,
      "duration_seconds": 4.15,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 303.46,
      "end_seconds": 306.38,
      "duration_seconds": 2.92,
      "text": "Thank you, uh, that's helpful."
    }
  ]
}