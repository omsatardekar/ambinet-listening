{
  "schema_version": "1.0",
  "encounter_id": "01758",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.3,
      "end_seconds": 8.6,
      "duration_seconds": 7.3,
      "text": "Okay, doctor, we're all set in here. I'll give you the numbers when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.33,
      "end_seconds": 13.83,
      "duration_seconds": 3.5,
      "text": "Thank you. Right, hello, what's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 15.88,
      "end_seconds": 21.68,
      "duration_seconds": 5.8,
      "text": "doctor, it's trouble falling asleep. It's getting on my nerves now"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.33,
      "end_seconds": 25.15,
      "duration_seconds": 2.82,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 25.8,
      "end_seconds": 29.7,
      "duration_seconds": 3.9,
      "text": "Oh, it's been going on for two months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.91,
      "end_seconds": 41.92,
      "duration_seconds": 9.01,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 43.16,
      "end_seconds": 57.35,
      "duration_seconds": 14.19,
      "text": "I notice it more with coffee in the evening and screens. I'd give it a three, out of ten. It settles a little with a warm bath."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.93,
      "end_seconds": 59.95,
      "duration_seconds": 2.02,
      "text": "have you been waking tired?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 63.06,
      "end_seconds": 64.21,
      "duration_seconds": 1.15,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.14,
      "end_seconds": 69.2,
      "duration_seconds": 4.06,
      "text": "Has there been a busy mind at night too?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 70.39,
      "end_seconds": 73.25,
      "duration_seconds": 2.86,
      "text": "Yeah, um, that too."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.38,
      "end_seconds": 90.7,
      "duration_seconds": 4.32,
      "text": "Any low mood, chest pain, snoring or weight change?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 92.12,
      "end_seconds": 97.22,
      "duration_seconds": 5.1,
      "text": "No, no low mood, chest pain, snoring or weight change."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.75,
      "end_seconds": 101.95,
      "duration_seconds": 3.2,
      "text": "any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 106.21,
      "end_seconds": 107.72,
      "duration_seconds": 1.51,
      "text": "no, nothing there"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.47,
      "end_seconds": 110.82,
      "duration_seconds": 2.35,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 112.06,
      "end_seconds": 115.26,
      "duration_seconds": 3.2,
      "text": "Propranolol, 40 milligrams, twice a day"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 116.54,
      "end_seconds": 121.22,
      "duration_seconds": 4.68,
      "text": "doctor, our chart from the last visit lists it as 20 milligrams"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.2,
      "end_seconds": 127.37,
      "duration_seconds": 4.17,
      "text": "Hm, that's different. Is the latest prescription anywhere near you?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 127.99,
      "end_seconds": 140.5,
      "duration_seconds": 12.51,
      "text": "no, uh, I left it at home. A herbal sleep tea i take it at night i used to take sumatriptan, but I stopped it"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.31,
      "end_seconds": 146.99,
      "duration_seconds": 4.68,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 150.71,
      "end_seconds": 165.53,
      "duration_seconds": 14.82,
      "text": "I only drink at family occasions. I hardly move around during the day. My partner and our baby. I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.27,
      "end_seconds": 167.47,
      "duration_seconds": 1.2,
      "text": "any previous surgeries?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 169.18,
      "end_seconds": 170.66,
      "duration_seconds": 1.48,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.64,
      "end_seconds": 192.64,
      "duration_seconds": 3.0,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 196.83,
      "end_seconds": 200.49,
      "duration_seconds": 3.66,
      "text": "I have migraines, for about a year"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.51,
      "end_seconds": 202.57,
      "duration_seconds": 1.06,
      "text": "hm, okay"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 204.56,
      "end_seconds": 208.62,
      "duration_seconds": 4.06,
      "text": "I have eczema, for about ten years."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.3,
      "end_seconds": 217.75,
      "duration_seconds": 5.45,
      "text": "okay, go on. Okay, I can see eczema in your file as well"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 219.01,
      "end_seconds": 235.77,
      "duration_seconds": 16.76,
      "text": "Doctor, I've got the readings for you. Pulse is 81 beats a minute, weight 52 kilos, blood pressure 110 over 69, respiratory rate 16, oxygen saturation is 97 percent, BMI works out to 20.8, height 158 centimetres."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.41,
      "end_seconds": 237.39,
      "duration_seconds": 0.98,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.28,
      "end_seconds": 243.65,
      "duration_seconds": 4.37,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.87,
      "end_seconds": 246.91,
      "duration_seconds": 2.04,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.05,
      "end_seconds": 264.91,
      "duration_seconds": 2.86,
      "text": "Your blood pressure and pulse are normal."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.38,
      "end_seconds": 272.86,
      "duration_seconds": 2.48,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.69,
      "end_seconds": 313.67,
      "duration_seconds": 22.98,
      "text": "Right, here's what I'm thinking. The most likely explanation is poor sleep habits. Mild anxiety is also on my list. Keep a fixed bedtime, no screens for an hour before bed, and no coffee after lunch. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 317.54,
      "end_seconds": 319.4,
      "duration_seconds": 1.86,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.93,
      "end_seconds": 325.04,
      "duration_seconds": 4.11,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 326.92,
      "end_seconds": 329.01,
      "duration_seconds": 2.09,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.97,
      "end_seconds": 331.55,
      "duration_seconds": 1.58,
      "text": "Have a good day."
    }
  ]
}