{
  "schema_version": "1.0",
  "encounter_id": "01868",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.62,
      "end_seconds": 4.8,
      "duration_seconds": 4.18,
      "text": "Doctor, we're ready in room two, I've already taken the observations."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.89,
      "end_seconds": 11.61,
      "duration_seconds": 4.72,
      "text": "Great. Hello, come in and sit down. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.02,
      "end_seconds": 19.17,
      "duration_seconds": 6.15,
      "text": "Good morning, you know, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.79,
      "end_seconds": 28.47,
      "duration_seconds": 3.68,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 30.36,
      "end_seconds": 35.37,
      "duration_seconds": 5.01,
      "text": "He's been having pain going to my right shoulder, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.35,
      "end_seconds": 43.17,
      "duration_seconds": 5.82,
      "text": "Did it come on recently? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 47.93,
      "end_seconds": 52.07,
      "duration_seconds": 4.14,
      "text": "It's been going on for about two weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 52.97,
      "end_seconds": 60.12,
      "duration_seconds": 7.15,
      "text": "Oh, I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 60.22,
      "end_seconds": 67.44,
      "duration_seconds": 7.22,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.1,
      "end_seconds": 71.34,
      "duration_seconds": 2.24,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 72.08,
      "end_seconds": 82.78,
      "duration_seconds": 10.7,
      "text": "Oh, and pain under my right ribs after fatty meals. That's been about the same, one week."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.45,
      "end_seconds": 86.92,
      "duration_seconds": 3.47,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 88.41,
      "end_seconds": 96.8,
      "duration_seconds": 8.39,
      "text": "Well, you know, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.08,
      "end_seconds": 103.18,
      "duration_seconds": 5.1,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 105.09,
      "end_seconds": 114.6,
      "duration_seconds": 9.51,
      "text": "About a seven out of ten. Bloating was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.53,
      "end_seconds": 123.68,
      "duration_seconds": 7.15,
      "text": "Have you had pain going to your right shoulder before, or is this the first time?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 124.67,
      "end_seconds": 134.28,
      "duration_seconds": 9.61,
      "text": "Okay, so yes, something like this happened last winter, and it went away on its own."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.18,
      "end_seconds": 137.66,
      "duration_seconds": 2.48,
      "text": "Okay, what about dark urine?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 139.35,
      "end_seconds": 141.5,
      "duration_seconds": 2.15,
      "text": "No, no dark urine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.14,
      "end_seconds": 144.99,
      "duration_seconds": 2.85,
      "text": "Any pale stools, yellow eyes or fever?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 147.05,
      "end_seconds": 154.13,
      "duration_seconds": 7.08,
      "text": "Let me think, um, no, I haven't had any of them."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.17,
      "end_seconds": 158.74,
      "duration_seconds": 2.57,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 159.71,
      "end_seconds": 161.38,
      "duration_seconds": 1.67,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.61,
      "end_seconds": 166.43,
      "duration_seconds": 3.82,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 167.49,
      "end_seconds": 187.4,
      "duration_seconds": 19.91,
      "text": "It's iron tablets, once a day. My neighbour said I should get it looked at. Sitagliptin. I take it 100 milligrams, once a day. It's an antacid, 10 ml, maybe, when needed."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.42,
      "end_seconds": 193.9,
      "duration_seconds": 4.48,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 195.87,
      "end_seconds": 198.36,
      "duration_seconds": 2.49,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.14,
      "end_seconds": 203.08,
      "duration_seconds": 3.94,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 204.58,
      "end_seconds": 217.99,
      "duration_seconds": 13.41,
      "text": "Low haemoglobin, for about a year. My family kept telling me to get it checked. I have diabetes, for about a year."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.88,
      "end_seconds": 220.31,
      "duration_seconds": 1.43,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.97,
      "end_seconds": 230.66,
      "duration_seconds": 8.69,
      "text": "Alright, diabetes, that matches what I have here. Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 231.22,
      "end_seconds": 243.18,
      "duration_seconds": 11.96,
      "text": "Sorry, um, what was I saying, I was told I'm allergic to grass pollen, but I don't remember what reaction I had."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.2,
      "end_seconds": 248.44,
      "duration_seconds": 3.24,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 249.66,
      "end_seconds": 252.23,
      "duration_seconds": 2.57,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.18,
      "end_seconds": 263.29,
      "duration_seconds": 3.11,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 264.2,
      "end_seconds": 268.6,
      "duration_seconds": 4.4,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.26,
      "end_seconds": 273.69,
      "duration_seconds": 3.43,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 275.14,
      "end_seconds": 281.75,
      "duration_seconds": 6.61,
      "text": "Just my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 293.94,
      "end_seconds": 305.62,
      "duration_seconds": 11.68,
      "text": "Here are the numbers, doctor. Oxygen saturation is 97 percent, pulse is 76 beats a minute, temp 36.5 degrees. BP is 123 over 71."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.13,
      "end_seconds": 313.74,
      "duration_seconds": 7.61,
      "text": "Thanks. So, based on your history, this is probably gallstone-related pain. A stomach ulcer is still possible."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 315.36,
      "end_seconds": 319.36,
      "duration_seconds": 4.0,
      "text": "Mm, uh, is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.37,
      "end_seconds": 352.4,
      "duration_seconds": 32.03,
      "text": "I understand the worry. At the moment I'd say it's gallstone-related pain, and we'll know more once the an ultrasound of the abdomen is back. We should do an ultrasound of the abdomen for biliary pain. We should do liver blood tests for biliary pain. For this, paracetamol, 1 gram, four times a day when needed, one week. You take it by mouth. It's for pain. Avoid fatty and fried foods until the scan."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.1,
      "end_seconds": 372.09,
      "duration_seconds": 17.99,
      "text": "Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 373.09,
      "end_seconds": 376.18,
      "duration_seconds": 3.09,
      "text": "I know what to watch for."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 377.17,
      "end_seconds": 385.78,
      "duration_seconds": 8.61,
      "text": "I'd like to see you again after the scan. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 386.89,
      "end_seconds": 390.96,
      "duration_seconds": 4.07,
      "text": "Actually, good, thanks, I'll see you then."
    }
  ]
}