    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.82,
      "end_seconds": 149.6,
      "duration_seconds": 6.78,
      "text": "Yeah um my heart's been fine as far as I know."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.23,
      "end_seconds": 154.75,
      "duration_seconds": 3.52,
      "text": "Are you taking anything regularly including from the pharmacy?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.79,
      "end_seconds": 163.31,
      "duration_seconds": 4.52,
      "text": "I'm, I'm on Thyronorm, 50 micrograms, every morning."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.7,
      "end_seconds": 182.17,
      "duration_seconds": 2.47,
      "text": "have you had any previous surgeries?"
