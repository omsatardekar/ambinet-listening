    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.62,
      "end_seconds": 81.61,
      "duration_seconds": 2.99,
      "text": "it's a few times a day"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.34,
      "end_seconds": 85.58,
      "duration_seconds": 3.24,
      "text": "What about crusting have you noticed that?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.61,
      "end_seconds": 89.22,
      "duration_seconds": 2.61,
      "text": "Yes you know since Friday."
