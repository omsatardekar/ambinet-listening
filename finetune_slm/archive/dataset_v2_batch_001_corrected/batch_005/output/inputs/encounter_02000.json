      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.22,
      "end_seconds": 302.99,
      "duration_seconds": 10.77,
      "text": "please sit back down. The treatment will be aciclovir cream 5% five times a day five days. It's for cold sore. Does all of that make sense?"
    },
