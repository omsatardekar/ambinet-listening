    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.22,
      "end_seconds": 142.12,
      "duration_seconds": 3.9,
      "text": "Anything with your heart like skipped beats or fainting?"
