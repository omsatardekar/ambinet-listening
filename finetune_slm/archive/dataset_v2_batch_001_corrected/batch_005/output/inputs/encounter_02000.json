    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.88,
      "end_seconds": 288.86,
      "duration_seconds": 5.98,
      "text": "There is a small cluster of blisters on the edge of the upper lip."
