    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.42,
      "end_seconds": 186.2,
      "duration_seconds": 2.78,
      "text": "Well no not at all."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.34,
      "end_seconds": 191.82,
      "duration_seconds": 4.48,
      "text": "any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.55,
      "end_seconds": 205.14,
      "duration_seconds": 11.59,
      "text": "Right, I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.85,
      "end_seconds": 211.18,
      "duration_seconds": 4.33,
      "text": "anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.7,
      "end_seconds": 224.59,
      "duration_seconds": 12.89,
      "text": "Yes gout. Sorry what was I saying I've got an underactive thyroid. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.97,
      "end_seconds": 234.81,
      "duration_seconds": 6.84,
      "text": "right, so gout is already on your record we'll keep that in mind today"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.5,
      "end_seconds": 248.88,
      "duration_seconds": 2.38,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.52,
      "end_seconds": 259.44,
      "duration_seconds": 9.92,
      "text": "No, I've never smoked in my life. I swim twice a week. My husband and I live above the shop"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.52,
      "end_seconds": 264.47,
      "duration_seconds": 3.95,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.96,
      "end_seconds": 268.02,
      "duration_seconds": 2.06,
      "text": "okay, uh, doctor"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.18,
      "end_seconds": 271.3,
      "duration_seconds": 2.12,
      "text": "tell me if that's sore"
