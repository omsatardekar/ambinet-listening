      "role": "DOCTOR",
      "start_seconds": 6.78,
      "end_seconds": 12.1,
      "duration_seconds": 5.32,
      "text": "Okay, yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.78,
      "end_seconds": 23.75,
      "duration_seconds": 10.97,
      "text": "Erm, um, honestly, it's a tingling lip then a blister, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.68,
      "end_seconds": 27.69,
      "duration_seconds": 3.01,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.92,
      "end_seconds": 38.61,
      "duration_seconds": 2.69,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.48,
      "end_seconds": 63.02,
      "duration_seconds": 6.54,
      "text": "okay: blood pressure 113 over 74, pulse 73, temperature 36.6, respiratory rate 14."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.17,
      "end_seconds": 76.55,
      "duration_seconds": 2.38,
      "text": "Is it constant or in episodes?"
