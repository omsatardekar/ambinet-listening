    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.85,
      "end_seconds": 92.69,
      "duration_seconds": 2.84,
      "text": "Any a mild sore feeling as well?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.34,
      "end_seconds": 100.06,
      "duration_seconds": 6.72,
      "text": "Yes, since yesterday. Oh, as for mild sore feeling, mild, really."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.1,
      "end_seconds": 109.18,
      "duration_seconds": 7.08,
      "text": "have you had a tingling lip then a blister before, or is this the first time?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.45,
      "end_seconds": 116.74,
      "duration_seconds": 6.29,
      "text": "mm, I had a similar thing last year. It went away"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.26,
      "end_seconds": 121.15,
      "duration_seconds": 2.89,
      "text": "did you notice any rash elsewhere?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.83,
      "end_seconds": 125.73,
      "duration_seconds": 3.9,
      "text": "I I haven't noticed any rash elsewhere"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.36,
      "end_seconds": 132.01,
      "duration_seconds": 4.65,
      "text": "Any sores in the mouth, eye pain or fever at all?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.5,
      "end_seconds": 136.69,
      "duration_seconds": 3.19,
      "text": "well, nope, nothing like that"
