{
  "schema_version": "1.0",
  "encounter_id": "01951",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.64,
      "end_seconds": 4.74,
      "duration_seconds": 4.1,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.09,
      "end_seconds": 10.28,
      "duration_seconds": 4.19,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.29,
      "end_seconds": 19.71,
      "duration_seconds": 7.42,
      "text": "So the thing is, you know, I've got a sore on my ankle that won't heal."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.8,
      "end_seconds": 30.18,
      "duration_seconds": 5.38,
      "text": "So, can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.48,
      "end_seconds": 39.68,
      "duration_seconds": 2.2,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.97,
      "end_seconds": 72.01,
      "duration_seconds": 13.04,
      "text": "Okay: temperature is 36.6 degrees, respiratory rate 16, oxygen saturation is 97 percent, pulse 73, pressure 127 over 75. How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.19,
      "end_seconds": 76.35,
      "duration_seconds": 3.16,
      "text": "For about a month, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.96,
      "end_seconds": 80.64,
      "duration_seconds": 3.68,
      "text": "Any itchy brown skin on the shin as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.55,
      "end_seconds": 82.75,
      "duration_seconds": 1.2,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.26,
      "end_seconds": 101.92,
      "duration_seconds": 2.66,
      "text": "Have you had any spreading redness?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.39,
      "end_seconds": 106.33,
      "duration_seconds": 2.94,
      "text": "No, none, no spreading redness."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.04,
      "end_seconds": 113.56,
      "duration_seconds": 6.52,
      "text": "Let me check a few things. Any calf pain, fever or chest pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.2,
      "end_seconds": 116.43,
      "duration_seconds": 2.23,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.25,
      "end_seconds": 120.6,
      "duration_seconds": 2.35,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.45,
      "end_seconds": 122.42,
      "duration_seconds": 0.97,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.96,
      "end_seconds": 127.11,
      "duration_seconds": 3.15,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.67,
      "end_seconds": 130.6,
      "duration_seconds": 1.93,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.74,
      "end_seconds": 135.17,
      "duration_seconds": 3.43,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.83,
      "end_seconds": 140.18,
      "duration_seconds": 3.35,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.84,
      "end_seconds": 143.61,
      "duration_seconds": 1.77,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.48,
      "end_seconds": 147.76,
      "duration_seconds": 3.28,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.46,
      "end_seconds": 160.29,
      "duration_seconds": 2.83,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.76,
      "end_seconds": 166.4,
      "duration_seconds": 4.64,
      "text": "I have high blood pressure, for two years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.63,
      "end_seconds": 181.1,
      "duration_seconds": 4.47,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.31,
      "end_seconds": 185.63,
      "duration_seconds": 3.32,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.99,
      "end_seconds": 190.46,
      "duration_seconds": 3.47,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.34,
      "end_seconds": 195.51,
      "duration_seconds": 4.17,
      "text": "It's metoprolol, 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.01,
      "end_seconds": 201.36,
      "duration_seconds": 3.35,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.42,
      "end_seconds": 212.94,
      "duration_seconds": 1.52,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.47,
      "end_seconds": 215.64,
      "duration_seconds": 1.17,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.17,
      "end_seconds": 232.47,
      "duration_seconds": 7.3,
      "text": "There is a shallow ulcer above the inner ankle with brown skin around it and visible varicose veins."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.42,
      "end_seconds": 243.54,
      "duration_seconds": 8.12,
      "text": "Okay, that's all I needed to check. Taking everything into account, it fits best with a venous leg ulcer."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.98,
      "end_seconds": 246.98,
      "duration_seconds": 2.0,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.79,
      "end_seconds": 280.85,
      "duration_seconds": 33.06,
      "text": "I understand the worry. At the moment I'd say it's a venous leg ulcer, and we'll know more once the a wound swab is back. We should do a wound swab for leg ulcer. It's a routine test and it'll give us a much clearer picture. A doppler test of the leg pulses is what I'd like next, for leg ulcer. Compression bandaging and keeping the leg raised when sitting."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.84,
      "end_seconds": 306.65,
      "duration_seconds": 24.81,
      "text": "The leg ulcer clinic would be the right next step, I'll refer you. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. Let's plan a check in two weeks. Okay, tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.18,
      "end_seconds": 312.89,
      "duration_seconds": 4.71,
      "text": "So, I come back in two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.61,
      "end_seconds": 323.32,
      "duration_seconds": 4.71,
      "text": "Yes, exactly right. Right, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.14,
      "end_seconds": 326.88,
      "duration_seconds": 1.74,
      "text": "That's clear, thanks."
    }
  ]
}