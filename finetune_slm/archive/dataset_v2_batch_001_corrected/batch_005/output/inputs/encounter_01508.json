{
  "schema_version": "1.0",
  "encounter_id": "01508",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.36,
      "end_seconds": 8.93,
      "duration_seconds": 7.57,
      "text": "let me think, doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.82,
      "end_seconds": 14.11,
      "duration_seconds": 4.29,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.43,
      "end_seconds": 19.88,
      "duration_seconds": 4.45,
      "text": "Well, I've been having loose stools with blood."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.84,
      "end_seconds": 24.16,
      "duration_seconds": 3.32,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.88,
      "end_seconds": 40.08,
      "duration_seconds": 14.2,
      "text": "ah, you know, I've had it for about a month. Sorry, what was I saying, and there's mouth ulcers as well, about two weeks now"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.06,
      "end_seconds": 45.34,
      "duration_seconds": 3.28,
      "text": "So, has there been cramping tummy pain too?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.24,
      "end_seconds": 49.44,
      "duration_seconds": 2.2,
      "text": "Yes, for two months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.04,
      "end_seconds": 55.28,
      "duration_seconds": 5.24,
      "text": "right, is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.89,
      "end_seconds": 59.45,
      "duration_seconds": 3.56,
      "text": "Honestly, a couple of times a week."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.25,
      "end_seconds": 64.61,
      "duration_seconds": 3.36,
      "text": "A few quick ones: joint pain or vomiting?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.19,
      "end_seconds": 69.82,
      "duration_seconds": 4.63,
      "text": "I mean, no, no joint pain or vomiting."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.83,
      "end_seconds": 74.55,
      "duration_seconds": 2.72,
      "text": "have you noticed fever or weight loss?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.52,
      "end_seconds": 78.68,
      "duration_seconds": 3.16,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.08,
      "end_seconds": 82.54,
      "duration_seconds": 2.46,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.98,
      "end_seconds": 85.07,
      "duration_seconds": 1.09,
      "text": "skin's normal"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.49,
      "end_seconds": 89.03,
      "duration_seconds": 2.54,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.91,
      "end_seconds": 93.93,
      "duration_seconds": 4.02,
      "text": "Let me think, I've had asthma, yes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.52,
      "end_seconds": 104.86,
      "duration_seconds": 2.34,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.9,
      "end_seconds": 108.32,
      "duration_seconds": 2.42,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.92,
      "end_seconds": 111.84,
      "duration_seconds": 2.92,
      "text": "do you work outside the home?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.14,
      "end_seconds": 121.71,
      "duration_seconds": 4.57,
      "text": "I'm a hairdresser, on my feet all day"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.79,
      "end_seconds": 128.04,
      "duration_seconds": 2.25,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.96,
      "end_seconds": 133.17,
      "duration_seconds": 4.21,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.0,
      "end_seconds": 135.76,
      "duration_seconds": 1.76,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.78,
      "end_seconds": 141.19,
      "duration_seconds": 4.41,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.19,
      "end_seconds": 160.39,
      "duration_seconds": 3.2,
      "text": "which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.35,
      "end_seconds": 166.74,
      "duration_seconds": 4.39,
      "text": "Foracort inhaler. I take it it twice a day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.06,
      "end_seconds": 186.97,
      "duration_seconds": 3.91,
      "text": "let me get the readings out of the way"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.91,
      "end_seconds": 200.12,
      "duration_seconds": 3.21,
      "text": "Okay, bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.63,
      "end_seconds": 222.12,
      "duration_seconds": 8.49,
      "text": "Okay: blood pressure 128 over 81, heart rate 83. And height 161 centimetres, weight 54 kilos, respiratory rate 18."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.15,
      "end_seconds": 227.67,
      "duration_seconds": 3.52,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.53,
      "end_seconds": 229.52,
      "duration_seconds": 0.99,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.46,
      "end_seconds": 233.46,
      "duration_seconds": 2.0,
      "text": "Okay, does that hurt?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.72,
      "end_seconds": 247.08,
      "duration_seconds": 4.36,
      "text": "There is tenderness in the lower right tummy and no guarding."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.83,
      "end_seconds": 283.55,
      "duration_seconds": 32.72,
      "text": "Okay, you can sit up now. I think a stool test makes sense here, for bloody diarrhoea. I'd like to arrange blood tests for flare. That will help us see what's going on underneath and decide the next step. You'll be taking prednisolone, 40 milligrams, once a day, one week then reduce. That should help with inflammatory bowel flare. Keep up your fluids and call the IBD nurse if you get a fever."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.41,
      "end_seconds": 295.57,
      "duration_seconds": 11.16,
      "text": "The thing that would worry me is if the symptoms get worse. If that happens, go to emergency. I'd like you back in two weeks."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.66,
      "end_seconds": 299.72,
      "duration_seconds": 3.06,
      "text": "Oh, good, I'll return then."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.64,
      "end_seconds": 305.03,
      "duration_seconds": 4.39,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.65,
      "end_seconds": 308.31,
      "duration_seconds": 1.66,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.19,
      "end_seconds": 310.54,
      "duration_seconds": 1.35,
      "text": "see you soon"
    }
  ]
}