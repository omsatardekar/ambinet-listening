{
  "schema_version": "1.0",
  "encounter_id": "01523",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.34,
      "end_seconds": 4.81,
      "duration_seconds": 3.47,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.64,
      "end_seconds": 11.09,
      "duration_seconds": 4.45,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.95,
      "end_seconds": 15.33,
      "duration_seconds": 3.38,
      "text": "It's a cough for three weeks, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.63,
      "end_seconds": 18.25,
      "duration_seconds": 1.62,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.98,
      "end_seconds": 29.31,
      "duration_seconds": 9.33,
      "text": "Hm. It was either the end of last month or earlier than that. I couldn't tell you the date."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.72,
      "end_seconds": 43.87,
      "duration_seconds": 10.15,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.31,
      "end_seconds": 59.27,
      "duration_seconds": 12.96,
      "text": "I'd give it a six, out of ten. Honestly, every other day. I've been losing weight too, since yesterday. I've had night sweats too, for six months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.01,
      "end_seconds": 62.43,
      "duration_seconds": 2.42,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.14,
      "end_seconds": 72.8,
      "duration_seconds": 2.66,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.83,
      "end_seconds": 105.65,
      "duration_seconds": 12.82,
      "text": "Okay: weight 78 kilos, saturation 98 percent. And height 178 centimetres, pulse is 73 beats a minute, respiratory rate 18, temp 36.9 degrees, blood pressure 114 over 76."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.31,
      "end_seconds": 111.48,
      "duration_seconds": 4.17,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.47,
      "end_seconds": 114.94,
      "duration_seconds": 2.47,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.01,
      "end_seconds": 127.91,
      "duration_seconds": 4.9,
      "text": "There are some crackles at the top of the right lung."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.46,
      "end_seconds": 134.38,
      "duration_seconds": 2.92,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.33,
      "end_seconds": 157.77,
      "duration_seconds": 4.44,
      "text": "Have you had any chest pain, coughing up blood or fever?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.66,
      "end_seconds": 162.54,
      "duration_seconds": 3.88,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.51,
      "end_seconds": 164.77,
      "duration_seconds": 1.26,
      "text": "What about HIV?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.45,
      "end_seconds": 168.14,
      "duration_seconds": 1.69,
      "text": "Nope, no HIV."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.01,
      "end_seconds": 171.47,
      "duration_seconds": 1.46,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.09,
      "end_seconds": 173.55,
      "duration_seconds": 1.46,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.88,
      "end_seconds": 176.19,
      "duration_seconds": 1.31,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.82,
      "end_seconds": 180.92,
      "duration_seconds": 3.1,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.19,
      "end_seconds": 187.7,
      "duration_seconds": 5.51,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.86,
      "end_seconds": 206.27,
      "duration_seconds": 17.41,
      "text": "I gave up cigarettes last spring. I only drink at family occasions. I grab fast food at lunch most days. Yes, I work in a bakery, early starts. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.99,
      "end_seconds": 211.67,
      "duration_seconds": 4.68,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.59,
      "end_seconds": 218.35,
      "duration_seconds": 4.76,
      "text": "My son has asthma. My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.68,
      "end_seconds": 223.26,
      "duration_seconds": 3.58,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.34,
      "end_seconds": 229.53,
      "duration_seconds": 4.19,
      "text": "It's alendronate, 70 milligrams, maybe, once a week."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.22,
      "end_seconds": 235.16,
      "duration_seconds": 3.94,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.14,
      "end_seconds": 243.74,
      "duration_seconds": 7.6,
      "text": "Not with me. I'll bring it next time. I was on glibenclamide before. I stopped taking it."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.28,
      "end_seconds": 259.95,
      "duration_seconds": 3.67,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.15,
      "end_seconds": 265.65,
      "duration_seconds": 4.5,
      "text": "Yes, kiwi, it gives me an itchy mouth."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.71,
      "end_seconds": 271.18,
      "duration_seconds": 4.47,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.18,
      "end_seconds": 277.21,
      "duration_seconds": 4.03,
      "text": "I've got thin bones. I have an enlarged prostate."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.58,
      "end_seconds": 279.28,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.34,
      "end_seconds": 284.34,
      "duration_seconds": 4.0,
      "text": "I've had diabetes for nearly five years now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.92,
      "end_seconds": 287.79,
      "duration_seconds": 1.87,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.44,
      "end_seconds": 296.74,
      "duration_seconds": 7.3,
      "text": "Right, so an enlarged prostate is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.07,
      "end_seconds": 317.32,
      "duration_seconds": 9.25,
      "text": "From what you've told me and what I found, it fits best with possible tuberculosis. We shouldn't forget a lung tumour."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.41,
      "end_seconds": 320.53,
      "duration_seconds": 2.12,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.42,
      "end_seconds": 339.4,
      "duration_seconds": 17.98,
      "text": "Nothing I've seen today points to an emergency. It looks like possible tuberculosis, but I'd like to confirm. Just to be sure I understood. You've had a cough for three weeks, and no fever or HIV."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.3,
      "end_seconds": 341.84,
      "duration_seconds": 1.54,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.97,
      "end_seconds": 347.26,
      "duration_seconds": 4.29,
      "text": "I'll request a chest X-ray, it'll help with prolonged cough."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.08,
      "end_seconds": 349.75,
      "duration_seconds": 1.67,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.45,
      "end_seconds": 380.43,
      "duration_seconds": 29.98,
      "text": "I'm going to order three sputum samples, for possible tuberculosis. I'd rather check than guess, and this is the quickest way to know more. Wear a mask in public and cover your mouth when you cough until the results are back. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 382.07,
      "end_seconds": 383.73,
      "duration_seconds": 1.66,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 384.54,
      "end_seconds": 392.98,
      "duration_seconds": 8.44,
      "text": "See me again after the tests. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 394.77,
      "end_seconds": 398.61,
      "duration_seconds": 3.84,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}