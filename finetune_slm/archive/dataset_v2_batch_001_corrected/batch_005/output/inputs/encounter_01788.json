{
  "schema_version": "1.0",
  "encounter_id": "01788",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.92,
      "end_seconds": 6.02,
      "duration_seconds": 5.1,
      "text": "Doctor, if you're free, we can start. I've got the numbers noted down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.77,
      "end_seconds": 11.65,
      "duration_seconds": 3.88,
      "text": "Perfect, thanks. Hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 12.25,
      "end_seconds": 17.21,
      "duration_seconds": 4.96,
      "text": "Um, so... a swollen tummy. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.1,
      "end_seconds": 21.83,
      "duration_seconds": 2.73,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 23.07,
      "end_seconds": 35.93,
      "duration_seconds": 12.86,
      "text": "Pretty mild, if I'm being honest. I've also had colicky tummy pain, for two weeks. About colicky tummy pain, pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 38.36,
      "end_seconds": 51.37,
      "duration_seconds": 13.01,
      "text": "Okay, so the vitals from earlier. Height 164 centimetres, BP is 125 over 73, SpO2 98 percent on room air. Temperature 36.6, heart rate 106, weight 72 kilos."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.51,
      "end_seconds": 57.83,
      "duration_seconds": 1.32,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.16,
      "end_seconds": 62.17,
      "duration_seconds": 2.01,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.42,
      "end_seconds": 64.89,
      "duration_seconds": 1.47,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.04,
      "end_seconds": 83.57,
      "duration_seconds": 4.53,
      "text": "Your tummy is swollen and tympanic, with high-pitched tinkling bowel sounds."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.9,
      "end_seconds": 92.43,
      "duration_seconds": 6.53,
      "text": "Okay, that's enough for me. Have you noticed blood in the stool, hernia or fever?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 93.91,
      "end_seconds": 98.29,
      "duration_seconds": 4.38,
      "text": "No, no blood in the stool, hernia or fever."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.09,
      "end_seconds": 102.46,
      "duration_seconds": 2.37,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 107.71,
      "end_seconds": 109.22,
      "duration_seconds": 1.51,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.93,
      "end_seconds": 112.41,
      "duration_seconds": 2.48,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 114.07,
      "end_seconds": 115.01,
      "duration_seconds": 0.94,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.66,
      "end_seconds": 121.56,
      "duration_seconds": 4.9,
      "text": "So, tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 124.05,
      "end_seconds": 125.75,
      "duration_seconds": 1.7,
      "text": "I have anxiety."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.78,
      "end_seconds": 137.12,
      "duration_seconds": 10.34,
      "text": "I follow. Right, so anxiety is already on your record. We'll keep that in mind today. Alright, are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 138.98,
      "end_seconds": 141.02,
      "duration_seconds": 2.04,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.58,
      "end_seconds": 143.75,
      "duration_seconds": 1.17,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 145.06,
      "end_seconds": 148.09,
      "duration_seconds": 3.03,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.71,
      "end_seconds": 151.98,
      "duration_seconds": 2.27,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 153.6,
      "end_seconds": 156.02,
      "duration_seconds": 2.42,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.88,
      "end_seconds": 160.73,
      "duration_seconds": 2.85,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 162.62,
      "end_seconds": 166.33,
      "duration_seconds": 3.71,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.67,
      "end_seconds": 170.42,
      "duration_seconds": 2.75,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 171.91,
      "end_seconds": 175.43,
      "duration_seconds": 3.52,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.2,
      "end_seconds": 192.6,
      "duration_seconds": 2.4,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 194.69,
      "end_seconds": 196.73,
      "duration_seconds": 2.04,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.75,
      "end_seconds": 201.77,
      "duration_seconds": 3.02,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 203.03,
      "end_seconds": 206.48,
      "duration_seconds": 3.45,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.88,
      "end_seconds": 228.6,
      "duration_seconds": 9.72,
      "text": "So where does that leave us? This is probably a bowel obstruction needing urgent surgical care. I can't rule out severe constipation yet."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 229.44,
      "end_seconds": 232.3,
      "duration_seconds": 2.86,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.61,
      "end_seconds": 242.87,
      "duration_seconds": 9.26,
      "text": "I can't promise yet, but most people with a bowel obstruction needing urgent surgical care do well once it's treated properly."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.87,
      "end_seconds": 266.95,
      "duration_seconds": 10.08,
      "text": "I'll request urgent blood tests, it'll help with vomiting. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 268.97,
      "end_seconds": 270.89,
      "duration_seconds": 1.92,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.5,
      "end_seconds": 276.72,
      "duration_seconds": 4.22,
      "text": "We should do an abdominal X-ray for possible obstruction."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 277.28,
      "end_seconds": 278.84,
      "duration_seconds": 1.56,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.19,
      "end_seconds": 302.21,
      "duration_seconds": 22.02,
      "text": "Nothing to eat or drink, and you are going to hospital now. Let's get you seen by the surgical team, I'll arrange the letter. Do get help quickly if the symptoms get worse. We'll catch up straight away. Okay, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 307.71,
      "end_seconds": 311.18,
      "duration_seconds": 3.47,
      "text": "Alright, uh, thanks, take care."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.28,
      "end_seconds": 313.73,
      "duration_seconds": 1.45,
      "text": "See you soon."
    }
  ]
}