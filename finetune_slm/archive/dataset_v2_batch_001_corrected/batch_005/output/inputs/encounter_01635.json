{
  "schema_version": "1.0",
  "encounter_id": "01635",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.36,
      "end_seconds": 7.23,
      "duration_seconds": 5.87,
      "text": "doctor? Hello, you know, I hope this is the the right time"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.02,
      "end_seconds": 12.07,
      "duration_seconds": 4.05,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.58,
      "end_seconds": 23.25,
      "duration_seconds": 9.67,
      "text": "it's a sore on my ankle that won't heal i thought I'd wait, but it hasn't gone"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.1,
      "end_seconds": 27.7,
      "duration_seconds": 3.6,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.35,
      "end_seconds": 39.31,
      "duration_seconds": 2.96,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.05,
      "end_seconds": 62.59,
      "duration_seconds": 11.54,
      "text": "Okay: blood pressure 122 over 71, saturation 97 percent, height 178 centimetres, temperature 36.7, weight 58 kilos, respiratory rate 18, pulse 72."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.22,
      "end_seconds": 65.24,
      "duration_seconds": 2.02,
      "text": "is that alright, doctor?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.37,
      "end_seconds": 69.86,
      "duration_seconds": 3.49,
      "text": "don't worry, we'll discuss it in a second"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.58,
      "end_seconds": 91.36,
      "duration_seconds": 2.78,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.3,
      "end_seconds": 95.75,
      "duration_seconds": 3.45,
      "text": "it's been like this since last weekend"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.34,
      "end_seconds": 100.32,
      "duration_seconds": 2.98,
      "text": "how much trouble does it give you?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.49,
      "end_seconds": 107.72,
      "duration_seconds": 1.23,
      "text": "Mild, really"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.35,
      "end_seconds": 111.57,
      "duration_seconds": 3.22,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.03,
      "end_seconds": 127.72,
      "duration_seconds": 14.69,
      "text": "It usually comes with swollen legs by evening. The swollen legs by evening? That's been for about four days. About swollen legs by evening, honestly, a few times a day."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.89,
      "end_seconds": 148.33,
      "duration_seconds": 2.44,
      "text": "Have you had any calf pain?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.81,
      "end_seconds": 152.05,
      "duration_seconds": 2.24,
      "text": "nope, no calf pain"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.97,
      "end_seconds": 158.23,
      "duration_seconds": 3.26,
      "text": "did you get chest pain or fever?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.57,
      "end_seconds": 162.58,
      "duration_seconds": 3.01,
      "text": "No, no chest pain or fever."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.56,
      "end_seconds": 168.82,
      "duration_seconds": 4.26,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.44,
      "end_seconds": 171.94,
      "duration_seconds": 1.5,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.38,
      "end_seconds": 176.31,
      "duration_seconds": 2.93,
      "text": "how are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.77,
      "end_seconds": 179.79,
      "duration_seconds": 2.02,
      "text": "I move fine otherwise"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.08,
      "end_seconds": 187.52,
      "duration_seconds": 3.44,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.0,
      "end_seconds": 192.26,
      "duration_seconds": 3.26,
      "text": "no, nothing I can think of"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.3,
      "end_seconds": 208.08,
      "duration_seconds": 2.78,
      "text": "so, do you get out much?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.32,
      "end_seconds": 213.14,
      "duration_seconds": 3.82,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.81,
      "end_seconds": 217.64,
      "duration_seconds": 2.83,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.56,
      "end_seconds": 222.31,
      "duration_seconds": 3.75,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.13,
      "end_seconds": 227.32,
      "duration_seconds": 3.19,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.35,
      "end_seconds": 231.99,
      "duration_seconds": 2.64,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.27,
      "end_seconds": 236.03,
      "duration_seconds": 2.76,
      "text": "have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.58,
      "end_seconds": 238.14,
      "duration_seconds": 1.56,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.38,
      "end_seconds": 243.75,
      "duration_seconds": 4.37,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.77,
      "end_seconds": 249.9,
      "duration_seconds": 1.13,
      "text": "Yes, trimethoprim."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.93,
      "end_seconds": 253.33,
      "duration_seconds": 2.4,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.74,
      "end_seconds": 256.08,
      "duration_seconds": 1.34,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.49,
      "end_seconds": 277.51,
      "duration_seconds": 8.02,
      "text": "there is a shallow ulcer above the inner ankle with brown skin around it and visible varicose veins"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.0,
      "end_seconds": 297.28,
      "duration_seconds": 15.28,
      "text": "Thank you, you can get dressed. Just to be sure I understood. You've had a sore on your ankle that won't heal, since last weekend, mild, and no chest pain or calf pain."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.7,
      "end_seconds": 299.4,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.81,
      "end_seconds": 338.06,
      "duration_seconds": 27.25,
      "text": "I'm going to order a wound swab, for leg ulcer. Compression bandaging and keeping the leg raised when sitting. If it hasn't settled next month, we'd think about a doppler test of the leg pulses, but not now. Come back or go to emergency straight away if the symptoms get worse. Book a review in two weeks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.01,
      "end_seconds": 341.65,
      "duration_seconds": 1.64,
      "text": "yes, that's manageable"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.86,
      "end_seconds": 345.49,
      "duration_seconds": 2.63,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.26,
      "end_seconds": 349.57,
      "duration_seconds": 3.31,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}