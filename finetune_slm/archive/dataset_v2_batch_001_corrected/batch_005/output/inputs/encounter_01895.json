{
  "schema_version": "1.0",
  "encounter_id": "01895",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.83,
      "end_seconds": 5.16,
      "duration_seconds": 4.33,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.88,
      "end_seconds": 11.09,
      "duration_seconds": 4.21,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.93,
      "end_seconds": 19.92,
      "duration_seconds": 7.99,
      "text": "So, honestly, it's swollen glands in my neck, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.48,
      "end_seconds": 23.41,
      "duration_seconds": 2.93,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.43,
      "end_seconds": 34.44,
      "duration_seconds": 9.01,
      "text": "For about a week, I'd say. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.42,
      "end_seconds": 37.84,
      "duration_seconds": 2.42,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.36,
      "end_seconds": 43.18,
      "duration_seconds": 3.82,
      "text": "Actually, it usually comes with a fever."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.76,
      "end_seconds": 46.02,
      "duration_seconds": 2.26,
      "text": "Have you been feeling exhausted?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.62,
      "end_seconds": 49.66,
      "duration_seconds": 3.04,
      "text": "Yeah, I've had that since yesterday."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.55,
      "end_seconds": 59.83,
      "duration_seconds": 8.28,
      "text": "Let me check a few things. Any rash, jaundice, tummy pain on the left or difficulty breathing?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.68,
      "end_seconds": 65.51,
      "duration_seconds": 3.83,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.29,
      "end_seconds": 70.53,
      "duration_seconds": 3.24,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.34,
      "end_seconds": 75.52,
      "duration_seconds": 3.18,
      "text": "Oh, I move fine otherwise."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.2,
      "end_seconds": 81.68,
      "duration_seconds": 4.48,
      "text": "So, anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.07,
      "end_seconds": 84.81,
      "duration_seconds": 1.74,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.38,
      "end_seconds": 91.15,
      "duration_seconds": 3.77,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.68,
      "end_seconds": 94.98,
      "duration_seconds": 2.3,
      "text": "Migraines, for two years."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.02,
      "end_seconds": 113.37,
      "duration_seconds": 5.35,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.82,
      "end_seconds": 118.01,
      "duration_seconds": 3.19,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.03,
      "end_seconds": 122.74,
      "duration_seconds": 2.71,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.74,
      "end_seconds": 128.66,
      "duration_seconds": 3.92,
      "text": "I take sumatriptan, 50 milligrams, when needed."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.22,
      "end_seconds": 130.3,
      "duration_seconds": 1.08,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.54,
      "end_seconds": 135.22,
      "duration_seconds": 3.68,
      "text": "Throat lozenges. I take it when needed."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.55,
      "end_seconds": 147.47,
      "duration_seconds": 3.92,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.48,
      "end_seconds": 152.74,
      "duration_seconds": 3.26,
      "text": "Uh, my brother has epilepsy."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.41,
      "end_seconds": 154.96,
      "duration_seconds": 1.55,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.4,
      "end_seconds": 164.2,
      "duration_seconds": 4.8,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.13,
      "end_seconds": 167.95,
      "duration_seconds": 2.82,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.52,
      "end_seconds": 173.04,
      "duration_seconds": 3.52,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.94,
      "end_seconds": 177.04,
      "duration_seconds": 2.1,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.83,
      "end_seconds": 181.91,
      "duration_seconds": 4.08,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.0,
      "end_seconds": 185.96,
      "duration_seconds": 1.96,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.77,
      "end_seconds": 193.6,
      "duration_seconds": 5.83,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.2,
      "end_seconds": 198.97,
      "duration_seconds": 3.77,
      "text": "Right, I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.65,
      "end_seconds": 208.8,
      "duration_seconds": 2.15,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.04,
      "end_seconds": 229.12,
      "duration_seconds": 9.08,
      "text": "Okay: BP is 105 over 71, respiratory rate 20, heart rate 96, oxygen saturation is 96 percent, temperature 38.9."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.34,
      "end_seconds": 231.81,
      "duration_seconds": 1.47,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.84,
      "end_seconds": 238.39,
      "duration_seconds": 2.55,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.95,
      "end_seconds": 242.98,
      "duration_seconds": 2.03,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.65,
      "end_seconds": 246.07,
      "duration_seconds": 1.42,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.03,
      "end_seconds": 260.83,
      "duration_seconds": 6.8,
      "text": "Your tonsils are large with white coating and the glands in the neck are tender."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.44,
      "end_seconds": 265.96,
      "duration_seconds": 2.52,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.45,
      "end_seconds": 284.31,
      "duration_seconds": 8.86,
      "text": "From what you've told me and what I found, this is probably glandular fever. Streptococcal tonsillitis is still possible."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.23,
      "end_seconds": 291.95,
      "duration_seconds": 1.72,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.89,
      "end_seconds": 325.08,
      "duration_seconds": 32.19,
      "text": "I can't promise yet, but most people with glandular fever do well once it's treated properly. Let's book a blood count to look into glandular fever. It's a routine test and it'll give us a much clearer picture. Let's get a monospot test, for sore throat and fatigue. It's a routine test and it'll give us a much clearer picture. Rest, plenty of fluids, and no contact sport for a month because of the spleen."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.94,
      "end_seconds": 334.66,
      "duration_seconds": 8.72,
      "text": "Come back or go to emergency straight away if the symptoms get worse. We'll catch up in two weeks."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.59,
      "end_seconds": 338.86,
      "duration_seconds": 3.27,
      "text": "Good, uh, I'll return then."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.14,
      "end_seconds": 343.65,
      "duration_seconds": 3.51,
      "text": "Okay, does all of that make sense?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.98,
      "end_seconds": 349.12,
      "duration_seconds": 4.14,
      "text": "I, I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.45,
      "end_seconds": 352.29,
      "duration_seconds": 1.84,
      "text": "Have a good day."
    }
  ]
}