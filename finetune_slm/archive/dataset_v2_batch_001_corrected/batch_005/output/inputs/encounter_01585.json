{
  "schema_version": "1.0",
  "encounter_id": "01585",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.18,
      "end_seconds": 5.04,
      "duration_seconds": 3.86,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.0,
      "end_seconds": 10.76,
      "duration_seconds": 3.76,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.71,
      "end_seconds": 18.83,
      "duration_seconds": 6.12,
      "text": "Hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.73,
      "end_seconds": 27.37,
      "duration_seconds": 5.64,
      "text": "Mainly I've been feeling nervous about exertion. That's why I came."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.15,
      "end_seconds": 32.4,
      "duration_seconds": 3.25,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.9,
      "end_seconds": 36.3,
      "duration_seconds": 2.4,
      "text": "About... well, about four days."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.83,
      "end_seconds": 42.0,
      "duration_seconds": 4.17,
      "text": "Any an ache in your chest wall as well?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.66,
      "end_seconds": 46.97,
      "duration_seconds": 4.31,
      "text": "Yes, I have. I've also had a little breathlessness."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.46,
      "end_seconds": 55.57,
      "duration_seconds": 5.11,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.67,
      "end_seconds": 62.77,
      "duration_seconds": 3.1,
      "text": "It's a few times a day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.33,
      "end_seconds": 70.0,
      "duration_seconds": 5.67,
      "text": "Have you been feeling nervous about exertion at any time before this?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.4,
      "end_seconds": 77.52,
      "duration_seconds": 6.12,
      "text": "I had a similar thing about six months ago. It went away."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.82,
      "end_seconds": 81.31,
      "duration_seconds": 2.49,
      "text": "Any palpitations, leg swelling or fainting?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.83,
      "end_seconds": 88.75,
      "duration_seconds": 5.92,
      "text": "Yeah, I haven't had palpitations, leg swelling or fainting, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.61,
      "end_seconds": 92.9,
      "duration_seconds": 3.29,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.21,
      "end_seconds": 97.1,
      "duration_seconds": 2.89,
      "text": "Hmm, no, skin's been fine."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.86,
      "end_seconds": 101.24,
      "duration_seconds": 2.38,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.67,
      "end_seconds": 104.14,
      "duration_seconds": 1.47,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.45,
      "end_seconds": 108.0,
      "duration_seconds": 2.55,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.57,
      "end_seconds": 111.52,
      "duration_seconds": 2.95,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 112.26,
      "end_seconds": 120.12,
      "duration_seconds": 7.86,
      "text": "Actually, I remember she had some kind of reaction to trimethoprim before. I couldn't swear to it."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.74,
      "end_seconds": 123.41,
      "duration_seconds": 2.67,
      "text": "Really? I don't think so."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.92,
      "end_seconds": 132.8,
      "duration_seconds": 7.88,
      "text": "Alright, so that's unclear. I'll record what each of you said. Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.53,
      "end_seconds": 138.45,
      "duration_seconds": 3.92,
      "text": "It's aspirin, once a day for my heart."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.15,
      "end_seconds": 141.86,
      "duration_seconds": 2.71,
      "text": "Right, do you know the dose?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.5,
      "end_seconds": 143.57,
      "duration_seconds": 1.07,
      "text": "75 milligrams."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.43,
      "end_seconds": 147.83,
      "duration_seconds": 2.4,
      "text": "How long have you taken that?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.57,
      "end_seconds": 151.45,
      "duration_seconds": 1.88,
      "text": "About about a month."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.53,
      "end_seconds": 154.99,
      "duration_seconds": 1.46,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.59,
      "end_seconds": 159.86,
      "duration_seconds": 3.27,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.91,
      "end_seconds": 169.24,
      "duration_seconds": 1.33,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.7,
      "end_seconds": 173.89,
      "duration_seconds": 3.19,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.0,
      "end_seconds": 179.9,
      "duration_seconds": 1.9,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.67,
      "end_seconds": 185.77,
      "duration_seconds": 4.1,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.38,
      "end_seconds": 189.75,
      "duration_seconds": 2.37,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.39,
      "end_seconds": 193.58,
      "duration_seconds": 3.19,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.68,
      "end_seconds": 198.71,
      "duration_seconds": 3.03,
      "text": "Alright, anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.39,
      "end_seconds": 203.64,
      "duration_seconds": 3.25,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.97,
      "end_seconds": 220.97,
      "duration_seconds": 3.0,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.01,
      "end_seconds": 225.43,
      "duration_seconds": 2.42,
      "text": "I have high blood pressure."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.18,
      "end_seconds": 227.47,
      "duration_seconds": 1.29,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.36,
      "end_seconds": 233.35,
      "duration_seconds": 4.99,
      "text": "I've had heart disease for nearly five years now."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.87,
      "end_seconds": 252.67,
      "duration_seconds": 3.8,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.89,
      "end_seconds": 261.76,
      "duration_seconds": 2.87,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.23,
      "end_seconds": 290.21,
      "duration_seconds": 8.98,
      "text": "Okay: pressure 123 over 78, oxygen saturation is 98 percent, pulse is 82 beats a minute. And temperature is 36.7 degrees."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.64,
      "end_seconds": 293.0,
      "duration_seconds": 1.36,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.51,
      "end_seconds": 297.41,
      "duration_seconds": 3.9,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.38,
      "end_seconds": 303.31,
      "duration_seconds": 3.93,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.15,
      "end_seconds": 307.37,
      "duration_seconds": 2.22,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.64,
      "end_seconds": 319.83,
      "duration_seconds": 5.19,
      "text": "Your heart rate and rhythm are regular and the breastbone wound has healed."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.72,
      "end_seconds": 323.24,
      "duration_seconds": 1.52,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.27,
      "end_seconds": 338.15,
      "duration_seconds": 10.88,
      "text": "You can sit up now. Putting it all together, this looks most like recovering well after a heart attack. We shouldn't forget anxiety."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.86,
      "end_seconds": 341.88,
      "duration_seconds": 2.02,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.49,
      "end_seconds": 359.07,
      "duration_seconds": 16.58,
      "text": "I understand the worry. At the moment I'd say it's recovering well after a heart attack, and we'll watch how it goes. There's nothing new for me to start or arrange today. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 360.1,
      "end_seconds": 362.41,
      "duration_seconds": 2.31,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.07,
      "end_seconds": 364.52,
      "duration_seconds": 1.45,
      "text": "Goodbye for now."
    }
  ]
}