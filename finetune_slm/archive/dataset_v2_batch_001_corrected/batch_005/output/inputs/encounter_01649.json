{
  "schema_version": "1.0",
  "encounter_id": "01649",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.98,
      "end_seconds": 5.14,
      "duration_seconds": 4.16,
      "text": "Welcome. Make yourself comfortable. Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.84,
      "end_seconds": 13.24,
      "duration_seconds": 6.4,
      "text": "Let me think, I'm here because of a pulled muscle in my thigh."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.8,
      "end_seconds": 16.41,
      "duration_seconds": 1.61,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 17.2,
      "end_seconds": 23.37,
      "duration_seconds": 6.17,
      "text": "I'd say about a month. Actually, no, closer to six months."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.34,
      "end_seconds": 27.96,
      "duration_seconds": 2.62,
      "text": "Is it worse at certain times?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 29.84,
      "end_seconds": 32.84,
      "duration_seconds": 3.0,
      "text": "Yes, running. That makes it worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.46,
      "end_seconds": 36.77,
      "duration_seconds": 3.31,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 37.71,
      "end_seconds": 39.4,
      "duration_seconds": 1.69,
      "text": "Severe, I'd say."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.95,
      "end_seconds": 42.28,
      "duration_seconds": 2.33,
      "text": "Ah. Anything that improves it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.38,
      "end_seconds": 48.05,
      "duration_seconds": 3.67,
      "text": "Well, I get some relief from rest."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 49.47,
      "end_seconds": 51.48,
      "duration_seconds": 2.01,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 52.03,
      "end_seconds": 61.04,
      "duration_seconds": 9.01,
      "text": "It usually comes with a bit of bruising. Okay, so the bit of bruising? That's been for three weeks."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.61,
      "end_seconds": 66.34,
      "duration_seconds": 4.73,
      "text": "Okay, go on. I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.95,
      "end_seconds": 77.2,
      "duration_seconds": 3.25,
      "text": "Alright, keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.58,
      "end_seconds": 97.68,
      "duration_seconds": 8.1,
      "text": "Okay: respiratory rate 15, temperature 36.7, pulse is 74 beats a minute. And BP is 119 over 72."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.45,
      "end_seconds": 100.74,
      "duration_seconds": 2.29,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.5,
      "end_seconds": 105.22,
      "duration_seconds": 3.72,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.42,
      "end_seconds": 110.23,
      "duration_seconds": 3.81,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.42,
      "end_seconds": 113.49,
      "duration_seconds": 2.07,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.15,
      "end_seconds": 128.16,
      "duration_seconds": 7.01,
      "text": "There is mild tenderness in the back of the thigh and you can still straighten the knee fully."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.84,
      "end_seconds": 130.5,
      "duration_seconds": 1.66,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.42,
      "end_seconds": 136.29,
      "duration_seconds": 2.87,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.71,
      "end_seconds": 150.42,
      "duration_seconds": 3.71,
      "text": "Any fall, pop at the time or swelling?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.29,
      "end_seconds": 154.19,
      "duration_seconds": 2.9,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.39,
      "end_seconds": 158.19,
      "duration_seconds": 2.8,
      "text": "Right, has there been any numbness?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.97,
      "end_seconds": 160.37,
      "duration_seconds": 1.4,
      "text": "No. No numbness."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.22,
      "end_seconds": 163.19,
      "duration_seconds": 1.97,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.03,
      "end_seconds": 166.09,
      "duration_seconds": 1.06,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.23,
      "end_seconds": 169.91,
      "duration_seconds": 2.68,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.63,
      "end_seconds": 174.48,
      "duration_seconds": 3.85,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.43,
      "end_seconds": 177.02,
      "duration_seconds": 1.59,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 177.89,
      "end_seconds": 182.64,
      "duration_seconds": 4.75,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.6,
      "end_seconds": 187.03,
      "duration_seconds": 2.43,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 187.61,
      "end_seconds": 191.8,
      "duration_seconds": 4.19,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.05,
      "end_seconds": 196.06,
      "duration_seconds": 3.01,
      "text": "Alright, do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 197.58,
      "end_seconds": 206.05,
      "duration_seconds": 8.47,
      "text": "Yes, high cholesterol. I've got thin bones. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.82,
      "end_seconds": 211.35,
      "duration_seconds": 3.53,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 213.29,
      "end_seconds": 230.15,
      "duration_seconds": 16.86,
      "text": "I, I take rosuvastatin, 10 milligrams, at night. Alendronate, 70 milligrams, once a week for my bones. My family kept telling me to get it checked. I'm on ibuprofen gel, three times a day."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.21,
      "end_seconds": 235.17,
      "duration_seconds": 2.96,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 236.59,
      "end_seconds": 247.78,
      "duration_seconds": 11.19,
      "text": "Hmm, I had a mole taken off my arm a few years ago. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.91,
      "end_seconds": 251.4,
      "duration_seconds": 2.49,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 251.93,
      "end_seconds": 255.9,
      "duration_seconds": 3.97,
      "text": "Yes, erythromycin, it gives me a rash."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.06,
      "end_seconds": 274.06,
      "duration_seconds": 6.0,
      "text": "Okay, so my impression is this: I'd lean towards a mild hamstring strain."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 274.76,
      "end_seconds": 277.78,
      "duration_seconds": 3.02,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 279.45,
      "end_seconds": 285.64,
      "duration_seconds": 6.19,
      "text": "Nothing I've seen today points to an emergency. It looks like a mild hamstring strain."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.83,
      "end_seconds": 305.5,
      "duration_seconds": 11.67,
      "text": "Rest for a few days, ice it, and then ease back in with gentle stretching. Please come and see me if not better in two weeks."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 307.29,
      "end_seconds": 312.47,
      "duration_seconds": 5.18,
      "text": "I'll book your follow-up at the front desk on your way out."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 313.39,
      "end_seconds": 316.12,
      "duration_seconds": 2.73,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 317.19,
      "end_seconds": 320.26,
      "duration_seconds": 3.07,
      "text": "Great, thank you for your help."
    }
  ]
}