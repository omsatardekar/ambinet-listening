{
  "schema_version": "1.0",
  "encounter_id": "01776",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.09,
      "end_seconds": 4.07,
      "duration_seconds": 2.98,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.94,
      "end_seconds": 10.35,
      "duration_seconds": 4.41,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.32,
      "end_seconds": 18.4,
      "duration_seconds": 6.08,
      "text": "Actually, hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.99,
      "end_seconds": 23.89,
      "duration_seconds": 4.9,
      "text": "of course, please stay it's helpful to have you here"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.4,
      "end_seconds": 26.8,
      "duration_seconds": 2.4,
      "text": "It's a barking cough, mostly."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.46,
      "end_seconds": 30.81,
      "duration_seconds": 3.35,
      "text": "Okay, how long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.4,
      "end_seconds": 36.09,
      "duration_seconds": 4.69,
      "text": "it's, It's been about a week, I'm fairly sure"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.19,
      "end_seconds": 42.08,
      "duration_seconds": 3.89,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.38,
      "end_seconds": 44.49,
      "duration_seconds": 1.11,
      "text": "Moderate, really."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.42,
      "end_seconds": 50.96,
      "duration_seconds": 2.54,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.8,
      "end_seconds": 60.85,
      "duration_seconds": 9.05,
      "text": "when it starts I tend to get a runny nose as well oh, uh, and a hoarse voice"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.86,
      "end_seconds": 67.46,
      "duration_seconds": 4.6,
      "text": "Have you had any drooling or noisy breathing when resting?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.28,
      "end_seconds": 74.06,
      "duration_seconds": 5.78,
      "text": "Hmm, no drooling or noisy breathing when resting, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.98,
      "end_seconds": 78.49,
      "duration_seconds": 3.51,
      "text": "Have you had any difficulty swallowing or blue lips?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.98,
      "end_seconds": 84.5,
      "duration_seconds": 4.52,
      "text": "I mean, uh, no, nothing to report there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.84,
      "end_seconds": 89.18,
      "duration_seconds": 3.34,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.01,
      "end_seconds": 95.87,
      "duration_seconds": 5.86,
      "text": "Right, um, my heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.63,
      "end_seconds": 102.06,
      "duration_seconds": 4.43,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.67,
      "end_seconds": 107.5,
      "duration_seconds": 4.83,
      "text": "let me think, yes, amoxicillin, it gives me hives"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.37,
      "end_seconds": 113.09,
      "duration_seconds": 3.72,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.6,
      "end_seconds": 116.91,
      "duration_seconds": 2.31,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.82,
      "end_seconds": 122.39,
      "duration_seconds": 3.57,
      "text": "Right, any past operations I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.51,
      "end_seconds": 126.94,
      "duration_seconds": 3.43,
      "text": "just a triple bypass, eight years ago"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.33,
      "end_seconds": 131.11,
      "duration_seconds": 2.78,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.64,
      "end_seconds": 146.46,
      "duration_seconds": 13.82,
      "text": "I've got heart disease. Mm, I have diabetes, for about ten years. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.7,
      "end_seconds": 148.96,
      "duration_seconds": 1.26,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.69,
      "end_seconds": 154.51,
      "duration_seconds": 3.82,
      "text": "I quit smoking around ten years ago"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.8,
      "end_seconds": 157.07,
      "duration_seconds": 1.27,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.89,
      "end_seconds": 161.85,
      "duration_seconds": 2.96,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.03,
      "end_seconds": 165.2,
      "duration_seconds": 2.17,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.65,
      "end_seconds": 170.96,
      "duration_seconds": 4.31,
      "text": "Not much, I mostly stay in these days"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.72,
      "end_seconds": 176.13,
      "duration_seconds": 3.41,
      "text": "so, are you in work at the moment?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.1,
      "end_seconds": 181.58,
      "duration_seconds": 4.48,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.76,
      "end_seconds": 185.23,
      "duration_seconds": 2.47,
      "text": "is there someone at home?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.75,
      "end_seconds": 190.97,
      "duration_seconds": 4.22,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.78,
      "end_seconds": 195.93,
      "duration_seconds": 4.15,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 197.05,
      "end_seconds": 203.04,
      "duration_seconds": 5.99,
      "text": "Okay, uh, so she takes metoprolol, twice a day for my heart."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.08,
      "end_seconds": 207.3,
      "duration_seconds": 2.22,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 208.12,
      "end_seconds": 215.99,
      "duration_seconds": 7.87,
      "text": "50 milligrams. Let me think, uh, she takes gliclazide, 80 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.29,
      "end_seconds": 230.2,
      "duration_seconds": 2.91,
      "text": "let's start with the basic checks"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.49,
      "end_seconds": 241.52,
      "duration_seconds": 2.03,
      "text": "nearly done with the readings.."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.64,
      "end_seconds": 270.81,
      "duration_seconds": 12.17,
      "text": "Okay: pressure 124 over 74, temperature is 36.9 degrees, oxygen saturation is 99 percent, respiratory rate 15, pulse is 81 beats a minute."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.79,
      "end_seconds": 273.98,
      "duration_seconds": 2.19,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.04,
      "end_seconds": 278.4,
      "duration_seconds": 2.36,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.74,
      "end_seconds": 283.35,
      "duration_seconds": 3.61,
      "text": "Okay, time for me to to examine you."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.25,
      "end_seconds": 287.64,
      "duration_seconds": 2.39,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.65,
      "end_seconds": 303.15,
      "duration_seconds": 7.5,
      "text": "He is playful, breathing comfortably at rest, and I can't hear any noisy breathing now."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.81,
      "end_seconds": 311.19,
      "duration_seconds": 2.38,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.33,
      "end_seconds": 329.75,
      "duration_seconds": 6.42,
      "text": "So, based on the history and the examination, the most likely explanation is mild croup."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.28,
      "end_seconds": 363.71,
      "duration_seconds": 21.43,
      "text": "We'll begin with dexamethasone, 0.15 mg per kg, once, single dose. That should help with croup. Keep him calm, sit him upright, and give fluids. If he makes a noisy sound when resting or struggles to breathe, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 365.31,
      "end_seconds": 368.45,
      "duration_seconds": 3.14,
      "text": "Hmm, that's fine by me."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.15,
      "end_seconds": 379.03,
      "duration_seconds": 9.88,
      "text": "book a review if no better in two days before we finish, can you repeat the plan back to me?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 379.9,
      "end_seconds": 393.18,
      "duration_seconds": 13.28,
      "text": "So, I take the dexamethasone, 0.15 mg per kg, once and come back if no better in two days. Is that right?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 395.94,
      "end_seconds": 400.19,
      "duration_seconds": 4.25,
      "text": "Yes, exactly right. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 401.63,
      "end_seconds": 405.42,
      "duration_seconds": 3.79,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}