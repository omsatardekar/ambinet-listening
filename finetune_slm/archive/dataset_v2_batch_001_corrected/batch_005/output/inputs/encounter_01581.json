      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.19,
      "end_seconds": 266.98,
      "duration_seconds": 10.79,
      "text": "An urgent ECG is what I'd like next for fast heart rhythm. I'd rather check than guess and this is the quickest way to know more"
    },
