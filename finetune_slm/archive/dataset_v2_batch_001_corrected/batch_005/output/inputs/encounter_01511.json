{
  "schema_version": "1.0",
  "encounter_id": "01511",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.91,
      "end_seconds": 5.17,
      "duration_seconds": 4.26,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.01,
      "end_seconds": 10.21,
      "duration_seconds": 4.2,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.17,
      "end_seconds": 15.8,
      "duration_seconds": 4.63,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.58,
      "end_seconds": 26.17,
      "duration_seconds": 9.59,
      "text": "Well, I've been having watery diarrhoea and vomiting. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.04,
      "end_seconds": 29.36,
      "duration_seconds": 1.32,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.05,
      "end_seconds": 33.01,
      "duration_seconds": 1.96,
      "text": "Probably two days. Yeah."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.67,
      "end_seconds": 43.11,
      "duration_seconds": 9.44,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.22,
      "end_seconds": 51.24,
      "duration_seconds": 7.02,
      "text": "Severe, really. It happens every other day. I've been feeling very weak too."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.9,
      "end_seconds": 55.22,
      "duration_seconds": 2.32,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.94,
      "end_seconds": 60.75,
      "duration_seconds": 4.81,
      "text": "Yes, I had a triple bypass, eight years ago."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.84,
      "end_seconds": 66.62,
      "duration_seconds": 4.78,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.1,
      "end_seconds": 70.71,
      "duration_seconds": 2.61,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.83,
      "end_seconds": 84.1,
      "duration_seconds": 3.27,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 85.21,
      "end_seconds": 93.79,
      "duration_seconds": 8.58,
      "text": "She is on losartan, once a day for my blood pressure, I give it to her."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.65,
      "end_seconds": 97.74,
      "duration_seconds": 2.09,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 99.84,
      "end_seconds": 118.77,
      "duration_seconds": 18.93,
      "text": "50 milligrams, I think that's what's on the box. It's clopidogrel, 75 milligrams, once a day for the stent, doctor. She is on oral rehydration salts, after each loose stool, I give it to her."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.37,
      "end_seconds": 122.62,
      "duration_seconds": 2.25,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 123.67,
      "end_seconds": 125.15,
      "duration_seconds": 1.48,
      "text": "It's 1 sachet."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.93,
      "end_seconds": 128.57,
      "duration_seconds": 1.64,
      "text": "And for how long?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 129.82,
      "end_seconds": 131.79,
      "duration_seconds": 1.97,
      "text": "About about a month."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.32,
      "end_seconds": 142.83,
      "duration_seconds": 2.51,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.01,
      "end_seconds": 146.26,
      "duration_seconds": 2.25,
      "text": "Yes, high blood pressure."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.13,
      "end_seconds": 148.05,
      "duration_seconds": 0.92,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.86,
      "end_seconds": 151.62,
      "duration_seconds": 1.76,
      "text": "Yes, heart disease."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.47,
      "end_seconds": 155.91,
      "duration_seconds": 2.44,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.19,
      "end_seconds": 171.77,
      "duration_seconds": 14.58,
      "text": "I drink a lot of tea and snack through the day. I retired from the post office two years ago. Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.13,
      "end_seconds": 183.93,
      "duration_seconds": 2.8,
      "text": "Have you noticed fever or chest pain?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.85,
      "end_seconds": 188.91,
      "duration_seconds": 4.06,
      "text": "I haven't had fever or chest pain, no."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.04,
      "end_seconds": 193.9,
      "duration_seconds": 3.86,
      "text": "Have you noticed blood in the stool or confusion?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.13,
      "end_seconds": 201.07,
      "duration_seconds": 5.94,
      "text": "Oh, no blood in the stool or confusion, none of it."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.03,
      "end_seconds": 206.96,
      "duration_seconds": 3.93,
      "text": "So, on the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.67,
      "end_seconds": 210.23,
      "duration_seconds": 1.56,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.97,
      "end_seconds": 215.84,
      "duration_seconds": 3.87,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.79,
      "end_seconds": 221.39,
      "duration_seconds": 3.6,
      "text": "Yeah, you know, no, that's all normal."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.79,
      "end_seconds": 225.6,
      "duration_seconds": 2.81,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.24,
      "end_seconds": 236.27,
      "duration_seconds": 2.03,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.49,
      "end_seconds": 266.23,
      "duration_seconds": 11.74,
      "text": "Okay: pressure 94 over 65, height 154 centimetres, weight 76 kilos, temperature is 37.1 degrees, pulse 102, respiratory rate 16, BMI works out to 32.0."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.25,
      "end_seconds": 268.64,
      "duration_seconds": 1.39,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.57,
      "end_seconds": 273.35,
      "duration_seconds": 2.78,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.06,
      "end_seconds": 278.43,
      "duration_seconds": 2.37,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.5,
      "end_seconds": 282.24,
      "duration_seconds": 1.74,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.48,
      "end_seconds": 285.99,
      "duration_seconds": 2.51,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.98,
      "end_seconds": 311.64,
      "duration_seconds": 6.66,
      "text": "Your mouth is dry, your skin is slack, and your blood pressure drops when you stand."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.96,
      "end_seconds": 337.59,
      "duration_seconds": 23.63,
      "text": "Alright, good, you can sit up again. I'll request blood tests, it'll help with dehydration. Sip fluids little and often and hold your water tablet until you are eating again. If the symptoms get worse, or you feel really unwell, please come to the emergency department. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.57,
      "end_seconds": 342.05,
      "duration_seconds": 2.48,
      "text": "Alright, thanks, take care."
    }
  ]
}