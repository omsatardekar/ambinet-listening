  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.78,
      "end_seconds": 3.71,
      "duration_seconds": 2.93,
      "text": "Good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.3,
      "end_seconds": 8.33,
      "duration_seconds": 3.03,
      "text": "Hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.89,
      "end_seconds": 15.31,
      "duration_seconds": 2.42,
      "text": "Have you been waiting long?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 17.17,
      "end_seconds": 20.1,
      "duration_seconds": 2.93,
      "text": "Only about ten minutes, no trouble."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.61,
      "end_seconds": 24.82,
      "duration_seconds": 3.21,
      "text": "So what can I do for you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.19,
      "end_seconds": 30.48,
      "duration_seconds": 4.29,
      "text": "I've been putting on weight over the years."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.0,
      "end_seconds": 35.33,
      "duration_seconds": 3.33,
      "text": "Have you been getting out of breath?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 35.85,
      "end_seconds": 38.32,
      "duration_seconds": 2.47,
      "text": "Mm, you know, yes."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.3,
      "end_seconds": 40.72,
      "duration_seconds": 1.42,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.52,
      "end_seconds": 44.91,
      "duration_seconds": 2.39,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.93,
      "end_seconds": 64.23,
      "duration_seconds": 3.3,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.01,
      "end_seconds": 69.01,
      "duration_seconds": 4.0,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.35,
      "end_seconds": 80.0,
      "duration_seconds": 2.65,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.56,
      "end_seconds": 83.77,
      "duration_seconds": 3.21,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.4,
      "end_seconds": 87.79,
      "duration_seconds": 3.39,
      "text": "Okay, what do you do during the day?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.48,
      "end_seconds": 92.07,
      "duration_seconds": 3.59,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.11,
      "end_seconds": 95.82,
      "duration_seconds": 2.71,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.75,
      "end_seconds": 100.26,
      "duration_seconds": 3.51,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.77,
      "end_seconds": 104.95,
      "duration_seconds": 3.18,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 106.38,
      "end_seconds": 109.8,
      "duration_seconds": 3.42,
      "text": "It's amlodipine, 5 milligrams, once a day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.26,
      "end_seconds": 114.37,
      "duration_seconds": 3.11,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 116.18,
      "end_seconds": 118.5,
      "duration_seconds": 2.32,
      "text": "Yes, high blood pressure."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.28,
      "end_seconds": 122.86,
      "duration_seconds": 3.58,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.73,
      "end_seconds": 125.98,
      "duration_seconds": 2.25,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.32,
      "end_seconds": 132.42,
      "duration_seconds": 5.1,
      "text": "Have you had any palpitations, high thirst, chest pain or low mood?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.62,
      "end_seconds": 143.54,
      "duration_seconds": 5.92,
      "text": "I haven't had palpitations, high thirst, chest pain or low mood, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.73,
      "end_seconds": 147.63,
      "duration_seconds": 2.9,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 152.82,
      "end_seconds": 154.52,
      "duration_seconds": 1.7,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.93,
      "end_seconds": 170.41,
      "duration_seconds": 2.48,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.56,
      "end_seconds": 179.7,
      "duration_seconds": 2.14,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.18,
      "end_seconds": 198.69,
      "duration_seconds": 8.51,
      "text": "Okay: pressure 159 over 90, respiratory rate 15, heart rate 84. And oxygen saturation is 99 percent."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.66,
      "end_seconds": 203.64,
      "duration_seconds": 2.98,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 205.34,
      "end_seconds": 207.0,
      "duration_seconds": 1.66,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.51,
      "end_seconds": 209.99,
      "duration_seconds": 1.48,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.48,
      "end_seconds": 227.06,
      "duration_seconds": 4.58,
      "text": "Your weight and waist measurement are both above the healthy range."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.08,
      "end_seconds": 245.65,
      "duration_seconds": 16.57,
      "text": "All finished, thank you. Let me tell you where I've got to. I think we're dealing with obesity with weight-related symptoms at this stage. I'd also keep an underactive thyroid in mind. I want an HbA1c done, that's for obesity."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 247.45,
      "end_seconds": 249.4,
      "duration_seconds": 1.95,
      "text": "Okay, I'll do it."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.16,
      "end_seconds": 260.8,
      "duration_seconds": 9.64,
      "text": "I'm going to order a thyroid test, for weight gain. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 262.01,
      "end_seconds": 263.5,
      "duration_seconds": 1.49,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.15,
      "end_seconds": 287.55,
      "duration_seconds": 23.4,
      "text": "Aim for a loss of half a kilo a week with smaller portions and a daily thirty-minute walk. Let's hold off on a cholesterol test for now, and if there's no change in two weeks we can revisit it. Do get help quickly if the symptoms get worse."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 288.36,
      "end_seconds": 289.3,
      "duration_seconds": 0.94,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.96,
      "end_seconds": 293.78,
      "duration_seconds": 2.82,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 295.5,
      "end_seconds": 298.94,
      "duration_seconds": 3.44,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 300.29,
      "end_seconds": 301.7,
      "duration_seconds": 1.41,
      "text": "Look after yourself."
    }
  ]
