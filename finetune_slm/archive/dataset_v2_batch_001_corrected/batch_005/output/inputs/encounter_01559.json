{
  "schema_version": "1.0",
  "encounter_id": "01559",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.35,
      "end_seconds": 5.59,
      "duration_seconds": 4.24,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.97,
      "end_seconds": 10.89,
      "duration_seconds": 3.92,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.17,
      "end_seconds": 16.86,
      "duration_seconds": 4.69,
      "text": "so, good morning, doctor i came along to help out"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.16,
      "end_seconds": 22.19,
      "duration_seconds": 4.03,
      "text": "I'm here because of being confused and drowsy."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.14,
      "end_seconds": 27.89,
      "duration_seconds": 3.75,
      "text": "can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.75,
      "end_seconds": 31.82,
      "duration_seconds": 2.07,
      "text": "About... well, one week."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.06,
      "end_seconds": 35.82,
      "duration_seconds": 2.76,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.78,
      "end_seconds": 48.66,
      "duration_seconds": 10.88,
      "text": "I'd say mild. I've had being extremely thirsty too, for about a month. As for being extremely thirsty, severe, I'd say."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.63,
      "end_seconds": 60.71,
      "duration_seconds": 4.08,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.89,
      "end_seconds": 75.27,
      "duration_seconds": 2.38,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.47,
      "end_seconds": 95.19,
      "duration_seconds": 6.72,
      "text": "okay: temperature is 36.6 degrees, pressure 113 over 72, pulse is 117 beats a minute"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.64,
      "end_seconds": 101.06,
      "duration_seconds": 3.42,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.94,
      "end_seconds": 104.71,
      "duration_seconds": 2.77,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.61,
      "end_seconds": 126.78,
      "duration_seconds": 6.17,
      "text": "You are very dry and drowsy, and your sugar reading is too high to read."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.33,
      "end_seconds": 134.84,
      "duration_seconds": 2.51,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.5,
      "end_seconds": 150.67,
      "duration_seconds": 1.17,
      "text": "How about fever?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.07,
      "end_seconds": 155.55,
      "duration_seconds": 3.48,
      "text": "Not that I've noticed, no fever."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.14,
      "end_seconds": 161.57,
      "duration_seconds": 4.43,
      "text": "Let me check a few things. Any chest pain or vomiting?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.68,
      "end_seconds": 165.06,
      "duration_seconds": 2.38,
      "text": "no, none that I've noticed"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.52,
      "end_seconds": 169.33,
      "duration_seconds": 2.81,
      "text": "anything different when you pass water?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.47,
      "end_seconds": 174.37,
      "duration_seconds": 3.9,
      "text": "Right, that's normal as far as I know."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.59,
      "end_seconds": 184.35,
      "duration_seconds": 2.76,
      "text": "right, what about your medical history?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.9,
      "end_seconds": 189.38,
      "duration_seconds": 3.48,
      "text": "I have diabetes, for about ten years"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.17,
      "end_seconds": 191.87,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.48,
      "end_seconds": 195.97,
      "duration_seconds": 2.49,
      "text": "Eczema, for about ten years"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.03,
      "end_seconds": 202.57,
      "duration_seconds": 5.54,
      "text": "I see, go ahead okay, have you got any known allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.23,
      "end_seconds": 209.01,
      "duration_seconds": 4.78,
      "text": "Yes, tramadol, it gives me feeling very drowsy."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.06,
      "end_seconds": 213.75,
      "duration_seconds": 2.69,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.78,
      "end_seconds": 223.06,
      "duration_seconds": 4.28,
      "text": "Yes, I had my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.36,
      "end_seconds": 225.57,
      "duration_seconds": 1.21,
      "text": "what about alcohol?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.62,
      "end_seconds": 231.02,
      "duration_seconds": 4.4,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.02,
      "end_seconds": 233.81,
      "duration_seconds": 1.79,
      "text": "Alright, do you smoke?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.19,
      "end_seconds": 238.57,
      "duration_seconds": 3.38,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.02,
      "end_seconds": 241.22,
      "duration_seconds": 1.2,
      "text": "are you active?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.64,
      "end_seconds": 245.93,
      "duration_seconds": 3.29,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.62,
      "end_seconds": 248.08,
      "duration_seconds": 1.46,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.74,
      "end_seconds": 253.07,
      "duration_seconds": 3.33,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.87,
      "end_seconds": 257.24,
      "duration_seconds": 2.37,
      "text": "Okay, how are your meals?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.03,
      "end_seconds": 263.56,
      "duration_seconds": 4.53,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.34,
      "end_seconds": 270.53,
      "duration_seconds": 3.19,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.28,
      "end_seconds": 274.83,
      "duration_seconds": 2.55,
      "text": "my father has Parkinson's disease"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.36,
      "end_seconds": 279.76,
      "duration_seconds": 3.4,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 280.55,
      "end_seconds": 285.82,
      "duration_seconds": 5.27,
      "text": "it's Glycomet, 500 milligrams, twice a day for my sugar, doctor"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.05,
      "end_seconds": 314.1,
      "duration_seconds": 27.05,
      "text": "From what you've told me and what I found, I think we're dealing with a hyperosmolar diabetic emergency at this stage. I'd like to arrange urgent blood tests for hyperglycaemic emergency. You need hospital now for fluids and insulin. Let's hold off on an ECG for now, and if there's no change in a month we can revisit it. I'll want another look straight away."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.58,
      "end_seconds": 316.28,
      "duration_seconds": 0.7,
      "text": "sure"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.66,
      "end_seconds": 322.33,
      "duration_seconds": 3.67,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.15,
      "end_seconds": 325.19,
      "duration_seconds": 2.04,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.18,
      "end_seconds": 328.53,
      "duration_seconds": 1.35,
      "text": "Look after yourself."
    }
  ]
}