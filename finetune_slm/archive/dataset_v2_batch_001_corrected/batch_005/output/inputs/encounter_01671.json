  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.11,
      "end_seconds": 6.91,
      "duration_seconds": 5.8,
      "text": "mm, hi, doctor, I hope I'm not disturbing you"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.23,
      "end_seconds": 12.74,
      "duration_seconds": 4.51,
      "text": "that's fine, sit down tell me why you came"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.08,
      "end_seconds": 19.07,
      "duration_seconds": 4.99,
      "text": "So, I've been feeling suddenly very hungry, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.74,
      "end_seconds": 22.69,
      "duration_seconds": 2.95,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.96,
      "end_seconds": 44.7,
      "duration_seconds": 20.74,
      "text": "I've had it for about three months. I did try to ignore it for a while. Erm, and I've been sweating as well. I, I had being confused for a minute before. That's settled now, though."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.01,
      "end_seconds": 48.47,
      "duration_seconds": 2.46,
      "text": "Any seizure or vomiting at all?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.16,
      "end_seconds": 54.02,
      "duration_seconds": 3.86,
      "text": "No seizure or vomiting, none of it."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.56,
      "end_seconds": 57.72,
      "duration_seconds": 3.16,
      "text": "yes. Any loss of consciousness or chest pain?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.11,
      "end_seconds": 66.37,
      "duration_seconds": 7.26,
      "text": "Erm, uh, no loss of consciousness or chest pain, none of it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.8,
      "end_seconds": 70.69,
      "duration_seconds": 2.89,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.05,
      "end_seconds": 75.92,
      "duration_seconds": 3.87,
      "text": "Let me think, no problems with breathing."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.72,
      "end_seconds": 94.29,
      "duration_seconds": 4.57,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.4,
      "end_seconds": 99.67,
      "duration_seconds": 4.27,
      "text": "Erm, no, not that I know of."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.57,
      "end_seconds": 103.56,
      "duration_seconds": 1.99,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.26,
      "end_seconds": 114.21,
      "duration_seconds": 8.95,
      "text": "yes, um, I had a a meniscus repair on my knee, four years ago"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.94,
      "end_seconds": 119.31,
      "duration_seconds": 4.37,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.95,
      "end_seconds": 135.31,
      "duration_seconds": 14.36,
      "text": "I've got diabetes. My neighbour said I should get it it looked at. I've, I've had heart disease, yes. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.93,
      "end_seconds": 146.95,
      "duration_seconds": 10.02,
      "text": "I see, go ahead. Yes, heart disease is known to us, good to have that clear. Let's run through your medicines."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.14,
      "end_seconds": 149.99,
      "duration_seconds": 1.85,
      "text": "Glibenclamide, before breakfast."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.09,
      "end_seconds": 153.49,
      "duration_seconds": 2.4,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.0,
      "end_seconds": 161.81,
      "duration_seconds": 6.81,
      "text": "5 milligrams. Metoprolol, 50 milligrams, twice a day for my heart."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.33,
      "end_seconds": 174.41,
      "duration_seconds": 3.08,
      "text": "right, is there someone at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.24,
      "end_seconds": 179.47,
      "duration_seconds": 4.23,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.47,
      "end_seconds": 183.52,
      "duration_seconds": 3.05,
      "text": "Right, anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.37,
      "end_seconds": 188.02,
      "duration_seconds": 3.65,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.45,
      "end_seconds": 190.82,
      "duration_seconds": 1.37,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.68,
      "end_seconds": 195.18,
      "duration_seconds": 3.5,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.52,
      "end_seconds": 200.28,
      "duration_seconds": 3.76,
      "text": "what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.95,
      "end_seconds": 207.58,
      "duration_seconds": 5.63,
      "text": "sorry, what was I saying, my cousin has psoriasis"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.01,
      "end_seconds": 228.53,
      "duration_seconds": 2.52,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.58,
      "end_seconds": 239.32,
      "duration_seconds": 2.74,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.8,
      "end_seconds": 267.78,
      "duration_seconds": 6.98,
      "text": "Okay: pulse is 113 beats a minute, saturation 99 percent, blood pressure 128 over 79."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.91,
      "end_seconds": 272.69,
      "duration_seconds": 3.78,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.64,
      "end_seconds": 277.89,
      "duration_seconds": 3.25,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.68,
      "end_seconds": 299.71,
      "duration_seconds": 8.03,
      "text": "Your sugar reading in clinic is on the low side and and your pulse is a little fast."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.82,
      "end_seconds": 318.04,
      "duration_seconds": 15.22,
      "text": "So, that's the the examination finished. Let me tell you where I've got to. My working impression is recurrent low blood sugar on insulin. A dose that is too high is also on my list."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.5,
      "end_seconds": 322.47,
      "duration_seconds": 2.97,
      "text": "Well, is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.71,
      "end_seconds": 335.03,
      "duration_seconds": 11.32,
      "text": "it's reasonable to be concerned, but right now recurrent low blood sugar on insulin is my leading thought, not anything worse let's get an HbA1c, for diabetes review"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 336.92,
      "end_seconds": 339.22,
      "duration_seconds": 2.3,
      "text": "The earliest is Thursday, 9 am."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.96,
      "end_seconds": 358.35,
      "duration_seconds": 17.39,
      "text": "I'm prescribing insulin glargine, 16 units, once a day at bedtime, long term that's for diabetes always carry sugar and eat something before exercise let's get you seen by the diabetes team, I'll arrange the letter"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 360.41,
      "end_seconds": 361.11,
      "duration_seconds": 0.7,
      "text": "okay"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.7,
      "end_seconds": 379.19,
      "duration_seconds": 16.49,
      "text": "One warning sign to remember: the symptoms get worse. In that case don't wait. Let's review you in two weeks. Let me check I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 381.18,
      "end_seconds": 394.01,
      "duration_seconds": 12.83,
      "text": "So, I take the insulin glargine, 16 units, once a day at bedtime and come back in two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 395.15,
      "end_seconds": 401.28,
      "duration_seconds": 6.13,
      "text": "yes, exactly right. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 402.03,
      "end_seconds": 403.75,
      "duration_seconds": 1.72,
      "text": "That's clear, thanks."
    }
  ]
}