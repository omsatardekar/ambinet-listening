{
  "schema_version": "1.0",
  "encounter_id": "01893",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.31,
      "end_seconds": 6.91,
      "duration_seconds": 5.6,
      "text": "Sorry, what was I saying, hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.9,
      "end_seconds": 12.88,
      "duration_seconds": 4.98,
      "text": "You're alright, take a a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.74,
      "end_seconds": 17.51,
      "duration_seconds": 2.77,
      "text": "I've been feeling low most days."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.51,
      "end_seconds": 24.5,
      "duration_seconds": 1.99,
      "text": "Right, since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.72,
      "end_seconds": 29.12,
      "duration_seconds": 3.4,
      "text": "It's been going on for two months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.38,
      "end_seconds": 34.47,
      "duration_seconds": 5.09,
      "text": "hm, okay rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.56,
      "end_seconds": 38.92,
      "duration_seconds": 3.36,
      "text": "About a five out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.66,
      "end_seconds": 48.26,
      "duration_seconds": 3.6,
      "text": "Has there been no interest in things too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.28,
      "end_seconds": 53.91,
      "duration_seconds": 4.63,
      "text": "Yes, actually. About no interest in things, mostly mild."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.87,
      "end_seconds": 66.03,
      "duration_seconds": 3.16,
      "text": "have you had any thoughts of harming myself?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.57,
      "end_seconds": 69.97,
      "duration_seconds": 3.4,
      "text": "No, none, no thoughts of harming myself."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.48,
      "end_seconds": 76.01,
      "duration_seconds": 5.53,
      "text": "have you had any panic attacks, hearing voices or drinking more?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.64,
      "end_seconds": 79.1,
      "duration_seconds": 2.46,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.8,
      "end_seconds": 83.33,
      "duration_seconds": 2.53,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.06,
      "end_seconds": 87.8,
      "duration_seconds": 2.74,
      "text": "no, my breathing's been fine"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.84,
      "end_seconds": 92.47,
      "duration_seconds": 2.63,
      "text": "anything different when you pass water?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.4,
      "end_seconds": 96.99,
      "duration_seconds": 3.59,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.03,
      "end_seconds": 100.77,
      "duration_seconds": 2.74,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.12,
      "end_seconds": 105.44,
      "duration_seconds": 3.32,
      "text": "I have epilepsy, for two years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.19,
      "end_seconds": 116.19,
      "duration_seconds": 6.0,
      "text": "Right, so epilepsy is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.85,
      "end_seconds": 135.65,
      "duration_seconds": 3.8,
      "text": "what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.55,
      "end_seconds": 139.78,
      "duration_seconds": 2.23,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.78,
      "end_seconds": 146.72,
      "duration_seconds": 2.94,
      "text": "any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.21,
      "end_seconds": 149.33,
      "duration_seconds": 1.12,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.31,
      "end_seconds": 152.35,
      "duration_seconds": 2.04,
      "text": "Right, what about alcohol?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.16,
      "end_seconds": 159.64,
      "duration_seconds": 5.48,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.73,
      "end_seconds": 164.76,
      "duration_seconds": 4.03,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.92,
      "end_seconds": 169.84,
      "duration_seconds": 3.92,
      "text": "Lots of rice, lentils and some fruit"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.76,
      "end_seconds": 174.12,
      "duration_seconds": 2.36,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.62,
      "end_seconds": 179.69,
      "duration_seconds": 4.07,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.72,
      "end_seconds": 182.66,
      "duration_seconds": 1.94,
      "text": "who lives with you?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.0,
      "end_seconds": 189.79,
      "duration_seconds": 2.79,
      "text": "My partner and our baby"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.39,
      "end_seconds": 193.87,
      "duration_seconds": 2.48,
      "text": "let me quickly check your readings"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.13,
      "end_seconds": 202.36,
      "duration_seconds": 2.23,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.95,
      "end_seconds": 227.45,
      "duration_seconds": 9.5,
      "text": "Okay: pulse is 69 beats a a minute, blood pressure 110 over 73, temperature 36.6, SpO2 99 percent on room air."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.96,
      "end_seconds": 232.38,
      "duration_seconds": 3.42,
      "text": "Hmm, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.08,
      "end_seconds": 239.5,
      "duration_seconds": 3.42,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.3,
      "end_seconds": 243.7,
      "duration_seconds": 2.4,
      "text": "may I examine you now?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.1,
      "end_seconds": 246.94,
      "duration_seconds": 1.84,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.52,
      "end_seconds": 260.41,
      "duration_seconds": 5.89,
      "text": "You are tearful and speaking slowly, but you are following everything well."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.45,
      "end_seconds": 265.27,
      "duration_seconds": 1.82,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.08,
      "end_seconds": 280.5,
      "duration_seconds": 6.42,
      "text": "Okay, so my impression is this: This looks most like a moderate depressive episode."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.13,
      "end_seconds": 283.82,
      "duration_seconds": 2.69,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.34,
      "end_seconds": 296.57,
      "duration_seconds": 11.23,
      "text": "I can't promise yet, but most people with a moderate depressive episode do well once it's treated properly. I'd like to arrange a thyroid test for low mood"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.01,
      "end_seconds": 300.76,
      "duration_seconds": 2.75,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.78,
      "end_seconds": 312.41,
      "duration_seconds": 8.63,
      "text": "We should do a blood count for tiredness. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.37,
      "end_seconds": 316.6,
      "duration_seconds": 2.23,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.22,
      "end_seconds": 341.22,
      "duration_seconds": 24.0,
      "text": "What I'm giving you is sertraline, 50 milligrams, once a day in the morning, long term. It's for low mood. Try a short walk each day and keep a regular sleep routine. Cut down on salt and fried food for now, it really does make a difference. Let's get you seen by the talking therapy service, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.74,
      "end_seconds": 343.25,
      "duration_seconds": 1.51,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.83,
      "end_seconds": 350.76,
      "duration_seconds": 5.93,
      "text": "If you have thoughts of harming yourself, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.62,
      "end_seconds": 354.17,
      "duration_seconds": 1.55,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.33,
      "end_seconds": 361.15,
      "duration_seconds": 2.82,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 365.63,
      "end_seconds": 367.76,
      "duration_seconds": 2.13,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}