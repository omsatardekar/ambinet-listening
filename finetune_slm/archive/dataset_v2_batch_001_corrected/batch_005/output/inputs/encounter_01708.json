{
  "schema_version": "1.0",
  "encounter_id": "01708",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.59,
      "end_seconds": 4.52,
      "duration_seconds": 3.93,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.6,
      "end_seconds": 10.4,
      "duration_seconds": 4.8,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.83,
      "end_seconds": 16.49,
      "duration_seconds": 4.66,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.97,
      "end_seconds": 21.0,
      "duration_seconds": 3.03,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 21.63,
      "end_seconds": 26.71,
      "duration_seconds": 5.08,
      "text": "He's been having an upset stomach in the mornings, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.94,
      "end_seconds": 30.91,
      "duration_seconds": 2.97,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.77,
      "end_seconds": 46.22,
      "duration_seconds": 2.45,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.86,
      "end_seconds": 68.99,
      "duration_seconds": 12.13,
      "text": "Okay: SpO2 99 percent on room air, blood pressure 123 over 75, heart rate 86, weight 58 kilos, height 163 centimetres, temperature 36.5."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.53,
      "end_seconds": 72.11,
      "duration_seconds": 2.58,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.61,
      "end_seconds": 81.1,
      "duration_seconds": 7.49,
      "text": "Right, they help me see the whole picture, more shortly. Is there anything else with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.52,
      "end_seconds": 92.13,
      "duration_seconds": 9.61,
      "text": "Poor sleep goes along with it, most of the time. There's drinking most nights as well."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.67,
      "end_seconds": 95.95,
      "duration_seconds": 2.28,
      "text": "Any sign of black stools?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.21,
      "end_seconds": 102.15,
      "duration_seconds": 4.94,
      "text": "Mm, no, I haven't had any black stools."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.66,
      "end_seconds": 108.29,
      "duration_seconds": 5.63,
      "text": "Mm, okay. Have you had any yellow eyes, vomiting blood or confusion?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.09,
      "end_seconds": 114.44,
      "duration_seconds": 5.35,
      "text": "I haven't had yellow eyes, vomiting blood or confusion, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.45,
      "end_seconds": 118.78,
      "duration_seconds": 3.33,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.69,
      "end_seconds": 121.76,
      "duration_seconds": 2.07,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.88,
      "end_seconds": 125.81,
      "duration_seconds": 2.93,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.59,
      "end_seconds": 129.15,
      "duration_seconds": 1.56,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.33,
      "end_seconds": 142.67,
      "duration_seconds": 2.34,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.51,
      "end_seconds": 148.36,
      "duration_seconds": 4.85,
      "text": "Mm, just a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.15,
      "end_seconds": 153.83,
      "duration_seconds": 3.68,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.2,
      "end_seconds": 160.88,
      "duration_seconds": 5.68,
      "text": "Let me think, no, not that I know of."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 162.31,
      "end_seconds": 168.98,
      "duration_seconds": 6.67,
      "text": "Oh, I'm not sure that's right. I seem to recall a problem with amoxicillin."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.64,
      "end_seconds": 175.07,
      "duration_seconds": 4.43,
      "text": "Actually, maybe, but I don't recall it."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.47,
      "end_seconds": 183.2,
      "duration_seconds": 6.73,
      "text": "Fair enough, I'll write down both versions. Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.89,
      "end_seconds": 187.82,
      "duration_seconds": 2.93,
      "text": "Heart disease, for five years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.22,
      "end_seconds": 190.39,
      "duration_seconds": 1.17,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.02,
      "end_seconds": 192.82,
      "duration_seconds": 1.8,
      "text": "Yes, acid reflux."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.56,
      "end_seconds": 198.43,
      "duration_seconds": 4.87,
      "text": "Mm, okay. Okay, are you on your own at home?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.67,
      "end_seconds": 203.3,
      "duration_seconds": 3.63,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.93,
      "end_seconds": 207.23,
      "duration_seconds": 3.3,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.05,
      "end_seconds": 215.35,
      "duration_seconds": 4.3,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.68,
      "end_seconds": 223.32,
      "duration_seconds": 3.64,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.04,
      "end_seconds": 227.9,
      "duration_seconds": 3.86,
      "text": "It's clopidogrel, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 229.99,
      "end_seconds": 242.1,
      "duration_seconds": 12.11,
      "text": "Sorry, what was I saying, doctor, I think the last prescription for the clopidogrel was 150 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.66,
      "end_seconds": 249.7,
      "duration_seconds": 4.04,
      "text": "Hm. Do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.56,
      "end_seconds": 265.31,
      "duration_seconds": 13.75,
      "text": "Sorry, uh, what was I saying, I don't think I have it with me. I'm on omeprazole, 20 milligrams, once a day for the reflux."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.2,
      "end_seconds": 290.46,
      "duration_seconds": 12.26,
      "text": "Okay, so my impression from what you've said is this: This looks most like harmful alcohol use with liver strain. I'd also keep fatty liver in mind."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.2,
      "end_seconds": 294.2,
      "duration_seconds": 3.0,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.74,
      "end_seconds": 305.35,
      "duration_seconds": 9.61,
      "text": "I can't promise yet, but most people with harmful alcohol use with liver strain do well once it's treated properly."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.62,
      "end_seconds": 323.88,
      "duration_seconds": 4.26,
      "text": "Have you had any tests for this so far?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.61,
      "end_seconds": 333.92,
      "duration_seconds": 8.31,
      "text": "I did have an ultrasound of the liver done last year, but the paper's at home."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.84,
      "end_seconds": 351.79,
      "duration_seconds": 16.95,
      "text": "Cut down gradually and do not stop suddenly on your own if you drink heavily. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 355.74,
      "end_seconds": 356.96,
      "duration_seconds": 1.22,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.22,
      "end_seconds": 365.07,
      "duration_seconds": 6.85,
      "text": "I'll want another look after the tests. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 366.64,
      "end_seconds": 370.73,
      "duration_seconds": 4.09,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 372.01,
      "end_seconds": 374.0,
      "duration_seconds": 1.99,
      "text": "Alright, see you soon."
    }
  ]
}