{
  "schema_version": "1.0",
  "encounter_id": "01949",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.72,
      "end_seconds": 4.24,
      "duration_seconds": 3.52,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.22,
      "end_seconds": 10.45,
      "duration_seconds": 5.23,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 15.56,
      "end_seconds": 24.88,
      "duration_seconds": 9.32,
      "text": "Sorry, what was I saying, good afternoon, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.73,
      "end_seconds": 29.8,
      "duration_seconds": 4.07,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 30.82,
      "end_seconds": 35.64,
      "duration_seconds": 4.82,
      "text": "Doctor, it's watery diarrhoea and vomiting. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.64,
      "end_seconds": 40.78,
      "duration_seconds": 3.14,
      "text": "What do you do to make it better?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.67,
      "end_seconds": 46.3,
      "duration_seconds": 4.63,
      "text": "Only sips of water, um, and it's not much."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.6,
      "end_seconds": 51.47,
      "duration_seconds": 4.87,
      "text": "Hm, okay. Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.53,
      "end_seconds": 55.81,
      "duration_seconds": 2.28,
      "text": "It feels severe to me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.9,
      "end_seconds": 60.78,
      "duration_seconds": 2.88,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.97,
      "end_seconds": 68.77,
      "duration_seconds": 3.8,
      "text": "I'd say a couple of times a week."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.08,
      "end_seconds": 69.86,
      "duration_seconds": 0.78,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.69,
      "end_seconds": 76.74,
      "duration_seconds": 6.05,
      "text": "I was passing little urine at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.31,
      "end_seconds": 83.31,
      "duration_seconds": 6.0,
      "text": "Have you had watery diarrhoea and vomiting before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.25,
      "end_seconds": 90.61,
      "duration_seconds": 6.36,
      "text": "I had a similar thing a couple of years ago. It went away."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.47,
      "end_seconds": 94.86,
      "duration_seconds": 3.39,
      "text": "Any blood in the stool or fever?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.7,
      "end_seconds": 101.16,
      "duration_seconds": 4.46,
      "text": "No, no blood in the stool or fever."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.82,
      "end_seconds": 106.86,
      "duration_seconds": 4.04,
      "text": "So, any confusion or chest pain at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.53,
      "end_seconds": 109.74,
      "duration_seconds": 2.21,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.7,
      "end_seconds": 114.08,
      "duration_seconds": 3.38,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.11,
      "end_seconds": 116.7,
      "duration_seconds": 1.59,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.44,
      "end_seconds": 120.26,
      "duration_seconds": 2.82,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.84,
      "end_seconds": 123.57,
      "duration_seconds": 2.73,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.06,
      "end_seconds": 130.15,
      "duration_seconds": 5.09,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.72,
      "end_seconds": 144.64,
      "duration_seconds": 13.92,
      "text": "I'll have a glass of wine with dinner. I quit smoking around ten years ago. Lots of rice, lentils and some fruit. I swim twice a week."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.5,
      "end_seconds": 163.09,
      "duration_seconds": 2.59,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.61,
      "end_seconds": 167.73,
      "duration_seconds": 4.12,
      "text": "I mean, no, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.68,
      "end_seconds": 173.0,
      "duration_seconds": 4.32,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.51,
      "end_seconds": 178.53,
      "duration_seconds": 5.02,
      "text": "Oral rehydration salts, 1 sachet, maybe, after each loose stool."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.84,
      "end_seconds": 185.24,
      "duration_seconds": 4.4,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.17,
      "end_seconds": 190.42,
      "duration_seconds": 4.25,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.79,
      "end_seconds": 195.56,
      "duration_seconds": 3.77,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.27,
      "end_seconds": 200.47,
      "duration_seconds": 3.2,
      "text": "I've had high blood pressure, yes."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.86,
      "end_seconds": 216.0,
      "duration_seconds": 4.14,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.24,
      "end_seconds": 219.48,
      "duration_seconds": 2.24,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.71,
      "end_seconds": 226.28,
      "duration_seconds": 2.57,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.88,
      "end_seconds": 236.95,
      "duration_seconds": 2.07,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.63,
      "end_seconds": 259.39,
      "duration_seconds": 7.76,
      "text": "Okay: pulse is 112 beats a minute, temp 36.7 degrees, respiratory rate 17, blood pressure 103 over 56."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.22,
      "end_seconds": 264.27,
      "duration_seconds": 2.05,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.19,
      "end_seconds": 277.81,
      "duration_seconds": 1.62,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.12,
      "end_seconds": 281.08,
      "duration_seconds": 1.96,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.03,
      "end_seconds": 301.4,
      "duration_seconds": 7.37,
      "text": "Your mouth is dry, your skin is slack, and your blood pressure drops when you stand."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.08,
      "end_seconds": 339.63,
      "duration_seconds": 35.55,
      "text": "That's all I needed to check. So, based on the history and the examination, my working impression is dehydration from gastroenteritis. I'd also keep a kidney problem from low fluids in mind. I'm sending you for blood tests because of dehydration. Sip fluids little and often and hold your water tablet until you are eating again. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.18,
      "end_seconds": 344.71,
      "duration_seconds": 4.53,
      "text": "Okay, uh, I'll look out for that."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.54,
      "end_seconds": 354.41,
      "duration_seconds": 8.87,
      "text": "I'll want another look in two days. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 356.35,
      "end_seconds": 359.37,
      "duration_seconds": 3.02,
      "text": "Hmm, alright, thanks, take care."
    }
  ]
}