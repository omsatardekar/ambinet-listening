      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.48,
      "end_seconds": 17.41,
      "duration_seconds": 1.93,
      "text": "it's tired muscles, mostly"
