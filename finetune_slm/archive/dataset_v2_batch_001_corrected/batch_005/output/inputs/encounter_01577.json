    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.95,
      "end_seconds": 44.56,
      "duration_seconds": 4.61,
      "text": "and what about weakness weight loss bone pain or fractures?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.85,
      "end_seconds": 51.56,
      "duration_seconds": 5.71,
      "text": "no um no weakness weight loss bone pain or fractures"
    },
