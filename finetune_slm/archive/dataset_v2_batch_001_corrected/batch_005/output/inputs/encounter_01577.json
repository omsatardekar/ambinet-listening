    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.61,
      "end_seconds": 60.65,
      "duration_seconds": 2.04,
      "text": "no, that's been fine"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.63,
      "end_seconds": 65.01,
      "duration_seconds": 2.38,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.04,
      "end_seconds": 71.09,
      "duration_seconds": 1.05,
      "text": "no rashes"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.23,
      "end_seconds": 87.66,
      "duration_seconds": 5.43,
      "text": "so, can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.36,
      "end_seconds": 96.73,
      "duration_seconds": 4.37,
      "text": "It's pantoprazole, 40 milligrams, before breakfast for my acidity."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.15,
      "end_seconds": 98.13,
      "duration_seconds": 0.98,
      "text": "hm, okay"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.62,
      "end_seconds": 115.48,
      "duration_seconds": 3.86,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.67,
      "end_seconds": 119.8,
      "duration_seconds": 3.13,
      "text": "Acid reflux for about ten years"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.95,
      "end_seconds": 129.56,
      "duration_seconds": 8.61,
      "text": "hm, okay. Right, so acid reflux is already on your record. We'll keep that in mind today"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.46,
      "end_seconds": 144.35,
      "duration_seconds": 3.89,
      "text": "any allergies to tablets food or anything in the environment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.11,
      "end_seconds": 149.48,
      "duration_seconds": 4.37,
      "text": "I'm allergic to naproxen, I get a rash."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.14,
      "end_seconds": 153.33,
      "duration_seconds": 3.19,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.44,
      "end_seconds": 169.06,
      "duration_seconds": 14.62,
      "text": "I do a yoga class on Thursdays. I'm a plumber, lots of bending and kneeling. I drink a lot of tea and snack through the day"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.6,
      "end_seconds": 172.95,
      "duration_seconds": 2.35,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.71,
      "end_seconds": 179.72,
      "duration_seconds": 5.01,
      "text": "just a wisdom tooth extraction under sedation five years ago"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.56,
      "end_seconds": 183.98,
      "duration_seconds": 2.42,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.86,
      "end_seconds": 199.82,
      "duration_seconds": 1.96,
      "text": "Okay this won't take long..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.2,
      "end_seconds": 228.02,
      "duration_seconds": 6.82,
      "text": "okay: temp 36.8 degrees pulse 83 oxygen saturation is 97 percent BP is 122 over 73."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.45,
      "end_seconds": 232.19,
      "duration_seconds": 2.74,
      "text": "Let's move on to to the examination."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.44,
      "end_seconds": 234.55,
      "duration_seconds": 1.11,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.41,
      "end_seconds": 237.43,
      "duration_seconds": 2.02,
      "text": "hold that for a second"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.28,
      "end_seconds": 254.83,
      "duration_seconds": 4.55,
      "text": "Your muscle strength is normal and there is no bone tenderness."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.73,
      "end_seconds": 258.83,
      "duration_seconds": 2.1,
      "text": "Okay, um, doctor."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.22,
      "end_seconds": 274.68,
      "duration_seconds": 10.46,
      "text": "Right you can sit up now. From what you've told me and what I found this looks most like low vitamin D without complications."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.31,
      "end_seconds": 277.56,
      "duration_seconds": 2.25,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.88,
      "end_seconds": 309.31,
      "duration_seconds": 27.43,
      "text": "It's reasonable to be concerned, but right now low vitamin D without complications is my leading thought, not anything worse. I think a vitamin D level makes sense here, for tiredness. I'm going to put you on colecalciferol, 1000 units, once a day, three months. You take it by mouth. It's for low vitamin D."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.3,
      "end_seconds": 314.14,
      "duration_seconds": 3.84,
      "text": "can I collect it from my own pharmacy?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.74,
      "end_seconds": 323.35,
      "duration_seconds": 7.61,
      "text": "get some daily daylight and eat oily fish do get help quickly if the symptoms get worse"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.23,
      "end_seconds": 327.23,
      "duration_seconds": 3.0,
      "text": "yes I'll bear that in mind"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.71,
      "end_seconds": 339.05,
      "duration_seconds": 7.34,
      "text": "see me again in three months is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.37,
      "end_seconds": 348.25,
      "duration_seconds": 3.88,
      "text": "Right, I'll do that. Thank you, doctor."
    },
