      "role": "PATIENT",
      "start_seconds": 23.06,
      "end_seconds": 30.6,
      "duration_seconds": 7.54,
      "text": "A mild ache in my legs goes along with it most of the time."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.33,
      "end_seconds": 34.68,
      "duration_seconds": 2.35,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.05,
      "end_seconds": 38.81,
      "duration_seconds": 2.76,
