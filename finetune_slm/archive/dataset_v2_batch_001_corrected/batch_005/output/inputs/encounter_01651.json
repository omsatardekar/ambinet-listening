{
  "schema_version": "1.0",
  "encounter_id": "01651",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.85,
      "end_seconds": 8.11,
      "duration_seconds": 7.26,
      "text": "Doctor, your next patient is here. I've done the basics, I'll read them out in a moment."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.87,
      "end_seconds": 15.05,
      "duration_seconds": 5.18,
      "text": "Right, great. Hello, come in and sit down. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 16.57,
      "end_seconds": 22.3,
      "duration_seconds": 5.73,
      "text": "actually, good morning, doctor i came along to to help out"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.95,
      "end_seconds": 26.96,
      "duration_seconds": 4.01,
      "text": "good, that'll be useful pull up a chair"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 29.05,
      "end_seconds": 41.45,
      "duration_seconds": 12.4,
      "text": "Doctor, it's colicky tummy pain. It's getting on my nerves now. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.24,
      "end_seconds": 45.19,
      "duration_seconds": 1.95,
      "text": "when did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 46.96,
      "end_seconds": 49.27,
      "duration_seconds": 2.31,
      "text": "It's been two months now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.28,
      "end_seconds": 59.86,
      "duration_seconds": 9.58,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 61.35,
      "end_seconds": 66.47,
      "duration_seconds": 5.12,
      "text": "Oh, honestly, a couple of times a week. Mild, really."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.35,
      "end_seconds": 71.6,
      "duration_seconds": 4.25,
      "text": "What about vomiting green fluid, have you noticed that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 73.17,
      "end_seconds": 80.45,
      "duration_seconds": 7.28,
      "text": "Yes, since Monday. Not passing wind was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.66,
      "end_seconds": 86.86,
      "duration_seconds": 5.2,
      "text": "Okay, a few quick ones: blood in the stool, fever or hernia?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 87.87,
      "end_seconds": 93.6,
      "duration_seconds": 5.73,
      "text": "I haven't had blood in the stool, fever or hernia, no"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.73,
      "end_seconds": 98.56,
      "duration_seconds": 3.83,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 99.71,
      "end_seconds": 101.17,
      "duration_seconds": 1.46,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.59,
      "end_seconds": 106.13,
      "duration_seconds": 3.54,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 107.94,
      "end_seconds": 112.29,
      "duration_seconds": 4.35,
      "text": "No, um, not that I know of."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 114.27,
      "end_seconds": 121.41,
      "duration_seconds": 7.14,
      "text": "I'm, I'm not sure that's right. I seem to recall a problem with tramadol."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 124.45,
      "end_seconds": 127.34,
      "duration_seconds": 2.89,
      "text": "Maybe, but I don't recall it."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.45,
      "end_seconds": 140.11,
      "duration_seconds": 7.66,
      "text": "alright, so that's unclear i'll record what each of you said do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 141.55,
      "end_seconds": 143.7,
      "duration_seconds": 2.15,
      "text": "I have acid reflux"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.25,
      "end_seconds": 146.83,
      "duration_seconds": 1.58,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 148.92,
      "end_seconds": 155.63,
      "duration_seconds": 6.71,
      "text": "I have eczema, for nearly five years. COPD, for nearly five years"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.68,
      "end_seconds": 157.63,
      "duration_seconds": 0.95,
      "text": "Anything else?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.62,
      "end_seconds": 166.44,
      "duration_seconds": 6.82,
      "text": "right, so COPD is already on your record we'll keep that in mind today"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.64,
      "end_seconds": 184.63,
      "duration_seconds": 2.99,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 186.17,
      "end_seconds": 190.34,
      "duration_seconds": 4.17,
      "text": "Yes, I work in a bakery, early starts"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.8,
      "end_seconds": 193.9,
      "duration_seconds": 2.1,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 195.99,
      "end_seconds": 200.64,
      "duration_seconds": 4.65,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.98,
      "end_seconds": 204.34,
      "duration_seconds": 2.36,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 206.28,
      "end_seconds": 210.04,
      "duration_seconds": 3.76,
      "text": "I had my septum straightened in my thirties."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.2,
      "end_seconds": 229.32,
      "duration_seconds": 2.12,
      "text": "let's run through your medicines"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 229.92,
      "end_seconds": 234.32,
      "duration_seconds": 4.4,
      "text": "Omeprazole. I take it 20 milligrams, once a day."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 235.69,
      "end_seconds": 245.1,
      "duration_seconds": 9.41,
      "text": "So, doctor, I think the last prescription for the omeprazole was 10 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.95,
      "end_seconds": 249.77,
      "duration_seconds": 2.82,
      "text": "Alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 251.74,
      "end_seconds": 258.04,
      "duration_seconds": 6.3,
      "text": "no, I left it it at home. It's hydrocortisone cream, when needed"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 259.99,
      "end_seconds": 265.88,
      "duration_seconds": 5.89,
      "text": "doctor, I've got the readings for you blood pressure 116 over 80, pulse 114."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.8,
      "end_seconds": 271.71,
      "duration_seconds": 0.91,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.36,
      "end_seconds": 276.58,
      "duration_seconds": 3.22,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.48,
      "end_seconds": 279.73,
      "duration_seconds": 1.25,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.2,
      "end_seconds": 296.71,
      "duration_seconds": 4.51,
      "text": "Your tummy is swollen and tympanic, with high-pitched tinkling bowel sounds."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.7,
      "end_seconds": 337.52,
      "duration_seconds": 36.82,
      "text": "good, you can sit up again. Let me tell you where I've got to. My working impression is a bowel obstruction needing urgent surgical care. The reason I say that is that your story and my examination fit together. I'd also keep severe constipation in mind. I think urgent blood tests makes sense here, for vomiting. I'll request an abdominal X-ray, it'll help with possible obstruction. Nothing to eat or drink, and you are going to hospital now"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.11,
      "end_seconds": 353.18,
      "duration_seconds": 15.07,
      "text": "yes, carry on. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 354.94,
      "end_seconds": 356.0,
      "duration_seconds": 1.06,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.9,
      "end_seconds": 362.84,
      "duration_seconds": 5.94,
      "text": "Come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 363.92,
      "end_seconds": 365.47,
      "duration_seconds": 1.55,
      "text": "yes, will do"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.69,
      "end_seconds": 371.35,
      "duration_seconds": 4.66,
      "text": "is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 371.96,
      "end_seconds": 375.82,
      "duration_seconds": 3.86,
      "text": "right, I'll do that thank you, doctor"
    }
  ]
}