{
  "schema_version": "1.0",
  "encounter_id": "01809",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.22,
      "end_seconds": 6.0,
      "duration_seconds": 4.78,
      "text": "Hi doctor, you know, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.01,
      "end_seconds": 13.97,
      "duration_seconds": 5.96,
      "text": "So, yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.6,
      "end_seconds": 21.28,
      "duration_seconds": 6.68,
      "text": "Doctor, you know, it's a swollen tummy. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.5,
      "end_seconds": 25.36,
      "duration_seconds": 2.86,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.36,
      "end_seconds": 34.93,
      "duration_seconds": 2.57,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.39,
      "end_seconds": 62.02,
      "duration_seconds": 8.63,
      "text": "Okay: BP is 126 over 70, heart rate 109, temperature 36.9. Did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.45,
      "end_seconds": 66.77,
      "duration_seconds": 3.32,
      "text": "Ah, it's been about four days now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.15,
      "end_seconds": 71.27,
      "duration_seconds": 3.12,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.57,
      "end_seconds": 79.8,
      "duration_seconds": 7.23,
      "text": "Mild, really. I did have colicky tummy pain at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.03,
      "end_seconds": 86.33,
      "duration_seconds": 5.3,
      "text": "Right, any hernia, blood in the stool or fever at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.38,
      "end_seconds": 89.84,
      "duration_seconds": 2.46,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.78,
      "end_seconds": 93.89,
      "duration_seconds": 2.11,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.31,
      "end_seconds": 98.5,
      "duration_seconds": 3.19,
      "text": "No, um, that's all fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.56,
      "end_seconds": 104.16,
      "duration_seconds": 3.6,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.23,
      "end_seconds": 109.63,
      "duration_seconds": 3.4,
      "text": "Aspirin, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.04,
      "end_seconds": 111.99,
      "duration_seconds": 1.95,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.67,
      "end_seconds": 118.09,
      "duration_seconds": 4.42,
      "text": "Iron tablets, once a day for my blood count."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.08,
      "end_seconds": 123.42,
      "duration_seconds": 3.34,
      "text": "So, have you been to theatre before?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.01,
      "end_seconds": 130.66,
      "duration_seconds": 5.65,
      "text": "I, I had an operation for a hernia last spring."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.0,
      "end_seconds": 141.88,
      "duration_seconds": 2.88,
      "text": "So, do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.14,
      "end_seconds": 150.2,
      "duration_seconds": 7.06,
      "text": "I have heart disease. I've had low haemoglobin for about a year now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.87,
      "end_seconds": 156.41,
      "duration_seconds": 4.54,
      "text": "Alright, low haemoglobin, that matches what I have here."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.9,
      "end_seconds": 169.65,
      "duration_seconds": 2.75,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.43,
      "end_seconds": 174.27,
      "duration_seconds": 3.84,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.97,
      "end_seconds": 177.72,
      "duration_seconds": 1.75,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.27,
      "end_seconds": 183.76,
      "duration_seconds": 3.49,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.83,
      "end_seconds": 186.44,
      "duration_seconds": 1.61,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.7,
      "end_seconds": 193.51,
      "duration_seconds": 3.81,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.39,
      "end_seconds": 198.32,
      "duration_seconds": 3.93,
      "text": "Okay, are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.14,
      "end_seconds": 202.15,
      "duration_seconds": 2.01,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.8,
      "end_seconds": 208.89,
      "duration_seconds": 4.09,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.64,
      "end_seconds": 211.42,
      "duration_seconds": 1.78,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.22,
      "end_seconds": 214.62,
      "duration_seconds": 2.4,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.51,
      "end_seconds": 238.5,
      "duration_seconds": 4.99,
      "text": "Your tummy is swollen and tympanic, with high-pitched tinkling bowel sounds."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.21,
      "end_seconds": 244.0,
      "duration_seconds": 1.79,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.09,
      "end_seconds": 276.74,
      "duration_seconds": 14.65,
      "text": "Having listened and examined, I'd lean towards a bowel obstruction needing urgent surgical care. The reason I say that is that your story and my examination fit together. Another possibility is severe constipation."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.67,
      "end_seconds": 280.47,
      "duration_seconds": 2.8,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.41,
      "end_seconds": 305.99,
      "duration_seconds": 24.58,
      "text": "I understand the worry. At the moment I'd say it's a bowel obstruction needing urgent surgical care, and we'll know more once the an abdominal X-ray is back. We should do an abdominal X-ray for possible obstruction. Nothing to eat or drink, and you are going to hospital now. I think the surgical team should see you too."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.36,
      "end_seconds": 308.06,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.82,
      "end_seconds": 318.69,
      "duration_seconds": 8.87,
      "text": "Please come and see me straight away. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.56,
      "end_seconds": 321.35,
      "duration_seconds": 1.79,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.17,
      "end_seconds": 324.38,
      "duration_seconds": 1.21,
      "text": "See you soon."
    }
  ]
}