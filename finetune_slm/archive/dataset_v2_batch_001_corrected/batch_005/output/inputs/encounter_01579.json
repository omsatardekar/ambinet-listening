      "role": "DOCTOR",
      "start_seconds": 7.66,
      "end_seconds": 11.99,
      "duration_seconds": 4.33,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.08,
      "end_seconds": 19.28,
      "duration_seconds": 5.2,
      "text": "I've been dealing with tingling in my thumb and first fingers"
    },
