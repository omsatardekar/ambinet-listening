      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.85,
      "end_seconds": 171.64,
      "duration_seconds": 2.79,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.73,
      "end_seconds": 195.92,
      "duration_seconds": 5.19,
      "text": "Okay: pressure 114 over 74, pulse 84, temp 36.9 degrees."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.98,
      "end_seconds": 200.76,
      "duration_seconds": 3.78,
      "text": "let me look at the area, I'll be gentle"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.62,
      "end_seconds": 203.82,
      "duration_seconds": 2.2,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.79,
      "end_seconds": 225.99,
      "duration_seconds": 6.2,
      "text": "Tapping over the wrist brings on the tingling and the thumb muscle is slightly thin."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.73,
      "end_seconds": 233.7,
      "duration_seconds": 1.97,
      "text": "all finished, thank you"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.03,
      "end_seconds": 266.93,
      "duration_seconds": 23.9,
      "text": "Okay, so my impression is this: It points towards carpal tunnel syndrome. The reason I say that is that your story and and my examination fit together. Let me just check I've got this right. You've had tingling in your thumb and first fingers for about three months, and no weakness in the legs or neck pain."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.74,
      "end_seconds": 270.75,
      "duration_seconds": 3.01,
      "text": "Well, that's what happened, yes."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.58,
      "end_seconds": 298.21,
      "duration_seconds": 26.63,
      "text": "I'd like to arrange a nerve conduction study for carpal tunnel wear a wrist splint at night the hand clinic would be the right next step, I'll refer you one warning sign to remember: the symptoms get worse in that case don't wait book a review in six weeks anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.47,
      "end_seconds": 303.09,
      "duration_seconds": 3.62,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.74,
      "end_seconds": 305.99,
      "duration_seconds": 1.25,
      "text": "All the best."
    }
