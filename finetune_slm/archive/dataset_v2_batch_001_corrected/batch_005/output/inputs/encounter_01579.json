      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.37,
      "end_seconds": 150.76,
      "duration_seconds": 4.39,
      "text": "Clopidogrel, 75 milligrams, once a day for the stent"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.15,
      "end_seconds": 156.31,
      "duration_seconds": 2.16,
      "text": "I'll do your observations first."
