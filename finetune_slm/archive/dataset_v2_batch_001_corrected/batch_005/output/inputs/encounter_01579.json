      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.77,
      "end_seconds": 113.44,
      "duration_seconds": 7.67,
      "text": "I follow. Yes, heart disease is known to us, good to have that clear. How are your meals?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.76,
      "end_seconds": 118.55,
      "duration_seconds": 3.79,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.52,
      "end_seconds": 126.52,
      "duration_seconds": 3.0,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.26,
      "end_seconds": 132.32,
      "duration_seconds": 4.06,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.58,
      "end_seconds": 135.74,
      "duration_seconds": 2.16,
      "text": "do you do any exercise?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
