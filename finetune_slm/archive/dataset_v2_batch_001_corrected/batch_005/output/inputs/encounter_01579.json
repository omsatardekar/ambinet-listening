      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.86,
      "end_seconds": 29.1,
      "duration_seconds": 8.24,
      "text": "When was the first time you noticed it? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.17,
      "end_seconds": 32.66,
      "duration_seconds": 2.49,
      "text": "About... well, about three months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.61,
      "end_seconds": 37.42,
      "duration_seconds": 3.81,
      "text": "What do you do to make it better?"
