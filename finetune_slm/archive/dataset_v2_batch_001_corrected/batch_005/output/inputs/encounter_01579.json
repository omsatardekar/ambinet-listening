      "role": "DOCTOR",
      "start_seconds": 50.23,
      "end_seconds": 54.7,
      "duration_seconds": 4.47,
      "text": "Have you noticed weakness in the legs or neck pain?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.77,
      "end_seconds": 61.74,
      "duration_seconds": 4.97,
      "text": "Let me think, um, no, nothing to report there."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.63,
      "end_seconds": 66.92,
      "duration_seconds": 3.29,
      "text": "Have you had any pain in the shoulder?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.39,
      "end_seconds": 75.16,
      "duration_seconds": 2.77,
      "text": "Definitely no pain in the shoulder."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.4,
      "end_seconds": 78.82,
      "duration_seconds": 2.42,
      "text": "is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.8,
      "end_seconds": 81.36,
      "duration_seconds": 1.56,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.24,
      "end_seconds": 101.49,
      "duration_seconds": 3.25,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.62,
      "end_seconds": 104.63,
      "duration_seconds": 2.01,
      "text": "I've got heart disease"
