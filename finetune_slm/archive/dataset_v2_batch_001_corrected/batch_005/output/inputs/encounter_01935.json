{
  "schema_version": "1.0",
  "encounter_id": "01935",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.56,
      "end_seconds": 2.26,
      "duration_seconds": 1.7,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.19,
      "end_seconds": 8.24,
      "duration_seconds": 4.05,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.83,
      "end_seconds": 18.8,
      "duration_seconds": 8.97,
      "text": "Yeah, um, it's a high reading at the pharmacy. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.5,
      "end_seconds": 24.38,
      "duration_seconds": 3.88,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.46,
      "end_seconds": 32.19,
      "duration_seconds": 5.73,
      "text": "Allopurinol, 100 milligrams, once a day. I'm on metoprolol, twice a day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.97,
      "end_seconds": 35.43,
      "duration_seconds": 2.46,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.88,
      "end_seconds": 38.34,
      "duration_seconds": 1.46,
      "text": "It's 50 milligrams."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.76,
      "end_seconds": 42.18,
      "duration_seconds": 2.42,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.79,
      "end_seconds": 46.57,
      "duration_seconds": 3.78,
      "text": "It's, It's been about four days now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.9,
      "end_seconds": 51.06,
      "duration_seconds": 3.16,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.88,
      "end_seconds": 53.94,
      "duration_seconds": 1.06,
      "text": "Moderate, really."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.89,
      "end_seconds": 58.71,
      "duration_seconds": 2.82,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.31,
      "end_seconds": 62.44,
      "duration_seconds": 3.13,
      "text": "It usually comes with an occasional headache."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.97,
      "end_seconds": 66.43,
      "duration_seconds": 3.46,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.58,
      "end_seconds": 69.7,
      "duration_seconds": 2.12,
      "text": "I'd call it mild."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.04,
      "end_seconds": 72.83,
      "duration_seconds": 1.79,
      "text": "So, any visual changes?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.19,
      "end_seconds": 80.19,
      "duration_seconds": 6.0,
      "text": "Well, you know, not that I've noticed, no visual changes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.89,
      "end_seconds": 84.07,
      "duration_seconds": 3.18,
      "text": "Have you had any breathlessness or chest pain?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.73,
      "end_seconds": 87.54,
      "duration_seconds": 2.81,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.45,
      "end_seconds": 91.97,
      "duration_seconds": 2.52,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.64,
      "end_seconds": 94.13,
      "duration_seconds": 1.49,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.68,
      "end_seconds": 102.63,
      "duration_seconds": 2.95,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.58,
      "end_seconds": 104.56,
      "duration_seconds": 0.98,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.65,
      "end_seconds": 108.33,
      "duration_seconds": 2.68,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.71,
      "end_seconds": 114.41,
      "duration_seconds": 4.7,
      "text": "Yes, I had a triple bypass, eight years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.26,
      "end_seconds": 132.62,
      "duration_seconds": 4.36,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.71,
      "end_seconds": 139.22,
      "duration_seconds": 4.51,
      "text": "I've got gout. I've had heart disease, yes."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.8,
      "end_seconds": 150.12,
      "duration_seconds": 1.32,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.21,
      "end_seconds": 154.35,
      "duration_seconds": 3.14,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.16,
      "end_seconds": 159.14,
      "duration_seconds": 2.98,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.23,
      "end_seconds": 165.15,
      "duration_seconds": 2.92,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.87,
      "end_seconds": 188.13,
      "duration_seconds": 5.26,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.87,
      "end_seconds": 193.27,
      "duration_seconds": 3.4,
      "text": "Yes, kiwi, it gives me hives."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.93,
      "end_seconds": 213.39,
      "duration_seconds": 4.46,
      "text": "Okay, shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.52,
      "end_seconds": 221.88,
      "duration_seconds": 2.36,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.5,
      "end_seconds": 245.09,
      "duration_seconds": 7.59,
      "text": "Okay: pulse is 73 beats a minute, respiratory rate 16, BP is 147 over 102."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.51,
      "end_seconds": 251.55,
      "duration_seconds": 4.04,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.31,
      "end_seconds": 255.01,
      "duration_seconds": 1.7,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.72,
      "end_seconds": 274.12,
      "duration_seconds": 6.4,
      "text": "Your blood pressure is a little raised in the clinic but your heart sounds are normal."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.93,
      "end_seconds": 312.0,
      "duration_seconds": 35.07,
      "text": "That's all I needed to check. Taking everything into account, it points towards possible white-coat blood pressure. A 24-hour blood pressure monitor is what I'd like next, for raised clinic blood pressure. That will help us see what's going on underneath and decide the next step. Cut back on salt and do a week of home readings. One warning sign to remember: the symptoms get worse. In that case don't wait. Book a review after the monitor."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.65,
      "end_seconds": 317.26,
      "duration_seconds": 4.61,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.37,
      "end_seconds": 320.57,
      "duration_seconds": 2.2,
      "text": "Thank you, that's helpful."
    }
  ]
}