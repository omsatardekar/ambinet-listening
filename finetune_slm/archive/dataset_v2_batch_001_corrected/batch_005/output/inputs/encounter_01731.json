{
  "schema_version": "1.0",
  "encounter_id": "01731",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.91,
      "end_seconds": 4.52,
      "duration_seconds": 3.61,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.5,
      "end_seconds": 10.95,
      "duration_seconds": 4.45,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.15,
      "end_seconds": 16.31,
      "duration_seconds": 4.16,
      "text": "I wanted to get sudden severe breathlessness looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.85,
      "end_seconds": 24.23,
      "duration_seconds": 3.38,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.79,
      "end_seconds": 33.27,
      "duration_seconds": 8.48,
      "text": "For five days, I'd say. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.4,
      "end_seconds": 37.43,
      "duration_seconds": 3.03,
      "text": "Okay, have you been feeling very faint?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.87,
      "end_seconds": 40.64,
      "duration_seconds": 1.77,
      "text": "Yeah, that too."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.59,
      "end_seconds": 46.09,
      "duration_seconds": 3.5,
      "text": "Any fever, cough or leg swelling at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.07,
      "end_seconds": 54.11,
      "duration_seconds": 6.04,
      "text": "Actually, no fever, cough or leg swelling, none of it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.72,
      "end_seconds": 60.57,
      "duration_seconds": 4.85,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.94,
      "end_seconds": 65.31,
      "duration_seconds": 3.37,
      "text": "Bowels are regular, you know, nothing odd."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.09,
      "end_seconds": 72.52,
      "duration_seconds": 4.43,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.56,
      "end_seconds": 75.08,
      "duration_seconds": 1.52,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.3,
      "end_seconds": 80.98,
      "duration_seconds": 4.68,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.85,
      "end_seconds": 95.33,
      "duration_seconds": 12.48,
      "text": "I look after my grandchildren most days. I drink a lot of tea and snack through the day. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.04,
      "end_seconds": 101.36,
      "duration_seconds": 4.32,
      "text": "Okay, are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.72,
      "end_seconds": 106.8,
      "duration_seconds": 2.08,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.05,
      "end_seconds": 127.72,
      "duration_seconds": 2.67,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.41,
      "end_seconds": 132.37,
      "duration_seconds": 3.96,
      "text": "Ah, nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.04,
      "end_seconds": 152.68,
      "duration_seconds": 2.64,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.77,
      "end_seconds": 156.93,
      "duration_seconds": 2.16,
      "text": "No, you know, none."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.09,
      "end_seconds": 160.92,
      "duration_seconds": 2.83,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.24,
      "end_seconds": 170.3,
      "duration_seconds": 2.06,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.78,
      "end_seconds": 200.15,
      "duration_seconds": 9.37,
      "text": "Okay: respiratory rate 26, BP is 127 over 82, pulse is 86 beats a minute, SpO2 90 percent on room air."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.18,
      "end_seconds": 202.8,
      "duration_seconds": 1.62,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.63,
      "end_seconds": 206.61,
      "duration_seconds": 2.98,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.9,
      "end_seconds": 211.93,
      "duration_seconds": 4.03,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.99,
      "end_seconds": 231.04,
      "duration_seconds": 1.05,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.14,
      "end_seconds": 235.16,
      "duration_seconds": 3.02,
      "text": "Okay, tell me if that's sore."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.59,
      "end_seconds": 259.14,
      "duration_seconds": 9.55,
      "text": "Your windpipe is pushed to the right, there is no breath sound on the left, and your pressure is dropping."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.97,
      "end_seconds": 266.64,
      "duration_seconds": 1.67,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.74,
      "end_seconds": 287.92,
      "duration_seconds": 13.18,
      "text": "So, based on the history and the examination, this looks most like a collapsed lung under pressure. I'm sending you for an urgent chest decompression because of tension pneumothorax."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.85,
      "end_seconds": 291.22,
      "duration_seconds": 1.37,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.33,
      "end_seconds": 326.63,
      "duration_seconds": 34.3,
      "text": "I'm sending you for a chest X-ray because of chest pain. Stay sitting up, I need to relieve the pressure in your chest right now. The emergency team would be the right next step, I'll refer you. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. See me again straight away. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.5,
      "end_seconds": 331.1,
      "duration_seconds": 3.6,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.27,
      "end_seconds": 333.97,
      "duration_seconds": 1.7,
      "text": "Have a good day."
    }
  ]
}