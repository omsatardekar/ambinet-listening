{
  "schema_version": "1.0",
  "encounter_id": "01679",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.38,
      "end_seconds": 6.18,
      "duration_seconds": 4.8,
      "text": "Good morning, grab a seat. Alright, where shall we begin?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.57,
      "end_seconds": 12.49,
      "duration_seconds": 4.92,
      "text": "Um, so... an itchy scalp. That's why I came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.24,
      "end_seconds": 17.3,
      "duration_seconds": 4.06,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.06,
      "end_seconds": 33.43,
      "duration_seconds": 2.37,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.97,
      "end_seconds": 51.47,
      "duration_seconds": 8.5,
      "text": "Okay: temp 36.6 degrees, pulse is 74 beats a minute, BP is 113 over 82. And saturation 98 percent."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 55.39,
      "end_seconds": 57.56,
      "duration_seconds": 2.17,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 58.95,
      "end_seconds": 61.47,
      "duration_seconds": 2.52,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.83,
      "end_seconds": 76.06,
      "duration_seconds": 3.23,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.04,
      "end_seconds": 80.82,
      "duration_seconds": 2.78,
      "text": "I've had it for five days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.01,
      "end_seconds": 91.93,
      "duration_seconds": 9.92,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 93.85,
      "end_seconds": 102.14,
      "duration_seconds": 8.29,
      "text": "So, honestly, on and off. It's moderate, honestly. Oh, and scratch marks on the neck."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.73,
      "end_seconds": 107.58,
      "duration_seconds": 4.85,
      "text": "And what about fever, swollen glands or rash on the body?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.94,
      "end_seconds": 114.39,
      "duration_seconds": 5.45,
      "text": "No, no fever, swollen glands or rash on the body."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.43,
      "end_seconds": 119.54,
      "duration_seconds": 4.11,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.13,
      "end_seconds": 121.48,
      "duration_seconds": 1.35,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.56,
      "end_seconds": 125.0,
      "duration_seconds": 1.44,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.48,
      "end_seconds": 131.64,
      "duration_seconds": 2.16,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.09,
      "end_seconds": 135.88,
      "duration_seconds": 2.79,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.82,
      "end_seconds": 138.35,
      "duration_seconds": 1.53,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.4,
      "end_seconds": 142.25,
      "duration_seconds": 2.85,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.11,
      "end_seconds": 151.12,
      "duration_seconds": 3.01,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 151.77,
      "end_seconds": 156.04,
      "duration_seconds": 4.27,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 157.88,
      "end_seconds": 160.82,
      "duration_seconds": 2.94,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.62,
      "end_seconds": 182.74,
      "duration_seconds": 4.12,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 184.58,
      "end_seconds": 194.89,
      "duration_seconds": 10.31,
      "text": "No, I share a house with my brother. I look after my grandchildren most days. I walk the dog every morning."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.47,
      "end_seconds": 201.99,
      "duration_seconds": 4.52,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 219.55,
      "end_seconds": 221.14,
      "duration_seconds": 1.59,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.03,
      "end_seconds": 223.2,
      "duration_seconds": 1.17,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.81,
      "end_seconds": 245.57,
      "duration_seconds": 6.76,
      "text": "I can see live lice and small eggs close to the roots behind the ears."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.45,
      "end_seconds": 250.82,
      "duration_seconds": 2.37,
      "text": "Okay, you can relax now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.37,
      "end_seconds": 293.44,
      "duration_seconds": 32.07,
      "text": "Let me tell you where I've got to. I'd lean towards head lice. We'll begin with dimeticone lotion, 4%, once, repeat after seven days, two applications. That should help with head lice. I'll put all of this in writing so you don't have to remember it. Comb the hair with a fine comb every few days and check the family. See me again if lice persist after two treatments."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.64,
      "end_seconds": 299.22,
      "duration_seconds": 4.58,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 303.83,
      "end_seconds": 306.93,
      "duration_seconds": 3.1,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}