{
  "schema_version": "1.0",
  "encounter_id": "01745",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.57,
      "end_seconds": 5.56,
      "duration_seconds": 4.99,
      "text": "Uh, sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.01,
      "end_seconds": 10.67,
      "duration_seconds": 3.66,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.86,
      "end_seconds": 18.2,
      "duration_seconds": 6.34,
      "text": "Hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.79,
      "end_seconds": 27.41,
      "duration_seconds": 8.62,
      "text": "I've been dealing with a dry mouth. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.96,
      "end_seconds": 31.54,
      "duration_seconds": 3.58,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.71,
      "end_seconds": 38.45,
      "duration_seconds": 5.74,
      "text": "About... well, two weeks. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.29,
      "end_seconds": 43.29,
      "duration_seconds": 3.0,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.84,
      "end_seconds": 56.29,
      "duration_seconds": 12.45,
      "text": "It feels mild to me. Erm, you know, I've been passing little urine too. About passing little urine, about a three out of ten."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.91,
      "end_seconds": 59.71,
      "duration_seconds": 2.8,
      "text": "Have you been feeling very weak?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.95,
      "end_seconds": 62.63,
      "duration_seconds": 1.68,
      "text": "Yeah, that too."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.89,
      "end_seconds": 81.89,
      "duration_seconds": 4.0,
      "text": "Alright, have you noticed confusion or blood in the stool?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.59,
      "end_seconds": 85.59,
      "duration_seconds": 3.0,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.29,
      "end_seconds": 89.63,
      "duration_seconds": 3.34,
      "text": "Have you noticed fever or chest pain?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.5,
      "end_seconds": 99.45,
      "duration_seconds": 7.95,
      "text": "Sorry, what was I saying, no fever or chest pain, none of it."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.77,
      "end_seconds": 103.89,
      "duration_seconds": 3.12,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.92,
      "end_seconds": 108.7,
      "duration_seconds": 2.78,
      "text": "So, no, skin's been fine."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.2,
      "end_seconds": 114.67,
      "duration_seconds": 4.47,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.39,
      "end_seconds": 127.31,
      "duration_seconds": 11.92,
      "text": "Well, you know, I'm on metoprolol, 50 milligrams, twice a day. Thyronorm. I take it 50 micrograms, every morning."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 128.09,
      "end_seconds": 138.48,
      "duration_seconds": 10.39,
      "text": "Doctor, I think the last prescription for the Thyronorm was 25 micrograms. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.97,
      "end_seconds": 147.06,
      "duration_seconds": 4.09,
      "text": "Hm, that's different. Is the latest prescription anywhere near you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.22,
      "end_seconds": 156.85,
      "duration_seconds": 8.63,
      "text": "I don't think I have it with me. Simvastatin. I take it 20 milligrams, at night."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 158.31,
      "end_seconds": 167.95,
      "duration_seconds": 9.64,
      "text": "Uh, it's meant to be at night, though I don't see he take it every time."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.51,
      "end_seconds": 174.65,
      "duration_seconds": 5.14,
      "text": "It's oral rehydration salts, 1 sachet, after each loose stool."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.74,
      "end_seconds": 178.42,
      "duration_seconds": 2.68,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.7,
      "end_seconds": 193.12,
      "duration_seconds": 10.42,
      "text": "Walnuts. I come out in... well, hives. I mean, yes, nickel. I get a rash on my skin."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.69,
      "end_seconds": 197.34,
      "duration_seconds": 2.65,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.25,
      "end_seconds": 202.36,
      "duration_seconds": 3.11,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.3,
      "end_seconds": 206.8,
      "duration_seconds": 2.5,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.95,
      "end_seconds": 217.43,
      "duration_seconds": 9.48,
      "text": "I swim twice a week. My partner and our baby. Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.99,
      "end_seconds": 235.08,
      "duration_seconds": 4.09,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.3,
      "end_seconds": 249.97,
      "duration_seconds": 13.67,
      "text": "Okay, so I've got high blood pressure. It's the not knowing that gets to me. Yes, an underactive thyroid. Yes, high cholesterol."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.64,
      "end_seconds": 254.91,
      "duration_seconds": 4.27,
      "text": "Alright, an underactive thyroid, that matches what I have here."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.46,
      "end_seconds": 265.06,
      "duration_seconds": 2.6,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.2,
      "end_seconds": 279.77,
      "duration_seconds": 3.57,
      "text": "Right, keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.46,
      "end_seconds": 299.82,
      "duration_seconds": 10.36,
      "text": "Okay: pressure 99 over 60, temp 36.7 degrees. And oxygen saturation is 97 percent, pulse is 101 beats a minute."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.95,
      "end_seconds": 303.05,
      "duration_seconds": 2.1,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.6,
      "end_seconds": 308.08,
      "duration_seconds": 3.48,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.83,
      "end_seconds": 312.0,
      "duration_seconds": 2.17,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.55,
      "end_seconds": 314.95,
      "duration_seconds": 1.4,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.32,
      "end_seconds": 335.39,
      "duration_seconds": 7.07,
      "text": "Your mouth is dry, your skin is slack, and your blood pressure drops when you stand."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.14,
      "end_seconds": 337.24,
      "duration_seconds": 1.1,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.33,
      "end_seconds": 360.89,
      "duration_seconds": 21.56,
      "text": "Thank you, you can get dressed. So, based on the history and the examination, the most likely explanation is dehydration from gastroenteritis. I want to be honest that this is an impression, not a final answer. We shouldn't forget a kidney problem from low fluids. Blood tests is what I'd like next, for dehydration."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 365.87,
      "end_seconds": 369.33,
      "duration_seconds": 3.46,
      "text": "Actually, how long will it take?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 370.24,
      "end_seconds": 389.88,
      "duration_seconds": 19.64,
      "text": "Sip fluids little and often and hold your water tablet until you are eating again. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 390.92,
      "end_seconds": 394.59,
      "duration_seconds": 3.67,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 395.49,
      "end_seconds": 396.67,
      "duration_seconds": 1.18,
      "text": "Goodbye for now."
    }
  ]
}