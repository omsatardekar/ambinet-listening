  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.27,
      "end_seconds": 5.24,
      "duration_seconds": 3.97,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.3,
      "end_seconds": 11.71,
      "duration_seconds": 4.41,
      "text": "that's fine, sit down tell me why you came"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.75,
      "end_seconds": 20.13,
      "duration_seconds": 6.38,
      "text": "It's a bitten tongue. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.18,
      "end_seconds": 25.45,
      "duration_seconds": 3.27,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.12,
      "end_seconds": 29.41,
      "duration_seconds": 3.29,
      "text": "It's been like this since yesterday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.82,
      "end_seconds": 33.56,
      "duration_seconds": 3.74,
      "text": "Mm-hmm. How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.11,
      "end_seconds": 37.07,
      "duration_seconds": 2.96,
      "text": "Pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.97,
      "end_seconds": 42.24,
      "duration_seconds": 4.27,
      "text": "Did you get head injury, second seizure or fever?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.27,
      "end_seconds": 50.22,
      "duration_seconds": 5.95,
      "text": "Sorry, you know, what was I saying, no, I'd have said so."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.92,
      "end_seconds": 54.03,
      "duration_seconds": 2.11,
      "text": "any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.57,
      "end_seconds": 58.02,
      "duration_seconds": 3.45,
      "text": "that's normal as far as I know"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.67,
      "end_seconds": 61.88,
      "duration_seconds": 2.21,
      "text": "your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.82,
      "end_seconds": 63.81,
      "duration_seconds": 0.99,
      "text": "breathing's normal"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.21,
      "end_seconds": 68.75,
      "duration_seconds": 3.54,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.36,
      "end_seconds": 74.48,
      "duration_seconds": 5.12,
      "text": "It's carbamazepine, 200 milligrams, twice a day for the seizures."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.3,
      "end_seconds": 80.86,
      "duration_seconds": 4.56,
      "text": "do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.95,
      "end_seconds": 89.08,
      "duration_seconds": 3.13,
      "text": "no, I've never reacted to anything"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.18,
      "end_seconds": 101.04,
      "duration_seconds": 3.86,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.81,
      "end_seconds": 105.35,
      "duration_seconds": 2.54,
      "text": "erm, I've had epilepsy, yes"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.01,
      "end_seconds": 116.07,
      "duration_seconds": 3.06,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.78,
      "end_seconds": 120.14,
      "duration_seconds": 2.36,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.53,
      "end_seconds": 124.31,
      "duration_seconds": 2.78,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.01,
      "end_seconds": 128.39,
      "duration_seconds": 3.38,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.15,
      "end_seconds": 133.78,
      "duration_seconds": 4.63,
      "text": "What does a a normal day of food look like?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.33,
      "end_seconds": 138.83,
      "duration_seconds": 3.5,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.55,
      "end_seconds": 142.72,
      "duration_seconds": 2.17,
      "text": "Okay, how active are you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.7,
      "end_seconds": 151.85,
      "duration_seconds": 3.15,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.2,
      "end_seconds": 165.21,
      "duration_seconds": 2.01,
      "text": "I'll do your observations first"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.94,
      "end_seconds": 179.34,
      "duration_seconds": 2.4,
      "text": "sit still for a moment.."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.62,
      "end_seconds": 211.45,
      "duration_seconds": 10.83,
      "text": "Okay: oxygen saturation is 99 percent, BP is 119 over 78, temperature is 36.6 degrees. And pulse is 85 beats a minute."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.33,
      "end_seconds": 213.7,
      "duration_seconds": 1.37,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.35,
      "end_seconds": 219.23,
      "duration_seconds": 3.88,
      "text": "they help me see the whole picture, more shortly"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.44,
      "end_seconds": 224.01,
      "duration_seconds": 3.57,
      "text": "now I'm going to do a short physical check"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.11,
      "end_seconds": 226.47,
      "duration_seconds": 1.36,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.48,
      "end_seconds": 248.67,
      "duration_seconds": 4.19,
      "text": "you are alert and your neurological examination is normal"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.31,
      "end_seconds": 256.4,
      "duration_seconds": 3.09,
      "text": "Okay, good, you can sit up again."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.09,
      "end_seconds": 280.38,
      "duration_seconds": 5.29,
      "text": "An anticonvulsant level is what I'd like next, for breakthrough seizure"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.04,
      "end_seconds": 284.82,
      "duration_seconds": 2.78,
      "text": "When would that that take place?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.97,
      "end_seconds": 314.36,
      "duration_seconds": 28.39,
      "text": "Blood tests is what I'd like next, for seizure take your medicine at the same time every day and do not drive until we say so cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle the epilepsy nurse would be the right next step, I'll refer you come back in four weeks that's all from me any questions?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.94,
      "end_seconds": 317.74,
      "duration_seconds": 1.8,
      "text": "That's clear, thanks."
    }
  ]
}