{
  "schema_version": "1.0",
  "encounter_id": "01552",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.59,
      "end_seconds": 4.14,
      "duration_seconds": 3.55,
      "text": "Well, sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.03,
      "end_seconds": 10.07,
      "duration_seconds": 4.04,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.56,
      "end_seconds": 18.39,
      "duration_seconds": 6.83,
      "text": "It's a pulled muscle in my thigh. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.67,
      "end_seconds": 22.92,
      "duration_seconds": 3.25,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.69,
      "end_seconds": 28.09,
      "duration_seconds": 3.4,
      "text": "It's been going on for five days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.96,
      "end_seconds": 35.24,
      "duration_seconds": 5.28,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.26,
      "end_seconds": 42.83,
      "duration_seconds": 6.57,
      "text": "Yeah, I'd call it mild. I get some relief from ice and rest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.39,
      "end_seconds": 46.72,
      "duration_seconds": 2.33,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.65,
      "end_seconds": 60.64,
      "duration_seconds": 11.99,
      "text": "When it starts I tend to get tightness as well. I've also had a bit of bruising. With tightness, it happens on and off."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.42,
      "end_seconds": 66.14,
      "duration_seconds": 3.72,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.94,
      "end_seconds": 75.04,
      "duration_seconds": 2.1,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.62,
      "end_seconds": 102.04,
      "duration_seconds": 5.42,
      "text": "Okay: oxygen saturation is 98 percent, pulse 82, blood pressure 120 over 69."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.12,
      "end_seconds": 105.56,
      "duration_seconds": 1.44,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.2,
      "end_seconds": 110.32,
      "duration_seconds": 3.12,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.81,
      "end_seconds": 116.61,
      "duration_seconds": 3.8,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.36,
      "end_seconds": 119.68,
      "duration_seconds": 1.32,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.05,
      "end_seconds": 137.77,
      "duration_seconds": 8.72,
      "text": "There is mild tenderness in the back of the thigh and you can still straighten the knee fully."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.23,
      "end_seconds": 145.98,
      "duration_seconds": 2.75,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.54,
      "end_seconds": 166.19,
      "duration_seconds": 4.65,
      "text": "And what about fall, swelling or pop at the time?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.06,
      "end_seconds": 169.42,
      "duration_seconds": 2.36,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.27,
      "end_seconds": 172.41,
      "duration_seconds": 2.14,
      "text": "Have you had any numbness?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.43,
      "end_seconds": 176.63,
      "duration_seconds": 3.2,
      "text": "Not that I've noticed, no numbness."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.35,
      "end_seconds": 181.4,
      "duration_seconds": 4.05,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.03,
      "end_seconds": 186.85,
      "duration_seconds": 3.82,
      "text": "No, um, that side's been fine."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.08,
      "end_seconds": 194.79,
      "duration_seconds": 3.71,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.52,
      "end_seconds": 200.37,
      "duration_seconds": 4.85,
      "text": "Ibuprofen gel. I take it three times a day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.85,
      "end_seconds": 201.55,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.48,
      "end_seconds": 221.91,
      "duration_seconds": 1.43,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.47,
      "end_seconds": 227.69,
      "duration_seconds": 4.22,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.92,
      "end_seconds": 231.63,
      "duration_seconds": 2.71,
      "text": "Okay, do you live by yourself?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.24,
      "end_seconds": 236.41,
      "duration_seconds": 4.17,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.22,
      "end_seconds": 240.59,
      "duration_seconds": 2.37,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.4,
      "end_seconds": 245.24,
      "duration_seconds": 3.84,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.22,
      "end_seconds": 248.27,
      "duration_seconds": 2.05,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.81,
      "end_seconds": 251.61,
      "duration_seconds": 2.8,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.54,
      "end_seconds": 256.26,
      "duration_seconds": 2.72,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.26,
      "end_seconds": 261.65,
      "duration_seconds": 3.39,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.71,
      "end_seconds": 270.51,
      "duration_seconds": 3.8,
      "text": "Right, any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.36,
      "end_seconds": 274.1,
      "duration_seconds": 1.74,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.27,
      "end_seconds": 282.14,
      "duration_seconds": 2.87,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.77,
      "end_seconds": 287.29,
      "duration_seconds": 4.52,
      "text": "Yeah, just a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.1,
      "end_seconds": 296.48,
      "duration_seconds": 7.38,
      "text": "From what you've told me and what I found, this is probably a mild hamstring strain."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.57,
      "end_seconds": 300.46,
      "duration_seconds": 1.89,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.31,
      "end_seconds": 322.3,
      "duration_seconds": 19.99,
      "text": "Nothing I've seen today points to an emergency. It looks like a mild hamstring strain. Rest for a few days, ice it, and then ease back in with gentle stretching. We'll catch up if not better in two weeks. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.94,
      "end_seconds": 326.3,
      "duration_seconds": 2.36,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}