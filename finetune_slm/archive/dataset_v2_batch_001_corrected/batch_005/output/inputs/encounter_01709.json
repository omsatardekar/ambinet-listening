{
  "schema_version": "1.0",
  "encounter_id": "01709",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.33,
      "end_seconds": 3.65,
      "duration_seconds": 2.32,
      "text": "Right then, come on in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.64,
      "end_seconds": 11.35,
      "duration_seconds": 5.71,
      "text": "Hmm, um, hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.49,
      "end_seconds": 18.54,
      "duration_seconds": 6.05,
      "text": "Good morning, uh, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.03,
      "end_seconds": 27.21,
      "duration_seconds": 7.18,
      "text": "That's fine, sit down. We'll go through it together. So what can I do for you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 27.71,
      "end_seconds": 32.88,
      "duration_seconds": 5.17,
      "text": "I've been dealing with a high reading at the pharmacy."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.65,
      "end_seconds": 37.79,
      "duration_seconds": 3.14,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.39,
      "end_seconds": 45.08,
      "duration_seconds": 6.69,
      "text": "Mm, um, it's been about a week, I'm fairly sure."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.33,
      "end_seconds": 49.32,
      "duration_seconds": 2.99,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.15,
      "end_seconds": 53.67,
      "duration_seconds": 3.52,
      "text": "About a seven out of ten."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.55,
      "end_seconds": 57.17,
      "duration_seconds": 2.62,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 62.07,
      "end_seconds": 99.88,
      "duration_seconds": 37.81,
      "text": "Um, it usually comes with being a bit nervous at appointments. Oh, and an occasional headache. That's been about the same, five days. Erm, uh, as for occasional headache, I'd give it a six, out of ten. It happens once or twice a day. Okay, uh, so the being a bit nervous at appointments? That's been for four weeks."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.94,
      "end_seconds": 103.34,
      "duration_seconds": 2.4,
      "text": "And breathlessness, any of that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 104.0,
      "end_seconds": 105.58,
      "duration_seconds": 1.58,
      "text": "Definitely no breathlessness."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.44,
      "end_seconds": 112.29,
      "duration_seconds": 4.85,
      "text": "Have you had any leg swelling, chest pain or visual changes?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 113.54,
      "end_seconds": 117.7,
      "duration_seconds": 4.16,
      "text": "Um, you know, none of those, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.0,
      "end_seconds": 122.72,
      "duration_seconds": 4.72,
      "text": "Hm, okay. Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 124.01,
      "end_seconds": 127.06,
      "duration_seconds": 3.05,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.94,
      "end_seconds": 131.92,
      "duration_seconds": 3.98,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 133.59,
      "end_seconds": 135.19,
      "duration_seconds": 1.6,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.36,
      "end_seconds": 149.14,
      "duration_seconds": 2.78,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.17,
      "end_seconds": 155.33,
      "duration_seconds": 4.16,
      "text": "Hmm, no, nothing at the moment."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.87,
      "end_seconds": 168.44,
      "duration_seconds": 4.57,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.35,
      "end_seconds": 174.52,
      "duration_seconds": 4.17,
      "text": "Right, no, not that I know of."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.55,
      "end_seconds": 183.94,
      "duration_seconds": 3.39,
      "text": "So, a few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 184.68,
      "end_seconds": 196.61,
      "duration_seconds": 11.93,
      "text": "I'm vegetarian and have been for years. No, I share a house with my brother. Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.94,
      "end_seconds": 214.69,
      "duration_seconds": 3.75,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 215.75,
      "end_seconds": 219.23,
      "duration_seconds": 3.48,
      "text": "Um, no, nothing at all."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.47,
      "end_seconds": 225.2,
      "duration_seconds": 2.73,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.86,
      "end_seconds": 239.96,
      "duration_seconds": 2.1,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.58,
      "end_seconds": 262.54,
      "duration_seconds": 3.96,
      "text": "Okay: BP is 158 over 94, pulse 75."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 267.01,
      "end_seconds": 269.11,
      "duration_seconds": 2.1,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.96,
      "end_seconds": 274.18,
      "duration_seconds": 3.22,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.37,
      "end_seconds": 279.28,
      "duration_seconds": 3.91,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.16,
      "end_seconds": 282.61,
      "duration_seconds": 1.45,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.85,
      "end_seconds": 300.61,
      "duration_seconds": 6.76,
      "text": "Your blood pressure is a little raised in the clinic but your heart sounds are normal."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.69,
      "end_seconds": 330.2,
      "duration_seconds": 25.51,
      "text": "Please sit back down. Okay, so my impression is this: I think we're dealing with possible white-coat blood pressure at this stage. The reason I say that is that your story and my examination fit together. So, to recap quickly. You've had a high reading at the pharmacy for about a week, and no chest pain or breathlessness."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 331.03,
      "end_seconds": 331.73,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 333.34,
      "end_seconds": 339.97,
      "duration_seconds": 6.63,
      "text": "I'm going to order a 24-hour blood pressure monitor, for raised clinic blood pressure."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 341.95,
      "end_seconds": 343.22,
      "duration_seconds": 1.27,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 344.96,
      "end_seconds": 366.32,
      "duration_seconds": 21.36,
      "text": "Cut back on salt and do a week of home readings. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. Come back or go to emergency straight away if the symptoms get worse. We'll catch up after the monitor."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 367.37,
      "end_seconds": 371.03,
      "duration_seconds": 3.66,
      "text": "I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 372.37,
      "end_seconds": 376.21,
      "duration_seconds": 3.84,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 377.93,
      "end_seconds": 382.57,
      "duration_seconds": 4.64,
      "text": "I mean, I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 384.59,
      "end_seconds": 386.45,
      "duration_seconds": 1.86,
      "text": "Have a good day."
    }
  ]
}