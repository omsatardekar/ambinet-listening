{
  "schema_version": "1.0",
  "encounter_id": "01806",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.37,
      "end_seconds": 10.58,
      "duration_seconds": 9.21,
      "text": "Doctor, the patient's with us now. I did the usual checks at the front, so just say when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.24,
      "end_seconds": 15.97,
      "duration_seconds": 4.73,
      "text": "Good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 20.92,
      "end_seconds": 33.8,
      "duration_seconds": 12.88,
      "text": "Doctor, I'm just here to help with the details. Ah, you know, it's been feeling suddenly very hungry, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.28,
      "end_seconds": 38.65,
      "duration_seconds": 3.37,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 39.49,
      "end_seconds": 53.87,
      "duration_seconds": 14.38,
      "text": "For about a week, I'd say. I've also had shaky spells in the afternoon, for about four days. As for shaky spells in the afternoon, it's once or twice a day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.49,
      "end_seconds": 57.15,
      "duration_seconds": 1.66,
      "text": "Have you been sweating?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 58.33,
      "end_seconds": 68.19,
      "duration_seconds": 9.86,
      "text": "Yes, about the same, ten days. I've had being confused for a minute too, for three weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.47,
      "end_seconds": 80.47,
      "duration_seconds": 5.0,
      "text": "And what about chest pain, loss of consciousness or seizure?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 81.47,
      "end_seconds": 84.48,
      "duration_seconds": 3.01,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.32,
      "end_seconds": 87.84,
      "duration_seconds": 2.52,
      "text": "And vomiting, any of that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 88.92,
      "end_seconds": 91.23,
      "duration_seconds": 2.31,
      "text": "I haven't noticed any vomiting."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 94.22,
      "end_seconds": 99.41,
      "duration_seconds": 5.19,
      "text": "Actually, doctor, I did notice vomiting. He doesn't always say."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 103.75,
      "end_seconds": 109.98,
      "duration_seconds": 6.23,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.25,
      "end_seconds": 118.94,
      "duration_seconds": 7.69,
      "text": "Alright, I'll note both what you've said and what you've noticed. Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 119.56,
      "end_seconds": 120.54,
      "duration_seconds": 0.98,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.89,
      "end_seconds": 124.6,
      "duration_seconds": 2.71,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 126.16,
      "end_seconds": 127.71,
      "duration_seconds": 1.55,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.56,
      "end_seconds": 133.64,
      "duration_seconds": 5.08,
      "text": "Okay, what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 134.86,
      "end_seconds": 138.03,
      "duration_seconds": 3.17,
      "text": "I have diabetes, for five years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.06,
      "end_seconds": 140.0,
      "duration_seconds": 0.94,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 140.85,
      "end_seconds": 145.21,
      "duration_seconds": 4.36,
      "text": "I've had asthma for nearly five years now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.21,
      "end_seconds": 154.62,
      "duration_seconds": 8.41,
      "text": "Yes, diabetes and asthma are known to us, good to have that clear. What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 155.56,
      "end_seconds": 161.25,
      "duration_seconds": 5.69,
      "text": "Just a wisdom tooth extraction under sedation, five years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.3,
      "end_seconds": 171.06,
      "duration_seconds": 2.76,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 172.33,
      "end_seconds": 176.39,
      "duration_seconds": 4.06,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.9,
      "end_seconds": 179.87,
      "duration_seconds": 1.97,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 181.76,
      "end_seconds": 187.37,
      "duration_seconds": 5.61,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.11,
      "end_seconds": 190.16,
      "duration_seconds": 2.05,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 191.75,
      "end_seconds": 196.24,
      "duration_seconds": 4.49,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.79,
      "end_seconds": 200.78,
      "duration_seconds": 2.99,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 204.94,
      "end_seconds": 210.36,
      "duration_seconds": 5.42,
      "text": "My mother had a stroke. My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.35,
      "end_seconds": 226.51,
      "duration_seconds": 4.16,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 228.33,
      "end_seconds": 232.29,
      "duration_seconds": 3.96,
      "text": "I take Glycomet, 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 234.31,
      "end_seconds": 239.8,
      "duration_seconds": 5.49,
      "text": "Doctor, our chart from the last visit lists it as 250 milligrams."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.86,
      "end_seconds": 243.86,
      "duration_seconds": 3.0,
      "text": "Alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 246.81,
      "end_seconds": 260.22,
      "duration_seconds": 13.41,
      "text": "Not with me. I'll bring it next time. I'm on Asthalin inhaler, when needed for my asthma. Glucose tablets. I take it 4 tablets, when needed."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.4,
      "end_seconds": 265.04,
      "duration_seconds": 3.64,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 266.78,
      "end_seconds": 275.29,
      "duration_seconds": 8.51,
      "text": "Amoxicillin. I come out in... well, a rash all over. Actually, I'm allergic to walnuts, I get hives."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 275.8,
      "end_seconds": 284.55,
      "duration_seconds": 8.75,
      "text": "Here are the numbers, doctor. Saturation 97 percent, BP is 132 over 86, heart rate 107. Temp 36.7 degrees, respiratory rate 16."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.02,
      "end_seconds": 286.72,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.9,
      "end_seconds": 292.43,
      "duration_seconds": 3.53,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.39,
      "end_seconds": 296.41,
      "duration_seconds": 2.02,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.12,
      "end_seconds": 323.29,
      "duration_seconds": 8.17,
      "text": "Your sugar reading in clinic is on the low side and your pulse is a little fast."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.33,
      "end_seconds": 351.29,
      "duration_seconds": 22.96,
      "text": "Good, you can sit up again. Right, here's what I'm thinking. I can't pin this down yet. We're looking at recurrent low blood sugar on insulin or a dose that is too high. Just to be sure I understood. You've been feeling suddenly very hungry for about a week, and no loss of consciousness or chest pain."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 351.8,
      "end_seconds": 353.6,
      "duration_seconds": 1.8,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.53,
      "end_seconds": 380.19,
      "duration_seconds": 25.66,
      "text": "I'll request a download of the glucose meter, it'll help with hypoglycaemia. An HbA1c is what I'd like next, for diabetes review. I'm prescribing insulin glargine, 16 units, once a day at bedtime, long term. That's for diabetes. I'll put all of this in writing so you don't have to remember it. Always carry sugar and eat something before exercise."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 381.2,
      "end_seconds": 389.69,
      "duration_seconds": 8.49,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 390.75,
      "end_seconds": 392.51,
      "duration_seconds": 1.76,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 393.89,
      "end_seconds": 403.78,
      "duration_seconds": 9.89,
      "text": "Come back or go to emergency straight away if the symptoms get worse. Let's review you in two weeks. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 405.84,
      "end_seconds": 407.42,
      "duration_seconds": 1.58,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 409.23,
      "end_seconds": 410.56,
      "duration_seconds": 1.33,
      "text": "Look after yourself."
    }
  ]
}