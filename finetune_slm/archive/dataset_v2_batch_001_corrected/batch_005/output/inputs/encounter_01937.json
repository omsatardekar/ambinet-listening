{
  "schema_version": "1.0",
  "encounter_id": "01937",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.96,
      "end_seconds": 5.39,
      "duration_seconds": 4.43,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.99,
      "end_seconds": 10.76,
      "duration_seconds": 3.77,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.39,
      "end_seconds": 18.51,
      "duration_seconds": 7.12,
      "text": "Yeah, it's chest pain after a crash. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.23,
      "end_seconds": 23.91,
      "duration_seconds": 3.68,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.86,
      "end_seconds": 28.54,
      "duration_seconds": 3.68,
      "text": "Since yesterday, that's when it began."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.26,
      "end_seconds": 37.95,
      "duration_seconds": 8.69,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.37,
      "end_seconds": 47.26,
      "duration_seconds": 7.89,
      "text": "It's, It's worse with breathing. Moderate, I'd say. Honestly, once or twice a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.32,
      "end_seconds": 52.13,
      "duration_seconds": 2.81,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.72,
      "end_seconds": 61.3,
      "duration_seconds": 8.58,
      "text": "It usually comes with difficulty breathing. The, The difficulty breathing? That's been since Monday."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.49,
      "end_seconds": 70.71,
      "duration_seconds": 8.22,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.31,
      "end_seconds": 80.84,
      "duration_seconds": 9.53,
      "text": "Erm, I'd say every other day. Maybe a three out of ten on a bad day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.36,
      "end_seconds": 83.73,
      "duration_seconds": 2.37,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.68,
      "end_seconds": 90.3,
      "duration_seconds": 4.62,
      "text": "Hmm, it's rosuvastatin, 10 milligrams, at night."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.16,
      "end_seconds": 95.08,
      "duration_seconds": 3.92,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.83,
      "end_seconds": 100.84,
      "duration_seconds": 4.01,
      "text": "I've had high cholesterol for two years now."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.18,
      "end_seconds": 104.13,
      "duration_seconds": 1.95,
      "text": "I follow. How about smoking?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.09,
      "end_seconds": 109.14,
      "duration_seconds": 4.05,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.23,
      "end_seconds": 113.6,
      "duration_seconds": 3.37,
      "text": "Okay, what do you do during the day?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.53,
      "end_seconds": 119.12,
      "duration_seconds": 3.59,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.21,
      "end_seconds": 123.01,
      "duration_seconds": 1.8,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.99,
      "end_seconds": 127.62,
      "duration_seconds": 2.63,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.02,
      "end_seconds": 131.4,
      "duration_seconds": 2.38,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.58,
      "end_seconds": 138.45,
      "duration_seconds": 5.87,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.05,
      "end_seconds": 150.25,
      "duration_seconds": 4.2,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.95,
      "end_seconds": 155.99,
      "duration_seconds": 4.04,
      "text": "Yes, naproxen, it gives me stomach pain."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.48,
      "end_seconds": 175.35,
      "duration_seconds": 5.87,
      "text": "Have you had any neck pain, loss of consciousness or head injury?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.05,
      "end_seconds": 182.68,
      "duration_seconds": 6.63,
      "text": "No, um, no neck pain, loss of consciousness or head injury."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.17,
      "end_seconds": 187.99,
      "duration_seconds": 3.82,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.89,
      "end_seconds": 193.47,
      "duration_seconds": 3.58,
      "text": "Mm, no, nothing with my heart."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.09,
      "end_seconds": 198.17,
      "duration_seconds": 4.08,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.07,
      "end_seconds": 201.17,
      "duration_seconds": 2.1,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.03,
      "end_seconds": 206.06,
      "duration_seconds": 4.03,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.86,
      "end_seconds": 218.11,
      "duration_seconds": 2.25,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.3,
      "end_seconds": 232.26,
      "duration_seconds": 4.96,
      "text": "Okay: temperature 36.9, heart rate 110, BP is 98 over 66."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.01,
      "end_seconds": 239.43,
      "duration_seconds": 4.42,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.23,
      "end_seconds": 242.4,
      "duration_seconds": 1.17,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.5,
      "end_seconds": 244.81,
      "duration_seconds": 1.31,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.1,
      "end_seconds": 268.35,
      "duration_seconds": 8.25,
      "text": "There is bruising across the chest, the left side moves less, and the belly is tender and rigid."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.02,
      "end_seconds": 283.4,
      "duration_seconds": 10.38,
      "text": "Good, you can sit up again. Putting it all together, I'd lean towards serious chest and abdominal injury. Internal bleeding is still possible."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.35,
      "end_seconds": 310.94,
      "duration_seconds": 9.59,
      "text": "I'll request an urgent blood cross-match, it'll help with trauma. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.81,
      "end_seconds": 313.64,
      "duration_seconds": 1.83,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.72,
      "end_seconds": 319.0,
      "duration_seconds": 4.28,
      "text": "We should do a trauma CT scan for major trauma."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.12,
      "end_seconds": 321.23,
      "duration_seconds": 1.11,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.09,
      "end_seconds": 338.16,
      "duration_seconds": 16.07,
      "text": "Do not move, I am activating the trauma team now. Let's get you seen by the trauma team, I'll arrange the letter. If the symptoms get worse, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.68,
      "end_seconds": 340.37,
      "duration_seconds": 1.69,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.27,
      "end_seconds": 348.18,
      "duration_seconds": 6.91,
      "text": "I'd like you back straight away. Okay, is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.67,
      "end_seconds": 353.44,
      "duration_seconds": 3.77,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.27,
      "end_seconds": 356.52,
      "duration_seconds": 1.25,
      "text": "Take care now."
    }
  ]
}