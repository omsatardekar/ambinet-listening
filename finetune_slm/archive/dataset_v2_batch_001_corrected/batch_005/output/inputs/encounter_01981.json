{
  "schema_version": "1.0",
  "encounter_id": "01981",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.62,
      "end_seconds": 6.1,
      "duration_seconds": 5.48,
      "text": "Uh, you know, sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.65,
      "end_seconds": 11.27,
      "duration_seconds": 3.62,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.38,
      "end_seconds": 21.45,
      "duration_seconds": 9.07,
      "text": "Doctor, you know, it's a painful blistering rash on one side. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.07,
      "end_seconds": 28.45,
      "duration_seconds": 3.38,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.38,
      "end_seconds": 36.33,
      "duration_seconds": 6.95,
      "text": "About... well, about a week. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.56,
      "end_seconds": 42.4,
      "duration_seconds": 1.84,
      "text": "What brings it on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.92,
      "end_seconds": 46.58,
      "duration_seconds": 2.66,
      "text": "Mm, it's worse with touch."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.31,
      "end_seconds": 51.07,
      "duration_seconds": 2.76,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.78,
      "end_seconds": 58.74,
      "duration_seconds": 5.96,
      "text": "Burning pain before the rash goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.51,
      "end_seconds": 76.02,
      "duration_seconds": 3.51,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.91,
      "end_seconds": 92.46,
      "duration_seconds": 2.55,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.7,
      "end_seconds": 120.27,
      "duration_seconds": 15.57,
      "text": "Okay: pulse is 73 beats a minute, temperature 36.5, height 185 centimetres, BMI works out to 25.1, weight 86 kilos, respiratory rate 18, BP is 125 over 72, saturation 97 percent."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.6,
      "end_seconds": 125.69,
      "duration_seconds": 4.09,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.3,
      "end_seconds": 141.41,
      "duration_seconds": 1.11,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.18,
      "end_seconds": 145.37,
      "duration_seconds": 2.19,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.68,
      "end_seconds": 168.72,
      "duration_seconds": 8.04,
      "text": "There are grouped blisters on a red base along one band on the right side and none cross the midline."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.87,
      "end_seconds": 179.59,
      "duration_seconds": 7.72,
      "text": "That's all I needed to check. Alright, have you had any weakness, fever or rash across the midline?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.21,
      "end_seconds": 183.1,
      "duration_seconds": 2.89,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.73,
      "end_seconds": 184.98,
      "duration_seconds": 1.25,
      "text": "Any eye involvement?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.59,
      "end_seconds": 187.98,
      "duration_seconds": 2.39,
      "text": "No, no eye involvement."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.72,
      "end_seconds": 193.78,
      "duration_seconds": 4.06,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.82,
      "end_seconds": 199.22,
      "duration_seconds": 2.4,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.26,
      "end_seconds": 203.65,
      "duration_seconds": 3.39,
      "text": "So, any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.32,
      "end_seconds": 205.86,
      "duration_seconds": 1.54,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.53,
      "end_seconds": 211.46,
      "duration_seconds": 3.93,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.15,
      "end_seconds": 224.91,
      "duration_seconds": 11.76,
      "text": "An underactive thyroid, for about ten years. I'm hoping you can tell me something definite. Okay, so I have high cholesterol, for five years."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.04,
      "end_seconds": 229.03,
      "duration_seconds": 2.99,
      "text": "Right, is there someone at home?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.66,
      "end_seconds": 234.3,
      "duration_seconds": 3.64,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.01,
      "end_seconds": 238.57,
      "duration_seconds": 3.56,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.9,
      "end_seconds": 243.68,
      "duration_seconds": 3.78,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.22,
      "end_seconds": 246.52,
      "duration_seconds": 2.3,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.36,
      "end_seconds": 252.94,
      "duration_seconds": 4.58,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.64,
      "end_seconds": 265.1,
      "duration_seconds": 2.46,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.04,
      "end_seconds": 272.34,
      "duration_seconds": 6.3,
      "text": "I'm allergic to nickel, I get a rash on my skin."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.57,
      "end_seconds": 276.32,
      "duration_seconds": 2.75,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.09,
      "end_seconds": 280.06,
      "duration_seconds": 2.97,
      "text": "Erm, no, not at all."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.65,
      "end_seconds": 284.58,
      "duration_seconds": 3.93,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.39,
      "end_seconds": 294.64,
      "duration_seconds": 9.25,
      "text": "I take Eltroxin, 100 micrograms, every morning. Yeah, I take atorvastatin, 20 milligrams, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.1,
      "end_seconds": 301.69,
      "duration_seconds": 6.59,
      "text": "I follow. Let me tell you where I've got to. This is probably shingles."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.15,
      "end_seconds": 305.49,
      "duration_seconds": 2.34,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.09,
      "end_seconds": 326.79,
      "duration_seconds": 20.7,
      "text": "Nothing I've seen today points to an emergency. It looks like shingles. Keep the rash covered and stay away from pregnant women and newborn babies until it has crusted. Do get help quickly if the rash spreads to your face or eye."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.84,
      "end_seconds": 331.19,
      "duration_seconds": 3.35,
      "text": "Okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.9,
      "end_seconds": 335.84,
      "duration_seconds": 3.94,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.68,
      "end_seconds": 340.13,
      "duration_seconds": 3.45,
      "text": "Great, thank you for your help."
    }
  ]
}