{
  "schema_version": "1.0",
  "encounter_id": "01845",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.01,
      "end_seconds": 4.68,
      "duration_seconds": 3.67,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.24,
      "end_seconds": 10.25,
      "duration_seconds": 4.01,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.76,
      "end_seconds": 15.98,
      "duration_seconds": 5.22,
      "text": "Yeah, it's smaller handwriting. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.63,
      "end_seconds": 20.8,
      "duration_seconds": 3.17,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.89,
      "end_seconds": 25.07,
      "duration_seconds": 3.18,
      "text": "For about a week, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.55,
      "end_seconds": 30.55,
      "duration_seconds": 5.0,
      "text": "Yes, carry on. Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.64,
      "end_seconds": 33.35,
      "duration_seconds": 1.71,
      "text": "Severe, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.27,
      "end_seconds": 37.7,
      "duration_seconds": 2.43,
      "text": "Any a stiff arm as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.03,
      "end_seconds": 50.51,
      "duration_seconds": 6.48,
      "text": "Yes, for about three months. With stiff arm, I'd say mild."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.7,
      "end_seconds": 54.09,
      "duration_seconds": 2.39,
      "text": "Has there been slowness too?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.25,
      "end_seconds": 57.66,
      "duration_seconds": 2.41,
      "text": "Yes, for about two weeks."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.27,
      "end_seconds": 62.7,
      "duration_seconds": 3.43,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.61,
      "end_seconds": 66.28,
      "duration_seconds": 1.67,
      "text": "Mild, I'd say."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.0,
      "end_seconds": 71.45,
      "duration_seconds": 3.45,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.74,
      "end_seconds": 76.17,
      "duration_seconds": 3.43,
      "text": "Escitalopram, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.8,
      "end_seconds": 95.06,
      "duration_seconds": 1.26,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.85,
      "end_seconds": 98.61,
      "duration_seconds": 1.76,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.55,
      "end_seconds": 101.99,
      "duration_seconds": 2.44,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.66,
      "end_seconds": 105.89,
      "duration_seconds": 3.23,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.06,
      "end_seconds": 108.77,
      "duration_seconds": 1.71,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.37,
      "end_seconds": 111.77,
      "duration_seconds": 2.4,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.64,
      "end_seconds": 114.66,
      "duration_seconds": 2.02,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.2,
      "end_seconds": 120.11,
      "duration_seconds": 4.91,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.83,
      "end_seconds": 125.29,
      "duration_seconds": 3.46,
      "text": "Alright, does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.75,
      "end_seconds": 129.3,
      "duration_seconds": 2.55,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.85,
      "end_seconds": 145.49,
      "duration_seconds": 2.64,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.06,
      "end_seconds": 150.98,
      "duration_seconds": 4.92,
      "text": "I had my womb taken out fifteen years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.94,
      "end_seconds": 157.35,
      "duration_seconds": 4.41,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.9,
      "end_seconds": 161.1,
      "duration_seconds": 2.2,
      "text": "Anxiety, for five years."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.2,
      "end_seconds": 163.0,
      "duration_seconds": 0.8,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.61,
      "end_seconds": 165.2,
      "duration_seconds": 1.59,
      "text": "Yes, thin bones."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.56,
      "end_seconds": 175.45,
      "duration_seconds": 8.89,
      "text": "Right, so thin bones is already on your record. We'll keep that in mind today. Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.93,
      "end_seconds": 179.7,
      "duration_seconds": 2.77,
      "text": "Yes, tramadol. I get vomiting."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.31,
      "end_seconds": 183.48,
      "duration_seconds": 2.17,
      "text": "And falls, any of that?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.44,
      "end_seconds": 187.17,
      "duration_seconds": 1.73,
      "text": "Nope, no falls."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.06,
      "end_seconds": 194.26,
      "duration_seconds": 6.2,
      "text": "Let me check a few things. Any memory problems, constipation or loss of smell?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.83,
      "end_seconds": 198.46,
      "duration_seconds": 3.63,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.78,
      "end_seconds": 203.11,
      "duration_seconds": 3.33,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.48,
      "end_seconds": 209.38,
      "duration_seconds": 0.9,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.93,
      "end_seconds": 213.2,
      "duration_seconds": 3.27,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.12,
      "end_seconds": 223.41,
      "duration_seconds": 2.29,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.33,
      "end_seconds": 243.97,
      "duration_seconds": 4.64,
      "text": "Okay: pulse 73, blood pressure 113 over 82, temperature 36.4."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.35,
      "end_seconds": 250.54,
      "duration_seconds": 4.19,
      "text": "Right, now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.46,
      "end_seconds": 254.44,
      "duration_seconds": 1.98,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.28,
      "end_seconds": 270.44,
      "duration_seconds": 8.16,
      "text": "There is a pill-rolling tremor at rest on the right and the arm is stiff with a cogwheel feel."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.94,
      "end_seconds": 277.76,
      "duration_seconds": 1.82,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.6,
      "end_seconds": 301.47,
      "duration_seconds": 8.87,
      "text": "Right, here's what I'm thinking. The most likely explanation is possible Parkinson's disease. We should do a blood test for tremor."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.3,
      "end_seconds": 304.66,
      "duration_seconds": 2.36,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.24,
      "end_seconds": 310.42,
      "duration_seconds": 4.18,
      "text": "I'm referring you to the specialist and meanwhile keep active."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.95,
      "end_seconds": 320.74,
      "duration_seconds": 9.79,
      "text": "Understood. Let's get you seen by the movement disorders clinic, I'll arrange the letter. Do get help quickly if the symptoms get worse."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.71,
      "end_seconds": 323.63,
      "duration_seconds": 1.92,
      "text": "Thank you, that's clear."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.62,
      "end_seconds": 328.2,
      "duration_seconds": 2.58,
      "text": "We'll catch up after the specialist."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.0,
      "end_seconds": 333.11,
      "duration_seconds": 3.11,
      "text": "I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.87,
      "end_seconds": 340.68,
      "duration_seconds": 5.81,
      "text": "How would you describe the plan, so we're on the same page?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.54,
      "end_seconds": 348.3,
      "duration_seconds": 6.76,
      "text": "So, uh, I come back after the specialist. Is that right?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.0,
      "end_seconds": 355.0,
      "duration_seconds": 5.0,
      "text": "Yes, exactly right. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 355.58,
      "end_seconds": 357.67,
      "duration_seconds": 2.09,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.75,
      "end_seconds": 361.0,
      "duration_seconds": 1.25,
      "text": "Goodbye for now."
    }
  ]
}