{
  "schema_version": "1.0",
  "encounter_id": "01879",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.26,
      "end_seconds": 3.71,
      "duration_seconds": 2.45,
      "text": "Right then, come on in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.5,
      "end_seconds": 11.05,
      "duration_seconds": 5.55,
      "text": "Hi doctor, I got here as fast as I could."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.07,
      "end_seconds": 16.22,
      "duration_seconds": 3.15,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.07,
      "end_seconds": 26.46,
      "duration_seconds": 8.39,
      "text": "That's fine, sit down. We'll go through it together. Sorry about the wait, we're running a bit behind."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 30.14,
      "end_seconds": 37.04,
      "duration_seconds": 6.9,
      "text": "Oh, that's fine. I was just reading something on my phone."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 38.81,
      "end_seconds": 40.14,
      "duration_seconds": 1.33,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 41.3,
      "end_seconds": 46.86,
      "duration_seconds": 5.56,
      "text": "It's vomiting. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.17,
      "end_seconds": 54.27,
      "duration_seconds": 2.1,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 55.24,
      "end_seconds": 59.29,
      "duration_seconds": 4.05,
      "text": "Since last Tuesday, that's when it began."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.52,
      "end_seconds": 63.47,
      "duration_seconds": 2.95,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.02,
      "end_seconds": 68.62,
      "duration_seconds": 3.6,
      "text": "It usually comes with a fast heart."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.28,
      "end_seconds": 74.79,
      "duration_seconds": 4.51,
      "text": "Have you had vomiting before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.72,
      "end_seconds": 83.0,
      "duration_seconds": 6.28,
      "text": "I had a similar thing about six months ago. It went away."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.97,
      "end_seconds": 88.13,
      "duration_seconds": 3.16,
      "text": "Did you get black stools or chest pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 90.06,
      "end_seconds": 95.46,
      "duration_seconds": 5.4,
      "text": "No black stools or chest pain, none of it."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.18,
      "end_seconds": 99.15,
      "duration_seconds": 2.97,
      "text": "Have you noticed yellow eyes or fever?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.91,
      "end_seconds": 103.24,
      "duration_seconds": 2.33,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.1,
      "end_seconds": 107.31,
      "duration_seconds": 2.21,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.47,
      "end_seconds": 112.16,
      "duration_seconds": 3.69,
      "text": "No, uh, my breathing's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.51,
      "end_seconds": 116.88,
      "duration_seconds": 3.37,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.6,
      "end_seconds": 124.73,
      "duration_seconds": 6.13,
      "text": "Hmm, I've had high blood pressure for five years now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.75,
      "end_seconds": 131.85,
      "duration_seconds": 5.1,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.74,
      "end_seconds": 149.17,
      "duration_seconds": 16.43,
      "text": "I only drink at family occasions. No, I've never smoked in my life. Yes, I work in a bakery, early starts. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.43,
      "end_seconds": 160.86,
      "duration_seconds": 2.43,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 162.57,
      "end_seconds": 166.03,
      "duration_seconds": 3.46,
      "text": "Erm, no, nothing at the moment."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.88,
      "end_seconds": 171.22,
      "duration_seconds": 2.34,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 171.87,
      "end_seconds": 188.27,
      "duration_seconds": 16.4,
      "text": "Um, yes, I had a mole taken off my arm, a few years ago. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.78,
      "end_seconds": 207.38,
      "duration_seconds": 4.6,
      "text": "Okay, are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 209.28,
      "end_seconds": 212.92,
      "duration_seconds": 3.64,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.54,
      "end_seconds": 230.49,
      "duration_seconds": 1.95,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.1,
      "end_seconds": 243.58,
      "duration_seconds": 2.48,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.16,
      "end_seconds": 269.59,
      "duration_seconds": 9.43,
      "text": "Okay: BP is 133 over 82, temp 36.8 degrees. And oxygen saturation is 98 percent, heart rate 116."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 271.18,
      "end_seconds": 272.84,
      "duration_seconds": 1.66,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.89,
      "end_seconds": 275.95,
      "duration_seconds": 2.06,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.77,
      "end_seconds": 282.65,
      "duration_seconds": 3.88,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.5,
      "end_seconds": 284.68,
      "duration_seconds": 1.18,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 295.07,
      "end_seconds": 299.38,
      "duration_seconds": 4.31,
      "text": "Your upper tummy is very tender and you look dehydrated."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.62,
      "end_seconds": 313.42,
      "duration_seconds": 10.8,
      "text": "Good, you can sit up again. We should do an amylase blood test for severe abdominal pain. I'll request an abdominal scan, it'll help with pancreatitis."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 315.26,
      "end_seconds": 318.79,
      "duration_seconds": 3.53,
      "text": "Uh, is that done today?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 320.02,
      "end_seconds": 339.16,
      "duration_seconds": 19.14,
      "text": "You need admission for fluids and pain relief, nothing to eat for now. A short walk every day, even twenty minutes, will help more than you'd think. See me again straight away. Okay, what are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 339.81,
      "end_seconds": 345.04,
      "duration_seconds": 5.23,
      "text": "So, I come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 345.62,
      "end_seconds": 349.28,
      "duration_seconds": 3.66,
      "text": "Yes, exactly right. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 349.87,
      "end_seconds": 353.34,
      "duration_seconds": 3.47,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 354.97,
      "end_seconds": 356.23,
      "duration_seconds": 1.26,
      "text": "Take care now."
    }
  ]
}