{
  "schema_version": "1.0",
  "encounter_id": "01501",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.7,
      "end_seconds": 5.72,
      "duration_seconds": 5.02,
      "text": "ready for you, doctor. I'll stay in case you need anything"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.33,
      "end_seconds": 11.82,
      "duration_seconds": 4.49,
      "text": "Right, thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.59,
      "end_seconds": 19.76,
      "duration_seconds": 7.17,
      "text": "Um, doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.92,
      "end_seconds": 24.84,
      "duration_seconds": 3.92,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 30.65,
      "end_seconds": 36.19,
      "duration_seconds": 5.54,
      "text": "I've been dealing with a tingling lip then a blister."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.8,
      "end_seconds": 38.19,
      "duration_seconds": 1.39,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 38.91,
      "end_seconds": 43.28,
      "duration_seconds": 4.37,
      "text": "let me think, around three days, I think"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 44.83,
      "end_seconds": 48.71,
      "duration_seconds": 3.88,
      "text": "Hm, I'd say more like five days."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.53,
      "end_seconds": 59.07,
      "duration_seconds": 4.54,
      "text": "Okay, so roughly three to five days. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 59.75,
      "end_seconds": 61.86,
      "duration_seconds": 2.11,
      "text": "That sounds about right."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.99,
      "end_seconds": 72.05,
      "duration_seconds": 9.06,
      "text": "Okay, can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 72.84,
      "end_seconds": 81.86,
      "duration_seconds": 9.02,
      "text": "it comes and goes. I notice it more with sunlight. And there's crusting as well, two weeks now"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.1,
      "end_seconds": 86.54,
      "duration_seconds": 3.44,
      "text": "would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 88.23,
      "end_seconds": 90.19,
      "duration_seconds": 1.96,
      "text": "Mild, I'd say."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.08,
      "end_seconds": 94.31,
      "duration_seconds": 3.23,
      "text": "have you had a mild sore feeling?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 96.01,
      "end_seconds": 97.64,
      "duration_seconds": 1.63,
      "text": "Yes, since yesterday."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.3,
      "end_seconds": 101.88,
      "duration_seconds": 3.58,
      "text": "Alright, how strong would you say it is?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 103.54,
      "end_seconds": 104.64,
      "duration_seconds": 1.1,
      "text": "Mostly severe."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.4,
      "end_seconds": 110.9,
      "duration_seconds": 4.5,
      "text": "So, have you had rash elsewhere, by any chance?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 112.96,
      "end_seconds": 117.21,
      "duration_seconds": 4.25,
      "text": "Not at all, uh, no rash elsewhere."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.64,
      "end_seconds": 124.15,
      "duration_seconds": 5.51,
      "text": "any fever, eye pain or sores in the mouth at all?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 125.79,
      "end_seconds": 132.87,
      "duration_seconds": 7.08,
      "text": "I haven't had fever, eye pain or sores in the mouth, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.69,
      "end_seconds": 138.31,
      "duration_seconds": 3.62,
      "text": "how about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 139.94,
      "end_seconds": 142.26,
      "duration_seconds": 2.32,
      "text": "no, that's been fine"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.97,
      "end_seconds": 146.78,
      "duration_seconds": 3.81,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 147.92,
      "end_seconds": 151.29,
      "duration_seconds": 3.37,
      "text": "No, you know, that's all normal."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.39,
      "end_seconds": 155.78,
      "duration_seconds": 2.39,
      "text": "have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 157.23,
      "end_seconds": 158.36,
      "duration_seconds": 1.13,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.16,
      "end_seconds": 164.17,
      "duration_seconds": 5.01,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 166.0,
      "end_seconds": 170.54,
      "duration_seconds": 4.54,
      "text": "no, you know, I'm not allergic to anything"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 171.32,
      "end_seconds": 180.12,
      "duration_seconds": 8.8,
      "text": "Well, um, I'm not sure that's right. I seem to recall a problem with tramadol."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 182.2,
      "end_seconds": 185.31,
      "duration_seconds": 3.11,
      "text": "Ah, really? I don't think so."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.01,
      "end_seconds": 192.23,
      "duration_seconds": 5.22,
      "text": "Okay, I'll note both of those. Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 193.92,
      "end_seconds": 204.46,
      "duration_seconds": 10.54,
      "text": "Yeah, I've had asthma for about a year now. Yes, anxiety. I have high cholesterol, for two years."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.38,
      "end_seconds": 210.83,
      "duration_seconds": 4.45,
      "text": "Alright, high cholesterol, that matches what I have here."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.44,
      "end_seconds": 227.76,
      "duration_seconds": 3.32,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 229.21,
      "end_seconds": 243.49,
      "duration_seconds": 14.28,
      "text": "I drink a lot of tea and snack through the day. Not much, I mostly stay in these days. I'm a plumber, lots of bending and kneeling"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.45,
      "end_seconds": 247.18,
      "duration_seconds": 2.73,
      "text": "Right, tell me your medicines, please."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 248.94,
      "end_seconds": 254.13,
      "duration_seconds": 5.19,
      "text": "yeah, it's Seretide inhaler, twice a day for my asthma"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 254.64,
      "end_seconds": 261.13,
      "duration_seconds": 6.49,
      "text": "That's what's prescribed, but I'm not sure he takes it every day."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 261.68,
      "end_seconds": 274.01,
      "duration_seconds": 12.33,
      "text": "let me think, I'm on escitalopram, 10 milligrams, once a day i'm on simvastatin, 20 milligrams, at night for my cholesterol"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 287.37,
      "end_seconds": 296.62,
      "duration_seconds": 9.25,
      "text": "okay, so the the vitals from earlier oxygen saturation is 97 percent, pressure 115 over 68, pulse 68. Temp 36.8 degrees"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.63,
      "end_seconds": 299.6,
      "duration_seconds": 0.97,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.18,
      "end_seconds": 304.05,
      "duration_seconds": 2.87,
      "text": "okay, time for me to examine you"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 305.18,
      "end_seconds": 306.3,
      "duration_seconds": 1.12,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.41,
      "end_seconds": 308.8,
      "duration_seconds": 1.39,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.51,
      "end_seconds": 329.57,
      "duration_seconds": 6.06,
      "text": "there is a small cluster of blisters on the edge of the upper lip"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.37,
      "end_seconds": 334.26,
      "duration_seconds": 1.89,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.98,
      "end_seconds": 364.31,
      "duration_seconds": 15.33,
      "text": "so where does that leave us? The most likely explanation is a cold sore. Stop me if I've got anything wrong. You've had a tingling lip then a blister, and no sores in the mouth or rash elsewhere"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 365.12,
      "end_seconds": 367.45,
      "duration_seconds": 2.33,
      "text": "That's what happened, yes."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.4,
      "end_seconds": 387.53,
      "duration_seconds": 18.13,
      "text": "We'll begin with aciclovir cream, 5%, five times a day, five days. That's for cold sore. The pharmacy will go through the details again when you pick it up. Avoid kissing and sharing towels until it has crusted over. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 388.27,
      "end_seconds": 393.07,
      "duration_seconds": 4.8,
      "text": "Um, great, thank you for your help."
    }
  ]
}