      "role": "DOCTOR",
      "start_seconds": 24.33,
      "end_seconds": 28.47,
      "duration_seconds": 4.14,
      "text": "Okay, can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.26,
      "end_seconds": 31.19,
      "duration_seconds": 1.93,
      "text": "About... well, one week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.21,
      "end_seconds": 35.03,
      "duration_seconds": 2.82,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.17,
      "end_seconds": 48.54,
      "duration_seconds": 2.37,
      "text": "Nearly done with the readings..."
