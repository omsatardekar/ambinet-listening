      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.16,
      "end_seconds": 63.79,
      "duration_seconds": 5.63,
      "text": "okay: pulse 70, saturation 99 percent, blood pressure 122 over 77."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.63,
      "end_seconds": 67.97,
      "duration_seconds": 3.34,
      "text": "uh, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.45,
      "end_seconds": 73.58,
      "duration_seconds": 4.13,
      "text": "So, I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.03,
      "end_seconds": 78.16,
      "duration_seconds": 2.13,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.08,
      "end_seconds": 81.73,
      "duration_seconds": 2.65,
      "text": "take a deep breath for me"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.46,
      "end_seconds": 98.67,
      "duration_seconds": 5.21,
      "text": "There are some crackles at the top of the right lung."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.22,
      "end_seconds": 106.05,
      "duration_seconds": 2.83,
      "text": "good, you can sit up again"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.51,
      "end_seconds": 128.03,
      "duration_seconds": 4.52,
      "text": "Did you get HIV, coughing up blood or fever?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.62,
      "end_seconds": 133.97,
      "duration_seconds": 5.35,
      "text": "Mm, no HIV, coughing up blood or fever, none of it."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.3,
      "end_seconds": 138.12,
      "duration_seconds": 2.82,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.56,
      "end_seconds": 141.81,
      "duration_seconds": 2.25,
      "text": "no, joints are fine"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.28,
      "end_seconds": 147.98,
      "duration_seconds": 4.7,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.0,
      "end_seconds": 156.34,
      "duration_seconds": 3.34,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.9,
      "end_seconds": 160.01,
      "duration_seconds": 2.11,
      "text": "Right, how active are you?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.9,
      "end_seconds": 164.48,
      "duration_seconds": 3.58,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.47,
      "end_seconds": 169.48,
      "duration_seconds": 3.01,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.1,
      "end_seconds": 176.4,
      "duration_seconds": 5.3,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.4,
      "end_seconds": 197.26,
      "duration_seconds": 4.86,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.99,
      "end_seconds": 203.09,
      "duration_seconds": 5.1,
      "text": "I've had high cholesterol for nearly five years now"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.98,
      "end_seconds": 219.6,
      "duration_seconds": 2.62,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.32,
      "end_seconds": 226.46,
      "duration_seconds": 5.14,
      "text": "Simvastatin. I take it 20 milligrams, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.9,
      "end_seconds": 237.3,
      "duration_seconds": 3.4,
      "text": "Alright, have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.99,
      "end_seconds": 244.63,
      "duration_seconds": 5.64,
      "text": "I had keyhole surgery on my gallbladder two years back."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.32,
      "end_seconds": 279.0,
      "duration_seconds": 33.68,
      "text": "From what you've told me and what I found, it's hard to say. Possible tuberculosis is one possibility and a chest infection another, and I'd rather not commit yet. Let's book three sputum samples to look into Possible tuberculosis. Wear a mask in public and cover your mouth when you cough until the results are back. Let's review you after the tests. Okay, before we finish, can you repeat the plan back to me?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.62,
      "end_seconds": 285.64,
      "duration_seconds": 5.02,
      "text": "So, I come back after the tests. Is that right?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.67,
      "end_seconds": 293.92,
      "duration_seconds": 4.25,
      "text": "Okay, yes, exactly right. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.04,
      "end_seconds": 297.22,
      "duration_seconds": 2.18,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.31,
      "end_seconds": 300.55,
      "duration_seconds": 1.24,
      "text": "all the best"
    }
  ]
