{
  "schema_version": "1.0",
  "encounter_id": "01772",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.37,
      "end_seconds": 4.6,
      "duration_seconds": 3.23,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.32,
      "end_seconds": 14.31,
      "duration_seconds": 3.99,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.29,
      "end_seconds": 19.87,
      "duration_seconds": 4.58,
      "text": "I've been dealing with red sore skin on my shoulders."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.57,
      "end_seconds": 24.83,
      "duration_seconds": 3.26,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.62,
      "end_seconds": 36.43,
      "duration_seconds": 10.81,
      "text": "It's been about a month, I'm fairly sure. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.24,
      "end_seconds": 39.17,
      "duration_seconds": 1.93,
      "text": "Anything that improves it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.2,
      "end_seconds": 43.67,
      "duration_seconds": 2.47,
      "text": "Cool showers helps a bit."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.74,
      "end_seconds": 50.04,
      "duration_seconds": 4.3,
      "text": "What about tightness of the skin, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.55,
      "end_seconds": 62.76,
      "duration_seconds": 11.21,
      "text": "Yeah, I've had that since last weekend. Sorry, what was I saying, as for tightness of the skin, it sort of comes and goes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.59,
      "end_seconds": 78.46,
      "duration_seconds": 4.87,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.53,
      "end_seconds": 87.65,
      "duration_seconds": 2.12,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.14,
      "end_seconds": 109.4,
      "duration_seconds": 9.26,
      "text": "Okay: temperature 36.7, pulse is 79 beats a minute, oxygen saturation is 99 percent, blood pressure 108 over 70."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.34,
      "end_seconds": 113.67,
      "duration_seconds": 2.33,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.21,
      "end_seconds": 118.65,
      "duration_seconds": 3.44,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.8,
      "end_seconds": 125.69,
      "duration_seconds": 4.89,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.02,
      "end_seconds": 129.0,
      "duration_seconds": 1.98,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.5,
      "end_seconds": 148.02,
      "duration_seconds": 3.52,
      "text": "The skin is pink and tender with no blistering."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.88,
      "end_seconds": 159.71,
      "duration_seconds": 5.83,
      "text": "Good, you can sit up again. Have you had any vomiting, blisters or headache?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.31,
      "end_seconds": 164.66,
      "duration_seconds": 3.35,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.89,
      "end_seconds": 169.9,
      "duration_seconds": 4.01,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.74,
      "end_seconds": 173.55,
      "duration_seconds": 1.81,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.49,
      "end_seconds": 194.14,
      "duration_seconds": 4.65,
      "text": "Alright, are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.7,
      "end_seconds": 198.26,
      "duration_seconds": 2.56,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.53,
      "end_seconds": 213.86,
      "duration_seconds": 2.33,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.42,
      "end_seconds": 221.84,
      "duration_seconds": 7.42,
      "text": "It's alendronate, 70 milligrams, once a week. After-sun lotion. I take it twice a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.02,
      "end_seconds": 232.65,
      "duration_seconds": 3.63,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.41,
      "end_seconds": 238.3,
      "duration_seconds": 4.89,
      "text": "I've had thin bones for about ten years now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.63,
      "end_seconds": 245.74,
      "duration_seconds": 6.11,
      "text": "Okay, I can see thin bones in your file as well. Right, what's your work?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.29,
      "end_seconds": 250.72,
      "duration_seconds": 4.43,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.28,
      "end_seconds": 257.68,
      "duration_seconds": 2.4,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.5,
      "end_seconds": 263.28,
      "duration_seconds": 3.78,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.84,
      "end_seconds": 266.09,
      "duration_seconds": 2.25,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.13,
      "end_seconds": 272.3,
      "duration_seconds": 4.17,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.72,
      "end_seconds": 280.75,
      "duration_seconds": 7.03,
      "text": "Let me tell you where I've got to. I think we're dealing with mild sunburn at this stage."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.71,
      "end_seconds": 283.81,
      "duration_seconds": 2.1,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.74,
      "end_seconds": 306.83,
      "duration_seconds": 22.09,
      "text": "I understand the worry. At the moment I'd say it's mild sunburn, and we'll watch how it goes. Cool compresses, moisturiser and stay out of the sun for a few days. Let's review you if blisters develop. Right, does all of that make sense?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.88,
      "end_seconds": 312.81,
      "duration_seconds": 3.93,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.53,
      "end_seconds": 314.78,
      "duration_seconds": 1.25,
      "text": "Goodbye for now."
    }
  ]
}