{
  "schema_version": "1.0",
  "encounter_id": "01862",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.29,
      "end_seconds": 5.87,
      "duration_seconds": 4.58,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.85,
      "end_seconds": 11.02,
      "duration_seconds": 4.17,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.44,
      "end_seconds": 21.2,
      "duration_seconds": 5.76,
      "text": "Honestly, it's a swollen tummy, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.85,
      "end_seconds": 24.76,
      "duration_seconds": 2.91,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.52,
      "end_seconds": 38.95,
      "duration_seconds": 2.43,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.14,
      "end_seconds": 65.25,
      "duration_seconds": 11.11,
      "text": "Okay: pulse is 115 beats a minute, pressure 123 over 85. And SpO2 99 percent on room air, temperature is 37.1 degrees, respiratory rate 18."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.18,
      "end_seconds": 73.49,
      "duration_seconds": 3.31,
      "text": "Is that alright, you know, doctor?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.38,
      "end_seconds": 78.06,
      "duration_seconds": 3.68,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.15,
      "end_seconds": 98.31,
      "duration_seconds": 3.16,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.81,
      "end_seconds": 112.64,
      "duration_seconds": 10.83,
      "text": "I've had it for about three months. I'd rather know what's going on than keep guessing. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.42,
      "end_seconds": 116.89,
      "duration_seconds": 2.47,
      "text": "Any not passing wind as well?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.66,
      "end_seconds": 119.4,
      "duration_seconds": 1.74,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.04,
      "end_seconds": 125.49,
      "duration_seconds": 4.45,
      "text": "Have you had any blood in the stool, fever or hernia?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.38,
      "end_seconds": 133.5,
      "duration_seconds": 6.12,
      "text": "I haven't had blood in the stool, fever or hernia, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.94,
      "end_seconds": 141.55,
      "duration_seconds": 2.61,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.09,
      "end_seconds": 144.37,
      "duration_seconds": 2.28,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.5,
      "end_seconds": 158.4,
      "duration_seconds": 3.9,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.23,
      "end_seconds": 165.78,
      "duration_seconds": 5.55,
      "text": "I take Tiotropium inhaler, once a day for my chest."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.39,
      "end_seconds": 177.74,
      "duration_seconds": 2.35,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.96,
      "end_seconds": 180.54,
      "duration_seconds": 1.58,
      "text": "I have COPD."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.38,
      "end_seconds": 183.13,
      "duration_seconds": 1.75,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.33,
      "end_seconds": 186.62,
      "duration_seconds": 2.29,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.69,
      "end_seconds": 189.79,
      "duration_seconds": 2.1,
      "text": "Right, how are your meals?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.54,
      "end_seconds": 194.7,
      "duration_seconds": 4.16,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.46,
      "end_seconds": 200.65,
      "duration_seconds": 4.19,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.01,
      "end_seconds": 205.62,
      "duration_seconds": 3.61,
      "text": "Yes, grass pollen. I get itchy eyes."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.15,
      "end_seconds": 207.39,
      "duration_seconds": 1.24,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.21,
      "end_seconds": 212.22,
      "duration_seconds": 3.01,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.28,
      "end_seconds": 217.21,
      "duration_seconds": 3.93,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.75,
      "end_seconds": 226.67,
      "duration_seconds": 0.92,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.34,
      "end_seconds": 230.4,
      "duration_seconds": 2.06,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.38,
      "end_seconds": 251.76,
      "duration_seconds": 5.38,
      "text": "Your tummy is swollen and tympanic, with high-pitched tinkling bowel sounds."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.12,
      "end_seconds": 274.23,
      "duration_seconds": 19.11,
      "text": "You can sit up now. Right, here's what I'm thinking. My working impression is a bowel obstruction needing urgent surgical care. Let me just check I've got this right. You've had a swollen tummy for about three months, and no hernia or fever."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.87,
      "end_seconds": 276.57,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.77,
      "end_seconds": 309.79,
      "duration_seconds": 32.02,
      "text": "I'd like to arrange an abdominal X-ray for possible obstruction. I'm sending you for urgent blood tests because of vomiting. Nothing to eat or drink, and you are going to hospital now. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. If the symptoms get worse, or you feel really unwell, please come to the emergency department. Come back straight away."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.49,
      "end_seconds": 312.83,
      "duration_seconds": 2.34,
      "text": "Okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.4,
      "end_seconds": 316.16,
      "duration_seconds": 2.76,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.18,
      "end_seconds": 321.48,
      "duration_seconds": 4.3,
      "text": "Hmm, good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.99,
      "end_seconds": 323.91,
      "duration_seconds": 1.92,
      "text": "Alright, look after yourself."
    }
  ]
}