{
  "schema_version": "1.0",
  "encounter_id": "01685",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.1,
      "end_seconds": 4.87,
      "duration_seconds": 3.77,
      "text": "Okay, good morning. I've just opened your notes."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 5.88,
      "end_seconds": 11.62,
      "duration_seconds": 5.74,
      "text": "Uh, good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.23,
      "end_seconds": 20.23,
      "duration_seconds": 8.0,
      "text": "Of course, please stay. It's helpful to have you here. So what can I do for you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 21.17,
      "end_seconds": 27.7,
      "duration_seconds": 6.53,
      "text": "It's been waking very early, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.15,
      "end_seconds": 32.34,
      "duration_seconds": 3.19,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 36.25,
      "end_seconds": 38.65,
      "duration_seconds": 2.4,
      "text": "Ever since... since Friday, really."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.21,
      "end_seconds": 42.52,
      "duration_seconds": 3.31,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 44.25,
      "end_seconds": 54.01,
      "duration_seconds": 9.76,
      "text": "Right, it feels severe to me. I did have no energy at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 56.0,
      "end_seconds": 60.76,
      "duration_seconds": 4.76,
      "text": "Let me check a few things. Any drinking more or hearing voices?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 61.37,
      "end_seconds": 65.71,
      "duration_seconds": 4.34,
      "text": "I haven't had drinking more or hearing voices, no."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.93,
      "end_seconds": 71.08,
      "duration_seconds": 4.15,
      "text": "And what about panic attacks or thoughts of harming myself?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 72.04,
      "end_seconds": 77.91,
      "duration_seconds": 5.87,
      "text": "No panic attacks or thoughts of harming myself, none of it."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.54,
      "end_seconds": 81.02,
      "duration_seconds": 2.48,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 83.83,
      "end_seconds": 85.5,
      "duration_seconds": 1.67,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.14,
      "end_seconds": 90.55,
      "duration_seconds": 3.41,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 92.13,
      "end_seconds": 94.49,
      "duration_seconds": 2.36,
      "text": "I have high blood pressure."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.45,
      "end_seconds": 103.66,
      "duration_seconds": 7.21,
      "text": "Alright, high blood pressure, that matches what I have here. A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 105.45,
      "end_seconds": 121.32,
      "duration_seconds": 15.87,
      "text": "I smoke roughly a pack every two days. I only drink at family occasions. I'm vegetarian and have been for years. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.48,
      "end_seconds": 126.38,
      "duration_seconds": 3.9,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 127.14,
      "end_seconds": 128.97,
      "duration_seconds": 1.83,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.97,
      "end_seconds": 132.46,
      "duration_seconds": 2.49,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 134.09,
      "end_seconds": 138.94,
      "duration_seconds": 4.85,
      "text": "Yes, I had my tonsils removed, as a teenager."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.21,
      "end_seconds": 144.62,
      "duration_seconds": 4.41,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 145.95,
      "end_seconds": 149.82,
      "duration_seconds": 3.87,
      "text": "Um, no, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.22,
      "end_seconds": 163.6,
      "duration_seconds": 2.38,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 165.35,
      "end_seconds": 168.47,
      "duration_seconds": 3.12,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.73,
      "end_seconds": 175.58,
      "duration_seconds": 2.85,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.03,
      "end_seconds": 189.84,
      "duration_seconds": 2.81,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.97,
      "end_seconds": 216.74,
      "duration_seconds": 8.77,
      "text": "Okay: SpO2 97 percent on room air, pulse 69, blood pressure 120 over 70. And temp 36.6 degrees."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 218.28,
      "end_seconds": 219.65,
      "duration_seconds": 1.37,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.41,
      "end_seconds": 227.09,
      "duration_seconds": 3.68,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.14,
      "end_seconds": 232.16,
      "duration_seconds": 3.02,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.8,
      "end_seconds": 236.16,
      "duration_seconds": 2.36,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.89,
      "end_seconds": 251.34,
      "duration_seconds": 5.45,
      "text": "You are tearful and speaking slowly, but you are following everything well."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 268.31,
      "end_seconds": 269.01,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.52,
      "end_seconds": 276.97,
      "duration_seconds": 2.45,
      "text": "Okay, please sit back down."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 285.61,
      "end_seconds": 290.07,
      "duration_seconds": 4.46,
      "text": "Putting it all together, it points towards a moderate depressive episode."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 291.58,
      "end_seconds": 293.02,
      "duration_seconds": 1.44,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 295.05,
      "end_seconds": 319.91,
      "duration_seconds": 24.86,
      "text": "Nothing I've seen today points to an emergency. It looks like a moderate depressive episode. I'll start you on sertraline, 50 milligrams, once a day in the morning, long term. It's for low mood. See me again in two weeks. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 320.75,
      "end_seconds": 322.34,
      "duration_seconds": 1.59,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.71,
      "end_seconds": 325.18,
      "duration_seconds": 1.47,
      "text": "Goodbye for now."
    }
  ]
}