  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.88,
      "end_seconds": 4.74,
      "duration_seconds": 3.86,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.02,
      "end_seconds": 10.02,
      "duration_seconds": 4.0,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.8,
      "end_seconds": 19.06,
      "duration_seconds": 8.26,
      "text": "Sorry, what was I saying, hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.95,
      "end_seconds": 23.75,
      "duration_seconds": 3.8,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 27.53,
      "end_seconds": 32.33,
      "duration_seconds": 4.8,
      "text": "Right, she's been having being confused and drowsy, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.75,
      "end_seconds": 36.1,
      "duration_seconds": 2.35,
      "text": "tell me your medicines, please"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 38.1,
      "end_seconds": 46.55,
      "duration_seconds": 8.45,
      "text": "Oh, she is on metformin, 500 milligrams, twice a day, I give it to her."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.22,
      "end_seconds": 49.99,
      "duration_seconds": 2.77,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.96,
      "end_seconds": 61.45,
      "duration_seconds": 9.49,
      "text": "Actually, it's been like this since last night. I didn't wanna bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.05,
      "end_seconds": 67.37,
      "duration_seconds": 3.32,
      "text": "Alright, how troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.42,
      "end_seconds": 69.54,
      "duration_seconds": 1.12,
      "text": "mostly severe"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.36,
      "end_seconds": 76.68,
      "duration_seconds": 2.32,
      "text": "has there been weakness too?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.39,
      "end_seconds": 82.54,
      "duration_seconds": 1.15,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.22,
      "end_seconds": 87.05,
      "duration_seconds": 2.83,
      "text": "any being extremely thirsty as well?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.87,
      "end_seconds": 94.12,
      "duration_seconds": 5.25,
      "text": "Um, you know, yeah. About a month, I'd say."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.02,
      "end_seconds": 98.69,
      "duration_seconds": 3.67,
      "text": "Have you had any vomiting, chest pain or fever?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.38,
      "end_seconds": 105.7,
      "duration_seconds": 5.32,
      "text": "No vomiting, chest pain or fever, none of it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.74,
      "end_seconds": 109.5,
      "duration_seconds": 2.76,
      "text": "and your skin, any changes there?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.48,
      "end_seconds": 115.32,
      "duration_seconds": 3.84,
      "text": "Um, nothing on the skin, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.59,
      "end_seconds": 119.73,
      "duration_seconds": 3.14,
      "text": "any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.69,
      "end_seconds": 123.95,
      "duration_seconds": 3.26,
      "text": "no, uh, joints are fine"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.63,
      "end_seconds": 127.78,
      "duration_seconds": 3.15,
      "text": "okay, any surgery in the the past?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.77,
      "end_seconds": 134.44,
      "duration_seconds": 4.67,
      "text": "I had a triple bypass eight years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.6,
      "end_seconds": 156.1,
      "duration_seconds": 4.5,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.82,
      "end_seconds": 163.39,
      "duration_seconds": 5.57,
      "text": "I'm, I'm allergic to tramadol, I get feeling very drowsy."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.94,
      "end_seconds": 178.14,
      "duration_seconds": 3.2,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.0,
      "end_seconds": 183.53,
      "duration_seconds": 3.53,
      "text": "yes, diabetes. I've got heart disease"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.3,
      "end_seconds": 188.26,
      "duration_seconds": 3.96,
      "text": "Yes, carry on. Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.8,
      "end_seconds": 203.43,
      "duration_seconds": 13.63,
      "text": "I'm a bus driver, so I sit for long hours. Lots of rice, lentils and some fruit. I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.43,
      "end_seconds": 221.77,
      "duration_seconds": 2.34,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.51,
      "end_seconds": 234.91,
      "duration_seconds": 2.4,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.4,
      "end_seconds": 265.34,
      "duration_seconds": 9.94,
      "text": "Okay: heart rate 125, saturation 98 percent. And temperature is 36.9 degrees, respiratory rate 17, blood pressure 112 over 84."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.0,
      "end_seconds": 271.16,
      "duration_seconds": 3.16,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.07,
      "end_seconds": 274.37,
      "duration_seconds": 1.3,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.8,
      "end_seconds": 295.01,
      "duration_seconds": 6.21,
      "text": "You are very dry and drowsy, and your sugar reading is too high to read."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.18,
      "end_seconds": 326.16,
      "duration_seconds": 25.98,
      "text": "you can relax now. Taking everything into account, the most likely explanation is a hyperosmolar diabetic emergency. It could also be diabetic ketoacidosis, so we'll keep that open. I'd like to arrange urgent blood tests for hyperglycaemic emergency. The result will help us decide whether anything more is needed. You need hospital now for fluids and insulin"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.94,
      "end_seconds": 332.89,
      "duration_seconds": 5.95,
      "text": "Could I get an ECG done? A A friend had it."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.6,
      "end_seconds": 349.75,
      "duration_seconds": 15.15,
      "text": "not at this point, no it isn't indicated yet please don't wait if the symptoms get worse that's when to be seen urgently that's everything on my side anything you're unsure about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.83,
      "end_seconds": 355.77,
      "duration_seconds": 3.94,
      "text": "good, thanks, I'll see you then"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.38,
      "end_seconds": 359.12,
      "duration_seconds": 1.74,
      "text": "Okay, take care now."
    }
  ]
}