{
  "schema_version": "1.0",
  "encounter_id": "01672",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.18,
      "end_seconds": 6.72,
      "duration_seconds": 5.54,
      "text": "Mm, hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.77,
      "end_seconds": 12.85,
      "duration_seconds": 4.08,
      "text": "Alright, come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.06,
      "end_seconds": 17.71,
      "duration_seconds": 3.65,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.76,
      "end_seconds": 21.61,
      "duration_seconds": 2.85,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.86,
      "end_seconds": 24.59,
      "duration_seconds": 1.73,
      "text": "It's tiredness, mostly."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.7,
      "end_seconds": 29.56,
      "duration_seconds": 3.86,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.85,
      "end_seconds": 44.86,
      "duration_seconds": 14.01,
      "text": "Honestly I can't say exactly when it started. It might have been last month or the month before, I really can't pin it down."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.94,
      "end_seconds": 47.93,
      "duration_seconds": 1.99,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.75,
      "end_seconds": 77.33,
      "duration_seconds": 24.58,
      "text": "Ah, it usually comes with sore wrists. The sore wrists? That's been for about a month. Oh, and morning stiffness for an hour. That's been about the same, about two weeks. Actually, as for morning stiffness for an hour, I'd say severe."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.67,
      "end_seconds": 84.29,
      "duration_seconds": 6.62,
      "text": "Okay, go on. Have you had tiredness before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.77,
      "end_seconds": 91.71,
      "duration_seconds": 5.94,
      "text": "I had a similar thing about six months ago. It went away."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.23,
      "end_seconds": 100.95,
      "duration_seconds": 4.72,
      "text": "Any chest pain, rash, eye redness or fever at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.8,
      "end_seconds": 109.7,
      "duration_seconds": 6.9,
      "text": "No chest pain, rash, eye redness or fever, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.74,
      "end_seconds": 115.13,
      "duration_seconds": 4.39,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.41,
      "end_seconds": 122.99,
      "duration_seconds": 3.58,
      "text": "No, you know, all normal there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.87,
      "end_seconds": 127.39,
      "duration_seconds": 3.52,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.42,
      "end_seconds": 130.43,
      "duration_seconds": 1.01,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.2,
      "end_seconds": 135.08,
      "duration_seconds": 2.88,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.68,
      "end_seconds": 151.04,
      "duration_seconds": 14.36,
      "text": "I'll have a glass of wine with dinner. No, I've never smoked in my life. Lots of rice, lentils and some fruit. I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.86,
      "end_seconds": 154.09,
      "duration_seconds": 1.23,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.07,
      "end_seconds": 157.53,
      "duration_seconds": 2.46,
      "text": "No, you know, never."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.74,
      "end_seconds": 176.64,
      "duration_seconds": 2.9,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.01,
      "end_seconds": 183.12,
      "duration_seconds": 5.11,
      "text": "Omeprazole. I take it 20 milligrams, once a day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 184.46,
      "end_seconds": 193.26,
      "duration_seconds": 8.8,
      "text": "It's meant to be once a day, though I don't see he take it every time."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.35,
      "end_seconds": 200.09,
      "duration_seconds": 4.74,
      "text": "Ibuprofen. I take it 400 milligrams, when needed."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.41,
      "end_seconds": 204.96,
      "duration_seconds": 4.55,
      "text": "Okay, go on. Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.82,
      "end_seconds": 218.5,
      "duration_seconds": 11.68,
      "text": "I've had acid reflux for nearly five years now. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.26,
      "end_seconds": 223.37,
      "duration_seconds": 4.11,
      "text": "Ah. Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.83,
      "end_seconds": 229.72,
      "duration_seconds": 4.89,
      "text": "Okay, uh, so yes, I'm allergic to wheat."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.52,
      "end_seconds": 242.49,
      "duration_seconds": 2.97,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.04,
      "end_seconds": 257.41,
      "duration_seconds": 2.37,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.37,
      "end_seconds": 283.51,
      "duration_seconds": 8.14,
      "text": "Okay: heart rate 78, blood pressure 126 over 81, temp 37.0 degrees, SpO2 99 percent on room air."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.3,
      "end_seconds": 285.8,
      "duration_seconds": 1.5,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.24,
      "end_seconds": 291.25,
      "duration_seconds": 4.01,
      "text": "Right, I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.13,
      "end_seconds": 296.66,
      "duration_seconds": 2.53,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.46,
      "end_seconds": 299.93,
      "duration_seconds": 1.47,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.7,
      "end_seconds": 321.58,
      "duration_seconds": 5.88,
      "text": "The knuckles and wrists are swollen and warm, and the squeeze test is painful."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.29,
      "end_seconds": 330.87,
      "duration_seconds": 6.58,
      "text": "All finished, thank you. Taking everything into account, this looks most like an inflammatory arthritis flare."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.5,
      "end_seconds": 365.41,
      "duration_seconds": 22.91,
      "text": "I want X-rays of the hands done, that's for inflammatory arthritis. You'll be taking methotrexate, 10 milligrams, once a week, long term. It's for inflammatory arthritis. Gentle hand exercises and warm water in the morning. I'll want another look in four weeks. Alright, does all of that make sense?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 365.99,
      "end_seconds": 369.74,
      "duration_seconds": 3.75,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}