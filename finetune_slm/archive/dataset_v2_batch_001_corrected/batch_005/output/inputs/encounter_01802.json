{
  "schema_version": "1.0",
  "encounter_id": "01802",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.94,
      "end_seconds": 6.03,
      "duration_seconds": 5.09,
      "text": "Afternoon, doctor. They're in and comfortable, and I have the measurements ready."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.45,
      "end_seconds": 11.28,
      "duration_seconds": 3.83,
      "text": "Perfect, thanks. Hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 12.07,
      "end_seconds": 21.93,
      "duration_seconds": 9.86,
      "text": "Honestly, it's trouble falling asleep, and my family pushed me to come. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.21,
      "end_seconds": 26.96,
      "duration_seconds": 3.75,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 28.42,
      "end_seconds": 44.12,
      "duration_seconds": 15.7,
      "text": "I take gliclazide, 80 milligrams, twice a day for my sugar. I do miss it now and then, to be fair. Naproxen. I take it 250 milligrams, twice a day for the knee pain."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.96,
      "end_seconds": 46.57,
      "duration_seconds": 1.61,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 48.38,
      "end_seconds": 54.53,
      "duration_seconds": 6.15,
      "text": "Ten days, I think... sorry, five days, I got that wrong."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.77,
      "end_seconds": 61.25,
      "duration_seconds": 5.48,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 62.08,
      "end_seconds": 67.3,
      "duration_seconds": 5.22,
      "text": "Mostly mild. Only a warm bath, and it's not much."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.08,
      "end_seconds": 71.7,
      "duration_seconds": 3.62,
      "text": "Have you had a busy mind at night?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 72.92,
      "end_seconds": 80.15,
      "duration_seconds": 7.23,
      "text": "Yeah, yeah. Two days, I'd say. I'd been waking tired, but that went away."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.72,
      "end_seconds": 85.06,
      "duration_seconds": 4.34,
      "text": "Okay, did you get weight change or low mood?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 86.97,
      "end_seconds": 91.42,
      "duration_seconds": 4.45,
      "text": "No weight change or low mood, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.5,
      "end_seconds": 94.58,
      "duration_seconds": 2.08,
      "text": "Any chest pain or snoring?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 95.99,
      "end_seconds": 99.21,
      "duration_seconds": 3.22,
      "text": "No, no chest pain or snoring."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.43,
      "end_seconds": 102.51,
      "duration_seconds": 2.08,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 106.95,
      "end_seconds": 108.75,
      "duration_seconds": 1.8,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.22,
      "end_seconds": 113.76,
      "duration_seconds": 3.54,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 114.35,
      "end_seconds": 123.15,
      "duration_seconds": 8.8,
      "text": "I've had diabetes, yes. Ah, I have arthritis in my knees. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.86,
      "end_seconds": 129.18,
      "duration_seconds": 4.32,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 130.9,
      "end_seconds": 144.81,
      "duration_seconds": 13.91,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.65,
      "end_seconds": 146.49,
      "duration_seconds": 0.84,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 147.1,
      "end_seconds": 150.83,
      "duration_seconds": 3.73,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.71,
      "end_seconds": 156.59,
      "duration_seconds": 3.88,
      "text": "So, what do you do during the day?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 158.31,
      "end_seconds": 162.1,
      "duration_seconds": 3.79,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.91,
      "end_seconds": 165.09,
      "duration_seconds": 1.18,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 166.08,
      "end_seconds": 168.87,
      "duration_seconds": 2.79,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.74,
      "end_seconds": 172.52,
      "duration_seconds": 2.78,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 174.39,
      "end_seconds": 179.67,
      "duration_seconds": 5.28,
      "text": "Ah, my grandfather had a stroke. My grandmother had dementia."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.66,
      "end_seconds": 182.84,
      "duration_seconds": 1.18,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 184.27,
      "end_seconds": 185.43,
      "duration_seconds": 1.16,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 197.85,
      "end_seconds": 210.05,
      "duration_seconds": 12.2,
      "text": "Here are the numbers, doctor. Temperature is 36.5 degrees, height 178 centimetres, pressure 118 over 73, weight 85 kilos, respiratory rate 15, heart rate 84."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.83,
      "end_seconds": 211.73,
      "duration_seconds": 0.9,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.86,
      "end_seconds": 218.3,
      "duration_seconds": 4.44,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 219.29,
      "end_seconds": 220.97,
      "duration_seconds": 1.68,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.68,
      "end_seconds": 225.06,
      "duration_seconds": 2.38,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.04,
      "end_seconds": 243.42,
      "duration_seconds": 3.38,
      "text": "Your blood pressure and pulse are normal."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.78,
      "end_seconds": 258.76,
      "duration_seconds": 9.98,
      "text": "Okay, that's enough for me. Having listened and examined, this looks most like poor sleep habits. Mild anxiety is also on my list."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 264.12,
      "end_seconds": 267.07,
      "duration_seconds": 2.95,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.62,
      "end_seconds": 275.48,
      "duration_seconds": 7.86,
      "text": "I understand the worry. At the moment I'd say it's poor sleep habits, and we'll watch how it goes."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.32,
      "end_seconds": 300.0,
      "duration_seconds": 11.68,
      "text": "Keep a fixed bedtime, no screens for an hour before bed, and no coffee after lunch. Do get help quickly if the symptoms get worse."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 301.26,
      "end_seconds": 304.07,
      "duration_seconds": 2.81,
      "text": "I know what to watch for."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.05,
      "end_seconds": 309.64,
      "duration_seconds": 3.59,
      "text": "Please come and see me in four weeks."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 314.22,
      "end_seconds": 319.11,
      "duration_seconds": 4.89,
      "text": "I'll book your follow-up at the front desk on your way out."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 320.82,
      "end_seconds": 324.25,
      "duration_seconds": 3.43,
      "text": "Good, you know, I'll return then."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.16,
      "end_seconds": 330.34,
      "duration_seconds": 5.18,
      "text": "Right, is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 332.19,
      "end_seconds": 337.4,
      "duration_seconds": 5.21,
      "text": "Right, uh, I'll do that. Thank you, doctor."
    }
  ]
}