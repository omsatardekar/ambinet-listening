{
  "schema_version": "1.0",
  "encounter_id": "01682",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.9,
      "end_seconds": 3.2,
      "duration_seconds": 2.3,
      "text": "Right, welcome. Make yourself comfortable."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.04,
      "end_seconds": 6.17,
      "duration_seconds": 1.13,
      "text": "Evening, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 6.88,
      "end_seconds": 10.18,
      "duration_seconds": 3.3,
      "text": "So, what do you need help with?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.7,
      "end_seconds": 19.41,
      "duration_seconds": 6.71,
      "text": "Doctor, it's a very fast heartbeat. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.79,
      "end_seconds": 24.09,
      "duration_seconds": 3.3,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.97,
      "end_seconds": 27.1,
      "duration_seconds": 2.13,
      "text": "Probably six months. Yeah."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.41,
      "end_seconds": 31.32,
      "duration_seconds": 2.91,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.53,
      "end_seconds": 38.02,
      "duration_seconds": 5.49,
      "text": "So, maybe a seven out of ten on a bad day."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.92,
      "end_seconds": 42.35,
      "duration_seconds": 2.43,
      "text": "Have you been feeling faint?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.64,
      "end_seconds": 46.94,
      "duration_seconds": 3.3,
      "text": "Yeah, I've had that since Monday."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 48.55,
      "end_seconds": 50.23,
      "duration_seconds": 1.68,
      "text": "Have you been sweating?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 51.09,
      "end_seconds": 54.46,
      "duration_seconds": 3.37,
      "text": "Yes, about the same, about four days."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.05,
      "end_seconds": 57.9,
      "duration_seconds": 2.85,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 58.48,
      "end_seconds": 67.26,
      "duration_seconds": 8.78,
      "text": "Hmm, it feels mild to me. Chest pressure was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.81,
      "end_seconds": 82.49,
      "duration_seconds": 3.68,
      "text": "Have you had any fever, cough or leg swelling?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.1,
      "end_seconds": 86.24,
      "duration_seconds": 2.14,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.58,
      "end_seconds": 90.76,
      "duration_seconds": 3.18,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 93.72,
      "end_seconds": 95.69,
      "duration_seconds": 1.97,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.11,
      "end_seconds": 101.2,
      "duration_seconds": 4.09,
      "text": "Right, are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.15,
      "end_seconds": 106.33,
      "duration_seconds": 3.18,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.22,
      "end_seconds": 125.26,
      "duration_seconds": 3.04,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 127.02,
      "end_seconds": 131.07,
      "duration_seconds": 4.05,
      "text": "My cousin has psoriasis. My son has asthma."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.29,
      "end_seconds": 134.61,
      "duration_seconds": 2.32,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.54,
      "end_seconds": 146.61,
      "duration_seconds": 11.07,
      "text": "Aspirin. I take it 75 milligrams, once a day for my heart. I take sumatriptan, 50 milligrams, when needed."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.43,
      "end_seconds": 149.86,
      "duration_seconds": 2.43,
      "text": "How long have you taken that?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 153.37,
      "end_seconds": 167.6,
      "duration_seconds": 14.23,
      "text": "For about a year. I'm on atorvastatin, 20 milligrams, at night. I'm on alendronate, 70 milligrams, once a week. I'm supposed to take it regularly, but I don't always manage."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.77,
      "end_seconds": 173.49,
      "duration_seconds": 4.72,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.16,
      "end_seconds": 188.89,
      "duration_seconds": 13.73,
      "text": "I used to drink heavily but I stopped four years ago. Not much, I mostly stay in these days. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.96,
      "end_seconds": 199.96,
      "duration_seconds": 2.0,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 201.18,
      "end_seconds": 205.79,
      "duration_seconds": 4.61,
      "text": "I have heart disease, for about ten years."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.98,
      "end_seconds": 207.68,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 208.83,
      "end_seconds": 209.99,
      "duration_seconds": 1.16,
      "text": "Yes, migraines."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.66,
      "end_seconds": 212.2,
      "duration_seconds": 1.54,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 214.14,
      "end_seconds": 217.02,
      "duration_seconds": 2.88,
      "text": "I've had high cholesterol, yes."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.61,
      "end_seconds": 219.44,
      "duration_seconds": 0.83,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 225.54,
      "end_seconds": 230.23,
      "duration_seconds": 4.69,
      "text": "I've had thin bones for about ten years now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.8,
      "end_seconds": 240.16,
      "duration_seconds": 9.36,
      "text": "Yes, carry on. Alright, heart disease and migraines, that matches what I have here. Okay, have you been to theatre before?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 241.86,
      "end_seconds": 247.03,
      "duration_seconds": 5.17,
      "text": "Just a wisdom tooth extraction under sedation, five years ago."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.81,
      "end_seconds": 250.14,
      "duration_seconds": 2.33,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.31,
      "end_seconds": 260.98,
      "duration_seconds": 3.67,
      "text": "Okay, that's it, just a little longer..."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.99,
      "end_seconds": 288.28,
      "duration_seconds": 9.29,
      "text": "Okay: BP is 102 over 57, temp 36.7 degrees, pulse is 93 beats a minute, oxygen saturation is 98 percent."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 290.11,
      "end_seconds": 291.77,
      "duration_seconds": 1.66,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.11,
      "end_seconds": 296.4,
      "duration_seconds": 3.29,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.25,
      "end_seconds": 300.94,
      "duration_seconds": 2.69,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.77,
      "end_seconds": 304.14,
      "duration_seconds": 1.37,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 317.6,
      "end_seconds": 323.5,
      "duration_seconds": 5.9,
      "text": "Your pulse is over one hundred and eighty and your blood pressure is low."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 327.69,
      "end_seconds": 348.48,
      "duration_seconds": 20.79,
      "text": "All finished, thank you. Taking everything into account, it fits best with a dangerous fast heart rhythm. I want to be honest that this is an impression, not a final answer. I can't rule out supraventricular tachycardia yet. We should do an urgent ECG for fast heart rhythm."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 353.0,
      "end_seconds": 356.34,
      "duration_seconds": 3.34,
      "text": "I can book that for Monday at 10 am."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 356.97,
      "end_seconds": 358.06,
      "duration_seconds": 1.09,
      "text": "That's fine."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 359.87,
      "end_seconds": 386.0,
      "duration_seconds": 26.13,
      "text": "I'm sending you for blood tests because of arrhythmia. Lie flat, I am calling the emergency team and preparing to shock the heart. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. Let's review you straight away. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 391.1,
      "end_seconds": 393.04,
      "duration_seconds": 1.94,
      "text": "Thank you, that's helpful."
    }
  ]
}