{
  "schema_version": "1.0",
  "encounter_id": "01629",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.39,
      "end_seconds": 7.55,
      "duration_seconds": 6.16,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 12.34,
      "end_seconds": 16.35,
      "duration_seconds": 4.01,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.92,
      "end_seconds": 24.07,
      "duration_seconds": 6.15,
      "text": "It's a barking cough. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.81,
      "end_seconds": 27.91,
      "duration_seconds": 3.1,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.24,
      "end_seconds": 37.46,
      "duration_seconds": 8.22,
      "text": "Since last night, that's when it began. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.45,
      "end_seconds": 43.71,
      "duration_seconds": 5.26,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.73,
      "end_seconds": 54.47,
      "duration_seconds": 8.74,
      "text": "Honestly, a few times a day. Mild, I'd say. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.6,
      "end_seconds": 59.02,
      "duration_seconds": 3.42,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.04,
      "end_seconds": 69.16,
      "duration_seconds": 2.12,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.03,
      "end_seconds": 96.07,
      "duration_seconds": 9.04,
      "text": "Okay: BP is 112 over 80, respiratory rate 17, oxygen saturation is 97 percent, heart rate 86, temperature is 36.6 degrees."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.61,
      "end_seconds": 101.89,
      "duration_seconds": 4.28,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.74,
      "end_seconds": 105.63,
      "duration_seconds": 2.89,
      "text": "So, I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.88,
      "end_seconds": 126.81,
      "duration_seconds": 6.93,
      "text": "He is playful, breathing comfortably at rest, and I can't hear any noisy breathing now."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.71,
      "end_seconds": 142.52,
      "duration_seconds": 1.81,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.35,
      "end_seconds": 150.03,
      "duration_seconds": 1.68,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.43,
      "end_seconds": 165.85,
      "duration_seconds": 2.42,
      "text": "Nothing like noisy breathing when resting?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.95,
      "end_seconds": 171.31,
      "duration_seconds": 3.36,
      "text": "Nope, no noisy breathing when resting."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.13,
      "end_seconds": 177.24,
      "duration_seconds": 5.11,
      "text": "Right, any drooling, blue lips or difficulty swallowing at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.64,
      "end_seconds": 183.61,
      "duration_seconds": 4.97,
      "text": "No, you know, no drooling, blue lips or difficulty swallowing."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.65,
      "end_seconds": 188.91,
      "duration_seconds": 3.26,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.65,
      "end_seconds": 191.86,
      "duration_seconds": 2.21,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.49,
      "end_seconds": 197.0,
      "duration_seconds": 4.51,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.53,
      "end_seconds": 201.95,
      "duration_seconds": 3.42,
      "text": "Hmm, no, that side's been fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.46,
      "end_seconds": 207.53,
      "duration_seconds": 4.07,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.13,
      "end_seconds": 210.83,
      "duration_seconds": 1.7,
      "text": "I've got depression."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.94,
      "end_seconds": 225.85,
      "duration_seconds": 3.91,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.38,
      "end_seconds": 230.72,
      "duration_seconds": 3.34,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.35,
      "end_seconds": 253.19,
      "duration_seconds": 3.84,
      "text": "Right, do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.44,
      "end_seconds": 257.89,
      "duration_seconds": 3.45,
      "text": "Sertraline, 50 milligrams, once a day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.25,
      "end_seconds": 266.3,
      "duration_seconds": 3.05,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.57,
      "end_seconds": 276.35,
      "duration_seconds": 5.78,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.9,
      "end_seconds": 280.74,
      "duration_seconds": 2.84,
      "text": "So, tell me about your eating."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.64,
      "end_seconds": 286.93,
      "duration_seconds": 5.29,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.7,
      "end_seconds": 301.61,
      "duration_seconds": 12.91,
      "text": "Taking everything into account, my working impression is mild croup. I don't need to add any tests or treatment at this point. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.77,
      "end_seconds": 305.89,
      "duration_seconds": 3.12,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.55,
      "end_seconds": 309.01,
      "duration_seconds": 1.46,
      "text": "Goodbye for now."
    }
  ]
}