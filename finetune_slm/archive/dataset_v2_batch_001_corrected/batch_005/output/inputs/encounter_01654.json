  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.88,
      "end_seconds": 5.5,
      "duration_seconds": 4.62,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.03,
      "end_seconds": 10.13,
      "duration_seconds": 4.1,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.37,
      "end_seconds": 16.27,
      "duration_seconds": 4.9,
      "text": "I wanted to get a dull low backache looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.85,
      "end_seconds": 21.08,
      "duration_seconds": 3.23,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.86,
      "end_seconds": 27.6,
      "duration_seconds": 4.74,
      "text": "Actually, it's been going on for six months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.72,
      "end_seconds": 31.12,
      "duration_seconds": 2.4,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.95,
      "end_seconds": 41.54,
      "duration_seconds": 9.59,
      "text": "honestly, a couple of times a week i've also been passing urine very often, for one week"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.1,
      "end_seconds": 46.38,
      "duration_seconds": 3.28,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.93,
      "end_seconds": 55.4,
      "duration_seconds": 7.47,
      "text": "I'd say mild. And there's burning on passing urine as well, ten days now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.73,
      "end_seconds": 59.31,
      "duration_seconds": 2.58,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.9,
      "end_seconds": 62.22,
      "duration_seconds": 1.32,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.52,
      "end_seconds": 65.34,
      "duration_seconds": 1.82,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.1,
      "end_seconds": 69.5,
      "duration_seconds": 3.4,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.89,
      "end_seconds": 72.12,
      "duration_seconds": 1.23,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.89,
      "end_seconds": 77.27,
      "duration_seconds": 4.38,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.02,
      "end_seconds": 81.29,
      "duration_seconds": 2.27,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.18,
      "end_seconds": 87.81,
      "duration_seconds": 4.63,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.3,
      "end_seconds": 93.75,
      "duration_seconds": 4.45,
      "text": "What does a a normal day of food look like?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.26,
      "end_seconds": 99.53,
      "duration_seconds": 4.27,
      "text": "Lots of rice, lentils and some fruit"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.98,
      "end_seconds": 104.4,
      "duration_seconds": 3.42,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.68,
      "end_seconds": 109.12,
      "duration_seconds": 3.44,
      "text": "Um, no, nothing at all."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.81,
      "end_seconds": 114.35,
      "duration_seconds": 3.54,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.15,
      "end_seconds": 118.48,
      "duration_seconds": 2.33,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.45,
      "end_seconds": 123.26,
      "duration_seconds": 2.81,
      "text": "before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.04,
      "end_seconds": 129.95,
      "duration_seconds": 4.91,
      "text": "Yes, plasters. I get a red itchy rash."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.55,
      "end_seconds": 147.14,
      "duration_seconds": 1.59,
      "text": "What about leaking fluid?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.95,
      "end_seconds": 150.02,
      "duration_seconds": 2.07,
      "text": "no leaking fluid, thankfully"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.13,
      "end_seconds": 162.41,
      "duration_seconds": 7.28,
      "text": "Let me check a few things. Any vaginal bleeding, severe back pain or reduced baby movements?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.52,
      "end_seconds": 171.04,
      "duration_seconds": 7.52,
      "text": "I haven't had vaginal bleeding, severe back pain or reduced baby movements, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.99,
      "end_seconds": 175.99,
      "duration_seconds": 4.0,
      "text": "how about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.12,
      "end_seconds": 183.63,
      "duration_seconds": 6.51,
      "text": "Well, um, my heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.26,
      "end_seconds": 187.87,
      "duration_seconds": 2.61,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.34,
      "end_seconds": 192.3,
      "duration_seconds": 2.96,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.32,
      "end_seconds": 202.9,
      "duration_seconds": 2.58,
      "text": "Right, I'll do your observations first."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.58,
      "end_seconds": 218.23,
      "duration_seconds": 2.65,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.52,
      "end_seconds": 244.56,
      "duration_seconds": 8.04,
      "text": "Okay: BP is 115 over 76, temperature is 38.2 degrees. And pulse 91, SpO2 98 percent on room air."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.52,
      "end_seconds": 250.27,
      "duration_seconds": 3.75,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.89,
      "end_seconds": 253.68,
      "duration_seconds": 1.79,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.31,
      "end_seconds": 268.99,
      "duration_seconds": 5.68,
      "text": "there is mild tenderness above the pubic bone and no tenderness in the loins"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.81,
      "end_seconds": 274.75,
      "duration_seconds": 1.94,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.08,
      "end_seconds": 294.7,
      "duration_seconds": 5.62,
      "text": "Okay, thinking it through, it fits best with a urinary infection in pregnancy."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.19,
      "end_seconds": 300.34,
      "duration_seconds": 4.15,
      "text": "I mean, um, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.68,
      "end_seconds": 335.22,
      "duration_seconds": 33.54,
      "text": "I understand the worry at the moment I'd say it's a urinary infection in pregnancy, and we'll know more once the the a urine culture is back i'd like to arrange a urine culture for urinary infection let's get a urine dipstick, for burning urine i'm going to put you on cefalexin, 500 milligrams, twice a day, seven days you take it by mouth that's for urinary infection in pregnancy drink plenty of fluids and tell your midwife"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.35,
      "end_seconds": 349.83,
      "duration_seconds": 13.48,
      "text": "I'd like you to see the midwife as well, and I'll write the referral. We'll catch up in one week. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.64,
      "end_seconds": 354.79,
      "duration_seconds": 3.15,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.07,
      "end_seconds": 357.27,
      "duration_seconds": 1.2,
      "text": "all the best"
    }
  ]
