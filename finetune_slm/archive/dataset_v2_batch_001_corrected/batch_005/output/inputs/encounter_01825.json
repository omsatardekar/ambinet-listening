{
  "schema_version": "1.0",
  "encounter_id": "01825",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.95,
      "end_seconds": 4.19,
      "duration_seconds": 3.24,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.9,
      "end_seconds": 9.16,
      "duration_seconds": 4.26,
      "text": "no problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.17,
      "end_seconds": 14.63,
      "duration_seconds": 4.46,
      "text": "So the thing is, I've got sudden severe breathlessness."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.22,
      "end_seconds": 19.05,
      "duration_seconds": 3.83,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.74,
      "end_seconds": 32.99,
      "duration_seconds": 13.25,
      "text": "I've had it for about a week. I kept putting it off, which I know isn't sensible. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.54,
      "end_seconds": 35.87,
      "duration_seconds": 2.33,
      "text": "how often do you get it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.61,
      "end_seconds": 38.56,
      "duration_seconds": 1.95,
      "text": "Honestly, every other day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.4,
      "end_seconds": 59.09,
      "duration_seconds": 3.69,
      "text": "Any leg swelling, fever or cough at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.89,
      "end_seconds": 65.51,
      "duration_seconds": 4.62,
      "text": "No leg swelling, fever or cough, none of it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.62,
      "end_seconds": 68.62,
      "duration_seconds": 2.0,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.01,
      "end_seconds": 73.19,
      "duration_seconds": 3.18,
      "text": "that's normal as far as I know"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.66,
      "end_seconds": 86.03,
      "duration_seconds": 3.37,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.48,
      "end_seconds": 97.93,
      "duration_seconds": 10.45,
      "text": "Yes, I had a bunion operation, six years ago. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.57,
      "end_seconds": 105.05,
      "duration_seconds": 3.48,
      "text": "Okay, a few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.94,
      "end_seconds": 117.11,
      "duration_seconds": 10.17,
      "text": "I look after my grandchildren most days. My partner and our baby. I walk the dog every morning."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.55,
      "end_seconds": 121.38,
      "duration_seconds": 2.83,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.2,
      "end_seconds": 125.71,
      "duration_seconds": 2.51,
      "text": "no, nothing at the moment"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.02,
      "end_seconds": 144.11,
      "duration_seconds": 4.09,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.73,
      "end_seconds": 146.31,
      "duration_seconds": 1.58,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.45,
      "end_seconds": 150.04,
      "duration_seconds": 2.59,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.92,
      "end_seconds": 158.7,
      "duration_seconds": 3.78,
      "text": "Milk. I come out in... well, a rash."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.16,
      "end_seconds": 167.41,
      "duration_seconds": 3.25,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.1,
      "end_seconds": 178.31,
      "duration_seconds": 2.21,
      "text": "sit still for a moment.."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.42,
      "end_seconds": 195.71,
      "duration_seconds": 8.29,
      "text": "okay: respiratory rate 20, BP is 141 over 85, pulse 86, oxygen saturation is 89 percent, temperature 37.1."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.18,
      "end_seconds": 199.87,
      "duration_seconds": 2.69,
      "text": "is that that alright, doctor?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.72,
      "end_seconds": 204.67,
      "duration_seconds": 3.95,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.83,
      "end_seconds": 211.28,
      "duration_seconds": 4.45,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.85,
      "end_seconds": 216.9,
      "duration_seconds": 1.05,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.18,
      "end_seconds": 219.4,
      "duration_seconds": 1.22,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.7,
      "end_seconds": 242.74,
      "duration_seconds": 8.04,
      "text": "Your windpipe is pushed to the right, there is no breath sound on the left, and your pressure is dropping."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.77,
      "end_seconds": 249.79,
      "duration_seconds": 1.02,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.39,
      "end_seconds": 253.96,
      "duration_seconds": 1.57,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.96,
      "end_seconds": 303.63,
      "duration_seconds": 32.67,
      "text": "from what you've told me and what I found, I think we're dealing with a collapsed lung under pressure at this stage. I want a chest X-ray done, that's for chest pain. We should do an urgent chest decompression for tension pneumothorax. Stay sitting up, I need to relieve the pressure in your chest right now. The emergency team would be the right next step, I'll refer you"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.32,
      "end_seconds": 318.48,
      "duration_seconds": 14.16,
      "text": "If the symptoms get worse, or you feel really unwell, please come to the emergency department. I'd like you back straight away. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.44,
      "end_seconds": 321.62,
      "duration_seconds": 2.18,
      "text": "thank you, that's helpful"
    }
  ]
}