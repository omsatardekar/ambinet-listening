{
  "schema_version": "1.0",
  "encounter_id": "01587",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.28,
      "end_seconds": 6.94,
      "duration_seconds": 5.66,
      "text": "Hi there, the chair's free, sit down. You came on your own today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.24,
      "end_seconds": 11.29,
      "duration_seconds": 3.05,
      "text": "Yes, I managed on my own."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.88,
      "end_seconds": 15.57,
      "duration_seconds": 2.69,
      "text": "How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 16.57,
      "end_seconds": 19.29,
      "duration_seconds": 2.72,
      "text": "It's a swollen tummy, mostly."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.32,
      "end_seconds": 23.76,
      "duration_seconds": 3.44,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.7,
      "end_seconds": 28.73,
      "duration_seconds": 3.03,
      "text": "Since Friday, that's when it began."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.35,
      "end_seconds": 34.7,
      "duration_seconds": 2.35,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.31,
      "end_seconds": 37.77,
      "duration_seconds": 1.46,
      "text": "It's mild, honestly."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 49.61,
      "end_seconds": 54.05,
      "duration_seconds": 4.44,
      "text": "A few quick ones: blood in the stool, fever or hernia?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 55.32,
      "end_seconds": 61.5,
      "duration_seconds": 6.18,
      "text": "I haven't had blood in the stool, fever or hernia, no."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.56,
      "end_seconds": 69.93,
      "duration_seconds": 3.37,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 71.87,
      "end_seconds": 74.07,
      "duration_seconds": 2.2,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.42,
      "end_seconds": 79.02,
      "duration_seconds": 3.6,
      "text": "Alright, is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 81.38,
      "end_seconds": 84.35,
      "duration_seconds": 2.97,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.12,
      "end_seconds": 89.06,
      "duration_seconds": 3.94,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 90.22,
      "end_seconds": 92.6,
      "duration_seconds": 2.38,
      "text": "Not really, um, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.1,
      "end_seconds": 107.65,
      "duration_seconds": 3.55,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.75,
      "end_seconds": 111.48,
      "duration_seconds": 2.73,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.21,
      "end_seconds": 124.11,
      "duration_seconds": 2.9,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.82,
      "end_seconds": 128.94,
      "duration_seconds": 3.12,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.65,
      "end_seconds": 132.18,
      "duration_seconds": 2.53,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.69,
      "end_seconds": 146.66,
      "duration_seconds": 13.97,
      "text": "I gave up cigarettes last spring. Nothing, I'm teetotal. I retired from the post office two years ago. Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.57,
      "end_seconds": 152.03,
      "duration_seconds": 3.46,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.81,
      "end_seconds": 168.18,
      "duration_seconds": 2.37,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.24,
      "end_seconds": 196.72,
      "duration_seconds": 8.48,
      "text": "Okay: temp 37.0 degrees, oxygen saturation is 96 percent, pressure 114 over 86. And pulse 116."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 198.1,
      "end_seconds": 200.99,
      "duration_seconds": 2.89,
      "text": "Is that alright, um, doctor?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.76,
      "end_seconds": 206.67,
      "duration_seconds": 3.91,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.97,
      "end_seconds": 211.93,
      "duration_seconds": 3.96,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.92,
      "end_seconds": 215.38,
      "duration_seconds": 2.46,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.54,
      "end_seconds": 228.21,
      "duration_seconds": 4.67,
      "text": "Your tummy is swollen and tympanic, with high-pitched tinkling bowel sounds."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.95,
      "end_seconds": 246.98,
      "duration_seconds": 15.03,
      "text": "All finished, thank you. Okay, thinking it through, it points towards a bowel obstruction needing urgent surgical care. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 248.57,
      "end_seconds": 251.43,
      "duration_seconds": 2.86,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.12,
      "end_seconds": 262.63,
      "duration_seconds": 9.51,
      "text": "It's reasonable to be concerned, but right now a bowel obstruction needing urgent surgical care is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.33,
      "end_seconds": 297.22,
      "duration_seconds": 25.89,
      "text": "I think urgent blood tests makes sense here, for vomiting. Nothing to eat or drink, and you are going to hospital now. I'll also refer you to the surgical team. I'm not ordering an abdominal X-ray today. If things carry on in two weeks, we'll consider it. Book a review straight away."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 298.92,
      "end_seconds": 300.86,
      "duration_seconds": 1.94,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.54,
      "end_seconds": 305.43,
      "duration_seconds": 2.89,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 307.26,
      "end_seconds": 311.31,
      "duration_seconds": 4.05,
      "text": "Yeah, no, that's all. Thanks a lot."
    }
  ]
}