{
  "schema_version": "1.0",
  "encounter_id": "01634",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.84,
      "end_seconds": 3.23,
      "duration_seconds": 2.39,
      "text": "Hi, sit anywhere you like."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.87,
      "end_seconds": 10.69,
      "duration_seconds": 2.82,
      "text": "Hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.05,
      "end_seconds": 18.25,
      "duration_seconds": 6.2,
      "text": "Good afternoon, um, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.93,
      "end_seconds": 25.93,
      "duration_seconds": 6.0,
      "text": "Absolutely, come and sit beside them. Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 27.85,
      "end_seconds": 32.29,
      "duration_seconds": 4.44,
      "text": "Doctor, it's daytime sleepiness. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.78,
      "end_seconds": 35.56,
      "duration_seconds": 1.78,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.44,
      "end_seconds": 42.77,
      "duration_seconds": 6.33,
      "text": "About four days, I think... sorry, three days, I got that wrong."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.63,
      "end_seconds": 47.96,
      "duration_seconds": 3.33,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 48.85,
      "end_seconds": 50.45,
      "duration_seconds": 1.6,
      "text": "I'd say moderate."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.89,
      "end_seconds": 54.37,
      "duration_seconds": 3.48,
      "text": "Right, right. Does anything else come with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 55.45,
      "end_seconds": 64.65,
      "duration_seconds": 9.2,
      "text": "Sorry, what was I saying, when it starts I tend to get stopping breathing at night as well."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.5,
      "end_seconds": 73.32,
      "duration_seconds": 7.82,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 73.42,
      "end_seconds": 80.05,
      "duration_seconds": 6.63,
      "text": "Um, tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 81.93,
      "end_seconds": 94.34,
      "duration_seconds": 12.41,
      "text": "I was getting to that! Oh, the stopping breathing at night? That's been for about three months. Let me think, there's morning headaches as well."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.08,
      "end_seconds": 103.8,
      "duration_seconds": 8.72,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 104.92,
      "end_seconds": 121.72,
      "duration_seconds": 16.8,
      "text": "Mostly moderate. It's on and off. Work has been very busy so I kept ignoring it. Sorry, I know I'm rambling a bit. Loud snoring was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.48,
      "end_seconds": 127.57,
      "duration_seconds": 4.09,
      "text": "Any chest pain, choking or leg swelling at all?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 133.18,
      "end_seconds": 136.57,
      "duration_seconds": 3.39,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.97,
      "end_seconds": 142.02,
      "duration_seconds": 4.05,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.18,
      "end_seconds": 144.55,
      "duration_seconds": 1.37,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.47,
      "end_seconds": 149.36,
      "duration_seconds": 2.89,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.21,
      "end_seconds": 161.64,
      "duration_seconds": 11.43,
      "text": "No, I've never smoked in my life. I only drink at family occasions. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.36,
      "end_seconds": 166.64,
      "duration_seconds": 3.28,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 168.1,
      "end_seconds": 182.04,
      "duration_seconds": 13.94,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 183.45,
      "end_seconds": 185.62,
      "duration_seconds": 2.17,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 187.01,
      "end_seconds": 193.22,
      "duration_seconds": 6.21,
      "text": "Yes, I had keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.28,
      "end_seconds": 197.22,
      "duration_seconds": 2.94,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 198.09,
      "end_seconds": 203.06,
      "duration_seconds": 4.97,
      "text": "My aunt has rheumatoid arthritis. My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.14,
      "end_seconds": 214.17,
      "duration_seconds": 2.03,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 215.38,
      "end_seconds": 220.68,
      "duration_seconds": 5.3,
      "text": "High blood pressure, for nearly five years. I've had gout, yes."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.35,
      "end_seconds": 223.67,
      "duration_seconds": 1.32,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.48,
      "end_seconds": 233.78,
      "duration_seconds": 9.3,
      "text": "Okay, I can see gout in your file as well. Okay, which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 235.38,
      "end_seconds": 241.16,
      "duration_seconds": 5.78,
      "text": "I'm on febuxostat, 80 milligrams, once a day for the gout."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 242.04,
      "end_seconds": 250.09,
      "duration_seconds": 8.05,
      "text": "It's meant to be once a day, though I don't see she take it every time."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.64,
      "end_seconds": 253.87,
      "duration_seconds": 2.23,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.81,
      "end_seconds": 257.72,
      "duration_seconds": 2.91,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.38,
      "end_seconds": 271.21,
      "duration_seconds": 3.83,
      "text": "You have a thick neck and a crowded throat."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.7,
      "end_seconds": 275.39,
      "duration_seconds": 1.69,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 289.22,
      "end_seconds": 298.44,
      "duration_seconds": 9.22,
      "text": "Right, here's what I'm thinking. I can't pin this down yet. We're looking at probable obstructive sleep apnoea or an underactive thyroid."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 299.98,
      "end_seconds": 302.82,
      "duration_seconds": 2.84,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 303.94,
      "end_seconds": 316.5,
      "duration_seconds": 12.56,
      "text": "It's reasonable to be concerned, but right now probable obstructive sleep apnoea is my leading thought, not anything worse. Let's book a thyroid test to look into tiredness."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 317.2,
      "end_seconds": 320.32,
      "duration_seconds": 3.12,
      "text": "The earliest is Thursday, 3:30 pm."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 322.11,
      "end_seconds": 327.64,
      "duration_seconds": 5.53,
      "text": "I think a home sleep study makes sense here, for snoring and apnoeas."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 332.47,
      "end_seconds": 335.61,
      "duration_seconds": 3.14,
      "text": "Um, that's fine with me."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 336.41,
      "end_seconds": 346.91,
      "duration_seconds": 10.5,
      "text": "Avoid alcohol in the evening, lose some weight if you can, and do not drive when drowsy. We'll refer you to the sleep clinic."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 347.9,
      "end_seconds": 350.58,
      "duration_seconds": 2.68,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 352.21,
      "end_seconds": 354.73,
      "duration_seconds": 2.52,
      "text": "Come back after the sleep study."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 355.94,
      "end_seconds": 359.2,
      "duration_seconds": 3.26,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 364.35,
      "end_seconds": 368.67,
      "duration_seconds": 4.32,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 370.11,
      "end_seconds": 373.93,
      "duration_seconds": 3.82,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 374.45,
      "end_seconds": 375.74,
      "duration_seconds": 1.29,
      "text": "See you soon."
    }
  ]
}