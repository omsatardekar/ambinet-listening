{
  "schema_version": "1.0",
  "encounter_id": "01808",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.63,
      "end_seconds": 7.4,
      "duration_seconds": 6.77,
      "text": "doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.55,
      "end_seconds": 13.23,
      "duration_seconds": 4.68,
      "text": "Right, no problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.13,
      "end_seconds": 23.51,
      "duration_seconds": 8.38,
      "text": "doctor, it's a painful blistering rash on one side. It's getting on my nerves now"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.09,
      "end_seconds": 26.88,
      "duration_seconds": 2.79,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.32,
      "end_seconds": 42.05,
      "duration_seconds": 2.73,
      "text": "that's it, just a little longer.."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.71,
      "end_seconds": 69.03,
      "duration_seconds": 14.32,
      "text": "Okay: respiratory rate 17, weight 89 kilos, BMI works out to 36.6. And blood pressure 118 over 74, temp 37.0 degrees, height 156 centimetres, pulse is 86 beats a minute."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.34,
      "end_seconds": 72.98,
      "duration_seconds": 1.64,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.08,
      "end_seconds": 78.81,
      "duration_seconds": 4.73,
      "text": "Right, they help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.4,
      "end_seconds": 97.72,
      "duration_seconds": 1.32,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.41,
      "end_seconds": 107.3,
      "duration_seconds": 8.89,
      "text": "just since yesterday. I've been putting this off for weeks. It's the not knowing that gets to me"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.58,
      "end_seconds": 110.67,
      "duration_seconds": 2.09,
      "text": "What aggravates it, if anything?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.94,
      "end_seconds": 128.76,
      "duration_seconds": 16.82,
      "text": "I mean, I notice it more with touch. And I've been feeling unwell as well. Sensitivity to clothes touching was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.55,
      "end_seconds": 134.25,
      "duration_seconds": 3.7,
      "text": "And what about rash across the midline or fever?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.63,
      "end_seconds": 139.35,
      "duration_seconds": 3.72,
      "text": "No, uh, none that I've noticed."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.47,
      "end_seconds": 142.51,
      "duration_seconds": 2.04,
      "text": "Any weakness or eye involvement?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.96,
      "end_seconds": 147.11,
      "duration_seconds": 3.15,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.15,
      "end_seconds": 153.65,
      "duration_seconds": 4.5,
      "text": "Okay, anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.46,
      "end_seconds": 157.14,
      "duration_seconds": 1.68,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.24,
      "end_seconds": 160.47,
      "duration_seconds": 2.23,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.17,
      "end_seconds": 164.37,
      "duration_seconds": 3.2,
      "text": "Okay, so I move fine otherwise."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.37,
      "end_seconds": 169.26,
      "duration_seconds": 2.89,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.14,
      "end_seconds": 181.16,
      "duration_seconds": 11.02,
      "text": "My partner and our baby. I look after my grandchildren most days. I'm vegetarian and have been for years"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.79,
      "end_seconds": 187.02,
      "duration_seconds": 5.23,
      "text": "What's on your current medicine list? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.02,
      "end_seconds": 193.66,
      "duration_seconds": 4.64,
      "text": "well, I take Seretide inhaler, twice a day"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.83,
      "end_seconds": 199.01,
      "duration_seconds": 4.18,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.03,
      "end_seconds": 202.83,
      "duration_seconds": 2.8,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.44,
      "end_seconds": 206.56,
      "duration_seconds": 3.12,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.09,
      "end_seconds": 227.87,
      "duration_seconds": 19.78,
      "text": "Yes, uh, I had a mole taken off my arm, a few years ago. I told myself I'd wait and see, and here I am. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.69,
      "end_seconds": 232.54,
      "duration_seconds": 3.85,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.86,
      "end_seconds": 240.13,
      "duration_seconds": 2.27,
      "text": "I've had asthma, yes"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.07,
      "end_seconds": 247.75,
      "duration_seconds": 5.68,
      "text": "Hm, okay. Okay, I can see asthma in your file as well."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.09,
      "end_seconds": 252.03,
      "duration_seconds": 2.94,
      "text": "Okay, shall I start the the examination?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.85,
      "end_seconds": 255.13,
      "duration_seconds": 2.28,
      "text": "raise your arm for me"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.02,
      "end_seconds": 280.19,
      "duration_seconds": 9.17,
      "text": "there are grouped blisters on a red base along one band on the right side and none cross the midline"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.35,
      "end_seconds": 286.89,
      "duration_seconds": 2.54,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.6,
      "end_seconds": 304.96,
      "duration_seconds": 9.36,
      "text": "so, to recap quickly you've had a painful blistering rash on one side, yesterday, and no rash across the midline or fever"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.0,
      "end_seconds": 309.1,
      "duration_seconds": 3.1,
      "text": "right, that's what happened, yes"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.84,
      "end_seconds": 320.69,
      "duration_seconds": 9.85,
      "text": "keep the rash covered and stay away from pregnant women and newborn babies until it has crusted that's all from me any questions?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.91,
      "end_seconds": 326.04,
      "duration_seconds": 4.13,
      "text": "Hmm, great, thank you for your help."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.72,
      "end_seconds": 329.33,
      "duration_seconds": 1.61,
      "text": "Have a good day."
    }
  ]
