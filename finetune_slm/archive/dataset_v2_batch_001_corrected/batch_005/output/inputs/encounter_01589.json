{
  "schema_version": "1.0",
  "encounter_id": "01589",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.98,
      "end_seconds": 5.95,
      "duration_seconds": 4.97,
      "text": "I mean, hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.59,
      "end_seconds": 10.58,
      "duration_seconds": 3.99,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.84,
      "end_seconds": 21.65,
      "duration_seconds": 9.81,
      "text": "Mainly itchy brown skin on the shin. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.16,
      "end_seconds": 26.06,
      "duration_seconds": 3.9,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.24,
      "end_seconds": 39.27,
      "duration_seconds": 2.03,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.79,
      "end_seconds": 66.85,
      "duration_seconds": 9.06,
      "text": "Okay: saturation 97 percent, temperature is 36.4 degrees, pulse is 71 beats a minute. And BP is 126 over 72."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.7,
      "end_seconds": 70.35,
      "duration_seconds": 1.65,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.43,
      "end_seconds": 75.88,
      "duration_seconds": 3.45,
      "text": "So, we'll look at it together shortly."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.0,
      "end_seconds": 84.21,
      "duration_seconds": 1.21,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.85,
      "end_seconds": 91.75,
      "duration_seconds": 6.9,
      "text": "Sorry, what was I saying, it's been going on for about four days."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.72,
      "end_seconds": 96.09,
      "duration_seconds": 2.37,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.69,
      "end_seconds": 100.98,
      "duration_seconds": 3.29,
      "text": "Honestly, a couple of times a week."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.86,
      "end_seconds": 106.1,
      "duration_seconds": 3.24,
      "text": "Right, how much does it limit you?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.24,
      "end_seconds": 108.85,
      "duration_seconds": 1.61,
      "text": "I'd say moderate."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.98,
      "end_seconds": 112.09,
      "duration_seconds": 2.11,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.15,
      "end_seconds": 122.72,
      "duration_seconds": 8.57,
      "text": "A sore on my ankle that won't heal goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.43,
      "end_seconds": 146.23,
      "duration_seconds": 5.8,
      "text": "Alright, have you noticed fever, spreading redness, calf pain or chest pain?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.02,
      "end_seconds": 152.11,
      "duration_seconds": 4.09,
      "text": "I mean, no, none of those at all."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.58,
      "end_seconds": 157.2,
      "duration_seconds": 3.62,
      "text": "Right, any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.25,
      "end_seconds": 162.84,
      "duration_seconds": 3.59,
      "text": "No, you know, joints are fine."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.5,
      "end_seconds": 175.13,
      "duration_seconds": 2.63,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.86,
      "end_seconds": 178.68,
      "duration_seconds": 2.82,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.34,
      "end_seconds": 182.29,
      "duration_seconds": 2.95,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.67,
      "end_seconds": 186.86,
      "duration_seconds": 3.19,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.25,
      "end_seconds": 189.51,
      "duration_seconds": 1.26,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.13,
      "end_seconds": 195.03,
      "duration_seconds": 3.9,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.11,
      "end_seconds": 203.92,
      "duration_seconds": 7.81,
      "text": "Any medical conditions, anything you've been treated for? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.87,
      "end_seconds": 207.95,
      "duration_seconds": 3.08,
      "text": "No, you know, no conditions."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.43,
      "end_seconds": 225.23,
      "duration_seconds": 3.8,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.59,
      "end_seconds": 229.28,
      "duration_seconds": 2.69,
      "text": "My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.91,
      "end_seconds": 233.62,
      "duration_seconds": 2.71,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.41,
      "end_seconds": 236.66,
      "duration_seconds": 2.25,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.23,
      "end_seconds": 240.7,
      "duration_seconds": 2.47,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.54,
      "end_seconds": 244.03,
      "duration_seconds": 1.49,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.75,
      "end_seconds": 247.06,
      "duration_seconds": 1.31,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.07,
      "end_seconds": 267.24,
      "duration_seconds": 7.17,
      "text": "There is a shallow ulcer above the inner ankle with brown skin around it and visible varicose veins."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.23,
      "end_seconds": 301.66,
      "duration_seconds": 28.43,
      "text": "You can sit up now. Right, here's what I'm thinking. I think we're dealing with a venous leg ulcer at this stage. Let's book a doppler test of the leg pulses to look into leg ulcer. The result will help us decide whether anything more is needed. Let's book a wound swab to look into leg ulcer. Compression bandaging and keeping the leg raised when sitting."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.33,
      "end_seconds": 317.22,
      "duration_seconds": 14.89,
      "text": "Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. The leg ulcer clinic would be the right next step, I'll refer you. See me again in two weeks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.97,
      "end_seconds": 319.67,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.36,
      "end_seconds": 323.55,
      "duration_seconds": 3.19,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.34,
      "end_seconds": 328.43,
      "duration_seconds": 3.09,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}