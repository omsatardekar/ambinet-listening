{
  "schema_version": "1.0",
  "encounter_id": "01642",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.32,
      "end_seconds": 6.35,
      "duration_seconds": 5.03,
      "text": "Hello, take a seat, I'll be with you in a second."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 7.17,
      "end_seconds": 12.84,
      "duration_seconds": 5.67,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.96,
      "end_seconds": 20.26,
      "duration_seconds": 6.3,
      "text": "Of course, please stay. It's helpful to have you here. What's been worrying you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 21.22,
      "end_seconds": 24.58,
      "duration_seconds": 3.36,
      "text": "We came because of colicky tummy pain."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.48,
      "end_seconds": 26.67,
      "duration_seconds": 1.19,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 28.31,
      "end_seconds": 33.77,
      "duration_seconds": 5.46,
      "text": "Sorry, what was I saying, around two weeks, I think."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 35.61,
      "end_seconds": 39.43,
      "duration_seconds": 3.82,
      "text": "Hm, I'd say more like three weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.09,
      "end_seconds": 47.37,
      "duration_seconds": 4.28,
      "text": "okay, so roughly two to three weeks is that right?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 48.34,
      "end_seconds": 50.56,
      "duration_seconds": 2.22,
      "text": "I suppose so, yes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.16,
      "end_seconds": 54.68,
      "duration_seconds": 2.52,
      "text": "is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 58.22,
      "end_seconds": 60.14,
      "duration_seconds": 1.92,
      "text": "it comes and goes"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.45,
      "end_seconds": 64.49,
      "duration_seconds": 3.04,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 66.42,
      "end_seconds": 69.43,
      "duration_seconds": 3.01,
      "text": "About a eight out of ten."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 70.23,
      "end_seconds": 76.68,
      "duration_seconds": 6.45,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 76.78,
      "end_seconds": 83.23,
      "duration_seconds": 6.45,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.94,
      "end_seconds": 87.21,
      "duration_seconds": 2.27,
      "text": "later, thanks. Please go on"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 87.91,
      "end_seconds": 90.94,
      "duration_seconds": 3.03,
      "text": "There's vomiting green fluid as well."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.84,
      "end_seconds": 93.3,
      "duration_seconds": 1.46,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 93.83,
      "end_seconds": 97.93,
      "duration_seconds": 4.1,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.65,
      "end_seconds": 100.86,
      "duration_seconds": 2.21,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 102.58,
      "end_seconds": 106.9,
      "duration_seconds": 4.32,
      "text": "No, I share a house with my brother"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.59,
      "end_seconds": 111.42,
      "duration_seconds": 2.83,
      "text": "do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 113.02,
      "end_seconds": 116.71,
      "duration_seconds": 3.69,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.8,
      "end_seconds": 121.22,
      "duration_seconds": 3.42,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 121.81,
      "end_seconds": 127.02,
      "duration_seconds": 5.21,
      "text": "I had keyhole surgery on my gallbladder two years back."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.06,
      "end_seconds": 131.18,
      "duration_seconds": 2.12,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 132.96,
      "end_seconds": 135.88,
      "duration_seconds": 2.92,
      "text": "Eltroxin. I take it every morning."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.7,
      "end_seconds": 142.34,
      "duration_seconds": 2.64,
      "text": "Okay, do you know the dose?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 144.14,
      "end_seconds": 155.42,
      "duration_seconds": 11.28,
      "text": "100 micrograms, I think that's what's on the the box. Atorvastatin. I take it 20 milligrams, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 157.22,
      "end_seconds": 162.76,
      "duration_seconds": 5.54,
      "text": "Doctor, our chart from the last visit lists it it as 10 milligrams."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.62,
      "end_seconds": 167.52,
      "duration_seconds": 3.9,
      "text": "Right. Do you happen to have the current prescription here?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 168.4,
      "end_seconds": 182.89,
      "duration_seconds": 14.49,
      "text": "No, you know, I left it at home. I'm on paracetamol, 650 milligrams, when needed for the knee pain. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.4,
      "end_seconds": 187.23,
      "duration_seconds": 2.83,
      "text": "do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 188.56,
      "end_seconds": 193.86,
      "duration_seconds": 5.3,
      "text": "I've had an underactive thyroid for nearly five years now"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.68,
      "end_seconds": 197.07,
      "duration_seconds": 1.39,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 198.74,
      "end_seconds": 210.04,
      "duration_seconds": 11.3,
      "text": "I have high cholesterol. My neighbour said I should get it looked at. Arthritis in my knees, for about ten years"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.5,
      "end_seconds": 212.83,
      "duration_seconds": 1.33,
      "text": "Is that everything?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 214.43,
      "end_seconds": 215.99,
      "duration_seconds": 1.56,
      "text": "I have anxiety."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.9,
      "end_seconds": 229.48,
      "duration_seconds": 11.58,
      "text": "alright, arthritis in your knees and anxiety, that matches what I have here any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 231.53,
      "end_seconds": 239.83,
      "duration_seconds": 8.3,
      "text": "Yes, cat fur. I've no idea what the reaction was, only that I'm not supposed to have it."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.38,
      "end_seconds": 263.11,
      "duration_seconds": 6.73,
      "text": "Let me check a few things. Any fever, blood in the stool or hernia?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 265.15,
      "end_seconds": 277.34,
      "duration_seconds": 12.19,
      "text": "No, no fever, no blood in the stool, no hernia. I did have not passing wind at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.02,
      "end_seconds": 280.78,
      "duration_seconds": 2.76,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 281.57,
      "end_seconds": 284.3,
      "duration_seconds": 2.73,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 295.78,
      "end_seconds": 305.26,
      "duration_seconds": 9.48,
      "text": "Doctor, I've got the readings for you. Pressure 131 over 85, saturation 99 percent, heart rate 115, temperature is 36.6 degrees."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.14,
      "end_seconds": 307.07,
      "duration_seconds": 0.93,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.22,
      "end_seconds": 313.4,
      "duration_seconds": 4.18,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 314.91,
      "end_seconds": 316.1,
      "duration_seconds": 1.19,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 334.65,
      "end_seconds": 339.05,
      "duration_seconds": 4.4,
      "text": "Your tummy is swollen and tympanic, with high-pitched tinkling bowel sounds."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 341.34,
      "end_seconds": 354.55,
      "duration_seconds": 13.21,
      "text": "Okay, please sit back down. From what you've told me and what I found, my working impression is a bowel obstruction needing urgent surgical care. Severe constipation is also on my list."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 355.77,
      "end_seconds": 357.9,
      "duration_seconds": 2.13,
      "text": "will it clear up?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 359.84,
      "end_seconds": 375.31,
      "duration_seconds": 15.47,
      "text": "I can't promise yet, but most people with a bowel obstruction needing urgent surgical care do well once it's treated properly. Let me just check I've got this right. You've had colicky tummy pain, and no fever or hernia."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 375.82,
      "end_seconds": 378.09,
      "duration_seconds": 2.27,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 380.69,
      "end_seconds": 388.5,
      "duration_seconds": 7.81,
      "text": "I'd like to arrange urgent blood tests for vomiting. Let's get an abdominal X-ray, for possible obstruction."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 390.08,
      "end_seconds": 392.35,
      "duration_seconds": 2.27,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 393.89,
      "end_seconds": 415.07,
      "duration_seconds": 21.18,
      "text": "Nothing to eat or drink, and you are going to hospital now. I'd like you to see the surgical team as well, and I'll write the referral. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 417.06,
      "end_seconds": 419.15,
      "duration_seconds": 2.09,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 419.92,
      "end_seconds": 424.57,
      "duration_seconds": 4.65,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 426.42,
      "end_seconds": 428.23,
      "duration_seconds": 1.81,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 429.72,
      "end_seconds": 430.9,
      "duration_seconds": 1.18,
      "text": "See you soon."
    }
  ]
}