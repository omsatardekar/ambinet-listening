{
  "schema_version": "1.0",
  "encounter_id": "01826",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.2,
      "end_seconds": 8.71,
      "duration_seconds": 7.51,
      "text": "Okay, doctor, we're all set in here. I'll give you the numbers when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.09,
      "end_seconds": 15.06,
      "duration_seconds": 4.97,
      "text": "good, thank you. Welcome, tell me what's brought you in"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 16.01,
      "end_seconds": 26.11,
      "duration_seconds": 10.1,
      "text": "Doctor, thank you for seeing us. It's an itchy scalp, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.61,
      "end_seconds": 31.17,
      "duration_seconds": 3.56,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 31.84,
      "end_seconds": 47.88,
      "duration_seconds": 16.04,
      "text": "She is on alendronate, 70 milligrams, once a week for my bones, I give it to her. Actually, it's iron tablets, once a day for my blood count, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.48,
      "end_seconds": 53.6,
      "duration_seconds": 3.12,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 54.33,
      "end_seconds": 55.69,
      "duration_seconds": 1.36,
      "text": "For six months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.32,
      "end_seconds": 59.49,
      "duration_seconds": 2.17,
      "text": "Right, when did this begin?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 61.4,
      "end_seconds": 64.24,
      "duration_seconds": 2.84,
      "text": "Around three days, I think."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 64.97,
      "end_seconds": 68.68,
      "duration_seconds": 3.71,
      "text": "I think it's been nearer five days, actually."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.09,
      "end_seconds": 75.1,
      "duration_seconds": 5.01,
      "text": "Okay, so so roughly three to five days. Is that right?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 75.84,
      "end_seconds": 77.07,
      "duration_seconds": 1.23,
      "text": "Yeah, roughly."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.66,
      "end_seconds": 86.8,
      "duration_seconds": 9.14,
      "text": "Ah. Can you describe it it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 88.71,
      "end_seconds": 94.46,
      "duration_seconds": 5.75,
      "text": "Honestly, once or twice a day. Pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 95.25,
      "end_seconds": 101.52,
      "duration_seconds": 6.27,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 101.62,
      "end_seconds": 107.92,
      "duration_seconds": 6.3,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.42,
      "end_seconds": 112.0,
      "duration_seconds": 2.58,
      "text": "later, thanks please go on"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 112.61,
      "end_seconds": 120.07,
      "duration_seconds": 7.46,
      "text": "Oh, and scratch marks on the neck. That's been about the the same, about four days."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.09,
      "end_seconds": 124.98,
      "duration_seconds": 2.89,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 129.72,
      "end_seconds": 131.23,
      "duration_seconds": 1.51,
      "text": "Severe, I'd say."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 132.03,
      "end_seconds": 135.83,
      "duration_seconds": 3.8,
      "text": "Yes, that's right, that's how it was."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.17,
      "end_seconds": 143.96,
      "duration_seconds": 6.79,
      "text": "Let me check a few things. Any fever, swollen glands or rash on the body?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 149.88,
      "end_seconds": 164.55,
      "duration_seconds": 14.67,
      "text": "No, no fever, no swollen glands, no rash on the body. I did have seeing tiny bugs in the hair at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.71,
      "end_seconds": 168.83,
      "duration_seconds": 3.12,
      "text": "any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 170.63,
      "end_seconds": 172.16,
      "duration_seconds": 1.53,
      "text": "nothing else aches"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.76,
      "end_seconds": 176.14,
      "duration_seconds": 3.38,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 177.48,
      "end_seconds": 178.82,
      "duration_seconds": 1.34,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.6,
      "end_seconds": 183.07,
      "duration_seconds": 2.47,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 184.79,
      "end_seconds": 188.94,
      "duration_seconds": 4.15,
      "text": "Okay, so no, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 189.83,
      "end_seconds": 196.77,
      "duration_seconds": 6.94,
      "text": "hold on, doctor, I think she reacted to naproxen once i'm not certain, though"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 197.52,
      "end_seconds": 199.54,
      "duration_seconds": 2.02,
      "text": "I don't remember that."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.64,
      "end_seconds": 206.12,
      "duration_seconds": 4.48,
      "text": "Alright, so that's unclear. I'll record what each of you said."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.07,
      "end_seconds": 218.22,
      "duration_seconds": 3.15,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 219.82,
      "end_seconds": 225.75,
      "duration_seconds": 5.93,
      "text": "My aunt has rheumatoid arthritis. Right, my daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.64,
      "end_seconds": 227.82,
      "duration_seconds": 1.18,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 229.1,
      "end_seconds": 231.87,
      "duration_seconds": 2.77,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.91,
      "end_seconds": 238.39,
      "duration_seconds": 1.48,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 239.35,
      "end_seconds": 243.69,
      "duration_seconds": 4.34,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.02,
      "end_seconds": 247.51,
      "duration_seconds": 2.49,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 249.15,
      "end_seconds": 252.72,
      "duration_seconds": 3.57,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.29,
      "end_seconds": 270.47,
      "duration_seconds": 1.18,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 271.31,
      "end_seconds": 274.22,
      "duration_seconds": 2.91,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.27,
      "end_seconds": 279.95,
      "duration_seconds": 3.68,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 281.58,
      "end_seconds": 286.41,
      "duration_seconds": 4.83,
      "text": "I've had thin bones, yes. I've got low haemoglobin."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.61,
      "end_seconds": 295.12,
      "duration_seconds": 7.51,
      "text": "Yes, carry on. Right, so thin bones is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 297.02,
      "end_seconds": 304.4,
      "duration_seconds": 7.38,
      "text": "okay, so the vitals from earlier bP is 117 over 68, pulse 72, temperature 36.8."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.1,
      "end_seconds": 306.01,
      "duration_seconds": 0.91,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.82,
      "end_seconds": 311.34,
      "duration_seconds": 2.52,
      "text": "Right, may I examine you now?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.28,
      "end_seconds": 314.12,
      "duration_seconds": 1.84,
      "text": "Alright, does that hurt?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.54,
      "end_seconds": 328.56,
      "duration_seconds": 6.02,
      "text": "I can see live lice and small eggs close to the roots behind the ears."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 329.44,
      "end_seconds": 330.35,
      "duration_seconds": 0.91,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.55,
      "end_seconds": 339.9,
      "duration_seconds": 5.35,
      "text": "Please sit back down. Putting it all together, I'd lean towards head lice."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 341.21,
      "end_seconds": 344.03,
      "duration_seconds": 2.82,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.11,
      "end_seconds": 372.93,
      "duration_seconds": 26.82,
      "text": "Nothing I've seen today points to an emergency. It looks like head lice. What I'm giving you is dimeticone lotion, 4%, once, repeat after seven days, two applications. That should help with head lice. Comb the hair with a fine comb every few days and check the family. If the symptoms get worse, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 373.83,
      "end_seconds": 375.52,
      "duration_seconds": 1.69,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 377.09,
      "end_seconds": 386.18,
      "duration_seconds": 9.09,
      "text": "We'll catch up if lice persist after two treatments. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 387.54,
      "end_seconds": 390.52,
      "duration_seconds": 2.98,
      "text": "Great, thank you for your help."
    }
  ]
}