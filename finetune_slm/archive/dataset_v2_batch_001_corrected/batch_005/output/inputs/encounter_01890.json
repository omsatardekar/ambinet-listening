{
  "schema_version": "1.0",
  "encounter_id": "01890",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.73,
      "end_seconds": 6.51,
      "duration_seconds": 5.78,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.7,
      "end_seconds": 11.36,
      "duration_seconds": 3.66,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.99,
      "end_seconds": 21.94,
      "duration_seconds": 9.95,
      "text": "Right, honestly, it's pain under my right ribs after fatty meals, and and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.66,
      "end_seconds": 25.6,
      "duration_seconds": 2.94,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.67,
      "end_seconds": 39.36,
      "duration_seconds": 12.69,
      "text": "Since Monday, that's when it began sorry, I know I'm rambling a bit i took the morning off to come in today"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.82,
      "end_seconds": 53.23,
      "duration_seconds": 8.41,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.09,
      "end_seconds": 66.87,
      "duration_seconds": 11.78,
      "text": "It's mild, honestly. It's worse with fatty meals. I get some relief from lying still. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.79,
      "end_seconds": 69.75,
      "duration_seconds": 1.96,
      "text": "Any bloating as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.62,
      "end_seconds": 72.09,
      "duration_seconds": 1.47,
      "text": "Yes, since Monday."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.46,
      "end_seconds": 88.27,
      "duration_seconds": 4.81,
      "text": "have you had any yellow eyes, pale stools or dark urine?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.14,
      "end_seconds": 95.37,
      "duration_seconds": 6.23,
      "text": "I haven't had yellow eyes, pale stools or dark urine, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.05,
      "end_seconds": 97.31,
      "duration_seconds": 1.26,
      "text": "Nothing like fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.37,
      "end_seconds": 101.0,
      "duration_seconds": 1.63,
      "text": "No. No fever."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.23,
      "end_seconds": 105.23,
      "duration_seconds": 4.0,
      "text": "Mm, okay. How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.21,
      "end_seconds": 109.07,
      "duration_seconds": 1.86,
      "text": "I move fine otherwise"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.93,
      "end_seconds": 112.77,
      "duration_seconds": 2.84,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.89,
      "end_seconds": 116.18,
      "duration_seconds": 2.29,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.27,
      "end_seconds": 120.15,
      "duration_seconds": 2.88,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.17,
      "end_seconds": 126.42,
      "duration_seconds": 5.25,
      "text": "Yes, I had keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.41,
      "end_seconds": 145.66,
      "duration_seconds": 5.25,
      "text": "Tell me your medicines, please. I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.5,
      "end_seconds": 159.95,
      "duration_seconds": 10.45,
      "text": "Lisinopril. I take it 10 milligrams, once a day. I do miss it now and then, to be fair"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.01,
      "end_seconds": 164.31,
      "duration_seconds": 3.3,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.33,
      "end_seconds": 168.13,
      "duration_seconds": 2.8,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.06,
      "end_seconds": 175.24,
      "duration_seconds": 5.18,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.99,
      "end_seconds": 189.68,
      "duration_seconds": 13.69,
      "text": "I only drink at family occasions. I'm vegetarian and have been for years. My husband and I live above the shop. I swim twice a week."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.45,
      "end_seconds": 194.21,
      "duration_seconds": 2.76,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.84,
      "end_seconds": 197.27,
      "duration_seconds": 1.43,
      "text": "no known allergies"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.8,
      "end_seconds": 211.76,
      "duration_seconds": 3.96,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.16,
      "end_seconds": 215.24,
      "duration_seconds": 2.08,
      "text": "yes, high blood pressure"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.82,
      "end_seconds": 223.56,
      "duration_seconds": 7.74,
      "text": "right, right. Alright, high blood pressure, that matches what I have here. I'll do your observations first"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.27,
      "end_seconds": 238.56,
      "duration_seconds": 2.29,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.22,
      "end_seconds": 263.48,
      "duration_seconds": 7.26,
      "text": "Okay: temp 36.6 degrees, oxygen saturation is 98 percent, pressure 115 over 76, heart rate 68."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.51,
      "end_seconds": 268.97,
      "duration_seconds": 4.46,
      "text": "Right, could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.86,
      "end_seconds": 271.3,
      "duration_seconds": 1.44,
      "text": "does that hurt?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.97,
      "end_seconds": 295.11,
      "duration_seconds": 7.14,
      "text": "it is tender under the right ribs and you stop breathing in when I press"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.83,
      "end_seconds": 316.0,
      "duration_seconds": 15.17,
      "text": "That's the examination finished. Putting it all together, this looks most like gallstone-related pain. The reason I say that is that your story and my examination fit together. I can't rule out a stomach ulcer yet."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.62,
      "end_seconds": 320.91,
      "duration_seconds": 3.29,
      "text": "hmm, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.4,
      "end_seconds": 340.45,
      "duration_seconds": 18.05,
      "text": "It's reasonable to be concerned, but right now gallstone-related pain is my leading thought, not anything worse. So, to recap quickly. You've had pain under your right ribs after fatty meals, since Monday, mild, and no fever or yellow eyes."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.09,
      "end_seconds": 342.71,
      "duration_seconds": 1.62,
      "text": "mm, that's right"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.22,
      "end_seconds": 347.62,
      "duration_seconds": 4.4,
      "text": "let's get an ultrasound of the abdomen, for biliary pain"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 349.0,
      "end_seconds": 353.08,
      "duration_seconds": 4.08,
      "text": "I can book that for Wednesday at 2 pm."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 353.7,
      "end_seconds": 356.07,
      "duration_seconds": 2.37,
      "text": "Okay, I'll be there."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.73,
      "end_seconds": 371.98,
      "duration_seconds": 14.25,
      "text": "I'll request liver blood tests, it'll help with biliary pain. You'll be taking paracetamol, 1 gram, four times a day when needed, one week. You take it by mouth. That should help with pain."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 377.25,
      "end_seconds": 378.88,
      "duration_seconds": 1.63,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.4,
      "end_seconds": 390.77,
      "duration_seconds": 10.37,
      "text": "Avoid fatty and fried foods until the scan. I'll want another look after the scan. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 392.03,
      "end_seconds": 393.65,
      "duration_seconds": 1.62,
      "text": "that's clear, thanks"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 394.53,
      "end_seconds": 396.11,
      "duration_seconds": 1.58,
      "text": "Have a good day."
    }
  ]
}