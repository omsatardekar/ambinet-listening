      "role": "DOCTOR",
      "start_seconds": 8.03,
      "end_seconds": 12.27,
      "duration_seconds": 4.24,
      "text": "of course leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.3,
      "end_seconds": 25.05,
      "duration_seconds": 10.75,
      "text": "hello, doctor i'm here with them in case I can help erm, doctor, it's thoughts of ending my life that's what we're worried about"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.25,
      "end_seconds": 30.2,
      "duration_seconds": 3.95,
      "text": "How many days or weeks has it been?"
