      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.86,
      "end_seconds": 85.55,
      "duration_seconds": 4.69,
      "text": "I'd give it it a three out of ten"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "UNKNOWN",
      "start_seconds": 87.31,
      "end_seconds": 89.29,
      "duration_seconds": 1.98,
      "text": "yes, exactly like that"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.8,
      "end_seconds": 94.44,
      "duration_seconds": 3.64,
      "text": "have you had recent loss, by any chance?"
