    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.57,
      "end_seconds": 37.96,
      "duration_seconds": 2.39,
      "text": "is there anything else with it?"
