{
  "schema_version": "1.0",
  "encounter_id": "01569",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.08,
      "end_seconds": 5.27,
      "duration_seconds": 4.19,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.02,
      "end_seconds": 11.26,
      "duration_seconds": 4.24,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.26,
      "end_seconds": 18.68,
      "duration_seconds": 5.42,
      "text": "I've, I've been dealing with red sore skin on my shoulders."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.13,
      "end_seconds": 22.36,
      "duration_seconds": 2.23,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.22,
      "end_seconds": 32.58,
      "duration_seconds": 8.36,
      "text": "Clopidogrel. I take it 75 milligrams, once a day. I'm on naproxen, twice a day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.34,
      "end_seconds": 35.38,
      "duration_seconds": 2.04,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.96,
      "end_seconds": 39.99,
      "duration_seconds": 1.03,
      "text": "250 milligrams."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.39,
      "end_seconds": 54.62,
      "duration_seconds": 1.23,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.12,
      "end_seconds": 58.36,
      "duration_seconds": 2.24,
      "text": "About... well, two weeks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.22,
      "end_seconds": 67.32,
      "duration_seconds": 8.1,
      "text": "Okay, give me more detail on it, whatever comes to mind. Just so I get the full picture."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.09,
      "end_seconds": 76.1,
      "duration_seconds": 7.01,
      "text": "It settles a little with cool showers. Yes, clothes rubbing. That makes it worse."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.89,
      "end_seconds": 79.21,
      "duration_seconds": 2.32,
      "text": "Any blisters, headache or fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.12,
      "end_seconds": 84.37,
      "duration_seconds": 4.25,
      "text": "Ah, no, no blisters, headache or fever."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.96,
      "end_seconds": 87.11,
      "duration_seconds": 2.15,
      "text": "Have you had any vomiting?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.23,
      "end_seconds": 89.83,
      "duration_seconds": 1.6,
      "text": "Definitely no vomiting."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.34,
      "end_seconds": 96.29,
      "duration_seconds": 5.95,
      "text": "I see, go ahead. Okay, anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.95,
      "end_seconds": 100.27,
      "duration_seconds": 2.32,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.96,
      "end_seconds": 107.94,
      "duration_seconds": 4.98,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.95,
      "end_seconds": 113.38,
      "duration_seconds": 3.43,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.97,
      "end_seconds": 119.97,
      "duration_seconds": 5.0,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.71,
      "end_seconds": 131.47,
      "duration_seconds": 10.76,
      "text": "I swim twice a week. Lots of rice, lentils and some fruit. I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.66,
      "end_seconds": 142.57,
      "duration_seconds": 3.91,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.11,
      "end_seconds": 150.76,
      "duration_seconds": 6.65,
      "text": "Heart disease, for nearly five years. I've got arthritis in my knees."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.49,
      "end_seconds": 157.92,
      "duration_seconds": 6.43,
      "text": "Okay, I can see heart disease and arthritis in your knees in your file as well."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.5,
      "end_seconds": 178.04,
      "duration_seconds": 2.54,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.41,
      "end_seconds": 182.85,
      "duration_seconds": 3.44,
      "text": "Just a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.09,
      "end_seconds": 187.37,
      "duration_seconds": 3.28,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.53,
      "end_seconds": 201.77,
      "duration_seconds": 2.24,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.32,
      "end_seconds": 229.19,
      "duration_seconds": 6.87,
      "text": "Okay: saturation 98 percent, blood pressure 121 over 72, pulse is 85 beats a minute."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.08,
      "end_seconds": 232.56,
      "duration_seconds": 1.48,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.55,
      "end_seconds": 237.13,
      "duration_seconds": 2.58,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.62,
      "end_seconds": 242.43,
      "duration_seconds": 3.81,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.13,
      "end_seconds": 246.56,
      "duration_seconds": 2.43,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.33,
      "end_seconds": 266.92,
      "duration_seconds": 3.59,
      "text": "The skin is pink and tender with no blistering."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.93,
      "end_seconds": 273.22,
      "duration_seconds": 2.29,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.22,
      "end_seconds": 298.32,
      "duration_seconds": 15.1,
      "text": "Having listened and examined, this looks most like mild sunburn. Let me repeat that back to make sure. You've had red sore skin on your shoulders for two weeks, and no vomiting or blisters."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.45,
      "end_seconds": 300.92,
      "duration_seconds": 1.47,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.85,
      "end_seconds": 311.25,
      "duration_seconds": 8.4,
      "text": "Cool compresses, moisturiser and stay out of the sun for a few days. Let's plan a check if blisters develop."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.43,
      "end_seconds": 314.69,
      "duration_seconds": 2.26,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.54,
      "end_seconds": 319.87,
      "duration_seconds": 3.33,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.94,
      "end_seconds": 323.13,
      "duration_seconds": 2.19,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.2,
      "end_seconds": 326.45,
      "duration_seconds": 1.25,
      "text": "All the best."
    }
  ]
}