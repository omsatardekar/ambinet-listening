    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.45,
      "end_seconds": 270.17,
      "duration_seconds": 6.72,
      "text": "your blood pressure is a little raised in the clinic but your heart sounds are normal"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.93,
      "end_seconds": 273.45,
