{
  "schema_version": "1.0",
  "encounter_id": "01695",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.1,
      "end_seconds": 4.22,
      "duration_seconds": 3.12,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.18,
      "end_seconds": 10.67,
      "duration_seconds": 4.49,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.27,
      "end_seconds": 13.7,
      "duration_seconds": 2.43,
      "text": "It's drinking most nights, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.44,
      "end_seconds": 19.91,
      "duration_seconds": 2.47,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.71,
      "end_seconds": 36.04,
      "duration_seconds": 2.33,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.83,
      "end_seconds": 58.13,
      "duration_seconds": 8.3,
      "text": "Okay: pulse 70, temperature is 36.8 degrees, oxygen saturation is 99 percent. And BP is 121 over 82."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.2,
      "end_seconds": 77.09,
      "duration_seconds": 2.89,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.52,
      "end_seconds": 81.58,
      "duration_seconds": 3.06,
      "text": "I've had it for one week."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.48,
      "end_seconds": 85.48,
      "duration_seconds": 3.0,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.45,
      "end_seconds": 89.51,
      "duration_seconds": 2.06,
      "text": "I'd call it severe."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.07,
      "end_seconds": 98.48,
      "duration_seconds": 4.41,
      "text": "Has there been an upset stomach in the mornings too?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.23,
      "end_seconds": 102.54,
      "duration_seconds": 3.31,
      "text": "Yeah, I've had that since last night."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.1,
      "end_seconds": 110.01,
      "duration_seconds": 5.91,
      "text": "Let me check a few things. Any confusion, vomiting blood or black stools?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.16,
      "end_seconds": 115.8,
      "duration_seconds": 4.64,
      "text": "No, no confusion, vomiting blood or black stools."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.89,
      "end_seconds": 120.3,
      "duration_seconds": 2.41,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.44,
      "end_seconds": 122.45,
      "duration_seconds": 1.01,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.36,
      "end_seconds": 125.56,
      "duration_seconds": 1.2,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.75,
      "end_seconds": 129.14,
      "duration_seconds": 2.39,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.2,
      "end_seconds": 132.47,
      "duration_seconds": 1.27,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.27,
      "end_seconds": 137.6,
      "duration_seconds": 4.33,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.79,
      "end_seconds": 141.47,
      "duration_seconds": 2.68,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.08,
      "end_seconds": 145.94,
      "duration_seconds": 3.86,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.69,
      "end_seconds": 149.6,
      "duration_seconds": 1.91,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.51,
      "end_seconds": 155.14,
      "duration_seconds": 3.63,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.72,
      "end_seconds": 159.32,
      "duration_seconds": 2.6,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.03,
      "end_seconds": 162.15,
      "duration_seconds": 1.12,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.63,
      "end_seconds": 166.9,
      "duration_seconds": 3.27,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.45,
      "end_seconds": 171.99,
      "duration_seconds": 3.54,
      "text": "Sodium valproate, 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.53,
      "end_seconds": 177.77,
      "duration_seconds": 4.24,
      "text": "So, any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.63,
      "end_seconds": 182.54,
      "duration_seconds": 2.91,
      "text": "I have epilepsy, for five years."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.21,
      "end_seconds": 197.89,
      "duration_seconds": 3.68,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.62,
      "end_seconds": 201.53,
      "duration_seconds": 1.91,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.81,
      "end_seconds": 209.19,
      "duration_seconds": 5.38,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.41,
      "end_seconds": 217.42,
      "duration_seconds": 1.01,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.22,
      "end_seconds": 220.39,
      "duration_seconds": 1.17,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.01,
      "end_seconds": 238.12,
      "duration_seconds": 6.11,
      "text": "Your liver edge is felt slightly below the ribs and there is a fine tremor."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.55,
      "end_seconds": 252.21,
      "duration_seconds": 10.66,
      "text": "You can relax now. Let me tell you where I've got to. The most likely explanation is harmful alcohol use with liver strain."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.01,
      "end_seconds": 254.36,
      "duration_seconds": 1.35,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.71,
      "end_seconds": 264.39,
      "duration_seconds": 8.68,
      "text": "I understand the worry. At the moment I'd say it's harmful alcohol use with liver strain, and we'll watch how it goes."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.23,
      "end_seconds": 294.84,
      "duration_seconds": 12.61,
      "text": "Cut down gradually and do not stop suddenly on your own if you drink heavily. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.02,
      "end_seconds": 298.83,
      "duration_seconds": 2.81,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.22,
      "end_seconds": 301.45,
      "duration_seconds": 1.23,
      "text": "Goodbye for now."
    }
  ]
}