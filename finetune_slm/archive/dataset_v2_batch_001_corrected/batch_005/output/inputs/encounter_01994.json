{
  "schema_version": "1.0",
  "encounter_id": "01994",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.65,
      "end_seconds": 3.57,
      "duration_seconds": 2.92,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.29,
      "end_seconds": 9.05,
      "duration_seconds": 4.76,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.19,
      "end_seconds": 14.24,
      "duration_seconds": 4.05,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.12,
      "end_seconds": 23.15,
      "duration_seconds": 4.03,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 24.37,
      "end_seconds": 26.93,
      "duration_seconds": 2.56,
      "text": "We came because of sore knees."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.84,
      "end_seconds": 30.88,
      "duration_seconds": 3.04,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.83,
      "end_seconds": 44.41,
      "duration_seconds": 2.58,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.5,
      "end_seconds": 77.63,
      "duration_seconds": 13.13,
      "text": "Okay: temperature is 37.0 degrees, weight 88 kilos. And BP is 158 over 99, oxygen saturation is 96 percent, heart rate 93, height 153 centimetres."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.17,
      "end_seconds": 79.59,
      "duration_seconds": 1.42,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.43,
      "end_seconds": 86.5,
      "duration_seconds": 5.07,
      "text": "I'll come back to the numbers. How long has it been like this?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.04,
      "end_seconds": 89.94,
      "duration_seconds": 2.9,
      "text": "Around a week, I think."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 92.02,
      "end_seconds": 95.21,
      "duration_seconds": 3.19,
      "text": "It was closer to two weeks, doctor."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.54,
      "end_seconds": 100.82,
      "duration_seconds": 4.28,
      "text": "Okay, so roughly one to two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.88,
      "end_seconds": 105.14,
      "duration_seconds": 2.26,
      "text": "I suppose so, yes."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.2,
      "end_seconds": 118.64,
      "duration_seconds": 12.44,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps. I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.55,
      "end_seconds": 138.18,
      "duration_seconds": 18.63,
      "text": "Walking definitely sets it off. It feels moderate to me. It happens all the time. I just want to get back to normal, really. Oh, I've also been snoring, for about a month."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.13,
      "end_seconds": 143.39,
      "duration_seconds": 3.26,
      "text": "Have you been getting out of breath?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.23,
      "end_seconds": 152.44,
      "duration_seconds": 7.21,
      "text": "Yes, I have. About getting out of breath, honestly, a few times a day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.83,
      "end_seconds": 154.61,
      "duration_seconds": 0.78,
      "text": "Any palpitations?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.43,
      "end_seconds": 158.64,
      "duration_seconds": 3.21,
      "text": "Not that I've noticed, no palpitations."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.57,
      "end_seconds": 165.87,
      "duration_seconds": 6.3,
      "text": "Let me check a few things. Any high thirst, low mood or chest pain?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.8,
      "end_seconds": 172.98,
      "duration_seconds": 5.18,
      "text": "No high thirst, low mood or chest pain, none of it."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.51,
      "end_seconds": 179.67,
      "duration_seconds": 2.16,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.67,
      "end_seconds": 182.83,
      "duration_seconds": 2.16,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.43,
      "end_seconds": 186.64,
      "duration_seconds": 3.21,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.97,
      "end_seconds": 190.39,
      "duration_seconds": 2.42,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.46,
      "end_seconds": 195.62,
      "duration_seconds": 4.16,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.24,
      "end_seconds": 201.37,
      "duration_seconds": 5.13,
      "text": "My son has asthma. My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.5,
      "end_seconds": 219.2,
      "duration_seconds": 2.7,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.03,
      "end_seconds": 226.76,
      "duration_seconds": 6.73,
      "text": "Ramipril. I take it 5 milligrams, every morning for my blood pressure."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.91,
      "end_seconds": 229.57,
      "duration_seconds": 1.66,
      "text": "And for how long?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.49,
      "end_seconds": 240.57,
      "duration_seconds": 7.08,
      "text": "Two months now. Sertraline, 50 milligrams, maybe, once a day for my mood."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.25,
      "end_seconds": 246.29,
      "duration_seconds": 5.04,
      "text": "Right, have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.38,
      "end_seconds": 249.4,
      "duration_seconds": 2.02,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.15,
      "end_seconds": 272.43,
      "duration_seconds": 5.28,
      "text": "So, any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.23,
      "end_seconds": 277.3,
      "duration_seconds": 4.07,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.87,
      "end_seconds": 288.86,
      "duration_seconds": 3.99,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.7,
      "end_seconds": 293.51,
      "duration_seconds": 2.81,
      "text": "I've had high blood pressure, yes."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.56,
      "end_seconds": 296.14,
      "duration_seconds": 1.58,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.93,
      "end_seconds": 300.56,
      "duration_seconds": 3.63,
      "text": "I've had depression for five years now."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.38,
      "end_seconds": 310.24,
      "duration_seconds": 7.86,
      "text": "Alright, high blood pressure and depression, that matches what I have here. What do you do during the day?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.99,
      "end_seconds": 314.19,
      "duration_seconds": 3.2,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.73,
      "end_seconds": 316.87,
      "duration_seconds": 2.14,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.58,
      "end_seconds": 320.18,
      "duration_seconds": 2.6,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.79,
      "end_seconds": 325.27,
      "duration_seconds": 2.48,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.31,
      "end_seconds": 328.31,
      "duration_seconds": 2.0,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.37,
      "end_seconds": 348.56,
      "duration_seconds": 5.19,
      "text": "Your weight and waist measurement are both above the healthy range."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.23,
      "end_seconds": 387.87,
      "duration_seconds": 33.64,
      "text": "Good, you can sit up again. Putting it all together, it points towards obesity with weight-related symptoms. The reason I say that is that your story and my examination fit together. An underactive thyroid is also on my list. I think a cholesterol test makes sense here, for obesity. The result will help us decide whether anything more is needed. We should do a thyroid test for weight gain."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 389.26,
      "end_seconds": 391.1,
      "duration_seconds": 1.84,
      "text": "Is that done today?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 392.86,
      "end_seconds": 415.03,
      "duration_seconds": 22.17,
      "text": "Aim for a loss of half a kilo a week with smaller portions and a daily thirty-minute walk. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Come back in three months. How would you describe the plan, so we're on the same page?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 416.86,
      "end_seconds": 421.46,
      "duration_seconds": 4.6,
      "text": "So, I come back in three months. Is that right?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 423.52,
      "end_seconds": 427.35,
      "duration_seconds": 3.83,
      "text": "Yes, exactly right. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 428.4,
      "end_seconds": 430.1,
      "duration_seconds": 1.7,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 433.82,
      "end_seconds": 435.07,
      "duration_seconds": 1.25,
      "text": "Goodbye for now."
    }
  ]
}