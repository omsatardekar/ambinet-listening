{
  "schema_version": "1.0",
  "encounter_id": "01966",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.23,
      "end_seconds": 8.68,
      "duration_seconds": 7.45,
      "text": "Doctor, your next patient is here. I've done the basics, I'll read them out in a moment."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.97,
      "end_seconds": 17.65,
      "duration_seconds": 5.68,
      "text": "Right, good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 19.15,
      "end_seconds": 21.58,
      "duration_seconds": 2.43,
      "text": "I've been feeling very faint."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.46,
      "end_seconds": 26.91,
      "duration_seconds": 3.45,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 27.77,
      "end_seconds": 30.59,
      "duration_seconds": 2.82,
      "text": "For four weeks, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.85,
      "end_seconds": 33.86,
      "duration_seconds": 2.01,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 35.75,
      "end_seconds": 37.71,
      "duration_seconds": 1.96,
      "text": "It's all the time."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.98,
      "end_seconds": 42.51,
      "duration_seconds": 3.53,
      "text": "Have you had sharp chest pain on one side?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 44.15,
      "end_seconds": 51.79,
      "duration_seconds": 7.64,
      "text": "Mm, yeah. Ten days, I'd say. With sharp chest pain on one side, it's moderate, honestly."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 53.36,
      "end_seconds": 69.55,
      "duration_seconds": 16.19,
      "text": "Okay, so the vitals from earlier. Height 178 centimetres, pulse 96. Blood pressure 125 over 76, saturation 90 percent, temperature is 36.9 degrees, weight 93 kilos, BMI works out to 29.4, respiratory rate 23."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.62,
      "end_seconds": 71.94,
      "duration_seconds": 1.32,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.24,
      "end_seconds": 77.96,
      "duration_seconds": 3.72,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 85.09,
      "end_seconds": 86.6,
      "duration_seconds": 1.51,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.47,
      "end_seconds": 89.64,
      "duration_seconds": 1.17,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.77,
      "end_seconds": 108.76,
      "duration_seconds": 8.99,
      "text": "Your windpipe is pushed to the right, there is no breath sound on the left, and your pressure is dropping."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.33,
      "end_seconds": 114.1,
      "duration_seconds": 2.77,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.83,
      "end_seconds": 133.67,
      "duration_seconds": 5.84,
      "text": "Let me check a few things. Any cough, leg swelling or fever?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 134.6,
      "end_seconds": 140.76,
      "duration_seconds": 6.16,
      "text": "Sorry, what was I saying, no, I haven't had any of them."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.26,
      "end_seconds": 143.35,
      "duration_seconds": 2.09,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 144.44,
      "end_seconds": 146.92,
      "duration_seconds": 2.48,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.03,
      "end_seconds": 155.01,
      "duration_seconds": 0.98,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 156.53,
      "end_seconds": 160.09,
      "duration_seconds": 3.56,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.53,
      "end_seconds": 163.48,
      "duration_seconds": 1.95,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 164.3,
      "end_seconds": 166.0,
      "duration_seconds": 1.7,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.71,
      "end_seconds": 170.42,
      "duration_seconds": 2.71,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 172.2,
      "end_seconds": 175.4,
      "duration_seconds": 3.2,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.33,
      "end_seconds": 179.45,
      "duration_seconds": 2.12,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 181.32,
      "end_seconds": 185.34,
      "duration_seconds": 4.02,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.78,
      "end_seconds": 190.12,
      "duration_seconds": 3.34,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 190.93,
      "end_seconds": 195.01,
      "duration_seconds": 4.08,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.6,
      "end_seconds": 199.2,
      "duration_seconds": 2.6,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 201.3,
      "end_seconds": 202.38,
      "duration_seconds": 1.08,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.19,
      "end_seconds": 206.46,
      "duration_seconds": 3.27,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 207.94,
      "end_seconds": 209.74,
      "duration_seconds": 1.8,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.19,
      "end_seconds": 213.97,
      "duration_seconds": 2.78,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 215.98,
      "end_seconds": 218.11,
      "duration_seconds": 2.13,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.28,
      "end_seconds": 233.2,
      "duration_seconds": 2.92,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 235.01,
      "end_seconds": 238.95,
      "duration_seconds": 3.94,
      "text": "I had my septum straightened in my thirties."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.02,
      "end_seconds": 246.31,
      "duration_seconds": 5.29,
      "text": "Right, do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 248.06,
      "end_seconds": 249.87,
      "duration_seconds": 1.81,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.64,
      "end_seconds": 273.99,
      "duration_seconds": 23.35,
      "text": "Let me tell you where I've got to. I don't have a clear answer today: a collapsed lung under pressure is possible, and so is a heart attack. Stop me if I've got anything wrong. You've been feeling very faint for four weeks, and no leg swelling or cough."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 275.75,
      "end_seconds": 276.45,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.52,
      "end_seconds": 303.97,
      "duration_seconds": 26.45,
      "text": "I'm going to order a chest X-ray, for chest pain. I'd like to arrange an urgent chest decompression for tension pneumothorax. Stay sitting up, I need to relieve the pressure in your chest right now. Let's get you seen by the emergency team, I'll arrange the letter. I'd like to see you again straight away. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 305.56,
      "end_seconds": 308.69,
      "duration_seconds": 3.13,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.37,
      "end_seconds": 311.64,
      "duration_seconds": 1.27,
      "text": "See you soon."
    }
  ]
}