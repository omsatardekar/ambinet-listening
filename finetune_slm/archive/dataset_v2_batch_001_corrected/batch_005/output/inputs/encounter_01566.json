{
  "schema_version": "1.0",
  "encounter_id": "01566",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.21,
      "end_seconds": 7.3,
      "duration_seconds": 6.09,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.53,
      "end_seconds": 12.73,
      "duration_seconds": 4.2,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.46,
      "end_seconds": 19.74,
      "duration_seconds": 5.28,
      "text": "Mainly I've been passing urine very often. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.44,
      "end_seconds": 24.24,
      "duration_seconds": 2.8,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.94,
      "end_seconds": 27.53,
      "duration_seconds": 2.59,
      "text": "For three days, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.2,
      "end_seconds": 31.57,
      "duration_seconds": 2.37,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.68,
      "end_seconds": 35.71,
      "duration_seconds": 3.03,
      "text": "Pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.79,
      "end_seconds": 42.45,
      "duration_seconds": 5.66,
      "text": "A few quick ones: severe back pain, reduced baby movements or vaginal bleeding?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.83,
      "end_seconds": 52.43,
      "duration_seconds": 8.6,
      "text": "Let me think, I haven't had severe back pain, reduced baby movements or vaginal bleeding, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.06,
      "end_seconds": 56.62,
      "duration_seconds": 2.56,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.65,
      "end_seconds": 59.21,
      "duration_seconds": 1.56,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.89,
      "end_seconds": 63.13,
      "duration_seconds": 3.24,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.66,
      "end_seconds": 65.57,
      "duration_seconds": 1.91,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.86,
      "end_seconds": 83.48,
      "duration_seconds": 1.62,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.38,
      "end_seconds": 91.03,
      "duration_seconds": 5.65,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.96,
      "end_seconds": 93.15,
      "duration_seconds": 1.19,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.02,
      "end_seconds": 98.28,
      "duration_seconds": 3.26,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.3,
      "end_seconds": 100.87,
      "duration_seconds": 1.57,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.39,
      "end_seconds": 104.67,
      "duration_seconds": 2.28,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.23,
      "end_seconds": 106.98,
      "duration_seconds": 1.75,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.1,
      "end_seconds": 111.94,
      "duration_seconds": 3.84,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.76,
      "end_seconds": 115.2,
      "duration_seconds": 1.44,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.67,
      "end_seconds": 120.01,
      "duration_seconds": 3.34,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.4,
      "end_seconds": 133.46,
      "duration_seconds": 4.06,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.75,
      "end_seconds": 137.86,
      "duration_seconds": 3.11,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.21,
      "end_seconds": 157.65,
      "duration_seconds": 3.44,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.46,
      "end_seconds": 161.39,
      "duration_seconds": 2.93,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.34,
      "end_seconds": 164.63,
      "duration_seconds": 1.29,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.29,
      "end_seconds": 168.47,
      "duration_seconds": 3.18,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.16,
      "end_seconds": 184.83,
      "duration_seconds": 2.67,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.65,
      "end_seconds": 186.72,
      "duration_seconds": 1.07,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.62,
      "end_seconds": 191.48,
      "duration_seconds": 2.86,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.22,
      "end_seconds": 206.08,
      "duration_seconds": 2.86,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.05,
      "end_seconds": 230.32,
      "duration_seconds": 7.27,
      "text": "Okay: heart rate 108, blood pressure 123 over 77. And temperature 39.2, oxygen saturation is 98 percent."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.58,
      "end_seconds": 235.54,
      "duration_seconds": 3.96,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.82,
      "end_seconds": 238.09,
      "duration_seconds": 1.27,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.66,
      "end_seconds": 257.17,
      "duration_seconds": 6.51,
      "text": "There is mild tenderness above the pubic bone and no tenderness in the loins."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.79,
      "end_seconds": 274.01,
      "duration_seconds": 11.22,
      "text": "Good, you can sit up again. From what you've told me and what I found, this is probably a urinary infection in pregnancy."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.5,
      "end_seconds": 278.68,
      "duration_seconds": 3.18,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.33,
      "end_seconds": 291.47,
      "duration_seconds": 12.14,
      "text": "It's reasonable to be concerned, but right now a urinary infection in pregnancy is my leading thought, not anything worse. Let's book a urine culture to look into urinary infection."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.25,
      "end_seconds": 294.42,
      "duration_seconds": 1.17,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.13,
      "end_seconds": 321.18,
      "duration_seconds": 25.05,
      "text": "You'll be taking cefalexin, 500 milligrams, twice a day, seven days. It's for urinary infection in pregnancy. Drink plenty of fluids and tell your midwife. Please take the tablets with food so they don't upset your stomach. Come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.14,
      "end_seconds": 324.82,
      "duration_seconds": 1.68,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.53,
      "end_seconds": 333.19,
      "duration_seconds": 6.66,
      "text": "Please come and see me in one week. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.29,
      "end_seconds": 337.89,
      "duration_seconds": 3.6,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.44,
      "end_seconds": 340.61,
      "duration_seconds": 1.17,
      "text": "All the best."
    }
  ]
}