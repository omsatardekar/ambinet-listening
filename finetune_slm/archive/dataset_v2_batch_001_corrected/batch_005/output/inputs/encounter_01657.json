{
  "schema_version": "1.0",
  "encounter_id": "01657",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.92,
      "end_seconds": 4.05,
      "duration_seconds": 3.13,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.85,
      "end_seconds": 9.99,
      "duration_seconds": 4.14,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.04,
      "end_seconds": 15.87,
      "duration_seconds": 3.83,
      "text": "Hmm, doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.49,
      "end_seconds": 20.3,
      "duration_seconds": 2.81,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 21.12,
      "end_seconds": 28.27,
      "duration_seconds": 7.15,
      "text": "Doctor, um, it's been feeling nervous about exertion. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.69,
      "end_seconds": 33.09,
      "duration_seconds": 3.4,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.54,
      "end_seconds": 37.49,
      "duration_seconds": 2.95,
      "text": "It's been about four days now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.24,
      "end_seconds": 42.06,
      "duration_seconds": 2.82,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.48,
      "end_seconds": 49.86,
      "duration_seconds": 6.38,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.83,
      "end_seconds": 56.09,
      "duration_seconds": 5.26,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.1,
      "end_seconds": 63.17,
      "duration_seconds": 5.07,
      "text": "Maybe a eight out of ten on a bad day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.64,
      "end_seconds": 66.48,
      "duration_seconds": 2.84,
      "text": "Hm, okay. Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.24,
      "end_seconds": 73.82,
      "duration_seconds": 6.58,
      "text": "An ache in my chest wall goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.52,
      "end_seconds": 77.26,
      "duration_seconds": 2.74,
      "text": "Has there been a little breathlessness too?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.82,
      "end_seconds": 80.37,
      "duration_seconds": 1.55,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.96,
      "end_seconds": 84.27,
      "duration_seconds": 3.31,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.52,
      "end_seconds": 91.98,
      "duration_seconds": 6.46,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.56,
      "end_seconds": 99.26,
      "duration_seconds": 5.7,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.06,
      "end_seconds": 102.65,
      "duration_seconds": 1.59,
      "text": "It's moderate, honestly."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.25,
      "end_seconds": 105.22,
      "duration_seconds": 1.97,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.15,
      "end_seconds": 112.32,
      "duration_seconds": 5.17,
      "text": "Just my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.51,
      "end_seconds": 117.56,
      "duration_seconds": 4.05,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.26,
      "end_seconds": 126.91,
      "duration_seconds": 8.65,
      "text": "I've had high cholesterol for about ten years now. I have high blood pressure, for nearly five years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.66,
      "end_seconds": 129.91,
      "duration_seconds": 1.25,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.26,
      "end_seconds": 133.64,
      "duration_seconds": 2.38,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.18,
      "end_seconds": 138.13,
      "duration_seconds": 2.95,
      "text": "It's simvastatin, 20 milligrams, at night."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 138.98,
      "end_seconds": 144.01,
      "duration_seconds": 5.03,
      "text": "Doctor, our chart from the last visit lists it as 10 milligrams."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.76,
      "end_seconds": 149.37,
      "duration_seconds": 3.61,
      "text": "Hm. Do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.09,
      "end_seconds": 158.19,
      "duration_seconds": 8.1,
      "text": "Not with me. I'll bring it next time. It's metoprolol, 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 163.46,
      "end_seconds": 171.78,
      "duration_seconds": 8.32,
      "text": "Mm, it's meant to be twice a day, though I don't see he take it every time."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.35,
      "end_seconds": 174.88,
      "duration_seconds": 2.53,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.79,
      "end_seconds": 181.59,
      "duration_seconds": 2.8,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.94,
      "end_seconds": 200.41,
      "duration_seconds": 4.47,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.28,
      "end_seconds": 207.68,
      "duration_seconds": 5.4,
      "text": "My uncle has high cholesterol. My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.57,
      "end_seconds": 214.28,
      "duration_seconds": 1.71,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.93,
      "end_seconds": 216.47,
      "duration_seconds": 1.54,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.97,
      "end_seconds": 218.41,
      "duration_seconds": 1.44,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.33,
      "end_seconds": 222.51,
      "duration_seconds": 3.18,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.63,
      "end_seconds": 227.41,
      "duration_seconds": 3.78,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.57,
      "end_seconds": 231.88,
      "duration_seconds": 3.31,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.86,
      "end_seconds": 236.33,
      "duration_seconds": 2.47,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.23,
      "end_seconds": 242.26,
      "duration_seconds": 4.03,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.26,
      "end_seconds": 261.42,
      "duration_seconds": 2.16,
      "text": "Has there been any palpitations?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.94,
      "end_seconds": 266.38,
      "duration_seconds": 3.44,
      "text": "No, I haven't had any palpitations."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 268.31,
      "end_seconds": 273.8,
      "duration_seconds": 5.49,
      "text": "Actually, doctor, I did notice palpitations. He doesn't always say."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.96,
      "end_seconds": 284.56,
      "duration_seconds": 9.6,
      "text": "Sorry, what was I saying, no, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.84,
      "end_seconds": 294.05,
      "duration_seconds": 8.21,
      "text": "Alright, I'll note both what you've said and what you've noticed. Have you noticed leg swelling or fainting?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.07,
      "end_seconds": 307.65,
      "duration_seconds": 11.58,
      "text": "No, no leg swelling, no fainting. I did have tiredness at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.74,
      "end_seconds": 312.07,
      "duration_seconds": 3.33,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.07,
      "end_seconds": 317.15,
      "duration_seconds": 3.08,
      "text": "Mm, no, that's been fine."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.81,
      "end_seconds": 320.24,
      "duration_seconds": 2.43,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.29,
      "end_seconds": 322.31,
      "duration_seconds": 1.02,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 323.88,
      "end_seconds": 331.75,
      "duration_seconds": 7.87,
      "text": "Here are the numbers, doctor. Respiratory rate 15, pulse 77, BP is 114 over 70. Temperature 36.9."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.17,
      "end_seconds": 334.08,
      "duration_seconds": 0.91,
      "text": "Okay, thanks."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.71,
      "end_seconds": 338.72,
      "duration_seconds": 2.01,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.27,
      "end_seconds": 339.97,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.29,
      "end_seconds": 342.95,
      "duration_seconds": 1.66,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.18,
      "end_seconds": 367.06,
      "duration_seconds": 5.88,
      "text": "Your heart rate and rhythm are regular and the breastbone wound has healed."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.76,
      "end_seconds": 383.26,
      "duration_seconds": 11.5,
      "text": "Good, you can sit up again. So where does that leave us? It fits best with recovering well after a heart attack. Anxiety is also on my list."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 386.6,
      "end_seconds": 388.55,
      "duration_seconds": 1.95,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 390.32,
      "end_seconds": 405.6,
      "duration_seconds": 15.28,
      "text": "I can't promise yet, but most people with recovering well after a heart attack do well once it's treated properly. So, to recap quickly. You've been feeling nervous about exertion for about four days, and no fainting."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 407.05,
      "end_seconds": 407.75,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 409.62,
      "end_seconds": 416.02,
      "duration_seconds": 6.4,
      "text": "Doctor, I did an ECG before they came in, the result's on your screen."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 418.05,
      "end_seconds": 424.35,
      "duration_seconds": 6.3,
      "text": "Great, that's useful. I'd like to arrange a cholesterol test for secondary prevention."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 425.78,
      "end_seconds": 428.37,
      "duration_seconds": 2.59,
      "text": "The earliest is Monday, 2 pm."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 429.66,
      "end_seconds": 444.4,
      "duration_seconds": 14.74,
      "text": "Start the rehabilitation classes and build up walking gradually. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. We'll refer you to the cardiac rehabilitation team."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 445.54,
      "end_seconds": 448.46,
      "duration_seconds": 2.92,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 450.09,
      "end_seconds": 459.67,
      "duration_seconds": 9.58,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 460.42,
      "end_seconds": 463.77,
      "duration_seconds": 3.35,
      "text": "Okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 465.0,
      "end_seconds": 467.53,
      "duration_seconds": 2.53,
      "text": "See me again in three months."
    },
    {
      "segment_id": "SEG0071",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 468.49,
      "end_seconds": 472.45,
      "duration_seconds": 3.96,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0072",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 473.08,
      "end_seconds": 476.21,
      "duration_seconds": 3.13,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0073",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 477.2,
      "end_seconds": 480.35,
      "duration_seconds": 3.15,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}