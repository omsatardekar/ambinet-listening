{
  "schema_version": "1.0",
  "encounter_id": "01926",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.8,
      "end_seconds": 7.1,
      "duration_seconds": 6.3,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.64,
      "end_seconds": 12.4,
      "duration_seconds": 3.76,
      "text": "yes, have a seat tell me what's going on"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.24,
      "end_seconds": 32.08,
      "duration_seconds": 13.84,
      "text": "Mainly being extremely thirsty. There's a couple of other things, you know, but that's the main one. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.64,
      "end_seconds": 35.76,
      "duration_seconds": 3.12,
      "text": "has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.3,
      "end_seconds": 40.02,
      "duration_seconds": 2.72,
      "text": "it's been about a month now"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.2,
      "end_seconds": 46.92,
      "duration_seconds": 2.72,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.61,
      "end_seconds": 57.12,
      "duration_seconds": 4.51,
      "text": "well, a six out of ten, I suppose"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.63,
      "end_seconds": 61.01,
      "duration_seconds": 2.38,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.37,
      "end_seconds": 86.15,
      "duration_seconds": 23.78,
      "text": "Being confused and drowsy goes along with it, you know, most of the time. Yeah, the Being confused and drowsy? That's been since yesterday. Erm, about Being confused and drowsy, I'd say mild. And, And weakness, too. I'd been passing huge amounts of urine, but that that went away."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.75,
      "end_seconds": 90.88,
      "duration_seconds": 4.13,
      "text": "So, a few quick ones: fever, vomiting or chest pain?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.54,
      "end_seconds": 96.3,
      "duration_seconds": 4.76,
      "text": "ah, no, I haven't had any of them"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.1,
      "end_seconds": 101.4,
      "duration_seconds": 3.3,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.31,
      "end_seconds": 106.5,
      "duration_seconds": 3.19,
      "text": "Uh, no, joints are fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.22,
      "end_seconds": 111.08,
      "duration_seconds": 3.86,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.54,
      "end_seconds": 126.86,
      "duration_seconds": 14.32,
      "text": "I have diabetes. A neighbour of mine said I should see someone about it. I've got arthritis in my knees. I've got low haemoglobin. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.19,
      "end_seconds": 138.59,
      "duration_seconds": 2.4,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.53,
      "end_seconds": 142.17,
      "duration_seconds": 1.64,
      "text": "no surgery, no"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.06,
      "end_seconds": 148.17,
      "duration_seconds": 4.11,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.03,
      "end_seconds": 160.13,
      "duration_seconds": 10.1,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.66,
      "end_seconds": 166.04,
      "duration_seconds": 2.38,
      "text": "what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.73,
      "end_seconds": 179.91,
      "duration_seconds": 13.18,
      "text": "Well, I'm on metformin, 500 milligrams, twice a day. I'm, I'm on naproxen, 250 milligrams, maybe, twice a day for the knee pain."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.75,
      "end_seconds": 184.8,
      "duration_seconds": 4.05,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.59,
      "end_seconds": 188.52,
      "duration_seconds": 1.93,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.82,
      "end_seconds": 191.27,
      "duration_seconds": 1.45,
      "text": "what's your work?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.81,
      "end_seconds": 197.25,
      "duration_seconds": 4.44,
      "text": "I'm a plumber, lots of bending and kneeling"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.37,
      "end_seconds": 200.08,
      "duration_seconds": 1.71,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.35,
      "end_seconds": 205.24,
      "duration_seconds": 3.89,
      "text": "I hardly move around during the day"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.01,
      "end_seconds": 208.44,
      "duration_seconds": 2.43,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.37,
      "end_seconds": 220.79,
      "duration_seconds": 2.42,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.24,
      "end_seconds": 241.45,
      "duration_seconds": 9.21,
      "text": "Okay: SpO2 96 percent on room air, temp 36.8 degrees, BP is 119 over 78, pulse 121."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.92,
      "end_seconds": 248.14,
      "duration_seconds": 4.22,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.08,
      "end_seconds": 251.74,
      "duration_seconds": 1.66,
      "text": "let me feel here"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.97,
      "end_seconds": 274.0,
      "duration_seconds": 7.03,
      "text": "You are very dry and and drowsy, and your sugar reading is too high to read."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.65,
      "end_seconds": 280.43,
      "duration_seconds": 2.78,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.2,
      "end_seconds": 302.98,
      "duration_seconds": 10.78,
      "text": "Right, here's what I'm thinking. I'm honestly not certain yet. It could be a hyperosmolar diabetic emergency, or it might be sepsis."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.88,
      "end_seconds": 308.65,
      "duration_seconds": 3.77,
      "text": "Uh, what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.46,
      "end_seconds": 322.15,
      "duration_seconds": 11.69,
      "text": "I understand the worry. At the moment I'd say it's a hyperosmolar diabetic emergency, and we'll know more once the urgent blood tests is back"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.23,
      "end_seconds": 340.5,
      "duration_seconds": 10.27,
      "text": "I think urgent blood tests makes sense here, for hyperglycaemic emergency. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.05,
      "end_seconds": 348.95,
      "duration_seconds": 2.9,
      "text": "oh, okay, I'll do it"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.8,
      "end_seconds": 367.5,
      "duration_seconds": 17.7,
      "text": "I'm sending you for an ECG because of hyperglycaemic emergency. You need hospital now for fluids and insulin. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 368.42,
      "end_seconds": 369.91,
      "duration_seconds": 1.49,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.21,
      "end_seconds": 374.75,
      "duration_seconds": 3.54,
      "text": "I'd like to see you again straight away."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 376.53,
      "end_seconds": 379.33,
      "duration_seconds": 2.8,
      "text": "Yeah, that's fine with me."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.57,
      "end_seconds": 385.59,
      "duration_seconds": 5.02,
      "text": "right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 386.23,
      "end_seconds": 387.76,
      "duration_seconds": 1.53,
      "text": "that's clear, thanks"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 389.7,
      "end_seconds": 391.0,
      "duration_seconds": 1.3,
      "text": "All the best."
    }
  ]
}