  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.84,
      "end_seconds": 4.95,
      "duration_seconds": 4.11,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.79,
      "end_seconds": 10.46,
      "duration_seconds": 3.67,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.8,
      "end_seconds": 25.01,
      "duration_seconds": 13.21,
      "text": "I mean, mainly a fall and pain in my left hip. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.81,
      "end_seconds": 33.91,
      "duration_seconds": 7.1,
      "text": "Has this been going on for long? I ask because it it helps me narrow things down."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.35,
      "end_seconds": 43.95,
      "duration_seconds": 8.6,
      "text": "it's been like this since last weekend i'd rather know what's going on than keep guessing"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.85,
      "end_seconds": 48.31,
      "duration_seconds": 2.46,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.11,
      "end_seconds": 57.32,
      "duration_seconds": 8.21,
      "text": "pretty moderate, if I'm being honest so, there's pain in my groin as well"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.27,
      "end_seconds": 67.68,
      "duration_seconds": 8.41,
      "text": "Have you had a a fall and pain in your left hip before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.85,
      "end_seconds": 75.75,
      "duration_seconds": 6.9,
      "text": "Actually, I had a a similar thing last winter. It went away."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.15,
      "end_seconds": 82.53,
      "duration_seconds": 5.38,
      "text": "Have you had any loss of consciousness, numbness, chest pain or head injury?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.16,
      "end_seconds": 89.64,
      "duration_seconds": 6.48,
      "text": "No, no loss of consciousness, numbness, chest pain or head injury."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.44,
      "end_seconds": 96.12,
      "duration_seconds": 5.68,
      "text": "so, have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.66,
      "end_seconds": 99.29,
      "duration_seconds": 1.63,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.68,
      "end_seconds": 112.46,
      "duration_seconds": 2.78,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.77,
      "end_seconds": 124.31,
      "duration_seconds": 8.54,
      "text": "Sorry, uh, what was I saying, I have thin bones, for about a year."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.47,
      "end_seconds": 137.3,
      "duration_seconds": 8.83,
      "text": "Right, so thin bones is already on your record. We'll keep that in mind today. Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.19,
      "end_seconds": 139.89,
      "duration_seconds": 1.7,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.31,
      "end_seconds": 150.35,
      "duration_seconds": 2.04,
      "text": "let's run through your medicines"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.79,
      "end_seconds": 155.14,
      "duration_seconds": 3.35,
      "text": "it's paracetamol, 1 gram, when needed"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.81,
      "end_seconds": 161.74,
      "duration_seconds": 2.93,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.6,
      "end_seconds": 166.63,
      "duration_seconds": 3.03,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.51,
      "end_seconds": 183.87,
      "duration_seconds": 2.36,
      "text": "Now some background about your lifestyle"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.4,
      "end_seconds": 209.14,
      "duration_seconds": 23.74,
      "text": "No, I've never smoked in my life. I'll have a glass of wine with dinner. Not much, I mostly stay in these days. I drink a lot of tea and snack through the day. I live with my elderly mother"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.97,
      "end_seconds": 213.88,
      "duration_seconds": 3.91,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.76,
      "end_seconds": 218.94,
      "duration_seconds": 3.18,
      "text": "no, not that I know of"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.87,
      "end_seconds": 223.48,
      "duration_seconds": 2.61,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.24,
      "end_seconds": 234.61,
      "duration_seconds": 2.37,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.16,
      "end_seconds": 264.63,
      "duration_seconds": 10.47,
      "text": "Okay: respiratory rate 15, saturation 99 percent, pressure 116 over 68, temp 37.0 degrees, pulse is 80 beats a a minute."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.65,
      "end_seconds": 268.49,
      "duration_seconds": 1.84,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.93,
      "end_seconds": 288.7,
      "duration_seconds": 18.77,
      "text": "they help me see the whole picture, more shortly let me tell you where I've got to i think we're dealing with a probable hip fracture at this stage i'm going to order an X-ray of the hip, for hip fracture"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 289.41,
      "end_seconds": 293.38,
      "duration_seconds": 3.97,
      "text": "I can book that for Wednesday at 2 pm."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.03,
      "end_seconds": 298.45,
      "duration_seconds": 4.42,
      "text": "Right, you know, okay, I'll be there."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.12,
      "end_seconds": 319.89,
      "duration_seconds": 20.77,
      "text": "we should do blood tests for pre-operative i'd like you to take morphine, 2.5 milligrams, now, single dose that's for hip pain lie still, I am arranging an ambulance and pain relief let's get you seen by the orthopaedic team, I'll arrange the letter"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.2,
      "end_seconds": 323.17,
      "duration_seconds": 1.97,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.8,
      "end_seconds": 326.17,
      "duration_seconds": 2.37,
      "text": "See me again straight away."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.81,
      "end_seconds": 329.1,
      "duration_seconds": 2.29,
      "text": "Alright, I'll be back."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.07,
      "end_seconds": 337.37,
      "duration_seconds": 7.3,
      "text": "can you tell me the plan back in your own words, so I know I've explained it clearly?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.62,
      "end_seconds": 351.73,
      "duration_seconds": 10.11,
      "text": "So, uh, I take the morphine, 2.5 milligrams, now and come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.51,
      "end_seconds": 359.66,
      "duration_seconds": 6.15,
      "text": "Right, yes, exactly right. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 363.65,
      "end_seconds": 366.84,
      "duration_seconds": 3.19,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.89,
      "end_seconds": 369.32,
      "duration_seconds": 1.43,
      "text": "All the best."
    }
  ]
