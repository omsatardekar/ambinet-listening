{
  "schema_version": "1.0",
  "encounter_id": "01885",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.84,
      "end_seconds": 3.1,
      "duration_seconds": 2.26,
      "text": "Afternoon, thanks for coming in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.57,
      "end_seconds": 8.13,
      "duration_seconds": 3.56,
      "text": "Morning, doctor, sorry about the rush."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.95,
      "end_seconds": 10.41,
      "duration_seconds": 1.46,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.16,
      "end_seconds": 18.53,
      "duration_seconds": 7.37,
      "text": "Yeah, um, I'm here because of aching muscles in my thighs."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.35,
      "end_seconds": 21.01,
      "duration_seconds": 1.66,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.57,
      "end_seconds": 29.18,
      "duration_seconds": 4.61,
      "text": "Let me think, ever since... since this morning, really."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.97,
      "end_seconds": 34.85,
      "duration_seconds": 4.88,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.28,
      "end_seconds": 48.33,
      "duration_seconds": 12.05,
      "text": "I'd give it a seven, out of ten. It settles a little with rest. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 49.7,
      "end_seconds": 52.98,
      "duration_seconds": 3.28,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 54.34,
      "end_seconds": 60.19,
      "duration_seconds": 5.85,
      "text": "Muscle weakness goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.08,
      "end_seconds": 64.96,
      "duration_seconds": 3.88,
      "text": "What about dark urine once, have you noticed that?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.19,
      "end_seconds": 72.09,
      "duration_seconds": 5.9,
      "text": "Mm, yes. Yeah, as for muscle weakness, mostly moderate."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.03,
      "end_seconds": 78.71,
      "duration_seconds": 3.68,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.35,
      "end_seconds": 82.88,
      "duration_seconds": 2.53,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.96,
      "end_seconds": 105.33,
      "duration_seconds": 4.37,
      "text": "The thigh muscles are tender and the strength is slightly reduced."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.87,
      "end_seconds": 111.13,
      "duration_seconds": 2.26,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.4,
      "end_seconds": 130.61,
      "duration_seconds": 4.21,
      "text": "Have you noticed fever, chest pain, joint swelling or rash?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.74,
      "end_seconds": 136.58,
      "duration_seconds": 4.84,
      "text": "Erm, no, I haven't had any of them."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.71,
      "end_seconds": 146.17,
      "duration_seconds": 4.46,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.17,
      "end_seconds": 151.81,
      "duration_seconds": 3.64,
      "text": "I mean, bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.46,
      "end_seconds": 156.82,
      "duration_seconds": 4.36,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.17,
      "end_seconds": 169.85,
      "duration_seconds": 11.68,
      "text": "I, I have high cholesterol. I took the morning off to come in today. Um, I've had anxiety, yes."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.75,
      "end_seconds": 173.56,
      "duration_seconds": 0.81,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 174.98,
      "end_seconds": 179.77,
      "duration_seconds": 4.79,
      "text": "Right, I've had asthma for about a year now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.7,
      "end_seconds": 184.58,
      "duration_seconds": 3.88,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 185.3,
      "end_seconds": 189.15,
      "duration_seconds": 3.85,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.98,
      "end_seconds": 193.19,
      "duration_seconds": 2.21,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 195.27,
      "end_seconds": 199.99,
      "duration_seconds": 4.72,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.84,
      "end_seconds": 203.29,
      "duration_seconds": 1.45,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 204.07,
      "end_seconds": 208.41,
      "duration_seconds": 4.34,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.33,
      "end_seconds": 211.59,
      "duration_seconds": 2.26,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 216.98,
      "end_seconds": 235.46,
      "duration_seconds": 18.48,
      "text": "Sorry, what was I saying, I'm on rosuvastatin, 10 milligrams, at night. Yeah, I'm supposed to take it regularly, but I don't always manage. Escitalopram. I take it 10 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.41,
      "end_seconds": 241.27,
      "duration_seconds": 4.86,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 241.83,
      "end_seconds": 255.25,
      "duration_seconds": 13.42,
      "text": "Not with me. I'll bring it next time. Asthalin inhaler. I take it when needed. It's, It's paracetamol, 1 gram, when needed."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.2,
      "end_seconds": 272.11,
      "duration_seconds": 2.91,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 273.22,
      "end_seconds": 279.71,
      "duration_seconds": 6.49,
      "text": "Sorry, you know, what was I saying, no, not at all."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 280.98,
      "end_seconds": 285.64,
      "duration_seconds": 4.66,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 287.38,
      "end_seconds": 299.06,
      "duration_seconds": 11.68,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.73,
      "end_seconds": 321.1,
      "duration_seconds": 21.37,
      "text": "Right, here's what I'm thinking. My working impression is muscle symptoms possibly from the cholesterol tablet. Another possibility is low vitamin D. Let me just check I've got this right. You've had aching muscles in your thighs, since this morning, and no fever or rash."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 322.44,
      "end_seconds": 325.22,
      "duration_seconds": 2.78,
      "text": "That's it, uh, yes."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 332.24,
      "end_seconds": 341.89,
      "duration_seconds": 9.65,
      "text": "Let's book a thyroid test to look into muscle aches. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 343.84,
      "end_seconds": 347.67,
      "duration_seconds": 3.83,
      "text": "I can book that for Tuesday at 10 am."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 349.21,
      "end_seconds": 350.3,
      "duration_seconds": 1.09,
      "text": "That's fine."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 352.21,
      "end_seconds": 376.09,
      "duration_seconds": 23.88,
      "text": "I think a vitamin D level makes sense here, for muscle aches. We will pause the statin for a few weeks while we check the blood tests. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. See me again after the results."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 377.48,
      "end_seconds": 381.3,
      "duration_seconds": 3.82,
      "text": "Let me think, alright, I'll be back."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 382.84,
      "end_seconds": 385.26,
      "duration_seconds": 2.42,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 387.11,
      "end_seconds": 391.98,
      "duration_seconds": 4.87,
      "text": "Okay, you know, that makes sense. Thanks for explaining."
    }
  ]
}