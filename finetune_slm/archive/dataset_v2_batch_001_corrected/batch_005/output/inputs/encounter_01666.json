{
  "schema_version": "1.0",
  "encounter_id": "01666",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.2,
      "end_seconds": 2.92,
      "duration_seconds": 1.72,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.97,
      "end_seconds": 8.08,
      "duration_seconds": 4.11,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.52,
      "end_seconds": 16.2,
      "duration_seconds": 6.68,
      "text": "Doctor, it's shaky spells in the afternoon. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.63,
      "end_seconds": 31.36,
      "duration_seconds": 3.73,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.95,
      "end_seconds": 39.54,
      "duration_seconds": 2.59,
      "text": "Probably about a week. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.37,
      "end_seconds": 48.4,
      "duration_seconds": 8.03,
      "text": "can you describe it a bit more for me? How strong it is, what the pattern is, what helps"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.0,
      "end_seconds": 54.94,
      "duration_seconds": 4.94,
      "text": "It's worse with missed lunch. It settles a little with sweets."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.05,
      "end_seconds": 57.37,
      "duration_seconds": 1.32,
      "text": "What about vomiting?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.22,
      "end_seconds": 62.4,
      "duration_seconds": 3.18,
      "text": "Not that I've noticed, no vomiting."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.37,
      "end_seconds": 69.02,
      "duration_seconds": 4.65,
      "text": "and what about seizure, chest pain or loss of consciousness?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.6,
      "end_seconds": 76.68,
      "duration_seconds": 6.08,
      "text": "No seizure, chest pain or loss of consciousness, none of it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.45,
      "end_seconds": 82.44,
      "duration_seconds": 3.99,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.08,
      "end_seconds": 85.8,
      "duration_seconds": 2.72,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.24,
      "end_seconds": 90.27,
      "duration_seconds": 3.03,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.18,
      "end_seconds": 94.77,
      "duration_seconds": 2.59,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.48,
      "end_seconds": 113.57,
      "duration_seconds": 6.09,
      "text": "have you got any known allergies? I'll explain everything as we go along"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.68,
      "end_seconds": 116.52,
      "duration_seconds": 1.84,
      "text": "no allergies at all"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.39,
      "end_seconds": 121.38,
      "duration_seconds": 2.99,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.03,
      "end_seconds": 124.26,
      "duration_seconds": 1.23,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.65,
      "end_seconds": 146.31,
      "duration_seconds": 4.66,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.13,
      "end_seconds": 149.85,
      "duration_seconds": 1.72,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.39,
      "end_seconds": 153.28,
      "duration_seconds": 2.89,
      "text": "are you in work at the moment?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.27,
      "end_seconds": 158.75,
      "duration_seconds": 4.48,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.67,
      "end_seconds": 162.37,
      "duration_seconds": 1.7,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.98,
      "end_seconds": 168.2,
      "duration_seconds": 4.22,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.15,
      "end_seconds": 189.01,
      "duration_seconds": 2.86,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.05,
      "end_seconds": 194.3,
      "duration_seconds": 3.25,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.95,
      "end_seconds": 202.01,
      "duration_seconds": 5.06,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.87,
      "end_seconds": 205.62,
      "duration_seconds": 2.75,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.77,
      "end_seconds": 231.11,
      "duration_seconds": 8.34,
      "text": "Your sugar reading in clinic is on the low side and your pulse is a little fast."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.69,
      "end_seconds": 252.78,
      "duration_seconds": 16.09,
      "text": "okay, that's enough for me. Putting it all together, I'm honestly not certain yet. It could be recurrent low blood sugar on insulin, or it might be a dose that is too high"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.02,
      "end_seconds": 255.87,
      "duration_seconds": 1.85,
      "text": "will it clear up?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.32,
      "end_seconds": 291.81,
      "duration_seconds": 34.49,
      "text": "I can't promise yet, but most people with recurrent low blood sugar on insulin do well once it's treated properly. I'll request a download of the glucose meter, it'll help with hypoglycaemia. The result will help us decide whether anything more is needed. I'm going to put you on insulin glargine, 16 units, once a day at bedtime, long term. That's for diabetes. Always carry sugar and eat something before exercise."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.74,
      "end_seconds": 305.12,
      "duration_seconds": 12.38,
      "text": "I'd like to see you again in two weeks. Can you tell me the plan back in your own words, so I know I've explained it clearly?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.76,
      "end_seconds": 319.7,
      "duration_seconds": 10.94,
      "text": "So, I take the insulin glargine, 16 units, once a day at bedtime and come back in two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.37,
      "end_seconds": 327.31,
      "duration_seconds": 5.94,
      "text": "Yes, exactly right. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.02,
      "end_seconds": 331.77,
      "duration_seconds": 2.75,
      "text": "I think I understand everything. Thanks."
    }
  ]
}