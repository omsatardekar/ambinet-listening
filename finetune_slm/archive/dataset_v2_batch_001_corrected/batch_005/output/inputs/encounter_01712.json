{
  "schema_version": "1.0",
  "encounter_id": "01712",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.67,
      "end_seconds": 4.53,
      "duration_seconds": 3.86,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.7,
      "end_seconds": 10.95,
      "duration_seconds": 5.25,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.86,
      "end_seconds": 20.65,
      "duration_seconds": 7.79,
      "text": "It's the worst headache of my life. I thought I'd wait, uh, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.57,
      "end_seconds": 24.84,
      "duration_seconds": 2.27,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.18,
      "end_seconds": 38.34,
      "duration_seconds": 12.16,
      "text": "Probably about a month. Yeah. I just want to get back to normal, really. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.22,
      "end_seconds": 41.99,
      "duration_seconds": 2.77,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.77,
      "end_seconds": 50.14,
      "duration_seconds": 6.37,
      "text": "I'd call it moderate. I had vomiting before. That's settled now, though."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.78,
      "end_seconds": 55.19,
      "duration_seconds": 3.41,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.7,
      "end_seconds": 61.58,
      "duration_seconds": 4.88,
      "text": "Okay, so I don't think I have any, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.72,
      "end_seconds": 67.16,
      "duration_seconds": 4.44,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.77,
      "end_seconds": 71.36,
      "duration_seconds": 2.59,
      "text": "My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.78,
      "end_seconds": 91.22,
      "duration_seconds": 1.44,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.26,
      "end_seconds": 96.05,
      "duration_seconds": 2.79,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.81,
      "end_seconds": 102.21,
      "duration_seconds": 4.4,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.85,
      "end_seconds": 106.79,
      "duration_seconds": 3.94,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.78,
      "end_seconds": 110.51,
      "duration_seconds": 2.73,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.05,
      "end_seconds": 115.8,
      "duration_seconds": 3.75,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.56,
      "end_seconds": 119.83,
      "duration_seconds": 2.27,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.2,
      "end_seconds": 125.56,
      "duration_seconds": 4.36,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.24,
      "end_seconds": 134.6,
      "duration_seconds": 8.36,
      "text": "Do you take any prescribed or over-the-counter medicines? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.05,
      "end_seconds": 140.29,
      "duration_seconds": 4.24,
      "text": "Propranolol. I take it 40 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.81,
      "end_seconds": 161.26,
      "duration_seconds": 2.45,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.89,
      "end_seconds": 165.18,
      "duration_seconds": 3.29,
      "text": "I've had migraines for five years now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.16,
      "end_seconds": 172.51,
      "duration_seconds": 5.35,
      "text": "Let me check a few things. Any weakness, fever or head injury?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.07,
      "end_seconds": 176.87,
      "duration_seconds": 2.8,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.4,
      "end_seconds": 182.47,
      "duration_seconds": 4.07,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.95,
      "end_seconds": 186.6,
      "duration_seconds": 2.65,
      "text": "Actually, no, that's been fine."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.76,
      "end_seconds": 190.22,
      "duration_seconds": 2.46,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.22,
      "end_seconds": 196.35,
      "duration_seconds": 5.13,
      "text": "Okay, so that's normal as far as I know."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.08,
      "end_seconds": 199.55,
      "duration_seconds": 2.47,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.92,
      "end_seconds": 214.29,
      "duration_seconds": 2.37,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.38,
      "end_seconds": 231.61,
      "duration_seconds": 5.23,
      "text": "Okay: temp 36.9 degrees, heart rate 91, pressure 156 over 95."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.03,
      "end_seconds": 235.08,
      "duration_seconds": 2.05,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.98,
      "end_seconds": 239.67,
      "duration_seconds": 2.69,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.88,
      "end_seconds": 245.91,
      "duration_seconds": 4.03,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.73,
      "end_seconds": 248.73,
      "duration_seconds": 2.0,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.84,
      "end_seconds": 268.14,
      "duration_seconds": 5.3,
      "text": "Your neck is stiff and you are very sensitive to light."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.87,
      "end_seconds": 272.54,
      "duration_seconds": 1.67,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.42,
      "end_seconds": 292.94,
      "duration_seconds": 9.52,
      "text": "So, based on the history and the examination, the most likely explanation is a possible bleed around the brain."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.69,
      "end_seconds": 297.45,
      "duration_seconds": 3.76,
      "text": "Actually, is there something to worry about?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.46,
      "end_seconds": 314.32,
      "duration_seconds": 15.86,
      "text": "Nothing I've seen today points to an emergency. It looks like a possible bleed around the brain, but I'd like to confirm. I'll request an urgent CT scan of the head, it'll help with thunderclap headache."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.32,
      "end_seconds": 318.71,
      "duration_seconds": 2.39,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.52,
      "end_seconds": 334.91,
      "duration_seconds": 15.39,
      "text": "I'll request a lumbar puncture, it'll help with thunderclap headache. This needs an emergency scan, an ambulance is on its way. We'll catch up straight away. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.58,
      "end_seconds": 340.02,
      "duration_seconds": 3.44,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.84,
      "end_seconds": 343.03,
      "duration_seconds": 1.19,
      "text": "See you soon."
    }
  ]
}