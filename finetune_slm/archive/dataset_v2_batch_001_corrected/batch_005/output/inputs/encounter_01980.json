      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.18,
      "end_seconds": 168.63,
      "duration_seconds": 2.45,
      "text": "have you got any known allergies?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.56,
      "end_seconds": 179.52,
      "duration_seconds": 8.96,
      "text": "Oh, years back I got a rash from erythromycin, so I stay away from it now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.79,
      "end_seconds": 183.39,
      "duration_seconds": 2.6,
      "text": "Let's start with the basic checks."
