    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.89,
      "end_seconds": 195.69,
      "duration_seconds": 2.8,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.83,
      "end_seconds": 218.87,
      "duration_seconds": 10.04,
      "text": "Okay: saturation 98 percent, temperature 36.6, height 152 centimetres, weight 97 kilos, pulse is 67 beats a minute, BP is 117 over 75."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 220.46,
      "end_seconds": 221.84,
      "duration_seconds": 1.38,
      "text": "Is that normal?"
