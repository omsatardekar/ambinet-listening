{
  "schema_version": "1.0",
  "encounter_id": "01643",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.5,
      "end_seconds": 4.37,
      "duration_seconds": 3.87,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.0,
      "end_seconds": 9.33,
      "duration_seconds": 4.33,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.94,
      "end_seconds": 15.3,
      "duration_seconds": 5.36,
      "text": "I've been dealing with a fall and pain in my left hip."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.99,
      "end_seconds": 20.53,
      "duration_seconds": 3.54,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.39,
      "end_seconds": 24.87,
      "duration_seconds": 2.48,
      "text": "For two days, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.31,
      "end_seconds": 28.51,
      "duration_seconds": 2.2,
      "text": "Alright, what brings it on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.28,
      "end_seconds": 32.0,
      "duration_seconds": 2.72,
      "text": "I notice it more with moving."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.62,
      "end_seconds": 37.05,
      "duration_seconds": 4.43,
      "text": "A few quick ones: chest pain, numbness or loss of consciousness?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.3,
      "end_seconds": 42.69,
      "duration_seconds": 4.39,
      "text": "Right, no, I haven't had any of them."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.94,
      "end_seconds": 48.46,
      "duration_seconds": 4.52,
      "text": "Okay, any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.11,
      "end_seconds": 51.06,
      "duration_seconds": 1.95,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.8,
      "end_seconds": 74.69,
      "duration_seconds": 4.89,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.04,
      "end_seconds": 79.09,
      "duration_seconds": 3.05,
      "text": "No, you know, nothing at all."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.96,
      "end_seconds": 83.0,
      "duration_seconds": 2.04,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.93,
      "end_seconds": 90.97,
      "duration_seconds": 6.04,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.18,
      "end_seconds": 94.16,
      "duration_seconds": 1.98,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.7,
      "end_seconds": 98.03,
      "duration_seconds": 2.33,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.21,
      "end_seconds": 101.94,
      "duration_seconds": 2.73,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.37,
      "end_seconds": 106.27,
      "duration_seconds": 2.9,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.9,
      "end_seconds": 109.56,
      "duration_seconds": 2.66,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.2,
      "end_seconds": 111.91,
      "duration_seconds": 1.71,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.5,
      "end_seconds": 118.59,
      "duration_seconds": 5.09,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.12,
      "end_seconds": 123.13,
      "duration_seconds": 3.01,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.71,
      "end_seconds": 134.53,
      "duration_seconds": 2.82,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.66,
      "end_seconds": 138.47,
      "duration_seconds": 2.81,
      "text": "Okay, so my son has asthma."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.72,
      "end_seconds": 149.57,
      "duration_seconds": 2.85,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.78,
      "end_seconds": 160.92,
      "duration_seconds": 2.14,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.42,
      "end_seconds": 191.53,
      "duration_seconds": 10.11,
      "text": "Okay: saturation 99 percent, pulse is 86 beats a minute. And BP is 112 over 79, temperature 36.6, respiratory rate 18."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.32,
      "end_seconds": 198.66,
      "duration_seconds": 4.34,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.82,
      "end_seconds": 215.51,
      "duration_seconds": 1.69,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.59,
      "end_seconds": 220.03,
      "duration_seconds": 3.44,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.33,
      "end_seconds": 240.56,
      "duration_seconds": 6.23,
      "text": "The left leg is shortened and turned outwards, and it is very painful to move."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.86,
      "end_seconds": 257.72,
      "duration_seconds": 11.86,
      "text": "Please sit back down. So, based on the history and the examination, I can't pin this down yet. We're looking at a probable hip fracture or a pelvic fracture."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.04,
      "end_seconds": 262.04,
      "duration_seconds": 3.0,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.19,
      "end_seconds": 285.95,
      "duration_seconds": 22.76,
      "text": "It's reasonable to be concerned, but right now a probable hip fracture is my leading thought, not anything worse. I'm going to order an X-ray of the hip, for hip fracture. I'll start you on morphine, 2.5 milligrams, now, single dose. It's for hip pain. Lie still, I am arranging an ambulance and pain relief."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.41,
      "end_seconds": 290.46,
      "duration_seconds": 4.05,
      "text": "Mm-hmm. I'll also refer you to the orthopaedic team."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.45,
      "end_seconds": 294.98,
      "duration_seconds": 2.53,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.29,
      "end_seconds": 311.02,
      "duration_seconds": 14.73,
      "text": "Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. Let's plan a check straight away. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.96,
      "end_seconds": 314.96,
      "duration_seconds": 3.0,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.52,
      "end_seconds": 317.75,
      "duration_seconds": 1.23,
      "text": "Take care now."
    }
  ]
}