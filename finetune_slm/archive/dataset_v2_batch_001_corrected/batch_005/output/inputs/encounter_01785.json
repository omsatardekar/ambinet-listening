{
  "schema_version": "1.0",
  "encounter_id": "01785",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.29,
      "end_seconds": 6.65,
      "duration_seconds": 5.36,
      "text": "Uh, hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.24,
      "end_seconds": 11.09,
      "duration_seconds": 3.85,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.36,
      "end_seconds": 20.73,
      "duration_seconds": 8.37,
      "text": "It's pulling at the ear. I thought I'd wait, you know, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.33,
      "end_seconds": 25.19,
      "duration_seconds": 2.86,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.72,
      "end_seconds": 29.67,
      "duration_seconds": 2.95,
      "text": "Since Monday, that's when it began."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.9,
      "end_seconds": 44.3,
      "duration_seconds": 4.4,
      "text": "And what about discharge, swelling behind the ear or hearing loss?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.77,
      "end_seconds": 48.7,
      "duration_seconds": 2.93,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.2,
      "end_seconds": 52.22,
      "duration_seconds": 2.02,
      "text": "Any sign of stiff neck?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.62,
      "end_seconds": 58.23,
      "duration_seconds": 4.61,
      "text": "No, you know, I haven't had any stiff neck."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.32,
      "end_seconds": 64.78,
      "duration_seconds": 3.46,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.72,
      "end_seconds": 68.58,
      "duration_seconds": 1.86,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.6,
      "end_seconds": 73.22,
      "duration_seconds": 3.62,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.84,
      "end_seconds": 76.92,
      "duration_seconds": 3.08,
      "text": "No, um, that's all normal."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.6,
      "end_seconds": 84.87,
      "duration_seconds": 6.27,
      "text": "What's on your current medicine list? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.46,
      "end_seconds": 95.39,
      "duration_seconds": 8.93,
      "text": "It's lisinopril, 10 milligrams, once a day. Mm, I take paracetamol syrup, 5 ml, every six hours."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.37,
      "end_seconds": 101.08,
      "duration_seconds": 3.71,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.88,
      "end_seconds": 105.53,
      "duration_seconds": 2.65,
      "text": "I have high blood pressure."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.35,
      "end_seconds": 109.85,
      "duration_seconds": 2.5,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.27,
      "end_seconds": 112.41,
      "duration_seconds": 1.14,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.37,
      "end_seconds": 132.77,
      "duration_seconds": 4.4,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.37,
      "end_seconds": 136.25,
      "duration_seconds": 2.88,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.29,
      "end_seconds": 155.47,
      "duration_seconds": 1.18,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.77,
      "end_seconds": 160.62,
      "duration_seconds": 3.85,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.72,
      "end_seconds": 163.12,
      "duration_seconds": 1.4,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.45,
      "end_seconds": 167.71,
      "duration_seconds": 3.26,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.32,
      "end_seconds": 169.97,
      "duration_seconds": 1.65,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.25,
      "end_seconds": 174.97,
      "duration_seconds": 3.72,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.85,
      "end_seconds": 178.11,
      "duration_seconds": 1.26,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.44,
      "end_seconds": 183.79,
      "duration_seconds": 4.35,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.5,
      "end_seconds": 188.26,
      "duration_seconds": 2.76,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.46,
      "end_seconds": 192.22,
      "duration_seconds": 2.76,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.24,
      "end_seconds": 207.08,
      "duration_seconds": 3.84,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.89,
      "end_seconds": 220.87,
      "duration_seconds": 1.98,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.0,
      "end_seconds": 250.01,
      "duration_seconds": 9.01,
      "text": "Okay: pulse is 91 beats a minute, temperature 39.1. And BP is 106 over 69, respiratory rate 19, saturation 95 percent."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.55,
      "end_seconds": 256.62,
      "duration_seconds": 4.07,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.63,
      "end_seconds": 259.88,
      "duration_seconds": 2.25,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.03,
      "end_seconds": 274.56,
      "duration_seconds": 5.53,
      "text": "The right ear drum is red and bulging, and the left is normal."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.79,
      "end_seconds": 291.82,
      "duration_seconds": 14.03,
      "text": "You can sit up now. Right, here's what I'm thinking. I don't have a clear answer today: acute middle ear infection is possible, and so is a viral cold."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.18,
      "end_seconds": 297.21,
      "duration_seconds": 2.03,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.0,
      "end_seconds": 329.8,
      "duration_seconds": 30.8,
      "text": "I understand the worry. At the moment I'd say it's acute middle ear infection, and we'll watch how it goes. I'm prescribing amoxicillin, 250 milligrams, three times a day, five days. It's for ear infection. Give pain relief regularly and plenty to drink. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. If the symptoms get worse, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.8,
      "end_seconds": 332.76,
      "duration_seconds": 0.96,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.36,
      "end_seconds": 337.93,
      "duration_seconds": 4.57,
      "text": "I'd like you back if not better in two days."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.12,
      "end_seconds": 339.82,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.44,
      "end_seconds": 345.35,
      "duration_seconds": 4.91,
      "text": "Before we finish, can you repeat the plan back to me?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.57,
      "end_seconds": 361.0,
      "duration_seconds": 11.43,
      "text": "So, I take the amoxicillin, 250 milligrams, three times a day and come back if not better in two days. Is that right?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.72,
      "end_seconds": 369.31,
      "duration_seconds": 6.59,
      "text": "Yes, exactly right. Okay, is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 370.07,
      "end_seconds": 371.61,
      "duration_seconds": 1.54,
      "text": "That's clear, thanks."
    }
  ]
}