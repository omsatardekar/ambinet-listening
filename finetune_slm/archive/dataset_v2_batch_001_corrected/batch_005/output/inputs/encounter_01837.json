{
  "schema_version": "1.0",
  "encounter_id": "01837",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.95,
      "end_seconds": 7.05,
      "duration_seconds": 6.1,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.04,
      "end_seconds": 11.84,
      "duration_seconds": 3.8,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.57,
      "end_seconds": 24.86,
      "duration_seconds": 12.29,
      "text": "I've been feeling tired after the birth, and I wanted to get it checked. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.91,
      "end_seconds": 28.48,
      "duration_seconds": 2.57,
      "text": "Did it it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.0,
      "end_seconds": 33.63,
      "duration_seconds": 4.63,
      "text": "Let me think, it's been going on for six months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.4,
      "end_seconds": 38.12,
      "duration_seconds": 2.72,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.99,
      "end_seconds": 49.78,
      "duration_seconds": 8.79,
      "text": "Okay, so I'd give it a eight, out of ten. I've also been feeling tearful at times."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.78,
      "end_seconds": 68.24,
      "duration_seconds": 6.46,
      "text": "And what about leg swelling, thoughts of harming the baby, heavy bleeding or fever?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.48,
      "end_seconds": 76.54,
      "duration_seconds": 7.06,
      "text": "No, no leg swelling, thoughts of harming the baby, heavy bleeding or fever."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.71,
      "end_seconds": 80.07,
      "duration_seconds": 2.36,
      "text": "is your chest okay generally?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.2,
      "end_seconds": 83.89,
      "duration_seconds": 2.69,
      "text": "no, my breathing's been fine"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.92,
      "end_seconds": 90.31,
      "duration_seconds": 5.39,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.9,
      "end_seconds": 93.08,
      "duration_seconds": 2.18,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.23,
      "end_seconds": 98.51,
      "duration_seconds": 4.28,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.09,
      "end_seconds": 105.83,
      "duration_seconds": 5.74,
      "text": "Nickel. I come out in... well, a rash on my skin"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.44,
      "end_seconds": 125.78,
      "duration_seconds": 2.34,
      "text": "do you work outside the home?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.45,
      "end_seconds": 130.51,
      "duration_seconds": 4.06,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.63,
      "end_seconds": 135.37,
      "duration_seconds": 3.74,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.63,
      "end_seconds": 140.22,
      "duration_seconds": 3.59,
      "text": "Lots of rice, lentils and some fruit"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.62,
      "end_seconds": 143.71,
      "duration_seconds": 2.09,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.79,
      "end_seconds": 147.52,
      "duration_seconds": 2.73,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.92,
      "end_seconds": 153.73,
      "duration_seconds": 4.81,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.9,
      "end_seconds": 158.09,
      "duration_seconds": 3.19,
      "text": "no, nothing I can think of"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.82,
      "end_seconds": 164.77,
      "duration_seconds": 4.95,
      "text": "Are you taking anything regularly, including from the the pharmacy?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.9,
      "end_seconds": 168.76,
      "duration_seconds": 2.86,
      "text": "Paracetamol, 1 gram, when needed."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.6,
      "end_seconds": 173.5,
      "duration_seconds": 2.9,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.57,
      "end_seconds": 180.01,
      "duration_seconds": 4.44,
      "text": "Actually, I had a bunion operation six years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.95,
      "end_seconds": 190.82,
      "duration_seconds": 2.87,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.65,
      "end_seconds": 204.73,
      "duration_seconds": 2.08,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.11,
      "end_seconds": 228.14,
      "duration_seconds": 5.03,
      "text": "Okay: BP is 120 over 81, pulse 65, temperature 36.5."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.06,
      "end_seconds": 231.51,
      "duration_seconds": 1.45,
      "text": "is that okay?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.87,
      "end_seconds": 239.22,
      "duration_seconds": 2.35,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.3,
      "end_seconds": 245.4,
      "duration_seconds": 4.1,
      "text": "Could you come over to the the couch, please?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.17,
      "end_seconds": 260.28,
      "duration_seconds": 1.11,
      "text": "of course"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.53,
      "end_seconds": 264.86,
      "duration_seconds": 3.33,
      "text": "Okay, stay as you are for a moment."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.94,
      "end_seconds": 286.17,
      "duration_seconds": 6.23,
      "text": "The womb has gone down well and the stitches are healing, with no redness."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.63,
      "end_seconds": 305.97,
      "duration_seconds": 16.34,
      "text": "Okay, that's enough for me. Let me tell you where I've got to. It's hard to say. A normal postnatal recovery is one possibility and the baby blues another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.12,
      "end_seconds": 310.04,
      "duration_seconds": 2.92,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.13,
      "end_seconds": 335.87,
      "duration_seconds": 22.74,
      "text": "I understand the worry. At the moment I'd say it's a normal postnatal recovery, and we'll know more once the the a blood count is back. Let me repeat that back to make sure. You've been feeling tired after the birth for six months, and no fever or leg swelling."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.72,
      "end_seconds": 341.42,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.23,
      "end_seconds": 349.74,
      "duration_seconds": 5.51,
      "text": "I think a blood count makes sense here, for postnatal tiredness."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.0,
      "end_seconds": 353.47,
      "duration_seconds": 2.47,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.87,
      "end_seconds": 382.25,
      "duration_seconds": 23.38,
      "text": "rest when the baby sleeps and ask for help; contraception can be discussed at six weeks please don't wait if the symptoms get worse that's when to be seen urgently come back in four weeks tell me what you've taken from all that, so I can fill in any gaps"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 383.98,
      "end_seconds": 389.42,
      "duration_seconds": 5.44,
      "text": "So, I come back in four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 390.14,
      "end_seconds": 394.1,
      "duration_seconds": 3.96,
      "text": "yes, exactly right. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 395.89,
      "end_seconds": 398.04,
      "duration_seconds": 2.15,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 399.56,
      "end_seconds": 400.79,
      "duration_seconds": 1.23,
      "text": "Goodbye for now."
    }
  ]
}