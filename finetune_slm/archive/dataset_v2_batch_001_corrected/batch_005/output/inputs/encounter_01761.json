{
  "schema_version": "1.0",
  "encounter_id": "01761",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.1,
      "end_seconds": 5.04,
      "duration_seconds": 3.94,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.97,
      "end_seconds": 10.83,
      "duration_seconds": 3.86,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.78,
      "end_seconds": 18.47,
      "duration_seconds": 6.69,
      "text": "Honestly, it's morning stiffness for an hour, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.89,
      "end_seconds": 23.53,
      "duration_seconds": 3.64,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.71,
      "end_seconds": 27.45,
      "duration_seconds": 2.74,
      "text": "About... well, about two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.98,
      "end_seconds": 32.17,
      "duration_seconds": 3.19,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.54,
      "end_seconds": 41.86,
      "duration_seconds": 8.32,
      "text": "I'd give it a three, out of ten. And there's sore wrists as well, two weeks now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.92,
      "end_seconds": 47.8,
      "duration_seconds": 3.88,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.19,
      "end_seconds": 50.76,
      "duration_seconds": 1.57,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.33,
      "end_seconds": 54.71,
      "duration_seconds": 2.38,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.21,
      "end_seconds": 59.35,
      "duration_seconds": 3.14,
      "text": "It's ibuprofen, 400 milligrams, when needed."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.4,
      "end_seconds": 73.12,
      "duration_seconds": 4.72,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.12,
      "end_seconds": 77.14,
      "duration_seconds": 3.02,
      "text": "Yes, tramadol, it gives me vomiting."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.48,
      "end_seconds": 82.58,
      "duration_seconds": 4.1,
      "text": "Right, has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.56,
      "end_seconds": 86.87,
      "duration_seconds": 2.31,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.54,
      "end_seconds": 99.14,
      "duration_seconds": 2.6,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.1,
      "end_seconds": 104.02,
      "duration_seconds": 3.92,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.29,
      "end_seconds": 107.47,
      "duration_seconds": 2.18,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.54,
      "end_seconds": 114.73,
      "duration_seconds": 6.19,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.99,
      "end_seconds": 122.69,
      "duration_seconds": 3.7,
      "text": "A few quick ones: eye redness or chest pain?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.5,
      "end_seconds": 128.31,
      "duration_seconds": 4.81,
      "text": "No eye redness or chest pain, none of it."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.25,
      "end_seconds": 132.61,
      "duration_seconds": 2.36,
      "text": "Did you get fever or rash?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.18,
      "end_seconds": 137.17,
      "duration_seconds": 2.99,
      "text": "Actually, nope, nothing like that."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.06,
      "end_seconds": 140.5,
      "duration_seconds": 2.44,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.16,
      "end_seconds": 142.86,
      "duration_seconds": 1.7,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.05,
      "end_seconds": 146.84,
      "duration_seconds": 2.79,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.33,
      "end_seconds": 160.29,
      "duration_seconds": 2.96,
      "text": "So, keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.53,
      "end_seconds": 176.04,
      "duration_seconds": 6.51,
      "text": "Okay: pulse 80, temp 36.6 degrees, saturation 99 percent. And pressure 128 over 79."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.16,
      "end_seconds": 182.36,
      "duration_seconds": 2.2,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.84,
      "end_seconds": 186.39,
      "duration_seconds": 2.55,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.98,
      "end_seconds": 190.27,
      "duration_seconds": 2.29,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.23,
      "end_seconds": 193.48,
      "duration_seconds": 1.25,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.71,
      "end_seconds": 209.71,
      "duration_seconds": 6.0,
      "text": "The knuckles and wrists are swollen and warm, and the squeeze test is painful."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.24,
      "end_seconds": 222.94,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.35,
      "end_seconds": 229.02,
      "duration_seconds": 2.67,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.69,
      "end_seconds": 254.35,
      "duration_seconds": 11.66,
      "text": "Okay, so my impression is this: I'd lean towards an inflammatory arthritis flare. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.11,
      "end_seconds": 258.08,
      "duration_seconds": 1.97,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.33,
      "end_seconds": 279.26,
      "duration_seconds": 19.93,
      "text": "Nothing I've seen today points to an emergency. It looks like an inflammatory arthritis flare, but I'd like to confirm. Just to be sure I understood. You've had morning stiffness for an hour for about two weeks, and no rash or fever."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.93,
      "end_seconds": 281.63,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.29,
      "end_seconds": 307.87,
      "duration_seconds": 25.58,
      "text": "We should do blood tests for inflammatory arthritis. You'll be taking methotrexate, 10 milligrams, once a week, long term. It's for inflammatory arthritis. Gentle hand exercises and warm water in the morning. I think the rheumatology clinic should see you too. Come back in four weeks. Okay, does all of that make sense?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.42,
      "end_seconds": 311.45,
      "duration_seconds": 2.03,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}