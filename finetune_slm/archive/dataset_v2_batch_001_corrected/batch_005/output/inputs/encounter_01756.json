{
  "schema_version": "1.0",
  "encounter_id": "01756",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.01,
      "end_seconds": 5.67,
      "duration_seconds": 4.66,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.18,
      "end_seconds": 10.96,
      "duration_seconds": 3.78,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.96,
      "end_seconds": 20.93,
      "duration_seconds": 7.97,
      "text": "I've been feeling tired after the birth, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.28,
      "end_seconds": 26.06,
      "duration_seconds": 3.78,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.03,
      "end_seconds": 31.12,
      "duration_seconds": 3.09,
      "text": "I've had it for two months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.88,
      "end_seconds": 34.81,
      "duration_seconds": 2.93,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.18,
      "end_seconds": 39.35,
      "duration_seconds": 3.17,
      "text": "Pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.58,
      "end_seconds": 45.63,
      "duration_seconds": 5.05,
      "text": "What about some soreness from the stitches, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.46,
      "end_seconds": 52.9,
      "duration_seconds": 5.44,
      "text": "Mm, yes. About soreness from the stitches, I'd call it mild."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.76,
      "end_seconds": 74.68,
      "duration_seconds": 4.92,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.45,
      "end_seconds": 90.44,
      "duration_seconds": 13.99,
      "text": "I smoke roughly a pack every two days. Yes, I work in a bakery, early starts. I live with my elderly mother. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.66,
      "end_seconds": 99.02,
      "duration_seconds": 5.36,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.31,
      "end_seconds": 103.33,
      "duration_seconds": 3.02,
      "text": "Yes, cat fur. I get wheezing."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.51,
      "end_seconds": 123.58,
      "duration_seconds": 8.07,
      "text": "Which medicines do you take at the moment? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.35,
      "end_seconds": 128.4,
      "duration_seconds": 4.05,
      "text": "Paracetamol. I take it 1 gram, when needed."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.42,
      "end_seconds": 146.01,
      "duration_seconds": 6.59,
      "text": "Any medical conditions, anything you've been treated for? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.65,
      "end_seconds": 148.93,
      "duration_seconds": 2.28,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.01,
      "end_seconds": 153.0,
      "duration_seconds": 1.99,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.56,
      "end_seconds": 161.38,
      "duration_seconds": 3.82,
      "text": "I had a bunion operation six years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.94,
      "end_seconds": 167.26,
      "duration_seconds": 5.32,
      "text": "Let me check a few things. Any heavy bleeding or leg swelling?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.74,
      "end_seconds": 172.18,
      "duration_seconds": 3.44,
      "text": "Okay, so no, none that I've noticed."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.16,
      "end_seconds": 178.63,
      "duration_seconds": 4.47,
      "text": "Okay, any fever or thoughts of harming the baby at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.8,
      "end_seconds": 186.36,
      "duration_seconds": 2.56,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.01,
      "end_seconds": 192.26,
      "duration_seconds": 4.25,
      "text": "Alright, on the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.44,
      "end_seconds": 198.07,
      "duration_seconds": 4.63,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.44,
      "end_seconds": 219.74,
      "duration_seconds": 4.3,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.92,
      "end_seconds": 229.4,
      "duration_seconds": 2.48,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.88,
      "end_seconds": 257.29,
      "duration_seconds": 8.41,
      "text": "Okay: BP is 125 over 71, SpO2 99 percent on room air. And temp 36.8 degrees, heart rate 73."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.28,
      "end_seconds": 264.23,
      "duration_seconds": 3.95,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.27,
      "end_seconds": 267.06,
      "duration_seconds": 1.79,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.4,
      "end_seconds": 282.31,
      "duration_seconds": 5.91,
      "text": "The womb has gone down well and the stitches are healing, with no redness."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.72,
      "end_seconds": 295.57,
      "duration_seconds": 8.85,
      "text": "Okay, that's enough for me. From what you've told me and what I found, this looks most like a normal postnatal recovery."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.75,
      "end_seconds": 299.75,
      "duration_seconds": 2.0,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.3,
      "end_seconds": 320.24,
      "duration_seconds": 18.94,
      "text": "I understand the worry. At the moment I'd say it's a normal postnatal recovery, and we'll watch how it goes. I don't need to add any tests or treatment at this point. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.75,
      "end_seconds": 324.83,
      "duration_seconds": 4.08,
      "text": "I, I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.33,
      "end_seconds": 328.28,
      "duration_seconds": 1.95,
      "text": "Have a good day."
    }
  ]
}