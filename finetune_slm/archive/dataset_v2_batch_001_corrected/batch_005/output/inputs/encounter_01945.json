{
  "schema_version": "1.0",
  "encounter_id": "01945",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.14,
      "end_seconds": 5.33,
      "duration_seconds": 4.19,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.13,
      "end_seconds": 11.67,
      "duration_seconds": 4.54,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 17.72,
      "end_seconds": 27.64,
      "duration_seconds": 9.92,
      "text": "Erm, doctor, I've come along because I know the history, if it helps. He's been having been feeling exhausted, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.59,
      "end_seconds": 36.31,
      "duration_seconds": 3.72,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 41.94,
      "end_seconds": 51.01,
      "duration_seconds": 9.07,
      "text": "He takes metoprolol, 50 milligrams, twice a day. It's bisoprolol, 2.5 milligrams, once a day, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.12,
      "end_seconds": 53.85,
      "duration_seconds": 1.73,
      "text": "Okay, is that long-standing?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 54.87,
      "end_seconds": 60.22,
      "duration_seconds": 5.35,
      "text": "About about a month. He takes throat lozenges, when needed."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.52,
      "end_seconds": 64.37,
      "duration_seconds": 2.85,
      "text": "Right, when did you start it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 66.19,
      "end_seconds": 68.15,
      "duration_seconds": 1.96,
      "text": "About about three months."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.27,
      "end_seconds": 77.41,
      "duration_seconds": 3.14,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.04,
      "end_seconds": 82.11,
      "duration_seconds": 4.07,
      "text": "Since last night, that's when it began."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.59,
      "end_seconds": 86.87,
      "duration_seconds": 3.28,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.85,
      "end_seconds": 99.52,
      "duration_seconds": 10.67,
      "text": "It usually comes with a fever. The fever? That's been for three days. As for fever, it just comes and goes."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.51,
      "end_seconds": 105.74,
      "duration_seconds": 4.23,
      "text": "Have you been feeling exhausted at any time before this?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.52,
      "end_seconds": 117.03,
      "duration_seconds": 9.51,
      "text": "Yes, something like this happened a couple of years ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.97,
      "end_seconds": 124.72,
      "duration_seconds": 5.75,
      "text": "A few quick ones: rash, jaundice or tummy pain on the left?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.33,
      "end_seconds": 128.56,
      "duration_seconds": 3.23,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.44,
      "end_seconds": 132.06,
      "duration_seconds": 2.62,
      "text": "And difficulty breathing, any of that?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.44,
      "end_seconds": 137.33,
      "duration_seconds": 3.89,
      "text": "Not that I've noticed, no difficulty breathing."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.29,
      "end_seconds": 141.33,
      "duration_seconds": 3.04,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.42,
      "end_seconds": 145.58,
      "duration_seconds": 2.16,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.6,
      "end_seconds": 150.2,
      "duration_seconds": 2.6,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.22,
      "end_seconds": 155.28,
      "duration_seconds": 4.06,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.59,
      "end_seconds": 162.67,
      "duration_seconds": 3.08,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.03,
      "end_seconds": 167.93,
      "duration_seconds": 3.9,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.92,
      "end_seconds": 171.97,
      "duration_seconds": 2.05,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.99,
      "end_seconds": 175.3,
      "duration_seconds": 2.31,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.96,
      "end_seconds": 178.92,
      "duration_seconds": 1.96,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.4,
      "end_seconds": 184.14,
      "duration_seconds": 3.74,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.96,
      "end_seconds": 187.13,
      "duration_seconds": 1.17,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.57,
      "end_seconds": 191.61,
      "duration_seconds": 1.04,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.63,
      "end_seconds": 212.15,
      "duration_seconds": 3.52,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.99,
      "end_seconds": 224.67,
      "duration_seconds": 10.68,
      "text": "I've got heart failure. I have an irregular heartbeat. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.24,
      "end_seconds": 236.19,
      "duration_seconds": 9.95,
      "text": "Yes, an irregular heartbeat is known to us, good to have that clear. Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.26,
      "end_seconds": 249.96,
      "duration_seconds": 3.7,
      "text": "Right, that's it, just a little longer..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.07,
      "end_seconds": 276.99,
      "duration_seconds": 12.92,
      "text": "Okay: saturation 98 percent, weight 78 kilos, BMI works out to 33.8, BP is 119 over 67, height 152 centimetres, pulse is 104 beats a minute, temp 38.1 degrees."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.56,
      "end_seconds": 280.86,
      "duration_seconds": 2.3,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.49,
      "end_seconds": 284.57,
      "duration_seconds": 2.08,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.16,
      "end_seconds": 290.94,
      "duration_seconds": 3.78,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.87,
      "end_seconds": 292.99,
      "duration_seconds": 1.12,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.48,
      "end_seconds": 297.21,
      "duration_seconds": 2.73,
      "text": "Okay, I'm just checking this side."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.97,
      "end_seconds": 311.11,
      "duration_seconds": 6.14,
      "text": "Your tonsils are large with white coating and the glands in the neck are tender."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.9,
      "end_seconds": 315.46,
      "duration_seconds": 1.56,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.81,
      "end_seconds": 340.88,
      "duration_seconds": 10.07,
      "text": "Right, here's what I'm thinking. It's hard to say. Glandular fever is one possibility and streptococcal tonsillitis another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.8,
      "end_seconds": 343.82,
      "duration_seconds": 2.02,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.67,
      "end_seconds": 351.2,
      "duration_seconds": 6.53,
      "text": "I can't promise yet, but most people with glandular fever do well once it's treated properly."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.48,
      "end_seconds": 401.6,
      "duration_seconds": 35.12,
      "text": "I think a monospot test makes sense here, for sore throat and fatigue. I think a blood count makes sense here, for glandular fever. Rest, plenty of fluids, and no contact sport for a month because of the spleen. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. Please don't wait if the symptoms get worse. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 402.46,
      "end_seconds": 408.91,
      "duration_seconds": 6.45,
      "text": "Please come and see me in two weeks. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 409.82,
      "end_seconds": 412.0,
      "duration_seconds": 2.18,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 413.98,
      "end_seconds": 415.27,
      "duration_seconds": 1.29,
      "text": "See you soon."
    }
  ]
}