{
  "schema_version": "1.0",
  "encounter_id": "01593",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.84,
      "end_seconds": 6.45,
      "duration_seconds": 5.61,
      "text": "Hi, uh, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.45,
      "end_seconds": 12.55,
      "duration_seconds": 4.1,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.33,
      "end_seconds": 19.9,
      "duration_seconds": 5.57,
      "text": "I wanted to get a seizure last week looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.65,
      "end_seconds": 23.67,
      "duration_seconds": 3.02,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.49,
      "end_seconds": 27.19,
      "duration_seconds": 2.7,
      "text": "I've had it for two months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.65,
      "end_seconds": 31.38,
      "duration_seconds": 2.73,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.71,
      "end_seconds": 38.62,
      "duration_seconds": 5.91,
      "text": "A bitten tongue goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.57,
      "end_seconds": 43.91,
      "duration_seconds": 3.34,
      "text": "Alright, do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.94,
      "end_seconds": 49.45,
      "duration_seconds": 3.51,
      "text": "I have epilepsy, for two years."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.12,
      "end_seconds": 52.88,
      "duration_seconds": 2.76,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.49,
      "end_seconds": 65.95,
      "duration_seconds": 11.46,
      "text": "I look after my grandchildren most days. Lots of rice, lentils and some fruit. I walk the dog every morning."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.24,
      "end_seconds": 72.08,
      "duration_seconds": 4.84,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.89,
      "end_seconds": 78.25,
      "duration_seconds": 5.36,
      "text": "Not currently, but as a youngster erythromycin gave me a rash."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.81,
      "end_seconds": 95.0,
      "duration_seconds": 2.19,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.57,
      "end_seconds": 106.15,
      "duration_seconds": 5.58,
      "text": "Lamotrigine. I take it 100 milligrams, twice a day for the fits."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.39,
      "end_seconds": 123.72,
      "duration_seconds": 3.33,
      "text": "Have you had head injury, by any chance?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.72,
      "end_seconds": 127.7,
      "duration_seconds": 1.98,
      "text": "Nope, no head injury."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.62,
      "end_seconds": 135.59,
      "duration_seconds": 5.97,
      "text": "Let me check a few things. Any fever, loss of bladder control or second seizure?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.2,
      "end_seconds": 139.84,
      "duration_seconds": 3.64,
      "text": "Erm, no, I'd have said so."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.72,
      "end_seconds": 143.72,
      "duration_seconds": 2.0,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.33,
      "end_seconds": 145.81,
      "duration_seconds": 1.48,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.6,
      "end_seconds": 151.54,
      "duration_seconds": 3.94,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.14,
      "end_seconds": 156.45,
      "duration_seconds": 4.31,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.33,
      "end_seconds": 172.82,
      "duration_seconds": 3.49,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.9,
      "end_seconds": 181.55,
      "duration_seconds": 2.65,
      "text": "Right, nearly done with the readings..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.28,
      "end_seconds": 197.65,
      "duration_seconds": 5.37,
      "text": "Okay: temp 36.9 degrees, BP is 113 over 73, pulse 67."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.09,
      "end_seconds": 200.58,
      "duration_seconds": 1.49,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.22,
      "end_seconds": 206.47,
      "duration_seconds": 4.25,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.0,
      "end_seconds": 212.68,
      "duration_seconds": 4.68,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.81,
      "end_seconds": 216.6,
      "duration_seconds": 2.79,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.35,
      "end_seconds": 239.06,
      "duration_seconds": 3.71,
      "text": "You are alert and your neurological examination is normal."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.47,
      "end_seconds": 245.43,
      "duration_seconds": 1.96,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.98,
      "end_seconds": 289.99,
      "duration_seconds": 26.01,
      "text": "Putting it all together, I think we're dealing with a breakthrough seizure after missed medication and poor sleep at this stage. We should do an anticonvulsant level for breakthrough seizure. Take your medicine at the same time every day and do not drive until we say so. The epilepsy nurse would be the right next step, I'll refer you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.97,
      "end_seconds": 292.51,
      "duration_seconds": 1.54,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.04,
      "end_seconds": 299.12,
      "duration_seconds": 6.08,
      "text": "One warning sign to remember: the symptoms get worse. In that case don't wait."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.14,
      "end_seconds": 304.88,
      "duration_seconds": 1.74,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.95,
      "end_seconds": 308.58,
      "duration_seconds": 2.63,
      "text": "See me again in four weeks."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.15,
      "end_seconds": 310.85,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.85,
      "end_seconds": 317.27,
      "duration_seconds": 5.42,
      "text": "Right, is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.5,
      "end_seconds": 321.52,
      "duration_seconds": 3.02,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}