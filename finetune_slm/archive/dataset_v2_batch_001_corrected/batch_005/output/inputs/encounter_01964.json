{
  "schema_version": "1.0",
  "encounter_id": "01964",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.08,
      "end_seconds": 4.66,
      "duration_seconds": 3.58,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.2,
      "end_seconds": 11.94,
      "duration_seconds": 5.74,
      "text": "Alright, yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.25,
      "end_seconds": 24.21,
      "duration_seconds": 10.96,
      "text": "Well, I've been having a swollen tummy. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.93,
      "end_seconds": 31.41,
      "duration_seconds": 5.48,
      "text": "How long has this been bothering you? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.0,
      "end_seconds": 37.84,
      "duration_seconds": 4.84,
      "text": "Uh, I've had it for about four days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.32,
      "end_seconds": 39.06,
      "duration_seconds": 0.74,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.08,
      "end_seconds": 48.41,
      "duration_seconds": 7.33,
      "text": "And there's not passing wind as well, you know, about a month now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.14,
      "end_seconds": 51.69,
      "duration_seconds": 2.55,
      "text": "Any vomiting green fluid as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.5,
      "end_seconds": 55.69,
      "duration_seconds": 2.19,
      "text": "Mm, you know, yes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.2,
      "end_seconds": 60.6,
      "duration_seconds": 2.4,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.26,
      "end_seconds": 64.55,
      "duration_seconds": 2.29,
      "text": "Honestly, on and off."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.81,
      "end_seconds": 65.57,
      "duration_seconds": 0.76,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.04,
      "end_seconds": 70.81,
      "duration_seconds": 2.77,
      "text": "So, may I examine you now?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.72,
      "end_seconds": 74.61,
      "duration_seconds": 1.89,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.5,
      "end_seconds": 98.71,
      "duration_seconds": 5.21,
      "text": "Your tummy is swollen and tympanic, with high-pitched tinkling bowel sounds."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.1,
      "end_seconds": 103.97,
      "duration_seconds": 2.87,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.43,
      "end_seconds": 119.68,
      "duration_seconds": 4.25,
      "text": "Right, any blood in the stool, hernia or fever?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.37,
      "end_seconds": 123.2,
      "duration_seconds": 2.83,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.37,
      "end_seconds": 127.39,
      "duration_seconds": 3.02,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.96,
      "end_seconds": 135.15,
      "duration_seconds": 6.19,
      "text": "Sorry, what was I saying, no, nothing with my heart."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.29,
      "end_seconds": 140.13,
      "duration_seconds": 3.84,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.36,
      "end_seconds": 147.47,
      "duration_seconds": 1.11,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.06,
      "end_seconds": 155.82,
      "duration_seconds": 6.76,
      "text": "Any medical conditions, anything you've been treated for? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.89,
      "end_seconds": 160.37,
      "duration_seconds": 3.48,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.03,
      "end_seconds": 174.69,
      "duration_seconds": 3.66,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.54,
      "end_seconds": 179.28,
      "duration_seconds": 3.74,
      "text": "Erm, um, no allergies at all."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.8,
      "end_seconds": 183.73,
      "duration_seconds": 2.93,
      "text": "Right, are you on any regular medication?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.82,
      "end_seconds": 187.84,
      "duration_seconds": 3.02,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.75,
      "end_seconds": 193.73,
      "duration_seconds": 3.98,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.73,
      "end_seconds": 201.16,
      "duration_seconds": 5.43,
      "text": "Uh, uh, my daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.06,
      "end_seconds": 205.49,
      "duration_seconds": 2.43,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.19,
      "end_seconds": 216.26,
      "duration_seconds": 5.07,
      "text": "Oh, just my tonsils removed, as a teenager."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.23,
      "end_seconds": 219.91,
      "duration_seconds": 1.68,
      "text": "Okay, what about alcohol?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.08,
      "end_seconds": 230.74,
      "duration_seconds": 6.66,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.52,
      "end_seconds": 232.77,
      "duration_seconds": 1.25,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.0,
      "end_seconds": 238.01,
      "duration_seconds": 4.01,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.44,
      "end_seconds": 241.38,
      "duration_seconds": 1.94,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.28,
      "end_seconds": 245.14,
      "duration_seconds": 2.86,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.4,
      "end_seconds": 250.13,
      "duration_seconds": 1.73,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.07,
      "end_seconds": 254.84,
      "duration_seconds": 2.77,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.84,
      "end_seconds": 257.94,
      "duration_seconds": 2.1,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.85,
      "end_seconds": 265.92,
      "duration_seconds": 6.07,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.43,
      "end_seconds": 289.34,
      "duration_seconds": 14.91,
      "text": "Let me tell you where I've got to. It points towards a bowel obstruction needing urgent surgical care. That's my thinking for now, and it may change as we learn more. Severe constipation is still possible."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.5,
      "end_seconds": 295.38,
      "duration_seconds": 4.88,
      "text": "Sorry, what was I saying, is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.31,
      "end_seconds": 319.29,
      "duration_seconds": 21.98,
      "text": "I understand the worry. At the moment I'd say it's a bowel obstruction needing urgent surgical care, and we'll know more once the an abdominal X-ray is back. We should do an abdominal X-ray for possible obstruction. I'm sending you for urgent blood tests because of vomiting."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.13,
      "end_seconds": 323.23,
      "duration_seconds": 3.1,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.85,
      "end_seconds": 336.65,
      "duration_seconds": 11.8,
      "text": "Nothing to eat or drink, and you are going to hospital now. If the symptoms get worse, that's the point to come in urgently. Let's review you straight away."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.22,
      "end_seconds": 339.29,
      "duration_seconds": 2.07,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.15,
      "end_seconds": 344.86,
      "duration_seconds": 4.71,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.82,
      "end_seconds": 350.11,
      "duration_seconds": 4.29,
      "text": "Ah, no, that's all. Thanks a lot."
    }
  ]
}