{
  "schema_version": "1.0",
  "encounter_id": "01958",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.97,
      "end_seconds": 5.38,
      "duration_seconds": 4.41,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.6,
      "end_seconds": 10.91,
      "duration_seconds": 4.31,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.01,
      "end_seconds": 21.76,
      "duration_seconds": 8.75,
      "text": "Mainly a productive cough with rusty phlegm. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.06,
      "end_seconds": 30.81,
      "duration_seconds": 8.75,
      "text": "Understood. Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.58,
      "end_seconds": 40.06,
      "duration_seconds": 5.48,
      "text": "Moderate, I'd say. I'd say a few times a day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.14,
      "end_seconds": 43.9,
      "duration_seconds": 2.76,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.73,
      "end_seconds": 70.2,
      "duration_seconds": 25.47,
      "text": "Hmm, when it starts I tend to get pain on the right when I breathe in as well. Um, the pain on the right when I breathe in? That's been for three days. As for pain on the right when I breathe in, I'd give it a five, out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.69,
      "end_seconds": 76.33,
      "duration_seconds": 2.64,
      "text": "And recent travel, any of that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.32,
      "end_seconds": 84.2,
      "duration_seconds": 6.88,
      "text": "Sorry, uh, what was I saying, no, I haven't had any recent travel."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.61,
      "end_seconds": 90.35,
      "duration_seconds": 4.74,
      "text": "A few quick ones: leg swelling, confusion or coughing up blood?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.36,
      "end_seconds": 98.27,
      "duration_seconds": 5.91,
      "text": "No leg swelling, confusion or coughing up blood, none of it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.53,
      "end_seconds": 102.79,
      "duration_seconds": 3.26,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.93,
      "end_seconds": 105.54,
      "duration_seconds": 1.61,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.76,
      "end_seconds": 109.32,
      "duration_seconds": 2.56,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.3,
      "end_seconds": 112.54,
      "duration_seconds": 1.24,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.3,
      "end_seconds": 118.66,
      "duration_seconds": 4.36,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.58,
      "end_seconds": 132.28,
      "duration_seconds": 11.7,
      "text": "Lots of rice, lentils and some fruit. I'm a plumber, lots of bending and kneeling. I walk the dog every morning."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.28,
      "end_seconds": 137.48,
      "duration_seconds": 4.2,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.99,
      "end_seconds": 140.8,
      "duration_seconds": 2.81,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.14,
      "end_seconds": 145.49,
      "duration_seconds": 3.35,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.53,
      "end_seconds": 154.84,
      "duration_seconds": 7.31,
      "text": "Okay, um, so I've got depression. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.49,
      "end_seconds": 167.11,
      "duration_seconds": 10.62,
      "text": "Ah. Okay, I can see depression in your file as well. Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.26,
      "end_seconds": 185.08,
      "duration_seconds": 12.82,
      "text": "It's paracetamol, 1 gram, when needed. I did try to ignore it for a while. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.51,
      "end_seconds": 188.76,
      "duration_seconds": 3.25,
      "text": "Understood. I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.77,
      "end_seconds": 201.12,
      "duration_seconds": 2.35,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.1,
      "end_seconds": 224.97,
      "duration_seconds": 9.87,
      "text": "Okay: BP is 121 over 71, saturation 97 percent, respiratory rate 21, temperature 38.7, pulse is 108 beats a minute."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.36,
      "end_seconds": 227.94,
      "duration_seconds": 1.58,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.81,
      "end_seconds": 234.34,
      "duration_seconds": 4.53,
      "text": "Right, don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.47,
      "end_seconds": 239.57,
      "duration_seconds": 4.1,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.52,
      "end_seconds": 244.14,
      "duration_seconds": 2.62,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.68,
      "end_seconds": 263.72,
      "duration_seconds": 6.04,
      "text": "There are crackles at the right base and the breathing is a bit fast."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.19,
      "end_seconds": 269.98,
      "duration_seconds": 1.79,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.1,
      "end_seconds": 293.24,
      "duration_seconds": 10.14,
      "text": "So where does that leave us? I'm honestly not certain yet. It could be community-acquired pneumonia, or it might be acute bronchitis."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.75,
      "end_seconds": 297.21,
      "duration_seconds": 3.46,
      "text": "Actually, is there something to worry about?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.28,
      "end_seconds": 305.93,
      "duration_seconds": 6.65,
      "text": "I can't promise yet, but most people with community-acquired pneumonia do well once it's treated properly."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.89,
      "end_seconds": 339.56,
      "duration_seconds": 22.67,
      "text": "Let's get a chest X-ray, for possible pneumonia. I'm going to order blood tests, for pneumonia. The treatment will be amoxicillin, 500 milligrams, three times a day, five days. You take it by mouth. It's for chest infection. It's a commonly used medicine and most people tolerate it well."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.53,
      "end_seconds": 344.78,
      "duration_seconds": 4.25,
      "text": "Can I collect it from my own pharmacy?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.94,
      "end_seconds": 359.05,
      "duration_seconds": 13.11,
      "text": "Rest, drink plenty, and come back if you are not improving in two days. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.76,
      "end_seconds": 363.11,
      "duration_seconds": 3.35,
      "text": "Okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.47,
      "end_seconds": 367.2,
      "duration_seconds": 2.73,
      "text": "I'll want another look in one week."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 368.06,
      "end_seconds": 371.66,
      "duration_seconds": 3.6,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 372.83,
      "end_seconds": 375.29,
      "duration_seconds": 2.46,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 376.62,
      "end_seconds": 380.45,
      "duration_seconds": 3.83,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 381.13,
      "end_seconds": 382.86,
      "duration_seconds": 1.73,
      "text": "Have a good day."
    }
  ]
}