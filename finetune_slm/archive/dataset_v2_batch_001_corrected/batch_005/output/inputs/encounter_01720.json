{
  "schema_version": "1.0",
  "encounter_id": "01720",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.34,
      "end_seconds": 5.74,
      "duration_seconds": 4.4,
      "text": "Well, hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.29,
      "end_seconds": 11.42,
      "duration_seconds": 4.13,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.42,
      "end_seconds": 19.38,
      "duration_seconds": 6.96,
      "text": "It's a curtain coming across my vision. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.16,
      "end_seconds": 23.52,
      "duration_seconds": 3.36,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.99,
      "end_seconds": 28.21,
      "duration_seconds": 3.22,
      "text": "So, for two days, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.29,
      "end_seconds": 34.27,
      "duration_seconds": 2.98,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.66,
      "end_seconds": 40.59,
      "duration_seconds": 4.93,
      "text": "When it starts I tend to get blurred vision as well."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.52,
      "end_seconds": 45.01,
      "duration_seconds": 2.49,
      "text": "Have you had sudden new floaters?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.64,
      "end_seconds": 52.33,
      "duration_seconds": 6.69,
      "text": "Yes, for three weeks. The blurred vision? That's been for five days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.87,
      "end_seconds": 71.52,
      "duration_seconds": 4.65,
      "text": "Did you get headache, eye pain, recent injury or red eye?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.12,
      "end_seconds": 74.83,
      "duration_seconds": 2.71,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.69,
      "end_seconds": 80.09,
      "duration_seconds": 4.4,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.81,
      "end_seconds": 84.35,
      "duration_seconds": 2.54,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.4,
      "end_seconds": 89.38,
      "duration_seconds": 3.98,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.47,
      "end_seconds": 93.61,
      "duration_seconds": 2.14,
      "text": "I've got high cholesterol."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.52,
      "end_seconds": 97.58,
      "duration_seconds": 2.06,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.06,
      "end_seconds": 106.44,
      "duration_seconds": 7.38,
      "text": "Rosuvastatin, 10 milligrams, at night. Before this I was on simvastatin; that's been stopped."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.01,
      "end_seconds": 129.02,
      "duration_seconds": 4.01,
      "text": "Alright, are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.55,
      "end_seconds": 137.99,
      "duration_seconds": 8.44,
      "text": "I was told I'm allergic to kiwi, but I don't remember what reaction I had."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.55,
      "end_seconds": 140.85,
      "duration_seconds": 1.3,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.31,
      "end_seconds": 143.83,
      "duration_seconds": 1.52,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.07,
      "end_seconds": 146.23,
      "duration_seconds": 1.16,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.03,
      "end_seconds": 150.28,
      "duration_seconds": 3.25,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.22,
      "end_seconds": 154.19,
      "duration_seconds": 2.97,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.83,
      "end_seconds": 159.78,
      "duration_seconds": 3.95,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.37,
      "end_seconds": 163.51,
      "duration_seconds": 2.14,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.33,
      "end_seconds": 171.49,
      "duration_seconds": 6.16,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.5,
      "end_seconds": 175.85,
      "duration_seconds": 2.35,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.16,
      "end_seconds": 180.59,
      "duration_seconds": 3.43,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 186.19,
      "end_seconds": 194.09,
      "duration_seconds": 7.9,
      "text": "Here are the numbers, doctor. Temperature 36.8, pulse is 84 beats a minute, pressure 123 over 82. Respiratory rate 17."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.44,
      "end_seconds": 196.49,
      "duration_seconds": 1.05,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.52,
      "end_seconds": 202.64,
      "duration_seconds": 4.12,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.61,
      "end_seconds": 206.65,
      "duration_seconds": 2.04,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.06,
      "end_seconds": 224.18,
      "duration_seconds": 8.12,
      "text": "The vision in the right eye is much reduced and the field is cut off at the top."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.12,
      "end_seconds": 231.78,
      "duration_seconds": 1.66,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.49,
      "end_seconds": 260.57,
      "duration_seconds": 14.08,
      "text": "Let me tell you where I've got to. I'm honestly not certain yet. It could be a possible retinal detachment needing urgent surgery, or it might be a vitreous haemorrhage."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.65,
      "end_seconds": 263.02,
      "duration_seconds": 1.37,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.85,
      "end_seconds": 296.76,
      "duration_seconds": 31.91,
      "text": "It's reasonable to be concerned, but right now a possible retinal detachment needing urgent surgery is my leading thought, not anything worse. I'd like to arrange an urgent eye examination for possible retinal detachment. You need to be seen by the eye surgeons today, please don't eat or drink. The eye emergency service would be the right next step, I'll refer you. Come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.21,
      "end_seconds": 300.92,
      "duration_seconds": 2.71,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.44,
      "end_seconds": 306.33,
      "duration_seconds": 3.89,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.6,
      "end_seconds": 312.0,
      "duration_seconds": 1.4,
      "text": "Take care now."
    }
  ]
}