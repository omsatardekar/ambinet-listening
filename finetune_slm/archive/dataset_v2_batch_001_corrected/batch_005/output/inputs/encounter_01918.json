{
  "schema_version": "1.0",
  "encounter_id": "01918",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.9,
      "end_seconds": 3.0,
      "duration_seconds": 2.1,
      "text": "right then, come on in"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.19,
      "end_seconds": 7.22,
      "duration_seconds": 3.03,
      "text": "Good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.8,
      "end_seconds": 11.18,
      "duration_seconds": 2.38,
      "text": "what do you need help with?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.91,
      "end_seconds": 19.61,
      "duration_seconds": 6.7,
      "text": "It's a barking cough. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.0,
      "end_seconds": 24.15,
      "duration_seconds": 3.15,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.72,
      "end_seconds": 28.17,
      "duration_seconds": 3.45,
      "text": "I've had it for about a month"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.12,
      "end_seconds": 34.05,
      "duration_seconds": 4.93,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.85,
      "end_seconds": 45.07,
      "duration_seconds": 10.22,
      "text": "right, I'd say a few times a day. I'd say severe. Actually, and there's a runny nose as well, three weeks now"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 63.73,
      "end_seconds": 66.69,
      "duration_seconds": 2.96,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.71,
      "end_seconds": 82.48,
      "duration_seconds": 2.77,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.03,
      "end_seconds": 108.12,
      "duration_seconds": 8.09,
      "text": "Okay: respiratory rate 16, BP is 111 over 74, heart rate 78, SpO2 98 percent on room air."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.13,
      "end_seconds": 113.88,
      "duration_seconds": 3.75,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 124.39,
      "end_seconds": 125.45,
      "duration_seconds": 1.06,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.74,
      "end_seconds": 128.38,
      "duration_seconds": 1.64,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.99,
      "end_seconds": 153.46,
      "duration_seconds": 6.47,
      "text": "He is playful, breathing comfortably at rest, and I can't hear any noisy breathing now."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.07,
      "end_seconds": 159.92,
      "duration_seconds": 1.85,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.31,
      "end_seconds": 178.44,
      "duration_seconds": 3.13,
      "text": "has there been any noisy breathing when resting?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 179.01,
      "end_seconds": 182.33,
      "duration_seconds": 3.32,
      "text": "nope, no noisy breathing when resting"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 183.13,
      "end_seconds": 188.52,
      "duration_seconds": 5.39,
      "text": "let me check a few things. Any drooling, blue lips or difficulty swallowing?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 189.24,
      "end_seconds": 193.78,
      "duration_seconds": 4.54,
      "text": "no, uh, none of those at all"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.52,
      "end_seconds": 198.59,
      "duration_seconds": 3.07,
      "text": "how are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.63,
      "end_seconds": 202.24,
      "duration_seconds": 1.61,
      "text": "no, nothing there"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.0,
      "end_seconds": 206.0,
      "duration_seconds": 2.0,
      "text": "anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.61,
      "end_seconds": 209.19,
      "duration_seconds": 1.58,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.42,
      "end_seconds": 212.47,
      "duration_seconds": 2.05,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 214.17,
      "end_seconds": 215.41,
      "duration_seconds": 1.24,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.18,
      "end_seconds": 224.35,
      "duration_seconds": 8.17,
      "text": "Any health conditions I should have on record? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 225.96,
      "end_seconds": 228.04,
      "duration_seconds": 2.08,
      "text": "yes, an underactive thyroid"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.02,
      "end_seconds": 233.93,
      "duration_seconds": 4.91,
      "text": "Alright, any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 235.74,
      "end_seconds": 238.37,
      "duration_seconds": 2.63,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.77,
      "end_seconds": 242.4,
      "duration_seconds": 2.63,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 243.45,
      "end_seconds": 247.15,
      "duration_seconds": 3.7,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.43,
      "end_seconds": 250.29,
      "duration_seconds": 1.86,
      "text": "how active are you?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 251.14,
      "end_seconds": 254.94,
      "duration_seconds": 3.8,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.45,
      "end_seconds": 258.33,
      "duration_seconds": 2.88,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 260.08,
      "end_seconds": 263.87,
      "duration_seconds": 3.79,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.94,
      "end_seconds": 272.36,
      "duration_seconds": 4.42,
      "text": "Having listened and examined, this is probably mild croup."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 276.82,
      "end_seconds": 278.79,
      "duration_seconds": 1.97,
      "text": "is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 280.39,
      "end_seconds": 291.66,
      "duration_seconds": 11.27,
      "text": "Nothing I've seen today points to an emergency. It looks like mild croup. I'm prescribing dexamethasone, 0.15 mg per kg, once, single dose. That's for croup."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 292.19,
      "end_seconds": 293.75,
      "duration_seconds": 1.56,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 295.19,
      "end_seconds": 308.92,
      "duration_seconds": 13.73,
      "text": "Keep him calm, sit him upright, and give fluids. Let's plan a check if no better in two days. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 309.78,
      "end_seconds": 312.07,
      "duration_seconds": 2.29,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 314.14,
      "end_seconds": 315.47,
      "duration_seconds": 1.33,
      "text": "All the best."
    }
  ]
}