{
  "schema_version": "1.0",
  "encounter_id": "01944",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.51,
      "end_seconds": 9.36,
      "duration_seconds": 8.85,
      "text": "doctor, the patient's with us now i did the usual checks at the front, so just say when you want them"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.81,
      "end_seconds": 15.6,
      "duration_seconds": 4.79,
      "text": "Good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 16.99,
      "end_seconds": 24.75,
      "duration_seconds": 7.76,
      "text": "oh, uh, hello, doctor, I came in with them, if that's okay"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.18,
      "end_seconds": 29.59,
      "duration_seconds": 3.41,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 30.53,
      "end_seconds": 35.34,
      "duration_seconds": 4.81,
      "text": "She's been having shaky spells in the afternoon, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.13,
      "end_seconds": 40.91,
      "duration_seconds": 3.78,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 41.85,
      "end_seconds": 45.11,
      "duration_seconds": 3.26,
      "text": "about two weeks, give or take"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 46.74,
      "end_seconds": 50.25,
      "duration_seconds": 3.51,
      "text": "Hm, I'd say more like three weeks."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.57,
      "end_seconds": 56.17,
      "duration_seconds": 4.6,
      "text": "Okay, so roughly two to three weeks. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 58.04,
      "end_seconds": 62.09,
      "duration_seconds": 4.05,
      "text": "Um, um, that sounds about right."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.65,
      "end_seconds": 67.03,
      "duration_seconds": 3.38,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 68.48,
      "end_seconds": 76.25,
      "duration_seconds": 7.77,
      "text": "Well, um, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.69,
      "end_seconds": 82.75,
      "duration_seconds": 5.06,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 83.32,
      "end_seconds": 86.37,
      "duration_seconds": 3.05,
      "text": "It feels severe to me."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.86,
      "end_seconds": 90.27,
      "duration_seconds": 2.41,
      "text": "how often do you get it?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 92.25,
      "end_seconds": 99.86,
      "duration_seconds": 7.61,
      "text": "erm, it's, um... not exactly... well, hard to to explain, I mean—"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.59,
      "end_seconds": 106.73,
      "duration_seconds": 6.14,
      "text": "Let me put it another way: how many times in a typical day or week?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 108.13,
      "end_seconds": 111.77,
      "duration_seconds": 3.64,
      "text": "It's a few times a day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.76,
      "end_seconds": 115.58,
      "duration_seconds": 1.82,
      "text": "Does anything help it?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 116.49,
      "end_seconds": 118.68,
      "duration_seconds": 2.19,
      "text": "Sweets helps a bit"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 119.27,
      "end_seconds": 126.76,
      "duration_seconds": 7.49,
      "text": "I was just going to to say that the main thing is—"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 126.86,
      "end_seconds": 134.05,
      "duration_seconds": 7.19,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.04,
      "end_seconds": 140.41,
      "duration_seconds": 4.37,
      "text": "Right, later, thanks. Please go on. Have you been sweating?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 142.15,
      "end_seconds": 146.61,
      "duration_seconds": 4.46,
      "text": "Yes, about the same, about a week."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.49,
      "end_seconds": 151.22,
      "duration_seconds": 3.73,
      "text": "Any being confused for a minute as well?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 151.79,
      "end_seconds": 153.41,
      "duration_seconds": 1.62,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.29,
      "end_seconds": 157.45,
      "duration_seconds": 3.16,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 158.27,
      "end_seconds": 170.78,
      "duration_seconds": 12.51,
      "text": "Um, it feels moderate to me. Erm, I was feeling suddenly very hungry at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 171.6,
      "end_seconds": 173.77,
      "duration_seconds": 2.17,
      "text": "Yes, exactly like that."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 174.68,
      "end_seconds": 191.42,
      "duration_seconds": 16.74,
      "text": "Here are the numbers, doctor. Oxygen saturation is 99 percent, weight 67 kilos, heart rate 117, temperature 36.9, respiratory rate 19, BMI works out to 23.5, height 169 centimetres, pressure 124 over 88."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.79,
      "end_seconds": 194.17,
      "duration_seconds": 1.38,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.27,
      "end_seconds": 198.99,
      "duration_seconds": 3.72,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.91,
      "end_seconds": 201.21,
      "duration_seconds": 1.3,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.53,
      "end_seconds": 216.17,
      "duration_seconds": 7.64,
      "text": "Your sugar reading in clinic is on the low side and your pulse is a little fast."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.97,
      "end_seconds": 221.37,
      "duration_seconds": 2.4,
      "text": "right, that's the examination finished"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.8,
      "end_seconds": 236.67,
      "duration_seconds": 2.87,
      "text": "Have you had vomiting, by any chance?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 237.58,
      "end_seconds": 239.33,
      "duration_seconds": 1.75,
      "text": "No. No vomiting."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 240.47,
      "end_seconds": 247.46,
      "duration_seconds": 6.99,
      "text": "Actually, uh, doctor, I did notice vomiting. She doesn't always say."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 253.33,
      "end_seconds": 259.99,
      "duration_seconds": 6.66,
      "text": "no, I don't think I did maybe a little, I'm not sure"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.0,
      "end_seconds": 271.37,
      "duration_seconds": 10.37,
      "text": "alright, I'll note both what you've said and what you've noticed a few quick ones: chest pain, seizure or loss of consciousness?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 272.21,
      "end_seconds": 277.17,
      "duration_seconds": 4.96,
      "text": "no, no chest pain, seizure or loss of consciousness"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.82,
      "end_seconds": 280.82,
      "duration_seconds": 3.0,
      "text": "Alright, how are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 282.86,
      "end_seconds": 286.79,
      "duration_seconds": 3.93,
      "text": "Bowels are regular, you know, nothing odd."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.72,
      "end_seconds": 292.12,
      "duration_seconds": 3.4,
      "text": "what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 293.36,
      "end_seconds": 304.0,
      "duration_seconds": 10.64,
      "text": "well, I'm on sitagliptin, 100 milligrams, once a day let me think, I'm on Seretide inhaler, twice a day"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.88,
      "end_seconds": 308.02,
      "duration_seconds": 3.14,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 309.79,
      "end_seconds": 318.82,
      "duration_seconds": 9.03,
      "text": "Nearly five years now. Right, I'm on sumatriptan, 50 milligrams, when needed for my migraines."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 320.14,
      "end_seconds": 327.4,
      "duration_seconds": 7.26,
      "text": "It's a... um, I can't remember what it's called. It's a round yellow one."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.22,
      "end_seconds": 331.7,
      "duration_seconds": 2.48,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 333.12,
      "end_seconds": 343.78,
      "duration_seconds": 10.66,
      "text": "Okay, so for my thyroid, I believe. My daughter sets them out for me, I just take what I'm given."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.63,
      "end_seconds": 348.26,
      "duration_seconds": 3.63,
      "text": "Okay, are you on your own at home?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 349.58,
      "end_seconds": 352.58,
      "duration_seconds": 3.0,
      "text": "I live with my elderly mother"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.34,
      "end_seconds": 358.8,
      "duration_seconds": 4.46,
      "text": "So, what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 362.6,
      "end_seconds": 369.1,
      "duration_seconds": 6.5,
      "text": "I have diabetes. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 370.66,
      "end_seconds": 371.36,
      "duration_seconds": 0.7,
      "text": "ah"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 372.97,
      "end_seconds": 389.63,
      "duration_seconds": 16.66,
      "text": "I have asthma, for five years i kept putting it off, which I know isn't sensible i've got migraines um, uh, I've had an underactive thyroid, yes"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 390.16,
      "end_seconds": 415.07,
      "duration_seconds": 24.91,
      "text": "Yes, diabetes and asthma are known to us, good to have that clear. Okay, so my impression is this: I think we're dealing with recurrent low blood sugar on insulin at this stage. That's my thinking for now, and it may change as we learn more. It could also be a dose that is too high, so we'll keep that open."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 416.89,
      "end_seconds": 420.55,
      "duration_seconds": 3.66,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 421.75,
      "end_seconds": 433.72,
      "duration_seconds": 11.97,
      "text": "I understand the worry. At the moment I'd say it's recurrent low blood sugar on insulin, and we'll know more once the a download of the glucose meter is back."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 446.52,
      "end_seconds": 456.91,
      "duration_seconds": 10.39,
      "text": "I think a download of the glucose meter makes sense here, for hypoglycaemia i think an HbA1c makes sense here, for diabetes review"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 457.8,
      "end_seconds": 460.04,
      "duration_seconds": 2.24,
      "text": "mm, um, alright"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 460.55,
      "end_seconds": 478.92,
      "duration_seconds": 18.37,
      "text": "I'm gonna put you on insulin glargine, 16 units, once a day at bedtime, long term. That should help with diabetes. Always carry sugar and eat something before exercise. Do get help quickly if the symptoms get worse."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 483.51,
      "end_seconds": 485.4,
      "duration_seconds": 1.89,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 488.51,
      "end_seconds": 495.76,
      "duration_seconds": 7.25,
      "text": "I'd like you back in two weeks. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 497.11,
      "end_seconds": 501.98,
      "duration_seconds": 4.87,
      "text": "no, um, that's all thanks a lot"
    }
  ]
}