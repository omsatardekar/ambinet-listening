{
  "schema_version": "1.0",
  "encounter_id": "01988",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.32,
      "end_seconds": 4.62,
      "duration_seconds": 3.3,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.55,
      "end_seconds": 9.43,
      "duration_seconds": 3.88,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.47,
      "end_seconds": 19.67,
      "duration_seconds": 8.2,
      "text": "Uh, I've been feeling tired after the birth, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.02,
      "end_seconds": 26.75,
      "duration_seconds": 2.73,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.68,
      "end_seconds": 37.57,
      "duration_seconds": 9.89,
      "text": "Hm. It was either the end of last month or earlier than that. I couldn't tell you the date."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.1,
      "end_seconds": 42.04,
      "duration_seconds": 2.94,
      "text": "Have you been feeling tearful at times?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.51,
      "end_seconds": 44.63,
      "duration_seconds": 1.12,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.07,
      "end_seconds": 46.44,
      "duration_seconds": 1.37,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.53,
      "end_seconds": 55.67,
      "duration_seconds": 7.14,
      "text": "And there's bleeding that is tailing off as well, about a month now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.59,
      "end_seconds": 61.62,
      "duration_seconds": 4.03,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.56,
      "end_seconds": 72.19,
      "duration_seconds": 3.63,
      "text": "Okay, that's it, just a little longer..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.78,
      "end_seconds": 96.72,
      "duration_seconds": 7.94,
      "text": "Okay: temperature is 36.9 degrees, pulse 75, BP is 111 over 78. And saturation 98 percent."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.34,
      "end_seconds": 102.71,
      "duration_seconds": 4.37,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.37,
      "end_seconds": 106.38,
      "duration_seconds": 2.01,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.54,
      "end_seconds": 125.5,
      "duration_seconds": 6.96,
      "text": "The womb has gone down well and the stitches are healing, with no redness."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.89,
      "end_seconds": 132.58,
      "duration_seconds": 1.69,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.75,
      "end_seconds": 144.97,
      "duration_seconds": 5.22,
      "text": "Have you had thoughts of harming the baby, by any chance?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.46,
      "end_seconds": 151.29,
      "duration_seconds": 4.83,
      "text": "No, I haven't had any thoughts of harming the baby."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.96,
      "end_seconds": 159.31,
      "duration_seconds": 3.35,
      "text": "Have you had any leg swelling or fever?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.96,
      "end_seconds": 163.33,
      "duration_seconds": 3.37,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.64,
      "end_seconds": 171.45,
      "duration_seconds": 3.81,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.13,
      "end_seconds": 176.28,
      "duration_seconds": 4.15,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.38,
      "end_seconds": 183.7,
      "duration_seconds": 2.32,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.22,
      "end_seconds": 186.31,
      "duration_seconds": 1.09,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.07,
      "end_seconds": 191.59,
      "duration_seconds": 3.52,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.22,
      "end_seconds": 206.24,
      "duration_seconds": 13.02,
      "text": "Yes, I had my septum straightened, in my thirties. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.24,
      "end_seconds": 225.53,
      "duration_seconds": 5.29,
      "text": "Has anyone ever diagnosed you with something? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.18,
      "end_seconds": 231.66,
      "duration_seconds": 5.48,
      "text": "I've had diabetes for about ten years now. Yes, low haemoglobin."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.04,
      "end_seconds": 235.69,
      "duration_seconds": 2.65,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.8,
      "end_seconds": 240.1,
      "duration_seconds": 3.3,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.71,
      "end_seconds": 242.27,
      "duration_seconds": 1.56,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.82,
      "end_seconds": 245.22,
      "duration_seconds": 2.4,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.84,
      "end_seconds": 251.01,
      "duration_seconds": 5.17,
      "text": "Okay, are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.05,
      "end_seconds": 267.84,
      "duration_seconds": 12.79,
      "text": "I'm on metformin, 500 milligrams, twice a day. I'm, I'm on iron tablets, once a day. Paracetamol. I take it 1 gram, when needed."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.78,
      "end_seconds": 277.81,
      "duration_seconds": 9.03,
      "text": "Taking everything into account, this looks most like a normal postnatal recovery. The baby blues is also on my list."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.27,
      "end_seconds": 312.99,
      "duration_seconds": 17.72,
      "text": "I'll request a blood count, it'll help with postnatal tiredness. The result will help us decide whether anything more is needed. Rest when the baby sleeps and ask for help; contraception can be discussed at six weeks."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.34,
      "end_seconds": 325.17,
      "duration_seconds": 11.83,
      "text": "Ah. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency. Come back in four weeks. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.21,
      "end_seconds": 330.21,
      "duration_seconds": 2.0,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.04,
      "end_seconds": 335.7,
      "duration_seconds": 1.66,
      "text": "Have a good day."
    }
  ]
}