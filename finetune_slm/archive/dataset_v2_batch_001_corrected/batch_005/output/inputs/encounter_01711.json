{
  "schema_version": "1.0",
  "encounter_id": "01711",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.32,
      "end_seconds": 5.58,
      "duration_seconds": 4.26,
      "text": "Oh good evening doctor thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.91,
      "end_seconds": 14.5,
      "duration_seconds": 4.59,
      "text": "Of course leave it it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 16.41,
      "end_seconds": 20.86,
      "duration_seconds": 4.45,
      "text": "morning, doctor i'll stay and fill in anything that's missed"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.8,
      "end_seconds": 24.94,
      "duration_seconds": 3.14,
      "text": "please do. Extra information is always welcome"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.32,
      "end_seconds": 35.39,
      "duration_seconds": 9.07,
      "text": "yeah, it's a tremor in my right hand at rest i don't know what's causing it"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.21,
      "end_seconds": 38.73,
      "duration_seconds": 2.52,
      "text": "Okay, did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.4,
      "end_seconds": 43.48,
      "duration_seconds": 3.08,
      "text": "For about three months, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.97,
      "end_seconds": 48.31,
      "duration_seconds": 3.34,
      "text": "right how much trouble does it give you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.11,
      "end_seconds": 51.74,
      "duration_seconds": 1.63,
      "text": "Mild I'd say"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.37,
      "end_seconds": 55.58,
      "duration_seconds": 2.21,
      "text": "any other symptoms with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.27,
      "end_seconds": 60.91,
      "duration_seconds": 4.64,
      "text": "actually, it usually comes with a stiff arm"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.38,
      "end_seconds": 67.87,
      "duration_seconds": 6.49,
      "text": "Yeah I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 67.97,
      "end_seconds": 75.12,
      "duration_seconds": 7.15,
      "text": "sorry to cut in doctor quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.36,
      "end_seconds": 78.5,
      "duration_seconds": 2.14,
      "text": "later, thanks please go on"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.19,
      "end_seconds": 83.44,
      "duration_seconds": 4.25,
      "text": "The stiff arm? That's been for about a month."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.35,
      "end_seconds": 87.92,
      "duration_seconds": 3.57,
      "text": "is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.4,
      "end_seconds": 95.49,
      "duration_seconds": 6.09,
      "text": "Well it's... hard to say it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.13,
      "end_seconds": 101.34,
      "duration_seconds": 5.21,
      "text": "take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.74,
      "end_seconds": 115.16,
      "duration_seconds": 12.42,
      "text": "Mostly moderate. As for slowness I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.47,
      "end_seconds": 124.59,
      "duration_seconds": 8.12,
      "text": "Have you had a tremor in your right hand at rest before, or is this the first time?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.6,
      "end_seconds": 130.38,
      "duration_seconds": 4.78,
      "text": "I had a similar thing last winter. It went away."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.38,
      "end_seconds": 135.15,
      "duration_seconds": 2.77,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.88,
      "end_seconds": 150.67,
      "duration_seconds": 13.79,
      "text": "I only drink at family occasions. I have about eight cigarettes in a day. I walk the dog every morning. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.1,
      "end_seconds": 156.98,
      "duration_seconds": 4.88,
      "text": "so, has anything ever caused you a reaction? I mean any allergies"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.52,
      "end_seconds": 169.16,
      "duration_seconds": 10.64,
      "text": "Actually, I had a a reaction to amoxicillin when I was younger, a rash all over, and I've avoided it since."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.59,
      "end_seconds": 181.96,
      "duration_seconds": 1.37,
      "text": "any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.49,
      "end_seconds": 184.05,
      "duration_seconds": 1.56,
      "text": "no surgery, no"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.76,
      "end_seconds": 186.94,
      "duration_seconds": 2.18,
      "text": "tell me your medicines please"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.56,
      "end_seconds": 196.37,
      "duration_seconds": 8.81,
      "text": "Glimepiride, 2 milligrams, before breakfast. Clopidogrel i take it 75 milligrams, once a day for the stent"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 197.02,
      "end_seconds": 204.64,
      "duration_seconds": 7.62,
      "text": "he is supposed to take it once a day, but I can't say he always does"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.42,
      "end_seconds": 210.06,
      "duration_seconds": 4.64,
      "text": "I used to to take sitagliptin but I stopped it"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.84,
      "end_seconds": 213.83,
      "duration_seconds": 1.99,
      "text": "what about your medical history?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.81,
      "end_seconds": 226.08,
      "duration_seconds": 11.27,
      "text": "Uh, you know, I have diabetes, for two years. I have eczema, for two years. I've, I've got heart disease."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.16,
      "end_seconds": 237.82,
      "duration_seconds": 10.66,
      "text": "Okay I can see heart disease in your file as well. Have you had any memory problems loss of smell or constipation?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.53,
      "end_seconds": 245.55,
      "duration_seconds": 6.02,
      "text": "no memory problems, loss of smell or constipation, none of it"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.66,
      "end_seconds": 248.11,
      "duration_seconds": 1.45,
      "text": "How about falls?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.54,
      "end_seconds": 251.18,
      "duration_seconds": 1.64,
      "text": "Definitely no falls."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.12,
      "end_seconds": 257.1,
      "duration_seconds": 1.98,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.16,
      "end_seconds": 259.79,
      "duration_seconds": 1.63,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.04,
      "end_seconds": 264.06,
      "duration_seconds": 3.02,
      "text": "okay and your skin any changes there?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.8,
      "end_seconds": 266.7,
      "duration_seconds": 0.9,
      "text": "skin's normal"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 268.47,
      "end_seconds": 285.59,
      "duration_seconds": 17.12,
      "text": "Here are the numbers, doctor. Height 166 centimetres, BMI works out to 22.9, pulse is 72 beats a minute, BP is 111 over 69, temperature is 36.9 degrees, oxygen saturation is 98 percent, weight 63 kilos."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.35,
      "end_seconds": 291.74,
      "duration_seconds": 1.39,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.6,
      "end_seconds": 297.58,
      "duration_seconds": 3.98,
      "text": "I'll examine you in a second make yourself comfortable"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.87,
      "end_seconds": 299.81,
      "duration_seconds": 0.94,
      "text": "that's alright"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.02,
      "end_seconds": 302.26,
      "duration_seconds": 1.24,
      "text": "breathe out slowly"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.28,
      "end_seconds": 327.8,
      "duration_seconds": 8.52,
      "text": "There is a pill-rolling tremor at rest on the right and the arm is stiff with a cogwheel feel."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.97,
      "end_seconds": 333.49,
      "duration_seconds": 2.52,
      "text": "good, you can sit up again"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.67,
      "end_seconds": 367.75,
      "duration_seconds": 25.08,
      "text": "okay, so my impression is this: The most likely explanation is possible Parkinson's disease. Another possibility is a drug-induced tremor. An essential tremor is also on my list. Let me just check I've got this right. You've had a tremor in your right hand at rest for about three months, mild, and no constipation or loss of smell"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 369.29,
      "end_seconds": 370.86,
      "duration_seconds": 1.57,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 372.24,
      "end_seconds": 380.44,
      "duration_seconds": 8.2,
      "text": "I'm referring you to the specialist and meanwhile keep active. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 382.42,
      "end_seconds": 386.68,
      "duration_seconds": 4.26,
      "text": "great, uh, thank you for your help"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 387.28,
      "end_seconds": 389.64,
      "duration_seconds": 2.36,
      "text": "Have a a good day."
    }
  ]
}