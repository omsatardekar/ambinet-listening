{
  "schema_version": "1.0",
  "encounter_id": "01719",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.19,
      "end_seconds": 7.57,
      "duration_seconds": 6.38,
      "text": "All set here, doctor. Chart's updated, and I'll read the readings out when you're ready."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.98,
      "end_seconds": 16.03,
      "duration_seconds": 4.05,
      "text": "Right, perfect, thanks. Hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 17.3,
      "end_seconds": 22.5,
      "duration_seconds": 5.2,
      "text": "Oh, I'm here because of swollen painful finger joints."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.41,
      "end_seconds": 27.61,
      "duration_seconds": 3.2,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 28.55,
      "end_seconds": 30.48,
      "duration_seconds": 1.93,
      "text": "About... well, two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.62,
      "end_seconds": 40.86,
      "duration_seconds": 9.24,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 42.55,
      "end_seconds": 53.92,
      "duration_seconds": 11.37,
      "text": "Pretty severe, if I'm being honest. Honestly, a couple of times a week. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.74,
      "end_seconds": 58.01,
      "duration_seconds": 3.27,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 58.62,
      "end_seconds": 69.77,
      "duration_seconds": 11.15,
      "text": "When it starts I tend to get sore wrists as well. Oh, about sore wrists, it happens every other day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.87,
      "end_seconds": 75.09,
      "duration_seconds": 3.22,
      "text": "Have you had any fever or chest pain?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 76.56,
      "end_seconds": 80.31,
      "duration_seconds": 3.75,
      "text": "I haven't had fever or chest pain, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.64,
      "end_seconds": 84.61,
      "duration_seconds": 3.97,
      "text": "Right, right. Did you get eye redness or rash?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 86.57,
      "end_seconds": 90.68,
      "duration_seconds": 4.11,
      "text": "No eye redness or rash, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.27,
      "end_seconds": 94.67,
      "duration_seconds": 2.4,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 96.75,
      "end_seconds": 98.69,
      "duration_seconds": 1.94,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.69,
      "end_seconds": 102.44,
      "duration_seconds": 1.75,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 103.62,
      "end_seconds": 105.29,
      "duration_seconds": 1.67,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.58,
      "end_seconds": 114.59,
      "duration_seconds": 2.01,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 115.18,
      "end_seconds": 120.09,
      "duration_seconds": 4.91,
      "text": "Just a meniscus repair on my knee, four years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.81,
      "end_seconds": 123.7,
      "duration_seconds": 2.89,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 124.77,
      "end_seconds": 127.85,
      "duration_seconds": 3.08,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.57,
      "end_seconds": 132.88,
      "duration_seconds": 4.31,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 138.81,
      "end_seconds": 142.83,
      "duration_seconds": 4.02,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.41,
      "end_seconds": 146.64,
      "duration_seconds": 2.23,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 148.18,
      "end_seconds": 150.72,
      "duration_seconds": 2.54,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.52,
      "end_seconds": 172.65,
      "duration_seconds": 3.13,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 173.71,
      "end_seconds": 178.14,
      "duration_seconds": 4.43,
      "text": "I mean, uh, my aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.15,
      "end_seconds": 182.11,
      "duration_seconds": 1.96,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 183.02,
      "end_seconds": 187.64,
      "duration_seconds": 4.62,
      "text": "I take alendronate, once a week for my bones."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.26,
      "end_seconds": 191.38,
      "duration_seconds": 2.12,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 192.81,
      "end_seconds": 199.9,
      "duration_seconds": 7.09,
      "text": "70 milligrams, I think that's what's on the box. Ibuprofen, 400 milligrams, when needed."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.21,
      "end_seconds": 203.85,
      "duration_seconds": 3.64,
      "text": "Okay, go on. Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 205.57,
      "end_seconds": 211.36,
      "duration_seconds": 5.79,
      "text": "I have thin bones. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 213.26,
      "end_seconds": 219.58,
      "duration_seconds": 6.32,
      "text": "Here are the numbers, doctor. Respiratory rate 14, blood pressure 119 over 78, pulse 78."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.24,
      "end_seconds": 222.74,
      "duration_seconds": 1.5,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.69,
      "end_seconds": 228.36,
      "duration_seconds": 3.67,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.33,
      "end_seconds": 230.7,
      "duration_seconds": 1.37,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.97,
      "end_seconds": 246.78,
      "duration_seconds": 5.81,
      "text": "The knuckles and wrists are swollen and warm, and the squeeze test is painful."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.52,
      "end_seconds": 255.01,
      "duration_seconds": 3.49,
      "text": "Alright, good, you can sit up again."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.57,
      "end_seconds": 282.26,
      "duration_seconds": 10.69,
      "text": "Having listened and examined, it fits best with an inflammatory arthritis flare. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 283.02,
      "end_seconds": 284.61,
      "duration_seconds": 1.59,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.09,
      "end_seconds": 300.2,
      "duration_seconds": 14.11,
      "text": "Nothing I've seen today points to an emergency. It looks like an inflammatory arthritis flare, but I'd like to confirm. I think blood tests makes sense here, for inflammatory arthritis."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 302.22,
      "end_seconds": 303.6,
      "duration_seconds": 1.38,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.76,
      "end_seconds": 327.19,
      "duration_seconds": 22.43,
      "text": "We should do X-rays of the hands for inflammatory arthritis. That will help us see what's going on underneath and decide the next step. I'm prescribing methotrexate, 10 milligrams, once a week, long term. That's for inflammatory arthritis. Gentle hand exercises and warm water in the morning."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.44,
      "end_seconds": 337.43,
      "duration_seconds": 9.99,
      "text": "Mm, okay. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 339.36,
      "end_seconds": 341.41,
      "duration_seconds": 2.05,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.97,
      "end_seconds": 346.57,
      "duration_seconds": 4.6,
      "text": "Come back in four weeks. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 350.85,
      "end_seconds": 355.35,
      "duration_seconds": 4.5,
      "text": "Right, you know, I'll do that. Thank you, doctor."
    }
  ]
}