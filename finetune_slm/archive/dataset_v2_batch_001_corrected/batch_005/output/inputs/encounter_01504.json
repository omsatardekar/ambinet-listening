{
  "schema_version": "1.0",
  "encounter_id": "01504",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.3,
      "end_seconds": 6.93,
      "duration_seconds": 5.63,
      "text": "Doctor, this one's ready for you. Everything's on the chart, but I'll go through it."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.09,
      "end_seconds": 11.52,
      "duration_seconds": 3.43,
      "text": "Perfect, thanks. Hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 12.25,
      "end_seconds": 20.38,
      "duration_seconds": 8.13,
      "text": "Honestly, it's a painful blistering rash on one side, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.68,
      "end_seconds": 23.87,
      "duration_seconds": 2.19,
      "text": "Is anything making it worse?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 24.75,
      "end_seconds": 27.87,
      "duration_seconds": 3.12,
      "text": "Yes, touch. That makes it worse."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.02,
      "end_seconds": 31.08,
      "duration_seconds": 2.06,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 32.28,
      "end_seconds": 43.93,
      "duration_seconds": 11.65,
      "text": "Sensitivity to clothes touching goes along with it, most of the time. The sensitivity to clothes touching? That's been for six months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.59,
      "end_seconds": 48.15,
      "duration_seconds": 2.56,
      "text": "What aggravates it, if anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 49.61,
      "end_seconds": 52.3,
      "duration_seconds": 2.69,
      "text": "Clothes definitely sets it off."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.88,
      "end_seconds": 55.99,
      "duration_seconds": 2.11,
      "text": "Have you been feeling unwell?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 56.81,
      "end_seconds": 59.76,
      "duration_seconds": 2.95,
      "text": "Yes, about the same, one week."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.27,
      "end_seconds": 70.28,
      "duration_seconds": 6.01,
      "text": "Have you noticed rash across the midline, eye involvement, weakness or fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 70.87,
      "end_seconds": 77.75,
      "duration_seconds": 6.88,
      "text": "No rash across the midline, eye involvement, weakness or fever, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.43,
      "end_seconds": 81.19,
      "duration_seconds": 2.76,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 82.15,
      "end_seconds": 83.83,
      "duration_seconds": 1.68,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.49,
      "end_seconds": 88.17,
      "duration_seconds": 2.68,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 89.76,
      "end_seconds": 91.24,
      "duration_seconds": 1.48,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.96,
      "end_seconds": 108.61,
      "duration_seconds": 3.65,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 109.11,
      "end_seconds": 125.27,
      "duration_seconds": 16.16,
      "text": "I'm on carvedilol, 6.25 milligrams, twice a day. I'm on tamsulosin, 0.4 milligrams, at night. My family kept telling me to get it checked. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.69,
      "end_seconds": 126.5,
      "duration_seconds": 0.81,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.47,
      "end_seconds": 140.51,
      "duration_seconds": 4.04,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 141.42,
      "end_seconds": 145.17,
      "duration_seconds": 3.75,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.59,
      "end_seconds": 148.55,
      "duration_seconds": 1.96,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 150.46,
      "end_seconds": 153.61,
      "duration_seconds": 3.15,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.08,
      "end_seconds": 158.91,
      "duration_seconds": 3.83,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 159.56,
      "end_seconds": 161.47,
      "duration_seconds": 1.91,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.12,
      "end_seconds": 168.17,
      "duration_seconds": 3.05,
      "text": "Right, do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 168.85,
      "end_seconds": 178.36,
      "duration_seconds": 9.51,
      "text": "I have heart failure, for nearly five years. I mean, I have an enlarged prostate, for nearly five years."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.13,
      "end_seconds": 182.96,
      "duration_seconds": 3.83,
      "text": "Alright, heart failure, that matches what I have here."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.98,
      "end_seconds": 193.23,
      "duration_seconds": 3.25,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 196.3,
      "end_seconds": 198.92,
      "duration_seconds": 2.62,
      "text": "My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 200.96,
      "end_seconds": 210.02,
      "duration_seconds": 9.06,
      "text": "Doctor, I've got the readings for you. Temp 37.0 degrees, heart rate 86. Pressure 123 over 78, saturation 99 percent."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.7,
      "end_seconds": 211.4,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.03,
      "end_seconds": 218.09,
      "duration_seconds": 4.06,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 218.6,
      "end_seconds": 219.66,
      "duration_seconds": 1.06,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.89,
      "end_seconds": 223.3,
      "duration_seconds": 2.41,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.3,
      "end_seconds": 245.23,
      "duration_seconds": 7.93,
      "text": "There are grouped blisters on a red base along one band on the right side and none cross the midline."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.08,
      "end_seconds": 275.24,
      "duration_seconds": 27.16,
      "text": "Right, that's the examination finished. So, based on the history and the examination, I'd lean towards shingles. I'd also keep contact dermatitis in mind. We'll begin with aciclovir, 800 milligrams, five times a day, seven days. You take it by mouth. That's for shingles. Keep the rash covered and stay away from pregnant women and newborn babies until it has crusted."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.31,
      "end_seconds": 296.83,
      "duration_seconds": 15.52,
      "text": "One warning sign to remember: the rash spreads to your face or eye. In that case don't wait. Please come and see me in one week. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 297.73,
      "end_seconds": 301.03,
      "duration_seconds": 3.3,
      "text": "I think I understand everything. Thanks."
    }
  ]
}