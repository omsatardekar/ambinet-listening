{
  "schema_version": "1.0",
  "encounter_id": "01961",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.02,
      "end_seconds": 6.9,
      "duration_seconds": 5.88,
      "text": "Alright, afternoon, thanks for coming in. What do you need help with?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.56,
      "end_seconds": 15.63,
      "duration_seconds": 8.07,
      "text": "Honestly, it's a stiff neck after sleeping badly, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.3,
      "end_seconds": 18.4,
      "duration_seconds": 2.1,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.38,
      "end_seconds": 23.36,
      "duration_seconds": 3.98,
      "text": "Well, it's been one week, I'm fairly sure."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.72,
      "end_seconds": 34.94,
      "duration_seconds": 11.22,
      "text": "Hm, okay. Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 35.45,
      "end_seconds": 44.61,
      "duration_seconds": 9.16,
      "text": "Turning definitely sets it off. A four out of ten, I suppose. It settles a little with heat."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.86,
      "end_seconds": 65.51,
      "duration_seconds": 2.65,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.07,
      "end_seconds": 70.38,
      "duration_seconds": 2.31,
      "text": "Epilepsy, for five years."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.36,
      "end_seconds": 76.93,
      "duration_seconds": 4.57,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.5,
      "end_seconds": 87.38,
      "duration_seconds": 9.88,
      "text": "I had a reaction to trimethoprim when I was younger, a rash, and I've avoided it since."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.16,
      "end_seconds": 90.36,
      "duration_seconds": 1.2,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.61,
      "end_seconds": 94.83,
      "duration_seconds": 3.22,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.55,
      "end_seconds": 98.03,
      "duration_seconds": 2.48,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 99.74,
      "end_seconds": 121.11,
      "duration_seconds": 21.37,
      "text": "I used to drink heavily but I stopped four years ago. I quit smoking around ten years ago. I walk the dog every morning. Lots of rice, lentils and some fruit. I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.68,
      "end_seconds": 126.04,
      "duration_seconds": 4.36,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 126.7,
      "end_seconds": 131.76,
      "duration_seconds": 5.06,
      "text": "Lamotrigine, 100 milligrams, twice a day for the fits."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.7,
      "end_seconds": 135.95,
      "duration_seconds": 2.25,
      "text": "Did you notice any fever?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 138.05,
      "end_seconds": 139.73,
      "duration_seconds": 1.68,
      "text": "No. No fever."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.98,
      "end_seconds": 145.02,
      "duration_seconds": 4.04,
      "text": "Did you get head injury, headache or arm numbness?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 145.93,
      "end_seconds": 150.57,
      "duration_seconds": 4.64,
      "text": "No, no head injury, headache or arm numbness."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.81,
      "end_seconds": 160.96,
      "duration_seconds": 5.15,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 162.55,
      "end_seconds": 165.92,
      "duration_seconds": 3.37,
      "text": "Let me think, no, that's all normal."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.16,
      "end_seconds": 173.85,
      "duration_seconds": 2.69,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.55,
      "end_seconds": 177.35,
      "duration_seconds": 1.8,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.15,
      "end_seconds": 181.9,
      "duration_seconds": 2.75,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.68,
      "end_seconds": 198.17,
      "duration_seconds": 2.49,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.44,
      "end_seconds": 214.76,
      "duration_seconds": 6.32,
      "text": "Okay: pulse 74, temperature 36.6. And pressure 119 over 74, saturation 97 percent."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 218.92,
      "end_seconds": 221.18,
      "duration_seconds": 2.26,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.92,
      "end_seconds": 228.15,
      "duration_seconds": 2.23,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.08,
      "end_seconds": 235.83,
      "duration_seconds": 4.75,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.83,
      "end_seconds": 238.51,
      "duration_seconds": 1.68,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.51,
      "end_seconds": 260.09,
      "duration_seconds": 5.58,
      "text": "The neck muscles on the left are tight and the movements are full."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 263.27,
      "end_seconds": 265.78,
      "duration_seconds": 2.51,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.4,
      "end_seconds": 281.47,
      "duration_seconds": 8.07,
      "text": "So, based on the history and the examination, it fits best with a simple neck muscle strain."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.05,
      "end_seconds": 315.52,
      "duration_seconds": 21.47,
      "text": "Heat, gentle neck rolls, and a supportive pillow. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. Book a review if not better in two weeks. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 316.75,
      "end_seconds": 319.51,
      "duration_seconds": 2.76,
      "text": "I think I understand everything. Thanks."
    }
  ]
}