{
  "schema_version": "1.0",
  "encounter_id": "01880",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.77,
      "end_seconds": 7.36,
      "duration_seconds": 6.59,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.0,
      "end_seconds": 12.78,
      "duration_seconds": 3.78,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.32,
      "end_seconds": 17.74,
      "duration_seconds": 3.42,
      "text": "Yeah, doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.28,
      "end_seconds": 21.68,
      "duration_seconds": 3.4,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 23.4,
      "end_seconds": 29.33,
      "duration_seconds": 5.93,
      "text": "It's been feeling faint, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.39,
      "end_seconds": 33.74,
      "duration_seconds": 2.35,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.72,
      "end_seconds": 41.56,
      "duration_seconds": 3.84,
      "text": "It's been about a month, I'm fairly sure."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.59,
      "end_seconds": 48.72,
      "duration_seconds": 5.13,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.97,
      "end_seconds": 53.86,
      "duration_seconds": 3.89,
      "text": "It's a couple of times a week."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.64,
      "end_seconds": 57.51,
      "duration_seconds": 2.87,
      "text": "Have you tried anything for it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.65,
      "end_seconds": 64.14,
      "duration_seconds": 5.49,
      "text": "Lying down helps a bit. I'd been sweating, but that went away."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.05,
      "end_seconds": 69.57,
      "duration_seconds": 4.52,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.05,
      "end_seconds": 83.29,
      "duration_seconds": 2.24,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.02,
      "end_seconds": 104.42,
      "duration_seconds": 9.4,
      "text": "Okay: temperature is 37.0 degrees, heart rate 93. And blood pressure 94 over 61, SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.98,
      "end_seconds": 110.47,
      "duration_seconds": 1.49,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.67,
      "end_seconds": 114.93,
      "duration_seconds": 3.26,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.73,
      "end_seconds": 121.03,
      "duration_seconds": 4.3,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.24,
      "end_seconds": 125.65,
      "duration_seconds": 3.41,
      "text": "So, stay as you are for a moment."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.24,
      "end_seconds": 139.84,
      "duration_seconds": 5.6,
      "text": "Your pulse is over one hundred and eighty and your blood pressure is low."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.51,
      "end_seconds": 144.81,
      "duration_seconds": 2.3,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.16,
      "end_seconds": 158.49,
      "duration_seconds": 1.33,
      "text": "Nothing like fever?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.84,
      "end_seconds": 161.54,
      "duration_seconds": 1.7,
      "text": "No fever, thankfully."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.05,
      "end_seconds": 165.39,
      "duration_seconds": 2.34,
      "text": "Any cough or leg swelling?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.85,
      "end_seconds": 172.72,
      "duration_seconds": 2.87,
      "text": "No, no cough or leg swelling."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.31,
      "end_seconds": 177.27,
      "duration_seconds": 1.96,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.0,
      "end_seconds": 182.22,
      "duration_seconds": 3.22,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.5,
      "end_seconds": 186.42,
      "duration_seconds": 2.92,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.38,
      "end_seconds": 195.06,
      "duration_seconds": 6.68,
      "text": "Yes, I had a meniscus repair on my knee, four years ago."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.58,
      "end_seconds": 199.76,
      "duration_seconds": 3.18,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.73,
      "end_seconds": 202.66,
      "duration_seconds": 1.93,
      "text": "I've got heart disease."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.52,
      "end_seconds": 208.75,
      "duration_seconds": 5.23,
      "text": "Okay, I can see heart disease in your file as well. Any smoking?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.32,
      "end_seconds": 211.58,
      "duration_seconds": 2.26,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.67,
      "end_seconds": 214.95,
      "duration_seconds": 1.28,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.76,
      "end_seconds": 220.63,
      "duration_seconds": 3.87,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.26,
      "end_seconds": 224.03,
      "duration_seconds": 2.77,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.43,
      "end_seconds": 231.56,
      "duration_seconds": 3.13,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.29,
      "end_seconds": 235.48,
      "duration_seconds": 2.19,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.32,
      "end_seconds": 241.26,
      "duration_seconds": 3.94,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.22,
      "end_seconds": 247.12,
      "duration_seconds": 4.9,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.75,
      "end_seconds": 250.1,
      "duration_seconds": 2.35,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.65,
      "end_seconds": 271.51,
      "duration_seconds": 2.86,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.1,
      "end_seconds": 273.35,
      "duration_seconds": 1.25,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.78,
      "end_seconds": 285.48,
      "duration_seconds": 3.7,
      "text": "I'll request blood tests, it'll help with arrhythmia."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.16,
      "end_seconds": 288.04,
      "duration_seconds": 1.88,
      "text": "Is that done today?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.92,
      "end_seconds": 320.75,
      "duration_seconds": 31.83,
      "text": "I'll request an urgent ECG, it'll help with fast heart rhythm. Lie flat, I am calling the emergency team and preparing to shock the heart. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. Let's get you seen by the emergency team, I'll arrange the letter. Come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.01,
      "end_seconds": 324.82,
      "duration_seconds": 2.81,
      "text": "Okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.58,
      "end_seconds": 332.42,
      "duration_seconds": 5.84,
      "text": "I'd like to see you again straight away. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.84,
      "end_seconds": 336.08,
      "duration_seconds": 2.24,
      "text": "Thank you, that's helpful."
    }
  ]
}