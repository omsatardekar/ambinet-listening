{
  "schema_version": "1.0",
  "encounter_id": "01661",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.29,
      "end_seconds": 5.63,
      "duration_seconds": 4.34,
      "text": "So, hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.05,
      "end_seconds": 10.73,
      "duration_seconds": 3.68,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.91,
      "end_seconds": 19.05,
      "duration_seconds": 7.14,
      "text": "Well, hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.74,
      "end_seconds": 24.29,
      "duration_seconds": 4.55,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.81,
      "end_seconds": 32.68,
      "duration_seconds": 6.87,
      "text": "Yeah, it's swollen painful finger joints. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.56,
      "end_seconds": 40.79,
      "duration_seconds": 3.23,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.24,
      "end_seconds": 44.61,
      "duration_seconds": 2.37,
      "text": "About... well, three weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.48,
      "end_seconds": 56.36,
      "duration_seconds": 9.88,
      "text": "Okay, can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.38,
      "end_seconds": 62.66,
      "duration_seconds": 4.28,
      "text": "I mean, honestly, all the time. Mild, really."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.61,
      "end_seconds": 66.34,
      "duration_seconds": 2.73,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.92,
      "end_seconds": 99.28,
      "duration_seconds": 32.36,
      "text": "Hmm, it usually comes with tiredness. Oh, and sore wrists. Had that since last Tuesday. As for sore wrists, I'd say every other day. Okay, so as for morning stiffness for an hour, I honestly can't say when that began. It might have been last month or the month before. Um, with morning stiffness for an hour, about a eight out of ten."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.15,
      "end_seconds": 103.14,
      "duration_seconds": 2.99,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.03,
      "end_seconds": 119.52,
      "duration_seconds": 15.49,
      "text": "I have about eight cigarettes in a day. Nothing, I'm teetotal. I look after my grandchildren most days. Not much, I mostly stay in these days. My partner and our baby."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.72,
      "end_seconds": 123.49,
      "duration_seconds": 2.77,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.31,
      "end_seconds": 127.96,
      "duration_seconds": 2.65,
      "text": "I've got anxiety. Yes, gout."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.64,
      "end_seconds": 132.78,
      "duration_seconds": 4.14,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.69,
      "end_seconds": 141.31,
      "duration_seconds": 6.62,
      "text": "Um, my father had bowel cancer. My mother had a stroke."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.33,
      "end_seconds": 144.85,
      "duration_seconds": 2.52,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.59,
      "end_seconds": 148.49,
      "duration_seconds": 2.9,
      "text": "No surgery, uh, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.92,
      "end_seconds": 159.34,
      "duration_seconds": 3.42,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.8,
      "end_seconds": 165.19,
      "duration_seconds": 4.39,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 166.24,
      "end_seconds": 174.43,
      "duration_seconds": 8.19,
      "text": "Okay, uh, so I'm not sure that's right. I seem to recall a problem with tramadol."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.42,
      "end_seconds": 181.18,
      "duration_seconds": 4.76,
      "text": "Hmm, maybe, but I don't recall it."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.08,
      "end_seconds": 188.9,
      "duration_seconds": 6.82,
      "text": "Alright, so that's unclear. I'll record what each of you said. What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.58,
      "end_seconds": 195.65,
      "duration_seconds": 6.07,
      "text": "Right, um, I'm on escitalopram, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.3,
      "end_seconds": 199.24,
      "duration_seconds": 1.94,
      "text": "When did you start it?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.78,
      "end_seconds": 202.81,
      "duration_seconds": 2.03,
      "text": "About about a year."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.23,
      "end_seconds": 204.19,
      "duration_seconds": 0.96,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.59,
      "end_seconds": 208.22,
      "duration_seconds": 2.63,
      "text": "It's allopurinol, once a day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.5,
      "end_seconds": 211.8,
      "duration_seconds": 2.3,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.39,
      "end_seconds": 226.77,
      "duration_seconds": 9.38,
      "text": "100 milligrams, I think that's what's on the box. I take ibuprofen, 400 milligrams, when needed."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.67,
      "end_seconds": 248.93,
      "duration_seconds": 4.26,
      "text": "Did you get chest pain, rash, eye redness or fever?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.71,
      "end_seconds": 257.53,
      "duration_seconds": 6.82,
      "text": "No chest pain, rash, eye redness or fever, none of it."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.45,
      "end_seconds": 260.78,
      "duration_seconds": 2.33,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.29,
      "end_seconds": 264.37,
      "duration_seconds": 3.08,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.08,
      "end_seconds": 275.45,
      "duration_seconds": 3.37,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.71,
      "end_seconds": 291.12,
      "duration_seconds": 2.41,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.98,
      "end_seconds": 317.08,
      "duration_seconds": 10.1,
      "text": "Okay: BP is 115 over 72, oxygen saturation is 99 percent, temp 36.5 degrees. And respiratory rate 15, heart rate 84."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.12,
      "end_seconds": 319.81,
      "duration_seconds": 1.69,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.71,
      "end_seconds": 325.37,
      "duration_seconds": 3.66,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.63,
      "end_seconds": 329.57,
      "duration_seconds": 2.94,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.16,
      "end_seconds": 332.96,
      "duration_seconds": 1.8,
      "text": "Alright, nearly finished here."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.65,
      "end_seconds": 354.81,
      "duration_seconds": 6.16,
      "text": "The knuckles and wrists are swollen and warm, and the squeeze test is painful."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.92,
      "end_seconds": 367.83,
      "duration_seconds": 9.91,
      "text": "Alright, that's the examination finished. So where does that leave us? I'd lean towards an inflammatory arthritis flare. Another possibility is osteoarthritis."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 372.62,
      "end_seconds": 374.13,
      "duration_seconds": 1.51,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 376.19,
      "end_seconds": 407.35,
      "duration_seconds": 31.16,
      "text": "I can't promise yet, but most people with an inflammatory arthritis flare do well once it's treated properly. Let's get X-rays of the hands, for inflammatory arthritis. I'm sending you for blood tests because of inflammatory arthritis. I'm going to put you on methotrexate, 10 milligrams, once a week, long term. That should help with inflammatory arthritis. I'll put all of this in writing so you don't have to remember it."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 408.22,
      "end_seconds": 417.51,
      "duration_seconds": 9.29,
      "text": "Gentle hand exercises and warm water in the morning. Come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 419.31,
      "end_seconds": 420.89,
      "duration_seconds": 1.58,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 423.66,
      "end_seconds": 426.41,
      "duration_seconds": 2.75,
      "text": "Let's review you in four weeks."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 428.46,
      "end_seconds": 431.79,
      "duration_seconds": 3.33,
      "text": "Uh, good, I'll return then."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 433.69,
      "end_seconds": 439.91,
      "duration_seconds": 6.22,
      "text": "Tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 442.79,
      "end_seconds": 453.62,
      "duration_seconds": 10.83,
      "text": "So, I take the methotrexate, 10 milligrams, once a week and come back in four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 455.33,
      "end_seconds": 459.87,
      "duration_seconds": 4.54,
      "text": "Yes, exactly right. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 460.82,
      "end_seconds": 465.57,
      "duration_seconds": 4.75,
      "text": "Ah, you know, alright, thanks, take care."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 466.97,
      "end_seconds": 468.39,
      "duration_seconds": 1.42,
      "text": "See you soon."
    }
  ]
}