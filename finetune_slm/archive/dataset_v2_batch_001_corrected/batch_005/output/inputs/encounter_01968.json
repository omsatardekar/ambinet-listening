{
  "schema_version": "1.0",
  "encounter_id": "01968",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.31,
      "end_seconds": 3.84,
      "duration_seconds": 2.53,
      "text": "Right then, come on in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 5.04,
      "end_seconds": 12.33,
      "duration_seconds": 7.29,
      "text": "Doctor, I'll sit in if that's okay, I know what's been happening."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.61,
      "end_seconds": 21.4,
      "duration_seconds": 7.79,
      "text": "Of course, please stay. It's helpful to have you here. You came on your own today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 25.99,
      "end_seconds": 30.8,
      "duration_seconds": 4.81,
      "text": "Yes, um, I managed on my own."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.41,
      "end_seconds": 36.48,
      "duration_seconds": 2.07,
      "text": "What's the main thing today?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 38.35,
      "end_seconds": 58.42,
      "duration_seconds": 20.07,
      "text": "Oh, you know, so the thing is, I've got a tremor in my right hand at rest. I told my wife I'd come today. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.87,
      "end_seconds": 62.43,
      "duration_seconds": 1.56,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 64.16,
      "end_seconds": 67.9,
      "duration_seconds": 3.74,
      "text": "Well, for three days, I'd say."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.7,
      "end_seconds": 72.03,
      "duration_seconds": 2.33,
      "text": "Is there something that settles it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 73.97,
      "end_seconds": 77.92,
      "duration_seconds": 3.95,
      "text": "It settles a little with using the hand."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.81,
      "end_seconds": 81.72,
      "duration_seconds": 2.91,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 86.11,
      "end_seconds": 98.38,
      "duration_seconds": 12.27,
      "text": "I'd give it a eight, uh, out of ten. There was a stiff arm, yes, but that went away."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.55,
      "end_seconds": 113.13,
      "duration_seconds": 4.58,
      "text": "Right, any constipation, loss of smell, falls or memory problems?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 114.58,
      "end_seconds": 117.57,
      "duration_seconds": 2.99,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.1,
      "end_seconds": 121.04,
      "duration_seconds": 1.94,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 122.36,
      "end_seconds": 123.83,
      "duration_seconds": 1.47,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.69,
      "end_seconds": 128.53,
      "duration_seconds": 3.84,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 130.24,
      "end_seconds": 133.47,
      "duration_seconds": 3.23,
      "text": "Well, no, nothing with my heart."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.86,
      "end_seconds": 144.23,
      "duration_seconds": 3.37,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 145.86,
      "end_seconds": 150.52,
      "duration_seconds": 4.66,
      "text": "I'm allergic to milk, I get a rash."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 151.03,
      "end_seconds": 154.83,
      "duration_seconds": 3.8,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 155.79,
      "end_seconds": 161.19,
      "duration_seconds": 5.4,
      "text": "Yeah, it's metoprolol, twice a day for my heart, doctor."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.52,
      "end_seconds": 164.59,
      "duration_seconds": 2.07,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 166.68,
      "end_seconds": 167.65,
      "duration_seconds": 0.97,
      "text": "50 milligrams."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.15,
      "end_seconds": 171.67,
      "duration_seconds": 2.52,
      "text": "Right, when did you start it?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 172.59,
      "end_seconds": 174.12,
      "duration_seconds": 1.53,
      "text": "About six months."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.9,
      "end_seconds": 177.16,
      "duration_seconds": 2.26,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 183.04,
      "end_seconds": 202.67,
      "duration_seconds": 19.63,
      "text": "I've, I've had heart failure, yes. I wasn't sure whether to come in at all, to be honest. Let me think, I've had arthritis in my knees, yes. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.67,
      "end_seconds": 208.68,
      "duration_seconds": 5.01,
      "text": "Yes, heart failure is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.39,
      "end_seconds": 221.49,
      "duration_seconds": 2.1,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 223.41,
      "end_seconds": 229.29,
      "duration_seconds": 5.88,
      "text": "I had a wisdom tooth extraction under sedation five years ago."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.39,
      "end_seconds": 237.36,
      "duration_seconds": 1.97,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 238.7,
      "end_seconds": 241.72,
      "duration_seconds": 3.02,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.77,
      "end_seconds": 246.22,
      "duration_seconds": 2.45,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 248.14,
      "end_seconds": 254.41,
      "duration_seconds": 6.27,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.15,
      "end_seconds": 257.53,
      "duration_seconds": 2.38,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 258.86,
      "end_seconds": 263.34,
      "duration_seconds": 4.48,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.1,
      "end_seconds": 269.37,
      "duration_seconds": 4.27,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.11,
      "end_seconds": 283.73,
      "duration_seconds": 2.62,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.27,
      "end_seconds": 312.33,
      "duration_seconds": 11.06,
      "text": "Okay: temperature is 36.5 degrees, respiratory rate 16, pulse is 72 beats a minute. And SpO2 98 percent on room air, blood pressure 127 over 79."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 314.72,
      "end_seconds": 319.64,
      "duration_seconds": 4.92,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 320.63,
      "end_seconds": 321.81,
      "duration_seconds": 1.18,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 334.26,
      "end_seconds": 341.73,
      "duration_seconds": 7.47,
      "text": "There is a pill-rolling tremor at rest on the right and the arm is stiff with a cogwheel feel."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 345.12,
      "end_seconds": 358.38,
      "duration_seconds": 13.26,
      "text": "All finished, thank you. So where does that leave us? It fits best with possible Parkinson's disease. It could also be a drug-induced tremor, so we'll keep that open."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 359.84,
      "end_seconds": 364.15,
      "duration_seconds": 4.31,
      "text": "Hmm, uh, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 365.54,
      "end_seconds": 384.39,
      "duration_seconds": 18.85,
      "text": "I can't promise yet, but most people with possible Parkinson's disease do well once it's treated properly. Stop me if I've got anything wrong. You've had a tremor in your right hand at rest for three days, and no falls or memory problems."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 385.18,
      "end_seconds": 385.88,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 386.7,
      "end_seconds": 390.42,
      "duration_seconds": 3.72,
      "text": "I'm going to order a blood test, for tremor."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 391.46,
      "end_seconds": 394.69,
      "duration_seconds": 3.23,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 396.08,
      "end_seconds": 412.46,
      "duration_seconds": 16.38,
      "text": "I'm referring you to the specialist and meanwhile keep active. Do get help quickly if the symptoms get worse. See me again after the specialist. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 412.97,
      "end_seconds": 417.58,
      "duration_seconds": 4.61,
      "text": "Great, um, thank you for your help."
    }
  ]
}