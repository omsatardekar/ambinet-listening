{
  "schema_version": "1.0",
  "encounter_id": "01833",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.19,
      "end_seconds": 4.52,
      "duration_seconds": 3.33,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.46,
      "end_seconds": 9.38,
      "duration_seconds": 3.92,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.34,
      "end_seconds": 15.6,
      "duration_seconds": 4.26,
      "text": "so the thing is, I've got a dry mouth"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.33,
      "end_seconds": 20.9,
      "duration_seconds": 3.57,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.38,
      "end_seconds": 25.18,
      "duration_seconds": 2.8,
      "text": "It's been four weeks now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.23,
      "end_seconds": 30.53,
      "duration_seconds": 3.3,
      "text": "would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.76,
      "end_seconds": 44.24,
      "duration_seconds": 9.48,
      "text": "I'd call it moderate. I've been passing little urine too, since Friday. Mm, with passing little urine, moderate, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.16,
      "end_seconds": 52.64,
      "duration_seconds": 6.48,
      "text": "Have you had a dry mouth before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.57,
      "end_seconds": 60.23,
      "duration_seconds": 5.66,
      "text": "I had a similar thing last year. It went away."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.02,
      "end_seconds": 81.98,
      "duration_seconds": 2.96,
      "text": "Any confusion or chest pain at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.98,
      "end_seconds": 85.3,
      "duration_seconds": 2.32,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.38,
      "end_seconds": 90.65,
      "duration_seconds": 3.27,
      "text": "Any blood in the stool or fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.84,
      "end_seconds": 97.12,
      "duration_seconds": 5.28,
      "text": "No blood in the stool or fever, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.95,
      "end_seconds": 101.71,
      "duration_seconds": 2.76,
      "text": "and your skin, any changes there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.57,
      "end_seconds": 104.69,
      "duration_seconds": 1.12,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.55,
      "end_seconds": 108.09,
      "duration_seconds": 1.54,
      "text": "neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.76,
      "end_seconds": 111.16,
      "duration_seconds": 1.4,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.26,
      "end_seconds": 115.59,
      "duration_seconds": 3.33,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.87,
      "end_seconds": 118.97,
      "duration_seconds": 2.1,
      "text": "no allergies at all"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.47,
      "end_seconds": 122.81,
      "duration_seconds": 2.34,
      "text": "what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.61,
      "end_seconds": 129.03,
      "duration_seconds": 4.42,
      "text": "I take lisinopril, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.64,
      "end_seconds": 152.07,
      "duration_seconds": 5.43,
      "text": "so, any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.24,
      "end_seconds": 155.03,
      "duration_seconds": 1.79,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.06,
      "end_seconds": 158.34,
      "duration_seconds": 2.28,
      "text": "alright, how are your meals?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.74,
      "end_seconds": 163.37,
      "duration_seconds": 3.63,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.93,
      "end_seconds": 166.24,
      "duration_seconds": 1.31,
      "text": "what's your work?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.63,
      "end_seconds": 171.35,
      "duration_seconds": 3.72,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.63,
      "end_seconds": 178.18,
      "duration_seconds": 3.55,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.94,
      "end_seconds": 183.31,
      "duration_seconds": 3.37,
      "text": "I've had high blood pressure, yes."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.37,
      "end_seconds": 188.1,
      "duration_seconds": 2.73,
      "text": "right, and anything else to add?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.0,
      "end_seconds": 192.27,
      "duration_seconds": 3.27,
      "text": "I've had asthma for two years now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.32,
      "end_seconds": 197.5,
      "duration_seconds": 4.18,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.04,
      "end_seconds": 207.23,
      "duration_seconds": 2.19,
      "text": "nearly done with the readings.."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.8,
      "end_seconds": 227.62,
      "duration_seconds": 8.82,
      "text": "okay: respiratory rate 19, blood pressure 95 over 66. And pulse 108, SpO2 97 percent on room air"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.99,
      "end_seconds": 231.32,
      "duration_seconds": 2.33,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.25,
      "end_seconds": 239.95,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.77,
      "end_seconds": 243.73,
      "duration_seconds": 1.96,
      "text": "Okay, breathe out slowly."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.82,
      "end_seconds": 266.3,
      "duration_seconds": 7.48,
      "text": "your mouth is dry, your skin is slack, and your blood pressure drops when you stand"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.34,
      "end_seconds": 303.47,
      "duration_seconds": 34.13,
      "text": "That's the examination finished. So where does that leave us? This looks most like dehydration from gastroenteritis. We shouldn't forget a kidney problem from low fluids. I'm going to order blood tests, for dehydration. The result will help us decide whether anything more is needed. Sip fluids little and often and hold your water tablet until you are eating again. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.5,
      "end_seconds": 308.29,
      "duration_seconds": 2.79,
      "text": "see me again in two days"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.3,
      "end_seconds": 312.71,
      "duration_seconds": 3.41,
      "text": "let me think, that's fine with me"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.66,
      "end_seconds": 317.96,
      "duration_seconds": 3.3,
      "text": "So, does all of that make sense?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.39,
      "end_seconds": 325.52,
      "duration_seconds": 3.13,
      "text": "Alright, you know, thanks, take care."
    }
  ]
}