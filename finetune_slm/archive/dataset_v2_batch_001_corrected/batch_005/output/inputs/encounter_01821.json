      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.24,
      "end_seconds": 290.58,
      "duration_seconds": 2.34,
      "text": "I'm just checking this side"
