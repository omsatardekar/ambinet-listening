      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 268.38,
      "end_seconds": 277.24,
      "duration_seconds": 8.86,
      "text": "Doctor, I've got the readings for you. Saturation 97 percent, temperature 36.9, BP is 161 over 96, respiratory rate 15, pulse 79."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.1,
      "end_seconds": 280.62,
      "duration_seconds": 1.52,
      "text": "good, thank you"
