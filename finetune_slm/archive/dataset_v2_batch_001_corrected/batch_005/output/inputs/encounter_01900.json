{
  "schema_version": "1.0",
  "encounter_id": "01900",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.31,
      "end_seconds": 4.15,
      "duration_seconds": 2.84,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.81,
      "end_seconds": 9.28,
      "duration_seconds": 4.47,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.93,
      "end_seconds": 13.07,
      "duration_seconds": 3.14,
      "text": "I've been dealing with an itchy scalp."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.33,
      "end_seconds": 18.27,
      "duration_seconds": 3.94,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.4,
      "end_seconds": 26.39,
      "duration_seconds": 1.99,
      "text": "Allopurinol, once a day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.26,
      "end_seconds": 29.51,
      "duration_seconds": 2.25,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.25,
      "end_seconds": 34.83,
      "duration_seconds": 4.58,
      "text": "100 milligrams. Tiotropium inhaler. I take it once a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.76,
      "end_seconds": 39.55,
      "duration_seconds": 2.79,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.26,
      "end_seconds": 45.24,
      "duration_seconds": 3.98,
      "text": "It's been going on for about three months."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.95,
      "end_seconds": 60.43,
      "duration_seconds": 5.48,
      "text": "Have you had any rash on the body, fever or swollen glands?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.5,
      "end_seconds": 68.7,
      "duration_seconds": 6.2,
      "text": "No rash on the body, fever or swollen glands, none of it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.68,
      "end_seconds": 73.31,
      "duration_seconds": 2.63,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.74,
      "end_seconds": 76.09,
      "duration_seconds": 1.35,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.07,
      "end_seconds": 98.22,
      "duration_seconds": 3.15,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.81,
      "end_seconds": 102.64,
      "duration_seconds": 2.83,
      "text": "I have gout, for two years."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.18,
      "end_seconds": 104.88,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.85,
      "end_seconds": 109.83,
      "duration_seconds": 3.98,
      "text": "I've had COPD for about a year now."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.03,
      "end_seconds": 116.23,
      "duration_seconds": 5.2,
      "text": "Okay, I can see gout and COPD in your file as well."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.35,
      "end_seconds": 137.15,
      "duration_seconds": 4.8,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.91,
      "end_seconds": 143.24,
      "duration_seconds": 4.33,
      "text": "No, uh, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.14,
      "end_seconds": 147.29,
      "duration_seconds": 2.15,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.79,
      "end_seconds": 154.34,
      "duration_seconds": 5.55,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.4,
      "end_seconds": 158.35,
      "duration_seconds": 2.95,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.87,
      "end_seconds": 164.08,
      "duration_seconds": 4.21,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.76,
      "end_seconds": 180.52,
      "duration_seconds": 3.76,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.43,
      "end_seconds": 192.5,
      "duration_seconds": 3.07,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.13,
      "end_seconds": 221.4,
      "duration_seconds": 8.27,
      "text": "Okay: pressure 123 over 82, pulse is 69 beats a minute. And weight 88 kilos, height 183 centimetres."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.2,
      "end_seconds": 224.8,
      "duration_seconds": 1.6,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.57,
      "end_seconds": 228.29,
      "duration_seconds": 2.72,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.15,
      "end_seconds": 235.4,
      "duration_seconds": 4.25,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.27,
      "end_seconds": 238.92,
      "duration_seconds": 1.65,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.86,
      "end_seconds": 264.18,
      "duration_seconds": 6.32,
      "text": "I can see live lice and small eggs close to the roots behind the ears."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.15,
      "end_seconds": 274.83,
      "duration_seconds": 7.68,
      "text": "That's all I needed to check. Let me tell you where I've got to. This is probably head lice."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.61,
      "end_seconds": 278.35,
      "duration_seconds": 2.74,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.92,
      "end_seconds": 297.63,
      "duration_seconds": 15.71,
      "text": "I understand the worry. At the moment I'd say it's head lice, and we'll watch how it goes. For this, dimeticone lotion, 4%, once, repeat after seven days, two applications. That should help with head lice."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.1,
      "end_seconds": 301.37,
      "duration_seconds": 2.27,
      "text": "How soon will it work?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.24,
      "end_seconds": 311.18,
      "duration_seconds": 8.94,
      "text": "Comb the hair with a fine comb every few days and check the family. See me again if lice persist after two treatments."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.0,
      "end_seconds": 312.7,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.32,
      "end_seconds": 316.88,
      "duration_seconds": 2.56,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.53,
      "end_seconds": 320.9,
      "duration_seconds": 2.37,
      "text": "Alright, thanks, take care."
    }
  ]
}