{
  "schema_version": "1.0",
  "encounter_id": "01583",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.75,
      "end_seconds": 4.84,
      "duration_seconds": 4.09,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.22,
      "end_seconds": 11.77,
      "duration_seconds": 5.55,
      "text": "Alright, you're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.79,
      "end_seconds": 16.04,
      "duration_seconds": 2.25,
      "text": "It's ear pain, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.52,
      "end_seconds": 20.45,
      "duration_seconds": 2.93,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.13,
      "end_seconds": 34.22,
      "duration_seconds": 11.09,
      "text": "So, hm. It was either the end of last month or earlier than that. I couldn't tell you the date."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.45,
      "end_seconds": 40.02,
      "duration_seconds": 4.57,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.62,
      "end_seconds": 61.85,
      "duration_seconds": 17.23,
      "text": "Hmm, uh, yes, lying down. That makes it worse. It's all the time. I've been putting this off for weeks. A temperature was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.78,
      "end_seconds": 68.07,
      "duration_seconds": 5.29,
      "text": "Alright, have you had any swelling behind the ear, discharge or hearing loss?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.36,
      "end_seconds": 74.83,
      "duration_seconds": 5.47,
      "text": "Sorry, what was I saying, no, I'd have said so."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.83,
      "end_seconds": 77.78,
      "duration_seconds": 1.95,
      "text": "Nothing like stiff neck?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.55,
      "end_seconds": 81.83,
      "duration_seconds": 3.28,
      "text": "No, none, no stiff neck."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.38,
      "end_seconds": 85.61,
      "duration_seconds": 2.23,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.03,
      "end_seconds": 90.1,
      "duration_seconds": 3.07,
      "text": "Actually, no problems with breathing."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.63,
      "end_seconds": 94.3,
      "duration_seconds": 2.67,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.2,
      "end_seconds": 97.8,
      "duration_seconds": 2.6,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.59,
      "end_seconds": 101.66,
      "duration_seconds": 3.07,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.63,
      "end_seconds": 109.69,
      "duration_seconds": 6.06,
      "text": "Just a wisdom tooth extraction under sedation, five years ago."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.42,
      "end_seconds": 114.33,
      "duration_seconds": 3.91,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.72,
      "end_seconds": 119.07,
      "duration_seconds": 3.35,
      "text": "Yes, milk. I get stomach cramps."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.23,
      "end_seconds": 136.51,
      "duration_seconds": 3.28,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.2,
      "end_seconds": 139.78,
      "duration_seconds": 2.58,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.0,
      "end_seconds": 150.39,
      "duration_seconds": 2.39,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.15,
      "end_seconds": 154.19,
      "duration_seconds": 2.04,
      "text": "I have heart failure."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.95,
      "end_seconds": 166.87,
      "duration_seconds": 7.92,
      "text": "Sure. Okay, I can see heart failure in your file as well. Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.98,
      "end_seconds": 179.75,
      "duration_seconds": 9.77,
      "text": "I swim twice a week. I live with my elderly mother. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.63,
      "end_seconds": 200.66,
      "duration_seconds": 2.03,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.16,
      "end_seconds": 205.88,
      "duration_seconds": 3.72,
      "text": "Spironolactone, 25 milligrams, once a day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.33,
      "end_seconds": 212.79,
      "duration_seconds": 6.46,
      "text": "I see, go ahead. Right, shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.6,
      "end_seconds": 221.54,
      "duration_seconds": 1.94,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.79,
      "end_seconds": 255.96,
      "duration_seconds": 14.17,
      "text": "Okay: pulse is 103 beats a minute, BMI works out to 15.8, blood pressure 107 over 79, height 185 centimetres, temperature is 39.4 degrees, saturation 97 percent, weight 54 kilos."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.38,
      "end_seconds": 261.89,
      "duration_seconds": 4.51,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.73,
      "end_seconds": 263.82,
      "duration_seconds": 1.09,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.63,
      "end_seconds": 266.96,
      "duration_seconds": 1.33,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.6,
      "end_seconds": 290.96,
      "duration_seconds": 6.36,
      "text": "The right ear drum is red and bulging, and the left is normal."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.56,
      "end_seconds": 326.8,
      "duration_seconds": 30.24,
      "text": "That's the examination finished. Putting it all together, I'd lean towards acute middle ear infection. For this, amoxicillin, 250 milligrams, three times a day, five days. That should help with ear infection. The pharmacy will go through the details again when you pick it up. Give pain relief regularly and plenty to drink. Do get help quickly if the symptoms get worse."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.21,
      "end_seconds": 333.5,
      "duration_seconds": 4.29,
      "text": "Okay, um, I'll look out for that."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.24,
      "end_seconds": 338.17,
      "duration_seconds": 3.93,
      "text": "Let's plan a check if not better in two days."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.01,
      "end_seconds": 344.07,
      "duration_seconds": 4.06,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.95,
      "end_seconds": 348.31,
      "duration_seconds": 3.36,
      "text": "Alright, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.87,
      "end_seconds": 353.69,
      "duration_seconds": 3.82,
      "text": "Great, thank you for your help."
    }
  ]
}