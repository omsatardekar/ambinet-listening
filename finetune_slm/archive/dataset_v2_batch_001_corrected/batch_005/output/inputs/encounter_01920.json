  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.74,
      "end_seconds": 3.72,
      "duration_seconds": 2.98,
      "text": "Good morning. I've just opened your notes."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.23,
      "end_seconds": 11.05,
      "duration_seconds": 5.82,
      "text": "Erm, hi doctor, I got here as fast as I could."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.32,
      "end_seconds": 15.3,
      "duration_seconds": 2.98,
      "text": "Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 17.21,
      "end_seconds": 30.43,
      "duration_seconds": 13.22,
      "text": "Yeah, it's heavy bleeding after the birth. I don't know what's causing it. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.03,
      "end_seconds": 37.24,
      "duration_seconds": 2.21,
      "text": "Have you been feeling faint?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.03,
      "end_seconds": 51.79,
      "duration_seconds": 13.76,
      "text": "Mm, um, yes. Okay, so as for feeling faint, it's moderate, honestly. Okay, um, so I'd been passing large clots, but that went away."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.19,
      "end_seconds": 56.18,
      "duration_seconds": 2.99,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.01,
      "end_seconds": 68.19,
      "duration_seconds": 11.18,
      "text": "I'm a hairdresser, on my feet all day. I walk the dog every morning. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.11,
      "end_seconds": 73.51,
      "duration_seconds": 4.4,
      "text": "Okay, what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.18,
      "end_seconds": 80.16,
      "duration_seconds": 4.98,
      "text": "I mean, my mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.08,
      "end_seconds": 84.66,
      "duration_seconds": 2.58,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.31,
      "end_seconds": 91.32,
      "duration_seconds": 5.01,
      "text": "no, uh, nothing as far as I know"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.97,
      "end_seconds": 95.89,
      "duration_seconds": 2.92,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.68,
      "end_seconds": 98.5,
      "duration_seconds": 1.82,
      "text": "I've got asthma."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.08,
      "end_seconds": 103.38,
      "duration_seconds": 4.3,
      "text": "Okay, I can see asthma in your file as well."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.93,
      "end_seconds": 123.82,
      "duration_seconds": 2.89,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.02,
      "end_seconds": 131.65,
      "duration_seconds": 6.63,
      "text": "Yes, I had keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.42,
      "end_seconds": 136.96,
      "duration_seconds": 3.54,
      "text": "do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.79,
      "end_seconds": 141.47,
      "duration_seconds": 3.68,
      "text": "I'm, I'm on Asthalin inhaler, when needed."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.34,
      "end_seconds": 157.34,
      "duration_seconds": 3.0,
      "text": "Any headache, severe pain or fever?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 157.93,
      "end_seconds": 160.07,
      "duration_seconds": 2.14,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.65,
      "end_seconds": 164.11,
      "duration_seconds": 2.46,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 164.79,
      "end_seconds": 167.46,
      "duration_seconds": 2.67,
      "text": "bowels are regular, nothing odd"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.03,
      "end_seconds": 170.9,
      "duration_seconds": 2.87,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 171.63,
      "end_seconds": 173.2,
      "duration_seconds": 1.57,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.02,
      "end_seconds": 188.15,
      "duration_seconds": 3.13,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.89,
      "end_seconds": 202.7,
      "duration_seconds": 2.81,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.03,
      "end_seconds": 231.23,
      "duration_seconds": 8.2,
      "text": "okay: SpO2 99 percent on room air, pulse is 97 beats a minute, blood pressure 100 over 61."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 232.16,
      "end_seconds": 233.89,
      "duration_seconds": 1.73,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.52,
      "end_seconds": 239.14,
      "duration_seconds": 3.62,
      "text": "I'll explain what these mean in a moment"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.71,
      "end_seconds": 246.03,
      "duration_seconds": 4.32,
      "text": "So, I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 247.99,
      "end_seconds": 250.65,
      "duration_seconds": 2.66,
      "text": "Yeah, um, no problem."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.12,
      "end_seconds": 254.7,
      "duration_seconds": 2.58,
      "text": "take a deep breath for me"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.51,
      "end_seconds": 268.03,
      "duration_seconds": 5.52,
      "text": "You are pale and clammy and the womb feels soft and large."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.26,
      "end_seconds": 303.73,
      "duration_seconds": 31.47,
      "text": "Good, you can sit up again. Right, here's what I'm thinking. My working impression is a postpartum haemorrhage. The reason I say that is that your story and my examination fit together. I'd also keep retained tissue in mind. I think urgent blood tests makes sense here, for haemorrhage. I'll request an urgent scan, it'll help with bleeding. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 305.77,
      "end_seconds": 309.83,
      "duration_seconds": 4.06,
      "text": "Actually, um, when would that take place?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.52,
      "end_seconds": 317.69,
      "duration_seconds": 7.17,
      "text": "I'll start you on oxytocin, 10 units, now, single dose. That should help with postpartum bleeding."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 319.61,
      "end_seconds": 321.25,
      "duration_seconds": 1.64,
      "text": "That's simple enough."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 326.69,
      "end_seconds": 340.55,
      "duration_seconds": 13.86,
      "text": "I am rubbing the womb to help it contract, and calling the emergency team. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 342.6,
      "end_seconds": 344.41,
      "duration_seconds": 1.81,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 349.94,
      "end_seconds": 353.13,
      "duration_seconds": 3.19,
      "text": "alright, does all of that make sense?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 358.41,
      "end_seconds": 360.14,
      "duration_seconds": 1.73,
      "text": "that's clear, thanks"
    }
  ]
}