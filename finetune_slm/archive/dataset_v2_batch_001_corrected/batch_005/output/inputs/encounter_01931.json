  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.15,
      "end_seconds": 5.37,
      "duration_seconds": 4.22,
      "text": "Doctor, we're ready in room two, I've already taken the observations."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.2,
      "end_seconds": 10.35,
      "duration_seconds": 4.15,
      "text": "Thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 12.05,
      "end_seconds": 17.04,
      "duration_seconds": 4.99,
      "text": "well, I've been having red sore skin on my shoulders"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 17.72,
      "end_seconds": 27.58,
      "duration_seconds": 9.86,
      "text": "okay, so the vitals from earlier spO2 99 percent on room air, pulse is 78 beats a minute, pressure 119 over 70."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.14,
      "end_seconds": 33.46,
      "duration_seconds": 4.32,
      "text": "Okay, noted. Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 34.13,
      "end_seconds": 37.45,
      "duration_seconds": 3.32,
      "text": "Ever since... since last night, really."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.76,
      "end_seconds": 42.21,
      "duration_seconds": 3.45,
      "text": "Okay, is there anything else with it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 44.03,
      "end_seconds": 63.03,
      "duration_seconds": 19.0,
      "text": "Sorry, you know, what was I saying, it usually comes with tightness of the skin. As for tightness of the skin, moderate, really. I'd say a few times a day."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.5,
      "end_seconds": 68.02,
      "duration_seconds": 4.52,
      "text": "I see, go ahead. Any blisters, vomiting or headache at all?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 69.9,
      "end_seconds": 73.63,
      "duration_seconds": 3.73,
      "text": "no, I haven't had any of them"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.68,
      "end_seconds": 78.05,
      "duration_seconds": 2.37,
      "text": "did you notice any fever?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 79.67,
      "end_seconds": 82.71,
      "duration_seconds": 3.04,
      "text": "Not that I've noticed, no fever."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.85,
      "end_seconds": 85.4,
      "duration_seconds": 1.55,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 86.64,
      "end_seconds": 87.82,
      "duration_seconds": 1.18,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.54,
      "end_seconds": 101.55,
      "duration_seconds": 2.01,
      "text": "do you do any exercise?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 102.25,
      "end_seconds": 105.02,
      "duration_seconds": 2.77,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.5,
      "end_seconds": 110.57,
      "duration_seconds": 4.07,
      "text": "Right, what line of work are you in?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 111.51,
      "end_seconds": 117.24,
      "duration_seconds": 5.73,
      "text": "I'm a bus driver, so I sit for long hours"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.65,
      "end_seconds": 122.08,
      "duration_seconds": 3.43,
      "text": "Alright, have you ever had an operation?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 122.84,
      "end_seconds": 138.27,
      "duration_seconds": 15.43,
      "text": "Erm, just a varicose vein procedure, last year. My sister suggested writing things down, but I forgot. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.49,
      "end_seconds": 160.47,
      "duration_seconds": 3.98,
      "text": "Which medicines do you take at the the moment?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 161.3,
      "end_seconds": 164.28,
      "duration_seconds": 2.98,
      "text": "Simvastatin, 20 milligrams, at night."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.91,
      "end_seconds": 170.09,
      "duration_seconds": 4.18,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 170.72,
      "end_seconds": 174.28,
      "duration_seconds": 3.56,
      "text": "Mm, not to my knowledge, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.67,
      "end_seconds": 179.46,
      "duration_seconds": 3.79,
      "text": "is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 181.41,
      "end_seconds": 184.59,
      "duration_seconds": 3.18,
      "text": "My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.01,
      "end_seconds": 201.51,
      "duration_seconds": 2.5,
      "text": "do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 202.32,
      "end_seconds": 205.68,
      "duration_seconds": 3.36,
      "text": "High cholesterol, for about a year."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.1,
      "end_seconds": 218.45,
      "duration_seconds": 7.35,
      "text": "Understood. Right, so high cholesterol is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.17,
      "end_seconds": 224.67,
      "duration_seconds": 3.5,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.48,
      "end_seconds": 226.75,
      "duration_seconds": 1.27,
      "text": "look straight ahead"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.52,
      "end_seconds": 242.11,
      "duration_seconds": 3.59,
      "text": "The skin is pink and tender with no blistering."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.67,
      "end_seconds": 252.04,
      "duration_seconds": 6.37,
      "text": "Okay, that's enough for me. Okay, thinking it through, this looks most like mild sunburn."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 253.46,
      "end_seconds": 256.45,
      "duration_seconds": 2.99,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.23,
      "end_seconds": 274.97,
      "duration_seconds": 16.74,
      "text": "I understand the worry at the moment I'd say it's mild sunburn, and we'll watch how it goes so, to recap quickly you've had red sore skin on your shoulders, since last night, and no blisters or headache"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 275.69,
      "end_seconds": 278.38,
      "duration_seconds": 2.69,
      "text": "Yes, uh, that's right."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.01,
      "end_seconds": 290.32,
      "duration_seconds": 10.31,
      "text": "Cool compresses, moisturiser and stay out of the sun for a few days. Do get help quickly if the symptoms get worse."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 292.14,
      "end_seconds": 293.67,
      "duration_seconds": 1.53,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.62,
      "end_seconds": 297.56,
      "duration_seconds": 2.94,
      "text": "I'll want another look if blisters develop."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 298.53,
      "end_seconds": 300.69,
      "duration_seconds": 2.16,
      "text": "Alright, I'll be back."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.08,
      "end_seconds": 307.97,
      "duration_seconds": 5.89,
      "text": "How would you describe the plan, so we're on the same page?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 308.99,
      "end_seconds": 315.18,
      "duration_seconds": 6.19,
      "text": "so, I come back if blisters develop is that right?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.26,
      "end_seconds": 326.56,
      "duration_seconds": 5.3,
      "text": "Yes, exactly right. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 328.25,
      "end_seconds": 333.17,
      "duration_seconds": 4.92,
      "text": "Well, okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.79,
      "end_seconds": 336.04,
      "duration_seconds": 1.25,
      "text": "goodbye for now"
    }
