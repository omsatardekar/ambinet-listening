{
  "schema_version": "1.0",
  "encounter_id": "01596",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.34,
      "end_seconds": 3.37,
      "duration_seconds": 2.03,
      "text": "Morning, come on through."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.7,
      "end_seconds": 8.34,
      "duration_seconds": 3.64,
      "text": "Morning, doctor, sorry about the rush."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.41,
      "end_seconds": 14.95,
      "duration_seconds": 4.54,
      "text": "Mm, doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.82,
      "end_seconds": 17.71,
      "duration_seconds": 1.89,
      "text": "What's been worrying you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.53,
      "end_seconds": 24.12,
      "duration_seconds": 4.59,
      "text": "Well, I've been having a stiff neck after sleeping badly."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.34,
      "end_seconds": 28.47,
      "duration_seconds": 3.13,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 29.08,
      "end_seconds": 32.33,
      "duration_seconds": 3.25,
      "text": "It's been going on for four weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.03,
      "end_seconds": 38.66,
      "duration_seconds": 4.63,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.72,
      "end_seconds": 47.54,
      "duration_seconds": 3.82,
      "text": "Heat helps a bit. It's every other day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 48.06,
      "end_seconds": 50.91,
      "duration_seconds": 2.85,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 51.92,
      "end_seconds": 61.98,
      "duration_seconds": 10.06,
      "text": "It usually comes with tightness between my shoulders. The tightness between my shoulders? That's been since last Tuesday."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 63.55,
      "end_seconds": 67.79,
      "duration_seconds": 4.24,
      "text": "Any head injury, arm numbness, fever or headache at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 69.03,
      "end_seconds": 72.32,
      "duration_seconds": 3.29,
      "text": "No, um, none that I've noticed."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.56,
      "end_seconds": 76.28,
      "duration_seconds": 2.72,
      "text": "Alright, is your chest okay generally?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.3,
      "end_seconds": 81.9,
      "duration_seconds": 3.6,
      "text": "Oh, no, my breathing's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.64,
      "end_seconds": 89.21,
      "duration_seconds": 3.57,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.33,
      "end_seconds": 94.35,
      "duration_seconds": 2.02,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.32,
      "end_seconds": 99.0,
      "duration_seconds": 2.68,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.76,
      "end_seconds": 105.44,
      "duration_seconds": 4.68,
      "text": "Right, I had an operation for a hernia last spring."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.03,
      "end_seconds": 114.85,
      "duration_seconds": 4.82,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.01,
      "end_seconds": 132.09,
      "duration_seconds": 13.08,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.89,
      "end_seconds": 148.27,
      "duration_seconds": 2.38,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.04,
      "end_seconds": 156.24,
      "duration_seconds": 6.2,
      "text": "I've, I've had an underactive thyroid for nearly five years now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.99,
      "end_seconds": 158.69,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.66,
      "end_seconds": 162.52,
      "duration_seconds": 1.86,
      "text": "I have heart disease."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.09,
      "end_seconds": 173.81,
      "duration_seconds": 9.72,
      "text": "Right, so an underactive thyroid is already on your record. We'll keep that in mind today. Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 174.58,
      "end_seconds": 179.34,
      "duration_seconds": 4.76,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.26,
      "end_seconds": 183.59,
      "duration_seconds": 3.33,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 185.29,
      "end_seconds": 188.39,
      "duration_seconds": 3.1,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.56,
      "end_seconds": 193.58,
      "duration_seconds": 4.02,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 194.33,
      "end_seconds": 199.64,
      "duration_seconds": 5.31,
      "text": "something called thyr... Thyronorm, 50 micrograms, maybe, every morning."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.3,
      "end_seconds": 204.41,
      "duration_seconds": 3.11,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 205.49,
      "end_seconds": 210.91,
      "duration_seconds": 5.42,
      "text": "No, it's at home. It's, It's paracetamol, when needed."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.2,
      "end_seconds": 214.49,
      "duration_seconds": 2.29,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 215.61,
      "end_seconds": 216.65,
      "duration_seconds": 1.04,
      "text": "1 gram."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.47,
      "end_seconds": 221.7,
      "duration_seconds": 3.23,
      "text": "Okay, does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 222.47,
      "end_seconds": 227.97,
      "duration_seconds": 5.5,
      "text": "My uncle has high cholesterol. My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 237.63,
      "end_seconds": 247.68,
      "duration_seconds": 10.05,
      "text": "Okay, so the vitals from earlier. Pulse is 74 beats a minute, oxygen saturation is 98 percent, blood pressure 108 over 78. Temp 36.5 degrees."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.52,
      "end_seconds": 250.22,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.8,
      "end_seconds": 253.81,
      "duration_seconds": 2.01,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.68,
      "end_seconds": 258.66,
      "duration_seconds": 2.98,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.16,
      "end_seconds": 272.93,
      "duration_seconds": 5.77,
      "text": "The neck muscles on the left are tight and the movements are full."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.15,
      "end_seconds": 280.27,
      "duration_seconds": 2.12,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.27,
      "end_seconds": 299.41,
      "duration_seconds": 5.14,
      "text": "Taking everything into account, it points towards a simple neck muscle strain."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 301.46,
      "end_seconds": 304.39,
      "duration_seconds": 2.93,
      "text": "Uh, will it clear up?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.44,
      "end_seconds": 332.83,
      "duration_seconds": 26.39,
      "text": "I understand the worry. At the moment I'd say it's a simple neck muscle strain, and we'll watch how it goes. Heat, gentle neck rolls, and a supportive pillow. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. So, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 334.62,
      "end_seconds": 337.01,
      "duration_seconds": 2.39,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 338.1,
      "end_seconds": 339.44,
      "duration_seconds": 1.34,
      "text": "Take care now."
    }
  ]
}