{
  "schema_version": "1.0",
  "encounter_id": "01688",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.37,
      "end_seconds": 5.89,
      "duration_seconds": 4.52,
      "text": "I mean, morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.71,
      "end_seconds": 11.14,
      "duration_seconds": 4.43,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.78,
      "end_seconds": 25.22,
      "duration_seconds": 10.44,
      "text": "Doctor, thank you for seeing us. It's, It's a barking cough, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.83,
      "end_seconds": 29.03,
      "duration_seconds": 2.2,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.1,
      "end_seconds": 33.25,
      "duration_seconds": 3.15,
      "text": "About two weeks, give or take."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 35.11,
      "end_seconds": 38.29,
      "duration_seconds": 3.18,
      "text": "It was closer to three weeks, doctor."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.63,
      "end_seconds": 44.48,
      "duration_seconds": 4.85,
      "text": "Okay, so roughly two to three weeks. Is that right?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.48,
      "end_seconds": 49.33,
      "duration_seconds": 2.85,
      "text": "Okay, so that sounds about right."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.64,
      "end_seconds": 53.28,
      "duration_seconds": 2.64,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.3,
      "end_seconds": 57.77,
      "duration_seconds": 3.47,
      "text": "Pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.55,
      "end_seconds": 63.07,
      "duration_seconds": 3.52,
      "text": "Alright, is there anything else with it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.68,
      "end_seconds": 74.23,
      "duration_seconds": 10.55,
      "text": "Um, it usually comes with a runny nose. And there's a hoarse voice as well, about a month now."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.78,
      "end_seconds": 78.88,
      "duration_seconds": 3.1,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.06,
      "end_seconds": 83.43,
      "duration_seconds": 3.37,
      "text": "Right, about a six out of ten."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.98,
      "end_seconds": 91.38,
      "duration_seconds": 6.4,
      "text": "Did you get difficulty swallowing, drooling, noisy breathing when resting or blue lips?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.7,
      "end_seconds": 102.86,
      "duration_seconds": 7.16,
      "text": "I haven't had difficulty swallowing, drooling, noisy breathing when resting or blue lips, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.58,
      "end_seconds": 109.79,
      "duration_seconds": 3.21,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.77,
      "end_seconds": 113.3,
      "duration_seconds": 1.53,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.81,
      "end_seconds": 117.72,
      "duration_seconds": 3.91,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.49,
      "end_seconds": 121.32,
      "duration_seconds": 2.83,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.11,
      "end_seconds": 140.35,
      "duration_seconds": 1.24,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.25,
      "end_seconds": 145.8,
      "duration_seconds": 4.55,
      "text": "Okay, so no, I've never been operated on."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.37,
      "end_seconds": 151.38,
      "duration_seconds": 4.01,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.33,
      "end_seconds": 157.87,
      "duration_seconds": 2.54,
      "text": "Yes, eczema. Yes, thin bones."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.71,
      "end_seconds": 167.53,
      "duration_seconds": 8.82,
      "text": "Right, so eczema is already on your record. We'll keep that in mind today. Let's run through your medicines."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 169.6,
      "end_seconds": 179.38,
      "duration_seconds": 9.78,
      "text": "It's, It's hydrocortisone cream, when needed, doctor. It's, It's alendronate, 70 milligrams, once a week for my bones, doctor."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.32,
      "end_seconds": 197.5,
      "duration_seconds": 1.18,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.67,
      "end_seconds": 202.03,
      "duration_seconds": 3.36,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.56,
      "end_seconds": 205.59,
      "duration_seconds": 2.03,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.56,
      "end_seconds": 211.64,
      "duration_seconds": 4.08,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.5,
      "end_seconds": 216.21,
      "duration_seconds": 3.71,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.0,
      "end_seconds": 223.53,
      "duration_seconds": 6.53,
      "text": "Erm, my mother has an underactive thyroid. My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 225.35,
      "end_seconds": 236.46,
      "duration_seconds": 11.11,
      "text": "Doctor, I've got the readings for you. Pulse is 72 beats a minute, respiratory rate 17, pressure 128 over 77. SpO2 99 percent on room air."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.66,
      "end_seconds": 238.36,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.2,
      "end_seconds": 243.94,
      "duration_seconds": 2.74,
      "text": "Okay, shall I start the examination?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.89,
      "end_seconds": 246.13,
      "duration_seconds": 1.24,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.05,
      "end_seconds": 268.39,
      "duration_seconds": 6.34,
      "text": "He is playful, breathing comfortably at rest, and I can't hear any noisy breathing now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.78,
      "end_seconds": 283.83,
      "duration_seconds": 13.05,
      "text": "Good, you can sit up again. Right, here's what I'm thinking. It's hard to say. Mild croup is one possibility and a viral cold another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.74,
      "end_seconds": 287.63,
      "duration_seconds": 2.89,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.04,
      "end_seconds": 302.36,
      "duration_seconds": 13.32,
      "text": "Nothing I've seen today points to an emergency. It looks like mild croup. Stop me if I've got anything wrong. You've had a barking cough, mild, and no difficulty swallowing or blue lips."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.95,
      "end_seconds": 305.69,
      "duration_seconds": 1.74,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.31,
      "end_seconds": 318.93,
      "duration_seconds": 7.62,
      "text": "I'd like you to take dexamethasone, 0.15 mg per kg, once, single dose. It's for croup."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.57,
      "end_seconds": 323.44,
      "duration_seconds": 3.87,
      "text": "Should I carry on if I feel better?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.81,
      "end_seconds": 344.32,
      "duration_seconds": 19.51,
      "text": "Keep him calm, sit him upright, and give fluids. Please take the tablets with food so they don't upset your stomach. I'd like you back if no better in two days. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.15,
      "end_seconds": 351.46,
      "duration_seconds": 5.31,
      "text": "Right, you know, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.56,
      "end_seconds": 355.0,
      "duration_seconds": 1.44,
      "text": "Take care now."
    }
  ]
}