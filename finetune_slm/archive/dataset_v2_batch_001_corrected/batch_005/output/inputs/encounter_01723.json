{
  "schema_version": "1.0",
  "encounter_id": "01723",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.28,
      "end_seconds": 7.46,
      "duration_seconds": 6.18,
      "text": "Hi, you know, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.16,
      "end_seconds": 13.14,
      "duration_seconds": 4.98,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.2,
      "end_seconds": 18.36,
      "duration_seconds": 3.16,
      "text": "I'm here because of an itchy scalp"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.54,
      "end_seconds": 22.9,
      "duration_seconds": 3.36,
      "text": "how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.9,
      "end_seconds": 31.81,
      "duration_seconds": 2.91,
      "text": "About... well, about a week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.34,
      "end_seconds": 36.65,
      "duration_seconds": 4.31,
      "text": "Mm-hmm. So, how much does it it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.45,
      "end_seconds": 44.05,
      "duration_seconds": 5.6,
      "text": "I'd give it a eight, you know, out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.5,
      "end_seconds": 48.11,
      "duration_seconds": 2.61,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.12,
      "end_seconds": 52.3,
      "duration_seconds": 3.18,
      "text": "honestly, a few times a day"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.06,
      "end_seconds": 63.34,
      "duration_seconds": 5.28,
      "text": "What about seeing tiny bugs in the hair, have you noticed that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.94,
      "end_seconds": 66.05,
      "duration_seconds": 2.11,
      "text": "Mm, uh, yes."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.01,
      "end_seconds": 74.28,
      "duration_seconds": 6.27,
      "text": "Let me check a few things. Any rash on the body, fever or swollen glands?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.78,
      "end_seconds": 81.21,
      "duration_seconds": 6.43,
      "text": "Erm, no rash on the body, fever or swollen glands, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.05,
      "end_seconds": 84.51,
      "duration_seconds": 1.46,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.46,
      "end_seconds": 91.53,
      "duration_seconds": 2.07,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.06,
      "end_seconds": 96.12,
      "duration_seconds": 4.06,
      "text": "Alright, any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.03,
      "end_seconds": 99.52,
      "duration_seconds": 2.49,
      "text": "Yeah, I move fine otherwise."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.98,
      "end_seconds": 103.95,
      "duration_seconds": 2.97,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.05,
      "end_seconds": 106.2,
      "duration_seconds": 1.15,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.87,
      "end_seconds": 110.57,
      "duration_seconds": 2.7,
      "text": "have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.3,
      "end_seconds": 117.45,
      "duration_seconds": 1.15,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.31,
      "end_seconds": 119.7,
      "duration_seconds": 1.39,
      "text": "and your job?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.68,
      "end_seconds": 124.26,
      "duration_seconds": 3.58,
      "text": "I work in accounts at a hospital"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.88,
      "end_seconds": 127.65,
      "duration_seconds": 2.77,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.84,
      "end_seconds": 132.02,
      "duration_seconds": 3.18,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.8,
      "end_seconds": 137.41,
      "duration_seconds": 4.61,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.84,
      "end_seconds": 141.45,
      "duration_seconds": 2.61,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.04,
      "end_seconds": 161.98,
      "duration_seconds": 3.94,
      "text": "Alright, any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.5,
      "end_seconds": 164.18,
      "duration_seconds": 1.68,
      "text": "not really, no"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.17,
      "end_seconds": 182.81,
      "duration_seconds": 4.64,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.46,
      "end_seconds": 198.9,
      "duration_seconds": 2.44,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.33,
      "end_seconds": 221.09,
      "duration_seconds": 6.76,
      "text": "okay: pulse is 81 beats a minute, saturation 97 percent, pressure 112 over 74."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.77,
      "end_seconds": 225.63,
      "duration_seconds": 2.86,
      "text": "okay, time for me to examine you"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.09,
      "end_seconds": 229.18,
      "duration_seconds": 2.09,
      "text": "tell me if that's sore"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.6,
      "end_seconds": 248.79,
      "duration_seconds": 6.19,
      "text": "I can see live lice and small eggs close to the roots behind the ears."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.65,
      "end_seconds": 257.7,
      "duration_seconds": 3.05,
      "text": "thank you, you can get dressed"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.43,
      "end_seconds": 274.15,
      "duration_seconds": 3.72,
      "text": "taking everything into account, it points towards head lice"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.2,
      "end_seconds": 309.37,
      "duration_seconds": 22.17,
      "text": "for this, dimeticone lotion, 4%, once, repeat after seven days, two applications. It's for head lice. Comb the hair with a fine comb every few days and check the family. If the symptoms get worse, that's the point to come in urgently. Let's plan a check if lice persist after two treatments"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.27,
      "end_seconds": 314.15,
      "duration_seconds": 3.88,
      "text": "hmm, I'll note it in my calendar"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.21,
      "end_seconds": 319.38,
      "duration_seconds": 4.17,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.83,
      "end_seconds": 324.78,
      "duration_seconds": 3.95,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.5,
      "end_seconds": 328.85,
      "duration_seconds": 2.35,
      "text": "Right, have a good day."
    }
  ]
