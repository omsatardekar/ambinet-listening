{
  "schema_version": "1.0",
  "encounter_id": "01848",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.5,
      "end_seconds": 7.12,
      "duration_seconds": 6.62,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.6,
      "end_seconds": 15.94,
      "duration_seconds": 5.34,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.67,
      "end_seconds": 27.69,
      "duration_seconds": 6.02,
      "text": "Doctor, it's loose stools with blood. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.5,
      "end_seconds": 34.61,
      "duration_seconds": 3.11,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.25,
      "end_seconds": 51.95,
      "duration_seconds": 16.7,
      "text": "I'd say severe. And cramping tummy pain, too. About cramping tummy pain, it's a few times a day. Oh, and tiredness. That's been about the same, two months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.62,
      "end_seconds": 54.67,
      "duration_seconds": 2.05,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.43,
      "end_seconds": 72.62,
      "duration_seconds": 17.19,
      "text": "Well, I take Foracort inhaler, twice a day. I do miss it now and then, to be fair. Oh, I had Asthalin inhaler at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.71,
      "end_seconds": 90.5,
      "duration_seconds": 2.79,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.45,
      "end_seconds": 95.87,
      "duration_seconds": 3.42,
      "text": "I've had asthma for two years now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.55,
      "end_seconds": 107.57,
      "duration_seconds": 11.02,
      "text": "Yes, asthma is known to us, good to have that clear. Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.0,
      "end_seconds": 113.28,
      "duration_seconds": 4.28,
      "text": "Okay, so no, not that I know of."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.1,
      "end_seconds": 121.89,
      "duration_seconds": 4.79,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.33,
      "end_seconds": 135.42,
      "duration_seconds": 12.09,
      "text": "I'm a hairdresser, on my feet all day. I grab fast food at lunch most days. Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.93,
      "end_seconds": 139.19,
      "duration_seconds": 3.26,
      "text": "Okay, have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.32,
      "end_seconds": 144.51,
      "duration_seconds": 4.19,
      "text": "Just my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.5,
      "end_seconds": 162.21,
      "duration_seconds": 1.71,
      "text": "So, how about fever?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.94,
      "end_seconds": 167.52,
      "duration_seconds": 3.58,
      "text": "Not that I've noticed, no fever."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.85,
      "end_seconds": 171.6,
      "duration_seconds": 3.75,
      "text": "I follow. Any vomiting, joint pain or weight loss?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.44,
      "end_seconds": 174.56,
      "duration_seconds": 2.12,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.76,
      "end_seconds": 178.91,
      "duration_seconds": 4.15,
      "text": "Okay, go on. Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.85,
      "end_seconds": 184.22,
      "duration_seconds": 3.37,
      "text": "Yeah, no, nothing with my heart."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 185.55,
      "end_seconds": 195.71,
      "duration_seconds": 10.16,
      "text": "Doctor, I've got the readings for you. SpO2 98 percent on room air, pressure 128 over 78, temp 36.5 degrees, pulse 79, respiratory rate 15."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.26,
      "end_seconds": 198.22,
      "duration_seconds": 0.96,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.41,
      "end_seconds": 203.85,
      "duration_seconds": 3.44,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.43,
      "end_seconds": 206.72,
      "duration_seconds": 1.29,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.33,
      "end_seconds": 221.31,
      "duration_seconds": 4.98,
      "text": "There is tenderness in the lower right tummy and no guarding."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.07,
      "end_seconds": 238.38,
      "duration_seconds": 12.31,
      "text": "Right, good, you can sit up again. So where does that leave us? I think we're dealing with a flare of inflammatory bowel disease at this stage."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.92,
      "end_seconds": 246.93,
      "duration_seconds": 4.01,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.94,
      "end_seconds": 258.6,
      "duration_seconds": 9.66,
      "text": "I can't promise yet, but most people with a flare of inflammatory bowel disease do well once it's treated properly."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.51,
      "end_seconds": 291.74,
      "duration_seconds": 18.23,
      "text": "I want blood tests done, that's for flare. I want a stool test done, that's for bloody diarrhoea. I'm going to put you on prednisolone, 40 milligrams, once a day, one week then reduce. You take it by mouth. It's for inflammatory bowel flare."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.59,
      "end_seconds": 297.25,
      "duration_seconds": 3.66,
      "text": "Is that safe with my other medicines?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.89,
      "end_seconds": 315.6,
      "duration_seconds": 16.71,
      "text": "Keep up your fluids and call the IBD nurse if you get a fever. Come back or go to emergency straight away if the symptoms get worse. Book a review in two weeks. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.21,
      "end_seconds": 320.33,
      "duration_seconds": 3.12,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.0,
      "end_seconds": 322.41,
      "duration_seconds": 1.41,
      "text": "Look after yourself."
    }
  ]
}