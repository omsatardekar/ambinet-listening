{
  "schema_version": "1.0",
  "encounter_id": "01815",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.78,
      "end_seconds": 3.66,
      "duration_seconds": 2.88,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.48,
      "end_seconds": 9.19,
      "duration_seconds": 4.71,
      "text": "yes, come in and sit down what brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.34,
      "end_seconds": 17.22,
      "duration_seconds": 6.88,
      "text": "Mainly sore knees. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.86,
      "end_seconds": 22.39,
      "duration_seconds": 3.53,
      "text": "can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.76,
      "end_seconds": 30.0,
      "duration_seconds": 3.24,
      "text": "I've had it for three days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.27,
      "end_seconds": 36.9,
      "duration_seconds": 5.63,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.66,
      "end_seconds": 45.64,
      "duration_seconds": 7.98,
      "text": "I notice it it more with walking. Mild, really. I've been snoring too, for three weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.12,
      "end_seconds": 57.1,
      "duration_seconds": 1.98,
      "text": "Did you notice any palpitations?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.68,
      "end_seconds": 59.31,
      "duration_seconds": 1.63,
      "text": "no, no palpitations"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.77,
      "end_seconds": 64.67,
      "duration_seconds": 3.9,
      "text": "Have you had any chest pain or high thirst?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.08,
      "end_seconds": 68.98,
      "duration_seconds": 2.9,
      "text": "no, none of those at all"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.7,
      "end_seconds": 75.13,
      "duration_seconds": 5.43,
      "text": "Right, have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.97,
      "end_seconds": 77.61,
      "duration_seconds": 1.64,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.0,
      "end_seconds": 79.91,
      "duration_seconds": 0.91,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.02,
      "end_seconds": 86.77,
      "duration_seconds": 2.75,
      "text": "I've never touched a cigarette"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.16,
      "end_seconds": 90.54,
      "duration_seconds": 2.38,
      "text": "Alright, do you drink alcohol?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.05,
      "end_seconds": 93.69,
      "duration_seconds": 1.64,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.72,
      "end_seconds": 97.96,
      "duration_seconds": 2.24,
      "text": "tell me about your eating"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.01,
      "end_seconds": 106.04,
      "duration_seconds": 6.03,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.12,
      "end_seconds": 110.25,
      "duration_seconds": 2.13,
      "text": "Right, how active are you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.34,
      "end_seconds": 114.58,
      "duration_seconds": 3.24,
      "text": "I hardly move around during the day"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.7,
      "end_seconds": 118.0,
      "duration_seconds": 2.3,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.42,
      "end_seconds": 123.36,
      "duration_seconds": 3.94,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.51,
      "end_seconds": 128.25,
      "duration_seconds": 3.74,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.03,
      "end_seconds": 131.56,
      "duration_seconds": 1.53,
      "text": "no, no conditions"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.72,
      "end_seconds": 135.54,
      "duration_seconds": 2.82,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.64,
      "end_seconds": 140.58,
      "duration_seconds": 2.94,
      "text": "No, nothing at the the moment."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.24,
      "end_seconds": 145.24,
      "duration_seconds": 3.0,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.98,
      "end_seconds": 149.94,
      "duration_seconds": 3.96,
      "text": "Just an operation for a hernia, last spring."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.88,
      "end_seconds": 155.17,
      "duration_seconds": 3.29,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.33,
      "end_seconds": 163.85,
      "duration_seconds": 4.52,
      "text": "Yes, kiwi, it gives me an itchy mouth."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.47,
      "end_seconds": 167.51,
      "duration_seconds": 2.04,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.87,
      "end_seconds": 178.7,
      "duration_seconds": 2.83,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.6,
      "end_seconds": 208.93,
      "duration_seconds": 10.33,
      "text": "Okay: heart rate 75, blood pressure 144 over 96, height 174 centimetres, weight 98 kilos, oxygen saturation is 98 percent, temp 36.8 degrees."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.05,
      "end_seconds": 212.1,
      "duration_seconds": 2.05,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.99,
      "end_seconds": 217.74,
      "duration_seconds": 3.75,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.52,
      "end_seconds": 222.62,
      "duration_seconds": 2.1,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.07,
      "end_seconds": 227.18,
      "duration_seconds": 3.11,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.46,
      "end_seconds": 243.93,
      "duration_seconds": 4.47,
      "text": "Your weight and waist measurement are both above the healthy range."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.05,
      "end_seconds": 251.92,
      "duration_seconds": 2.87,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.39,
      "end_seconds": 278.36,
      "duration_seconds": 10.97,
      "text": "okay, thinking it through, I'm honestly not certain yet. It could be obesity with weight-related symptoms, or it might be an underactive thyroid"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.24,
      "end_seconds": 316.31,
      "duration_seconds": 19.07,
      "text": "I'll request a thyroid test, it'll help with weight gain. Aim for a loss of half a kilo a week with smaller portions and a daily thirty-minute walk. I'm going to send a referral to the weight management service."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.19,
      "end_seconds": 317.89,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.67,
      "end_seconds": 329.28,
      "duration_seconds": 9.61,
      "text": "please don't wait if the symptoms get worse that's when to be seen urgently please come and see me in three months"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.85,
      "end_seconds": 331.72,
      "duration_seconds": 1.87,
      "text": "that's fine with me"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.61,
      "end_seconds": 336.47,
      "duration_seconds": 3.86,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.96,
      "end_seconds": 343.05,
      "duration_seconds": 2.09,
      "text": "alright, thanks, take care"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.05,
      "end_seconds": 345.3,
      "duration_seconds": 1.25,
      "text": "Look after yourself."
    }
  ]
