{
  "schema_version": "1.0",
  "encounter_id": "01740",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.24,
      "end_seconds": 4.59,
      "duration_seconds": 3.35,
      "text": "hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.4,
      "end_seconds": 10.23,
      "duration_seconds": 3.83,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.32,
      "end_seconds": 20.4,
      "duration_seconds": 9.08,
      "text": "Well, I've been having severe pain in the upper tummy going through to the back."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.73,
      "end_seconds": 24.6,
      "duration_seconds": 2.87,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.09,
      "end_seconds": 37.1,
      "duration_seconds": 3.01,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.98,
      "end_seconds": 59.33,
      "duration_seconds": 3.35,
      "text": "Okay: pulse 109, pressure 123 over 81."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.69,
      "end_seconds": 74.16,
      "duration_seconds": 2.47,
      "text": "did it come on recently?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.07,
      "end_seconds": 83.05,
      "duration_seconds": 6.98,
      "text": "It's been four weeks now. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.54,
      "end_seconds": 89.59,
      "duration_seconds": 6.05,
      "text": "mm-hmm is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.42,
      "end_seconds": 93.48,
      "duration_seconds": 3.06,
      "text": "I'd say every other day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.81,
      "end_seconds": 97.43,
      "duration_seconds": 3.62,
      "text": "okay, go on. Is there anything else with it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.69,
      "end_seconds": 109.87,
      "duration_seconds": 11.18,
      "text": "It usually comes with a fast heart. Mm, and I've been feeling very unwell as well, since this morning."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.27,
      "end_seconds": 114.48,
      "duration_seconds": 3.21,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.38,
      "end_seconds": 117.5,
      "duration_seconds": 1.12,
      "text": "Mostly moderate."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.04,
      "end_seconds": 122.13,
      "duration_seconds": 4.09,
      "text": "and what about fever, yellow eyes or chest pain?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.83,
      "end_seconds": 127.84,
      "duration_seconds": 5.01,
      "text": "Well, no, no fever, yellow eyes or chest pain."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.28,
      "end_seconds": 135.17,
      "duration_seconds": 2.89,
      "text": "Right, any sign of black stools?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.76,
      "end_seconds": 140.29,
      "duration_seconds": 3.53,
      "text": "No, I haven't had any black stools."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.32,
      "end_seconds": 146.37,
      "duration_seconds": 4.05,
      "text": "Any pins and and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.32,
      "end_seconds": 149.48,
      "duration_seconds": 2.16,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.49,
      "end_seconds": 153.88,
      "duration_seconds": 2.39,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.01,
      "end_seconds": 160.68,
      "duration_seconds": 1.67,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.01,
      "end_seconds": 164.5,
      "duration_seconds": 2.49,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.11,
      "end_seconds": 185.53,
      "duration_seconds": 20.42,
      "text": "I used to drink heavily but I stopped four years ago. I've never touched a cigarette. I walk the dog every morning. I drink a lot of tea and snack through the day. I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.16,
      "end_seconds": 190.67,
      "duration_seconds": 4.51,
      "text": "can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.44,
      "end_seconds": 202.56,
      "duration_seconds": 10.12,
      "text": "I'm on diclofenac, 50 milligrams, when needed for the joint pain. It's ibuprofen, 400 milligrams, when needed."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.52,
      "end_seconds": 207.89,
      "duration_seconds": 3.37,
      "text": "Okay, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.88,
      "end_seconds": 214.06,
      "duration_seconds": 4.18,
      "text": "Okay, so nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.55,
      "end_seconds": 217.94,
      "duration_seconds": 2.39,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.41,
      "end_seconds": 228.41,
      "duration_seconds": 9.0,
      "text": "Oh, I've got arthritis in my knees. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.97,
      "end_seconds": 234.81,
      "duration_seconds": 5.84,
      "text": "Okay, go on. Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.9,
      "end_seconds": 237.7,
      "duration_seconds": 1.8,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.8,
      "end_seconds": 258.62,
      "duration_seconds": 2.82,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.65,
      "end_seconds": 263.5,
      "duration_seconds": 2.85,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.39,
      "end_seconds": 269.66,
      "duration_seconds": 3.27,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.53,
      "end_seconds": 271.87,
      "duration_seconds": 1.34,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.39,
      "end_seconds": 275.45,
      "duration_seconds": 2.06,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.17,
      "end_seconds": 295.35,
      "duration_seconds": 4.18,
      "text": "Your upper tummy is very tender and you look dehydrated."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.64,
      "end_seconds": 300.17,
      "duration_seconds": 2.53,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.28,
      "end_seconds": 333.02,
      "duration_seconds": 23.74,
      "text": "So where does that leave us? I think we're dealing with acute pancreatitis at this stage. Let's get an abdominal scan, for pancreatitis. You need admission for fluids and pain relief, nothing to eat for now. We'll refer you to the surgical team. I'd like to see you again straight away. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.56,
      "end_seconds": 337.86,
      "duration_seconds": 4.3,
      "text": "I, I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.85,
      "end_seconds": 340.23,
      "duration_seconds": 1.38,
      "text": "See you soon."
    }
  ]
}