{
  "schema_version": "1.0",
  "encounter_id": "01813",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.26,
      "end_seconds": 5.88,
      "duration_seconds": 4.62,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.54,
      "end_seconds": 10.71,
      "duration_seconds": 4.17,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.1,
      "end_seconds": 15.49,
      "duration_seconds": 3.39,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.58,
      "end_seconds": 23.24,
      "duration_seconds": 6.66,
      "text": "Doctor, it's chest tightness when I walk uphill. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.83,
      "end_seconds": 28.06,
      "duration_seconds": 3.23,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.28,
      "end_seconds": 39.56,
      "duration_seconds": 10.28,
      "text": "Around six months... no wait, it's more like about three months. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.54,
      "end_seconds": 50.12,
      "duration_seconds": 8.58,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.92,
      "end_seconds": 56.58,
      "duration_seconds": 4.66,
      "text": "Yes, hills. That makes it worse. I'd say severe."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.37,
      "end_seconds": 61.01,
      "duration_seconds": 3.64,
      "text": "What about breathlessness on exertion, have you noticed that?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.19,
      "end_seconds": 74.78,
      "duration_seconds": 12.59,
      "text": "Yeah. About a week, I'd say. Yeah, as for breathlessness on exertion, I'd give it a four, out of ten. Oh, and pain in my jaw."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.27,
      "end_seconds": 83.85,
      "duration_seconds": 7.58,
      "text": "Have you had chest tightness when you walk uphill before, or is this the first time?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.64,
      "end_seconds": 92.53,
      "duration_seconds": 6.89,
      "text": "Yes, something like this happened last winter, and it went away on its own."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.48,
      "end_seconds": 97.87,
      "duration_seconds": 3.39,
      "text": "Have you had any palpitations or leg swelling?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.68,
      "end_seconds": 103.06,
      "duration_seconds": 4.38,
      "text": "Actually, I haven't had palpitations or leg swelling, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.4,
      "end_seconds": 107.71,
      "duration_seconds": 3.31,
      "text": "Did you get fainting or pain at rest?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.25,
      "end_seconds": 110.68,
      "duration_seconds": 2.43,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.66,
      "end_seconds": 117.27,
      "duration_seconds": 4.61,
      "text": "So, any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.83,
      "end_seconds": 125.4,
      "duration_seconds": 3.57,
      "text": "No, um, that side's been fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.77,
      "end_seconds": 129.33,
      "duration_seconds": 2.56,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.69,
      "end_seconds": 134.75,
      "duration_seconds": 4.06,
      "text": "Nothing on the skin, you know, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.32,
      "end_seconds": 140.02,
      "duration_seconds": 4.7,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.06,
      "end_seconds": 154.78,
      "duration_seconds": 12.72,
      "text": "I only drink at family occasions. I've never touched a cigarette. I'm a plumber, lots of bending and kneeling. I walk the dog every morning."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.62,
      "end_seconds": 167.68,
      "duration_seconds": 2.06,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.92,
      "end_seconds": 173.82,
      "duration_seconds": 4.9,
      "text": "Yes, I had a bunion operation, six years ago."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.38,
      "end_seconds": 191.95,
      "duration_seconds": 2.57,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.22,
      "end_seconds": 197.67,
      "duration_seconds": 4.45,
      "text": "Naproxen. I come out in... well, a rash."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.45,
      "end_seconds": 200.61,
      "duration_seconds": 2.16,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.32,
      "end_seconds": 207.06,
      "duration_seconds": 4.74,
      "text": "I've had high blood pressure for two years now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.85,
      "end_seconds": 214.5,
      "duration_seconds": 5.65,
      "text": "Yes, high blood pressure is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.32,
      "end_seconds": 232.12,
      "duration_seconds": 3.8,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.83,
      "end_seconds": 239.49,
      "duration_seconds": 6.66,
      "text": "Sorry, what was I saying, it's ramipril, 5 milligrams, maybe, every morning."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.31,
      "end_seconds": 246.13,
      "duration_seconds": 4.82,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.59,
      "end_seconds": 249.53,
      "duration_seconds": 1.94,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.02,
      "end_seconds": 254.54,
      "duration_seconds": 3.52,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.58,
      "end_seconds": 267.54,
      "duration_seconds": 2.96,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.43,
      "end_seconds": 292.79,
      "duration_seconds": 13.36,
      "text": "Okay: height 150 centimetres, blood pressure 111 over 68, weight 58 kilos, BMI works out to 25.8, pulse 77, respiratory rate 18, temp 36.9 degrees, saturation 97 percent."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.53,
      "end_seconds": 295.9,
      "duration_seconds": 1.37,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.37,
      "end_seconds": 300.45,
      "duration_seconds": 3.08,
      "text": "Alright, I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.17,
      "end_seconds": 306.59,
      "duration_seconds": 4.42,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.45,
      "end_seconds": 309.81,
      "duration_seconds": 2.36,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.79,
      "end_seconds": 333.22,
      "duration_seconds": 5.43,
      "text": "Your heart sounds are normal and the pulses are all present."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.99,
      "end_seconds": 335.07,
      "duration_seconds": 1.08,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.48,
      "end_seconds": 348.2,
      "duration_seconds": 10.72,
      "text": "That's the examination finished. So, based on the history and the examination, the most likely explanation is stable angina. Gastro-oesophageal reflux is still possible."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.26,
      "end_seconds": 353.22,
      "duration_seconds": 2.96,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.44,
      "end_seconds": 371.19,
      "duration_seconds": 16.75,
      "text": "Nothing I've seen today points to an emergency. It looks like stable angina, but I'd like to confirm. So, to recap quickly. You've had chest tightness when you walk uphill for about three months, severe, and no fainting or leg swelling."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 372.55,
      "end_seconds": 374.33,
      "duration_seconds": 1.78,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 375.26,
      "end_seconds": 410.17,
      "duration_seconds": 34.91,
      "text": "We should do an ECG for chest tightness. Let's get an exercise test, for exertional chest tightness. I want a cholesterol test done, that's for heart risk. I'm prescribing glyceryl trinitrate spray, 400 micrograms, when needed, long term. That should help with chest tightness. It's a commonly used medicine and most people tolerate it well. Stop and rest when the tightness starts, and use the spray if it does not ease in a few minutes."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 412.02,
      "end_seconds": 420.3,
      "duration_seconds": 8.28,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 421.79,
      "end_seconds": 425.85,
      "duration_seconds": 4.06,
      "text": "Yeah, okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 426.56,
      "end_seconds": 430.69,
      "duration_seconds": 4.13,
      "text": "Do get help quickly if the symptoms get worse."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 431.68,
      "end_seconds": 433.06,
      "duration_seconds": 1.38,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 436.87,
      "end_seconds": 443.05,
      "duration_seconds": 6.18,
      "text": "We'll catch up after the tests. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 444.52,
      "end_seconds": 447.91,
      "duration_seconds": 3.39,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 449.01,
      "end_seconds": 450.44,
      "duration_seconds": 1.43,
      "text": "Look after yourself."
    }
  ]
}