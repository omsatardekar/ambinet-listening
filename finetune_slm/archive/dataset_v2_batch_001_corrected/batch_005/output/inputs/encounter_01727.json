{
  "schema_version": "1.0",
  "encounter_id": "01727",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.19,
      "end_seconds": 5.18,
      "duration_seconds": 3.99,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.75,
      "end_seconds": 15.4,
      "duration_seconds": 4.65,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 16.04,
      "end_seconds": 22.08,
      "duration_seconds": 6.04,
      "text": "Oh, morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.94,
      "end_seconds": 26.53,
      "duration_seconds": 3.59,
      "text": "Right, please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 28.45,
      "end_seconds": 32.3,
      "duration_seconds": 3.85,
      "text": "She's been having sudden severe breathlessness, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.35,
      "end_seconds": 39.71,
      "duration_seconds": 3.36,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.23,
      "end_seconds": 45.53,
      "duration_seconds": 4.3,
      "text": "It's been about four days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.43,
      "end_seconds": 49.2,
      "duration_seconds": 2.77,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.85,
      "end_seconds": 53.01,
      "duration_seconds": 3.16,
      "text": "I'd say once or twice a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.17,
      "end_seconds": 58.55,
      "duration_seconds": 2.38,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.43,
      "end_seconds": 69.33,
      "duration_seconds": 6.9,
      "text": "Being unable to lie flat goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.96,
      "end_seconds": 77.49,
      "duration_seconds": 7.53,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 77.59,
      "end_seconds": 83.72,
      "duration_seconds": 6.13,
      "text": "Tell the doctor about the other thing, you know, that's what worries me."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.76,
      "end_seconds": 98.62,
      "duration_seconds": 10.86,
      "text": "I was getting to that! The being unable to lie flat? That's been for two months. I've been feeling very faint too."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.63,
      "end_seconds": 102.58,
      "duration_seconds": 2.95,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.13,
      "end_seconds": 106.77,
      "duration_seconds": 3.64,
      "text": "Well, pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.08,
      "end_seconds": 111.3,
      "duration_seconds": 3.22,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.86,
      "end_seconds": 115.52,
      "duration_seconds": 3.66,
      "text": "My grandmother had dementia. My son has asthma."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.93,
      "end_seconds": 136.57,
      "duration_seconds": 3.64,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.18,
      "end_seconds": 147.24,
      "duration_seconds": 5.06,
      "text": "Yes, plasters, it gives me a red itchy rash."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.85,
      "end_seconds": 152.33,
      "duration_seconds": 4.48,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.32,
      "end_seconds": 156.56,
      "duration_seconds": 2.24,
      "text": "Depression, for two years."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.98,
      "end_seconds": 161.23,
      "duration_seconds": 1.25,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.8,
      "end_seconds": 166.01,
      "duration_seconds": 3.21,
      "text": "I've had anxiety for five years now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.57,
      "end_seconds": 167.44,
      "duration_seconds": 0.87,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.95,
      "end_seconds": 171.04,
      "duration_seconds": 3.09,
      "text": "I have migraines, for two years."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.23,
      "end_seconds": 173.49,
      "duration_seconds": 1.26,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.22,
      "end_seconds": 179.26,
      "duration_seconds": 4.04,
      "text": "Arthritis in my knees, for about ten years."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.3,
      "end_seconds": 189.17,
      "duration_seconds": 7.87,
      "text": "Yes, depression and anxiety are known to us, good to have that clear. How active are you?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.13,
      "end_seconds": 193.8,
      "duration_seconds": 3.67,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.72,
      "end_seconds": 204.53,
      "duration_seconds": 5.81,
      "text": "Tell me your medicines, please. These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.12,
      "end_seconds": 216.5,
      "duration_seconds": 11.38,
      "text": "I'm on sertraline, 50 milligrams, once a day for my mood. Actually, it's escitalopram, 10 milligrams, once a day for the anxiety."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 217.89,
      "end_seconds": 225.18,
      "duration_seconds": 7.29,
      "text": "She is supposed to take it once a day, but I can't say she always does."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.61,
      "end_seconds": 233.54,
      "duration_seconds": 6.93,
      "text": "It's a... um, I can't remember what it's called. It's a small white one."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.32,
      "end_seconds": 237.09,
      "duration_seconds": 2.77,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.21,
      "end_seconds": 250.86,
      "duration_seconds": 12.65,
      "text": "For my migraines, I believe. My daughter sets them out for me, I just take what I'm given. I'm on paracetamol, 650 milligrams, when needed."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.26,
      "end_seconds": 255.52,
      "duration_seconds": 3.26,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.06,
      "end_seconds": 269.66,
      "duration_seconds": 13.6,
      "text": "Right, yes, I had an operation for a hernia, last spring. Sorry, I know I'm rambling a bit. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.24,
      "end_seconds": 274.42,
      "duration_seconds": 3.18,
      "text": "Did you get fever or leg swelling?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.0,
      "end_seconds": 289.27,
      "duration_seconds": 13.27,
      "text": "Well, no, no fever, no leg swelling. I did have sharp chest pain on one side at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.9,
      "end_seconds": 292.91,
      "duration_seconds": 2.01,
      "text": "Has there been any cough?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.41,
      "end_seconds": 295.73,
      "duration_seconds": 2.32,
      "text": "I haven't noticed any cough."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.49,
      "end_seconds": 301.29,
      "duration_seconds": 3.8,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.63,
      "end_seconds": 304.87,
      "duration_seconds": 2.24,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.55,
      "end_seconds": 324.83,
      "duration_seconds": 2.28,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.43,
      "end_seconds": 336.71,
      "duration_seconds": 2.28,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.49,
      "end_seconds": 358.35,
      "duration_seconds": 11.86,
      "text": "Okay: oxygen saturation is 93 percent, BP is 121 over 84, temperature is 36.9 degrees, pulse is 89 beats a minute, respiratory rate 20."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.35,
      "end_seconds": 363.52,
      "duration_seconds": 2.17,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 364.67,
      "end_seconds": 365.76,
      "duration_seconds": 1.09,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.6,
      "end_seconds": 370.09,
      "duration_seconds": 2.49,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 384.42,
      "end_seconds": 394.22,
      "duration_seconds": 9.8,
      "text": "Your windpipe is pushed to the right, there is no breath sound on the left, and your pressure is dropping."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 397.46,
      "end_seconds": 411.78,
      "duration_seconds": 14.32,
      "text": "That's the examination finished. Let me tell you where I've got to. It fits best with a collapsed lung under pressure. I'd also keep a heart attack in mind."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 412.43,
      "end_seconds": 415.4,
      "duration_seconds": 2.97,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 420.02,
      "end_seconds": 437.41,
      "duration_seconds": 17.39,
      "text": "Nothing I've seen today points to an emergency. It looks like a collapsed lung under pressure, but I'd like to confirm. Stop me if I've got anything wrong. You've had sudden severe breathlessness for about four days, and no cough or leg swelling."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 438.44,
      "end_seconds": 440.23,
      "duration_seconds": 1.79,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 442.13,
      "end_seconds": 475.43,
      "duration_seconds": 33.3,
      "text": "I think a chest X-ray makes sense here, for chest pain. I'll request an urgent chest decompression, it'll help with tension pneumothorax. Stay sitting up, I need to relieve the pressure in your chest right now. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. I think the emergency team should see you too. Come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 477.43,
      "end_seconds": 479.19,
      "duration_seconds": 1.76,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 484.66,
      "end_seconds": 486.72,
      "duration_seconds": 2.06,
      "text": "We'll catch up straight away."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 488.52,
      "end_seconds": 491.83,
      "duration_seconds": 3.31,
      "text": "I mean, I can manage that."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 492.53,
      "end_seconds": 499.11,
      "duration_seconds": 6.58,
      "text": "Tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 500.63,
      "end_seconds": 505.17,
      "duration_seconds": 4.54,
      "text": "So, I come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 506.97,
      "end_seconds": 512.83,
      "duration_seconds": 5.86,
      "text": "Yes, exactly right. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 513.69,
      "end_seconds": 517.44,
      "duration_seconds": 3.75,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 520.12,
      "end_seconds": 521.87,
      "duration_seconds": 1.75,
      "text": "Right, see you soon."
    }
  ]
}