{
  "schema_version": "1.0",
  "encounter_id": "01610",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.11,
      "end_seconds": 5.8,
      "duration_seconds": 4.69,
      "text": "So, hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.62,
      "end_seconds": 12.0,
      "duration_seconds": 4.38,
      "text": "Right, come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.84,
      "end_seconds": 21.17,
      "duration_seconds": 8.33,
      "text": "Well, I've been having a fever. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.39,
      "end_seconds": 25.33,
      "duration_seconds": 2.94,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.87,
      "end_seconds": 31.37,
      "duration_seconds": 4.5,
      "text": "No, you know, I'm not on anything."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.72,
      "end_seconds": 46.06,
      "duration_seconds": 3.34,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.26,
      "end_seconds": 51.6,
      "duration_seconds": 4.34,
      "text": "Um, pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.62,
      "end_seconds": 58.52,
      "duration_seconds": 5.9,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.59,
      "end_seconds": 66.75,
      "duration_seconds": 7.16,
      "text": "It's once or twice a day. Oh, and a productive cough with rusty phlegm."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.37,
      "end_seconds": 70.69,
      "duration_seconds": 3.32,
      "text": "Okay, have you been feeling short of breath?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.31,
      "end_seconds": 79.9,
      "duration_seconds": 8.59,
      "text": "Mm, yes. About feeling short of breath, I'd say mild. Honestly, a few times a day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.63,
      "end_seconds": 98.77,
      "duration_seconds": 5.14,
      "text": "Have you noticed recent travel, coughing up blood or leg swelling?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.62,
      "end_seconds": 105.56,
      "duration_seconds": 5.94,
      "text": "No, no recent travel, coughing up blood or leg swelling."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.94,
      "end_seconds": 108.9,
      "duration_seconds": 2.96,
      "text": "Yes, carry on. Nothing like confusion?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.44,
      "end_seconds": 112.07,
      "duration_seconds": 1.63,
      "text": "No. No confusion."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.71,
      "end_seconds": 115.16,
      "duration_seconds": 2.45,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.8,
      "end_seconds": 118.0,
      "duration_seconds": 2.2,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.69,
      "end_seconds": 122.86,
      "duration_seconds": 4.17,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.69,
      "end_seconds": 128.56,
      "duration_seconds": 4.87,
      "text": "No, you know, nothing I can think of."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.23,
      "end_seconds": 136.86,
      "duration_seconds": 4.63,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.73,
      "end_seconds": 140.51,
      "duration_seconds": 1.78,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.95,
      "end_seconds": 143.4,
      "duration_seconds": 1.45,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.44,
      "end_seconds": 151.64,
      "duration_seconds": 3.2,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.13,
      "end_seconds": 154.71,
      "duration_seconds": 1.58,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.58,
      "end_seconds": 157.49,
      "duration_seconds": 1.91,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.7,
      "end_seconds": 162.75,
      "duration_seconds": 4.05,
      "text": "So, what does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.27,
      "end_seconds": 167.64,
      "duration_seconds": 4.37,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.25,
      "end_seconds": 170.64,
      "duration_seconds": 2.39,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.77,
      "end_seconds": 174.48,
      "duration_seconds": 2.71,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.18,
      "end_seconds": 179.71,
      "duration_seconds": 3.53,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.9,
      "end_seconds": 187.89,
      "duration_seconds": 2.99,
      "text": "My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.71,
      "end_seconds": 193.08,
      "duration_seconds": 3.37,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.79,
      "end_seconds": 202.84,
      "duration_seconds": 4.05,
      "text": "Just my tonsils removed, as a teenager."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.82,
      "end_seconds": 216.73,
      "duration_seconds": 3.91,
      "text": "Okay, I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.34,
      "end_seconds": 225.88,
      "duration_seconds": 2.54,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.7,
      "end_seconds": 254.14,
      "duration_seconds": 13.44,
      "text": "Okay: weight 79 kilos, pulse is 94 beats a minute, blood pressure 106 over 75. And respiratory rate 17, SpO2 95 percent on room air, height 182 centimetres."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.76,
      "end_seconds": 260.93,
      "duration_seconds": 2.17,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.87,
      "end_seconds": 266.42,
      "duration_seconds": 3.55,
      "text": "Okay, we'll look at it together shortly."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.01,
      "end_seconds": 273.03,
      "duration_seconds": 5.02,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.29,
      "end_seconds": 276.34,
      "duration_seconds": 2.05,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.56,
      "end_seconds": 293.04,
      "duration_seconds": 5.48,
      "text": "There are crackles at the right base and the breathing is a bit fast."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.0,
      "end_seconds": 295.81,
      "duration_seconds": 1.81,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.63,
      "end_seconds": 330.11,
      "duration_seconds": 28.48,
      "text": "Alright, please sit back down. Let me tell you where I've got to. My working impression is community-acquired pneumonia. I want to be honest that this is an impression, not a final answer. It could also be acute bronchitis, so we'll keep that open. Blood tests is what I'd like next, for pneumonia. We should do a chest X-ray for possible pneumonia."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.62,
      "end_seconds": 340.07,
      "duration_seconds": 9.45,
      "text": "I'm going to put you on amoxicillin, 500 milligrams, three times a day, five days. It's for chest infection."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.58,
      "end_seconds": 343.15,
      "duration_seconds": 2.57,
      "text": "How soon will it work?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.65,
      "end_seconds": 362.98,
      "duration_seconds": 18.33,
      "text": "Rest, drink plenty, and come back if you are not improving in two days. Please take the tablets with food so they don't upset your stomach. One warning sign to remember: the symptoms get worse. In that case don't wait."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 364.56,
      "end_seconds": 368.32,
      "duration_seconds": 3.76,
      "text": "Okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.78,
      "end_seconds": 371.78,
      "duration_seconds": 2.0,
      "text": "Come back in one week."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 372.85,
      "end_seconds": 373.55,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 374.4,
      "end_seconds": 376.8,
      "duration_seconds": 2.4,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 379.7,
      "end_seconds": 384.17,
      "duration_seconds": 4.47,
      "text": "No, you know, that's all. Thanks a lot."
    }
  ]
}