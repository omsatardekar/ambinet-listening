      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.67,
      "end_seconds": 353.33,
      "duration_seconds": 2.66,
      "text": "Yes, um, that's manageable."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.42,
      "end_seconds": 357.16,
      "duration_seconds": 2.74,
      "text": "Does all of that make sense?"
