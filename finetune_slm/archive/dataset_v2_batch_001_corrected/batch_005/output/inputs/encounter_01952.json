      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.14,
      "end_seconds": 264.22,
      "duration_seconds": 10.08,
      "text": "okay: SpO2 99 percent on room air respiratory rate 18. And And pulse 80 pressure 118 over 79 temp 36.7 degrees"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.33,
      "end_seconds": 268.39,
      "duration_seconds": 3.06,
      "text": "Okay, time for me to examine you."
