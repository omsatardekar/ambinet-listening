{
  "schema_version": "1.0",
  "encounter_id": "01749",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.52,
      "end_seconds": 3.04,
      "duration_seconds": 2.52,
      "text": "Hello, come in. Mind the step."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.78,
      "end_seconds": 11.0,
      "duration_seconds": 6.22,
      "text": "Sorry, you know, what was I saying, good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.04,
      "end_seconds": 15.71,
      "duration_seconds": 2.67,
      "text": "Did you take the bus in?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 16.59,
      "end_seconds": 19.76,
      "duration_seconds": 3.17,
      "text": "I drove. The roads were quiet today."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.26,
      "end_seconds": 22.68,
      "duration_seconds": 2.42,
      "text": "Alright, what's been worrying you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.3,
      "end_seconds": 26.39,
      "duration_seconds": 2.09,
      "text": "It's ear pain, mostly."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.14,
      "end_seconds": 31.44,
      "duration_seconds": 3.3,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.05,
      "end_seconds": 46.37,
      "duration_seconds": 14.32,
      "text": "I've had it since yesterday. I'd rather know what's going on than keep guessing. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.94,
      "end_seconds": 52.34,
      "duration_seconds": 5.4,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 53.15,
      "end_seconds": 59.39,
      "duration_seconds": 6.24,
      "text": "I get some relief from paracetamol. I notice it more with lying down."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.97,
      "end_seconds": 62.72,
      "duration_seconds": 2.75,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.77,
      "end_seconds": 74.8,
      "duration_seconds": 10.03,
      "text": "A temperature goes along with it, most of the time. The temperature? That's been for about two weeks."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.06,
      "end_seconds": 78.81,
      "duration_seconds": 2.75,
      "text": "And stiff neck, any of that?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.62,
      "end_seconds": 83.3,
      "duration_seconds": 3.68,
      "text": "No, I haven't had any stiff neck."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.93,
      "end_seconds": 90.94,
      "duration_seconds": 6.01,
      "text": "Have you had any swelling behind the ear, hearing loss or discharge?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.84,
      "end_seconds": 94.91,
      "duration_seconds": 2.07,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.75,
      "end_seconds": 100.34,
      "duration_seconds": 4.59,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.48,
      "end_seconds": 103.2,
      "duration_seconds": 1.72,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.71,
      "end_seconds": 107.65,
      "duration_seconds": 3.94,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.73,
      "end_seconds": 110.78,
      "duration_seconds": 1.05,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.47,
      "end_seconds": 116.86,
      "duration_seconds": 4.39,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.74,
      "end_seconds": 121.46,
      "duration_seconds": 2.72,
      "text": "Thin bones, for five years."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.41,
      "end_seconds": 135.04,
      "duration_seconds": 4.63,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.24,
      "end_seconds": 141.27,
      "duration_seconds": 5.03,
      "text": "I'm allergic to plasters, I get a red itchy rash."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.82,
      "end_seconds": 144.78,
      "duration_seconds": 1.96,
      "text": "Alright, any previous surgeries?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 149.14,
      "end_seconds": 152.23,
      "duration_seconds": 3.09,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.87,
      "end_seconds": 166.5,
      "duration_seconds": 3.63,
      "text": "Okay, which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 168.42,
      "end_seconds": 177.0,
      "duration_seconds": 8.58,
      "text": "I take alendronate, 70 milligrams, once a week. I take paracetamol syrup, 5 ml, every six hours."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.9,
      "end_seconds": 181.39,
      "duration_seconds": 2.49,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 182.63,
      "end_seconds": 186.2,
      "duration_seconds": 3.57,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.03,
      "end_seconds": 192.24,
      "duration_seconds": 1.21,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.75,
      "end_seconds": 197.08,
      "duration_seconds": 4.33,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.9,
      "end_seconds": 200.3,
      "duration_seconds": 2.4,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.5,
      "end_seconds": 212.97,
      "duration_seconds": 2.47,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.51,
      "end_seconds": 243.61,
      "duration_seconds": 13.1,
      "text": "Okay: temp 38.2 degrees, BP is 122 over 70, saturation 95 percent, height 180 centimetres, weight 58 kilos, BMI works out to 17.9, pulse 108."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 245.45,
      "end_seconds": 247.64,
      "duration_seconds": 2.19,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.69,
      "end_seconds": 252.64,
      "duration_seconds": 3.95,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.74,
      "end_seconds": 258.04,
      "duration_seconds": 4.3,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.13,
      "end_seconds": 260.55,
      "duration_seconds": 1.42,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.07,
      "end_seconds": 283.57,
      "duration_seconds": 5.5,
      "text": "The right ear drum is red and bulging, and the left is normal."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 289.29,
      "end_seconds": 291.0,
      "duration_seconds": 1.71,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.08,
      "end_seconds": 311.29,
      "duration_seconds": 5.21,
      "text": "Right, here's what I'm thinking. I'd lean towards acute middle ear infection."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 312.86,
      "end_seconds": 315.12,
      "duration_seconds": 2.26,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 316.72,
      "end_seconds": 352.81,
      "duration_seconds": 36.09,
      "text": "I understand the worry. At the moment I'd say it's acute middle ear infection, and we'll watch how it goes. I'd like you to take amoxicillin, 250 milligrams, three times a day, five days. You take it by mouth. That should help with ear infection. Give pain relief regularly and plenty to drink. Come back or go to emergency straight away if the symptoms get worse. Please come and see me if not better in two days."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 353.93,
      "end_seconds": 362.33,
      "duration_seconds": 8.4,
      "text": "Can you tell me the plan back in your own words, so I know I've explained it clearly?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 362.9,
      "end_seconds": 373.71,
      "duration_seconds": 10.81,
      "text": "So, I take the amoxicillin, 250 milligrams, three times a day and come back if not better in two days. Is that right?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 375.35,
      "end_seconds": 379.36,
      "duration_seconds": 4.01,
      "text": "Yes, exactly right. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 379.97,
      "end_seconds": 382.21,
      "duration_seconds": 2.24,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 383.82,
      "end_seconds": 385.25,
      "duration_seconds": 1.43,
      "text": "All the best."
    }
  ]
}