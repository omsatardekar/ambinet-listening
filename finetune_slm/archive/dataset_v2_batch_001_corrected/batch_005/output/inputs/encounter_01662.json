{
  "schema_version": "1.0",
  "encounter_id": "01662",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.26,
      "end_seconds": 6.2,
      "duration_seconds": 4.94,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.47,
      "end_seconds": 14.68,
      "duration_seconds": 4.21,
      "text": "Alright, of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 16.01,
      "end_seconds": 20.72,
      "duration_seconds": 4.71,
      "text": "Ah, good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.25,
      "end_seconds": 25.06,
      "duration_seconds": 2.81,
      "text": "please do. Extra information is always welcome"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.03,
      "end_seconds": 36.11,
      "duration_seconds": 6.08,
      "text": "I wanted to get a pulled muscle in my thigh looked at."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.92,
      "end_seconds": 39.0,
      "duration_seconds": 2.08,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.08,
      "end_seconds": 47.69,
      "duration_seconds": 6.61,
      "text": "I'm on metoprolol, 50 milligrams, twice a day for the heart rhythm."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 49.35,
      "end_seconds": 60.18,
      "duration_seconds": 10.83,
      "text": "right, doctor, I think the last prescription for the metoprolol was 25 milligrams we changed it at the last visit"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.91,
      "end_seconds": 65.31,
      "duration_seconds": 3.4,
      "text": "Alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.46,
      "end_seconds": 78.79,
      "duration_seconds": 12.33,
      "text": "Mm, I don't think I have it with me. It's Tiotropium inhaler, once a day. I take ibuprofen gel, three times a day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.8,
      "end_seconds": 82.51,
      "duration_seconds": 2.71,
      "text": "Okay, when did you start it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.7,
      "end_seconds": 85.21,
      "duration_seconds": 1.51,
      "text": "for two months"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.56,
      "end_seconds": 89.36,
      "duration_seconds": 3.8,
      "text": "Mm-hmm. Has this been going on for long?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.35,
      "end_seconds": 93.04,
      "duration_seconds": 2.69,
      "text": "For two days, I'd say."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.13,
      "end_seconds": 97.98,
      "duration_seconds": 3.85,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.16,
      "end_seconds": 109.65,
      "duration_seconds": 10.49,
      "text": "Mostly severe. And there's tightness as well, um, three days now. I've also had a bit of bruising, for four weeks."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.26,
      "end_seconds": 130.38,
      "duration_seconds": 2.12,
      "text": "Has there been any fall?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.29,
      "end_seconds": 133.98,
      "duration_seconds": 1.69,
      "text": "no, no fall"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.86,
      "end_seconds": 139.56,
      "duration_seconds": 4.7,
      "text": "Okay, and what about numbness, pop at the time or swelling?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.85,
      "end_seconds": 145.25,
      "duration_seconds": 4.4,
      "text": "No, no numbness, pop at the time or swelling."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.95,
      "end_seconds": 152.38,
      "duration_seconds": 2.43,
      "text": "anything different when you pass water?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.01,
      "end_seconds": 155.49,
      "duration_seconds": 1.48,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.54,
      "end_seconds": 165.23,
      "duration_seconds": 4.69,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.52,
      "end_seconds": 170.24,
      "duration_seconds": 3.72,
      "text": "I'm allergic to walnuts, I get hives"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.9,
      "end_seconds": 174.16,
      "duration_seconds": 3.26,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.55,
      "end_seconds": 183.28,
      "duration_seconds": 4.73,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.48,
      "end_seconds": 186.07,
      "duration_seconds": 1.59,
      "text": "how active are you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.29,
      "end_seconds": 190.93,
      "duration_seconds": 3.64,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.16,
      "end_seconds": 194.61,
      "duration_seconds": 2.45,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.22,
      "end_seconds": 200.09,
      "duration_seconds": 4.87,
      "text": "An irregular heartbeat, for two years i've got COPD"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.4,
      "end_seconds": 211.3,
      "duration_seconds": 9.9,
      "text": "I follow. Right, so COPD is already on your record. We'll keep that in mind today. Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.91,
      "end_seconds": 225.29,
      "duration_seconds": 2.38,
      "text": "sit still for a moment.."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.14,
      "end_seconds": 250.02,
      "duration_seconds": 5.88,
      "text": "Okay: temperature is 36.9 degrees, pulse 79, BP is 112 over 68."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.24,
      "end_seconds": 254.58,
      "duration_seconds": 3.34,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.72,
      "end_seconds": 257.83,
      "duration_seconds": 2.11,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.41,
      "end_seconds": 275.77,
      "duration_seconds": 7.36,
      "text": "there is mild tenderness in the back of the thigh and you can still straighten the knee fully"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.64,
      "end_seconds": 281.51,
      "duration_seconds": 1.87,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.09,
      "end_seconds": 297.31,
      "duration_seconds": 6.22,
      "text": "So where does that leave us? It fits best with a mild hamstring strain."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.53,
      "end_seconds": 301.82,
      "duration_seconds": 3.29,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.42,
      "end_seconds": 308.37,
      "duration_seconds": 5.95,
      "text": "Nothing I've seen today points to an emergency. It looks like a mild hamstring strain."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.29,
      "end_seconds": 346.68,
      "duration_seconds": 19.39,
      "text": "rest for a few days, ice it, and then ease back in with gentle stretching and please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.94,
      "end_seconds": 350.28,
      "duration_seconds": 2.34,
      "text": "Thank you, that's helpful."
    }
  ]
}