  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.73,
      "end_seconds": 6.64,
      "duration_seconds": 5.91,
      "text": "Sorry, what was I saying, hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.99,
      "end_seconds": 11.66,
      "duration_seconds": 3.67,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.42,
      "end_seconds": 17.56,
      "duration_seconds": 5.14,
      "text": "yeah, it's tired muscles. I don't know what's causing it"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.26,
      "end_seconds": 22.46,
      "duration_seconds": 3.2,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.67,
      "end_seconds": 29.6,
      "duration_seconds": 5.93,
      "text": "I'd say about three months actually, no, closer to to six months"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.57,
      "end_seconds": 33.69,
      "duration_seconds": 3.12,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.24,
      "end_seconds": 44.16,
      "duration_seconds": 9.92,
      "text": "I'd give it a eight, uh, out of ten. And a mild ache in my legs, too."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.9,
      "end_seconds": 48.24,
      "duration_seconds": 2.34,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.33,
      "end_seconds": 56.11,
      "duration_seconds": 5.78,
      "text": "It sort of comes and goes. There's not getting outdoors as well."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.98,
      "end_seconds": 60.87,
      "duration_seconds": 2.89,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.31,
      "end_seconds": 67.22,
      "duration_seconds": 4.91,
      "text": "Maybe a three out of ten on a bad day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.44,
      "end_seconds": 72.08,
      "duration_seconds": 4.64,
      "text": "Mm-hmm. A few quick ones: bone pain, weakness or fractures?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.01,
      "end_seconds": 77.85,
      "duration_seconds": 4.84,
      "text": "no bone pain, weakness or fractures, none of it"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.0,
      "end_seconds": 85.57,
      "duration_seconds": 2.57,
      "text": "Has there been any weight loss?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.87,
      "end_seconds": 88.82,
      "duration_seconds": 1.95,
      "text": "Nope, no weight loss."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.72,
      "end_seconds": 91.89,
      "duration_seconds": 2.17,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.97,
      "end_seconds": 97.43,
      "duration_seconds": 3.46,
      "text": "Ah, nothing on the skin, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.57,
      "end_seconds": 105.35,
      "duration_seconds": 2.78,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.98,
      "end_seconds": 108.94,
      "duration_seconds": 2.96,
      "text": "no, you know, nothing there"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.3,
      "end_seconds": 120.7,
      "duration_seconds": 4.4,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.5,
      "end_seconds": 126.36,
      "duration_seconds": 4.86,
      "text": "yes, nickel i get a rash on my skin"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.39,
      "end_seconds": 131.85,
      "duration_seconds": 4.46,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.51,
      "end_seconds": 134.69,
      "duration_seconds": 2.18,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.62,
      "end_seconds": 139.25,
      "duration_seconds": 2.63,
      "text": "Alright, anything surgical in your history?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.9,
      "end_seconds": 144.8,
      "duration_seconds": 4.9,
      "text": "yes, I had my tonsils removed, as a teenager"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.73,
      "end_seconds": 148.82,
      "duration_seconds": 3.09,
      "text": "are you on your own at home?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.24,
      "end_seconds": 153.35,
      "duration_seconds": 3.11,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.4,
      "end_seconds": 159.65,
      "duration_seconds": 1.25,
      "text": "are you active?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.26,
      "end_seconds": 166.14,
      "duration_seconds": 2.88,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.64,
      "end_seconds": 172.99,
      "duration_seconds": 2.35,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.83,
      "end_seconds": 177.6,
      "duration_seconds": 3.77,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.56,
      "end_seconds": 180.94,
      "duration_seconds": 2.38,
      "text": "let's run through your medicines"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.05,
      "end_seconds": 193.32,
      "duration_seconds": 11.27,
      "text": "I take tamsulosin, 0.4 milligrams, at night for the prostate. I take carbamazepine, 200 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.31,
      "end_seconds": 200.86,
      "duration_seconds": 2.55,
      "text": "Right, what about your medical history?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.69,
      "end_seconds": 213.75,
      "duration_seconds": 11.06,
      "text": "right, I've had an enlarged prostate for two years now. I've been putting this off for weeks. I've had epilepsy, yes"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.16,
      "end_seconds": 217.21,
      "duration_seconds": 2.05,
      "text": "Alright, is that everything?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.04,
      "end_seconds": 227.54,
      "duration_seconds": 8.5,
      "text": "Yes, epilepsy is known to us, good to have that clear. I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.99,
      "end_seconds": 237.15,
      "duration_seconds": 2.16,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.26,
      "end_seconds": 267.59,
      "duration_seconds": 11.33,
      "text": "Okay: temperature 36.8, blood pressure 120 over 74, respiratory rate 16. And heart rate 76, oxygen saturation is 98 percent, height 167 centimetres, weight 88 kilos."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.42,
      "end_seconds": 271.88,
      "duration_seconds": 2.46,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.47,
      "end_seconds": 274.7,
      "duration_seconds": 1.23,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.6,
      "end_seconds": 293.12,
      "duration_seconds": 4.52,
      "text": "Your muscle strength is normal and there is no bone tenderness."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.02,
      "end_seconds": 312.41,
      "duration_seconds": 1.39,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.77,
      "end_seconds": 318.67,
      "duration_seconds": 1.9,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.28,
      "end_seconds": 340.25,
      "duration_seconds": 8.97,
      "text": "Let's use colecalciferol, 1000 units, once a day, three months. You take it by mouth. That's for low vitamin D."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.25,
      "end_seconds": 348.58,
      "duration_seconds": 4.33,
      "text": "can I collect it from my own pharmacy?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.83,
      "end_seconds": 355.01,
      "duration_seconds": 5.18,
      "text": "before we finish, can you repeat the plan back to me?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 356.46,
      "end_seconds": 363.49,
      "duration_seconds": 7.03,
      "text": "So, I take the colecalciferol, 1000 units, once a day. Is that right?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.06,
      "end_seconds": 369.22,
      "duration_seconds": 4.16,
      "text": "Yes, exactly right. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 370.58,
      "end_seconds": 373.81,
      "duration_seconds": 3.23,
      "text": "I think I understand everything. Thanks"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 374.87,
      "end_seconds": 376.05,
      "duration_seconds": 1.18,
      "text": "All the best."
    }
  ]
