{
  "schema_version": "1.0",
  "encounter_id": "01763",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.39,
      "end_seconds": 6.56,
      "duration_seconds": 5.17,
      "text": "Uh, good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.53,
      "end_seconds": 11.38,
      "duration_seconds": 3.85,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.37,
      "end_seconds": 25.29,
      "duration_seconds": 11.92,
      "text": "Mainly severe pain in the upper tummy going through to the back. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.47,
      "end_seconds": 30.52,
      "duration_seconds": 4.05,
      "text": "Since when exactly? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.23,
      "end_seconds": 34.78,
      "duration_seconds": 3.55,
      "text": "So, it's been like this since yesterday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.74,
      "end_seconds": 44.88,
      "duration_seconds": 8.14,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.02,
      "end_seconds": 54.4,
      "duration_seconds": 8.38,
      "text": "Leaning forward helps a bit. It's worse with lying flat. I'd say severe. Honestly, on and off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.74,
      "end_seconds": 59.85,
      "duration_seconds": 4.11,
      "text": "Did you get yellow eyes, chest pain or black stools?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.17,
      "end_seconds": 65.14,
      "duration_seconds": 3.97,
      "text": "Okay, so no, none of those at all."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.2,
      "end_seconds": 73.18,
      "duration_seconds": 5.98,
      "text": "Okay, have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.98,
      "end_seconds": 76.93,
      "duration_seconds": 1.95,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.06,
      "end_seconds": 90.51,
      "duration_seconds": 3.45,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.26,
      "end_seconds": 94.42,
      "duration_seconds": 3.16,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.64,
      "end_seconds": 100.85,
      "duration_seconds": 3.21,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.52,
      "end_seconds": 102.55,
      "duration_seconds": 1.03,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.29,
      "end_seconds": 115.15,
      "duration_seconds": 4.86,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.25,
      "end_seconds": 119.77,
      "duration_seconds": 3.52,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.79,
      "end_seconds": 124.27,
      "duration_seconds": 3.48,
      "text": "Okay, are you in work at the moment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.3,
      "end_seconds": 129.28,
      "duration_seconds": 3.98,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.11,
      "end_seconds": 133.89,
      "duration_seconds": 2.78,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.77,
      "end_seconds": 138.02,
      "duration_seconds": 3.25,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.01,
      "end_seconds": 141.4,
      "duration_seconds": 1.39,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.44,
      "end_seconds": 146.47,
      "duration_seconds": 3.03,
      "text": "Right, no, not at all."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.99,
      "end_seconds": 163.81,
      "duration_seconds": 2.82,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.14,
      "end_seconds": 179.16,
      "duration_seconds": 3.02,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.09,
      "end_seconds": 201.73,
      "duration_seconds": 9.64,
      "text": "Okay: SpO2 97 percent on room air, temperature 37.0, respiratory rate 19, pulse 114, BP is 138 over 72."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.46,
      "end_seconds": 207.13,
      "duration_seconds": 3.67,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.99,
      "end_seconds": 211.32,
      "duration_seconds": 2.33,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.38,
      "end_seconds": 222.4,
      "duration_seconds": 4.02,
      "text": "Your upper tummy is very tender and you look dehydrated."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.39,
      "end_seconds": 240.54,
      "duration_seconds": 12.15,
      "text": "Okay, that's enough for me. Having listened and examined, it's hard to say. Acute pancreatitis is one possibility and gallstone disease another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.87,
      "end_seconds": 244.7,
      "duration_seconds": 2.83,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.46,
      "end_seconds": 252.96,
      "duration_seconds": 6.5,
      "text": "I can't promise yet, but most people with acute pancreatitis do well once it's treated properly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.8,
      "end_seconds": 264.2,
      "duration_seconds": 3.4,
      "text": "We should do an abdominal scan for pancreatitis."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.81,
      "end_seconds": 268.37,
      "duration_seconds": 2.56,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.24,
      "end_seconds": 287.94,
      "duration_seconds": 18.7,
      "text": "You need admission for fluids and pain relief, nothing to eat for now. Do get help quickly if the symptoms get worse. Come back straight away. How would you describe the plan, so we're on the same page?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.63,
      "end_seconds": 293.35,
      "duration_seconds": 4.72,
      "text": "So, I come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.21,
      "end_seconds": 304.17,
      "duration_seconds": 4.96,
      "text": "Alright, yes, exactly right. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.06,
      "end_seconds": 308.02,
      "duration_seconds": 1.96,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.04,
      "end_seconds": 310.36,
      "duration_seconds": 1.32,
      "text": "Look after yourself."
    }
  ]
}