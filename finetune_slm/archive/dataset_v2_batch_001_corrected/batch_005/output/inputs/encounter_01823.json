{
  "schema_version": "1.0",
  "encounter_id": "01823",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.62,
      "end_seconds": 3.58,
      "duration_seconds": 2.96,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.23,
      "end_seconds": 9.29,
      "duration_seconds": 4.06,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.31,
      "end_seconds": 18.74,
      "duration_seconds": 7.43,
      "text": "Oh, it's a dry mouth. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.11,
      "end_seconds": 23.86,
      "duration_seconds": 3.75,
      "text": "So, when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.87,
      "end_seconds": 30.95,
      "duration_seconds": 5.08,
      "text": "I'd say three weeks. Actually, no, closer to four weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.5,
      "end_seconds": 36.17,
      "duration_seconds": 3.67,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.86,
      "end_seconds": 40.23,
      "duration_seconds": 2.37,
      "text": "Yes, diclofenac. I get wheezing."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.79,
      "end_seconds": 44.13,
      "duration_seconds": 3.34,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.19,
      "end_seconds": 48.36,
      "duration_seconds": 3.17,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.46,
      "end_seconds": 60.38,
      "duration_seconds": 1.92,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.28,
      "end_seconds": 66.01,
      "duration_seconds": 3.73,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.24,
      "end_seconds": 72.61,
      "duration_seconds": 1.37,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.67,
      "end_seconds": 78.06,
      "duration_seconds": 3.39,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.81,
      "end_seconds": 83.14,
      "duration_seconds": 4.33,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.5,
      "end_seconds": 88.01,
      "duration_seconds": 3.51,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.33,
      "end_seconds": 91.04,
      "duration_seconds": 1.71,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.77,
      "end_seconds": 96.31,
      "duration_seconds": 3.54,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.86,
      "end_seconds": 99.86,
      "duration_seconds": 2.0,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.31,
      "end_seconds": 107.33,
      "duration_seconds": 4.02,
      "text": "I had a varicose vein procedure last year."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.85,
      "end_seconds": 119.9,
      "duration_seconds": 4.05,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.06,
      "end_seconds": 126.81,
      "duration_seconds": 5.75,
      "text": "I take oral rehydration salts, 1 sachet, after each loose stool."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.12,
      "end_seconds": 128.99,
      "duration_seconds": 1.87,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.69,
      "end_seconds": 147.71,
      "duration_seconds": 2.02,
      "text": "Any fever or chest pain?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.7,
      "end_seconds": 151.12,
      "duration_seconds": 2.42,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.02,
      "end_seconds": 157.77,
      "duration_seconds": 2.75,
      "text": "Any blood in the stool or confusion?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.67,
      "end_seconds": 161.93,
      "duration_seconds": 2.26,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.91,
      "end_seconds": 166.45,
      "duration_seconds": 2.54,
      "text": "So, is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.07,
      "end_seconds": 171.6,
      "duration_seconds": 3.53,
      "text": "No, you know, joints are fine."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.38,
      "end_seconds": 177.23,
      "duration_seconds": 3.85,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.76,
      "end_seconds": 179.65,
      "duration_seconds": 0.89,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.53,
      "end_seconds": 183.88,
      "duration_seconds": 3.35,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.45,
      "end_seconds": 198.17,
      "duration_seconds": 2.72,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.08,
      "end_seconds": 228.52,
      "duration_seconds": 16.44,
      "text": "Okay: pressure 98 over 66, temperature is 36.4 degrees, SpO2 97 percent on room air, pulse is 96 beats a minute, BMI works out to 24.8, height 185 centimetres, weight 85 kilos."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.98,
      "end_seconds": 231.9,
      "duration_seconds": 1.92,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.81,
      "end_seconds": 235.25,
      "duration_seconds": 2.44,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.15,
      "end_seconds": 243.37,
      "duration_seconds": 5.22,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.89,
      "end_seconds": 247.19,
      "duration_seconds": 2.3,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.32,
      "end_seconds": 270.83,
      "duration_seconds": 6.51,
      "text": "Your mouth is dry, your skin is slack, and your blood pressure drops when you stand."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.98,
      "end_seconds": 273.65,
      "duration_seconds": 1.67,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.22,
      "end_seconds": 286.27,
      "duration_seconds": 10.05,
      "text": "Please sit back down. Let me tell you where I've got to. I think we're dealing with dehydration from gastroenteritis at this stage."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.25,
      "end_seconds": 290.36,
      "duration_seconds": 2.11,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.14,
      "end_seconds": 301.7,
      "duration_seconds": 10.56,
      "text": "I understand the worry. At the moment I'd say it's dehydration from gastroenteritis, and we'll know more once the blood tests is back."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.93,
      "end_seconds": 339.2,
      "duration_seconds": 19.27,
      "text": "I want blood tests done, that's for dehydration. I'd rather check than guess, and this is the quickest way to know more. Sip fluids little and often and hold your water tablet until you are eating again. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.93,
      "end_seconds": 344.13,
      "duration_seconds": 3.2,
      "text": "Thank you, uh, that's helpful."
    }
  ]
}