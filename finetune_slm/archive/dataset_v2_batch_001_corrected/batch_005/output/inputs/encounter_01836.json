  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.75,
      "end_seconds": 3.1,
      "duration_seconds": 2.35,
      "text": "Good morning, grab a seat."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.87,
      "end_seconds": 10.08,
      "duration_seconds": 5.21,
      "text": "Let me think, hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.09,
      "end_seconds": 13.83,
      "duration_seconds": 1.74,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.61,
      "end_seconds": 22.24,
      "duration_seconds": 6.63,
      "text": "Doctor, it's morning stiffness for an hour. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.74,
      "end_seconds": 26.33,
      "duration_seconds": 2.59,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.78,
      "end_seconds": 38.62,
      "duration_seconds": 2.84,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.09,
      "end_seconds": 63.82,
      "duration_seconds": 11.73,
      "text": "Okay: temp 37.0 degrees, blood pressure 121 over 75, height 159 centimetres, weight 61 kilos, saturation 98 percent, heart rate 65, BMI works out to 24.1."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.96,
      "end_seconds": 67.29,
      "duration_seconds": 2.33,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.4,
      "end_seconds": 70.89,
      "duration_seconds": 2.49,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.13,
      "end_seconds": 83.97,
      "duration_seconds": 1.84,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 85.45,
      "end_seconds": 88.33,
      "duration_seconds": 2.88,
      "text": "For six months, I'd say."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.93,
      "end_seconds": 99.24,
      "duration_seconds": 9.31,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.01,
      "end_seconds": 114.47,
      "duration_seconds": 13.46,
      "text": "It's every other day. It feels mild to me. And sore wrists, too. About sore wrists, pretty severe, if I'm being honest. There's tiredness as well."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.22,
      "end_seconds": 119.76,
      "duration_seconds": 3.54,
      "text": "Any chest pain or eye redness at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 124.81,
      "end_seconds": 128.4,
      "duration_seconds": 3.59,
      "text": "No, no chest pain or eye redness."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.49,
      "end_seconds": 133.3,
      "duration_seconds": 2.81,
      "text": "Any fever or rash at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.18,
      "end_seconds": 138.73,
      "duration_seconds": 3.55,
      "text": "No fever or rash, none of it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.84,
      "end_seconds": 142.25,
      "duration_seconds": 2.41,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.61,
      "end_seconds": 147.11,
      "duration_seconds": 3.5,
      "text": "Nothing on the skin, you know, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.7,
      "end_seconds": 151.85,
      "duration_seconds": 3.15,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 156.63,
      "end_seconds": 159.3,
      "duration_seconds": 2.67,
      "text": "Pantoprazole, 40 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.52,
      "end_seconds": 163.67,
      "duration_seconds": 3.15,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.54,
      "end_seconds": 166.92,
      "duration_seconds": 1.38,
      "text": "About two months."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.84,
      "end_seconds": 173.67,
      "duration_seconds": 4.83,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.75,
      "end_seconds": 185.23,
      "duration_seconds": 9.48,
      "text": "Yes, milk. I've no idea what the reaction was, only that I'm not supposed to have it."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.14,
      "end_seconds": 189.2,
      "duration_seconds": 2.06,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 191.25,
      "end_seconds": 197.42,
      "duration_seconds": 6.17,
      "text": "I have acid reflux. Actually, I've had asthma for about ten years now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.3,
      "end_seconds": 200.0,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.56,
      "end_seconds": 216.59,
      "duration_seconds": 2.03,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 217.37,
      "end_seconds": 221.74,
      "duration_seconds": 4.37,
      "text": "Yes, I had my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.57,
      "end_seconds": 235.18,
      "duration_seconds": 2.61,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 236.04,
      "end_seconds": 245.05,
      "duration_seconds": 9.01,
      "text": "I work in accounts at a hospital. I live with my elderly mother. I walk the dog every morning."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.18,
      "end_seconds": 249.3,
      "duration_seconds": 2.12,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.1,
      "end_seconds": 252.49,
      "duration_seconds": 1.39,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.64,
      "end_seconds": 267.33,
      "duration_seconds": 6.69,
      "text": "The knuckles and wrists are swollen and warm, and the squeeze test is painful."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.91,
      "end_seconds": 306.19,
      "duration_seconds": 35.28,
      "text": "Good, you can sit up again. Okay, so my impression is this: This looks most like an inflammatory arthritis flare. Osteoarthritis is also on my list. I'm going to order X-rays of the hands, for inflammatory arthritis. I want blood tests done, that's for inflammatory arthritis. That will help us see what's going on underneath and decide the next step. What I'm giving you is methotrexate, 10 milligrams, once a week, long term. It's for inflammatory arthritis."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.78,
      "end_seconds": 323.74,
      "duration_seconds": 15.96,
      "text": "Gentle hand exercises and warm water in the morning. The rheumatology clinic would be the right next step, I'll refer you. I'll want another look in four weeks. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 326.98,
      "end_seconds": 330.07,
      "duration_seconds": 3.09,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 331.88,
      "end_seconds": 333.09,
      "duration_seconds": 1.21,
      "text": "Take care now."
    }
  ]
}