  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.97,
      "end_seconds": 4.93,
      "duration_seconds": 3.96,
      "text": "hello? Doctor? I was told to come in"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.55,
      "end_seconds": 12.79,
      "duration_seconds": 6.24,
      "text": "okay you're alright take a a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.35,
      "end_seconds": 17.86,
      "duration_seconds": 4.51,
      "text": "well I've been having heavy bleeding after the birth"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.27,
      "end_seconds": 24.51,
      "duration_seconds": 3.24,
      "text": "what's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.91,
      "end_seconds": 28.06,
      "duration_seconds": 2.15,
      "text": "about... well, two weeks"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.02,
      "end_seconds": 33.16,
      "duration_seconds": 3.14,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.58,
      "end_seconds": 41.44,
      "duration_seconds": 6.86,
      "text": "Okay so so when it starts I tend to get a racing heart as well."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.29,
      "end_seconds": 47.89,
      "duration_seconds": 5.6,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 47.99,
      "end_seconds": 53.84,
      "duration_seconds": 5.85,
      "text": "Sorry to cut in doctor quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.77,
      "end_seconds": 61.8,
      "duration_seconds": 6.03,
      "text": "Later thanks. Please go on. How much trouble does it it give you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.07,
      "end_seconds": 64.54,
      "duration_seconds": 1.47,
      "text": "I'd say mild"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.59,
      "end_seconds": 69.45,
      "duration_seconds": 2.86,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.21,
      "end_seconds": 72.18,
      "duration_seconds": 1.97,
      "text": "it's every other day"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "UNKNOWN",
      "start_seconds": 73.53,
      "end_seconds": 76.28,
      "duration_seconds": 2.75,
      "text": "mm, that's what happened, yes"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 81.73,
      "end_seconds": 87.97,
      "duration_seconds": 6.24,
      "text": "okay so the vitals from earlier heart rate 102 BP is 101 over 56."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.65,
      "end_seconds": 89.35,
      "duration_seconds": 0.7,
      "text": "thanks"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.6,
      "end_seconds": 95.87,
      "duration_seconds": 4.27,
      "text": "let me look at the area, I'll be gentle"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.79,
      "end_seconds": 98.0,
      "duration_seconds": 1.21,
      "text": "breathe out slowly"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.42,
      "end_seconds": 113.19,
      "duration_seconds": 5.77,
      "text": "you are pale and clammy and the womb feels soft and large"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.14,
      "end_seconds": 122.12,
      "duration_seconds": 2.98,
      "text": "Right, good, you can sit up again."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.04,
      "end_seconds": 136.38,
      "duration_seconds": 4.34,
      "text": "Have you had any headache severe pain or fever?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.88,
      "end_seconds": 150.14,
      "duration_seconds": 12.26,
      "text": "Hmm, no, no headache, no severe pain, no fever. I was passing large clots at one point, but that that went away on its own."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.66,
      "end_seconds": 154.94,
      "duration_seconds": 3.28,
      "text": "how are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.48,
      "end_seconds": 157.12,
      "duration_seconds": 1.64,
      "text": "No nothing there."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.35,
      "end_seconds": 161.71,
      "duration_seconds": 3.36,
      "text": "are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.32,
      "end_seconds": 168.94,
      "duration_seconds": 5.62,
      "text": "My uncle has high cholesterol. My sister had breast cancer."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.96,
      "end_seconds": 186.01,
      "duration_seconds": 3.05,
      "text": "Right do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.15,
      "end_seconds": 196.95,
      "duration_seconds": 9.8,
      "text": "Anxiety for five years. Oh I've had thin bones yes. I didn't want to bother you but it keeps coming back"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.7,
      "end_seconds": 199.4,
      "duration_seconds": 0.7,
      "text": "yes"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.13,
      "end_seconds": 208.22,
      "duration_seconds": 7.09,
      "text": "Yes, acid reflux. I've had an irregular heartbeat for about a year now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.74,
      "end_seconds": 211.5,
      "duration_seconds": 1.76,
      "text": "is there anything more?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.99,
      "end_seconds": 223.2,
      "duration_seconds": 10.21,
      "text": "yes, thin bones is known to us, good to have that clear alright, has anything ever caused you a reaction? I mean any allergies"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.3,
      "end_seconds": 239.12,
      "duration_seconds": 13.82,
      "text": "sorry, you know, what was I saying, I think I reacted to to some antibiotic once, years ago. I don't remember which one, or what happened exactly"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.33,
      "end_seconds": 242.36,
      "duration_seconds": 2.03,
      "text": "tell me your medicines please"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.36,
      "end_seconds": 263.36,
      "duration_seconds": 20.0,
      "text": "I take escitalopram 10 milligrams once a day for the anxiety. Alendronate. I take it 70 milligrams once a week. I'm on lansoprazole 30 milligrams before breakfast. It's metoprolol 50 milligrams twice a day for the heart rhythm"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 265.36,
      "end_seconds": 270.06,
      "duration_seconds": 4.7,
      "text": "doctor, our chart from the last visit lists it as 25 milligrams"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.36,
      "end_seconds": 276.84,
      "duration_seconds": 5.48,
      "text": "Okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.4,
      "end_seconds": 287.57,
      "duration_seconds": 9.17,
      "text": "not with me. I'll bring it next time. Before this I was on omeprazole; that's been stopped"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.22,
      "end_seconds": 292.1,
      "duration_seconds": 2.88,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.8,
      "end_seconds": 311.33,
      "duration_seconds": 13.53,
      "text": "I smoke roughly a pack every two days. I used to drink heavily but I stopped four years ago. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.3,
      "end_seconds": 315.87,
      "duration_seconds": 2.57,
      "text": "have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.04,
      "end_seconds": 323.68,
      "duration_seconds": 6.64,
      "text": "let me think yes I had a varicose vein procedure last year"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.94,
      "end_seconds": 331.75,
      "duration_seconds": 6.81,
      "text": "Having listened and examined, it fits best with a postpartum haemorrhage. Retained tissue is still possible."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.55,
      "end_seconds": 338.58,
      "duration_seconds": 5.03,
      "text": "I mean, you know, what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.98,
      "end_seconds": 359.26,
      "duration_seconds": 19.28,
      "text": "it's reasonable to be concerned, but right now a postpartum haemorrhage is my leading thought, not anything worse just to be sure I understood you've had heavy bleeding after the birth for two weeks, and no severe pain or fever"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.99,
      "end_seconds": 361.46,
      "duration_seconds": 1.47,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.12,
      "end_seconds": 367.14,
      "duration_seconds": 4.02,
      "text": "I'm sending you for urgent blood tests because of haemorrhage"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 369.11,
      "end_seconds": 373.59,
      "duration_seconds": 4.48,
      "text": "we have a slot Monday at 2 pm if that works"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 374.53,
      "end_seconds": 404.33,
      "duration_seconds": 29.8,
      "text": "I'm going to order an urgent scan for bleeding. That will help us see what's going on underneath and decide the next step. Let's use oxytocin 10 units now single dose. That's for postpartum bleeding. I am rubbing the womb to help it contract and calling the emergency team. And please bring the latest prescription or the medicine boxes to the next visit so we can settle the dose. Let's review you straight away."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 405.53,
      "end_seconds": 407.99,
      "duration_seconds": 2.46,
      "text": "that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 409.27,
      "end_seconds": 413.22,
      "duration_seconds": 3.95,
      "text": "right uh I'll do that thank you doctor"
    }
  ]
}