  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.23,
      "end_seconds": 4.09,
      "duration_seconds": 2.86,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.0,
      "end_seconds": 10.56,
      "duration_seconds": 4.56,
      "text": "not at all, please sit what seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.12,
      "end_seconds": 19.42,
      "duration_seconds": 7.3,
      "text": "I've been putting on weight over the years, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.59,
      "end_seconds": 24.01,
      "duration_seconds": 3.42,
      "text": "when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.77,
      "end_seconds": 39.4,
      "duration_seconds": 13.63,
      "text": "it's been ten days, I'm fairly sure. And I've been snoring as well, for five days. I've also had sore knees, for ten days"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.54,
      "end_seconds": 45.16,
      "duration_seconds": 4.62,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.83,
      "end_seconds": 53.78,
      "duration_seconds": 6.95,
      "text": "Pretty mild, if I'm being honest. It happens once or twice a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.75,
      "end_seconds": 60.3,
      "duration_seconds": 5.55,
      "text": "Have you been putting on weight over the years at any time before this?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.43,
      "end_seconds": 68.67,
      "duration_seconds": 7.24,
      "text": "Yes, something like this happened last winter, and it went away on its own."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.42,
      "end_seconds": 72.34,
      "duration_seconds": 2.92,
      "text": "has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.74,
      "end_seconds": 78.81,
      "duration_seconds": 3.07,
      "text": "High blood pressure, for two years."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.73,
      "end_seconds": 101.02,
      "duration_seconds": 3.29,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.93,
      "end_seconds": 107.64,
      "duration_seconds": 4.71,
      "text": "sorry, what was I saying, my cousin has psoriasis"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.14,
      "end_seconds": 125.46,
      "duration_seconds": 3.32,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.3,
      "end_seconds": 129.18,
      "duration_seconds": 2.88,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.68,
      "end_seconds": 133.09,
      "duration_seconds": 3.41,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.67,
      "end_seconds": 140.06,
      "duration_seconds": 5.39,
      "text": "it's something called rami... ramipril, 5 milligrams, maybe, every morning"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.79,
      "end_seconds": 150.33,
      "duration_seconds": 4.54,
      "text": "Have you got the box or the the prescription on you?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.9,
      "end_seconds": 154.07,
      "duration_seconds": 2.17,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.96,
      "end_seconds": 161.43,
      "duration_seconds": 2.47,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.64,
      "end_seconds": 166.71,
      "duration_seconds": 4.07,
      "text": "I had a varicose vein procedure last year."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.67,
      "end_seconds": 171.91,
      "duration_seconds": 3.24,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.45,
      "end_seconds": 188.58,
      "duration_seconds": 16.13,
      "text": "I used to drink heavily but I stopped four years ago. I'm a hairdresser, on my feet all day. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.39,
      "end_seconds": 192.11,
      "duration_seconds": 2.72,
      "text": "And what about chest pain or palpitations?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.27,
      "end_seconds": 196.19,
      "duration_seconds": 2.92,
      "text": "Um, none of those, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.26,
      "end_seconds": 199.65,
      "duration_seconds": 2.39,
      "text": "Any low mood or high thirst?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.7,
      "end_seconds": 203.34,
      "duration_seconds": 2.64,
      "text": "no, none that I've noticed"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.03,
      "end_seconds": 207.96,
      "duration_seconds": 3.93,
      "text": "what about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.92,
      "end_seconds": 212.29,
      "duration_seconds": 3.37,
      "text": "I mean, no, that side's been fine."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.61,
      "end_seconds": 231.56,
      "duration_seconds": 2.95,
      "text": "I'll just record a few vital signs"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.93,
      "end_seconds": 243.46,
      "duration_seconds": 3.53,
      "text": "Alright, bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.85,
      "end_seconds": 267.95,
      "duration_seconds": 15.1,
      "text": "Okay: BMI works out to 24.5, weight 81 kilos, height 182 centimetres. And temperature is 36.8 degrees, SpO2 99 percent on room air, heart rate 87, BP is 165 over 92."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.81,
      "end_seconds": 270.21,
      "duration_seconds": 1.4,
      "text": "is that okay?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.29,
      "end_seconds": 275.1,
      "duration_seconds": 3.81,
      "text": "Right, I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.99,
      "end_seconds": 281.71,
      "duration_seconds": 3.72,
      "text": "right, let's have a proper look at you"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.22,
      "end_seconds": 285.68,
      "duration_seconds": 2.46,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.68,
      "end_seconds": 297.96,
      "duration_seconds": 4.28,
      "text": "Your weight and waist measurement are both above the healthy range."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.85,
      "end_seconds": 320.8,
      "duration_seconds": 19.95,
      "text": "that's all I needed to check putting it all together, it points towards obesity with weight-related symptoms another possibility is an underactive thyroid stop me if I've got anything wrong you've been putting on weight over the years for ten days, and no chest pain or low mood"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.46,
      "end_seconds": 323.16,
      "duration_seconds": 0.7,
      "text": "correct"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.52,
      "end_seconds": 356.57,
      "duration_seconds": 32.05,
      "text": "An HbA1c is what I'd like next, for obesity. Aim for a loss of half a kilo a week with smaller portions and a daily thirty-minute walk. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Come back or go to emergency straight away if the symptoms get worse. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.42,
      "end_seconds": 363.85,
      "duration_seconds": 4.43,
      "text": "No, you know, that's all. Thanks a a lot."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.72,
      "end_seconds": 367.62,
      "duration_seconds": 1.9,
      "text": "Okay, all the best."
    }
  ]
}