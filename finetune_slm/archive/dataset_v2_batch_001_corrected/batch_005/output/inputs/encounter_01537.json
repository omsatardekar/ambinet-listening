{
  "schema_version": "1.0",
  "encounter_id": "01537",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.62,
      "end_seconds": 5.11,
      "duration_seconds": 4.49,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.64,
      "end_seconds": 9.9,
      "duration_seconds": 4.26,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.84,
      "end_seconds": 15.21,
      "duration_seconds": 3.37,
      "text": "I've been dealing with ear pain."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.21,
      "end_seconds": 19.52,
      "duration_seconds": 3.31,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.55,
      "end_seconds": 27.96,
      "duration_seconds": 3.41,
      "text": "I've had it for three days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.18,
      "end_seconds": 45.91,
      "duration_seconds": 13.73,
      "text": "Right, can you describe it a bit more for me? How strong it is, what the pattern is, what helps. It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.47,
      "end_seconds": 53.61,
      "duration_seconds": 6.14,
      "text": "Uh, I'd say every other day. It's worse with lying down."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.02,
      "end_seconds": 57.63,
      "duration_seconds": 2.61,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.57,
      "end_seconds": 72.0,
      "duration_seconds": 13.43,
      "text": "It usually comes with pulling at the ear. There's not eating as well. With pulling at the ear, a four out of ten, I suppose."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.35,
      "end_seconds": 77.94,
      "duration_seconds": 4.59,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.66,
      "end_seconds": 82.44,
      "duration_seconds": 2.78,
      "text": "Ah, no, nothing at all."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.08,
      "end_seconds": 100.47,
      "duration_seconds": 2.39,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.68,
      "end_seconds": 107.41,
      "duration_seconds": 3.73,
      "text": "Paracetamol syrup, 5 ml, every six hours."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.78,
      "end_seconds": 119.98,
      "duration_seconds": 4.2,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.43,
      "end_seconds": 134.71,
      "duration_seconds": 13.28,
      "text": "I do a yoga class on Thursdays. Lots of rice, lentils and some fruit. I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.44,
      "end_seconds": 139.38,
      "duration_seconds": 3.94,
      "text": "Any swelling behind the ear, discharge or stiff neck?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.84,
      "end_seconds": 147.43,
      "duration_seconds": 6.59,
      "text": "Okay, so no, no swelling behind the ear, discharge or stiff neck."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.38,
      "end_seconds": 154.89,
      "duration_seconds": 2.51,
      "text": "Have you had any hearing loss?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.79,
      "end_seconds": 157.86,
      "duration_seconds": 2.07,
      "text": "Nope, no hearing loss."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.55,
      "end_seconds": 161.64,
      "duration_seconds": 2.09,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.31,
      "end_seconds": 166.41,
      "duration_seconds": 3.1,
      "text": "Mm, no, joints are fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.04,
      "end_seconds": 173.78,
      "duration_seconds": 3.74,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.7,
      "end_seconds": 188.36,
      "duration_seconds": 3.66,
      "text": "Alright, that's it, just a little longer..."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.88,
      "end_seconds": 224.86,
      "duration_seconds": 14.98,
      "text": "Okay: heart rate 97, blood pressure 105 over 68, oxygen saturation is 97 percent. Listening to the whole story, it points towards acute middle ear infection. I'd also keep a viral cold in mind."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.65,
      "end_seconds": 229.85,
      "duration_seconds": 3.2,
      "text": "Is it dangerous, uh, doctor?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.6,
      "end_seconds": 239.44,
      "duration_seconds": 8.84,
      "text": "I understand the worry. At the moment I'd say it's acute middle ear infection, and we'll watch how it goes."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.19,
      "end_seconds": 276.6,
      "duration_seconds": 20.41,
      "text": "I'm prescribing amoxicillin, 250 milligrams, three times a day, five days. It's for ear infection. Give pain relief regularly and plenty to drink. I'd like to see you again if not better in two days. How would you describe the plan, so we're on the same page?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.08,
      "end_seconds": 293.89,
      "duration_seconds": 15.81,
      "text": "So, you know, I take the amoxicillin, 250 milligrams, three times a day and come back if not better in two days. Is that right?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.88,
      "end_seconds": 300.48,
      "duration_seconds": 5.6,
      "text": "Yes, exactly right. Right, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.38,
      "end_seconds": 305.67,
      "duration_seconds": 4.29,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}