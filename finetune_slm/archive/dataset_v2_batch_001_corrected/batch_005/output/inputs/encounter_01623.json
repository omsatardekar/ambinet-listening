{
  "schema_version": "1.0",
  "encounter_id": "01623",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.87,
      "end_seconds": 6.52,
      "duration_seconds": 5.65,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.86,
      "end_seconds": 11.92,
      "duration_seconds": 4.06,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.67,
      "end_seconds": 19.53,
      "duration_seconds": 5.86,
      "text": "Hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.07,
      "end_seconds": 25.02,
      "duration_seconds": 4.95,
      "text": "Alright, that's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.59,
      "end_seconds": 35.97,
      "duration_seconds": 9.38,
      "text": "Um, so... being extremely thirsty. That's why I came. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.45,
      "end_seconds": 39.98,
      "duration_seconds": 2.53,
      "text": "Alright, did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.62,
      "end_seconds": 47.69,
      "duration_seconds": 2.07,
      "text": "Probably ten days. Yeah."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.45,
      "end_seconds": 52.35,
      "duration_seconds": 2.9,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.44,
      "end_seconds": 55.13,
      "duration_seconds": 1.69,
      "text": "It's severe, honestly."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.14,
      "end_seconds": 60.76,
      "duration_seconds": 3.62,
      "text": "Have you been passing huge amounts of urine?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.88,
      "end_seconds": 64.0,
      "duration_seconds": 2.12,
      "text": "Yes, uh, actually."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.12,
      "end_seconds": 70.54,
      "duration_seconds": 5.42,
      "text": "Have you had being extremely thirsty before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.83,
      "end_seconds": 79.15,
      "duration_seconds": 7.32,
      "text": "I had a similar thing a couple of years ago. It went away."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.14,
      "end_seconds": 101.96,
      "duration_seconds": 3.82,
      "text": "Have you noticed chest pain, vomiting or fever?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.76,
      "end_seconds": 106.88,
      "duration_seconds": 3.12,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.34,
      "end_seconds": 111.82,
      "duration_seconds": 4.48,
      "text": "Yes, carry on. How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.89,
      "end_seconds": 118.24,
      "duration_seconds": 1.35,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.91,
      "end_seconds": 120.47,
      "duration_seconds": 1.56,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.27,
      "end_seconds": 125.1,
      "duration_seconds": 2.83,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.15,
      "end_seconds": 127.47,
      "duration_seconds": 1.32,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.69,
      "end_seconds": 132.8,
      "duration_seconds": 4.11,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.56,
      "end_seconds": 135.54,
      "duration_seconds": 1.98,
      "text": "Right, are you active?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.95,
      "end_seconds": 139.81,
      "duration_seconds": 2.86,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.47,
      "end_seconds": 159.91,
      "duration_seconds": 4.44,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.83,
      "end_seconds": 164.2,
      "duration_seconds": 2.37,
      "text": "Yes, kiwi. I get hives."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.67,
      "end_seconds": 171.43,
      "duration_seconds": 2.76,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.94,
      "end_seconds": 175.32,
      "duration_seconds": 2.38,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.09,
      "end_seconds": 179.29,
      "duration_seconds": 3.2,
      "text": "So, have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.9,
      "end_seconds": 185.9,
      "duration_seconds": 5.0,
      "text": "Yes, I had my tonsils removed, as a teenager."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.34,
      "end_seconds": 190.54,
      "duration_seconds": 3.2,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.55,
      "end_seconds": 192.96,
      "duration_seconds": 1.41,
      "text": "I have diabetes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.69,
      "end_seconds": 197.64,
      "duration_seconds": 3.95,
      "text": "Alright, shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.33,
      "end_seconds": 213.19,
      "duration_seconds": 2.86,
      "text": "Right, sit still for a moment..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.32,
      "end_seconds": 232.22,
      "duration_seconds": 8.9,
      "text": "Okay: heart rate 117, respiratory rate 18, height 154 centimetres, saturation 98 percent, weight 80 kilos, pressure 129 over 84."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.21,
      "end_seconds": 239.42,
      "duration_seconds": 4.21,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.54,
      "end_seconds": 241.66,
      "duration_seconds": 1.12,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.31,
      "end_seconds": 244.61,
      "duration_seconds": 1.3,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.98,
      "end_seconds": 268.24,
      "duration_seconds": 7.26,
      "text": "You are very dry and drowsy, and your sugar reading is too high to read."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.59,
      "end_seconds": 280.03,
      "duration_seconds": 9.44,
      "text": "Good, you can sit up again. Okay, thinking it through, this looks most like a hyperosmolar diabetic emergency. We shouldn't forget sepsis."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.0,
      "end_seconds": 285.25,
      "duration_seconds": 3.25,
      "text": "I mean, will it clear up?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.17,
      "end_seconds": 294.41,
      "duration_seconds": 8.24,
      "text": "It's reasonable to be concerned, but right now a hyperosmolar diabetic emergency is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.98,
      "end_seconds": 327.9,
      "duration_seconds": 25.92,
      "text": "Urgent blood tests is what I'd like next, for hyperglycaemic emergency. I'd like to arrange an ECG for hyperglycaemic emergency. I'd rather check than guess, and this is the quickest way to know more. You need hospital now for fluids and insulin. I'm going to send a referral to the emergency team."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.98,
      "end_seconds": 332.74,
      "duration_seconds": 2.76,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.06,
      "end_seconds": 339.77,
      "duration_seconds": 5.71,
      "text": "If the symptoms get worse, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.9,
      "end_seconds": 343.62,
      "duration_seconds": 2.72,
      "text": "Okay, uh, makes sense."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.51,
      "end_seconds": 350.84,
      "duration_seconds": 5.33,
      "text": "I'll want another look straight away. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.84,
      "end_seconds": 356.17,
      "duration_seconds": 3.33,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.81,
      "end_seconds": 361.57,
      "duration_seconds": 1.76,
      "text": "Alright, take care now."
    }
  ]
}