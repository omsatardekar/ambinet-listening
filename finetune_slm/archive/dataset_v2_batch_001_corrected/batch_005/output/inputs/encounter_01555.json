      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.46,
      "end_seconds": 168.36,
      "duration_seconds": 5.9,
      "text": "yes I had a mole taken off my arm a few years ago"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.26,
      "end_seconds": 175.57,
      "duration_seconds": 4.31,
      "text": "are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.22,
      "end_seconds": 189.18,
      "duration_seconds": 9.96,
      "text": "it's telmisartan, 40 milligrams, once a day i didn't want to bother you but it keeps coming back"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.01,
      "end_seconds": 194.88,
      "duration_seconds": 3.87,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.69,
      "end_seconds": 199.51,
      "duration_seconds": 2.82,
      "text": "I mean, my brother has epilepsy"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.0,
      "end_seconds": 216.1,
      "duration_seconds": 3.1,
      "text": "has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.37,
      "end_seconds": 223.1,
      "duration_seconds": 5.73,
      "text": "let me think, I have high blood pressure, for two years"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.0,
      "end_seconds": 231.89,
      "duration_seconds": 6.89,
      "text": "I follow. Alright, high blood pressure, that matches what I have here. Tell me about your eating"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.52,
      "end_seconds": 238.64,
      "duration_seconds": 6.12,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.46,
      "end_seconds": 242.06,
      "duration_seconds": 2.6,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.06,
      "end_seconds": 247.68,
      "duration_seconds": 3.62,
      "text": "I do a yoga class on Thursdays"
