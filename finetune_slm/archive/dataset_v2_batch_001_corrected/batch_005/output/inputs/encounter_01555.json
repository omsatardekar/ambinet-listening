      "role": "DOCTOR",
      "start_seconds": 19.74,
      "end_seconds": 22.85,
      "duration_seconds": 3.11,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.06,
      "end_seconds": 27.36,
      "duration_seconds": 3.3,
      "text": "Well, I've had it for two days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.68,
      "end_seconds": 36.68,
      "duration_seconds": 3.0,
      "text": "would you say mild moderate or severe?"
