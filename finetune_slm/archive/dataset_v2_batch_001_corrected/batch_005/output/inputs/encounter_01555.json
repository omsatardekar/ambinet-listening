    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.25,
      "end_seconds": 143.36,
      "duration_seconds": 3.11,
      "text": "Bowels are regular um nothing odd."
