      "role": "DOCTOR",
      "start_seconds": 60.72,
      "end_seconds": 63.36,
      "duration_seconds": 2.64,
      "text": "bear with me while this finishes.."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.66,
      "end_seconds": 93.35,
      "duration_seconds": 15.69,
      "text": "Okay: respiratory rate 16, heart rate 86, BMI works out to 36.5, temp 36.8 degrees, weight 97 kilos, blood pressure 149 over 97, height 163 centimetres, saturation 98 percent."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.83,
      "end_seconds": 97.25,
      "duration_seconds": 2.42,
      "text": "shall I start the the examination?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.25,
      "end_seconds": 99.87,
      "duration_seconds": 1.62,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.85,
      "end_seconds": 103.46,
      "duration_seconds": 2.61,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.05,
      "end_seconds": 119.86,
      "duration_seconds": 3.81,
      "text": "you have a thick neck and a crowded throat"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.52,
      "end_seconds": 130.54,
      "duration_seconds": 6.02,
      "text": "You can relax now. Alright, have you noticed chest pain, leg swelling or choking?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.09,
      "end_seconds": 134.87,
      "duration_seconds": 2.78,
      "text": "no not a single one"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.92,
      "end_seconds": 139.59,
      "duration_seconds": 2.67,
      "text": "How are your bowels, any trouble?"
