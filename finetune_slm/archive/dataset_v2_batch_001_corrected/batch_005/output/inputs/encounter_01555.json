      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.0,
      "end_seconds": 161.76,
      "duration_seconds": 2.76,
      "text": "What operations have you had if any?"
