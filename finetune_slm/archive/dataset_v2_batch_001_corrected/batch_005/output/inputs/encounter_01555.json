    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.99,
      "end_seconds": 256.08,
      "duration_seconds": 3.09,
      "text": "are you in work at the moment?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.93,
      "end_seconds": 262.61,
      "duration_seconds": 4.68,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.43,
      "end_seconds": 287.82,
      "duration_seconds": 14.39,
      "text": "okay, thinking it it through, this looks most like probable obstructive sleep apnoea an underactive thyroid is also on my list we should do a home sleep study for snoring and apnoeas"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.75,
      "end_seconds": 290.98,
      "duration_seconds": 2.23,
      "text": "Okay, I'll do it."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.45,
      "end_seconds": 322.1,
      "duration_seconds": 29.65,
      "text": "I'm sending you for a thyroid test cos of tiredness avoid alcohol in the evening, lose some weight if you can, and do not drive when drowsy the sleep clinic would be the right next step, I'll refer you please don't wait if the symptoms get worse that's when to be seen urgently please come and see me after the sleep study"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.03,
      "end_seconds": 323.73,
      "duration_seconds": 0.7,
      "text": "right"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
