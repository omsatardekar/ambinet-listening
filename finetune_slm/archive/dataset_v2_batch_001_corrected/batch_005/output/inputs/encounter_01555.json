      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.73,
      "end_seconds": 46.58,
      "duration_seconds": 7.85,
      "text": "it's severe, honestly i've also had morning headaches about morning headaches, I'd call it moderate"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.34,
      "end_seconds": 51.02,
      "duration_seconds": 3.68,
      "text": "shall I check your blood pressure and pulse?"
