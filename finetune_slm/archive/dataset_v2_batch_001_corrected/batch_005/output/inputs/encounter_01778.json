{
  "schema_version": "1.0",
  "encounter_id": "01778",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.61,
      "end_seconds": 2.33,
      "duration_seconds": 1.72,
      "text": "Morning, come on through."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.85,
      "end_seconds": 7.35,
      "duration_seconds": 3.5,
      "text": "Erm, hello, thanks for fitting me in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.47,
      "end_seconds": 15.06,
      "duration_seconds": 3.59,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 17.1,
      "end_seconds": 20.39,
      "duration_seconds": 3.29,
      "text": "I've been dealing with ear pain."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.22,
      "end_seconds": 25.86,
      "duration_seconds": 3.64,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.08,
      "end_seconds": 33.72,
      "duration_seconds": 2.64,
      "text": "Probably about two weeks. Yeah."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.01,
      "end_seconds": 40.28,
      "duration_seconds": 3.27,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 41.17,
      "end_seconds": 42.81,
      "duration_seconds": 1.64,
      "text": "It's moderate, honestly."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.1,
      "end_seconds": 48.68,
      "duration_seconds": 5.58,
      "text": "Hm, okay. Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.29,
      "end_seconds": 53.45,
      "duration_seconds": 3.16,
      "text": "It's a few times a day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.17,
      "end_seconds": 56.41,
      "duration_seconds": 2.24,
      "text": "What aggravates it, if anything?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.79,
      "end_seconds": 64.44,
      "duration_seconds": 6.65,
      "text": "Sorry, uh, what was I saying, yes, lying down. That makes it worse."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.19,
      "end_seconds": 66.75,
      "duration_seconds": 1.56,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.04,
      "end_seconds": 73.76,
      "duration_seconds": 3.72,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.61,
      "end_seconds": 76.22,
      "duration_seconds": 1.61,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.33,
      "end_seconds": 79.74,
      "duration_seconds": 2.41,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.57,
      "end_seconds": 85.57,
      "duration_seconds": 4.0,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.14,
      "end_seconds": 97.59,
      "duration_seconds": 10.45,
      "text": "I take propranolol, 40 milligrams, twice a day. Paracetamol syrup. I take it 5 ml, every six hours."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.76,
      "end_seconds": 101.64,
      "duration_seconds": 2.88,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.87,
      "end_seconds": 105.6,
      "duration_seconds": 2.73,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.62,
      "end_seconds": 110.38,
      "duration_seconds": 2.76,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.82,
      "end_seconds": 113.24,
      "duration_seconds": 1.42,
      "text": "I've got migraines."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.13,
      "end_seconds": 125.11,
      "duration_seconds": 2.98,
      "text": "Have you noticed stiff neck or discharge?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.97,
      "end_seconds": 130.18,
      "duration_seconds": 4.21,
      "text": "Well, no, I haven't had any of them."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.82,
      "end_seconds": 135.94,
      "duration_seconds": 5.12,
      "text": "A few quick ones: hearing loss or swelling behind the ear?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.46,
      "end_seconds": 142.43,
      "duration_seconds": 4.97,
      "text": "No, no hearing loss or swelling behind the ear."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.52,
      "end_seconds": 148.23,
      "duration_seconds": 2.71,
      "text": "Alright, is your chest okay generally?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 149.07,
      "end_seconds": 151.22,
      "duration_seconds": 2.15,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.24,
      "end_seconds": 157.12,
      "duration_seconds": 3.88,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.56,
      "end_seconds": 160.04,
      "duration_seconds": 1.48,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.0,
      "end_seconds": 176.46,
      "duration_seconds": 3.46,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.78,
      "end_seconds": 187.21,
      "duration_seconds": 2.43,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.54,
      "end_seconds": 216.65,
      "duration_seconds": 8.11,
      "text": "Okay: pulse 103, temp 38.3 degrees, blood pressure 124 over 67, SpO2 96 percent on room air."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 217.68,
      "end_seconds": 219.8,
      "duration_seconds": 2.12,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.63,
      "end_seconds": 224.84,
      "duration_seconds": 4.21,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.42,
      "end_seconds": 228.67,
      "duration_seconds": 2.25,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.2,
      "end_seconds": 232.05,
      "duration_seconds": 1.85,
      "text": "So, nearly finished here."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.82,
      "end_seconds": 250.32,
      "duration_seconds": 6.5,
      "text": "The right ear drum is red and bulging, and the left is normal."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.23,
      "end_seconds": 254.85,
      "duration_seconds": 1.62,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 263.66,
      "end_seconds": 274.73,
      "duration_seconds": 11.07,
      "text": "Taking everything into account, my working impression is acute middle ear infection. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.08,
      "end_seconds": 307.38,
      "duration_seconds": 19.3,
      "text": "The treatment will be amoxicillin, 250 milligrams, three times a day, five days. It's for ear infection. Give pain relief regularly and plenty to drink. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.64,
      "end_seconds": 325.2,
      "duration_seconds": 17.56,
      "text": "Right, right. If the symptoms get worse, or you feel really unwell, please come to the emergency department. We'll catch up if not better in two days. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 327.0,
      "end_seconds": 330.19,
      "duration_seconds": 3.19,
      "text": "Hmm, thank you, that's helpful."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 331.92,
      "end_seconds": 333.35,
      "duration_seconds": 1.43,
      "text": "See you soon."
    }
  ]
}