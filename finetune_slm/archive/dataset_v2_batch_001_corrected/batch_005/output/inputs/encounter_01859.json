{
  "schema_version": "1.0",
  "encounter_id": "01859",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.05,
      "end_seconds": 7.16,
      "duration_seconds": 6.11,
      "text": "Right, thanks for waiting, come in. Okay, what do you need help with?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.68,
      "end_seconds": 13.46,
      "duration_seconds": 5.78,
      "text": "Well, I've been having a stiff neck after sleeping badly."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.89,
      "end_seconds": 18.2,
      "duration_seconds": 3.31,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.14,
      "end_seconds": 28.03,
      "duration_seconds": 8.89,
      "text": "Allopurinol, 100 milligrams, once a day for the gout. It's, It's naproxen, 250 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.91,
      "end_seconds": 35.84,
      "duration_seconds": 3.93,
      "text": "Okay, how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 37.25,
      "end_seconds": 39.53,
      "duration_seconds": 2.28,
      "text": "It's been four weeks now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.09,
      "end_seconds": 47.94,
      "duration_seconds": 7.85,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 48.82,
      "end_seconds": 66.23,
      "duration_seconds": 17.41,
      "text": "It's moderate, honestly. Turning definitely sets it off. It happens on and off. It settles a little with heat. I've also had tightness between my shoulders. About tightness between my shoulders, it's a few times a day."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.94,
      "end_seconds": 72.72,
      "duration_seconds": 4.78,
      "text": "Any fever, arm numbness, headache or head injury at all?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 74.02,
      "end_seconds": 78.6,
      "duration_seconds": 4.58,
      "text": "No, no fever, arm numbness, headache or head injury."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.93,
      "end_seconds": 85.56,
      "duration_seconds": 1.63,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.92,
      "end_seconds": 89.47,
      "duration_seconds": 2.55,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.49,
      "end_seconds": 94.16,
      "duration_seconds": 2.67,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.08,
      "end_seconds": 98.56,
      "duration_seconds": 2.48,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.98,
      "end_seconds": 116.84,
      "duration_seconds": 3.86,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.34,
      "end_seconds": 122.99,
      "duration_seconds": 4.65,
      "text": "Yes, gout. I've got arthritis in my knees."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.5,
      "end_seconds": 133.08,
      "duration_seconds": 9.58,
      "text": "Alright, gout and arthritis in your knees, that matches what I have here. Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.68,
      "end_seconds": 139.4,
      "duration_seconds": 4.72,
      "text": "I'm allergic to erythromycin, I get bad stomach cramps."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.43,
      "end_seconds": 145.72,
      "duration_seconds": 4.29,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.85,
      "end_seconds": 151.02,
      "duration_seconds": 4.17,
      "text": "Let me think, my father had bowel cancer."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.11,
      "end_seconds": 171.2,
      "duration_seconds": 2.09,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 172.41,
      "end_seconds": 176.58,
      "duration_seconds": 4.17,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.82,
      "end_seconds": 184.57,
      "duration_seconds": 2.75,
      "text": "So, tell me about your eating."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 186.67,
      "end_seconds": 192.55,
      "duration_seconds": 5.88,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.07,
      "end_seconds": 194.8,
      "duration_seconds": 1.73,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 195.72,
      "end_seconds": 199.17,
      "duration_seconds": 3.45,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.91,
      "end_seconds": 203.27,
      "duration_seconds": 3.36,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.45,
      "end_seconds": 217.84,
      "duration_seconds": 2.39,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.76,
      "end_seconds": 243.07,
      "duration_seconds": 12.31,
      "text": "Okay: SpO2 99 percent on room air, height 171 centimetres, blood pressure 120 over 82, temperature 36.5, BMI works out to 21.2, pulse 82, weight 62 kilos."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.21,
      "end_seconds": 249.26,
      "duration_seconds": 5.05,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.47,
      "end_seconds": 253.36,
      "duration_seconds": 2.89,
      "text": "Right, tell me if that's sore."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.12,
      "end_seconds": 275.93,
      "duration_seconds": 5.81,
      "text": "The neck muscles on the left are tight and the movements are full."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.91,
      "end_seconds": 289.73,
      "duration_seconds": 10.82,
      "text": "Right, thank you, you can get dressed. Putting it all together, I think we're dealing with a simple neck muscle strain at this stage."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 291.35,
      "end_seconds": 294.6,
      "duration_seconds": 3.25,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 297.58,
      "end_seconds": 303.85,
      "duration_seconds": 6.27,
      "text": "Nothing I've seen today points to an emergency. It looks like a simple neck muscle strain."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 322.56,
      "end_seconds": 332.61,
      "duration_seconds": 10.05,
      "text": "Heat, gentle neck rolls, and a supportive pillow. Come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 336.84,
      "end_seconds": 337.84,
      "duration_seconds": 1.0,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 338.67,
      "end_seconds": 342.46,
      "duration_seconds": 3.79,
      "text": "Come back if not better in two weeks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 344.1,
      "end_seconds": 348.99,
      "duration_seconds": 4.89,
      "text": "I'll book your follow-up at the front desk on your way out."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 349.69,
      "end_seconds": 354.36,
      "duration_seconds": 4.67,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 356.41,
      "end_seconds": 358.53,
      "duration_seconds": 2.12,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 359.82,
      "end_seconds": 361.12,
      "duration_seconds": 1.3,
      "text": "Look after yourself."
    }
  ]
}