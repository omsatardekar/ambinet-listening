{
  "schema_version": "1.0",
  "encounter_id": "01910",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.9,
      "end_seconds": 2.87,
      "duration_seconds": 1.97,
      "text": "Morning, come on through."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 3.8,
      "end_seconds": 10.19,
      "duration_seconds": 6.39,
      "text": "Hello, um, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.8,
      "end_seconds": 14.25,
      "duration_seconds": 2.45,
      "text": "What's the main thing today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 14.82,
      "end_seconds": 20.55,
      "duration_seconds": 5.73,
      "text": "I've been feeling hopeless, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.35,
      "end_seconds": 25.0,
      "duration_seconds": 3.65,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 26.33,
      "end_seconds": 29.61,
      "duration_seconds": 3.28,
      "text": "Around about a month, I think."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 30.69,
      "end_seconds": 34.77,
      "duration_seconds": 4.08,
      "text": "It was closer to about two months, doctor."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.57,
      "end_seconds": 40.56,
      "duration_seconds": 4.99,
      "text": "Okay, so roughly one to two months. Is that right?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 41.1,
      "end_seconds": 43.07,
      "duration_seconds": 1.97,
      "text": "That sounds about right."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.29,
      "end_seconds": 44.62,
      "duration_seconds": 1.33,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 48.64,
      "end_seconds": 66.13,
      "duration_seconds": 17.49,
      "text": "I've had thoughts of ending my life too, for two days. There's a plan as well. I've also had not sleeping for days, for two months. About not sleeping for days, I'd call it severe."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.73,
      "end_seconds": 67.43,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.05,
      "end_seconds": 93.04,
      "duration_seconds": 6.99,
      "text": "Let me check a few things. Any recent loss, having taken tablets or hearing voices?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 94.24,
      "end_seconds": 100.96,
      "duration_seconds": 6.72,
      "text": "No recent loss, having taken tablets or hearing voices, none of it."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.57,
      "end_seconds": 105.43,
      "duration_seconds": 2.86,
      "text": "Have you had drinking, by any chance?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 106.49,
      "end_seconds": 108.14,
      "duration_seconds": 1.65,
      "text": "Nope, no drinking."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.21,
      "end_seconds": 112.41,
      "duration_seconds": 2.2,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 113.21,
      "end_seconds": 114.55,
      "duration_seconds": 1.34,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.38,
      "end_seconds": 119.46,
      "duration_seconds": 3.08,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 120.88,
      "end_seconds": 122.42,
      "duration_seconds": 1.54,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.37,
      "end_seconds": 127.51,
      "duration_seconds": 3.14,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 129.31,
      "end_seconds": 133.28,
      "duration_seconds": 3.97,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.14,
      "end_seconds": 136.25,
      "duration_seconds": 2.11,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 137.04,
      "end_seconds": 139.65,
      "duration_seconds": 2.61,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.66,
      "end_seconds": 142.33,
      "duration_seconds": 1.67,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 143.3,
      "end_seconds": 145.64,
      "duration_seconds": 2.34,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.24,
      "end_seconds": 149.15,
      "duration_seconds": 2.91,
      "text": "Alright, have you got any known allergies?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 154.54,
      "end_seconds": 157.56,
      "duration_seconds": 3.02,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.69,
      "end_seconds": 169.18,
      "duration_seconds": 3.49,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 170.95,
      "end_seconds": 174.14,
      "duration_seconds": 3.19,
      "text": "It's sertraline, once a day, doctor."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.23,
      "end_seconds": 178.39,
      "duration_seconds": 2.16,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 179.04,
      "end_seconds": 189.66,
      "duration_seconds": 10.62,
      "text": "50 milligrams, I think that's what's on the box. It's allopurinol, 100 milligrams, once a day for the gout, doctor."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.98,
      "end_seconds": 194.47,
      "duration_seconds": 4.49,
      "text": "Yes, carry on. Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 195.79,
      "end_seconds": 201.4,
      "duration_seconds": 5.61,
      "text": "I have depression, for about a year. I've got thin bones."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.54,
      "end_seconds": 203.24,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 203.93,
      "end_seconds": 206.1,
      "duration_seconds": 2.17,
      "text": "I've, I've got gout."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.1,
      "end_seconds": 215.95,
      "duration_seconds": 7.85,
      "text": "Sure. Yes, thin bones is known to us, good to have that clear. Any previous surgeries?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 217.59,
      "end_seconds": 221.03,
      "duration_seconds": 3.44,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.08,
      "end_seconds": 226.04,
      "duration_seconds": 3.96,
      "text": "Okay, is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 226.67,
      "end_seconds": 231.63,
      "duration_seconds": 4.96,
      "text": "My daughter has type 1 diabetes. My brother has epilepsy."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 232.81,
      "end_seconds": 242.83,
      "duration_seconds": 10.02,
      "text": "Here are the numbers, doctor. Pressure 108 over 80, oxygen saturation is 98 percent, pulse is 80 beats a minute. Temperature is 36.9 degrees."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.43,
      "end_seconds": 245.01,
      "duration_seconds": 1.58,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.29,
      "end_seconds": 295.22,
      "duration_seconds": 32.93,
      "text": "Right, here's what I'm thinking. It fits best with a high risk of suicide needing urgent assessment. It could also be a severe depressive episode, so we'll keep that open. An urgent mental health assessment is what I'd like next, for suicidal thoughts. I want you to stay with me while we arrange help, and your family will be called. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.86,
      "end_seconds": 300.53,
      "duration_seconds": 3.67,
      "text": "Okay, I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 301.15,
      "end_seconds": 304.62,
      "duration_seconds": 3.47,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}