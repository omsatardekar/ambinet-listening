{
  "schema_version": "1.0",
  "encounter_id": "01738",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.24,
      "end_seconds": 4.21,
      "duration_seconds": 2.97,
      "text": "Hello, come in. Mind the step."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.41,
      "end_seconds": 8.56,
      "duration_seconds": 3.15,
      "text": "Hello, thanks for fitting me in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.66,
      "end_seconds": 12.85,
      "duration_seconds": 2.19,
      "text": "what's the main thing today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.04,
      "end_seconds": 23.26,
      "duration_seconds": 9.22,
      "text": "Mainly a high reading at the pharmacy. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.82,
      "end_seconds": 28.29,
      "duration_seconds": 3.47,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.84,
      "end_seconds": 34.99,
      "duration_seconds": 6.15,
      "text": "Thyronorm. I take it 50 micrograms, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.48,
      "end_seconds": 36.18,
      "duration_seconds": 0.7,
      "text": "ah"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 37.7,
      "end_seconds": 43.27,
      "duration_seconds": 5.57,
      "text": "I take pantoprazole, 40 milligrams, before breakfast for my acidity."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.15,
      "end_seconds": 46.08,
      "duration_seconds": 1.93,
      "text": "and for how long?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.86,
      "end_seconds": 49.42,
      "duration_seconds": 1.56,
      "text": "Six months now."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.56,
      "end_seconds": 70.41,
      "duration_seconds": 2.85,
      "text": "So, did it it come on recently?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 72.25,
      "end_seconds": 75.49,
      "duration_seconds": 3.24,
      "text": "it's been going on for two weeks"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.55,
      "end_seconds": 80.23,
      "duration_seconds": 3.68,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.25,
      "end_seconds": 85.12,
      "duration_seconds": 2.87,
      "text": "pretty moderate, if I'm being honest"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.29,
      "end_seconds": 89.13,
      "duration_seconds": 2.84,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 90.43,
      "end_seconds": 97.8,
      "duration_seconds": 7.37,
      "text": "Being a bit nervous at appointments goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.39,
      "end_seconds": 104.73,
      "duration_seconds": 6.34,
      "text": "Mm-hmm. A few quick ones: chest pain, breathlessness, visual changes or leg swelling?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 105.64,
      "end_seconds": 111.69,
      "duration_seconds": 6.05,
      "text": "no chest pain, breathlessness, visual changes or leg swelling, none of it"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.23,
      "end_seconds": 115.64,
      "duration_seconds": 2.41,
      "text": "any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.47,
      "end_seconds": 119.26,
      "duration_seconds": 1.79,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.39,
      "end_seconds": 123.78,
      "duration_seconds": 3.39,
      "text": "Okay, have you been to theatre before?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 126.21,
      "end_seconds": 131.0,
      "duration_seconds": 4.79,
      "text": "Yes, I had a triple bypass, eight years ago."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.58,
      "end_seconds": 136.63,
      "duration_seconds": 4.05,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.74,
      "end_seconds": 141.19,
      "duration_seconds": 3.45,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.33,
      "end_seconds": 158.06,
      "duration_seconds": 2.73,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.93,
      "end_seconds": 170.51,
      "duration_seconds": 11.58,
      "text": "An underactive thyroid, for five years. I've got acid reflux. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.01,
      "end_seconds": 174.97,
      "duration_seconds": 2.96,
      "text": "right, and and anything else to add?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.08,
      "end_seconds": 177.63,
      "duration_seconds": 1.55,
      "text": "Yes, heart disease."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.61,
      "end_seconds": 184.97,
      "duration_seconds": 6.36,
      "text": "okay, I can see acid reflux in your file as well. And alcohol, how much?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 186.69,
      "end_seconds": 192.38,
      "duration_seconds": 5.69,
      "text": "I used to drink heavily but I stopped four years ago"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.2,
      "end_seconds": 197.2,
      "duration_seconds": 3.0,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 198.03,
      "end_seconds": 201.06,
      "duration_seconds": 3.03,
      "text": "I live with my elderly mother"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.89,
      "end_seconds": 204.33,
      "duration_seconds": 2.44,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 205.66,
      "end_seconds": 210.58,
      "duration_seconds": 4.92,
      "text": "I drink a lot of tea and snack through the day"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.79,
      "end_seconds": 224.03,
      "duration_seconds": 3.24,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 225.56,
      "end_seconds": 228.38,
      "duration_seconds": 2.82,
      "text": "So, my aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.16,
      "end_seconds": 232.74,
      "duration_seconds": 2.58,
      "text": "let me quickly check your readings"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.78,
      "end_seconds": 241.14,
      "duration_seconds": 2.36,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.66,
      "end_seconds": 260.84,
      "duration_seconds": 10.18,
      "text": "okay: blood pressure 158 over 101, weight 60 kilos, temp 36.6 degrees and heart rate 87, saturation 98 percent, height 182 centimetres"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 263.38,
      "end_seconds": 266.62,
      "duration_seconds": 3.24,
      "text": "right, let's have a proper look at you"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.32,
      "end_seconds": 271.11,
      "duration_seconds": 2.79,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 285.91,
      "end_seconds": 292.27,
      "duration_seconds": 6.36,
      "text": "Your blood pressure is a little raised in the clinic but your heart sounds are normal."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 296.41,
      "end_seconds": 297.98,
      "duration_seconds": 1.57,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 300.99,
      "end_seconds": 322.36,
      "duration_seconds": 21.37,
      "text": "Good, you can sit up again. Putting it all together, I can't pin this down yet. We're looking at possible white-coat blood pressure or early hypertension. Cut back on salt and do a week of home readings. Right, that's the plan. Do you wanna ask me anything?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 323.69,
      "end_seconds": 325.87,
      "duration_seconds": 2.18,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 326.84,
      "end_seconds": 328.31,
      "duration_seconds": 1.47,
      "text": "Take care now."
    }
  ]
}