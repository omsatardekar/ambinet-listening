{
  "schema_version": "1.0",
  "encounter_id": "01506",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.66,
      "end_seconds": 5.45,
      "duration_seconds": 4.79,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.86,
      "end_seconds": 10.51,
      "duration_seconds": 3.65,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.41,
      "end_seconds": 17.06,
      "duration_seconds": 5.65,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.82,
      "end_seconds": 25.5,
      "duration_seconds": 4.68,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 26.54,
      "end_seconds": 31.05,
      "duration_seconds": 4.51,
      "text": "We came because of a tingling lip then a blister."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.05,
      "end_seconds": 36.48,
      "duration_seconds": 3.43,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.83,
      "end_seconds": 40.19,
      "duration_seconds": 2.36,
      "text": "Around three weeks, I think."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 41.76,
      "end_seconds": 44.93,
      "duration_seconds": 3.17,
      "text": "Hm, I'd say more like a month."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.42,
      "end_seconds": 53.09,
      "duration_seconds": 4.67,
      "text": "Okay, so roughly three to four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.17,
      "end_seconds": 58.31,
      "duration_seconds": 2.14,
      "text": "I suppose so, yes."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.91,
      "end_seconds": 61.35,
      "duration_seconds": 2.44,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.22,
      "end_seconds": 66.31,
      "duration_seconds": 3.09,
      "text": "It's once or twice a day."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.55,
      "end_seconds": 69.12,
      "duration_seconds": 2.57,
      "text": "Sure. Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.68,
      "end_seconds": 72.98,
      "duration_seconds": 2.3,
      "text": "It usually comes with crusting."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.01,
      "end_seconds": 78.5,
      "duration_seconds": 3.49,
      "text": "Okay, have you had a mild sore feeling?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.18,
      "end_seconds": 92.46,
      "duration_seconds": 13.28,
      "text": "Yeah, I've had that since last weekend. As for crusting, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.54,
      "end_seconds": 98.07,
      "duration_seconds": 3.53,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.34,
      "end_seconds": 101.58,
      "duration_seconds": 2.24,
      "text": "It feels mild to me."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.66,
      "end_seconds": 106.12,
      "duration_seconds": 2.46,
      "text": "And fever, any of that?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.02,
      "end_seconds": 108.51,
      "duration_seconds": 1.49,
      "text": "Nope, no fever."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.6,
      "end_seconds": 117.86,
      "duration_seconds": 5.26,
      "text": "Did you get rash elsewhere, eye pain or sores in the mouth?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.81,
      "end_seconds": 125.45,
      "duration_seconds": 5.64,
      "text": "No, no rash elsewhere, eye pain or sores in the mouth."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.68,
      "end_seconds": 129.12,
      "duration_seconds": 2.44,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.99,
      "end_seconds": 131.75,
      "duration_seconds": 1.76,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.76,
      "end_seconds": 135.84,
      "duration_seconds": 3.08,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.49,
      "end_seconds": 140.35,
      "duration_seconds": 2.86,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.71,
      "end_seconds": 144.19,
      "duration_seconds": 2.48,
      "text": "Alright, do you live by yourself?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.14,
      "end_seconds": 150.4,
      "duration_seconds": 4.26,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.57,
      "end_seconds": 153.24,
      "duration_seconds": 1.67,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.31,
      "end_seconds": 158.74,
      "duration_seconds": 4.43,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.33,
      "end_seconds": 162.77,
      "duration_seconds": 2.44,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.14,
      "end_seconds": 171.44,
      "duration_seconds": 7.3,
      "text": "I've got an underactive thyroid. I have thin bones, for about ten years."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.09,
      "end_seconds": 181.39,
      "duration_seconds": 9.3,
      "text": "Okay, go on. Right, so an underactive thyroid and thin bones are already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.23,
      "end_seconds": 203.51,
      "duration_seconds": 4.28,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 204.02,
      "end_seconds": 212.4,
      "duration_seconds": 8.38,
      "text": "She takes Eltroxin, 100 micrograms, every morning. She takes alendronate, 70 milligrams, once a week for my bones."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.23,
      "end_seconds": 216.81,
      "duration_seconds": 2.58,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.31,
      "end_seconds": 228.52,
      "duration_seconds": 2.21,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.22,
      "end_seconds": 251.28,
      "duration_seconds": 7.06,
      "text": "Okay: temperature is 36.9 degrees, BP is 112 over 78, heart rate 67, saturation 99 percent."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.49,
      "end_seconds": 271.56,
      "duration_seconds": 6.07,
      "text": "Let me tell you where I've got to. It fits best with a cold sore."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.36,
      "end_seconds": 275.2,
      "duration_seconds": 1.84,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.23,
      "end_seconds": 294.94,
      "duration_seconds": 17.71,
      "text": "I understand the worry. At the moment I'd say it's a cold sore, and we'll watch how it goes. So, to recap quickly. You've had a tingling lip then a blister, and no sores in the mouth or fever."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.36,
      "end_seconds": 297.06,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.87,
      "end_seconds": 320.54,
      "duration_seconds": 6.67,
      "text": "You'll be taking aciclovir cream, 5%, five times a day, five days. That's for cold sore."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.26,
      "end_seconds": 323.85,
      "duration_seconds": 1.59,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.83,
      "end_seconds": 336.78,
      "duration_seconds": 11.95,
      "text": "Avoid kissing and sharing towels until it has crusted over. Let's review you if not healed in ten days. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.41,
      "end_seconds": 342.2,
      "duration_seconds": 3.79,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.87,
      "end_seconds": 344.29,
      "duration_seconds": 1.42,
      "text": "All the best."
    }
  ]
}