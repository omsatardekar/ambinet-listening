  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.55,
      "end_seconds": 4.21,
      "duration_seconds": 3.66,
      "text": "Come in, have a seat by the desk."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.13,
      "end_seconds": 7.25,
      "duration_seconds": 1.12,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.86,
      "end_seconds": 11.8,
      "duration_seconds": 2.94,
      "text": "How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.57,
      "end_seconds": 18.71,
      "duration_seconds": 6.14,
      "text": "Honestly, it's tired muscles, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.3,
      "end_seconds": 22.04,
      "duration_seconds": 2.74,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.03,
      "end_seconds": 25.59,
      "duration_seconds": 2.56,
      "text": "Ever since... since Friday, really."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.44,
      "end_seconds": 28.91,
      "duration_seconds": 2.47,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 29.54,
      "end_seconds": 32.28,
      "duration_seconds": 2.74,
      "text": "about a five out of ten"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.22,
      "end_seconds": 36.6,
      "duration_seconds": 2.38,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.06,
      "end_seconds": 54.24,
      "duration_seconds": 16.18,
      "text": "It usually comes with a mild ache in my legs. As for mild ache in my legs, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 56.04,
      "end_seconds": 58.86,
      "duration_seconds": 2.82,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 59.8,
      "end_seconds": 64.48,
      "duration_seconds": 4.68,
      "text": "It's moderate, honestly. Oh, and not getting outdoors."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.41,
      "end_seconds": 69.37,
      "duration_seconds": 3.96,
      "text": "okay, rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 71.18,
      "end_seconds": 72.19,
      "duration_seconds": 1.01,
      "text": "mostly moderate"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "UNKNOWN",
      "start_seconds": 73.11,
      "end_seconds": 75.71,
      "duration_seconds": 2.6,
      "text": "mm, that's what happened, yes"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.1,
      "end_seconds": 97.31,
      "duration_seconds": 3.21,
      "text": "which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 99.13,
      "end_seconds": 114.4,
      "duration_seconds": 15.27,
      "text": "Tamsulosin, 0.4 milligrams, at night. I take carvedilol, 6.25 milligrams, twice a day. I do miss it now and then, to be fair. I take atorvastatin, 20 milligrams, at night."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 115.35,
      "end_seconds": 120.81,
      "duration_seconds": 5.46,
      "text": "doctor, our chart from the last visit lists it as 10 milligrams"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.46,
      "end_seconds": 127.37,
      "duration_seconds": 4.91,
      "text": "Right. Do you happen to have the current prescription here?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.72,
      "end_seconds": 133.12,
      "duration_seconds": 4.4,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.25,
      "end_seconds": 135.5,
      "duration_seconds": 1.25,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.51,
      "end_seconds": 139.76,
      "duration_seconds": 2.25,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.56,
      "end_seconds": 145.24,
      "duration_seconds": 4.68,
      "text": "Okay, what does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.56,
      "end_seconds": 149.91,
      "duration_seconds": 3.35,
      "text": "Lots of rice, lentils and some fruit"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.55,
      "end_seconds": 154.43,
      "duration_seconds": 3.88,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 154.94,
      "end_seconds": 158.18,
      "duration_seconds": 3.24,
      "text": "Yes, grass pollen. I get sneezing."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.7,
      "end_seconds": 162.4,
      "duration_seconds": 2.7,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.36,
      "end_seconds": 168.48,
      "duration_seconds": 1.12,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.51,
      "end_seconds": 172.05,
      "duration_seconds": 2.54,
      "text": "do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.91,
      "end_seconds": 178.42,
      "duration_seconds": 4.51,
      "text": "I have an enlarged prostate, for two years."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.22,
      "end_seconds": 182.1,
      "duration_seconds": 1.88,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 182.74,
      "end_seconds": 184.23,
      "duration_seconds": 1.49,
      "text": "Yes, heart failure."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.51,
      "end_seconds": 187.22,
      "duration_seconds": 1.71,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 189.05,
      "end_seconds": 191.16,
      "duration_seconds": 2.11,
      "text": "I have high cholesterol"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.84,
      "end_seconds": 193.62,
      "duration_seconds": 0.78,
      "text": "Anything else?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.0,
      "end_seconds": 210.58,
      "duration_seconds": 12.58,
      "text": "Right, so an enlarged prostate and high cholesterol are already on your record. We'll keep that in mind today. Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 212.42,
      "end_seconds": 217.65,
      "duration_seconds": 5.23,
      "text": "oh, my sister had breast cancer. My uncle has high cholesterol"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.79,
      "end_seconds": 222.19,
      "duration_seconds": 3.4,
      "text": "have you had any weakness or bone pain?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 224.03,
      "end_seconds": 228.37,
      "duration_seconds": 4.34,
      "text": "Erm, no weakness or bone pain, none of it."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.44,
      "end_seconds": 233.34,
      "duration_seconds": 3.9,
      "text": "Have you had any weight loss or fractures?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 235.04,
      "end_seconds": 238.4,
      "duration_seconds": 3.36,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.11,
      "end_seconds": 241.26,
      "duration_seconds": 2.15,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 242.9,
      "end_seconds": 244.38,
      "duration_seconds": 1.48,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 245.24,
      "end_seconds": 258.43,
      "duration_seconds": 13.19,
      "text": "here are the numbers, doctor temperature is 36.6 degrees, pressure 110 over 68, heart rate 75, height 171 centimetres, saturation 98 percent, weight 77 kilos, BMI works out to 26.3."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.17,
      "end_seconds": 261.6,
      "duration_seconds": 1.43,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.07,
      "end_seconds": 266.15,
      "duration_seconds": 2.08,
      "text": "shall I start the examination?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.7,
      "end_seconds": 268.97,
      "duration_seconds": 1.27,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 280.13,
      "end_seconds": 284.74,
      "duration_seconds": 4.61,
      "text": "Your muscle strength is normal and there is no bone tenderness."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 287.73,
      "end_seconds": 289.34,
      "duration_seconds": 1.61,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 297.85,
      "end_seconds": 305.63,
      "duration_seconds": 7.78,
      "text": "Right, here's what I'm thinking. I think we're dealing with low vitamin D without complications at this stage."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 307.71,
      "end_seconds": 309.38,
      "duration_seconds": 1.67,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 311.19,
      "end_seconds": 323.97,
      "duration_seconds": 12.78,
      "text": "I can't promise yet, but most people with low vitamin D without complications do well once it's treated properly. I want a vitamin D level done, that's for tiredness."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 325.31,
      "end_seconds": 329.43,
      "duration_seconds": 4.12,
      "text": "We have a slot Wednesday at 10 am, if that works."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 330.64,
      "end_seconds": 351.06,
      "duration_seconds": 20.42,
      "text": "I'd like you to take colecalciferol, 1000 units, once a day, three months. It's for low vitamin D. Get some daily daylight and eat oily fish. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 352.44,
      "end_seconds": 354.29,
      "duration_seconds": 1.85,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 356.17,
      "end_seconds": 363.17,
      "duration_seconds": 7.0,
      "text": "come back in three months. Alright, that's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 364.76,
      "end_seconds": 367.53,
      "duration_seconds": 2.77,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 371.07,
      "end_seconds": 372.4,
      "duration_seconds": 1.33,
      "text": "all the best"
    }
  ]
