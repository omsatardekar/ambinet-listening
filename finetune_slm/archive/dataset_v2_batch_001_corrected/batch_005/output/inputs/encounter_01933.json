{
  "schema_version": "1.0",
  "encounter_id": "01933",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.29,
      "end_seconds": 6.76,
      "duration_seconds": 5.47,
      "text": "Doctor, I've brought them through. The observations are done, whenever you need them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.83,
      "end_seconds": 13.4,
      "duration_seconds": 5.57,
      "text": "Thanks. Hello, come in, sit down. What brings you in today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 14.73,
      "end_seconds": 22.74,
      "duration_seconds": 8.01,
      "text": "So, it's thoughts of ending my life. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.4,
      "end_seconds": 27.31,
      "duration_seconds": 3.91,
      "text": "Okay, when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 28.82,
      "end_seconds": 40.85,
      "duration_seconds": 12.03,
      "text": "let me think, um, for about two weeks, I'd say i didn't want to make a fuss, you know"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.99,
      "end_seconds": 45.38,
      "duration_seconds": 3.39,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 47.03,
      "end_seconds": 59.82,
      "duration_seconds": 12.79,
      "text": "pretty moderate, if I'm being honest oh, and not sleeping for days with not sleeping for days, pretty mild, if I'm being honest"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 61.52,
      "end_seconds": 72.31,
      "duration_seconds": 10.79,
      "text": "Doctor, I've got the readings for you. Temperature 36.9, SpO2 99 percent on room air, pulse 70, blood pressure 119 over 71."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.24,
      "end_seconds": 79.93,
      "duration_seconds": 5.69,
      "text": "Right, thanks. Have you had any recent loss, having taken tablets or drinking?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 81.72,
      "end_seconds": 87.24,
      "duration_seconds": 5.52,
      "text": "No, no recent loss, having taken tablets or drinking."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.53,
      "end_seconds": 93.03,
      "duration_seconds": 5.5,
      "text": "I see, go ahead. Have you had hearing voices, by any chance?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 96.76,
      "end_seconds": 100.66,
      "duration_seconds": 3.9,
      "text": "No, you know, no hearing voices."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.75,
      "end_seconds": 104.58,
      "duration_seconds": 2.83,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 107.36,
      "end_seconds": 111.64,
      "duration_seconds": 4.28,
      "text": "Um, nothing on the skin, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.26,
      "end_seconds": 117.68,
      "duration_seconds": 4.42,
      "text": "any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 121.0,
      "end_seconds": 123.21,
      "duration_seconds": 2.21,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.26,
      "end_seconds": 128.24,
      "duration_seconds": 2.98,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 130.18,
      "end_seconds": 150.76,
      "duration_seconds": 20.58,
      "text": "I used to drink heavily but I stopped four years ago. I gave up cigarettes last spring. I do a yoga class on Thursdays. Lots of rice, lentils and some fruit. I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.38,
      "end_seconds": 172.76,
      "duration_seconds": 3.38,
      "text": "Right, did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 173.39,
      "end_seconds": 178.93,
      "duration_seconds": 5.54,
      "text": "I had two stents put in my heart three years ago."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.31,
      "end_seconds": 184.15,
      "duration_seconds": 3.84,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 185.11,
      "end_seconds": 188.06,
      "duration_seconds": 2.95,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.87,
      "end_seconds": 193.06,
      "duration_seconds": 3.19,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 194.47,
      "end_seconds": 195.6,
      "duration_seconds": 1.13,
      "text": "Yes, depression."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.35,
      "end_seconds": 197.2,
      "duration_seconds": 0.85,
      "text": "Anything else?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 197.75,
      "end_seconds": 200.81,
      "duration_seconds": 3.06,
      "text": "I, I have heart disease."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.35,
      "end_seconds": 210.0,
      "duration_seconds": 7.65,
      "text": "alright, depression, that matches what I have here are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 211.26,
      "end_seconds": 221.09,
      "duration_seconds": 9.83,
      "text": "I take mirtazapine, 15 milligrams, at night. Hmm, I take metoprolol, 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.42,
      "end_seconds": 226.47,
      "duration_seconds": 4.05,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 227.32,
      "end_seconds": 231.21,
      "duration_seconds": 3.89,
      "text": "Erm, no, not that I know of."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.88,
      "end_seconds": 260.15,
      "duration_seconds": 16.27,
      "text": "right, here's what I'm thinking. It points towards a high risk of suicide needing urgent assessment. The reason I say that is that the way you describe it fits together. We shouldn't forget a severe depressive episode"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.66,
      "end_seconds": 311.19,
      "duration_seconds": 32.53,
      "text": "let's book an urgent mental health assessment to look into suicidal thoughts i want you to stay with me while we arrange help, and your family will be called let's get you seen by the crisis team, I'll arrange the letter if the symptoms get worse, or you feel really unwell, please come to the emergency department come back straight away right, that's the plan do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 312.12,
      "end_seconds": 316.31,
      "duration_seconds": 4.19,
      "text": "ah, good, thanks, I'll see you then"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.36,
      "end_seconds": 319.63,
      "duration_seconds": 1.27,
      "text": "See you soon."
    }
  ]
}