{
  "schema_version": "1.0",
  "encounter_id": "01614",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.17,
      "end_seconds": 4.74,
      "duration_seconds": 3.57,
      "text": "sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.84,
      "end_seconds": 9.51,
      "duration_seconds": 3.67,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.5,
      "end_seconds": 14.81,
      "duration_seconds": 3.31,
      "text": "I'm here because of sudden severe breathlessness."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.54,
      "end_seconds": 19.72,
      "duration_seconds": 4.18,
      "text": "alright, what's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.48,
      "end_seconds": 23.69,
      "duration_seconds": 3.21,
      "text": "Oh, it's been two weeks now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.35,
      "end_seconds": 28.6,
      "duration_seconds": 3.25,
      "text": "so, is there anything else with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.13,
      "end_seconds": 43.24,
      "duration_seconds": 14.11,
      "text": "Sharp chest pain on one side goes along with it, most of the time. And I've been feeling very faint as well, for about two weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.67,
      "end_seconds": 51.09,
      "duration_seconds": 4.42,
      "text": "let me get the readings out of the way"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.73,
      "end_seconds": 66.91,
      "duration_seconds": 2.18,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.49,
      "end_seconds": 94.52,
      "duration_seconds": 11.03,
      "text": "Okay: blood pressure 118 over 82, temp 37.3 degrees. And SpO2 93 percent on room air, respiratory rate 22, pulse is 98 beats a minute."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.73,
      "end_seconds": 100.5,
      "duration_seconds": 3.77,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.56,
      "end_seconds": 104.35,
      "duration_seconds": 2.79,
      "text": "stay as you are for a moment"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.22,
      "end_seconds": 128.62,
      "duration_seconds": 8.4,
      "text": "Your windpipe is pushed to the right, there is no breath sound on the left, and your pressure is dropping."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.12,
      "end_seconds": 135.0,
      "duration_seconds": 3.88,
      "text": "Thank you, you can get dressed. How about cough?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.88,
      "end_seconds": 141.03,
      "duration_seconds": 4.15,
      "text": "not at all, you know, no cough"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.37,
      "end_seconds": 145.2,
      "duration_seconds": 2.83,
      "text": "have you noticed fever or leg swelling?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.45,
      "end_seconds": 148.47,
      "duration_seconds": 2.02,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.81,
      "end_seconds": 152.64,
      "duration_seconds": 3.83,
      "text": "Right, right. Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.58,
      "end_seconds": 156.23,
      "duration_seconds": 1.65,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.26,
      "end_seconds": 161.67,
      "duration_seconds": 4.41,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.31,
      "end_seconds": 167.75,
      "duration_seconds": 4.44,
      "text": "I'm allergic to wheat, I get itchy skin."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.89,
      "end_seconds": 171.68,
      "duration_seconds": 2.79,
      "text": "did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.67,
      "end_seconds": 177.43,
      "duration_seconds": 3.76,
      "text": "Just an operation for a hernia, last spring."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.73,
      "end_seconds": 183.38,
      "duration_seconds": 2.65,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.84,
      "end_seconds": 200.35,
      "duration_seconds": 12.51,
      "text": "I quit smoking around ten years ago. No, I share a house with my brother. I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.66,
      "end_seconds": 211.76,
      "duration_seconds": 2.1,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.33,
      "end_seconds": 217.1,
      "duration_seconds": 4.77,
      "text": "I'm on ramipril, every morning for my blood pressure."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.62,
      "end_seconds": 219.63,
      "duration_seconds": 2.01,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.35,
      "end_seconds": 221.34,
      "duration_seconds": 0.99,
      "text": "5 milligrams."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.08,
      "end_seconds": 243.2,
      "duration_seconds": 3.12,
      "text": "has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.74,
      "end_seconds": 246.2,
      "duration_seconds": 2.46,
      "text": "my sister had breast cancer"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.04,
      "end_seconds": 252.28,
      "duration_seconds": 4.24,
      "text": "what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.98,
      "end_seconds": 257.65,
      "duration_seconds": 3.67,
      "text": "High blood pressure, for nearly five years."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.69,
      "end_seconds": 260.7,
      "duration_seconds": 1.01,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.7,
      "end_seconds": 292.64,
      "duration_seconds": 20.94,
      "text": "I'm sending you for a chest X-ray because of chest pain. That will help us see what's going on underneath and decide the next step. I'm going to order an urgent chest decompression, for tension pneumothorax. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.44,
      "end_seconds": 298.7,
      "duration_seconds": 2.26,
      "text": "Does it it hurt?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.72,
      "end_seconds": 314.27,
      "duration_seconds": 13.55,
      "text": "Stay sitting up, I need to relieve the pressure in your chest right now. I'd like you to see the emergency team as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.98,
      "end_seconds": 318.48,
      "duration_seconds": 3.5,
      "text": "I mean, sure, where do I go?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.17,
      "end_seconds": 326.11,
      "duration_seconds": 6.94,
      "text": "Let's plan a check straight away. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.13,
      "end_seconds": 330.34,
      "duration_seconds": 2.21,
      "text": "Thank you, that's helpful."
    }
  ]
}