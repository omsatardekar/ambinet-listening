{
  "schema_version": "1.0",
  "encounter_id": "01747",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.9,
      "end_seconds": 3.71,
      "duration_seconds": 2.81,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.31,
      "end_seconds": 8.81,
      "duration_seconds": 4.5,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.38,
      "end_seconds": 15.9,
      "duration_seconds": 5.52,
      "text": "Ah, I wanted to get loose stools with blood looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.76,
      "end_seconds": 21.05,
      "duration_seconds": 3.29,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.89,
      "end_seconds": 33.54,
      "duration_seconds": 11.65,
      "text": "I'd say two days. Actually, no, closer to three days. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.75,
      "end_seconds": 38.59,
      "duration_seconds": 4.84,
      "text": "Sure. Okay, rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.15,
      "end_seconds": 44.76,
      "duration_seconds": 1.61,
      "text": "Severe, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.28,
      "end_seconds": 65.82,
      "duration_seconds": 4.54,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.56,
      "end_seconds": 69.96,
      "duration_seconds": 3.4,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.99,
      "end_seconds": 91.46,
      "duration_seconds": 3.47,
      "text": "Right, what operations have you had, if any?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.35,
      "end_seconds": 97.86,
      "duration_seconds": 5.51,
      "text": "Just two stents put in my heart, three years ago."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.92,
      "end_seconds": 104.24,
      "duration_seconds": 5.32,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.58,
      "end_seconds": 118.31,
      "duration_seconds": 12.73,
      "text": "I only drink at family occasions. I walk the dog every morning. No, I share a house with my brother. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.95,
      "end_seconds": 123.05,
      "duration_seconds": 3.1,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.98,
      "end_seconds": 127.79,
      "duration_seconds": 2.81,
      "text": "I've had heart disease, yes."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.3,
      "end_seconds": 134.0,
      "duration_seconds": 4.7,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.45,
      "end_seconds": 141.7,
      "duration_seconds": 6.25,
      "text": "Clopidogrel. I take it 75 milligrams, once a day for the stent."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.22,
      "end_seconds": 146.96,
      "duration_seconds": 4.74,
      "text": "Right, right. Did you get weight loss, fever or vomiting?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.13,
      "end_seconds": 153.07,
      "duration_seconds": 4.94,
      "text": "I haven't had weight loss, fever or vomiting, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.47,
      "end_seconds": 157.73,
      "duration_seconds": 3.26,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.99,
      "end_seconds": 161.33,
      "duration_seconds": 2.34,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.16,
      "end_seconds": 167.02,
      "duration_seconds": 2.86,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.87,
      "end_seconds": 183.71,
      "duration_seconds": 2.84,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.55,
      "end_seconds": 207.15,
      "duration_seconds": 8.6,
      "text": "Okay: pressure 120 over 73, oxygen saturation is 98 percent. And temperature is 36.5 degrees, pulse 81."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.97,
      "end_seconds": 211.17,
      "duration_seconds": 2.2,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.73,
      "end_seconds": 216.57,
      "duration_seconds": 3.84,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.46,
      "end_seconds": 223.92,
      "duration_seconds": 4.46,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.98,
      "end_seconds": 237.68,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.5,
      "end_seconds": 240.36,
      "duration_seconds": 1.86,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.65,
      "end_seconds": 259.78,
      "duration_seconds": 5.13,
      "text": "There is tenderness in the lower right tummy and no guarding."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.71,
      "end_seconds": 262.82,
      "duration_seconds": 1.11,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.23,
      "end_seconds": 274.41,
      "duration_seconds": 9.18,
      "text": "You can sit up now. So where does that leave us? My working impression is a flare of inflammatory bowel disease."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.38,
      "end_seconds": 313.28,
      "duration_seconds": 30.9,
      "text": "Blood tests is what I'd like next, for flare. I'd rather check than guess, and this is the quickest way to know more. I'm prescribing prednisolone, 40 milligrams, once a day, one week then reduce. You take it by mouth. That should help with inflammatory bowel flare. Keep up your fluids and call the IBD nurse if you get a fever. Let's get you seen by the IBD nurse, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.88,
      "end_seconds": 316.77,
      "duration_seconds": 2.89,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.93,
      "end_seconds": 330.36,
      "duration_seconds": 12.43,
      "text": "A stool test is something we might do if this doesn't improve next month. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.78,
      "end_seconds": 335.95,
      "duration_seconds": 4.17,
      "text": "No, uh, that's all. Thanks a lot."
    }
  ]
}