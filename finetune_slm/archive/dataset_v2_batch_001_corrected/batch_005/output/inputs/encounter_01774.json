      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.64,
      "end_seconds": 73.84,
      "duration_seconds": 1.2,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 74.87,
      "end_seconds": 77.58,
      "duration_seconds": 2.71,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.55,
      "end_seconds": 84.44,
      "duration_seconds": 2.89,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.99,
      "end_seconds": 88.2,
      "duration_seconds": 3.21,
      "text": "I look after my grandchildren most days."
