    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.11,
      "end_seconds": 95.48,
      "duration_seconds": 3.37,
      "text": "no, I don't take any tablets"
