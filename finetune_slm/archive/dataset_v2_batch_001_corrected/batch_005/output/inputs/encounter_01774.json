      "role": "DOCTOR",
      "start_seconds": 96.15,
      "end_seconds": 100.16,
      "duration_seconds": 4.01,
      "text": "Right, any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 104.16,
      "end_seconds": 105.67,
