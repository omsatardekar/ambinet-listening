      "role": "PATIENT",
      "start_seconds": 59.64,
      "end_seconds": 65.58,
      "duration_seconds": 5.94,
      "text": "mm, maybe a three out of ten on a bad day"
    },
    {
      "segment_id": "SEG0011",
