      "role": "DOCTOR",
      "start_seconds": 142.31,
      "end_seconds": 147.38,
      "duration_seconds": 5.07,
      "text": "A few quick ones: fever, head injury or loss of bladder control?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.63,
      "end_seconds": 155.33,
      "duration_seconds": 6.7,
      "text": "well, no fever, head injury or loss of bladder control, none of it"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.8,
      "end_seconds": 160.18,
      "duration_seconds": 3.38,
      "text": "how about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.85,
      "end_seconds": 163.33,
      "duration_seconds": 1.48,
      "text": "Nothing like that."
    },
    {
