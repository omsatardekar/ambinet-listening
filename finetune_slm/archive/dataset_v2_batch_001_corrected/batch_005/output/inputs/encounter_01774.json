      "role": "DOCTOR",
      "start_seconds": 118.72,
      "end_seconds": 121.31,
      "duration_seconds": 2.59,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.06,
      "end_seconds": 123.86,
      "duration_seconds": 1.8,
      "text": "No allergies at all."
    },
