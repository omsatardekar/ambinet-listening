      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.32,
      "end_seconds": 171.5,
      "duration_seconds": 3.18,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.37,
      "end_seconds": 174.87,
      "duration_seconds": 1.5,
      "text": "nothing else aches"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.48,
      "end_seconds": 179.4,
      "duration_seconds": 2.92,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.17,
      "end_seconds": 195.4,
      "duration_seconds": 2.23,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.08,
      "end_seconds": 216.17,
      "duration_seconds": 8.09,
      "text": "Okay: respiratory rate 16, pulse is 77 beats a minute, temperature is 36.9 degrees. And pressure 122 over 75."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.93,
      "end_seconds": 221.75,
      "duration_seconds": 2.82,
      "text": "let's move on to the examination"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 232.75,
      "end_seconds": 234.12,
      "duration_seconds": 1.37,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.33,
      "end_seconds": 237.76,
      "duration_seconds": 2.43,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.43,
      "end_seconds": 257.63,
      "duration_seconds": 4.2,
      "text": "You are alert and your neurological examination is normal."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.85,
      "end_seconds": 286.81,
      "duration_seconds": 24.96,
      "text": "Thank you, you can get dressed. So where does that leave us? I think we're dealing with a breakthrough seizure after missed medication and poor sleep at this stage. Let me just check I've got this right. You've had a seizure last week, since yesterday, moderate, and no head injury or fever."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 287.74,
      "end_seconds": 289.45,
      "duration_seconds": 1.71,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 308.38,
      "end_seconds": 327.75,
      "duration_seconds": 19.37,
      "text": "I'll request blood tests, it'll help with seizure. Take your medicine at the same time every day and do not drive until we say so. We'll refer you to the epilepsy nurse. Book a review in four weeks. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 328.83,
      "end_seconds": 332.75,
      "duration_seconds": 3.92,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 334.65,
      "end_seconds": 335.99,
      "duration_seconds": 1.34,
      "text": "Look after yourself."
    }
