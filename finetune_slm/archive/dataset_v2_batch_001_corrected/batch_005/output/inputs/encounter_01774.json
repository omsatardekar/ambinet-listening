    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.78,
      "end_seconds": 91.38,
      "duration_seconds": 2.6,
      "text": "Are you on any regular medication?"
