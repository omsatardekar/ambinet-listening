  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.53,
      "end_seconds": 3.14,
      "duration_seconds": 2.61,
      "text": "good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 4.79,
      "end_seconds": 6.38,
      "duration_seconds": 1.59,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.54,
      "end_seconds": 13.75,
      "duration_seconds": 6.21,
      "text": "Honestly, it's tired muscles, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.3,
      "end_seconds": 17.67,
      "duration_seconds": 3.37,
      "text": "rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 18.21,
      "end_seconds": 34.05,
      "duration_seconds": 15.84,
      "text": "Mostly mild. Oh, and not getting outdoors. That's been about the same, two weeks. I've had a mild ache in my legs too, um, for about two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.43,
      "end_seconds": 39.83,
      "duration_seconds": 4.4,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.42,
      "end_seconds": 56.16,
      "duration_seconds": 2.74,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.82,
      "end_seconds": 76.67,
      "duration_seconds": 7.85,
      "text": "okay: saturation 99 percent, pressure 122 over 73, temperature is 36.9 degrees, heart rate 72."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.71,
      "end_seconds": 80.97,
      "duration_seconds": 2.26,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.67,
      "end_seconds": 84.53,
      "duration_seconds": 2.86,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.55,
      "end_seconds": 90.45,
      "duration_seconds": 3.9,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.24,
      "end_seconds": 92.89,
      "duration_seconds": 1.65,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.58,
      "end_seconds": 97.35,
      "duration_seconds": 2.77,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.63,
      "end_seconds": 116.31,
      "duration_seconds": 4.68,
      "text": "your muscle strength is normal and there is no bone tenderness"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.66,
      "end_seconds": 122.79,
      "duration_seconds": 2.13,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.71,
      "end_seconds": 136.1,
      "duration_seconds": 1.39,
      "text": "any weight loss?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.46,
      "end_seconds": 139.6,
      "duration_seconds": 2.14,
      "text": "No. No weight loss."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.33,
      "end_seconds": 144.22,
      "duration_seconds": 3.89,
      "text": "Have you had any bone pain, fractures or weakness?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 145.57,
      "end_seconds": 147.75,
      "duration_seconds": 2.18,
      "text": "none of those, no"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.51,
      "end_seconds": 152.81,
      "duration_seconds": 3.3,
      "text": "anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 154.6,
      "end_seconds": 156.08,
      "duration_seconds": 1.48,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.64,
      "end_seconds": 159.13,
      "duration_seconds": 2.49,
      "text": "how are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.09,
      "end_seconds": 163.77,
      "duration_seconds": 2.68,
      "text": "Nothing unusual, you know, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.29,
      "end_seconds": 177.97,
      "duration_seconds": 3.68,
      "text": "are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 178.8,
      "end_seconds": 189.17,
      "duration_seconds": 10.37,
      "text": "I had a reaction to naproxen when I was younger, stomach pain, and I've avoided it since"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.79,
      "end_seconds": 206.76,
      "duration_seconds": 3.97,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.33,
      "end_seconds": 221.5,
      "duration_seconds": 14.17,
      "text": "Not much, I mostly stay in these days. I drink a lot of tea and snack through the day. I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.29,
      "end_seconds": 227.6,
      "duration_seconds": 4.31,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 232.99,
      "end_seconds": 235.53,
      "duration_seconds": 2.54,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.32,
      "end_seconds": 239.59,
      "duration_seconds": 2.27,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 241.2,
      "end_seconds": 249.12,
      "duration_seconds": 7.92,
      "text": "I've got diabetes i've had arthritis in my knees for about a year now"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.41,
      "end_seconds": 265.29,
      "duration_seconds": 9.88,
      "text": "Right, so diabetes and arthritis in your knees are already on your record. We'll keep that in mind today. Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 266.65,
      "end_seconds": 272.72,
      "duration_seconds": 6.07,
      "text": "Yes, I had a caesarean for my second baby, nine years ago."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.5,
      "end_seconds": 278.29,
      "duration_seconds": 3.79,
      "text": "alright, which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 280.25,
      "end_seconds": 288.2,
      "duration_seconds": 7.95,
      "text": "Erm, um, I'm on naproxen, 250 milligrams, twice a day for the knee pain."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.83,
      "end_seconds": 301.06,
      "duration_seconds": 12.23,
      "text": "Putting it all together, this looks most like low vitamin D without complications. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 302.69,
      "end_seconds": 305.57,
      "duration_seconds": 2.88,
      "text": "Actually, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.1,
      "end_seconds": 323.4,
      "duration_seconds": 17.3,
      "text": "I understand the worry. At the moment I'd say it's low vitamin D without complications, and we'll watch how it goes. Let's use colecalciferol, 1000 units, once a day, three months. That's for low vitamin D."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 324.21,
      "end_seconds": 325.31,
      "duration_seconds": 1.1,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 327.29,
      "end_seconds": 333.58,
      "duration_seconds": 6.29,
      "text": "Please come and see me in three months. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 335.13,
      "end_seconds": 340.04,
      "duration_seconds": 4.91,
      "text": "Okay, so I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 340.8,
      "end_seconds": 342.15,
      "duration_seconds": 1.35,
      "text": "Goodbye for now."
    }
  ]
}