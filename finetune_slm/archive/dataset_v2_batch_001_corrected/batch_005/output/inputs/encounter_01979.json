{
  "schema_version": "1.0",
  "encounter_id": "01979",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.79,
      "end_seconds": 3.92,
      "duration_seconds": 3.13,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.45,
      "end_seconds": 10.48,
      "duration_seconds": 5.03,
      "text": "Okay, that's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.07,
      "end_seconds": 17.69,
      "duration_seconds": 5.62,
      "text": "Well, um, I've been having a sore throat again."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.21,
      "end_seconds": 25.54,
      "duration_seconds": 3.33,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.04,
      "end_seconds": 28.72,
      "duration_seconds": 2.68,
      "text": "Probably about three months. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.47,
      "end_seconds": 40.68,
      "duration_seconds": 10.21,
      "text": "tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.35,
      "end_seconds": 48.84,
      "duration_seconds": 7.49,
      "text": "maybe a seven out of ten on a bad day. It's worse with swallowing"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.78,
      "end_seconds": 56.4,
      "duration_seconds": 2.62,
      "text": "so, any other symptoms with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.1,
      "end_seconds": 72.45,
      "duration_seconds": 14.35,
      "text": "let me think, uh, when it starts I tend to get missing school as well. Oh, and bad breath. That's been about the same, five days"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.47,
      "end_seconds": 76.63,
      "duration_seconds": 3.16,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.2,
      "end_seconds": 82.47,
      "duration_seconds": 5.27,
      "text": "Oh, um, I'd give it a seven, out of ten."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.55,
      "end_seconds": 90.42,
      "duration_seconds": 6.87,
      "text": "have you had a sore throat again before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.59,
      "end_seconds": 97.54,
      "duration_seconds": 5.95,
      "text": "well, I had a similar thing last year. It went away"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.58,
      "end_seconds": 101.91,
      "duration_seconds": 3.33,
      "text": "Did you get difficulty breathing or drooling?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.79,
      "end_seconds": 108.01,
      "duration_seconds": 4.22,
      "text": "no difficulty breathing or drooling, none of it"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.65,
      "end_seconds": 110.61,
      "duration_seconds": 1.96,
      "text": "Any rash or ear pain?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.86,
      "end_seconds": 118.49,
      "duration_seconds": 3.63,
      "text": "Erm, no, no rash or ear pain."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.7,
      "end_seconds": 122.19,
      "duration_seconds": 2.49,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.92,
      "end_seconds": 127.07,
      "duration_seconds": 3.15,
      "text": "Um, no, that's all fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.12,
      "end_seconds": 136.32,
      "duration_seconds": 1.2,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.71,
      "end_seconds": 141.92,
      "duration_seconds": 4.21,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.84,
      "end_seconds": 146.03,
      "duration_seconds": 3.19,
      "text": "Okay, do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.19,
      "end_seconds": 153.37,
      "duration_seconds": 3.18,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.11,
      "end_seconds": 159.84,
      "duration_seconds": 1.73,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.38,
      "end_seconds": 164.92,
      "duration_seconds": 3.54,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.71,
      "end_seconds": 171.91,
      "duration_seconds": 5.2,
      "text": "any inherited conditions that you know of in the the family?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.48,
      "end_seconds": 175.94,
      "duration_seconds": 2.46,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.53,
      "end_seconds": 182.03,
      "duration_seconds": 4.5,
      "text": "any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.57,
      "end_seconds": 185.96,
      "duration_seconds": 2.39,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.21,
      "end_seconds": 190.86,
      "duration_seconds": 3.65,
      "text": "any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.96,
      "end_seconds": 203.68,
      "duration_seconds": 11.72,
      "text": "I have epilepsy. I took the morning off to come in today. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.3,
      "end_seconds": 214.31,
      "duration_seconds": 10.01,
      "text": "Understood. Yes, epilepsy is known to us, good to have that clear. Right, are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.86,
      "end_seconds": 224.62,
      "duration_seconds": 6.76,
      "text": "I take sodium valproate, 500 milligrams, twice a day. Paracetamol syrup, every six hours."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.35,
      "end_seconds": 231.51,
      "duration_seconds": 2.16,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.34,
      "end_seconds": 237.91,
      "duration_seconds": 4.57,
      "text": "10 ml, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.17,
      "end_seconds": 255.54,
      "duration_seconds": 4.37,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.54,
      "end_seconds": 269.16,
      "duration_seconds": 2.62,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.17,
      "end_seconds": 287.54,
      "duration_seconds": 9.37,
      "text": "okay: heart rate 98, respiratory rate 22, BP is 115 over 77, temp 39.4 degrees, saturation 95 percent"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.48,
      "end_seconds": 293.73,
      "duration_seconds": 3.25,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.91,
      "end_seconds": 297.23,
      "duration_seconds": 2.32,
      "text": "hold that for a second"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.1,
      "end_seconds": 322.01,
      "duration_seconds": 6.91,
      "text": "The tonsils are large and red with white spots, and and the neck glands are tender."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.42,
      "end_seconds": 339.58,
      "duration_seconds": 1.16,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.09,
      "end_seconds": 356.92,
      "duration_seconds": 12.83,
      "text": "You can sit up now. Okay, so my impression is this: It fits best with tonsillitis. A throat swab is what I'd like next, for recurrent tonsillitis."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.72,
      "end_seconds": 360.91,
      "duration_seconds": 2.19,
      "text": "is that done today?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.8,
      "end_seconds": 393.45,
      "duration_seconds": 30.65,
      "text": "Let's use phenoxymethylpenicillin, 250 milligrams, four times a day, ten days. It's for tonsillitis. Plenty of fluids and soft foods, and he can return to school when the fever has gone. I'd like you to see the ENT clinic as well, and I'll write the referral. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency. Come back if recurrent, tonsil review."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 395.24,
      "end_seconds": 400.56,
      "duration_seconds": 5.32,
      "text": "Before we finish, can you repeat the plan back to me?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 402.58,
      "end_seconds": 412.64,
      "duration_seconds": 10.06,
      "text": "So, I take the phenoxymethylpenicillin, 250 milligrams, four times a day and come back if recurrent, tonsil review. Is that right?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 414.67,
      "end_seconds": 421.1,
      "duration_seconds": 6.43,
      "text": "Yes, exactly right. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 421.96,
      "end_seconds": 424.88,
      "duration_seconds": 2.92,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 426.31,
      "end_seconds": 428.25,
      "duration_seconds": 1.94,
      "text": "right, all the best"
    }
  ]
}