      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.94,
      "end_seconds": 277.5,
      "duration_seconds": 2.56,
      "text": "Thank you, you can get dressed."
