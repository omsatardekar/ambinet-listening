{
  "schema_version": "1.0",
  "encounter_id": "01505",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.58,
      "end_seconds": 2.68,
      "duration_seconds": 2.1,
      "text": "Good morning, grab a seat."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.1,
      "end_seconds": 6.37,
      "duration_seconds": 2.27,
      "text": "Hi, you know, thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.23,
      "end_seconds": 11.36,
      "duration_seconds": 3.13,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.81,
      "end_seconds": 20.8,
      "duration_seconds": 7.99,
      "text": "Yeah, it's a dull low backache. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.87,
      "end_seconds": 25.73,
      "duration_seconds": 3.86,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.92,
      "end_seconds": 37.57,
      "duration_seconds": 10.65,
      "text": "Sorry, what was I saying, probably two months. Yeah. Work has been very busy so I kept ignoring it."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.47,
      "end_seconds": 48.79,
      "duration_seconds": 9.32,
      "text": "Right, can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.12,
      "end_seconds": 56.29,
      "duration_seconds": 6.17,
      "text": "Uh, it happens on and off. I'd call it moderate."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.49,
      "end_seconds": 60.6,
      "duration_seconds": 3.11,
      "text": "Have you been feeling a bit feverish?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 62.45,
      "end_seconds": 64.12,
      "duration_seconds": 1.67,
      "text": "Yeah, that too."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.17,
      "end_seconds": 70.65,
      "duration_seconds": 4.48,
      "text": "Right, rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 72.43,
      "end_seconds": 83.34,
      "duration_seconds": 10.91,
      "text": "Uh, pretty mild, if I'm being honest. Ah, I had burning on passing urine before. That's settled now, though."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.21,
      "end_seconds": 89.31,
      "duration_seconds": 4.1,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 90.81,
      "end_seconds": 94.91,
      "duration_seconds": 4.1,
      "text": "No, uh, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.88,
      "end_seconds": 99.2,
      "duration_seconds": 3.32,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.18,
      "end_seconds": 106.91,
      "duration_seconds": 5.73,
      "text": "Alendronate. I take it once a week for my bones."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.9,
      "end_seconds": 110.21,
      "duration_seconds": 2.31,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.35,
      "end_seconds": 118.94,
      "duration_seconds": 7.59,
      "text": "70 milligrams. I take paracetamol, 650 milligrams, when needed for the knee pain."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.19,
      "end_seconds": 124.14,
      "duration_seconds": 3.95,
      "text": "Alright, a few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.63,
      "end_seconds": 136.8,
      "duration_seconds": 11.17,
      "text": "Lots of rice, lentils and some fruit. I'm a plumber, lots of bending and kneeling. I swim twice a week."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.68,
      "end_seconds": 142.18,
      "duration_seconds": 3.5,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.55,
      "end_seconds": 156.0,
      "duration_seconds": 12.45,
      "text": "I've got thin bones. I've been putting this off for weeks. Okay, so I have arthritis in my knees, for five years."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.13,
      "end_seconds": 171.23,
      "duration_seconds": 14.1,
      "text": "Yes, thin bones and arthritis in your knees are known to us, good to have that clear. Have you had any vaginal bleeding, leaking fluid, reduced baby movements or severe back pain?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 172.29,
      "end_seconds": 175.09,
      "duration_seconds": 2.8,
      "text": "Erm, nope, nothing like that."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.67,
      "end_seconds": 178.8,
      "duration_seconds": 2.13,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 179.63,
      "end_seconds": 181.74,
      "duration_seconds": 2.11,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.6,
      "end_seconds": 193.22,
      "duration_seconds": 2.62,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.4,
      "end_seconds": 204.3,
      "duration_seconds": 2.9,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.14,
      "end_seconds": 234.35,
      "duration_seconds": 13.21,
      "text": "Okay: blood pressure 115 over 74, BMI works out to 17.5, height 182 centimetres, weight 58 kilos, SpO2 96 percent on room air, heart rate 102."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 234.86,
      "end_seconds": 236.65,
      "duration_seconds": 1.79,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.59,
      "end_seconds": 241.38,
      "duration_seconds": 3.79,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.77,
      "end_seconds": 248.13,
      "duration_seconds": 4.36,
      "text": "Alright, could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 266.6,
      "end_seconds": 267.3,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.27,
      "end_seconds": 270.53,
      "duration_seconds": 2.26,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.45,
      "end_seconds": 284.9,
      "duration_seconds": 6.45,
      "text": "There is mild tenderness above the pubic bone and no tenderness in the loins."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 287.51,
      "end_seconds": 297.53,
      "duration_seconds": 10.02,
      "text": "You can sit up now. From what you've told me and what I found, it fits best with a urinary infection in pregnancy."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 299.08,
      "end_seconds": 301.66,
      "duration_seconds": 2.58,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 303.2,
      "end_seconds": 315.5,
      "duration_seconds": 12.3,
      "text": "I understand the worry. At the moment I'd say it's a urinary infection in pregnancy, and we'll know more once the a urine culture is back."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 322.8,
      "end_seconds": 349.14,
      "duration_seconds": 26.34,
      "text": "We should do a urine culture for urinary infection. I'm going to put you on cefalexin, 500 milligrams, twice a day, seven days. You take it by mouth. That's for urinary infection in pregnancy. Drink plenty of fluids and tell your midwife. I'd like you to see the midwife as well, and I'll write the referral. Let's plan a check in one week."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 350.91,
      "end_seconds": 354.25,
      "duration_seconds": 3.34,
      "text": "I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 354.77,
      "end_seconds": 357.56,
      "duration_seconds": 2.79,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 363.26,
      "end_seconds": 366.09,
      "duration_seconds": 2.83,
      "text": "That's clear, uh, thanks."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 367.48,
      "end_seconds": 368.77,
      "duration_seconds": 1.29,
      "text": "Goodbye for now."
    }
  ]
}