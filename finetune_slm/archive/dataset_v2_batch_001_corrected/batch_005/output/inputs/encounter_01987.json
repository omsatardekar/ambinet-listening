{
  "schema_version": "1.0",
  "encounter_id": "01987",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.58,
      "end_seconds": 5.19,
      "duration_seconds": 4.61,
      "text": "Hello, take a seat, I'll be with you in a second."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.48,
      "end_seconds": 7.61,
      "duration_seconds": 1.13,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.23,
      "end_seconds": 12.84,
      "duration_seconds": 3.61,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.62,
      "end_seconds": 20.19,
      "duration_seconds": 6.57,
      "text": "Um, so... a high reading at the pharmacy. That's why I came."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.74,
      "end_seconds": 24.05,
      "duration_seconds": 3.31,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.91,
      "end_seconds": 28.35,
      "duration_seconds": 1.44,
      "text": "It started yesterday."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.48,
      "end_seconds": 45.82,
      "duration_seconds": 3.34,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 56.0,
      "end_seconds": 58.12,
      "duration_seconds": 2.12,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.98,
      "end_seconds": 83.4,
      "duration_seconds": 7.42,
      "text": "Okay: SpO2 98 percent on room air, respiratory rate 16, blood pressure 163 over 95, heart rate 75."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.94,
      "end_seconds": 88.08,
      "duration_seconds": 2.14,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.15,
      "end_seconds": 91.21,
      "duration_seconds": 2.06,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.77,
      "end_seconds": 106.75,
      "duration_seconds": 6.98,
      "text": "Your blood pressure is a little raised in the clinic but your heart sounds are normal."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.48,
      "end_seconds": 112.6,
      "duration_seconds": 2.12,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.02,
      "end_seconds": 132.86,
      "duration_seconds": 1.84,
      "text": "So, any leg swelling?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.81,
      "end_seconds": 136.95,
      "duration_seconds": 2.14,
      "text": "No, no leg swelling."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.93,
      "end_seconds": 144.74,
      "duration_seconds": 5.81,
      "text": "Let me check a few things. Any chest pain, visual changes or breathlessness?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 145.44,
      "end_seconds": 149.49,
      "duration_seconds": 4.05,
      "text": "Erm, no, I haven't had any of them."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.38,
      "end_seconds": 152.84,
      "duration_seconds": 2.46,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 154.55,
      "end_seconds": 156.69,
      "duration_seconds": 2.14,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.39,
      "end_seconds": 163.04,
      "duration_seconds": 4.65,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 164.49,
      "end_seconds": 167.25,
      "duration_seconds": 2.76,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.81,
      "end_seconds": 169.87,
      "duration_seconds": 2.06,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 171.25,
      "end_seconds": 172.76,
      "duration_seconds": 1.51,
      "text": "I have depression."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.64,
      "end_seconds": 175.51,
      "duration_seconds": 1.87,
      "text": "Ah. What about alcohol?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 177.6,
      "end_seconds": 180.78,
      "duration_seconds": 3.18,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.32,
      "end_seconds": 184.01,
      "duration_seconds": 1.69,
      "text": "Alright, do you smoke?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 185.37,
      "end_seconds": 189.24,
      "duration_seconds": 3.87,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.3,
      "end_seconds": 194.5,
      "duration_seconds": 3.2,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 198.94,
      "end_seconds": 204.15,
      "duration_seconds": 5.21,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.0,
      "end_seconds": 207.11,
      "duration_seconds": 2.11,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 208.63,
      "end_seconds": 214.01,
      "duration_seconds": 5.38,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.98,
      "end_seconds": 216.37,
      "duration_seconds": 1.39,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 217.41,
      "end_seconds": 220.31,
      "duration_seconds": 2.9,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.39,
      "end_seconds": 225.26,
      "duration_seconds": 3.87,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 227.15,
      "end_seconds": 234.17,
      "duration_seconds": 7.02,
      "text": "I was told I'm allergic to amoxicillin, but I don't remember what reaction I had."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.42,
      "end_seconds": 239.76,
      "duration_seconds": 4.34,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 241.69,
      "end_seconds": 247.11,
      "duration_seconds": 5.42,
      "text": "It's escitalopram, 10 milligrams, once a day for my mood."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.41,
      "end_seconds": 262.39,
      "duration_seconds": 3.98,
      "text": "Okay, has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 263.63,
      "end_seconds": 266.44,
      "duration_seconds": 2.81,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.25,
      "end_seconds": 284.02,
      "duration_seconds": 16.77,
      "text": "So, based on the history and the examination, my working impression is possible white-coat blood pressure. Stop me if I've got anything wrong. You've had a high reading at the pharmacy, yesterday, and no chest pain or breathlessness."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 285.83,
      "end_seconds": 286.53,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 303.2,
      "end_seconds": 324.12,
      "duration_seconds": 20.92,
      "text": "Let's book a 24-hour blood pressure monitor to look into raised clinic blood pressure. Cut back on salt and do a week of home readings. Book a review after the monitor. Can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 324.92,
      "end_seconds": 329.75,
      "duration_seconds": 4.83,
      "text": "So, I come back after the monitor. Is that right?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 333.52,
      "end_seconds": 338.19,
      "duration_seconds": 4.67,
      "text": "Yes, exactly right. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 339.26,
      "end_seconds": 341.99,
      "duration_seconds": 2.73,
      "text": "I think I understand everything. Thanks."
    }
  ]
}