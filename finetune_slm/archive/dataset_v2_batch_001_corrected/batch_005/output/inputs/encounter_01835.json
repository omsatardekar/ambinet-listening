{
  "schema_version": "1.0",
  "encounter_id": "01835",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.95,
      "end_seconds": 7.48,
      "duration_seconds": 6.53,
      "text": "well, um, hello? Doctor? I was told to come in"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.43,
      "end_seconds": 12.11,
      "duration_seconds": 3.68,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.09,
      "end_seconds": 21.96,
      "duration_seconds": 7.87,
      "text": "So the thing is, I've got tired muscles. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.72,
      "end_seconds": 25.08,
      "duration_seconds": 2.36,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.55,
      "end_seconds": 30.56,
      "duration_seconds": 4.01,
      "text": "It's been about four days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.26,
      "end_seconds": 36.15,
      "duration_seconds": 3.89,
      "text": "Rate it it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.7,
      "end_seconds": 57.96,
      "duration_seconds": 20.26,
      "text": "I'd say mild. Oh, um, and a mild ache in my legs. That's been about the same, three weeks. Yeah, um, as for mild ache in my legs, it feels severe to me"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.48,
      "end_seconds": 65.06,
      "duration_seconds": 5.58,
      "text": "Have you had tired muscles before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.2,
      "end_seconds": 74.05,
      "duration_seconds": 7.85,
      "text": "Right, I had a similar thing a couple of years ago. It went away."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.38,
      "end_seconds": 79.77,
      "duration_seconds": 4.39,
      "text": "So, which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.42,
      "end_seconds": 89.21,
      "duration_seconds": 8.79,
      "text": "Alendronate, 70 milligrams, once a week for my bones. It's simvastatin, 20 milligrams, at night."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.71,
      "end_seconds": 103.56,
      "duration_seconds": 3.85,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.73,
      "end_seconds": 108.68,
      "duration_seconds": 3.95,
      "text": "No, not that that I know of."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.51,
      "end_seconds": 112.28,
      "duration_seconds": 1.77,
      "text": "and alcohol, how much?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.37,
      "end_seconds": 118.2,
      "duration_seconds": 4.83,
      "text": "I'll have a glass of wine with dinner"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.46,
      "end_seconds": 122.54,
      "duration_seconds": 2.08,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.6,
      "end_seconds": 128.68,
      "duration_seconds": 4.08,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.82,
      "end_seconds": 131.48,
      "duration_seconds": 1.66,
      "text": "who lives with you?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.97,
      "end_seconds": 135.45,
      "duration_seconds": 2.48,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.88,
      "end_seconds": 142.2,
      "duration_seconds": 1.32,
      "text": "and your job?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.16,
      "end_seconds": 146.63,
      "duration_seconds": 3.47,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.18,
      "end_seconds": 150.99,
      "duration_seconds": 3.81,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.63,
      "end_seconds": 157.21,
      "duration_seconds": 4.58,
      "text": "Well, um, I've had thin bones, yes."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.81,
      "end_seconds": 164.62,
      "duration_seconds": 1.81,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.24,
      "end_seconds": 177.99,
      "duration_seconds": 12.75,
      "text": "I've had high cholesterol for about a year now. My neighbour said I should get it looked at. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.11,
      "end_seconds": 185.05,
      "duration_seconds": 5.94,
      "text": "yes, thin bones is known to us, good to have that clear"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.83,
      "end_seconds": 197.91,
      "duration_seconds": 5.08,
      "text": "Any bone pain, weakness, fractures or weight loss at all?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.87,
      "end_seconds": 204.35,
      "duration_seconds": 5.48,
      "text": "No, no bone pain, weakness, fractures or weight loss."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.36,
      "end_seconds": 207.92,
      "duration_seconds": 2.56,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.34,
      "end_seconds": 210.37,
      "duration_seconds": 1.03,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.96,
      "end_seconds": 214.49,
      "duration_seconds": 2.53,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.28,
      "end_seconds": 226.58,
      "duration_seconds": 2.3,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.79,
      "end_seconds": 249.31,
      "duration_seconds": 6.52,
      "text": "okay: heart rate 78, temperature is 36.5 degrees, blood pressure 113 over 68."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.03,
      "end_seconds": 252.54,
      "duration_seconds": 2.51,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.41,
      "end_seconds": 258.26,
      "duration_seconds": 3.85,
      "text": "I'll explain what these mean in a moment"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.57,
      "end_seconds": 264.07,
      "duration_seconds": 3.5,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.98,
      "end_seconds": 267.8,
      "duration_seconds": 1.82,
      "text": "let me feel here"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.27,
      "end_seconds": 286.28,
      "duration_seconds": 5.01,
      "text": "Your muscle strength is normal and there is no bone tenderness."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.39,
      "end_seconds": 297.34,
      "duration_seconds": 7.95,
      "text": "you can relax now. Okay, thinking it through, the most likely explanation is low vitamin D without complications"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.22,
      "end_seconds": 300.86,
      "duration_seconds": 1.64,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.7,
      "end_seconds": 310.0,
      "duration_seconds": 8.3,
      "text": "Nothing I've seen today points to an emergency. It looks like low vitamin D without complications, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.87,
      "end_seconds": 348.98,
      "duration_seconds": 24.11,
      "text": "I'm sending you for a vitamin D level because of tiredness the treatment will be colecalciferol, 1000 units, once a day, three months that's for low vitamin D get some daily daylight and eat oily fish keep an eye out, and if the symptoms get worse, call us the same day or go to emergency"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.81,
      "end_seconds": 353.6,
      "duration_seconds": 2.79,
      "text": "Alright, you know, I follow."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.19,
      "end_seconds": 360.6,
      "duration_seconds": 6.41,
      "text": "I'd like to see you again in three months. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 361.63,
      "end_seconds": 365.12,
      "duration_seconds": 3.49,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}