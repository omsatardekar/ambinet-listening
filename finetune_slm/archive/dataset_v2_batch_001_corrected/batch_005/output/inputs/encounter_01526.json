{
  "schema_version": "1.0",
  "encounter_id": "01526",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.25,
      "end_seconds": 8.12,
      "duration_seconds": 6.87,
      "text": "Sorry, what was I saying, doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.1,
      "end_seconds": 13.59,
      "duration_seconds": 4.49,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.57,
      "end_seconds": 26.8,
      "duration_seconds": 12.23,
      "text": "Um, so... a stiff neck after sleeping badly. That's why I came. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.64,
      "end_seconds": 31.25,
      "duration_seconds": 3.61,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.31,
      "end_seconds": 42.4,
      "duration_seconds": 2.09,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.76,
      "end_seconds": 67.42,
      "duration_seconds": 12.66,
      "text": "Okay: height 161 centimetres, temp 36.8 degrees. And weight 88 kilos, heart rate 76, BP is 117 over 69, respiratory rate 17, SpO2 98 percent on room air."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.22,
      "end_seconds": 71.2,
      "duration_seconds": 1.98,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.2,
      "end_seconds": 79.22,
      "duration_seconds": 7.02,
      "text": "I'll explain what these mean in a moment. Has this been going on for long?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.09,
      "end_seconds": 83.93,
      "duration_seconds": 2.84,
      "text": "Since Friday, that's when it began."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.37,
      "end_seconds": 92.92,
      "duration_seconds": 8.55,
      "text": "Right, right. Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.34,
      "end_seconds": 111.43,
      "duration_seconds": 17.09,
      "text": "I notice it more with turning. It's mild, honestly. Sorry, I know I'm rambling a bit. I've also had tightness between my shoulders, since Monday. About tightness between my shoulders, it's once or twice a day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.19,
      "end_seconds": 131.17,
      "duration_seconds": 1.98,
      "text": "Any sign of arm numbness?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.03,
      "end_seconds": 135.61,
      "duration_seconds": 3.58,
      "text": "No, I haven't had any arm numbness."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.92,
      "end_seconds": 139.52,
      "duration_seconds": 2.6,
      "text": "Any headache, fever or head injury?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.12,
      "end_seconds": 144.03,
      "duration_seconds": 3.91,
      "text": "No, no headache, fever or head injury."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.6,
      "end_seconds": 145.91,
      "duration_seconds": 1.31,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.0,
      "end_seconds": 149.93,
      "duration_seconds": 1.93,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.4,
      "end_seconds": 153.6,
      "duration_seconds": 2.2,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.01,
      "end_seconds": 155.97,
      "duration_seconds": 0.96,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.8,
      "end_seconds": 167.14,
      "duration_seconds": 3.34,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.9,
      "end_seconds": 172.92,
      "duration_seconds": 5.02,
      "text": "Yes, I had an operation for a hernia, last spring."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.37,
      "end_seconds": 179.18,
      "duration_seconds": 4.81,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.4,
      "end_seconds": 183.27,
      "duration_seconds": 2.87,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.85,
      "end_seconds": 199.77,
      "duration_seconds": 1.92,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.38,
      "end_seconds": 204.88,
      "duration_seconds": 4.5,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.42,
      "end_seconds": 206.85,
      "duration_seconds": 1.43,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.82,
      "end_seconds": 211.52,
      "duration_seconds": 2.7,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.39,
      "end_seconds": 217.2,
      "duration_seconds": 3.81,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.28,
      "end_seconds": 226.22,
      "duration_seconds": 6.94,
      "text": "I've got heart disease. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.31,
      "end_seconds": 230.49,
      "duration_seconds": 2.18,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.73,
      "end_seconds": 259.47,
      "duration_seconds": 27.74,
      "text": "It's metoprolol, 50 milligrams, twice a day for my heart. I'd rather not end up on lots of tablets if I can avoid it. I didn't want to make a fuss, you know. I'm on paracetamol, 1 gram, when needed. I did try to ignore it for a while. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.8,
      "end_seconds": 264.7,
      "duration_seconds": 2.9,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.2,
      "end_seconds": 268.61,
      "duration_seconds": 2.41,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.75,
      "end_seconds": 292.86,
      "duration_seconds": 6.11,
      "text": "The neck muscles on the left are tight and the movements are full."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.59,
      "end_seconds": 304.24,
      "duration_seconds": 7.65,
      "text": "Okay, that's enough for me. Okay, thinking it through, it fits best with a simple neck muscle strain."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.18,
      "end_seconds": 332.58,
      "duration_seconds": 12.4,
      "text": "Heat, gentle neck rolls, and a supportive pillow. See me again if not better in two weeks. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.7,
      "end_seconds": 335.93,
      "duration_seconds": 2.23,
      "text": "Alright, thanks, take care."
    }
  ]
}