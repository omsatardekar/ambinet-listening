    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 244.07,
      "end_seconds": 247.15,
      "duration_seconds": 3.08,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.35,
      "end_seconds": 251.97,
      "duration_seconds": 1.62,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 253.92,
      "end_seconds": 257.43,
      "duration_seconds": 3.51,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.05,
      "end_seconds": 260.05,
      "duration_seconds": 2.0,
      "text": "is there someone at home?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 261.07,
      "end_seconds": 265.33,
      "duration_seconds": 4.26,
      "text": "My husband and I live above the shop"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.23,
      "end_seconds": 287.06,
      "duration_seconds": 2.83,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 287.82,
      "end_seconds": 295.44,
      "duration_seconds": 7.62,
      "text": "Hmm, just a mole taken off my arm, a few years ago."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.49,
      "end_seconds": 299.73,
      "duration_seconds": 3.24,
      "text": "Okay, what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 300.35,
      "end_seconds": 303.11,
      "duration_seconds": 2.76,
      "text": "Rosuvastatin, 10 milligrams, at night."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 303.31,
      "end_seconds": 307.34,
      "duration_seconds": 4.03,
      "text": "Understood. Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 311.12,
      "end_seconds": 321.88,
      "duration_seconds": 10.76,
      "text": "I have high cholesterol, for two years it's a relief to finally sit down and talk about it"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.01,
      "end_seconds": 337.41,
      "duration_seconds": 14.4,
      "text": "okay, I can see high cholesterol in your file as well let me tell you where I've got to this looks most like muscle symptoms possibly from the cholesterol tablet we shouldn't forget a low thyroid"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 338.77,
      "end_seconds": 340.77,
      "duration_seconds": 2.0,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 342.58,
      "end_seconds": 356.05,
      "duration_seconds": 13.47,
      "text": "I can't promise yet, but most people with muscle symptoms possibly from the cholesterol tablet do well once it's treated properly. Let's get a creatine kinase test, for muscle aches"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 357.91,
      "end_seconds": 360.05,
      "duration_seconds": 2.14,
      "text": "Okay, I'll do it."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 360.62,
      "end_seconds": 369.58,
      "duration_seconds": 8.96,
      "text": "We will pause the statin for a few weeks while we check the blood tests. Right, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 370.73,
      "end_seconds": 373.98,
      "duration_seconds": 3.25,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 375.06,
      "end_seconds": 376.45,
