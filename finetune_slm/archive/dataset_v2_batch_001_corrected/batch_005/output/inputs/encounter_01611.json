    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.25,
      "end_seconds": 235.59,
      "duration_seconds": 1.34,
      "text": "what about alcohol?"
