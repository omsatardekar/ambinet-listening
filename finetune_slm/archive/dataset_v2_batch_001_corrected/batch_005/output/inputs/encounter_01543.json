    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.12,
      "end_seconds": 180.49,
      "duration_seconds": 2.37,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.14,
      "end_seconds": 185.94,
      "duration_seconds": 3.8,
      "text": "No, I share a house with my brother"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.73,
      "end_seconds": 188.57,
      "duration_seconds": 1.84,
      "text": "How are your meals?"
