      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.22,
      "end_seconds": 242.71,
      "duration_seconds": 4.49,
      "text": "you have a a thick neck and a crowded throat"
    },
