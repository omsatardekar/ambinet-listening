      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.54,
      "end_seconds": 176.52,
      "duration_seconds": 2.98,
      "text": "I walk the dog every morning"
