      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.76,
      "end_seconds": 161.26,
      "duration_seconds": 4.5,
      "text": "I take hydrochlorothiazide, 12.5 milligrams, every morning"
    },
    {
      "segment_id": "SEG0022",
