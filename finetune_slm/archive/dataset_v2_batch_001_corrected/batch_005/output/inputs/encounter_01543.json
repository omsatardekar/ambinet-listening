      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.12,
      "end_seconds": 249.12,
      "duration_seconds": 2.0,
      "text": "that's the the examination finished"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.4,
      "end_seconds": 267.14,
      "duration_seconds": 6.74,
      "text": "from what you've told me and what I found, this looks most like probable obstructive sleep apnoea"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.84,
      "end_seconds": 275.55,
      "duration_seconds": 2.71,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.22,
      "end_seconds": 311.13,
      "duration_seconds": 33.91,
      "text": "nothing I've seen today points to an emergency it looks like probable obstructive sleep apnoea, but I'd like to confirm i want a home sleep study done, that's for snoring and apnoeas i'd like to arrange a thyroid test for tiredness it's a routine test and it'll give us a much clearer picture avoid alcohol in the evening, lose some weight if you can, and do not drive when drowsy"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.18,
      "end_seconds": 327.7,
      "duration_seconds": 15.52,
      "text": "don't skip meals and try to eat smaller portions more often through the day. One warning sign to remember: the symptoms get worse. In that case don't wait. Let's review you after the sleep study"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.42,
      "end_seconds": 330.12,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.82,
      "end_seconds": 333.67,
      "duration_seconds": 2.85,
      "text": "Have I covered everything you wanted?"
    },
