      "role": "DOCTOR",
      "start_seconds": 127.2,
      "end_seconds": 130.07,
      "duration_seconds": 2.87,
      "text": "right, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.3,
      "end_seconds": 134.8,
      "duration_seconds": 3.5,
      "text": "Actually, nothing, I haven't had any operations."
