{
  "schema_version": "1.0",
  "encounter_id": "01869",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.06,
      "end_seconds": 5.77,
      "duration_seconds": 4.71,
      "text": "Yeah, hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.8,
      "end_seconds": 10.89,
      "duration_seconds": 4.09,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.9,
      "end_seconds": 18.99,
      "duration_seconds": 6.09,
      "text": "Good morning, you know, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.58,
      "end_seconds": 26.33,
      "duration_seconds": 5.75,
      "text": "I've been dealing with tingling in my thumb and first fingers."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.45,
      "end_seconds": 35.38,
      "duration_seconds": 3.93,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.78,
      "end_seconds": 42.44,
      "duration_seconds": 5.66,
      "text": "Sorry, what was I saying, around about a month, I think."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 44.38,
      "end_seconds": 48.63,
      "duration_seconds": 4.25,
      "text": "It was closer to about two months, doctor."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.19,
      "end_seconds": 54.0,
      "duration_seconds": 4.81,
      "text": "Okay, so roughly one to two months. Is that right?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.61,
      "end_seconds": 56.72,
      "duration_seconds": 2.11,
      "text": "Yeah, um, roughly."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.59,
      "end_seconds": 63.65,
      "duration_seconds": 5.06,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.59,
      "end_seconds": 73.98,
      "duration_seconds": 9.39,
      "text": "So, it's worse with driving and night. Shaking the hand helps a bit. It's every other day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.01,
      "end_seconds": 80.44,
      "duration_seconds": 4.43,
      "text": "Have you been waking at night with numb hands?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.01,
      "end_seconds": 96.77,
      "duration_seconds": 11.76,
      "text": "Yes, I have. As for waking at night with numb hands, mostly severe. It's all the time. And dropping things, too."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.29,
      "end_seconds": 100.94,
      "duration_seconds": 2.65,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.44,
      "end_seconds": 106.8,
      "duration_seconds": 4.36,
      "text": "Hmm, no, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.39,
      "end_seconds": 118.65,
      "duration_seconds": 2.26,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.17,
      "end_seconds": 123.15,
      "duration_seconds": 3.98,
      "text": "I had my septum straightened in my thirties."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.87,
      "end_seconds": 128.31,
      "duration_seconds": 3.44,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.78,
      "end_seconds": 133.77,
      "duration_seconds": 3.99,
      "text": "Sumatriptan, 50 milligrams, when needed for my migraines."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 134.66,
      "end_seconds": 142.65,
      "duration_seconds": 7.99,
      "text": "It's meant to be when needed, though I don't see he take it every time."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.73,
      "end_seconds": 147.47,
      "duration_seconds": 2.74,
      "text": "It's hydrocortisone cream, when needed."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.01,
      "end_seconds": 154.94,
      "duration_seconds": 2.93,
      "text": "Roughly how long on that one?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.12,
      "end_seconds": 158.19,
      "duration_seconds": 2.07,
      "text": "For about three months."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.04,
      "end_seconds": 161.28,
      "duration_seconds": 1.24,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.89,
      "end_seconds": 166.69,
      "duration_seconds": 3.8,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.95,
      "end_seconds": 169.9,
      "duration_seconds": 1.95,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.87,
      "end_seconds": 175.58,
      "duration_seconds": 3.71,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.36,
      "end_seconds": 179.32,
      "duration_seconds": 2.96,
      "text": "Right, tell me about your eating."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.92,
      "end_seconds": 186.95,
      "duration_seconds": 6.03,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.0,
      "end_seconds": 190.11,
      "duration_seconds": 2.11,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.72,
      "end_seconds": 195.52,
      "duration_seconds": 3.8,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.12,
      "end_seconds": 200.08,
      "duration_seconds": 3.96,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.13,
      "end_seconds": 203.15,
      "duration_seconds": 2.02,
      "text": "I've had migraines, yes."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.24,
      "end_seconds": 205.01,
      "duration_seconds": 0.77,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.61,
      "end_seconds": 218.74,
      "duration_seconds": 12.13,
      "text": "I have eczema. It's a relief to finally sit down and talk about it. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.99,
      "end_seconds": 227.49,
      "duration_seconds": 7.5,
      "text": "Ah. Alright, migraines, that matches what I have here. Right, does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.14,
      "end_seconds": 231.79,
      "duration_seconds": 2.65,
      "text": "My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.77,
      "end_seconds": 236.46,
      "duration_seconds": 1.69,
      "text": "How about neck pain?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.64,
      "end_seconds": 241.92,
      "duration_seconds": 4.28,
      "text": "Hmm, not at all, no neck pain."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.07,
      "end_seconds": 248.18,
      "duration_seconds": 5.11,
      "text": "Did you get pain in the shoulder or weakness in the legs?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.76,
      "end_seconds": 255.97,
      "duration_seconds": 5.21,
      "text": "No, no pain in the shoulder or weakness in the legs."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.11,
      "end_seconds": 260.13,
      "duration_seconds": 3.02,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.94,
      "end_seconds": 263.45,
      "duration_seconds": 1.51,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.88,
      "end_seconds": 266.83,
      "duration_seconds": 1.95,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.68,
      "end_seconds": 271.7,
      "duration_seconds": 1.02,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 272.38,
      "end_seconds": 289.36,
      "duration_seconds": 16.98,
      "text": "Doctor, I've got the readings for you. Respiratory rate 15, height 170 centimetres, BP is 109 over 74, weight 81 kilos, BMI works out to 28.0, heart rate 80, temp 36.4 degrees, SpO2 99 percent on room air."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.83,
      "end_seconds": 294.81,
      "duration_seconds": 1.98,
      "text": "Right, good, thank you."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.5,
      "end_seconds": 300.87,
      "duration_seconds": 3.37,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.9,
      "end_seconds": 303.13,
      "duration_seconds": 1.23,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.91,
      "end_seconds": 322.89,
      "duration_seconds": 5.98,
      "text": "Tapping over the wrist brings on the tingling and the thumb muscle is slightly thin."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.48,
      "end_seconds": 335.18,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.03,
      "end_seconds": 348.54,
      "duration_seconds": 10.51,
      "text": "You can sit up now. Taking everything into account, this is probably carpal tunnel syndrome. Another possibility is a pinched nerve in the neck."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.39,
      "end_seconds": 350.88,
      "duration_seconds": 1.49,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.62,
      "end_seconds": 358.34,
      "duration_seconds": 6.72,
      "text": "I can't promise yet, but most people with carpal tunnel syndrome do well once it's treated properly."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 372.21,
      "end_seconds": 377.69,
      "duration_seconds": 5.48,
      "text": "I'm sending you for a nerve conduction study because of carpal tunnel."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 378.78,
      "end_seconds": 381.25,
      "duration_seconds": 2.47,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 381.95,
      "end_seconds": 387.86,
      "duration_seconds": 5.91,
      "text": "Wear a wrist splint at night. I'd like to see you again in six weeks."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 389.93,
      "end_seconds": 393.66,
      "duration_seconds": 3.73,
      "text": "Yeah, uh, alright, I'll be back."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 394.61,
      "end_seconds": 398.77,
      "duration_seconds": 4.16,
      "text": "Okay, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 399.33,
      "end_seconds": 402.66,
      "duration_seconds": 3.33,
      "text": "Thank you, you know, doctor, goodbye."
    }
  ]
}