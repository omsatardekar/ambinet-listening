{
  "schema_version": "1.0",
  "encounter_id": "01911",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.62,
      "end_seconds": 2.1,
      "duration_seconds": 1.48,
      "text": "good afternoon, doctor"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.18,
      "end_seconds": 7.94,
      "duration_seconds": 3.76,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.08,
      "end_seconds": 14.62,
      "duration_seconds": 5.54,
      "text": "Honestly, it's night sweats, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.99,
      "end_seconds": 19.38,
      "duration_seconds": 3.39,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.25,
      "end_seconds": 26.5,
      "duration_seconds": 3.25,
      "text": "It's been about a month now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.83,
      "end_seconds": 30.64,
      "duration_seconds": 3.81,
      "text": "Right, right. How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.29,
      "end_seconds": 39.22,
      "duration_seconds": 3.93,
      "text": "I'd give it a eight, out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.69,
      "end_seconds": 46.0,
      "duration_seconds": 6.31,
      "text": "I see, go ahead. What about a cough for three weeks, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.75,
      "end_seconds": 52.86,
      "duration_seconds": 4.11,
      "text": "Well, yes, about the same, about a week."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.49,
      "end_seconds": 57.01,
      "duration_seconds": 2.52,
      "text": "how often do you get it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.83,
      "end_seconds": 60.04,
      "duration_seconds": 2.21,
      "text": "It's all the time."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.26,
      "end_seconds": 64.48,
      "duration_seconds": 3.22,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.31,
      "end_seconds": 67.87,
      "duration_seconds": 1.56,
      "text": "Mild, I'd say."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.56,
      "end_seconds": 78.48,
      "duration_seconds": 1.92,
      "text": "Okay, do you smoke?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.61,
      "end_seconds": 83.91,
      "duration_seconds": 4.3,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.31,
      "end_seconds": 87.43,
      "duration_seconds": 2.12,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.31,
      "end_seconds": 93.49,
      "duration_seconds": 4.18,
      "text": "Not much, I mostly stay in these days"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.2,
      "end_seconds": 97.76,
      "duration_seconds": 2.56,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.63,
      "end_seconds": 101.87,
      "duration_seconds": 3.24,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.32,
      "end_seconds": 105.88,
      "duration_seconds": 2.56,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.47,
      "end_seconds": 108.52,
      "duration_seconds": 2.05,
      "text": "no, not at all"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.18,
      "end_seconds": 125.94,
      "duration_seconds": 4.76,
      "text": "so, are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.47,
      "end_seconds": 129.56,
      "duration_seconds": 3.09,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.53,
      "end_seconds": 133.88,
      "duration_seconds": 2.35,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.62,
      "end_seconds": 140.32,
      "duration_seconds": 5.7,
      "text": "It's something called clop... clopidogrel, 75 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.84,
      "end_seconds": 143.86,
      "duration_seconds": 3.02,
      "text": "is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.23,
      "end_seconds": 147.98,
      "duration_seconds": 2.75,
      "text": "Erm, no, it's at home."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.09,
      "end_seconds": 156.41,
      "duration_seconds": 7.32,
      "text": "Anything in your past medical history I should know? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.1,
      "end_seconds": 161.4,
      "duration_seconds": 4.3,
      "text": "I've had heart disease for two years now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.31,
      "end_seconds": 163.22,
      "duration_seconds": 0.91,
      "text": "Any fever?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.12,
      "end_seconds": 166.89,
      "duration_seconds": 2.77,
      "text": "I haven't noticed any fever."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.67,
      "end_seconds": 173.04,
      "duration_seconds": 4.37,
      "text": "And what about HIV, coughing up blood or chest pain?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.98,
      "end_seconds": 177.77,
      "duration_seconds": 2.79,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.05,
      "end_seconds": 181.21,
      "duration_seconds": 3.16,
      "text": "Mm-hmm. Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.9,
      "end_seconds": 184.07,
      "duration_seconds": 2.17,
      "text": "I move fine otherwise"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.26,
      "end_seconds": 201.26,
      "duration_seconds": 3.0,
      "text": "Right, I'll do your observations first."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.22,
      "end_seconds": 210.64,
      "duration_seconds": 2.42,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.67,
      "end_seconds": 231.38,
      "duration_seconds": 7.71,
      "text": "okay: BP is 128 over 74, SpO2 98 percent on room air, pulse is 80 beats a minute"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.3,
      "end_seconds": 234.41,
      "duration_seconds": 2.11,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.22,
      "end_seconds": 238.7,
      "duration_seconds": 3.48,
      "text": "don't worry, we'll discuss it in a second"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.67,
      "end_seconds": 245.64,
      "duration_seconds": 3.97,
      "text": "I'll examine you in a second, make yourself comfortable"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.28,
      "end_seconds": 248.67,
      "duration_seconds": 1.39,
      "text": "look straight ahead"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.61,
      "end_seconds": 271.28,
      "duration_seconds": 4.67,
      "text": "There are some crackles at the top of the right lung."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.91,
      "end_seconds": 288.09,
      "duration_seconds": 14.18,
      "text": "okay, that's enough for me right, here's what I'm thinking the most likely explanation is possible tuberculosis that's my thinking for now, and it may change as we learn more"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.79,
      "end_seconds": 293.14,
      "duration_seconds": 3.35,
      "text": "I mean, is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.05,
      "end_seconds": 322.11,
      "duration_seconds": 28.06,
      "text": "It's reasonable to be concerned, but right now possible tuberculosis is my leading thought, not anything worse. We should do a chest X-ray for prolonged cough. I'd rather check than guess, and this is the quickest way to know more. A blood test is what I'd like next, for TB contact. Wear a mask in public and cover your mouth when you cough until the results are back."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.0,
      "end_seconds": 343.92,
      "duration_seconds": 19.92,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Please don't wait if the symptoms get worse. That's when to be seen urgently. Let's plan a check after the tests. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.5,
      "end_seconds": 348.79,
      "duration_seconds": 3.29,
      "text": "thank you, um, that's helpful"
    }
  ]
}