{
  "schema_version": "1.0",
  "encounter_id": "01544",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.75,
      "end_seconds": 2.85,
      "duration_seconds": 2.1,
      "text": "Afternoon, thanks for coming in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.7,
      "end_seconds": 7.49,
      "duration_seconds": 2.79,
      "text": "Afternoon, is this seat fine?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 9.39,
      "end_seconds": 17.24,
      "duration_seconds": 7.85,
      "text": "Good afternoon, you know, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.34,
      "end_seconds": 20.92,
      "duration_seconds": 1.58,
      "text": "What's been worrying you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.82,
      "end_seconds": 31.8,
      "duration_seconds": 9.98,
      "text": "Well, mainly a cough for three weeks. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.88,
      "end_seconds": 35.63,
      "duration_seconds": 2.75,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.94,
      "end_seconds": 40.08,
      "duration_seconds": 3.14,
      "text": "About three weeks, give or take."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 41.91,
      "end_seconds": 47.2,
      "duration_seconds": 5.29,
      "text": "I, I think it's been nearer a month, actually."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 48.43,
      "end_seconds": 53.16,
      "duration_seconds": 4.73,
      "text": "Okay, so roughly three to four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 54.92,
      "end_seconds": 57.87,
      "duration_seconds": 2.95,
      "text": "So, yes, somewhere around that."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.15,
      "end_seconds": 64.41,
      "duration_seconds": 5.26,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.16,
      "end_seconds": 69.78,
      "duration_seconds": 3.62,
      "text": "I'd say once or twice a day."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.24,
      "end_seconds": 70.99,
      "duration_seconds": 0.75,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 71.67,
      "end_seconds": 78.75,
      "duration_seconds": 7.08,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 78.85,
      "end_seconds": 84.75,
      "duration_seconds": 5.9,
      "text": "Right, tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.41,
      "end_seconds": 89.45,
      "duration_seconds": 3.04,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.13,
      "end_seconds": 94.49,
      "duration_seconds": 3.36,
      "text": "What about night sweats, have you noticed that?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.16,
      "end_seconds": 97.88,
      "duration_seconds": 2.72,
      "text": "Yeah. Two weeks, I'd say."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.38,
      "end_seconds": 99.41,
      "duration_seconds": 1.03,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.18,
      "end_seconds": 103.82,
      "duration_seconds": 2.64,
      "text": "I've also been feeling tired."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.88,
      "end_seconds": 108.65,
      "duration_seconds": 3.77,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.57,
      "end_seconds": 117.69,
      "duration_seconds": 7.12,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.51,
      "end_seconds": 124.34,
      "duration_seconds": 5.83,
      "text": "Right, take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.81,
      "end_seconds": 130.1,
      "duration_seconds": 4.29,
      "text": "Mm, uh, I'd call it mild."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.26,
      "end_seconds": 137.52,
      "duration_seconds": 3.26,
      "text": "Have you noticed HIV or chest pain?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 138.23,
      "end_seconds": 141.32,
      "duration_seconds": 3.09,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.47,
      "end_seconds": 146.6,
      "duration_seconds": 4.13,
      "text": "Have you had any coughing up blood or fever?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.34,
      "end_seconds": 154.01,
      "duration_seconds": 5.67,
      "text": "I haven't had coughing up blood or fever, no."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.37,
      "end_seconds": 158.68,
      "duration_seconds": 3.31,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.45,
      "end_seconds": 163.73,
      "duration_seconds": 4.28,
      "text": "No, you know, nothing with my heart."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.8,
      "end_seconds": 169.7,
      "duration_seconds": 3.9,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 171.77,
      "end_seconds": 182.35,
      "duration_seconds": 10.58,
      "text": "I have about eight cigarettes in a day. Nothing, I'm teetotal. Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.47,
      "end_seconds": 200.6,
      "duration_seconds": 3.13,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 204.02,
      "end_seconds": 211.11,
      "duration_seconds": 7.09,
      "text": "I mean, my mother has an underactive thyroid. My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.15,
      "end_seconds": 215.99,
      "duration_seconds": 2.84,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 217.15,
      "end_seconds": 220.84,
      "duration_seconds": 3.69,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.98,
      "end_seconds": 223.96,
      "duration_seconds": 1.98,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 227.14,
      "end_seconds": 229.97,
      "duration_seconds": 2.83,
      "text": "Asthma, for nearly five years."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.27,
      "end_seconds": 232.2,
      "duration_seconds": 0.93,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 234.3,
      "end_seconds": 238.2,
      "duration_seconds": 3.9,
      "text": "Yes, eczema. Migraines, for nearly five years."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.16,
      "end_seconds": 248.62,
      "duration_seconds": 8.46,
      "text": "Right, so eczema is already on your record. We'll keep that in mind today. Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 249.12,
      "end_seconds": 253.58,
      "duration_seconds": 4.46,
      "text": "Ah, I'm on Asthalin inhaler, when needed."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.32,
      "end_seconds": 257.17,
      "duration_seconds": 1.85,
      "text": "And for how long?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 258.8,
      "end_seconds": 271.49,
      "duration_seconds": 12.69,
      "text": "For two months. Right, I'm on hydrocortisone cream, when needed for the eczema. I was on Seretide inhaler before. I stopped taking it."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 279.82,
      "end_seconds": 284.57,
      "duration_seconds": 4.75,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 285.3,
      "end_seconds": 289.42,
      "duration_seconds": 4.12,
      "text": "Yes, tramadol, it gives me feeling very drowsy."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 290.37,
      "end_seconds": 300.74,
      "duration_seconds": 10.37,
      "text": "Doctor, I've got the readings for you. Oxygen saturation is 99 percent, blood pressure 110 over 72, temperature 36.8. Heart rate 64."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.79,
      "end_seconds": 306.33,
      "duration_seconds": 1.54,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 308.7,
      "end_seconds": 312.91,
      "duration_seconds": 4.21,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 314.09,
      "end_seconds": 315.79,
      "duration_seconds": 1.7,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 316.7,
      "end_seconds": 317.91,
      "duration_seconds": 1.21,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 333.66,
      "end_seconds": 338.66,
      "duration_seconds": 5.0,
      "text": "There are some crackles at the top of the right lung."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 342.58,
      "end_seconds": 364.67,
      "duration_seconds": 22.09,
      "text": "That's all I needed to check. Right, here's what I'm thinking. I don't have a clear answer today: possible tuberculosis is possible, and so is a lung tumour. I can't rule out a chest infection yet. A blood test is what I'd like next, for TB contact."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 369.53,
      "end_seconds": 374.05,
      "duration_seconds": 4.52,
      "text": "I can book that for Wednesday at 3:30 pm."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 375.15,
      "end_seconds": 377.48,
      "duration_seconds": 2.33,
      "text": "Okay, I'll be there."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 382.27,
      "end_seconds": 408.95,
      "duration_seconds": 26.68,
      "text": "Three sputum samples is what I'd like next, for possible tuberculosis. Wear a mask in public and cover your mouth when you cough until the results are back. If the symptoms get worse, that's the point to come in urgently. See me again after the tests. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 410.72,
      "end_seconds": 413.9,
      "duration_seconds": 3.18,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}