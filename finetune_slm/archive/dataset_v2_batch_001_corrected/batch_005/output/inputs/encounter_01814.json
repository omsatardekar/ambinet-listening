{
  "schema_version": "1.0",
  "encounter_id": "01814",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.83,
      "end_seconds": 6.84,
      "duration_seconds": 6.01,
      "text": "Let me think, hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.55,
      "end_seconds": 12.92,
      "duration_seconds": 4.37,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.54,
      "end_seconds": 18.09,
      "duration_seconds": 3.55,
      "text": "Well, I've been having smaller handwriting."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.05,
      "end_seconds": 20.72,
      "duration_seconds": 1.67,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.55,
      "end_seconds": 31.64,
      "duration_seconds": 9.09,
      "text": "Hmm, you know, probably six months. Yeah. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.45,
      "end_seconds": 37.25,
      "duration_seconds": 3.8,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.23,
      "end_seconds": 40.89,
      "duration_seconds": 1.66,
      "text": "It's mild, honestly."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.65,
      "end_seconds": 49.12,
      "duration_seconds": 6.47,
      "text": "What about a tremor in your right hand at rest, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.95,
      "end_seconds": 51.53,
      "duration_seconds": 1.58,
      "text": "Yeah, that too."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.45,
      "end_seconds": 70.97,
      "duration_seconds": 3.52,
      "text": "Right, has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.14,
      "end_seconds": 80.61,
      "duration_seconds": 8.47,
      "text": "Yes, heart failure. Right, I've had arthritis in my knees for nearly five years now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.68,
      "end_seconds": 92.59,
      "duration_seconds": 9.91,
      "text": "Right, so heart failure is already on your record. We'll keep that in mind today. Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.89,
      "end_seconds": 99.84,
      "duration_seconds": 3.95,
      "text": "Hmm, um, my cousin has psoriasis."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.77,
      "end_seconds": 104.13,
      "duration_seconds": 2.36,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.4,
      "end_seconds": 111.75,
      "duration_seconds": 6.35,
      "text": "Sorry, what was I saying, nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.7,
      "end_seconds": 119.02,
      "duration_seconds": 3.32,
      "text": "Okay, what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.03,
      "end_seconds": 128.71,
      "duration_seconds": 8.68,
      "text": "I'm on metoprolol, 50 milligrams, twice a day. It's diclofenac, 50 milligrams, when needed."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.27,
      "end_seconds": 145.29,
      "duration_seconds": 5.02,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.15,
      "end_seconds": 150.24,
      "duration_seconds": 4.09,
      "text": "Um, I've never had an allergy."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.44,
      "end_seconds": 154.2,
      "duration_seconds": 2.76,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.17,
      "end_seconds": 158.54,
      "duration_seconds": 3.37,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.11,
      "end_seconds": 160.42,
      "duration_seconds": 1.31,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.98,
      "end_seconds": 165.5,
      "duration_seconds": 3.52,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.57,
      "end_seconds": 169.89,
      "duration_seconds": 3.32,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.69,
      "end_seconds": 175.8,
      "duration_seconds": 5.11,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.46,
      "end_seconds": 190.6,
      "duration_seconds": 4.14,
      "text": "Did you get memory problems or loss of smell?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.59,
      "end_seconds": 196.76,
      "duration_seconds": 4.17,
      "text": "No, you know, none of those at all."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.21,
      "end_seconds": 200.91,
      "duration_seconds": 2.7,
      "text": "Any constipation or falls at all?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.35,
      "end_seconds": 212.29,
      "duration_seconds": 5.94,
      "text": "So, uh, no constipation or falls, none of it."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.16,
      "end_seconds": 216.77,
      "duration_seconds": 2.61,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.61,
      "end_seconds": 218.67,
      "duration_seconds": 1.06,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 219.61,
      "end_seconds": 230.5,
      "duration_seconds": 10.89,
      "text": "Doctor, I've got the readings for you. Heart rate 66, saturation 97 percent, blood pressure 113 over 75, temperature is 36.8 degrees."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.26,
      "end_seconds": 232.96,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.23,
      "end_seconds": 238.61,
      "duration_seconds": 4.38,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.65,
      "end_seconds": 241.61,
      "duration_seconds": 1.96,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.95,
      "end_seconds": 260.53,
      "duration_seconds": 8.58,
      "text": "There is a pill-rolling tremor at rest on the right and the arm is stiff with a cogwheel feel."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.96,
      "end_seconds": 275.56,
      "duration_seconds": 11.6,
      "text": "Okay, you can sit up now. Let me tell you where I've got to. It points towards possible Parkinson's disease. We shouldn't forget an essential tremor."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.25,
      "end_seconds": 280.37,
      "duration_seconds": 3.12,
      "text": "Erm, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.52,
      "end_seconds": 300.74,
      "duration_seconds": 19.22,
      "text": "Nothing I've seen today points to an emergency. It looks like possible Parkinson's disease, but I'd like to confirm. I'd like to arrange a blood test for tremor. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.07,
      "end_seconds": 304.98,
      "duration_seconds": 2.91,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.6,
      "end_seconds": 317.33,
      "duration_seconds": 10.73,
      "text": "I'm referring you to the specialist and meanwhile keep active. Let's get you seen by the movement disorders clinic, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.68,
      "end_seconds": 320.26,
      "duration_seconds": 1.58,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.18,
      "end_seconds": 328.51,
      "duration_seconds": 6.33,
      "text": "Come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.25,
      "end_seconds": 335.29,
      "duration_seconds": 5.04,
      "text": "Mm, you know, okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.2,
      "end_seconds": 339.42,
      "duration_seconds": 3.22,
      "text": "Please come and see me after the specialist."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.69,
      "end_seconds": 342.87,
      "duration_seconds": 2.18,
      "text": "Alright, I'll be back."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.59,
      "end_seconds": 348.35,
      "duration_seconds": 3.76,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.43,
      "end_seconds": 352.62,
      "duration_seconds": 2.19,
      "text": "Thank you, that's helpful."
    }
  ]
}