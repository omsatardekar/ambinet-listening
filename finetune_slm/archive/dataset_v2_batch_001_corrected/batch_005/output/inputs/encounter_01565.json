{
  "schema_version": "1.0",
  "encounter_id": "01565",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.24,
      "end_seconds": 5.71,
      "duration_seconds": 4.47,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.35,
      "end_seconds": 10.98,
      "duration_seconds": 4.63,
      "text": "So, that's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.73,
      "end_seconds": 22.08,
      "duration_seconds": 10.35,
      "text": "It's tired muscles. I thought I'd wait, but it hasn't gone. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.63,
      "end_seconds": 25.16,
      "duration_seconds": 2.53,
      "text": "Alright, when did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.12,
      "end_seconds": 35.87,
      "duration_seconds": 4.75,
      "text": "It's, It's been one week, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.85,
      "end_seconds": 40.98,
      "duration_seconds": 3.13,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.54,
      "end_seconds": 61.5,
      "duration_seconds": 19.96,
      "text": "Ah, it feels mild to me. Oh, and a mild ache in my legs. That's been about the same, four weeks. As for mild ache in my legs, it's every other day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.4,
      "end_seconds": 68.95,
      "duration_seconds": 5.55,
      "text": "Have you had tired muscles before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.38,
      "end_seconds": 79.81,
      "duration_seconds": 6.43,
      "text": "A bit, a couple of years ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.85,
      "end_seconds": 100.75,
      "duration_seconds": 3.9,
      "text": "So, do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.0,
      "end_seconds": 110.82,
      "duration_seconds": 4.82,
      "text": "Sitagliptin. I take it 100 milligrams, once a day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.22,
      "end_seconds": 130.5,
      "duration_seconds": 4.28,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.42,
      "end_seconds": 146.03,
      "duration_seconds": 14.61,
      "text": "Nothing, I'm teetotal. I quit smoking around ten years ago. I retired from the post office two years ago. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.61,
      "end_seconds": 150.4,
      "duration_seconds": 2.79,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.33,
      "end_seconds": 164.66,
      "duration_seconds": 11.33,
      "text": "Oh, you know, I've had diabetes for two years now. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.7,
      "end_seconds": 168.43,
      "duration_seconds": 2.73,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.41,
      "end_seconds": 172.38,
      "duration_seconds": 2.97,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.1,
      "end_seconds": 178.16,
      "duration_seconds": 4.06,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.82,
      "end_seconds": 181.45,
      "duration_seconds": 2.63,
      "text": "Yes, walnuts. I get hives."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.32,
      "end_seconds": 185.2,
      "duration_seconds": 2.88,
      "text": "A few quick ones: fractures or weakness?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.12,
      "end_seconds": 189.85,
      "duration_seconds": 2.73,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.39,
      "end_seconds": 194.37,
      "duration_seconds": 3.98,
      "text": "Okay, go on. Any weight loss or bone pain?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.06,
      "end_seconds": 200.29,
      "duration_seconds": 4.23,
      "text": "Yeah, no, I haven't had any of them."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.26,
      "end_seconds": 209.31,
      "duration_seconds": 3.05,
      "text": "Right, and your skin, any changes there?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.2,
      "end_seconds": 214.19,
      "duration_seconds": 2.99,
      "text": "Yeah, no, skin's been fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.49,
      "end_seconds": 234.0,
      "duration_seconds": 2.51,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.22,
      "end_seconds": 243.09,
      "duration_seconds": 2.87,
      "text": "Alright, sit still for a moment..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.11,
      "end_seconds": 266.71,
      "duration_seconds": 9.6,
      "text": "Okay: pulse is 68 beats a minute, temp 36.7 degrees, oxygen saturation is 98 percent, blood pressure 114 over 72."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.19,
      "end_seconds": 273.04,
      "duration_seconds": 3.85,
      "text": "Okay, could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.95,
      "end_seconds": 275.65,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.7,
      "end_seconds": 277.96,
      "duration_seconds": 1.26,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.0,
      "end_seconds": 295.75,
      "duration_seconds": 4.75,
      "text": "Your muscle strength is normal and there is no bone tenderness."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.09,
      "end_seconds": 314.58,
      "duration_seconds": 13.49,
      "text": "Please sit back down. Taking everything into account, this is probably low vitamin D without complications. I'm prescribing colecalciferol, 1000 units, once a day, three months. That should help with low vitamin D."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.19,
      "end_seconds": 322.53,
      "duration_seconds": 6.34,
      "text": "Do I need a vitamin D level? I read it might help."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.4,
      "end_seconds": 331.35,
      "duration_seconds": 7.95,
      "text": "Not at this point, no. It isn't indicated yet. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.33,
      "end_seconds": 335.8,
      "duration_seconds": 3.47,
      "text": "I think I understand everything. Thanks."
    }
  ]
}