  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.86,
      "end_seconds": 6.81,
      "duration_seconds": 5.95,
      "text": "Right then, come on in. Is this your first time with this clinic?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.22,
      "end_seconds": 14.99,
      "duration_seconds": 5.77,
      "text": "Mm, first time with this one, yes. A friend recommended it."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.32,
      "end_seconds": 19.22,
      "duration_seconds": 2.9,
      "text": "Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 20.94,
      "end_seconds": 26.65,
      "duration_seconds": 5.71,
      "text": "well, I've been having a tingling lip then a blister"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.61,
      "end_seconds": 30.19,
      "duration_seconds": 2.58,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.22,
      "end_seconds": 36.73,
      "duration_seconds": 4.51,
      "text": "No, uh, I don't take any tablets."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.38,
      "end_seconds": 39.45,
      "duration_seconds": 2.07,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 41.12,
      "end_seconds": 44.0,
      "duration_seconds": 2.88,
      "text": "For about three months, I'd say."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.28,
      "end_seconds": 47.92,
      "duration_seconds": 2.64,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.28,
      "end_seconds": 59.06,
      "duration_seconds": 9.78,
      "text": "it's a few times a day. Oh, and a mild sore feeling. That's been about the same, four weeks"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.5,
      "end_seconds": 60.52,
      "duration_seconds": 1.02,
      "text": "right, right"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.58,
      "end_seconds": 77.24,
      "duration_seconds": 5.66,
      "text": "Right, have you noticed eye pain, sores in the mouth or rash elsewhere?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.11,
      "end_seconds": 85.1,
      "duration_seconds": 2.99,
      "text": "No, nothing to to report there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.69,
      "end_seconds": 89.14,
      "duration_seconds": 3.45,
      "text": "hm, okay did you notice any fever?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.02,
      "end_seconds": 93.51,
      "duration_seconds": 2.49,
      "text": "Not at all, no fever."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.45,
      "end_seconds": 98.9,
      "duration_seconds": 3.45,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.02,
      "end_seconds": 101.67,
      "duration_seconds": 1.65,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.04,
      "end_seconds": 105.94,
      "duration_seconds": 2.9,
      "text": "Right, have you got any known allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.37,
      "end_seconds": 110.53,
      "duration_seconds": 3.16,
      "text": "no, I'm not allergic to anything"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.16,
      "end_seconds": 130.46,
      "duration_seconds": 1.3,
      "text": "any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.38,
      "end_seconds": 134.17,
      "duration_seconds": 2.79,
      "text": "Oh, no, not at all."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.24,
      "end_seconds": 137.32,
      "duration_seconds": 2.08,
      "text": "do you do any exercise?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 138.41,
      "end_seconds": 141.04,
      "duration_seconds": 2.63,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.03,
      "end_seconds": 143.28,
      "duration_seconds": 1.25,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.48,
      "end_seconds": 150.96,
      "duration_seconds": 4.48,
      "text": "I'm a plumber, lots of bending and kneeling"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.48,
      "end_seconds": 156.52,
      "duration_seconds": 4.04,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.29,
      "end_seconds": 160.07,
      "duration_seconds": 1.78,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.82,
      "end_seconds": 165.58,
      "duration_seconds": 4.76,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 171.23,
      "end_seconds": 173.8,
      "duration_seconds": 2.57,
      "text": "my mother had a stroke"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.11,
      "end_seconds": 180.95,
      "duration_seconds": 2.84,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.94,
      "end_seconds": 193.74,
      "duration_seconds": 2.8,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.48,
      "end_seconds": 225.26,
      "duration_seconds": 9.78,
      "text": "okay: pulse 80, respiratory rate 15. And temperature 36.7, SpO2 97 percent on room air, BP is 109 over 70."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.89,
      "end_seconds": 245.38,
      "duration_seconds": 12.49,
      "text": "Going by what you've described, it fits best with a cold sore. The reason I say that is that the way you describe it fits together."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 246.73,
      "end_seconds": 250.24,
      "duration_seconds": 3.51,
      "text": "What are the the odds it's serious?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.83,
      "end_seconds": 259.58,
      "duration_seconds": 7.75,
      "text": "I understand the worry. At the moment I'd say it's a cold sore, and we'll watch how it goes."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.08,
      "end_seconds": 299.46,
      "duration_seconds": 31.38,
      "text": "let's use aciclovir cream, 5%, five times a day, five days. It's for cold sore. The pharmacy will go through the details again when you pick it up. Avoid kissing and sharing towels until it has crusted over. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. Come back if not healed in ten days. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 302.81,
      "end_seconds": 306.69,
      "duration_seconds": 3.88,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}