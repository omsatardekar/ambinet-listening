{
  "schema_version": "1.0",
  "encounter_id": "01786",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.62,
      "end_seconds": 4.58,
      "duration_seconds": 3.96,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.74,
      "end_seconds": 11.29,
      "duration_seconds": 5.55,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.29,
      "end_seconds": 16.46,
      "duration_seconds": 3.17,
      "text": "It's being confused and drowsy, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.73,
      "end_seconds": 19.92,
      "duration_seconds": 2.19,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.61,
      "end_seconds": 34.38,
      "duration_seconds": 2.77,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.64,
      "end_seconds": 68.84,
      "duration_seconds": 17.2,
      "text": "Okay: blood pressure 136 over 86, height 154 centimetres, BMI works out to 31.2, respiratory rate 16, weight 74 kilos, saturation 98 percent, pulse is 108 beats a minute, temp 36.8 degrees. Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.84,
      "end_seconds": 73.79,
      "duration_seconds": 2.95,
      "text": "For one week, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.76,
      "end_seconds": 78.79,
      "duration_seconds": 3.03,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.23,
      "end_seconds": 89.18,
      "duration_seconds": 8.95,
      "text": "Mm, it feels moderate to me. I've been passing huge amounts of urine too, for five days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.88,
      "end_seconds": 94.38,
      "duration_seconds": 3.5,
      "text": "Have you noticed vomiting, chest pain or fever?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.04,
      "end_seconds": 99.3,
      "duration_seconds": 4.26,
      "text": "No vomiting, chest pain or fever, none of it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.31,
      "end_seconds": 104.24,
      "duration_seconds": 2.93,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.71,
      "end_seconds": 108.66,
      "duration_seconds": 1.95,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.88,
      "end_seconds": 113.9,
      "duration_seconds": 2.02,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.44,
      "end_seconds": 119.23,
      "duration_seconds": 3.79,
      "text": "I've had diabetes for nearly five years now."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.16,
      "end_seconds": 120.86,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.39,
      "end_seconds": 128.22,
      "duration_seconds": 6.83,
      "text": "I have an irregular heartbeat. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.23,
      "end_seconds": 139.24,
      "duration_seconds": 6.01,
      "text": "Hm, okay. Okay, I can see diabetes in your file as well."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.88,
      "end_seconds": 159.26,
      "duration_seconds": 2.38,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.0,
      "end_seconds": 169.96,
      "duration_seconds": 9.96,
      "text": "I'm on Glycomet, 500 milligrams, twice a day. Warfarin. I take it 3 milligrams, in the evening."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.09,
      "end_seconds": 174.48,
      "duration_seconds": 3.39,
      "text": "Alright, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.99,
      "end_seconds": 178.02,
      "duration_seconds": 2.03,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.04,
      "end_seconds": 182.61,
      "duration_seconds": 3.57,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.55,
      "end_seconds": 190.41,
      "duration_seconds": 1.86,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.72,
      "end_seconds": 210.44,
      "duration_seconds": 5.72,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.21,
      "end_seconds": 225.77,
      "duration_seconds": 14.56,
      "text": "I only drink at family occasions. My husband and I live above the shop. Not much, I mostly stay in these days. I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.61,
      "end_seconds": 230.98,
      "duration_seconds": 2.37,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.54,
      "end_seconds": 233.45,
      "duration_seconds": 0.91,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.24,
      "end_seconds": 238.24,
      "duration_seconds": 3.0,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.78,
      "end_seconds": 258.22,
      "duration_seconds": 7.44,
      "text": "You are very dry and drowsy, and your sugar reading is too high to read."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.47,
      "end_seconds": 264.85,
      "duration_seconds": 2.38,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.66,
      "end_seconds": 291.2,
      "duration_seconds": 9.54,
      "text": "Let me tell you where I've got to. I can't pin this down yet. We're looking at a hyperosmolar diabetic emergency or sepsis."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.84,
      "end_seconds": 296.56,
      "duration_seconds": 3.72,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.36,
      "end_seconds": 309.69,
      "duration_seconds": 11.33,
      "text": "I understand the worry. At the moment I'd say it's a hyperosmolar diabetic emergency, and we'll know more once the urgent blood tests is back."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.86,
      "end_seconds": 337.59,
      "duration_seconds": 17.73,
      "text": "I'm sending you for urgent blood tests because of hyperglycaemic emergency. You need hospital now for fluids and insulin. We'll refer you to the emergency team. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.58,
      "end_seconds": 340.15,
      "duration_seconds": 1.57,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.94,
      "end_seconds": 345.73,
      "duration_seconds": 3.79,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.81,
      "end_seconds": 350.92,
      "duration_seconds": 3.11,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.2,
      "end_seconds": 354.29,
      "duration_seconds": 2.09,
      "text": "Right, see you soon."
    }
  ]
}