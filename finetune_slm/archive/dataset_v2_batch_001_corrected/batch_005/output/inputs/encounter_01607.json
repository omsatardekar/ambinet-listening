{
  "schema_version": "1.0",
  "encounter_id": "01607",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.4,
      "end_seconds": 7.13,
      "duration_seconds": 5.73,
      "text": "I mean, you know, sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.24,
      "end_seconds": 11.9,
      "duration_seconds": 3.66,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.65,
      "end_seconds": 19.66,
      "duration_seconds": 6.01,
      "text": "Good morning, uh, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.72,
      "end_seconds": 26.06,
      "duration_seconds": 5.34,
      "text": "I'm here because of red sore skin on my shoulders."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.87,
      "end_seconds": 29.71,
      "duration_seconds": 2.84,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.62,
      "end_seconds": 58.48,
      "duration_seconds": 27.86,
      "text": "Ever since... since yesterday, really. I've been reading about it online and it worried me. And a little peeling, too. Oh, uh, and tightness of the skin. That's been about the same, about a month. Hmm, with tightness of the skin, mostly severe. I'd say on and off."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.91,
      "end_seconds": 67.48,
      "duration_seconds": 7.57,
      "text": "Have you had red sore skin on your shoulders before, or is this the first time?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.51,
      "end_seconds": 77.49,
      "duration_seconds": 7.98,
      "text": "Yeah, yes, something like this happened last year, and it went away on its own."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.3,
      "end_seconds": 82.08,
      "duration_seconds": 3.78,
      "text": "Have you had any vomiting, fever, headache or blisters?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.66,
      "end_seconds": 87.77,
      "duration_seconds": 5.11,
      "text": "I haven't had vomiting, fever, headache or blisters, no."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.41,
      "end_seconds": 93.77,
      "duration_seconds": 4.36,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.57,
      "end_seconds": 97.92,
      "duration_seconds": 2.35,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.13,
      "end_seconds": 117.39,
      "duration_seconds": 1.26,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.07,
      "end_seconds": 123.49,
      "duration_seconds": 4.42,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.15,
      "end_seconds": 126.16,
      "duration_seconds": 2.01,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.95,
      "end_seconds": 129.85,
      "duration_seconds": 1.9,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.21,
      "end_seconds": 134.19,
      "duration_seconds": 2.98,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.5,
      "end_seconds": 139.15,
      "duration_seconds": 3.65,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.22,
      "end_seconds": 142.92,
      "duration_seconds": 2.7,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.82,
      "end_seconds": 148.75,
      "duration_seconds": 3.93,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.97,
      "end_seconds": 151.98,
      "duration_seconds": 2.01,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.96,
      "end_seconds": 158.02,
      "duration_seconds": 4.06,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.25,
      "end_seconds": 162.03,
      "duration_seconds": 2.78,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.96,
      "end_seconds": 165.58,
      "duration_seconds": 1.62,
      "text": "I have epilepsy."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.74,
      "end_seconds": 167.44,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.18,
      "end_seconds": 186.09,
      "duration_seconds": 3.91,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.12,
      "end_seconds": 192.66,
      "duration_seconds": 4.54,
      "text": "Ah, no, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.73,
      "end_seconds": 195.85,
      "duration_seconds": 2.12,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.74,
      "end_seconds": 202.3,
      "duration_seconds": 5.56,
      "text": "I mean, I'm on levetiracetam, 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.98,
      "end_seconds": 217.32,
      "duration_seconds": 2.34,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.61,
      "end_seconds": 228.51,
      "duration_seconds": 2.9,
      "text": "Right, nearly done with the readings..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.21,
      "end_seconds": 257.8,
      "duration_seconds": 13.59,
      "text": "Okay: weight 76 kilos, temperature 36.8, pressure 116 over 79, height 182 centimetres, pulse is 84 beats a minute, SpO2 97 percent on room air, respiratory rate 15."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.11,
      "end_seconds": 263.53,
      "duration_seconds": 3.42,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.45,
      "end_seconds": 267.58,
      "duration_seconds": 2.13,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.16,
      "end_seconds": 280.18,
      "duration_seconds": 4.02,
      "text": "The skin is pink and tender with no blistering."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.35,
      "end_seconds": 292.99,
      "duration_seconds": 7.64,
      "text": "Please sit back down. Let me tell you where I've got to. The most likely explanation is mild sunburn."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.96,
      "end_seconds": 296.8,
      "duration_seconds": 2.84,
      "text": "Ah, will it clear up?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.42,
      "end_seconds": 325.59,
      "duration_seconds": 27.17,
      "text": "Nothing I've seen today points to an emergency. It looks like mild sunburn. Cool compresses, moisturiser and stay out of the sun for a few days. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency. Please come and see me if blisters develop. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.59,
      "end_seconds": 328.93,
      "duration_seconds": 2.34,
      "text": "Alright, thanks, take care."
    }
  ]
}