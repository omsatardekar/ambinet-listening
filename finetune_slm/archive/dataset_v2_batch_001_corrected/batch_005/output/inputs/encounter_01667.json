{
  "schema_version": "1.0",
  "encounter_id": "01667",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.93,
      "end_seconds": 6.93,
      "duration_seconds": 6.0,
      "text": "Hi, you know, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.21,
      "end_seconds": 12.88,
      "duration_seconds": 4.67,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.78,
      "end_seconds": 19.66,
      "duration_seconds": 4.88,
      "text": "Hmm, good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.71,
      "end_seconds": 28.44,
      "duration_seconds": 3.73,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 29.33,
      "end_seconds": 33.37,
      "duration_seconds": 4.04,
      "text": "He's been having been feeling low most days, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.81,
      "end_seconds": 37.05,
      "duration_seconds": 3.24,
      "text": "Right, right. Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.57,
      "end_seconds": 40.61,
      "duration_seconds": 3.04,
      "text": "It usually comes with no energy."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.46,
      "end_seconds": 48.16,
      "duration_seconds": 6.7,
      "text": "Did you get drinking more, panic attacks, hearing voices or thoughts of harming myself?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.37,
      "end_seconds": 51.63,
      "duration_seconds": 2.26,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.16,
      "end_seconds": 56.33,
      "duration_seconds": 4.17,
      "text": "Right, on the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.02,
      "end_seconds": 67.49,
      "duration_seconds": 5.47,
      "text": "My heart's been fine, you know, as far as I know."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.51,
      "end_seconds": 74.56,
      "duration_seconds": 5.05,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 75.16,
      "end_seconds": 84.27,
      "duration_seconds": 9.11,
      "text": "Let me think, he is on escitalopram, 10 milligrams, once a day for the anxiety, I give it to him."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.22,
      "end_seconds": 87.65,
      "duration_seconds": 2.43,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.81,
      "end_seconds": 95.7,
      "duration_seconds": 6.89,
      "text": "Actually, uh, I have anxiety. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.38,
      "end_seconds": 101.31,
      "duration_seconds": 3.93,
      "text": "Alright, anxiety, that matches what I have here."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.18,
      "end_seconds": 116.55,
      "duration_seconds": 1.37,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.49,
      "end_seconds": 121.93,
      "duration_seconds": 4.44,
      "text": "Nothing, um, I haven't had any operations."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.61,
      "end_seconds": 127.02,
      "duration_seconds": 3.41,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.54,
      "end_seconds": 132.62,
      "duration_seconds": 5.08,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.97,
      "end_seconds": 135.95,
      "duration_seconds": 1.98,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.71,
      "end_seconds": 140.88,
      "duration_seconds": 4.17,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.2,
      "end_seconds": 144.15,
      "duration_seconds": 1.95,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.22,
      "end_seconds": 150.57,
      "duration_seconds": 4.35,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.52,
      "end_seconds": 162.7,
      "duration_seconds": 4.18,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.88,
      "end_seconds": 170.42,
      "duration_seconds": 6.54,
      "text": "Not currently, you know, but as a youngster tramadol gave me vomiting."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.0,
      "end_seconds": 175.34,
      "duration_seconds": 3.34,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.23,
      "end_seconds": 186.01,
      "duration_seconds": 2.78,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.72,
      "end_seconds": 208.52,
      "duration_seconds": 9.8,
      "text": "Okay: heart rate 79, SpO2 98 percent on room air, respiratory rate 16. And BP is 120 over 69, temperature 36.4."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.24,
      "end_seconds": 213.39,
      "duration_seconds": 2.15,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.09,
      "end_seconds": 216.13,
      "duration_seconds": 1.04,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.72,
      "end_seconds": 219.18,
      "duration_seconds": 1.46,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.02,
      "end_seconds": 240.07,
      "duration_seconds": 5.05,
      "text": "You are tearful and speaking slowly, but you are following everything well."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.18,
      "end_seconds": 241.88,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.14,
      "end_seconds": 265.32,
      "duration_seconds": 18.18,
      "text": "That's all I needed to check. So, based on the history and the examination, it points towards a moderate depressive episode. That's my thinking for now, and it may change as we learn more. We shouldn't forget an underactive thyroid."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.2,
      "end_seconds": 269.0,
      "duration_seconds": 1.8,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.89,
      "end_seconds": 280.86,
      "duration_seconds": 10.97,
      "text": "I understand the worry. At the moment I'd say it's a moderate depressive episode, and we'll know more once the a thyroid test is back."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.17,
      "end_seconds": 325.28,
      "duration_seconds": 34.11,
      "text": "Let's book a thyroid test to look into low mood. Let's book a blood count to look into tiredness. Try a short walk each day and keep a regular sleep routine. A short walk every day, even twenty minutes, will help more than you'd think. I'll also refer you to the talking therapy service. Do get help quickly if you have thoughts of harming yourself. Let's plan a check in two weeks. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.03,
      "end_seconds": 329.39,
      "duration_seconds": 2.36,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.38,
      "end_seconds": 333.46,
      "duration_seconds": 2.08,
      "text": "Okay, all the best."
    }
  ]
}