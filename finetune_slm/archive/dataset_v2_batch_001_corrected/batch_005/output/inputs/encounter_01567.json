{
  "schema_version": "1.0",
  "encounter_id": "01567",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.99,
      "end_seconds": 5.35,
      "duration_seconds": 4.36,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.65,
      "end_seconds": 11.17,
      "duration_seconds": 4.52,
      "text": "no problem at all, come in what's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.65,
      "end_seconds": 14.64,
      "duration_seconds": 1.99,
      "text": "I've been feeling sick."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.35,
      "end_seconds": 24.31,
      "duration_seconds": 7.96,
      "text": "Right, how many days or weeks has it been? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.93,
      "end_seconds": 37.08,
      "duration_seconds": 12.15,
      "text": "honestly I can't say exactly when it started it might have been last month or the month before, I really can't pin it down"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.77,
      "end_seconds": 40.67,
      "duration_seconds": 2.9,
      "text": "how much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.76,
      "end_seconds": 43.67,
      "duration_seconds": 1.91,
      "text": "I'd call it severe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.29,
      "end_seconds": 51.43,
      "duration_seconds": 2.14,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.91,
      "end_seconds": 77.94,
      "duration_seconds": 25.03,
      "text": "Sorry, what was I saying, when it starts I tend to get bloating as well. As for bloating, I'd say moderate. And pain going to my right shoulder as well, since Monday. As for pain going to my right shoulder, I'd say all the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.45,
      "end_seconds": 82.3,
      "duration_seconds": 2.85,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.22,
      "end_seconds": 98.25,
      "duration_seconds": 3.03,
      "text": "that's it, just a a little longer.."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.18,
      "end_seconds": 124.93,
      "duration_seconds": 10.75,
      "text": "Okay: heart rate 66, SpO2 99 percent on room air. And temperature is 36.5 degrees, height 155 centimetres, weight 97 kilos, pressure 123 over 79."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.95,
      "end_seconds": 127.34,
      "duration_seconds": 1.39,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.27,
      "end_seconds": 130.28,
      "duration_seconds": 2.01,
      "text": "we'll go over that shortly"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.05,
      "end_seconds": 134.04,
      "duration_seconds": 1.99,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.2,
      "end_seconds": 137.16,
      "duration_seconds": 1.96,
      "text": "let me feel here"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.37,
      "end_seconds": 150.26,
      "duration_seconds": 5.89,
      "text": "It is tender under the right ribs and you stop breathing in when I press."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.36,
      "end_seconds": 156.16,
      "duration_seconds": 2.8,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.12,
      "end_seconds": 176.31,
      "duration_seconds": 6.19,
      "text": "let me check a few things any fever, yellow eyes or dark urine?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.7,
      "end_seconds": 180.38,
      "duration_seconds": 2.68,
      "text": "no, not a single one"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.21,
      "end_seconds": 184.09,
      "duration_seconds": 2.88,
      "text": "Have you had any pale stools?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.64,
      "end_seconds": 186.58,
      "duration_seconds": 1.94,
      "text": "No. No pale stools."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.45,
      "end_seconds": 189.82,
      "duration_seconds": 2.37,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.65,
      "end_seconds": 196.65,
      "duration_seconds": 1.0,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.81,
      "end_seconds": 200.62,
      "duration_seconds": 2.81,
      "text": "Okay, tell me your medicines, please."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.36,
      "end_seconds": 211.27,
      "duration_seconds": 8.91,
      "text": "It's allopurinol, 100 milligrams, once a day. I'm on Seretide inhaler, twice a day for my asthma."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.81,
      "end_seconds": 215.81,
      "duration_seconds": 3.0,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.9,
      "end_seconds": 231.88,
      "duration_seconds": 14.98,
      "text": "For two months. Diclofenac. I take it 50 milligrams, when needed. I'm not great at remembering details, so bear with me. Um, I'm on an antacid, 10 ml, maybe, when needed."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.16,
      "end_seconds": 239.34,
      "duration_seconds": 4.18,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.31,
      "end_seconds": 249.49,
      "duration_seconds": 8.18,
      "text": "Not with me. I'll bring it next time. I used to to take paracetamol, but I stopped it."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.0,
      "end_seconds": 254.85,
      "duration_seconds": 3.85,
      "text": "what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.46,
      "end_seconds": 258.25,
      "duration_seconds": 2.79,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.15,
      "end_seconds": 261.31,
      "duration_seconds": 2.16,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.02,
      "end_seconds": 266.16,
      "duration_seconds": 4.14,
      "text": "Just keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.05,
      "end_seconds": 283.24,
      "duration_seconds": 5.19,
      "text": "So, what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.1,
      "end_seconds": 287.85,
      "duration_seconds": 2.75,
      "text": "Gout, for about a year."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.36,
      "end_seconds": 289.69,
      "duration_seconds": 1.33,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.36,
      "end_seconds": 302.8,
      "duration_seconds": 11.44,
      "text": "I've had asthma for two years now. I have arthritis in my knees. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.04,
      "end_seconds": 316.25,
      "duration_seconds": 12.21,
      "text": "I see, go ahead. Okay, I can see asthma in your file as well. Let's talk a little about your daily life and and habits."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.63,
      "end_seconds": 332.91,
      "duration_seconds": 15.28,
      "text": "I gave up cigarettes last spring. I drink a lot of tea and snack through the day. I walk the dog every morning. My partner and our baby"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.5,
      "end_seconds": 341.04,
      "duration_seconds": 6.54,
      "text": "Taking everything into account, I think we're dealing with gallstone-related pain at this stage."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.11,
      "end_seconds": 348.15,
      "duration_seconds": 2.04,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.52,
      "end_seconds": 381.73,
      "duration_seconds": 32.21,
      "text": "It's reasonable to be concerned, but right now gallstone-related pain is my leading thought, not anything worse. Let's book liver blood tests to look into biliary pain. Let's get an ultrasound of the abdomen, for biliary pain. That will help us see what's going on underneath and decide the next step. Avoid fatty and fried foods until the scan. The surgical clinic would be the right next step, I'll refer you."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 383.56,
      "end_seconds": 399.38,
      "duration_seconds": 15.82,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Come back after the scan. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 400.77,
      "end_seconds": 404.21,
      "duration_seconds": 3.44,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 405.9,
      "end_seconds": 407.33,
      "duration_seconds": 1.43,
      "text": "Goodbye for now."
    }
  ]
}