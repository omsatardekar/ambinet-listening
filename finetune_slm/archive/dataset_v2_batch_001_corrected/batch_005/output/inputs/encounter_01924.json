{
  "schema_version": "1.0",
  "encounter_id": "01924",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.81,
      "end_seconds": 8.08,
      "duration_seconds": 7.27,
      "text": "Doctor, I've checked them in and done the preliminary measurements, I'll hand them over when you ask."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.62,
      "end_seconds": 14.55,
      "duration_seconds": 4.93,
      "text": "thanks hello, come in, sit down what brings you in today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 15.37,
      "end_seconds": 27.12,
      "duration_seconds": 11.75,
      "text": "it's pain under my right ribs after fatty meals, mostly. A neighbour of mine said I should see someone about it"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.88,
      "end_seconds": 32.3,
      "duration_seconds": 3.42,
      "text": "what's the the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 34.08,
      "end_seconds": 37.8,
      "duration_seconds": 3.72,
      "text": "I've had it for about a month."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.03,
      "end_seconds": 41.67,
      "duration_seconds": 2.64,
      "text": "is it worse at certain times?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 45.77,
      "end_seconds": 49.42,
      "duration_seconds": 3.65,
      "text": "Yes, fatty meals. That makes it worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.95,
      "end_seconds": 52.87,
      "duration_seconds": 2.92,
      "text": "understood. How often do you get it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 53.91,
      "end_seconds": 56.7,
      "duration_seconds": 2.79,
      "text": "It's a few times a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.35,
      "end_seconds": 61.45,
      "duration_seconds": 3.1,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 62.06,
      "end_seconds": 63.44,
      "duration_seconds": 1.38,
      "text": "I'd say mild."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.19,
      "end_seconds": 67.33,
      "duration_seconds": 3.14,
      "text": "What do you do to make it better?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 68.84,
      "end_seconds": 75.83,
      "duration_seconds": 6.99,
      "text": "I get some relief from lying still. I had bloating before. That's settled now, though."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.31,
      "end_seconds": 95.73,
      "duration_seconds": 2.42,
      "text": "Any fever or pale stools?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 97.71,
      "end_seconds": 100.22,
      "duration_seconds": 2.51,
      "text": "no, nothing to report there"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.79,
      "end_seconds": 106.04,
      "duration_seconds": 5.25,
      "text": "I see, go ahead. And what about dark urine or yellow eyes?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 106.96,
      "end_seconds": 111.45,
      "duration_seconds": 4.49,
      "text": "I haven't had dark urine or yellow eyes, no"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.53,
      "end_seconds": 116.76,
      "duration_seconds": 3.23,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 117.3,
      "end_seconds": 118.75,
      "duration_seconds": 1.45,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.81,
      "end_seconds": 122.04,
      "duration_seconds": 2.23,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 123.14,
      "end_seconds": 127.13,
      "duration_seconds": 3.99,
      "text": "No, I share a house with my brother"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.91,
      "end_seconds": 130.84,
      "duration_seconds": 1.93,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 131.82,
      "end_seconds": 135.79,
      "duration_seconds": 3.97,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.28,
      "end_seconds": 141.67,
      "duration_seconds": 2.39,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 143.33,
      "end_seconds": 147.49,
      "duration_seconds": 4.16,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.7,
      "end_seconds": 166.41,
      "duration_seconds": 2.71,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 168.09,
      "end_seconds": 170.63,
      "duration_seconds": 2.54,
      "text": "not to my knowledge, no"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.18,
      "end_seconds": 175.47,
      "duration_seconds": 3.29,
      "text": "any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 176.94,
      "end_seconds": 181.24,
      "duration_seconds": 4.3,
      "text": "I've had anxiety for about a year now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.03,
      "end_seconds": 182.73,
      "duration_seconds": 0.7,
      "text": "understood"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 188.11,
      "end_seconds": 193.34,
      "duration_seconds": 5.23,
      "text": "I mean, I've had high blood pressure for five years now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.06,
      "end_seconds": 195.87,
      "duration_seconds": 0.81,
      "text": "mm-hmm"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.65,
      "end_seconds": 207.49,
      "duration_seconds": 2.84,
      "text": "have you ever had an operation?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 208.88,
      "end_seconds": 213.79,
      "duration_seconds": 4.91,
      "text": "Just a meniscus repair on my knee, four years ago."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.01,
      "end_seconds": 219.55,
      "duration_seconds": 4.54,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 220.05,
      "end_seconds": 233.21,
      "duration_seconds": 13.16,
      "text": "I take escitalopram, 10 milligrams, once a day. I thought it would sort itself out, but it hasn't. Losartan, once a day for my blood pressure."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.04,
      "end_seconds": 237.1,
      "duration_seconds": 2.06,
      "text": "how much do you take?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 239.12,
      "end_seconds": 240.7,
      "duration_seconds": 1.58,
      "text": "It's 50 milligrams."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 245.09,
      "end_seconds": 254.59,
      "duration_seconds": 9.5,
      "text": "Here are the numbers, doctor. Oxygen saturation is 97 percent, blood pressure 119 over 76. Pulse is 71 beats a minute, respiratory rate 14."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.27,
      "end_seconds": 256.2,
      "duration_seconds": 0.93,
      "text": "okay, noted"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.51,
      "end_seconds": 259.51,
      "duration_seconds": 2.0,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.79,
      "end_seconds": 263.44,
      "duration_seconds": 2.65,
      "text": "So, I'm just checking this side."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.18,
      "end_seconds": 287.5,
      "duration_seconds": 6.32,
      "text": "It is tender under the right ribs and you stop breathing in when I press."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.69,
      "end_seconds": 307.55,
      "duration_seconds": 14.86,
      "text": "you can sit up now so, based on the history and the examination, the most likely explanation is gallstone-related pain i'd like to arrange an ultrasound of the abdomen for biliary pain"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 308.9,
      "end_seconds": 311.14,
      "duration_seconds": 2.24,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.15,
      "end_seconds": 331.02,
      "duration_seconds": 18.87,
      "text": "Let's use paracetamol, 1 gram, four times a day when needed, one week. You take it by mouth. That's for pain. It's a commonly used medicine and most people tolerate it well. Avoid fatty and fried foods until the scan."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.3,
      "end_seconds": 342.85,
      "duration_seconds": 11.55,
      "text": "mm-hmm i'm going to send a referral to the surgical clinic if the symptoms get worse, that's the point to come in urgently"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 347.23,
      "end_seconds": 348.91,
      "duration_seconds": 1.68,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.88,
      "end_seconds": 357.58,
      "duration_seconds": 7.7,
      "text": "Let's plan a check after the scan. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 361.52,
      "end_seconds": 365.42,
      "duration_seconds": 3.9,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.46,
      "end_seconds": 368.71,
      "duration_seconds": 1.25,
      "text": "Goodbye for now."
    }
  ]
}