{
  "schema_version": "1.0",
  "encounter_id": "01627",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.57,
      "end_seconds": 6.81,
      "duration_seconds": 6.24,
      "text": "Hi, you know, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.22,
      "end_seconds": 12.07,
      "duration_seconds": 3.85,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.43,
      "end_seconds": 17.8,
      "duration_seconds": 4.37,
      "text": "I wanted to get itchy raised welts looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.78,
      "end_seconds": 22.89,
      "duration_seconds": 3.11,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.42,
      "end_seconds": 26.65,
      "duration_seconds": 3.23,
      "text": "Since Friday, that's when it began."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.73,
      "end_seconds": 31.38,
      "duration_seconds": 2.65,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.45,
      "end_seconds": 36.79,
      "duration_seconds": 3.34,
      "text": "Pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.81,
      "end_seconds": 41.35,
      "duration_seconds": 2.54,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.41,
      "end_seconds": 45.6,
      "duration_seconds": 2.19,
      "text": "Honestly, all the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.99,
      "end_seconds": 48.84,
      "duration_seconds": 1.85,
      "text": "Does anything help it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.37,
      "end_seconds": 52.39,
      "duration_seconds": 2.02,
      "text": "Antihistamine helps a bit."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.83,
      "end_seconds": 56.24,
      "duration_seconds": 2.41,
      "text": "Does anything set it off?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.91,
      "end_seconds": 72.1,
      "duration_seconds": 15.19,
      "text": "It's worse with stress. Well, as for welts that move around, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.27,
      "end_seconds": 75.73,
      "duration_seconds": 2.46,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.46,
      "end_seconds": 99.44,
      "duration_seconds": 21.98,
      "text": "I have about eight cigarettes in a day. I used to drink heavily but I stopped four years ago. I retired from the post office two years ago. I walk the dog every morning. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.72,
      "end_seconds": 119.05,
      "duration_seconds": 4.33,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.47,
      "end_seconds": 130.16,
      "duration_seconds": 9.69,
      "text": "I'm on carvedilol, 6.25 milligrams, twice a day. I'm on glibenclamide, 5 milligrams, before breakfast for my sugar."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.08,
      "end_seconds": 138.79,
      "duration_seconds": 6.71,
      "text": "Any health conditions I should have on record? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.28,
      "end_seconds": 148.68,
      "duration_seconds": 8.4,
      "text": "I have heart failure. I've got diabetes. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.2,
      "end_seconds": 152.59,
      "duration_seconds": 2.39,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.28,
      "end_seconds": 161.93,
      "duration_seconds": 5.65,
      "text": "Erm, yes, I had a bunion operation, six years ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.42,
      "end_seconds": 166.21,
      "duration_seconds": 2.79,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.64,
      "end_seconds": 169.63,
      "duration_seconds": 1.99,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.32,
      "end_seconds": 175.95,
      "duration_seconds": 4.63,
      "text": "Have you noticed joint pain, throat tightness or difficulty breathing?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.42,
      "end_seconds": 185.87,
      "duration_seconds": 6.45,
      "text": "Um, I haven't had joint pain, throat tightness or difficulty breathing, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.23,
      "end_seconds": 189.4,
      "duration_seconds": 2.17,
      "text": "So, any sign of fever?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.49,
      "end_seconds": 194.03,
      "duration_seconds": 2.54,
      "text": "Not at all, no fever."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.73,
      "end_seconds": 196.69,
      "duration_seconds": 1.96,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.82,
      "end_seconds": 200.53,
      "duration_seconds": 2.71,
      "text": "Uh, no problems with breathing."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.16,
      "end_seconds": 204.74,
      "duration_seconds": 3.58,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.31,
      "end_seconds": 207.99,
      "duration_seconds": 1.68,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.37,
      "end_seconds": 213.31,
      "duration_seconds": 3.94,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.58,
      "end_seconds": 227.37,
      "duration_seconds": 2.79,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.55,
      "end_seconds": 247.67,
      "duration_seconds": 10.12,
      "text": "Okay: temperature 36.5, weight 81 kilos, pressure 111 over 74, BMI works out to 30.1, pulse 84, height 164 centimetres."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.23,
      "end_seconds": 250.82,
      "duration_seconds": 1.59,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.68,
      "end_seconds": 259.92,
      "duration_seconds": 3.24,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.17,
      "end_seconds": 266.18,
      "duration_seconds": 4.01,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.06,
      "end_seconds": 268.48,
      "duration_seconds": 1.42,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.67,
      "end_seconds": 288.92,
      "duration_seconds": 6.25,
      "text": "There are pink raised wheals on the arms and trunk that blanch with pressure."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.07,
      "end_seconds": 295.77,
      "duration_seconds": 1.7,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.21,
      "end_seconds": 309.58,
      "duration_seconds": 5.37,
      "text": "So where does that leave us? It fits best with chronic spontaneous urticaria."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.57,
      "end_seconds": 311.92,
      "duration_seconds": 1.35,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.66,
      "end_seconds": 322.83,
      "duration_seconds": 9.17,
      "text": "Nothing I've seen today points to an emergency. It looks like chronic spontaneous urticaria, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.78,
      "end_seconds": 346.47,
      "duration_seconds": 8.69,
      "text": "Let's book blood tests to look into chronic urticaria. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.26,
      "end_seconds": 349.31,
      "duration_seconds": 2.05,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.05,
      "end_seconds": 352.44,
      "duration_seconds": 1.39,
      "text": "See you soon."
    }
  ]
}