{
  "schema_version": "1.0",
  "encounter_id": "01834",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.35,
      "end_seconds": 4.02,
      "duration_seconds": 2.67,
      "text": "Right, thanks for waiting, come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.85,
      "end_seconds": 10.28,
      "duration_seconds": 5.43,
      "text": "Hi doctor, I got here as fast as I could."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.87,
      "end_seconds": 18.44,
      "duration_seconds": 6.57,
      "text": "Doctor, uh, I'll sit in if that's okay, I know what's been happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.19,
      "end_seconds": 25.91,
      "duration_seconds": 6.72,
      "text": "Good, that'll be useful. Pull up a chair. So what can I do for you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 27.49,
      "end_seconds": 34.6,
      "duration_seconds": 7.11,
      "text": "Um, so... a productive cough with rusty phlegm. That's why I came."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.29,
      "end_seconds": 39.3,
      "duration_seconds": 4.01,
      "text": "Okay, what's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 40.22,
      "end_seconds": 44.09,
      "duration_seconds": 3.87,
      "text": "It's been going on for four weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.9,
      "end_seconds": 55.16,
      "duration_seconds": 10.26,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 56.54,
      "end_seconds": 78.33,
      "duration_seconds": 21.79,
      "text": "I'd say on and off. It feels severe to me. There's pain on the right when I breathe in as well. As for pain on the right when I breathe in, I'd give it a eight, out of ten."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.75,
      "end_seconds": 84.43,
      "duration_seconds": 4.68,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 85.09,
      "end_seconds": 95.75,
      "duration_seconds": 10.66,
      "text": "I'm, I'm on ramipril, 5 milligrams, every morning for my blood pressure. It's paracetamol, 1 gram, when needed."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.33,
      "end_seconds": 100.01,
      "duration_seconds": 3.68,
      "text": "Ah. Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.22,
      "end_seconds": 105.54,
      "duration_seconds": 4.32,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.15,
      "end_seconds": 109.07,
      "duration_seconds": 1.92,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.57,
      "end_seconds": 112.2,
      "duration_seconds": 2.63,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.06,
      "end_seconds": 114.74,
      "duration_seconds": 1.68,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 116.65,
      "end_seconds": 120.77,
      "duration_seconds": 4.12,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.16,
      "end_seconds": 125.78,
      "duration_seconds": 3.62,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 126.75,
      "end_seconds": 139.32,
      "duration_seconds": 12.57,
      "text": "I've had high blood pressure, yes. My sister suggested writing things down, but I forgot. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.19,
      "end_seconds": 150.16,
      "duration_seconds": 1.97,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.81,
      "end_seconds": 158.79,
      "duration_seconds": 7.98,
      "text": "Yes, I had a cataract operation in my left eye, about a year ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.57,
      "end_seconds": 170.07,
      "duration_seconds": 3.5,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 171.77,
      "end_seconds": 175.79,
      "duration_seconds": 4.02,
      "text": "Not to my knowledge, you know, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.87,
      "end_seconds": 195.73,
      "duration_seconds": 4.86,
      "text": "Any coughing up blood, confusion or leg swelling at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 196.34,
      "end_seconds": 202.37,
      "duration_seconds": 6.03,
      "text": "Oh, I haven't had coughing up blood, confusion or leg swelling, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.81,
      "end_seconds": 205.87,
      "duration_seconds": 2.06,
      "text": "Any sign of recent travel?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.73,
      "end_seconds": 213.59,
      "duration_seconds": 5.86,
      "text": "Sorry, what was I saying, no, none, no recent travel."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.44,
      "end_seconds": 215.94,
      "duration_seconds": 1.5,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 217.49,
      "end_seconds": 220.56,
      "duration_seconds": 3.07,
      "text": "No, uh, that's all normal."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.7,
      "end_seconds": 227.24,
      "duration_seconds": 2.54,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 229.11,
      "end_seconds": 230.72,
      "duration_seconds": 1.61,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.33,
      "end_seconds": 237.47,
      "duration_seconds": 2.14,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.18,
      "end_seconds": 248.98,
      "duration_seconds": 2.8,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.34,
      "end_seconds": 277.46,
      "duration_seconds": 11.12,
      "text": "Okay: temp 39.1 degrees, blood pressure 115 over 67, pulse is 88 beats a minute. And respiratory rate 17, oxygen saturation is 95 percent."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 279.81,
      "end_seconds": 283.81,
      "duration_seconds": 4.0,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 285.43,
      "end_seconds": 288.62,
      "duration_seconds": 3.19,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.96,
      "end_seconds": 305.35,
      "duration_seconds": 6.39,
      "text": "There are crackles at the right base and the breathing is a bit fast."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.64,
      "end_seconds": 327.85,
      "duration_seconds": 20.21,
      "text": "Please sit back down. Okay, thinking it through, I'm honestly not certain yet. It could be community-acquired pneumonia, or it might be acute bronchitis. I'd like to arrange blood tests for pneumonia. I'd like to arrange a chest X-ray for possible pneumonia."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 329.84,
      "end_seconds": 331.78,
      "duration_seconds": 1.94,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 337.2,
      "end_seconds": 355.24,
      "duration_seconds": 18.04,
      "text": "You'll be taking amoxicillin, 500 milligrams, three times a day, five days. That's for chest infection. Rest, drink plenty, and come back if you are not improving in two days. I'd like you back in one week. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 357.18,
      "end_seconds": 359.45,
      "duration_seconds": 2.27,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 361.16,
      "end_seconds": 362.5,
      "duration_seconds": 1.34,
      "text": "Take care now."
    }
  ]
}