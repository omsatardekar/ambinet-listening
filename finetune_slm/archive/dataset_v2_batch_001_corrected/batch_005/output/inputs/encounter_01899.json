{
  "schema_version": "1.0",
  "encounter_id": "01899",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.76,
      "end_seconds": 5.31,
      "duration_seconds": 4.55,
      "text": "Hmm, hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.15,
      "end_seconds": 10.85,
      "duration_seconds": 3.7,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.35,
      "end_seconds": 19.77,
      "duration_seconds": 7.42,
      "text": "Hello, you know, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.9,
      "end_seconds": 28.95,
      "duration_seconds": 8.05,
      "text": "Honestly, it's pain on the right when I breathe in, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.33,
      "end_seconds": 33.39,
      "duration_seconds": 3.06,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.03,
      "end_seconds": 42.29,
      "duration_seconds": 8.26,
      "text": "Oh, it's been ten days now. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.56,
      "end_seconds": 45.36,
      "duration_seconds": 2.8,
      "text": "Mm-hmm. Does anything set it off?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.22,
      "end_seconds": 49.87,
      "duration_seconds": 2.65,
      "text": "It's worse with deep breaths."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.97,
      "end_seconds": 54.84,
      "duration_seconds": 2.87,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.69,
      "end_seconds": 73.18,
      "duration_seconds": 17.49,
      "text": "When it starts I tend to get a fever as well. And I've been feeling short of breath as well. Ah, the fever? That's been for two months. As for fever, it's severe, honestly."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.59,
      "end_seconds": 87.04,
      "duration_seconds": 3.45,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.67,
      "end_seconds": 100.16,
      "duration_seconds": 2.49,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.44,
      "end_seconds": 126.41,
      "duration_seconds": 10.97,
      "text": "Okay: BP is 111 over 71, pulse is 93 beats a minute, respiratory rate 18, saturation 95 percent, temp 39.0 degrees."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.73,
      "end_seconds": 132.2,
      "duration_seconds": 3.47,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.34,
      "end_seconds": 135.55,
      "duration_seconds": 2.21,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.34,
      "end_seconds": 151.51,
      "duration_seconds": 6.17,
      "text": "There are crackles at the right base and the breathing is a bit fast."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.13,
      "end_seconds": 164.67,
      "duration_seconds": 8.54,
      "text": "Okay, that's enough for me. Have you had any coughing up blood, recent travel, leg swelling or confusion?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.79,
      "end_seconds": 168.61,
      "duration_seconds": 2.82,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.43,
      "end_seconds": 173.18,
      "duration_seconds": 3.75,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.12,
      "end_seconds": 178.3,
      "duration_seconds": 4.18,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.54,
      "end_seconds": 181.99,
      "duration_seconds": 2.45,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.95,
      "end_seconds": 190.75,
      "duration_seconds": 4.8,
      "text": "Just two stents put in my heart, three years ago."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.65,
      "end_seconds": 194.81,
      "duration_seconds": 3.16,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.41,
      "end_seconds": 199.8,
      "duration_seconds": 4.39,
      "text": "Alendronate. I take it 70 milligrams, once a week."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 200.71,
      "end_seconds": 206.34,
      "duration_seconds": 5.63,
      "text": "That's what's prescribed, but I'm not sure he takes it every day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.9,
      "end_seconds": 210.57,
      "duration_seconds": 2.67,
      "text": "It's metoprolol, twice a day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.49,
      "end_seconds": 213.7,
      "duration_seconds": 2.21,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.57,
      "end_seconds": 220.81,
      "duration_seconds": 6.24,
      "text": "50 milligrams. Paracetamol. I take it 1 gram, maybe, when needed."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.66,
      "end_seconds": 225.92,
      "duration_seconds": 4.26,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.16,
      "end_seconds": 229.48,
      "duration_seconds": 2.32,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.86,
      "end_seconds": 244.53,
      "duration_seconds": 4.67,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.42,
      "end_seconds": 255.92,
      "duration_seconds": 10.5,
      "text": "I hardly move around during the day. No, I share a house with my brother. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.93,
      "end_seconds": 262.02,
      "duration_seconds": 4.09,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.74,
      "end_seconds": 267.72,
      "duration_seconds": 4.98,
      "text": "I don't think I have any, um, no."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.81,
      "end_seconds": 273.25,
      "duration_seconds": 4.44,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.19,
      "end_seconds": 281.33,
      "duration_seconds": 7.14,
      "text": "Thin bones, for about a year. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.15,
      "end_seconds": 284.04,
      "duration_seconds": 0.89,
      "text": "Anything else?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.37,
      "end_seconds": 287.07,
      "duration_seconds": 1.7,
      "text": "Yes, heart failure."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.0,
      "end_seconds": 288.89,
      "duration_seconds": 0.89,
      "text": "Anything else?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.55,
      "end_seconds": 292.91,
      "duration_seconds": 2.36,
      "text": "I've got high blood pressure."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.24,
      "end_seconds": 295.86,
      "duration_seconds": 1.62,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.04,
      "end_seconds": 298.74,
      "duration_seconds": 1.7,
      "text": "Yes, heart disease."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.34,
      "end_seconds": 304.72,
      "duration_seconds": 5.38,
      "text": "Right, right. Taking everything into account, the most likely explanation is community-acquired pneumonia."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.87,
      "end_seconds": 309.01,
      "duration_seconds": 3.14,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.23,
      "end_seconds": 317.35,
      "duration_seconds": 7.12,
      "text": "I can't promise yet, but most people with community-acquired pneumonia do well once it's treated properly."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.05,
      "end_seconds": 356.34,
      "duration_seconds": 30.29,
      "text": "I want a chest X-ray done, that's for possible pneumonia. The treatment will be amoxicillin, 500 milligrams, three times a day, five days. You take it by mouth. That's for chest infection. Rest, drink plenty, and come back if you are not improving in two days. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.15,
      "end_seconds": 365.99,
      "duration_seconds": 8.84,
      "text": "The thing that would worry me is if the symptoms get worse. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 366.61,
      "end_seconds": 368.52,
      "duration_seconds": 1.91,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.66,
      "end_seconds": 374.54,
      "duration_seconds": 4.88,
      "text": "Let's review you in one week. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 375.14,
      "end_seconds": 377.8,
      "duration_seconds": 2.66,
      "text": "Mm, alright, thanks, take care."
    }
  ]
}