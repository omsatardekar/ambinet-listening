{
  "schema_version": "1.0",
  "encounter_id": "01617",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.16,
      "end_seconds": 4.56,
      "duration_seconds": 3.4,
      "text": "Well, hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.28,
      "end_seconds": 9.52,
      "duration_seconds": 4.24,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.37,
      "end_seconds": 19.91,
      "duration_seconds": 8.54,
      "text": "doctor it's severe pain in the upper tummy going through to the back it's getting on my nerves now"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.89,
      "end_seconds": 24.76,
      "duration_seconds": 2.87,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.55,
      "end_seconds": 40.88,
      "duration_seconds": 2.33,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.91,
      "end_seconds": 58.39,
      "duration_seconds": 8.48,
      "text": "okay: blood pressure 137 over 77, saturation 97 percent, temperature 36.8, pulse is 114 beats a minute"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.64,
      "end_seconds": 69.09,
      "duration_seconds": 1.45,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.27,
      "end_seconds": 76.76,
      "duration_seconds": 6.49,
      "text": "it's been four weeks now it's the not knowing that gets to me"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.32,
      "end_seconds": 83.11,
      "duration_seconds": 4.79,
      "text": "Okay give me more detail on it whatever comes to to mind."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.01,
      "end_seconds": 90.11,
      "duration_seconds": 4.1,
      "text": "Severe really i notice it more with lying flat"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.71,
      "end_seconds": 93.19,
      "duration_seconds": 2.48,
      "text": "any a fast heart as well?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.76,
      "end_seconds": 97.13,
      "duration_seconds": 3.37,
      "text": "mm yes with fast heart severe really"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.33,
      "end_seconds": 106.94,
      "duration_seconds": 8.61,
      "text": "Have you had severe pain in the upper tummy going through to the back before, or is this the first time?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.97,
      "end_seconds": 117.19,
      "duration_seconds": 9.22,
      "text": "yes, something like this happened about six months ago, and it went away on its own"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.18,
      "end_seconds": 134.13,
      "duration_seconds": 5.95,
      "text": "a few quick ones: black stools, yellow eyes, chest pain or fever?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.46,
      "end_seconds": 139.11,
      "duration_seconds": 3.65,
      "text": "yeah no none of those at all"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.3,
      "end_seconds": 141.61,
      "duration_seconds": 1.31,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.64,
      "end_seconds": 145.62,
      "duration_seconds": 1.98,
      "text": "no weakness or anything"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.1,
      "end_seconds": 148.91,
      "duration_seconds": 1.81,
      "text": "how's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.31,
      "end_seconds": 154.91,
      "duration_seconds": 2.6,
      "text": "no, my breathing's been fine"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.97,
      "end_seconds": 159.78,
      "duration_seconds": 2.81,
      "text": "any past operations I should know about?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.01,
      "end_seconds": 164.72,
      "duration_seconds": 3.71,
      "text": "I had a varicose vein procedure last year."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.49,
      "end_seconds": 171.06,
      "duration_seconds": 5.57,
      "text": "right tell me about your routine work habits that sort of thing"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.33,
      "end_seconds": 182.49,
      "duration_seconds": 10.16,
      "text": "I'm a hairdresser, on my feet all day. I swim twice a week. My partner and our baby"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.13,
      "end_seconds": 188.22,
      "duration_seconds": 4.09,
      "text": "any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.18,
      "end_seconds": 194.16,
      "duration_seconds": 3.98,
      "text": "let me think, my grandmother had dementia"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.88,
      "end_seconds": 201.13,
      "duration_seconds": 5.25,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.91,
      "end_seconds": 205.0,
      "duration_seconds": 2.09,
      "text": "no allergies at all"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.6,
      "end_seconds": 210.5,
      "duration_seconds": 3.9,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.94,
      "end_seconds": 217.83,
      "duration_seconds": 4.89,
      "text": "Uh, uh, I have epilepsy, for two years."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.6,
      "end_seconds": 227.78,
      "duration_seconds": 8.18,
      "text": "sure. Okay I can see epilepsy in your file as well. Are you taking anything regularly including from the pharmacy?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.25,
      "end_seconds": 231.38,
      "duration_seconds": 2.13,
      "text": "it's ibuprofen, when needed"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.44,
      "end_seconds": 235.81,
      "duration_seconds": 2.37,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.75,
      "end_seconds": 241.04,
      "duration_seconds": 4.29,
      "text": "400 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.2,
      "end_seconds": 245.45,
      "duration_seconds": 3.25,
      "text": "Right let's have a proper look at you."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.37,
      "end_seconds": 248.37,
      "duration_seconds": 1.0,
      "text": "that's alright"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.63,
      "end_seconds": 251.99,
      "duration_seconds": 2.36,
      "text": "raise your arm for me"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.44,
      "end_seconds": 271.15,
      "duration_seconds": 4.71,
      "text": "your upper tummy is very tender and you look dehydrated"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.05,
      "end_seconds": 278.76,
      "duration_seconds": 1.71,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.29,
      "end_seconds": 301.48,
      "duration_seconds": 9.19,
      "text": "Let's book an abdominal scan to look into pancreatitis. You need admission for fluids and pain relief, nothing to eat for now."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.72,
      "end_seconds": 310.33,
      "duration_seconds": 8.61,
      "text": "yes. The surgical team would be the right next step, I'll refer you. I think we're done unless you have questions"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.15,
      "end_seconds": 314.44,
      "duration_seconds": 2.29,
      "text": "alright, thanks, take care"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.4,
      "end_seconds": 316.83,
      "duration_seconds": 1.43,
      "text": "take care now"
    }
  ]
