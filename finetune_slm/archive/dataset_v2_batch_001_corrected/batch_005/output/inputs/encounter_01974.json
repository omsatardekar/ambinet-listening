{
  "schema_version": "1.0",
  "encounter_id": "01974",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.05,
      "end_seconds": 5.92,
      "duration_seconds": 4.87,
      "text": "Afternoon, doctor. They're in and comfortable, and I have the measurements ready."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.4,
      "end_seconds": 11.23,
      "duration_seconds": 3.83,
      "text": "Okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 16.75,
      "end_seconds": 31.04,
      "duration_seconds": 14.29,
      "text": "Right, I've been getting out of breath, and I wanted to get it checked. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.11,
      "end_seconds": 33.51,
      "duration_seconds": 1.4,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 35.44,
      "end_seconds": 38.36,
      "duration_seconds": 2.92,
      "text": "I've had it for three days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.37,
      "end_seconds": 47.56,
      "duration_seconds": 3.19,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 48.43,
      "end_seconds": 51.61,
      "duration_seconds": 3.18,
      "text": "About a seven out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.28,
      "end_seconds": 54.97,
      "duration_seconds": 2.69,
      "text": "Is it worse at certain times?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 56.17,
      "end_seconds": 58.87,
      "duration_seconds": 2.7,
      "text": "I notice it more with stairs."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.69,
      "end_seconds": 64.19,
      "duration_seconds": 2.5,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 69.59,
      "end_seconds": 74.78,
      "duration_seconds": 5.19,
      "text": "Sore knees goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.29,
      "end_seconds": 95.01,
      "duration_seconds": 2.72,
      "text": "Have you had any chest pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 100.62,
      "end_seconds": 104.18,
      "duration_seconds": 3.56,
      "text": "Not that I've noticed, no chest pain."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.22,
      "end_seconds": 110.08,
      "duration_seconds": 3.86,
      "text": "Alright, any low mood, palpitations or high thirst?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 111.52,
      "end_seconds": 115.55,
      "duration_seconds": 4.03,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.9,
      "end_seconds": 119.82,
      "duration_seconds": 2.92,
      "text": "Okay, has your skin been okay?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 121.2,
      "end_seconds": 123.59,
      "duration_seconds": 2.39,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.06,
      "end_seconds": 132.45,
      "duration_seconds": 7.39,
      "text": "What do you take on a normal day? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 133.06,
      "end_seconds": 137.54,
      "duration_seconds": 4.48,
      "text": "I take metoprolol, 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.14,
      "end_seconds": 152.67,
      "duration_seconds": 3.53,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 153.92,
      "end_seconds": 159.53,
      "duration_seconds": 5.61,
      "text": "I've had high blood pressure for about a year now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.79,
      "end_seconds": 163.6,
      "duration_seconds": 0.81,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.47,
      "end_seconds": 178.75,
      "duration_seconds": 4.28,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 179.48,
      "end_seconds": 181.86,
      "duration_seconds": 2.38,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.83,
      "end_seconds": 196.61,
      "duration_seconds": 1.78,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 198.4,
      "end_seconds": 201.7,
      "duration_seconds": 3.3,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.1,
      "end_seconds": 205.11,
      "duration_seconds": 2.01,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 206.03,
      "end_seconds": 211.77,
      "duration_seconds": 5.74,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 213.75,
      "end_seconds": 230.79,
      "duration_seconds": 17.04,
      "text": "Doctor, I've got the readings for you. Heart rate 80, temperature is 36.5 degrees. BP is 169 over 98, BMI works out to 23.0, oxygen saturation is 99 percent, height 163 centimetres, weight 61 kilos."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.74,
      "end_seconds": 233.18,
      "duration_seconds": 1.44,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.67,
      "end_seconds": 239.28,
      "duration_seconds": 4.61,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.29,
      "end_seconds": 241.54,
      "duration_seconds": 1.25,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.09,
      "end_seconds": 258.66,
      "duration_seconds": 4.57,
      "text": "Your weight and waist measurement are both above the healthy range."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.16,
      "end_seconds": 271.15,
      "duration_seconds": 9.99,
      "text": "You can relax now. From what you've told me and what I found, this is probably obesity with weight-related symptoms."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 271.98,
      "end_seconds": 274.93,
      "duration_seconds": 2.95,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.78,
      "end_seconds": 314.46,
      "duration_seconds": 37.68,
      "text": "It's reasonable to be concerned, but right now obesity with weight-related symptoms is my leading thought, not anything worse. I think a thyroid test makes sense here, for weight gain. Aim for a loss of half a kilo a week with smaller portions and a daily thirty-minute walk. Don't skip meals, and try to eat smaller portions more often through the day. Come back in three months. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 315.94,
      "end_seconds": 319.8,
      "duration_seconds": 3.86,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.71,
      "end_seconds": 322.95,
      "duration_seconds": 1.24,
      "text": "All the best."
    }
  ]
}