{
  "schema_version": "1.0",
  "encounter_id": "01644",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.1,
      "end_seconds": 4.77,
      "duration_seconds": 3.67,
      "text": "Hi there, the chair's free, sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.46,
      "end_seconds": 7.59,
      "duration_seconds": 1.13,
      "text": "Evening, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.65,
      "end_seconds": 11.54,
      "duration_seconds": 2.89,
      "text": "Did the receptionist sort you out quickly?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.08,
      "end_seconds": 15.86,
      "duration_seconds": 3.78,
      "text": "Yes, she was lovely about it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.63,
      "end_seconds": 19.05,
      "duration_seconds": 2.42,
      "text": "So, where shall we begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.75,
      "end_seconds": 26.29,
      "duration_seconds": 6.54,
      "text": "Yeah, it's pulling at the ear. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.25,
      "end_seconds": 30.42,
      "duration_seconds": 3.17,
      "text": "So, tell me your medicines, please."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.82,
      "end_seconds": 42.36,
      "duration_seconds": 10.54,
      "text": "Right, it's lansoprazole, 30 milligrams, before breakfast for my acidity. I take clopidogrel, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.82,
      "end_seconds": 45.18,
      "duration_seconds": 1.36,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.31,
      "end_seconds": 49.95,
      "duration_seconds": 3.64,
      "text": "It's been about a month now."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.18,
      "end_seconds": 53.52,
      "duration_seconds": 3.34,
      "text": "Sure. How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 54.24,
      "end_seconds": 56.05,
      "duration_seconds": 1.81,
      "text": "It's severe, honestly."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.25,
      "end_seconds": 59.71,
      "duration_seconds": 2.46,
      "text": "Alright, is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 61.5,
      "end_seconds": 77.93,
      "duration_seconds": 16.43,
      "text": "When it starts I tend to get ear pain as well. Erm, you know, about ear pain, pretty severe, if I'm being honest. I notice it more with lying down."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.62,
      "end_seconds": 80.98,
      "duration_seconds": 2.36,
      "text": "Have you had not eating?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.06,
      "end_seconds": 84.22,
      "duration_seconds": 2.16,
      "text": "Yes, for six months."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.4,
      "end_seconds": 98.97,
      "duration_seconds": 2.57,
      "text": "And discharge, any of that?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.09,
      "end_seconds": 101.75,
      "duration_seconds": 1.66,
      "text": "No discharge, thankfully."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.18,
      "end_seconds": 108.4,
      "duration_seconds": 5.22,
      "text": "Have you had any stiff neck, swelling behind the ear or hearing loss?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.02,
      "end_seconds": 117.14,
      "duration_seconds": 7.12,
      "text": "No stiff neck, swelling behind the ear or hearing loss, none of it."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.73,
      "end_seconds": 119.95,
      "duration_seconds": 2.22,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.79,
      "end_seconds": 122.37,
      "duration_seconds": 1.58,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.3,
      "end_seconds": 127.5,
      "duration_seconds": 3.2,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.31,
      "end_seconds": 132.51,
      "duration_seconds": 4.2,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.0,
      "end_seconds": 135.92,
      "duration_seconds": 1.92,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.96,
      "end_seconds": 141.65,
      "duration_seconds": 4.69,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.6,
      "end_seconds": 156.17,
      "duration_seconds": 3.57,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.38,
      "end_seconds": 174.1,
      "duration_seconds": 12.72,
      "text": "Yeah, yes, acid reflux. It's a relief to finally sit down and talk about it. I have heart disease, for about ten years."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.42,
      "end_seconds": 183.31,
      "duration_seconds": 7.89,
      "text": "Hm, okay. Okay, I can see acid reflux and heart disease in your file as well. Any previous surgeries?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 184.67,
      "end_seconds": 188.54,
      "duration_seconds": 3.87,
      "text": "Ah, nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.62,
      "end_seconds": 195.09,
      "duration_seconds": 4.47,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 197.04,
      "end_seconds": 201.43,
      "duration_seconds": 4.39,
      "text": "No, uh, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.63,
      "end_seconds": 205.51,
      "duration_seconds": 2.88,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 210.57,
      "end_seconds": 214.19,
      "duration_seconds": 3.62,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 215.64,
      "end_seconds": 221.9,
      "duration_seconds": 6.26,
      "text": "Here are the numbers, doctor. Heart rate 90, blood pressure 108 over 77, respiratory rate 18."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.55,
      "end_seconds": 225.04,
      "duration_seconds": 1.49,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.96,
      "end_seconds": 230.23,
      "duration_seconds": 3.27,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.59,
      "end_seconds": 232.84,
      "duration_seconds": 1.25,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.96,
      "end_seconds": 249.69,
      "duration_seconds": 5.73,
      "text": "The right ear drum is red and bulging, and the left is normal."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.28,
      "end_seconds": 257.09,
      "duration_seconds": 2.81,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.06,
      "end_seconds": 282.2,
      "duration_seconds": 8.14,
      "text": "Okay, thinking it through, this is probably acute middle ear infection. A viral cold is still possible."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 283.5,
      "end_seconds": 288.42,
      "duration_seconds": 4.92,
      "text": "I'm, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.22,
      "end_seconds": 321.28,
      "duration_seconds": 31.06,
      "text": "Nothing I've seen today points to an emergency. It looks like acute middle ear infection. I'm going to put you on amoxicillin, 250 milligrams, three times a day, five days. You take it by mouth. That's for ear infection. It's a commonly used medicine and most people tolerate it well. Give pain relief regularly and plenty to drink. So, does all of that make sense?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 322.94,
      "end_seconds": 326.03,
      "duration_seconds": 3.09,
      "text": "Actually, alright, thanks, take care."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 326.93,
      "end_seconds": 328.12,
      "duration_seconds": 1.19,
      "text": "Look after yourself."
    }
  ]
}