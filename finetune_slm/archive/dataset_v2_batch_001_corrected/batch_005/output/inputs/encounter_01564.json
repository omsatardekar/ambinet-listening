{
  "schema_version": "1.0",
  "encounter_id": "01564",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.35,
      "end_seconds": 2.88,
      "duration_seconds": 1.53,
      "text": "good afternoon, doctor"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.67,
      "end_seconds": 8.68,
      "duration_seconds": 4.01,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.69,
      "end_seconds": 24.11,
      "duration_seconds": 9.42,
      "text": "Erm, hello, doctor, I came in with them, if that's okay. Right, we came because of an itchy scalp."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.11,
      "end_seconds": 28.97,
      "duration_seconds": 2.86,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.45,
      "end_seconds": 37.77,
      "duration_seconds": 7.32,
      "text": "It's, It's mild, honestly. There's seeing tiny bugs in the hair as well."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.14,
      "end_seconds": 44.73,
      "duration_seconds": 5.59,
      "text": "Have you had an itchy scalp before, or is this the first time?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.39,
      "end_seconds": 52.24,
      "duration_seconds": 5.85,
      "text": "Uh, a bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.42,
      "end_seconds": 58.28,
      "duration_seconds": 4.86,
      "text": "Have you noticed swollen glands, rash on the body or fever?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.19,
      "end_seconds": 66.76,
      "duration_seconds": 6.57,
      "text": "No swollen glands, rash on the body or fever, none of it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.73,
      "end_seconds": 73.04,
      "duration_seconds": 4.31,
      "text": "what about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.13,
      "end_seconds": 78.88,
      "duration_seconds": 1.75,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.59,
      "end_seconds": 82.58,
      "duration_seconds": 2.99,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.58,
      "end_seconds": 90.8,
      "duration_seconds": 6.22,
      "text": "I had my appendix taken out when I was in my twenties"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.31,
      "end_seconds": 95.19,
      "duration_seconds": 2.88,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.58,
      "end_seconds": 100.45,
      "duration_seconds": 3.87,
      "text": "Okay, so no, nothing at the moment."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.28,
      "end_seconds": 107.5,
      "duration_seconds": 3.22,
      "text": "a few questions about your lifestyle now"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.3,
      "end_seconds": 118.77,
      "duration_seconds": 9.47,
      "text": "My partner and our baby. I walk the dog every morning. I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.55,
      "end_seconds": 140.4,
      "duration_seconds": 3.85,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.63,
      "end_seconds": 144.48,
      "duration_seconds": 2.85,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.52,
      "end_seconds": 150.4,
      "duration_seconds": 3.88,
      "text": "has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.94,
      "end_seconds": 155.15,
      "duration_seconds": 3.21,
      "text": "Yeah, my grandfather had a stroke."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.58,
      "end_seconds": 176.62,
      "duration_seconds": 4.04,
      "text": "Shall I check your blood pressure and and pulse?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.95,
      "end_seconds": 184.9,
      "duration_seconds": 1.95,
      "text": "sit still for a moment.."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.99,
      "end_seconds": 207.46,
      "duration_seconds": 7.47,
      "text": "Okay: oxygen saturation is 97 percent, pulse 83, BP is 122 over 82, temp 36.9 degrees."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.44,
      "end_seconds": 210.66,
      "duration_seconds": 2.22,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.29,
      "end_seconds": 215.06,
      "duration_seconds": 2.77,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.16,
      "end_seconds": 221.15,
      "duration_seconds": 4.99,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.05,
      "end_seconds": 223.62,
      "duration_seconds": 1.57,
      "text": "yes, that's fine"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.3,
      "end_seconds": 226.6,
      "duration_seconds": 1.3,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.97,
      "end_seconds": 244.75,
      "duration_seconds": 6.78,
      "text": "I can see live lice and small eggs close to the roots behind the ears."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.1,
      "end_seconds": 277.1,
      "duration_seconds": 28.0,
      "text": "Please sit back down. Let me tell you where I've got to. I think we're dealing with head lice at this stage. You'll be taking dimeticone lotion, 4%, once, repeat after seven days, two applications. That should help with head lice. Comb the hair with a fine comb every few days and check the family. Please don't wait if the symptoms get worse. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.49,
      "end_seconds": 287.78,
      "duration_seconds": 9.29,
      "text": "Let's plan a check if lice persist after two treatments. How would you describe the plan, so we're on the same page?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.4,
      "end_seconds": 302.97,
      "duration_seconds": 14.57,
      "text": "So, you know, I take the the dimeticone lotion, 4%, once, repeat after seven days and come back if lice persist after two treatments. Is that right?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.5,
      "end_seconds": 308.82,
      "duration_seconds": 5.32,
      "text": "yes, exactly right that's everything on my side anything you're unsure about?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.67,
      "end_seconds": 313.91,
      "duration_seconds": 3.24,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.92,
      "end_seconds": 317.83,
      "duration_seconds": 1.91,
      "text": "Have a good day."
    }
  ]
}