{
  "schema_version": "1.0",
  "encounter_id": "01591",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.8,
      "end_seconds": 6.54,
      "duration_seconds": 5.74,
      "text": "erm, you know, good evening, doctor, thanks for seeing me"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.59,
      "end_seconds": 15.91,
      "duration_seconds": 4.32,
      "text": "so, yes, have a seat tell me what's going on"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.59,
      "end_seconds": 27.2,
      "duration_seconds": 10.61,
      "text": "well, I've been having swollen glands in my neck i took the morning off to to come in today"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.02,
      "end_seconds": 30.8,
      "duration_seconds": 2.78,
      "text": "I'll just record a few vital signs"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.43,
      "end_seconds": 40.42,
      "duration_seconds": 2.99,
      "text": "So, that's it, just a little longer..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.23,
      "end_seconds": 73.47,
      "duration_seconds": 11.24,
      "text": "Okay: pulse 106, blood pressure 111 over 80, oxygen saturation is 95 percent, temperature 39.3, respiratory rate 20. How long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.09,
      "end_seconds": 78.89,
      "duration_seconds": 4.8,
      "text": "Um, it's been about a month, I'm fairly sure."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.71,
      "end_seconds": 83.06,
      "duration_seconds": 3.35,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.0,
      "end_seconds": 95.28,
      "duration_seconds": 11.28,
      "text": "About a three out of ten. Oh, and a fever. Had that since last night. There's a very sore throat as well."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.72,
      "end_seconds": 111.04,
      "duration_seconds": 3.32,
      "text": "Have you had rash, by any chance?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.85,
      "end_seconds": 116.85,
      "duration_seconds": 4.0,
      "text": "No, uh, I haven't had any rash."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.55,
      "end_seconds": 123.06,
      "duration_seconds": 4.51,
      "text": "Any difficulty breathing, jaundice or tummy pain on the left?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.75,
      "end_seconds": 132.02,
      "duration_seconds": 7.27,
      "text": "Okay, so no difficulty breathing, jaundice or tummy pain on the left, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.09,
      "end_seconds": 136.05,
      "duration_seconds": 1.96,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.59,
      "end_seconds": 139.78,
      "duration_seconds": 3.19,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.17,
      "end_seconds": 144.31,
      "duration_seconds": 3.14,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.49,
      "end_seconds": 147.35,
      "duration_seconds": 1.86,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.85,
      "end_seconds": 151.79,
      "duration_seconds": 2.94,
      "text": "Alright, have you ever had an operation?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.64,
      "end_seconds": 159.97,
      "duration_seconds": 6.33,
      "text": "Yes, I had keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.51,
      "end_seconds": 164.24,
      "duration_seconds": 3.73,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.28,
      "end_seconds": 167.83,
      "duration_seconds": 1.55,
      "text": "I've got eczema"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.95,
      "end_seconds": 171.42,
      "duration_seconds": 2.47,
      "text": "Sure. Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.63,
      "end_seconds": 176.62,
      "duration_seconds": 3.99,
      "text": "Oh, I'm on hydrocortisone cream, when needed."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.49,
      "end_seconds": 188.33,
      "duration_seconds": 3.84,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.57,
      "end_seconds": 196.88,
      "duration_seconds": 4.31,
      "text": "I'm allergic to erythromycin, I get a rash."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.75,
      "end_seconds": 199.63,
      "duration_seconds": 1.88,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.46,
      "end_seconds": 203.25,
      "duration_seconds": 2.79,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.88,
      "end_seconds": 205.58,
      "duration_seconds": 1.7,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.44,
      "end_seconds": 209.77,
      "duration_seconds": 3.33,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.62,
      "end_seconds": 213.59,
      "duration_seconds": 1.97,
      "text": "shall I start the examination?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.5,
      "end_seconds": 217.39,
      "duration_seconds": 1.89,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.05,
      "end_seconds": 235.45,
      "duration_seconds": 6.4,
      "text": "Your tonsils are large with white coating and the glands in the neck are tender."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.26,
      "end_seconds": 241.03,
      "duration_seconds": 1.77,
      "text": "all finished, thank you"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.11,
      "end_seconds": 261.89,
      "duration_seconds": 12.78,
      "text": "From what you've told me and what I found, this looks most like glandular fever. Streptococcal tonsillitis is still possible. I'm going to order a blood count, for glandular fever."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 262.65,
      "end_seconds": 267.5,
      "duration_seconds": 4.85,
      "text": "We have a slot Wednesday at 10 am, if that works."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.37,
      "end_seconds": 271.91,
      "duration_seconds": 2.54,
      "text": "Wednesday, that works for me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.54,
      "end_seconds": 279.52,
      "duration_seconds": 5.98,
      "text": "I think a monospot test makes sense here, for sore throat and fatigue."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.43,
      "end_seconds": 284.28,
      "duration_seconds": 3.85,
      "text": "Let me think, okay, I'll do it."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.03,
      "end_seconds": 306.58,
      "duration_seconds": 20.55,
      "text": "Rest, plenty of fluids, and no contact sport for a month because of the spleen. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. One warning sign to remember: the symptoms get worse. In that case don't wait."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.32,
      "end_seconds": 309.25,
      "duration_seconds": 0.93,
      "text": "I understand"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.19,
      "end_seconds": 318.2,
      "duration_seconds": 7.01,
      "text": "see me again in two weeks. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.85,
      "end_seconds": 323.06,
      "duration_seconds": 4.21,
      "text": "actually, good, thanks, I'll see you then"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.27,
      "end_seconds": 325.5,
      "duration_seconds": 1.23,
      "text": "Look after yourself."
    }
  ]
}