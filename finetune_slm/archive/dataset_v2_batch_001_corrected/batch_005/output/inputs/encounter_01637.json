{
  "schema_version": "1.0",
  "encounter_id": "01637",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.53,
      "end_seconds": 5.87,
      "duration_seconds": 5.34,
      "text": "hello, you know, doctor i think it's my turn"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.9,
      "end_seconds": 12.0,
      "duration_seconds": 5.1,
      "text": "You're alright take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.6,
      "end_seconds": 20.05,
      "duration_seconds": 6.45,
      "text": "Doctor I've come along because I know the history if it it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.63,
      "end_seconds": 24.83,
      "duration_seconds": 3.2,
      "text": "please do. Extra information is always welcome"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 26.34,
      "end_seconds": 32.87,
      "duration_seconds": 6.53,
      "text": "doctor, it's a seizure last week. That's what we're worried about"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.58,
      "end_seconds": 36.72,
      "duration_seconds": 3.14,
      "text": "how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.66,
      "end_seconds": 43.74,
      "duration_seconds": 5.08,
      "text": "Uh, um, about three days, give or take."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 45.03,
      "end_seconds": 48.48,
      "duration_seconds": 3.45,
      "text": "It was closer to five days, doctor."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.98,
      "end_seconds": 54.31,
      "duration_seconds": 4.33,
      "text": "Okay, so roughly three to five days. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.34,
      "end_seconds": 58.48,
      "duration_seconds": 2.14,
      "text": "that sounds about right"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.08,
      "end_seconds": 71.61,
      "duration_seconds": 8.53,
      "text": "tell me a bit more about it: how bad it gets how often and whether anything makes it better or worse"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.61,
      "end_seconds": 81.01,
      "duration_seconds": 7.4,
      "text": "oh, you know, I'd call it it mild i'd say every other day"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.05,
      "end_seconds": 85.67,
      "duration_seconds": 3.62,
      "text": "has there been headache the next day too?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.39,
      "end_seconds": 108.79,
      "duration_seconds": 22.4,
      "text": "Yes, I have. About headache the next day, honestly, every other day. Hmm, and and I've been feeling groggy afterwards as well, for ten days. As for feeling groggy afterwards, pretty mild, if I'm being honest. I've also had a bitten tongue."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.03,
      "end_seconds": 129.72,
      "duration_seconds": 4.69,
      "text": "can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 131.01,
      "end_seconds": 142.28,
      "duration_seconds": 11.27,
      "text": "she takes levetiracetam, 500 milligrams, twice a day. I mean, she is on Eltroxin, every morning, I give it to to her"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.95,
      "end_seconds": 147.12,
      "duration_seconds": 2.17,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 148.88,
      "end_seconds": 161.03,
      "duration_seconds": 12.15,
      "text": "It's 100 micrograms. Let me think, um, she is on aspirin, 75 milligrams, once a day for my heart, I give it to her."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.86,
      "end_seconds": 164.62,
      "duration_seconds": 2.76,
      "text": "do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.54,
      "end_seconds": 186.88,
      "duration_seconds": 21.34,
      "text": "Yes, epilepsy. I didn't want to bother you but it keeps coming back. I've had an underactive thyroid, yes. I've had heart disease, yes. I've been reading about it it online and it worried me."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.9,
      "end_seconds": 198.47,
      "duration_seconds": 10.57,
      "text": "understood. Yes, an underactive thyroid is known to us, good to have that clear. Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.93,
      "end_seconds": 210.58,
      "duration_seconds": 10.65,
      "text": "I, I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.39,
      "end_seconds": 216.27,
      "duration_seconds": 4.88,
      "text": "tell me about your routine work habits that sort of thing"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.96,
      "end_seconds": 239.33,
      "duration_seconds": 21.37,
      "text": "I used to drink heavily but I stopped four years ago. I've never touched a cigarette. I'm a bus driver, so I sit for long hours. I walk the dog every morning. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.08,
      "end_seconds": 247.54,
      "duration_seconds": 6.46,
      "text": "Okay, have you had any loss of bladder control, head injury or fever?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.09,
      "end_seconds": 251.92,
      "duration_seconds": 3.83,
      "text": "erm, nope, nothing like that that"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.7,
      "end_seconds": 254.45,
      "duration_seconds": 1.75,
      "text": "Nothing like second seizure?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.92,
      "end_seconds": 261.03,
      "duration_seconds": 5.11,
      "text": "Right, not that I've noticed, no second seizure."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.38,
      "end_seconds": 264.92,
      "duration_seconds": 2.54,
      "text": "anything different when you pass water?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.93,
      "end_seconds": 269.76,
      "duration_seconds": 2.83,
      "text": "Oh, no, that's all fine."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.86,
      "end_seconds": 282.21,
      "duration_seconds": 4.35,
      "text": "Can I check a a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.49,
      "end_seconds": 296.15,
      "duration_seconds": 2.66,
      "text": "that's it just a little longer.."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.63,
      "end_seconds": 314.07,
      "duration_seconds": 6.44,
      "text": "okay: blood pressure 124 over 75, oxygen saturation is 98 percent, pulse 80."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.56,
      "end_seconds": 319.53,
      "duration_seconds": 3.97,
      "text": "I'll examine you in a second, make yourself comfortable"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.98,
      "end_seconds": 323.06,
      "duration_seconds": 2.08,
      "text": "I'm just checking this side"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.69,
      "end_seconds": 343.52,
      "duration_seconds": 3.83,
      "text": "you are alert and your neurological examination is normal"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.23,
      "end_seconds": 369.87,
      "duration_seconds": 21.64,
      "text": "that's all I needed to check. From what you've told me and what I found I think we're dealing with a breakthrough seizure after missed medication and poor sleep at this stage. The reason I say that is that your story and my examination fit together. We shouldn't forget a dose that is too low"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 383.55,
      "end_seconds": 396.74,
      "duration_seconds": 13.19,
      "text": "take your medicine at the same time every day and and do not drive until we say so i'd like you back in four weeks anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 398.42,
      "end_seconds": 401.63,
      "duration_seconds": 3.21,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 403.72,
      "end_seconds": 405.71,
      "duration_seconds": 1.99,
      "text": "so, see you soon"
    }
  ]
}