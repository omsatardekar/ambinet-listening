{
  "schema_version": "1.0",
  "encounter_id": "01916",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.55,
      "end_seconds": 6.69,
      "duration_seconds": 6.14,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.12,
      "end_seconds": 12.47,
      "duration_seconds": 4.35,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.83,
      "end_seconds": 23.84,
      "duration_seconds": 10.01,
      "text": "It's, It's a sore on my ankle that won't heal. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.54,
      "end_seconds": 27.76,
      "duration_seconds": 2.22,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.86,
      "end_seconds": 32.53,
      "duration_seconds": 2.67,
      "text": "It's been two weeks now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.74,
      "end_seconds": 35.43,
      "duration_seconds": 1.69,
      "text": "Anything that improves it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.2,
      "end_seconds": 39.17,
      "duration_seconds": 2.97,
      "text": "It settles a little with elevation."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.33,
      "end_seconds": 57.46,
      "duration_seconds": 4.13,
      "text": "Any spreading redness, chest pain or fever at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.44,
      "end_seconds": 62.25,
      "duration_seconds": 2.81,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.84,
      "end_seconds": 66.8,
      "duration_seconds": 3.96,
      "text": "Right, right. Have you had any calf pain?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.37,
      "end_seconds": 69.35,
      "duration_seconds": 1.98,
      "text": "No, no calf pain."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.32,
      "end_seconds": 76.57,
      "duration_seconds": 3.25,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.69,
      "end_seconds": 79.9,
      "duration_seconds": 2.21,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.56,
      "end_seconds": 93.37,
      "duration_seconds": 5.81,
      "text": "Have you got any known allergies? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.57,
      "end_seconds": 103.84,
      "duration_seconds": 9.27,
      "text": "Yes, kiwi. I've no idea what the reaction was, only that I'm not supposed to have it."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.93,
      "end_seconds": 106.39,
      "duration_seconds": 1.46,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.19,
      "end_seconds": 111.79,
      "duration_seconds": 3.6,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.64,
      "end_seconds": 114.75,
      "duration_seconds": 2.11,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.92,
      "end_seconds": 118.46,
      "duration_seconds": 2.54,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.37,
      "end_seconds": 122.52,
      "duration_seconds": 2.15,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.12,
      "end_seconds": 128.25,
      "duration_seconds": 4.13,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.66,
      "end_seconds": 130.89,
      "duration_seconds": 1.23,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.83,
      "end_seconds": 136.37,
      "duration_seconds": 4.54,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.17,
      "end_seconds": 139.53,
      "duration_seconds": 2.36,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.33,
      "end_seconds": 144.15,
      "duration_seconds": 2.82,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.94,
      "end_seconds": 162.2,
      "duration_seconds": 4.26,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.56,
      "end_seconds": 171.44,
      "duration_seconds": 3.88,
      "text": "Um, no, nothing I can think of."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.13,
      "end_seconds": 187.92,
      "duration_seconds": 2.79,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.13,
      "end_seconds": 196.23,
      "duration_seconds": 2.1,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.55,
      "end_seconds": 221.75,
      "duration_seconds": 10.2,
      "text": "Okay: pulse is 75 beats a minute, SpO2 98 percent on room air. And temperature is 36.5 degrees, blood pressure 110 over 79."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.64,
      "end_seconds": 226.21,
      "duration_seconds": 2.57,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.42,
      "end_seconds": 230.03,
      "duration_seconds": 2.61,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.44,
      "end_seconds": 252.54,
      "duration_seconds": 7.1,
      "text": "There is a shallow ulcer above the inner ankle with brown skin around it and visible varicose veins."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.54,
      "end_seconds": 283.93,
      "duration_seconds": 27.39,
      "text": "That's all I needed to check. Right, here's what I'm thinking. The most likely explanation is a venous leg ulcer. I think a doppler test of the leg pulses makes sense here, for leg ulcer. Compression bandaging and keeping the leg raised when sitting. One warning sign to remember: the symptoms get worse. In that case don't wait. I'll want another look in two weeks."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.01,
      "end_seconds": 291.47,
      "duration_seconds": 5.46,
      "text": "Sorry, what was I saying, okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.77,
      "end_seconds": 296.0,
      "duration_seconds": 3.23,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.9,
      "end_seconds": 300.35,
      "duration_seconds": 3.45,
      "text": "Okay, so alright, thanks, take care."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.38,
      "end_seconds": 306.77,
      "duration_seconds": 1.39,
      "text": "See you soon."
    }
  ]
}