  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.2,
      "end_seconds": 4.28,
      "duration_seconds": 3.08,
      "text": "Hello, come in. Mind the step."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.99,
      "end_seconds": 8.92,
      "duration_seconds": 2.93,
      "text": "Good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.52,
      "end_seconds": 13.16,
      "duration_seconds": 2.64,
      "text": "How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.32,
      "end_seconds": 19.41,
      "duration_seconds": 5.09,
      "text": "So, I've been putting on weight over the years, doctor."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.01,
      "end_seconds": 22.95,
      "duration_seconds": 1.94,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.02,
      "end_seconds": 28.37,
      "duration_seconds": 4.35,
      "text": "It's, It's been going on for five days."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.33,
      "end_seconds": 48.24,
      "duration_seconds": 2.91,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.6,
      "end_seconds": 53.27,
      "duration_seconds": 3.67,
      "text": "Okay, so no, nothing at the moment."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.37,
      "end_seconds": 60.12,
      "duration_seconds": 4.75,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 60.81,
      "end_seconds": 65.19,
      "duration_seconds": 4.38,
      "text": "No, you know, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.5,
      "end_seconds": 81.36,
      "duration_seconds": 4.86,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.3,
      "end_seconds": 87.78,
      "duration_seconds": 1.48,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.4,
      "end_seconds": 91.08,
      "duration_seconds": 1.68,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.65,
      "end_seconds": 94.01,
      "duration_seconds": 2.36,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.92,
      "end_seconds": 98.36,
      "duration_seconds": 2.44,
      "text": "Okay, how active are you?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.22,
      "end_seconds": 104.08,
      "duration_seconds": 3.86,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.64,
      "end_seconds": 108.52,
      "duration_seconds": 3.88,
      "text": "Have you noticed high thirst, low mood or palpitations?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 114.19,
      "end_seconds": 119.77,
      "duration_seconds": 5.58,
      "text": "Sorry, what was I saying, no, not a single one."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.24,
      "end_seconds": 124.09,
      "duration_seconds": 2.85,
      "text": "Did you notice any chest pain?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.23,
      "end_seconds": 127.17,
      "duration_seconds": 1.94,
      "text": "Definitely no chest pain."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.07,
      "end_seconds": 134.49,
      "duration_seconds": 2.42,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.34,
      "end_seconds": 142.23,
      "duration_seconds": 2.89,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.79,
      "end_seconds": 147.31,
      "duration_seconds": 4.52,
      "text": "Alright, can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.31,
      "end_seconds": 162.39,
      "duration_seconds": 3.08,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.85,
      "end_seconds": 192.55,
      "duration_seconds": 13.7,
      "text": "Okay: oxygen saturation is 97 percent, BP is 165 over 92, weight 53 kilos. And pulse 78, BMI works out to 19.0, height 167 centimetres, temp 36.7 degrees."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 196.11,
      "end_seconds": 200.9,
      "duration_seconds": 4.79,
      "text": "Sorry, what was I saying, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.46,
      "end_seconds": 204.87,
      "duration_seconds": 3.41,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.39,
      "end_seconds": 211.15,
      "duration_seconds": 4.76,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 220.0,
      "end_seconds": 221.1,
      "duration_seconds": 1.1,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.5,
      "end_seconds": 224.92,
      "duration_seconds": 2.42,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.09,
      "end_seconds": 244.55,
      "duration_seconds": 4.46,
      "text": "Your weight and waist measurement are both above the healthy range."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.11,
      "end_seconds": 252.68,
      "duration_seconds": 2.57,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.88,
      "end_seconds": 294.88,
      "duration_seconds": 34.0,
      "text": "We should do an HbA1c for obesity. We should do a cholesterol test for obesity. Aim for a loss of half a kilo a week with smaller portions and a daily thirty-minute walk. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. I think the weight management service should see you too. I'm not ordering a thyroid test today. If things carry on next month, we'll consider it."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.82,
      "end_seconds": 303.25,
      "duration_seconds": 6.43,
      "text": "Do get help quickly if the symptoms get worse. Book a review in three months."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 303.89,
      "end_seconds": 306.02,
      "duration_seconds": 2.13,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.38,
      "end_seconds": 310.78,
      "duration_seconds": 3.4,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 313.75,
      "end_seconds": 316.7,
      "duration_seconds": 2.95,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.13,
      "end_seconds": 320.5,
      "duration_seconds": 1.37,
      "text": "See you soon."
    }
  ]
}