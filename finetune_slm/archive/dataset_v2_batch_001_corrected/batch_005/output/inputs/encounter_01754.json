{
  "schema_version": "1.0",
  "encounter_id": "01754",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.35,
      "end_seconds": 4.39,
      "duration_seconds": 3.04,
      "text": "Hello, good to see you. Please sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.33,
      "end_seconds": 9.5,
      "duration_seconds": 4.17,
      "text": "Uh, hello, thanks for fitting me in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.95,
      "end_seconds": 15.89,
      "duration_seconds": 2.94,
      "text": "How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 17.84,
      "end_seconds": 27.42,
      "duration_seconds": 9.58,
      "text": "I'm here because of a curtain coming across my vision. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.69,
      "end_seconds": 32.43,
      "duration_seconds": 3.74,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.99,
      "end_seconds": 54.56,
      "duration_seconds": 21.57,
      "text": "I'd say one week. Actually, no, closer to about two weeks. I'd rather know what's going on than keep guessing. I've had blurred vision too, for about two weeks. I did have sudden new floaters at one point, um, but that's gone now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.86,
      "end_seconds": 59.89,
      "duration_seconds": 4.03,
      "text": "Did you get red eye, eye pain or recent injury?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.11,
      "end_seconds": 68.79,
      "duration_seconds": 4.68,
      "text": "Mm, no, I haven't had any of them."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.28,
      "end_seconds": 73.37,
      "duration_seconds": 4.09,
      "text": "Ah. Right, have you had headache, by any chance?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.34,
      "end_seconds": 77.81,
      "duration_seconds": 2.47,
      "text": "I haven't noticed any headache."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.93,
      "end_seconds": 81.35,
      "duration_seconds": 2.42,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.66,
      "end_seconds": 85.78,
      "duration_seconds": 1.12,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.62,
      "end_seconds": 88.64,
      "duration_seconds": 2.02,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 89.21,
      "end_seconds": 92.02,
      "duration_seconds": 2.81,
      "text": "Right, no, that's all fine."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.81,
      "end_seconds": 95.71,
      "duration_seconds": 2.9,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.33,
      "end_seconds": 101.14,
      "duration_seconds": 3.81,
      "text": "I had a bunion operation six years ago."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.68,
      "end_seconds": 119.34,
      "duration_seconds": 3.66,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.41,
      "end_seconds": 124.68,
      "duration_seconds": 3.27,
      "text": "It's diclofenac, 50 milligrams, when needed."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.78,
      "end_seconds": 128.31,
      "duration_seconds": 2.53,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.83,
      "end_seconds": 133.11,
      "duration_seconds": 3.28,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.17,
      "end_seconds": 141.34,
      "duration_seconds": 2.17,
      "text": "Right, how active are you?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.66,
      "end_seconds": 146.32,
      "duration_seconds": 3.66,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.2,
      "end_seconds": 158.59,
      "duration_seconds": 3.39,
      "text": "So, have you got any known allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.56,
      "end_seconds": 162.56,
      "duration_seconds": 3.0,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.25,
      "end_seconds": 166.55,
      "duration_seconds": 3.3,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 168.18,
      "end_seconds": 173.42,
      "duration_seconds": 5.24,
      "text": "I've had arthritis in my knees for two years now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.69,
      "end_seconds": 188.38,
      "duration_seconds": 13.69,
      "text": "I see, go ahead. Yes, arthritis in your knees is known to us, good to have that clear. What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 189.04,
      "end_seconds": 191.6,
      "duration_seconds": 2.56,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 192.72,
      "end_seconds": 204.66,
      "duration_seconds": 11.94,
      "text": "Here are the numbers, doctor. Pulse is 76 beats a minute, blood pressure 127 over 68. Respiratory rate 18, SpO2 97 percent on room air, temperature 36.7."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.34,
      "end_seconds": 206.69,
      "duration_seconds": 1.35,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.28,
      "end_seconds": 210.55,
      "duration_seconds": 2.27,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 211.3,
      "end_seconds": 212.38,
      "duration_seconds": 1.08,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.16,
      "end_seconds": 215.33,
      "duration_seconds": 1.17,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.65,
      "end_seconds": 237.88,
      "duration_seconds": 7.23,
      "text": "The vision in the right eye is much reduced and the field is cut off at the top."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 238.76,
      "end_seconds": 239.86,
      "duration_seconds": 1.1,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.99,
      "end_seconds": 245.71,
      "duration_seconds": 1.72,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.03,
      "end_seconds": 280.38,
      "duration_seconds": 27.35,
      "text": "Let me tell you where I've got to. It fits best with a possible retinal detachment needing urgent surgery. Let's get an urgent eye examination, for possible retinal detachment. You need to be seen by the eye surgeons today, please don't eat or drink. I'm going to send a referral to the eye emergency service."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 282.46,
      "end_seconds": 283.16,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.63,
      "end_seconds": 300.23,
      "duration_seconds": 15.6,
      "text": "Please don't wait if the symptoms get worse. That's when to be seen urgently. Please come and see me straight away. Tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 300.73,
      "end_seconds": 304.9,
      "duration_seconds": 4.17,
      "text": "So, I come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.86,
      "end_seconds": 312.49,
      "duration_seconds": 4.63,
      "text": "Yes, exactly right. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 313.21,
      "end_seconds": 317.37,
      "duration_seconds": 4.16,
      "text": "Yeah, good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.34,
      "end_seconds": 319.71,
      "duration_seconds": 1.37,
      "text": "All the best."
    }
  ]
}