{
  "schema_version": "1.0",
  "encounter_id": "01647",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.21,
      "end_seconds": 4.29,
      "duration_seconds": 3.08,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.96,
      "end_seconds": 9.97,
      "duration_seconds": 5.01,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.35,
      "end_seconds": 14.2,
      "duration_seconds": 2.85,
      "text": "It's a dry mouth, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.03,
      "end_seconds": 23.33,
      "duration_seconds": 7.3,
      "text": "When was the first time you noticed it? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.96,
      "end_seconds": 27.61,
      "duration_seconds": 3.65,
      "text": "It's been going on for about a month."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.49,
      "end_seconds": 32.96,
      "duration_seconds": 3.47,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.65,
      "end_seconds": 36.4,
      "duration_seconds": 1.75,
      "text": "Moderate, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.97,
      "end_seconds": 40.43,
      "duration_seconds": 2.46,
      "text": "Have you been feeling very weak?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.47,
      "end_seconds": 43.59,
      "duration_seconds": 1.12,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.98,
      "end_seconds": 62.07,
      "duration_seconds": 4.09,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.6,
      "end_seconds": 65.13,
      "duration_seconds": 1.53,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.32,
      "end_seconds": 68.41,
      "duration_seconds": 2.09,
      "text": "So, do you smoke?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.28,
      "end_seconds": 73.15,
      "duration_seconds": 3.87,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.42,
      "end_seconds": 76.12,
      "duration_seconds": 1.7,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.69,
      "end_seconds": 79.61,
      "duration_seconds": 2.92,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.31,
      "end_seconds": 82.68,
      "duration_seconds": 1.37,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.13,
      "end_seconds": 87.66,
      "duration_seconds": 3.53,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.6,
      "end_seconds": 89.82,
      "duration_seconds": 1.22,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.13,
      "end_seconds": 94.16,
      "duration_seconds": 3.03,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.61,
      "end_seconds": 97.55,
      "duration_seconds": 1.94,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.17,
      "end_seconds": 118.17,
      "duration_seconds": 19.0,
      "text": "I take hydrochlorothiazide, 12.5 milligrams, every morning for my pressure. Let me think, I'm on oral rehydration salts, 1 sachet, after each loose stool. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.34,
      "end_seconds": 121.66,
      "duration_seconds": 2.32,
      "text": "When did you start it?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.77,
      "end_seconds": 127.84,
      "duration_seconds": 2.07,
      "text": "About a month now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.37,
      "end_seconds": 132.94,
      "duration_seconds": 4.57,
      "text": "Okay, what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.53,
      "end_seconds": 139.7,
      "duration_seconds": 5.17,
      "text": "I've had high blood pressure for about a year now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.96,
      "end_seconds": 146.13,
      "duration_seconds": 5.17,
      "text": "Okay, I can see high blood pressure in your file as well."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.02,
      "end_seconds": 164.32,
      "duration_seconds": 5.3,
      "text": "A few quick ones: chest pain, confusion, blood in the stool or fever?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.7,
      "end_seconds": 172.06,
      "duration_seconds": 6.36,
      "text": "No chest pain, confusion, blood in the stool or fever, none of it."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.02,
      "end_seconds": 176.73,
      "duration_seconds": 3.71,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.7,
      "end_seconds": 180.49,
      "duration_seconds": 1.79,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.16,
      "end_seconds": 183.22,
      "duration_seconds": 2.06,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.62,
      "end_seconds": 196.74,
      "duration_seconds": 2.12,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.41,
      "end_seconds": 214.71,
      "duration_seconds": 5.3,
      "text": "Okay: respiratory rate 17, pulse 102, blood pressure 92 over 58."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.57,
      "end_seconds": 221.9,
      "duration_seconds": 4.33,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.56,
      "end_seconds": 224.05,
      "duration_seconds": 1.49,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.62,
      "end_seconds": 227.99,
      "duration_seconds": 2.37,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.07,
      "end_seconds": 246.05,
      "duration_seconds": 6.98,
      "text": "Your mouth is dry, your skin is slack, and your blood pressure drops when you stand."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.53,
      "end_seconds": 254.33,
      "duration_seconds": 2.8,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.82,
      "end_seconds": 286.08,
      "duration_seconds": 19.26,
      "text": "Taking everything into account, it points towards dehydration from gastroenteritis. I'm going to order blood tests, for dehydration. Sip fluids little and often and hold your water tablet until you are eating again. I'd like to see you again in two days."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.75,
      "end_seconds": 293.32,
      "duration_seconds": 5.57,
      "text": "Yeah, uh, I'll book it on my way out."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.58,
      "end_seconds": 298.47,
      "duration_seconds": 3.89,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.67,
      "end_seconds": 305.71,
      "duration_seconds": 4.04,
      "text": "Yeah, okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.22,
      "end_seconds": 307.43,
      "duration_seconds": 1.21,
      "text": "See you soon."
    }
  ]
}