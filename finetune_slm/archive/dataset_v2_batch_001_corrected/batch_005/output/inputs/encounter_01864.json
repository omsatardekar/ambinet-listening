{
  "schema_version": "1.0",
  "encounter_id": "01864",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.15,
      "end_seconds": 5.2,
      "duration_seconds": 4.05,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.79,
      "end_seconds": 10.63,
      "duration_seconds": 4.84,
      "text": "Right, come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.37,
      "end_seconds": 18.49,
      "duration_seconds": 7.12,
      "text": "I wanted to get vomiting looked at. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.51,
      "end_seconds": 21.77,
      "duration_seconds": 2.26,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.25,
      "end_seconds": 26.8,
      "duration_seconds": 3.55,
      "text": "Yesterday, it came on out of nowhere."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.27,
      "end_seconds": 31.01,
      "duration_seconds": 3.74,
      "text": "Hm, okay. How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.94,
      "end_seconds": 32.96,
      "duration_seconds": 1.02,
      "text": "Moderate, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.04,
      "end_seconds": 38.4,
      "duration_seconds": 3.36,
      "text": "Has there been a fast heart too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.06,
      "end_seconds": 41.28,
      "duration_seconds": 1.22,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.13,
      "end_seconds": 46.62,
      "duration_seconds": 3.49,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.33,
      "end_seconds": 50.21,
      "duration_seconds": 2.88,
      "text": "About a six out of ten."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.56,
      "end_seconds": 51.48,
      "duration_seconds": 0.92,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.7,
      "end_seconds": 63.31,
      "duration_seconds": 3.61,
      "text": "Did you get black stools, fever or yellow eyes?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.92,
      "end_seconds": 70.77,
      "duration_seconds": 5.85,
      "text": "No black stools, fever or yellow eyes, none of it."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.27,
      "end_seconds": 73.89,
      "duration_seconds": 2.62,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.01,
      "end_seconds": 76.0,
      "duration_seconds": 0.99,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.94,
      "end_seconds": 80.94,
      "duration_seconds": 4.0,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.38,
      "end_seconds": 92.15,
      "duration_seconds": 5.77,
      "text": "Sorry, what was I saying, no, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.15,
      "end_seconds": 98.17,
      "duration_seconds": 2.02,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.12,
      "end_seconds": 100.37,
      "duration_seconds": 1.25,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.86,
      "end_seconds": 112.0,
      "duration_seconds": 3.14,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.83,
      "end_seconds": 116.57,
      "duration_seconds": 3.74,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.7,
      "end_seconds": 119.83,
      "duration_seconds": 2.13,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.29,
      "end_seconds": 127.44,
      "duration_seconds": 6.15,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.21,
      "end_seconds": 141.84,
      "duration_seconds": 3.63,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.99,
      "end_seconds": 155.99,
      "duration_seconds": 3.0,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.01,
      "end_seconds": 180.12,
      "duration_seconds": 14.11,
      "text": "Okay: respiratory rate 20, blood pressure 113 over 76, BMI works out to 20.5, pulse 124, saturation 99 percent, temp 36.9 degrees, weight 68 kilos, height 182 centimetres."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.0,
      "end_seconds": 183.98,
      "duration_seconds": 2.98,
      "text": "Mm, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.52,
      "end_seconds": 187.94,
      "duration_seconds": 2.42,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.1,
      "end_seconds": 194.38,
      "duration_seconds": 4.28,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.29,
      "end_seconds": 197.53,
      "duration_seconds": 2.24,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.49,
      "end_seconds": 214.57,
      "duration_seconds": 4.08,
      "text": "Your upper tummy is very tender and you look dehydrated."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.66,
      "end_seconds": 218.55,
      "duration_seconds": 1.89,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.38,
      "end_seconds": 242.75,
      "duration_seconds": 11.37,
      "text": "Okay, so my impression is this: It's hard to say. Acute pancreatitis is one possibility and gallstone disease another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.05,
      "end_seconds": 247.44,
      "duration_seconds": 3.39,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.22,
      "end_seconds": 265.22,
      "duration_seconds": 16.0,
      "text": "I understand the worry. At the moment I'd say it's acute pancreatitis, and we'll know more once the an abdominal scan is back. I'll request an abdominal scan, it'll help with pancreatitis."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.59,
      "end_seconds": 269.06,
      "duration_seconds": 2.47,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.9,
      "end_seconds": 285.24,
      "duration_seconds": 14.34,
      "text": "You need admission for fluids and pain relief, nothing to eat for now. Please don't wait if the symptoms get worse. That's when to be seen urgently. I'd like you back straight away."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.52,
      "end_seconds": 289.66,
      "duration_seconds": 3.14,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.93,
      "end_seconds": 296.08,
      "duration_seconds": 5.15,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.14,
      "end_seconds": 300.27,
      "duration_seconds": 2.13,
      "text": "Thank you, that's helpful."
    }
  ]
}