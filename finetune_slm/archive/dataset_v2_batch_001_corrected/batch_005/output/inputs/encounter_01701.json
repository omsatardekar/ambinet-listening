{
  "schema_version": "1.0",
  "encounter_id": "01701",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.73,
      "end_seconds": 5.19,
      "duration_seconds": 4.46,
      "text": "Um, sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.97,
      "end_seconds": 10.74,
      "duration_seconds": 3.77,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.45,
      "end_seconds": 16.87,
      "duration_seconds": 4.42,
      "text": "Mainly I've been feeling unwell. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.61,
      "end_seconds": 20.33,
      "duration_seconds": 1.72,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.49,
      "end_seconds": 30.2,
      "duration_seconds": 8.71,
      "text": "Probably six months. Yeah. I've had a painful blistering rash on one side too, for two months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.01,
      "end_seconds": 34.8,
      "duration_seconds": 2.79,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.7,
      "end_seconds": 51.25,
      "duration_seconds": 2.55,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.45,
      "end_seconds": 80.82,
      "duration_seconds": 9.37,
      "text": "Okay: pulse is 69 beats a minute, BP is 126 over 79, respiratory rate 17. And temp 36.8 degrees."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.62,
      "end_seconds": 85.88,
      "duration_seconds": 3.26,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.84,
      "end_seconds": 90.69,
      "duration_seconds": 2.85,
      "text": "Right, I'm just checking this side."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.53,
      "end_seconds": 110.34,
      "duration_seconds": 8.81,
      "text": "There are grouped blisters on a red base along one band on the right side and none cross the midline."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.33,
      "end_seconds": 119.44,
      "duration_seconds": 3.11,
      "text": "Okay, good, you can sit up again."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.74,
      "end_seconds": 138.25,
      "duration_seconds": 2.51,
      "text": "Alright, have you had any fever?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.46,
      "end_seconds": 142.67,
      "duration_seconds": 3.21,
      "text": "No, um, none, no fever."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.04,
      "end_seconds": 148.94,
      "duration_seconds": 4.9,
      "text": "Have you had any eye involvement, weakness or rash across the midline?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.23,
      "end_seconds": 152.45,
      "duration_seconds": 2.22,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.88,
      "end_seconds": 156.99,
      "duration_seconds": 3.11,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.37,
      "end_seconds": 161.76,
      "duration_seconds": 3.39,
      "text": "Hmm, no, joints are fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.45,
      "end_seconds": 164.89,
      "duration_seconds": 2.44,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.51,
      "end_seconds": 167.25,
      "duration_seconds": 1.74,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.9,
      "end_seconds": 173.91,
      "duration_seconds": 5.01,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.64,
      "end_seconds": 179.36,
      "duration_seconds": 3.72,
      "text": "Actually, I've never had an allergy."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.78,
      "end_seconds": 183.31,
      "duration_seconds": 2.53,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.01,
      "end_seconds": 190.66,
      "duration_seconds": 3.65,
      "text": "I have depression, for nearly five years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.36,
      "end_seconds": 197.12,
      "duration_seconds": 4.76,
      "text": "Okay, I can see depression in your file as well."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.63,
      "end_seconds": 213.3,
      "duration_seconds": 2.67,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.36,
      "end_seconds": 222.47,
      "duration_seconds": 7.11,
      "text": "It's, It's sertraline, 50 milligrams, once a day. It's paracetamol, when needed."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.0,
      "end_seconds": 226.2,
      "duration_seconds": 2.2,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.39,
      "end_seconds": 232.03,
      "duration_seconds": 4.64,
      "text": "1 gram, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.62,
      "end_seconds": 237.96,
      "duration_seconds": 4.34,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.44,
      "end_seconds": 251.45,
      "duration_seconds": 12.01,
      "text": "I'm vegetarian and have been for years. Not much, I mostly stay in these days. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.99,
      "end_seconds": 256.4,
      "duration_seconds": 3.41,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.45,
      "end_seconds": 263.54,
      "duration_seconds": 6.09,
      "text": "Oh, I had a caesarean for my second baby nine years ago."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.9,
      "end_seconds": 300.1,
      "duration_seconds": 32.2,
      "text": "Taking everything into account, I don't have a clear answer today: shingles is possible, and so is contact dermatitis. I'm going to put you on aciclovir, 800 milligrams, five times a day, seven days. That's for shingles. Keep the rash covered and stay away from pregnant women and newborn babies until it has crusted. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.19,
      "end_seconds": 316.33,
      "duration_seconds": 15.14,
      "text": "The thing that would worry me is if the rash spreads to your face or eye. If that happens, go to emergency. We'll catch up in one week. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.16,
      "end_seconds": 321.94,
      "duration_seconds": 4.78,
      "text": "Good, um, thanks, I'll see you then."
    }
  ]
}