{
  "schema_version": "1.0",
  "encounter_id": "01943",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.24,
      "end_seconds": 4.7,
      "duration_seconds": 3.46,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.71,
      "end_seconds": 10.49,
      "duration_seconds": 3.78,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.29,
      "end_seconds": 27.34,
      "duration_seconds": 15.05,
      "text": "I've been feeling tired after the birth, and I wanted to get it checked i wasn't sure whether to come in at all, to be honest i told my wife I'd come today"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.86,
      "end_seconds": 31.2,
      "duration_seconds": 3.34,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.34,
      "end_seconds": 36.44,
      "duration_seconds": 4.1,
      "text": "Um, I've had it since last night."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.83,
      "end_seconds": 42.63,
      "duration_seconds": 2.8,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.41,
      "end_seconds": 45.23,
      "duration_seconds": 1.82,
      "text": "I'd call it severe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.12,
      "end_seconds": 51.93,
      "duration_seconds": 5.81,
      "text": "Have you had any fever, leg swelling or thoughts of harming the baby?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.88,
      "end_seconds": 60.52,
      "duration_seconds": 6.64,
      "text": "I haven't had fever, leg swelling or thoughts of harming the baby, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.51,
      "end_seconds": 65.97,
      "duration_seconds": 3.46,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.03,
      "end_seconds": 69.98,
      "duration_seconds": 1.95,
      "text": "no, that's all normal"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.61,
      "end_seconds": 75.36,
      "duration_seconds": 3.75,
      "text": "on the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.16,
      "end_seconds": 79.38,
      "duration_seconds": 2.22,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.17,
      "end_seconds": 87.4,
      "duration_seconds": 4.23,
      "text": "are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.19,
      "end_seconds": 90.67,
      "duration_seconds": 1.48,
      "text": "no known allergies"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.65,
      "end_seconds": 101.61,
      "duration_seconds": 1.96,
      "text": "let's run through your medicines"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.34,
      "end_seconds": 118.16,
      "duration_seconds": 11.82,
      "text": "It's allopurinol, 100 milligrams, once a day for the gout. I looked a few things up online, and and that probably didn't help."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.03,
      "end_seconds": 122.2,
      "duration_seconds": 3.17,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.71,
      "end_seconds": 125.2,
      "duration_seconds": 2.49,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.96,
      "end_seconds": 131.31,
      "duration_seconds": 2.35,
      "text": "have you ever had an operation?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.74,
      "end_seconds": 138.28,
      "duration_seconds": 5.54,
      "text": "I had a caesarean for my second baby nine years ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.74,
      "end_seconds": 155.63,
      "duration_seconds": 3.89,
      "text": "What do you do during the the day?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.53,
      "end_seconds": 160.68,
      "duration_seconds": 3.15,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.58,
      "end_seconds": 165.31,
      "duration_seconds": 3.73,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.45,
      "end_seconds": 169.81,
      "duration_seconds": 3.36,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.8,
      "end_seconds": 191.55,
      "duration_seconds": 2.75,
      "text": "do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.16,
      "end_seconds": 200.33,
      "duration_seconds": 7.17,
      "text": "I have gout, for nearly five years. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.76,
      "end_seconds": 209.31,
      "duration_seconds": 7.55,
      "text": "Okay, I can see gout in your file as well. I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.61,
      "end_seconds": 222.69,
      "duration_seconds": 2.08,
      "text": "okay, this won't take long.."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.03,
      "end_seconds": 242.62,
      "duration_seconds": 7.59,
      "text": "Okay: saturation 98 percent, respiratory rate 16, temp 36.7 degrees, pressure 112 over 79, heart rate 82."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.42,
      "end_seconds": 269.78,
      "duration_seconds": 8.36,
      "text": "Let me tell you where I've got to. This looks most like a a normal postnatal recovery."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.48,
      "end_seconds": 272.97,
      "duration_seconds": 1.49,
      "text": "is this permanent?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.64,
      "end_seconds": 295.42,
      "duration_seconds": 21.78,
      "text": "It's reasonable to be concerned, but right now a normal postnatal recovery is my leading thought, not anything worse. A blood count is what I'd like next, for postnatal tiredness. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.13,
      "end_seconds": 299.1,
      "duration_seconds": 1.97,
      "text": "Is that done today?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.12,
      "end_seconds": 303.04,
      "duration_seconds": 2.92,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.62,
      "end_seconds": 307.52,
      "duration_seconds": 2.9,
      "text": "I think I understand everything. Thanks."
    }
  ]
}