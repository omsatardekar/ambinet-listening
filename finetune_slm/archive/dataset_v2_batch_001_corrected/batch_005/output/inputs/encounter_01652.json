{
  "schema_version": "1.0",
  "encounter_id": "01652",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.38,
      "end_seconds": 9.08,
      "duration_seconds": 7.7,
      "text": "I mean, doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.85,
      "end_seconds": 14.55,
      "duration_seconds": 4.7,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 15.88,
      "end_seconds": 27.22,
      "duration_seconds": 11.34,
      "text": "Hello, doctor, I came in with them, if that's okay. Doctor, it's aching muscles in my thighs. That's what we're worried about."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.03,
      "end_seconds": 30.92,
      "duration_seconds": 2.89,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.63,
      "end_seconds": 35.64,
      "duration_seconds": 4.01,
      "text": "Well, it's been like this since last Tuesday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.44,
      "end_seconds": 42.5,
      "duration_seconds": 2.06,
      "text": "Is anything making it worse?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.01,
      "end_seconds": 46.21,
      "duration_seconds": 3.2,
      "text": "I notice it more with stairs."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.79,
      "end_seconds": 48.87,
      "duration_seconds": 2.08,
      "text": "Have you been feeling tired?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.92,
      "end_seconds": 52.62,
      "duration_seconds": 1.7,
      "text": "Yeah, that too."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.28,
      "end_seconds": 56.64,
      "duration_seconds": 3.36,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.31,
      "end_seconds": 66.28,
      "duration_seconds": 7.97,
      "text": "Well, um, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.11,
      "end_seconds": 73.35,
      "duration_seconds": 5.24,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.07,
      "end_seconds": 87.91,
      "duration_seconds": 13.84,
      "text": "Moderate, really. Mm, um, as for muscle weakness, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "UNKNOWN",
      "start_seconds": 88.76,
      "end_seconds": 91.68,
      "duration_seconds": 2.92,
      "text": "Mm, that's what happened, yes."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.6,
      "end_seconds": 97.99,
      "duration_seconds": 5.39,
      "text": "Have you had any joint swelling, rash, fever or chest pain?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.63,
      "end_seconds": 112.41,
      "duration_seconds": 12.78,
      "text": "No, no joint swelling, no rash, no fever. I did have dark urine once at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.44,
      "end_seconds": 116.88,
      "duration_seconds": 2.44,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.93,
      "end_seconds": 119.77,
      "duration_seconds": 1.84,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.01,
      "end_seconds": 125.02,
      "duration_seconds": 4.01,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.4,
      "end_seconds": 127.75,
      "duration_seconds": 1.35,
      "text": "Yes, naproxen."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.72,
      "end_seconds": 131.11,
      "duration_seconds": 1.39,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.45,
      "end_seconds": 140.59,
      "duration_seconds": 4.14,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.11,
      "end_seconds": 143.63,
      "duration_seconds": 2.52,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.33,
      "end_seconds": 149.4,
      "duration_seconds": 4.07,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.48,
      "end_seconds": 155.85,
      "duration_seconds": 4.37,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.44,
      "end_seconds": 158.62,
      "duration_seconds": 2.18,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.46,
      "end_seconds": 163.27,
      "duration_seconds": 3.81,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.23,
      "end_seconds": 172.0,
      "duration_seconds": 4.77,
      "text": "Simvastatin, 20 milligrams, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 174.03,
      "end_seconds": 181.33,
      "duration_seconds": 7.3,
      "text": "Mm, that's what's prescribed, but I'm not sure he takes it every day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.81,
      "end_seconds": 187.43,
      "duration_seconds": 4.62,
      "text": "Eltroxin. I take it 100 micrograms, every morning."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.02,
      "end_seconds": 191.07,
      "duration_seconds": 2.05,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.98,
      "end_seconds": 208.23,
      "duration_seconds": 15.25,
      "text": "Let me think, you know, just keyhole surgery on my gallbladder, two years back. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.64,
      "end_seconds": 213.16,
      "duration_seconds": 3.52,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.23,
      "end_seconds": 227.0,
      "duration_seconds": 12.77,
      "text": "I have high cholesterol, for about ten years. Um, I've had an underactive thyroid for five years now. I've had COPD, yes."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.0,
      "end_seconds": 232.92,
      "duration_seconds": 4.92,
      "text": "Alright, an underactive thyroid and COPD, that matches what I have here."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.98,
      "end_seconds": 253.68,
      "duration_seconds": 3.7,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.19,
      "end_seconds": 265.56,
      "duration_seconds": 2.37,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.21,
      "end_seconds": 287.56,
      "duration_seconds": 11.35,
      "text": "Okay: blood pressure 121 over 78, pulse is 83 beats a minute, respiratory rate 14, temperature 36.6, oxygen saturation is 98 percent."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.83,
      "end_seconds": 294.09,
      "duration_seconds": 4.26,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.05,
      "end_seconds": 297.38,
      "duration_seconds": 1.33,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.03,
      "end_seconds": 316.89,
      "duration_seconds": 4.86,
      "text": "The thigh muscles are tender and the strength is slightly reduced."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.96,
      "end_seconds": 321.05,
      "duration_seconds": 2.09,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.55,
      "end_seconds": 357.55,
      "duration_seconds": 22.0,
      "text": "Right, here's what I'm thinking. I'd lean towards muscle symptoms possibly from the cholesterol tablet. The reason I say that is that your story and my examination fit together. I can't rule out low vitamin D yet. I can't rule out a low thyroid yet."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.51,
      "end_seconds": 361.71,
      "duration_seconds": 3.2,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.12,
      "end_seconds": 382.11,
      "duration_seconds": 15.99,
      "text": "I understand the worry. At the moment I'd say it's muscle symptoms possibly from the cholesterol tablet, and we'll know more once the a vitamin D level is back. Have you had any tests for this so far?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 383.05,
      "end_seconds": 392.45,
      "duration_seconds": 9.4,
      "text": "Yeah, um, I did have a vitamin D level done last year, but the paper's at home."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 393.68,
      "end_seconds": 397.13,
      "duration_seconds": 3.45,
      "text": "Let's get a thyroid test, for muscle aches."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 398.67,
      "end_seconds": 403.16,
      "duration_seconds": 4.49,
      "text": "We have a slot Tuesday at 3:30 pm, if that works."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 404.49,
      "end_seconds": 407.55,
      "duration_seconds": 3.06,
      "text": "Tuesday, that works for me."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 408.75,
      "end_seconds": 426.76,
      "duration_seconds": 18.01,
      "text": "I'm going to order a creatine kinase test, for muscle aches. We will pause the statin for a few weeks while we check the blood tests. See me again after the results. How would you describe the plan, so we're on the same page?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 429.77,
      "end_seconds": 435.16,
      "duration_seconds": 5.39,
      "text": "So, I come back after the results. Is that right?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 439.49,
      "end_seconds": 446.38,
      "duration_seconds": 6.89,
      "text": "Yes, exactly right. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 447.17,
      "end_seconds": 450.22,
      "duration_seconds": 3.05,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 451.3,
      "end_seconds": 452.6,
      "duration_seconds": 1.3,
      "text": "Goodbye for now."
    }
  ]
}