{
  "schema_version": "1.0",
  "encounter_id": "01603",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.34,
      "end_seconds": 4.55,
      "duration_seconds": 3.21,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.28,
      "end_seconds": 9.97,
      "duration_seconds": 3.69,
      "text": "yes, have a seat tell me what's going on"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.67,
      "end_seconds": 18.29,
      "duration_seconds": 6.62,
      "text": "doctor, um, I'll sit in if that's okay, I know what's been happening"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.19,
      "end_seconds": 25.22,
      "duration_seconds": 5.03,
      "text": "of course, please stay it's helpful to have you here"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.12,
      "end_seconds": 36.6,
      "duration_seconds": 6.48,
      "text": "I'm, I'm here because of a painful blistering rash on one side"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.64,
      "end_seconds": 41.84,
      "duration_seconds": 4.2,
      "text": "Can you tell me when it it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.4,
      "end_seconds": 50.08,
      "duration_seconds": 7.68,
      "text": "for about two weeks I'd say. I've had burning pain before the rash too for four weeks"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.26,
      "end_seconds": 53.28,
      "duration_seconds": 2.02,
      "text": "have you been feeling unwell?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.22,
      "end_seconds": 61.07,
      "duration_seconds": 6.85,
      "text": "Mm, yes. As for feeling unwell, about a a seven out of ten."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.36,
      "end_seconds": 69.28,
      "duration_seconds": 3.92,
      "text": "has there been sensitivity to clothes touching too?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.89,
      "end_seconds": 75.9,
      "duration_seconds": 5.01,
      "text": "yes, you know, about the same, about four days"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.55,
      "end_seconds": 79.95,
      "duration_seconds": 3.4,
      "text": "how strong would you say it it is?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.04,
      "end_seconds": 83.08,
      "duration_seconds": 1.04,
      "text": "Mostly severe."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.7,
      "end_seconds": 92.79,
      "duration_seconds": 2.09,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.97,
      "end_seconds": 108.65,
      "duration_seconds": 2.68,
      "text": "sit still for a a moment.."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.46,
      "end_seconds": 135.37,
      "duration_seconds": 4.91,
      "text": "okay: pressure 112 over 80, pulse 66, saturation 97 percent"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.2,
      "end_seconds": 138.77,
      "duration_seconds": 1.57,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.4,
      "end_seconds": 143.2,
      "duration_seconds": 2.8,
      "text": "we'll look at it together shortly"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.1,
      "end_seconds": 147.08,
      "duration_seconds": 1.98,
      "text": "shall I start the examination?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.21,
      "end_seconds": 150.5,
      "duration_seconds": 2.29,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.61,
      "end_seconds": 176.39,
      "duration_seconds": 8.78,
      "text": "there are grouped blisters on a red base along one band on the right side and none cross the midline"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.22,
      "end_seconds": 184.92,
      "duration_seconds": 2.7,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.36,
      "end_seconds": 199.45,
      "duration_seconds": 5.09,
      "text": "have you had any eye involvement or rash across the midline?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.13,
      "end_seconds": 207.03,
      "duration_seconds": 6.9,
      "text": "well, I haven't had eye involvement or rash across the midline, no"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.15,
      "end_seconds": 212.43,
      "duration_seconds": 4.28,
      "text": "Let me check a few things. Any weakness or fever?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.22,
      "end_seconds": 215.84,
      "duration_seconds": 2.62,
      "text": "No, no weakness or fever."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.49,
      "end_seconds": 221.14,
      "duration_seconds": 3.65,
      "text": "So how about your heart any problems like that?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.67,
      "end_seconds": 224.78,
      "duration_seconds": 2.11,
      "text": "no that's been fine"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.55,
      "end_seconds": 229.32,
      "duration_seconds": 3.77,
      "text": "what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.62,
      "end_seconds": 236.54,
      "duration_seconds": 5.92,
      "text": "my daughter has type 1 diabetes. Right, my grandfather had a stroke"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.88,
      "end_seconds": 242.22,
      "duration_seconds": 4.34,
      "text": "Right, do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.74,
      "end_seconds": 248.68,
      "duration_seconds": 5.94,
      "text": "Yeah, I'm on sumatriptan, 50 milligrams, when needed for my migraines."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 250.44,
      "end_seconds": 259.5,
      "duration_seconds": 9.06,
      "text": "doctor, I think the last prescription for the sumatriptan was 100 milligrams we changed it it at the last visit"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.53,
      "end_seconds": 266.16,
      "duration_seconds": 4.63,
      "text": "so hm do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.1,
      "end_seconds": 278.6,
      "duration_seconds": 11.5,
      "text": "mm, no, I left it at home. Allopurinol i take it 100 milligrams, once a day. Paracetamol, 1 gram, when needed"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.27,
      "end_seconds": 282.94,
      "duration_seconds": 2.67,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.01,
      "end_seconds": 295.78,
      "duration_seconds": 11.77,
      "text": "Yes, I work in a bakery, early starts. I live with my elderly mother. Not much, I mostly stay in these days"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.17,
      "end_seconds": 298.53,
      "duration_seconds": 1.36,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.32,
      "end_seconds": 302.32,
      "duration_seconds": 3.0,
      "text": "no I've never been operated on"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.78,
      "end_seconds": 308.04,
      "duration_seconds": 4.26,
      "text": "are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.95,
      "end_seconds": 319.91,
      "duration_seconds": 10.96,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.04,
      "end_seconds": 329.95,
      "duration_seconds": 3.91,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.98,
      "end_seconds": 333.41,
      "duration_seconds": 1.43,
      "text": "I have migraines"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.33,
      "end_seconds": 338.03,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.93,
      "end_seconds": 346.74,
      "duration_seconds": 7.81,
      "text": "I've, I've had gout for two years now. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.72,
      "end_seconds": 349.7,
      "duration_seconds": 0.98,
      "text": "hm okay"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.47,
      "end_seconds": 366.12,
      "duration_seconds": 8.65,
      "text": "right, here's what I'm thinking. This looks most like shingles. It could also be contact dermatitis, so we'll keep that open"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 367.49,
      "end_seconds": 371.07,
      "duration_seconds": 3.58,
      "text": "Oh do you think it's something serious?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 372.15,
      "end_seconds": 399.52,
      "duration_seconds": 27.37,
      "text": "nothing I've seen today points to an emergency. It looks like shingles. What I'm giving you is aciclovir, 800 milligrams, five times a day, seven days. You take it by mouth. That's for shingles. Keep the rash covered and stay away from pregnant women and newborn babies until it has crusted. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 401.05,
      "end_seconds": 411.89,
      "duration_seconds": 10.84,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. See me again in one week."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 413.32,
      "end_seconds": 414.02,
      "duration_seconds": 0.7,
      "text": "sure"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 414.89,
      "end_seconds": 421.32,
      "duration_seconds": 6.43,
      "text": "can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 423.06,
      "end_seconds": 434.45,
      "duration_seconds": 11.39,
      "text": "So, I take the aciclovir, 800 milligrams, five times a day and come back in one week. Is that right?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 436.52,
      "end_seconds": 441.74,
      "duration_seconds": 5.22,
      "text": "yes exactly right. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 442.84,
      "end_seconds": 445.53,
      "duration_seconds": 2.69,
      "text": "I think I understand everything. Thanks."
    }
  ]
}