{
  "schema_version": "1.0",
  "encounter_id": "01687",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.27,
      "end_seconds": 3.68,
      "duration_seconds": 2.41,
      "text": "Hi, sit anywhere you like."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.0,
      "end_seconds": 10.66,
      "duration_seconds": 3.66,
      "text": "Erm, good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.44,
      "end_seconds": 13.86,
      "duration_seconds": 2.42,
      "text": "What do you need help with?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.4,
      "end_seconds": 25.43,
      "duration_seconds": 10.03,
      "text": "Well, um, I've been having chest pressure. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.2,
      "end_seconds": 31.14,
      "duration_seconds": 3.94,
      "text": "So, how long has it been like this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.01,
      "end_seconds": 40.93,
      "duration_seconds": 7.92,
      "text": "Probably five days. Yeah. I've had a very fast heartbeat too, for four weeks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.2,
      "end_seconds": 45.19,
      "duration_seconds": 2.99,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.36,
      "end_seconds": 55.59,
      "duration_seconds": 9.23,
      "text": "I mean, you know, I'd give it a three, out of ten. Mm, I've also been feeling faint."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 56.52,
      "end_seconds": 57.88,
      "duration_seconds": 1.36,
      "text": "What about fever?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 58.59,
      "end_seconds": 60.24,
      "duration_seconds": 1.65,
      "text": "No fever, thankfully."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.76,
      "end_seconds": 63.82,
      "duration_seconds": 3.06,
      "text": "Did you get cough or leg swelling?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.92,
      "end_seconds": 71.84,
      "duration_seconds": 5.92,
      "text": "Okay, so I haven't had cough or leg swelling, no."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.84,
      "end_seconds": 75.74,
      "duration_seconds": 1.9,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.72,
      "end_seconds": 77.71,
      "duration_seconds": 0.99,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.19,
      "end_seconds": 100.03,
      "duration_seconds": 3.84,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.73,
      "end_seconds": 108.09,
      "duration_seconds": 6.36,
      "text": "I take clopidogrel, 75 milligrams, once a day for the stent."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.11,
      "end_seconds": 111.18,
      "duration_seconds": 2.07,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 112.94,
      "end_seconds": 114.69,
      "duration_seconds": 1.75,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.16,
      "end_seconds": 118.82,
      "duration_seconds": 2.66,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.67,
      "end_seconds": 123.95,
      "duration_seconds": 4.28,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.32,
      "end_seconds": 127.52,
      "duration_seconds": 2.2,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.12,
      "end_seconds": 131.56,
      "duration_seconds": 2.44,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.46,
      "end_seconds": 136.32,
      "duration_seconds": 2.86,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.91,
      "end_seconds": 139.85,
      "duration_seconds": 2.94,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.01,
      "end_seconds": 143.46,
      "duration_seconds": 2.45,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 145.35,
      "end_seconds": 148.28,
      "duration_seconds": 2.93,
      "text": "Heart disease, for five years."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.32,
      "end_seconds": 159.06,
      "duration_seconds": 9.74,
      "text": "Okay, I can see heart disease in your file as well. Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.02,
      "end_seconds": 163.1,
      "duration_seconds": 3.08,
      "text": "Actually, no allergies at all."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.75,
      "end_seconds": 168.03,
      "duration_seconds": 3.28,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 172.69,
      "end_seconds": 175.96,
      "duration_seconds": 3.27,
      "text": "Well, my uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.03,
      "end_seconds": 179.06,
      "duration_seconds": 2.03,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.02,
      "end_seconds": 188.99,
      "duration_seconds": 2.97,
      "text": "Alright, keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.71,
      "end_seconds": 222.02,
      "duration_seconds": 11.31,
      "text": "Okay: height 186 centimetres, weight 83 kilos, blood pressure 103 over 64, pulse 92, temp 36.4 degrees, oxygen saturation is 96 percent."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 223.97,
      "end_seconds": 225.49,
      "duration_seconds": 1.52,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.02,
      "end_seconds": 230.47,
      "duration_seconds": 3.45,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.42,
      "end_seconds": 237.4,
      "duration_seconds": 3.98,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.56,
      "end_seconds": 241.93,
      "duration_seconds": 3.37,
      "text": "So, take a deep breath for me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.67,
      "end_seconds": 265.2,
      "duration_seconds": 6.53,
      "text": "Your pulse is over one hundred and eighty and your blood pressure is low."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.58,
      "end_seconds": 271.57,
      "duration_seconds": 2.99,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 280.75,
      "end_seconds": 289.62,
      "duration_seconds": 8.87,
      "text": "Let me tell you where I've got to. It fits best with a dangerous fast heart rhythm. We shouldn't forget supraventricular tachycardia."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 291.52,
      "end_seconds": 294.57,
      "duration_seconds": 3.05,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.63,
      "end_seconds": 305.04,
      "duration_seconds": 8.41,
      "text": "Nothing I've seen today points to an emergency. It looks like a dangerous fast heart rhythm, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 320.55,
      "end_seconds": 328.69,
      "duration_seconds": 8.14,
      "text": "I think an urgent ECG makes sense here, for fast heart rhythm. We should do blood tests for arrhythmia."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 330.01,
      "end_seconds": 332.42,
      "duration_seconds": 2.41,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 333.35,
      "end_seconds": 349.19,
      "duration_seconds": 15.84,
      "text": "Lie flat, I am calling the emergency team and preparing to shock the heart. Do get help quickly if the symptoms get worse. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 350.24,
      "end_seconds": 354.31,
      "duration_seconds": 4.07,
      "text": "So, I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 355.48,
      "end_seconds": 357.07,
      "duration_seconds": 1.59,
      "text": "Have a good day."
    }
  ]
}