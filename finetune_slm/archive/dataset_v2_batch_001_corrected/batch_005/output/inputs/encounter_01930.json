{
  "schema_version": "1.0",
  "encounter_id": "01930",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.88,
      "end_seconds": 5.06,
      "duration_seconds": 4.18,
      "text": "Hmm, hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.11,
      "end_seconds": 11.86,
      "duration_seconds": 4.75,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.09,
      "end_seconds": 23.82,
      "duration_seconds": 10.73,
      "text": "I wanted to get a purple rash that does not fade looked at. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.64,
      "end_seconds": 28.2,
      "duration_seconds": 3.56,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.01,
      "end_seconds": 40.78,
      "duration_seconds": 11.77,
      "text": "For about three months, I'd say. I thought it would sort itself out, but it hasn't. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.38,
      "end_seconds": 45.02,
      "duration_seconds": 2.64,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.33,
      "end_seconds": 51.44,
      "duration_seconds": 5.11,
      "text": "Mm, a four out of ten, I suppose."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.59,
      "end_seconds": 55.17,
      "duration_seconds": 2.58,
      "text": "Okay, have you had being drowsy?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.51,
      "end_seconds": 67.02,
      "duration_seconds": 10.51,
      "text": "Yes, actually. Ah, you know, I've also had a high fever. About high fever, it's all the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.16,
      "end_seconds": 71.7,
      "duration_seconds": 3.54,
      "text": "Has there been cold hands and feet too?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.53,
      "end_seconds": 73.67,
      "duration_seconds": 1.14,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.2,
      "end_seconds": 82.09,
      "duration_seconds": 6.89,
      "text": "Have you had a purple rash that does not fade before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.27,
      "end_seconds": 89.72,
      "duration_seconds": 6.45,
      "text": "I had a similar thing about six months ago. It went away."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.51,
      "end_seconds": 95.29,
      "duration_seconds": 4.78,
      "text": "Let me check a few things. Any diarrhoea, stiff neck or cough?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.15,
      "end_seconds": 99.32,
      "duration_seconds": 3.17,
      "text": "I mean, nope, nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.11,
      "end_seconds": 103.97,
      "duration_seconds": 2.86,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.74,
      "end_seconds": 106.48,
      "duration_seconds": 1.74,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.36,
      "end_seconds": 109.36,
      "duration_seconds": 2.0,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.71,
      "end_seconds": 124.23,
      "duration_seconds": 9.52,
      "text": "I'm on glimepiride, 2 milligrams, before breakfast for my sugar. It's alendronate, once a week."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.53,
      "end_seconds": 127.79,
      "duration_seconds": 2.26,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.77,
      "end_seconds": 141.24,
      "duration_seconds": 12.47,
      "text": "70 milligrams, I think that's what's on the box. Thyroxine, 75 micrograms, every morning. I'm on lamotrigine, 100 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.06,
      "end_seconds": 162.82,
      "duration_seconds": 3.76,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.73,
      "end_seconds": 168.6,
      "duration_seconds": 3.87,
      "text": "Hmm, my sister had breast cancer."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.56,
      "end_seconds": 185.39,
      "duration_seconds": 2.83,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.07,
      "end_seconds": 213.81,
      "duration_seconds": 27.74,
      "text": "I've had diabetes, yes. My family kept telling me to get it checked. My sister suggested writing things down, but I forgot. Yes, thin bones. I have an underactive thyroid, for five years. I told my wife I'd come today. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.52,
      "end_seconds": 219.94,
      "duration_seconds": 1.42,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.84,
      "end_seconds": 223.06,
      "duration_seconds": 2.22,
      "text": "I've had epilepsy, yes."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.14,
      "end_seconds": 226.54,
      "duration_seconds": 1.4,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.02,
      "end_seconds": 237.26,
      "duration_seconds": 1.24,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.81,
      "end_seconds": 244.78,
      "duration_seconds": 2.97,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.59,
      "end_seconds": 248.28,
      "duration_seconds": 1.69,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.01,
      "end_seconds": 251.97,
      "duration_seconds": 2.96,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.43,
      "end_seconds": 256.98,
      "duration_seconds": 3.55,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.9,
      "end_seconds": 263.82,
      "duration_seconds": 5.92,
      "text": "Just a wisdom tooth extraction under sedation, five years ago."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.58,
      "end_seconds": 269.25,
      "duration_seconds": 4.67,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.83,
      "end_seconds": 284.43,
      "duration_seconds": 14.6,
      "text": "Hmm, um, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.68,
      "end_seconds": 287.96,
      "duration_seconds": 2.28,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.38,
      "end_seconds": 299.81,
      "duration_seconds": 2.43,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.48,
      "end_seconds": 316.39,
      "duration_seconds": 6.91,
      "text": "Okay: SpO2 96 percent on room air, blood pressure 111 over 77, pulse 92."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.6,
      "end_seconds": 319.1,
      "duration_seconds": 1.5,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.79,
      "end_seconds": 322.35,
      "duration_seconds": 2.56,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.76,
      "end_seconds": 328.33,
      "duration_seconds": 3.57,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.29,
      "end_seconds": 330.99,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.46,
      "end_seconds": 333.73,
      "duration_seconds": 1.27,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.5,
      "end_seconds": 356.56,
      "duration_seconds": 8.06,
      "text": "The purple spots do not fade when I press a glass on them, and he is floppy and drowsy."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.4,
      "end_seconds": 359.1,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.44,
      "end_seconds": 375.58,
      "duration_seconds": 11.14,
      "text": "You can relax now. So, based on the history and the examination, it fits best with possible meningococcal sepsis. A viral rash is still possible."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 376.1,
      "end_seconds": 377.72,
      "duration_seconds": 1.62,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.51,
      "end_seconds": 397.31,
      "duration_seconds": 18.8,
      "text": "Nothing I've seen today points to an emergency. It looks like possible meningococcal sepsis, but I'd like to confirm. Let me repeat that back to make sure. You've had a purple rash that does not fade for about three months, and no cough or stiff neck."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 398.08,
      "end_seconds": 398.78,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 399.92,
      "end_seconds": 418.19,
      "duration_seconds": 18.27,
      "text": "I want urgent blood tests done, that's for possible sepsis. I want blood cultures done, that's for possible sepsis. What I'm giving you is benzylpenicillin, 600 milligrams, once now, single dose. That should help with possible meningococcal sepsis."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 419.68,
      "end_seconds": 424.3,
      "duration_seconds": 4.62,
      "text": "Actually, should I carry on if I feel better?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 425.48,
      "end_seconds": 434.08,
      "duration_seconds": 8.6,
      "text": "I am giving an antibiotic injection now and calling an ambulance. We'll refer you to the emergency team."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 435.91,
      "end_seconds": 436.61,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 437.49,
      "end_seconds": 447.95,
      "duration_seconds": 10.46,
      "text": "If the symptoms get worse, that's the point to come in urgently. See me again straight away. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 449.2,
      "end_seconds": 452.48,
      "duration_seconds": 3.28,
      "text": "I think I understand everything. Thanks."
    }
  ]
}