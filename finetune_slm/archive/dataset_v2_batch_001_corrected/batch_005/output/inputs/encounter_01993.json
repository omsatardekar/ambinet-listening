{
  "schema_version": "1.0",
  "encounter_id": "01993",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.52,
      "end_seconds": 6.01,
      "duration_seconds": 5.49,
      "text": "Yeah, uh, hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.91,
      "end_seconds": 11.73,
      "duration_seconds": 3.82,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.72,
      "end_seconds": 18.84,
      "duration_seconds": 5.12,
      "text": "Um, so... burning on passing urine. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.45,
      "end_seconds": 25.01,
      "duration_seconds": 4.56,
      "text": "Okay, can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.56,
      "end_seconds": 38.85,
      "duration_seconds": 2.29,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.41,
      "end_seconds": 56.51,
      "duration_seconds": 8.1,
      "text": "Okay: pulse 92, SpO2 95 percent on room air, temperature is 39.0 degrees. And blood pressure 106 over 67."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.48,
      "end_seconds": 62.89,
      "duration_seconds": 1.41,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.38,
      "end_seconds": 68.48,
      "duration_seconds": 4.1,
      "text": "We'll look at it together shortly. When did this begin?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.28,
      "end_seconds": 73.01,
      "duration_seconds": 3.73,
      "text": "It's been going on for five days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.9,
      "end_seconds": 77.87,
      "duration_seconds": 2.97,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.38,
      "end_seconds": 102.68,
      "duration_seconds": 23.3,
      "text": "A dull low backache goes along with it, uh, most of the time. About dull low backache, it just comes and goes. And I've been passing urine very often as well, since Friday. I was feeling a bit feverish at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.39,
      "end_seconds": 118.83,
      "duration_seconds": 6.44,
      "text": "Have you had any severe back pain, leaking fluid, reduced baby movements or vaginal bleeding?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.55,
      "end_seconds": 125.45,
      "duration_seconds": 4.9,
      "text": "I mean, um, no, not a single one."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.04,
      "end_seconds": 129.0,
      "duration_seconds": 2.96,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.8,
      "end_seconds": 133.18,
      "duration_seconds": 2.38,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.84,
      "end_seconds": 147.81,
      "duration_seconds": 1.97,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.51,
      "end_seconds": 171.17,
      "duration_seconds": 21.66,
      "text": "Febuxostat. I take it 80 milligrams, once a day for the gout. I'm supposed to take it regularly, you know, but I don't always manage. Sitagliptin, 100 milligrams, once a day. Um, it's spironolactone, 25 milligrams, once a day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.13,
      "end_seconds": 177.44,
      "duration_seconds": 4.31,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.45,
      "end_seconds": 198.72,
      "duration_seconds": 19.27,
      "text": "No, I've never smoked in my life. I used to drink heavily but I stopped four years ago. I'm a bus driver, so I sit for long hours. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.99,
      "end_seconds": 202.27,
      "duration_seconds": 2.28,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.12,
      "end_seconds": 204.65,
      "duration_seconds": 1.53,
      "text": "I have gout."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.65,
      "end_seconds": 206.35,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.68,
      "end_seconds": 211.86,
      "duration_seconds": 4.18,
      "text": "Diabetes, for about ten years. I've got heart failure."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.81,
      "end_seconds": 215.35,
      "duration_seconds": 1.54,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.85,
      "end_seconds": 225.61,
      "duration_seconds": 9.76,
      "text": "Right, so gout and diabetes are already on your record. We'll keep that in mind today. Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.79,
      "end_seconds": 231.83,
      "duration_seconds": 5.04,
      "text": "My uncle has high cholesterol. My father had bowel cancer."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.8,
      "end_seconds": 238.12,
      "duration_seconds": 4.32,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.5,
      "end_seconds": 248.7,
      "duration_seconds": 9.2,
      "text": "Hmm, yes, I'm allergic to grass pollen. Erm, yes, walnuts. I get my lips swelling."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.83,
      "end_seconds": 252.73,
      "duration_seconds": 2.9,
      "text": "So, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.99,
      "end_seconds": 257.94,
      "duration_seconds": 3.95,
      "text": "Nothing, uh, I haven't had any operations."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.74,
      "end_seconds": 286.04,
      "duration_seconds": 10.3,
      "text": "Okay, so my impression from what you've said is this: I'd lean towards a urinary infection in pregnancy. Another possibility is a kidney infection."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.42,
      "end_seconds": 291.93,
      "duration_seconds": 1.51,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.43,
      "end_seconds": 321.4,
      "duration_seconds": 28.97,
      "text": "It's reasonable to be concerned, but right now a urinary infection in pregnancy is my leading thought, not anything worse. I'd like to arrange a urine culture for urinary infection. I'd like to arrange a urine dipstick for burning urine. For this, cefalexin, 500 milligrams, twice a day, seven days. You take it by mouth. That should help with urinary infection in pregnancy. Drink plenty of fluids and tell your midwife."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.62,
      "end_seconds": 333.83,
      "duration_seconds": 11.21,
      "text": "Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. I think the midwife should see you too."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.13,
      "end_seconds": 337.6,
      "duration_seconds": 2.47,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.18,
      "end_seconds": 345.31,
      "duration_seconds": 7.13,
      "text": "Do get help quickly if the symptoms get worse. We'll catch up in one week."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.01,
      "end_seconds": 353.14,
      "duration_seconds": 6.13,
      "text": "Sorry, what was I saying, I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.92,
      "end_seconds": 357.87,
      "duration_seconds": 3.95,
      "text": "What are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.61,
      "end_seconds": 368.76,
      "duration_seconds": 9.15,
      "text": "So, I take the cefalexin, 500 milligrams, twice a day and come back in one week. Is that right?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 370.29,
      "end_seconds": 376.18,
      "duration_seconds": 5.89,
      "text": "Alright, yes, exactly right. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 377.01,
      "end_seconds": 378.54,
      "duration_seconds": 1.53,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.31,
      "end_seconds": 380.54,
      "duration_seconds": 1.23,
      "text": "Take care now."
    }
  ]
}