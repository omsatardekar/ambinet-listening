{
  "schema_version": "1.0",
  "encounter_id": "01923",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.64,
      "end_seconds": 7.45,
      "duration_seconds": 6.81,
      "text": "Okay, doctor, we're all set in here. I'll give you the numbers when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.39,
      "end_seconds": 12.54,
      "duration_seconds": 4.15,
      "text": "Thank you. Good morning tell me what's been going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.43,
      "end_seconds": 23.7,
      "duration_seconds": 10.27,
      "text": "Morning doctor. I'll stay and fill in anything that's missed. It's dark urine once doctor. He didn't want to to come but I insisted."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.17,
      "end_seconds": 27.46,
      "duration_seconds": 2.29,
      "text": "did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 28.57,
      "end_seconds": 30.54,
      "duration_seconds": 1.97,
      "text": "About... well six months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 30.94,
      "end_seconds": 37.14,
      "duration_seconds": 6.2,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 37.24,
      "end_seconds": 44.01,
      "duration_seconds": 6.77,
      "text": "sorry to cut in doctor quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.79,
      "end_seconds": 46.94,
      "duration_seconds": 2.15,
      "text": "later, thanks please go on"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 50.47,
      "end_seconds": 64.27,
      "duration_seconds": 13.8,
      "text": "As for feeling tired, I honestly can't say when that began. It might have been last month or the month before. As for feeling tired, moderate, really."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.27,
      "end_seconds": 72.36,
      "duration_seconds": 6.09,
      "text": "have you had dark urine once before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 74.28,
      "end_seconds": 83.87,
      "duration_seconds": 9.59,
      "text": "Yes something like this happened a couple of years ago and it went away on its own."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.77,
      "end_seconds": 90.29,
      "duration_seconds": 5.52,
      "text": "have you had any joint swelling, chest pain, rash or fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 91.78,
      "end_seconds": 105.03,
      "duration_seconds": 13.25,
      "text": "no no joint swelling no chest pain no rash i did have aching muscles in my thighs at one point but that went away on its own"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.67,
      "end_seconds": 109.49,
      "duration_seconds": 2.82,
      "text": "alright how are your bowels any trouble?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 110.3,
      "end_seconds": 111.7,
      "duration_seconds": 1.4,
      "text": "Nothing unusual no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.89,
      "end_seconds": 115.36,
      "duration_seconds": 2.47,
      "text": "and your skin, any changes there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 117.11,
      "end_seconds": 118.13,
      "duration_seconds": 1.02,
      "text": "skin's normal"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.85,
      "end_seconds": 123.91,
      "duration_seconds": 4.06,
      "text": "anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 124.48,
      "end_seconds": 139.8,
      "duration_seconds": 15.32,
      "text": "I've had high cholesterol for about a year now. Depression, for two years i've been putting this off for weeks i've had anxiety for about a year now"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.4,
      "end_seconds": 151.57,
      "duration_seconds": 7.17,
      "text": "alright, high cholesterol and and depression, that matches what I have here how about smoking?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 153.07,
      "end_seconds": 157.45,
      "duration_seconds": 4.38,
      "text": "I smoke roughly a pack every two days"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.26,
      "end_seconds": 160.61,
      "duration_seconds": 1.35,
      "text": "what about alcohol?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 161.87,
      "end_seconds": 166.91,
      "duration_seconds": 5.04,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.88,
      "end_seconds": 170.54,
      "duration_seconds": 1.66,
      "text": "how are your meals?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 172.47,
      "end_seconds": 176.42,
      "duration_seconds": 3.95,
      "text": "I grab fast food at lunch most days"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.62,
      "end_seconds": 178.96,
      "duration_seconds": 1.34,
      "text": "are you active?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 180.17,
      "end_seconds": 182.89,
      "duration_seconds": 2.72,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.63,
      "end_seconds": 187.54,
      "duration_seconds": 2.91,
      "text": "have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 189.05,
      "end_seconds": 190.18,
      "duration_seconds": 1.13,
      "text": "no, never"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.92,
      "end_seconds": 195.77,
      "duration_seconds": 4.85,
      "text": "Any allergies to tablets food or anything in the environment?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 196.76,
      "end_seconds": 205.66,
      "duration_seconds": 8.9,
      "text": "I think I reacted to some antibiotic once, years ago i don't remember which one, or what happened exactly"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.29,
      "end_seconds": 210.87,
      "duration_seconds": 3.58,
      "text": "is there anything relevant on the the family side?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 212.86,
      "end_seconds": 215.34,
      "duration_seconds": 2.48,
      "text": "My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.89,
      "end_seconds": 219.06,
      "duration_seconds": 2.17,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 220.04,
      "end_seconds": 226.4,
      "duration_seconds": 6.36,
      "text": "Sorry, what was I saying, it's simvastatin, 20 milligrams, at night."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 228.34,
      "end_seconds": 233.23,
      "duration_seconds": 4.89,
      "text": "doctor, our chart from the last visit lists it as 40 milligrams"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.89,
      "end_seconds": 244.7,
      "duration_seconds": 5.81,
      "text": "okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 245.98,
      "end_seconds": 249.3,
      "duration_seconds": 3.32,
      "text": "no I left it it at home"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 250.61,
      "end_seconds": 258.12,
      "duration_seconds": 7.51,
      "text": "it's a... um, I can't remember what it's called it's a a round yellow one"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.17,
      "end_seconds": 261.7,
      "duration_seconds": 2.53,
      "text": "do you remember what it's for?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 263.48,
      "end_seconds": 285.47,
      "duration_seconds": 21.99,
      "text": "for my mood, I believe. My daughter sets them out for me, I just take what I'm given. It's escitalopram, 10 milligrams, once a day. I didn't want to to bother you but it keeps coming back. Okay, so I take paracetamol, 1 gram, when needed"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 293.4,
      "end_seconds": 303.22,
      "duration_seconds": 9.82,
      "text": "Here are the numbers, doctor. Temperature 36.8, SpO2 98 percent on room air, BP is 124 over 72, pulse is 66 beats a minute."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.91,
      "end_seconds": 304.92,
      "duration_seconds": 1.01,
      "text": "okay, thanks"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.85,
      "end_seconds": 310.98,
      "duration_seconds": 4.13,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 322.59,
      "end_seconds": 323.6,
      "duration_seconds": 1.01,
      "text": "of course"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.07,
      "end_seconds": 327.43,
      "duration_seconds": 2.36,
      "text": "take a deep breath for me"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.56,
      "end_seconds": 339.6,
      "duration_seconds": 5.04,
      "text": "the thigh muscles are tender and the strength is slightly reduced"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.01,
      "end_seconds": 359.36,
      "duration_seconds": 16.35,
      "text": "You can relax now. Having listened and examined I'd lean towards muscle symptoms possibly from the cholesterol tablet. I can't rule out a low thyroid yet. I think a thyroid test makes sense here for muscle aches."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 361.11,
      "end_seconds": 363.79,
      "duration_seconds": 2.68,
      "text": "how long will it take?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.74,
      "end_seconds": 371.02,
      "duration_seconds": 5.28,
      "text": "I think a vitamin D level makes sense here, for muscle aches"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 372.26,
      "end_seconds": 373.22,
      "duration_seconds": 0.96,
      "text": "mm alright"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 374.58,
      "end_seconds": 400.97,
      "duration_seconds": 26.39,
      "text": "We will pause the statin for a few weeks while we check the blood tests. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. If the symptoms get worse, or you feel really unwell, please come to the emergency department. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 402.64,
      "end_seconds": 404.58,
      "duration_seconds": 1.94,
      "text": "thank you doctor goodbye"
    }
  ]
}