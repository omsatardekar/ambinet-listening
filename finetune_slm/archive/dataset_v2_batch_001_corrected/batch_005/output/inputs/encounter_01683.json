      "role": "DOCTOR",
      "start_seconds": 4.52,
      "end_seconds": 9.21,
      "duration_seconds": 4.69,
      "text": "you're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.53,
      "end_seconds": 20.81,
      "duration_seconds": 10.28,
      "text": "it's severe pain in the upper tummy going through to the back i thought I'd wait, but it hasn't gone"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.63,
      "end_seconds": 23.09,
      "duration_seconds": 1.46,
      "text": "since when exactly?"
