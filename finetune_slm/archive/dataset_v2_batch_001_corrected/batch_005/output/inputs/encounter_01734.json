{
  "schema_version": "1.0",
  "encounter_id": "01734",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.06,
      "end_seconds": 6.28,
      "duration_seconds": 5.22,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.46,
      "end_seconds": 12.76,
      "duration_seconds": 5.3,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.56,
      "end_seconds": 19.73,
      "duration_seconds": 5.17,
      "text": "So the thing is, I've got drinking most nights."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.05,
      "end_seconds": 23.18,
      "duration_seconds": 2.13,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.56,
      "end_seconds": 27.65,
      "duration_seconds": 3.09,
      "text": "for about a week, I'd say"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.17,
      "end_seconds": 31.28,
      "duration_seconds": 2.11,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.74,
      "end_seconds": 41.41,
      "duration_seconds": 8.67,
      "text": "Shaky hands goes along with it, most of the time. The Shaky hands? That's been for three weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.87,
      "end_seconds": 56.78,
      "duration_seconds": 3.91,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.64,
      "end_seconds": 71.17,
      "duration_seconds": 2.53,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.02,
      "end_seconds": 93.03,
      "duration_seconds": 9.01,
      "text": "okay: pulse is 68 beats a minute, pressure 116 over 68, temperature is 36.8 degrees and saturation 97 percent"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.68,
      "end_seconds": 96.29,
      "duration_seconds": 1.61,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.26,
      "end_seconds": 99.8,
      "duration_seconds": 2.54,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.02,
      "end_seconds": 103.71,
      "duration_seconds": 2.69,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.33,
      "end_seconds": 105.47,
      "duration_seconds": 1.14,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.18,
      "end_seconds": 110.43,
      "duration_seconds": 3.25,
      "text": "Okay, take a deep breath for me."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.42,
      "end_seconds": 133.85,
      "duration_seconds": 6.43,
      "text": "Your liver edge is felt slightly below the ribs and and there is a fine tremor."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.78,
      "end_seconds": 144.04,
      "duration_seconds": 5.26,
      "text": "All finished, thank you. Any confusion, black stools or vomiting blood?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.66,
      "end_seconds": 152.09,
      "duration_seconds": 6.43,
      "text": "um, no confusion, black stools or vomiting blood, none of it"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.78,
      "end_seconds": 156.57,
      "duration_seconds": 3.79,
      "text": "on the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.08,
      "end_seconds": 161.59,
      "duration_seconds": 4.51,
      "text": "my heart's been fine, as far as I know"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.11,
      "end_seconds": 164.81,
      "duration_seconds": 2.7,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.14,
      "end_seconds": 168.19,
      "duration_seconds": 2.05,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.04,
      "end_seconds": 185.52,
      "duration_seconds": 2.48,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.51,
      "end_seconds": 190.4,
      "duration_seconds": 2.89,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.08,
      "end_seconds": 194.35,
      "duration_seconds": 3.27,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.98,
      "end_seconds": 199.92,
      "duration_seconds": 3.94,
      "text": "no, you know, I've never reacted to anything"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.48,
      "end_seconds": 213.06,
      "duration_seconds": 3.58,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.62,
      "end_seconds": 216.17,
      "duration_seconds": 1.55,
      "text": "not really, no"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.84,
      "end_seconds": 225.37,
      "duration_seconds": 4.53,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.87,
      "end_seconds": 241.04,
      "duration_seconds": 15.17,
      "text": "I've never touched a cigarette. I only drink at family occasions. I hardly move around during the day. I live with my elderly mother. Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.53,
      "end_seconds": 261.43,
      "duration_seconds": 10.9,
      "text": "So where does that leave us? I'm honestly not certain yet. It could be harmful alcohol use with liver strain, or it might be fatty liver."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.35,
      "end_seconds": 267.24,
      "duration_seconds": 3.89,
      "text": "Actually, is there something to worry about?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.27,
      "end_seconds": 300.19,
      "duration_seconds": 30.92,
      "text": "Nothing I've seen today points to an emergency. It looks like harmful alcohol use with liver strain, but I'd like to confirm. I'm sending you for liver blood tests because of alcohol use. Let's use thiamine, 100 milligrams, three times a day, long term. It's for alcohol-related nutritional deficiency. Cut down gradually and do not stop suddenly on your own if you drink heavily. We'll refer you to the alcohol support service."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.66,
      "end_seconds": 302.36,
      "duration_seconds": 0.7,
      "text": "okay"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.34,
      "end_seconds": 306.94,
      "duration_seconds": 3.6,
      "text": "I'd like to see you again after the tests"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.48,
      "end_seconds": 310.43,
      "duration_seconds": 2.95,
      "text": "I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.04,
      "end_seconds": 316.5,
      "duration_seconds": 4.46,
      "text": "right, that's the plan do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.45,
      "end_seconds": 320.66,
      "duration_seconds": 2.21,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.99,
      "end_seconds": 323.18,
      "duration_seconds": 1.19,
      "text": "Look after yourself."
    }
  ]
}