  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.71,
      "end_seconds": 3.76,
      "duration_seconds": 3.05,
      "text": "hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.51,
      "end_seconds": 9.35,
      "duration_seconds": 4.84,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.41,
      "end_seconds": 15.4,
      "duration_seconds": 4.99,
      "text": "um, so... trouble falling asleep that's why I came"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.96,
      "end_seconds": 19.5,
      "duration_seconds": 3.54,
      "text": "time for your numbers, if that's okay"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.59,
      "end_seconds": 31.78,
      "duration_seconds": 2.19,
      "text": "nearly done with the readings.."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.62,
      "end_seconds": 66.28,
      "duration_seconds": 12.66,
      "text": "okay: SpO2 97 percent on room air, pulse 86, temperature 36.9, blood pressure 108 over 80. When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.71,
      "end_seconds": 72.77,
      "duration_seconds": 5.06,
      "text": "Hmm, uh, it's been going on for three weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.32,
      "end_seconds": 80.14,
      "duration_seconds": 6.82,
      "text": "okay go on okay give me more detail on it whatever comes to mind"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.85,
      "end_seconds": 91.78,
      "duration_seconds": 10.93,
      "text": "A warm bath helps a a bit. Mild, really. I've had a busy mind at night too, for about a month."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.33,
      "end_seconds": 116.35,
      "duration_seconds": 7.02,
      "text": "let me check a few things any low mood, chest pain or weight change?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.4,
      "end_seconds": 122.28,
      "duration_seconds": 3.88,
      "text": "no, I haven't had any of them"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.84,
      "end_seconds": 126.27,
      "duration_seconds": 2.43,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.44,
      "end_seconds": 129.4,
      "duration_seconds": 1.96,
      "text": "no all normal there"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.05,
      "end_seconds": 140.5,
      "duration_seconds": 2.45,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.01,
      "end_seconds": 145.03,
      "duration_seconds": 3.02,
      "text": "nothing I haven't had any operations"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.04,
      "end_seconds": 155.27,
      "duration_seconds": 2.23,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.23,
      "end_seconds": 161.18,
      "duration_seconds": 3.95,
      "text": "It's a herbal sleep tea, at night."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.39,
      "end_seconds": 166.59,
      "duration_seconds": 5.2,
      "text": "okay, go on do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.84,
      "end_seconds": 174.75,
      "duration_seconds": 2.91,
      "text": "no, you know, no conditions"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.76,
      "end_seconds": 177.6,
      "duration_seconds": 1.84,
      "text": "okay, what about alcohol?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.98,
      "end_seconds": 181.67,
      "duration_seconds": 2.69,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.7,
      "end_seconds": 188.04,
      "duration_seconds": 1.34,
      "text": "how about smoking?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.72,
      "end_seconds": 193.55,
      "duration_seconds": 3.83,
      "text": "I quit smoking around ten years ago"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.33,
      "end_seconds": 196.65,
      "duration_seconds": 1.32,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.2,
      "end_seconds": 201.5,
      "duration_seconds": 3.3,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.85,
      "end_seconds": 204.89,
      "duration_seconds": 2.04,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.75,
      "end_seconds": 209.56,
      "duration_seconds": 3.81,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.17,
      "end_seconds": 215.67,
      "duration_seconds": 4.5,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.7,
      "end_seconds": 220.75,
      "duration_seconds": 3.05,
      "text": "yeah, I've never had an allergy"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.03,
      "end_seconds": 227.08,
      "duration_seconds": 4.05,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.94,
      "end_seconds": 230.29,
      "duration_seconds": 2.35,
      "text": "tell me if that's sore"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.57,
      "end_seconds": 247.51,
      "duration_seconds": 2.94,
      "text": "your blood pressure and pulse are normal"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.99,
      "end_seconds": 255.46,
      "duration_seconds": 2.47,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.27,
      "end_seconds": 269.32,
      "duration_seconds": 5.05,
      "text": "Taking everything into account it fits best with poor sleep habits."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.23,
      "end_seconds": 273.05,
      "duration_seconds": 2.82,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.24,
      "end_seconds": 308.97,
      "duration_seconds": 34.73,
      "text": "I understand the worry at the moment I'd say it's poor sleep habits and we'll watch how it goes keep a fixed bedtime no screens for an hour before bed and no coffee after lunch if you smoke this is a good moment to think about stopping and we can help you with that come back or go to emergency straight away if the symptoms get worse let's review you in four weeks"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.14,
      "end_seconds": 312.72,
      "duration_seconds": 2.58,
      "text": "Erm I can manage that."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.27,
      "end_seconds": 317.15,
      "duration_seconds": 3.88,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.43,
      "end_seconds": 323.42,
      "duration_seconds": 4.99,
      "text": "sorry what was I saying alright thanks take care"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.54,
      "end_seconds": 325.75,
      "duration_seconds": 1.21,
      "text": "See you soon."
    }
  ]
}