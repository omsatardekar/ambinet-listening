  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.76,
      "end_seconds": 3.99,
      "duration_seconds": 3.23,
      "text": "Come in, have a seat by the desk."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.57,
      "end_seconds": 5.64,
      "duration_seconds": 1.07,
      "text": "evening, doctor"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.76,
      "end_seconds": 15.69,
      "duration_seconds": 3.93,
      "text": "Sorry about the wait, we're running a bit behind."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 16.74,
      "end_seconds": 23.05,
      "duration_seconds": 6.31,
      "text": "oh, that's fine. I was just reading something on my phone"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.72,
      "end_seconds": 26.99,
      "duration_seconds": 2.27,
      "text": "What's the main thing today?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 30.24,
      "end_seconds": 35.8,
      "duration_seconds": 5.56,
      "text": "So the thing is, I've got a pulled muscle in my thigh."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.32,
      "end_seconds": 39.17,
      "duration_seconds": 2.85,
      "text": "what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 40.11,
      "end_seconds": 46.15,
      "duration_seconds": 6.04,
      "text": "I take something called tams... tamsulosin, 0.4 milligrams, maybe, at night."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.8,
      "end_seconds": 50.94,
      "duration_seconds": 4.14,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 52.7,
      "end_seconds": 60.8,
      "duration_seconds": 8.1,
      "text": "sorry, what was I saying, no, it's at home. Ibuprofen gel, three times a day"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.04,
      "end_seconds": 64.48,
      "duration_seconds": 2.44,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.48,
      "end_seconds": 72.05,
      "duration_seconds": 6.57,
      "text": "Actually, ever since... since Monday, really. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.63,
      "end_seconds": 78.4,
      "duration_seconds": 5.77,
      "text": "hm, okay okay, give me more detail on it, whatever comes to mind"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.85,
      "end_seconds": 94.7,
      "duration_seconds": 14.85,
      "text": "Maybe a seven out of ten on a bad day. I notice it more with running. Rest and ice helps a bit. Oh, and a bit of bruising. Had that since Friday."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.5,
      "end_seconds": 98.66,
      "duration_seconds": 2.16,
      "text": "has there been tightness too?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.5,
      "end_seconds": 111.0,
      "duration_seconds": 10.5,
      "text": "Yeah. About a month, I'd say. Okay, you know, so with tightness, about a five out of ten."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.66,
      "end_seconds": 117.32,
      "duration_seconds": 4.66,
      "text": "Any numbness, swelling, pop at the time or fall?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.92,
      "end_seconds": 121.48,
      "duration_seconds": 2.56,
      "text": "no, I'd have said so"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.19,
      "end_seconds": 125.8,
      "duration_seconds": 1.61,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 126.74,
      "end_seconds": 128.96,
      "duration_seconds": 2.22,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.25,
      "end_seconds": 141.31,
      "duration_seconds": 3.06,
      "text": "Right, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 141.89,
      "end_seconds": 143.91,
      "duration_seconds": 2.02,
      "text": "no, not at all"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.74,
      "end_seconds": 147.51,
      "duration_seconds": 2.77,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 149.01,
      "end_seconds": 152.34,
      "duration_seconds": 3.33,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.39,
      "end_seconds": 157.85,
      "duration_seconds": 4.46,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.04,
      "end_seconds": 177.03,
      "duration_seconds": 17.99,
      "text": "I smoke roughly a pack every two days. Nothing, I'm teetotal. I swim twice a week. I'm a hairdresser, on my feet all day. No, I share a house with my brother"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.79,
      "end_seconds": 182.72,
      "duration_seconds": 3.93,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 183.71,
      "end_seconds": 186.04,
      "duration_seconds": 2.33,
      "text": "I have an enlarged prostate"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.74,
      "end_seconds": 199.01,
      "duration_seconds": 3.27,
      "text": "shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.88,
      "end_seconds": 214.69,
      "duration_seconds": 2.81,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.11,
      "end_seconds": 238.42,
      "duration_seconds": 11.31,
      "text": "Okay: pulse is 85 beats a minute, temperature is 36.8 degrees, SpO2 99 percent on room air. And pressure 111 over 74."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 240.38,
      "end_seconds": 242.58,
      "duration_seconds": 2.2,
      "text": "is that alright, doctor?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.28,
      "end_seconds": 247.03,
      "duration_seconds": 2.75,
      "text": "I'll interpret them after the examination"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.86,
      "end_seconds": 254.39,
      "duration_seconds": 5.53,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 263.77,
      "end_seconds": 264.81,
      "duration_seconds": 1.04,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.78,
      "end_seconds": 268.2,
      "duration_seconds": 1.42,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 280.01,
      "end_seconds": 288.82,
      "duration_seconds": 8.81,
      "text": "There is mild tenderness in the back of the thigh and you can still straighten the knee fully."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.91,
      "end_seconds": 316.36,
      "duration_seconds": 22.45,
      "text": "so, good, you can sit up again having listened and examined, this looks most like a mild hamstring strain. Rest for a few days, ice it, and then ease back in with gentle stretching and please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 318.19,
      "end_seconds": 320.12,
      "duration_seconds": 1.93,
      "text": "Thank you, that's clear."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 321.38,
      "end_seconds": 327.34,
      "duration_seconds": 5.96,
      "text": "please don't wait if the symptoms get worse that's when to be seen urgently"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 327.98,
      "end_seconds": 331.0,
      "duration_seconds": 3.02,
      "text": "okay, I'll look out for that"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 335.12,
      "end_seconds": 339.04,
      "duration_seconds": 3.92,
      "text": "See me again if not better in two weeks."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 339.71,
      "end_seconds": 343.2,
      "duration_seconds": 3.49,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 345.16,
      "end_seconds": 350.65,
      "duration_seconds": 5.49,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 355.4,
      "end_seconds": 359.22,
      "duration_seconds": 3.82,
      "text": "no, um, that's all thanks a lot"
    }
  ]
}