{
  "schema_version": "1.0",
  "encounter_id": "01824",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.95,
      "end_seconds": 3.77,
      "duration_seconds": 2.82,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.43,
      "end_seconds": 10.09,
      "duration_seconds": 3.66,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.95,
      "end_seconds": 18.75,
      "duration_seconds": 6.8,
      "text": "Mm, I'm here because of tingling in my thumb and first fingers."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.75,
      "end_seconds": 22.43,
      "duration_seconds": 2.68,
      "text": "Alright, did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.2,
      "end_seconds": 29.36,
      "duration_seconds": 2.16,
      "text": "Probably six months. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.12,
      "end_seconds": 32.8,
      "duration_seconds": 2.68,
      "text": "Is there something that settles it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.6,
      "end_seconds": 38.44,
      "duration_seconds": 4.84,
      "text": "So, um, shaking the hand helps a bit."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.43,
      "end_seconds": 43.88,
      "duration_seconds": 3.45,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.31,
      "end_seconds": 48.33,
      "duration_seconds": 3.02,
      "text": "Pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.09,
      "end_seconds": 53.14,
      "duration_seconds": 3.05,
      "text": "Okay, how often do you get it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.76,
      "end_seconds": 58.24,
      "duration_seconds": 3.48,
      "text": "Honestly, once or twice a day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.56,
      "end_seconds": 62.18,
      "duration_seconds": 2.62,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.56,
      "end_seconds": 81.83,
      "duration_seconds": 18.27,
      "text": "When it starts I tend to get dropping things as well. And I've been waking at night with numb hands as well, since last night. About waking at night with numb hands, it happens a couple of times a week."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.67,
      "end_seconds": 104.97,
      "duration_seconds": 7.3,
      "text": "Okay, have you had any pain in the shoulder, neck pain or weakness in the legs?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.14,
      "end_seconds": 113.49,
      "duration_seconds": 7.35,
      "text": "No, no pain in the shoulder, neck pain or weakness in the legs."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.02,
      "end_seconds": 117.95,
      "duration_seconds": 2.93,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.05,
      "end_seconds": 122.21,
      "duration_seconds": 2.16,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.15,
      "end_seconds": 127.57,
      "duration_seconds": 4.42,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.12,
      "end_seconds": 130.75,
      "duration_seconds": 2.63,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.39,
      "end_seconds": 134.14,
      "duration_seconds": 2.75,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.02,
      "end_seconds": 138.18,
      "duration_seconds": 2.16,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.62,
      "end_seconds": 144.39,
      "duration_seconds": 1.77,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.9,
      "end_seconds": 150.5,
      "duration_seconds": 5.6,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.06,
      "end_seconds": 151.91,
      "duration_seconds": 0.85,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.85,
      "end_seconds": 158.28,
      "duration_seconds": 3.43,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.23,
      "end_seconds": 162.23,
      "duration_seconds": 2.0,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.28,
      "end_seconds": 167.09,
      "duration_seconds": 3.81,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.89,
      "end_seconds": 171.02,
      "duration_seconds": 3.13,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.72,
      "end_seconds": 175.67,
      "duration_seconds": 2.95,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.07,
      "end_seconds": 181.12,
      "duration_seconds": 4.05,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.77,
      "end_seconds": 189.06,
      "duration_seconds": 3.29,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.91,
      "end_seconds": 204.9,
      "duration_seconds": 5.99,
      "text": "Any health conditions I should have on record? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.58,
      "end_seconds": 209.98,
      "duration_seconds": 4.4,
      "text": "I have thin bones, for about a year."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.41,
      "end_seconds": 219.16,
      "duration_seconds": 7.75,
      "text": "Okay, I can see thin bones in your file as well. Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.62,
      "end_seconds": 222.89,
      "duration_seconds": 2.27,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.37,
      "end_seconds": 240.52,
      "duration_seconds": 7.15,
      "text": "Do you take any prescribed or over-the-counter medicines? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.85,
      "end_seconds": 250.32,
      "duration_seconds": 8.47,
      "text": "Alendronate, 70 milligrams, once a week. I do miss it now and then, to be fair."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.26,
      "end_seconds": 255.57,
      "duration_seconds": 3.31,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.77,
      "end_seconds": 271.54,
      "duration_seconds": 2.77,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.38,
      "end_seconds": 292.88,
      "duration_seconds": 7.5,
      "text": "Okay: saturation 98 percent, pulse is 72 beats a minute, BP is 128 over 68."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.5,
      "end_seconds": 294.86,
      "duration_seconds": 1.36,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.44,
      "end_seconds": 299.05,
      "duration_seconds": 2.61,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.21,
      "end_seconds": 303.75,
      "duration_seconds": 3.54,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.93,
      "end_seconds": 308.25,
      "duration_seconds": 3.32,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.57,
      "end_seconds": 324.92,
      "duration_seconds": 7.35,
      "text": "Tapping over the wrist brings on the tingling and the thumb muscle is slightly thin."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.24,
      "end_seconds": 345.64,
      "duration_seconds": 17.4,
      "text": "All finished, thank you. Having listened and examined, this looks most like carpal tunnel syndrome. I'll request a nerve conduction study, it'll help with carpal tunnel. Wear a wrist splint at night. I'd like you back in six weeks."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.89,
      "end_seconds": 347.59,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.36,
      "end_seconds": 352.96,
      "duration_seconds": 4.6,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 354.12,
      "end_seconds": 357.18,
      "duration_seconds": 3.06,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.94,
      "end_seconds": 359.41,
      "duration_seconds": 1.47,
      "text": "All the best."
    }
  ]
}