      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.42,
      "end_seconds": 264.8,
      "duration_seconds": 9.38,
      "text": "there is a pill-rolling tremor at rest on the right and the arm is stiff with a cogwheel feel"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.93,
      "end_seconds": 270.43,
      "duration_seconds": 2.5,
      "text": "thank you, you can get dressed"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.83,
      "end_seconds": 285.27,
      "duration_seconds": 4.44,
      "text": "Right, here's what I'm thinking. I'd lean towards possible Parkinson's disease."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.84,
      "end_seconds": 288.37,
      "duration_seconds": 1.53,
      "text": "is this permanent?"
    },
