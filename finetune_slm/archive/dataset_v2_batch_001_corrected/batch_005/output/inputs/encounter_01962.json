    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.17,
      "end_seconds": 192.5,
      "duration_seconds": 2.33,
      "text": "nearly done with the readings.."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.63,
      "end_seconds": 220.31,
      "duration_seconds": 8.68,
      "text": "Okay: BP is 114 over 73, oxygen saturation is 98 percent, pulse 71, temp 36.9 degrees."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.41,
      "end_seconds": 223.08,
      "duration_seconds": 1.67,
      "text": "is that normal?"
