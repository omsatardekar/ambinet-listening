      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.37,
      "end_seconds": 228.35,
      "duration_seconds": 3.98,
      "text": "don't worry, we'll discuss it in a second"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.61,
      "end_seconds": 234.28,
      "duration_seconds": 3.67,
      "text": "Let me look at the area I'll be gentle."
    },
