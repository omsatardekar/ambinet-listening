    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.96,
      "end_seconds": 182.83,
      "duration_seconds": 4.87,
      "text": "can I check a few measurements before we carry on?"
