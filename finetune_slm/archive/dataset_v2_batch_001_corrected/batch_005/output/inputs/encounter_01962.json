      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.63,
      "end_seconds": 177.03,
      "duration_seconds": 4.4,
      "text": "No, I share a house with my brother"
