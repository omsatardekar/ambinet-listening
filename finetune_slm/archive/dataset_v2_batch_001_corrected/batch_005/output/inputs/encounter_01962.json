      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.68,
      "end_seconds": 171.7,
      "duration_seconds": 2.02,
      "text": "do you live by yourself?"
