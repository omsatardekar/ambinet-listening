      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.01,
      "end_seconds": 168.11,
      "duration_seconds": 3.1,
      "text": "I walk the dog every morning"
    },
