      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.38,
      "end_seconds": 298.85,
      "duration_seconds": 9.47,
      "text": "I understand the worry at the moment I'd say it's possible Parkinson's disease, and we'll know more once the a blood test is back"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.02,
      "end_seconds": 314.94,
      "duration_seconds": 4.92,
      "text": "I think a blood test makes sense here, for tremor."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 315.54,
      "end_seconds": 317.93,
      "duration_seconds": 2.39,
      "text": "The earliest is Friday, 10 am."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.67,
      "end_seconds": 341.33,
      "duration_seconds": 22.66,
      "text": "I'm referring you to to the specialist and meanwhile keep active let's get you seen by the movement disorders clinic I'll arrange the letter please don't wait if the symptoms get worse that's when to be seen urgently come back after the specialist does all of that make sense?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.2,
      "end_seconds": 345.37,
