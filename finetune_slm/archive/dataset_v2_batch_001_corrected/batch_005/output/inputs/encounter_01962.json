      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.15,
      "end_seconds": 237.68,
      "duration_seconds": 2.53,
      "text": "take a deep breath for me"
