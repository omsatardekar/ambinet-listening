{
  "schema_version": "1.0",
  "encounter_id": "01882",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.06,
      "end_seconds": 7.14,
      "duration_seconds": 6.08,
      "text": "Doctor, I've brought them through. The observations are done, whenever you need them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.54,
      "end_seconds": 12.17,
      "duration_seconds": 3.63,
      "text": "Okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 13.28,
      "end_seconds": 18.08,
      "duration_seconds": 4.8,
      "text": "I'm here because of an upset stomach in the mornings."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.7,
      "end_seconds": 21.54,
      "duration_seconds": 2.84,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 22.19,
      "end_seconds": 24.9,
      "duration_seconds": 2.71,
      "text": "It's been one week now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.32,
      "end_seconds": 29.72,
      "duration_seconds": 3.4,
      "text": "Okay, is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 31.58,
      "end_seconds": 33.68,
      "duration_seconds": 2.1,
      "text": "Honestly, on and off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.73,
      "end_seconds": 39.78,
      "duration_seconds": 4.05,
      "text": "Okay, what about shaky hands, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 41.68,
      "end_seconds": 48.84,
      "duration_seconds": 7.16,
      "text": "Yeah, that too. As for shaky hands, a seven out of ten, I suppose."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.73,
      "end_seconds": 64.82,
      "duration_seconds": 3.09,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 66.18,
      "end_seconds": 69.34,
      "duration_seconds": 3.16,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.96,
      "end_seconds": 91.68,
      "duration_seconds": 4.72,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 93.61,
      "end_seconds": 105.79,
      "duration_seconds": 12.18,
      "text": "My husband and I live above the shop. Lots of rice, lentils and some fruit. Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.84,
      "end_seconds": 110.76,
      "duration_seconds": 2.92,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 111.38,
      "end_seconds": 117.53,
      "duration_seconds": 6.15,
      "text": "Okay, so yes, I had a bunion operation, six years ago."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.75,
      "end_seconds": 122.55,
      "duration_seconds": 3.8,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 123.83,
      "end_seconds": 125.52,
      "duration_seconds": 1.69,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.56,
      "end_seconds": 129.07,
      "duration_seconds": 2.51,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 133.48,
      "end_seconds": 138.48,
      "duration_seconds": 5.0,
      "text": "Let me think, no, not that I know of."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.85,
      "end_seconds": 155.07,
      "duration_seconds": 5.22,
      "text": "Let me check a few things. Any confusion, vomiting blood or black stools?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 156.73,
      "end_seconds": 160.56,
      "duration_seconds": 3.83,
      "text": "No, no confusion, vomiting blood or black stools."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.54,
      "end_seconds": 164.26,
      "duration_seconds": 1.72,
      "text": "Nothing like yellow eyes?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 165.05,
      "end_seconds": 167.25,
      "duration_seconds": 2.2,
      "text": "No yellow eyes, thankfully."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.91,
      "end_seconds": 169.52,
      "duration_seconds": 1.61,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 171.28,
      "end_seconds": 172.26,
      "duration_seconds": 0.98,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 173.62,
      "end_seconds": 188.73,
      "duration_seconds": 15.11,
      "text": "Here are the numbers, doctor. Pulse is 72 beats a minute, weight 75 kilos. Saturation 97 percent, BMI works out to 23.1, height 180 centimetres, temp 36.4 degrees, pressure 113 over 81."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.29,
      "end_seconds": 191.22,
      "duration_seconds": 1.93,
      "text": "Okay, good, thank you."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.04,
      "end_seconds": 198.05,
      "duration_seconds": 5.01,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 206.5,
      "end_seconds": 207.47,
      "duration_seconds": 0.97,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.97,
      "end_seconds": 210.4,
      "duration_seconds": 1.43,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.28,
      "end_seconds": 235.26,
      "duration_seconds": 5.98,
      "text": "Your liver edge is felt slightly below the ribs and there is a fine tremor."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 235.89,
      "end_seconds": 236.85,
      "duration_seconds": 0.96,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.5,
      "end_seconds": 254.34,
      "duration_seconds": 11.84,
      "text": "Thank you, you can get dressed. From what you've told me and what I found, it points towards harmful alcohol use with liver strain."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 255.44,
      "end_seconds": 258.37,
      "duration_seconds": 2.93,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.25,
      "end_seconds": 291.7,
      "duration_seconds": 28.45,
      "text": "I understand the worry. At the moment I'd say it's harmful alcohol use with liver strain, and we'll know more once the an ultrasound of the liver is back. I think an ultrasound of the liver makes sense here, for hepatomegaly. We should do a blood count for alcohol use. You'll be taking thiamine, 100 milligrams, three times a day, long term. That should help with alcohol-related nutritional deficiency."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 294.56,
      "end_seconds": 297.8,
      "duration_seconds": 3.24,
      "text": "Is that safe with my other medicines?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.37,
      "end_seconds": 308.26,
      "duration_seconds": 9.89,
      "text": "Cut down gradually and do not stop suddenly on your own if you drink heavily. I'll also refer you to the alcohol support service."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 309.74,
      "end_seconds": 312.6,
      "duration_seconds": 2.86,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.99,
      "end_seconds": 326.6,
      "duration_seconds": 10.61,
      "text": "Do get help quickly if the symptoms get worse. Come back after the tests. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 328.51,
      "end_seconds": 332.02,
      "duration_seconds": 3.51,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}