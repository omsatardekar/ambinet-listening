{
  "schema_version": "1.0",
  "encounter_id": "01921",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.22,
      "end_seconds": 6.23,
      "duration_seconds": 5.01,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.53,
      "end_seconds": 11.21,
      "duration_seconds": 3.68,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.09,
      "end_seconds": 18.59,
      "duration_seconds": 6.5,
      "text": "Honestly, it's a little breathlessness, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.43,
      "end_seconds": 22.82,
      "duration_seconds": 3.39,
      "text": "So, are you on any regular medication?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.97,
      "end_seconds": 26.8,
      "duration_seconds": 2.83,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.15,
      "end_seconds": 39.58,
      "duration_seconds": 1.43,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.61,
      "end_seconds": 51.18,
      "duration_seconds": 9.57,
      "text": "It's been two days, I'm fairly sure. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.34,
      "end_seconds": 62.81,
      "duration_seconds": 10.47,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.42,
      "end_seconds": 71.25,
      "duration_seconds": 6.83,
      "text": "Mostly moderate. Yes, stairs. That makes it worse. I'd say every other day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.74,
      "end_seconds": 92.92,
      "duration_seconds": 3.18,
      "text": "Right, have you noticed fainting or palpitations?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.16,
      "end_seconds": 99.04,
      "duration_seconds": 2.88,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.93,
      "end_seconds": 102.45,
      "duration_seconds": 2.52,
      "text": "Did you notice any leg swelling?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.51,
      "end_seconds": 108.02,
      "duration_seconds": 3.51,
      "text": "Not at all, no leg swelling."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.07,
      "end_seconds": 113.47,
      "duration_seconds": 3.4,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.87,
      "end_seconds": 116.41,
      "duration_seconds": 1.54,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.22,
      "end_seconds": 118.74,
      "duration_seconds": 1.52,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.96,
      "end_seconds": 121.99,
      "duration_seconds": 2.03,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.88,
      "end_seconds": 126.16,
      "duration_seconds": 3.28,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.48,
      "end_seconds": 129.92,
      "duration_seconds": 2.44,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.38,
      "end_seconds": 136.62,
      "duration_seconds": 5.24,
      "text": "Right, any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.68,
      "end_seconds": 141.16,
      "duration_seconds": 2.48,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.07,
      "end_seconds": 144.17,
      "duration_seconds": 2.1,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.98,
      "end_seconds": 148.88,
      "duration_seconds": 3.9,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.99,
      "end_seconds": 151.25,
      "duration_seconds": 1.26,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.89,
      "end_seconds": 155.12,
      "duration_seconds": 3.23,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.18,
      "end_seconds": 160.25,
      "duration_seconds": 4.07,
      "text": "So, any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.89,
      "end_seconds": 172.47,
      "duration_seconds": 10.58,
      "text": "Heart disease, for five years. A neighbour of mine said I should see someone about it. I have high blood pressure."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.27,
      "end_seconds": 181.66,
      "duration_seconds": 8.39,
      "text": "Okay, I can see heart disease in your file as well. Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.52,
      "end_seconds": 190.47,
      "duration_seconds": 1.95,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.93,
      "end_seconds": 218.66,
      "duration_seconds": 7.73,
      "text": "Okay: saturation 97 percent, temperature 36.6, heart rate 72. And BP is 122 over 75."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.8,
      "end_seconds": 223.7,
      "duration_seconds": 3.9,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.31,
      "end_seconds": 226.94,
      "duration_seconds": 1.63,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.12,
      "end_seconds": 246.21,
      "duration_seconds": 5.09,
      "text": "Your heart rate and rhythm are regular and the breastbone wound has healed."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.91,
      "end_seconds": 251.34,
      "duration_seconds": 2.43,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.72,
      "end_seconds": 272.42,
      "duration_seconds": 5.7,
      "text": "Right, here's what I'm thinking. It points towards recovering well after a heart attack."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.74,
      "end_seconds": 275.96,
      "duration_seconds": 2.22,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.76,
      "end_seconds": 291.01,
      "duration_seconds": 13.25,
      "text": "It's reasonable to be concerned, but right now recovering well after a heart attack is my leading thought, not anything worse. I'll request an ECG, it'll help with post heart attack review."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 292.18,
      "end_seconds": 295.89,
      "duration_seconds": 3.71,
      "text": "I can book that for Friday at 11:30 am."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.51,
      "end_seconds": 304.15,
      "duration_seconds": 7.64,
      "text": "Start the rehabilitation classes and build up walking gradually. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.79,
      "end_seconds": 308.78,
      "duration_seconds": 2.99,
      "text": "Alright, um, thanks, take care."
    }
  ]
}