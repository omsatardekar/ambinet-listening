{
  "schema_version": "1.0",
  "encounter_id": "01948",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.89,
      "end_seconds": 9.24,
      "duration_seconds": 8.35,
      "text": "Doctor, the patient's with us now. I did the usual checks at the front, so just say when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.09,
      "end_seconds": 15.28,
      "duration_seconds": 4.19,
      "text": "Perfect, thanks. Hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 16.84,
      "end_seconds": 25.14,
      "duration_seconds": 8.3,
      "text": "Okay, uh, so morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.38,
      "end_seconds": 32.06,
      "duration_seconds": 3.68,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 33.96,
      "end_seconds": 43.33,
      "duration_seconds": 9.37,
      "text": "It's, It's a purple rash that does not fade, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.39,
      "end_seconds": 51.14,
      "duration_seconds": 3.75,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 52.15,
      "end_seconds": 55.21,
      "duration_seconds": 3.06,
      "text": "I'd say three days, maybe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 57.25,
      "end_seconds": 61.9,
      "duration_seconds": 4.65,
      "text": "Um, it was closer to five days, doctor."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.39,
      "end_seconds": 67.54,
      "duration_seconds": 4.15,
      "text": "Okay, so roughly three to five days. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 68.06,
      "end_seconds": 71.71,
      "duration_seconds": 3.65,
      "text": "Okay, so I suppose so, yes."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.28,
      "end_seconds": 77.63,
      "duration_seconds": 3.35,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 79.25,
      "end_seconds": 84.69,
      "duration_seconds": 5.44,
      "text": "Maybe a four out of ten on a bad day."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 85.66,
      "end_seconds": 92.5,
      "duration_seconds": 6.84,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 92.6,
      "end_seconds": 98.68,
      "duration_seconds": 6.08,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.26,
      "end_seconds": 106.99,
      "duration_seconds": 6.73,
      "text": "Later, thanks. Please go on. What about cold hands and feet, have you noticed that?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 108.68,
      "end_seconds": 120.68,
      "duration_seconds": 12.0,
      "text": "Mm, yes. Oh, and being drowsy. That's been about the same, about four days. As for being drowsy, mild, really."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.74,
      "end_seconds": 125.08,
      "duration_seconds": 2.34,
      "text": "Have you had a high fever?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 126.93,
      "end_seconds": 133.03,
      "duration_seconds": 6.1,
      "text": "Yes, actually. Okay, so about high fever, it's every other day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 134.41,
      "end_seconds": 137.81,
      "duration_seconds": 3.4,
      "text": "Yes, that's right, that's how it was."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.33,
      "end_seconds": 142.22,
      "duration_seconds": 2.89,
      "text": "Any diarrhoea, cough or stiff neck?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 147.3,
      "end_seconds": 150.45,
      "duration_seconds": 3.15,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.03,
      "end_seconds": 154.38,
      "duration_seconds": 2.35,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 155.9,
      "end_seconds": 160.95,
      "duration_seconds": 5.05,
      "text": "Oh, you know, no, that side's been fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.98,
      "end_seconds": 166.74,
      "duration_seconds": 3.76,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 167.75,
      "end_seconds": 171.89,
      "duration_seconds": 4.14,
      "text": "Eltroxin. I take it 100 micrograms, every morning."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 173.51,
      "end_seconds": 181.97,
      "duration_seconds": 8.46,
      "text": "It's, It's a... um, I can't remember what it's called. It's a round yellow one."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.76,
      "end_seconds": 186.78,
      "duration_seconds": 3.02,
      "text": "Okay, do you remember what it's for?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 188.66,
      "end_seconds": 208.35,
      "duration_seconds": 19.69,
      "text": "I mean, for my bones, I believe. My wife sets them out for me, I just take what I'm given. Sorry, you know, what was I saying, I take metformin, twice a day for my sugar."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.88,
      "end_seconds": 211.88,
      "duration_seconds": 2.0,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 213.67,
      "end_seconds": 222.56,
      "duration_seconds": 8.89,
      "text": "500 milligrams. Right, I'm on febuxostat, 80 milligrams, once a day for the gout."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.91,
      "end_seconds": 227.28,
      "duration_seconds": 3.37,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 228.52,
      "end_seconds": 234.9,
      "duration_seconds": 6.38,
      "text": "Well, I had a caesarean for my second baby nine years ago."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.77,
      "end_seconds": 240.6,
      "duration_seconds": 3.83,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 242.41,
      "end_seconds": 246.41,
      "duration_seconds": 4.0,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 247.56,
      "end_seconds": 257.09,
      "duration_seconds": 9.53,
      "text": "Actually, I remember she had some kind of reaction to trimethoprim before. I couldn't swear to it."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 258.52,
      "end_seconds": 262.8,
      "duration_seconds": 4.28,
      "text": "Actually, maybe, but I don't recall it."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.03,
      "end_seconds": 271.13,
      "duration_seconds": 7.1,
      "text": "Alright, so that's unclear. I'll record what each of you said. Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 272.15,
      "end_seconds": 284.36,
      "duration_seconds": 12.21,
      "text": "I've had an underactive thyroid, yes. I've had thin bones for two years now. I've had diabetes for five years now. Yes, gout."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.53,
      "end_seconds": 297.92,
      "duration_seconds": 12.39,
      "text": "Ah. Yes, an underactive thyroid and thin bones are known to us, good to have that clear. Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 299.23,
      "end_seconds": 312.07,
      "duration_seconds": 12.84,
      "text": "I used to drink heavily but I stopped four years ago. My partner and our baby. I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 313.0,
      "end_seconds": 322.29,
      "duration_seconds": 9.29,
      "text": "Okay, so the vitals from earlier. BP is 122 over 80, temperature is 39.4 degrees, pulse 93, oxygen saturation is 96 percent."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.14,
      "end_seconds": 324.84,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.63,
      "end_seconds": 328.97,
      "duration_seconds": 2.34,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 330.14,
      "end_seconds": 331.23,
      "duration_seconds": 1.09,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.7,
      "end_seconds": 334.79,
      "duration_seconds": 2.09,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.13,
      "end_seconds": 357.89,
      "duration_seconds": 7.76,
      "text": "The purple spots do not fade when I press a glass on them, and he is floppy and drowsy."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.87,
      "end_seconds": 365.6,
      "duration_seconds": 2.73,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 374.85,
      "end_seconds": 383.13,
      "duration_seconds": 8.28,
      "text": "Right, here's what I'm thinking. I'd lean towards possible meningococcal sepsis. A viral rash is also on my list."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 390.16,
      "end_seconds": 397.24,
      "duration_seconds": 7.08,
      "text": "Let's book urgent blood tests to look into possible sepsis. We should do blood cultures for possible sepsis."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 398.42,
      "end_seconds": 401.33,
      "duration_seconds": 2.91,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 402.71,
      "end_seconds": 412.24,
      "duration_seconds": 9.53,
      "text": "What I'm giving you is benzylpenicillin, 600 milligrams, once now, single dose. That should help with possible meningococcal sepsis."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 414.06,
      "end_seconds": 416.29,
      "duration_seconds": 2.23,
      "text": "Mm, um, alright."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 416.84,
      "end_seconds": 431.85,
      "duration_seconds": 15.01,
      "text": "I am giving an antibiotic injection now and calling an ambulance. Let's get you seen by the emergency team, I'll arrange the letter. I'd like to see you again straight away."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 435.72,
      "end_seconds": 437.51,
      "duration_seconds": 1.79,
      "text": "Yes, that's manageable."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 439.05,
      "end_seconds": 442.96,
      "duration_seconds": 3.91,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 444.23,
      "end_seconds": 447.71,
      "duration_seconds": 3.48,
      "text": "Um, thank you, that's helpful."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 449.78,
      "end_seconds": 451.62,
      "duration_seconds": 1.84,
      "text": "Have a good day."
    }
  ]
}