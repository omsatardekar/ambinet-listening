{
  "schema_version": "1.0",
  "encounter_id": "01598",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.02,
      "end_seconds": 4.05,
      "duration_seconds": 3.03,
      "text": "hi there, the chair's free, sit down"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.13,
      "end_seconds": 8.07,
      "duration_seconds": 2.94,
      "text": "Hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 9.49,
      "end_seconds": 15.95,
      "duration_seconds": 6.46,
      "text": "Morning, um, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.96,
      "end_seconds": 20.64,
      "duration_seconds": 3.68,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 25.03,
      "end_seconds": 31.28,
      "duration_seconds": 6.25,
      "text": "It's a little breathlessness, doctor. She didn't want to to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.09,
      "end_seconds": 36.44,
      "duration_seconds": 3.35,
      "text": "how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 37.7,
      "end_seconds": 40.41,
      "duration_seconds": 2.71,
      "text": "It's been two months now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.94,
      "end_seconds": 48.62,
      "duration_seconds": 7.68,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.36,
      "end_seconds": 58.75,
      "duration_seconds": 8.39,
      "text": "Sorry, what was I saying, it feels severe to me. I notice it more with stairs."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.49,
      "end_seconds": 63.67,
      "duration_seconds": 3.18,
      "text": "Have you been feeling nervous about exertion?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 67.96,
      "end_seconds": 70.91,
      "duration_seconds": 2.95,
      "text": "Yeah. About two weeks, I'd say."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.94,
      "end_seconds": 75.69,
      "duration_seconds": 2.75,
      "text": "And what about leg swelling or fainting?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.65,
      "end_seconds": 89.1,
      "duration_seconds": 12.45,
      "text": "No, no leg swelling, no fainting. I did have an ache in my chest wall at one point, but that that went away on its own."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.54,
      "end_seconds": 92.77,
      "duration_seconds": 2.23,
      "text": "Has there been any palpitations?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.31,
      "end_seconds": 97.14,
      "duration_seconds": 2.83,
      "text": "Not at all, no palpitations."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.16,
      "end_seconds": 100.68,
      "duration_seconds": 2.52,
      "text": "So, any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.67,
      "end_seconds": 103.92,
      "duration_seconds": 2.25,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.91,
      "end_seconds": 107.96,
      "duration_seconds": 2.05,
      "text": "anything surgical in your history?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.54,
      "end_seconds": 114.44,
      "duration_seconds": 4.9,
      "text": "just a meniscus repair on my knee, four years ago"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.75,
      "end_seconds": 120.49,
      "duration_seconds": 4.74,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.37,
      "end_seconds": 124.92,
      "duration_seconds": 2.55,
      "text": "I've had high cholesterol, yes"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.34,
      "end_seconds": 131.11,
      "duration_seconds": 1.77,
      "text": "right, any other things?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.39,
      "end_seconds": 139.36,
      "duration_seconds": 6.97,
      "text": "Yes, high blood pressure. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.76,
      "end_seconds": 142.69,
      "duration_seconds": 1.93,
      "text": "Right, any other things?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.78,
      "end_seconds": 148.45,
      "duration_seconds": 4.67,
      "text": "I've got heart disease. I've got arthritis in my knees."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.11,
      "end_seconds": 156.15,
      "duration_seconds": 7.04,
      "text": "Yes, high cholesterol and heart disease are known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.7,
      "end_seconds": 172.74,
      "duration_seconds": 4.04,
      "text": "are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.86,
      "end_seconds": 177.27,
      "duration_seconds": 3.41,
      "text": "Clopidogrel, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 179.04,
      "end_seconds": 184.44,
      "duration_seconds": 5.4,
      "text": "that's what's prescribed, but I'm not sure she takes it every day"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 185.88,
      "end_seconds": 191.1,
      "duration_seconds": 5.22,
      "text": "I'm on diclofenac, when needed for the joint pain."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.72,
      "end_seconds": 194.64,
      "duration_seconds": 2.92,
      "text": "Right, and what strength is that?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 195.6,
      "end_seconds": 199.48,
      "duration_seconds": 3.88,
      "text": "It's 50 milligrams. Paracetamol I don't take anymore."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.1,
      "end_seconds": 222.76,
      "duration_seconds": 4.66,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 227.63,
      "end_seconds": 238.9,
      "duration_seconds": 11.27,
      "text": "I'll have a glass of wine with dinner. I gave up cigarettes last spring. I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 240.86,
      "end_seconds": 251.01,
      "duration_seconds": 10.15,
      "text": "here are the the numbers, doctor spO2 97 percent on room air, respiratory rate 18, pressure 118 over 76. Heart rate 83, temp 36.7 degrees"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.53,
      "end_seconds": 253.23,
      "duration_seconds": 0.7,
      "text": "thanks"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.62,
      "end_seconds": 258.4,
      "duration_seconds": 3.78,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 260.16,
      "end_seconds": 261.22,
      "duration_seconds": 1.06,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.76,
      "end_seconds": 265.01,
      "duration_seconds": 2.25,
      "text": "tell me if that's sore"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.09,
      "end_seconds": 277.74,
      "duration_seconds": 5.65,
      "text": "your heart rate and rhythm are regular and the breastbone wound has healed"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.0,
      "end_seconds": 292.08,
      "duration_seconds": 9.08,
      "text": "That's the examination finished. Putting it all together, it fits best with recovering well after a heart attack. Another possibility is anxiety."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 293.64,
      "end_seconds": 295.62,
      "duration_seconds": 1.98,
      "text": "will it clear up?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.42,
      "end_seconds": 317.27,
      "duration_seconds": 20.85,
      "text": "Nothing I've seen today points to an emergency. It looks like recovering well after a heart attack, but I'd like to confirm. Stop me if I've got anything wrong. You've had a little breathlessness for two months, severe, and no fainting or leg swelling."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 318.92,
      "end_seconds": 321.7,
      "duration_seconds": 2.78,
      "text": "That's it, uh, yes."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 322.52,
      "end_seconds": 328.26,
      "duration_seconds": 5.74,
      "text": "doctor, I did an ECG before they came in, the result's on your screen"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 330.2,
      "end_seconds": 351.34,
      "duration_seconds": 21.14,
      "text": "Thanks, that helps. Let's get a cholesterol test, for secondary prevention. Start the rehabilitation classes and build up walking gradually. Do get help quickly if the symptoms get worse. We'll catch up in three months. Okay, is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 352.5,
      "end_seconds": 355.24,
      "duration_seconds": 2.74,
      "text": "I think I understand everything. Thanks."
    }
  ]
}