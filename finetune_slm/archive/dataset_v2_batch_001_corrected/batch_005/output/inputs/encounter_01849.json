{
  "schema_version": "1.0",
  "encounter_id": "01849",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.86,
      "end_seconds": 3.71,
      "duration_seconds": 2.85,
      "text": "Hello, good to see you. Please sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.06,
      "end_seconds": 8.82,
      "duration_seconds": 3.76,
      "text": "Okay, so good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.87,
      "end_seconds": 12.33,
      "duration_seconds": 2.46,
      "text": "Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.84,
      "end_seconds": 20.56,
      "duration_seconds": 4.72,
      "text": "I've been dealing with red sore skin on my shoulders."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.65,
      "end_seconds": 24.71,
      "duration_seconds": 3.06,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.72,
      "end_seconds": 40.24,
      "duration_seconds": 13.52,
      "text": "Five days, I think... sorry, about four days, I got that wrong. I mean, I've had tightness of the skin too, for about a month."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.25,
      "end_seconds": 44.64,
      "duration_seconds": 2.39,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 45.59,
      "end_seconds": 49.26,
      "duration_seconds": 3.67,
      "text": "I'd say once or twice a day."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.08,
      "end_seconds": 70.43,
      "duration_seconds": 4.35,
      "text": "So, have you had any vomiting, headache or blisters?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 71.02,
      "end_seconds": 73.49,
      "duration_seconds": 2.47,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.77,
      "end_seconds": 76.73,
      "duration_seconds": 2.96,
      "text": "Right, right. Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.36,
      "end_seconds": 81.86,
      "duration_seconds": 3.5,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.85,
      "end_seconds": 100.15,
      "duration_seconds": 1.3,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.7,
      "end_seconds": 102.39,
      "duration_seconds": 1.69,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.22,
      "end_seconds": 105.64,
      "duration_seconds": 2.42,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.04,
      "end_seconds": 114.45,
      "duration_seconds": 4.41,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.55,
      "end_seconds": 120.01,
      "duration_seconds": 4.46,
      "text": "Okay, what does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.66,
      "end_seconds": 125.35,
      "duration_seconds": 3.69,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.92,
      "end_seconds": 129.65,
      "duration_seconds": 2.73,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.7,
      "end_seconds": 135.61,
      "duration_seconds": 3.91,
      "text": "Nothing, um, I haven't had any operations."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.37,
      "end_seconds": 139.53,
      "duration_seconds": 3.16,
      "text": "Alright, before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 141.31,
      "end_seconds": 144.7,
      "duration_seconds": 3.39,
      "text": "Yes, milk. I get a rash."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.84,
      "end_seconds": 149.76,
      "duration_seconds": 3.92,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.93,
      "end_seconds": 157.47,
      "duration_seconds": 1.54,
      "text": "Yes, low haemoglobin."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.23,
      "end_seconds": 164.41,
      "duration_seconds": 6.18,
      "text": "Right, right. Okay, I can see low haemoglobin in your file as well."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.05,
      "end_seconds": 181.43,
      "duration_seconds": 2.38,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 182.44,
      "end_seconds": 188.51,
      "duration_seconds": 6.07,
      "text": "Iron tablets. I take it once a day for my blood count."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.88,
      "end_seconds": 192.13,
      "duration_seconds": 3.25,
      "text": "Yes, carry on. I'll do your observations first."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.6,
      "end_seconds": 203.59,
      "duration_seconds": 1.99,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.65,
      "end_seconds": 227.67,
      "duration_seconds": 9.02,
      "text": "Okay: pulse is 74 beats a minute, SpO2 98 percent on room air, temperature is 36.4 degrees, pressure 119 over 71."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.78,
      "end_seconds": 233.03,
      "duration_seconds": 4.25,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.48,
      "end_seconds": 235.8,
      "duration_seconds": 1.32,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.23,
      "end_seconds": 249.05,
      "duration_seconds": 3.82,
      "text": "The skin is pink and tender with no blistering."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.01,
      "end_seconds": 257.71,
      "duration_seconds": 2.7,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.55,
      "end_seconds": 280.55,
      "duration_seconds": 10.0,
      "text": "Okay, thinking it through, my working impression is mild sunburn. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 282.0,
      "end_seconds": 284.38,
      "duration_seconds": 2.38,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.48,
      "end_seconds": 310.68,
      "duration_seconds": 22.2,
      "text": "Nothing I've seen today points to an emergency. It looks like mild sunburn. Cool compresses, moisturiser and stay out of the sun for a few days. Don't skip meals, and try to eat smaller portions more often through the day. Come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 312.34,
      "end_seconds": 315.75,
      "duration_seconds": 3.41,
      "text": "Thank you, um, that's clear."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 316.88,
      "end_seconds": 320.15,
      "duration_seconds": 3.27,
      "text": "Let's plan a check if blisters develop."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 321.85,
      "end_seconds": 325.56,
      "duration_seconds": 3.71,
      "text": "Come by reception afterwards and I'll fix the appointment."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 326.61,
      "end_seconds": 330.97,
      "duration_seconds": 4.36,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 332.83,
      "end_seconds": 336.05,
      "duration_seconds": 3.22,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 336.63,
      "end_seconds": 338.57,
      "duration_seconds": 1.94,
      "text": "So, see you soon."
    }
  ]
}