{
  "schema_version": "1.0",
  "encounter_id": "01822",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.56,
      "end_seconds": 7.39,
      "duration_seconds": 6.83,
      "text": "Hello, sorry about the delay, do sit. Alright, start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.23,
      "end_seconds": 18.66,
      "duration_seconds": 9.43,
      "text": "I wanted to get not sleeping for days looked at. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.47,
      "end_seconds": 24.7,
      "duration_seconds": 4.23,
      "text": "Okay, how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.37,
      "end_seconds": 28.48,
      "duration_seconds": 2.11,
      "text": "About... well, two months."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.61,
      "end_seconds": 31.66,
      "duration_seconds": 2.05,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.57,
      "end_seconds": 46.91,
      "duration_seconds": 13.34,
      "text": "A plan goes along with it, most of the time. I mean, the plan? That's been for one week. As for plan, mild, really."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.44,
      "end_seconds": 51.97,
      "duration_seconds": 4.53,
      "text": "Did you get recent loss, hearing voices or having taken tablets?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 52.74,
      "end_seconds": 59.7,
      "duration_seconds": 6.96,
      "text": "I haven't had recent loss, hearing voices or having taken tablets, no."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.65,
      "end_seconds": 62.72,
      "duration_seconds": 2.07,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 63.49,
      "end_seconds": 64.96,
      "duration_seconds": 1.47,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.93,
      "end_seconds": 68.7,
      "duration_seconds": 2.77,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.45,
      "end_seconds": 71.55,
      "duration_seconds": 1.1,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.28,
      "end_seconds": 89.42,
      "duration_seconds": 3.14,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 93.19,
      "end_seconds": 95.58,
      "duration_seconds": 2.39,
      "text": "My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.66,
      "end_seconds": 117.38,
      "duration_seconds": 4.72,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.36,
      "end_seconds": 123.09,
      "duration_seconds": 3.73,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.11,
      "end_seconds": 127.3,
      "duration_seconds": 3.19,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.19,
      "end_seconds": 142.26,
      "duration_seconds": 14.07,
      "text": "I'm a bus driver, so I sit for long hours. My partner and our baby. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.54,
      "end_seconds": 145.58,
      "duration_seconds": 2.04,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.49,
      "end_seconds": 158.97,
      "duration_seconds": 12.48,
      "text": "Depression, for two years. I did try to ignore it for a while. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.44,
      "end_seconds": 177.74,
      "duration_seconds": 2.3,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 178.27,
      "end_seconds": 183.71,
      "duration_seconds": 5.44,
      "text": "Yes, I had keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.42,
      "end_seconds": 186.98,
      "duration_seconds": 2.56,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.79,
      "end_seconds": 201.98,
      "duration_seconds": 2.19,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.77,
      "end_seconds": 229.46,
      "duration_seconds": 12.69,
      "text": "Okay: temp 36.4 degrees, BMI works out to 21.0. And SpO2 98 percent on room air, weight 55 kilos, height 162 centimetres, pressure 128 over 76, heart rate 66."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 230.02,
      "end_seconds": 232.53,
      "duration_seconds": 2.51,
      "text": "Right, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.44,
      "end_seconds": 235.75,
      "duration_seconds": 2.31,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.23,
      "end_seconds": 241.13,
      "duration_seconds": 3.9,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.03,
      "end_seconds": 243.45,
      "duration_seconds": 1.42,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.77,
      "end_seconds": 265.54,
      "duration_seconds": 6.77,
      "text": "You are calm but very flat, and you have thought through how you would do it."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.83,
      "end_seconds": 273.63,
      "duration_seconds": 2.8,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.32,
      "end_seconds": 299.6,
      "duration_seconds": 8.28,
      "text": "Okay, thinking it through, the most likely explanation is a high risk of suicide needing urgent assessment."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 301.66,
      "end_seconds": 304.5,
      "duration_seconds": 2.84,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.37,
      "end_seconds": 321.51,
      "duration_seconds": 15.14,
      "text": "It's reasonable to be concerned, but right now a high risk of suicide needing urgent assessment is my leading thought, not anything worse. I want an urgent mental health assessment done, that's for suicidal thoughts."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 322.34,
      "end_seconds": 325.01,
      "duration_seconds": 2.67,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 325.69,
      "end_seconds": 343.59,
      "duration_seconds": 17.9,
      "text": "I want you to stay with me while we arrange help, and your family will be called. Please take the tablets with food so they don't upset your stomach. Let's plan a check straight away. So, I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 344.97,
      "end_seconds": 348.39,
      "duration_seconds": 3.42,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 349.43,
      "end_seconds": 351.04,
      "duration_seconds": 1.61,
      "text": "Have a good day."
    }
  ]
}