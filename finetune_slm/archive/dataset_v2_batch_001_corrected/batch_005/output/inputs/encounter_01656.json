{
  "schema_version": "1.0",
  "encounter_id": "01656",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.83,
      "end_seconds": 3.35,
      "duration_seconds": 2.52,
      "text": "Hi, sit anywhere you like."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 5.06,
      "end_seconds": 9.89,
      "duration_seconds": 4.83,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.73,
      "end_seconds": 18.92,
      "duration_seconds": 7.19,
      "text": "Yes, that's no problem at all. Please sit. So what can I do for you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 19.51,
      "end_seconds": 27.79,
      "duration_seconds": 8.28,
      "text": "It's tingling in my thumb and first fingers, mostly. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.86,
      "end_seconds": 33.4,
      "duration_seconds": 3.54,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 35.13,
      "end_seconds": 39.16,
      "duration_seconds": 4.03,
      "text": "It's been going on for about three months."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.95,
      "end_seconds": 47.85,
      "duration_seconds": 7.9,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 48.78,
      "end_seconds": 54.38,
      "duration_seconds": 5.6,
      "text": "I, I'd say severe. I get some relief from shaking the hand."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.98,
      "end_seconds": 57.25,
      "duration_seconds": 2.27,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 58.27,
      "end_seconds": 63.59,
      "duration_seconds": 5.32,
      "text": "When it starts I tend to get dropping things as well."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 64.52,
      "end_seconds": 72.1,
      "duration_seconds": 7.58,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 72.2,
      "end_seconds": 78.02,
      "duration_seconds": 5.82,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 79.42,
      "end_seconds": 81.77,
      "duration_seconds": 2.35,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.03,
      "end_seconds": 92.47,
      "duration_seconds": 5.44,
      "text": "Okay, that's fine, one at a time. I'll ask about everything."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 93.03,
      "end_seconds": 98.03,
      "duration_seconds": 5.0,
      "text": "The, The dropping things? That's been for two months."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.69,
      "end_seconds": 102.6,
      "duration_seconds": 2.91,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 104.3,
      "end_seconds": 110.05,
      "duration_seconds": 5.75,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.5,
      "end_seconds": 117.95,
      "duration_seconds": 6.45,
      "text": "Alright, take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 118.76,
      "end_seconds": 121.78,
      "duration_seconds": 3.02,
      "text": "Pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.61,
      "end_seconds": 138.92,
      "duration_seconds": 6.31,
      "text": "Any neck pain, pain in the shoulder or weakness in the legs at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 140.59,
      "end_seconds": 159.07,
      "duration_seconds": 18.48,
      "text": "No, no neck pain, no pain in the shoulder, no weakness in the legs. I was waking at night with numb hands at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.46,
      "end_seconds": 163.35,
      "duration_seconds": 2.89,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 163.95,
      "end_seconds": 165.98,
      "duration_seconds": 2.03,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.78,
      "end_seconds": 169.48,
      "duration_seconds": 2.7,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 170.48,
      "end_seconds": 176.92,
      "duration_seconds": 6.44,
      "text": "I've got eczema. I have acid reflux. I've had asthma for two years now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.55,
      "end_seconds": 187.37,
      "duration_seconds": 9.82,
      "text": "Right, so acid reflux is already on your record. We'll keep that in mind today. Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 188.49,
      "end_seconds": 190.56,
      "duration_seconds": 2.07,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.32,
      "end_seconds": 197.42,
      "duration_seconds": 5.1,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 198.06,
      "end_seconds": 210.79,
      "duration_seconds": 12.73,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.3,
      "end_seconds": 216.45,
      "duration_seconds": 5.15,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 218.04,
      "end_seconds": 220.9,
      "duration_seconds": 2.86,
      "text": "I take hydrocortisone cream, when needed."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 222.22,
      "end_seconds": 229.31,
      "duration_seconds": 7.09,
      "text": "It's a... um, I can't remember what it's called. It's a small white one."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.05,
      "end_seconds": 232.6,
      "duration_seconds": 2.55,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 233.26,
      "end_seconds": 263.51,
      "duration_seconds": 30.25,
      "text": "For the reflux, I believe. My husband sets them out for me, I just take what I'm given. Foracort inhaler, twice a day. I didn't want to bother you but it keeps coming back. I did try to ignore it for a while. I'd been on Seretide inhaler, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.41,
      "end_seconds": 265.7,
      "duration_seconds": 1.29,
      "text": "So, any smoking?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 267.24,
      "end_seconds": 270.47,
      "duration_seconds": 3.23,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.72,
      "end_seconds": 275.91,
      "duration_seconds": 1.19,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 277.06,
      "end_seconds": 280.24,
      "duration_seconds": 3.18,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 280.77,
      "end_seconds": 283.05,
      "duration_seconds": 2.28,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 284.61,
      "end_seconds": 290.41,
      "duration_seconds": 5.8,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 305.97,
      "end_seconds": 314.79,
      "duration_seconds": 8.82,
      "text": "Doctor, I've got the readings for you. BP is 120 over 82, respiratory rate 17, pulse is 83 beats a minute."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 315.31,
      "end_seconds": 316.63,
      "duration_seconds": 1.32,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.71,
      "end_seconds": 322.35,
      "duration_seconds": 3.64,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.47,
      "end_seconds": 325.81,
      "duration_seconds": 2.34,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 343.15,
      "end_seconds": 349.48,
      "duration_seconds": 6.33,
      "text": "Tapping over the wrist brings on the tingling and the thumb muscle is slightly thin."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 351.54,
      "end_seconds": 376.81,
      "duration_seconds": 25.27,
      "text": "That's all I needed to check. Taking everything into account, it points towards carpal tunnel syndrome. A pinched nerve in the neck is still possible. Wear a wrist splint at night. I'd like you back in six weeks. Alright, can you tell me the plan back in your own words, so I know I've explained it clearly?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 378.86,
      "end_seconds": 383.94,
      "duration_seconds": 5.08,
      "text": "So, I come back in six weeks. Is that right?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 386.01,
      "end_seconds": 391.93,
      "duration_seconds": 5.92,
      "text": "Yes, exactly right. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 392.86,
      "end_seconds": 394.95,
      "duration_seconds": 2.09,
      "text": "Alright, thanks, take care."
    }
  ]
}