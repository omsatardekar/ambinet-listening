{
  "schema_version": "1.0",
  "encounter_id": "01515",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.62,
      "end_seconds": 3.45,
      "duration_seconds": 2.83,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.61,
      "end_seconds": 9.05,
      "duration_seconds": 4.44,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.8,
      "end_seconds": 19.21,
      "duration_seconds": 8.41,
      "text": "So, I've been waking very early, doctor. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.95,
      "end_seconds": 21.82,
      "duration_seconds": 1.87,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.44,
      "end_seconds": 32.1,
      "duration_seconds": 9.66,
      "text": "About a week, I think... sorry, three weeks, I got that wrong. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.12,
      "end_seconds": 37.22,
      "duration_seconds": 3.1,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.42,
      "end_seconds": 43.23,
      "duration_seconds": 2.81,
      "text": "Pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.06,
      "end_seconds": 46.68,
      "duration_seconds": 2.62,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.91,
      "end_seconds": 54.75,
      "duration_seconds": 2.84,
      "text": "It usually comes with no energy."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.38,
      "end_seconds": 59.41,
      "duration_seconds": 3.03,
      "text": "Have you been feeling low most days?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.78,
      "end_seconds": 64.61,
      "duration_seconds": 3.83,
      "text": "Yeah. Four weeks, you know, I'd say."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.16,
      "end_seconds": 71.15,
      "duration_seconds": 4.99,
      "text": "Have you had any drinking more, panic attacks or hearing voices?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.49,
      "end_seconds": 78.22,
      "duration_seconds": 5.73,
      "text": "No drinking more, panic attacks or hearing voices, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.59,
      "end_seconds": 82.32,
      "duration_seconds": 2.73,
      "text": "Any sign of thoughts of harming myself?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.04,
      "end_seconds": 91.33,
      "duration_seconds": 4.29,
      "text": "Not that I've noticed, no thoughts of harming myself."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.58,
      "end_seconds": 95.99,
      "duration_seconds": 3.41,
      "text": "So, any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.51,
      "end_seconds": 97.47,
      "duration_seconds": 0.96,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.1,
      "end_seconds": 102.01,
      "duration_seconds": 2.91,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.71,
      "end_seconds": 104.68,
      "duration_seconds": 0.97,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.17,
      "end_seconds": 124.14,
      "duration_seconds": 3.97,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.02,
      "end_seconds": 137.22,
      "duration_seconds": 9.2,
      "text": "Gout, for about a year. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.05,
      "end_seconds": 140.52,
      "duration_seconds": 2.47,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.55,
      "end_seconds": 147.59,
      "duration_seconds": 6.04,
      "text": "Just a mole taken off my arm, a few years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.47,
      "end_seconds": 150.31,
      "duration_seconds": 1.84,
      "text": "Right, what's your work?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.41,
      "end_seconds": 155.26,
      "duration_seconds": 3.85,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.29,
      "end_seconds": 160.27,
      "duration_seconds": 1.98,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.17,
      "end_seconds": 163.9,
      "duration_seconds": 2.73,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.87,
      "end_seconds": 183.11,
      "duration_seconds": 2.24,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.99,
      "end_seconds": 197.01,
      "duration_seconds": 12.02,
      "text": "Febuxostat. I take it 80 milligrams, once a day for the gout. Erm, I had allopurinol at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.09,
      "end_seconds": 213.74,
      "duration_seconds": 2.65,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.08,
      "end_seconds": 224.49,
      "duration_seconds": 2.41,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.19,
      "end_seconds": 243.04,
      "duration_seconds": 8.85,
      "text": "Okay: temp 36.5 degrees, pressure 117 over 82, respiratory rate 14, pulse 69, saturation 98 percent."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.94,
      "end_seconds": 248.44,
      "duration_seconds": 3.5,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.37,
      "end_seconds": 252.53,
      "duration_seconds": 3.16,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.57,
      "end_seconds": 266.73,
      "duration_seconds": 5.16,
      "text": "You are tearful and speaking slowly, but you are following everything well."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.75,
      "end_seconds": 285.01,
      "duration_seconds": 14.26,
      "text": "Okay, that's enough for me. Let me tell you where I've got to. It fits best with a moderate depressive episode. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.07,
      "end_seconds": 289.82,
      "duration_seconds": 2.75,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.87,
      "end_seconds": 305.38,
      "duration_seconds": 12.51,
      "text": "Nothing I've seen today points to an emergency. It looks like a moderate depressive episode, but I'd like to confirm. I'd like to arrange a blood count for tiredness."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.97,
      "end_seconds": 312.38,
      "duration_seconds": 2.41,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.5,
      "end_seconds": 326.43,
      "duration_seconds": 12.93,
      "text": "I think a thyroid test makes sense here, for low mood. You'll be taking sertraline, 50 milligrams, once a day in the morning, long term. It's for low mood."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.5,
      "end_seconds": 330.79,
      "duration_seconds": 3.29,
      "text": "Uh, how soon will it work?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.37,
      "end_seconds": 342.51,
      "duration_seconds": 10.14,
      "text": "Try a short walk each day and keep a regular sleep routine. I'll also refer you to the talking therapy service."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.68,
      "end_seconds": 345.27,
      "duration_seconds": 1.59,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.0,
      "end_seconds": 353.07,
      "duration_seconds": 6.07,
      "text": "Please come and see me in two weeks. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 356.77,
      "end_seconds": 361.17,
      "duration_seconds": 4.4,
      "text": "Oh, um, great, thank you for your help."
    }
  ]
}