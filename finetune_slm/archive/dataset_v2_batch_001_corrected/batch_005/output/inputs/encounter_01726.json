{
  "schema_version": "1.0",
  "encounter_id": "01726",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.27,
      "end_seconds": 3.35,
      "duration_seconds": 2.08,
      "text": "Right then, come on in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.25,
      "end_seconds": 6.27,
      "duration_seconds": 1.02,
      "text": "Evening, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.63,
      "end_seconds": 9.6,
      "duration_seconds": 1.97,
      "text": "What's the main thing today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.62,
      "end_seconds": 22.21,
      "duration_seconds": 6.59,
      "text": "Doctor, it's a very fast heartbeat. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.28,
      "end_seconds": 26.16,
      "duration_seconds": 2.88,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 27.04,
      "end_seconds": 31.37,
      "duration_seconds": 4.33,
      "text": "Uh, ever since... since last night, really."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.68,
      "end_seconds": 40.63,
      "duration_seconds": 8.95,
      "text": "Hm, okay. Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.3,
      "end_seconds": 53.13,
      "duration_seconds": 10.83,
      "text": "It happens a few times a day. It feels severe to me. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.64,
      "end_seconds": 56.2,
      "duration_seconds": 2.56,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.82,
      "end_seconds": 67.76,
      "duration_seconds": 9.94,
      "text": "Chest pressure goes along with it, most of the time. As for chest pressure, I'd call it mild."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.18,
      "end_seconds": 70.4,
      "duration_seconds": 1.22,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 72.29,
      "end_seconds": 74.01,
      "duration_seconds": 1.72,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.0,
      "end_seconds": 78.99,
      "duration_seconds": 2.99,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.64,
      "end_seconds": 93.12,
      "duration_seconds": 13.48,
      "text": "I'm a bus driver, so I sit for long hours. I grab fast food at lunch most days. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.64,
      "end_seconds": 107.49,
      "duration_seconds": 2.85,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.97,
      "end_seconds": 111.44,
      "duration_seconds": 2.47,
      "text": "Nothing regular, um, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.22,
      "end_seconds": 132.69,
      "duration_seconds": 2.47,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.53,
      "end_seconds": 140.17,
      "duration_seconds": 5.64,
      "text": "Uh, yes, plasters, it gives me a red itchy rash."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.39,
      "end_seconds": 145.09,
      "duration_seconds": 3.7,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.59,
      "end_seconds": 151.97,
      "duration_seconds": 3.38,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.6,
      "end_seconds": 157.27,
      "duration_seconds": 4.67,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.21,
      "end_seconds": 161.57,
      "duration_seconds": 2.36,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.55,
      "end_seconds": 167.37,
      "duration_seconds": 3.82,
      "text": "Alright, any leg swelling, cough or fever at all?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 171.63,
      "end_seconds": 176.16,
      "duration_seconds": 4.53,
      "text": "No leg swelling, cough or fever, none of it."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.17,
      "end_seconds": 179.65,
      "duration_seconds": 2.48,
      "text": "Alright, is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 182.96,
      "end_seconds": 187.05,
      "duration_seconds": 4.09,
      "text": "Erm, um, no, all normal there."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.12,
      "end_seconds": 192.0,
      "duration_seconds": 2.88,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.16,
      "end_seconds": 203.95,
      "duration_seconds": 2.79,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.0,
      "end_seconds": 230.31,
      "duration_seconds": 7.31,
      "text": "Okay: pulse 95, pressure 98 over 59, saturation 98 percent, temperature is 36.5 degrees."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 231.62,
      "end_seconds": 233.25,
      "duration_seconds": 1.63,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.25,
      "end_seconds": 237.39,
      "duration_seconds": 2.14,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.24,
      "end_seconds": 243.48,
      "duration_seconds": 3.24,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.51,
      "end_seconds": 246.62,
      "duration_seconds": 2.11,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.56,
      "end_seconds": 271.67,
      "duration_seconds": 6.11,
      "text": "Your pulse is over one hundred and eighty and your blood pressure is low."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.01,
      "end_seconds": 283.67,
      "duration_seconds": 8.66,
      "text": "All finished, thank you. Okay, thinking it through, the most likely explanation is a dangerous fast heart rhythm."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.52,
      "end_seconds": 319.11,
      "duration_seconds": 22.59,
      "text": "Let's book blood tests to look into arrhythmia. We should do an urgent ECG for fast heart rhythm. Lie flat, I am calling the emergency team and preparing to shock the heart. I'll also refer you to the emergency team. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 320.89,
      "end_seconds": 324.04,
      "duration_seconds": 3.15,
      "text": "I think I understand everything. Thanks."
    }
  ]
}