{
  "schema_version": "1.0",
  "encounter_id": "01586",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.59,
      "end_seconds": 4.38,
      "duration_seconds": 3.79,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.6,
      "end_seconds": 10.46,
      "duration_seconds": 4.86,
      "text": "Alright, of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.47,
      "end_seconds": 14.79,
      "duration_seconds": 3.32,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.56,
      "end_seconds": 25.43,
      "duration_seconds": 4.87,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.93,
      "end_seconds": 33.39,
      "duration_seconds": 6.46,
      "text": "I've been feeling nervous about exertion, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.58,
      "end_seconds": 39.95,
      "duration_seconds": 5.37,
      "text": "Okay, can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.92,
      "end_seconds": 50.83,
      "duration_seconds": 2.91,
      "text": "So, keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.92,
      "end_seconds": 81.16,
      "duration_seconds": 10.24,
      "text": "Okay: temperature is 36.8 degrees, blood pressure 108 over 70. And pulse is 75 beats a minute, oxygen saturation is 98 percent."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.77,
      "end_seconds": 84.8,
      "duration_seconds": 2.03,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.67,
      "end_seconds": 91.55,
      "duration_seconds": 4.88,
      "text": "We'll go over that shortly. Has this been going on for long?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.37,
      "end_seconds": 95.78,
      "duration_seconds": 2.41,
      "text": "Around two weeks, I think."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 97.79,
      "end_seconds": 101.34,
      "duration_seconds": 3.55,
      "text": "I think it's been nearer three weeks, actually."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.44,
      "end_seconds": 107.54,
      "duration_seconds": 4.1,
      "text": "Okay, so roughly two to three weeks. Is that right?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.84,
      "end_seconds": 111.01,
      "duration_seconds": 2.17,
      "text": "That sounds about right."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.97,
      "end_seconds": 114.06,
      "duration_seconds": 2.09,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.78,
      "end_seconds": 118.53,
      "duration_seconds": 2.75,
      "text": "It usually comes with tiredness."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.91,
      "end_seconds": 123.57,
      "duration_seconds": 3.66,
      "text": "Have you had an ache in your chest wall?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.53,
      "end_seconds": 130.68,
      "duration_seconds": 3.15,
      "text": "Yes, about the same, two days."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.05,
      "end_seconds": 135.25,
      "duration_seconds": 3.2,
      "text": "Has there been a little breathlessness too?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.45,
      "end_seconds": 151.63,
      "duration_seconds": 15.18,
      "text": "Yes, uh, for two days. As for little breathlessness, about a three out of ten. Yes, stairs. That makes it worse. The tiredness? That's been since last weekend."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.5,
      "end_seconds": 156.77,
      "duration_seconds": 3.27,
      "text": "Have you noticed fainting, leg swelling or palpitations?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.78,
      "end_seconds": 160.81,
      "duration_seconds": 2.03,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.65,
      "end_seconds": 164.16,
      "duration_seconds": 2.51,
      "text": "Okay, any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.24,
      "end_seconds": 167.6,
      "duration_seconds": 1.36,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.38,
      "end_seconds": 172.18,
      "duration_seconds": 2.8,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.75,
      "end_seconds": 192.01,
      "duration_seconds": 18.26,
      "text": "I quit smoking around ten years ago. Nothing, I'm teetotal. No, I share a house with my brother. I'm a hairdresser, on my feet all day. Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.33,
      "end_seconds": 203.82,
      "duration_seconds": 3.49,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 205.52,
      "end_seconds": 213.32,
      "duration_seconds": 7.8,
      "text": "He is on ramipril, 5 milligrams, every morning for my blood pressure, I give it to him."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.79,
      "end_seconds": 214.49,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 215.81,
      "end_seconds": 226.66,
      "duration_seconds": 10.85,
      "text": "He is on metoprolol, 50 milligrams, twice a day, I give it to him. I mean, he takes atorvastatin, 20 milligrams, at night."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.71,
      "end_seconds": 232.28,
      "duration_seconds": 4.57,
      "text": "I used to take amlodipine, but I stopped it."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.36,
      "end_seconds": 237.21,
      "duration_seconds": 2.85,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.71,
      "end_seconds": 242.7,
      "duration_seconds": 3.99,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.77,
      "end_seconds": 245.02,
      "duration_seconds": 1.25,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.75,
      "end_seconds": 247.92,
      "duration_seconds": 1.17,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.04,
      "end_seconds": 268.04,
      "duration_seconds": 5.0,
      "text": "Right, what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.67,
      "end_seconds": 276.78,
      "duration_seconds": 4.11,
      "text": "I've had high blood pressure for five years now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.68,
      "end_seconds": 279.38,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.67,
      "end_seconds": 286.08,
      "duration_seconds": 5.41,
      "text": "Heart disease, for five years. High cholesterol, for about a year."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.64,
      "end_seconds": 296.06,
      "duration_seconds": 8.42,
      "text": "Right, so high blood pressure and heart disease are already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.32,
      "end_seconds": 302.24,
      "duration_seconds": 3.92,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.19,
      "end_seconds": 304.93,
      "duration_seconds": 1.74,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.54,
      "end_seconds": 323.09,
      "duration_seconds": 5.55,
      "text": "Your heart rate and rhythm are regular and the breastbone wound has healed."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.34,
      "end_seconds": 337.8,
      "duration_seconds": 1.46,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.57,
      "end_seconds": 354.87,
      "duration_seconds": 13.3,
      "text": "You can relax now. So, based on the history and the examination, it fits best with recovering well after a heart attack. It could also be anxiety, so we'll keep that open."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 356.58,
      "end_seconds": 358.23,
      "duration_seconds": 1.65,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.44,
      "end_seconds": 377.35,
      "duration_seconds": 17.91,
      "text": "It's reasonable to be concerned, but right now recovering well after a heart attack is my leading thought, not anything worse. Let me repeat that back to make sure. You've been feeling nervous about exertion, and no palpitations or fainting."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 379.21,
      "end_seconds": 381.0,
      "duration_seconds": 1.79,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 382.35,
      "end_seconds": 387.19,
      "duration_seconds": 4.84,
      "text": "I'm going to order a cholesterol test, for secondary prevention."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 388.55,
      "end_seconds": 391.18,
      "duration_seconds": 2.63,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 392.76,
      "end_seconds": 404.88,
      "duration_seconds": 12.12,
      "text": "Let's book an ECG to look into post heart attack review. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 409.33,
      "end_seconds": 411.64,
      "duration_seconds": 2.31,
      "text": "Okay, I'll do it."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 413.2,
      "end_seconds": 431.19,
      "duration_seconds": 17.99,
      "text": "Start the rehabilitation classes and build up walking gradually. I'm going to send a referral to the cardiac rehabilitation team. Come back or go to emergency straight away if the symptoms get worse. Okay, I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 431.87,
      "end_seconds": 434.16,
      "duration_seconds": 2.29,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 435.92,
      "end_seconds": 437.84,
      "duration_seconds": 1.92,
      "text": "Have a good day."
    }
  ]
}