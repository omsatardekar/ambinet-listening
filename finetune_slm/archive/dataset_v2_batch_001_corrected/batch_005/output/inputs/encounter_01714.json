{
  "schema_version": "1.0",
  "encounter_id": "01714",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.29,
      "end_seconds": 5.29,
      "duration_seconds": 4.0,
      "text": "Hi, sit anywhere you like. Where shall we begin?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.35,
      "end_seconds": 17.35,
      "duration_seconds": 8.0,
      "text": "Yeah, it's a curtain coming across my vision. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.91,
      "end_seconds": 20.11,
      "duration_seconds": 2.2,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.94,
      "end_seconds": 31.99,
      "duration_seconds": 2.05,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.84,
      "end_seconds": 52.03,
      "duration_seconds": 9.19,
      "text": "Okay: temp 36.9 degrees, respiratory rate 14, heart rate 86. And height 166 centimetres, weight 56 kilos, pressure 115 over 79."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 54.02,
      "end_seconds": 55.6,
      "duration_seconds": 1.58,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.64,
      "end_seconds": 63.33,
      "duration_seconds": 5.69,
      "text": "I'll interpret them after the examination. How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.33,
      "end_seconds": 69.1,
      "duration_seconds": 3.77,
      "text": "Ah, it's been two days now."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.08,
      "end_seconds": 74.02,
      "duration_seconds": 2.94,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.69,
      "end_seconds": 82.02,
      "duration_seconds": 6.33,
      "text": "It, It feels mild to me. And flashes of light, too."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.01,
      "end_seconds": 88.47,
      "duration_seconds": 2.46,
      "text": "Any blurred vision as well?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 90.23,
      "end_seconds": 95.25,
      "duration_seconds": 5.02,
      "text": "Yeah, that too. About blurred vision, mostly severe."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.3,
      "end_seconds": 108.05,
      "duration_seconds": 2.75,
      "text": "Have you noticed headache or red eye?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.8,
      "end_seconds": 112.14,
      "duration_seconds": 3.34,
      "text": "No, no headache or red eye."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.4,
      "end_seconds": 118.04,
      "duration_seconds": 5.64,
      "text": "Understood. Let me check a few things. Any eye pain or recent injury?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.62,
      "end_seconds": 123.73,
      "duration_seconds": 4.11,
      "text": "No, uh, I'd have said so."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.05,
      "end_seconds": 128.56,
      "duration_seconds": 3.51,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.6,
      "end_seconds": 132.3,
      "duration_seconds": 1.7,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.58,
      "end_seconds": 136.37,
      "duration_seconds": 2.79,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 138.35,
      "end_seconds": 143.0,
      "duration_seconds": 4.65,
      "text": "Just an operation for a hernia, last spring."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.58,
      "end_seconds": 147.7,
      "duration_seconds": 3.12,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 152.95,
      "end_seconds": 155.12,
      "duration_seconds": 2.17,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.78,
      "end_seconds": 172.58,
      "duration_seconds": 0.8,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.08,
      "end_seconds": 177.3,
      "duration_seconds": 4.22,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.42,
      "end_seconds": 179.77,
      "duration_seconds": 1.35,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 180.63,
      "end_seconds": 183.68,
      "duration_seconds": 3.05,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.95,
      "end_seconds": 186.55,
      "duration_seconds": 1.6,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 188.41,
      "end_seconds": 192.81,
      "duration_seconds": 4.4,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.39,
      "end_seconds": 194.98,
      "duration_seconds": 1.59,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 196.61,
      "end_seconds": 199.42,
      "duration_seconds": 2.81,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.32,
      "end_seconds": 203.99,
      "duration_seconds": 3.67,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 205.27,
      "end_seconds": 230.44,
      "duration_seconds": 25.17,
      "text": "I've had heart disease for two years now. Sorry, what was I saying, I've got gout. I've been reading about it online and it worried me. I wasn't sure whether to come in at all, to be honest. Yes, thin bones."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.57,
      "end_seconds": 241.69,
      "duration_seconds": 10.12,
      "text": "Alright, heart disease and gout, that matches what I have here. Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 242.28,
      "end_seconds": 245.35,
      "duration_seconds": 3.07,
      "text": "Yes, walnuts. I get hives."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.74,
      "end_seconds": 257.08,
      "duration_seconds": 3.34,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 258.39,
      "end_seconds": 276.4,
      "duration_seconds": 18.01,
      "text": "Right, um, I'm on aspirin, 75 milligrams, once a day for my heart. Febuxostat. I take it 80 milligrams, once a day. Mm, it's something called alen... alendronate, 70 milligrams, maybe, once a week."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 277.01,
      "end_seconds": 280.89,
      "duration_seconds": 3.88,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 282.16,
      "end_seconds": 287.91,
      "duration_seconds": 5.75,
      "text": "Yeah, no, it's at home. Allopurinol I don't take anymore."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.18,
      "end_seconds": 294.29,
      "duration_seconds": 4.11,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 295.74,
      "end_seconds": 297.38,
      "duration_seconds": 1.64,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.57,
      "end_seconds": 299.96,
      "duration_seconds": 1.39,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 316.35,
      "end_seconds": 324.42,
      "duration_seconds": 8.07,
      "text": "The vision in the right eye is much reduced and the field is cut off at the top."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 328.6,
      "end_seconds": 341.23,
      "duration_seconds": 12.63,
      "text": "You can relax now. So where does that leave us? I don't have a clear answer today: a possible retinal detachment needing urgent surgery is possible, and so is a vitreous haemorrhage."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 341.79,
      "end_seconds": 344.78,
      "duration_seconds": 2.99,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 346.44,
      "end_seconds": 367.3,
      "duration_seconds": 20.86,
      "text": "Nothing I've seen today points to an emergency. It looks like a possible retinal detachment needing urgent surgery, but I'd like to confirm. I'm going to order an urgent eye examination, for possible retinal detachment. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 369.04,
      "end_seconds": 372.62,
      "duration_seconds": 3.58,
      "text": "I can book that for Friday at 10 am."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 374.07,
      "end_seconds": 375.22,
      "duration_seconds": 1.15,
      "text": "That's fine."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 376.92,
      "end_seconds": 409.63,
      "duration_seconds": 32.71,
      "text": "You need to be seen by the eye surgeons today, please don't eat or drink. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Please don't wait if the symptoms get worse. That's when to be seen urgently. I'll want another look straight away. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 410.43,
      "end_seconds": 413.59,
      "duration_seconds": 3.16,
      "text": "Um, alright, thanks, take care."
    }
  ]
}