{
  "schema_version": "1.0",
  "encounter_id": "01503",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.63,
      "end_seconds": 5.56,
      "duration_seconds": 4.93,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.82,
      "end_seconds": 11.3,
      "duration_seconds": 4.48,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.17,
      "end_seconds": 25.59,
      "duration_seconds": 9.42,
      "text": "Yeah, it's trouble falling asleep. I don't know what's causing it. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.66,
      "end_seconds": 28.0,
      "duration_seconds": 1.34,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.84,
      "end_seconds": 36.66,
      "duration_seconds": 2.82,
      "text": "Actually, it's been six months now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.31,
      "end_seconds": 42.63,
      "duration_seconds": 2.32,
      "text": "Is anything making it worse?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.9,
      "end_seconds": 48.25,
      "duration_seconds": 4.35,
      "text": "I notice it more with coffee in the evening."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.64,
      "end_seconds": 51.88,
      "duration_seconds": 2.24,
      "text": "Have you been waking tired?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.85,
      "end_seconds": 59.26,
      "duration_seconds": 5.41,
      "text": "Yes, for two days. As for waking tired, mostly moderate."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.4,
      "end_seconds": 78.76,
      "duration_seconds": 2.36,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.28,
      "end_seconds": 90.71,
      "duration_seconds": 2.43,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.64,
      "end_seconds": 114.85,
      "duration_seconds": 6.21,
      "text": "Okay: BP is 109 over 68, pulse 69, saturation 98 percent, temp 36.9 degrees."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.15,
      "end_seconds": 121.41,
      "duration_seconds": 4.26,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.98,
      "end_seconds": 125.54,
      "duration_seconds": 2.56,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.57,
      "end_seconds": 142.65,
      "duration_seconds": 3.08,
      "text": "Your blood pressure and pulse are normal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.93,
      "end_seconds": 153.45,
      "duration_seconds": 1.52,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.59,
      "end_seconds": 165.58,
      "duration_seconds": 6.99,
      "text": "Good, you can sit up again. Have you had any low mood, chest pain or snoring?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.65,
      "end_seconds": 171.45,
      "duration_seconds": 4.8,
      "text": "No low mood, chest pain or snoring, none of it."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.71,
      "end_seconds": 175.48,
      "duration_seconds": 2.77,
      "text": "Have you had any weight change?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.16,
      "end_seconds": 178.1,
      "duration_seconds": 1.94,
      "text": "No weight change, thankfully."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.42,
      "end_seconds": 183.5,
      "duration_seconds": 3.08,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.23,
      "end_seconds": 187.89,
      "duration_seconds": 2.66,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.97,
      "end_seconds": 203.8,
      "duration_seconds": 4.83,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.84,
      "end_seconds": 217.64,
      "duration_seconds": 11.8,
      "text": "I only drink at family occasions. My husband and I live above the shop. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.53,
      "end_seconds": 223.54,
      "duration_seconds": 4.01,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.22,
      "end_seconds": 227.22,
      "duration_seconds": 3.0,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.76,
      "end_seconds": 234.04,
      "duration_seconds": 3.28,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.21,
      "end_seconds": 236.8,
      "duration_seconds": 1.59,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.73,
      "end_seconds": 242.43,
      "duration_seconds": 4.7,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.4,
      "end_seconds": 249.06,
      "duration_seconds": 4.66,
      "text": "I'm on a herbal sleep tea, at night."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.86,
      "end_seconds": 280.61,
      "duration_seconds": 20.75,
      "text": "Taking everything into account, I'd lean towards poor sleep habits. Keep a fixed bedtime, no screens for an hour before bed, and no coffee after lunch. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.8,
      "end_seconds": 283.8,
      "duration_seconds": 2.0,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.36,
      "end_seconds": 287.98,
      "duration_seconds": 3.62,
      "text": "Please come and see me in four weeks."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.15,
      "end_seconds": 293.54,
      "duration_seconds": 4.39,
      "text": "Ah, I'll book it on my way out."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.46,
      "end_seconds": 296.88,
      "duration_seconds": 2.42,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.46,
      "end_seconds": 302.17,
      "duration_seconds": 3.71,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.54,
      "end_seconds": 304.77,
      "duration_seconds": 1.23,
      "text": "Take care now."
    }
  ]
}