{
  "schema_version": "1.0",
  "encounter_id": "01638",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.75,
      "end_seconds": 6.13,
      "duration_seconds": 5.38,
      "text": "Right, thanks for waiting, come in. What do you need help with?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.72,
      "end_seconds": 12.19,
      "duration_seconds": 5.47,
      "text": "Mainly I've been passing huge amounts of urine. That's why I came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.06,
      "end_seconds": 16.2,
      "duration_seconds": 3.14,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 17.13,
      "end_seconds": 20.34,
      "duration_seconds": 3.21,
      "text": "It's been about three months now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.67,
      "end_seconds": 27.73,
      "duration_seconds": 4.06,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.28,
      "end_seconds": 35.76,
      "duration_seconds": 7.48,
      "text": "Moderate, I'd say. Weakness was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.54,
      "end_seconds": 40.03,
      "duration_seconds": 2.49,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.4,
      "end_seconds": 53.96,
      "duration_seconds": 2.56,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.75,
      "end_seconds": 75.92,
      "duration_seconds": 9.17,
      "text": "Okay: respiratory rate 16, temp 36.8 degrees, pulse 110. And saturation 96 percent, BP is 132 over 83."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.56,
      "end_seconds": 82.98,
      "duration_seconds": 4.42,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.47,
      "end_seconds": 86.47,
      "duration_seconds": 2.0,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.02,
      "end_seconds": 107.78,
      "duration_seconds": 6.76,
      "text": "You are very dry and drowsy, and your sugar reading is too high to read."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.26,
      "end_seconds": 116.57,
      "duration_seconds": 3.31,
      "text": "You can relax now. What about vomiting?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.92,
      "end_seconds": 121.78,
      "duration_seconds": 3.86,
      "text": "Not that I've noticed, um, no vomiting."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.01,
      "end_seconds": 125.11,
      "duration_seconds": 2.1,
      "text": "Any fever or chest pain?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.83,
      "end_seconds": 128.42,
      "duration_seconds": 2.59,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.3,
      "end_seconds": 132.42,
      "duration_seconds": 3.12,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 133.82,
      "end_seconds": 135.3,
      "duration_seconds": 1.48,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.87,
      "end_seconds": 142.24,
      "duration_seconds": 3.37,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.04,
      "end_seconds": 144.09,
      "duration_seconds": 1.05,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.19,
      "end_seconds": 162.86,
      "duration_seconds": 3.67,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 164.29,
      "end_seconds": 169.25,
      "duration_seconds": 4.96,
      "text": "Tramadol. I come out in... well, feeling very drowsy."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.92,
      "end_seconds": 171.12,
      "duration_seconds": 1.2,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 172.99,
      "end_seconds": 176.09,
      "duration_seconds": 3.1,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.76,
      "end_seconds": 178.71,
      "duration_seconds": 0.95,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 179.55,
      "end_seconds": 182.8,
      "duration_seconds": 3.25,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 183.97,
      "end_seconds": 187.14,
      "duration_seconds": 3.17,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 188.44,
      "end_seconds": 192.35,
      "duration_seconds": 3.91,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.37,
      "end_seconds": 196.62,
      "duration_seconds": 3.25,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 198.58,
      "end_seconds": 201.76,
      "duration_seconds": 3.18,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.83,
      "end_seconds": 205.66,
      "duration_seconds": 1.83,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.61,
      "end_seconds": 211.37,
      "duration_seconds": 3.76,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.93,
      "end_seconds": 227.84,
      "duration_seconds": 2.91,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 229.67,
      "end_seconds": 232.52,
      "duration_seconds": 2.85,
      "text": "Diabetes, for about a year."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.69,
      "end_seconds": 244.98,
      "duration_seconds": 1.29,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 246.14,
      "end_seconds": 247.36,
      "duration_seconds": 1.22,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.07,
      "end_seconds": 251.71,
      "duration_seconds": 3.64,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 253.37,
      "end_seconds": 256.93,
      "duration_seconds": 3.56,
      "text": "Glycomet. I take it twice a day."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.52,
      "end_seconds": 259.55,
      "duration_seconds": 2.03,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 260.85,
      "end_seconds": 261.78,
      "duration_seconds": 0.93,
      "text": "500 milligrams."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.75,
      "end_seconds": 266.65,
      "duration_seconds": 1.9,
      "text": "So, is that long-standing?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 268.35,
      "end_seconds": 270.59,
      "duration_seconds": 2.24,
      "text": "For about three months."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.17,
      "end_seconds": 279.34,
      "duration_seconds": 7.17,
      "text": "Let me tell you where I've got to. I'd lean towards a hyperosmolar diabetic emergency."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 280.55,
      "end_seconds": 283.26,
      "duration_seconds": 2.71,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.95,
      "end_seconds": 299.33,
      "duration_seconds": 14.38,
      "text": "Nothing I've seen today points to an emergency. It looks like a hyperosmolar diabetic emergency, but I'd like to confirm. An ECG is what I'd like next, for hyperglycaemic emergency."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 300.05,
      "end_seconds": 303.54,
      "duration_seconds": 3.49,
      "text": "I can book that for Tuesday at 2 pm."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 305.14,
      "end_seconds": 309.67,
      "duration_seconds": 4.53,
      "text": "I'm sending you for urgent blood tests because of hyperglycaemic emergency."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 310.72,
      "end_seconds": 312.62,
      "duration_seconds": 1.9,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 314.69,
      "end_seconds": 335.91,
      "duration_seconds": 21.22,
      "text": "You need hospital now for fluids and insulin. Cut down on salt and fried food for now, it really does make a difference. I think the emergency team should see you too. Come back or go to emergency straight away if the symptoms get worse. See me again straight away."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 341.67,
      "end_seconds": 343.47,
      "duration_seconds": 1.8,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 344.22,
      "end_seconds": 347.69,
      "duration_seconds": 3.47,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 348.6,
      "end_seconds": 351.28,
      "duration_seconds": 2.68,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 355.44,
      "end_seconds": 357.12,
      "duration_seconds": 1.68,
      "text": "Have a good day."
    }
  ]
}