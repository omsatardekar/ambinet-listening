{
  "schema_version": "1.0",
  "encounter_id": "01673",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.73,
      "end_seconds": 3.59,
      "duration_seconds": 2.86,
      "text": "Alright, afternoon, thanks for coming in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 4.7,
      "end_seconds": 9.61,
      "duration_seconds": 4.91,
      "text": "Hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.55,
      "end_seconds": 16.33,
      "duration_seconds": 5.78,
      "text": "Absolutely, come and sit beside them. How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 17.63,
      "end_seconds": 24.14,
      "duration_seconds": 6.51,
      "text": "It's loud snoring, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.0,
      "end_seconds": 29.35,
      "duration_seconds": 3.35,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 30.31,
      "end_seconds": 32.4,
      "duration_seconds": 2.09,
      "text": "About... well, ten days."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.33,
      "end_seconds": 36.55,
      "duration_seconds": 2.22,
      "text": "Is anything making it worse?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 41.25,
      "end_seconds": 48.82,
      "duration_seconds": 7.57,
      "text": "It's worse with alcohol. Oh, and morning headaches. That's been about the same, two months."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 49.41,
      "end_seconds": 51.66,
      "duration_seconds": 2.25,
      "text": "Have you had daytime sleepiness?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 53.49,
      "end_seconds": 59.69,
      "duration_seconds": 6.2,
      "text": "Yes, actually. About daytime sleepiness, pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.17,
      "end_seconds": 76.4,
      "duration_seconds": 3.23,
      "text": "And what about chest pain or leg swelling?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 77.75,
      "end_seconds": 81.51,
      "duration_seconds": 3.76,
      "text": "No, no chest pain or leg swelling."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.02,
      "end_seconds": 84.39,
      "duration_seconds": 2.37,
      "text": "Understood. Have you had any choking?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 85.98,
      "end_seconds": 88.6,
      "duration_seconds": 2.62,
      "text": "I haven't noticed any choking."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.03,
      "end_seconds": 92.84,
      "duration_seconds": 2.81,
      "text": "Okay, is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 97.26,
      "end_seconds": 98.69,
      "duration_seconds": 1.43,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.78,
      "end_seconds": 111.26,
      "duration_seconds": 4.48,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 112.51,
      "end_seconds": 114.97,
      "duration_seconds": 2.46,
      "text": "My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.65,
      "end_seconds": 119.35,
      "duration_seconds": 3.7,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 120.3,
      "end_seconds": 122.4,
      "duration_seconds": 2.1,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.47,
      "end_seconds": 126.27,
      "duration_seconds": 1.8,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 127.51,
      "end_seconds": 129.24,
      "duration_seconds": 1.73,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.25,
      "end_seconds": 131.65,
      "duration_seconds": 1.4,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 132.5,
      "end_seconds": 136.18,
      "duration_seconds": 3.68,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.3,
      "end_seconds": 139.49,
      "duration_seconds": 2.19,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 141.53,
      "end_seconds": 145.54,
      "duration_seconds": 4.01,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.58,
      "end_seconds": 149.2,
      "duration_seconds": 1.62,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 150.82,
      "end_seconds": 155.16,
      "duration_seconds": 4.34,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.58,
      "end_seconds": 158.35,
      "duration_seconds": 1.77,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 159.24,
      "end_seconds": 161.53,
      "duration_seconds": 2.29,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.94,
      "end_seconds": 171.21,
      "duration_seconds": 4.27,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 173.16,
      "end_seconds": 178.31,
      "duration_seconds": 5.15,
      "text": "I'm allergic to diclofenac, I get swelling of my lips."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.38,
      "end_seconds": 183.09,
      "duration_seconds": 2.71,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 186.8,
      "end_seconds": 187.82,
      "duration_seconds": 1.02,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.18,
      "end_seconds": 195.16,
      "duration_seconds": 1.98,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.65,
      "end_seconds": 211.37,
      "duration_seconds": 2.72,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.39,
      "end_seconds": 234.46,
      "duration_seconds": 8.07,
      "text": "Okay: respiratory rate 17, pulse 72, pressure 162 over 93, SpO2 97 percent on room air, temperature 36.4."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.52,
      "end_seconds": 238.82,
      "duration_seconds": 2.3,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.83,
      "end_seconds": 241.11,
      "duration_seconds": 1.28,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.57,
      "end_seconds": 258.48,
      "duration_seconds": 3.91,
      "text": "You have a thick neck and a crowded throat."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.62,
      "end_seconds": 264.36,
      "duration_seconds": 1.74,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.25,
      "end_seconds": 283.49,
      "duration_seconds": 5.24,
      "text": "Right, here's what I'm thinking. This looks most like probable obstructive sleep apnoea."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 284.52,
      "end_seconds": 287.24,
      "duration_seconds": 2.72,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.26,
      "end_seconds": 325.18,
      "duration_seconds": 36.92,
      "text": "I can't promise yet, but most people with probable obstructive sleep apnoea do well once it's treated properly. I'm sending you for a thyroid test because of tiredness. I'd like to arrange a home sleep study for snoring and apnoeas. The result will help us decide whether anything more is needed. Avoid alcohol in the evening, lose some weight if you can, and do not drive when drowsy. Please come and see me after the sleep study."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 326.86,
      "end_seconds": 328.77,
      "duration_seconds": 1.91,
      "text": "Alright, I'll be back."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 330.04,
      "end_seconds": 334.87,
      "duration_seconds": 4.83,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 336.07,
      "end_seconds": 338.91,
      "duration_seconds": 2.84,
      "text": "Great, thank you for your help."
    }
  ]
}