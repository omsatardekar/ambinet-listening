  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.93,
      "end_seconds": 5.29,
      "duration_seconds": 4.36,
      "text": "Good morning, grab a seat. Where shall we begin?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.47,
      "end_seconds": 9.99,
      "duration_seconds": 3.52,
      "text": "Well, I've been having being extremely thirsty."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.05,
      "end_seconds": 16.62,
      "duration_seconds": 4.57,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 17.58,
      "end_seconds": 25.58,
      "duration_seconds": 8.0,
      "text": "I take something called glic... gliclazide, 80 milligrams, maybe, twice a day for my sugar."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.43,
      "end_seconds": 29.54,
      "duration_seconds": 3.11,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.03,
      "end_seconds": 40.29,
      "duration_seconds": 9.26,
      "text": "Not with me. I'll bring it next time. I'd been on metformin, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.61,
      "end_seconds": 41.52,
      "duration_seconds": 0.91,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.24,
      "end_seconds": 47.42,
      "duration_seconds": 5.18,
      "text": "Yeah, there was weakness, yes, but that went away."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 48.55,
      "end_seconds": 53.75,
      "duration_seconds": 5.2,
      "text": "have you had being extremely thirsty before, or is this the first time?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 55.05,
      "end_seconds": 65.15,
      "duration_seconds": 10.1,
      "text": "oh, you know, yes, something like this happened last winter, and it went away on its own"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.15,
      "end_seconds": 82.65,
      "duration_seconds": 3.5,
      "text": "any chest pain, fever or vomiting at all?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.41,
      "end_seconds": 88.12,
      "duration_seconds": 4.71,
      "text": "No chest pain, fever or vomiting, none of it."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.11,
      "end_seconds": 93.24,
      "duration_seconds": 3.13,
      "text": "Alright, any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.28,
      "end_seconds": 98.38,
      "duration_seconds": 3.1,
      "text": "Hmm, no problems with breathing."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.54,
      "end_seconds": 102.0,
      "duration_seconds": 2.46,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.86,
      "end_seconds": 107.38,
      "duration_seconds": 3.52,
      "text": "Um, bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.66,
      "end_seconds": 125.57,
      "duration_seconds": 3.91,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 126.74,
      "end_seconds": 129.59,
      "duration_seconds": 2.85,
      "text": "Erm, my cousin has psoriasis."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.56,
      "end_seconds": 135.07,
      "duration_seconds": 4.51,
      "text": "So, tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 140.23,
      "end_seconds": 145.55,
      "duration_seconds": 5.32,
      "text": "I have diabetes. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.59,
      "end_seconds": 152.08,
      "duration_seconds": 4.49,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 152.9,
      "end_seconds": 164.73,
      "duration_seconds": 11.83,
      "text": "I hardly move around during the day. I drink a lot of tea and snack through the day. I work in accounts at a hospital"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.84,
      "end_seconds": 168.66,
      "duration_seconds": 2.82,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.85,
      "end_seconds": 180.82,
      "duration_seconds": 2.97,
      "text": "Right, that's it, just a little longer..."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.8,
      "end_seconds": 211.21,
      "duration_seconds": 15.41,
      "text": "Okay: BMI works out to 33.7, weight 93 kilos. And respiratory rate 17, oxygen saturation is 98 percent, blood pressure 128 over 74, height 166 centimetres, pulse 111, temp 36.6 degrees."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.57,
      "end_seconds": 216.71,
      "duration_seconds": 4.14,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.67,
      "end_seconds": 220.52,
      "duration_seconds": 2.85,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.33,
      "end_seconds": 236.43,
      "duration_seconds": 6.1,
      "text": "you are very dry and drowsy, and your sugar reading is too high to read"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 254.46,
      "end_seconds": 255.42,
      "duration_seconds": 0.96,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.95,
      "end_seconds": 268.39,
      "duration_seconds": 8.44,
      "text": "All finished, thank you. From what you've told me and what I found, it fits best with a hyperosmolar diabetic emergency."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 269.34,
      "end_seconds": 272.23,
      "duration_seconds": 2.89,
      "text": "Um, is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.93,
      "end_seconds": 286.45,
      "duration_seconds": 12.52,
      "text": "nothing I've seen today points to an emergency. It looks like a hyperosmolar diabetic emergency, but I'd like to confirm. Let's get an ECG, for hyperglycaemic emergency"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 287.7,
      "end_seconds": 289.78,
      "duration_seconds": 2.08,
      "text": "Okay, I'll do it."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.81,
      "end_seconds": 304.44,
      "duration_seconds": 12.63,
      "text": "I'd like to arrange urgent blood tests for hyperglycaemic emergency you need hospital now for fluids and insulin i'll also refer you to the emergency team"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 305.77,
      "end_seconds": 306.47,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.55,
      "end_seconds": 318.93,
      "duration_seconds": 9.38,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 319.92,
      "end_seconds": 322.4,
      "duration_seconds": 2.48,
      "text": "alright, um, I follow"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.19,
      "end_seconds": 326.95,
      "duration_seconds": 3.76,
      "text": "do get help quickly if the symptoms get worse"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 327.83,
      "end_seconds": 329.18,
      "duration_seconds": 1.35,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 331.08,
      "end_seconds": 337.07,
      "duration_seconds": 5.99,
      "text": "Come back straight away. Right, that's the plan. Do you wanna ask me anything?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 339.1,
      "end_seconds": 342.16,
      "duration_seconds": 3.06,
      "text": "No, that's all. Thanks a lot."
    }
  ]
