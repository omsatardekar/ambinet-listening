{
  "schema_version": "1.0",
  "encounter_id": "01919",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.29,
      "end_seconds": 4.7,
      "duration_seconds": 3.41,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.91,
      "end_seconds": 10.18,
      "duration_seconds": 4.27,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.28,
      "end_seconds": 21.3,
      "duration_seconds": 5.02,
      "text": "I wanted to get a little breathlessness looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.98,
      "end_seconds": 26.9,
      "duration_seconds": 3.92,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.56,
      "end_seconds": 37.06,
      "duration_seconds": 2.5,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.56,
      "end_seconds": 67.7,
      "duration_seconds": 11.14,
      "text": "Okay: saturation 99 percent, height 174 centimetres, weight 86 kilos. And BMI works out to 28.4, BP is 127 over 73, pulse 67."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.14,
      "end_seconds": 71.18,
      "duration_seconds": 2.04,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.18,
      "end_seconds": 77.54,
      "duration_seconds": 5.36,
      "text": "We'll go over that shortly. Alright, did it come on recently?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.31,
      "end_seconds": 88.84,
      "duration_seconds": 9.53,
      "text": "It's been going on for about four days. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.4,
      "end_seconds": 94.04,
      "duration_seconds": 4.64,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.06,
      "end_seconds": 108.65,
      "duration_seconds": 13.59,
      "text": "Oh, about a four out of ten. I'd say once or twice a day. Only resting, and it's not much. I notice it more with stairs."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.07,
      "end_seconds": 115.39,
      "duration_seconds": 5.32,
      "text": "Okay, what about an ache in your chest wall, have you noticed that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.64,
      "end_seconds": 121.22,
      "duration_seconds": 2.58,
      "text": "Yes, you know, I have."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.24,
      "end_seconds": 125.7,
      "duration_seconds": 2.46,
      "text": "Did you get fainting or palpitations?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.39,
      "end_seconds": 130.21,
      "duration_seconds": 3.82,
      "text": "I haven't had fainting or palpitations, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.36,
      "end_seconds": 134.37,
      "duration_seconds": 3.01,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.4,
      "end_seconds": 138.54,
      "duration_seconds": 2.14,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.57,
      "end_seconds": 142.79,
      "duration_seconds": 2.22,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.43,
      "end_seconds": 148.85,
      "duration_seconds": 1.42,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.24,
      "end_seconds": 163.76,
      "duration_seconds": 5.52,
      "text": "Right, do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.07,
      "end_seconds": 168.82,
      "duration_seconds": 3.75,
      "text": "Uh, no, nothing I can think of."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.29,
      "end_seconds": 181.88,
      "duration_seconds": 2.59,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.05,
      "end_seconds": 185.53,
      "duration_seconds": 2.48,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.18,
      "end_seconds": 196.72,
      "duration_seconds": 2.54,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.9,
      "end_seconds": 200.99,
      "duration_seconds": 3.09,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.37,
      "end_seconds": 205.22,
      "duration_seconds": 2.85,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.91,
      "end_seconds": 209.95,
      "duration_seconds": 4.04,
      "text": "Yes, milk, it gives me a rash."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.14,
      "end_seconds": 214.34,
      "duration_seconds": 3.2,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.1,
      "end_seconds": 216.94,
      "duration_seconds": 1.84,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.71,
      "end_seconds": 221.33,
      "duration_seconds": 2.62,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.36,
      "end_seconds": 241.12,
      "duration_seconds": 18.76,
      "text": "I used to drink heavily but I stopped four years ago. I'm a plumber, lots of bending and kneeling. Lots of rice, lentils and some fruit. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.64,
      "end_seconds": 246.39,
      "duration_seconds": 3.75,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.19,
      "end_seconds": 249.0,
      "duration_seconds": 1.81,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.29,
      "end_seconds": 271.12,
      "duration_seconds": 5.83,
      "text": "Your heart rate and rhythm are regular and the breastbone wound has healed."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.99,
      "end_seconds": 279.08,
      "duration_seconds": 3.09,
      "text": "So, thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.14,
      "end_seconds": 304.86,
      "duration_seconds": 12.72,
      "text": "Let's get a cholesterol test, for secondary prevention. Start the rehabilitation classes and build up walking gradually. We'll refer you to the cardiac rehabilitation team. I'll want another look in three months."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.85,
      "end_seconds": 310.07,
      "duration_seconds": 3.22,
      "text": "I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.8,
      "end_seconds": 316.38,
      "duration_seconds": 4.58,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.46,
      "end_seconds": 322.6,
      "duration_seconds": 4.14,
      "text": "Great, um, thank you for your help."
    }
  ]
}