{
  "schema_version": "1.0",
  "encounter_id": "01892",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.36,
      "end_seconds": 4.96,
      "duration_seconds": 3.6,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.9,
      "end_seconds": 10.26,
      "duration_seconds": 4.36,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.87,
      "end_seconds": 20.29,
      "duration_seconds": 8.42,
      "text": "I mean, doctor, it's a pulled muscle in my thigh. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.31,
      "end_seconds": 22.75,
      "duration_seconds": 1.44,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.71,
      "end_seconds": 28.63,
      "duration_seconds": 3.92,
      "text": "It's been going on for two months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.91,
      "end_seconds": 32.69,
      "duration_seconds": 2.78,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.4,
      "end_seconds": 35.27,
      "duration_seconds": 1.87,
      "text": "I'd call it mild."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.24,
      "end_seconds": 38.93,
      "duration_seconds": 1.69,
      "text": "Have you had tightness?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.8,
      "end_seconds": 48.86,
      "duration_seconds": 9.06,
      "text": "Yes, about the same, about a week. And there's a bit of bruising as well, three days now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.88,
      "end_seconds": 57.69,
      "duration_seconds": 7.81,
      "text": "Have you had a pulled muscle in your thigh before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.2,
      "end_seconds": 68.26,
      "duration_seconds": 9.06,
      "text": "Yes, something like this happened a couple of years ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.81,
      "end_seconds": 84.44,
      "duration_seconds": 2.63,
      "text": "Have you noticed fall or numbness?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.18,
      "end_seconds": 89.03,
      "duration_seconds": 3.85,
      "text": "I haven't had fall or numbness, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.66,
      "end_seconds": 94.73,
      "duration_seconds": 4.07,
      "text": "Any pop at the time or swelling at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.98,
      "end_seconds": 101.09,
      "duration_seconds": 5.11,
      "text": "Sorry, what was I saying, nope, nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.94,
      "end_seconds": 104.41,
      "duration_seconds": 2.47,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.23,
      "end_seconds": 110.09,
      "duration_seconds": 3.86,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.07,
      "end_seconds": 117.17,
      "duration_seconds": 5.1,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.52,
      "end_seconds": 126.0,
      "duration_seconds": 7.48,
      "text": "Years back I got itching from trimethoprim, so I stay away from it now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.87,
      "end_seconds": 140.64,
      "duration_seconds": 3.77,
      "text": "Right, what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.37,
      "end_seconds": 147.72,
      "duration_seconds": 6.35,
      "text": "Sumatriptan. I take it 50 milligrams, when needed for my migraines."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 148.45,
      "end_seconds": 153.71,
      "duration_seconds": 5.26,
      "text": "Doctor, our chart from the last visit lists it as 100 milligrams."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.61,
      "end_seconds": 158.99,
      "duration_seconds": 4.38,
      "text": "I see. Is the most recent prescription on you?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.02,
      "end_seconds": 168.69,
      "duration_seconds": 7.67,
      "text": "Not with me. I'll bring it next time. Escitalopram, 10 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.24,
      "end_seconds": 174.3,
      "duration_seconds": 4.06,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.28,
      "end_seconds": 181.54,
      "duration_seconds": 2.26,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.42,
      "end_seconds": 185.87,
      "duration_seconds": 3.45,
      "text": "Alright, do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.89,
      "end_seconds": 199.07,
      "duration_seconds": 11.18,
      "text": "I've had migraines for five years now. I wasn't sure whether to come in at all, to be honest. Anxiety, for nearly five years."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.6,
      "end_seconds": 210.37,
      "duration_seconds": 6.77,
      "text": "Yes, carry on. Okay, tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.22,
      "end_seconds": 228.03,
      "duration_seconds": 15.81,
      "text": "I quit smoking around ten years ago. Nothing, I'm teetotal. My partner and our baby. Not much, I mostly stay in these days. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 229.99,
      "end_seconds": 241.67,
      "duration_seconds": 11.68,
      "text": "Doctor, I've got the readings for you. Pressure 116 over 68, temperature is 36.4 degrees. Respiratory rate 17, pulse 73, SpO2 99 percent on room air."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.47,
      "end_seconds": 243.45,
      "duration_seconds": 0.98,
      "text": "Right, thanks."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.68,
      "end_seconds": 248.14,
      "duration_seconds": 2.46,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.78,
      "end_seconds": 252.45,
      "duration_seconds": 2.67,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.08,
      "end_seconds": 269.79,
      "duration_seconds": 7.71,
      "text": "There is mild tenderness in the back of the thigh and you can still straighten the knee fully."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.54,
      "end_seconds": 282.33,
      "duration_seconds": 6.79,
      "text": "Please sit back down. Okay, thinking it through, this looks most like a mild hamstring strain."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.51,
      "end_seconds": 317.5,
      "duration_seconds": 19.99,
      "text": "Rest for a few days, ice it, and then ease back in with gentle stretching. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. See me again if not better in two weeks. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.12,
      "end_seconds": 323.82,
      "duration_seconds": 4.7,
      "text": "So, okay, that makes sense. Thanks for explaining."
    }
  ]
}