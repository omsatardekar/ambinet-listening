{
  "schema_version": "1.0",
  "encounter_id": "01646",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.8,
      "end_seconds": 4.11,
      "duration_seconds": 3.31,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.68,
      "end_seconds": 9.37,
      "duration_seconds": 4.69,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.19,
      "end_seconds": 15.89,
      "duration_seconds": 5.7,
      "text": "Yeah, um, I'm here because of a dull low backache."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.81,
      "end_seconds": 21.24,
      "duration_seconds": 3.43,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.36,
      "end_seconds": 28.03,
      "duration_seconds": 5.67,
      "text": "It started yesterday. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.64,
      "end_seconds": 32.48,
      "duration_seconds": 2.84,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.88,
      "end_seconds": 37.3,
      "duration_seconds": 3.42,
      "text": "Mm, pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.47,
      "end_seconds": 42.54,
      "duration_seconds": 4.07,
      "text": "Alright, have you been feeling a bit feverish?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.52,
      "end_seconds": 46.79,
      "duration_seconds": 2.27,
      "text": "Yes, uh, actually."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.16,
      "end_seconds": 52.46,
      "duration_seconds": 4.3,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.24,
      "end_seconds": 64.52,
      "duration_seconds": 10.28,
      "text": "It's diclofenac, 50 milligrams, when needed. I had paracetamol at one point, you know, but I'm off it now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.18,
      "end_seconds": 68.32,
      "duration_seconds": 3.14,
      "text": "Okay, do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.92,
      "end_seconds": 71.61,
      "duration_seconds": 2.69,
      "text": "I have arthritis in my knees."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.23,
      "end_seconds": 73.6,
      "duration_seconds": 1.37,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.21,
      "end_seconds": 79.35,
      "duration_seconds": 4.14,
      "text": "I've had anxiety for about ten years now."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.14,
      "end_seconds": 85.51,
      "duration_seconds": 4.37,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.26,
      "end_seconds": 97.56,
      "duration_seconds": 10.3,
      "text": "Lots of rice, lentils and some fruit. Not much, I mostly stay in these days. I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.51,
      "end_seconds": 106.71,
      "duration_seconds": 5.2,
      "text": "Alright, do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.32,
      "end_seconds": 113.13,
      "duration_seconds": 4.81,
      "text": "Oh, yes, kiwi, it gives me an itchy mouth."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.07,
      "end_seconds": 129.39,
      "duration_seconds": 6.32,
      "text": "Have you had any reduced baby movements, vaginal bleeding, leaking fluid or severe back pain?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.42,
      "end_seconds": 138.0,
      "duration_seconds": 7.58,
      "text": "No, um, no reduced baby movements, vaginal bleeding, leaking fluid or severe back pain."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.07,
      "end_seconds": 141.97,
      "duration_seconds": 1.9,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.59,
      "end_seconds": 146.42,
      "duration_seconds": 2.83,
      "text": "Uh, no problems with breathing."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.99,
      "end_seconds": 150.97,
      "duration_seconds": 1.98,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.78,
      "end_seconds": 154.19,
      "duration_seconds": 2.41,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.48,
      "end_seconds": 172.98,
      "duration_seconds": 5.5,
      "text": "There is mild tenderness above the pubic bone and no tenderness in the loins."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.29,
      "end_seconds": 178.27,
      "duration_seconds": 2.98,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.52,
      "end_seconds": 198.33,
      "duration_seconds": 7.81,
      "text": "Right, here's what I'm thinking. This is probably a urinary infection in pregnancy. A kidney infection is still possible."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.07,
      "end_seconds": 202.16,
      "duration_seconds": 3.09,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.16,
      "end_seconds": 225.22,
      "duration_seconds": 21.06,
      "text": "Nothing I've seen today points to an emergency. It looks like a urinary infection in pregnancy, but I'd like to confirm. Just to be sure I understood. You've had a dull low backache, yesterday, mild, and no vaginal bleeding or severe back pain."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.8,
      "end_seconds": 227.5,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.5,
      "end_seconds": 255.8,
      "duration_seconds": 26.3,
      "text": "I want a urine dipstick done, that's for burning urine. A urine culture is what I'd like next, for urinary infection. I'm prescribing cefalexin, 500 milligrams, twice a day, seven days. You take it by mouth. It's for urinary infection in pregnancy. The pharmacy will go through the details again when you pick it up."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.1,
      "end_seconds": 261.64,
      "duration_seconds": 4.54,
      "text": "Can I collect it from my own pharmacy?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.07,
      "end_seconds": 284.34,
      "duration_seconds": 21.27,
      "text": "Drink plenty of fluids and tell your midwife. Let's get you seen by the midwife, I'll arrange the letter. If the symptoms get worse, that's the point to come in urgently. Let me check I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.97,
      "end_seconds": 292.25,
      "duration_seconds": 6.28,
      "text": "So, I take the cefalexin, 500 milligrams, twice a day. Is that right?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.82,
      "end_seconds": 298.7,
      "duration_seconds": 5.88,
      "text": "Alright, yes, exactly right. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.74,
      "end_seconds": 303.24,
      "duration_seconds": 2.5,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.75,
      "end_seconds": 305.94,
      "duration_seconds": 1.19,
      "text": "Take care now."
    }
  ]
}