{
  "schema_version": "1.0",
  "encounter_id": "01861",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.81,
      "end_seconds": 5.47,
      "duration_seconds": 4.66,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.35,
      "end_seconds": 15.5,
      "duration_seconds": 4.15,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.17,
      "end_seconds": 26.62,
      "duration_seconds": 9.45,
      "text": "Okay, so mainly chest tightness when I walk uphill. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.07,
      "end_seconds": 30.8,
      "duration_seconds": 2.73,
      "text": "has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.59,
      "end_seconds": 44.7,
      "duration_seconds": 13.11,
      "text": "Since last Tuesday, that's when it it began. I kept putting it off, which I know isn't sensible. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.13,
      "end_seconds": 52.92,
      "duration_seconds": 7.79,
      "text": "I see, go ahead. Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.44,
      "end_seconds": 56.69,
      "duration_seconds": 2.25,
      "text": "it happens every other day"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.17,
      "end_seconds": 64.0,
      "duration_seconds": 2.83,
      "text": "Alright, is anything making it worse?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.26,
      "end_seconds": 68.07,
      "duration_seconds": 2.81,
      "text": "Hills definitely sets it off."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.72,
      "end_seconds": 71.51,
      "duration_seconds": 2.79,
      "text": "how strong would you say it is?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.97,
      "end_seconds": 76.49,
      "duration_seconds": 3.52,
      "text": "A seven out of ten, I suppose."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.73,
      "end_seconds": 80.13,
      "duration_seconds": 3.4,
      "text": "I follow. Does anything else come with it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.13,
      "end_seconds": 85.77,
      "duration_seconds": 3.64,
      "text": "it usually comes with pain in my jaw"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.65,
      "end_seconds": 97.93,
      "duration_seconds": 4.28,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.53,
      "end_seconds": 110.89,
      "duration_seconds": 12.36,
      "text": "My partner and our baby. I'm a plumber, lots of bending and kneeling. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.87,
      "end_seconds": 117.58,
      "duration_seconds": 2.71,
      "text": "Any surgery in the the past?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.65,
      "end_seconds": 123.65,
      "duration_seconds": 5.0,
      "text": "Just a wisdom tooth extraction under sedation, five years ago."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.53,
      "end_seconds": 129.92,
      "duration_seconds": 5.39,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.9,
      "end_seconds": 133.14,
      "duration_seconds": 2.24,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.23,
      "end_seconds": 154.37,
      "duration_seconds": 3.14,
      "text": "do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.78,
      "end_seconds": 161.15,
      "duration_seconds": 5.37,
      "text": "I take rosuvastatin, 10 milligrams, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.93,
      "end_seconds": 166.84,
      "duration_seconds": 3.91,
      "text": "tell me about any past illnesses or ongoing conditions"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.95,
      "end_seconds": 182.51,
      "duration_seconds": 14.56,
      "text": "I've had high cholesterol for nearly five years now work has been very busy so I kept ignoring it i'm hoping you can tell me something definite"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.37,
      "end_seconds": 184.07,
      "duration_seconds": 0.7,
      "text": "understood"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.84,
      "end_seconds": 200.65,
      "duration_seconds": 3.81,
      "text": "A few quick ones: palpitations or pain at rest?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.44,
      "end_seconds": 207.3,
      "duration_seconds": 4.86,
      "text": "no palpitations or pain at rest, none of it"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.69,
      "end_seconds": 211.33,
      "duration_seconds": 2.64,
      "text": "have you had any leg swelling?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.21,
      "end_seconds": 217.66,
      "duration_seconds": 5.45,
      "text": "Uh, you know, not that I've noticed, no leg swelling."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.62,
      "end_seconds": 222.51,
      "duration_seconds": 3.89,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.83,
      "end_seconds": 226.09,
      "duration_seconds": 2.26,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.94,
      "end_seconds": 230.16,
      "duration_seconds": 2.22,
      "text": "may I examine you now?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.45,
      "end_seconds": 232.66,
      "duration_seconds": 1.21,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.65,
      "end_seconds": 245.01,
      "duration_seconds": 4.36,
      "text": "Your heart sounds are normal and the pulses are all present."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.96,
      "end_seconds": 251.8,
      "duration_seconds": 2.84,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.32,
      "end_seconds": 286.73,
      "duration_seconds": 16.41,
      "text": "having listened and examined, I'd lean towards stable angina i'm going to order a cholesterol test, for heart risk let's use glyceryl trinitrate spray, 400 micrograms, when needed, long term it's for chest tightness"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.97,
      "end_seconds": 291.16,
      "duration_seconds": 3.19,
      "text": "Should I take that with food?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.96,
      "end_seconds": 316.09,
      "duration_seconds": 23.13,
      "text": "stop and rest when the tightness starts, and use the spray if it does not ease in a few minutes. One warning sign to remember: the symptoms get worse. In that case don't wait. I'd like to see you again after the tests. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.98,
      "end_seconds": 320.92,
      "duration_seconds": 2.94,
      "text": "Thank you, um, that's helpful."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.64,
      "end_seconds": 323.86,
      "duration_seconds": 1.22,
      "text": "Look after yourself."
    }
  ]
}