{
  "schema_version": "1.0",
  "encounter_id": "01741",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.01,
      "end_seconds": 5.64,
      "duration_seconds": 4.63,
      "text": "Hmm, hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.24,
      "end_seconds": 10.14,
      "duration_seconds": 3.9,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.97,
      "end_seconds": 19.93,
      "duration_seconds": 4.96,
      "text": "I wanted to get a little breathlessness looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 21.15,
      "end_seconds": 35.96,
      "duration_seconds": 14.81,
      "text": "Here are the numbers, doctor. BMI works out to 25.1, temperature is 36.6 degrees, weight 58 kilos. Blood pressure 125 over 78, heart rate 68, oxygen saturation is 99 percent, height 152 centimetres, respiratory rate 16."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.85,
      "end_seconds": 41.54,
      "duration_seconds": 4.69,
      "text": "Good, thank you. How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.41,
      "end_seconds": 48.63,
      "duration_seconds": 5.22,
      "text": "Let me think, ever since... since last weekend, really."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.99,
      "end_seconds": 57.3,
      "duration_seconds": 8.31,
      "text": "Understood. Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.19,
      "end_seconds": 86.09,
      "duration_seconds": 27.9,
      "text": "Maybe a five out of ten on a bad day. It happens a couple of times a week. I told myself I'd wait and see, and here I am. There's tiredness as well. An ache in my chest wall was there, you know, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.83,
      "end_seconds": 90.22,
      "duration_seconds": 3.39,
      "text": "Any fainting or leg swelling at all?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.58,
      "end_seconds": 94.86,
      "duration_seconds": 3.28,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.27,
      "end_seconds": 98.24,
      "duration_seconds": 1.97,
      "text": "Have you had any palpitations?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.8,
      "end_seconds": 101.98,
      "duration_seconds": 3.18,
      "text": "Not at all, no palpitations."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.93,
      "end_seconds": 106.96,
      "duration_seconds": 3.03,
      "text": "So, anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.43,
      "end_seconds": 115.42,
      "duration_seconds": 3.99,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.71,
      "end_seconds": 118.01,
      "duration_seconds": 1.3,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.25,
      "end_seconds": 121.59,
      "duration_seconds": 2.34,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.7,
      "end_seconds": 139.54,
      "duration_seconds": 2.84,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.44,
      "end_seconds": 143.89,
      "duration_seconds": 2.45,
      "text": "No, you know, none."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.78,
      "end_seconds": 147.14,
      "duration_seconds": 2.36,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.69,
      "end_seconds": 152.33,
      "duration_seconds": 3.64,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.47,
      "end_seconds": 168.3,
      "duration_seconds": 2.83,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.28,
      "end_seconds": 189.35,
      "duration_seconds": 19.07,
      "text": "I used to drink heavily but I stopped four years ago. I do a yoga class on Thursdays. Lots of rice, lentils and some fruit. I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.24,
      "end_seconds": 200.1,
      "duration_seconds": 2.86,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.69,
      "end_seconds": 205.36,
      "duration_seconds": 3.67,
      "text": "High cholesterol, for nearly five years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.61,
      "end_seconds": 213.42,
      "duration_seconds": 6.81,
      "text": "Okay, go on. Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.71,
      "end_seconds": 225.98,
      "duration_seconds": 11.27,
      "text": "So, yes, amoxicillin. I've no idea what the reaction was, only that I'm not supposed to have it."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.82,
      "end_seconds": 232.91,
      "duration_seconds": 4.09,
      "text": "So, could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.17,
      "end_seconds": 235.2,
      "duration_seconds": 1.03,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.36,
      "end_seconds": 239.25,
      "duration_seconds": 2.89,
      "text": "Right, take a deep breath for me."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.03,
      "end_seconds": 253.22,
      "duration_seconds": 5.19,
      "text": "Your heart rate and rhythm are regular and the breastbone wound has healed."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.97,
      "end_seconds": 272.56,
      "duration_seconds": 14.59,
      "text": "You can sit up now. So, based on the history and the examination, I don't have a clear answer today: recovering well after a heart attack is possible, and so is anxiety."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.47,
      "end_seconds": 278.07,
      "duration_seconds": 3.6,
      "text": "Uh, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.88,
      "end_seconds": 287.9,
      "duration_seconds": 9.02,
      "text": "I can't promise yet, but most people with recovering well after a heart attack do well once it's treated properly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 289.56,
      "end_seconds": 293.0,
      "duration_seconds": 3.44,
      "text": "We've already done an ECG this morning, doctor."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.56,
      "end_seconds": 317.25,
      "duration_seconds": 23.69,
      "text": "Okay, I'll take a look at that. I want a cholesterol test done, that's for secondary prevention. Start the rehabilitation classes and build up walking gradually. If the symptoms get worse, or you feel really unwell, please come to the emergency department. Come back in three months."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.84,
      "end_seconds": 320.66,
      "duration_seconds": 2.82,
      "text": "Yes, um, that's manageable."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.49,
      "end_seconds": 325.38,
      "duration_seconds": 2.89,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.21,
      "end_seconds": 332.58,
      "duration_seconds": 6.37,
      "text": "Sorry, what was I saying, I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.94,
      "end_seconds": 335.15,
      "duration_seconds": 1.21,
      "text": "Goodbye for now."
    }
  ]
}