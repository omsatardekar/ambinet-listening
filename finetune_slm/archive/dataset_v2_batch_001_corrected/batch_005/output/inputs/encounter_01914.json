{
  "schema_version": "1.0",
  "encounter_id": "01914",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.75,
      "end_seconds": 3.93,
      "duration_seconds": 3.18,
      "text": "Right, hello, come in. Mind the step."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.5,
      "end_seconds": 5.67,
      "duration_seconds": 1.17,
      "text": "Hello, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 6.64,
      "end_seconds": 8.82,
      "duration_seconds": 2.18,
      "text": "What's the main thing today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.89,
      "end_seconds": 20.68,
      "duration_seconds": 10.79,
      "text": "Doctor, you know, it's severe pain in the upper tummy going through to the back. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.24,
      "end_seconds": 23.78,
      "duration_seconds": 2.54,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.76,
      "end_seconds": 35.61,
      "duration_seconds": 2.85,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.01,
      "end_seconds": 62.07,
      "duration_seconds": 9.06,
      "text": "Okay: heart rate 124, blood pressure 132 over 75. And temperature 37.0, SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.03,
      "end_seconds": 65.45,
      "duration_seconds": 1.42,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.19,
      "end_seconds": 71.79,
      "duration_seconds": 2.6,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.8,
      "end_seconds": 82.16,
      "duration_seconds": 1.36,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.12,
      "end_seconds": 93.4,
      "duration_seconds": 9.28,
      "text": "Okay, so it's been going on for one week. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.94,
      "end_seconds": 102.65,
      "duration_seconds": 8.71,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 106.76,
      "end_seconds": 118.61,
      "duration_seconds": 11.85,
      "text": "I'd call it severe. It happens all the time. I've been putting this off for weeks. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.97,
      "end_seconds": 131.41,
      "duration_seconds": 5.44,
      "text": "Let me check a few things. Any fever, yellow eyes or chest pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.56,
      "end_seconds": 137.44,
      "duration_seconds": 4.88,
      "text": "I haven't had fever, yellow eyes or chest pain, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.52,
      "end_seconds": 143.12,
      "duration_seconds": 4.6,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.42,
      "end_seconds": 146.73,
      "duration_seconds": 2.31,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.53,
      "end_seconds": 149.62,
      "duration_seconds": 2.09,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.5,
      "end_seconds": 155.14,
      "duration_seconds": 3.64,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.84,
      "end_seconds": 159.36,
      "duration_seconds": 3.52,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.45,
      "end_seconds": 163.23,
      "duration_seconds": 2.78,
      "text": "My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.43,
      "end_seconds": 168.3,
      "duration_seconds": 3.87,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.02,
      "end_seconds": 173.59,
      "duration_seconds": 3.57,
      "text": "Oh, no, nothing I can think of."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.59,
      "end_seconds": 185.42,
      "duration_seconds": 0.83,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 189.87,
      "end_seconds": 194.18,
      "duration_seconds": 4.31,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.41,
      "end_seconds": 199.14,
      "duration_seconds": 3.73,
      "text": "So, are you on your own at home?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 199.81,
      "end_seconds": 202.65,
      "duration_seconds": 2.84,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.74,
      "end_seconds": 205.59,
      "duration_seconds": 1.85,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 210.51,
      "end_seconds": 214.11,
      "duration_seconds": 3.6,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.84,
      "end_seconds": 217.71,
      "duration_seconds": 2.87,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 219.61,
      "end_seconds": 223.08,
      "duration_seconds": 3.47,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.63,
      "end_seconds": 227.39,
      "duration_seconds": 2.76,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 228.22,
      "end_seconds": 231.58,
      "duration_seconds": 3.36,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.79,
      "end_seconds": 243.43,
      "duration_seconds": 2.64,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 244.77,
      "end_seconds": 248.76,
      "duration_seconds": 3.99,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.02,
      "end_seconds": 254.07,
      "duration_seconds": 4.05,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 259.56,
      "end_seconds": 262.0,
      "duration_seconds": 2.44,
      "text": "Yeah, uh, no problem."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 263.12,
      "end_seconds": 264.37,
      "duration_seconds": 1.25,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.56,
      "end_seconds": 286.69,
      "duration_seconds": 4.13,
      "text": "Your upper tummy is very tender and you look dehydrated."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 289.15,
      "end_seconds": 297.86,
      "duration_seconds": 8.71,
      "text": "You can sit up now. Having listened and examined, I think we're dealing with acute pancreatitis at this stage."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 299.43,
      "end_seconds": 302.12,
      "duration_seconds": 2.69,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.0,
      "end_seconds": 330.26,
      "duration_seconds": 26.26,
      "text": "It's reasonable to be concerned, but right now acute pancreatitis is my leading thought, not anything worse. I want an amylase blood test done, that's for severe abdominal pain. I'd rather check than guess, and this is the quickest way to know more. You need admission for fluids and pain relief, nothing to eat for now."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 330.54,
      "end_seconds": 344.79,
      "duration_seconds": 14.25,
      "text": "Okay, go on. An abdominal scan is something we might do if this doesn't improve in two weeks. Let's plan a check straight away. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 346.28,
      "end_seconds": 349.53,
      "duration_seconds": 3.25,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}