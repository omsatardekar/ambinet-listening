{
  "schema_version": "1.0",
  "encounter_id": "01792",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.1,
      "end_seconds": 5.78,
      "duration_seconds": 4.68,
      "text": "Good evening, um, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.94,
      "end_seconds": 11.35,
      "duration_seconds": 4.41,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.21,
      "end_seconds": 19.41,
      "duration_seconds": 6.2,
      "text": "Hmm, morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.36,
      "end_seconds": 24.25,
      "duration_seconds": 2.89,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 26.29,
      "end_seconds": 32.49,
      "duration_seconds": 6.2,
      "text": "It's loud snoring, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.63,
      "end_seconds": 36.58,
      "duration_seconds": 2.95,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.1,
      "end_seconds": 49.0,
      "duration_seconds": 2.9,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.68,
      "end_seconds": 70.67,
      "duration_seconds": 9.99,
      "text": "Okay: pressure 159 over 101, temp 36.6 degrees, pulse is 90 beats a minute, SpO2 98 percent on room air, respiratory rate 16."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.03,
      "end_seconds": 73.55,
      "duration_seconds": 1.52,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.14,
      "end_seconds": 79.72,
      "duration_seconds": 5.58,
      "text": "I'll interpret them after the examination. How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.27,
      "end_seconds": 83.59,
      "duration_seconds": 3.32,
      "text": "About three weeks, give or take."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 84.79,
      "end_seconds": 89.03,
      "duration_seconds": 4.24,
      "text": "Oh, hm, I'd say more like a month."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.6,
      "end_seconds": 93.68,
      "duration_seconds": 4.08,
      "text": "Okay, so roughly three to four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.69,
      "end_seconds": 98.28,
      "duration_seconds": 2.59,
      "text": "Ah, that sounds about right."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.22,
      "end_seconds": 103.3,
      "duration_seconds": 3.08,
      "text": "Right, have you noticed any triggers?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.82,
      "end_seconds": 113.7,
      "duration_seconds": 8.88,
      "text": "Erm, alcohol definitely sets it off. I've had daytime sleepiness too, for about a month."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.13,
      "end_seconds": 121.2,
      "duration_seconds": 3.07,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.13,
      "end_seconds": 132.44,
      "duration_seconds": 10.31,
      "text": "Mm, it feels mild to me. I had stopping breathing at night before. That's settled now, you know, though."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.93,
      "end_seconds": 148.3,
      "duration_seconds": 4.37,
      "text": "Have you had any leg swelling, chest pain or choking?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.04,
      "end_seconds": 155.32,
      "duration_seconds": 5.28,
      "text": "I haven't had leg swelling, chest pain or choking, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.36,
      "end_seconds": 159.32,
      "duration_seconds": 1.96,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.1,
      "end_seconds": 161.26,
      "duration_seconds": 1.16,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.4,
      "end_seconds": 177.0,
      "duration_seconds": 2.6,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.03,
      "end_seconds": 181.46,
      "duration_seconds": 2.43,
      "text": "I have high blood pressure."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.71,
      "end_seconds": 192.65,
      "duration_seconds": 9.94,
      "text": "Yes, high blood pressure is known to us, good to have that clear. Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.32,
      "end_seconds": 199.12,
      "duration_seconds": 5.8,
      "text": "Uh, yes, amoxicillin, it gives me a rash all over."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.33,
      "end_seconds": 204.11,
      "duration_seconds": 3.78,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 204.67,
      "end_seconds": 210.88,
      "duration_seconds": 6.21,
      "text": "Ah, he takes metoprolol, 50 milligrams, twice a day for my pressure."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.76,
      "end_seconds": 217.54,
      "duration_seconds": 4.78,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.06,
      "end_seconds": 230.08,
      "duration_seconds": 11.02,
      "text": "Lots of rice, lentils and some fruit. I walk the dog every morning. I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.88,
      "end_seconds": 233.3,
      "duration_seconds": 2.42,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.09,
      "end_seconds": 240.01,
      "duration_seconds": 4.92,
      "text": "Just keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.19,
      "end_seconds": 244.31,
      "duration_seconds": 2.12,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.51,
      "end_seconds": 247.2,
      "duration_seconds": 1.69,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.31,
      "end_seconds": 268.88,
      "duration_seconds": 3.57,
      "text": "You have a thick neck and a crowded throat."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.87,
      "end_seconds": 290.5,
      "duration_seconds": 15.63,
      "text": "Good, you can sit up again. Putting it all together, I think we're dealing with probable obstructive sleep apnoea at this stage. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.39,
      "end_seconds": 298.44,
      "duration_seconds": 3.05,
      "text": "Mm, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.54,
      "end_seconds": 308.98,
      "duration_seconds": 8.44,
      "text": "Nothing I've seen today points to an emergency. It looks like probable obstructive sleep apnoea, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.39,
      "end_seconds": 343.71,
      "duration_seconds": 19.32,
      "text": "I'd like to arrange a thyroid test for tiredness. I'd like to arrange a home sleep study for snoring and apnoeas. Avoid alcohol in the evening, lose some weight if you can, and do not drive when drowsy. I'd like you back after the sleep study."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.27,
      "end_seconds": 351.38,
      "duration_seconds": 5.11,
      "text": "Um, uh, I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.08,
      "end_seconds": 357.29,
      "duration_seconds": 4.21,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.22,
      "end_seconds": 360.45,
      "duration_seconds": 2.23,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.99,
      "end_seconds": 363.31,
      "duration_seconds": 1.32,
      "text": "Take care now."
    }
  ]
}