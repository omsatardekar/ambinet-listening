      "role": "DOCTOR",
      "start_seconds": 222.3,
      "end_seconds": 230.8,
      "duration_seconds": 8.5,
      "text": "okay: pulse 74, temperature is 36.9 degrees, pressure 114 over 73. And SpO2 97 percent on room air"
    },
