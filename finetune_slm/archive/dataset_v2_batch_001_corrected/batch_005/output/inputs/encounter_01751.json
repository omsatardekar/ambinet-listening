      "role": "DOCTOR",
      "start_seconds": 297.19,
      "end_seconds": 310.17,
      "duration_seconds": 12.98,
      "text": "nothing I've seen today points to an emergency it looks like a breakthrough seizure after missed medication and poor sleep, but I'd like to confirm we should do blood tests for seizure"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 311.47,
      "end_seconds": 314.38,
      "duration_seconds": 2.91,
      "text": "do I need to prepare?"
