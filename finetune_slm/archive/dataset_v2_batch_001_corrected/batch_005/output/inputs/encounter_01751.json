      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.59,
      "end_seconds": 338.99,
      "duration_seconds": 19.4,
      "text": "I'm gonna order an anticonvulsant level, for breakthrough seizure. Take your medicine at the same time every day and do not drive until we say so. If the symptoms get worse, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 340.19,
      "end_seconds": 341.99,
      "duration_seconds": 1.8,
      "text": "Okay, makes sense."
