      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.06,
      "end_seconds": 290.44,
      "duration_seconds": 6.38,
      "text": "putting it all together this is probably a breakthrough seizure after missed medication and poor sleep"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 291.55,
      "end_seconds": 295.14,
      "duration_seconds": 3.59,
      "text": "Is it it dangerous, uh, doctor?"
