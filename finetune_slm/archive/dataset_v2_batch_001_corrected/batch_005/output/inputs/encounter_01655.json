  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.53,
      "end_seconds": 2.19,
      "duration_seconds": 1.66,
      "text": "Evening. Let's get started."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.04,
      "end_seconds": 6.97,
      "duration_seconds": 2.93,
      "text": "Hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 9.05,
      "end_seconds": 13.57,
      "duration_seconds": 4.52,
      "text": "morning doctor. I'll stay and fill in anything that's missed"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.65,
      "end_seconds": 17.33,
      "duration_seconds": 1.68,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.05,
      "end_seconds": 23.57,
      "duration_seconds": 4.52,
      "text": "I've been dealing with a very fast heartbeat"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.16,
      "end_seconds": 25.36,
      "duration_seconds": 1.2,
      "text": "since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.96,
      "end_seconds": 29.34,
      "duration_seconds": 2.38,
      "text": "probably about three months yeah"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.27,
      "end_seconds": 41.17,
      "duration_seconds": 9.9,
      "text": "tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.63,
      "end_seconds": 53.77,
      "duration_seconds": 11.14,
      "text": "Well, it comes and goes. It feels moderate to me. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.66,
      "end_seconds": 57.7,
      "duration_seconds": 2.04,
      "text": "any other symptoms with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 59.61,
      "end_seconds": 74.22,
      "duration_seconds": 14.61,
      "text": "Chest pressure goes along with it most of the time. And And I've been sweating as well uh since last night. The Chest pressure? That's been for two days."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.84,
      "end_seconds": 83.62,
      "duration_seconds": 4.78,
      "text": "Let me check a few things. Any fever leg swelling or cough?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.7,
      "end_seconds": 86.53,
      "duration_seconds": 1.83,
      "text": "None of those no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.45,
      "end_seconds": 92.17,
      "duration_seconds": 4.72,
      "text": "Have you noticed any weakness or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.17,
      "end_seconds": 96.04,
      "duration_seconds": 1.87,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.78,
      "end_seconds": 101.62,
      "duration_seconds": 3.84,
      "text": "anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.26,
      "end_seconds": 111.22,
      "duration_seconds": 7.96,
      "text": "yes, heart disease. I looked a few things up online, and that probably didn't help"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.17,
      "end_seconds": 116.81,
      "duration_seconds": 4.64,
      "text": "Ah. Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.25,
      "end_seconds": 121.72,
      "duration_seconds": 3.47,
      "text": "yes, milk i get stomach cramps"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.84,
      "end_seconds": 125.28,
      "duration_seconds": 2.44,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 126.24,
      "end_seconds": 134.69,
      "duration_seconds": 8.45,
      "text": "she is on aspirin, 75 milligrams, once a day for my heart, I give it to her"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.31,
      "end_seconds": 146.88,
      "duration_seconds": 1.57,
      "text": "And alcohol how much?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.94,
      "end_seconds": 151.64,
      "duration_seconds": 2.7,
      "text": "I only drink at family occasions"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.29,
      "end_seconds": 153.76,
      "duration_seconds": 1.47,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.62,
      "end_seconds": 161.94,
      "duration_seconds": 3.32,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.23,
      "end_seconds": 165.69,
      "duration_seconds": 2.46,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 166.62,
      "end_seconds": 170.97,
      "duration_seconds": 4.35,
      "text": "Not much, I mostly stay in these days"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.53,
      "end_seconds": 174.25,
      "duration_seconds": 1.72,
      "text": "how are your meals?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.39,
      "end_seconds": 179.34,
      "duration_seconds": 3.95,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.63,
      "end_seconds": 189.67,
      "duration_seconds": 3.04,
      "text": "I'll note down your vital signs first"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.84,
      "end_seconds": 198.33,
      "duration_seconds": 2.49,
      "text": "keep your arm relaxed for me.."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.43,
      "end_seconds": 215.98,
      "duration_seconds": 8.55,
      "text": "okay: oxygen saturation is 96 percent, pressure 95 over 59, temperature 36.9. And pulse is 111 beats a minute"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.2,
      "end_seconds": 221.47,
      "duration_seconds": 4.27,
      "text": "I'd like to check you over now, if that's alright"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.42,
      "end_seconds": 225.81,
      "duration_seconds": 2.39,
      "text": "tell me if that's sore"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.5,
      "end_seconds": 242.01,
      "duration_seconds": 6.51,
      "text": "your pulse is over one hundred and eighty and and your blood pressure is low"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.13,
      "end_seconds": 248.01,
      "duration_seconds": 1.88,
      "text": "that's the examination finished"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.88,
      "end_seconds": 270.31,
      "duration_seconds": 9.43,
      "text": "taking everything into account, I'd lean towards a dangerous fast heart rhythm i can't rule out supraventricular tachycardia yet"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 272.14,
      "end_seconds": 274.28,
      "duration_seconds": 2.14,
      "text": "is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 276.22,
      "end_seconds": 293.68,
      "duration_seconds": 17.46,
      "text": "it's reasonable to be concerned, but right now a dangerous fast heart rhythm is my leading thought, not anything worse let's get an urgent ECG, for fast heart rhythm i'd like to arrange blood tests for arrhythmia"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 295.47,
      "end_seconds": 297.71,
      "duration_seconds": 2.24,
      "text": "does it it hurt?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.09,
      "end_seconds": 307.26,
      "duration_seconds": 8.17,
      "text": "Lie flat, I am calling the emergency team and preparing to shock the heart. We'll catch up straight away."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 308.2,
      "end_seconds": 308.9,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.07,
      "end_seconds": 313.4,
      "duration_seconds": 3.33,
      "text": "I think we're done unless you have questions"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 314.13,
      "end_seconds": 317.56,
      "duration_seconds": 3.43,
      "text": "right, I'll do that. Thank you, doctor"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.04,
      "end_seconds": 320.37,
      "duration_seconds": 1.33,
      "text": "Goodbye for now."
    }
  ]
