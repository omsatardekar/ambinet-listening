{
  "schema_version": "1.0",
  "encounter_id": "01976",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.33,
      "end_seconds": 4.6,
      "duration_seconds": 3.27,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.07,
      "end_seconds": 11.19,
      "duration_seconds": 5.12,
      "text": "Alright, you're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.88,
      "end_seconds": 22.25,
      "duration_seconds": 9.37,
      "text": "Um, it's a pulled muscle in my thigh. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.84,
      "end_seconds": 25.89,
      "duration_seconds": 2.05,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.04,
      "end_seconds": 36.83,
      "duration_seconds": 2.79,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.88,
      "end_seconds": 61.6,
      "duration_seconds": 10.72,
      "text": "Okay: blood pressure 125 over 69, pulse 75, SpO2 97 percent on room air. And temperature is 36.5 degrees. Has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.15,
      "end_seconds": 73.03,
      "duration_seconds": 9.88,
      "text": "Uh, you know, for two months, I'd say. Work has been very busy so I kept ignoring it."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.46,
      "end_seconds": 88.75,
      "duration_seconds": 10.29,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.5,
      "end_seconds": 98.92,
      "duration_seconds": 9.42,
      "text": "So, you know, maybe a four out of ten on a bad day. I notice it more with running."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.89,
      "end_seconds": 122.6,
      "duration_seconds": 4.71,
      "text": "Any swelling, fall, pop at the time or numbness at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.86,
      "end_seconds": 126.07,
      "duration_seconds": 2.21,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.56,
      "end_seconds": 128.84,
      "duration_seconds": 2.28,
      "text": "Hm, okay. Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.24,
      "end_seconds": 132.48,
      "duration_seconds": 2.24,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.92,
      "end_seconds": 136.14,
      "duration_seconds": 2.22,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.17,
      "end_seconds": 144.88,
      "duration_seconds": 3.71,
      "text": "Erm, that's normal as far as I know."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.69,
      "end_seconds": 155.63,
      "duration_seconds": 2.94,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.33,
      "end_seconds": 162.73,
      "duration_seconds": 4.4,
      "text": "Actually, um, no, I don't take any tablets."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.12,
      "end_seconds": 169.27,
      "duration_seconds": 5.15,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.56,
      "end_seconds": 174.31,
      "duration_seconds": 3.75,
      "text": "Wheat. I come out in... well, bloating."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.88,
      "end_seconds": 194.56,
      "duration_seconds": 1.68,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.68,
      "end_seconds": 198.4,
      "duration_seconds": 2.72,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.87,
      "end_seconds": 200.8,
      "duration_seconds": 0.93,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.31,
      "end_seconds": 204.76,
      "duration_seconds": 2.45,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.11,
      "end_seconds": 208.99,
      "duration_seconds": 2.88,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.66,
      "end_seconds": 215.86,
      "duration_seconds": 5.2,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.79,
      "end_seconds": 219.16,
      "duration_seconds": 2.37,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.37,
      "end_seconds": 224.33,
      "duration_seconds": 3.96,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.22,
      "end_seconds": 233.11,
      "duration_seconds": 2.89,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.09,
      "end_seconds": 241.79,
      "duration_seconds": 3.7,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.18,
      "end_seconds": 245.49,
      "duration_seconds": 2.31,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.2,
      "end_seconds": 250.49,
      "duration_seconds": 4.29,
      "text": "Just an operation for a hernia, last spring."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.1,
      "end_seconds": 268.92,
      "duration_seconds": 3.82,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.5,
      "end_seconds": 272.83,
      "duration_seconds": 3.33,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.72,
      "end_seconds": 278.63,
      "duration_seconds": 3.91,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.99,
      "end_seconds": 280.96,
      "duration_seconds": 0.97,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.58,
      "end_seconds": 284.96,
      "duration_seconds": 2.38,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.48,
      "end_seconds": 310.53,
      "duration_seconds": 7.05,
      "text": "There is mild tenderness in the back of the thigh and you can still straighten the knee fully."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.0,
      "end_seconds": 332.68,
      "duration_seconds": 18.68,
      "text": "Thank you, you can get dressed. Okay, so my impression is this: This is probably a mild hamstring strain. Rest for a few days, ice it, and then ease back in with gentle stretching. Okay, I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.37,
      "end_seconds": 335.57,
      "duration_seconds": 2.2,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}