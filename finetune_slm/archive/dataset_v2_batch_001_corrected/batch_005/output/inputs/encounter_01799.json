{
  "schema_version": "1.0",
  "encounter_id": "01799",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.88,
      "end_seconds": 4.27,
      "duration_seconds": 3.39,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.0,
      "end_seconds": 9.97,
      "duration_seconds": 4.97,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.23,
      "end_seconds": 16.54,
      "duration_seconds": 5.31,
      "text": "Well, I've been having a painful blistering rash on one side."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.38,
      "end_seconds": 19.75,
      "duration_seconds": 1.37,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.35,
      "end_seconds": 25.33,
      "duration_seconds": 3.98,
      "text": "Um, it's been about four days now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.19,
      "end_seconds": 37.67,
      "duration_seconds": 8.48,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.47,
      "end_seconds": 54.62,
      "duration_seconds": 15.15,
      "text": "Touch definitely sets it off. Honestly, once or twice a day. I told my wife I'd come today. I've had burning pain before the rash too, for two days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.07,
      "end_seconds": 67.44,
      "duration_seconds": 5.37,
      "text": "A few quick ones: eye involvement or rash across the midline?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.08,
      "end_seconds": 71.02,
      "duration_seconds": 1.94,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.8,
      "end_seconds": 73.69,
      "duration_seconds": 1.89,
      "text": "Any weakness or fever?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.25,
      "end_seconds": 77.74,
      "duration_seconds": 2.49,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.79,
      "end_seconds": 81.27,
      "duration_seconds": 2.48,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.06,
      "end_seconds": 85.06,
      "duration_seconds": 3.0,
      "text": "Uh, no, all normal there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.19,
      "end_seconds": 92.11,
      "duration_seconds": 2.92,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.08,
      "end_seconds": 95.71,
      "duration_seconds": 2.63,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.93,
      "end_seconds": 101.45,
      "duration_seconds": 4.52,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.79,
      "end_seconds": 105.34,
      "duration_seconds": 2.55,
      "text": "Erm, no, nothing at all."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.89,
      "end_seconds": 124.08,
      "duration_seconds": 2.19,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.48,
      "end_seconds": 129.87,
      "duration_seconds": 4.39,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.45,
      "end_seconds": 132.93,
      "duration_seconds": 2.48,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.98,
      "end_seconds": 137.14,
      "duration_seconds": 3.16,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.47,
      "end_seconds": 156.86,
      "duration_seconds": 4.39,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.6,
      "end_seconds": 161.98,
      "duration_seconds": 3.38,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.74,
      "end_seconds": 165.52,
      "duration_seconds": 2.78,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.73,
      "end_seconds": 178.04,
      "duration_seconds": 2.31,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.29,
      "end_seconds": 206.39,
      "duration_seconds": 11.1,
      "text": "Okay: temp 36.5 degrees, SpO2 98 percent on room air, respiratory rate 18, blood pressure 110 over 72, heart rate 75."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.77,
      "end_seconds": 210.18,
      "duration_seconds": 2.41,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.75,
      "end_seconds": 214.47,
      "duration_seconds": 2.72,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.31,
      "end_seconds": 234.41,
      "duration_seconds": 8.1,
      "text": "There are grouped blisters on a red base along one band on the right side and none cross the midline."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.89,
      "end_seconds": 249.37,
      "duration_seconds": 9.48,
      "text": "You can relax now. Right, here's what I'm thinking. I can't pin this down yet. We're looking at shingles or contact dermatitis."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.89,
      "end_seconds": 294.02,
      "duration_seconds": 27.13,
      "text": "Let's use aciclovir, 800 milligrams, five times a day, seven days. That's for shingles. Keep the rash covered and stay away from pregnant women and newborn babies until it has crusted. Keep an eye out, and if the rash spreads to your face or eye, call us the same day or go to emergency. Come back in one week. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.0,
      "end_seconds": 298.94,
      "duration_seconds": 2.94,
      "text": "Hmm, alright, thanks, take care."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.18,
      "end_seconds": 305.35,
      "duration_seconds": 1.17,
      "text": "Goodbye for now."
    }
  ]
}