{
  "schema_version": "1.0",
  "encounter_id": "01716",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.35,
      "end_seconds": 6.75,
      "duration_seconds": 5.4,
      "text": "Afternoon, thanks for coming in. Is it your first time here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.37,
      "end_seconds": 12.32,
      "duration_seconds": 3.95,
      "text": "No, I came last year for something else."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.46,
      "end_seconds": 17.64,
      "duration_seconds": 1.18,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 18.98,
      "end_seconds": 27.37,
      "duration_seconds": 8.39,
      "text": "Mainly shaky spells in the afternoon. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.04,
      "end_seconds": 31.42,
      "duration_seconds": 3.38,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.86,
      "end_seconds": 36.86,
      "duration_seconds": 4.0,
      "text": "It's, It's been two weeks, I'm fairly sure."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 38.94,
      "end_seconds": 48.63,
      "duration_seconds": 9.69,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.56,
      "end_seconds": 65.13,
      "duration_seconds": 14.57,
      "text": "It settles a little with sweets. I notice it more with exercise and missed lunch. I'd say a couple of times a week. I'd say severe."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.62,
      "end_seconds": 69.55,
      "duration_seconds": 1.93,
      "text": "Have you been sweating?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 71.51,
      "end_seconds": 72.75,
      "duration_seconds": 1.24,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.41,
      "end_seconds": 79.65,
      "duration_seconds": 2.24,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 81.17,
      "end_seconds": 83.61,
      "duration_seconds": 2.44,
      "text": "It happens all the time."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.63,
      "end_seconds": 96.31,
      "duration_seconds": 3.68,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.94,
      "end_seconds": 112.86,
      "duration_seconds": 2.92,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.08,
      "end_seconds": 137.51,
      "duration_seconds": 9.43,
      "text": "Okay: SpO2 96 percent on room air, pressure 132 over 81. And temperature is 36.9 degrees, heart rate 113."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.56,
      "end_seconds": 142.37,
      "duration_seconds": 3.81,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.9,
      "end_seconds": 145.45,
      "duration_seconds": 1.55,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.33,
      "end_seconds": 148.33,
      "duration_seconds": 2.0,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.95,
      "end_seconds": 172.67,
      "duration_seconds": 7.72,
      "text": "Your sugar reading in clinic is on the low side and your pulse is a little fast."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.16,
      "end_seconds": 185.27,
      "duration_seconds": 9.11,
      "text": "That's all I needed to check. Let me check a few things. Any chest pain, seizure, loss of consciousness or vomiting?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 186.79,
      "end_seconds": 189.24,
      "duration_seconds": 2.45,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.25,
      "end_seconds": 193.59,
      "duration_seconds": 2.34,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 198.93,
      "end_seconds": 199.98,
      "duration_seconds": 1.05,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.89,
      "end_seconds": 204.48,
      "duration_seconds": 2.59,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 208.58,
      "end_seconds": 209.72,
      "duration_seconds": 1.14,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.3,
      "end_seconds": 215.87,
      "duration_seconds": 4.57,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 217.32,
      "end_seconds": 223.45,
      "duration_seconds": 6.13,
      "text": "Not currently, but as a youngster naproxen gave me stomach pain."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.96,
      "end_seconds": 228.85,
      "duration_seconds": 4.89,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 230.28,
      "end_seconds": 233.32,
      "duration_seconds": 3.04,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.49,
      "end_seconds": 252.64,
      "duration_seconds": 4.15,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 253.34,
      "end_seconds": 273.08,
      "duration_seconds": 19.74,
      "text": "I'll have a glass of wine with dinner. I've never touched a cigarette. My husband and I live above the shop. Not much, I mostly stay in these days. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 285.7,
      "end_seconds": 286.97,
      "duration_seconds": 1.27,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 287.93,
      "end_seconds": 290.86,
      "duration_seconds": 2.93,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.68,
      "end_seconds": 299.41,
      "duration_seconds": 7.73,
      "text": "Okay, thinking it through, I think we're dealing with recurrent low blood sugar on insulin at this stage."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 308.32,
      "end_seconds": 322.73,
      "duration_seconds": 14.41,
      "text": "Let's get a download of the glucose meter, for hypoglycaemia. What I'm giving you is insulin glargine, 16 units, once a day at bedtime, long term. It's for diabetes."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 324.7,
      "end_seconds": 327.69,
      "duration_seconds": 2.99,
      "text": "Should I take that with food?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 333.16,
      "end_seconds": 342.93,
      "duration_seconds": 9.77,
      "text": "Always carry sugar and eat something before exercise. Come back in two weeks. What are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 344.95,
      "end_seconds": 355.28,
      "duration_seconds": 10.33,
      "text": "So, I take the insulin glargine, 16 units, once a day at bedtime and come back in two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 355.84,
      "end_seconds": 362.43,
      "duration_seconds": 6.59,
      "text": "Yes, exactly right. Right, is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 363.73,
      "end_seconds": 365.4,
      "duration_seconds": 1.67,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 366.25,
      "end_seconds": 367.68,
      "duration_seconds": 1.43,
      "text": "Take care now."
    }
  ]
}