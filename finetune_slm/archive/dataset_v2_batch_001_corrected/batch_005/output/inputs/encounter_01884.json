{
  "schema_version": "1.0",
  "encounter_id": "01884",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.82,
      "end_seconds": 2.57,
      "duration_seconds": 1.75,
      "text": "Welcome. Make yourself comfortable."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.12,
      "end_seconds": 5.6,
      "duration_seconds": 2.48,
      "text": "Hi, you know, thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.37,
      "end_seconds": 9.02,
      "duration_seconds": 1.65,
      "text": "What's been worrying you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.6,
      "end_seconds": 15.9,
      "duration_seconds": 6.3,
      "text": "Um, so... thoughts of ending my life. That's why I came."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.61,
      "end_seconds": 19.35,
      "duration_seconds": 2.74,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 20.63,
      "end_seconds": 29.86,
      "duration_seconds": 9.23,
      "text": "I'd say six months. Actually, no, closer to about a month. Um, I've also been feeling hopeless."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.43,
      "end_seconds": 34.99,
      "duration_seconds": 4.56,
      "text": "Right, and what about drinking, hearing voices or recent loss?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.24,
      "end_seconds": 41.83,
      "duration_seconds": 5.59,
      "text": "Mm, um, no, no drinking, hearing voices or recent loss."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.26,
      "end_seconds": 47.83,
      "duration_seconds": 4.57,
      "text": "Okay, anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.17,
      "end_seconds": 50.85,
      "duration_seconds": 1.68,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.86,
      "end_seconds": 54.28,
      "duration_seconds": 2.42,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 54.91,
      "end_seconds": 60.19,
      "duration_seconds": 5.28,
      "text": "Yes, depression. I've had high blood pressure for two years now."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.11,
      "end_seconds": 63.28,
      "duration_seconds": 1.17,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.27,
      "end_seconds": 86.54,
      "duration_seconds": 4.27,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.11,
      "end_seconds": 95.83,
      "duration_seconds": 7.72,
      "text": "I'm on mirtazapine, 15 milligrams, at night for my mood. Hydrochlorothiazide, 12.5 milligrams, every morning."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.32,
      "end_seconds": 105.91,
      "duration_seconds": 4.59,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.0,
      "end_seconds": 116.18,
      "duration_seconds": 8.18,
      "text": "I had a reaction to amoxicillin when I was younger, hives, and I've avoided it since."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.71,
      "end_seconds": 134.12,
      "duration_seconds": 1.41,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.67,
      "end_seconds": 137.95,
      "duration_seconds": 3.28,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.51,
      "end_seconds": 140.19,
      "duration_seconds": 1.68,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.88,
      "end_seconds": 147.92,
      "duration_seconds": 4.04,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.61,
      "end_seconds": 150.6,
      "duration_seconds": 1.99,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.7,
      "end_seconds": 154.37,
      "duration_seconds": 2.67,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.94,
      "end_seconds": 159.13,
      "duration_seconds": 4.19,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.97,
      "end_seconds": 164.55,
      "duration_seconds": 3.58,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.4,
      "end_seconds": 167.1,
      "duration_seconds": 1.7,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 168.98,
      "end_seconds": 173.17,
      "duration_seconds": 4.19,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 189.6,
      "end_seconds": 198.05,
      "duration_seconds": 8.45,
      "text": "Here are the numbers, doctor. Pulse 76, pressure 110 over 70, oxygen saturation is 99 percent, temperature 36.9."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.13,
      "end_seconds": 200.04,
      "duration_seconds": 0.91,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.87,
      "end_seconds": 205.27,
      "duration_seconds": 2.4,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.2,
      "end_seconds": 209.64,
      "duration_seconds": 2.44,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.88,
      "end_seconds": 227.32,
      "duration_seconds": 6.44,
      "text": "You are calm but very flat, and you have thought through how you would do it."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 228.59,
      "end_seconds": 230.2,
      "duration_seconds": 1.61,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.83,
      "end_seconds": 248.74,
      "duration_seconds": 12.91,
      "text": "All finished, thank you. Okay, thinking it through, I'd lean towards a high risk of suicide needing urgent assessment. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.62,
      "end_seconds": 296.51,
      "duration_seconds": 29.89,
      "text": "I'm sending you for an urgent mental health assessment because of suicidal thoughts. I want you to stay with me while we arrange help, and your family will be called. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. I think the crisis team should see you too. I'll want another look straight away. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 297.68,
      "end_seconds": 301.29,
      "duration_seconds": 3.61,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}