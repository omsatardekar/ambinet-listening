    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.12,
      "end_seconds": 240.33,
      "duration_seconds": 2.21,
      "text": "Is that alright, doctor?"
