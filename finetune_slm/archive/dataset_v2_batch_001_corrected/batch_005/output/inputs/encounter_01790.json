    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.3,
      "end_seconds": 272.47,
      "duration_seconds": 2.17,
      "text": "Is this serious, doctor?"
