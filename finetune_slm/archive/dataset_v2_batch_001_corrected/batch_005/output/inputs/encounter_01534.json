{
  "schema_version": "1.0",
  "encounter_id": "01534",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.95,
      "end_seconds": 3.36,
      "duration_seconds": 2.41,
      "text": "Afternoon, thanks for coming in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.03,
      "end_seconds": 11.68,
      "duration_seconds": 5.65,
      "text": "Hi doctor, I got here as fast as I could."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.16,
      "end_seconds": 18.45,
      "duration_seconds": 5.29,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.03,
      "end_seconds": 22.25,
      "duration_seconds": 2.22,
      "text": "Alright, where shall we begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.46,
      "end_seconds": 28.86,
      "duration_seconds": 5.4,
      "text": "Well, so the thing is, I've got a bitten tongue."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.72,
      "end_seconds": 32.74,
      "duration_seconds": 3.02,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.79,
      "end_seconds": 37.4,
      "duration_seconds": 2.61,
      "text": "Around two weeks, I think."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 38.82,
      "end_seconds": 43.47,
      "duration_seconds": 4.65,
      "text": "Right, it was closer to three weeks, doctor."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.68,
      "end_seconds": 49.27,
      "duration_seconds": 4.59,
      "text": "Okay, so roughly two to three weeks. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.94,
      "end_seconds": 52.43,
      "duration_seconds": 2.49,
      "text": "Yes, somewhere around that."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.89,
      "end_seconds": 57.09,
      "duration_seconds": 4.2,
      "text": "Okay, go on. How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 58.36,
      "end_seconds": 72.15,
      "duration_seconds": 13.79,
      "text": "I'd call it severe. As for feeling groggy afterwards, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.59,
      "end_seconds": 76.94,
      "duration_seconds": 3.35,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.96,
      "end_seconds": 81.23,
      "duration_seconds": 2.27,
      "text": "It's, It's moderate, honestly."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.54,
      "end_seconds": 85.27,
      "duration_seconds": 2.73,
      "text": "Have you had headache the next day?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.14,
      "end_seconds": 89.11,
      "duration_seconds": 2.97,
      "text": "Yeah. Two weeks, I'd say."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.46,
      "end_seconds": 95.09,
      "duration_seconds": 4.63,
      "text": "What about a seizure last week, have you noticed that?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.81,
      "end_seconds": 97.0,
      "duration_seconds": 1.19,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.47,
      "end_seconds": 107.42,
      "duration_seconds": 5.95,
      "text": "Did you get fever, head injury, loss of bladder control or second seizure?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.34,
      "end_seconds": 117.25,
      "duration_seconds": 7.91,
      "text": "No fever, head injury, loss of bladder control or second seizure, none of it."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.84,
      "end_seconds": 121.35,
      "duration_seconds": 3.51,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.35,
      "end_seconds": 123.85,
      "duration_seconds": 1.5,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.92,
      "end_seconds": 127.56,
      "duration_seconds": 2.64,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.91,
      "end_seconds": 131.07,
      "duration_seconds": 2.16,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.0,
      "end_seconds": 137.76,
      "duration_seconds": 4.76,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.45,
      "end_seconds": 161.81,
      "duration_seconds": 22.36,
      "text": "I'll have a glass of wine with dinner. I gave up cigarettes last spring. I'm a hairdresser, on my feet all day. I drink a lot of tea and snack through the day. I swim twice a week."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.63,
      "end_seconds": 180.75,
      "duration_seconds": 9.12,
      "text": "So, can you list what you take, tablets, creams or inhalers? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 182.76,
      "end_seconds": 198.72,
      "duration_seconds": 15.96,
      "text": "Lamotrigine. I take it 100 milligrams, twice a day. Naproxen. I take it 250 milligrams, twice a day. It's Tiotropium inhaler, once a day for my chest."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.14,
      "end_seconds": 202.9,
      "duration_seconds": 2.76,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 204.52,
      "end_seconds": 207.55,
      "duration_seconds": 3.03,
      "text": "Epilepsy, for about a year."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.8,
      "end_seconds": 210.22,
      "duration_seconds": 1.42,
      "text": "Is that everything?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 211.81,
      "end_seconds": 220.88,
      "duration_seconds": 9.07,
      "text": "I've had arthritis in my knees, yes. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.36,
      "end_seconds": 223.91,
      "duration_seconds": 1.55,
      "text": "So, anything else?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 225.5,
      "end_seconds": 228.36,
      "duration_seconds": 2.86,
      "text": "Oh, I've had COPD, yes."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.77,
      "end_seconds": 238.74,
      "duration_seconds": 5.97,
      "text": "Okay, I can see epilepsy and COPD in your file as well."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.16,
      "end_seconds": 260.6,
      "duration_seconds": 3.44,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 262.17,
      "end_seconds": 270.84,
      "duration_seconds": 8.67,
      "text": "I had a reaction to naproxen when I was younger, stomach pain, and I've avoided it since."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.38,
      "end_seconds": 273.93,
      "duration_seconds": 2.55,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 287.34,
      "end_seconds": 290.03,
      "duration_seconds": 2.69,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.83,
      "end_seconds": 315.22,
      "duration_seconds": 7.39,
      "text": "Okay: temperature 36.8, pulse 66, oxygen saturation is 98 percent, BP is 123 over 77."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 318.67,
      "end_seconds": 320.19,
      "duration_seconds": 1.52,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 320.71,
      "end_seconds": 323.46,
      "duration_seconds": 2.75,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 325.34,
      "end_seconds": 329.51,
      "duration_seconds": 4.17,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 330.44,
      "end_seconds": 332.49,
      "duration_seconds": 2.05,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 345.9,
      "end_seconds": 350.03,
      "duration_seconds": 4.13,
      "text": "You are alert and your neurological examination is normal."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 355.52,
      "end_seconds": 371.06,
      "duration_seconds": 15.54,
      "text": "Thank you, you can get dressed. So, based on the history and the examination, my working impression is a breakthrough seizure after missed medication and poor sleep. A dose that is too low is also on my list."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 372.57,
      "end_seconds": 375.61,
      "duration_seconds": 3.04,
      "text": "Is this serious, uh, doctor?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 376.96,
      "end_seconds": 388.9,
      "duration_seconds": 11.94,
      "text": "I understand the worry. At the moment I'd say it's a breakthrough seizure after missed medication and poor sleep, and we'll watch how it goes."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 398.85,
      "end_seconds": 406.91,
      "duration_seconds": 8.06,
      "text": "Take your medicine at the same time every day and do not drive until we say so."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 408.44,
      "end_seconds": 412.53,
      "duration_seconds": 4.09,
      "text": "Can you send me for blood tests?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 414.44,
      "end_seconds": 422.66,
      "duration_seconds": 8.22,
      "text": "Not right now, it wouldn't change what we do today. Alright, that's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 427.49,
      "end_seconds": 429.86,
      "duration_seconds": 2.37,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 431.56,
      "end_seconds": 432.97,
      "duration_seconds": 1.41,
      "text": "Goodbye for now."
    }
  ]
}