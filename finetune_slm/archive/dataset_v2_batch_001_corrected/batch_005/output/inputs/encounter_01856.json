{
  "schema_version": "1.0",
  "encounter_id": "01856",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.03,
      "end_seconds": 2.52,
      "duration_seconds": 1.49,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.59,
      "end_seconds": 8.66,
      "duration_seconds": 4.07,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.63,
      "end_seconds": 13.18,
      "duration_seconds": 3.55,
      "text": "It's a cough for three weeks, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.43,
      "end_seconds": 17.72,
      "duration_seconds": 3.29,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.63,
      "end_seconds": 28.4,
      "duration_seconds": 9.77,
      "text": "Probably about two weeks. Yeah. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.3,
      "end_seconds": 38.49,
      "duration_seconds": 9.19,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.72,
      "end_seconds": 52.36,
      "duration_seconds": 12.64,
      "text": "Okay, um, so mostly moderate. Honestly, on and off. I've also been feeling tired, since Monday. There was night sweats, yes, but that went away."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.68,
      "end_seconds": 60.12,
      "duration_seconds": 6.44,
      "text": "Have you had a cough for three weeks before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.78,
      "end_seconds": 71.4,
      "duration_seconds": 9.62,
      "text": "Yes, something like this happened a couple of years ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.13,
      "end_seconds": 75.66,
      "duration_seconds": 2.53,
      "text": "Okay, may I examine you now?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.33,
      "end_seconds": 78.75,
      "duration_seconds": 1.42,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.95,
      "end_seconds": 100.31,
      "duration_seconds": 5.36,
      "text": "There are some crackles at the top of the right lung."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.03,
      "end_seconds": 109.9,
      "duration_seconds": 6.87,
      "text": "So, you can sit up now. Have you had any chest pain, fever or coughing up blood?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.3,
      "end_seconds": 115.75,
      "duration_seconds": 2.45,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.2,
      "end_seconds": 119.49,
      "duration_seconds": 2.29,
      "text": "Have you had any HIV?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.32,
      "end_seconds": 121.81,
      "duration_seconds": 1.49,
      "text": "Nope, no HIV."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.38,
      "end_seconds": 124.6,
      "duration_seconds": 2.22,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.17,
      "end_seconds": 127.74,
      "duration_seconds": 2.57,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.5,
      "end_seconds": 133.57,
      "duration_seconds": 5.07,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.64,
      "end_seconds": 137.14,
      "duration_seconds": 1.5,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.23,
      "end_seconds": 141.61,
      "duration_seconds": 2.38,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.45,
      "end_seconds": 146.64,
      "duration_seconds": 4.19,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.53,
      "end_seconds": 150.95,
      "duration_seconds": 2.42,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.7,
      "end_seconds": 161.61,
      "duration_seconds": 4.91,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.16,
      "end_seconds": 165.93,
      "duration_seconds": 2.77,
      "text": "Okay, do you do any exercise?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.42,
      "end_seconds": 169.86,
      "duration_seconds": 2.44,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.51,
      "end_seconds": 184.96,
      "duration_seconds": 3.45,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.24,
      "end_seconds": 189.03,
      "duration_seconds": 2.79,
      "text": "Fluoxetine. I take it every morning."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.35,
      "end_seconds": 192.66,
      "duration_seconds": 2.31,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.33,
      "end_seconds": 204.74,
      "duration_seconds": 9.41,
      "text": "It's 20 milligrams. Lansoprazole. I take it 30 milligrams, before breakfast. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.7,
      "end_seconds": 216.15,
      "duration_seconds": 3.45,
      "text": "So, what operations have you had, if any?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.67,
      "end_seconds": 220.41,
      "duration_seconds": 3.74,
      "text": "Just my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.43,
      "end_seconds": 226.46,
      "duration_seconds": 5.03,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.33,
      "end_seconds": 230.11,
      "duration_seconds": 2.78,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.18,
      "end_seconds": 236.31,
      "duration_seconds": 4.13,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.52,
      "end_seconds": 240.11,
      "duration_seconds": 2.59,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.3,
      "end_seconds": 256.01,
      "duration_seconds": 3.71,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.05,
      "end_seconds": 263.7,
      "duration_seconds": 5.65,
      "text": "I've had depression, yes. I have acid reflux, for two years."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.64,
      "end_seconds": 281.65,
      "duration_seconds": 13.01,
      "text": "Let me just check I've got this right. You've had a cough for three weeks for about two weeks, moderate, and no fever or chest pain."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.08,
      "end_seconds": 287.78,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.32,
      "end_seconds": 293.04,
      "duration_seconds": 4.72,
      "text": "I'm going to order three sputum samples, for possible tuberculosis."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.59,
      "end_seconds": 294.93,
      "duration_seconds": 1.34,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.35,
      "end_seconds": 324.38,
      "duration_seconds": 28.03,
      "text": "Wear a mask in public and cover your mouth when you cough until the results are back. Please take the tablets with food so they don't upset your stomach. The TB service would be the right next step, I'll refer you. If the symptoms get worse, that's the point to come in urgently. I'd like you back after the tests. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.03,
      "end_seconds": 326.65,
      "duration_seconds": 1.62,
      "text": "That's clear, thanks."
    }
  ]
}