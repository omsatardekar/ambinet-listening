{
  "schema_version": "1.0",
  "encounter_id": "01620",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.59,
      "end_seconds": 3.74,
      "duration_seconds": 3.15,
      "text": "Hello, good to see you. Please sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.41,
      "end_seconds": 8.64,
      "duration_seconds": 3.23,
      "text": "Morning, doctor, sorry about the rush."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.5,
      "end_seconds": 12.09,
      "duration_seconds": 2.59,
      "text": "tell me what's brought you in"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.86,
      "end_seconds": 22.08,
      "duration_seconds": 9.22,
      "text": "mainly a high reading at the pharmacy. There's a couple of other things, but that's the main one"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.87,
      "end_seconds": 26.4,
      "duration_seconds": 3.53,
      "text": "Right, how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 27.55,
      "end_seconds": 29.66,
      "duration_seconds": 2.11,
      "text": "Probably one week. Yeah."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.91,
      "end_seconds": 34.65,
      "duration_seconds": 3.74,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.59,
      "end_seconds": 38.06,
      "duration_seconds": 1.47,
      "text": "I'd say severe."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 38.58,
      "end_seconds": 41.3,
      "duration_seconds": 2.72,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.78,
      "end_seconds": 58.77,
      "duration_seconds": 15.99,
      "text": "when it starts I tend to get an occasional headache as well. The occasional headache? That's been for about a week. About occasional headache, pretty moderate, if I'm being honest. It just comes and goes"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.29,
      "end_seconds": 59.99,
      "duration_seconds": 0.7,
      "text": "understood"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 61.01,
      "end_seconds": 67.46,
      "duration_seconds": 6.45,
      "text": "there was being a bit nervous at appointments, yes, but that went away"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.51,
      "end_seconds": 82.95,
      "duration_seconds": 3.44,
      "text": "any chest pain, leg swelling or visual changes?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.2,
      "end_seconds": 90.18,
      "duration_seconds": 5.98,
      "text": "Oh, no, no chest pain, leg swelling or visual changes."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.95,
      "end_seconds": 94.3,
      "duration_seconds": 3.35,
      "text": "Have you had breathlessness, by any chance?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.58,
      "end_seconds": 97.01,
      "duration_seconds": 1.43,
      "text": "Definitely no breathlessness."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.27,
      "end_seconds": 101.73,
      "duration_seconds": 3.46,
      "text": "Right, how are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.27,
      "end_seconds": 103.75,
      "duration_seconds": 1.48,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.51,
      "end_seconds": 108.27,
      "duration_seconds": 2.76,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.78,
      "end_seconds": 118.08,
      "duration_seconds": 8.3,
      "text": "I have about eight cigarettes in a day. My partner and our baby. I swim twice a week."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.8,
      "end_seconds": 124.16,
      "duration_seconds": 4.36,
      "text": "Okay, what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 126.25,
      "end_seconds": 128.74,
      "duration_seconds": 2.49,
      "text": "my father has Parkinson's disease"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.13,
      "end_seconds": 134.67,
      "duration_seconds": 4.54,
      "text": "Right, are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.76,
      "end_seconds": 138.35,
      "duration_seconds": 2.59,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.85,
      "end_seconds": 142.74,
      "duration_seconds": 3.89,
      "text": "anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.38,
      "end_seconds": 158.72,
      "duration_seconds": 15.34,
      "text": "Yes, gout. I've had heart disease, yes. I didn't want to bother you but it keeps coming back. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.45,
      "end_seconds": 162.18,
      "duration_seconds": 2.73,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.85,
      "end_seconds": 169.14,
      "duration_seconds": 5.29,
      "text": "Just two stents put in my heart, three years ago."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.12,
      "end_seconds": 173.75,
      "duration_seconds": 3.63,
      "text": "Right, which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.41,
      "end_seconds": 181.95,
      "duration_seconds": 6.54,
      "text": "Allopurinol. I take it 100 milligrams, maybe, once a day for the gout."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 183.37,
      "end_seconds": 188.03,
      "duration_seconds": 4.66,
      "text": "do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 188.89,
      "end_seconds": 195.7,
      "duration_seconds": 6.81,
      "text": "Not with me. I'll bring it next time. Aspirin, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.14,
      "end_seconds": 197.54,
      "duration_seconds": 1.4,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 201.65,
      "end_seconds": 205.81,
      "duration_seconds": 4.16,
      "text": "before this I was on clopidogrel; that's been stopped"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.82,
      "end_seconds": 224.33,
      "duration_seconds": 3.51,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.65,
      "end_seconds": 240.25,
      "duration_seconds": 2.6,
      "text": "Nearly done with the the readings..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.95,
      "end_seconds": 262.91,
      "duration_seconds": 8.96,
      "text": "Okay: pulse is 82 beats a minute, pressure 170 over 103, temp 36.6 degrees, respiratory rate 16."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 263.57,
      "end_seconds": 265.16,
      "duration_seconds": 1.59,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.17,
      "end_seconds": 270.07,
      "duration_seconds": 2.9,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.09,
      "end_seconds": 275.81,
      "duration_seconds": 3.72,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 276.92,
      "end_seconds": 279.31,
      "duration_seconds": 2.39,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 292.04,
      "end_seconds": 299.15,
      "duration_seconds": 7.11,
      "text": "Your blood pressure is a little raised in the clinic but your heart sounds are normal."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.66,
      "end_seconds": 313.92,
      "duration_seconds": 9.26,
      "text": "Please sit back down. So, based on the history and the examination, I'd lean towards possible white-coat blood pressure."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 315.89,
      "end_seconds": 318.26,
      "duration_seconds": 2.37,
      "text": "is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 320.14,
      "end_seconds": 327.93,
      "duration_seconds": 7.79,
      "text": "it's reasonable to be concerned, but right now possible white-coat blood pressure is my leading thought, not anything worse"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 344.5,
      "end_seconds": 365.98,
      "duration_seconds": 21.48,
      "text": "We should do a 24-hour blood pressure monitor for raised clinic blood pressure. Cut back on salt and do a week of home readings. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 367.93,
      "end_seconds": 371.72,
      "duration_seconds": 3.79,
      "text": "Mm, yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 376.97,
      "end_seconds": 388.57,
      "duration_seconds": 11.6,
      "text": "See me again after the monitor. Okay, can you tell me the plan back in your own words, so I know I've explained it clearly?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 390.07,
      "end_seconds": 395.33,
      "duration_seconds": 5.26,
      "text": "so, I come back after the monitor is that right?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 397.28,
      "end_seconds": 400.98,
      "duration_seconds": 3.7,
      "text": "yes, exactly right have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 402.31,
      "end_seconds": 406.34,
      "duration_seconds": 4.03,
      "text": "so, no, that's all thanks a lot"
    }
  ]
}