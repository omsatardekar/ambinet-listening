{
  "schema_version": "1.0",
  "encounter_id": "00720",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 2.92,
      "end_seconds": 7.06,
      "duration_seconds": 4.14,
      "text": "Hello. It's the metformin. It upsets my stomach."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.22,
      "end_seconds": 15.35,
      "duration_seconds": 5.13,
      "text": "Tell me what happens after you take it."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.55,
      "end_seconds": 23.71,
      "duration_seconds": 5.16,
      "text": "Cramps. Then I'm running to the loo. Within an hour."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.87,
      "end_seconds": 30.36,
      "duration_seconds": 2.49,
      "text": "Is that every time?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.45,
      "end_seconds": 36.97,
      "duration_seconds": 3.52,
      "text": "Most times. So I skip it sometimes."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.65,
      "end_seconds": 43.48,
      "duration_seconds": 2.83,
      "text": "How often do you skip?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.82,
      "end_seconds": 56.97,
      "duration_seconds": 9.15,
      "text": "Couple of days a week. I take it twice a day, 500 mg, when I take it."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.58,
      "end_seconds": 72.66,
      "duration_seconds": 12.08,
      "text": "So it's prescribed twice a day, but you miss it a couple of days a week. Thank you for being honest. What else do you take?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.96,
      "end_seconds": 80.88,
      "duration_seconds": 4.92,
      "text": "Gliclazide. 40 mg, once a day, with breakfast."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.6,
      "end_seconds": 86.06,
      "duration_seconds": 1.46,
      "text": "Any vomiting?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.42,
      "end_seconds": 91.89,
      "duration_seconds": 2.47,
      "text": "No. Not been sick."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.49,
      "end_seconds": 100.1,
      "duration_seconds": 4.61,
      "text": "Any blood in the stool, or black stools?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.01,
      "end_seconds": 105.63,
      "duration_seconds": 1.62,
      "text": "No blood."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.41,
      "end_seconds": 112.88,
      "duration_seconds": 3.47,
      "text": "Any weight loss that you've noticed?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.03,
      "end_seconds": 120.07,
      "duration_seconds": 3.04,
      "text": "No. Put weight on, if anything."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.7,
      "end_seconds": 128.42,
      "duration_seconds": 4.72,
      "text": "Your background conditions, apart from the diabetes?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.47,
      "end_seconds": 138.28,
      "duration_seconds": 5.81,
      "text": "Type 2 diabetes, five years. And high blood pressure."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.52,
      "end_seconds": 143.82,
      "duration_seconds": 2.3,
      "text": "How's your diet?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.0,
      "end_seconds": 150.41,
      "duration_seconds": 3.41,
      "text": "Meat and veg. Lots of bread."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.13,
      "end_seconds": 159.7,
      "duration_seconds": 5.57,
      "text": "Let me press on your tummy. Lie back. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.49,
      "end_seconds": 177.57,
      "duration_seconds": 1.08,
      "text": "Right."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.59,
      "end_seconds": 187.01,
      "duration_seconds": 5.42,
      "text": "Your tummy is soft and there's no tenderness."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.13,
      "end_seconds": 193.22,
      "duration_seconds": 3.09,
      "text": "So it's the tablets. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.19,
      "end_seconds": 208.2,
      "duration_seconds": 11.01,
      "text": "What you describe, cramps and loose stools within an hour of taking it, is a common side effect of metformin."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.48,
      "end_seconds": 214.72,
      "duration_seconds": 3.24,
      "text": "Can I stop it? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.68,
      "end_seconds": 229.36,
      "duration_seconds": 10.68,
      "text": "Please don't stop it on your own. There's a version called slow-release metformin that's much gentler on the stomach. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.49,
      "end_seconds": 234.95,
      "duration_seconds": 2.46,
      "text": "Is that different? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.22,
      "end_seconds": 248.58,
      "duration_seconds": 9.36,
      "text": "Same medicine, released slowly. Most people who can't tolerate the ordinary tablets manage that one. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.64,
      "end_seconds": 255.8,
      "duration_seconds": 4.16,
      "text": "Right. When do I switch? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.06,
      "end_seconds": 269.73,
      "duration_seconds": 9.67,
      "text": "Today. I'll sort out a new prescription, and you take it with your evening meal, never on an empty stomach."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.66,
      "end_seconds": 276.18,
      "duration_seconds": 2.52,
      "text": "With food. Okay. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.13,
      "end_seconds": 286.52,
      "duration_seconds": 6.39,
      "text": "Start the new one once you've finished the old tablets. Don't take both."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.84,
      "end_seconds": 291.57,
      "duration_seconds": 1.73,
      "text": "Understood. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.48,
      "end_seconds": 300.1,
      "duration_seconds": 4.62,
      "text": "If the stomach trouble carries on, ring the surgery."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.68,
      "end_seconds": 306.0,
      "duration_seconds": 2.32,
      "text": "Fine. Thanks. ~"
    }
  ]
}
