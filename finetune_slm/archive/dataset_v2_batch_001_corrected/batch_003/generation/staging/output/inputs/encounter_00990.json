{
  "schema_version": "1.0",
  "encounter_id": "00990",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.14,
      "end_seconds": 9.68,
      "duration_seconds": 8.54,
      "text": "Doctor, it's a bit awkward. I've been itchy around the back passage for about three weeks."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.8,
      "end_seconds": 15.98,
      "duration_seconds": 5.18,
      "text": "Thank you for saying. Is it worse at any time?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.44,
      "end_seconds": 22.67,
      "duration_seconds": 4.23,
      "text": "At night. It keeps me awake."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.49,
      "end_seconds": 27.15,
      "duration_seconds": 2.66,
      "text": "Is it sore too?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.78,
      "end_seconds": 32.75,
      "duration_seconds": 3.97,
      "text": "A bit raw, from the scratching."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.94,
      "end_seconds": 36.03,
      "duration_seconds": 2.09,
      "text": "Any leakage, mucus?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.73,
      "end_seconds": 40.49,
      "duration_seconds": 2.76,
      "text": "A little, on the underwear."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.32,
      "end_seconds": 44.27,
      "duration_seconds": 1.95,
      "text": "Any blood?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.38,
      "end_seconds": 47.51,
      "duration_seconds": 2.13,
      "text": "No blood."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.51,
      "end_seconds": 51.2,
      "duration_seconds": 1.69,
      "text": "Weight loss?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.65,
      "end_seconds": 53.83,
      "duration_seconds": 1.18,
      "text": "None."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.93,
      "end_seconds": 57.4,
      "duration_seconds": 2.47,
      "text": "What have you tried?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.72,
      "end_seconds": 69.55,
      "duration_seconds": 10.83,
      "text": "Zinc oxide cream, twice a day. Well, most days, I forget it sometimes. And loperamide, 2 mg, when my bowels are loose."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.14,
      "end_seconds": 72.57,
      "duration_seconds": 1.43,
      "text": "Any allergies?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.37,
      "end_seconds": 78.43,
      "duration_seconds": 4.06,
      "text": "Latex. I get a contact rash."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.97,
      "end_seconds": 81.82,
      "duration_seconds": 1.85,
      "text": "Medical history?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.13,
      "end_seconds": 87.41,
      "duration_seconds": 4.28,
      "text": "Haemorrhoids, irritable bowel, eczema, and diverticulosis."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.45,
      "end_seconds": 89.47,
      "duration_seconds": 1.02,
      "text": "Operations?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.81,
      "end_seconds": 96.41,
      "duration_seconds": 5.6,
      "text": "Haemorrhoid banding, in 2017. And a hernia, in 2009."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.74,
      "end_seconds": 101.51,
      "duration_seconds": 2.77,
      "text": "Bowel trouble in the family?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.57,
      "end_seconds": 106.96,
      "duration_seconds": 3.39,
      "text": "My father had bowel polyps."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.54,
      "end_seconds": 112.14,
      "duration_seconds": 2.6,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.21,
      "end_seconds": 115.42,
      "duration_seconds": 2.21,
      "text": "Ten a day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.0,
      "end_seconds": 117.92,
      "duration_seconds": 0.92,
      "text": "Alcohol?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.95,
      "end_seconds": 125.12,
      "duration_seconds": 5.17,
      "text": "I'm a publican, so, yes, more than I should."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.55,
      "end_seconds": 128.23,
      "duration_seconds": 1.68,
      "text": "And work?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.54,
      "end_seconds": 134.37,
      "duration_seconds": 3.83,
      "text": "Same, the pub. Long hours."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.96,
      "end_seconds": 162.76,
      "duration_seconds": 10.8,
      "text": "Let me check you. Pulse 74, blood pressure 130 over 80, temperature 36.7, oxygen 98 percent, breathing 14, weight 88 kilos."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.61,
      "end_seconds": 165.21,
      "duration_seconds": 1.6,
      "text": "Fine? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.6,
      "end_seconds": 190.88,
      "duration_seconds": 4.28,
      "text": "Fine. Lie on your left side, please."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.24,
      "end_seconds": 195.02,
      "duration_seconds": 1.78,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.66,
      "end_seconds": 201.66,
      "duration_seconds": 5.0,
      "text": "There's redness and scratch marks around the anus."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.96,
      "end_seconds": 207.15,
      "duration_seconds": 3.19,
      "text": "That'll be the itching. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.1,
      "end_seconds": 211.58,
      "duration_seconds": 3.48,
      "text": "And a small skin tag."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.08,
      "end_seconds": 216.74,
      "duration_seconds": 2.66,
      "text": "Always had that. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.5,
      "end_seconds": 222.67,
      "duration_seconds": 4.17,
      "text": "I can't feel any lumps inside."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.84,
      "end_seconds": 226.45,
      "duration_seconds": 1.61,
      "text": "Good. ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.01,
      "end_seconds": 231.29,
      "duration_seconds": 3.28,
      "text": "Any trouble with your water?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.86,
      "end_seconds": 234.32,
      "duration_seconds": 1.46,
      "text": "No, nothing."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.15,
      "end_seconds": 238.79,
      "duration_seconds": 3.64,
      "text": "Any bloating or tummy pain?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.93,
      "end_seconds": 241.8,
      "duration_seconds": 1.87,
      "text": "No, nothing."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.71,
      "end_seconds": 256.33,
      "duration_seconds": 11.62,
      "text": "The itch could be haemorrhoids, but I can't rule out threadworms, or a skin condition from scratching and the leakage."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.42,
      "end_seconds": 260.62,
      "duration_seconds": 3.2,
      "text": "Worms? At my age? ~"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.47,
      "end_seconds": 274.65,
      "duration_seconds": 11.18,
      "text": "It happens at any age. I'd like to arrange a sticky tape test for threadworms, and a stool sample."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.1,
      "end_seconds": 278.63,
      "duration_seconds": 1.53,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.41,
      "end_seconds": 287.81,
      "duration_seconds": 8.4,
      "text": "And I'd like to arrange blood tests including blood sugar, since itching can be a sign."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.8,
      "end_seconds": 290.5,
      "duration_seconds": 1.7,
      "text": "Fine. ~"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.93,
      "end_seconds": 299.01,
      "duration_seconds": 7.08,
      "text": "Wash gently with plain water, pat dry, and keep your nails short."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.48,
      "end_seconds": 303.34,
      "duration_seconds": 1.86,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.26,
      "end_seconds": 311.11,
      "duration_seconds": 4.85,
      "text": "I'd like to see you again in three weeks."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.97,
      "end_seconds": 316.33,
      "duration_seconds": 2.36,
      "text": "Three weeks. ~"
    }
  ]
}
