{
  "schema_version": "1.0",
  "encounter_id": "00572",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 0.73,
      "end_seconds": 14.71,
      "duration_seconds": 13.98,
      "text": "Mr Quarmby, I've got your GP's letter here, and the notes from when you came in a fortnight ago. The letter says blood in your urine. Tell me about it."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.41,
      "end_seconds": 24.36,
      "duration_seconds": 8.95,
      "text": "Well, it's the blood in my wee, doctor. First time, I thought it was beetroot, but I hadn't had any."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.54,
      "end_seconds": 29.02,
      "duration_seconds": 3.48,
      "text": "Fair. What colour exactly? Pink, red, tea-coloured?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.72,
      "end_seconds": 34.06,
      "duration_seconds": 4.34,
      "text": "Sort of reddy-pink, like weak squash. Comes and goes."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.04,
      "end_seconds": 38.66,
      "duration_seconds": 3.62,
      "text": "And how long has it been happening?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.92,
      "end_seconds": 48.31,
      "duration_seconds": 7.39,
      "text": "About three weeks now. Off and on. Some days it's clear, some days it isn't."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.94,
      "end_seconds": 54.68,
      "duration_seconds": 3.74,
      "text": "Does it hurt when you pass it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.84,
      "end_seconds": 62.69,
      "duration_seconds": 6.85,
      "text": "No, no pain at all. That's what's odd. Doesn't hurt a bit."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.9,
      "end_seconds": 70.95,
      "duration_seconds": 6.05,
      "text": "Any pain in your back or sides? Or a temperature?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.72,
      "end_seconds": 81.13,
      "duration_seconds": 9.41,
      "text": "Nothing in the back. And no temperature, I'd know, the wife checks me like a Sunday roast."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.2,
      "end_seconds": 87.17,
      "duration_seconds": 4.97,
      "text": "Good. Anything else you've noticed lately, even if it seems unrelated?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.43,
      "end_seconds": 98.89,
      "duration_seconds": 9.46,
      "text": "I'm up in the night for a wee, three times, that's new. And I'm dog-tired by teatime."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.56,
      "end_seconds": 102.47,
      "duration_seconds": 2.91,
      "text": "Anything else? Appetite, weight, swelling?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.32,
      "end_seconds": 111.54,
      "duration_seconds": 7.22,
      "text": "I've gone off my grub a bit. And my ankles are like balloons by evening."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.18,
      "end_seconds": 118.16,
      "duration_seconds": 3.98,
      "text": "Mm-hm. Right. Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.95,
      "end_seconds": 126.16,
      "duration_seconds": 7.21,
      "text": "Diabetes, type 2, about eight years. And high blood pressure, longer than that."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.42,
      "end_seconds": 131.29,
      "duration_seconds": 2.87,
      "text": "Any operations in the past?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.26,
      "end_seconds": 139.39,
      "duration_seconds": 7.13,
      "text": "Gallbladder out in 2015, and a knee replacement about six years ago."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.33,
      "end_seconds": 147.04,
      "duration_seconds": 5.71,
      "text": "Has anyone in the family had kidney or bladder trouble?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.8,
      "end_seconds": 154.34,
      "duration_seconds": 5.54,
      "text": "My dad had bladder cancer. He was in his seventies."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.59,
      "end_seconds": 162.48,
      "duration_seconds": 5.89,
      "text": "Thank you, that's useful to know. Now, tell me what tablets you take."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.36,
      "end_seconds": 177.53,
      "duration_seconds": 14.17,
      "text": "Amlodipine, 5 milligrams, once a day, for the blood pressure. Then metformin for the sugar, 500 milligrams twice a day. And atorvastatin for the cholesterol, 20 milligrams at night."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.04,
      "end_seconds": 184.48,
      "duration_seconds": 4.44,
      "text": "And do you take them all regularly?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.87,
      "end_seconds": 200.08,
      "duration_seconds": 13.21,
      "text": "Every day, religiously. Well, the evening metformin I do miss now and then, if I've dozed off in the chair. I couldn't swear I get it right every day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.74,
      "end_seconds": 206.68,
      "duration_seconds": 5.94,
      "text": "That's common, and we'll tackle it another time. Any allergies to medicines?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.41,
      "end_seconds": 213.04,
      "duration_seconds": 5.63,
      "text": "Codeine. Came out in an itchy rash all over, years ago."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.46,
      "end_seconds": 219.7,
      "duration_seconds": 4.24,
      "text": "Noted. Do you smoke, or have you ever?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.58,
      "end_seconds": 229.63,
      "duration_seconds": 9.05,
      "text": "I did, twenty a day. Packed it in in 2010, the best thing I ever did."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.43,
      "end_seconds": 235.24,
      "duration_seconds": 3.81,
      "text": "Well done. And what was your work?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.74,
      "end_seconds": 245.95,
      "duration_seconds": 8.21,
      "text": "Lorry driver, forty years on the road. Retired now, and the wife says I'm under her feet."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.12,
      "end_seconds": 251.06,
      "duration_seconds": 2.94,
      "text": "Ha. How are your bowels?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.41,
      "end_seconds": 255.26,
      "duration_seconds": 2.85,
      "text": "Fine, regular as the 7.15 bus."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.38,
      "end_seconds": 265.07,
      "duration_seconds": 7.69,
      "text": "Good. And is the sleep disturbed by the night trips, or do you drop off again?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.58,
      "end_seconds": 273.18,
      "duration_seconds": 5.6,
      "text": "Drop off like a stone, the minute I'm back in bed."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.16,
      "end_seconds": 282.62,
      "duration_seconds": 8.46,
      "text": "Good, thank you. Let's do your checks. I'll take your pressure, pulse, temperature, oxygen and weight."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.96,
      "end_seconds": 289.85,
      "duration_seconds": 5.89,
      "text": "Do I need to take my shoes off for the scales?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.53,
      "end_seconds": 296.0,
      "duration_seconds": 3.47,
      "text": "Yes please, and your jacket."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.64,
      "end_seconds": 323.08,
      "duration_seconds": 8.44,
      "text": "Blood pressure is 148 over 88, pulse 78, temperature 36.9 degrees, oxygen 97 percent, and weight 84 kilograms."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.45,
      "end_seconds": 329.17,
      "duration_seconds": 4.72,
      "text": "Is that all right? I've lost a bit, I think."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.16,
      "end_seconds": 340.49,
      "duration_seconds": 9.33,
      "text": "Your pressure's a little up. We'll come to that. Lie back and let me feel your tummy."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.26,
      "end_seconds": 344.73,
      "duration_seconds": 2.47,
      "text": "Go on. Mind, I'm ticklish."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.86,
      "end_seconds": 350.24,
      "duration_seconds": 4.38,
      "text": "I'll be quick. Tell me if anything is tender."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.12,
      "end_seconds": 355.57,
      "duration_seconds": 3.45,
      "text": "Only that your hands are cold, doctor."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.0,
      "end_seconds": 376.59,
      "duration_seconds": 8.59,
      "text": "Your abdomen is soft. Now your ankles. There is swelling around both ankles, and it leaves a dent when I press."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 377.53,
      "end_seconds": 380.51,
      "duration_seconds": 2.98,
      "text": "I told the wife. Balloons."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 381.6,
      "end_seconds": 395.87,
      "duration_seconds": 14.27,
      "text": "Right, let me be direct. Blood in the urine without pain needs proper checking. I can't rule out a growth in the bladder or kidney yet."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 397.26,
      "end_seconds": 400.26,
      "duration_seconds": 3.0,
      "text": "A growth? You mean cancer?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 401.6,
      "end_seconds": 413.52,
      "duration_seconds": 11.92,
      "text": "It's one of the possibilities, and I'd rather say so plainly. It could equally be something simpler, so we find out properly."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 414.79,
      "end_seconds": 417.66,
      "duration_seconds": 2.87,
      "text": "Right. Well. I didn't expect that."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 418.74,
      "end_seconds": 424.66,
      "duration_seconds": 5.92,
      "text": "Understood, and it's a lot to take in. Shall I go on?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 426.44,
      "end_seconds": 430.88,
      "duration_seconds": 4.44,
      "text": "Yes, go on. What happens now, then?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 431.82,
      "end_seconds": 446.68,
      "duration_seconds": 14.86,
      "text": "Four things. One, a urine sample today. Two, blood tests to check how your kidneys are working. Three, an ultrasound scan of your kidneys and bladder. Four, a camera test of the bladder, a cystoscopy."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 448.03,
      "end_seconds": 451.3,
      "duration_seconds": 3.27,
      "text": "A camera? Down there? Oh, lovely."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 452.87,
      "end_seconds": 461.94,
      "duration_seconds": 9.07,
      "text": "It's quick and done with numbing gel. I'll arrange all four, and the scan and camera appointments will come by post."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 464.44,
      "end_seconds": 468.86,
      "duration_seconds": 4.42,
      "text": "Do I need to stop my tablets?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 470.02,
      "end_seconds": 481.42,
      "duration_seconds": 11.4,
      "text": "No, carry on with all three as normal. Try not to miss the evening metformin, put the tablets by the kettle."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 483.92,
      "end_seconds": 488.28,
      "duration_seconds": 4.36,
      "text": "By the kettle. Good idea, I'm always in there."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 490.97,
      "end_seconds": 497.63,
      "duration_seconds": 6.66,
      "text": "I'd like to see you in two weeks, once the results are back."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 498.63,
      "end_seconds": 503.62,
      "duration_seconds": 4.99,
      "text": "Two weeks. I'll tell the wife, she'll want to come."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 506.08,
      "end_seconds": 511.02,
      "duration_seconds": 4.94,
      "text": "Please bring her. And drink plenty of water meanwhile."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 513.7,
      "end_seconds": 517.86,
      "duration_seconds": 4.16,
      "text": "Will do. Thanks, doctor, you've been straight with me."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 519.98,
      "end_seconds": 525.0,
      "duration_seconds": 5.02,
      "text": "Best way. See you in a fortnight, Mr Quarmby."
    }
  ]
}
