{
  "schema_version": "1.0",
  "encounter_id": "00725",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 2.36,
      "end_seconds": 22.08,
      "duration_seconds": 19.72,
      "text": "Hello! I've come about a rash, and I've got to say, it's the strangest thing, because I've been on a course of tablets from the dentist, for a tooth, and I started to itch on day four."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.03,
      "end_seconds": 30.41,
      "duration_seconds": 5.38,
      "text": "Let's slow down. When did the rash appear?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.99,
      "end_seconds": 44.89,
      "duration_seconds": 10.9,
      "text": "Day five, so yesterday morning. It started on my chest, and now it's on my back and my arms. Little red blotches."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.57,
      "end_seconds": 50.35,
      "duration_seconds": 1.78,
      "text": "Do they itch?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.57,
      "end_seconds": 62.5,
      "duration_seconds": 8.93,
      "text": "Terribly. I was scratching in the night, my husband said I was like a dog with fleas."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.56,
      "end_seconds": 70.35,
      "duration_seconds": 4.79,
      "text": "Any swelling of your lips, tongue or face? ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.65,
      "end_seconds": 77.78,
      "duration_seconds": 4.13,
      "text": "No, nothing like that, thank goodness. ~"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.46,
      "end_seconds": 85.82,
      "duration_seconds": 4.36,
      "text": "Any trouble breathing, or feeling faint? ~"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.89,
      "end_seconds": 91.39,
      "duration_seconds": 2.5,
      "text": "Not at all. ~"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.92,
      "end_seconds": 98.92,
      "duration_seconds": 4.0,
      "text": "Have you got a fever? ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.49,
      "end_seconds": 107.99,
      "duration_seconds": 6.5,
      "text": "No, I've felt fine. Apart from the itching and the tooth. ~"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.63,
      "end_seconds": 115.03,
      "duration_seconds": 4.4,
      "text": "Are you still taking the tablets? ~"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.39,
      "end_seconds": 124.07,
      "duration_seconds": 6.68,
      "text": "I took the last one yesterday, I had a five-day course. ~"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.74,
      "end_seconds": 135.19,
      "duration_seconds": 8.45,
      "text": "Right, so it's finished. Let me look at your skin. Roll up your sleeves. ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.54,
      "end_seconds": 148.54,
      "duration_seconds": 10.0,
      "text": "Of course. I'm a hairdresser, so my arms are usually fine, but I've had to wear long sleeves."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.21,
      "end_seconds": 168.43,
      "duration_seconds": 2.22,
      "text": "I'll check the blotches."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.41,
      "end_seconds": 174.18,
      "duration_seconds": 2.77,
      "text": "Is it nasty? ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.69,
      "end_seconds": 185.86,
      "duration_seconds": 8.17,
      "text": "Pink, flat blotches over the chest, back and arms, and no blistering. Nothing worrying. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.22,
      "end_seconds": 194.16,
      "duration_seconds": 4.94,
      "text": "Is it the tablets, do you think? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.8,
      "end_seconds": 207.12,
      "duration_seconds": 10.32,
      "text": "It's likely linked, since the timing fits, so the dentist will want to choose something different next time. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.79,
      "end_seconds": 216.76,
      "duration_seconds": 5.97,
      "text": "Oh good, I'd hate to have it again. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.41,
      "end_seconds": 230.82,
      "duration_seconds": 11.41,
      "text": "It should fade by itself over a few days. A cool shower, and loose cotton clothing, will help the itch."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.94,
      "end_seconds": 235.58,
      "duration_seconds": 2.64,
      "text": "And my tooth? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.47,
      "end_seconds": 248.96,
      "duration_seconds": 10.49,
      "text": "Go back to the dentist and tell them about the rash. They'll choose a different treatment if you still need one."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.99,
      "end_seconds": 258.44,
      "duration_seconds": 6.45,
      "text": "Right. I do still have a bit of a toothache. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.31,
      "end_seconds": 267.82,
      "duration_seconds": 6.51,
      "text": "Then do ring them today, and mention the rash. Please. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.44,
      "end_seconds": 275.66,
      "duration_seconds": 5.22,
      "text": "I will. Do you think it'll get worse? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.88,
      "end_seconds": 293.56,
      "duration_seconds": 14.68,
      "text": "It usually peaks and settles, but if you develop swelling of the face or lips, difficulty breathing, blistering, or a fever, call 999 or come straight in."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.45,
      "end_seconds": 299.9,
      "duration_seconds": 3.45,
      "text": "Understood. Thanks ever so much. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.62,
      "end_seconds": 305.96,
      "duration_seconds": 3.34,
      "text": "You're welcome. Take care. ~"
    }
  ]
}
