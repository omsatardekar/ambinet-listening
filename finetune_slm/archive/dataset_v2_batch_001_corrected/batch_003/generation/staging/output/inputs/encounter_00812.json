{
  "schema_version": "1.0",
  "encounter_id": "00812",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.74,
      "end_seconds": 14.59,
      "duration_seconds": 13.85,
      "text": "Doctor, I've come for the glaucoma check. The pressure test. I'm not sure when I'm meant to be here, I think it's every six months."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.97,
      "end_seconds": 28.09,
      "duration_seconds": 12.12,
      "text": "That's right. Let me look at your notes. You've been on drops since your diagnosis. Remind me, what are you using?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.22,
      "end_seconds": 34.55,
      "duration_seconds": 5.33,
      "text": "One drop, in each eye, at night. It's called latanoprost."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.48,
      "end_seconds": 39.54,
      "duration_seconds": 4.06,
      "text": "Good. Do you ever miss it? ~"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.3,
      "end_seconds": 48.09,
      "duration_seconds": 5.79,
      "text": "Sometimes, if I fall asleep early. Maybe once a week. ~"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.17,
      "end_seconds": 53.6,
      "duration_seconds": 4.43,
      "text": "How are your eyes? Any change in your vision?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.81,
      "end_seconds": 63.21,
      "duration_seconds": 8.4,
      "text": "I think my side vision is a bit narrower. I bumped into a door the other day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.31,
      "end_seconds": 67.85,
      "duration_seconds": 3.54,
      "text": "When did you first notice that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.01,
      "end_seconds": 75.72,
      "duration_seconds": 5.71,
      "text": "Oh, a few months ago? Perhaps longer. I honestly can't say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.01,
      "end_seconds": 81.75,
      "duration_seconds": 4.74,
      "text": "Any eye pain, redness, or haloes around lights?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.06,
      "end_seconds": 87.23,
      "duration_seconds": 4.17,
      "text": "No pain. No redness. No haloes."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.78,
      "end_seconds": 91.42,
      "duration_seconds": 1.64,
      "text": "Any headaches?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.88,
      "end_seconds": 94.42,
      "duration_seconds": 1.54,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.58,
      "end_seconds": 98.86,
      "duration_seconds": 2.28,
      "text": "Any other conditions?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.43,
      "end_seconds": 103.63,
      "duration_seconds": 3.2,
      "text": "High blood pressure, and short-sightedness."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.3,
      "end_seconds": 114.79,
      "duration_seconds": 9.49,
      "text": "Right. Let's do the tests. First the pressure. Put your chin on the rest. ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.48,
      "end_seconds": 138.68,
      "duration_seconds": 1.2,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.22,
      "end_seconds": 153.38,
      "duration_seconds": 12.16,
      "text": "The pressure in your right eye is 17 and the left is 19, which is within normal range on treatment."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.59,
      "end_seconds": 157.53,
      "duration_seconds": 2.94,
      "text": "Is that good? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.35,
      "end_seconds": 171.87,
      "duration_seconds": 11.52,
      "text": "Yes, that's in the target range. Now I'll look at the back of the eye, with the drops to enlarge your pupils. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.85,
      "end_seconds": 176.03,
      "duration_seconds": 3.18,
      "text": "Will it blur things? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.3,
      "end_seconds": 201.73,
      "duration_seconds": 4.43,
      "text": "A bit, for a few hours. Don't drive."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.99,
      "end_seconds": 218.72,
      "duration_seconds": 14.73,
      "text": "The optic nerves look a little more cupped on the left than last time, and your visual field test shows a slight loss at the edges, a bit more than before."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.62,
      "end_seconds": 224.68,
      "duration_seconds": 3.06,
      "text": "Is it getting worse? ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.42,
      "end_seconds": 238.93,
      "duration_seconds": 12.51,
      "text": "There's been a small change in the left eye. I'd say your glaucoma is progressing slowly in that eye, even though the pressure is controlled."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.85,
      "end_seconds": 243.07,
      "duration_seconds": 2.22,
      "text": "Oh dear. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.6,
      "end_seconds": 256.95,
      "duration_seconds": 12.35,
      "text": "It's a gradual condition. The aim is to slow it down. I'd like you to take the drops every night without fail."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.5,
      "end_seconds": 265.05,
      "duration_seconds": 5.55,
      "text": "I will. I'll put them by my toothbrush. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.31,
      "end_seconds": 276.91,
      "duration_seconds": 9.6,
      "text": "And I'd like to arrange a repeat visual field test and a scan of the optic nerve in three months."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.88,
      "end_seconds": 280.85,
      "duration_seconds": 2.97,
      "text": "Three months. Okay. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.24,
      "end_seconds": 288.02,
      "duration_seconds": 5.78,
      "text": "Please don't drive until the dilating drops have worn off."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.3,
      "end_seconds": 294.13,
      "duration_seconds": 3.83,
      "text": "My daughter's driving me home. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.64,
      "end_seconds": 300.74,
      "duration_seconds": 4.1,
      "text": "Good. Thank you for coming. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.7,
      "end_seconds": 306.02,
      "duration_seconds": 3.32,
      "text": "Thank you, doctor. ~"
    }
  ]
}
