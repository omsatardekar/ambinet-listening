{
  "schema_version": "1.0",
  "encounter_id": "00828",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.4,
      "end_seconds": 20.49,
      "duration_seconds": 20.09,
      "text": "Okay, so I kept a log. My right knee swelled up five days ago after a long day kneeling on a tile floor, and it hasn't gone down. I have the dates on my phone."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.98,
      "end_seconds": 29.71,
      "duration_seconds": 7.73,
      "text": "Good, thanks. Show me when you're ready. Is it only swollen, or is it painful too?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.79,
      "end_seconds": 48.6,
      "duration_seconds": 16.81,
      "text": "Painful, yes, it hurts in the knee. But I can't tell you when exactly the pain started. I wrote the swelling date, not the pain. I think the pain came first, maybe two days before. Maybe not."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.95,
      "end_seconds": 54.2,
      "duration_seconds": 3.25,
      "text": "That's fine. Does it feel stiff?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.54,
      "end_seconds": 61.38,
      "duration_seconds": 5.84,
      "text": "Stiff after sitting in the truck, yes. Takes a minute to straighten."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.91,
      "end_seconds": 64.99,
      "duration_seconds": 2.08,
      "text": "Is it warm?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.9,
      "end_seconds": 74.61,
      "duration_seconds": 8.71,
      "text": "Warm to the touch, compared to the left. I checked with the back of my hand."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.52,
      "end_seconds": 79.22,
      "duration_seconds": 3.7,
      "text": "And where does it hurt most?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.0,
      "end_seconds": 87.15,
      "duration_seconds": 6.15,
      "text": "Right at the front, over the kneecap. Tender when I press."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.57,
      "end_seconds": 89.94,
      "duration_seconds": 1.37,
      "text": "Any fever?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.04,
      "end_seconds": 96.35,
      "duration_seconds": 4.31,
      "text": "No fever, I took it last night."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.44,
      "end_seconds": 99.76,
      "duration_seconds": 1.32,
      "text": "Redness?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.98,
      "end_seconds": 102.75,
      "duration_seconds": 1.77,
      "text": "No redness."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.2,
      "end_seconds": 106.67,
      "duration_seconds": 2.47,
      "text": "Does the knee lock?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.4,
      "end_seconds": 111.16,
      "duration_seconds": 1.76,
      "text": "No locking."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.36,
      "end_seconds": 115.9,
      "duration_seconds": 3.54,
      "text": "Did you fall or twist it?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.36,
      "end_seconds": 121.05,
      "duration_seconds": 2.69,
      "text": "No fall, no twist."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.35,
      "end_seconds": 125.92,
      "duration_seconds": 2.57,
      "text": "Chills or sweats?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.06,
      "end_seconds": 129.0,
      "duration_seconds": 1.94,
      "text": "No chills."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.83,
      "end_seconds": 132.8,
      "duration_seconds": 2.97,
      "text": "What medications are you taking?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.52,
      "end_seconds": 153.1,
      "duration_seconds": 18.58,
      "text": "Ibuprofen, maybe 400 mg, three times a day, for the knee. Metformin, 500 mg, twice a day, breakfast and dinner, though I skip some dinners. Lisinopril, 10 mg, once a day. And omeprazole, 20 mg, once a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.43,
      "end_seconds": 156.74,
      "duration_seconds": 2.31,
      "text": "Okay. Any allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.04,
      "end_seconds": 161.11,
      "duration_seconds": 3.07,
      "text": "Penicillin. My lips swelled up."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.16,
      "end_seconds": 164.95,
      "duration_seconds": 1.79,
      "text": "Medical history?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.59,
      "end_seconds": 170.4,
      "duration_seconds": 3.81,
      "text": "Type 2 diabetes and high blood pressure."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.81,
      "end_seconds": 174.03,
      "duration_seconds": 1.22,
      "text": "Surgery?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.84,
      "end_seconds": 182.13,
      "duration_seconds": 6.29,
      "text": "Left knee scope in 2015. And a right shoulder surgery in 2019."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.58,
      "end_seconds": 185.86,
      "duration_seconds": 1.28,
      "text": "Family?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.98,
      "end_seconds": 192.69,
      "duration_seconds": 4.71,
      "text": "My father has gout. My mother has arthritis."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.75,
      "end_seconds": 197.65,
      "duration_seconds": 3.9,
      "text": "What do you do for work?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.02,
      "end_seconds": 205.11,
      "duration_seconds": 5.09,
      "text": "Flooring installer, mostly tile. So a lot of kneeling."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.18,
      "end_seconds": 207.45,
      "duration_seconds": 1.27,
      "text": "Alcohol?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.32,
      "end_seconds": 214.09,
      "duration_seconds": 3.77,
      "text": "Two beers after work, most days."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 216.18,
      "end_seconds": 222.63,
      "duration_seconds": 6.45,
      "text": "Doc, the blood draw tray is ready whenever you want it. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.6,
      "end_seconds": 247.05,
      "duration_seconds": 10.45,
      "text": "Thanks, give me five minutes. Let me check you. Temperature 37.9, blood pressure 132 over 84, pulse 84."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.9,
      "end_seconds": 251.84,
      "duration_seconds": 2.94,
      "text": "Is the temperature high? ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.63,
      "end_seconds": 268.42,
      "duration_seconds": 3.79,
      "text": "Slightly. Let me see the knee."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.37,
      "end_seconds": 272.86,
      "duration_seconds": 1.49,
      "text": "Careful. ~"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.78,
      "end_seconds": 286.26,
      "duration_seconds": 10.48,
      "text": "There's swelling over the front of the right knee, like a bag of fluid in front of the kneecap."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.8,
      "end_seconds": 292.47,
      "duration_seconds": 4.67,
      "text": "That's what I've been looking at. ~"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.63,
      "end_seconds": 302.92,
      "duration_seconds": 8.29,
      "text": "It's warm, and tender over the kneecap itself. The knee still bends fully, though."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.19,
      "end_seconds": 307.7,
      "duration_seconds": 2.51,
      "text": "It bends, yes. ~"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.34,
      "end_seconds": 314.47,
      "duration_seconds": 4.13,
      "text": "Any trouble with your breathing, chest?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.18,
      "end_seconds": 320.9,
      "duration_seconds": 4.72,
      "text": "No, nothing at all, my chest is fine."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.28,
      "end_seconds": 334.82,
      "duration_seconds": 12.54,
      "text": "This could be bursitis from kneeling, but I can't rule out an infection in the bursa, given the warmth and the temperature."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.78,
      "end_seconds": 338.37,
      "duration_seconds": 2.59,
      "text": "Infection? From kneeling? ~"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.98,
      "end_seconds": 352.85,
      "duration_seconds": 11.87,
      "text": "It happens when the skin gets broken. I'd like to arrange blood tests, including inflammation markers, and an X-ray of the knee."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 354.43,
      "end_seconds": 360.97,
      "duration_seconds": 6.54,
      "text": "I can draw the bloods now, if you like. ~"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.74,
      "end_seconds": 377.51,
      "duration_seconds": 13.77,
      "text": "Please. And I'd like to do an ultrasound of the knee, and I may need to draw some fluid out with a needle."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 378.71,
      "end_seconds": 381.04,
      "duration_seconds": 2.33,
      "text": "Sounds unpleasant. ~"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 382.63,
      "end_seconds": 391.1,
      "duration_seconds": 8.47,
      "text": "It's quick. Stop the ibuprofen on an empty stomach, and rest the knee, no kneeling for now."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 393.42,
      "end_seconds": 396.99,
      "duration_seconds": 3.57,
      "text": "That's a week's pay gone. ~"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 398.71,
      "end_seconds": 404.73,
      "duration_seconds": 6.02,
      "text": "I'd like to see you again in two days."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 406.71,
      "end_seconds": 410.92,
      "duration_seconds": 4.21,
      "text": "Two days. I'll be here. ~"
    }
  ]
}
