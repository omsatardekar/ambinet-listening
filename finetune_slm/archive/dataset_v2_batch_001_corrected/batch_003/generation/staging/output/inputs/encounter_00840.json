{
  "schema_version": "1.0",
  "encounter_id": "00840",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 3.3,
      "end_seconds": 9.82,
      "duration_seconds": 6.52,
      "text": "Doctor. My legs are swollen. Since I started the new blood pressure tablet."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.53,
      "end_seconds": 18.65,
      "duration_seconds": 5.12,
      "text": "Which tablet, and when did you start it?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.55,
      "end_seconds": 27.43,
      "duration_seconds": 4.88,
      "text": "Amlodipine. 10 mg. Once a day. Six weeks ago."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.67,
      "end_seconds": 33.47,
      "duration_seconds": 1.8,
      "text": "Both legs?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.57,
      "end_seconds": 41.85,
      "duration_seconds": 4.28,
      "text": "Both. Ankles and feet. Worse in the evening."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.73,
      "end_seconds": 47.52,
      "duration_seconds": 1.79,
      "text": "Any breathlessness?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.05,
      "end_seconds": 53.94,
      "duration_seconds": 1.89,
      "text": "No. None."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.79,
      "end_seconds": 59.9,
      "duration_seconds": 2.11,
      "text": "Any chest pain?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.14,
      "end_seconds": 65.57,
      "duration_seconds": 1.43,
      "text": "No. Nothing."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.16,
      "end_seconds": 72.96,
      "duration_seconds": 2.8,
      "text": "What else do you take?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.59,
      "end_seconds": 79.88,
      "duration_seconds": 3.29,
      "text": "Metformin. 500 mg. Twice a day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.99,
      "end_seconds": 86.58,
      "duration_seconds": 2.59,
      "text": "Any other conditions?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.07,
      "end_seconds": 94.4,
      "duration_seconds": 3.33,
      "text": "Diabetes. And kidney disease. Mild."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.51,
      "end_seconds": 103.07,
      "duration_seconds": 4.56,
      "text": "Any change in the amount of urine? ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.71,
      "end_seconds": 109.84,
      "duration_seconds": 2.13,
      "text": "No. Same. ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.47,
      "end_seconds": 120.36,
      "duration_seconds": 5.89,
      "text": "Let me look at your legs. Sit on the couch. ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.87,
      "end_seconds": 139.15,
      "duration_seconds": 1.28,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.44,
      "end_seconds": 156.06,
      "duration_seconds": 12.62,
      "text": "Both legs are swollen up to the shins, soft and pitting when I press, with no redness or tenderness, and the skin is intact."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.05,
      "end_seconds": 163.18,
      "duration_seconds": 3.13,
      "text": "Is it my heart? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.28,
      "end_seconds": 182.74,
      "duration_seconds": 15.46,
      "text": "The pattern, both legs, after starting amlodipine, with no breathlessness, fits with a known side effect of that tablet. I'd say this is amlodipine-related ankle swelling."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.27,
      "end_seconds": 188.82,
      "duration_seconds": 2.55,
      "text": "Can it stop? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.44,
      "end_seconds": 207.63,
      "duration_seconds": 15.19,
      "text": "It often settles when the dose is lowered or the tablet changed. But because you have kidney disease and diabetes, I want to rule out other causes. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.25,
      "end_seconds": 215.65,
      "duration_seconds": 3.4,
      "text": "What do you want? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.74,
      "end_seconds": 228.59,
      "duration_seconds": 8.85,
      "text": "I'd like to arrange blood tests, for your kidney function, and a urine test for protein."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.31,
      "end_seconds": 234.33,
      "duration_seconds": 2.02,
      "text": "Today? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.06,
      "end_seconds": 243.22,
      "duration_seconds": 4.16,
      "text": "Please. The nurse will take them. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.82,
      "end_seconds": 248.49,
      "duration_seconds": 1.67,
      "text": "Fine. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.87,
      "end_seconds": 261.85,
      "duration_seconds": 8.98,
      "text": "And I'd like to see you again in a week, with the results. I may change your tablet then."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.92,
      "end_seconds": 268.67,
      "duration_seconds": 2.75,
      "text": "A week. Okay. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.04,
      "end_seconds": 279.05,
      "duration_seconds": 6.01,
      "text": "Meanwhile, raise your legs when you sit, and don't stand for long."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.58,
      "end_seconds": 284.34,
      "duration_seconds": 1.76,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.28,
      "end_seconds": 299.62,
      "duration_seconds": 11.34,
      "text": "If you get breathless, chest pain, or one leg becomes much more swollen than the other, or red, come the same day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.72,
      "end_seconds": 305.99,
      "duration_seconds": 2.27,
      "text": "I will. ~"
    }
  ]
}
