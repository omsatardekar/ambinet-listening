{
  "schema_version": "1.0",
  "encounter_id": "00671",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.57,
      "end_seconds": 12.14,
      "duration_seconds": 10.57,
      "text": "Morning. It's these patches. Itchy ones, on my elbows and knees. I've had them a few months."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.6,
      "end_seconds": 21.89,
      "duration_seconds": 6.29,
      "text": "Tell me more about them. What do they look like?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.74,
      "end_seconds": 30.76,
      "duration_seconds": 7.02,
      "text": "Red, with a silvery flaky bit on top. They look daft."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.45,
      "end_seconds": 36.91,
      "duration_seconds": 3.46,
      "text": "Do they flake a lot?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.45,
      "end_seconds": 50.0,
      "duration_seconds": 9.55,
      "text": "Aye, I find bits in the bed. And they itch like mad, mainly at night."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.3,
      "end_seconds": 58.68,
      "duration_seconds": 5.38,
      "text": "Have you ever had anything like it before? ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.85,
      "end_seconds": 64.27,
      "duration_seconds": 2.42,
      "text": "No. First time. ~"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.37,
      "end_seconds": 71.58,
      "duration_seconds": 4.21,
      "text": "Any changes to your nails, pitting, ridges, anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.18,
      "end_seconds": 77.08,
      "duration_seconds": 2.9,
      "text": "No, nails are fine."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.15,
      "end_seconds": 87.47,
      "duration_seconds": 8.32,
      "text": "And are your joints okay, any pain or stiffness, especially in the morning?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.17,
      "end_seconds": 93.88,
      "duration_seconds": 3.71,
      "text": "No, nothing. Joints are fine."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.7,
      "end_seconds": 100.34,
      "duration_seconds": 3.64,
      "text": "What work do you do?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.95,
      "end_seconds": 115.69,
      "duration_seconds": 11.74,
      "text": "I'm a scaffolder. I'm outdoors most days, and gloves and knee pads, so the knees are rubbed a lot."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.85,
      "end_seconds": 145.38,
      "duration_seconds": 9.53,
      "text": "That could be making them sorer. Let me have a look. Roll up your sleeve, and your trouser leg."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.72,
      "end_seconds": 150.68,
      "duration_seconds": 2.96,
      "text": "There you go. ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.66,
      "end_seconds": 167.26,
      "duration_seconds": 13.6,
      "text": "Right. I'm not going to put a label on it today. I'd like to treat them first and see how they respond. ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.16,
      "end_seconds": 173.54,
      "duration_seconds": 3.38,
      "text": "Fair enough. What's the treatment? ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.45,
      "end_seconds": 185.94,
      "duration_seconds": 10.49,
      "text": "I'd like to start you on a steroid cream, betamethasone, apply it to the patches once a day for two weeks, thinly."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.28,
      "end_seconds": 191.36,
      "duration_seconds": 3.08,
      "text": "Just to the patches? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.4,
      "end_seconds": 198.58,
      "duration_seconds": 5.18,
      "text": "Just the patches, nowhere else. Wash your hands afterwards. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.99,
      "end_seconds": 205.95,
      "duration_seconds": 3.96,
      "text": "Right. Does it stop the itch? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.07,
      "end_seconds": 222.84,
      "duration_seconds": 13.77,
      "text": "It usually does within a few days. And I'd like to arrange a skin scraping from one patch, to make sure it's not a fungal infection."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.76,
      "end_seconds": 226.95,
      "duration_seconds": 2.19,
      "text": "A scraping? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.7,
      "end_seconds": 237.74,
      "duration_seconds": 8.04,
      "text": "A tiny bit of the flaky skin, painless. I'll do it now. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.93,
      "end_seconds": 256.33,
      "duration_seconds": 2.4,
      "text": "Go on then."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.9,
      "end_seconds": 270.25,
      "duration_seconds": 11.35,
      "text": "Done. You'll hear if anything shows. Moisturise every day, with a plain thick cream, even when they're better."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.74,
      "end_seconds": 276.62,
      "duration_seconds": 3.88,
      "text": "I'm not much for creams. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.54,
      "end_seconds": 286.43,
      "duration_seconds": 6.89,
      "text": "It makes a big difference. Try it for a fortnight. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.96,
      "end_seconds": 293.85,
      "duration_seconds": 3.89,
      "text": "Right. And if it doesn't work? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.93,
      "end_seconds": 300.65,
      "duration_seconds": 4.72,
      "text": "Then come back and we'll think again. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.28,
      "end_seconds": 306.0,
      "duration_seconds": 2.72,
      "text": "Fine. Thanks, doctor. ~"
    }
  ]
}
