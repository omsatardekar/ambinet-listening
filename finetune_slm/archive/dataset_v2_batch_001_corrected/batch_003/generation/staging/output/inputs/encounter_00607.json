{
  "schema_version": "1.0",
  "encounter_id": "00607",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.9,
      "end_seconds": 7.54,
      "duration_seconds": 6.64,
      "text": "Hot one out there today. Took me twenty minutes to find a park."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.05,
      "end_seconds": 17.47,
      "duration_seconds": 8.42,
      "text": "Always the way on Thursdays. Council's got half the street dug up. Come in, sit down."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.34,
      "end_seconds": 25.83,
      "duration_seconds": 5.49,
      "text": "Right, the note says scalp trouble. What's going on?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.88,
      "end_seconds": 31.6,
      "duration_seconds": 3.72,
      "text": "Itchy scalp. Since I dyed my hair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.28,
      "end_seconds": 37.57,
      "duration_seconds": 4.29,
      "text": "How long ago was the dye?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.14,
      "end_seconds": 46.73,
      "duration_seconds": 7.59,
      "text": "Five days ago. Box dye, a darker brown. Got it at the chemist."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.54,
      "end_seconds": 52.25,
      "duration_seconds": 3.71,
      "text": "Had you used that brand before?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.53,
      "end_seconds": 58.92,
      "duration_seconds": 4.39,
      "text": "Different brand. First time with this one."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.95,
      "end_seconds": 65.68,
      "duration_seconds": 4.73,
      "text": "When did the itch start, relative to the dye?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.39,
      "end_seconds": 71.71,
      "duration_seconds": 5.32,
      "text": "The day after the dye. Got worse by the weekend."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.52,
      "end_seconds": 78.45,
      "duration_seconds": 4.93,
      "text": "Describe the itch for me. Is it constant?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.17,
      "end_seconds": 82.46,
      "duration_seconds": 3.29,
      "text": "Pretty constant. Worse in hot showers."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.29,
      "end_seconds": 88.44,
      "duration_seconds": 5.15,
      "text": "Anything else going on up there? Burning, stinging, anything?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.71,
      "end_seconds": 95.17,
      "duration_seconds": 4.46,
      "text": "A burning feeling along the front, yeah."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.01,
      "end_seconds": 103.4,
      "duration_seconds": 5.39,
      "text": "Okay. Any skin changes you can see or feel?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.22,
      "end_seconds": 110.73,
      "duration_seconds": 6.51,
      "text": "Flaking. Bits come off when I scratch. And redness along my hairline."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.05,
      "end_seconds": 117.57,
      "duration_seconds": 5.52,
      "text": "Mm. Any swelling around the eyes or lips?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.48,
      "end_seconds": 121.02,
      "duration_seconds": 1.54,
      "text": "Nope."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.83,
      "end_seconds": 125.63,
      "duration_seconds": 3.8,
      "text": "Fever or feeling hot and shivery?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.11,
      "end_seconds": 128.19,
      "duration_seconds": 1.08,
      "text": "No."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.38,
      "end_seconds": 135.08,
      "duration_seconds": 4.7,
      "text": "Rash anywhere else on your body, arms, neck, chest?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.91,
      "end_seconds": 141.49,
      "duration_seconds": 3.58,
      "text": "Not at all. Just the head."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.77,
      "end_seconds": 150.07,
      "duration_seconds": 6.3,
      "text": "Good. Now, do you have any health conditions I should know about?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.65,
      "end_seconds": 157.68,
      "duration_seconds": 6.03,
      "text": "High blood pressure. Asthma. And migraines, but they're pretty rare."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.7,
      "end_seconds": 161.12,
      "duration_seconds": 2.42,
      "text": "Medicines for those?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.27,
      "end_seconds": 167.32,
      "duration_seconds": 5.05,
      "text": "Ramipril, 5 mg once a day, for my blood pressure."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.73,
      "end_seconds": 171.68,
      "duration_seconds": 2.95,
      "text": "And for the asthma?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.3,
      "end_seconds": 177.55,
      "duration_seconds": 4.25,
      "text": "Ventolin puffer. When I need it. Not often."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.77,
      "end_seconds": 182.57,
      "duration_seconds": 3.8,
      "text": "Any allergies to medicines or anything else?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.6,
      "end_seconds": 186.45,
      "duration_seconds": 1.85,
      "text": "Nope. None."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.29,
      "end_seconds": 191.39,
      "duration_seconds": 4.1,
      "text": "Okay. Any operations in the past?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.38,
      "end_seconds": 196.19,
      "duration_seconds": 3.81,
      "text": "Appendix out, about ten years ago."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.26,
      "end_seconds": 198.66,
      "duration_seconds": 1.4,
      "text": "Any others?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.27,
      "end_seconds": 203.83,
      "duration_seconds": 2.56,
      "text": "Tonsils. As a child."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.8,
      "end_seconds": 209.65,
      "duration_seconds": 2.85,
      "text": "Family history of skin problems?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.82,
      "end_seconds": 214.8,
      "duration_seconds": 3.98,
      "text": "Mum's got psoriasis. Mostly on her elbows."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.41,
      "end_seconds": 222.03,
      "duration_seconds": 4.62,
      "text": "Noted. What do you do for work?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.03,
      "end_seconds": 230.38,
      "duration_seconds": 7.35,
      "text": "I'm an electrician. Lots of time in a hard hat, if that matters."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.89,
      "end_seconds": 236.23,
      "duration_seconds": 3.34,
      "text": "It might, actually. Do you smoke?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.13,
      "end_seconds": 242.33,
      "duration_seconds": 3.2,
      "text": "Never smoked in my life."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.74,
      "end_seconds": 245.07,
      "duration_seconds": 1.33,
      "text": "Alcohol?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.61,
      "end_seconds": 253.52,
      "duration_seconds": 5.91,
      "text": "A couple of beers on the weekend. That's it."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.89,
      "end_seconds": 257.07,
      "duration_seconds": 1.18,
      "text": "Exercise?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.87,
      "end_seconds": 267.34,
      "duration_seconds": 7.47,
      "text": "Gym three times a week. Sweat a lot under the helmet, too."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.49,
      "end_seconds": 291.64,
      "duration_seconds": 11.15,
      "text": "Lovely, thanks. Let me check your vitals. Blood pressure 138 over 86. Pulse 76. Temperature 36.8. Oxygen 99 percent. Weight 84 kilos."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.33,
      "end_seconds": 296.38,
      "duration_seconds": 3.05,
      "text": "Is the pressure high?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.36,
      "end_seconds": 309.0,
      "duration_seconds": 10.64,
      "text": "A touch up, nothing to worry about today. How's your breathing, by the way, any problems with the chest?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.6,
      "end_seconds": 312.96,
      "duration_seconds": 1.36,
      "text": "Breathing's fine."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.91,
      "end_seconds": 333.44,
      "duration_seconds": 7.53,
      "text": "Good. Now let's have a look at the scalp. Part your hair for me, chin down."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.66,
      "end_seconds": 348.33,
      "duration_seconds": 5.67,
      "text": "Your scalp is red and flaky along the front hairline."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.84,
      "end_seconds": 353.65,
      "duration_seconds": 3.81,
      "text": "Yeah, I can feel that bit."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.7,
      "end_seconds": 366.72,
      "duration_seconds": 5.02,
      "text": "There are small crusted spots behind both ears as well."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 369.46,
      "end_seconds": 371.99,
      "duration_seconds": 2.53,
      "text": "I hadn't seen those."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.36,
      "end_seconds": 379.31,
      "duration_seconds": 5.95,
      "text": "And I can't feel any swollen glands in your neck."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 381.96,
      "end_seconds": 402.87,
      "duration_seconds": 20.91,
      "text": "So what I'm thinking. This could be a reaction to the dye, a contact dermatitis. But I can't rule out a flare of dermatitis from the helmet and sweat, or even psoriasis, given your mum."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 404.05,
      "end_seconds": 407.89,
      "duration_seconds": 3.84,
      "text": "Right. Not just the dye, then."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 410.33,
      "end_seconds": 416.77,
      "duration_seconds": 6.44,
      "text": "Possibly not. Hard to say from looking alone, so we'll test it."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 419.65,
      "end_seconds": 421.25,
      "duration_seconds": 1.6,
      "text": "What tests?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 422.58,
      "end_seconds": 432.8,
      "duration_seconds": 10.22,
      "text": "I'd like to do a skin scraping today, and the nurse will take it on the way out."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 434.82,
      "end_seconds": 442.68,
      "duration_seconds": 7.86,
      "text": "We'll also do a swab of the crusted spots, to check for infection."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 445.21,
      "end_seconds": 457.02,
      "duration_seconds": 11.81,
      "text": "And I'd like to book a patch test, to see exactly what your skin reacts to. The clinic will call you with a date."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 458.26,
      "end_seconds": 461.83,
      "duration_seconds": 3.57,
      "text": "How long does that take?"
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 463.93,
      "end_seconds": 473.43,
      "duration_seconds": 9.5,
      "text": "A few visits across a week. Until then, no more dye, and use a gentle shampoo. Lukewarm water, not hot."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 475.21,
      "end_seconds": 477.99,
      "duration_seconds": 2.78,
      "text": "Easy. I'll skip the dye."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 480.31,
      "end_seconds": 485.84,
      "duration_seconds": 5.53,
      "text": "Come back next Thursday and we'll go over the results."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 487.36,
      "end_seconds": 491.24,
      "duration_seconds": 3.88,
      "text": "Next Thursday. Righto. Hopefully a park too."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 493.02,
      "end_seconds": 497.95,
      "duration_seconds": 4.93,
      "text": "Ha, good luck with that. See you then."
    }
  ]
}
