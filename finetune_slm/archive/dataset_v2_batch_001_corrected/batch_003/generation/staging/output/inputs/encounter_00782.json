{
  "schema_version": "1.0",
  "encounter_id": "00782",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 3.86,
      "end_seconds": 10.65,
      "duration_seconds": 6.79,
      "text": "Morning. My hands are stiff in the morning. Both. About an hour."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.07,
      "end_seconds": 18.93,
      "duration_seconds": 3.86,
      "text": "How long has that been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.17,
      "end_seconds": 29.96,
      "duration_seconds": 6.79,
      "text": "A while. I can't say exactly. A few months. Or longer."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.44,
      "end_seconds": 36.21,
      "duration_seconds": 1.77,
      "text": "Which joints?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.97,
      "end_seconds": 44.08,
      "duration_seconds": 3.11,
      "text": "Knuckles. Fingers. Wrists a bit."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.02,
      "end_seconds": 55.01,
      "duration_seconds": 5.99,
      "text": "Does it get better as the day goes on? ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.31,
      "end_seconds": 62.88,
      "duration_seconds": 3.57,
      "text": "Yes. By lunchtime I'm fine. ~"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.83,
      "end_seconds": 71.21,
      "duration_seconds": 3.38,
      "text": "Any swelling in the joints?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.08,
      "end_seconds": 81.05,
      "duration_seconds": 4.97,
      "text": "Maybe a little in the knuckles. No redness."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.97,
      "end_seconds": 90.21,
      "duration_seconds": 5.24,
      "text": "Any other joint pain, like your feet, knees, or back?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.15,
      "end_seconds": 96.49,
      "duration_seconds": 2.34,
      "text": "No. Just hands."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.37,
      "end_seconds": 106.24,
      "duration_seconds": 4.87,
      "text": "Does anyone in the family have arthritis?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.17,
      "end_seconds": 113.41,
      "duration_seconds": 3.24,
      "text": "My mother had rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.23,
      "end_seconds": 121.56,
      "duration_seconds": 3.33,
      "text": "Any psoriasis, or rashes? ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.39,
      "end_seconds": 129.49,
      "duration_seconds": 3.1,
      "text": "No. Skin's fine. ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.41,
      "end_seconds": 137.11,
      "duration_seconds": 3.7,
      "text": "Do you have any other conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.74,
      "end_seconds": 144.59,
      "duration_seconds": 2.85,
      "text": "High blood pressure. That's all."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.04,
      "end_seconds": 157.27,
      "duration_seconds": 8.23,
      "text": "Let me look at your hands. Put them out in front of you. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.26,
      "end_seconds": 175.95,
      "duration_seconds": 1.69,
      "text": "Like this?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.54,
      "end_seconds": 189.29,
      "duration_seconds": 8.75,
      "text": "There's slight swelling over several knuckles in both hands, and they're tender when I squeeze across them."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.79,
      "end_seconds": 196.64,
      "duration_seconds": 2.85,
      "text": "Is that arthritis? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.56,
      "end_seconds": 212.81,
      "duration_seconds": 12.25,
      "text": "With an hour of morning stiffness, swollen knuckles, and your mother's history, this fits with an inflammatory arthritis, I'd say probable early rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.78,
      "end_seconds": 220.32,
      "duration_seconds": 3.54,
      "text": "Rheumatoid. Like my mother. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.25,
      "end_seconds": 237.65,
      "duration_seconds": 12.4,
      "text": "It's treatable, and treating it early prevents damage. I'd like to arrange blood tests and X-rays of both hands, and refer you to the rheumatology team."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.49,
      "end_seconds": 243.26,
      "duration_seconds": 1.77,
      "text": "When? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.94,
      "end_seconds": 255.02,
      "duration_seconds": 7.08,
      "text": "The specialist will see you within a few weeks. I'll mark it urgent."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.58,
      "end_seconds": 262.5,
      "duration_seconds": 2.92,
      "text": "And in the meantime? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.04,
      "end_seconds": 278.02,
      "duration_seconds": 10.98,
      "text": "Keep your hands warm and moving, and do gentle exercises, like making a fist and opening it, every morning."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.7,
      "end_seconds": 284.14,
      "duration_seconds": 1.44,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.49,
      "end_seconds": 297.88,
      "duration_seconds": 9.39,
      "text": "If your joints become very swollen, you get a fever, or you can't use your hands, ring us."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.25,
      "end_seconds": 306.01,
      "duration_seconds": 3.76,
      "text": "I will. Thank you. ~"
    }
  ]
}
