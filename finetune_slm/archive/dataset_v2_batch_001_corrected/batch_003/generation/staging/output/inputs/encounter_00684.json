{
  "schema_version": "1.0",
  "encounter_id": "00684",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.98,
      "end_seconds": 13.81,
      "duration_seconds": 12.83,
      "text": "Good morning, doctor. Thank you for seeing me. I have been having pain in the upper right of my abdomen, after I eat fatty food."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.73,
      "end_seconds": 24.78,
      "duration_seconds": 8.05,
      "text": "Good morning, Mr Reddy. Tell me more about the pain. When does it come on?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.43,
      "end_seconds": 38.88,
      "duration_seconds": 11.45,
      "text": "Usually an hour after a heavy meal, fried food especially. It is quite sharp, and it lasts for about two hours."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.72,
      "end_seconds": 42.29,
      "duration_seconds": 2.57,
      "text": "Does it spread anywhere?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.0,
      "end_seconds": 51.91,
      "duration_seconds": 7.91,
      "text": "Sometimes to my right shoulder blade. And I feel nauseous along with it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.81,
      "end_seconds": 58.37,
      "duration_seconds": 3.56,
      "text": "How often does it happen?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.14,
      "end_seconds": 63.7,
      "duration_seconds": 4.56,
      "text": "Perhaps once a week, since about three months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.69,
      "end_seconds": 68.13,
      "duration_seconds": 2.44,
      "text": "Have you been vomiting?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.49,
      "end_seconds": 73.68,
      "duration_seconds": 3.19,
      "text": "Not vomiting, but nausea, yes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.79,
      "end_seconds": 81.23,
      "duration_seconds": 6.44,
      "text": "Any yellowing of your eyes or skin, or dark urine?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.97,
      "end_seconds": 87.99,
      "duration_seconds": 5.02,
      "text": "No, no yellowing. And my urine is normal."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.21,
      "end_seconds": 93.25,
      "duration_seconds": 3.04,
      "text": "Any fever with the attacks?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.4,
      "end_seconds": 97.49,
      "duration_seconds": 2.09,
      "text": "No fever, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.6,
      "end_seconds": 103.16,
      "duration_seconds": 4.56,
      "text": "Are you taking anything at the moment?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.05,
      "end_seconds": 111.55,
      "duration_seconds": 5.5,
      "text": "Just omeprazole, 20 mg once a day, for acidity."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.91,
      "end_seconds": 115.21,
      "duration_seconds": 2.3,
      "text": "Any other conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.26,
      "end_seconds": 123.86,
      "duration_seconds": 6.6,
      "text": "I have type 2 diabetes, high cholesterol, and high blood pressure."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.2,
      "end_seconds": 129.98,
      "duration_seconds": 4.78,
      "text": "Do you have any family history of gallstones?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.48,
      "end_seconds": 137.35,
      "duration_seconds": 5.87,
      "text": "Yes, my mother had her gallbladder removed, I believe in her fifties."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.8,
      "end_seconds": 144.53,
      "duration_seconds": 5.73,
      "text": "And your diet, do you eat a lot of fried food?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.42,
      "end_seconds": 154.93,
      "duration_seconds": 7.51,
      "text": "I confess I love samosas and pakoras. I eat them most evenings."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.46,
      "end_seconds": 160.26,
      "duration_seconds": 2.8,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.74,
      "end_seconds": 165.21,
      "duration_seconds": 3.47,
      "text": "No, I do not drink."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.66,
      "end_seconds": 171.2,
      "duration_seconds": 3.54,
      "text": "Let me check your numbers. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.65,
      "end_seconds": 175.3,
      "duration_seconds": 1.65,
      "text": "Please. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.2,
      "end_seconds": 195.63,
      "duration_seconds": 7.43,
      "text": "Pulse 76, blood pressure 138 over 86, temperature 36.7, oxygen 98 percent, weight 88 kilos."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.91,
      "end_seconds": 200.53,
      "duration_seconds": 2.62,
      "text": "Is that acceptable? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.69,
      "end_seconds": 216.27,
      "duration_seconds": 13.58,
      "text": "A little high on the pressure, but nothing alarming. Now, please lie back and breathe in deeply while I press under your right ribs. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.4,
      "end_seconds": 221.5,
      "duration_seconds": 4.1,
      "text": "Oh. That is the sore spot. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.15,
      "end_seconds": 246.36,
      "duration_seconds": 7.21,
      "text": "You are tender under the right ribs, especially when you breathe in."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.12,
      "end_seconds": 251.51,
      "duration_seconds": 3.39,
      "text": "Is it the gallbladder? ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.82,
      "end_seconds": 267.79,
      "duration_seconds": 14.97,
      "text": "The pattern fits, and I will want to see it properly. I'd like to arrange an ultrasound scan of your abdomen, to look at the gallbladder and the liver."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.27,
      "end_seconds": 272.97,
      "duration_seconds": 3.7,
      "text": "When can I have it? ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.6,
      "end_seconds": 283.85,
      "duration_seconds": 8.25,
      "text": "Within two weeks. I'd also like a blood test to check your liver, pancreas and sugar."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.84,
      "end_seconds": 288.7,
      "duration_seconds": 1.86,
      "text": "Certainly. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.94,
      "end_seconds": 297.08,
      "duration_seconds": 7.14,
      "text": "Until then, please avoid fried and fatty food, and eat smaller, lighter meals."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.63,
      "end_seconds": 304.41,
      "duration_seconds": 4.78,
      "text": "That will be a sacrifice, but I understand. ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.96,
      "end_seconds": 321.28,
      "duration_seconds": 14.32,
      "text": "If the pain lasts more than six hours, or you develop a fever, or your skin turns yellow, come in the same day or go to the emergency department."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.43,
      "end_seconds": 325.95,
      "duration_seconds": 2.52,
      "text": "Thank you, doctor. ~"
    }
  ]
}
