{
  "schema_version": "1.0",
  "encounter_id": "00837",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 1.11,
      "end_seconds": 15.18,
      "duration_seconds": 14.07,
      "text": "Mr Pryce, the booking says a painful big toe. Come in, sit, and I'll help you with that foot. Is this your wife? ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 17.65,
      "end_seconds": 26.13,
      "duration_seconds": 8.48,
      "text": "I'm Gwen. He's been up all night. I told him to ring last week. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.53,
      "end_seconds": 47.65,
      "duration_seconds": 19.12,
      "text": "It's my big toe, doctor, the left one. It came on suddenly two days ago and it's the worst pain I've ever had. Is it broken? Is it infected? Is it going to be amputated?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.96,
      "end_seconds": 54.78,
      "duration_seconds": 5.82,
      "text": "It's very unlikely to be any of those. Describe the pain."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.05,
      "end_seconds": 63.62,
      "duration_seconds": 7.57,
      "text": "Throbbing, severe, ten out of ten. Even the bedsheet on it is agony."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.74,
      "end_seconds": 67.37,
      "duration_seconds": 2.63,
      "text": "Is it swollen?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.69,
      "end_seconds": 73.16,
      "duration_seconds": 3.47,
      "text": "Swollen like a plum, and hot."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.63,
      "end_seconds": 76.59,
      "duration_seconds": 1.96,
      "text": "Are you limping?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 78.23,
      "end_seconds": 85.12,
      "duration_seconds": 6.89,
      "text": "He couldn't get his shoe on this morning. He's hopping about the kitchen."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.94,
      "end_seconds": 93.95,
      "duration_seconds": 6.01,
      "text": "Did you knock it, or drop something on it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.31,
      "end_seconds": 99.37,
      "duration_seconds": 4.06,
      "text": "No, nothing. I didn't hurt it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.47,
      "end_seconds": 104.11,
      "duration_seconds": 2.64,
      "text": "Any fever or shivers?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.88,
      "end_seconds": 111.89,
      "duration_seconds": 5.01,
      "text": "A bit warm last night, but no fever, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.25,
      "end_seconds": 117.18,
      "duration_seconds": 2.93,
      "text": "Pain in any other joints?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.95,
      "end_seconds": 120.61,
      "duration_seconds": 2.66,
      "text": "No, just the toe."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.5,
      "end_seconds": 123.05,
      "duration_seconds": 1.55,
      "text": "Any rash?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.85,
      "end_seconds": 126.22,
      "duration_seconds": 1.37,
      "text": "No rash."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 128.81,
      "end_seconds": 136.22,
      "duration_seconds": 7.41,
      "text": "Doctor, would you like him on the couch with the foot up? ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.88,
      "end_seconds": 144.08,
      "duration_seconds": 5.2,
      "text": "Yes please, nurse. Mr Pryce, what medicines are you taking?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.01,
      "end_seconds": 154.95,
      "duration_seconds": 9.94,
      "text": "Allopurinol, 100 mg, once a day. And naproxen, 250 mg, I took one last night, it did nothing."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.72,
      "end_seconds": 158.5,
      "duration_seconds": 1.78,
      "text": "Any allergies?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.92,
      "end_seconds": 165.65,
      "duration_seconds": 5.73,
      "text": "Penicillin, when I was a boy. I had a rash."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.63,
      "end_seconds": 169.31,
      "duration_seconds": 1.68,
      "text": "Medical history?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.28,
      "end_seconds": 178.39,
      "duration_seconds": 6.11,
      "text": "Gout, from years ago. High blood pressure. And I'm overweight, I know."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.65,
      "end_seconds": 181.1,
      "duration_seconds": 1.45,
      "text": "Surgery?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.18,
      "end_seconds": 185.55,
      "duration_seconds": 2.37,
      "text": "Gallbladder, in 2016."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.15,
      "end_seconds": 190.92,
      "duration_seconds": 2.77,
      "text": "Gout in the family?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.26,
      "end_seconds": 196.17,
      "duration_seconds": 2.91,
      "text": "My father had it terribly."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.42,
      "end_seconds": 201.3,
      "duration_seconds": 2.88,
      "text": "What do you do?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.98,
      "end_seconds": 213.58,
      "duration_seconds": 9.6,
      "text": "I drive a bus. Twelve hours. It's my foot on the pedal, doctor, I can't work like this."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.71,
      "end_seconds": 216.78,
      "duration_seconds": 2.07,
      "text": "Do you drink?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.43,
      "end_seconds": 222.93,
      "duration_seconds": 4.5,
      "text": "Four pints on a Saturday, and wine with dinner."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.3,
      "end_seconds": 227.36,
      "duration_seconds": 3.06,
      "text": "And what do you eat?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 229.41,
      "end_seconds": 235.31,
      "duration_seconds": 5.9,
      "text": "Red meat, and he loves shellfish at the weekend."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.99,
      "end_seconds": 265.07,
      "duration_seconds": 12.08,
      "text": "Let me check you. Pulse 86, blood pressure 150 over 94, temperature 37.4, oxygen 97 percent, breathing 16, weight 104 kilos."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.39,
      "end_seconds": 270.73,
      "duration_seconds": 3.34,
      "text": "Is the pressure dangerous? ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.69,
      "end_seconds": 288.24,
      "duration_seconds": 5.55,
      "text": "High, from the pain. Now, the toe. I'll be gentle."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.27,
      "end_seconds": 292.84,
      "duration_seconds": 2.57,
      "text": "Ow! Stop! ~"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.19,
      "end_seconds": 304.28,
      "duration_seconds": 9.09,
      "text": "The base of the left big toe is red, hot and swollen, and it's extremely tender to touch."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.99,
      "end_seconds": 307.37,
      "duration_seconds": 2.38,
      "text": "I told you. ~"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.51,
      "end_seconds": 314.44,
      "duration_seconds": 5.93,
      "text": "The other toes look fine, and the ankle moves normally."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 317.13,
      "end_seconds": 319.63,
      "duration_seconds": 2.5,
      "text": "Is it infected? ~"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.62,
      "end_seconds": 326.26,
      "duration_seconds": 4.64,
      "text": "Any trouble with your chest or breathing, Mr Pryce?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.07,
      "end_seconds": 331.31,
      "duration_seconds": 4.24,
      "text": "No, nothing, I'm fine in that way."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.93,
      "end_seconds": 339.32,
      "duration_seconds": 6.39,
      "text": "This looks like a gout flare, the classic big toe."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.94,
      "end_seconds": 344.68,
      "duration_seconds": 2.74,
      "text": "Not broken then? ~"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.65,
      "end_seconds": 358.65,
      "duration_seconds": 11.0,
      "text": "I don't think so, but I'd like to arrange a uric acid blood test, a kidney function test, and an X-ray of the foot."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 360.8,
      "end_seconds": 364.93,
      "duration_seconds": 4.13,
      "text": "I'll book the X-ray for this afternoon. ~"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.09,
      "end_seconds": 375.2,
      "duration_seconds": 9.11,
      "text": "Thank you. Keep taking the naproxen with food, rest the foot, and drink plenty of water."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 377.44,
      "end_seconds": 381.11,
      "duration_seconds": 3.67,
      "text": "Can I go to work? ~"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 383.83,
      "end_seconds": 392.08,
      "duration_seconds": 8.25,
      "text": "Not on the pedal for a few days. I'd like to see you again in two weeks."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 393.32,
      "end_seconds": 398.54,
      "duration_seconds": 5.22,
      "text": "Two weeks, I'll make sure he comes. ~"
    }
  ]
}
