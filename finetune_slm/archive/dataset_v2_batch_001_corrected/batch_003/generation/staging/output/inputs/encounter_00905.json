{
  "schema_version": "1.0",
  "encounter_id": "00905",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 1.14,
      "end_seconds": 18.48,
      "duration_seconds": 17.34,
      "text": "Sorry, sorry, we're late, I took the wrong turn, the sat nav sent us the long way round. This is Chloe, she fell off the trampoline about two hours ago."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.42,
      "end_seconds": 27.1,
      "duration_seconds": 6.68,
      "text": "No worries. Hi Chloe, I'm Dr Nguyen. How are you feeling? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.71,
      "end_seconds": 30.96,
      "duration_seconds": 2.25,
      "text": "My arm hurts."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.81,
      "end_seconds": 33.61,
      "duration_seconds": 1.8,
      "text": "Which arm?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.82,
      "end_seconds": 40.04,
      "duration_seconds": 5.22,
      "text": "This one. The left. Near my wrist. It's sore."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 41.04,
      "end_seconds": 51.58,
      "duration_seconds": 10.54,
      "text": "She landed on it, I saw it. It was her left hand, flat out, and she screamed."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.11,
      "end_seconds": 57.56,
      "duration_seconds": 4.45,
      "text": "Was anyone else on the trampoline? ~"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 59.46,
      "end_seconds": 68.53,
      "duration_seconds": 9.07,
      "text": "Her cousin, Jack, but he'd got off. He's the one who ran in to get me, he's six. ~"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.48,
      "end_seconds": 75.91,
      "duration_seconds": 5.43,
      "text": "That's a good cousin. Chloe, does it look different?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.25,
      "end_seconds": 79.62,
      "duration_seconds": 1.37,
      "text": "It's puffy."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.42,
      "end_seconds": 88.37,
      "duration_seconds": 5.95,
      "text": "Can you turn your hand over for me, like you're holding soup?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.49,
      "end_seconds": 93.13,
      "duration_seconds": 2.64,
      "text": "Ow. No. It hurts."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 93.92,
      "end_seconds": 100.31,
      "duration_seconds": 6.39,
      "text": "She can't turn it over, no. She tried in the car."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.27,
      "end_seconds": 105.68,
      "duration_seconds": 4.41,
      "text": "Did you hit your head, Chloe?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.54,
      "end_seconds": 110.36,
      "duration_seconds": 2.82,
      "text": "No. Just my arm."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 111.55,
      "end_seconds": 118.23,
      "duration_seconds": 6.68,
      "text": "She didn't hit her head. She was awake and crying straight away. ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.04,
      "end_seconds": 125.3,
      "duration_seconds": 4.26,
      "text": "Did you feel dizzy, or pass out?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.53,
      "end_seconds": 127.77,
      "duration_seconds": 1.24,
      "text": "No."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.11,
      "end_seconds": 132.95,
      "duration_seconds": 3.84,
      "text": "Any tingling in your fingers?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.87,
      "end_seconds": 137.85,
      "duration_seconds": 3.98,
      "text": "A bit funny. No, not funny. Just sore."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.8,
      "end_seconds": 142.61,
      "duration_seconds": 2.81,
      "text": "So no tingling? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.98,
      "end_seconds": 146.8,
      "duration_seconds": 1.82,
      "text": "No tingling."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.37,
      "end_seconds": 151.69,
      "duration_seconds": 3.32,
      "text": "Does your elbow or shoulder hurt?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.61,
      "end_seconds": 157.77,
      "duration_seconds": 3.16,
      "text": "No, just by the wrist."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.57,
      "end_seconds": 162.03,
      "duration_seconds": 2.46,
      "text": "Any medicines, Chloe's carer?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 163.86,
      "end_seconds": 177.02,
      "duration_seconds": 13.16,
      "text": "She had ibuprofen, 200 mg, in the car, I keep it in my bag. And montelukast, 5 mg, every night for her asthma."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.59,
      "end_seconds": 183.33,
      "duration_seconds": 3.74,
      "text": "Thank you. Any allergies, Chloe?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 184.59,
      "end_seconds": 192.78,
      "duration_seconds": 8.19,
      "text": "Egg. She's allergic to egg. But I couldn't tell you what happens, her mum would know."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.57,
      "end_seconds": 198.53,
      "duration_seconds": 2.96,
      "text": "That's fine. Any medical history?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 199.49,
      "end_seconds": 202.73,
      "duration_seconds": 3.24,
      "text": "Asthma, eczema, and hay fever."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.51,
      "end_seconds": 205.34,
      "duration_seconds": 1.83,
      "text": "Any operations?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 206.16,
      "end_seconds": 210.6,
      "duration_seconds": 4.44,
      "text": "She had grommets when she was four."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.13,
      "end_seconds": 215.83,
      "duration_seconds": 2.7,
      "text": "Anything in the family?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 217.79,
      "end_seconds": 223.76,
      "duration_seconds": 5.97,
      "text": "Her mum has migraines, and her dad has asthma too."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.25,
      "end_seconds": 229.16,
      "duration_seconds": 3.91,
      "text": "Which grade are you in, Chloe?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.91,
      "end_seconds": 231.47,
      "duration_seconds": 1.56,
      "text": "Year four."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.76,
      "end_seconds": 235.4,
      "duration_seconds": 2.64,
      "text": "Do you play sport?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.36,
      "end_seconds": 240.41,
      "duration_seconds": 3.05,
      "text": "Netball. And the trampoline."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.94,
      "end_seconds": 245.63,
      "duration_seconds": 2.69,
      "text": "And who's at home?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 247.16,
      "end_seconds": 255.76,
      "duration_seconds": 8.6,
      "text": "Her mum, dad, and her little brother. I just look after her after school."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.32,
      "end_seconds": 284.03,
      "duration_seconds": 11.71,
      "text": "Okay. Let me check your vitals, Chloe. Pulse 104, blood pressure 100 over 62, temperature 36.9, oxygen 99 percent, breathing 20, and weight 29 kilos."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 285.14,
      "end_seconds": 287.49,
      "duration_seconds": 2.35,
      "text": "All normal? ~"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.49,
      "end_seconds": 309.99,
      "duration_seconds": 11.5,
      "text": "All normal for her size. Chloe, I'm going to gently feel your arm, you tell me when it hurts."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.91,
      "end_seconds": 312.7,
      "duration_seconds": 1.79,
      "text": "There. ~"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.43,
      "end_seconds": 326.04,
      "duration_seconds": 10.61,
      "text": "There's swelling around the left wrist, and it's very tender over the end of the forearm bone."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.59,
      "end_seconds": 330.57,
      "duration_seconds": 1.98,
      "text": "Ow! ~"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.8,
      "end_seconds": 342.92,
      "duration_seconds": 10.12,
      "text": "Sorry, Chloe. I can feel her pulse at the wrist, and her fingers are pink and warm."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 344.03,
      "end_seconds": 346.89,
      "duration_seconds": 2.86,
      "text": "Good, that's good. ~"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.41,
      "end_seconds": 354.89,
      "duration_seconds": 6.48,
      "text": "Any problem with your breathing today, Chloe, with your asthma?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 356.7,
      "end_seconds": 358.71,
      "duration_seconds": 2.01,
      "text": "No, it's okay."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.62,
      "end_seconds": 364.72,
      "duration_seconds": 4.1,
      "text": "And any tummy ache or throwing up?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 367.14,
      "end_seconds": 369.02,
      "duration_seconds": 1.88,
      "text": "No. I'm fine."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.89,
      "end_seconds": 381.16,
      "duration_seconds": 9.27,
      "text": "I think this looks like a broken wrist. A fracture of the forearm bone, near the wrist."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 382.15,
      "end_seconds": 384.69,
      "duration_seconds": 2.54,
      "text": "Oh no. ~"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 385.52,
      "end_seconds": 400.46,
      "duration_seconds": 14.94,
      "text": "It's very common in children, it heals well. I'd like to arrange an X-ray of the wrist and forearm, and an X-ray of the elbow too, to be safe."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 402.4,
      "end_seconds": 405.12,
      "duration_seconds": 2.72,
      "text": "Will it hurt? ~"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 407.14,
      "end_seconds": 418.45,
      "duration_seconds": 11.31,
      "text": "Not at all, you just hold still. And I'd like to put her arm in a splint until then."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 419.87,
      "end_seconds": 421.34,
      "duration_seconds": 1.47,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 423.39,
      "end_seconds": 430.07,
      "duration_seconds": 6.68,
      "text": "And I'd like to arrange a fracture clinic appointment for the cast."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 432.69,
      "end_seconds": 436.02,
      "duration_seconds": 3.33,
      "text": "When would that be? ~"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 438.82,
      "end_seconds": 451.98,
      "duration_seconds": 13.16,
      "text": "The nurse will book it before you leave. If her fingers turn blue or numb, or the pain gets much worse, come back straight away."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 453.86,
      "end_seconds": 456.96,
      "duration_seconds": 3.1,
      "text": "I will. Thank you, doctor. ~"
    }
  ]
}
