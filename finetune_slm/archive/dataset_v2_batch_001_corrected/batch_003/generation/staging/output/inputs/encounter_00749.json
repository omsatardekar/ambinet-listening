{
  "schema_version": "1.0",
  "encounter_id": "00749",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 2.94,
      "end_seconds": 15.77,
      "duration_seconds": 12.83,
      "text": "Oh doctor, thank you for seeing us so fast. Kabir came off his bike an hour ago and he's holding his wrist and crying."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.12,
      "end_seconds": 26.66,
      "duration_seconds": 7.54,
      "text": "Hello Kabir. I'm Dr Rahman. Can you show me where it hurts? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.71,
      "end_seconds": 31.19,
      "duration_seconds": 1.48,
      "text": "Here."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.7,
      "end_seconds": 37.78,
      "duration_seconds": 3.08,
      "text": "Okay. How did you fall? ~"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.49,
      "end_seconds": 46.77,
      "duration_seconds": 6.28,
      "text": "The bike went over a bump, and I put my hand out. ~"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 50.56,
      "end_seconds": 58.36,
      "duration_seconds": 7.8,
      "text": "He landed on his outstretched hand, doctor. On the road, not the grass. ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.44,
      "end_seconds": 65.13,
      "duration_seconds": 3.69,
      "text": "Did you hit your head, Mum?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 69.02,
      "end_seconds": 77.97,
      "duration_seconds": 8.95,
      "text": "No, he had his helmet on, thank God. He didn't hit his head, no."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.72,
      "end_seconds": 86.63,
      "duration_seconds": 4.91,
      "text": "What's his age, and does he have any medicines?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 90.69,
      "end_seconds": 99.22,
      "duration_seconds": 8.53,
      "text": "He's nine. I gave him a spoon of paracetamol, 250 mg, when we got home, in case."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.32,
      "end_seconds": 107.17,
      "duration_seconds": 4.85,
      "text": "Good thinking. Any broken bones in the family?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 110.0,
      "end_seconds": 116.15,
      "duration_seconds": 6.15,
      "text": "His grandfather broke his wrist, years ago, but that's all."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.76,
      "end_seconds": 145.13,
      "duration_seconds": 11.37,
      "text": "Kabir, I'm going to touch your arm very gently, and I want you to tell me when it hurts."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.59,
      "end_seconds": 151.03,
      "duration_seconds": 2.44,
      "text": "Ow! Here! ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.42,
      "end_seconds": 169.32,
      "duration_seconds": 14.9,
      "text": "Thank you, you're very brave. Mum, the wrist is swollen and tender over the end of the forearm bone, and he doesn't want to turn his hand over. ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 172.85,
      "end_seconds": 175.94,
      "duration_seconds": 3.09,
      "text": "Is it broken? ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.58,
      "end_seconds": 190.34,
      "duration_seconds": 10.76,
      "text": "I can't rule out a fracture, which is common at this age, so I'd like an X-ray of the wrist and forearm now."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 194.2,
      "end_seconds": 196.52,
      "duration_seconds": 2.32,
      "text": "Now? Right. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.8,
      "end_seconds": 216.48,
      "duration_seconds": 16.68,
      "text": "The nurse will take you through. In the meantime, keep the arm still in this sling, and give him nothing to eat or drink in case he needs a procedure."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 220.35,
      "end_seconds": 223.79,
      "duration_seconds": 3.44,
      "text": "Okay. Kabir, be brave. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.68,
      "end_seconds": 231.86,
      "duration_seconds": 4.18,
      "text": "Will I need a cast? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.91,
      "end_seconds": 242.6,
      "duration_seconds": 7.69,
      "text": "If it's broken, maybe. A lot of children's breaks are small and heal quickly. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.07,
      "end_seconds": 249.61,
      "duration_seconds": 3.54,
      "text": "Can I choose the colour? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.76,
      "end_seconds": 254.08,
      "duration_seconds": 1.32,
      "text": "Absolutely. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 257.95,
      "end_seconds": 260.69,
      "duration_seconds": 2.74,
      "text": "Thank you, doctor. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.29,
      "end_seconds": 280.72,
      "duration_seconds": 16.43,
      "text": "I'll come and see you with the picture in a few minutes. If his fingers go blue, cold or numb in the meantime, call us at once."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 284.06,
      "end_seconds": 286.26,
      "duration_seconds": 2.2,
      "text": "I will. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.3,
      "end_seconds": 292.49,
      "duration_seconds": 2.19,
      "text": "Mummy, don't leave. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 295.79,
      "end_seconds": 298.38,
      "duration_seconds": 2.59,
      "text": "I'm here, beta. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.23,
      "end_seconds": 306.01,
      "duration_seconds": 3.78,
      "text": "Good boy. See you shortly. ~"
    }
  ]
}
