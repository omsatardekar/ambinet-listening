{
  "schema_version": "1.0",
  "encounter_id": "00596",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.8,
      "end_seconds": 7.68,
      "duration_seconds": 6.88,
      "text": "Come in, Mr Gallagher, come in. Terrible weather out there again, isn't it?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.49,
      "end_seconds": 11.67,
      "duration_seconds": 2.18,
      "text": "Wet, yeah. Soaking."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.43,
      "end_seconds": 21.33,
      "duration_seconds": 7.9,
      "text": "Did you manage to park all right? The car park's a nightmare on Thursdays."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.22,
      "end_seconds": 25.99,
      "duration_seconds": 2.77,
      "text": "Eventually. Went round three times."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.77,
      "end_seconds": 36.77,
      "duration_seconds": 10.0,
      "text": "Ah, you're not the only one. Sit down there, and take your coat off if it's wet."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 39.76,
      "end_seconds": 41.21,
      "duration_seconds": 1.45,
      "text": "I'm grand."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.0,
      "end_seconds": 56.3,
      "duration_seconds": 12.3,
      "text": "Well. It's been a good few weeks since you came out of hospital. How would you say things are going?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 59.08,
      "end_seconds": 60.99,
      "duration_seconds": 1.91,
      "text": "Not bad."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.99,
      "end_seconds": 68.89,
      "duration_seconds": 6.9,
      "text": "Not bad. Tell me a little more about that, if you can."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.32,
      "end_seconds": 81.59,
      "duration_seconds": 5.27,
      "text": "Walking more. The wife has me out every morning."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.17,
      "end_seconds": 88.12,
      "duration_seconds": 4.95,
      "text": "Good for her. How far are you getting?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 90.13,
      "end_seconds": 95.7,
      "duration_seconds": 5.57,
      "text": "Down to the shop and back. About a mile, maybe."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.52,
      "end_seconds": 104.93,
      "duration_seconds": 8.41,
      "text": "That's great. And when you're out on that walk, have you had any chest pain at all?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 106.37,
      "end_seconds": 108.44,
      "duration_seconds": 2.07,
      "text": "No. None."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.49,
      "end_seconds": 116.74,
      "duration_seconds": 7.25,
      "text": "What about getting short of breath, going up the hill or the stairs?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.91,
      "end_seconds": 121.26,
      "duration_seconds": 2.35,
      "text": "No, I'm not."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.96,
      "end_seconds": 127.14,
      "duration_seconds": 4.18,
      "text": "Any swelling around your ankles in the evenings?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.68,
      "end_seconds": 137.5,
      "duration_seconds": 2.82,
      "text": "No. Feet are fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.36,
      "end_seconds": 147.43,
      "duration_seconds": 9.07,
      "text": "Lovely. Now let's look at your tablets. Remind me what you're on at the moment."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.82,
      "end_seconds": 153.17,
      "duration_seconds": 4.35,
      "text": "The aspirin. And the cholesterol one."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.13,
      "end_seconds": 160.63,
      "duration_seconds": 5.5,
      "text": "The aspirin, is that the 75 mg, once a day?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.28,
      "end_seconds": 165.27,
      "duration_seconds": 1.99,
      "text": "Yeah. With breakfast."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.87,
      "end_seconds": 173.31,
      "duration_seconds": 5.44,
      "text": "And the cholesterol tablet, the atorvastatin. Is that 40 mg?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.31,
      "end_seconds": 179.32,
      "duration_seconds": 4.01,
      "text": "That's it. At night, before bed."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.43,
      "end_seconds": 187.25,
      "duration_seconds": 5.82,
      "text": "Good. How are you getting on with them, day to day?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 196.71,
      "end_seconds": 199.4,
      "duration_seconds": 2.69,
      "text": "Fine. Same as ever."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.67,
      "end_seconds": 208.25,
      "duration_seconds": 7.58,
      "text": "Do you ever forget a dose, or run short before the repeat comes?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 209.76,
      "end_seconds": 214.79,
      "duration_seconds": 5.03,
      "text": "The wife sets them out for me. In a box."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.25,
      "end_seconds": 224.21,
      "duration_seconds": 6.96,
      "text": "Sensible woman. Keep doing that. Anything you were worried about coming in today?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 227.18,
      "end_seconds": 234.08,
      "duration_seconds": 6.9,
      "text": "Just the one thing. Can I go back to the golf?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.31,
      "end_seconds": 247.25,
      "duration_seconds": 10.94,
      "text": "I'd say yes, in stages. Start with the driving range and a short nine, before you try a full round."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 248.62,
      "end_seconds": 253.67,
      "duration_seconds": 5.05,
      "text": "Right. She'll like that, she says I'm under her feet."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.97,
      "end_seconds": 263.65,
      "duration_seconds": 8.68,
      "text": "Ha. And I should ask, you used to smoke, didn't you? Where are we with that?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 265.49,
      "end_seconds": 269.33,
      "duration_seconds": 3.84,
      "text": "Gave up smoking. Twelve years ago now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.76,
      "end_seconds": 282.73,
      "duration_seconds": 10.97,
      "text": "Well done. Keep it that way. And you've still got the high blood pressure on your record, from years back."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 285.55,
      "end_seconds": 290.67,
      "duration_seconds": 5.12,
      "text": "I do, yeah. They keep an eye on it."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.1,
      "end_seconds": 301.45,
      "duration_seconds": 8.35,
      "text": "Good. Pop up on the couch there and I'll have a listen to your chest."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 306.3,
      "end_seconds": 307.56,
      "duration_seconds": 1.26,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 324.37,
      "end_seconds": 331.83,
      "duration_seconds": 7.46,
      "text": "Breathe in and out through your mouth for me. In... and out. Again."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 332.89,
      "end_seconds": 338.79,
      "duration_seconds": 5.9,
      "text": "Your chest is clear, both sides. Nothing to worry about there."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 340.01,
      "end_seconds": 341.25,
      "duration_seconds": 1.24,
      "text": "Good."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 343.56,
      "end_seconds": 353.71,
      "duration_seconds": 10.15,
      "text": "You can sit up. I won't lie, you look a different man from the one I saw in the ward."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 355.85,
      "end_seconds": 358.05,
      "duration_seconds": 2.2,
      "text": "Feel it too."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 360.69,
      "end_seconds": 372.77,
      "duration_seconds": 12.08,
      "text": "So, from what I can see today, you're recovering well. That's what I'd call it, a steady recovery, on track."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 374.29,
      "end_seconds": 376.19,
      "duration_seconds": 1.9,
      "text": "Good to hear."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 379.01,
      "end_seconds": 393.59,
      "duration_seconds": 14.58,
      "text": "I'd like to arrange a blood test for your cholesterol, to check the tablet's doing its job. The nurse at the desk will book it."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 399.83,
      "end_seconds": 401.04,
      "duration_seconds": 1.21,
      "text": "Fasting?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 403.95,
      "end_seconds": 410.21,
      "duration_seconds": 6.26,
      "text": "No need to fast for this one. Any time of day suits."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 412.81,
      "end_seconds": 413.95,
      "duration_seconds": 1.14,
      "text": "Grand."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 415.15,
      "end_seconds": 426.66,
      "duration_seconds": 11.51,
      "text": "And I'd like to see you again in six weeks, to go through the result and see how the walking is going."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 428.68,
      "end_seconds": 430.71,
      "duration_seconds": 2.03,
      "text": "Six weeks. Right."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 432.03,
      "end_seconds": 440.49,
      "duration_seconds": 8.46,
      "text": "Keep the walking up, and build it slowly. Don't push to the point of being wrecked."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 443.11,
      "end_seconds": 447.81,
      "duration_seconds": 4.7,
      "text": "I won't. The wife will see to that."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 449.84,
      "end_seconds": 456.69,
      "duration_seconds": 6.85,
      "text": "I'm sure she will. Is there anything you'd like to ask me?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 466.13,
      "end_seconds": 467.66,
      "duration_seconds": 1.53,
      "text": "Not really."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 469.76,
      "end_seconds": 477.04,
      "duration_seconds": 7.28,
      "text": "Nothing at all? Take your time, there's no rush on us."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 479.69,
      "end_seconds": 484.99,
      "duration_seconds": 5.3,
      "text": "The car park. Is there a cheaper one?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 487.46,
      "end_seconds": 496.16,
      "duration_seconds": 8.7,
      "text": "The one behind the chemist is free after six, but that's no use at this hour. Sorry."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 497.33,
      "end_seconds": 499.43,
      "duration_seconds": 2.1,
      "text": "Sure, I'll live."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 500.79,
      "end_seconds": 507.42,
      "duration_seconds": 6.63,
      "text": "Then mind yourself out there, Mr Gallagher. Say hello to herself for me."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 509.99,
      "end_seconds": 512.84,
      "duration_seconds": 2.85,
      "text": "I will. Thanks, doctor."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 513.94,
      "end_seconds": 519.8,
      "duration_seconds": 5.86,
      "text": "Take care now. Mind the wet floor in the corridor."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 522.74,
      "end_seconds": 524.37,
      "duration_seconds": 1.63,
      "text": "Will do."
    }
  ]
}
