{
  "schema_version": "1.0",
  "encounter_id": "00946",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.6,
      "end_seconds": 16.3,
      "duration_seconds": 15.7,
      "text": "Sorry, sorry, doctor, I'm late, I went to the wrong clinic, the eye one, I got halfway through the door before the receptionist stopped me. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.1,
      "end_seconds": 23.8,
      "duration_seconds": 6.7,
      "text": "No harm done, Mr Bhatt. Come in. What's the problem? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.3,
      "end_seconds": 38.39,
      "duration_seconds": 13.09,
      "text": "My thumbs. The base of both thumbs, they've been paining me. Pain at the base of the thumbs, when I grip things."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.31,
      "end_seconds": 43.21,
      "duration_seconds": 1.9,
      "text": "How long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.2,
      "end_seconds": 56.88,
      "duration_seconds": 10.68,
      "text": "Oh, I don't know. It was before Diwali. Or after? Last year? I really can't say when it started."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 59.46,
      "end_seconds": 66.87,
      "duration_seconds": 7.41,
      "text": "Doctor, I've got the splint trolley ready, whenever you want it. ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.66,
      "end_seconds": 78.31,
      "duration_seconds": 8.65,
      "text": "Thank you, Anita, in a minute. Mr Bhatt, what does it stop you doing? ~"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.02,
      "end_seconds": 91.87,
      "duration_seconds": 10.85,
      "text": "Opening jars. Turning keys. I was a tailor for forty years, so the thumbs were my life."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.89,
      "end_seconds": 98.34,
      "duration_seconds": 4.45,
      "text": "Any numbness or tingling in the fingers?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.59,
      "end_seconds": 103.28,
      "duration_seconds": 2.69,
      "text": "No numbness. No tingling."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.87,
      "end_seconds": 109.66,
      "duration_seconds": 3.79,
      "text": "Any allergies, to medicines or anything else?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.4,
      "end_seconds": 126.25,
      "duration_seconds": 15.85,
      "text": "Hm. I think I came out in a rash once, around my eyelids, after some eye drops. But I don't remember which ones. And I'm not sure it was an allergy."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.87,
      "end_seconds": 149.24,
      "duration_seconds": 10.37,
      "text": "I'll note it as a possible, unconfirmed reaction. Let me take two numbers. Pulse 74, blood pressure 136 over 84."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.47,
      "end_seconds": 153.17,
      "duration_seconds": 2.7,
      "text": "Is that fine? ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.49,
      "end_seconds": 171.5,
      "duration_seconds": 8.01,
      "text": "That's fine. Now I'd like to look at your hands. Put them flat on the table."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.47,
      "end_seconds": 174.32,
      "duration_seconds": 1.85,
      "text": "Like this? ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.06,
      "end_seconds": 179.8,
      "duration_seconds": 4.74,
      "text": "Now press your thumb against your fingertip. ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.85,
      "end_seconds": 183.01,
      "duration_seconds": 2.16,
      "text": "Ow! There. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.62,
      "end_seconds": 196.55,
      "duration_seconds": 10.93,
      "text": "I can see a bony swelling at the base of the right thumb, and it's tender when I press."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.02,
      "end_seconds": 202.14,
      "duration_seconds": 4.12,
      "text": "Both are like that, doctor. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.93,
      "end_seconds": 208.54,
      "duration_seconds": 5.61,
      "text": "I can see the left is a little less swollen. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.16,
      "end_seconds": 214.05,
      "duration_seconds": 2.89,
      "text": "Maybe it's the sewing. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.88,
      "end_seconds": 221.7,
      "duration_seconds": 5.82,
      "text": "Forty years of fine work will do that. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 223.57,
      "end_seconds": 228.63,
      "duration_seconds": 5.06,
      "text": "Shall I bring the splint, doctor? ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.26,
      "end_seconds": 238.51,
      "duration_seconds": 7.25,
      "text": "Yes, please, Anita. For the night, Mr Bhatt, a thumb splint can rest the joint."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.21,
      "end_seconds": 242.61,
      "duration_seconds": 2.4,
      "text": "Will it hurt? ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 244.72,
      "end_seconds": 252.59,
      "duration_seconds": 7.87,
      "text": "It's a soft one, Mr Bhatt, with velcro. Here, try it on. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.06,
      "end_seconds": 257.56,
      "duration_seconds": 2.5,
      "text": "It's very snug. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.58,
      "end_seconds": 271.13,
      "duration_seconds": 12.55,
      "text": "Good. Wear it at night and for heavy jobs. Soak your hands in warm water in the morning before you start."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.98,
      "end_seconds": 276.49,
      "duration_seconds": 2.51,
      "text": "In the sink? ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.66,
      "end_seconds": 291.06,
      "duration_seconds": 13.4,
      "text": "Yes, a basin of warm water, five minutes. And use the large-handled tools at home, they take the strain off the thumb."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.67,
      "end_seconds": 298.55,
      "duration_seconds": 5.88,
      "text": "My wife bought a jar opener last week. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.49,
      "end_seconds": 302.25,
      "duration_seconds": 2.76,
      "text": "Perfect. Use it. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.01,
      "end_seconds": 305.43,
      "duration_seconds": 2.42,
      "text": "Okay, doctor. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.39,
      "end_seconds": 312.62,
      "duration_seconds": 4.23,
      "text": "Keep an eye on the pain. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.8,
      "end_seconds": 315.68,
      "duration_seconds": 1.88,
      "text": "I will. ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 317.29,
      "end_seconds": 324.33,
      "duration_seconds": 7.04,
      "text": "I'll show you how to take the splint off, Mr Bhatt. ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.06,
      "end_seconds": 328.73,
      "duration_seconds": 3.67,
      "text": "Thank you, Anita. Thank you, doctor. ~"
    }
  ]
}
