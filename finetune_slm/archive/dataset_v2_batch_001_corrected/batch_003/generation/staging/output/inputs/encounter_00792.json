{
  "schema_version": "1.0",
  "encounter_id": "00792",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 1.02,
      "end_seconds": 17.01,
      "duration_seconds": 15.99,
      "text": "Dr Hale, this is Mrs Banks. I've done her obs. Blood pressure 124 over 78, pulse 80, temperature 36.7, oxygen 98 percent, breathing 16, weight 69 kilos. She's got food sticking in her chest."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.62,
      "end_seconds": 25.66,
      "duration_seconds": 6.04,
      "text": "Thank you, nurse. Come in, Mrs Banks. Sit down. Sticking where, exactly?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.68,
      "end_seconds": 43.36,
      "duration_seconds": 16.68,
      "text": "Oh, hello, dear. Here, behind the breastbone, it's like a lump of bread that won't go down. My sister had it, you see, well, no, she had something else, and I do hope this isn't the same."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.44,
      "end_seconds": 50.11,
      "duration_seconds": 4.67,
      "text": "How long have you had the food sticking?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.84,
      "end_seconds": 62.66,
      "duration_seconds": 10.82,
      "text": "Three months, give or take. It's worse with meat, and with the dry toast, oh, I do love toast."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.2,
      "end_seconds": 67.57,
      "duration_seconds": 2.37,
      "text": "Do you get heartburn?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.09,
      "end_seconds": 76.77,
      "duration_seconds": 6.68,
      "text": "Terrible heartburn. Years of it, but it's worse now at night."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.24,
      "end_seconds": 80.56,
      "duration_seconds": 2.32,
      "text": "Any burping, belching?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.27,
      "end_seconds": 86.13,
      "duration_seconds": 3.86,
      "text": "All the time, I'm so embarrassed."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.46,
      "end_seconds": 89.89,
      "duration_seconds": 2.43,
      "text": "Do you vomit blood?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.88,
      "end_seconds": 93.92,
      "duration_seconds": 2.04,
      "text": "No, no blood."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.53,
      "end_seconds": 98.97,
      "duration_seconds": 2.44,
      "text": "Have you lost weight?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.76,
      "end_seconds": 103.83,
      "duration_seconds": 4.07,
      "text": "No, if anything I've put it on."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.76,
      "end_seconds": 106.49,
      "duration_seconds": 1.73,
      "text": "Black stools?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.02,
      "end_seconds": 110.29,
      "duration_seconds": 2.27,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.05,
      "end_seconds": 116.35,
      "duration_seconds": 3.3,
      "text": "Is swallowing painful, or only stuck?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.68,
      "end_seconds": 120.88,
      "duration_seconds": 3.2,
      "text": "Not painful, no. Just stuck."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.81,
      "end_seconds": 125.14,
      "duration_seconds": 3.33,
      "text": "Allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.25,
      "end_seconds": 132.15,
      "duration_seconds": 5.9,
      "text": "Shellfish. My lips swell up. I've learned to be careful."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.97,
      "end_seconds": 137.39,
      "duration_seconds": 2.42,
      "text": "Good. And your history?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.3,
      "end_seconds": 146.64,
      "duration_seconds": 7.34,
      "text": "The reflux, mild asthma, and I was anaemic a few years ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.67,
      "end_seconds": 149.82,
      "duration_seconds": 1.15,
      "text": "Operations?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.84,
      "end_seconds": 154.74,
      "duration_seconds": 2.9,
      "text": "Appendix, as a girl."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.83,
      "end_seconds": 160.06,
      "duration_seconds": 4.23,
      "text": "Stomach or gullet problems in the family?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.55,
      "end_seconds": 170.61,
      "duration_seconds": 8.06,
      "text": "My mother had cancer of the gullet, poor soul. And my sister has coeliac disease."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.16,
      "end_seconds": 175.07,
      "duration_seconds": 1.91,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.76,
      "end_seconds": 181.53,
      "duration_seconds": 3.77,
      "text": "Ten a day, I'm afraid."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.36,
      "end_seconds": 186.13,
      "duration_seconds": 1.77,
      "text": "And drink?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.61,
      "end_seconds": 192.45,
      "duration_seconds": 4.84,
      "text": "A glass of wine most nights. Maybe two."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.18,
      "end_seconds": 213.84,
      "duration_seconds": 8.66,
      "text": "Let me look at you. Lie back. I'm pressing your tummy, tell me if it's sore."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.02,
      "end_seconds": 217.42,
      "duration_seconds": 2.4,
      "text": "Not at all. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.12,
      "end_seconds": 229.72,
      "duration_seconds": 9.6,
      "text": "The abdomen is soft and not tender, and I can't feel any lumps in your neck."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.21,
      "end_seconds": 235.24,
      "duration_seconds": 3.03,
      "text": "Is that good? ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.16,
      "end_seconds": 240.81,
      "duration_seconds": 4.65,
      "text": "Any trouble with your breathing, with your asthma?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.68,
      "end_seconds": 245.84,
      "duration_seconds": 3.16,
      "text": "No, nothing, it's been quiet."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.83,
      "end_seconds": 253.45,
      "duration_seconds": 5.62,
      "text": "Any chest pain on exertion, apart from the sticking?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.16,
      "end_seconds": 259.29,
      "duration_seconds": 3.13,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.25,
      "end_seconds": 278.45,
      "duration_seconds": 16.2,
      "text": "With years of reflux and food catching, I think it's the acid irritating the gullet, but I can't rule out a narrowing, and with your mother's history I want to look."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.34,
      "end_seconds": 284.87,
      "duration_seconds": 3.53,
      "text": "Oh dear. Is it cancer? ~"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.54,
      "end_seconds": 295.45,
      "duration_seconds": 8.91,
      "text": "I don't think so, but I'd like to arrange a camera test of the gullet, a gastroscopy."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.28,
      "end_seconds": 299.79,
      "duration_seconds": 3.51,
      "text": "Will I be asleep? ~"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.72,
      "end_seconds": 310.63,
      "duration_seconds": 8.91,
      "text": "Sedated, yes. I'd also like to do blood tests for anaemia, and a barium swallow."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.93,
      "end_seconds": 316.33,
      "duration_seconds": 3.4,
      "text": "Anything for the heartburn meanwhile? ~"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.96,
      "end_seconds": 322.77,
      "duration_seconds": 4.81,
      "text": "Yes, let's start omeprazole 40 mg once a day."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 323.47,
      "end_seconds": 329.3,
      "duration_seconds": 5.83,
      "text": "I'll print the instructions for the camera test. ~"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.53,
      "end_seconds": 338.78,
      "duration_seconds": 8.25,
      "text": "Thank you. I'd like to see you again in six weeks, after the tests."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.81,
      "end_seconds": 343.5,
      "duration_seconds": 3.69,
      "text": "Six weeks. Thank you, dears. ~"
    }
  ]
}
