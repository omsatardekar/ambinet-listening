{
  "schema_version": "1.0",
  "encounter_id": "00900",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.75,
      "end_seconds": 10.27,
      "duration_seconds": 9.52,
      "text": "Hello, doctor. I've noticed a new mole on my shoulder, and my husband insisted I get it looked at."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.63,
      "end_seconds": 25.29,
      "duration_seconds": 12.66,
      "text": "I'm the husband. I spotted it in the summer when she was in her swimsuit. It looked different from her other moles."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.35,
      "end_seconds": 32.09,
      "duration_seconds": 4.74,
      "text": "Thank you both for coming. Where exactly is it?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.23,
      "end_seconds": 44.74,
      "duration_seconds": 10.51,
      "text": "On the back of my left shoulder. I can't see it, so I only know what he says."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.98,
      "end_seconds": 53.3,
      "duration_seconds": 7.32,
      "text": "Has it changed in size or colour, according to your husband?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 54.43,
      "end_seconds": 60.4,
      "duration_seconds": 5.97,
      "text": "It's gotten bigger, I think, and darker at one edge."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.69,
      "end_seconds": 69.81,
      "duration_seconds": 8.12,
      "text": "It does sometimes itch a little, and once it bled when I scratched it."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.0,
      "end_seconds": 74.57,
      "duration_seconds": 3.57,
      "text": "Any other moles that have changed?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.8,
      "end_seconds": 81.77,
      "duration_seconds": 4.97,
      "text": "No, the rest are the same as always."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.18,
      "end_seconds": 91.43,
      "duration_seconds": 7.25,
      "text": "Have you had skin cancer, or does it run in the family? ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.28,
      "end_seconds": 99.45,
      "duration_seconds": 6.17,
      "text": "Neither. My mother had lots of moles, but never cancer. ~"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.69,
      "end_seconds": 105.36,
      "duration_seconds": 3.67,
      "text": "Any blistering sunburn in the past? ~"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.07,
      "end_seconds": 115.84,
      "duration_seconds": 8.77,
      "text": "As a child, in the south of France. We've avoided the sun a lot more since."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.56,
      "end_seconds": 121.88,
      "duration_seconds": 4.32,
      "text": "What medicines are you taking, if any?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.18,
      "end_seconds": 129.62,
      "duration_seconds": 6.44,
      "text": "A multivitamin, a thyroid tablet, levothyroxine, 50 micrograms, and the contraceptive pill."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.28,
      "end_seconds": 135.13,
      "duration_seconds": 3.85,
      "text": "Any allergies to medicines or plasters?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.2,
      "end_seconds": 148.76,
      "duration_seconds": 10.56,
      "text": "Penicillin, when I was a baby, my mother told me I had a rash. I've avoided it since."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.86,
      "end_seconds": 154.2,
      "duration_seconds": 2.34,
      "text": "Noted. Any other conditions?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.82,
      "end_seconds": 159.22,
      "duration_seconds": 2.4,
      "text": "Underactive thyroid. That's all."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 161.68,
      "end_seconds": 169.06,
      "duration_seconds": 7.38,
      "text": "Doctor, I've taken her pulse and pressure, and weight, they're on the screen. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.72,
      "end_seconds": 180.71,
      "duration_seconds": 8.99,
      "text": "Thank you. Pulse 72, blood pressure 118 over 74, weight 66 kilograms, I see. Perfect."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.94,
      "end_seconds": 185.3,
      "duration_seconds": 3.36,
      "text": "Is it all right? ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.11,
      "end_seconds": 196.49,
      "duration_seconds": 8.38,
      "text": "Yes. Now let me look at the mole with the dermatoscope. Please turn around. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.86,
      "end_seconds": 215.53,
      "duration_seconds": 1.67,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.93,
      "end_seconds": 226.57,
      "duration_seconds": 9.64,
      "text": "It's an irregular brown mole, about seven millimetres, with an uneven edge and two shades of colour."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 229.68,
      "end_seconds": 232.32,
      "duration_seconds": 2.64,
      "text": "Is it dangerous? ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.67,
      "end_seconds": 244.17,
      "duration_seconds": 10.5,
      "text": "I can't say from looking, and I don't like the irregular edge and the change that you describe."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.38,
      "end_seconds": 250.45,
      "duration_seconds": 3.07,
      "text": "What should we do? ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.27,
      "end_seconds": 263.13,
      "duration_seconds": 9.86,
      "text": "I'd like to remove the whole mole under local anaesthetic, and send it to the laboratory."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.51,
      "end_seconds": 267.37,
      "duration_seconds": 1.86,
      "text": "When? ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.48,
      "end_seconds": 284.41,
      "duration_seconds": 14.93,
      "text": "My colleague will book you for two weeks' time. You'll have a small scar, and the stitches come out after a week or so."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 286.1,
      "end_seconds": 289.3,
      "duration_seconds": 3.2,
      "text": "We'll be there. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.4,
      "end_seconds": 299.73,
      "duration_seconds": 7.33,
      "text": "Keep the area covered from the sun until then, and don't scratch it."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.93,
      "end_seconds": 306.0,
      "duration_seconds": 4.07,
      "text": "I won't. Thank you, doctor. ~"
    }
  ]
}
