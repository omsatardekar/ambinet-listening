{
  "schema_version": "1.0",
  "encounter_id": "00964",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 0.55,
      "end_seconds": 10.0,
      "duration_seconds": 9.45,
      "text": "Good afternoon. Before we start, how would you prefer to be addressed, Mr Simmons, or Arthur? ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.62,
      "end_seconds": 22.07,
      "duration_seconds": 9.45,
      "text": "Mr Simmons will do nicely, thank you, doctor. I've brought my daughter and my carer. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 23.15,
      "end_seconds": 36.17,
      "duration_seconds": 13.02,
      "text": "I'm Diane, his daughter. And this is Rosa, who's with him in the daytime. He's been having terrible headaches since he started the new spray."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.22,
      "end_seconds": 43.36,
      "duration_seconds": 5.14,
      "text": "Thank you both. Mr Simmons, tell me about the headaches."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.34,
      "end_seconds": 58.08,
      "duration_seconds": 11.74,
      "text": "They come within minutes of using it. A pounding across my forehead. It's been about two weeks, since the spray was started."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "CAREGIVER",
      "start_seconds": 60.72,
      "end_seconds": 67.51,
      "duration_seconds": 6.79,
      "text": "He grips his head, doctor, and has to sit down for twenty minutes."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.89,
      "end_seconds": 74.79,
      "duration_seconds": 4.9,
      "text": "Do you feel anything else when you use it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.33,
      "end_seconds": 82.86,
      "duration_seconds": 5.53,
      "text": "A flushed face. Very warm. I go quite red."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "CAREGIVER",
      "start_seconds": 85.85,
      "end_seconds": 91.57,
      "duration_seconds": 5.72,
      "text": "I've seen it, he looks like a lobster. ~"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.76,
      "end_seconds": 95.27,
      "duration_seconds": 1.51,
      "text": "And dizziness?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.92,
      "end_seconds": 102.96,
      "duration_seconds": 5.04,
      "text": "A touch, when I stand after the spray."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.75,
      "end_seconds": 107.06,
      "duration_seconds": 3.31,
      "text": "Which spray is it, Diane?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 109.28,
      "end_seconds": 116.71,
      "duration_seconds": 7.43,
      "text": "The nitroglycerin spray, 0.4 mg, under the tongue, when he gets chest tightness."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.6,
      "end_seconds": 123.52,
      "duration_seconds": 3.92,
      "text": "And what else does he take?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 125.98,
      "end_seconds": 129.87,
      "duration_seconds": 3.89,
      "text": "An aspirin, 81 mg, every morning."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.92,
      "end_seconds": 133.78,
      "duration_seconds": 2.86,
      "text": "Any allergies, Mr Simmons?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.63,
      "end_seconds": 139.72,
      "duration_seconds": 4.09,
      "text": "Sulfa drugs. I came out in a rash."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.78,
      "end_seconds": 145.95,
      "duration_seconds": 4.17,
      "text": "Thank you. And your medical history?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.42,
      "end_seconds": 152.76,
      "duration_seconds": 4.34,
      "text": "Angina, high blood pressure, and gout."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.6,
      "end_seconds": 157.79,
      "duration_seconds": 3.19,
      "text": "Who do you live with?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.06,
      "end_seconds": 164.03,
      "duration_seconds": 3.97,
      "text": "I live with Diane and her husband."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.96,
      "end_seconds": 183.46,
      "duration_seconds": 6.5,
      "text": "Let me check you. Blood pressure 132 over 78, pulse 70."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 185.04,
      "end_seconds": 188.0,
      "duration_seconds": 2.96,
      "text": "Is that normal? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.49,
      "end_seconds": 205.98,
      "duration_seconds": 7.49,
      "text": "Good for his age. Mr Simmons, can you bend your chin to your chest?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.53,
      "end_seconds": 211.02,
      "duration_seconds": 2.49,
      "text": "Like this? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.91,
      "end_seconds": 215.99,
      "duration_seconds": 4.08,
      "text": "Your neck moves freely, with no stiffness."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.42,
      "end_seconds": 220.7,
      "duration_seconds": 3.28,
      "text": "I'm quite supple, you know. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.49,
      "end_seconds": 226.91,
      "duration_seconds": 5.42,
      "text": "And follow my finger. Your pupils are equal and react normally."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.96,
      "end_seconds": 230.64,
      "duration_seconds": 1.68,
      "text": "Good. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.31,
      "end_seconds": 237.5,
      "duration_seconds": 4.19,
      "text": "Any weakness, numbness or trouble speaking?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.28,
      "end_seconds": 246.71,
      "duration_seconds": 8.43,
      "text": "Not at all, my speech is fine, and my arms and legs are normal."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.03,
      "end_seconds": 262.23,
      "duration_seconds": 14.2,
      "text": "Here is my thinking. Headaches and flushing within minutes of a nitrate spray is a well-known side effect. I think the headache is a side effect of the spray."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 264.76,
      "end_seconds": 269.06,
      "duration_seconds": 4.3,
      "text": "Does he have to stop it? ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.19,
      "end_seconds": 284.94,
      "duration_seconds": 14.75,
      "text": "Not without a plan. Chest tightness needs a medicine to treat it. I'd like to arrange an ECG to look at your heart today."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.83,
      "end_seconds": 288.85,
      "duration_seconds": 2.02,
      "text": "Today? ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.42,
      "end_seconds": 304.91,
      "duration_seconds": 14.49,
      "text": "Yes, it takes five minutes. And I'd like to fit a 24-hour blood pressure monitor, to see what happens to your pressure around the spray."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "CAREGIVER",
      "start_seconds": 306.5,
      "end_seconds": 310.17,
      "duration_seconds": 3.67,
      "text": "I'll bring him to the nurse. ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.42,
      "end_seconds": 319.89,
      "duration_seconds": 7.47,
      "text": "In the meantime, sit down before you use the spray, and have a sip of water."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.56,
      "end_seconds": 324.68,
      "duration_seconds": 2.12,
      "text": "Very sensible. ~"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.19,
      "end_seconds": 335.52,
      "duration_seconds": 9.33,
      "text": "If the headaches don't settle in two weeks, come back and we'll look at the options."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 337.89,
      "end_seconds": 342.12,
      "duration_seconds": 4.23,
      "text": "Two weeks. We'll book it. ~"
    }
  ]
}
