{
  "schema_version": "1.0",
  "encounter_id": "00740",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.65,
      "end_seconds": 8.77,
      "duration_seconds": 8.12,
      "text": "Hi. My mum said I had to come. I don't want to be here. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.53,
      "end_seconds": 18.87,
      "duration_seconds": 8.34,
      "text": "Thanks for coming anyway, that took some guts. What did she say was going on? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.11,
      "end_seconds": 28.72,
      "duration_seconds": 8.61,
      "text": "That I won't go to school. But it's not that I won't, I can't."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.1,
      "end_seconds": 35.06,
      "duration_seconds": 3.96,
      "text": "Tell me what happens when you try."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.03,
      "end_seconds": 47.38,
      "duration_seconds": 11.35,
      "text": "My heart goes crazy, my stomach drops, and I feel sick. Sometimes I can't breathe properly, and I sit on the stairs and cry."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.98,
      "end_seconds": 54.32,
      "duration_seconds": 4.34,
      "text": "Which part of school is hardest? ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.33,
      "end_seconds": 63.85,
      "duration_seconds": 8.52,
      "text": "The classroom, being looked at. Presentations. And lunch, where there's nobody I know. ~"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.34,
      "end_seconds": 69.31,
      "duration_seconds": 3.97,
      "text": "How long has this been going on?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.65,
      "end_seconds": 76.28,
      "duration_seconds": 4.63,
      "text": "Since September. I've missed about six weeks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.98,
      "end_seconds": 82.68,
      "duration_seconds": 3.7,
      "text": "Are you sleeping all right? ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.72,
      "end_seconds": 90.43,
      "duration_seconds": 5.71,
      "text": "Not great. My mind goes round at night. ~"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.94,
      "end_seconds": 99.89,
      "duration_seconds": 6.95,
      "text": "Do you ever have thoughts of harming yourself, or not wanting to be here?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.64,
      "end_seconds": 105.36,
      "duration_seconds": 4.72,
      "text": "No. No, nothing like that. I'm just scared."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.18,
      "end_seconds": 114.17,
      "duration_seconds": 6.99,
      "text": "Thank you for telling me. Do you take any medicines at the moment?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.0,
      "end_seconds": 130.19,
      "duration_seconds": 14.19,
      "text": "Propranolol, 10 mg, when I'm really bad. My doctor in Delhi gave me them, and I only take them when I need to."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.23,
      "end_seconds": 134.33,
      "duration_seconds": 3.1,
      "text": "Any allergies to medicines, to anything?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.47,
      "end_seconds": 137.87,
      "duration_seconds": 1.4,
      "text": "No, nothing."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.26,
      "end_seconds": 144.84,
      "duration_seconds": 5.58,
      "text": "Is there anyone in the family who has anxiety?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.22,
      "end_seconds": 154.09,
      "duration_seconds": 7.87,
      "text": "My mum does. She has panic attacks. She says it runs in the family."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.06,
      "end_seconds": 161.91,
      "duration_seconds": 5.85,
      "text": "Who do you live with, and what year are you in?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.45,
      "end_seconds": 168.98,
      "duration_seconds": 5.53,
      "text": "Mum, dad and my little sister. I'm in Year 10."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.63,
      "end_seconds": 175.93,
      "duration_seconds": 5.3,
      "text": "And what do you do in your free time?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.48,
      "end_seconds": 183.93,
      "duration_seconds": 6.45,
      "text": "Games, mostly. Four, five hours a day. I don't go out much."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.83,
      "end_seconds": 194.07,
      "duration_seconds": 8.24,
      "text": "Okay. Did you fill in the questionnaire the receptionist gave you, about how you've been feeling?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.7,
      "end_seconds": 201.78,
      "duration_seconds": 5.08,
      "text": "Yeah, I already did it in the waiting room."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.41,
      "end_seconds": 213.98,
      "duration_seconds": 9.57,
      "text": "I've read it. Your score shows a moderate level of anxiety, which fits what you've told me. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.07,
      "end_seconds": 217.66,
      "duration_seconds": 2.59,
      "text": "I knew it. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.63,
      "end_seconds": 233.5,
      "duration_seconds": 12.87,
      "text": "This is very common in teenagers and it's treatable. Avoiding school makes it worse in the long run, so we want to get you back gradually. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.16,
      "end_seconds": 237.04,
      "duration_seconds": 1.88,
      "text": "I can't. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.19,
      "end_seconds": 250.68,
      "duration_seconds": 12.49,
      "text": "Not all at once. We'd start small, with an agreed plan with your school, one lesson, a quiet room, a person you can go to."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.33,
      "end_seconds": 254.74,
      "duration_seconds": 1.41,
      "text": "Maybe. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.69,
      "end_seconds": 268.12,
      "duration_seconds": 10.43,
      "text": "I'd also like to arrange a blood test, to rule out any physical cause for the racing heart, like your thyroid."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.87,
      "end_seconds": 273.16,
      "duration_seconds": 4.29,
      "text": "Fine. I don't like needles. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.67,
      "end_seconds": 280.25,
      "duration_seconds": 4.58,
      "text": "I know. We can use numbing cream. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.55,
      "end_seconds": 283.03,
      "duration_seconds": 1.48,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.28,
      "end_seconds": 297.94,
      "duration_seconds": 12.66,
      "text": "And I'd like to refer you to the young people's mental health service for talking therapy, which works really well for this."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.37,
      "end_seconds": 304.76,
      "duration_seconds": 5.39,
      "text": "Do I have to talk to a stranger? ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.95,
      "end_seconds": 313.31,
      "duration_seconds": 6.36,
      "text": "Yes, but they're kind, and they've seen hundreds of people like you. ~"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.75,
      "end_seconds": 316.15,
      "duration_seconds": 1.4,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.32,
      "end_seconds": 331.39,
      "duration_seconds": 13.07,
      "text": "I'd like to see you again in two weeks, to see how you're getting on, and you can bring your mum if you want to."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.5,
      "end_seconds": 334.61,
      "duration_seconds": 2.11,
      "text": "Alright. ~"
    }
  ]
}
