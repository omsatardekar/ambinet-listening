{
  "schema_version": "1.0",
  "encounter_id": "00909",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 2.54,
      "end_seconds": 15.76,
      "duration_seconds": 13.22,
      "text": "The water tablet is making me pass urine all the time, and I get cramps in my legs at night. I'm not sure it's worth it."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.05,
      "end_seconds": 27.11,
      "duration_seconds": 8.06,
      "text": "I understand. Let me look at your records. Which tablet is it, and what dose?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.28,
      "end_seconds": 36.93,
      "duration_seconds": 5.65,
      "text": "Furosemide, 40 mg, once a day, in the morning."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 40.81,
      "end_seconds": 48.71,
      "duration_seconds": 7.9,
      "text": "Doctor, I've pulled up his last blood results, the potassium was low-normal last time."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.89,
      "end_seconds": 57.99,
      "duration_seconds": 5.1,
      "text": "Thank you. Do you take it every day, as prescribed?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.87,
      "end_seconds": 68.57,
      "duration_seconds": 7.7,
      "text": "Most days. Some days I skip it if I'm going out, to avoid the toilet."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.45,
      "end_seconds": 75.12,
      "duration_seconds": 3.67,
      "text": "I see. Are there any other medicines?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.41,
      "end_seconds": 86.79,
      "duration_seconds": 7.38,
      "text": "Ramipril, 5 mg, once a day. And a baby aspirin, 75 mg."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.08,
      "end_seconds": 93.8,
      "duration_seconds": 3.72,
      "text": "Why were you started on the furosemide?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.92,
      "end_seconds": 103.69,
      "duration_seconds": 5.77,
      "text": "I have a weak heart. Heart failure, they called it."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.57,
      "end_seconds": 111.45,
      "duration_seconds": 4.88,
      "text": "And do you have any other conditions?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.72,
      "end_seconds": 119.73,
      "duration_seconds": 5.01,
      "text": "High blood pressure. And I've had my gallbladder out."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.61,
      "end_seconds": 124.83,
      "duration_seconds": 2.22,
      "text": "When was that?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.1,
      "end_seconds": 130.99,
      "duration_seconds": 2.89,
      "text": "About ten years ago."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.71,
      "end_seconds": 140.3,
      "duration_seconds": 5.59,
      "text": "Any chest pain, breathlessness or ankle swelling at the moment?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.13,
      "end_seconds": 149.08,
      "duration_seconds": 5.95,
      "text": "No. My breathing is fine, and my ankles are normal."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 152.96,
      "end_seconds": 162.42,
      "duration_seconds": 9.46,
      "text": "Doctor, I need to say that when I weighed him today, he's lost two kilos since last month."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.15,
      "end_seconds": 176.85,
      "duration_seconds": 10.7,
      "text": "That's useful. It could be from the water tablet, or him skipping meals. I'd like to examine him. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.42,
      "end_seconds": 194.95,
      "duration_seconds": 1.53,
      "text": "Go on."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.99,
      "end_seconds": 205.67,
      "duration_seconds": 7.68,
      "text": "Your legs are soft and there is no swelling, and your chest is clear."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.51,
      "end_seconds": 212.93,
      "duration_seconds": 3.42,
      "text": "So I'm not retaining fluid? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.12,
      "end_seconds": 223.98,
      "duration_seconds": 7.86,
      "text": "Correct. At the moment you seem to be drying out a little, which fits with the cramps."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.49,
      "end_seconds": 230.23,
      "duration_seconds": 2.74,
      "text": "What can we do? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.48,
      "end_seconds": 243.38,
      "duration_seconds": 9.9,
      "text": "I'd like to check your kidneys and your salts with a blood test, including potassium and magnesium."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.59,
      "end_seconds": 249.29,
      "duration_seconds": 1.7,
      "text": "When? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.28,
      "end_seconds": 260.29,
      "duration_seconds": 7.01,
      "text": "Today. And I'd like an ECG and a review of the dose."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.16,
      "end_seconds": 268.43,
      "duration_seconds": 4.27,
      "text": "Can I stop it if it's bothersome? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.22,
      "end_seconds": 279.33,
      "duration_seconds": 8.11,
      "text": "Please don't stop it yourself, with your heart condition. We'll adjust the dose after the results."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.63,
      "end_seconds": 287.86,
      "duration_seconds": 5.23,
      "text": "All right. I'll take it every day, then. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.62,
      "end_seconds": 299.73,
      "duration_seconds": 8.11,
      "text": "Take it in the morning, and call us if your ankles swell or you get breathless."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.16,
      "end_seconds": 306.01,
      "duration_seconds": 2.85,
      "text": "I will. Thank you. ~"
    }
  ]
}
