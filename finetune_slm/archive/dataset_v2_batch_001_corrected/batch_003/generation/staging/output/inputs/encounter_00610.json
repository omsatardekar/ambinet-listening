{
  "schema_version": "1.0",
  "encounter_id": "00610",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.87,
      "end_seconds": 11.04,
      "duration_seconds": 10.17,
      "text": "Oh, I'm so sorry I'm late, doctor. The bus, it just... and then I couldn't find the right room."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.93,
      "end_seconds": 21.24,
      "duration_seconds": 7.31,
      "text": "Don't give it another thought. You're here now. And this is your mother?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 22.59,
      "end_seconds": 32.99,
      "duration_seconds": 10.4,
      "text": "Yes, I'm Pauline. I hope it's all right that I came in with her. She was nervous."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.47,
      "end_seconds": 45.49,
      "duration_seconds": 11.02,
      "text": "Of course. Alice, it's your appointment, so you tell me what's brought you in, and your mum can add things if you'd like."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.43,
      "end_seconds": 54.5,
      "duration_seconds": 7.07,
      "text": "Well, it's... I've missed my period. And it's been, um, about ten days now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.54,
      "end_seconds": 62.13,
      "duration_seconds": 6.59,
      "text": "I see. Is that unusual for you? Are your periods normally regular?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.87,
      "end_seconds": 71.91,
      "duration_seconds": 7.04,
      "text": "Usually. Like clockwork, mostly. That's why I... well, I got a bit worried."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.21,
      "end_seconds": 80.23,
      "duration_seconds": 6.02,
      "text": "That's completely understandable. Have you had any pain in your tummy?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.86,
      "end_seconds": 85.5,
      "duration_seconds": 2.64,
      "text": "No. No pain."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.24,
      "end_seconds": 93.82,
      "duration_seconds": 6.58,
      "text": "Any bleeding or spotting between periods, or at all in the last while?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.55,
      "end_seconds": 100.12,
      "duration_seconds": 3.57,
      "text": "No, not that I've... no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.19,
      "end_seconds": 106.32,
      "duration_seconds": 5.13,
      "text": "Good. And how are your bowels and digestion generally?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.32,
      "end_seconds": 110.82,
      "duration_seconds": 3.5,
      "text": "Fine, I think. Yes. Fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.98,
      "end_seconds": 120.56,
      "duration_seconds": 7.58,
      "text": "Thank you. Now I'd like to ask about medicines. Do you take anything regularly?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.95,
      "end_seconds": 130.88,
      "duration_seconds": 8.93,
      "text": "Just the one. A little white tablet, um, every morning. I can't remember what it's called."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.92,
      "end_seconds": 137.61,
      "duration_seconds": 5.69,
      "text": "Do you know what it's for, or what the box says?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.06,
      "end_seconds": 147.89,
      "duration_seconds": 7.83,
      "text": "I... it's from the chemist, and it's in a... I don't have the box."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 149.41,
      "end_seconds": 161.87,
      "duration_seconds": 12.46,
      "text": "It's a small white one, love, with a line across it. I can't say the name either. We'll bring the box next time."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.37,
      "end_seconds": 174.67,
      "duration_seconds": 10.3,
      "text": "That's fine. We'll check with the pharmacy. Now, one more thing I always ask. Have you any allergies, to medicines especially?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.18,
      "end_seconds": 179.49,
      "duration_seconds": 2.31,
      "text": "Um. Yes. Penicillin."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.48,
      "end_seconds": 187.56,
      "duration_seconds": 5.08,
      "text": "Penicillin. And what happens when you take it?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.13,
      "end_seconds": 198.55,
      "duration_seconds": 9.42,
      "text": "I come out in hives. All over. It was when I was, um... quite small."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 201.44,
      "end_seconds": 210.59,
      "duration_seconds": 9.15,
      "text": "She was about six. Her whole back was covered. We've told every doctor since."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.19,
      "end_seconds": 222.25,
      "duration_seconds": 9.06,
      "text": "That's very useful, thank you both. I'll make sure it's clearly recorded, so nobody prescribes it by mistake."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.46,
      "end_seconds": 228.05,
      "duration_seconds": 3.59,
      "text": "Does it matter for... for today?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.19,
      "end_seconds": 250.18,
      "duration_seconds": 12.99,
      "text": "It matters for any prescription, whatever the visit is about. It's about keeping you safe. Now, let me check your blood pressure and pulse."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.09,
      "end_seconds": 268.4,
      "duration_seconds": 5.31,
      "text": "Blood pressure 118 over 74, pulse 80. Both perfectly healthy."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.12,
      "end_seconds": 273.71,
      "duration_seconds": 2.59,
      "text": "That's good, isn't it?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.37,
      "end_seconds": 299.44,
      "duration_seconds": 11.07,
      "text": "It's reassuring. Can you lie back on the couch for me? I'm going to feel your tummy, very gently."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.5,
      "end_seconds": 302.64,
      "duration_seconds": 2.14,
      "text": "Is this okay?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.3,
      "end_seconds": 315.67,
      "duration_seconds": 4.37,
      "text": "That's fine. Your abdomen feels soft all over."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.47,
      "end_seconds": 320.12,
      "duration_seconds": 1.65,
      "text": "Oh. Good."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.96,
      "end_seconds": 328.87,
      "duration_seconds": 6.91,
      "text": "And there's no tenderness anywhere when I press. Does it hurt at all?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.82,
      "end_seconds": 335.28,
      "duration_seconds": 3.46,
      "text": "No. It's just a bit ticklish."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.71,
      "end_seconds": 345.64,
      "duration_seconds": 7.93,
      "text": "Right, you can sit up. Let me explain my thinking, because I know you're worried."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.91,
      "end_seconds": 349.22,
      "duration_seconds": 1.31,
      "text": "Please."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.93,
      "end_seconds": 360.01,
      "duration_seconds": 10.08,
      "text": "A late period has many everyday causes. Changes in routine, stress, how much you've been eating, travel. It's very common."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 362.28,
      "end_seconds": 367.15,
      "duration_seconds": 4.87,
      "text": "She has had a lot on her plate lately."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 369.47,
      "end_seconds": 371.29,
      "duration_seconds": 1.82,
      "text": "Mum, don't."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.33,
      "end_seconds": 383.33,
      "duration_seconds": 10.0,
      "text": "It's all right, Alice. That's helpful to know, and it's something we can talk about calmly."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 386.29,
      "end_seconds": 391.39,
      "duration_seconds": 5.1,
      "text": "I just... I wanted to know it's nothing awful."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 392.17,
      "end_seconds": 405.23,
      "duration_seconds": 13.06,
      "text": "I hear you. There is nothing in what I've seen or heard today that frightens me. We'll see what the next days bring."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 407.37,
      "end_seconds": 412.49,
      "duration_seconds": 5.12,
      "text": "Okay. Thank you. I feel a little calmer."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 413.27,
      "end_seconds": 422.63,
      "duration_seconds": 9.36,
      "text": "Good. And Pauline, do bring the tablet box, and mind that penicillin note stays on her record."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 424.43,
      "end_seconds": 428.09,
      "duration_seconds": 3.66,
      "text": "We will. Thank you, doctor."
    }
  ]
}
