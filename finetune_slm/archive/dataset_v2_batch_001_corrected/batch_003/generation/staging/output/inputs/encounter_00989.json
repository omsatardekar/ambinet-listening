{
  "schema_version": "1.0",
  "encounter_id": "00989",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.99,
      "end_seconds": 8.59,
      "duration_seconds": 6.6,
      "text": "It's my face. Flaky and red, next to my nose."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.22,
      "end_seconds": 11.54,
      "duration_seconds": 1.32,
      "text": "How long?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.7,
      "end_seconds": 16.5,
      "duration_seconds": 1.8,
      "text": "Three months."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.85,
      "end_seconds": 21.04,
      "duration_seconds": 1.19,
      "text": "Itchy?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.39,
      "end_seconds": 26.61,
      "duration_seconds": 3.22,
      "text": "Yes. Worse when I'm hot."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.75,
      "end_seconds": 31.19,
      "duration_seconds": 2.44,
      "text": "Anything on the scalp?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.23,
      "end_seconds": 35.71,
      "duration_seconds": 1.48,
      "text": "Dandruff. Always."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.11,
      "end_seconds": 41.74,
      "duration_seconds": 2.63,
      "text": "Is your skin greasy?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.23,
      "end_seconds": 46.69,
      "duration_seconds": 3.46,
      "text": "Very, on the nose and forehead."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.56,
      "end_seconds": 53.18,
      "duration_seconds": 3.62,
      "text": "Any patches elsewhere on the face?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.01,
      "end_seconds": 59.16,
      "duration_seconds": 3.15,
      "text": "Eyebrows. Red patches there too."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.6,
      "end_seconds": 65.24,
      "duration_seconds": 2.64,
      "text": "Any pus or weeping?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.57,
      "end_seconds": 69.39,
      "duration_seconds": 1.82,
      "text": "No pus."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.99,
      "end_seconds": 72.04,
      "duration_seconds": 1.05,
      "text": "Fever?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.69,
      "end_seconds": 76.5,
      "duration_seconds": 1.81,
      "text": "No fever."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.71,
      "end_seconds": 83.32,
      "duration_seconds": 4.61,
      "text": "Any new products on your face lately?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.5,
      "end_seconds": 88.86,
      "duration_seconds": 2.36,
      "text": "No new products."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.32,
      "end_seconds": 96.07,
      "duration_seconds": 3.75,
      "text": "What are you using on it?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.16,
      "end_seconds": 115.74,
      "duration_seconds": 16.58,
      "text": "Ketoconazole shampoo, twice a week. A moisturiser, twice a day. Cetirizine, 10 mg, at night. And a white cream from the dermatologist, I don't know the name."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.7,
      "end_seconds": 123.91,
      "duration_seconds": 5.21,
      "text": "We'll find that cream on your record. Any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.85,
      "end_seconds": 130.43,
      "duration_seconds": 4.58,
      "text": "Nickel. I get a rash from watch straps."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.53,
      "end_seconds": 134.25,
      "duration_seconds": 1.72,
      "text": "Skin history?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.05,
      "end_seconds": 141.46,
      "duration_seconds": 5.41,
      "text": "Eczema as a child. And acne as a teenager."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.79,
      "end_seconds": 145.74,
      "duration_seconds": 1.95,
      "text": "Any operations?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.26,
      "end_seconds": 155.12,
      "duration_seconds": 6.86,
      "text": "A mole removed, in 2016. And my tonsils, as a child."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.64,
      "end_seconds": 159.95,
      "duration_seconds": 3.31,
      "text": "Skin problems in the family?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.34,
      "end_seconds": 165.85,
      "duration_seconds": 2.51,
      "text": "My mother has psoriasis."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.38,
      "end_seconds": 170.97,
      "duration_seconds": 2.59,
      "text": "What do you do?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.72,
      "end_seconds": 176.77,
      "duration_seconds": 3.05,
      "text": "Baker. Hot ovens all day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.98,
      "end_seconds": 181.28,
      "duration_seconds": 1.3,
      "text": "Alcohol?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.22,
      "end_seconds": 187.82,
      "duration_seconds": 3.6,
      "text": "Weekends only, a few beers."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.26,
      "end_seconds": 206.67,
      "duration_seconds": 6.41,
      "text": "Let me check you. Blood pressure 120 over 74, pulse 70."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.39,
      "end_seconds": 209.73,
      "duration_seconds": 1.34,
      "text": "Fine. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.74,
      "end_seconds": 220.67,
      "duration_seconds": 7.93,
      "text": "I can see red, flaky patches along both sides of the nose and in the eyebrows."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.41,
      "end_seconds": 225.26,
      "duration_seconds": 1.85,
      "text": "Yes. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.31,
      "end_seconds": 231.49,
      "duration_seconds": 3.18,
      "text": "And scaling on the scalp."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.42,
      "end_seconds": 236.13,
      "duration_seconds": 2.71,
      "text": "That's the dandruff. ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.3,
      "end_seconds": 241.31,
      "duration_seconds": 2.01,
      "text": "Any joint pain?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.63,
      "end_seconds": 245.03,
      "duration_seconds": 1.4,
      "text": "No, nothing."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.66,
      "end_seconds": 252.18,
      "duration_seconds": 5.52,
      "text": "This looks like seborrhoeic dermatitis, but I can't rule out rosacea."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.46,
      "end_seconds": 258.08,
      "duration_seconds": 2.62,
      "text": "What's the difference? ~"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.82,
      "end_seconds": 274.05,
      "duration_seconds": 14.23,
      "text": "Rosacea has flushing and spots. We'll see. I'd like to arrange a skin scraping to check for fungus, and patch testing, given your nickel reaction."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.48,
      "end_seconds": 278.49,
      "duration_seconds": 2.01,
      "text": "Fine. ~"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.97,
      "end_seconds": 288.75,
      "duration_seconds": 6.78,
      "text": "Use the shampoo on your face as well, leave it on for five minutes."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.21,
      "end_seconds": 292.85,
      "duration_seconds": 1.64,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.45,
      "end_seconds": 300.95,
      "duration_seconds": 5.5,
      "text": "I'd like to see you again in four weeks."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.56,
      "end_seconds": 306.01,
      "duration_seconds": 2.45,
      "text": "Four weeks. ~"
    }
  ]
}
