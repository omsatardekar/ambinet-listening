{
  "schema_version": "1.0",
  "encounter_id": "00919",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 2.62,
      "end_seconds": 13.04,
      "duration_seconds": 10.42,
      "text": "Doctor, I'm Meera, her daughter-in-law. Mrs Rao has had a dry mouth and sores under her dentures for a good while now."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.34,
      "end_seconds": 24.32,
      "duration_seconds": 7.98,
      "text": "Thank you for coming with her. Mrs Rao, tell me about your mouth."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.4,
      "end_seconds": 36.69,
      "duration_seconds": 8.29,
      "text": "It's so dry, I can't taste anything. And the sores hurt when I eat."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.26,
      "end_seconds": 43.09,
      "duration_seconds": 2.83,
      "text": "Where are the sores?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.62,
      "end_seconds": 53.92,
      "duration_seconds": 7.3,
      "text": "On the roof of my mouth, and on the gums at the front."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 57.31,
      "end_seconds": 62.6,
      "duration_seconds": 5.29,
      "text": "She's been eating only soft things for a few weeks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.29,
      "end_seconds": 70.17,
      "duration_seconds": 3.88,
      "text": "Do the dentures still fit well? ~"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.04,
      "end_seconds": 78.04,
      "duration_seconds": 4.0,
      "text": "They've been loose since the winter. ~"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 81.05,
      "end_seconds": 88.74,
      "duration_seconds": 7.69,
      "text": "She had them made years ago. Her face has changed since then. ~"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.21,
      "end_seconds": 97.42,
      "duration_seconds": 5.21,
      "text": "Do you take them out at night? ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.05,
      "end_seconds": 104.6,
      "duration_seconds": 4.55,
      "text": "No, I forget. I sleep in them. ~"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.25,
      "end_seconds": 114.26,
      "duration_seconds": 7.01,
      "text": "That can make the sores worse. How long have you had the sores?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.78,
      "end_seconds": 118.61,
      "duration_seconds": 1.83,
      "text": "Three weeks."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.72,
      "end_seconds": 125.81,
      "duration_seconds": 4.09,
      "text": "Any fever, or sore throat? ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.72,
      "end_seconds": 132.19,
      "duration_seconds": 3.47,
      "text": "No, nothing like that. ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 135.57,
      "end_seconds": 145.05,
      "duration_seconds": 9.48,
      "text": "Doctor, shall I look in her mouth and record what I see for the notes? ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.84,
      "end_seconds": 154.58,
      "duration_seconds": 5.74,
      "text": "Yes, please do. I'd like to see it myself too. ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.34,
      "end_seconds": 160.36,
      "duration_seconds": 3.02,
      "text": "Will it hurt? ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 178.37,
      "end_seconds": 183.42,
      "duration_seconds": 5.05,
      "text": "No, I'll be very gentle. Open wide, Mrs Rao."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.01,
      "end_seconds": 198.01,
      "duration_seconds": 11.0,
      "text": "There are red, inflamed patches under the upper denture, with some white coating, and the mouth is dry."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.57,
      "end_seconds": 205.11,
      "duration_seconds": 3.54,
      "text": "What is it, doctor? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.82,
      "end_seconds": 218.21,
      "duration_seconds": 10.39,
      "text": "It looks like denture stomatitis, with thrush on top, and the dry mouth makes it more likely. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 221.87,
      "end_seconds": 225.82,
      "duration_seconds": 3.95,
      "text": "What causes the dry mouth? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.75,
      "end_seconds": 239.01,
      "duration_seconds": 10.26,
      "text": "Often tablets, or not drinking enough, or other things. I'd like to look at her medicines list and arrange some blood tests."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 242.0,
      "end_seconds": 245.21,
      "duration_seconds": 3.21,
      "text": "I've brought her list. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.99,
      "end_seconds": 259.19,
      "duration_seconds": 11.2,
      "text": "Thank you. In the meantime, she should take the dentures out at night, and keep them in a cup of water."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.82,
      "end_seconds": 266.22,
      "duration_seconds": 3.4,
      "text": "I'll try to remember. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 269.12,
      "end_seconds": 272.57,
      "duration_seconds": 3.45,
      "text": "I'll remind her every evening. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.32,
      "end_seconds": 282.41,
      "duration_seconds": 7.09,
      "text": "Brush the gums with a soft brush, and sip water through the day. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.29,
      "end_seconds": 287.83,
      "duration_seconds": 2.54,
      "text": "I will. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.68,
      "end_seconds": 299.36,
      "duration_seconds": 8.68,
      "text": "I'll also refer you to the dentist to have the dentures checked or remade."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 303.28,
      "end_seconds": 306.01,
      "duration_seconds": 2.73,
      "text": "Thank you, doctor. ~"
    }
  ]
}
