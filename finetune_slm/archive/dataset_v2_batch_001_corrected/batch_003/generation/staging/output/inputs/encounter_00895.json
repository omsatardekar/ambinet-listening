{
  "schema_version": "1.0",
  "encounter_id": "00895",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.26,
      "end_seconds": 12.87,
      "duration_seconds": 11.61,
      "text": "Hello, doctor. I know this will sound odd, but I keep feeling like I'm going to black out when I'm standing in queues."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.94,
      "end_seconds": 24.69,
      "duration_seconds": 8.75,
      "text": "It doesn't sound odd at all, it's something I hear fairly often. Tell me what happens."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.11,
      "end_seconds": 35.8,
      "duration_seconds": 7.69,
      "text": "I go warm all over, and then the room sort of goes dark at the edges."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.92,
      "end_seconds": 44.19,
      "duration_seconds": 5.27,
      "text": "Have you actually fainted, or does it pass before that?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.81,
      "end_seconds": 53.06,
      "duration_seconds": 7.25,
      "text": "I've never actually gone down. I always manage to lean on something or sit."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.46,
      "end_seconds": 58.27,
      "duration_seconds": 2.81,
      "text": "How often has this happened?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.14,
      "end_seconds": 68.75,
      "duration_seconds": 8.61,
      "text": "Oh, maybe four or five times. Always in a queue, at the bank or the post office."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.96,
      "end_seconds": 77.35,
      "duration_seconds": 5.39,
      "text": "Does it happen when you're sitting or walking about?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.54,
      "end_seconds": 85.09,
      "duration_seconds": 5.55,
      "text": "Never then. Only when I'm standing still for a long time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.37,
      "end_seconds": 94.98,
      "duration_seconds": 6.61,
      "text": "Do you feel your heart racing, or any chest pain with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.92,
      "end_seconds": 103.07,
      "duration_seconds": 6.15,
      "text": "A little fluttering, I think, but no pain at all."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.28,
      "end_seconds": 113.0,
      "duration_seconds": 7.72,
      "text": "Do you drink enough water during the day, do you think? ~"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.52,
      "end_seconds": 120.7,
      "duration_seconds": 5.18,
      "text": "Probably not. I'm usually rushing about and I forget. ~"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.09,
      "end_seconds": 127.71,
      "duration_seconds": 5.62,
      "text": "That's useful. Have you been working long hours recently? ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.78,
      "end_seconds": 136.69,
      "duration_seconds": 5.91,
      "text": "Yes, extra shifts. I'm tired, to be honest. ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.77,
      "end_seconds": 146.08,
      "duration_seconds": 7.31,
      "text": "I can understand that. Does anyone in your family have heart problems or fainting? ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.31,
      "end_seconds": 157.46,
      "duration_seconds": 8.15,
      "text": "My dad was a bit of a fainter, but he lived to eighty-five. ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.07,
      "end_seconds": 164.82,
      "duration_seconds": 5.75,
      "text": "That's reassuring. Do you smoke, or drink much coffee?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.53,
      "end_seconds": 171.08,
      "duration_seconds": 4.55,
      "text": "I don't smoke. Coffee, about four cups a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.78,
      "end_seconds": 182.39,
      "duration_seconds": 8.61,
      "text": "Four is a lot, and it can add to the fluttering. Do you eat breakfast? ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.09,
      "end_seconds": 190.38,
      "duration_seconds": 5.29,
      "text": "Not really. A coffee on the way to work. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.75,
      "end_seconds": 207.39,
      "duration_seconds": 15.64,
      "text": "Let me tell you what I think is happening. When you stand still, blood can pool in the legs and your pressure dips for a moment."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.21,
      "end_seconds": 212.72,
      "duration_seconds": 3.51,
      "text": "So it's not something dangerous? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.45,
      "end_seconds": 227.32,
      "duration_seconds": 12.87,
      "text": "Most of the time it isn't, but I'd like to record your heart tracing to make sure the rhythm is normal."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.33,
      "end_seconds": 233.16,
      "duration_seconds": 2.83,
      "text": "When would that be? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.71,
      "end_seconds": 242.58,
      "duration_seconds": 7.87,
      "text": "I can arrange it for later this week, at the clinic. It takes about ten minutes. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.06,
      "end_seconds": 246.39,
      "duration_seconds": 2.33,
      "text": "That's fine. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.47,
      "end_seconds": 256.31,
      "duration_seconds": 7.84,
      "text": "In the meantime, drink water through the day and have something to eat in the morning."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.57,
      "end_seconds": 261.78,
      "duration_seconds": 2.21,
      "text": "I will try. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.43,
      "end_seconds": 276.82,
      "duration_seconds": 12.39,
      "text": "If you're in a queue and start feeling it, shift your weight from foot to foot, or sit down straight away."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.28,
      "end_seconds": 282.21,
      "duration_seconds": 2.93,
      "text": "Okay, I'll do that. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.87,
      "end_seconds": 292.43,
      "duration_seconds": 7.56,
      "text": "And if you do faint, or get chest pain, come in or call at once."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.62,
      "end_seconds": 298.71,
      "duration_seconds": 3.09,
      "text": "Understood. Thank you. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.08,
      "end_seconds": 305.98,
      "duration_seconds": 5.9,
      "text": "We'll go over the tracing together once it's done. ~"
    }
  ]
}
