{
  "schema_version": "1.0",
  "encounter_id": "00794",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.2,
      "end_seconds": 17.28,
      "duration_seconds": 16.08,
      "text": "Hi, hi. I'm worried about my hands, they're awful, they're cracked and bleeding, and I'm scared it's going to get infected. I work in a care home, and we wash our hands constantly."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.61,
      "end_seconds": 22.58,
      "duration_seconds": 3.97,
      "text": "That sounds sore. When did it start?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.94,
      "end_seconds": 36.69,
      "duration_seconds": 11.75,
      "text": "Oh, a few months, I think, or since the winter, I can't remember when it began, maybe before. I keep meaning to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.71,
      "end_seconds": 42.0,
      "duration_seconds": 3.29,
      "text": "Which parts of the hands?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.81,
      "end_seconds": 54.29,
      "duration_seconds": 9.48,
      "text": "Between the fingers, and the backs, and my knuckles are split. And the skin's red, and itchy."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.75,
      "end_seconds": 61.71,
      "duration_seconds": 5.96,
      "text": "Any weeping or crusting, any yellow, any signs of infection?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.23,
      "end_seconds": 68.79,
      "duration_seconds": 4.56,
      "text": "A bit of crusting on one knuckle. No pus."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.02,
      "end_seconds": 74.63,
      "duration_seconds": 4.61,
      "text": "Do you wear gloves at work? ~"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.91,
      "end_seconds": 84.01,
      "duration_seconds": 7.1,
      "text": "When I'm told to, but they make my hands sweat, and then it's worse. ~"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.41,
      "end_seconds": 88.86,
      "duration_seconds": 3.45,
      "text": "What have you tried? ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.71,
      "end_seconds": 101.39,
      "duration_seconds": 9.68,
      "text": "A hand cream from the supermarket, I use it when I remember. Which is not often, to be fair. ~"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.18,
      "end_seconds": 108.24,
      "duration_seconds": 6.06,
      "text": "Is there any eczema in the past, or asthma, hay fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.47,
      "end_seconds": 113.8,
      "duration_seconds": 4.33,
      "text": "I had eczema as a child."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.67,
      "end_seconds": 120.41,
      "duration_seconds": 5.74,
      "text": "How many times a day do you wash your hands?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.19,
      "end_seconds": 128.39,
      "duration_seconds": 6.2,
      "text": "Thirty, forty times a shift. And sanitiser, the gel, it stings."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.19,
      "end_seconds": 136.01,
      "duration_seconds": 5.82,
      "text": "Do you have any other work involving chemicals, like cleaning products?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.39,
      "end_seconds": 141.71,
      "duration_seconds": 4.32,
      "text": "Yes, the cleaning products, bleach and disinfectant."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.23,
      "end_seconds": 147.42,
      "duration_seconds": 3.19,
      "text": "Pulse and temperature first, please. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.69,
      "end_seconds": 151.26,
      "duration_seconds": 1.57,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.39,
      "end_seconds": 166.04,
      "duration_seconds": 2.65,
      "text": "Pulse 78, temperature 36.7."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.1,
      "end_seconds": 169.95,
      "duration_seconds": 1.85,
      "text": "Good. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.6,
      "end_seconds": 193.15,
      "duration_seconds": 3.55,
      "text": "Now let me see the hands."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.4,
      "end_seconds": 196.65,
      "duration_seconds": 2.25,
      "text": "They're embarrassing. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.47,
      "end_seconds": 214.3,
      "duration_seconds": 14.83,
      "text": "There are dry, red, scaly patches with deep cracks across the knuckles, and in the finger webs, and one knuckle has a crust, but there's no spreading redness or pus."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.7,
      "end_seconds": 218.85,
      "duration_seconds": 3.15,
      "text": "Is it eczema, then? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.92,
      "end_seconds": 227.86,
      "duration_seconds": 7.94,
      "text": "It looks like irritant contact dermatitis, caused by the constant washing and cleaning products."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.37,
      "end_seconds": 233.7,
      "duration_seconds": 3.33,
      "text": "Can it be cured? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.07,
      "end_seconds": 253.7,
      "duration_seconds": 17.63,
      "text": "It can be controlled. I'm going to start you on a steroid ointment, betamethasone, apply it once a day to the red areas, for two weeks, and a thick emollient."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.42,
      "end_seconds": 262.22,
      "duration_seconds": 5.8,
      "text": "Do I have to use them all the time? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.38,
      "end_seconds": 276.65,
      "duration_seconds": 13.27,
      "text": "Steroid once a day, thin layer, only on the red cracked areas, and the emollient, as often as you can, particularly after washing."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.53,
      "end_seconds": 282.57,
      "duration_seconds": 4.04,
      "text": "Okay. I'll try, I promise. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.67,
      "end_seconds": 292.36,
      "duration_seconds": 7.69,
      "text": "Wear cotton gloves under waterproof ones, use a soap substitute, and dry your hands carefully."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.99,
      "end_seconds": 297.98,
      "duration_seconds": 2.99,
      "text": "I'll try. Sorry. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.04,
      "end_seconds": 314.59,
      "duration_seconds": 15.55,
      "text": "And I'd like to take a swab from the crusted knuckle, and a skin patch test referral, because I'd like to rule out a reaction to something at work."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.34,
      "end_seconds": 319.03,
      "duration_seconds": 1.69,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.77,
      "end_seconds": 327.04,
      "duration_seconds": 6.27,
      "text": "Please let your manager know, occupational health may help with a different glove."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.84,
      "end_seconds": 332.0,
      "duration_seconds": 2.16,
      "text": "Good idea. ~"
    }
  ]
}
