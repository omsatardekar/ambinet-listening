{
  "schema_version": "1.0",
  "encounter_id": "00888",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 1.71,
      "end_seconds": 12.87,
      "duration_seconds": 11.16,
      "text": "Hello doctor. This is my son Arjun, he's seven. He starts wheezing whenever he runs around, and it worries me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.65,
      "end_seconds": 23.41,
      "duration_seconds": 6.76,
      "text": "Thank you for bringing him. Hello Arjun, how are you feeling today? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.39,
      "end_seconds": 28.49,
      "duration_seconds": 2.1,
      "text": "I'm okay. ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.66,
      "end_seconds": 38.85,
      "duration_seconds": 7.19,
      "text": "Good lad. Mum, can you tell me what the wheezing is like?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 41.62,
      "end_seconds": 49.73,
      "duration_seconds": 8.11,
      "text": "It's a whistling sound from his chest, after he's been running for a few minutes at school."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.82,
      "end_seconds": 56.66,
      "duration_seconds": 4.84,
      "text": "How long does it last once he stops?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 59.54,
      "end_seconds": 63.73,
      "duration_seconds": 4.19,
      "text": "Ten minutes or so, then it settles."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.7,
      "end_seconds": 73.05,
      "duration_seconds": 6.35,
      "text": "Has it happened at night, or when he has a cold?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 75.35,
      "end_seconds": 84.62,
      "duration_seconds": 9.27,
      "text": "When he has a cold, yes, he gets a cough with it. But not usually at night."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.28,
      "end_seconds": 91.86,
      "duration_seconds": 4.58,
      "text": "Arjun, does it hurt when you wheeze? ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.19,
      "end_seconds": 98.38,
      "duration_seconds": 3.19,
      "text": "No, it just feels tight. ~"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.6,
      "end_seconds": 105.13,
      "duration_seconds": 3.53,
      "text": "Does he take anything for it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 108.34,
      "end_seconds": 118.46,
      "duration_seconds": 10.12,
      "text": "A blue inhaler, salbutamol, two puffs when he needs it, with a spacer. He has used it a few times."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.28,
      "end_seconds": 124.27,
      "duration_seconds": 2.99,
      "text": "Does the inhaler help? ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 127.15,
      "end_seconds": 131.06,
      "duration_seconds": 3.91,
      "text": "Yes, within a few minutes. ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.46,
      "end_seconds": 138.36,
      "duration_seconds": 4.9,
      "text": "Does anyone in the family have asthma or eczema?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 141.42,
      "end_seconds": 148.64,
      "duration_seconds": 7.22,
      "text": "His mother, that's me, had asthma as a child, and his father has hay fever."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.84,
      "end_seconds": 156.73,
      "duration_seconds": 4.89,
      "text": "Does Arjun have any allergies, to medicines or food?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 159.72,
      "end_seconds": 167.59,
      "duration_seconds": 7.87,
      "text": "A rash after eating peanuts when he was three. We've avoided them since."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.3,
      "end_seconds": 176.87,
      "duration_seconds": 5.57,
      "text": "Thank you. That's important. Does he have any other conditions? ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 180.37,
      "end_seconds": 185.6,
      "duration_seconds": 5.23,
      "text": "Eczema, when he was a baby. It's gone now. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.84,
      "end_seconds": 199.02,
      "duration_seconds": 10.18,
      "text": "I'd like to listen to his chest and check his oxygen. Arjun, can you take big breaths for me? ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.18,
      "end_seconds": 215.34,
      "duration_seconds": 1.16,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.82,
      "end_seconds": 227.47,
      "duration_seconds": 8.65,
      "text": "Oxygen 98 percent, pulse 90, breathing 22 a minute. His chest is clear now, no wheeze."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 230.91,
      "end_seconds": 233.51,
      "duration_seconds": 2.6,
      "text": "So it's gone? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.11,
      "end_seconds": 244.16,
      "duration_seconds": 7.05,
      "text": "Between episodes it often is. From what you describe, this sounds like exercise-induced asthma."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 247.67,
      "end_seconds": 250.17,
      "duration_seconds": 2.5,
      "text": "Is it dangerous? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.52,
      "end_seconds": 263.51,
      "duration_seconds": 10.99,
      "text": "It's common and very treatable. He should take two puffs of the salbutamol with the spacer ten minutes before sport."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 266.53,
      "end_seconds": 271.19,
      "duration_seconds": 4.66,
      "text": "The school should know about that. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.13,
      "end_seconds": 286.88,
      "duration_seconds": 12.75,
      "text": "I'll write a letter for the school. And I'd like to see him again in four weeks, to see how he's getting on."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 289.85,
      "end_seconds": 292.52,
      "duration_seconds": 2.67,
      "text": "Thank you, doctor. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.55,
      "end_seconds": 301.32,
      "duration_seconds": 6.77,
      "text": "If he's struggling to speak, or the inhaler isn't helping, call an ambulance."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 303.78,
      "end_seconds": 306.01,
      "duration_seconds": 2.23,
      "text": "I understand. ~"
    }
  ]
}
