{
  "schema_version": "1.0",
  "encounter_id": "00816",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 3.0,
      "end_seconds": 12.1,
      "duration_seconds": 9.1,
      "text": "Hello, doctor. I'm back about my ear. It's still leaking, and I'm worried, because of my diabetes."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.33,
      "end_seconds": 19.39,
      "duration_seconds": 4.06,
      "text": "Which ear, and what's been coming out?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.69,
      "end_seconds": 33.53,
      "duration_seconds": 10.84,
      "text": "The left. A yellowish discharge. It's been going on for two weeks, and the drops I was given didn't clear it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.89,
      "end_seconds": 39.29,
      "duration_seconds": 2.4,
      "text": "Is it painful?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.65,
      "end_seconds": 50.5,
      "duration_seconds": 7.85,
      "text": "A dull ache. Not like before. And I can't hear well on that side."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.82,
      "end_seconds": 57.82,
      "duration_seconds": 3.0,
      "text": "Any fever, or dizziness?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.75,
      "end_seconds": 64.49,
      "duration_seconds": 2.74,
      "text": "No fever. No dizziness."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.54,
      "end_seconds": 71.55,
      "duration_seconds": 4.01,
      "text": "Any swelling or pain behind the ear?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.09,
      "end_seconds": 77.76,
      "duration_seconds": 2.67,
      "text": "No. Nothing behind it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.09,
      "end_seconds": 84.97,
      "duration_seconds": 3.88,
      "text": "Remind me what you've been using."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.36,
      "end_seconds": 100.04,
      "duration_seconds": 11.68,
      "text": "The antibiotic drops, ciprofloxacin, three drops, twice a day, for ten days. And my diabetes tablet, metformin, 500 mg, twice a day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.38,
      "end_seconds": 107.92,
      "duration_seconds": 3.54,
      "text": "Right. And how's your sugar been? ~"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.18,
      "end_seconds": 118.57,
      "duration_seconds": 6.39,
      "text": "A bit high. Last time my nurse said eight-something. ~"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.9,
      "end_seconds": 124.29,
      "duration_seconds": 2.39,
      "text": "Any other conditions?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.06,
      "end_seconds": 133.29,
      "duration_seconds": 5.23,
      "text": "Type 2 diabetes, five years, and high blood pressure."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.11,
      "end_seconds": 141.78,
      "duration_seconds": 4.67,
      "text": "Let me look in your ear. ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.42,
      "end_seconds": 163.96,
      "duration_seconds": 1.54,
      "text": "Gently, please."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.66,
      "end_seconds": 181.3,
      "duration_seconds": 13.64,
      "text": "The ear canal is swollen and has yellowish debris and discharge in it, and the eardrum is hard to see, but I can see a small hole in it."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.15,
      "end_seconds": 187.08,
      "duration_seconds": 1.93,
      "text": "A hole? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.2,
      "end_seconds": 200.2,
      "duration_seconds": 10.0,
      "text": "A perforation of the eardrum, which would explain the discharge, and it may have come from an old middle-ear infection. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.54,
      "end_seconds": 205.69,
      "duration_seconds": 2.15,
      "text": "Oh dear. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.22,
      "end_seconds": 220.26,
      "duration_seconds": 11.04,
      "text": "It's very treatable. I'd like to arrange a swab from the ear, to see which germ is growing, and a hearing test."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.45,
      "end_seconds": 225.91,
      "duration_seconds": 1.46,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.12,
      "end_seconds": 240.62,
      "duration_seconds": 11.5,
      "text": "Diabetes can make ear infections harder to clear, so I'd like you to check your sugars twice a day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.82,
      "end_seconds": 246.13,
      "duration_seconds": 2.31,
      "text": "I will. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.74,
      "end_seconds": 262.16,
      "duration_seconds": 12.42,
      "text": "Keep the ear dry, use a cotton wool ball with petroleum jelly in the ear when you shower, and don't swim."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.25,
      "end_seconds": 270.08,
      "duration_seconds": 3.83,
      "text": "I will. I don't swim anyway. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.21,
      "end_seconds": 280.86,
      "duration_seconds": 6.65,
      "text": "I'd like to see you again in a week, with the swab result."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.03,
      "end_seconds": 288.62,
      "duration_seconds": 4.59,
      "text": "A week. Should I stop the drops? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.13,
      "end_seconds": 297.92,
      "duration_seconds": 5.79,
      "text": "Finish the course as prescribed, and don't use anyone else's. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.05,
      "end_seconds": 305.99,
      "duration_seconds": 3.94,
      "text": "Right, I'll finish them. Thank you, doctor. ~"
    }
  ]
}
