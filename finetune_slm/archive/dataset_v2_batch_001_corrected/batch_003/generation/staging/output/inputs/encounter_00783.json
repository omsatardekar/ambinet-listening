{
  "schema_version": "1.0",
  "encounter_id": "00783",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 1.05,
      "end_seconds": 13.78,
      "duration_seconds": 12.73,
      "text": "Mr Hartley, I'm Chloe, the nurse. You came in with a wrist injury. Let me get your pulse and blood pressure. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.9,
      "end_seconds": 25.77,
      "duration_seconds": 10.87,
      "text": "Thank you, my dear. I'm afraid I've been rather foolish. I fell off a ladder, cleaning the gutters."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 39.6,
      "end_seconds": 44.52,
      "duration_seconds": 4.92,
      "text": "Pulse 88, blood pressure 144 over 86, temperature 36.7."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.48,
      "end_seconds": 53.55,
      "duration_seconds": 6.07,
      "text": "Good morning, Mr Hartley. I'm Dr Naylor. Tell me what happened. ~"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.12,
      "end_seconds": 67.78,
      "duration_seconds": 12.66,
      "text": "I was about eight feet up, and the ladder slipped, and I came down on my left hand, with my arm out."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.66,
      "end_seconds": 71.02,
      "duration_seconds": 2.36,
      "text": "When was that?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.31,
      "end_seconds": 79.38,
      "duration_seconds": 6.07,
      "text": "About two hours ago. And my wrist has swollen up, rather alarmingly."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.02,
      "end_seconds": 85.42,
      "duration_seconds": 3.4,
      "text": "How bad is the pain?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.5,
      "end_seconds": 92.84,
      "duration_seconds": 6.34,
      "text": "Severe when I move it. I can hardly turn my hand over."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.74,
      "end_seconds": 98.57,
      "duration_seconds": 4.83,
      "text": "Did you hit your head, or hurt anywhere else?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.67,
      "end_seconds": 106.8,
      "duration_seconds": 7.13,
      "text": "No, no head injury. My right knee is a bit sore, but nothing much."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.61,
      "end_seconds": 111.84,
      "duration_seconds": 4.23,
      "text": "Any numbness or tingling in your fingers?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.29,
      "end_seconds": 119.08,
      "duration_seconds": 5.79,
      "text": "A little tingling in my thumb and index finger."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.46,
      "end_seconds": 123.79,
      "duration_seconds": 3.33,
      "text": "Do you have any medical problems?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.06,
      "end_seconds": 129.49,
      "duration_seconds": 4.43,
      "text": "High blood pressure and an underactive thyroid."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.71,
      "end_seconds": 137.69,
      "duration_seconds": 6.98,
      "text": "And do you do anything which might affect healing, do you smoke?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.68,
      "end_seconds": 143.76,
      "duration_seconds": 4.08,
      "text": "I gave up thirty years ago."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.95,
      "end_seconds": 168.08,
      "duration_seconds": 7.13,
      "text": "Let me look at your wrist. Tell me when it hurts."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.94,
      "end_seconds": 172.76,
      "duration_seconds": 1.82,
      "text": "Ow! There. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.49,
      "end_seconds": 190.6,
      "duration_seconds": 15.11,
      "text": "The wrist is swollen, with a visible bump, a deformity, on the back of it, it's very tender over the end of the radius, and the fingers are warm with a good pulse."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 193.38,
      "end_seconds": 197.32,
      "duration_seconds": 3.94,
      "text": "His capillary refill is normal, doctor. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.13,
      "end_seconds": 208.47,
      "duration_seconds": 10.34,
      "text": "Thank you, Chloe. Mr Hartley, this looks like a broken wrist, a fracture of the radius, called a Colles' fracture."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.09,
      "end_seconds": 213.25,
      "duration_seconds": 2.16,
      "text": "Oh, bother. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.66,
      "end_seconds": 233.65,
      "duration_seconds": 18.99,
      "text": "I can't be certain without an X-ray, and it could also involve a small bone in the wrist, so I'd like an X-ray of the wrist, and one of the knee."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.44,
      "end_seconds": 239.5,
      "duration_seconds": 4.06,
      "text": "Can I have something for the pain? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.53,
      "end_seconds": 247.41,
      "duration_seconds": 4.88,
      "text": "Chloe will give you something strong right away. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 249.13,
      "end_seconds": 252.6,
      "duration_seconds": 3.47,
      "text": "I'll bring it now. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.01,
      "end_seconds": 266.88,
      "duration_seconds": 12.87,
      "text": "Please keep the arm raised on a pillow, and don't eat or drink anything until the X-rays are done, in case you need it set."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.46,
      "end_seconds": 274.1,
      "duration_seconds": 4.64,
      "text": "Will it need to be put back? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.44,
      "end_seconds": 283.67,
      "duration_seconds": 8.23,
      "text": "Possibly. If the bone has shifted, we'll set it under local anaesthetic, in the department. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.31,
      "end_seconds": 289.07,
      "duration_seconds": 2.76,
      "text": "How very modern. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.12,
      "end_seconds": 300.06,
      "duration_seconds": 9.94,
      "text": "Chloe will take you through to radiology. If your fingers go cold, blue or numb, tell her at once."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.38,
      "end_seconds": 306.01,
      "duration_seconds": 3.63,
      "text": "I shall. Thank you. ~"
    }
  ]
}
