{
  "schema_version": "1.0",
  "encounter_id": "00912",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 2.57,
      "end_seconds": 12.92,
      "duration_seconds": 10.35,
      "text": "I wanted to talk about my eating. I've been restricting a lot, and my friend said I should speak to someone."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.04,
      "end_seconds": 25.85,
      "duration_seconds": 9.81,
      "text": "Thank you for telling us. That took courage. Can you tell me what restricting looks like for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.3,
      "end_seconds": 37.77,
      "duration_seconds": 8.47,
      "text": "I skip breakfast and lunch most days, and I only have a small dinner. I count everything."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.79,
      "end_seconds": 45.17,
      "duration_seconds": 4.38,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.25,
      "end_seconds": 54.82,
      "duration_seconds": 6.57,
      "text": "About one year. It got worse after exams last summer."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.17,
      "end_seconds": 64.13,
      "duration_seconds": 4.96,
      "text": "Have you been making yourself sick, or using laxatives?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.46,
      "end_seconds": 71.37,
      "duration_seconds": 3.91,
      "text": "No. Never. I just don't eat."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.77,
      "end_seconds": 80.65,
      "duration_seconds": 5.88,
      "text": "How do you feel about your weight and body? ~"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.49,
      "end_seconds": 91.19,
      "duration_seconds": 6.7,
      "text": "I feel too big, even though people say I'm thin. ~"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.12,
      "end_seconds": 99.88,
      "duration_seconds": 5.76,
      "text": "Thank you for being honest. Are you on any medicines?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.78,
      "end_seconds": 109.94,
      "duration_seconds": 6.16,
      "text": "Just the contraceptive pill, I think it's Microgynon, but I'm not sure."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 114.28,
      "end_seconds": 122.85,
      "duration_seconds": 8.57,
      "text": "Doctor, I've weighed her and taken her pulse. Weight 46 kilos, height 165, pulse 54. ~"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.4,
      "end_seconds": 134.09,
      "duration_seconds": 7.69,
      "text": "Thank you. That's a low pulse, and a body mass index around seventeen."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.07,
      "end_seconds": 140.87,
      "duration_seconds": 2.8,
      "text": "Is that bad? ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.88,
      "end_seconds": 153.67,
      "duration_seconds": 9.79,
      "text": "It's lower than I'd like. Your body is working hard to protect you. Have you had any dizziness or fainting?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.81,
      "end_seconds": 163.07,
      "duration_seconds": 5.26,
      "text": "Dizzy when I stand up quickly. Never fainted."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.77,
      "end_seconds": 170.17,
      "duration_seconds": 3.4,
      "text": "Have your periods been regular? ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.25,
      "end_seconds": 178.06,
      "duration_seconds": 4.81,
      "text": "They stopped about six months ago. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.5,
      "end_seconds": 184.0,
      "duration_seconds": 2.5,
      "text": "Any past medical conditions?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.81,
      "end_seconds": 194.49,
      "duration_seconds": 6.68,
      "text": "Asthma as a child. And anxiety, last year, but I was never treated."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.66,
      "end_seconds": 200.59,
      "duration_seconds": 1.93,
      "text": "Any operations?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.89,
      "end_seconds": 207.93,
      "duration_seconds": 4.04,
      "text": "My tonsils, when I was nine."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.2,
      "end_seconds": 216.31,
      "duration_seconds": 4.11,
      "text": "Do you drink alcohol or smoke?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.4,
      "end_seconds": 222.01,
      "duration_seconds": 2.61,
      "text": "No. I never have."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.11,
      "end_seconds": 238.98,
      "duration_seconds": 12.87,
      "text": "I'd like to be honest with you. What you describe sounds like an eating disorder, and I'd like to arrange a proper assessment."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.31,
      "end_seconds": 248.39,
      "duration_seconds": 5.08,
      "text": "I don't want to be put in hospital. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.31,
      "end_seconds": 263.92,
      "duration_seconds": 12.61,
      "text": "We're not talking about that now. I'm going to refer you to the eating disorder team, and we'll run bloods and an ECG."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.36,
      "end_seconds": 272.23,
      "duration_seconds": 4.87,
      "text": "Okay. I think I do need help. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 276.26,
      "end_seconds": 283.09,
      "duration_seconds": 6.83,
      "text": "I'll book the bloods with you before you leave today. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.25,
      "end_seconds": 297.18,
      "duration_seconds": 9.93,
      "text": "And I'd like to see you again in one week, so we can check how you're managing."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.83,
      "end_seconds": 306.0,
      "duration_seconds": 5.17,
      "text": "One week. Thank you for not judging me. ~"
    }
  ]
}
