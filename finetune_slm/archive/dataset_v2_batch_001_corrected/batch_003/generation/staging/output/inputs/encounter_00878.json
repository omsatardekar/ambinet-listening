{
  "schema_version": "1.0",
  "encounter_id": "00878",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.43,
      "end_seconds": 15.73,
      "duration_seconds": 14.3,
      "text": "Oh, I'm terribly sorry I'm late, doctor, I got the wrong day on the calendar, I thought it was Thursday. I mean, it's Thursday, but, oh, never mind. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.27,
      "end_seconds": 27.77,
      "duration_seconds": 9.5,
      "text": "Not at all, Mr Alderton. We have time. How have you been since I last saw you? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.16,
      "end_seconds": 42.55,
      "duration_seconds": 12.39,
      "text": "Not great, I'm afraid. The stiffness is worse in the mornings, it takes me an hour to get going, and my right hand shakes."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.0,
      "end_seconds": 53.33,
      "duration_seconds": 8.33,
      "text": "So the stiffness is worse first thing, and the right hand has a tremor. Which hand, again?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.84,
      "end_seconds": 59.83,
      "duration_seconds": 4.99,
      "text": "The right. Sorry, did I say left? The right."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.23,
      "end_seconds": 63.57,
      "duration_seconds": 2.34,
      "text": "And how's your walking?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.65,
      "end_seconds": 72.05,
      "duration_seconds": 5.4,
      "text": "Slow. I shuffle. My wife says I'm like a penguin."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.38,
      "end_seconds": 78.45,
      "duration_seconds": 3.07,
      "text": "Have you had any falls?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.07,
      "end_seconds": 84.34,
      "duration_seconds": 4.27,
      "text": "No falls, no. Wobbles, but I've caught myself."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.14,
      "end_seconds": 91.08,
      "duration_seconds": 3.94,
      "text": "Any hallucinations, seeing things that aren't there?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.12,
      "end_seconds": 97.09,
      "duration_seconds": 2.97,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.56,
      "end_seconds": 104.04,
      "duration_seconds": 4.48,
      "text": "What are you on at the moment?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.44,
      "end_seconds": 116.89,
      "duration_seconds": 10.45,
      "text": "Levodopa, 100 mg, four times a day. The last one's at six, and by seven in the morning I'm worn out."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.54,
      "end_seconds": 120.65,
      "duration_seconds": 2.11,
      "text": "Right. Any allergies?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.13,
      "end_seconds": 125.23,
      "duration_seconds": 2.1,
      "text": "No allergies, none."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.87,
      "end_seconds": 132.39,
      "duration_seconds": 4.52,
      "text": "And your Parkinson's, remind me when you were diagnosed?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.83,
      "end_seconds": 140.09,
      "duration_seconds": 6.26,
      "text": "Three years ago. Though I think it started a year before."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.4,
      "end_seconds": 143.92,
      "duration_seconds": 2.52,
      "text": "And you worked as?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.14,
      "end_seconds": 151.5,
      "duration_seconds": 4.36,
      "text": "I was a bus driver. Retired now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.19,
      "end_seconds": 180.07,
      "duration_seconds": 10.88,
      "text": "Let me check you. Pulse 72, blood pressure 138 over 80, temperature 36.5, oxygen 98 percent, breathing 14, weight 74 kilos."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.43,
      "end_seconds": 183.45,
      "duration_seconds": 2.02,
      "text": "All right? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.41,
      "end_seconds": 198.49,
      "duration_seconds": 5.08,
      "text": "All fine. Hold your arms out in front."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.99,
      "end_seconds": 203.19,
      "duration_seconds": 2.2,
      "text": "Like this? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.57,
      "end_seconds": 211.91,
      "duration_seconds": 6.34,
      "text": "I can see a tremor in the right hand at rest."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.44,
      "end_seconds": 218.2,
      "duration_seconds": 3.76,
      "text": "Yes, it's a pill-rolling thing. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.56,
      "end_seconds": 230.16,
      "duration_seconds": 10.6,
      "text": "And when I move your right arm, there's stiffness, a cogwheel catch, but the left is normal."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.46,
      "end_seconds": 234.22,
      "duration_seconds": 2.76,
      "text": "Is that bad? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.53,
      "end_seconds": 248.88,
      "duration_seconds": 11.35,
      "text": "It's what we expect. I think the stiffness in the mornings is the levodopa wearing off between doses."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.22,
      "end_seconds": 254.09,
      "duration_seconds": 2.87,
      "text": "What can we do? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.73,
      "end_seconds": 263.47,
      "duration_seconds": 7.74,
      "text": "I'd like to start rasagiline, 1 mg, once a day, to smooth things out."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.32,
      "end_seconds": 269.81,
      "duration_seconds": 3.49,
      "text": "Will it help the shaking? ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.7,
      "end_seconds": 283.28,
      "duration_seconds": 11.58,
      "text": "A little. I'd also like to arrange a physiotherapy assessment, and blood tests for your kidney and liver function."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.82,
      "end_seconds": 287.49,
      "duration_seconds": 1.67,
      "text": "Fine. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.53,
      "end_seconds": 298.7,
      "duration_seconds": 9.17,
      "text": "If the stiffness isn't better in a month, come back and we'll look at the timing again."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.38,
      "end_seconds": 305.98,
      "duration_seconds": 4.6,
      "text": "A month. I'll write it down. ~"
    }
  ]
}
