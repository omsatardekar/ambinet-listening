{
  "schema_version": "1.0",
  "encounter_id": "00692",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 2.62,
      "end_seconds": 15.56,
      "duration_seconds": 12.94,
      "text": "Hello, doctor. I woke up on Tuesday with a stiff neck, and it's not eased. I suspect I slept on it badly."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.22,
      "end_seconds": 24.78,
      "duration_seconds": 6.56,
      "text": "That's very common. Which side is it, and what's the movement like?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.94,
      "end_seconds": 41.49,
      "duration_seconds": 13.55,
      "text": "Right side, running down into the shoulder. I can't turn my head to the right without a sharp pain. Looking left is fine."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.75,
      "end_seconds": 51.63,
      "duration_seconds": 6.88,
      "text": "Have you any numbness or pins and needles in your arm or hand?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.43,
      "end_seconds": 62.63,
      "duration_seconds": 8.2,
      "text": "No, nothing in the arm. It's only the neck and a little into the shoulder."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.65,
      "end_seconds": 73.2,
      "duration_seconds": 6.55,
      "text": "Any injury before, a fall, a car accident, lifting something heavy? ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.17,
      "end_seconds": 89.41,
      "duration_seconds": 12.24,
      "text": "No, nothing like that. I did spend the night on my friend's sofa, which has a pillow like a brick. ~"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.12,
      "end_seconds": 98.28,
      "duration_seconds": 6.16,
      "text": "Ah, the sofa. That tends to be the culprit. ~"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.2,
      "end_seconds": 107.18,
      "duration_seconds": 4.98,
      "text": "I did think so. Is it serious? ~"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.9,
      "end_seconds": 119.39,
      "duration_seconds": 8.49,
      "text": "Almost never. Let me check you over to be sure. Temperature first. ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.04,
      "end_seconds": 125.27,
      "duration_seconds": 2.23,
      "text": "Of course. ~"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.35,
      "end_seconds": 132.08,
      "duration_seconds": 2.73,
      "text": "Temperature 36.6, pulse 70."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.14,
      "end_seconds": 137.89,
      "duration_seconds": 1.75,
      "text": "Good. ~"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.7,
      "end_seconds": 164.73,
      "duration_seconds": 10.03,
      "text": "Now I'm going to see how far your neck moves, so tell me where it pinches. Look left."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.25,
      "end_seconds": 170.36,
      "duration_seconds": 2.11,
      "text": "That's fine. ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.12,
      "end_seconds": 177.86,
      "duration_seconds": 3.74,
      "text": "Now over your right shoulder. ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.27,
      "end_seconds": 183.84,
      "duration_seconds": 2.57,
      "text": "Ow. That's it. ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.63,
      "end_seconds": 196.83,
      "duration_seconds": 9.2,
      "text": "Right, no fever and no worrying signs. This is a muscle strain from the awkward position. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.26,
      "end_seconds": 204.72,
      "duration_seconds": 4.46,
      "text": "How long will it take to settle? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.32,
      "end_seconds": 214.93,
      "duration_seconds": 6.61,
      "text": "Usually three to seven days. It should be a bit better each day. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.98,
      "end_seconds": 221.93,
      "duration_seconds": 2.95,
      "text": "Should I rest it? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.68,
      "end_seconds": 234.17,
      "duration_seconds": 9.49,
      "text": "Not completely. Gentle movement is better than keeping still. A warm pack on the muscle for twenty minutes helps."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.14,
      "end_seconds": 241.1,
      "duration_seconds": 3.96,
      "text": "I have a wheat bag. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.99,
      "end_seconds": 250.8,
      "duration_seconds": 5.81,
      "text": "Perfect. Use one pillow that keeps your neck level, not two. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.5,
      "end_seconds": 258.99,
      "duration_seconds": 4.49,
      "text": "I'll get rid of the brick. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.8,
      "end_seconds": 269.74,
      "duration_seconds": 7.94,
      "text": "Take care with sudden movements, and avoid carrying a heavy bag on that shoulder. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.3,
      "end_seconds": 276.98,
      "duration_seconds": 3.68,
      "text": "And should I come back? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.92,
      "end_seconds": 293.78,
      "duration_seconds": 13.86,
      "text": "Only if it's still bad after a week, or if you get weakness or numbness in the arm, a fever, or a severe headache."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.92,
      "end_seconds": 299.76,
      "duration_seconds": 2.84,
      "text": "Understood. Thank you. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.38,
      "end_seconds": 306.01,
      "duration_seconds": 3.63,
      "text": "Hope the neck loosens up. ~"
    }
  ]
}
