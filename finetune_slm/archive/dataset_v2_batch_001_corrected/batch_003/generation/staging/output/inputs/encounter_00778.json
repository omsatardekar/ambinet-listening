{
  "schema_version": "1.0",
  "encounter_id": "00778",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 3.9,
      "end_seconds": 6.76,
      "duration_seconds": 2.86,
      "text": "Follow-up. The bowel thing."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.88,
      "end_seconds": 18.98,
      "duration_seconds": 8.1,
      "text": "Right, you've been on the fibre treatment for six weeks. How are things?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.93,
      "end_seconds": 26.71,
      "duration_seconds": 3.78,
      "text": "Bit better. Still up and down."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.38,
      "end_seconds": 33.11,
      "duration_seconds": 2.73,
      "text": "Describe up and down."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.9,
      "end_seconds": 43.73,
      "duration_seconds": 5.83,
      "text": "Constipated for three days, then loose. Then fine. Then again."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.56,
      "end_seconds": 49.42,
      "duration_seconds": 1.86,
      "text": "Any pain?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.67,
      "end_seconds": 57.69,
      "duration_seconds": 4.02,
      "text": "Cramping. Lower left. Eases when I go."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.77,
      "end_seconds": 64.89,
      "duration_seconds": 3.12,
      "text": "Any blood in the stool?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.58,
      "end_seconds": 69.5,
      "duration_seconds": 0.92,
      "text": "No."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.14,
      "end_seconds": 76.01,
      "duration_seconds": 1.87,
      "text": "Weight loss?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.59,
      "end_seconds": 82.18,
      "duration_seconds": 1.59,
      "text": "No. Same."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.87,
      "end_seconds": 90.72,
      "duration_seconds": 4.85,
      "text": "Any waking at night to open your bowels?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.59,
      "end_seconds": 96.46,
      "duration_seconds": 1.87,
      "text": "No. Sleep through."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.03,
      "end_seconds": 102.12,
      "duration_seconds": 1.09,
      "text": "Allergies?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.0,
      "end_seconds": 107.06,
      "duration_seconds": 1.06,
      "text": "None."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.35,
      "end_seconds": 114.61,
      "duration_seconds": 3.26,
      "text": "Remind me, what are you taking?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.97,
      "end_seconds": 123.01,
      "duration_seconds": 4.04,
      "text": "Ispaghula husk. One sachet. Once a day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.93,
      "end_seconds": 129.2,
      "duration_seconds": 2.27,
      "text": "And your history?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.28,
      "end_seconds": 137.88,
      "duration_seconds": 4.6,
      "text": "Irritable bowel. Diagnosed last year. And hay fever."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.01,
      "end_seconds": 145.13,
      "duration_seconds": 3.12,
      "text": "Do you drink coffee, or alcohol?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.84,
      "end_seconds": 152.01,
      "duration_seconds": 3.17,
      "text": "Four coffees. Couple of beers weekends."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.01,
      "end_seconds": 171.21,
      "duration_seconds": 3.2,
      "text": "Let me check your tummy."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.46,
      "end_seconds": 177.35,
      "duration_seconds": 1.89,
      "text": "Fine. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.2,
      "end_seconds": 188.09,
      "duration_seconds": 6.89,
      "text": "Soft, a bit of tenderness on the lower left, no masses, nothing worrying."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.76,
      "end_seconds": 194.72,
      "duration_seconds": 1.96,
      "text": "So? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.6,
      "end_seconds": 211.93,
      "duration_seconds": 13.33,
      "text": "Alternating bowels with cramps that ease on opening them, normal tests so far, fits with irritable bowel. I'd call it irritable bowel syndrome with mixed bowel habit."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.69,
      "end_seconds": 219.11,
      "duration_seconds": 2.42,
      "text": "What now? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.95,
      "end_seconds": 232.32,
      "duration_seconds": 9.37,
      "text": "Keep the husk going, with plenty of water. It takes at least twelve weeks to judge. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.63,
      "end_seconds": 238.34,
      "duration_seconds": 1.71,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.61,
      "end_seconds": 249.96,
      "duration_seconds": 7.35,
      "text": "Cut the coffee to two a day, eat regularly, and try peppermint tea."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.13,
      "end_seconds": 255.96,
      "duration_seconds": 1.83,
      "text": "Peppermint. Fine. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.88,
      "end_seconds": 268.02,
      "duration_seconds": 8.14,
      "text": "And there's one blood test I'd like to check, a coeliac screen, as it can mimic this."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.94,
      "end_seconds": 273.34,
      "duration_seconds": 1.4,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.1,
      "end_seconds": 285.13,
      "duration_seconds": 7.03,
      "text": "If you notice blood, weight loss, or night-time diarrhoea, come back at once."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.85,
      "end_seconds": 291.13,
      "duration_seconds": 2.28,
      "text": "Will do. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.8,
      "end_seconds": 299.72,
      "duration_seconds": 4.92,
      "text": "Otherwise, I'll see you if it's not settling. ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.31,
      "end_seconds": 306.0,
      "duration_seconds": 1.69,
      "text": "Thanks. ~"
    }
  ]
}
