{
  "schema_version": "1.0",
  "encounter_id": "00913",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.65,
      "end_seconds": 13.21,
      "duration_seconds": 11.56,
      "text": "Hello, doctor. The surgery rang to say my calcium was high on a routine blood test, and I'm not sure what that means."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 15.33,
      "end_seconds": 22.99,
      "duration_seconds": 7.66,
      "text": "I'm her daughter, I came along because Mum gets confused with medical talk. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.71,
      "end_seconds": 35.91,
      "duration_seconds": 10.2,
      "text": "Thank you both for coming. A high calcium result is something we should look into. Have you noticed any symptoms?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.31,
      "end_seconds": 43.36,
      "duration_seconds": 5.05,
      "text": "I've been tired lately, I suppose. And thirsty."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 45.75,
      "end_seconds": 50.98,
      "duration_seconds": 5.23,
      "text": "She's been constipated too, she told me last week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.51,
      "end_seconds": 57.87,
      "duration_seconds": 4.36,
      "text": "How long has the tiredness been going on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.64,
      "end_seconds": 67.81,
      "duration_seconds": 8.17,
      "text": "Oh, a couple of months, I'd say. I put it down to the weather."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.91,
      "end_seconds": 73.88,
      "duration_seconds": 3.97,
      "text": "Any tummy pain, nausea, or bone pain?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.98,
      "end_seconds": 80.33,
      "duration_seconds": 4.35,
      "text": "No pain in the bones. No nausea."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.92,
      "end_seconds": 87.17,
      "duration_seconds": 3.25,
      "text": "Any kidney stones in the past?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.2,
      "end_seconds": 92.01,
      "duration_seconds": 1.81,
      "text": "No. Never."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.84,
      "end_seconds": 97.29,
      "duration_seconds": 3.45,
      "text": "What medicines are you taking?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.69,
      "end_seconds": 108.16,
      "duration_seconds": 7.47,
      "text": "Just a calcium and vitamin D tablet, one a day, for my bones."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 111.27,
      "end_seconds": 118.23,
      "duration_seconds": 6.96,
      "text": "No, Mum, it's two a day. I fill the dosette box."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.5,
      "end_seconds": 127.28,
      "duration_seconds": 5.78,
      "text": "Is it? I only take the one in the morning."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 129.32,
      "end_seconds": 137.55,
      "duration_seconds": 8.23,
      "text": "You take one in the morning and one at night, I see you do it."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.47,
      "end_seconds": 148.82,
      "duration_seconds": 9.35,
      "text": "I'll note that the two of you remember it differently, and we'll check the pharmacy record."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 151.67,
      "end_seconds": 157.42,
      "duration_seconds": 5.75,
      "text": "I can ring the pharmacy while you're talking, doctor. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.76,
      "end_seconds": 166.41,
      "duration_seconds": 5.65,
      "text": "Please do. Do you have any allergies to medicines?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.68,
      "end_seconds": 171.38,
      "duration_seconds": 1.7,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.0,
      "end_seconds": 177.28,
      "duration_seconds": 2.28,
      "text": "Any other conditions?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.94,
      "end_seconds": 184.11,
      "duration_seconds": 4.17,
      "text": "Osteoporosis. That's why I take the tablets."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.08,
      "end_seconds": 189.07,
      "duration_seconds": 2.99,
      "text": "Do you smoke or drink?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.28,
      "end_seconds": 194.85,
      "duration_seconds": 3.57,
      "text": "No smoking. A sherry at Christmas."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 196.9,
      "end_seconds": 202.84,
      "duration_seconds": 5.94,
      "text": "Doctor, I've checked her observations. Pulse 68, blood pressure 138 over 80."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.66,
      "end_seconds": 216.45,
      "duration_seconds": 10.79,
      "text": "Thank you. These are fine. I'd like to feel your neck and tummy, if you don't mind. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.22,
      "end_seconds": 233.86,
      "duration_seconds": 1.64,
      "text": "Go on."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.8,
      "end_seconds": 241.34,
      "duration_seconds": 5.54,
      "text": "No lumps in the neck, and your abdomen is soft."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 243.65,
      "end_seconds": 246.93,
      "duration_seconds": 3.28,
      "text": "What causes a high calcium? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.73,
      "end_seconds": 263.5,
      "duration_seconds": 13.77,
      "text": "Several things, including too much calcium from tablets, or an overactive gland in the neck. Right now I can't say which it is. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 266.99,
      "end_seconds": 271.81,
      "duration_seconds": 4.82,
      "text": "The pharmacy confirms two tablets a day, doctor. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.22,
      "end_seconds": 281.37,
      "duration_seconds": 7.15,
      "text": "Thank you. Then that is the first thing to adjust. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.94,
      "end_seconds": 288.22,
      "duration_seconds": 3.28,
      "text": "Should I stop them? ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.58,
      "end_seconds": 299.81,
      "duration_seconds": 9.23,
      "text": "Please hold them until I have the repeat blood test, and I'll phone you with the result."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.2,
      "end_seconds": 305.99,
      "duration_seconds": 2.79,
      "text": "All right. Thank you. ~"
    }
  ]
}
