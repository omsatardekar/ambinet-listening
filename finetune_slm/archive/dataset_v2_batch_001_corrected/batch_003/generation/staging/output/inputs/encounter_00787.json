{
  "schema_version": "1.0",
  "encounter_id": "00787",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.51,
      "end_seconds": 12.79,
      "duration_seconds": 12.28,
      "text": "Hi, doctor. It's my toe, and I'm a bit squeamish about all this, sorry. It's an ingrown toenail, I think. It's really sore."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.79,
      "end_seconds": 17.71,
      "duration_seconds": 3.92,
      "text": "No need to apologise. Which toe?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.59,
      "end_seconds": 29.14,
      "duration_seconds": 9.55,
      "text": "The big toe on my left foot, the outside edge. It's red, swollen, and a bit yellowy at the corner."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.77,
      "end_seconds": 34.62,
      "duration_seconds": 3.85,
      "text": "How long has it been like that?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.2,
      "end_seconds": 44.85,
      "duration_seconds": 7.65,
      "text": "A week. It got much worse in the last three days. It throbs at night."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.02,
      "end_seconds": 49.02,
      "duration_seconds": 3.0,
      "text": "Any fever, or shivering?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.73,
      "end_seconds": 54.45,
      "duration_seconds": 3.72,
      "text": "No fever. I've felt fine, otherwise."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.15,
      "end_seconds": 60.46,
      "duration_seconds": 4.31,
      "text": "Is there pus, or has it been bleeding?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.8,
      "end_seconds": 66.33,
      "duration_seconds": 4.53,
      "text": "Some pus, yes, a little. But no blood."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.85,
      "end_seconds": 72.71,
      "duration_seconds": 3.86,
      "text": "Any numbness in the toe? ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.5,
      "end_seconds": 79.32,
      "duration_seconds": 4.82,
      "text": "No, I can feel everything, unfortunately. ~"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.05,
      "end_seconds": 85.67,
      "duration_seconds": 3.62,
      "text": "Have you tried anything yourself? ~"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.3,
      "end_seconds": 97.65,
      "duration_seconds": 9.35,
      "text": "I soaked it in salt water, which helped a little, and I stopped wearing my work boots. ~"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.13,
      "end_seconds": 106.49,
      "duration_seconds": 6.36,
      "text": "Good. Let me look. Can you take your sock off? ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.47,
      "end_seconds": 128.77,
      "duration_seconds": 2.3,
      "text": "Oh dear. Okay."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.4,
      "end_seconds": 150.19,
      "duration_seconds": 18.79,
      "text": "The outer edge of the nail is digging into the skin, there's redness and swelling around it, and a little pus at the corner, but the redness doesn't spread up the toe."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.68,
      "end_seconds": 154.23,
      "duration_seconds": 2.55,
      "text": "Is it infected? ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.29,
      "end_seconds": 161.8,
      "duration_seconds": 4.51,
      "text": "Yes, it's mildly infected, an infected ingrown toenail."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.56,
      "end_seconds": 167.42,
      "duration_seconds": 3.86,
      "text": "Will you have to cut it? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.8,
      "end_seconds": 181.09,
      "duration_seconds": 11.29,
      "text": "Not today. I'd like to start with antibiotics, flucloxacillin, 500 mg, four times a day, for seven days. Have you had it before?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.53,
      "end_seconds": 189.78,
      "duration_seconds": 7.25,
      "text": "I've taken it once, for a cut, and it was fine. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.4,
      "end_seconds": 199.1,
      "duration_seconds": 6.7,
      "text": "Good. Take it on an empty stomach, half an hour before food."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.51,
      "end_seconds": 202.85,
      "duration_seconds": 1.34,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.44,
      "end_seconds": 215.0,
      "duration_seconds": 10.56,
      "text": "And I'd like to send a swab of the pus to the lab, to be sure the antibiotic's right."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.18,
      "end_seconds": 219.06,
      "duration_seconds": 2.88,
      "text": "Will it hurt? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.9,
      "end_seconds": 235.22,
      "duration_seconds": 4.32,
      "text": "Only a touch, it's a quick dab."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.37,
      "end_seconds": 239.26,
      "duration_seconds": 1.89,
      "text": "Done? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.22,
      "end_seconds": 252.81,
      "duration_seconds": 11.59,
      "text": "Done. Now, soak the toe in warm salty water for ten minutes, twice a day, and keep it clean and dry."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.52,
      "end_seconds": 258.45,
      "duration_seconds": 2.93,
      "text": "Right. And my shoes? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.32,
      "end_seconds": 268.22,
      "duration_seconds": 8.9,
      "text": "Open shoes or roomy ones, and don't trim the nail down at the corners. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.11,
      "end_seconds": 273.79,
      "duration_seconds": 4.68,
      "text": "I was trimming it at the corners. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.83,
      "end_seconds": 282.43,
      "duration_seconds": 5.6,
      "text": "That's often the cause. Cut it straight across. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.24,
      "end_seconds": 287.6,
      "duration_seconds": 2.36,
      "text": "I'll remember. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.83,
      "end_seconds": 300.75,
      "duration_seconds": 10.92,
      "text": "If you get a fever, redness spreading up your foot, or the pain gets worse, see us the same day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.61,
      "end_seconds": 306.02,
      "duration_seconds": 3.41,
      "text": "I will. Thank you. ~"
    }
  ]
}
