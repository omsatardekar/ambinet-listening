{
  "schema_version": "1.0",
  "encounter_id": "00866",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 2.52,
      "end_seconds": 14.64,
      "duration_seconds": 12.12,
      "text": "Um, hello. I've had diarrhoea, I'm sorry to say, for ten days now, since I got back from holiday. It's not stopping."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.4,
      "end_seconds": 20.35,
      "duration_seconds": 2.95,
      "text": "Where were you? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.47,
      "end_seconds": 32.2,
      "duration_seconds": 8.73,
      "text": "Egypt. A week in Hurghada. I was fine there, mostly, then it started on the flight home."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.2,
      "end_seconds": 38.52,
      "duration_seconds": 3.32,
      "text": "How often are you going?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.11,
      "end_seconds": 49.77,
      "duration_seconds": 7.66,
      "text": "Five or six times a day. Watery. And I've lost my appetite."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.9,
      "end_seconds": 56.2,
      "duration_seconds": 2.3,
      "text": "Any tummy pain?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.7,
      "end_seconds": 63.95,
      "duration_seconds": 4.25,
      "text": "Cramping, before I go. Then it eases."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.52,
      "end_seconds": 71.29,
      "duration_seconds": 3.77,
      "text": "Any blood, or mucus, in the stool?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.04,
      "end_seconds": 76.95,
      "duration_seconds": 2.91,
      "text": "No. No blood. Just watery."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.73,
      "end_seconds": 82.91,
      "duration_seconds": 2.18,
      "text": "Any fever? ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.6,
      "end_seconds": 91.99,
      "duration_seconds": 5.39,
      "text": "A bit hot, the first few days. Not now. ~"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.08,
      "end_seconds": 98.6,
      "duration_seconds": 2.52,
      "text": "What are you taking?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.29,
      "end_seconds": 111.0,
      "duration_seconds": 9.71,
      "text": "Omeprazole, 20 mg, once a day. And loperamide, I think, 2 mg, when I need to go out."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.41,
      "end_seconds": 118.06,
      "duration_seconds": 3.65,
      "text": "Does the loperamide help? ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.37,
      "end_seconds": 125.71,
      "duration_seconds": 4.34,
      "text": "A bit. For a few hours. ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.5,
      "end_seconds": 130.29,
      "duration_seconds": 1.79,
      "text": "Any other conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.95,
      "end_seconds": 135.32,
      "duration_seconds": 1.37,
      "text": "Acid reflux."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.3,
      "end_seconds": 141.28,
      "duration_seconds": 1.98,
      "text": "Any operations?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.72,
      "end_seconds": 147.29,
      "duration_seconds": 2.57,
      "text": "My gallbladder, in 2016."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.35,
      "end_seconds": 158.15,
      "duration_seconds": 6.8,
      "text": "Did you eat anything unusual, salads, ice, or drink tap water? ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.87,
      "end_seconds": 168.67,
      "duration_seconds": 6.8,
      "text": "Ice in my drinks. And a buffet. I know, I know. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.48,
      "end_seconds": 194.35,
      "duration_seconds": 5.87,
      "text": "That's the usual story. Let me press your tummy. Lie back."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.29,
      "end_seconds": 198.86,
      "duration_seconds": 1.57,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.07,
      "end_seconds": 213.19,
      "duration_seconds": 10.12,
      "text": "Your tummy is soft with mild general tenderness, and no guarding. Your mouth is slightly dry. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.27,
      "end_seconds": 219.4,
      "duration_seconds": 3.13,
      "text": "Is it serious? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.29,
      "end_seconds": 234.7,
      "duration_seconds": 12.41,
      "text": "Persistent traveller's diarrhoea after ten days, I'd say it's likely a gut infection picked up abroad, possibly a parasite like giardia, though bacteria are also possible."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.81,
      "end_seconds": 242.11,
      "duration_seconds": 3.3,
      "text": "What do I do? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.8,
      "end_seconds": 251.77,
      "duration_seconds": 6.97,
      "text": "I'd like to send a stool sample, to look for bacteria and parasites."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.57,
      "end_seconds": 256.43,
      "duration_seconds": 1.86,
      "text": "Fine. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.19,
      "end_seconds": 266.89,
      "duration_seconds": 7.7,
      "text": "Please drink plenty of fluids with some salt and sugar, and eat plain food."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.66,
      "end_seconds": 271.26,
      "duration_seconds": 1.6,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.4,
      "end_seconds": 282.38,
      "duration_seconds": 6.98,
      "text": "Don't take the loperamide if you get a fever or blood in the stool."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.49,
      "end_seconds": 287.54,
      "duration_seconds": 2.05,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.36,
      "end_seconds": 300.46,
      "duration_seconds": 9.1,
      "text": "If you get blood, a high fever, severe pain, or can't keep fluids down, come back at once."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.26,
      "end_seconds": 306.0,
      "duration_seconds": 2.74,
      "text": "I will. Thanks. ~"
    }
  ]
}
