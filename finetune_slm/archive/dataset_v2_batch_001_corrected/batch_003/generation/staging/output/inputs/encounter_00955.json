{
  "schema_version": "1.0",
  "encounter_id": "00955",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 1.78,
      "end_seconds": 13.88,
      "duration_seconds": 12.1,
      "text": "Mr Reilly, I wanted to talk about your vitamin D. It came back low. Do you know why you were tested? ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.29,
      "end_seconds": 23.27,
      "duration_seconds": 5.98,
      "text": "My wife made me. I'm tired, I guess. For about four months."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.4,
      "end_seconds": 30.31,
      "duration_seconds": 4.91,
      "text": "Tired how? All day, or at certain times?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.21,
      "end_seconds": 37.09,
      "duration_seconds": 3.88,
      "text": "All day. I wake up tired."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.06,
      "end_seconds": 45.62,
      "duration_seconds": 6.56,
      "text": "That's what low vitamin D can do. How's your mood? ~"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.77,
      "end_seconds": 51.44,
      "duration_seconds": 2.67,
      "text": "Fine. Just flat. ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.16,
      "end_seconds": 57.4,
      "duration_seconds": 3.24,
      "text": "Are you outdoors much? ~"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.91,
      "end_seconds": 68.61,
      "duration_seconds": 8.7,
      "text": "Not really. I'm at a desk. I leave in the dark, I come home in the dark. ~"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.0,
      "end_seconds": 79.05,
      "duration_seconds": 8.05,
      "text": "That's most of the winter, then. And what do you eat, any fish, eggs? ~"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.64,
      "end_seconds": 84.2,
      "duration_seconds": 3.56,
      "text": "Some eggs. Not much fish. ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.64,
      "end_seconds": 103.27,
      "duration_seconds": 7.63,
      "text": "Let me take two quick numbers. Blood pressure 122 over 76, pulse 70."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.86,
      "end_seconds": 106.94,
      "duration_seconds": 2.08,
      "text": "That's fine? ~"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.6,
      "end_seconds": 122.6,
      "duration_seconds": 6.0,
      "text": "That's fine. Let me press on a few places."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.57,
      "end_seconds": 127.15,
      "duration_seconds": 2.58,
      "text": "Go ahead. ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.12,
      "end_seconds": 136.23,
      "duration_seconds": 6.11,
      "text": "I'm pressing over the shin bone. Any tenderness? ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.97,
      "end_seconds": 141.72,
      "duration_seconds": 2.75,
      "text": "A little. Mm. ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.22,
      "end_seconds": 155.18,
      "duration_seconds": 10.96,
      "text": "There's mild tenderness over the shin bones, and the muscles of the thighs are slightly sore when I squeeze them."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.15,
      "end_seconds": 161.02,
      "duration_seconds": 3.87,
      "text": "Yes, my legs ache sometimes. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.7,
      "end_seconds": 168.39,
      "duration_seconds": 5.69,
      "text": "Any numbness or tingling in your hands or feet?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.91,
      "end_seconds": 173.04,
      "duration_seconds": 3.13,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.24,
      "end_seconds": 192.19,
      "duration_seconds": 16.95,
      "text": "What I think is happening is that low vitamin D could be behind your tiredness, but I can't rule out other causes, so I won't say it's the whole story."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.46,
      "end_seconds": 198.57,
      "duration_seconds": 3.11,
      "text": "What else could it be? ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.69,
      "end_seconds": 208.82,
      "duration_seconds": 8.13,
      "text": "Lots of things cause tiredness, sleep, stress, the winter. But we'll start with the simple fix. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.76,
      "end_seconds": 213.55,
      "duration_seconds": 2.79,
      "text": "What's the fix? ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.44,
      "end_seconds": 222.38,
      "duration_seconds": 6.94,
      "text": "More daylight, even in winter. A walk at lunch, for twenty minutes."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.82,
      "end_seconds": 227.5,
      "duration_seconds": 2.68,
      "text": "I can do that. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.21,
      "end_seconds": 235.53,
      "duration_seconds": 6.32,
      "text": "And eat oily fish, like salmon or mackerel, twice a week, and eggs."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.34,
      "end_seconds": 240.21,
      "duration_seconds": 1.87,
      "text": "Mackerel. Okay. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.43,
      "end_seconds": 249.24,
      "duration_seconds": 6.81,
      "text": "Keep a note of how your energy is over the next few weeks."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.39,
      "end_seconds": 253.8,
      "duration_seconds": 1.41,
      "text": "Sure. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.18,
      "end_seconds": 260.69,
      "duration_seconds": 3.51,
      "text": "Any questions for me? ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.98,
      "end_seconds": 265.39,
      "duration_seconds": 2.41,
      "text": "Is it serious? ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.85,
      "end_seconds": 273.98,
      "duration_seconds": 5.13,
      "text": "Not at all. It's very common, and fixable. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.92,
      "end_seconds": 281.42,
      "duration_seconds": 5.5,
      "text": "Good. I'll tell my wife she was right. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.67,
      "end_seconds": 287.69,
      "duration_seconds": 3.02,
      "text": "She sounds sensible. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.41,
      "end_seconds": 292.68,
      "duration_seconds": 2.27,
      "text": "She is. ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.01,
      "end_seconds": 299.05,
      "duration_seconds": 4.04,
      "text": "Anything else on your mind today? ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.53,
      "end_seconds": 305.99,
      "duration_seconds": 3.46,
      "text": "No, that's it. Thanks, doctor. ~"
    }
  ]
}
