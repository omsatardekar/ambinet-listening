{
  "schema_version": "1.0",
  "encounter_id": "00929",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 3.13,
      "end_seconds": 15.66,
      "duration_seconds": 12.53,
      "text": "I had COVID back in the spring, and I'm still breathless. I thought I'd be back to normal by now."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.31,
      "end_seconds": 28.42,
      "duration_seconds": 9.11,
      "text": "I'm sorry to hear that, and it's more common than people think. Tell me what the breathlessness is like."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.5,
      "end_seconds": 38.97,
      "duration_seconds": 7.47,
      "text": "Walking up a hill, or the stairs at work. I have to stop halfway."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.95,
      "end_seconds": 47.55,
      "duration_seconds": 4.6,
      "text": "Before COVID, could you manage those without any trouble?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.89,
      "end_seconds": 56.6,
      "duration_seconds": 5.71,
      "text": "Easily. I used to run five kilometres on a Saturday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.95,
      "end_seconds": 65.27,
      "duration_seconds": 4.32,
      "text": "Are you coughing, or bringing anything up?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.2,
      "end_seconds": 73.51,
      "duration_seconds": 4.31,
      "text": "A dry cough, now and again. Nothing much."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.52,
      "end_seconds": 82.4,
      "duration_seconds": 4.88,
      "text": "Any chest pain, wheeze, or swelling in your legs?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.42,
      "end_seconds": 92.55,
      "duration_seconds": 6.13,
      "text": "No chest pain. No wheeze. My legs are fine."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.98,
      "end_seconds": 99.58,
      "duration_seconds": 3.6,
      "text": "Any fever, or night sweats?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.59,
      "end_seconds": 106.28,
      "duration_seconds": 2.69,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.13,
      "end_seconds": 113.26,
      "duration_seconds": 3.13,
      "text": "Are you taking any medicines?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.01,
      "end_seconds": 124.95,
      "duration_seconds": 7.94,
      "text": "A blue inhaler, salbutamol, two puffs, when I need it, and vitamin D, 1000 units a day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.21,
      "end_seconds": 132.71,
      "duration_seconds": 3.5,
      "text": "Does the inhaler help? ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.72,
      "end_seconds": 140.24,
      "duration_seconds": 4.52,
      "text": "Not really. I don't notice a difference. ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.26,
      "end_seconds": 145.52,
      "duration_seconds": 2.26,
      "text": "Any past medical history?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.31,
      "end_seconds": 156.62,
      "duration_seconds": 7.31,
      "text": "High blood pressure, controlled with diet, and an appendix removal when I was twenty."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.42,
      "end_seconds": 168.15,
      "duration_seconds": 7.73,
      "text": "And how were you treated for COVID? Were you in hospital? ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.44,
      "end_seconds": 177.94,
      "duration_seconds": 6.5,
      "text": "No, I managed at home. But it was a rough fortnight. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.15,
      "end_seconds": 189.88,
      "duration_seconds": 8.73,
      "text": "Thank you. I'd like to listen to your chest, and check your oxygen when you walk. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.69,
      "end_seconds": 210.14,
      "duration_seconds": 1.45,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.58,
      "end_seconds": 220.6,
      "duration_seconds": 7.02,
      "text": "Your chest sounds clear, with good air entry on both sides. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.91,
      "end_seconds": 226.66,
      "duration_seconds": 2.75,
      "text": "So nothing wrong? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.99,
      "end_seconds": 242.9,
      "duration_seconds": 11.91,
      "text": "Nothing obvious on listening. I'd like to arrange a chest X-ray, and a breathing test called spirometry, to check how your lungs are working."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.08,
      "end_seconds": 249.93,
      "duration_seconds": 3.85,
      "text": "When can I have those? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.03,
      "end_seconds": 257.96,
      "duration_seconds": 4.93,
      "text": "Both within two weeks. I'll arrange them today. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.16,
      "end_seconds": 265.87,
      "duration_seconds": 3.71,
      "text": "And will I get better? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.62,
      "end_seconds": 281.52,
      "duration_seconds": 11.9,
      "text": "Most people do, but it can take months. Pace yourself, and build up gentle walking a little each week."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.97,
      "end_seconds": 287.27,
      "duration_seconds": 2.3,
      "text": "I'll try. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.87,
      "end_seconds": 298.26,
      "duration_seconds": 7.39,
      "text": "I'd like to see you again in three weeks, with the results in hand."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.49,
      "end_seconds": 305.99,
      "duration_seconds": 3.5,
      "text": "Three weeks. Thank you. ~"
    }
  ]
}
