{
  "schema_version": "1.0",
  "encounter_id": "00935",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 0.48,
      "end_seconds": 12.91,
      "duration_seconds": 12.43,
      "text": "Doctor, thank you for seeing us, I'm still shaking. Nuala swallowed a little battery, the flat round kind from the remote, and I've not slept since."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.86,
      "end_seconds": 21.73,
      "duration_seconds": 7.87,
      "text": "I'd be shaking too. Take a breath. She's well in herself now? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 22.64,
      "end_seconds": 29.69,
      "duration_seconds": 7.05,
      "text": "She's grand, she's playing like nothing happened. But I need to know it's safe. ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.23,
      "end_seconds": 36.52,
      "duration_seconds": 5.29,
      "text": "Let's go through it. When did she swallow it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 37.43,
      "end_seconds": 41.22,
      "duration_seconds": 3.79,
      "text": "Yesterday morning. It was only yesterday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.34,
      "end_seconds": 47.3,
      "duration_seconds": 3.96,
      "text": "Two days ago! I did it!"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.47,
      "end_seconds": 60.05,
      "duration_seconds": 11.58,
      "text": "Nuala says two days, Mum says yesterday. So somewhere between one and two days. Did she gag, cough, anything?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 61.7,
      "end_seconds": 70.75,
      "duration_seconds": 9.05,
      "text": "She gagged a bit and went red in the face, then it settled and she was fine."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.35,
      "end_seconds": 75.81,
      "duration_seconds": 2.46,
      "text": "Any tummy pain since?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 76.51,
      "end_seconds": 86.31,
      "duration_seconds": 9.8,
      "text": "She was clutching her tummy last night, but it's gone now. She's been eating a full dinner and she's laughing."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.52,
      "end_seconds": 90.99,
      "duration_seconds": 3.47,
      "text": "Right. What does she take, Mum?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 92.29,
      "end_seconds": 107.16,
      "duration_seconds": 14.87,
      "text": "Paracetamol syrup, 5 ml, when she needs it, which hasn't been today. And the little yellow drops, for her iron, I can't remember what they're called."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.97,
      "end_seconds": 113.84,
      "duration_seconds": 5.87,
      "text": "We'll find the drops on her record. Any allergies in Nuala?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 116.63,
      "end_seconds": 118.94,
      "duration_seconds": 2.31,
      "text": "None. No allergies."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.14,
      "end_seconds": 126.82,
      "duration_seconds": 5.68,
      "text": "Any health problems she was born with, or since?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 127.65,
      "end_seconds": 131.23,
      "duration_seconds": 3.58,
      "text": "Eczema, a bit, on her cheeks."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.39,
      "end_seconds": 133.81,
      "duration_seconds": 1.42,
      "text": "Any operations?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 136.58,
      "end_seconds": 143.31,
      "duration_seconds": 6.73,
      "text": "They snipped her tongue-tie when she was a week old."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.45,
      "end_seconds": 151.54,
      "duration_seconds": 6.09,
      "text": "And at home, is there a lot around that she could reach?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 152.29,
      "end_seconds": 160.42,
      "duration_seconds": 8.13,
      "text": "Two parents, a baby brother, and a house full of remotes. That's the problem."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.84,
      "end_seconds": 176.35,
      "duration_seconds": 6.51,
      "text": "Let me check her. Nuala, will you hold my torch?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.33,
      "end_seconds": 179.28,
      "duration_seconds": 1.95,
      "text": "Torch! ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.76,
      "end_seconds": 204.7,
      "duration_seconds": 10.94,
      "text": "Good girl. Temperature 36.7, pulse 112, breathing 24, oxygen 99 percent, weight 14.5 kilos, and height 95 centimetres."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 206.4,
      "end_seconds": 209.58,
      "duration_seconds": 3.18,
      "text": "Are those all right? ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.58,
      "end_seconds": 226.47,
      "duration_seconds": 5.89,
      "text": "All normal for her age. I'm pressing her tummy now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.95,
      "end_seconds": 229.29,
      "duration_seconds": 1.34,
      "text": "Tickles! ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.85,
      "end_seconds": 237.36,
      "duration_seconds": 5.51,
      "text": "Her tummy is soft and she isn't tender anywhere."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 239.31,
      "end_seconds": 241.4,
      "duration_seconds": 2.09,
      "text": "Thank God. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.84,
      "end_seconds": 247.57,
      "duration_seconds": 4.73,
      "text": "And her mouth and throat look completely normal."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 250.14,
      "end_seconds": 255.94,
      "duration_seconds": 5.8,
      "text": "She drank a whole glass of milk this morning. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.4,
      "end_seconds": 267.67,
      "duration_seconds": 9.27,
      "text": "It sounds as though the battery has passed through, since she's well, eating, and the pain has gone."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 268.59,
      "end_seconds": 271.51,
      "duration_seconds": 2.92,
      "text": "So it's out? ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.2,
      "end_seconds": 283.88,
      "duration_seconds": 10.68,
      "text": "Most likely. But batteries are dangerous, so please keep every one locked away, and check the remotes have screwed-on lids."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 286.14,
      "end_seconds": 289.8,
      "duration_seconds": 3.66,
      "text": "I'll do it tonight. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.11,
      "end_seconds": 301.03,
      "duration_seconds": 8.92,
      "text": "If she vomits, has black stools, or any blood, go straight to the emergency department."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 303.58,
      "end_seconds": 306.02,
      "duration_seconds": 2.44,
      "text": "Straight away, yes. ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.65,
      "end_seconds": 316.25,
      "duration_seconds": 7.6,
      "text": "I'd like to see you again in a week to check how she's doing."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 317.53,
      "end_seconds": 324.09,
      "duration_seconds": 6.56,
      "text": "A week. Thank you, doctor, thank you so much. ~"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.12,
      "end_seconds": 327.62,
      "duration_seconds": 2.5,
      "text": "Bye-bye, doctor! ~"
    }
  ]
}
