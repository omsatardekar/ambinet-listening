{
  "schema_version": "1.0",
  "encounter_id": "00960",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 0.82,
      "end_seconds": 20.48,
      "duration_seconds": 19.66,
      "text": "Dr Stein, this is Mrs Dawn Pearce. Her obs: blood pressure 142 over 86, pulse 76, temperature 36.6, oxygen 98 percent, breathing 16, weight 84 kilos. She's got a screening letter and a bit of a story."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.47,
      "end_seconds": 28.83,
      "duration_seconds": 6.36,
      "text": "Thanks, nurse. Dawn, come in, sit down. Tell me about the letter. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.8,
      "end_seconds": 52.72,
      "duration_seconds": 20.92,
      "text": "Oh, yes, lovely to see you, doctor. I got a letter from the eye screening people, and I thought, well, I'd better ask someone, because I've been seeing a bit blurry at times. Honestly, I'm so busy, and I don't know when it started."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.29,
      "end_seconds": 58.19,
      "duration_seconds": 3.9,
      "text": "When roughly? Last month, last year?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.16,
      "end_seconds": 66.43,
      "duration_seconds": 6.27,
      "text": "Hmm. I couldn't say. Sometime in the summer? Or the one before?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.92,
      "end_seconds": 74.37,
      "duration_seconds": 6.45,
      "text": "Fine. Is the blurring in one eye or both? ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.94,
      "end_seconds": 80.61,
      "duration_seconds": 4.67,
      "text": "Both, usually in the evening, when I'm reading. ~"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.31,
      "end_seconds": 84.69,
      "duration_seconds": 3.38,
      "text": "Any floaters, little dark spots?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.96,
      "end_seconds": 93.02,
      "duration_seconds": 6.06,
      "text": "A few, yes, drifting about. I thought it was dust."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.37,
      "end_seconds": 98.48,
      "duration_seconds": 3.11,
      "text": "Anything in your feet?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.71,
      "end_seconds": 105.1,
      "duration_seconds": 5.39,
      "text": "Tingling, yes. In the toes, mostly at night."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.37,
      "end_seconds": 110.67,
      "duration_seconds": 3.3,
      "text": "Are you thirsty a lot?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.12,
      "end_seconds": 119.45,
      "duration_seconds": 7.33,
      "text": "A bit more than usual. I'm always filling up my water bottle."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.78,
      "end_seconds": 123.51,
      "duration_seconds": 1.73,
      "text": "And tired?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.34,
      "end_seconds": 126.73,
      "duration_seconds": 1.39,
      "text": "Always."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.76,
      "end_seconds": 132.07,
      "duration_seconds": 3.31,
      "text": "Any pain in the eyes?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.88,
      "end_seconds": 136.55,
      "duration_seconds": 2.67,
      "text": "No eye pain."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.84,
      "end_seconds": 144.16,
      "duration_seconds": 6.32,
      "text": "Any sudden loss of vision, like a curtain coming down?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.18,
      "end_seconds": 147.58,
      "duration_seconds": 2.4,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.87,
      "end_seconds": 151.67,
      "duration_seconds": 1.8,
      "text": "Flashing lights?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.52,
      "end_seconds": 155.16,
      "duration_seconds": 1.64,
      "text": "No flashes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.43,
      "end_seconds": 159.74,
      "duration_seconds": 3.31,
      "text": "What medication are you taking?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.92,
      "end_seconds": 167.2,
      "duration_seconds": 6.28,
      "text": "Metformin, maybe 1000 mg, twice a day. I'd have to check the box."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.62,
      "end_seconds": 170.18,
      "duration_seconds": 1.56,
      "text": "And allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.98,
      "end_seconds": 172.6,
      "duration_seconds": 1.62,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.53,
      "end_seconds": 175.11,
      "duration_seconds": 1.58,
      "text": "Medical history?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.31,
      "end_seconds": 182.44,
      "duration_seconds": 6.13,
      "text": "Type 2 diabetes, for about eight years. And high blood pressure."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.86,
      "end_seconds": 186.28,
      "duration_seconds": 1.42,
      "text": "Surgery?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.73,
      "end_seconds": 195.05,
      "duration_seconds": 7.32,
      "text": "Cataract in the right eye, in 2022, and a hysterectomy in 2005."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.95,
      "end_seconds": 200.8,
      "duration_seconds": 2.85,
      "text": "Diabetes in the family?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.2,
      "end_seconds": 204.76,
      "duration_seconds": 2.56,
      "text": "My mother had it."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.11,
      "end_seconds": 210.36,
      "duration_seconds": 3.25,
      "text": "What did you do for work?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.06,
      "end_seconds": 216.09,
      "duration_seconds": 3.03,
      "text": "Bookkeeper. Retired two years."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.66,
      "end_seconds": 219.08,
      "duration_seconds": 1.42,
      "text": "Smoking?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.12,
      "end_seconds": 222.7,
      "duration_seconds": 1.58,
      "text": "Never."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.62,
      "end_seconds": 225.85,
      "duration_seconds": 1.23,
      "text": "Exercise?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.89,
      "end_seconds": 230.73,
      "duration_seconds": 3.84,
      "text": "I swim on Mondays and Fridays."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.96,
      "end_seconds": 249.51,
      "duration_seconds": 5.55,
      "text": "Let me look at your feet. Take your shoes off."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.23,
      "end_seconds": 254.62,
      "duration_seconds": 2.39,
      "text": "Of course. ~"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.45,
      "end_seconds": 280.2,
      "duration_seconds": 7.75,
      "text": "Close your eyes and tell me when you feel this thin plastic fibre."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.48,
      "end_seconds": 286.97,
      "duration_seconds": 4.49,
      "text": "Yes. Yes. Hm. Not that one. ~"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.6,
      "end_seconds": 296.77,
      "duration_seconds": 8.17,
      "text": "You can't feel it at the big toes, so the feeling there is reduced."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.67,
      "end_seconds": 299.48,
      "duration_seconds": 1.81,
      "text": "Oh. ~"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.44,
      "end_seconds": 306.48,
      "duration_seconds": 6.04,
      "text": "The pulses at both ankles are present and strong."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.05,
      "end_seconds": 311.53,
      "duration_seconds": 2.48,
      "text": "That's good. ~"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.07,
      "end_seconds": 317.03,
      "duration_seconds": 2.96,
      "text": "Any trouble with your breathing?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.34,
      "end_seconds": 322.27,
      "duration_seconds": 2.93,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.34,
      "end_seconds": 338.68,
      "duration_seconds": 14.34,
      "text": "Here's my thinking. Your diabetes control may be slipping, which would explain the thirst, the tiredness and the feet, but I can't rule out early diabetic changes in the eyes."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.49,
      "end_seconds": 341.64,
      "duration_seconds": 2.15,
      "text": "Oh dear. ~"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.53,
      "end_seconds": 356.36,
      "duration_seconds": 13.83,
      "text": "It's very treatable if caught early. I'd like to arrange an HbA1c blood test, and I'd like to arrange your retinal screening photograph."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.17,
      "end_seconds": 360.78,
      "duration_seconds": 1.61,
      "text": "When? ~"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.95,
      "end_seconds": 375.04,
      "duration_seconds": 13.09,
      "text": "The nurse can book the photograph now. I'd also like to start atorvastatin, 20 mg, once a day, to protect your heart and blood vessels."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 376.08,
      "end_seconds": 380.29,
      "duration_seconds": 4.21,
      "text": "I'll book it after this, Dawn. ~"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 381.77,
      "end_seconds": 384.0,
      "duration_seconds": 2.23,
      "text": "Thank you. ~"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 384.83,
      "end_seconds": 392.79,
      "duration_seconds": 7.96,
      "text": "I'd like to see you again in four weeks, when the results are back."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 394.11,
      "end_seconds": 398.68,
      "duration_seconds": 4.57,
      "text": "Four weeks. I'll write it on the calendar. ~"
    }
  ]
}
