{
  "schema_version": "1.0",
  "encounter_id": "00646",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.39,
      "end_seconds": 11.73,
      "duration_seconds": 11.34,
      "text": "Hello, doctor, sorry, I have forgotten what I was going to say. Lakshmi, what did we come about? ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.85,
      "end_seconds": 22.04,
      "duration_seconds": 9.19,
      "text": "The fever, Ramesh. The one from the rains. He's better, doctor, but he's still not himself."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.51,
      "end_seconds": 34.36,
      "duration_seconds": 10.85,
      "text": "Grand. I'm Dr Brennan, and I'll go slowly. You had a fever illness in the monsoon, is that right? ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 37.04,
      "end_seconds": 50.9,
      "duration_seconds": 13.86,
      "text": "Three weeks ago. High fever for five days, terrible body pain, and a rash at the end. The hospital said dengue, or something like it. ~"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.79,
      "end_seconds": 59.64,
      "duration_seconds": 5.85,
      "text": "That sounds like a hard week. How are you now, Ramesh?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.22,
      "end_seconds": 71.48,
      "duration_seconds": 10.26,
      "text": "Tired. I get so tired by the afternoon, I can't do what I used to. I just have to lie down."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 72.44,
      "end_seconds": 78.41,
      "duration_seconds": 5.97,
      "text": "He's asleep by three every day. He was never like that."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.04,
      "end_seconds": 84.62,
      "duration_seconds": 3.58,
      "text": "Any fever since it broke?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.99,
      "end_seconds": 90.81,
      "duration_seconds": 3.82,
      "text": "No fever. No, that's gone."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.8,
      "end_seconds": 100.03,
      "duration_seconds": 7.23,
      "text": "Good. What tablets are you taking, let's go through them with Lakshmi's help."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.19,
      "end_seconds": 108.55,
      "duration_seconds": 6.36,
      "text": "Paracetamol, 650 mg, when needed. And, what's the other, for the sugar..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 109.51,
      "end_seconds": 120.44,
      "duration_seconds": 10.93,
      "text": "Metformin, 500 mg twice a day. And the one for blood pressure, amlodipine, 5 mg once a day. You never remember that one."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.42,
      "end_seconds": 124.01,
      "duration_seconds": 2.59,
      "text": "She's right. ~"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.77,
      "end_seconds": 130.24,
      "duration_seconds": 5.47,
      "text": "Are you allergic to anything, any allergies to medicines?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.96,
      "end_seconds": 137.84,
      "duration_seconds": 6.88,
      "text": "I had some rash from a sulfa tablet once. Years ago."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.65,
      "end_seconds": 145.04,
      "duration_seconds": 5.39,
      "text": "Noted. And what other conditions do you have?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 146.68,
      "end_seconds": 151.79,
      "duration_seconds": 5.11,
      "text": "Diabetes, for twelve years, and high blood pressure. Nothing else."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.82,
      "end_seconds": 156.25,
      "duration_seconds": 3.43,
      "text": "Who's at home with you?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.61,
      "end_seconds": 166.49,
      "duration_seconds": 7.88,
      "text": "My wife and the two boys. We all live together, in the old house."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.96,
      "end_seconds": 172.56,
      "duration_seconds": 4.6,
      "text": "Lovely. Let me get your numbers. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.33,
      "end_seconds": 177.55,
      "duration_seconds": 2.22,
      "text": "Of course. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.72,
      "end_seconds": 204.34,
      "duration_seconds": 9.62,
      "text": "Pulse 78, blood pressure 138 over 84, temperature 36.8, oxygen 98 percent, weight 71 kilos."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 205.89,
      "end_seconds": 210.12,
      "duration_seconds": 4.23,
      "text": "He's lost weight. He was seventy-four. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.0,
      "end_seconds": 222.78,
      "duration_seconds": 11.78,
      "text": "He's lost a few kilos, which fits with being ill for a week. Let me press your tummy, Ramesh. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.54,
      "end_seconds": 226.03,
      "duration_seconds": 2.49,
      "text": "It's not sore. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.5,
      "end_seconds": 245.92,
      "duration_seconds": 6.42,
      "text": "Soft, and no tenderness, and I can't feel your liver edge."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.4,
      "end_seconds": 251.11,
      "duration_seconds": 2.71,
      "text": "Is that good? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.63,
      "end_seconds": 268.06,
      "duration_seconds": 15.43,
      "text": "It's what I wanted to find. So, all in all, the tiredness fits with the recovery period after a viral illness like dengue, and I'd call it post-viral fatigue."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 270.56,
      "end_seconds": 273.95,
      "duration_seconds": 3.39,
      "text": "How long will it last? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.19,
      "end_seconds": 284.4,
      "duration_seconds": 8.21,
      "text": "Often a few weeks, sometimes longer. It does pass, but it can't be rushed. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.56,
      "end_seconds": 289.7,
      "duration_seconds": 3.14,
      "text": "What can I do? ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.08,
      "end_seconds": 300.79,
      "duration_seconds": 9.71,
      "text": "Short walks, regular meals, and rest when you need it, but not all afternoon, or the nights get worse."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 302.45,
      "end_seconds": 306.42,
      "duration_seconds": 3.97,
      "text": "He drinks very little water. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.64,
      "end_seconds": 315.34,
      "duration_seconds": 6.7,
      "text": "Please, Ramesh, drink more, especially in this heat. Aim for eight glasses."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.11,
      "end_seconds": 319.56,
      "duration_seconds": 2.45,
      "text": "I will try. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.92,
      "end_seconds": 329.77,
      "duration_seconds": 7.85,
      "text": "I'd like to see you again in four weeks to see how you're getting on."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 332.65,
      "end_seconds": 336.67,
      "duration_seconds": 4.02,
      "text": "We will come. Thank you, doctor. ~"
    }
  ]
}
