{
  "schema_version": "1.0",
  "encounter_id": "00906",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 2.46,
      "end_seconds": 10.07,
      "duration_seconds": 7.61,
      "text": "I get headaches in the afternoon, and I wonder if it's my eyes."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 12.92,
      "end_seconds": 17.78,
      "duration_seconds": 4.86,
      "text": "Good question. Where do you feel the headache?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.08,
      "end_seconds": 26.15,
      "duration_seconds": 5.07,
      "text": "Across my forehead, and sometimes behind the eyes."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.97,
      "end_seconds": 33.17,
      "duration_seconds": 4.2,
      "text": "How long have you had them?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.66,
      "end_seconds": 41.47,
      "duration_seconds": 5.81,
      "text": "About three weeks. Since I started the new job at the computer."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.57,
      "end_seconds": 51.77,
      "duration_seconds": 6.2,
      "text": "How many hours a day are you looking at a screen? ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.43,
      "end_seconds": 58.26,
      "duration_seconds": 3.83,
      "text": "Eight or nine. Sometimes more. ~"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.38,
      "end_seconds": 65.75,
      "duration_seconds": 4.37,
      "text": "Do you notice blurred vision, or double vision?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.59,
      "end_seconds": 76.92,
      "duration_seconds": 7.33,
      "text": "Blurred, towards the end of the day. Words go a bit fuzzy."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.02,
      "end_seconds": 85.61,
      "duration_seconds": 4.59,
      "text": "Any flashing lights, or vomiting with the headache?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.25,
      "end_seconds": 91.46,
      "duration_seconds": 3.21,
      "text": "No. Nothing like that."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.91,
      "end_seconds": 99.64,
      "duration_seconds": 4.73,
      "text": "Do you take anything for the headache?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.8,
      "end_seconds": 108.11,
      "duration_seconds": 5.31,
      "text": "Ibuprofen, 400 mg, when it's bad. Maybe twice a week."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.09,
      "end_seconds": 115.95,
      "duration_seconds": 4.86,
      "text": "And have you ever had your eyes tested?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.56,
      "end_seconds": 125.49,
      "duration_seconds": 5.93,
      "text": "Not since school. I had glasses then, but I lost them."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.22,
      "end_seconds": 132.88,
      "duration_seconds": 4.66,
      "text": "Any allergies I should know about, to medicines?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.84,
      "end_seconds": 139.37,
      "duration_seconds": 3.53,
      "text": "No, none that I know of."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.6,
      "end_seconds": 147.71,
      "duration_seconds": 5.11,
      "text": "Any long-term conditions, or family history of eye problems?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.59,
      "end_seconds": 153.11,
      "duration_seconds": 2.52,
      "text": "My mother has glaucoma."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.9,
      "end_seconds": 164.16,
      "duration_seconds": 7.26,
      "text": "That's important, thank you. I'll check your blood pressure and pulse. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.12,
      "end_seconds": 177.62,
      "duration_seconds": 1.5,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.66,
      "end_seconds": 188.66,
      "duration_seconds": 7.0,
      "text": "Blood pressure 118 over 76, pulse 68, temperature 36.5, oxygen 99 percent, breathing 14."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.37,
      "end_seconds": 195.74,
      "duration_seconds": 3.37,
      "text": "Is it all right? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.79,
      "end_seconds": 207.55,
      "duration_seconds": 8.76,
      "text": "Perfect. I think this is eye strain, from the screen time and probably needing glasses again."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.52,
      "end_seconds": 217.47,
      "duration_seconds": 6.95,
      "text": "That's a relief. I was worried it was something worse. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.63,
      "end_seconds": 229.53,
      "duration_seconds": 8.9,
      "text": "With your mother's glaucoma, I'd like an optician to measure the pressure in your eyes too."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.51,
      "end_seconds": 237.53,
      "duration_seconds": 4.02,
      "text": "Can I book it myself? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.64,
      "end_seconds": 246.59,
      "duration_seconds": 5.95,
      "text": "Yes, a full eye test, and tell them about your mother."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.42,
      "end_seconds": 253.42,
      "duration_seconds": 4.0,
      "text": "I'll do it this week. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.19,
      "end_seconds": 264.31,
      "duration_seconds": 8.12,
      "text": "Meanwhile, take a break every twenty minutes and look at something far away."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.34,
      "end_seconds": 272.01,
      "duration_seconds": 4.67,
      "text": "The twenty-twenty rule, I've heard of it. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.94,
      "end_seconds": 279.91,
      "duration_seconds": 4.97,
      "text": "Exactly. And adjust the screen so it isn't glaring."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.52,
      "end_seconds": 288.07,
      "duration_seconds": 5.55,
      "text": "I'll move my desk away from the window. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.29,
      "end_seconds": 300.34,
      "duration_seconds": 9.05,
      "text": "If you get sudden loss of vision, eye pain, or vomiting with the headache, go to the emergency department."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.41,
      "end_seconds": 306.0,
      "duration_seconds": 2.59,
      "text": "Understood. Thanks, doctor. ~"
    }
  ]
}
