{
  "schema_version": "1.0",
  "encounter_id": "00679",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 0.71,
      "end_seconds": 7.66,
      "duration_seconds": 6.95,
      "text": "Mrs Iyer, Dev, you're in room three. The doctor's ready. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 9.73,
      "end_seconds": 14.65,
      "duration_seconds": 4.92,
      "text": "Thank you. Come, Dev. Doctor, we're back about the nosebleeds."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.9,
      "end_seconds": 27.87,
      "duration_seconds": 10.97,
      "text": "Hello Dev, hello Mrs Iyer. Last time, we tried the cream and the pinching. How has it gone? ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 30.15,
      "end_seconds": 39.25,
      "duration_seconds": 9.1,
      "text": "A little better, doctor. But he still gets them, two or three a week, mostly in the morning."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.82,
      "end_seconds": 46.3,
      "duration_seconds": 4.48,
      "text": "How long does each one last?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.92,
      "end_seconds": 49.79,
      "duration_seconds": 1.87,
      "text": "Long. ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 51.23,
      "end_seconds": 59.32,
      "duration_seconds": 8.09,
      "text": "Ten minutes, sometimes more, doctor. He holds a tissue and it keeps coming."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.76,
      "end_seconds": 64.14,
      "duration_seconds": 3.38,
      "text": "Dev, do you pick your nose?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.07,
      "end_seconds": 68.65,
      "duration_seconds": 1.58,
      "text": "Sometimes. ~"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 71.38,
      "end_seconds": 75.63,
      "duration_seconds": 4.25,
      "text": "He does. I tell him, but he forgets."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.41,
      "end_seconds": 82.37,
      "duration_seconds": 4.96,
      "text": "Is the cream helping? You're putting it on every day?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 83.82,
      "end_seconds": 90.43,
      "duration_seconds": 6.61,
      "text": "Twice a day, the nasal cream. We've used it for two weeks."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.57,
      "end_seconds": 99.09,
      "duration_seconds": 6.52,
      "text": "Any bruising on his body that you've noticed, or bleeding gums?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 101.52,
      "end_seconds": 108.05,
      "duration_seconds": 6.53,
      "text": "No, nothing like that. His gums are fine. No bruises beyond the football."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.29,
      "end_seconds": 114.52,
      "duration_seconds": 4.23,
      "text": "Any family history of bleeding problems? ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 116.04,
      "end_seconds": 117.52,
      "duration_seconds": 1.48,
      "text": "No. ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.17,
      "end_seconds": 122.52,
      "duration_seconds": 2.35,
      "text": "Hay fever, perhaps?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 124.41,
      "end_seconds": 131.94,
      "duration_seconds": 7.53,
      "text": "Yes, he has hay fever, every summer. He rubs his nose a lot."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.51,
      "end_seconds": 139.63,
      "duration_seconds": 6.12,
      "text": "That fits. I'll check him over. Temperature and pulse, please. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 142.48,
      "end_seconds": 146.18,
      "duration_seconds": 3.7,
      "text": "I'll do those, doctor. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 148.58,
      "end_seconds": 156.47,
      "duration_seconds": 7.89,
      "text": "Temperature 36.7, pulse 88, blood pressure 102 over 64, oxygen 99 percent, respiratory rate 20."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.19,
      "end_seconds": 168.27,
      "duration_seconds": 9.08,
      "text": "Thank you, Priya. Now Dev, can I look up your nose with a light? ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.27,
      "end_seconds": 186.67,
      "duration_seconds": 1.4,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.17,
      "end_seconds": 200.69,
      "duration_seconds": 12.52,
      "text": "Both sides are red and crusty at the front, and there's one tiny blood vessel on the right that's easy to bleed. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 201.89,
      "end_seconds": 205.05,
      "duration_seconds": 3.16,
      "text": "What does that mean? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.93,
      "end_seconds": 215.72,
      "duration_seconds": 9.79,
      "text": "It's the usual place for these. It's not serious, but it's persistent, so I'd like to look further. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 217.27,
      "end_seconds": 220.38,
      "duration_seconds": 3.11,
      "text": "What will you do? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.15,
      "end_seconds": 233.69,
      "duration_seconds": 11.54,
      "text": "I'd like to check a blood count and a clotting screen, to make sure his blood clots normally."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 235.99,
      "end_seconds": 239.1,
      "duration_seconds": 3.11,
      "text": "Will it hurt him? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.47,
      "end_seconds": 247.98,
      "duration_seconds": 7.51,
      "text": "A quick prick in the arm, and it's done. Priya will take him through. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 250.54,
      "end_seconds": 255.92,
      "duration_seconds": 5.38,
      "text": "I'll take care of him, Mrs Iyer. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.22,
      "end_seconds": 270.6,
      "duration_seconds": 13.38,
      "text": "Keep the cream going, twice a day, and keep his nails short. A little petroleum jelly inside the nose at night helps keep it moist."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 271.6,
      "end_seconds": 276.82,
      "duration_seconds": 5.22,
      "text": "We'll do that. And if it bleeds? ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.83,
      "end_seconds": 293.96,
      "duration_seconds": 16.13,
      "text": "Sit up, lean forward, pinch the soft part for ten minutes without letting go. If it lasts more than twenty minutes, or he's pale or drowsy, come in straight away."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 295.41,
      "end_seconds": 297.22,
      "duration_seconds": 1.81,
      "text": "Understood. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.26,
      "end_seconds": 305.54,
      "duration_seconds": 6.28,
      "text": "And if the blood tests show anything unusual, we'll call you in."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 306.72,
      "end_seconds": 309.66,
      "duration_seconds": 2.94,
      "text": "Thank you, doctor. ~"
    }
  ]
}
