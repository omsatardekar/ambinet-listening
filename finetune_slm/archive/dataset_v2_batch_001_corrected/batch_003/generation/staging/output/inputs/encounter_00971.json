{
  "schema_version": "1.0",
  "encounter_id": "00971",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 2.04,
      "end_seconds": 13.35,
      "duration_seconds": 11.31,
      "text": "Hi, doctor. I'm Jordan, Casey's partner. Casey gets this pain every month, and I've been telling them to come in. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.74,
      "end_seconds": 18.29,
      "duration_seconds": 2.55,
      "text": "It's nothing, Jordan. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.62,
      "end_seconds": 27.52,
      "duration_seconds": 5.9,
      "text": "Let's hear it from you, Casey. Where's the pain? ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.69,
      "end_seconds": 39.4,
      "duration_seconds": 8.71,
      "text": "Low down. On the left side, sometimes the right. Sharp. It comes and goes."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.37,
      "end_seconds": 46.43,
      "duration_seconds": 4.06,
      "text": "When in your cycle does it happen?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.31,
      "end_seconds": 56.08,
      "duration_seconds": 5.77,
      "text": "Um, about halfway. Like two weeks after my period starts."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 58.96,
      "end_seconds": 63.86,
      "duration_seconds": 4.9,
      "text": "It's the same every month. I can predict it. ~"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.35,
      "end_seconds": 70.32,
      "duration_seconds": 3.97,
      "text": "How long does it last? ~"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.25,
      "end_seconds": 77.09,
      "duration_seconds": 2.84,
      "text": "A day. Maybe two. ~"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.36,
      "end_seconds": 85.64,
      "duration_seconds": 5.28,
      "text": "Is it a sharp stab, or a dull ache? ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.13,
      "end_seconds": 92.8,
      "duration_seconds": 3.67,
      "text": "Sharp at first, then dull. ~"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.46,
      "end_seconds": 101.26,
      "duration_seconds": 5.8,
      "text": "Does it get in the way of what you do? ~"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.74,
      "end_seconds": 111.12,
      "duration_seconds": 7.38,
      "text": "It makes me curl up on the sofa. But then it's gone. ~"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.37,
      "end_seconds": 118.02,
      "duration_seconds": 3.65,
      "text": "Any heavy bleeding with it?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.51,
      "end_seconds": 124.73,
      "duration_seconds": 3.22,
      "text": "No, my periods are normal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.32,
      "end_seconds": 130.28,
      "duration_seconds": 1.96,
      "text": "Any fever?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.53,
      "end_seconds": 134.92,
      "duration_seconds": 1.39,
      "text": "No fever."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.29,
      "end_seconds": 145.04,
      "duration_seconds": 6.75,
      "text": "Do you have a history of cysts or gynaecological problems?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.65,
      "end_seconds": 158.61,
      "duration_seconds": 9.96,
      "text": "I had an ovarian cyst, a small one, a few years ago. It went away by itself."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 162.4,
      "end_seconds": 168.13,
      "duration_seconds": 5.73,
      "text": "She also gets a bit of spotting in the middle sometimes. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.92,
      "end_seconds": 173.39,
      "duration_seconds": 2.47,
      "text": "Is that right? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.66,
      "end_seconds": 179.57,
      "duration_seconds": 3.91,
      "text": "Sometimes, a tiny bit, brown. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.14,
      "end_seconds": 198.82,
      "duration_seconds": 16.68,
      "text": "Let me explain what I think is going on. Around the middle of the cycle, an egg is released from the ovary, and that can cause a sharp twinge on one side. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 202.8,
      "end_seconds": 204.85,
      "duration_seconds": 2.05,
      "text": "Ovulation? ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.74,
      "end_seconds": 220.49,
      "duration_seconds": 11.75,
      "text": "Yes. Some women feel it every month, and it's harmless. Given the timing and the pattern, I think this is ovulation pain."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.17,
      "end_seconds": 225.62,
      "duration_seconds": 2.45,
      "text": "That's it? ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.05,
      "end_seconds": 232.64,
      "duration_seconds": 3.59,
      "text": "That's what it sounds like. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.21,
      "end_seconds": 238.62,
      "duration_seconds": 3.41,
      "text": "Well, that's a relief. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.27,
      "end_seconds": 251.56,
      "duration_seconds": 10.29,
      "text": "Use a heat pack or a hot water bottle on your tummy, and a warm bath helps."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 255.08,
      "end_seconds": 260.09,
      "duration_seconds": 5.01,
      "text": "I'll make her a hot water bottle. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.45,
      "end_seconds": 265.39,
      "duration_seconds": 1.94,
      "text": "You'd better. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.25,
      "end_seconds": 282.74,
      "duration_seconds": 13.49,
      "text": "Pay attention to how it changes. If the pain becomes much stronger, or comes with a fever or a very heavy bleed, come back to us."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.92,
      "end_seconds": 287.35,
      "duration_seconds": 1.43,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.24,
      "end_seconds": 294.81,
      "duration_seconds": 4.57,
      "text": "Anything else you'd like to ask? ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.78,
      "end_seconds": 300.54,
      "duration_seconds": 1.76,
      "text": "No. Thanks. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 303.33,
      "end_seconds": 306.03,
      "duration_seconds": 2.7,
      "text": "Thanks, doctor. ~"
    }
  ]
}
