{
  "schema_version": "1.0",
  "encounter_id": "00949",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.51,
      "end_seconds": 13.62,
      "duration_seconds": 12.11,
      "text": "Doctor, I'm having a hernia repair next month, and the surgeon wants a heart check first, and I'm a bit nervous about it, honestly."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.06,
      "end_seconds": 24.24,
      "duration_seconds": 8.18,
      "text": "That's perfectly normal before an operation. Tell me about your heart. Any problems that you've noticed? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.8,
      "end_seconds": 34.19,
      "duration_seconds": 7.39,
      "text": "I get a bit puffed on the stairs. Two flights and I'm blowing."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.94,
      "end_seconds": 42.37,
      "duration_seconds": 5.43,
      "text": "How long has that been the case? ~"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.8,
      "end_seconds": 51.23,
      "duration_seconds": 6.43,
      "text": "A while now. Since I put on weight, I'd say. ~"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.4,
      "end_seconds": 58.1,
      "duration_seconds": 3.7,
      "text": "Any chest pain on exertion?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.78,
      "end_seconds": 64.56,
      "duration_seconds": 3.78,
      "text": "No chest pain. Not at all."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.98,
      "end_seconds": 66.97,
      "duration_seconds": 0.99,
      "text": "Palpitations?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.49,
      "end_seconds": 70.48,
      "duration_seconds": 1.99,
      "text": "No palpitations."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.26,
      "end_seconds": 76.13,
      "duration_seconds": 3.87,
      "text": "Have you fainted, or nearly fainted?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.85,
      "end_seconds": 80.66,
      "duration_seconds": 1.81,
      "text": "Never fainted, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.46,
      "end_seconds": 86.06,
      "duration_seconds": 3.6,
      "text": "What tablets are you taking?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.89,
      "end_seconds": 97.0,
      "duration_seconds": 9.11,
      "text": "Ramipril, 5 mg, once a day. Atorvastatin, 20 mg, at night. And aspirin, 75 mg, in the morning."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.78,
      "end_seconds": 101.46,
      "duration_seconds": 2.68,
      "text": "Good. Any heart history?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.87,
      "end_seconds": 106.26,
      "duration_seconds": 3.39,
      "text": "High blood pressure. For ten years."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.42,
      "end_seconds": 111.28,
      "duration_seconds": 2.86,
      "text": "Any procedures on your heart?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.61,
      "end_seconds": 116.58,
      "duration_seconds": 3.97,
      "text": "They put in a stent, in 2020."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.46,
      "end_seconds": 144.06,
      "duration_seconds": 11.6,
      "text": "Right. Let me take your numbers. Pulse 66, blood pressure 132 over 80, temperature 36.5, oxygen 97 percent, breathing 14, and weight 97 kilos."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.28,
      "end_seconds": 149.91,
      "duration_seconds": 3.63,
      "text": "Is that all right? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.72,
      "end_seconds": 167.99,
      "duration_seconds": 5.27,
      "text": "All fine. Let me listen to your heart."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.87,
      "end_seconds": 173.36,
      "duration_seconds": 2.49,
      "text": "Take your time. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.61,
      "end_seconds": 179.28,
      "duration_seconds": 3.67,
      "text": "Heart sounds are normal, regular rhythm."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.54,
      "end_seconds": 188.6,
      "duration_seconds": 6.06,
      "text": "Does that mean I'm okay for the surgery? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.47,
      "end_seconds": 204.7,
      "duration_seconds": 13.23,
      "text": "I can't promise that yet. The breathlessness on the stairs could simply be weight and fitness, but I can't rule out that it's coming from the heart."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.28,
      "end_seconds": 212.24,
      "duration_seconds": 4.96,
      "text": "Oh. That's not what I wanted to hear. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.91,
      "end_seconds": 221.32,
      "duration_seconds": 6.41,
      "text": "I know. But it's better to know before the operation than after. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.82,
      "end_seconds": 227.06,
      "duration_seconds": 3.24,
      "text": "True. What happens now? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.81,
      "end_seconds": 242.61,
      "duration_seconds": 12.8,
      "text": "I'll write to the surgeon with what I've found today and ask them to hold the date until I've seen you again. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.83,
      "end_seconds": 250.15,
      "duration_seconds": 4.32,
      "text": "Will it delay the surgery? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.57,
      "end_seconds": 257.16,
      "duration_seconds": 5.59,
      "text": "Possibly by a short time. It's much safer than rushing. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.08,
      "end_seconds": 261.73,
      "duration_seconds": 2.65,
      "text": "I suppose so. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.3,
      "end_seconds": 273.94,
      "duration_seconds": 9.64,
      "text": "In the meantime, keep taking all your tablets, including the aspirin, and keep walking each day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.08,
      "end_seconds": 278.6,
      "duration_seconds": 1.52,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.95,
      "end_seconds": 289.2,
      "duration_seconds": 7.25,
      "text": "I'd like to see you again in two weeks, before the date."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.93,
      "end_seconds": 294.4,
      "duration_seconds": 3.47,
      "text": "Two weeks. Thanks, doctor. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.73,
      "end_seconds": 299.84,
      "duration_seconds": 4.11,
      "text": "Don't worry. You're in good hands. ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.71,
      "end_seconds": 305.98,
      "duration_seconds": 3.27,
      "text": "I hope so. ~"
    }
  ]
}
