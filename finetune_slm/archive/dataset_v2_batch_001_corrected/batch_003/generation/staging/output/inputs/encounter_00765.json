{
  "schema_version": "1.0",
  "encounter_id": "00765",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 0.43,
      "end_seconds": 11.48,
      "duration_seconds": 11.05,
      "text": "Morning, doctor. I'm Ellie, Mr Rowe's carer. He's had the runs since the camping trip, and I can't get him to eat."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.54,
      "end_seconds": 20.28,
      "duration_seconds": 6.74,
      "text": "Thanks, Ellie. Mr Rowe, how long have you had the diarrhoea?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.14,
      "end_seconds": 25.2,
      "duration_seconds": 3.06,
      "text": "Four days. Since Saturday."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 26.81,
      "end_seconds": 35.95,
      "duration_seconds": 9.14,
      "text": "It's ten days, Mr Rowe. You told me the day after we got back from the lakes."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.24,
      "end_seconds": 51.06,
      "duration_seconds": 12.82,
      "text": "So four days from you and ten from Ellie. I'll put it down as four to ten days. How often are you going?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.75,
      "end_seconds": 57.39,
      "duration_seconds": 3.64,
      "text": "Five, six times a day. Watery."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.37,
      "end_seconds": 64.0,
      "duration_seconds": 3.63,
      "text": "Have you been sick? Any vomiting?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.97,
      "end_seconds": 69.0,
      "duration_seconds": 2.03,
      "text": "No. Not sick."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 70.4,
      "end_seconds": 77.95,
      "duration_seconds": 7.55,
      "text": "He was sick on the Sunday, twice, in the tent. I held the bucket."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.95,
      "end_seconds": 89.8,
      "duration_seconds": 8.85,
      "text": "I'll note that you each said different things about that. Any blood in the stool, or black stools?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.76,
      "end_seconds": 93.5,
      "duration_seconds": 1.74,
      "text": "No. ~"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.61,
      "end_seconds": 97.97,
      "duration_seconds": 2.36,
      "text": "Any fever? ~"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.61,
      "end_seconds": 103.96,
      "duration_seconds": 3.35,
      "text": "Hot and cold, a bit. ~"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.45,
      "end_seconds": 111.87,
      "duration_seconds": 6.42,
      "text": "Where did you get your drinking water, on the trip? ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.73,
      "end_seconds": 118.3,
      "duration_seconds": 4.57,
      "text": "From the stream, boiled. Most of the time. ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 121.03,
      "end_seconds": 124.19,
      "duration_seconds": 3.16,
      "text": "Not always boiled, I think. ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.05,
      "end_seconds": 129.02,
      "duration_seconds": 2.97,
      "text": "Okay. Any health conditions?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.92,
      "end_seconds": 134.24,
      "duration_seconds": 2.32,
      "text": "Type 2 diabetes."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.87,
      "end_seconds": 141.03,
      "duration_seconds": 4.16,
      "text": "Anyone in the family with bowel problems?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.18,
      "end_seconds": 145.04,
      "duration_seconds": 2.86,
      "text": "My brother has colitis."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.69,
      "end_seconds": 151.61,
      "duration_seconds": 3.92,
      "text": "Let me check your numbers. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.29,
      "end_seconds": 156.01,
      "duration_seconds": 2.72,
      "text": "Go on. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.44,
      "end_seconds": 179.96,
      "duration_seconds": 7.52,
      "text": "Pulse 92, blood pressure 118 over 70, temperature 37.8, oxygen 97 percent, weight 74 kilos."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 181.95,
      "end_seconds": 184.24,
      "duration_seconds": 2.29,
      "text": "Is he dry? ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.55,
      "end_seconds": 205.04,
      "duration_seconds": 4.49,
      "text": "A little. Mr Rowe, I'll press your tummy."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.68,
      "end_seconds": 208.2,
      "duration_seconds": 1.52,
      "text": "Ow. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.17,
      "end_seconds": 219.55,
      "duration_seconds": 9.38,
      "text": "Soft, with some tenderness around the belly button, no guarding, and your mouth is a little dry."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 222.51,
      "end_seconds": 226.65,
      "duration_seconds": 4.14,
      "text": "Does he need to go to hospital? ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.2,
      "end_seconds": 245.33,
      "duration_seconds": 17.13,
      "text": "Not at this stage. Persistent diarrhoea after drinking stream water makes me think of a parasite, giardia, but I'm not going to put a name on it until we test."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.69,
      "end_seconds": 249.7,
      "duration_seconds": 2.01,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.13,
      "end_seconds": 261.22,
      "duration_seconds": 10.09,
      "text": "I'd like you to bring a stool sample, in the pot I'll give you, so we can test for infections."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 262.93,
      "end_seconds": 267.28,
      "duration_seconds": 4.35,
      "text": "I'll make sure he does it tomorrow. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.2,
      "end_seconds": 277.61,
      "duration_seconds": 9.41,
      "text": "Drink lots of water with a pinch of salt and sugar, little and often, and eat plain food."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.89,
      "end_seconds": 281.29,
      "duration_seconds": 1.4,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.99,
      "end_seconds": 289.81,
      "duration_seconds": 6.82,
      "text": "As you have diabetes, check your sugars more often while you're unwell."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 291.41,
      "end_seconds": 294.41,
      "duration_seconds": 3.0,
      "text": "I'll remind him. ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.97,
      "end_seconds": 302.24,
      "duration_seconds": 6.27,
      "text": "I'd like to see you again in a week, with the results."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.21,
      "end_seconds": 305.97,
      "duration_seconds": 2.76,
      "text": "A week. Aye. ~"
    }
  ]
}
