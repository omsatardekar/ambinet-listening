{
  "schema_version": "1.0",
  "encounter_id": "00663",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 0.61,
      "end_seconds": 17.31,
      "duration_seconds": 16.7,
      "text": "Doctor, thank you for seeing us. It's my father, he doesn't complain, so I'm going to do the talking. He has fallen twice in the last month."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.55,
      "end_seconds": 27.04,
      "duration_seconds": 7.49,
      "text": "I'm sorry to hear that. Mr Nair, tell me in your own words, what happened?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.83,
      "end_seconds": 38.19,
      "duration_seconds": 8.36,
      "text": "It is nothing. I stood up from the chair, and my legs went. That's all."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 39.88,
      "end_seconds": 54.22,
      "duration_seconds": 14.34,
      "text": "The second time he was getting out of bed at night, to go to the toilet. I found him on the floor in the morning."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.55,
      "end_seconds": 61.1,
      "duration_seconds": 5.55,
      "text": "Mr Nair, do you remember feeling anything before you fell?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.86,
      "end_seconds": 71.47,
      "duration_seconds": 7.61,
      "text": "A bit dizzy. When I stand up fast, the room goes grey for a moment."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.82,
      "end_seconds": 77.65,
      "duration_seconds": 4.83,
      "text": "Did you hit your head on either fall?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.42,
      "end_seconds": 83.81,
      "duration_seconds": 3.39,
      "text": "No. My arm only, a bruise."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.8,
      "end_seconds": 89.9,
      "duration_seconds": 4.1,
      "text": "Any chest pain, or palpitations with it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.58,
      "end_seconds": 95.39,
      "duration_seconds": 3.81,
      "text": "No pain. Nothing in the chest."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.3,
      "end_seconds": 107.4,
      "duration_seconds": 10.1,
      "text": "Did you black out, lose consciousness at all, or is it more that your legs gave way?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.61,
      "end_seconds": 114.52,
      "duration_seconds": 4.91,
      "text": "No blackout. I was awake the whole time."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.43,
      "end_seconds": 120.61,
      "duration_seconds": 5.18,
      "text": "Thank you. What medicines does he take, Anita?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 123.12,
      "end_seconds": 133.36,
      "duration_seconds": 10.24,
      "text": "Amlodipine, 5 mg once a day, and atenolol, 50 mg once a day. He takes them in the morning."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.64,
      "end_seconds": 138.48,
      "duration_seconds": 3.84,
      "text": "Okay. And any allergies to medicines?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 139.83,
      "end_seconds": 144.01,
      "duration_seconds": 4.18,
      "text": "No, none. He has never had any problem."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.3,
      "end_seconds": 149.4,
      "duration_seconds": 4.1,
      "text": "Let me ask about his health background."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 150.54,
      "end_seconds": 157.1,
      "duration_seconds": 6.56,
      "text": "High blood pressure for twenty years, and diabetes, but it's diet-controlled."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.82,
      "end_seconds": 163.49,
      "duration_seconds": 3.67,
      "text": "I take care with sweets. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.79,
      "end_seconds": 168.75,
      "duration_seconds": 2.96,
      "text": "Good for you. Any operations?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 170.49,
      "end_seconds": 175.04,
      "duration_seconds": 4.55,
      "text": "Cataract operation on the right eye, last year."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.42,
      "end_seconds": 181.44,
      "duration_seconds": 5.02,
      "text": "Any strokes or heart disease in the family?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.08,
      "end_seconds": 189.03,
      "duration_seconds": 4.95,
      "text": "My father had a stroke, at seventy."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.25,
      "end_seconds": 199.11,
      "duration_seconds": 8.86,
      "text": "Thank you. I'm going to check your blood pressure lying and then standing, Mr Nair. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.57,
      "end_seconds": 202.93,
      "duration_seconds": 2.36,
      "text": "As you wish. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.3,
      "end_seconds": 275.51,
      "duration_seconds": 10.21,
      "text": "Lying down, 148 over 82. Now stand up for me slowly, and wait a minute. Standing, 118 over 70."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.69,
      "end_seconds": 281.08,
      "duration_seconds": 4.39,
      "text": "I feel a bit dizzy now. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.41,
      "end_seconds": 288.6,
      "duration_seconds": 5.19,
      "text": "That's what I thought. Sit back down, please. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.74,
      "end_seconds": 316.21,
      "duration_seconds": 10.47,
      "text": "I also watched you walk in. You walk slowly with a stoop, and your feet have good feeling when I test them."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 316.94,
      "end_seconds": 322.98,
      "duration_seconds": 6.04,
      "text": "What does it mean, the blood pressure dropping? ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.13,
      "end_seconds": 338.9,
      "duration_seconds": 14.77,
      "text": "When his pressure drops by 30 points on standing, that's what makes him dizzy and unsteady. It looks like postural hypotension, and I'd say it's the most likely cause of the falls."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 340.88,
      "end_seconds": 344.1,
      "duration_seconds": 3.22,
      "text": "Is it his tablets? ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.21,
      "end_seconds": 363.73,
      "duration_seconds": 17.52,
      "text": "They may be contributing, so I'll review them, but I don't want to change anything without looking at his heart tracing first. I'd like to arrange an ECG today."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 365.18,
      "end_seconds": 368.59,
      "duration_seconds": 3.41,
      "text": "Can we do it now? ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 370.05,
      "end_seconds": 376.09,
      "duration_seconds": 6.04,
      "text": "Yes, the nurse will take you through after this. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 376.93,
      "end_seconds": 381.5,
      "duration_seconds": 4.57,
      "text": "What can I do about the falling? ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 383.77,
      "end_seconds": 400.11,
      "duration_seconds": 16.34,
      "text": "Get up slowly, sit on the edge of the bed for a minute before standing, and drink enough water during the day. Keep a light on at night."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 403.07,
      "end_seconds": 407.84,
      "duration_seconds": 4.77,
      "text": "I'll put a night light in the corridor. ~"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 410.36,
      "end_seconds": 422.93,
      "duration_seconds": 12.57,
      "text": "Good idea. And I'd like to see you both in two weeks, to go over the ECG and decide about the tablets."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 425.11,
      "end_seconds": 427.92,
      "duration_seconds": 2.81,
      "text": "Thank you, doctor. ~"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 429.49,
      "end_seconds": 431.54,
      "duration_seconds": 2.05,
      "text": "Thank you. ~"
    }
  ]
}
