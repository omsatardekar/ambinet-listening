{
  "schema_version": "1.0",
  "encounter_id": "00936",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.52,
      "end_seconds": 15.82,
      "duration_seconds": 15.3,
      "text": "I can't see the board at school. I'm squinting all the time, and the teacher's moved me to the front twice, so my mum made me come."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.41,
      "end_seconds": 25.95,
      "duration_seconds": 7.54,
      "text": "Thanks for coming, Leo. Squinting at the board. How long has it been going on?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.06,
      "end_seconds": 32.47,
      "duration_seconds": 4.41,
      "text": "Since the start of term. About four months."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.34,
      "end_seconds": 40.9,
      "duration_seconds": 5.56,
      "text": "Is it only the board, or other things too?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.23,
      "end_seconds": 50.76,
      "duration_seconds": 8.53,
      "text": "Anything far away. Road signs, the football pitch. Everything's blurry past about ten metres."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.53,
      "end_seconds": 54.54,
      "duration_seconds": 3.01,
      "text": "Do you get headaches?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.25,
      "end_seconds": 59.07,
      "duration_seconds": 3.82,
      "text": "By the afternoon, yeah, across the front."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.84,
      "end_seconds": 63.35,
      "duration_seconds": 3.51,
      "text": "Do your eyes feel tired?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.23,
      "end_seconds": 70.09,
      "duration_seconds": 3.86,
      "text": "Really tired and sore. Especially after gaming."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.32,
      "end_seconds": 75.51,
      "duration_seconds": 4.19,
      "text": "Do you sit close to the screen?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.64,
      "end_seconds": 81.18,
      "duration_seconds": 4.54,
      "text": "Right up close, yeah. Mum shouts at me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 83.53,
      "end_seconds": 89.24,
      "duration_seconds": 5.71,
      "text": "Doctor, would you like his notes from the school? ~"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.06,
      "end_seconds": 94.79,
      "duration_seconds": 4.73,
      "text": "In a minute, nurse. Leo, any double vision?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.01,
      "end_seconds": 98.13,
      "duration_seconds": 2.12,
      "text": "No double vision."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.64,
      "end_seconds": 103.57,
      "duration_seconds": 2.93,
      "text": "Pain in the eyes themselves?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.04,
      "end_seconds": 107.63,
      "duration_seconds": 1.59,
      "text": "No pain."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.55,
      "end_seconds": 111.53,
      "duration_seconds": 1.98,
      "text": "Red eyes?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.67,
      "end_seconds": 115.68,
      "duration_seconds": 3.01,
      "text": "No, they're not red."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.95,
      "end_seconds": 121.17,
      "duration_seconds": 4.22,
      "text": "Any flashes of light or floaters?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.93,
      "end_seconds": 124.0,
      "duration_seconds": 2.07,
      "text": "No flashes."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.6,
      "end_seconds": 128.96,
      "duration_seconds": 3.36,
      "text": "What medicines do you take?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.67,
      "end_seconds": 137.01,
      "duration_seconds": 6.34,
      "text": "Montelukast, 10 mg, at night. And cetirizine, 10 mg, in the morning."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.21,
      "end_seconds": 141.3,
      "duration_seconds": 2.09,
      "text": "Any allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.53,
      "end_seconds": 148.15,
      "duration_seconds": 5.62,
      "text": "Penicillin. I got a rash when I was little."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.94,
      "end_seconds": 152.79,
      "duration_seconds": 1.85,
      "text": "Medical history?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.15,
      "end_seconds": 159.97,
      "duration_seconds": 4.82,
      "text": "Asthma, eczema, hay fever, and migraines sometimes."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.66,
      "end_seconds": 163.15,
      "duration_seconds": 1.49,
      "text": "Operations?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.5,
      "end_seconds": 168.87,
      "duration_seconds": 3.37,
      "text": "Adenoids out, when I was six."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.26,
      "end_seconds": 173.16,
      "duration_seconds": 2.9,
      "text": "Eye problems in the family?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.91,
      "end_seconds": 178.12,
      "duration_seconds": 4.21,
      "text": "My mum's short-sighted. And my dad has glaucoma."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.64,
      "end_seconds": 183.49,
      "duration_seconds": 3.85,
      "text": "What year are you in?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.09,
      "end_seconds": 191.0,
      "duration_seconds": 5.91,
      "text": "Year eleven. GCSEs, so I need to see the board."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.23,
      "end_seconds": 195.0,
      "duration_seconds": 1.77,
      "text": "And screens?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.19,
      "end_seconds": 201.11,
      "duration_seconds": 3.92,
      "text": "Gaming, about four hours a night."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.17,
      "end_seconds": 204.59,
      "duration_seconds": 1.42,
      "text": "Sport?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.44,
      "end_seconds": 211.68,
      "duration_seconds": 5.24,
      "text": "Football on Saturdays. I can't see the ball coming."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.77,
      "end_seconds": 217.49,
      "duration_seconds": 3.72,
      "text": "Who do you live with?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.44,
      "end_seconds": 224.02,
      "duration_seconds": 3.58,
      "text": "Mum, dad, and my sister."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.83,
      "end_seconds": 253.16,
      "duration_seconds": 13.33,
      "text": "Let me check you. Pulse 68, blood pressure 112 over 68, temperature 36.6, oxygen 99 percent, breathing 14, and weight 62 kilos."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.14,
      "end_seconds": 258.46,
      "duration_seconds": 3.32,
      "text": "Is that all fine? ~"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.48,
      "end_seconds": 280.28,
      "duration_seconds": 9.8,
      "text": "All fine. Nurse, put the chart up. Cover your left eye, Leo. Read the smallest line you can."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.89,
      "end_seconds": 287.85,
      "duration_seconds": 5.96,
      "text": "E, D, F... I can't see the next one. ~"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.82,
      "end_seconds": 294.19,
      "duration_seconds": 5.37,
      "text": "The right eye reads 6/12. Now cover the right."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.93,
      "end_seconds": 297.91,
      "duration_seconds": 1.98,
      "text": "That's worse. ~"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.73,
      "end_seconds": 301.38,
      "duration_seconds": 2.65,
      "text": "Left eye reads 6/18."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.06,
      "end_seconds": 305.75,
      "duration_seconds": 2.69,
      "text": "Is that bad? ~"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.74,
      "end_seconds": 318.29,
      "duration_seconds": 9.55,
      "text": "Both eyes are below normal for distance. Now look at my light. Your pupils are equal and react normally."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.77,
      "end_seconds": 321.28,
      "duration_seconds": 1.51,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.3,
      "end_seconds": 327.96,
      "duration_seconds": 5.66,
      "text": "And your eye movements are full, with no squint."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.26,
      "end_seconds": 333.87,
      "duration_seconds": 3.61,
      "text": "So what is it? ~"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.83,
      "end_seconds": 341.6,
      "duration_seconds": 4.77,
      "text": "Any problem with your balance or dizziness?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.37,
      "end_seconds": 344.9,
      "duration_seconds": 2.53,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.02,
      "end_seconds": 353.38,
      "duration_seconds": 7.36,
      "text": "This looks like short-sightedness, myopia, which is very common at your age."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 354.63,
      "end_seconds": 357.87,
      "duration_seconds": 3.24,
      "text": "Will I need glasses? ~"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.97,
      "end_seconds": 372.42,
      "duration_seconds": 12.45,
      "text": "Very likely. I'd like to arrange a full eye test with the optometrist, a retinal photograph, and a test with drops to measure your exact prescription."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 373.37,
      "end_seconds": 377.81,
      "duration_seconds": 4.44,
      "text": "I'll book the optometrist for this week. ~"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.61,
      "end_seconds": 388.36,
      "duration_seconds": 7.75,
      "text": "And I'd like to do a colour vision test while you're here."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 389.43,
      "end_seconds": 392.01,
      "duration_seconds": 2.58,
      "text": "That one's fun. ~"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 392.96,
      "end_seconds": 400.09,
      "duration_seconds": 7.13,
      "text": "Take screen breaks every twenty minutes, and get outside in daylight more."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 402.61,
      "end_seconds": 404.73,
      "duration_seconds": 2.12,
      "text": "Fair enough. ~"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 405.87,
      "end_seconds": 413.94,
      "duration_seconds": 8.07,
      "text": "If the headaches haven't settled four weeks after you get glasses, come back and see us."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 416.06,
      "end_seconds": 418.37,
      "duration_seconds": 2.31,
      "text": "Okay, thanks. ~"
    }
  ]
}
