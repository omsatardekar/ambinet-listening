{
  "schema_version": "1.0",
  "encounter_id": "00818",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 0.9,
      "end_seconds": 10.6,
      "duration_seconds": 9.7,
      "text": "Hello, Mrs Sharma. I'm Joy, the nurse. I'll take your measurements while you wait. Sit here. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.72,
      "end_seconds": 14.23,
      "duration_seconds": 1.51,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 30.46,
      "end_seconds": 37.42,
      "duration_seconds": 6.96,
      "text": "Temperature 36.8, pulse 84, blood pressure 118 over 72, weight 62 kilos."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.76,
      "end_seconds": 43.82,
      "duration_seconds": 5.06,
      "text": "Good morning, Mrs Sharma. What brings you in? ~"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.18,
      "end_seconds": 51.6,
      "duration_seconds": 5.42,
      "text": "Thrush. Again. Itching, soreness, white discharge. Fourth time this year."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.92,
      "end_seconds": 56.94,
      "duration_seconds": 3.02,
      "text": "When did it start?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.37,
      "end_seconds": 59.83,
      "duration_seconds": 1.46,
      "text": "Five days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.29,
      "end_seconds": 66.37,
      "duration_seconds": 4.08,
      "text": "Any burning when you pass urine?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.64,
      "end_seconds": 72.2,
      "duration_seconds": 3.56,
      "text": "Yes, outside, when the urine touches."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.62,
      "end_seconds": 79.02,
      "duration_seconds": 4.4,
      "text": "Any pelvic pain, fever, or an unusual smell?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.51,
      "end_seconds": 84.25,
      "duration_seconds": 3.74,
      "text": "No pain. No fever. No smell."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.67,
      "end_seconds": 90.51,
      "duration_seconds": 4.84,
      "text": "Any change in your periods, or bleeding between?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.58,
      "end_seconds": 95.11,
      "duration_seconds": 2.53,
      "text": "No. All normal."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.01,
      "end_seconds": 100.72,
      "duration_seconds": 3.71,
      "text": "What have you used so far?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.67,
      "end_seconds": 110.35,
      "duration_seconds": 6.68,
      "text": "Clotrimazole cream, twice a day. And a fluconazole capsule, 150 mg, once, on Sunday."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.17,
      "end_seconds": 114.15,
      "duration_seconds": 2.98,
      "text": "Did it help? ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.56,
      "end_seconds": 119.34,
      "duration_seconds": 3.78,
      "text": "A little. It came back. ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.3,
      "end_seconds": 124.48,
      "duration_seconds": 3.18,
      "text": "Any allergies to medicines?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.84,
      "end_seconds": 127.31,
      "duration_seconds": 1.47,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.25,
      "end_seconds": 130.6,
      "duration_seconds": 2.35,
      "text": "Any health conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.78,
      "end_seconds": 140.71,
      "duration_seconds": 7.93,
      "text": "I'm diabetic, type 2. And I had an infection in my chest last month."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.75,
      "end_seconds": 146.03,
      "duration_seconds": 4.28,
      "text": "Did you take antibiotics for that? ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.6,
      "end_seconds": 152.21,
      "duration_seconds": 3.61,
      "text": "Yes, a week of them. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 154.19,
      "end_seconds": 161.58,
      "duration_seconds": 7.39,
      "text": "Doctor, would you like me to set up the examination room? ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.5,
      "end_seconds": 171.82,
      "duration_seconds": 7.32,
      "text": "Please, Joy. Mrs Sharma, I'll examine you now, with the nurse present. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.31,
      "end_seconds": 201.06,
      "duration_seconds": 1.75,
      "text": "All right."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.12,
      "end_seconds": 214.86,
      "duration_seconds": 12.74,
      "text": "The vulva is red and swollen, with white curdy discharge and a few small cracks, and there's no sign of any ulcers."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.14,
      "end_seconds": 219.48,
      "duration_seconds": 3.34,
      "text": "Is it definitely thrush? ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.17,
      "end_seconds": 237.03,
      "duration_seconds": 14.86,
      "text": "It looks typical, and the antibiotics last month and your diabetes both make it more likely. I'd say this is recurrent vulvovaginal thrush, but I can't rule out a different infection."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.86,
      "end_seconds": 242.13,
      "duration_seconds": 3.27,
      "text": "What do we do? ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.43,
      "end_seconds": 259.22,
      "duration_seconds": 14.79,
      "text": "I'd like to take a swab, to confirm it and check for other germs, and a blood test to see how well your diabetes is controlled."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 261.14,
      "end_seconds": 265.13,
      "duration_seconds": 3.99,
      "text": "I'll take the swab now, doctor. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.99,
      "end_seconds": 277.11,
      "duration_seconds": 11.12,
      "text": "For treatment, I'd like you to continue the clotrimazole for another week, and avoid scented soaps, tight clothing and douching."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.27,
      "end_seconds": 280.77,
      "duration_seconds": 2.5,
      "text": "I'll do that. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.77,
      "end_seconds": 290.95,
      "duration_seconds": 7.18,
      "text": "Keep a close eye on your blood sugars, because high sugar feeds thrush."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.05,
      "end_seconds": 296.18,
      "duration_seconds": 3.13,
      "text": "They've been higher lately. ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.85,
      "end_seconds": 309.0,
      "duration_seconds": 11.15,
      "text": "That's something we'll look at. I'd like to see you in two weeks, with the swab and blood results."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.58,
      "end_seconds": 314.32,
      "duration_seconds": 3.74,
      "text": "Two weeks. Thank you. ~"
    }
  ]
}
