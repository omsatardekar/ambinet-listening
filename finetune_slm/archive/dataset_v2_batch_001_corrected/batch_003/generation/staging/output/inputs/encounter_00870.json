{
  "schema_version": "1.0",
  "encounter_id": "00870",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.53,
      "end_seconds": 13.08,
      "duration_seconds": 12.55,
      "text": "Hello, doctor. It's my fingers. They go tingly when I'm typing. And sometimes at night. Where was I? Oh, yes, the right hand, mostly."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.05,
      "end_seconds": 20.11,
      "duration_seconds": 4.06,
      "text": "Take your time. Which fingers are affected?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.5,
      "end_seconds": 28.26,
      "duration_seconds": 5.76,
      "text": "The thumb, the next two fingers. Not the little one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.29,
      "end_seconds": 34.86,
      "duration_seconds": 3.57,
      "text": "How long has this been happening?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.82,
      "end_seconds": 45.1,
      "duration_seconds": 8.28,
      "text": "About two months. It started when I took on the extra work. I type all day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.76,
      "end_seconds": 50.86,
      "duration_seconds": 4.1,
      "text": "Does it wake you up at night?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.7,
      "end_seconds": 60.98,
      "duration_seconds": 7.28,
      "text": "Yes, the fingers go numb, and I shake my hand to get them back."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.45,
      "end_seconds": 66.56,
      "duration_seconds": 3.11,
      "text": "Any weakness, dropping things?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.29,
      "end_seconds": 73.86,
      "duration_seconds": 5.57,
      "text": "I dropped a mug last week. And my grip feels weak."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.92,
      "end_seconds": 79.91,
      "duration_seconds": 4.99,
      "text": "Any pain in the neck, or down the arm?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.75,
      "end_seconds": 87.24,
      "duration_seconds": 4.49,
      "text": "No. No neck pain. Just the hand."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.22,
      "end_seconds": 91.99,
      "duration_seconds": 2.77,
      "text": "Any allergies to medicines?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.68,
      "end_seconds": 94.62,
      "duration_seconds": 0.94,
      "text": "None."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.51,
      "end_seconds": 99.97,
      "duration_seconds": 2.46,
      "text": "Any other conditions?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.1,
      "end_seconds": 104.4,
      "duration_seconds": 2.3,
      "text": "An underactive thyroid."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.0,
      "end_seconds": 107.88,
      "duration_seconds": 1.88,
      "text": "Any operations?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.96,
      "end_seconds": 113.67,
      "duration_seconds": 4.71,
      "text": "My wisdom teeth, a few years ago."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.2,
      "end_seconds": 119.57,
      "duration_seconds": 3.37,
      "text": "Pulse and temperature first. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.73,
      "end_seconds": 123.46,
      "duration_seconds": 1.73,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.96,
      "end_seconds": 139.21,
      "duration_seconds": 3.25,
      "text": "Pulse 70, temperature 36.5."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.32,
      "end_seconds": 141.78,
      "duration_seconds": 1.46,
      "text": "Fine? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.27,
      "end_seconds": 193.93,
      "duration_seconds": 10.66,
      "text": "Fine. Now, I'm going to tap on your wrist, and I'd like you to bend your wrist for a minute."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.56,
      "end_seconds": 198.53,
      "duration_seconds": 2.97,
      "text": "Oh! There, the tingling! ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.76,
      "end_seconds": 211.44,
      "duration_seconds": 10.68,
      "text": "That brings on your symptoms, and the muscle at the base of your thumb is slightly weaker on the right."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.3,
      "end_seconds": 217.22,
      "duration_seconds": 2.92,
      "text": "What is it? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.83,
      "end_seconds": 232.71,
      "duration_seconds": 13.88,
      "text": "This looks like carpal tunnel syndrome, a squeezed nerve at the wrist, but I can't rule out a neck cause, or low thyroid levels contributing."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.62,
      "end_seconds": 239.74,
      "duration_seconds": 4.12,
      "text": "Do I need an operation? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.53,
      "end_seconds": 247.45,
      "duration_seconds": 5.92,
      "text": "Not yet. Most people improve with a wrist splint worn at night."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.13,
      "end_seconds": 252.63,
      "duration_seconds": 3.5,
      "text": "Where do I get one? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.29,
      "end_seconds": 266.36,
      "duration_seconds": 12.07,
      "text": "The pharmacy, or I can arrange it. And I'd like to arrange a blood test, to check your thyroid and sugar."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.0,
      "end_seconds": 269.64,
      "duration_seconds": 1.64,
      "text": "Fine. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.7,
      "end_seconds": 280.68,
      "duration_seconds": 8.98,
      "text": "Take breaks from typing every half hour, keep your wrist straight, and check your desk set-up."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.73,
      "end_seconds": 285.23,
      "duration_seconds": 1.5,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.06,
      "end_seconds": 301.49,
      "duration_seconds": 13.43,
      "text": "If it doesn't improve in six weeks, or you get constant numbness or weakness, I'll arrange nerve tests and a specialist review."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.37,
      "end_seconds": 306.01,
      "duration_seconds": 2.64,
      "text": "Right. Thank you. ~"
    }
  ]
}
