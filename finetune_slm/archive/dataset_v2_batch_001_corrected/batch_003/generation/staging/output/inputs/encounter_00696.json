{
  "schema_version": "1.0",
  "encounter_id": "00696",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.91,
      "end_seconds": 9.92,
      "duration_seconds": 9.01,
      "text": "Hello. Um, I've noticed a yellowish bump on my eye, by the coloured bit, and I don't like it."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 12.33,
      "end_seconds": 18.96,
      "duration_seconds": 6.63,
      "text": "Let me hear more about it. When did you spot it?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.04,
      "end_seconds": 29.93,
      "duration_seconds": 8.89,
      "text": "About two months ago, in the mirror. It was tiny, and it's grown a little."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.75,
      "end_seconds": 36.63,
      "duration_seconds": 3.88,
      "text": "Does it bother you in any way?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.36,
      "end_seconds": 44.07,
      "duration_seconds": 6.71,
      "text": "My eye feels gritty, like there's sand in it. Mostly when the wind's blowing."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.01,
      "end_seconds": 49.92,
      "duration_seconds": 2.91,
      "text": "Any redness or watering?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.69,
      "end_seconds": 58.95,
      "duration_seconds": 6.26,
      "text": "It goes red now and then, and waters a bit, particularly outdoors."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.36,
      "end_seconds": 64.8,
      "duration_seconds": 3.44,
      "text": "Any change in your sight, blurriness?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.63,
      "end_seconds": 73.24,
      "duration_seconds": 5.61,
      "text": "No, my sight is fine. No blurring at all."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.7,
      "end_seconds": 78.99,
      "duration_seconds": 4.29,
      "text": "Are you using anything on the eye?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.0,
      "end_seconds": 86.73,
      "duration_seconds": 6.73,
      "text": "Lubricating drops, four times a day, for dry eyes. They help a little."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.07,
      "end_seconds": 92.12,
      "duration_seconds": 4.05,
      "text": "And you've had dry eyes for a while?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.99,
      "end_seconds": 97.24,
      "duration_seconds": 4.25,
      "text": "Years. And hay fever too, in the summer."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.0,
      "end_seconds": 102.77,
      "duration_seconds": 3.77,
      "text": "What work do you do?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.73,
      "end_seconds": 109.68,
      "duration_seconds": 5.95,
      "text": "I'm a gardener. I'm outside all day, in the sun and wind."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.83,
      "end_seconds": 117.5,
      "duration_seconds": 6.67,
      "text": "Let me check your pulse and blood pressure first, it's routine. ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.07,
      "end_seconds": 121.02,
      "duration_seconds": 1.95,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.97,
      "end_seconds": 136.96,
      "duration_seconds": 3.99,
      "text": "Pulse 72, blood pressure 122 over 76."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.46,
      "end_seconds": 141.07,
      "duration_seconds": 1.61,
      "text": "Fine? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.18,
      "end_seconds": 150.82,
      "duration_seconds": 7.64,
      "text": "Fine. Now sit at the microscope for me, chin on the rest, look straight ahead. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.43,
      "end_seconds": 174.26,
      "duration_seconds": 1.83,
      "text": "Like this?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.25,
      "end_seconds": 192.6,
      "duration_seconds": 15.35,
      "text": "Right. There's a small, raised, yellowish lump on the white of the eye, on the nose side, next to the cornea, and the surface around it is slightly red."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.59,
      "end_seconds": 196.65,
      "duration_seconds": 3.06,
      "text": "Is it a growth? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.14,
      "end_seconds": 207.75,
      "duration_seconds": 9.61,
      "text": "It's a benign thickening of the surface, and from the look of it I'd say it's a pinguecula."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.82,
      "end_seconds": 211.97,
      "duration_seconds": 3.15,
      "text": "What causes it? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.82,
      "end_seconds": 221.64,
      "duration_seconds": 8.82,
      "text": "Sun, wind and dust over the years, so it's very common in people who work outdoors. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.02,
      "end_seconds": 226.28,
      "duration_seconds": 2.26,
      "text": "Is it dangerous? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.1,
      "end_seconds": 240.96,
      "duration_seconds": 11.86,
      "text": "No, it isn't cancerous. It can get irritated, and rarely it can grow onto the cornea, so we keep an eye on it. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.25,
      "end_seconds": 247.2,
      "duration_seconds": 3.95,
      "text": "Do I need an operation? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.71,
      "end_seconds": 258.75,
      "duration_seconds": 9.04,
      "text": "Not at all. I'd like to do a vision test with the chart now, to have a baseline."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.47,
      "end_seconds": 277.57,
      "duration_seconds": 1.1,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.34,
      "end_seconds": 290.71,
      "duration_seconds": 11.37,
      "text": "Good, your vision is excellent. I'll also take a photograph of the eye, so we can compare it in future."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.79,
      "end_seconds": 296.33,
      "duration_seconds": 4.54,
      "text": "Thank you. What do I do? ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.21,
      "end_seconds": 304.73,
      "duration_seconds": 6.52,
      "text": "Wear wraparound sunglasses outdoors, keep using the drops, and avoid rubbing it."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.64,
      "end_seconds": 310.76,
      "duration_seconds": 4.12,
      "text": "I'll buy some proper sunglasses. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.17,
      "end_seconds": 321.19,
      "duration_seconds": 8.02,
      "text": "I'd like to see you again in six months to compare the photograph."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.58,
      "end_seconds": 326.51,
      "duration_seconds": 2.93,
      "text": "Six months. Thanks, doctor. ~"
    }
  ]
}
