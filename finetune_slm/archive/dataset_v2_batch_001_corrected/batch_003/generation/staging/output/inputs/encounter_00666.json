{
  "schema_version": "1.0",
  "encounter_id": "00666",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.13,
      "end_seconds": 12.59,
      "duration_seconds": 11.46,
      "text": "Good afternoon, doctor. I'm afraid my thumb is still not right, three weeks on. I'd hoped to be skiing again by now."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.73,
      "end_seconds": 21.06,
      "duration_seconds": 6.33,
      "text": "I'm Hugh's carer, doctor. I've been driving him since the injury. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.99,
      "end_seconds": 30.16,
      "duration_seconds": 6.17,
      "text": "Pleased to meet you both. Hugh, remind me what happened. ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.64,
      "end_seconds": 51.32,
      "duration_seconds": 18.68,
      "text": "A fall on the second day of the trip, my thumb caught in the strap of my pole. It swelled up almost immediately, and it's been painful at the base since."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.09,
      "end_seconds": 56.72,
      "duration_seconds": 3.63,
      "text": "How painful is it today?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.65,
      "end_seconds": 66.94,
      "duration_seconds": 7.29,
      "text": "Moderate, I'd say. It's worst when I try to grip, or pinch a pen."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.11,
      "end_seconds": 71.13,
      "duration_seconds": 3.02,
      "text": "And is the thumb stiff?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.46,
      "end_seconds": 79.34,
      "duration_seconds": 5.88,
      "text": "Yes, a bit stiff in the morning, though that eases."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.72,
      "end_seconds": 85.18,
      "duration_seconds": 4.46,
      "text": "Any numbness or tingling in the thumb or fingers?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.42,
      "end_seconds": 89.62,
      "duration_seconds": 3.2,
      "text": "No, there's no numbness."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.95,
      "end_seconds": 95.54,
      "duration_seconds": 3.59,
      "text": "What are you taking for it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.75,
      "end_seconds": 113.56,
      "duration_seconds": 15.81,
      "text": "Ibuprofen, 400 mg three times a day, and paracetamol, 1 gram, as well when it's bad. And omeprazole, 20 mg once a day, to protect my stomach."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.15,
      "end_seconds": 117.69,
      "duration_seconds": 2.54,
      "text": "Good thinking. Any allergies?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.32,
      "end_seconds": 123.31,
      "duration_seconds": 3.99,
      "text": "None that I'm aware of. No allergies."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.5,
      "end_seconds": 126.66,
      "duration_seconds": 2.16,
      "text": "Any other conditions?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.93,
      "end_seconds": 134.16,
      "duration_seconds": 5.23,
      "text": "Osteoarthritis in the other hand, nothing in this one."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.61,
      "end_seconds": 142.42,
      "duration_seconds": 5.81,
      "text": "Did you have the thumb X-rayed in the resort?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.99,
      "end_seconds": 153.65,
      "duration_seconds": 8.66,
      "text": "Yes, they did an X-ray on the first day. They said there was no fracture."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.65,
      "end_seconds": 162.18,
      "duration_seconds": 5.53,
      "text": "That's useful. Let me look at it. Which hand? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.1,
      "end_seconds": 166.4,
      "duration_seconds": 2.3,
      "text": "The right. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.71,
      "end_seconds": 189.73,
      "duration_seconds": 6.02,
      "text": "Rest it on the table. Tell me if I find the spot."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.51,
      "end_seconds": 193.65,
      "duration_seconds": 2.14,
      "text": "Ah, there. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.77,
      "end_seconds": 210.21,
      "duration_seconds": 13.44,
      "text": "Swollen and tender on the inner side of the thumb joint, and the joint opens up a bit more than the other side when I stress it."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 211.2,
      "end_seconds": 214.16,
      "duration_seconds": 2.96,
      "text": "Is it broken? ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.14,
      "end_seconds": 223.54,
      "duration_seconds": 8.4,
      "text": "The X-ray says no. What I suspect is a torn ligament, what we call skier's thumb."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.73,
      "end_seconds": 231.77,
      "duration_seconds": 6.04,
      "text": "Skier's thumb. I like the sound of that, rather grand. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.45,
      "end_seconds": 249.63,
      "duration_seconds": 15.18,
      "text": "It's common, and it matters, because a ligament that's fully torn may need surgery. I'd like to arrange an MRI scan to see how badly it's damaged."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.52,
      "end_seconds": 255.46,
      "duration_seconds": 3.94,
      "text": "How long will that take? ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.52,
      "end_seconds": 269.26,
      "duration_seconds": 11.74,
      "text": "A couple of weeks for the appointment. Meanwhile, wear the thumb splint all day, and take it off only to wash."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.04,
      "end_seconds": 276.35,
      "duration_seconds": 4.31,
      "text": "I've got it in my bag, actually. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.22,
      "end_seconds": 286.34,
      "duration_seconds": 8.12,
      "text": "Put it on now, please. And no gripping, no skiing, and no lifting. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 287.43,
      "end_seconds": 292.41,
      "duration_seconds": 4.98,
      "text": "I'll hold the door for him. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.13,
      "end_seconds": 300.5,
      "duration_seconds": 6.37,
      "text": "I'd like to see you again in three weeks, with the scan."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.74,
      "end_seconds": 306.02,
      "duration_seconds": 3.28,
      "text": "Thank you, doctor. ~"
    }
  ]
}
