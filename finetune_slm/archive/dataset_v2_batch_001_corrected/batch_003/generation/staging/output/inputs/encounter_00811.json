{
  "schema_version": "1.0",
  "encounter_id": "00811",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 0.41,
      "end_seconds": 12.37,
      "duration_seconds": 11.96,
      "text": "Morning, Mr Fitzgerald. I'm GrÃ¡inne, I'm the healthcare assistant. I've printed your medication list for the doctor, so we can go through it. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.51,
      "end_seconds": 24.68,
      "duration_seconds": 10.17,
      "text": "Ah, thanks a million. Sure, I'll talk the hind legs off a donkey, you'll have to stop me. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.79,
      "end_seconds": 31.59,
      "duration_seconds": 5.8,
      "text": "Hello, Mr Fitzgerald. It's the back, isn't it, and the leg?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.69,
      "end_seconds": 44.43,
      "duration_seconds": 10.74,
      "text": "It is, doctor. Lower back, and it runs down the back of my left leg, to the calf, like a hot wire."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.32,
      "end_seconds": 51.13,
      "duration_seconds": 3.81,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.24,
      "end_seconds": 63.0,
      "duration_seconds": 9.76,
      "text": "Three weeks. It started after I was lifting sacks of potatoes. I'm a farmer, you see."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.46,
      "end_seconds": 68.18,
      "duration_seconds": 3.72,
      "text": "Is it worse sitting, standing, or walking?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.17,
      "end_seconds": 76.45,
      "duration_seconds": 6.28,
      "text": "Sitting, mostly. And coughing, or sneezing, that sends a jolt down."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.34,
      "end_seconds": 83.53,
      "duration_seconds": 4.19,
      "text": "Any numbness, or weakness in the foot?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.43,
      "end_seconds": 91.74,
      "duration_seconds": 6.31,
      "text": "A bit of tingling in the toes. But the foot's strong. No weakness."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.76,
      "end_seconds": 101.44,
      "duration_seconds": 7.68,
      "text": "Any trouble with your bladder or bowels, or numbness in your groin? ~"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.29,
      "end_seconds": 105.44,
      "duration_seconds": 2.15,
      "text": "None whatsoever. ~"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 108.14,
      "end_seconds": 111.86,
      "duration_seconds": 3.72,
      "text": "Doctor, here's his list. ~"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.86,
      "end_seconds": 119.29,
      "duration_seconds": 5.43,
      "text": "Thanks, GrÃ¡inne. Mr Fitzgerald, let's go through the medicines."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.46,
      "end_seconds": 131.03,
      "duration_seconds": 9.57,
      "text": "Naproxen, 500 mg twice a day, with food. And paracetamol, 1 gram, four times a day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.85,
      "end_seconds": 135.81,
      "duration_seconds": 2.96,
      "text": "Is that helping? ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.16,
      "end_seconds": 142.7,
      "duration_seconds": 4.54,
      "text": "Takes the edge off. Not the leg. ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.39,
      "end_seconds": 147.25,
      "duration_seconds": 1.86,
      "text": "Any other conditions?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.99,
      "end_seconds": 151.71,
      "duration_seconds": 3.72,
      "text": "High blood pressure, and my knees."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.73,
      "end_seconds": 156.17,
      "duration_seconds": 2.44,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.82,
      "end_seconds": 163.9,
      "duration_seconds": 6.08,
      "text": "I stopped a few years back, ten a day, for forty years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 166.32,
      "end_seconds": 172.0,
      "duration_seconds": 5.68,
      "text": "Would you like me to take his blood pressure, doctor? ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.07,
      "end_seconds": 181.22,
      "duration_seconds": 7.15,
      "text": "Not today, thanks, GrÃ¡inne. Mr Fitzgerald, I'll check your leg. Lift it straight. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.33,
      "end_seconds": 202.76,
      "duration_seconds": 2.43,
      "text": "Ow. That's the one."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.56,
      "end_seconds": 220.01,
      "duration_seconds": 16.45,
      "text": "It's reproduced the pain when I raise the left leg, and your ankle reflex is a bit reduced on that side, but your strength is normal. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.85,
      "end_seconds": 225.69,
      "duration_seconds": 2.84,
      "text": "Is that a disc? ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.54,
      "end_seconds": 236.04,
      "duration_seconds": 9.5,
      "text": "It sounds like sciatica, which is a pinched nerve at the lower back, often from a slipped disc. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.17,
      "end_seconds": 241.09,
      "duration_seconds": 2.92,
      "text": "Will it need surgery? ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.47,
      "end_seconds": 248.31,
      "duration_seconds": 5.84,
      "text": "Most people improve without it, over six to twelve weeks. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.6,
      "end_seconds": 253.54,
      "duration_seconds": 2.94,
      "text": "Could I keep working? ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.1,
      "end_seconds": 261.24,
      "duration_seconds": 6.14,
      "text": "Yes, gentle activity, but no heavy lifting. Staying in bed is worse."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.13,
      "end_seconds": 266.27,
      "duration_seconds": 4.14,
      "text": "How will I lift the sacks? ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.33,
      "end_seconds": 271.62,
      "duration_seconds": 4.29,
      "text": "Ask for help, and bend your knees. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.01,
      "end_seconds": 276.56,
      "duration_seconds": 3.55,
      "text": "I'll get my son. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.92,
      "end_seconds": 284.5,
      "duration_seconds": 5.58,
      "text": "Keep taking the naproxen with food, and the paracetamol regularly."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 287.47,
      "end_seconds": 290.93,
      "duration_seconds": 3.46,
      "text": "And hot water bottles, doctor? ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.7,
      "end_seconds": 309.12,
      "duration_seconds": 15.42,
      "text": "Heat helps, yes. If you develop numbness between your legs, can't control your bladder or bowels, or your foot becomes weak, go to the emergency department right away."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.9,
      "end_seconds": 312.96,
      "duration_seconds": 2.06,
      "text": "I will. ~"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.06,
      "end_seconds": 324.33,
      "duration_seconds": 9.27,
      "text": "Otherwise, if it's not better in six weeks, come back and I'll arrange a scan and a physiotherapy referral."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.52,
      "end_seconds": 329.16,
      "duration_seconds": 3.64,
      "text": "Right. Thanks a million, doctor. ~"
    }
  ]
}
