{
  "schema_version": "1.0",
  "encounter_id": "00704",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 0.47,
      "end_seconds": 9.2,
      "duration_seconds": 8.73,
      "text": "Doctor, quick, he got cleaning fluid in his eye, from the bottle, a spray!"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.06,
      "end_seconds": 14.96,
      "duration_seconds": 4.9,
      "text": "Right, sit him here. What's your name? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.93,
      "end_seconds": 20.12,
      "duration_seconds": 2.19,
      "text": "Ravi. It burns."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.15,
      "end_seconds": 28.84,
      "duration_seconds": 6.69,
      "text": "Ravi, did you wash the eye out at home? ~"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 29.64,
      "end_seconds": 36.81,
      "duration_seconds": 7.17,
      "text": "A bit, with the tap, a minute or two. Then we drove here. ~"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.9,
      "end_seconds": 41.37,
      "duration_seconds": 3.47,
      "text": "How long ago did it happen?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.16,
      "end_seconds": 47.76,
      "duration_seconds": 3.6,
      "text": "Ten minutes. About 10 minutes."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 49.42,
      "end_seconds": 60.1,
      "duration_seconds": 10.68,
      "text": "No, it was half an hour, at least, 30 minutes, I looked at the clock when we left the house."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.36,
      "end_seconds": 76.22,
      "duration_seconds": 13.86,
      "text": "I'll write it down as 10 to 30 minutes. It doesn't change what I do, we're washing it out now. Do you know which cleaner it was?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 78.29,
      "end_seconds": 85.7,
      "duration_seconds": 7.41,
      "text": "Yes, I've got the bottle in my bag. It's a bathroom spray with bleach. ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.53,
      "end_seconds": 94.14,
      "duration_seconds": 7.61,
      "text": "Please give it to the nurse. Ravi, can you open your eye for me? ~"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.62,
      "end_seconds": 97.7,
      "duration_seconds": 2.08,
      "text": "It hurts. ~"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.73,
      "end_seconds": 123.28,
      "duration_seconds": 4.55,
      "text": "I know. I'm putting numbing drops in first."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.28,
      "end_seconds": 135.25,
      "duration_seconds": 8.97,
      "text": "Now I'm going to wash it with lots of fluid. Look up, look down, it'll feel wet. ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.21,
      "end_seconds": 178.9,
      "duration_seconds": 1.69,
      "text": "It's cold."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.03,
      "end_seconds": 189.08,
      "duration_seconds": 8.05,
      "text": "That's it. Keep going, we need to do this for a good ten to fifteen minutes. ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 190.77,
      "end_seconds": 195.28,
      "duration_seconds": 4.51,
      "text": "Is he going to be blind? ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.02,
      "end_seconds": 205.78,
      "duration_seconds": 9.76,
      "text": "I don't think so, but I need to examine the eye properly once it's washed. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.61,
      "end_seconds": 209.59,
      "duration_seconds": 1.98,
      "text": "Better now. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.33,
      "end_seconds": 213.63,
      "duration_seconds": 3.3,
      "text": "Good. Is your vision blurred?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.62,
      "end_seconds": 217.44,
      "duration_seconds": 2.82,
      "text": "A little. Not too much."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.54,
      "end_seconds": 223.42,
      "duration_seconds": 3.88,
      "text": "Any swelling of the eyelids?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.71,
      "end_seconds": 228.52,
      "duration_seconds": 2.81,
      "text": "No. Eyelids are fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.22,
      "end_seconds": 234.69,
      "duration_seconds": 3.47,
      "text": "Do you take any tablets?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 236.81,
      "end_seconds": 245.91,
      "duration_seconds": 9.1,
      "text": "He takes cetirizine, 10 mg, I think, maybe? For his asthma and hay fever."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.9,
      "end_seconds": 253.58,
      "duration_seconds": 6.68,
      "text": "Right. I'll note what you tell me. Pulse and oxygen for me. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.07,
      "end_seconds": 257.85,
      "duration_seconds": 1.78,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.99,
      "end_seconds": 272.07,
      "duration_seconds": 3.08,
      "text": "Pulse 86, oxygen 99 percent."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.87,
      "end_seconds": 288.7,
      "duration_seconds": 14.83,
      "text": "I've checked the surface with a dye and a blue light. There's a patch on the surface of the eye where the cells have been damaged, mostly in the lower half."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 290.64,
      "end_seconds": 293.69,
      "duration_seconds": 3.05,
      "text": "Will it heal? ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.5,
      "end_seconds": 309.86,
      "duration_seconds": 15.36,
      "text": "I can't be certain yet. This could be a chemical burn of the surface, and I can't rule out deeper damage until the eye specialist has seen him."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 310.9,
      "end_seconds": 315.55,
      "duration_seconds": 4.65,
      "text": "Do we go to another hospital? ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.44,
      "end_seconds": 332.18,
      "duration_seconds": 15.74,
      "text": "No, the eye team is here, and I'd like them to see him now. I'll also check the acidity of the eye, the pH, to make sure it's been washed clean."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.8,
      "end_seconds": 338.22,
      "duration_seconds": 4.42,
      "text": "Will I be able to go home? ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.07,
      "end_seconds": 350.47,
      "duration_seconds": 9.4,
      "text": "Possibly after the specialist sees you. Don't rub the eye, and keep the bottle with the nurse."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 352.62,
      "end_seconds": 355.65,
      "duration_seconds": 3.03,
      "text": "Thank you, doctor. ~"
    }
  ]
}
