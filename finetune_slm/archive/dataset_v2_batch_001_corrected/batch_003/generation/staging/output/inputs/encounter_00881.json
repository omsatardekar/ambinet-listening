{
  "schema_version": "1.0",
  "encounter_id": "00881",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 2.25,
      "end_seconds": 14.09,
      "duration_seconds": 11.84,
      "text": "Good afternoon, doctor. This is a bit awkward to talk about, but I think my antidepressant is affecting my sex life."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.05,
      "end_seconds": 28.38,
      "duration_seconds": 11.33,
      "text": "Thank you for raising it, it's a very common concern and nothing to be embarrassed about. Which antidepressant are you taking?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.56,
      "end_seconds": 37.16,
      "duration_seconds": 5.6,
      "text": "Sertraline, 100 mg, once a day, in the morning."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.59,
      "end_seconds": 43.59,
      "duration_seconds": 4.0,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.38,
      "end_seconds": 49.18,
      "duration_seconds": 1.8,
      "text": "About eight months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.34,
      "end_seconds": 57.23,
      "duration_seconds": 4.89,
      "text": "And how has your mood been on it? ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.6,
      "end_seconds": 66.78,
      "duration_seconds": 6.18,
      "text": "Much better, honestly. That's why I don't want to stop it. ~"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.33,
      "end_seconds": 78.03,
      "duration_seconds": 7.7,
      "text": "That's good to hear. What changes have you noticed in your sex life? ~"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.54,
      "end_seconds": 91.8,
      "duration_seconds": 10.26,
      "text": "Less desire, and it takes much longer to reach orgasm. My wife and I have talked about it. ~"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.4,
      "end_seconds": 99.66,
      "duration_seconds": 5.26,
      "text": "Did you have any difficulties before starting the sertraline? ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.23,
      "end_seconds": 111.31,
      "duration_seconds": 8.08,
      "text": "No, nothing at all. It started a few weeks after I began taking it. ~"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.55,
      "end_seconds": 116.56,
      "duration_seconds": 3.01,
      "text": "Any problems with erections?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.68,
      "end_seconds": 121.85,
      "duration_seconds": 2.17,
      "text": "No, that's fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.34,
      "end_seconds": 129.61,
      "duration_seconds": 5.27,
      "text": "Are you drinking much alcohol or using any recreational drugs?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.5,
      "end_seconds": 137.36,
      "duration_seconds": 4.86,
      "text": "A couple of beers at the weekend, nothing else."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.7,
      "end_seconds": 144.88,
      "duration_seconds": 4.18,
      "text": "Do you have any allergies to medicines?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.22,
      "end_seconds": 149.13,
      "duration_seconds": 1.91,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.92,
      "end_seconds": 157.47,
      "duration_seconds": 5.55,
      "text": "Let me check your blood pressure and pulse. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.42,
      "end_seconds": 170.79,
      "duration_seconds": 1.37,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.24,
      "end_seconds": 178.52,
      "duration_seconds": 4.28,
      "text": "Blood pressure 124 over 78, pulse 70."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.33,
      "end_seconds": 184.0,
      "duration_seconds": 1.67,
      "text": "Normal? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.77,
      "end_seconds": 197.57,
      "duration_seconds": 10.8,
      "text": "Yes, normal. This is a recognised side effect of sertraline, and I don't think it's a sign that anything else is wrong."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.64,
      "end_seconds": 205.13,
      "duration_seconds": 4.49,
      "text": "Is there anything we can do about it? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.6,
      "end_seconds": 221.21,
      "duration_seconds": 13.61,
      "text": "There are a few options. We could lower the dose a little, or switch to another antidepressant that has fewer sexual effects. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.1,
      "end_seconds": 229.85,
      "duration_seconds": 4.75,
      "text": "I'm worried about my mood getting worse. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.24,
      "end_seconds": 239.46,
      "duration_seconds": 7.22,
      "text": "That's reasonable. Please don't stop the sertraline or change the dose by yourself."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.12,
      "end_seconds": 245.1,
      "duration_seconds": 1.98,
      "text": "I won't. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.4,
      "end_seconds": 257.61,
      "duration_seconds": 9.21,
      "text": "I'd like to review your mood with a questionnaire first, so we change things only if it's safe."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.01,
      "end_seconds": 263.58,
      "duration_seconds": 3.57,
      "text": "Okay, I can do that. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.95,
      "end_seconds": 271.74,
      "duration_seconds": 5.79,
      "text": "We can do it right now, if you're happy to. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.12,
      "end_seconds": 277.76,
      "duration_seconds": 2.64,
      "text": "Yes, go ahead. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.05,
      "end_seconds": 291.48,
      "duration_seconds": 11.43,
      "text": "Let's go through it, then we'll talk about the next step, and I'll see you again in four weeks."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.72,
      "end_seconds": 297.84,
      "duration_seconds": 4.12,
      "text": "Thank you for being so understanding. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.93,
      "end_seconds": 305.99,
      "duration_seconds": 5.06,
      "text": "Not at all. Many people feel the same way. ~"
    }
  ]
}
