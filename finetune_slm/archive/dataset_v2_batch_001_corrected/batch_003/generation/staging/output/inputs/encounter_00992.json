{
  "schema_version": "1.0",
  "encounter_id": "00992",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 4.43,
      "end_seconds": 14.06,
      "duration_seconds": 9.63,
      "text": "Morning. I'd like to review my blood pressure tablets. My GP mentioned I should go through them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.53,
      "end_seconds": 23.11,
      "duration_seconds": 4.58,
      "text": "Happy to. Tell me exactly what you take."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.93,
      "end_seconds": 38.15,
      "duration_seconds": 10.22,
      "text": "Amlodipine, 10 mg, once a day. Ramipril, 10 mg, once a day. And indapamide, 1.5 mg, in the morning."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.19,
      "end_seconds": 47.69,
      "duration_seconds": 4.5,
      "text": "Do you take all of them every day?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.79,
      "end_seconds": 62.56,
      "duration_seconds": 9.77,
      "text": "The amlodipine and indapamide, yes. The ramipril, I take every day, except weekends, when I'm away and I forget."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.79,
      "end_seconds": 73.34,
      "duration_seconds": 5.55,
      "text": "Thanks for being straight. How long on this combination? ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.13,
      "end_seconds": 80.74,
      "duration_seconds": 2.61,
      "text": "About two years. ~"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.81,
      "end_seconds": 88.82,
      "duration_seconds": 3.01,
      "text": "Conditions I should know?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.05,
      "end_seconds": 96.97,
      "duration_seconds": 3.92,
      "text": "High blood pressure, obviously. And gout."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.68,
      "end_seconds": 104.74,
      "duration_seconds": 3.06,
      "text": "Have you had any falls?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.74,
      "end_seconds": 111.38,
      "duration_seconds": 1.64,
      "text": "No falls."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.11,
      "end_seconds": 133.15,
      "duration_seconds": 9.04,
      "text": "Let me take your numbers. Blood pressure 126 over 74, pulse 68, weight 90 kilos."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.35,
      "end_seconds": 142.31,
      "duration_seconds": 3.96,
      "text": "That's where I'd like it. ~"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.33,
      "end_seconds": 153.04,
      "duration_seconds": 5.71,
      "text": "It's good. Does it hold up on weekends? ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.89,
      "end_seconds": 162.3,
      "duration_seconds": 4.41,
      "text": "Hard to say. I only measure on weekdays. ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.25,
      "end_seconds": 171.19,
      "duration_seconds": 3.94,
      "text": "Worth measuring on a weekend or two. ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.75,
      "end_seconds": 177.66,
      "duration_seconds": 1.91,
      "text": "Fair. ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.58,
      "end_seconds": 194.51,
      "duration_seconds": 11.93,
      "text": "The ramipril is the one that matters for your kidneys and heart, so I'd like you to set a phone alarm for it, including weekends."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.05,
      "end_seconds": 202.68,
      "duration_seconds": 3.63,
      "text": "I do have a phone. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.12,
      "end_seconds": 212.31,
      "duration_seconds": 5.19,
      "text": "Take it with breakfast, wherever you are. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.88,
      "end_seconds": 219.48,
      "duration_seconds": 2.6,
      "text": "Easy enough. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.46,
      "end_seconds": 234.43,
      "duration_seconds": 9.97,
      "text": "Since you're on a water tablet and the ramipril, I'd like to arrange blood tests for kidney function and salts."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.68,
      "end_seconds": 240.63,
      "duration_seconds": 1.95,
      "text": "When? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.15,
      "end_seconds": 251.6,
      "duration_seconds": 6.45,
      "text": "This week. And I'd like an ECG, as it's been a while."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.09,
      "end_seconds": 257.89,
      "duration_seconds": 1.8,
      "text": "Fine. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.91,
      "end_seconds": 266.43,
      "duration_seconds": 3.52,
      "text": "Anything else about the tablets? ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.77,
      "end_seconds": 272.45,
      "duration_seconds": 1.68,
      "text": "No. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.08,
      "end_seconds": 284.21,
      "duration_seconds": 7.13,
      "text": "Keep a weekend blood pressure log, then, and bring it next time."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.92,
      "end_seconds": 291.38,
      "duration_seconds": 2.46,
      "text": "Will do. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.44,
      "end_seconds": 299.11,
      "duration_seconds": 2.67,
      "text": "Good. That's everything. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.21,
      "end_seconds": 306.02,
      "duration_seconds": 1.81,
      "text": "Thanks. ~"
    }
  ]
}
