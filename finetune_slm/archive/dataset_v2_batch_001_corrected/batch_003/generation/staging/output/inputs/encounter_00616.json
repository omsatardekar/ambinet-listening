{
  "schema_version": "1.0",
  "encounter_id": "00616",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.6,
      "end_seconds": 9.04,
      "duration_seconds": 8.44,
      "text": "Morning. I've got a meeting at ten, so can we keep this quick? ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.97,
      "end_seconds": 19.71,
      "duration_seconds": 9.74,
      "text": "We'll be as quick as we can. Your booking says routine check. Anything in particular on your mind? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.58,
      "end_seconds": 33.38,
      "duration_seconds": 10.8,
      "text": "Just the usual health check the company pays for. Oh, and my headaches keep coming back, by the way."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.85,
      "end_seconds": 37.4,
      "duration_seconds": 2.55,
      "text": "Tell me about them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.16,
      "end_seconds": 45.38,
      "duration_seconds": 7.22,
      "text": "Tight, like a band round my forehead. Mostly late afternoon at my desk."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.3,
      "end_seconds": 54.75,
      "duration_seconds": 7.45,
      "text": "How long has that been going on, and how bad do they get?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.46,
      "end_seconds": 64.52,
      "duration_seconds": 7.06,
      "text": "About three months. Mild, honestly. It's more of a nuisance than anything."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.55,
      "end_seconds": 70.55,
      "duration_seconds": 5.0,
      "text": "Any nausea with them, or changes in your vision?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.69,
      "end_seconds": 79.5,
      "duration_seconds": 6.81,
      "text": "No nausea, and my vision's fine. Sleep's fine too, before you ask."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.18,
      "end_seconds": 86.29,
      "duration_seconds": 4.11,
      "text": "Good. Any tablets you take regularly?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.12,
      "end_seconds": 95.33,
      "duration_seconds": 7.21,
      "text": "Candesartan, 8 mg once a day, for my high blood pressure."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.12,
      "end_seconds": 103.09,
      "duration_seconds": 4.97,
      "text": "And are you allergic to anything, medicines especially?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.57,
      "end_seconds": 116.22,
      "duration_seconds": 11.65,
      "text": "Penicillin. Came up in a rash when I was a kid, so they've kept it off my list ever since."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.8,
      "end_seconds": 123.55,
      "duration_seconds": 4.75,
      "text": "Thanks. Any heart disease or strokes in the family?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.28,
      "end_seconds": 136.35,
      "duration_seconds": 10.07,
      "text": "Dad had a heart attack at sixty. That's really why I come for these checks every year."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.39,
      "end_seconds": 148.41,
      "duration_seconds": 11.02,
      "text": "Sensible. Let me do your numbers. Sit back for me and rest your arm on the table. ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.67,
      "end_seconds": 155.59,
      "duration_seconds": 5.92,
      "text": "Cuff always feels tighter than it needs to. ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.92,
      "end_seconds": 184.94,
      "duration_seconds": 9.02,
      "text": "Blood pressure 128 over 80, pulse 68, temperature 36.6, oxygen 98 percent, and you're 84 kilos."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.17,
      "end_seconds": 189.23,
      "duration_seconds": 3.06,
      "text": "Is that all right? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.74,
      "end_seconds": 196.69,
      "duration_seconds": 5.95,
      "text": "All right indeed. Any cough, wheeze or breathlessness when you're active?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.66,
      "end_seconds": 204.83,
      "duration_seconds": 6.17,
      "text": "No, nothing. I run on Saturdays and have no trouble at all."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.49,
      "end_seconds": 210.86,
      "duration_seconds": 4.37,
      "text": "Any chest pain, palpitations or ankle swelling?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.96,
      "end_seconds": 214.78,
      "duration_seconds": 2.82,
      "text": "No. None of that."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.24,
      "end_seconds": 236.71,
      "duration_seconds": 9.47,
      "text": "Your shoulders are tight and the neck moves freely. A couple of tender knots across the top, nothing sinister."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.44,
      "end_seconds": 245.13,
      "duration_seconds": 6.69,
      "text": "Yeah, they do ache if I press them. So is it anything serious? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.19,
      "end_seconds": 263.58,
      "duration_seconds": 16.39,
      "text": "Nothing in what you've told me or what I've found sets off any alarm bells. Since you're on candesartan, I'd like to check your cholesterol and kidney function with a blood test too."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.55,
      "end_seconds": 269.92,
      "duration_seconds": 4.37,
      "text": "Fine. Where do I do that? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.27,
      "end_seconds": 280.7,
      "duration_seconds": 9.43,
      "text": "Reception will give you a form for the lab downstairs. It's walk-in, you don't need an appointment. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.54,
      "end_seconds": 287.29,
      "duration_seconds": 4.75,
      "text": "Great. Any tips for the headaches themselves? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.6,
      "end_seconds": 299.78,
      "duration_seconds": 11.18,
      "text": "Take a screen break every hour, raise your monitor a little, and drink water through the afternoon. Your shoulders will thank you."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.2,
      "end_seconds": 307.86,
      "duration_seconds": 5.66,
      "text": "Easy enough. Do I need to come back about them? ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.56,
      "end_seconds": 318.32,
      "duration_seconds": 8.76,
      "text": "Not unless they get worse or change in character. If they do, ring the surgery rather than waiting."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.23,
      "end_seconds": 326.89,
      "duration_seconds": 6.66,
      "text": "Perfect. I might actually make my meeting after all. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.74,
      "end_seconds": 331.57,
      "duration_seconds": 3.83,
      "text": "Good luck with it. ~"
    }
  ]
}
