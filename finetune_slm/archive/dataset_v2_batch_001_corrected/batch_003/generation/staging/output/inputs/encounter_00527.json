{
  "schema_version": "1.0",
  "encounter_id": "00527",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 1.13,
      "end_seconds": 12.44,
      "duration_seconds": 11.31,
      "text": "Morning, doctor. I've brought Mrs Adeyemi through from the waiting room. Her daughter's just parking the car, she'll be along in a minute."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.91,
      "end_seconds": 20.29,
      "duration_seconds": 6.38,
      "text": "Thank you. Good morning, Mrs Adeyemi, do sit down. And you are...?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 23.13,
      "end_seconds": 28.3,
      "duration_seconds": 5.17,
      "text": "Joy. I'm her carer, I come in mornings and evenings."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.62,
      "end_seconds": 36.82,
      "duration_seconds": 7.2,
      "text": "Lovely. So, Mrs Adeyemi, what's brought you in to see me today?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.14,
      "end_seconds": 44.59,
      "duration_seconds": 5.45,
      "text": "Well, it's... I don't really know that there's, um..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 46.18,
      "end_seconds": 59.32,
      "duration_seconds": 13.14,
      "text": "Sorry I'm late, the car park is a nightmare. Has Mum said anything yet? She's been so tired since she came out of hospital in the spring."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.4,
      "end_seconds": 65.71,
      "duration_seconds": 5.31,
      "text": "I wouldn't say tired, exactly. Just a bit, you know..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.55,
      "end_seconds": 73.4,
      "duration_seconds": 4.85,
      "text": "A bit what, Mrs Adeyemi? Take your time."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.68,
      "end_seconds": 80.09,
      "duration_seconds": 4.41,
      "text": "Slow. I'm not tired. Slow, that's all."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.06,
      "end_seconds": 89.91,
      "duration_seconds": 8.85,
      "text": "Slow is a good word for it. Is it all day, or worse at certain times?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.62,
      "end_seconds": 96.04,
      "duration_seconds": 4.42,
      "text": "Mornings are fine. It's after lunch that I..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.55,
      "end_seconds": 100.8,
      "duration_seconds": 2.25,
      "text": "After lunch, you...?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 102.3,
      "end_seconds": 109.59,
      "duration_seconds": 7.29,
      "text": "She's asleep in the armchair by three o'clock, every single afternoon. Joy finds her there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.32,
      "end_seconds": 113.44,
      "duration_seconds": 3.12,
      "text": "I'm only resting my eyes."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 116.01,
      "end_seconds": 127.22,
      "duration_seconds": 11.21,
      "text": "She's eating well, I'll say that for her. I made her a proper dinner yesterday and she cleared the plate."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.93,
      "end_seconds": 137.6,
      "duration_seconds": 9.67,
      "text": "That's good to hear, appetite is a useful clue. Mrs Adeyemi, how do you feel about the afternoons yourself?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.98,
      "end_seconds": 143.65,
      "duration_seconds": 3.67,
      "text": "It's only resting, dear. Everybody rests."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.69,
      "end_seconds": 155.14,
      "duration_seconds": 9.45,
      "text": "They do. Everyone's batteries run down. I'm just wondering whether yours are recharging as well as they used to."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.8,
      "end_seconds": 159.78,
      "duration_seconds": 1.98,
      "text": "Perhaps not quite..."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.0,
      "end_seconds": 167.25,
      "duration_seconds": 6.25,
      "text": "Fair enough. Do you live on your own, or with family?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.57,
      "end_seconds": 177.74,
      "duration_seconds": 9.17,
      "text": "On my own. In my flat. The ground floor one, I've been there forty years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 178.49,
      "end_seconds": 184.69,
      "duration_seconds": 6.2,
      "text": "With Joy coming in twice a day, and me most weekends."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.83,
      "end_seconds": 198.56,
      "duration_seconds": 12.73,
      "text": "That sounds a good set-up. Mrs Adeyemi, would you mind if I had a look at your neck? Just to see how everything has settled."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.35,
      "end_seconds": 203.32,
      "duration_seconds": 2.97,
      "text": "Oh. Yes, if you like."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.26,
      "end_seconds": 214.76,
      "duration_seconds": 9.5,
      "text": "Chin up a little for me. Mm. The scar has healed very neatly, it's flat and quite pale now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.37,
      "end_seconds": 219.27,
      "duration_seconds": 2.9,
      "text": "That's good, is it?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.09,
      "end_seconds": 227.93,
      "duration_seconds": 6.84,
      "text": "It's very good. Nice tidy healing, whoever did it knew their stuff."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 229.85,
      "end_seconds": 236.82,
      "duration_seconds": 6.97,
      "text": "But what about the sleeping, doctor? That's why I wanted her seen."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.62,
      "end_seconds": 260.91,
      "duration_seconds": 23.29,
      "text": "Of course. I'll tell you what I think. It looks most likely that she's still catching up after the hospital stay. Picture a phone battery that's had a rough month: it takes a while before it holds its charge like before."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.0,
      "end_seconds": 264.94,
      "duration_seconds": 1.94,
      "text": "Catching up."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.19,
      "end_seconds": 272.76,
      "duration_seconds": 6.57,
      "text": "Yes. And that sort of thing tends to improve gradually, not overnight."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 275.34,
      "end_seconds": 281.06,
      "duration_seconds": 5.72,
      "text": "So it's not something we should be worried about?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.7,
      "end_seconds": 286.7,
      "duration_seconds": 4.0,
      "text": "Nothing I've seen today worries me, no."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.63,
      "end_seconds": 310.99,
      "duration_seconds": 21.36,
      "text": "What helps meanwhile is a short walk in the morning light, a proper lunch, and if she does need the afternoon rest, half an hour on her bed rather than the armchair, so it doesn't swallow the whole afternoon."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 311.78,
      "end_seconds": 321.4,
      "duration_seconds": 9.62,
      "text": "I can walk her round the block before lunch, weather permitting. She likes the little park."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.64,
      "end_seconds": 327.18,
      "duration_seconds": 3.54,
      "text": "I do like the park."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.84,
      "end_seconds": 339.67,
      "duration_seconds": 10.83,
      "text": "Then that's settled. Joy, if you're happy to keep going as you are, that's all anyone can ask."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 341.16,
      "end_seconds": 345.35,
      "duration_seconds": 4.19,
      "text": "Thank you, doctor. I'll stop fussing, I promise."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.25,
      "end_seconds": 349.44,
      "duration_seconds": 2.19,
      "text": "Thank you, doctor."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.78,
      "end_seconds": 357.33,
      "duration_seconds": 6.55,
      "text": "Not at all. Off you go, and don't let her skip lunch."
    }
  ]
}
