{
  "schema_version": "1.0",
  "encounter_id": "00855",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 0.78,
      "end_seconds": 8.15,
      "duration_seconds": 7.37,
      "text": "Mr Hollis, is it Gerald, Gerald Hollis? You're down for a travel check. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.37,
      "end_seconds": 22.9,
      "duration_seconds": 13.53,
      "text": "That's me. We're off to Tanzania in six weeks, a charity build, and my daughter said I'd better get checked first. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.55,
      "end_seconds": 33.37,
      "duration_seconds": 8.82,
      "text": "Smart daughter. Think of this as a service before a long drive. How are you generally? ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.51,
      "end_seconds": 43.1,
      "duration_seconds": 6.59,
      "text": "Fine. Can't complain. A bit of heartburn, on and off."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.33,
      "end_seconds": 48.25,
      "duration_seconds": 3.92,
      "text": "How long's the heartburn been around?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.6,
      "end_seconds": 56.86,
      "duration_seconds": 6.26,
      "text": "Hm. A while. A year? Two? I honestly couldn't say when it began."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.64,
      "end_seconds": 60.65,
      "duration_seconds": 2.01,
      "text": "And your knees?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.5,
      "end_seconds": 69.22,
      "duration_seconds": 6.72,
      "text": "A bit stiff in the mornings. Nothing to write home about."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.48,
      "end_seconds": 74.45,
      "duration_seconds": 3.97,
      "text": "Any breathlessness when you're going uphill?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.29,
      "end_seconds": 81.6,
      "duration_seconds": 5.31,
      "text": "A bit puffy on the steep bits. I'm sixty-one, doc."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.65,
      "end_seconds": 85.69,
      "duration_seconds": 2.04,
      "text": "How's your sleep?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.35,
      "end_seconds": 91.72,
      "duration_seconds": 3.37,
      "text": "Light. I wake a lot."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.24,
      "end_seconds": 96.26,
      "duration_seconds": 2.02,
      "text": "Any chest pain?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.13,
      "end_seconds": 100.3,
      "duration_seconds": 2.17,
      "text": "None at all."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.35,
      "end_seconds": 105.82,
      "duration_seconds": 4.47,
      "text": "What are you taking at the moment?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.44,
      "end_seconds": 119.99,
      "duration_seconds": 11.55,
      "text": "Omeprazole, 20 mg, once a day, for the heartburn. And amlodipine, 5 mg, once a day, for the pressure."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.14,
      "end_seconds": 125.28,
      "duration_seconds": 4.14,
      "text": "Right. Tell me your medical history."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.25,
      "end_seconds": 133.75,
      "duration_seconds": 6.5,
      "text": "Reflux, obviously. High blood pressure. And arthritis in the knees, the doctor said."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.1,
      "end_seconds": 139.41,
      "duration_seconds": 3.31,
      "text": "Heart disease in the family?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.15,
      "end_seconds": 147.55,
      "duration_seconds": 5.4,
      "text": "My father had heart disease, he died at seventy."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.04,
      "end_seconds": 153.1,
      "duration_seconds": 4.06,
      "text": "What did you do for work?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.5,
      "end_seconds": 159.01,
      "duration_seconds": 3.51,
      "text": "Civil engineer. Retired three years."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.91,
      "end_seconds": 163.28,
      "duration_seconds": 1.37,
      "text": "Exercise?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.77,
      "end_seconds": 170.67,
      "duration_seconds": 4.9,
      "text": "I cycle at the weekends, about thirty miles."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.27,
      "end_seconds": 191.27,
      "duration_seconds": 9.0,
      "text": "Let me take your numbers. Pulse 66, blood pressure 126 over 78, and weight 86 kilos."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.33,
      "end_seconds": 196.18,
      "duration_seconds": 3.85,
      "text": "That's good, isn't it? ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.83,
      "end_seconds": 211.25,
      "duration_seconds": 4.42,
      "text": "That's like a clean engine. Let me listen."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.39,
      "end_seconds": 215.52,
      "duration_seconds": 2.13,
      "text": "Fire away. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.34,
      "end_seconds": 224.75,
      "duration_seconds": 6.41,
      "text": "Heart sounds are normal and your calves are soft, no swelling."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.8,
      "end_seconds": 227.56,
      "duration_seconds": 1.76,
      "text": "Good. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.26,
      "end_seconds": 233.48,
      "duration_seconds": 4.22,
      "text": "Any trouble with your breathing at rest?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.86,
      "end_seconds": 237.73,
      "duration_seconds": 2.87,
      "text": "No, nothing at rest."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.61,
      "end_seconds": 245.81,
      "duration_seconds": 6.2,
      "text": "And any trouble with your stomach apart from the heartburn, vomiting, anything?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.24,
      "end_seconds": 250.99,
      "duration_seconds": 3.75,
      "text": "No, nothing, everything else is normal."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.35,
      "end_seconds": 260.71,
      "duration_seconds": 8.36,
      "text": "Your blood pressure is well controlled, which is what matters for a trip like this."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.84,
      "end_seconds": 267.68,
      "duration_seconds": 3.84,
      "text": "Good to hear. What about vaccines? ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.43,
      "end_seconds": 280.67,
      "duration_seconds": 11.24,
      "text": "I'd like to arrange a blood test to check your immunity for hepatitis, and I'd like to book your typhoid and hepatitis A vaccines."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.83,
      "end_seconds": 284.32,
      "duration_seconds": 2.49,
      "text": "Are they painful? ~"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.59,
      "end_seconds": 291.0,
      "duration_seconds": 5.41,
      "text": "A little scratch, like a mosquito, only less annoying. ~"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.33,
      "end_seconds": 294.85,
      "duration_seconds": 1.52,
      "text": "Fine. ~"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.26,
      "end_seconds": 301.86,
      "duration_seconds": 5.6,
      "text": "Drink bottled water, and keep your tablets in your hand luggage."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.16,
      "end_seconds": 306.01,
      "duration_seconds": 2.85,
      "text": "Will do, doc. ~"
    }
  ]
}
