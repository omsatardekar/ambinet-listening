{
  "schema_version": "1.0",
  "encounter_id": "00727",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 4.65,
      "end_seconds": 9.02,
      "duration_seconds": 4.37,
      "text": "Cold sore. Again. Third this year."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.9,
      "end_seconds": 17.6,
      "duration_seconds": 3.7,
      "text": "Sorry to hear that. Where is it?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.09,
      "end_seconds": 26.75,
      "duration_seconds": 4.66,
      "text": "Top lip. Left side. Tingled yesterday, now it's blistered."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.45,
      "end_seconds": 37.01,
      "duration_seconds": 5.56,
      "text": "When did the first one come, this year?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.21,
      "end_seconds": 46.1,
      "duration_seconds": 3.89,
      "text": "January? Or February. I'm not sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.11,
      "end_seconds": 57.04,
      "duration_seconds": 5.93,
      "text": "That's fine. What sets them off, do you notice? ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.2,
      "end_seconds": 64.66,
      "duration_seconds": 2.46,
      "text": "Sun. Stress. Colds. ~"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.7,
      "end_seconds": 74.33,
      "duration_seconds": 4.63,
      "text": "What are you using on it now?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.34,
      "end_seconds": 84.27,
      "duration_seconds": 4.93,
      "text": "Aciclovir cream, five times a day, from the chemist."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.41,
      "end_seconds": 91.9,
      "duration_seconds": 2.49,
      "text": "Does it help? ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.99,
      "end_seconds": 102.82,
      "duration_seconds": 5.83,
      "text": "A bit. Not much. If I start it early. ~"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.51,
      "end_seconds": 110.07,
      "duration_seconds": 2.56,
      "text": "Anything else you use?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.09,
      "end_seconds": 120.74,
      "duration_seconds": 5.65,
      "text": "Lip balm with sun cream in it, every morning."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.81,
      "end_seconds": 130.57,
      "duration_seconds": 4.76,
      "text": "Good habit. Do you have any other conditions?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.17,
      "end_seconds": 137.63,
      "duration_seconds": 2.46,
      "text": "Eczema, hands. That's all."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.23,
      "end_seconds": 145.58,
      "duration_seconds": 3.35,
      "text": "Let me look at it. ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.86,
      "end_seconds": 158.38,
      "duration_seconds": 1.52,
      "text": "Go on."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.94,
      "end_seconds": 172.82,
      "duration_seconds": 9.88,
      "text": "It's a typical blister. Don't touch it, and wash your hands after you put the cream on. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.4,
      "end_seconds": 179.33,
      "duration_seconds": 1.93,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.93,
      "end_seconds": 193.99,
      "duration_seconds": 10.06,
      "text": "The key with the cream is to start it at the very first tingle, and to keep it up for five days."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.72,
      "end_seconds": 202.57,
      "duration_seconds": 3.85,
      "text": "I start late. I forget. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.95,
      "end_seconds": 214.84,
      "duration_seconds": 6.89,
      "text": "Keep the tube in your bag and in your bathroom. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.02,
      "end_seconds": 221.45,
      "duration_seconds": 1.43,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.8,
      "end_seconds": 242.13,
      "duration_seconds": 15.33,
      "text": "If they keep happening, there are tablets you can take for a few days at the first tingle, or even every day to prevent them. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.26,
      "end_seconds": 251.19,
      "duration_seconds": 3.93,
      "text": "Prevent them? That'd be good. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.54,
      "end_seconds": 269.28,
      "duration_seconds": 12.74,
      "text": "I'd like to see you again in four weeks to talk about it, if it's still bothering you, and I'll start you on that."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.26,
      "end_seconds": 276.2,
      "duration_seconds": 1.94,
      "text": "Okay. Thanks. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.75,
      "end_seconds": 285.37,
      "duration_seconds": 4.62,
      "text": "Avoid kissing or sharing towels while it's blistered."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.66,
      "end_seconds": 292.22,
      "duration_seconds": 1.56,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.81,
      "end_seconds": 298.62,
      "duration_seconds": 1.81,
      "text": "Take care. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.58,
      "end_seconds": 305.99,
      "duration_seconds": 2.41,
      "text": "See you. ~"
    }
  ]
}
