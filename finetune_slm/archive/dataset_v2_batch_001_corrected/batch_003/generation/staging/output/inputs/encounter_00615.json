{
  "schema_version": "1.0",
  "encounter_id": "00615",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.99,
      "end_seconds": 11.47,
      "duration_seconds": 10.48,
      "text": "I'm so sorry I'm late, doctor. The parking garage on Fifth was full and I had to circle it twice."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 12.69,
      "end_seconds": 20.93,
      "duration_seconds": 8.24,
      "text": "Please don't worry about it, we have plenty of time. Come in and take a seat."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.36,
      "end_seconds": 30.29,
      "duration_seconds": 6.93,
      "text": "Thank you. I wrote everything down beforehand so I wouldn't forget anything, if that's all right."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.81,
      "end_seconds": 39.71,
      "duration_seconds": 7.9,
      "text": "More than all right. Notes make my job easier. So what brings you in today?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.76,
      "end_seconds": 50.84,
      "duration_seconds": 9.08,
      "text": "Mostly a routine check of my nose and throat. It's been about two years since anyone looked."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.98,
      "end_seconds": 62.25,
      "duration_seconds": 10.27,
      "text": "Think of it as a service for the car. We look under the hood before anything starts rattling. Anything on your list?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.02,
      "end_seconds": 74.72,
      "duration_seconds": 10.7,
      "text": "Only one item. A coworker told me I should get my airways looked at, and she reads about health constantly."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.94,
      "end_seconds": 82.91,
      "duration_seconds": 6.97,
      "text": "Fair enough, and I'm glad you came. Let me run through some standard questions. Any nosebleeds?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.94,
      "end_seconds": 90.72,
      "duration_seconds": 6.78,
      "text": "No nosebleeds. I checked my notes, and not in the last few years either."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.69,
      "end_seconds": 95.04,
      "duration_seconds": 3.35,
      "text": "Good. What about pain in either ear?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.88,
      "end_seconds": 99.79,
      "duration_seconds": 2.91,
      "text": "No ear pain at all."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.8,
      "end_seconds": 108.03,
      "duration_seconds": 6.23,
      "text": "And your breathing in general, any trouble with it, day or night?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.51,
      "end_seconds": 116.12,
      "duration_seconds": 6.61,
      "text": "It's fine, honestly. I can climb three flights of stairs without stopping."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.75,
      "end_seconds": 123.02,
      "duration_seconds": 6.27,
      "text": "Great. Now, any health conditions I should know about, things you live with?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.87,
      "end_seconds": 134.52,
      "duration_seconds": 9.65,
      "text": "Acid reflux, for about six years now. It's mild, and I keep it quiet by eating smaller dinners."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.67,
      "end_seconds": 146.85,
      "duration_seconds": 10.18,
      "text": "Smaller dinners, sensible. It's like not overfilling a gas tank before a steep hill. Any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.09,
      "end_seconds": 157.66,
      "duration_seconds": 8.57,
      "text": "My father has sleep apnea. I put it on the list because I read that it can run in families."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.86,
      "end_seconds": 167.73,
      "duration_seconds": 7.87,
      "text": "Good thing to flag. And what do you do for work, if you don't mind me asking?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.2,
      "end_seconds": 178.29,
      "duration_seconds": 9.09,
      "text": "I teach high school chemistry. It's a lot of talking all day, so I'm careful with my voice."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.8,
      "end_seconds": 188.45,
      "duration_seconds": 8.65,
      "text": "That's like running a marathon in the same pair of shoes every day. Let's get your numbers while you're settled."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.78,
      "end_seconds": 207.47,
      "duration_seconds": 7.69,
      "text": "Blood pressure is 118 over 76, pulse is 68 and regular, and your temperature is 36.7 degrees Celsius."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.84,
      "end_seconds": 215.72,
      "duration_seconds": 6.88,
      "text": "Your oxygen saturation is 99 percent, and your respiratory rate is 14 breaths per minute."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.96,
      "end_seconds": 225.28,
      "duration_seconds": 7.32,
      "text": "Are those good numbers? I printed a table of typical ranges and put it in my folder."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.27,
      "end_seconds": 234.85,
      "duration_seconds": 7.58,
      "text": "They're textbook. Tidy as a freshly made bed. You can put the folder away."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.4,
      "end_seconds": 241.94,
      "duration_seconds": 5.54,
      "text": "Wonderful. I'll feel better once I've heard the rest, though. What happens next?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.09,
      "end_seconds": 250.85,
      "duration_seconds": 7.76,
      "text": "I'll look inside your nose and your throat. Open wide for me and say ahh."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.52,
      "end_seconds": 253.77,
      "duration_seconds": 1.25,
      "text": "Ahh."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.67,
      "end_seconds": 277.57,
      "duration_seconds": 9.9,
      "text": "Hm, give me a moment here. The lining inside your nose is a touch swollen on both sides, like a slightly puffy pillow."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.13,
      "end_seconds": 283.83,
      "duration_seconds": 3.7,
      "text": "Swollen? Should I be worried about that?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.5,
      "end_seconds": 294.94,
      "duration_seconds": 10.44,
      "text": "Not worried, just interested. Most likely this is mild nasal congestion, the kind of thing that builds up quietly over time."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.24,
      "end_seconds": 302.59,
      "duration_seconds": 6.35,
      "text": "I see. Is there a way to look further than that? I'd rather know properly."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.62,
      "end_seconds": 316.74,
      "duration_seconds": 12.12,
      "text": "There is. I'd like to book a nasal endoscopy, a tiny camera on a thin tube that lets us see the whole pipe."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.68,
      "end_seconds": 323.28,
      "duration_seconds": 5.6,
      "text": "Does that hurt? I'm a little squeamish about anything going up my nose."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.15,
      "end_seconds": 331.84,
      "duration_seconds": 7.69,
      "text": "It's uncomfortable for a minute, like the tickle before a sneeze, but it's very quick."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.61,
      "end_seconds": 338.86,
      "duration_seconds": 5.25,
      "text": "Then I can manage that. Will it be done today?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.39,
      "end_seconds": 348.84,
      "duration_seconds": 8.45,
      "text": "Not today. Our scheduler will call you with a slot, probably within the next couple of weeks."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.51,
      "end_seconds": 358.04,
      "duration_seconds": 8.53,
      "text": "Perfect. I also have a note about what I could do at home in the meantime."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.82,
      "end_seconds": 367.01,
      "duration_seconds": 8.19,
      "text": "Run a humidifier at night if you have one, and sip water through your teaching day. Like watering a houseplant."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 368.58,
      "end_seconds": 377.43,
      "duration_seconds": 8.85,
      "text": "I have a small humidifier in the bedroom. I'll use it every night, and keep a bottle on my desk."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.6,
      "end_seconds": 389.42,
      "duration_seconds": 10.82,
      "text": "Then you're ahead of schedule already. I'd like to see you again in four weeks, once the camera test is done."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 390.93,
      "end_seconds": 397.35,
      "duration_seconds": 6.42,
      "text": "Four weeks. I'll put it in my calendar right now, hold on."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 398.49,
      "end_seconds": 405.8,
      "duration_seconds": 7.31,
      "text": "Take your time. While you type, tell me, are the students behaving this year?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 408.35,
      "end_seconds": 416.06,
      "duration_seconds": 7.71,
      "text": "Mostly. The new class is lively, but they love the experiments with the colored flames."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 416.93,
      "end_seconds": 426.32,
      "duration_seconds": 9.39,
      "text": "Colored flames, now I wish I'd had you as a teacher. I only remember the baking soda volcano."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 427.59,
      "end_seconds": 435.5,
      "duration_seconds": 7.91,
      "text": "Everyone remembers the volcano. We do a bigger version in the spring with a safety shield."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 436.48,
      "end_seconds": 445.24,
      "duration_seconds": 8.76,
      "text": "Sounds like a good time. Is there anything else on your list, or have we covered it?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 447.21,
      "end_seconds": 455.26,
      "duration_seconds": 8.05,
      "text": "Let me check. Parking, done. Coworker, done. Questions about the test, done. I think that's everything."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 456.32,
      "end_seconds": 463.15,
      "duration_seconds": 6.83,
      "text": "Then you did better with that list than most of my appointments do."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 465.04,
      "end_seconds": 471.52,
      "duration_seconds": 6.48,
      "text": "Oh, one more thing. Should I bring someone to the camera appointment?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 472.44,
      "end_seconds": 479.66,
      "duration_seconds": 7.22,
      "text": "No need, you can drive yourself. It takes ten minutes and you walk out afterwards."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 481.49,
      "end_seconds": 489.42,
      "duration_seconds": 7.93,
      "text": "Good, because the garage on Fifth is the only place I know near the clinic."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 491.64,
      "end_seconds": 497.67,
      "duration_seconds": 6.03,
      "text": "Try the lot behind the pharmacy. It's usually quiet in the mornings."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 498.61,
      "end_seconds": 505.15,
      "duration_seconds": 6.54,
      "text": "The one with the blue gate? I'll try that. Thank you, that's very kind."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 506.47,
      "end_seconds": 511.13,
      "duration_seconds": 4.66,
      "text": "My pleasure. Take care of yourself, and enjoy the weekend."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 512.5,
      "end_seconds": 518.78,
      "duration_seconds": 6.28,
      "text": "You too, doctor. Goodbye, and thank you again for fitting me in."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 519.56,
      "end_seconds": 524.99,
      "duration_seconds": 5.43,
      "text": "Goodbye. Mind the stairs on your way out, they're polished."
    }
  ]
}
