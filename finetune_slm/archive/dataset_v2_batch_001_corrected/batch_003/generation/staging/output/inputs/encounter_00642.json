{
  "schema_version": "1.0",
  "encounter_id": "00642",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.04,
      "end_seconds": 15.35,
      "duration_seconds": 14.31,
      "text": "Hi! Sorry, I'm a bit early, I didn't want to get stuck in traffic and then I was parked in the first space I saw. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.41,
      "end_seconds": 29.44,
      "duration_seconds": 12.03,
      "text": "Early is fine. Come in, Maya. It's six weeks since we started the antidepressant, so I'd like to hear how it's been."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.12,
      "end_seconds": 37.53,
      "duration_seconds": 5.41,
      "text": "Honestly? Better, a bit better. Not fixed, but better. ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.59,
      "end_seconds": 43.26,
      "duration_seconds": 4.67,
      "text": "Tell me what's better and what's still hard. ~"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.17,
      "end_seconds": 56.55,
      "duration_seconds": 12.38,
      "text": "I'm crying less, which my sister has noticed. But I'm still waking at four every morning, and I can't get back to sleep."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.61,
      "end_seconds": 62.31,
      "duration_seconds": 4.7,
      "text": "Four every morning, and then you lie awake?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.98,
      "end_seconds": 70.95,
      "duration_seconds": 6.97,
      "text": "Yes, my mind starts going over work, and by seven I'm shattered."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.33,
      "end_seconds": 78.53,
      "duration_seconds": 6.2,
      "text": "Any side effects from the tablets, anything you've noticed since starting?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.16,
      "end_seconds": 89.52,
      "duration_seconds": 9.36,
      "text": "I'm sweating more at night, which is a bit gross, and it makes the waking worse."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.24,
      "end_seconds": 99.84,
      "duration_seconds": 7.6,
      "text": "Thank you. Now I have to ask: any thoughts of harming yourself?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.87,
      "end_seconds": 105.99,
      "duration_seconds": 4.12,
      "text": "No. Not at all. That was never, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.37,
      "end_seconds": 112.54,
      "duration_seconds": 4.17,
      "text": "Any panic attacks, or racing heart?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.1,
      "end_seconds": 117.83,
      "duration_seconds": 2.73,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.49,
      "end_seconds": 123.37,
      "duration_seconds": 3.88,
      "text": "And any dizziness, especially standing up?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.25,
      "end_seconds": 132.17,
      "duration_seconds": 6.92,
      "text": "No dizziness. I did feel strange in the first week, but that's gone."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.78,
      "end_seconds": 140.13,
      "duration_seconds": 6.35,
      "text": "Good. Tell me what you're taking, to check it matches the record."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.01,
      "end_seconds": 151.2,
      "duration_seconds": 10.19,
      "text": "Sertraline, 100 mg once a day, in the morning. And mirtazapine, 15 mg at night, which I started with the sertraline."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.68,
      "end_seconds": 156.68,
      "duration_seconds": 3.0,
      "text": "Right. And any allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.55,
      "end_seconds": 161.49,
      "duration_seconds": 2.94,
      "text": "No known allergies, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.28,
      "end_seconds": 166.26,
      "duration_seconds": 3.98,
      "text": "And in terms of other conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.91,
      "end_seconds": 175.46,
      "duration_seconds": 6.55,
      "text": "Depression, obviously, first diagnosed at nineteen. And I get migraines."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.41,
      "end_seconds": 180.88,
      "duration_seconds": 3.47,
      "text": "Any operations in the past?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.4,
      "end_seconds": 188.17,
      "duration_seconds": 4.77,
      "text": "Just my tonsils, when I was six."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 188.94,
      "end_seconds": 197.51,
      "duration_seconds": 8.57,
      "text": "I've got the trolley, doctor. Shall I do Maya's observations while you finish typing? ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.09,
      "end_seconds": 203.05,
      "duration_seconds": 2.96,
      "text": "Please, Nurse Amy. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 224.23,
      "end_seconds": 231.23,
      "duration_seconds": 7.0,
      "text": "Blood pressure 116 over 72, pulse 74, temperature 36.6, oxygen 99 percent, weight 63 kilos."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.72,
      "end_seconds": 239.37,
      "duration_seconds": 5.65,
      "text": "Is my weight okay? I've had a bit less appetite. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.31,
      "end_seconds": 250.09,
      "duration_seconds": 7.78,
      "text": "It's stable, so that's good. I'll check your pulse and look for a tremor. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.57,
      "end_seconds": 253.49,
      "duration_seconds": 1.92,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.39,
      "end_seconds": 268.03,
      "duration_seconds": 4.64,
      "text": "Pulse is regular, and no tremor in your hands."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.48,
      "end_seconds": 273.54,
      "duration_seconds": 3.06,
      "text": "Is that good? ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.22,
      "end_seconds": 290.54,
      "duration_seconds": 14.32,
      "text": "It's what I wanted. So, thinking about it all, this looks like depression that's partly responding to treatment, so I'm not changing the antidepressant today."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.15,
      "end_seconds": 295.87,
      "duration_seconds": 2.72,
      "text": "And the sleep? ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.48,
      "end_seconds": 309.38,
      "duration_seconds": 11.9,
      "text": "The early waking is a common thing in depression. But I can't rule out an underactive thyroid contributing, so I'd like to check that."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.89,
      "end_seconds": 313.8,
      "duration_seconds": 1.91,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.46,
      "end_seconds": 324.85,
      "duration_seconds": 9.39,
      "text": "I'd like to arrange a thyroid blood test, and a sodium level, as the sertraline can lower sodium."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 325.89,
      "end_seconds": 330.54,
      "duration_seconds": 4.65,
      "text": "I can take those bloods now, doctor. ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.09,
      "end_seconds": 344.75,
      "duration_seconds": 11.66,
      "text": "Please, Amy. And since you're on two medicines that can affect the heart rhythm, I'd also like an ECG while you're here."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.26,
      "end_seconds": 351.95,
      "duration_seconds": 4.69,
      "text": "Is something wrong with my heart? ~"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.32,
      "end_seconds": 359.73,
      "duration_seconds": 5.41,
      "text": "No, it's a precaution, and it takes two minutes. ~"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 361.21,
      "end_seconds": 362.72,
      "duration_seconds": 1.51,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.44,
      "end_seconds": 374.16,
      "duration_seconds": 9.72,
      "text": "I'd like to see you in four weeks to go over the results and see how the sleep is."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 375.21,
      "end_seconds": 379.44,
      "duration_seconds": 4.23,
      "text": "Four weeks. Thank you, doctor. ~"
    }
  ]
}
