{
  "schema_version": "1.0",
  "encounter_id": "00632",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 1.24,
      "end_seconds": 10.71,
      "duration_seconds": 9.47,
      "text": "Mrs Harding for you, doctor. I've put her in room four. She's a bit nervous, so go gently. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 12.5,
      "end_seconds": 22.01,
      "duration_seconds": 9.51,
      "text": "Thanks, Rachel. Hello Mrs Harding, do sit down. What can I do for you today? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.24,
      "end_seconds": 35.37,
      "duration_seconds": 11.13,
      "text": "Oh, it's probably nothing. It's just a, well, a little spot, on my nose. It's been there for a while."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.09,
      "end_seconds": 44.17,
      "duration_seconds": 7.08,
      "text": "Let me see. Can you tell me a bit more about it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.79,
      "end_seconds": 59.07,
      "duration_seconds": 13.28,
      "text": "It's rough, a bit scaly, like a bit of dry skin that won't go. I keep picking at it, and it comes back."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.89,
      "end_seconds": 64.53,
      "duration_seconds": 3.64,
      "text": "How long has it been there?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.71,
      "end_seconds": 71.48,
      "duration_seconds": 5.77,
      "text": "Months. Maybe since the spring. I really can't say exactly."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.46,
      "end_seconds": 77.99,
      "duration_seconds": 4.53,
      "text": "Does it bleed, or itch, or hurt?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.81,
      "end_seconds": 89.56,
      "duration_seconds": 8.75,
      "text": "It bled once when I scratched it with my fingernail. Otherwise no, it doesn't hurt."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 91.96,
      "end_seconds": 99.27,
      "duration_seconds": 7.31,
      "text": "Shall I get the camera, doctor? We take a photo for the record. ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.14,
      "end_seconds": 106.55,
      "duration_seconds": 6.41,
      "text": "Yes please, Rachel. Mrs Harding, would that be all right? ~"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.71,
      "end_seconds": 111.79,
      "duration_seconds": 4.08,
      "text": "Of course. Is that routine? ~"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 114.73,
      "end_seconds": 120.49,
      "duration_seconds": 5.76,
      "text": "Absolutely routine, we do it for any skin lesions. ~"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.25,
      "end_seconds": 125.5,
      "duration_seconds": 4.25,
      "text": "Do you have any other skin problems?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.09,
      "end_seconds": 134.91,
      "duration_seconds": 7.82,
      "text": "I get eczema on my hands, but it's been quiet this year."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.04,
      "end_seconds": 145.73,
      "duration_seconds": 8.69,
      "text": "Okay. And you've had a lot of sun over the years, have you? ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.77,
      "end_seconds": 160.6,
      "duration_seconds": 13.83,
      "text": "Oh, I was a nurse in Cyprus in my twenties. I used to go brown as a berry. I didn't know any better in those days. ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.98,
      "end_seconds": 188.68,
      "duration_seconds": 10.7,
      "text": "A lot of us didn't. Let me have a proper look under the light. Tilt your chin up."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.46,
      "end_seconds": 191.89,
      "duration_seconds": 2.43,
      "text": "Is it bad? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.33,
      "end_seconds": 205.97,
      "duration_seconds": 11.64,
      "text": "It's a rough, scaly patch about six millimetres across, on the side of the nose, with a slightly pearly edge."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 208.9,
      "end_seconds": 212.67,
      "duration_seconds": 3.77,
      "text": "I've taken the photographs, doctor. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.32,
      "end_seconds": 230.72,
      "duration_seconds": 15.4,
      "text": "Thanks. Mrs Harding, this is very common, and it fits with sun damage. But I can't rule out a basal cell carcinoma, which is a slow-growing, very treatable skin cancer."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.24,
      "end_seconds": 235.82,
      "duration_seconds": 2.58,
      "text": "Cancer? Oh dear. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.62,
      "end_seconds": 249.55,
      "duration_seconds": 11.93,
      "text": "I know the word is frightening. This type almost never spreads, it's slow, and it's cured by removing it. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.4,
      "end_seconds": 255.09,
      "duration_seconds": 3.69,
      "text": "What do I need to do? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.35,
      "end_seconds": 274.06,
      "duration_seconds": 17.71,
      "text": "What I'd like to do, because it hasn't healed in months, is to send the photographs to the skin specialists and have them look at it. They'll tell us whether it needs removing. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.3,
      "end_seconds": 279.21,
      "duration_seconds": 3.91,
      "text": "How long will I wait? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.72,
      "end_seconds": 286.93,
      "duration_seconds": 5.21,
      "text": "Usually under two weeks. You'll get a letter. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 289.23,
      "end_seconds": 297.92,
      "duration_seconds": 8.69,
      "text": "And if you've not heard by then, ring us and ask for Rachel. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.75,
      "end_seconds": 302.59,
      "duration_seconds": 2.84,
      "text": "I will. Thank you. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.71,
      "end_seconds": 315.61,
      "duration_seconds": 10.9,
      "text": "Meanwhile, please don't pick at it, and use a high-factor sun cream on your face when you're out."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.46,
      "end_seconds": 322.94,
      "duration_seconds": 5.48,
      "text": "I've got a hat as well. Is that good? ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.0,
      "end_seconds": 336.59,
      "duration_seconds": 11.59,
      "text": "A hat's excellent. If it grows, bleeds more, or hasn't settled in four weeks, come back and see me sooner."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.91,
      "end_seconds": 343.73,
      "duration_seconds": 4.82,
      "text": "I'll keep an eye. Thank you both. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.24,
      "end_seconds": 349.53,
      "duration_seconds": 3.29,
      "text": "Take care, Mrs Harding. ~"
    }
  ]
}
