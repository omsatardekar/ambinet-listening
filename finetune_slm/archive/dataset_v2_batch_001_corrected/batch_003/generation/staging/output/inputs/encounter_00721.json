{
  "schema_version": "1.0",
  "encounter_id": "00721",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 1.64,
      "end_seconds": 11.46,
      "duration_seconds": 9.82,
      "text": "Mr Webb? Come this way, I'll take your blood pressure and pulse before the doctor. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.93,
      "end_seconds": 20.73,
      "duration_seconds": 6.8,
      "text": "Right. Quick as you can, I've left my car on a meter. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 38.3,
      "end_seconds": 41.56,
      "duration_seconds": 3.26,
      "text": "138 over 84, pulse 78."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.57,
      "end_seconds": 53.15,
      "duration_seconds": 8.58,
      "text": "Hello, Mr Webb, and I see you've brought your daughter. Tell me what's going on. ~"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 55.12,
      "end_seconds": 65.75,
      "duration_seconds": 10.63,
      "text": "Dad won't make a fuss, so I'm going to. His bowels have changed, doctor. He's sixty, and he's been going more often."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.46,
      "end_seconds": 73.51,
      "duration_seconds": 5.05,
      "text": "It's nothing, I've had a funny tummy, that's all. ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.6,
      "end_seconds": 79.61,
      "duration_seconds": 4.01,
      "text": "Mr Webb, how long has this been?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.04,
      "end_seconds": 85.23,
      "duration_seconds": 3.19,
      "text": "Two months. Perhaps three."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.42,
      "end_seconds": 91.53,
      "duration_seconds": 3.11,
      "text": "How has it changed?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.18,
      "end_seconds": 104.05,
      "duration_seconds": 10.87,
      "text": "Looser. More often, three or four times a day instead of once. And I get this urgency, I have to run."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.98,
      "end_seconds": 109.25,
      "duration_seconds": 3.27,
      "text": "Any blood in the stool?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.38,
      "end_seconds": 113.58,
      "duration_seconds": 2.2,
      "text": "No. No blood."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.8,
      "end_seconds": 117.96,
      "duration_seconds": 2.16,
      "text": "Any weight loss?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.08,
      "end_seconds": 123.52,
      "duration_seconds": 2.44,
      "text": "Not that I've noticed."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 126.2,
      "end_seconds": 130.69,
      "duration_seconds": 4.49,
      "text": "He's lost weight, doctor, his trousers are loose."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.5,
      "end_seconds": 142.23,
      "duration_seconds": 8.73,
      "text": "I'll weigh him, and I'll note that you each said different things. What tablets are you on?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.69,
      "end_seconds": 152.31,
      "duration_seconds": 7.62,
      "text": "Ramipril, 5 mg once a day. And a statin, simvastatin, 20 mg, at night."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 154.35,
      "end_seconds": 158.87,
      "duration_seconds": 4.52,
      "text": "He forgets the statin most nights, doctor."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.9,
      "end_seconds": 167.07,
      "duration_seconds": 5.17,
      "text": "I don't forget it, I choose not to."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.36,
      "end_seconds": 173.63,
      "duration_seconds": 3.27,
      "text": "Okay, noted that. Any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.86,
      "end_seconds": 177.63,
      "duration_seconds": 1.77,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.73,
      "end_seconds": 181.75,
      "duration_seconds": 2.02,
      "text": "Medical history?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.47,
      "end_seconds": 191.61,
      "duration_seconds": 7.14,
      "text": "High blood pressure, high cholesterol, and I had a bit of gout once."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.98,
      "end_seconds": 196.42,
      "duration_seconds": 3.44,
      "text": "Do you smoke or drink?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.38,
      "end_seconds": 205.21,
      "duration_seconds": 5.83,
      "text": "Smoked until the nineties. And a pint with my tea on Fridays."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.48,
      "end_seconds": 219.64,
      "duration_seconds": 12.16,
      "text": "Right. A change in bowel habit over sixty, with possible weight loss, needs checking properly, even if it turns out to be nothing. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.63,
      "end_seconds": 226.41,
      "duration_seconds": 3.78,
      "text": "I knew you'd say that. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.74,
      "end_seconds": 239.25,
      "duration_seconds": 9.51,
      "text": "I'd like to arrange a stool test, called a FIT test, to look for hidden blood."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 241.12,
      "end_seconds": 243.69,
      "duration_seconds": 2.57,
      "text": "And a scan? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.01,
      "end_seconds": 259.81,
      "duration_seconds": 13.8,
      "text": "And I'd like to refer him for a colonoscopy, a camera test of the bowel, which is the best way to look."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.81,
      "end_seconds": 265.15,
      "duration_seconds": 3.34,
      "text": "A camera up there? ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.93,
      "end_seconds": 274.37,
      "duration_seconds": 6.44,
      "text": "Under sedation. It's the best test, and it's very common. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 276.2,
      "end_seconds": 283.86,
      "duration_seconds": 7.66,
      "text": "I'll book the stool kit for you, Mr Webb, and give you the leaflet. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.3,
      "end_seconds": 292.39,
      "duration_seconds": 7.09,
      "text": "Please drink plenty, and note your toilet habits for me in a little diary."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.52,
      "end_seconds": 299.76,
      "duration_seconds": 4.24,
      "text": "A diary of my bowels. Lovely. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 302.78,
      "end_seconds": 305.98,
      "duration_seconds": 3.2,
      "text": "I'll help you, Dad. ~"
    }
  ]
}
