{
  "schema_version": "1.0",
  "encounter_id": "00945",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 0.56,
      "end_seconds": 13.06,
      "duration_seconds": 12.5,
      "text": "Mrs Pettigrew, I've got the letter from your GP here, saying you've an acid taste in your mouth. How are you getting on? ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.06,
      "end_seconds": 17.62,
      "duration_seconds": 3.56,
      "text": "Well. Yes. It's. Um. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.63,
      "end_seconds": 26.79,
      "duration_seconds": 6.16,
      "text": "Take your time. Tell me in your own words. ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.8,
      "end_seconds": 36.89,
      "duration_seconds": 8.09,
      "text": "In the mornings. There's this taste. Sour. In my mouth. When I wake up, every morning."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.01,
      "end_seconds": 46.76,
      "duration_seconds": 7.75,
      "text": "A sour taste in the mouth first thing, every morning. Is that right?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.03,
      "end_seconds": 52.56,
      "duration_seconds": 3.53,
      "text": "Yes. It's like, um, vinegar. ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.57,
      "end_seconds": 59.15,
      "duration_seconds": 4.58,
      "text": "How long has it been going on? ~"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.33,
      "end_seconds": 66.97,
      "duration_seconds": 5.64,
      "text": "A few weeks. Maybe. I don't. It's hard to say. ~"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.98,
      "end_seconds": 76.22,
      "duration_seconds": 7.24,
      "text": "That's fine. Does anything bring it on, like a late meal? ~"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.43,
      "end_seconds": 84.8,
      "duration_seconds": 7.37,
      "text": "I suppose. I do like my supper. Late. With the telly. ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.9,
      "end_seconds": 96.0,
      "duration_seconds": 9.1,
      "text": "And does it ever happen at other times of day, or only on waking? ~"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.33,
      "end_seconds": 101.09,
      "duration_seconds": 3.76,
      "text": "Only when I wake. Not later. ~"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.52,
      "end_seconds": 108.47,
      "duration_seconds": 5.95,
      "text": "Any actual chest pain, like a heaviness or a squeezing?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.58,
      "end_seconds": 113.98,
      "duration_seconds": 4.4,
      "text": "No. Nothing like that. No chest pain."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.51,
      "end_seconds": 122.47,
      "duration_seconds": 5.96,
      "text": "That's helpful, thank you. Any allergies to medicines or food?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.94,
      "end_seconds": 126.2,
      "duration_seconds": 2.26,
      "text": "No allergies. None."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.44,
      "end_seconds": 134.76,
      "duration_seconds": 6.32,
      "text": "Good. Do you have any health problems I should know about?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.64,
      "end_seconds": 140.9,
      "duration_seconds": 4.26,
      "text": "Asthma. Just a little, since I was young."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.35,
      "end_seconds": 152.52,
      "duration_seconds": 10.17,
      "text": "Thank you. Let me feel your tummy, if that's all right. Could you lie back on the couch? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.13,
      "end_seconds": 157.69,
      "duration_seconds": 3.56,
      "text": "Oh. Yes. Of course. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.01,
      "end_seconds": 173.01,
      "duration_seconds": 4.0,
      "text": "Tell me if anything is tender."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.63,
      "end_seconds": 179.03,
      "duration_seconds": 3.4,
      "text": "Mm. No. It's fine. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.02,
      "end_seconds": 187.17,
      "duration_seconds": 5.15,
      "text": "Your abdomen is soft and not tender anywhere."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.28,
      "end_seconds": 191.7,
      "duration_seconds": 1.42,
      "text": "Good. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.86,
      "end_seconds": 205.72,
      "duration_seconds": 12.86,
      "text": "Let me repeat what you've told me. A sour taste every morning for a few weeks, and a late supper in front of the telly. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.56,
      "end_seconds": 210.91,
      "duration_seconds": 2.35,
      "text": "Yes. That's it. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.64,
      "end_seconds": 223.58,
      "duration_seconds": 9.94,
      "text": "There are simple things you can do. Try to finish supper at least three hours before bed."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.65,
      "end_seconds": 228.48,
      "duration_seconds": 3.83,
      "text": "Three hours. Oh. That's early. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.95,
      "end_seconds": 241.22,
      "duration_seconds": 10.27,
      "text": "And raise the head of the bed a little, with a couple of extra pillows, or a wedge."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.92,
      "end_seconds": 246.2,
      "duration_seconds": 2.28,
      "text": "A wedge? ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.91,
      "end_seconds": 255.03,
      "duration_seconds": 7.12,
      "text": "A foam wedge. You can get one from a pharmacy. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.57,
      "end_seconds": 260.25,
      "duration_seconds": 2.68,
      "text": "I could try. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.42,
      "end_seconds": 270.57,
      "duration_seconds": 9.15,
      "text": "Also, cut back on tea and coffee in the evening, and see how you go. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.56,
      "end_seconds": 275.9,
      "duration_seconds": 2.34,
      "text": "I'll try. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.89,
      "end_seconds": 287.55,
      "duration_seconds": 10.66,
      "text": "Good. Do that for a few weeks. If it's not settled in four weeks, come back and see me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.7,
      "end_seconds": 293.89,
      "duration_seconds": 4.19,
      "text": "Four weeks. Yes. I'll write it down. ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.58,
      "end_seconds": 300.22,
      "duration_seconds": 3.64,
      "text": "Lovely. Any questions before you go? ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.52,
      "end_seconds": 306.0,
      "duration_seconds": 3.48,
      "text": "No. No, thank you, doctor. ~"
    }
  ]
}
