{
  "schema_version": "1.0",
  "encounter_id": "00882",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 2.64,
      "end_seconds": 10.96,
      "duration_seconds": 8.32,
      "text": "I've got a discharge and it's really itchy down there. I've had it for about a week."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.4,
      "end_seconds": 19.82,
      "duration_seconds": 5.42,
      "text": "Thank you for telling me. Can you describe the discharge?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.45,
      "end_seconds": 29.79,
      "duration_seconds": 6.34,
      "text": "It's thick and white, a bit like cottage cheese. No smell."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.46,
      "end_seconds": 38.09,
      "duration_seconds": 4.63,
      "text": "And the itching, is it inside or outside?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.3,
      "end_seconds": 46.67,
      "duration_seconds": 5.37,
      "text": "Outside mostly, and it burns when I pass urine."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.88,
      "end_seconds": 55.6,
      "duration_seconds": 4.72,
      "text": "Any pain during sex, or bleeding between periods?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.64,
      "end_seconds": 64.16,
      "duration_seconds": 4.52,
      "text": "A bit sore during sex, but no bleeding."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.18,
      "end_seconds": 71.35,
      "duration_seconds": 4.17,
      "text": "Have you had anything like this before?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.57,
      "end_seconds": 81.04,
      "duration_seconds": 6.47,
      "text": "A couple of times, years ago. It cleared up with a cream."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.11,
      "end_seconds": 90.16,
      "duration_seconds": 5.05,
      "text": "What medicines are you taking at the moment?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.53,
      "end_seconds": 100.13,
      "duration_seconds": 6.6,
      "text": "The contraceptive pill, and I took antibiotics last month for a chest infection."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.11,
      "end_seconds": 107.39,
      "duration_seconds": 4.28,
      "text": "Which antibiotic was that, and for how long?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.67,
      "end_seconds": 116.12,
      "duration_seconds": 5.45,
      "text": "Amoxicillin, 500 mg, three times a day, for five days."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.3,
      "end_seconds": 126.9,
      "duration_seconds": 7.6,
      "text": "Thank you, that's helpful, because antibiotics can bring on thrush. Any allergies?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.63,
      "end_seconds": 134.52,
      "duration_seconds": 3.89,
      "text": "No, I don't have any allergies."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.34,
      "end_seconds": 143.07,
      "duration_seconds": 4.73,
      "text": "Are you pregnant, or could you be?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.88,
      "end_seconds": 151.43,
      "duration_seconds": 4.55,
      "text": "No, I had my period two weeks ago."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.15,
      "end_seconds": 159.01,
      "duration_seconds": 4.86,
      "text": "Do you use any soaps, bubble baths, or douches?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.67,
      "end_seconds": 167.3,
      "duration_seconds": 4.63,
      "text": "Sometimes a scented body wash. Nothing inside."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.56,
      "end_seconds": 177.8,
      "duration_seconds": 7.24,
      "text": "With your permission, I'd like to do a quick examination and a swab. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.25,
      "end_seconds": 199.79,
      "duration_seconds": 1.54,
      "text": "All right."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.44,
      "end_seconds": 210.29,
      "duration_seconds": 6.85,
      "text": "There's redness and some white curd-like discharge on the vulva, and no sores."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.03,
      "end_seconds": 215.45,
      "duration_seconds": 2.42,
      "text": "Is it thrush? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.6,
      "end_seconds": 227.88,
      "duration_seconds": 8.28,
      "text": "It looks very much like thrush, a yeast infection. The swab will confirm it."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.02,
      "end_seconds": 236.61,
      "duration_seconds": 4.59,
      "text": "Will you give me something for it? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.85,
      "end_seconds": 248.55,
      "duration_seconds": 8.7,
      "text": "Yes, I'll prescribe fluconazole, 150 mg, a single capsule, and clotrimazole cream for the itching."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.76,
      "end_seconds": 255.8,
      "duration_seconds": 4.04,
      "text": "Is it safe with my pill? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.95,
      "end_seconds": 265.81,
      "duration_seconds": 5.86,
      "text": "Yes, there's no problem with the contraceptive pill. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.2,
      "end_seconds": 273.17,
      "duration_seconds": 3.97,
      "text": "And should I avoid anything? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.11,
      "end_seconds": 281.4,
      "duration_seconds": 5.29,
      "text": "Avoid scented soaps and tight synthetic underwear for now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.92,
      "end_seconds": 286.46,
      "duration_seconds": 1.54,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.29,
      "end_seconds": 299.28,
      "duration_seconds": 8.99,
      "text": "If it hasn't cleared up in a week, come back and we'll look again."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.39,
      "end_seconds": 305.99,
      "duration_seconds": 2.6,
      "text": "Thank you, doctor. ~"
    }
  ]
}
