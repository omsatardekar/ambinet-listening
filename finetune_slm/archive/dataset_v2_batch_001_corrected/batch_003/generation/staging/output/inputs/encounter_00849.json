{
  "schema_version": "1.0",
  "encounter_id": "00849",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 0.57,
      "end_seconds": 13.42,
      "duration_seconds": 12.85,
      "text": "Hello, doctor! I'm Sinead's sister, I've come along for moral support, and because she'll forget half of what you say. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.07,
      "end_seconds": 22.68,
      "duration_seconds": 7.61,
      "text": "I will not. I'm just nervous. It's the results of my scan, the ovary one."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.26,
      "end_seconds": 31.82,
      "duration_seconds": 7.56,
      "text": "Don't worry. Let me begin by asking how you've been. Any pain in your tummy?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.0,
      "end_seconds": 49.0,
      "duration_seconds": 16.0,
      "text": "A dull ache, on the right side, low down, on and off. It comes at the time of my period, and a bit at other times."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.54,
      "end_seconds": 56.14,
      "duration_seconds": 4.6,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.7,
      "end_seconds": 62.18,
      "duration_seconds": 3.48,
      "text": "Six months, since the last scan."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.9,
      "end_seconds": 70.84,
      "duration_seconds": 5.94,
      "text": "Any bloating, or heavy bleeding, or bleeding between your periods?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.18,
      "end_seconds": 77.86,
      "duration_seconds": 4.68,
      "text": "No bloating. Periods are regular. No bleeding in between."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.0,
      "end_seconds": 85.4,
      "duration_seconds": 5.4,
      "text": "Any pain during sex, or when you open your bowels?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.99,
      "end_seconds": 91.04,
      "duration_seconds": 3.05,
      "text": "No. None of that."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.93,
      "end_seconds": 95.71,
      "duration_seconds": 3.78,
      "text": "Any fever, or sudden severe pain?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.38,
      "end_seconds": 100.33,
      "duration_seconds": 1.95,
      "text": "No. Nothing sudden."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.77,
      "end_seconds": 105.17,
      "duration_seconds": 2.4,
      "text": "What are you taking?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.69,
      "end_seconds": 111.95,
      "duration_seconds": 4.26,
      "text": "The combined pill, daily, for three years."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.32,
      "end_seconds": 116.55,
      "duration_seconds": 2.23,
      "text": "Any other conditions?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.05,
      "end_seconds": 123.08,
      "duration_seconds": 5.03,
      "text": "Migraines. And I had glandular fever at school."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.82,
      "end_seconds": 129.8,
      "duration_seconds": 4.98,
      "text": "Who do you live with, do you work?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.6,
      "end_seconds": 139.43,
      "duration_seconds": 6.83,
      "text": "I live with my sister, and I'm a primary school teacher."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 140.84,
      "end_seconds": 144.75,
      "duration_seconds": 3.91,
      "text": "I'm the one who feeds her. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.55,
      "end_seconds": 160.61,
      "duration_seconds": 15.06,
      "text": "The scan shows the cyst on your right ovary has got smaller. Last time it was four centimetres, now it's two and a half. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.27,
      "end_seconds": 164.82,
      "duration_seconds": 2.55,
      "text": "Is that good? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.62,
      "end_seconds": 176.44,
      "duration_seconds": 9.82,
      "text": "Very good. It's a simple, fluid-filled cyst, a functional cyst, with no solid parts, and no worrying features. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 178.85,
      "end_seconds": 181.97,
      "duration_seconds": 3.12,
      "text": "So it's not cancer? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.28,
      "end_seconds": 194.91,
      "duration_seconds": 11.63,
      "text": "There's nothing about the scan that suggests that. I'd say this is a simple functional ovarian cyst that is resolving."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.7,
      "end_seconds": 199.76,
      "duration_seconds": 3.06,
      "text": "What about the pain? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.12,
      "end_seconds": 222.04,
      "duration_seconds": 19.92,
      "text": "A cyst of that size can cause an ache. But since it's shrinking, I'd expect it to settle. I can't rule out that some of the ache is from your periods, or something else, so I'd like to examine you."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.82,
      "end_seconds": 245.73,
      "duration_seconds": 0.91,
      "text": "Fine."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.69,
      "end_seconds": 255.98,
      "duration_seconds": 9.29,
      "text": "Your tummy is soft, and there's no tenderness except mild discomfort in the right lower side. No masses."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.56,
      "end_seconds": 259.9,
      "duration_seconds": 2.34,
      "text": "Is that normal? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.58,
      "end_seconds": 269.29,
      "duration_seconds": 6.71,
      "text": "Yes, it's what I'd expect. Do you have any breathlessness, or chest pain?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.72,
      "end_seconds": 273.06,
      "duration_seconds": 1.34,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.66,
      "end_seconds": 282.87,
      "duration_seconds": 8.21,
      "text": "Good. I don't think you need any treatment for the cyst. Keep taking the pill. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.71,
      "end_seconds": 289.9,
      "duration_seconds": 4.19,
      "text": "Do I need another scan? ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.55,
      "end_seconds": 300.65,
      "duration_seconds": 9.1,
      "text": "Yes, I'd like to arrange a repeat ultrasound in three months, to make sure it's gone."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.66,
      "end_seconds": 303.65,
      "duration_seconds": 1.99,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.17,
      "end_seconds": 311.61,
      "duration_seconds": 6.44,
      "text": "For the ache, you can take paracetamol, and a hot water bottle."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 314.53,
      "end_seconds": 318.45,
      "duration_seconds": 3.92,
      "text": "She loves a hot water bottle. ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.0,
      "end_seconds": 333.08,
      "duration_seconds": 12.08,
      "text": "If you get sudden severe pain, vomiting, or fainting, go to the emergency department straight away, because a cyst can twist."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.2,
      "end_seconds": 337.96,
      "duration_seconds": 2.76,
      "text": "I will. ~"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.02,
      "end_seconds": 345.85,
      "duration_seconds": 5.83,
      "text": "I'd like to see you again once the scan's done."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.78,
      "end_seconds": 350.29,
      "duration_seconds": 2.51,
      "text": "Thank you, doctor. ~"
    }
  ]
}
