{
  "schema_version": "1.0",
  "encounter_id": "00582",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.85,
      "end_seconds": 13.65,
      "duration_seconds": 12.8,
      "text": "Doctor, it won't stop bleeding. I've been spitting blood into the sink for ages, sure look at the state of this towel."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.93,
      "end_seconds": 22.51,
      "duration_seconds": 6.58,
      "text": "Right, let's sort you out. Sit here. Where is the bleeding coming from?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.27,
      "end_seconds": 33.71,
      "duration_seconds": 9.44,
      "text": "From where the tooth came out this morning. Bottom left, the back one. The dentist said it'd stop by lunchtime."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 35.34,
      "end_seconds": 42.31,
      "duration_seconds": 6.97,
      "text": "It was two hours before he'd even tell me, Doctor. He's stubborn."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.06,
      "end_seconds": 52.61,
      "duration_seconds": 9.55,
      "text": "Ah, Aoife, would you stop. It's only been two hours, I'd say. Maybe a bit more."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 55.38,
      "end_seconds": 66.61,
      "duration_seconds": 11.23,
      "text": "It's three hours, Dad. I looked at the clock when we left the house. I've been holding that towel since."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.22,
      "end_seconds": 81.67,
      "duration_seconds": 12.45,
      "text": "So two hours, or three, somewhere in that region. We'll say two to three hours of bleeding. Nurse, can you get the numbers please?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 88.98,
      "end_seconds": 97.81,
      "duration_seconds": 8.83,
      "text": "Of course. Mr Gallagher, just pop that cuff on your arm. Hold the gauze in your mouth too."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 108.03,
      "end_seconds": 113.79,
      "duration_seconds": 5.76,
      "text": "Blood pressure is 142 over 88. Pulse 96. Temperature 36.9 degrees."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 119.74,
      "end_seconds": 125.93,
      "duration_seconds": 6.19,
      "text": "Oxygen saturation is 98 percent and respiratory rate is 16."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.46,
      "end_seconds": 132.92,
      "duration_seconds": 4.46,
      "text": "Thanks. Is it dripping, or an ooze?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.3,
      "end_seconds": 142.63,
      "duration_seconds": 8.33,
      "text": "A steady ooze, doctor. Bright red. When I take the gauze out it fills right up again."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.18,
      "end_seconds": 149.27,
      "duration_seconds": 5.09,
      "text": "Any pain with it, or is it mostly the bleeding?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.87,
      "end_seconds": 160.69,
      "duration_seconds": 8.82,
      "text": "The jaw is sore. A dull, throbbing thing. Not terrible, but I'd say it's getting worse since breakfast."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.55,
      "end_seconds": 168.02,
      "duration_seconds": 4.47,
      "text": "Do you feel faint or light-headed at all?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.42,
      "end_seconds": 177.63,
      "duration_seconds": 7.21,
      "text": "No, not at all. I'm grand. I just hate the taste of it."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.02,
      "end_seconds": 185.21,
      "duration_seconds": 5.19,
      "text": "Any bleeding from anywhere else? Nose, gums, bruises coming up?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.9,
      "end_seconds": 190.99,
      "duration_seconds": 4.09,
      "text": "No, nothing else. Only the mouth."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 192.03,
      "end_seconds": 198.65,
      "duration_seconds": 6.62,
      "text": "He gets bruises easily though, Doctor. Always has. It's the tablets."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.98,
      "end_seconds": 202.22,
      "duration_seconds": 2.24,
      "text": "Which tablets are those?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.11,
      "end_seconds": 212.58,
      "duration_seconds": 7.47,
      "text": "The warfarin. 5 mg every evening, for the heart. I never miss it."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.86,
      "end_seconds": 219.04,
      "duration_seconds": 5.18,
      "text": "For the irregular heartbeat, that's the atrial fibrillation?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.38,
      "end_seconds": 230.06,
      "duration_seconds": 9.68,
      "text": "That's the one. About four years now. And yer man, the dentist, didn't even ask me if I'd stopped it."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.99,
      "end_seconds": 237.76,
      "duration_seconds": 4.77,
      "text": "Did you tell him you take it?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.4,
      "end_seconds": 246.27,
      "duration_seconds": 6.87,
      "text": "I did, I did. He said grand, grand, and went ahead."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.6,
      "end_seconds": 254.37,
      "duration_seconds": 5.77,
      "text": "Okay. Do you have any allergies to medicines, latex, anything?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.24,
      "end_seconds": 259.18,
      "duration_seconds": 3.94,
      "text": "None at all. Never had a bother."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.89,
      "end_seconds": 266.01,
      "duration_seconds": 6.12,
      "text": "Does anyone in the family have bleeding problems or clotting problems?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 268.3,
      "end_seconds": 275.09,
      "duration_seconds": 6.79,
      "text": "Not really. Granddad Gallagher had a stroke, years ago. Dad's dad, I mean."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.93,
      "end_seconds": 281.77,
      "duration_seconds": 3.84,
      "text": "Thanks. Do you smoke, or drink?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.85,
      "end_seconds": 291.89,
      "duration_seconds": 9.04,
      "text": "I smoke about ten a day. And a few pints at the weekend, sure what else would you do."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.68,
      "end_seconds": 310.31,
      "duration_seconds": 5.63,
      "text": "Let me look at the mouth. Open wide, please."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.2,
      "end_seconds": 329.72,
      "duration_seconds": 11.52,
      "text": "The socket at the bottom left is oozing steadily, and there's no clot sitting in it. The gum around it is not swollen."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.64,
      "end_seconds": 332.54,
      "duration_seconds": 1.9,
      "text": "Is that bad?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.78,
      "end_seconds": 348.07,
      "duration_seconds": 14.29,
      "text": "It's a socket that hasn't clotted, which on warfarin is not unusual. I can't rule out that your warfarin level is running too high."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 350.97,
      "end_seconds": 355.86,
      "duration_seconds": 4.89,
      "text": "So is it the warfarin that's doing it?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.05,
      "end_seconds": 369.36,
      "duration_seconds": 12.31,
      "text": "Possibly. I can't rule out a high level yet, or just a slow-to-clot socket. That's why I'd like to order an INR blood test now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 372.05,
      "end_seconds": 379.43,
      "duration_seconds": 7.38,
      "text": "I can do that straight away, Doctor. I'll draw it while he's sitting there."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 381.44,
      "end_seconds": 390.38,
      "duration_seconds": 8.94,
      "text": "And I'd like a full blood count as well, to check how much blood he's lost."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 392.25,
      "end_seconds": 394.94,
      "duration_seconds": 2.69,
      "text": "Will I need a transfusion?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 397.05,
      "end_seconds": 408.33,
      "duration_seconds": 11.28,
      "text": "I doubt it. First, bite firmly on this fresh gauze for twenty minutes without peeking. No rinsing or spitting."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 410.41,
      "end_seconds": 415.07,
      "duration_seconds": 4.66,
      "text": "No peeking. Right. I'll do my best."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 416.51,
      "end_seconds": 422.19,
      "duration_seconds": 5.68,
      "text": "I'll keep an eye on the clock this time, Doctor."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 423.22,
      "end_seconds": 429.49,
      "duration_seconds": 6.27,
      "text": "Good woman. We'll watch him here until the results are back."
    }
  ]
}
