{
  "schema_version": "1.0",
  "encounter_id": "00746",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 2.14,
      "end_seconds": 15.08,
      "duration_seconds": 12.94,
      "text": "Hello, I'm Tia, I'll weigh and measure Evie later if the doctor wants. Take a seat, they won't be long. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 17.3,
      "end_seconds": 23.25,
      "duration_seconds": 5.95,
      "text": "Thanks, love. We've been waiting ages. Evie, don't scratch. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.99,
      "end_seconds": 31.73,
      "duration_seconds": 5.74,
      "text": "Hello, I'm Dr Pearson. Evie, how old are you? ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.08,
      "end_seconds": 36.37,
      "duration_seconds": 1.29,
      "text": "Nine. ~"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.31,
      "end_seconds": 44.29,
      "duration_seconds": 4.98,
      "text": "Nine, lovely. Evie, what's wrong with your head?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.81,
      "end_seconds": 51.12,
      "duration_seconds": 3.31,
      "text": "It's itchy. And there's white stuff."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 53.57,
      "end_seconds": 63.76,
      "duration_seconds": 10.19,
      "text": "Flaky white bits in her hair, doctor, on her shoulders, her school jumper. And she scratches at night."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.58,
      "end_seconds": 69.78,
      "duration_seconds": 3.2,
      "text": "When did it start, Evie?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.86,
      "end_seconds": 73.73,
      "duration_seconds": 1.87,
      "text": "Two weeks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 76.98,
      "end_seconds": 86.84,
      "duration_seconds": 9.86,
      "text": "It's longer than that, love, it's two months at least. I remember because of the half-term."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.23,
      "end_seconds": 100.77,
      "duration_seconds": 11.54,
      "text": "So two weeks from Evie and two months from Mum. I'll write that down. Does anyone else at home have itchy heads?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 103.61,
      "end_seconds": 107.98,
      "duration_seconds": 4.37,
      "text": "Her little brother scratches. I've not looked properly. ~"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.0,
      "end_seconds": 115.49,
      "duration_seconds": 5.49,
      "text": "Has she had any hair loss, patches where hair's gone?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 117.51,
      "end_seconds": 121.44,
      "duration_seconds": 3.93,
      "text": "No, no bald patches. Her hair's thick, thankfully."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.7,
      "end_seconds": 129.88,
      "duration_seconds": 5.18,
      "text": "Any sore, weepy or crusty bits on the scalp?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 131.96,
      "end_seconds": 137.11,
      "duration_seconds": 5.15,
      "text": "No, nothing weepy. Just flaky and red in places."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.18,
      "end_seconds": 146.23,
      "duration_seconds": 6.05,
      "text": "Evie, can I look at your scalp? Bend your head forward. ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.28,
      "end_seconds": 164.49,
      "duration_seconds": 1.21,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.68,
      "end_seconds": 180.05,
      "duration_seconds": 13.37,
      "text": "There are fine white flakes and some redness around the hair roots, mostly at the back and behind the ears. No broken hairs, and no bald spots."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 182.99,
      "end_seconds": 185.64,
      "duration_seconds": 2.65,
      "text": "Is it nits? ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.22,
      "end_seconds": 206.54,
      "duration_seconds": 17.32,
      "text": "I can't see lice or eggs. I'd say this looks like a dry, flaky scalp, but I can't rule out a fungal infection, which is more likely to spread between children."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 208.88,
      "end_seconds": 210.55,
      "duration_seconds": 1.67,
      "text": "Ringworm? ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.79,
      "end_seconds": 223.66,
      "duration_seconds": 10.87,
      "text": "It's possible, so I'd like to take a few flakes and a couple of hairs for testing. It doesn't hurt."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.75,
      "end_seconds": 228.27,
      "duration_seconds": 2.52,
      "text": "Will it hurt? ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.15,
      "end_seconds": 245.92,
      "duration_seconds": 4.77,
      "text": "No, Evie, it's like a gentle brush."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 248.65,
      "end_seconds": 253.47,
      "duration_seconds": 4.82,
      "text": "Doctor, shall I label the sample? ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.28,
      "end_seconds": 263.55,
      "duration_seconds": 7.27,
      "text": "Please, Tia. Mum, I'll also look at her brother's head when you next come. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 266.78,
      "end_seconds": 268.5,
      "duration_seconds": 1.72,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.29,
      "end_seconds": 277.76,
      "duration_seconds": 6.47,
      "text": "Meanwhile, use a gentle shampoo, don't scratch, and don't share hats or combs."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 280.99,
      "end_seconds": 282.69,
      "duration_seconds": 1.7,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.05,
      "end_seconds": 297.14,
      "duration_seconds": 11.09,
      "text": "If bald patches appear, the scalp gets crusty or sore, or the neck glands swell, come back and see me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 299.71,
      "end_seconds": 302.51,
      "duration_seconds": 2.8,
      "text": "We will. Thank you. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.31,
      "end_seconds": 305.99,
      "duration_seconds": 1.68,
      "text": "Bye. ~"
    }
  ]
}
