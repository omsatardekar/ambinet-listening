{
  "schema_version": "1.0",
  "encounter_id": "00743",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.44,
      "end_seconds": 11.66,
      "duration_seconds": 10.22,
      "text": "Morning, doctor. I'm Frank, and this is my wife Lorraine. We've come for the helicobacter retest, I hope that's the right word."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.5,
      "end_seconds": 23.16,
      "duration_seconds": 9.66,
      "text": "It is, Frank, nice to meet you both. You finished the treatment course, I see. Remind me what you took."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.61,
      "end_seconds": 36.51,
      "duration_seconds": 11.9,
      "text": "Clarithromycin, 500 mg, twice a day, I think, with another antibiotic and a stomach tablet, for two weeks. I'd have to check the box."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.13,
      "end_seconds": 47.91,
      "duration_seconds": 9.78,
      "text": "So 500 mg twice a day as you recall it. And how have you been since finishing?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.7,
      "end_seconds": 60.09,
      "duration_seconds": 9.39,
      "text": "The heartburn is much better, mostly, but still there in the evenings. A couple of weeks since I finished."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 62.47,
      "end_seconds": 72.58,
      "duration_seconds": 10.11,
      "text": "It's been a month, Frank. You finished on the fourth. I wrote it on the calendar."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.69,
      "end_seconds": 85.45,
      "duration_seconds": 11.76,
      "text": "So you say two weeks since finishing, and Lorraine says a month. I'll write two weeks to a month. Anything else?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.18,
      "end_seconds": 96.36,
      "duration_seconds": 8.18,
      "text": "A bit of belching, after meals. And I've been going off my food."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.27,
      "end_seconds": 100.27,
      "duration_seconds": 3.0,
      "text": "Any vomiting, or black stools?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.08,
      "end_seconds": 106.77,
      "duration_seconds": 3.69,
      "text": "No vomiting. No black stools."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.49,
      "end_seconds": 111.88,
      "duration_seconds": 3.39,
      "text": "Any trouble swallowing, or weight loss?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.31,
      "end_seconds": 119.1,
      "duration_seconds": 5.79,
      "text": "No weight loss, the scales say the same as always."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 120.55,
      "end_seconds": 125.6,
      "duration_seconds": 5.05,
      "text": "That's right, his weight's been steady, doctor."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.44,
      "end_seconds": 132.22,
      "duration_seconds": 3.78,
      "text": "Good. Any other health conditions?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.66,
      "end_seconds": 136.87,
      "duration_seconds": 2.21,
      "text": "High blood pressure."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.75,
      "end_seconds": 144.34,
      "duration_seconds": 4.59,
      "text": "Any bowel or stomach problems in the family?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 145.6,
      "end_seconds": 150.41,
      "duration_seconds": 4.81,
      "text": "His mother had a stomach ulcer, I believe."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.66,
      "end_seconds": 159.62,
      "duration_seconds": 6.96,
      "text": "And what do you do for a living, are you still working?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.96,
      "end_seconds": 166.26,
      "duration_seconds": 4.3,
      "text": "I'm a retired plumber. Thirty-five years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.21,
      "end_seconds": 185.23,
      "duration_seconds": 3.02,
      "text": "Let me press your tummy."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.0,
      "end_seconds": 190.33,
      "duration_seconds": 2.33,
      "text": "Ow, careful. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.85,
      "end_seconds": 204.95,
      "duration_seconds": 13.1,
      "text": "A little tender at the top, but nothing worrying. Frank, the antibiotics only work if the bacteria are gone, so I'd like to check. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 206.95,
      "end_seconds": 210.42,
      "duration_seconds": 3.47,
      "text": "How do you check? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.67,
      "end_seconds": 224.2,
      "duration_seconds": 12.53,
      "text": "I'd like to arrange a urea breath test, but you must have stopped acid-lowering tablets for two weeks and antibiotics for four weeks before it."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.96,
      "end_seconds": 235.31,
      "duration_seconds": 9.35,
      "text": "I stopped the antibiotics a month ago, then. And the stomach tablet is the one I take every morning. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.14,
      "end_seconds": 251.18,
      "duration_seconds": 13.04,
      "text": "The stomach tablet must stop two weeks before the test, so I'd like you to stop it now, and book the breath test for two weeks from now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 253.19,
      "end_seconds": 258.88,
      "duration_seconds": 5.69,
      "text": "Can he use anything for the heartburn meanwhile? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.59,
      "end_seconds": 267.92,
      "duration_seconds": 7.33,
      "text": "Antacid liquid when needed, but avoid spicy food, coffee, and late meals."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.65,
      "end_seconds": 272.61,
      "duration_seconds": 2.96,
      "text": "That I can do. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.3,
      "end_seconds": 283.32,
      "duration_seconds": 8.02,
      "text": "And if you vomit blood, pass black stools, or have trouble swallowing, come in at once."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 286.22,
      "end_seconds": 288.15,
      "duration_seconds": 1.93,
      "text": "We will. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.61,
      "end_seconds": 299.85,
      "duration_seconds": 9.24,
      "text": "I'd like to see you again in three weeks, once the breath test is done."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.82,
      "end_seconds": 306.0,
      "duration_seconds": 4.18,
      "text": "Three weeks. Thank you, doctor. ~"
    }
  ]
}
