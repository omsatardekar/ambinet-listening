{
  "schema_version": "1.0",
  "encounter_id": "00618",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.88,
      "end_seconds": 14.03,
      "duration_seconds": 13.15,
      "text": "I'd rather not make a fuss, but my wife insisted. I've got a terrible pain in my left side, round the back."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.48,
      "end_seconds": 22.88,
      "duration_seconds": 7.4,
      "text": "You were right to come. Let's get you comfortable. When did the pain start?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.3,
      "end_seconds": 33.56,
      "duration_seconds": 9.26,
      "text": "About six this morning. It woke me up. I've not had a pain like it, to be honest."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.79,
      "end_seconds": 41.94,
      "duration_seconds": 6.15,
      "text": "How would you describe it? Constant, or does it come in waves?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.68,
      "end_seconds": 53.88,
      "duration_seconds": 9.2,
      "text": "Waves. It builds up until I can hardly stand, then eases off a bit, then builds up again."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.86,
      "end_seconds": 64.15,
      "duration_seconds": 9.29,
      "text": "How bad is it at the worst, if you had to put a word to it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.18,
      "end_seconds": 75.02,
      "duration_seconds": 9.84,
      "text": "Severe. I was sick once on the way here, though I tried not to be in the car."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.68,
      "end_seconds": 82.65,
      "duration_seconds": 5.97,
      "text": "Does it spread anywhere, down into the groin for instance?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.27,
      "end_seconds": 92.48,
      "duration_seconds": 7.21,
      "text": "Yes, it goes round the front and down low. That's what frightened me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.21,
      "end_seconds": 101.53,
      "duration_seconds": 6.32,
      "text": "Understood. Have you had a temperature or shivering? Any fever at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.38,
      "end_seconds": 106.19,
      "duration_seconds": 3.81,
      "text": "No fever. No shivers. Nothing like that."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.64,
      "end_seconds": 114.6,
      "duration_seconds": 5.96,
      "text": "Good. Now, what tablets do you take, if any?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.47,
      "end_seconds": 125.34,
      "duration_seconds": 8.87,
      "text": "Amlodipine, 5 mg, once a day. I take it in the morning with my tea."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.1,
      "end_seconds": 133.13,
      "duration_seconds": 6.03,
      "text": "And do you have any allergies, to medicines or anything else?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.23,
      "end_seconds": 139.25,
      "duration_seconds": 5.02,
      "text": "No, none that I know of. Never have."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.64,
      "end_seconds": 151.59,
      "duration_seconds": 9.95,
      "text": "Thank you. Is there any kidney trouble in your family? Your wife mentioned something on the phone."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.31,
      "end_seconds": 164.25,
      "duration_seconds": 9.94,
      "text": "My brother has polycystic kidney disease. That's why she was so worried when I called out."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.52,
      "end_seconds": 176.99,
      "duration_seconds": 11.47,
      "text": "That's useful to know. I'm going to check your numbers now, and then examine your back and tummy. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.59,
      "end_seconds": 181.89,
      "duration_seconds": 2.3,
      "text": "Right you are. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.42,
      "end_seconds": 211.01,
      "duration_seconds": 11.59,
      "text": "Pulse 96, blood pressure 148 over 90, temperature 36.8, oxygen 99 percent, and you're breathing 18 times a minute."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.99,
      "end_seconds": 216.8,
      "duration_seconds": 2.81,
      "text": "Is that bad? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.73,
      "end_seconds": 232.72,
      "duration_seconds": 14.99,
      "text": "Your pulse and pressure are a bit up, which is just the pain. The temperature is normal, which I like. Can you lean forward for me? ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.11,
      "end_seconds": 238.98,
      "duration_seconds": 3.87,
      "text": "Ow. Yes. Careful, that's the spot. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.9,
      "end_seconds": 260.08,
      "duration_seconds": 8.18,
      "text": "You're very tender over the left loin, here, when I press. Your tummy itself is soft."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.13,
      "end_seconds": 266.33,
      "duration_seconds": 5.2,
      "text": "So what is it? Is it my kidney? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.22,
      "end_seconds": 283.0,
      "duration_seconds": 13.78,
      "text": "What you describe, with pain coming in waves and spreading to the groin, most likely a kidney stone. I'd like to be sure it's nothing more, though."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.28,
      "end_seconds": 289.55,
      "duration_seconds": 4.27,
      "text": "How do you do that? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.95,
      "end_seconds": 303.56,
      "duration_seconds": 12.61,
      "text": "I'd like to arrange a CT scan of your kidneys today. It's quick, and it shows a stone and whether your kidneys are blocked."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.59,
      "end_seconds": 312.58,
      "duration_seconds": 6.99,
      "text": "Today? Right. I thought I'd be sent home with a leaflet. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.81,
      "end_seconds": 324.95,
      "duration_seconds": 10.14,
      "text": "With the pain like this I'd rather see the picture first. I'll walk you round to radiology myself. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.8,
      "end_seconds": 331.84,
      "duration_seconds": 6.04,
      "text": "That's good of you. Can I have something for the pain? ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.7,
      "end_seconds": 344.89,
      "duration_seconds": 10.19,
      "text": "I'll make sure the nurses see you straight away in the scan area. Please drink water while you wait, small sips."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.44,
      "end_seconds": 351.64,
      "duration_seconds": 4.2,
      "text": "Small sips. I'll do my best. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.29,
      "end_seconds": 363.0,
      "duration_seconds": 8.71,
      "text": "If the pain suddenly gets much worse, or you start shivering, tell the staff at once."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 364.66,
      "end_seconds": 370.15,
      "duration_seconds": 5.49,
      "text": "Understood. Thank you, doctor. My wife will be relieved. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.04,
      "end_seconds": 377.95,
      "duration_seconds": 6.91,
      "text": "Let's get you to the scan. Lean on me if you need to. ~"
    }
  ]
}
