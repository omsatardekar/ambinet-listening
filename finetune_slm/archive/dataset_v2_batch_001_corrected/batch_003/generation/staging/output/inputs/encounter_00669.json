{
  "schema_version": "1.0",
  "encounter_id": "00669",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 0.68,
      "end_seconds": 8.36,
      "duration_seconds": 7.68,
      "text": "Morning, doctor. I'm Joan's carer, and we're here for her yearly over-seventy-fives check."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.29,
      "end_seconds": 16.81,
      "duration_seconds": 6.52,
      "text": "Good morning. Joan, how have you been, in general? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.81,
      "end_seconds": 29.11,
      "duration_seconds": 11.3,
      "text": "I'm fine. I do wish people would stop fussing. But since you ask, the forgetting is getting worse."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.2,
      "end_seconds": 35.36,
      "duration_seconds": 4.16,
      "text": "What sort of things do you forget?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.73,
      "end_seconds": 45.2,
      "duration_seconds": 7.47,
      "text": "Names, mostly. Where I've put my glasses. And last week I left the kettle on."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 47.64,
      "end_seconds": 53.71,
      "duration_seconds": 6.07,
      "text": "She's done it twice, doctor, the kettle. And she repeats herself."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.93,
      "end_seconds": 58.83,
      "duration_seconds": 3.9,
      "text": "Thank you. Anything else you've noticed? ~"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.07,
      "end_seconds": 64.99,
      "duration_seconds": 4.92,
      "text": "My knees ache, particularly on the stairs."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.63,
      "end_seconds": 68.31,
      "duration_seconds": 1.68,
      "text": "Both knees?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.67,
      "end_seconds": 81.44,
      "duration_seconds": 11.77,
      "text": "Both, though the right is worse. And my hearing's going, I'm sure, though Maureen says it's just that I don't listen."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 83.12,
      "end_seconds": 85.05,
      "duration_seconds": 1.93,
      "text": "It's both, doctor."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.32,
      "end_seconds": 90.16,
      "duration_seconds": 3.84,
      "text": "Any falls in the last year?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.57,
      "end_seconds": 94.89,
      "duration_seconds": 3.32,
      "text": "No falls. I'm very careful."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.85,
      "end_seconds": 104.53,
      "duration_seconds": 6.68,
      "text": "And have you lost weight, or has your appetite changed?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.55,
      "end_seconds": 110.34,
      "duration_seconds": 4.79,
      "text": "No, I'm eating well. Maureen's cooking sees to that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.29,
      "end_seconds": 115.1,
      "duration_seconds": 2.81,
      "text": "What medicines are you on?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 116.4,
      "end_seconds": 124.88,
      "duration_seconds": 8.48,
      "text": "Amlodipine, 5 mg once a day, and paracetamol, 500 mg, when her knees are bad."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.48,
      "end_seconds": 129.13,
      "duration_seconds": 1.65,
      "text": "Any allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.88,
      "end_seconds": 133.88,
      "duration_seconds": 3.0,
      "text": "None. I've been lucky."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.75,
      "end_seconds": 138.32,
      "duration_seconds": 1.57,
      "text": "Medical conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.75,
      "end_seconds": 144.66,
      "duration_seconds": 4.91,
      "text": "High blood pressure, and osteoarthritis in the knees."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.01,
      "end_seconds": 149.23,
      "duration_seconds": 3.22,
      "text": "Do you smoke or drink?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.73,
      "end_seconds": 159.31,
      "duration_seconds": 8.58,
      "text": "Never smoked in my life. I have a sherry at Christmas, a small one."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 161.62,
      "end_seconds": 167.63,
      "duration_seconds": 6.01,
      "text": "She walks round the block daily, with her stick. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.61,
      "end_seconds": 173.91,
      "duration_seconds": 4.3,
      "text": "Lovely. And any breathlessness, chest pain?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.1,
      "end_seconds": 179.86,
      "duration_seconds": 3.76,
      "text": "No, nothing of that sort."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.66,
      "end_seconds": 202.98,
      "duration_seconds": 6.32,
      "text": "Let me check your knees. Can you straighten that leg?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.06,
      "end_seconds": 207.08,
      "duration_seconds": 3.02,
      "text": "I can try. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.48,
      "end_seconds": 217.5,
      "duration_seconds": 9.02,
      "text": "There's some creaking, a crunch, in both knees when they bend, but no swelling or heat."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.27,
      "end_seconds": 223.01,
      "duration_seconds": 3.74,
      "text": "Is it wear and tear? ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.93,
      "end_seconds": 242.4,
      "duration_seconds": 17.47,
      "text": "That fits with osteoarthritis. As for the memory, a lot of things can cause forgetfulness, and I can't rule out early memory loss, which is why I'd like to look at it properly."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.23,
      "end_seconds": 247.92,
      "duration_seconds": 2.69,
      "text": "Dementia, you mean. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.52,
      "end_seconds": 269.16,
      "duration_seconds": 19.64,
      "text": "I don't want to put a label on it, Joan. I'd like a short memory test, today, if you're willing, and some blood tests to rule out simple causes, like vitamin B12 or thyroid."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.39,
      "end_seconds": 273.78,
      "duration_seconds": 2.39,
      "text": "I don't mind. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 275.27,
      "end_seconds": 278.44,
      "duration_seconds": 3.17,
      "text": "I'll sit with her. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.28,
      "end_seconds": 287.66,
      "duration_seconds": 6.38,
      "text": "And I'd like her hearing checked too, but that's a separate booking. ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 288.86,
      "end_seconds": 292.51,
      "duration_seconds": 3.65,
      "text": "Right, I'll ask at the desk. ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.23,
      "end_seconds": 303.1,
      "duration_seconds": 7.87,
      "text": "Until the results, please don't leave the kettle unattended. Maybe a kettle with an automatic switch-off."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 304.87,
      "end_seconds": 307.99,
      "duration_seconds": 3.12,
      "text": "I'll buy one this week. ~"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.26,
      "end_seconds": 317.81,
      "duration_seconds": 7.55,
      "text": "I'd like to see you again in three weeks, to talk through the tests."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.24,
      "end_seconds": 323.42,
      "duration_seconds": 3.18,
      "text": "Three weeks. Thank you, doctor. ~"
    }
  ]
}
