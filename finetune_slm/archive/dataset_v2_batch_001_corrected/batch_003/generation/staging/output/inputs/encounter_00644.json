{
  "schema_version": "1.0",
  "encounter_id": "00644",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.3,
      "end_seconds": 11.02,
      "duration_seconds": 10.72,
      "text": "Good afternoon, doctor. Thank you for seeing me again so promptly. I'm afraid the boil has not gone away entirely."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 12.79,
      "end_seconds": 24.26,
      "duration_seconds": 11.47,
      "text": "Good afternoon, Mr Whitfield. Nurse Sam is here to help. Tell me how things are since last time. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.8,
      "end_seconds": 37.39,
      "duration_seconds": 11.59,
      "text": "The boil under my right arm has gone down a bit, but it's still there, about ten days now. And it remains rather painful."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.46,
      "end_seconds": 43.37,
      "duration_seconds": 3.91,
      "text": "How painful? Is it worse at particular times?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.41,
      "end_seconds": 52.55,
      "duration_seconds": 8.14,
      "text": "Moderate, I should say. It catches when I lift my arm, putting on a jacket, for instance."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.58,
      "end_seconds": 56.16,
      "duration_seconds": 2.58,
      "text": "Any fever or shivers?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.56,
      "end_seconds": 61.11,
      "duration_seconds": 2.55,
      "text": "No fever, no."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.97,
      "end_seconds": 72.03,
      "duration_seconds": 8.06,
      "text": "And any similar lumps elsewhere, under the other arm or in the groin?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.85,
      "end_seconds": 83.04,
      "duration_seconds": 10.19,
      "text": "None in either place. This is the only one at present, though I've had others over the years."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.44,
      "end_seconds": 89.45,
      "duration_seconds": 5.01,
      "text": "Let's go through the treatment. What are you using?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.61,
      "end_seconds": 103.82,
      "duration_seconds": 12.21,
      "text": "The tablets you gave me, doxycycline, 100 mg twice a day, which I've nearly finished. And the antiseptic wash, chlorhexidine, every day in the shower."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.17,
      "end_seconds": 111.09,
      "duration_seconds": 4.92,
      "text": "Good. What else is on your record, medically?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.08,
      "end_seconds": 122.82,
      "duration_seconds": 9.74,
      "text": "Type 2 diabetes, acne when I was younger which I believe has persisted a little, and high cholesterol."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.97,
      "end_seconds": 132.72,
      "duration_seconds": 8.75,
      "text": "And you said you've had others over the years. Have you had any of them drained?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.63,
      "end_seconds": 143.02,
      "duration_seconds": 7.39,
      "text": "One, last year. The abscess drained under local anaesthetic, in the other armpit."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.91,
      "end_seconds": 146.02,
      "duration_seconds": 2.11,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.2,
      "end_seconds": 151.24,
      "duration_seconds": 4.04,
      "text": "I'm afraid so. About ten a day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 152.35,
      "end_seconds": 158.35,
      "duration_seconds": 6.0,
      "text": "Shall I do your observations, Mr Whitfield? Arm out, please. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.23,
      "end_seconds": 161.48,
      "duration_seconds": 2.25,
      "text": "Of course. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 180.44,
      "end_seconds": 188.56,
      "duration_seconds": 8.12,
      "text": "Blood pressure 134 over 84, pulse 80, temperature 36.7, oxygen 98 percent, weight 92 kilos."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.53,
      "end_seconds": 206.64,
      "duration_seconds": 7.11,
      "text": "Thanks, Sam. Right arm up, please, and let me have a look."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.9,
      "end_seconds": 212.24,
      "duration_seconds": 3.34,
      "text": "It's a little tender. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.04,
      "end_seconds": 224.34,
      "duration_seconds": 9.3,
      "text": "There's a tender swelling about three centimetres across under the right arm, with no spreading redness around it."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.17,
      "end_seconds": 228.57,
      "duration_seconds": 2.4,
      "text": "Is that satisfactory? ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.32,
      "end_seconds": 246.54,
      "duration_seconds": 17.22,
      "text": "It's improving, which is what I hoped for. Given that you've had repeated boils in the armpits, the pattern fits hidradenitis suppurativa, a condition of the sweat glands and hair follicles."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.84,
      "end_seconds": 256.12,
      "duration_seconds": 7.28,
      "text": "How interesting. I had never heard of that. Is it serious? ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.24,
      "end_seconds": 268.7,
      "duration_seconds": 10.46,
      "text": "It's chronic but manageable, and it's helped a lot by stopping smoking and managing your diabetes. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.38,
      "end_seconds": 275.17,
      "duration_seconds": 4.79,
      "text": "I do see the connection you're making. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.08,
      "end_seconds": 287.81,
      "duration_seconds": 9.73,
      "text": "I'd like to arrange an HbA1c blood test to see how your sugar control has been."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.1,
      "end_seconds": 291.92,
      "duration_seconds": 1.82,
      "text": "Certainly. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.79,
      "end_seconds": 303.42,
      "duration_seconds": 9.63,
      "text": "Keep using the wash, wear loose cotton clothing, and avoid shaving the area for now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.94,
      "end_seconds": 308.49,
      "duration_seconds": 2.55,
      "text": "Very well. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.01,
      "end_seconds": 320.85,
      "duration_seconds": 10.84,
      "text": "I'd like to see you again in two weeks, once the antibiotics are done, to check the area and talk about longer-term options."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.4,
      "end_seconds": 328.23,
      "duration_seconds": 4.83,
      "text": "Thank you, doctor. Thank you, Nurse. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 329.66,
      "end_seconds": 333.15,
      "duration_seconds": 3.49,
      "text": "Mind how you go. ~"
    }
  ]
}
