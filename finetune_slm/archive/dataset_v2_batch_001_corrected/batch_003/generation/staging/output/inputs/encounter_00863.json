{
  "schema_version": "1.0",
  "encounter_id": "00863",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 0.32,
      "end_seconds": 11.47,
      "duration_seconds": 11.15,
      "text": "Doctor, thank you for seeing us so quickly. It's my father, he has a sore on his heel, and today it looks terrible."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.9,
      "end_seconds": 18.2,
      "duration_seconds": 5.3,
      "text": "It's only a small thing. I told her. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.65,
      "end_seconds": 24.42,
      "duration_seconds": 4.77,
      "text": "Mr Kearney, can I have a look? Which heel?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.13,
      "end_seconds": 31.76,
      "duration_seconds": 4.63,
      "text": "The left. It's been sore a few weeks."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 34.53,
      "end_seconds": 45.28,
      "duration_seconds": 10.75,
      "text": "A pressure sore. The district nurse noticed it, and it's got worse this week, it's black in the middle, and it smells."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.96,
      "end_seconds": 51.99,
      "duration_seconds": 5.03,
      "text": "Are you able to walk, Mr Kearney? ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.3,
      "end_seconds": 60.06,
      "duration_seconds": 5.76,
      "text": "Not much. I'm in the chair most of the day. ~"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.22,
      "end_seconds": 65.15,
      "duration_seconds": 3.93,
      "text": "Any fever, or have you felt unwell?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 67.84,
      "end_seconds": 71.12,
      "duration_seconds": 3.28,
      "text": "He's been shivery since yesterday."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.52,
      "end_seconds": 75.85,
      "duration_seconds": 2.33,
      "text": "I'm fine. ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.68,
      "end_seconds": 80.82,
      "duration_seconds": 3.14,
      "text": "Any pain in the heel?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.77,
      "end_seconds": 86.06,
      "duration_seconds": 4.29,
      "text": "Not really. I can't feel it much."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.33,
      "end_seconds": 89.88,
      "duration_seconds": 2.55,
      "text": "What are you taking?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 92.6,
      "end_seconds": 110.0,
      "duration_seconds": 17.4,
      "text": "Clopidogrel, 75 mg, once a day, and metformin, 500 mg, twice a day. He takes the clopidogrel every day, I give it. The metformin, I'm not sure he takes."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.59,
      "end_seconds": 113.43,
      "duration_seconds": 1.84,
      "text": "I take it."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.18,
      "end_seconds": 122.53,
      "duration_seconds": 8.35,
      "text": "I'll note that you take it, Mr Kearney, and your daughter isn't sure. Any allergies?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 125.32,
      "end_seconds": 128.19,
      "duration_seconds": 2.87,
      "text": "Penicillin. He gets a rash."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.13,
      "end_seconds": 133.35,
      "duration_seconds": 3.22,
      "text": "Thank you. Do you smoke?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.11,
      "end_seconds": 137.91,
      "duration_seconds": 3.8,
      "text": "Gave it up after my stroke."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.54,
      "end_seconds": 143.79,
      "duration_seconds": 3.25,
      "text": "Pulse and temperature, please. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 146.04,
      "end_seconds": 147.99,
      "duration_seconds": 1.95,
      "text": "Go ahead. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.94,
      "end_seconds": 171.29,
      "duration_seconds": 6.35,
      "text": "Temperature 37.9, pulse 98, blood pressure 138 over 80, oxygen 97 percent."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 172.1,
      "end_seconds": 174.56,
      "duration_seconds": 2.46,
      "text": "Is that bad? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.96,
      "end_seconds": 205.26,
      "duration_seconds": 8.3,
      "text": "A raised temperature and a fast pulse, which worries me alongside the heel. Let me see it."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.19,
      "end_seconds": 225.31,
      "duration_seconds": 19.12,
      "text": "There's a black area of dead tissue, about three centimetres across, on the back of the left heel, with a red margin around it, some pus under the edge, and a foul smell, and the foot is warm."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 228.14,
      "end_seconds": 231.02,
      "duration_seconds": 2.88,
      "text": "Is it infected? ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.97,
      "end_seconds": 246.3,
      "duration_seconds": 13.33,
      "text": "Yes, I think it is, and I can't rule out the infection reaching the bone. This is a grade three pressure ulcer with infection, an infected pressure ulcer."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 248.64,
      "end_seconds": 252.28,
      "duration_seconds": 3.64,
      "text": "What do we do? ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.18,
      "end_seconds": 270.91,
      "duration_seconds": 15.73,
      "text": "He needs to come into hospital today. I'd like to arrange blood tests and an X-ray of the heel, and intravenous antibiotics, given your penicillin allergy, a different type."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.62,
      "end_seconds": 276.15,
      "duration_seconds": 3.53,
      "text": "Hospital? I'd rather not. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.45,
      "end_seconds": 286.58,
      "duration_seconds": 9.13,
      "text": "Mr Kearney, I understand, but the infection could spread to your blood or the bone, and that's dangerous. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.46,
      "end_seconds": 291.59,
      "duration_seconds": 2.13,
      "text": "All right. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.55,
      "end_seconds": 307.04,
      "duration_seconds": 13.49,
      "text": "I'll arrange an ambulance now, and I'll ring the ward. Please keep the heel off the bed and don't let anything press on it."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 309.54,
      "end_seconds": 312.87,
      "duration_seconds": 3.33,
      "text": "I'll pack a bag. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.22,
      "end_seconds": 324.91,
      "duration_seconds": 10.69,
      "text": "Bring his tablets and a list. If he becomes drowsy, confused, or very hot, tell the ambulance crew."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 327.0,
      "end_seconds": 329.84,
      "duration_seconds": 2.84,
      "text": "Thank you, doctor. ~"
    }
  ]
}
