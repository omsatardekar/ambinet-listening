{
  "schema_version": "1.0",
  "encounter_id": "00988",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 3.03,
      "end_seconds": 25.67,
      "duration_seconds": 22.64,
      "text": "Hi, doctor. Great to see you. I wanted to ask if I can cut down on my tablets, because my sugar numbers at home have been so much better, and I've been exercising, and my wife says I'm a new man, and, well, I thought it was worth asking."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.95,
      "end_seconds": 38.86,
      "duration_seconds": 8.91,
      "text": "Congratulations. That's a lot of hard work. How are you feeling in yourself? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.01,
      "end_seconds": 49.37,
      "duration_seconds": 6.36,
      "text": "Good. A bit dizzy now and then, when I stand up quick."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.18,
      "end_seconds": 55.07,
      "duration_seconds": 1.89,
      "text": "Anything else?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.76,
      "end_seconds": 63.23,
      "duration_seconds": 4.47,
      "text": "Hungry between meals. Like clockwork, at eleven."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.76,
      "end_seconds": 73.16,
      "duration_seconds": 6.4,
      "text": "Have you had any low blood sugar episodes, shakes, sweats?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.68,
      "end_seconds": 79.89,
      "duration_seconds": 3.21,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.03,
      "end_seconds": 87.91,
      "duration_seconds": 3.88,
      "text": "What are you taking at the moment?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.71,
      "end_seconds": 95.07,
      "duration_seconds": 3.36,
      "text": "Metformin, 1000 mg, twice a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.64,
      "end_seconds": 100.41,
      "duration_seconds": 1.77,
      "text": "Any allergies?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.04,
      "end_seconds": 115.58,
      "duration_seconds": 11.54,
      "text": "Hm. I think I had a reaction to some medicine once, a rash, but I can't remember what it was, or when."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.59,
      "end_seconds": 124.83,
      "duration_seconds": 5.24,
      "text": "I'll record it as a possible, unconfirmed allergy. Any other conditions?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.52,
      "end_seconds": 131.39,
      "duration_seconds": 2.87,
      "text": "Just the diabetes. Type 2."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.08,
      "end_seconds": 150.05,
      "duration_seconds": 6.97,
      "text": "Let me take your numbers. Blood pressure 124 over 76, weight 82 kilos."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.96,
      "end_seconds": 156.33,
      "duration_seconds": 3.37,
      "text": "I've lost seven kilos. ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.57,
      "end_seconds": 166.96,
      "duration_seconds": 6.39,
      "text": "That's a huge achievement. Any trouble with your heart, palpitations, when you're dizzy?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.56,
      "end_seconds": 173.07,
      "duration_seconds": 2.51,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.9,
      "end_seconds": 189.55,
      "duration_seconds": 12.65,
      "text": "Here's how I'd think about it. Weight loss and exercise make the body more sensitive to insulin, so you need less medicine. That's the goal. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.83,
      "end_seconds": 197.02,
      "duration_seconds": 4.19,
      "text": "So I can cut down? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.05,
      "end_seconds": 209.2,
      "duration_seconds": 9.15,
      "text": "A small step. I'd like to reduce your metformin to 500 mg, twice a day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.35,
      "end_seconds": 216.13,
      "duration_seconds": 3.78,
      "text": "Half the dose. Is that safe? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.75,
      "end_seconds": 232.03,
      "duration_seconds": 12.28,
      "text": "Yes, as long as we check. I'd like to arrange an HbA1c in three months, to make sure your sugar stays well controlled."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.1,
      "end_seconds": 237.83,
      "duration_seconds": 2.73,
      "text": "That makes sense. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.83,
      "end_seconds": 247.72,
      "duration_seconds": 6.89,
      "text": "If your home readings start climbing before then, ring us. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.65,
      "end_seconds": 253.78,
      "duration_seconds": 2.13,
      "text": "I will. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.06,
      "end_seconds": 265.89,
      "duration_seconds": 8.83,
      "text": "And the dizziness when you stand, drink a glass of water first thing, and stand up slowly."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.09,
      "end_seconds": 271.64,
      "duration_seconds": 2.55,
      "text": "I'll do that. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.3,
      "end_seconds": 281.75,
      "duration_seconds": 6.45,
      "text": "I'd like to see you again in three months, with the result."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.31,
      "end_seconds": 290.46,
      "duration_seconds": 5.15,
      "text": "Three months. And can I tell my wife? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.89,
      "end_seconds": 298.18,
      "duration_seconds": 4.29,
      "text": "Absolutely. She's earned it too. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.43,
      "end_seconds": 306.0,
      "duration_seconds": 3.57,
      "text": "She'll be delighted. Thank you. ~"
    }
  ]
}
