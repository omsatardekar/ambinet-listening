{
  "schema_version": "1.0",
  "encounter_id": "00730",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 1.35,
      "end_seconds": 11.68,
      "duration_seconds": 10.33,
      "text": "Doctor, I'm Sinead, I care for Mrs Dolan during the week. It's her knees, they're getting so bad she won't go out."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.95,
      "end_seconds": 19.15,
      "duration_seconds": 5.2,
      "text": "Ah, it's not that bad. I'm only slow. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.63,
      "end_seconds": 25.06,
      "duration_seconds": 4.43,
      "text": "Mrs Dolan, tell me about the knees."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.74,
      "end_seconds": 35.67,
      "duration_seconds": 8.93,
      "text": "Sore, both of them, especially the right. Stiff when I get up, and they ache at night."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.1,
      "end_seconds": 41.44,
      "duration_seconds": 3.34,
      "text": "How far can you walk now?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.27,
      "end_seconds": 55.01,
      "duration_seconds": 10.74,
      "text": "To the corner shop, and I have to stop twice. It used to be to the church and back, a mile."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.62,
      "end_seconds": 60.6,
      "duration_seconds": 3.98,
      "text": "How long has it been getting worse?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.87,
      "end_seconds": 65.12,
      "duration_seconds": 3.25,
      "text": "Over the last year, I'd say."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.39,
      "end_seconds": 72.93,
      "duration_seconds": 4.54,
      "text": "Any swelling or redness of the knees, or heat?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.49,
      "end_seconds": 79.91,
      "duration_seconds": 5.42,
      "text": "No, no swelling. They crack, though, like a bag of crisps."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.88,
      "end_seconds": 85.21,
      "duration_seconds": 3.33,
      "text": "Any falls, or giving way?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.92,
      "end_seconds": 90.17,
      "duration_seconds": 3.25,
      "text": "No, I haven't fallen, thank God."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.01,
      "end_seconds": 97.27,
      "duration_seconds": 4.26,
      "text": "What are you taking for the pain?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 99.36,
      "end_seconds": 107.38,
      "duration_seconds": 8.02,
      "text": "Paracetamol, 1 gram, four times a day, and naproxen, 250 mg, twice a day, with food."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.66,
      "end_seconds": 115.11,
      "duration_seconds": 6.45,
      "text": "I don't take the paracetamol four times, I take it when I remember."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 117.67,
      "end_seconds": 124.24,
      "duration_seconds": 6.57,
      "text": "She forgets it, doctor. I put it out, but I'm not always there."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.82,
      "end_seconds": 138.67,
      "duration_seconds": 12.85,
      "text": "So it's prescribed four times a day, but you take it as you remember. I won't be cross. What's your history?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.55,
      "end_seconds": 146.9,
      "duration_seconds": 5.35,
      "text": "Osteoarthritis, they said, in my knees and hands."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.92,
      "end_seconds": 151.67,
      "duration_seconds": 1.75,
      "text": "Any operations?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.35,
      "end_seconds": 160.22,
      "duration_seconds": 5.87,
      "text": "A hip replacement on the left, eight years ago."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.81,
      "end_seconds": 166.78,
      "duration_seconds": 3.97,
      "text": "And who helps you at home?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 168.78,
      "end_seconds": 175.54,
      "duration_seconds": 6.76,
      "text": "Her son comes at weekends. I come on weekdays. She lives alone."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.42,
      "end_seconds": 200.21,
      "duration_seconds": 4.79,
      "text": "Let me look at the knees, Mrs Dolan."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.07,
      "end_seconds": 216.2,
      "duration_seconds": 13.13,
      "text": "Both knees are a bit enlarged, with crunching when I bend them, and tender along the joint line, more on the right. No heat."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.13,
      "end_seconds": 221.16,
      "duration_seconds": 3.03,
      "text": "Is it worn out? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.24,
      "end_seconds": 235.54,
      "duration_seconds": 11.3,
      "text": "That fits wear-and-tear arthritis, osteoarthritis, but I can't rule out something inflammatory because of the night aches, so I'd like to check."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.86,
      "end_seconds": 239.03,
      "duration_seconds": 2.17,
      "text": "Check how? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.34,
      "end_seconds": 250.07,
      "duration_seconds": 8.73,
      "text": "I'd like to arrange an X-ray of both knees, and a blood test for inflammation."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 251.56,
      "end_seconds": 255.86,
      "duration_seconds": 4.3,
      "text": "Can she have injections, doctor? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.24,
      "end_seconds": 269.42,
      "duration_seconds": 11.18,
      "text": "A steroid injection can help the right knee for a few months, and we can discuss that when the X-ray is back. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.87,
      "end_seconds": 273.54,
      "duration_seconds": 2.67,
      "text": "Right. And exercise? ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.6,
      "end_seconds": 284.55,
      "duration_seconds": 7.95,
      "text": "Gentle exercise helps, swimming, cycling, a chair-based class. Walking sticks help too, I'll arrange a physio assessment."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 287.44,
      "end_seconds": 291.76,
      "duration_seconds": 4.32,
      "text": "I'll take her to the class. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.86,
      "end_seconds": 301.17,
      "duration_seconds": 6.31,
      "text": "I'd like to see you again in three weeks, with the results."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.89,
      "end_seconds": 306.02,
      "duration_seconds": 3.13,
      "text": "Three weeks. Thank you. ~"
    }
  ]
}
