{
  "schema_version": "1.0",
  "encounter_id": "00886",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.45,
      "end_seconds": 8.72,
      "duration_seconds": 7.27,
      "text": "Hello, doctor. I came to check my coil, because I can't feel the strings anymore."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_4",
      "role": "CAREGIVER",
      "start_seconds": 10.14,
      "end_seconds": 19.93,
      "duration_seconds": 9.79,
      "text": "I'm her sister, I came along for support. She's been worried about it for a week. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.52,
      "end_seconds": 26.69,
      "duration_seconds": 5.17,
      "text": "That's perfectly reasonable. When did you last feel the strings?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.9,
      "end_seconds": 38.34,
      "duration_seconds": 10.44,
      "text": "I think about a month ago. Maybe six weeks. I'm not sure, I don't check very often."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.29,
      "end_seconds": 43.24,
      "duration_seconds": 2.95,
      "text": "When was the coil fitted?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.38,
      "end_seconds": 51.58,
      "duration_seconds": 5.2,
      "text": "Three years ago. It's the hormone one, the levonorgestrel coil."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.13,
      "end_seconds": 58.51,
      "duration_seconds": 5.38,
      "text": "Have you had any pain, unusual bleeding, or discharge?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.39,
      "end_seconds": 66.87,
      "duration_seconds": 6.48,
      "text": "No pain, no bleeding, no discharge. Just the missing strings."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.94,
      "end_seconds": 72.91,
      "duration_seconds": 3.97,
      "text": "When was your last period? ~"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.65,
      "end_seconds": 83.12,
      "duration_seconds": 8.47,
      "text": "I don't really get them with the coil. Just a light spotting now and then. ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.8,
      "end_seconds": 90.41,
      "duration_seconds": 5.61,
      "text": "Is there any chance you could be pregnant? ~"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.61,
      "end_seconds": 97.7,
      "duration_seconds": 6.09,
      "text": "I took a test last week, and it was negative. ~"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.75,
      "end_seconds": 104.52,
      "duration_seconds": 3.77,
      "text": "Good. What other medicines are you taking?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.53,
      "end_seconds": 120.3,
      "duration_seconds": 13.77,
      "text": "A thyroid tablet, levothyroxine, 75 micrograms in the morning. Iron tablets, 200 mg, once a day. And paracetamol, 500 mg, now and then."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.21,
      "end_seconds": 126.31,
      "duration_seconds": 4.1,
      "text": "Thank you. Any past medical problems?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.96,
      "end_seconds": 132.03,
      "duration_seconds": 3.07,
      "text": "Underactive thyroid, and I'm anaemic."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.19,
      "end_seconds": 137.11,
      "duration_seconds": 2.92,
      "text": "Any operations in the past?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.17,
      "end_seconds": 143.95,
      "duration_seconds": 3.78,
      "text": "A caesarean section, seven years ago."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.77,
      "end_seconds": 154.13,
      "duration_seconds": 8.36,
      "text": "Thank you. My colleague will check your blood pressure and pulse first. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 155.85,
      "end_seconds": 160.67,
      "duration_seconds": 4.82,
      "text": "Please sit and relax your arm. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.62,
      "end_seconds": 172.93,
      "duration_seconds": 1.31,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 174.74,
      "end_seconds": 179.58,
      "duration_seconds": 4.84,
      "text": "Blood pressure 110 over 70, pulse 72."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.42,
      "end_seconds": 189.22,
      "duration_seconds": 7.8,
      "text": "Those are good. Now I'll do a speculum examination and look for the strings. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.83,
      "end_seconds": 213.38,
      "duration_seconds": 2.55,
      "text": "Okay. Please be gentle."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.91,
      "end_seconds": 225.62,
      "duration_seconds": 9.71,
      "text": "I can see the strings. They're short, and tucked up in the canal, but they are there."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.63,
      "end_seconds": 231.96,
      "duration_seconds": 4.33,
      "text": "Oh, thank God. So it's in place? ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.0,
      "end_seconds": 243.71,
      "duration_seconds": 8.71,
      "text": "It seems to be in place, yes. Strings sometimes curl up and are hard to feel."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "CAREGIVER",
      "start_seconds": 246.23,
      "end_seconds": 250.17,
      "duration_seconds": 3.94,
      "text": "So she doesn't need it removed? ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.52,
      "end_seconds": 263.15,
      "duration_seconds": 10.63,
      "text": "No. I'd still like to arrange a scan to confirm the position, because it's three years since it was fitted."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.49,
      "end_seconds": 268.68,
      "duration_seconds": 3.19,
      "text": "When would that be? ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.8,
      "end_seconds": 281.76,
      "duration_seconds": 10.96,
      "text": "Within two weeks. You'll get a letter. If it's in the right place, nothing more is needed. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.7,
      "end_seconds": 286.86,
      "duration_seconds": 3.16,
      "text": "That's a relief. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.33,
      "end_seconds": 299.1,
      "duration_seconds": 9.77,
      "text": "Until the scan, use condoms in case it has moved, and come back if you get pain or bleeding."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.11,
      "end_seconds": 306.0,
      "duration_seconds": 3.89,
      "text": "I will. Thank you both. ~"
    }
  ]
}
