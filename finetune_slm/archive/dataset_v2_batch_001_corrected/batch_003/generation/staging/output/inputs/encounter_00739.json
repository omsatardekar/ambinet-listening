{
  "schema_version": "1.0",
  "encounter_id": "00739",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 1.09,
      "end_seconds": 9.69,
      "duration_seconds": 8.6,
      "text": "Mr Corrigan, I'll do your observations first, then the doctor. Sit back for me. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.14,
      "end_seconds": 23.18,
      "duration_seconds": 11.04,
      "text": "Do you have to? I've a tee time at one, and I've already been through all this in the emergency department. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 65.33,
      "end_seconds": 74.07,
      "duration_seconds": 8.74,
      "text": "Blood pressure lying 126 over 78, and standing 122 over 76, pulse 68, oxygen 98 percent."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.34,
      "end_seconds": 87.04,
      "duration_seconds": 10.7,
      "text": "Good morning, Mr Corrigan, I'll be as quick as thoroughness allows. This is your follow-up after the faint at the wedding."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.63,
      "end_seconds": 99.78,
      "duration_seconds": 11.15,
      "text": "Yes, the wedding. I was standing in the sun for the photos, and the next thing, I'm looking up at the bridesmaid's shoes."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.37,
      "end_seconds": 105.53,
      "duration_seconds": 4.16,
      "text": "Tell me exactly what you remember."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.41,
      "end_seconds": 118.85,
      "duration_seconds": 10.44,
      "text": "Hot, a bit woozy, my vision went grey, and then I woke up on the grass. About a minute, they said."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.83,
      "end_seconds": 125.8,
      "duration_seconds": 5.97,
      "text": "Any warning in your chest, palpitations, pain, before you went?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.6,
      "end_seconds": 131.72,
      "duration_seconds": 4.12,
      "text": "No chest pain. No palpitations. Nothing like that."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.17,
      "end_seconds": 139.17,
      "duration_seconds": 6.0,
      "text": "Did you bite your tongue, or wet yourself, or feel confused afterwards?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.45,
      "end_seconds": 148.05,
      "duration_seconds": 7.6,
      "text": "No. I was a bit sweaty and clammy, and fine in five minutes."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.59,
      "end_seconds": 154.06,
      "duration_seconds": 3.47,
      "text": "Has it happened since? ~"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.52,
      "end_seconds": 160.58,
      "duration_seconds": 5.06,
      "text": "No, thank God. Not a flicker. ~"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.1,
      "end_seconds": 165.82,
      "duration_seconds": 2.72,
      "text": "What are you taking?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.14,
      "end_seconds": 176.15,
      "duration_seconds": 9.01,
      "text": "Ramipril, 5 mg once a day. And bisoprolol, 2.5 mg once a day. For the blood pressure."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.78,
      "end_seconds": 180.0,
      "duration_seconds": 2.22,
      "text": "And your history?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.62,
      "end_seconds": 191.74,
      "duration_seconds": 9.12,
      "text": "High blood pressure, high cholesterol, and I had gout, the once. I had a hernia repair too, in 2016."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.84,
      "end_seconds": 197.79,
      "duration_seconds": 4.95,
      "text": "Any breathlessness or palpitations at all, with the golf?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.93,
      "end_seconds": 204.92,
      "duration_seconds": 4.99,
      "text": "No, I can walk eighteen holes with no trouble."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.64,
      "end_seconds": 221.8,
      "duration_seconds": 15.16,
      "text": "Right. The ECG they did in the emergency department was normal, and the heart scan was normal, and your blood pressure today doesn't drop on standing. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.54,
      "end_seconds": 227.63,
      "duration_seconds": 3.09,
      "text": "So what was it? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.5,
      "end_seconds": 246.62,
      "duration_seconds": 17.12,
      "text": "Standing still in the heat, after a few drinks, is the classic setting for a simple faint, and nothing here suggests otherwise. I'm not going to put a heart label on it. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.44,
      "end_seconds": 252.79,
      "duration_seconds": 3.35,
      "text": "Good. Can I play golf? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.81,
      "end_seconds": 267.79,
      "duration_seconds": 13.98,
      "text": "Yes. Drink plenty of water, don't stand still for too long in the heat, and sit down at once if you feel woozy."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.35,
      "end_seconds": 272.89,
      "duration_seconds": 2.54,
      "text": "Easy enough. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 275.09,
      "end_seconds": 280.24,
      "duration_seconds": 5.15,
      "text": "Doctor, anything else you want me to do? ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.03,
      "end_seconds": 301.76,
      "duration_seconds": 19.73,
      "text": "No, Aoife, thank you. Mr Corrigan, if it happens again, particularly if it happens while you're sitting, with exercise, or with palpitations or chest pain, come back at once and I'll arrange further tests."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.96,
      "end_seconds": 307.62,
      "duration_seconds": 3.66,
      "text": "I will. Thanks, doctor. Aoife. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 308.8,
      "end_seconds": 312.62,
      "duration_seconds": 3.82,
      "text": "Good luck with the golf. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.15,
      "end_seconds": 317.45,
      "duration_seconds": 3.3,
      "text": "I'll need it. Cheers, both. ~"
    }
  ]
}
