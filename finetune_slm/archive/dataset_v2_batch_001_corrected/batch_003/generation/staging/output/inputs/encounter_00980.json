{
  "schema_version": "1.0",
  "encounter_id": "00980",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.42,
      "end_seconds": 14.99,
      "duration_seconds": 13.57,
      "text": "Good morning, doctor. I have no complaints at all, I'm here for my annual health check, and I'd like blood tests, as I've read it's sensible after forty."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.63,
      "end_seconds": 25.45,
      "duration_seconds": 7.82,
      "text": "It is sensible. Let me start with some questions. How are you in yourself? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.18,
      "end_seconds": 35.47,
      "duration_seconds": 8.29,
      "text": "Very well, honestly. A few small things. I sometimes get mild heartburn after spicy food."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.31,
      "end_seconds": 39.71,
      "duration_seconds": 1.4,
      "text": "How often?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.32,
      "end_seconds": 44.9,
      "duration_seconds": 2.58,
      "text": "Perhaps once a week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.71,
      "end_seconds": 48.67,
      "duration_seconds": 1.96,
      "text": "Anything else?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.13,
      "end_seconds": 59.94,
      "duration_seconds": 9.81,
      "text": "My lower back is a little stiff when I wake up. It goes after a shower."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.53,
      "end_seconds": 63.41,
      "duration_seconds": 1.88,
      "text": "Energy levels?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.56,
      "end_seconds": 71.64,
      "duration_seconds": 6.08,
      "text": "Fine. A bit tired by the evening, but I work long hours."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.02,
      "end_seconds": 76.16,
      "duration_seconds": 2.14,
      "text": "Any chest pain?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.93,
      "end_seconds": 81.2,
      "duration_seconds": 2.27,
      "text": "No chest pain."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.52,
      "end_seconds": 88.73,
      "duration_seconds": 4.21,
      "text": "What do you take at the moment?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.49,
      "end_seconds": 103.01,
      "duration_seconds": 12.52,
      "text": "A multivitamin, a little yellow capsule, from the pharmacy. I forget its name. And vitamin C, maybe 500 mg, once a day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.63,
      "end_seconds": 110.8,
      "duration_seconds": 5.17,
      "text": "Fine. And what do you do for a living?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.8,
      "end_seconds": 117.37,
      "duration_seconds": 3.57,
      "text": "I'm a software architect. Desk-bound, I'm afraid."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.24,
      "end_seconds": 138.19,
      "duration_seconds": 8.95,
      "text": "Let me take your numbers. Blood pressure 126 over 78, pulse 68, weight 72 kilos."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.71,
      "end_seconds": 144.6,
      "duration_seconds": 3.89,
      "text": "That's good, isn't it? ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.53,
      "end_seconds": 160.07,
      "duration_seconds": 5.54,
      "text": "Very good. I'm going to feel your tummy."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.6,
      "end_seconds": 164.96,
      "duration_seconds": 2.36,
      "text": "Go ahead. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.02,
      "end_seconds": 171.32,
      "duration_seconds": 4.3,
      "text": "Your abdomen is soft and not tender."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.34,
      "end_seconds": 176.25,
      "duration_seconds": 1.91,
      "text": "Good. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.22,
      "end_seconds": 187.34,
      "duration_seconds": 8.12,
      "text": "And the muscles of your lower back are a bit tight on both sides."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.8,
      "end_seconds": 192.17,
      "duration_seconds": 2.37,
      "text": "That's the stiffness. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.34,
      "end_seconds": 203.71,
      "duration_seconds": 9.37,
      "text": "Overall you're in good shape. I think you're healthy for your age, with only minor, easily managed complaints."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.54,
      "end_seconds": 208.84,
      "duration_seconds": 3.3,
      "text": "That's what I hoped. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.7,
      "end_seconds": 218.49,
      "duration_seconds": 7.79,
      "text": "For the heartburn, I'd like to start omeprazole, 20 mg, once a day, before breakfast."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.66,
      "end_seconds": 223.19,
      "duration_seconds": 2.53,
      "text": "For how long? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.15,
      "end_seconds": 235.23,
      "duration_seconds": 10.08,
      "text": "A month, and we'll see. And for the back, I'd suggest paracetamol, 1 gram, when it's stiff."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.27,
      "end_seconds": 241.43,
      "duration_seconds": 3.16,
      "text": "I rarely take anything. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.72,
      "end_seconds": 256.84,
      "duration_seconds": 13.12,
      "text": "Only when you need it. Now the tests. I'd like to arrange a full blood count with liver and kidney function, and a cholesterol and HbA1c test."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.99,
      "end_seconds": 262.62,
      "duration_seconds": 3.63,
      "text": "Do I need to fast? ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.13,
      "end_seconds": 270.59,
      "duration_seconds": 6.46,
      "text": "For the cholesterol, yes, from midnight. Water is fine. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.51,
      "end_seconds": 275.32,
      "duration_seconds": 1.81,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.66,
      "end_seconds": 283.71,
      "duration_seconds": 6.05,
      "text": "And stretch your back for a few minutes each morning."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.66,
      "end_seconds": 289.69,
      "duration_seconds": 3.03,
      "text": "I'll do that. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.35,
      "end_seconds": 299.46,
      "duration_seconds": 7.11,
      "text": "If the heartburn isn't better in four weeks, come back and see me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.78,
      "end_seconds": 306.03,
      "duration_seconds": 4.25,
      "text": "Four weeks. Thank you, doctor. ~"
    }
  ]
}
