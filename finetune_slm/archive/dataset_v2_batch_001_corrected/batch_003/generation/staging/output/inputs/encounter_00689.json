{
  "schema_version": "1.0",
  "encounter_id": "00689",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.16,
      "end_seconds": 11.27,
      "duration_seconds": 10.11,
      "text": "Morning, doctor! Well, I did it, I've cut my sleeping tablets down, and I want you to tell me I'm brilliant."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.81,
      "end_seconds": 22.41,
      "duration_seconds": 8.6,
      "text": "I'd be delighted to, once I hear the details. What are you taking now?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.07,
      "end_seconds": 35.08,
      "duration_seconds": 11.01,
      "text": "Zopiclone, 7.5 mg at night, which is half of what I was taking in the summer. Took me ten weeks."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.84,
      "end_seconds": 41.46,
      "duration_seconds": 4.62,
      "text": "That's a real achievement. How have the nights been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.41,
      "end_seconds": 54.57,
      "duration_seconds": 11.16,
      "text": "Up and down. Some nights I'm out like a light, others I'm staring at the ceiling thinking about the bins."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.61,
      "end_seconds": 61.61,
      "duration_seconds": 5.0,
      "text": "And if you don't take the tablet at all?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.94,
      "end_seconds": 75.56,
      "duration_seconds": 10.62,
      "text": "Then I can't sleep. I can't sleep a wink. I tried on Sunday, and I was up until four, wired."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.66,
      "end_seconds": 83.74,
      "duration_seconds": 6.08,
      "text": "Any shakes, sweats, or feeling very anxious when you cut down?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.01,
      "end_seconds": 95.08,
      "duration_seconds": 9.07,
      "text": "A bit jittery, but no, nothing dreadful. My mood's been steady, actually. No low spells."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.58,
      "end_seconds": 103.83,
      "duration_seconds": 6.25,
      "text": "Good. And remind me of your background, apart from the sleep."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.47,
      "end_seconds": 113.06,
      "duration_seconds": 7.59,
      "text": "Depression, years ago, which is much better now, and anxiety, which comes and goes."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.08,
      "end_seconds": 118.1,
      "duration_seconds": 3.02,
      "text": "How much coffee do you drink?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.45,
      "end_seconds": 128.32,
      "duration_seconds": 6.87,
      "text": "Three a day, the last around four. I know, I know, you've said."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.42,
      "end_seconds": 135.03,
      "duration_seconds": 4.61,
      "text": "Let me check your pulse and blood pressure. ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.95,
      "end_seconds": 140.22,
      "duration_seconds": 2.27,
      "text": "Go on. ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.47,
      "end_seconds": 157.85,
      "duration_seconds": 4.38,
      "text": "Pulse 70, blood pressure 124 over 78."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.57,
      "end_seconds": 161.9,
      "duration_seconds": 2.33,
      "text": "All fine? ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.26,
      "end_seconds": 171.05,
      "duration_seconds": 6.79,
      "text": "All fine. Hold your hands out in front of you for me. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.61,
      "end_seconds": 177.87,
      "duration_seconds": 4.26,
      "text": "Like this? Am I auditioning? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.61,
      "end_seconds": 198.08,
      "duration_seconds": 8.47,
      "text": "They're steady, no tremor. And you look calm and relaxed to me today."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.42,
      "end_seconds": 203.0,
      "duration_seconds": 2.58,
      "text": "I'll take that. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.27,
      "end_seconds": 214.95,
      "duration_seconds": 9.68,
      "text": "What I'm seeing is a dependence on zopiclone that's easing, but not yet resolved, because you can't sleep without it."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.05,
      "end_seconds": 220.33,
      "duration_seconds": 3.28,
      "text": "Dependence, ooh, that sounds dramatic. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.7,
      "end_seconds": 234.8,
      "duration_seconds": 11.1,
      "text": "It's just the word for when the body expects the tablet. It's common, and you're dealing with it well. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.38,
      "end_seconds": 241.24,
      "duration_seconds": 3.86,
      "text": "What should I do next? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.03,
      "end_seconds": 251.56,
      "duration_seconds": 8.53,
      "text": "Halve the dose again, so 3.75 mg at night, for two weeks. Slowly does it."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.75,
      "end_seconds": 258.29,
      "duration_seconds": 3.54,
      "text": "And if I can't sleep? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.39,
      "end_seconds": 271.84,
      "duration_seconds": 11.45,
      "text": "Get up after twenty minutes, go to another room, read something dull, and come back when you're sleepy. Don't watch the clock."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.15,
      "end_seconds": 281.91,
      "duration_seconds": 6.76,
      "text": "Dull I can do. I've got a manual for the boiler. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.97,
      "end_seconds": 288.61,
      "duration_seconds": 4.64,
      "text": "Perfect. And no coffee after noon. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.12,
      "end_seconds": 292.09,
      "duration_seconds": 1.97,
      "text": "Noon! Right. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.79,
      "end_seconds": 299.1,
      "duration_seconds": 5.31,
      "text": "I'd like to see you again in four weeks."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.58,
      "end_seconds": 306.0,
      "duration_seconds": 3.42,
      "text": "Four weeks. Thank you, doctor. ~"
    }
  ]
}
