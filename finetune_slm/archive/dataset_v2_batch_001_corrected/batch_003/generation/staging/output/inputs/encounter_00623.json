{
  "schema_version": "1.0",
  "encounter_id": "00623",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.6,
      "end_seconds": 9.37,
      "duration_seconds": 8.77,
      "text": "Hello. Um. I don't really know why we're here, it was Mark's idea. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 10.6,
      "end_seconds": 19.25,
      "duration_seconds": 8.65,
      "text": "I'm her husband, doctor. I made the appointment. I hope that's all right. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.65,
      "end_seconds": 31.39,
      "duration_seconds": 10.74,
      "text": "Of course it is. Thanks for coming, both of you. Let's start with you, Sarah, what's been going on? ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.11,
      "end_seconds": 42.35,
      "duration_seconds": 8.24,
      "text": "I'm just... tired. I'm a nurse on the acute medical ward, so everyone's tired, it's the job."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.54,
      "end_seconds": 53.54,
      "duration_seconds": 9.0,
      "text": "You're not wrong, but you came in, so I'd like to hear about your tired. ~"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.49,
      "end_seconds": 66.24,
      "duration_seconds": 11.75,
      "text": "It's a different sort of tired. I wake up and I'm exhausted before I've done anything. I feel exhausted all the time."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.82,
      "end_seconds": 73.26,
      "duration_seconds": 4.44,
      "text": "How long has it been like that?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.36,
      "end_seconds": 81.55,
      "duration_seconds": 6.19,
      "text": "Since the winter, probably. I don't know, I stopped counting."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.82,
      "end_seconds": 90.06,
      "duration_seconds": 6.24,
      "text": "Okay. Are you having any trouble sleeping at the moment?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.87,
      "end_seconds": 98.84,
      "duration_seconds": 5.97,
      "text": "No, I'm sleeping fine, actually. Seven hours, more or less."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 100.96,
      "end_seconds": 108.6,
      "duration_seconds": 7.64,
      "text": "She's up at three most nights, love. I hear her in the kitchen."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.57,
      "end_seconds": 119.23,
      "duration_seconds": 7.66,
      "text": "That's, I just get a glass of water, Mark. That's not being awake."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.13,
      "end_seconds": 131.98,
      "duration_seconds": 11.85,
      "text": "Thanks for telling me, both of you. I'll note what you each said. Have you had any thoughts of harming yourself?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.62,
      "end_seconds": 141.62,
      "duration_seconds": 7.0,
      "text": "No. Never. I'd tell you, I'm not that kind of tired."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.05,
      "end_seconds": 152.4,
      "duration_seconds": 8.35,
      "text": "I appreciate that. Let's look at the medicines. What are you taking at the moment?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.52,
      "end_seconds": 170.74,
      "duration_seconds": 17.22,
      "text": "Sertraline, 100 mg once a day. Zopiclone, 3.75 mg at night, only when I need it. Omeprazole, 20 mg in the morning, and propranolol, 40 mg for the shakes when I have a bad shift."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.7,
      "end_seconds": 176.92,
      "duration_seconds": 4.22,
      "text": "And the sertraline, you're taking that daily?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.41,
      "end_seconds": 182.12,
      "duration_seconds": 3.71,
      "text": "Every day. I never miss it."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 183.61,
      "end_seconds": 190.81,
      "duration_seconds": 7.2,
      "text": "She does miss it, love. I find the strip half full on Sundays."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.77,
      "end_seconds": 194.38,
      "duration_seconds": 2.61,
      "text": "That was once, Mark."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.5,
      "end_seconds": 207.74,
      "duration_seconds": 12.24,
      "text": "I'm not going to decide who's right here. I'll just record that you both told me different things. Any allergies to anything?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.86,
      "end_seconds": 215.4,
      "duration_seconds": 6.54,
      "text": "Latex. I get a rash on my hands from the gloves."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.93,
      "end_seconds": 222.45,
      "duration_seconds": 4.52,
      "text": "Good to know. And your health background?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.27,
      "end_seconds": 231.89,
      "duration_seconds": 8.62,
      "text": "Depression, diagnosed a few years ago. Migraine, and acid reflux, which is what the omeprazole is for."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.22,
      "end_seconds": 237.92,
      "duration_seconds": 3.7,
      "text": "And alcohol, do you drink?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.39,
      "end_seconds": 247.31,
      "duration_seconds": 7.92,
      "text": "I have a drink most evenings. A glass of wine, usually. It helps me switch off."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 250.24,
      "end_seconds": 254.33,
      "duration_seconds": 4.09,
      "text": "Mostly a glass. Sometimes two. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.22,
      "end_seconds": 259.66,
      "duration_seconds": 4.44,
      "text": "Thanks. Let me check you over. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 261.43,
      "end_seconds": 264.53,
      "duration_seconds": 3.1,
      "text": "I'll wait right here. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.2,
      "end_seconds": 289.18,
      "duration_seconds": 8.98,
      "text": "Pulse 78, blood pressure 118 over 74, temperature 36.7, oxygen 99 percent. Your pulse is regular."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.47,
      "end_seconds": 294.06,
      "duration_seconds": 3.59,
      "text": "Is everything all right? ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.85,
      "end_seconds": 304.57,
      "duration_seconds": 9.72,
      "text": "Your numbers are fine. Sarah, this isn't weakness, it's what burnout looks like. You've been running on empty. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.53,
      "end_seconds": 312.68,
      "duration_seconds": 5.15,
      "text": "I'm scared if I stop, I'll fall apart. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.02,
      "end_seconds": 327.44,
      "duration_seconds": 12.42,
      "text": "What I'd like is a fit note for two weeks, to start with. We'll talk about your hours with occupational health as well."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.85,
      "end_seconds": 334.17,
      "duration_seconds": 4.32,
      "text": "I can't just leave my team short. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 334.93,
      "end_seconds": 341.5,
      "duration_seconds": 6.57,
      "text": "Sarah, please. You're not the only nurse in the hospital. ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.15,
      "end_seconds": 355.84,
      "duration_seconds": 11.69,
      "text": "Take the two weeks, and let's see how you feel at the end. I'd like to see you again in four weeks."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 357.69,
      "end_seconds": 362.03,
      "duration_seconds": 4.34,
      "text": "Four weeks. Okay. Okay, I'll try. ~"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.32,
      "end_seconds": 368.39,
      "duration_seconds": 5.07,
      "text": "And Mark, thank you for bringing her. ~"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 370.66,
      "end_seconds": 373.39,
      "duration_seconds": 2.73,
      "text": "Thank you, doctor. ~"
    }
  ]
}
