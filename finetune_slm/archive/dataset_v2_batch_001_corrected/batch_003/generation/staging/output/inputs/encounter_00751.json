{
  "schema_version": "1.0",
  "encounter_id": "00751",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 1.3,
      "end_seconds": 8.84,
      "duration_seconds": 7.54,
      "text": "Doctor, quick, it's my husband, he can't breathe, his inhaler's not working!"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.59,
      "end_seconds": 17.97,
      "duration_seconds": 7.38,
      "text": "Bring him straight in, sit him up. Sir, can you tell me your name? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.71,
      "end_seconds": 23.12,
      "duration_seconds": 2.41,
      "text": "Declan. Can't. Breathe."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.45,
      "end_seconds": 33.25,
      "duration_seconds": 7.8,
      "text": "Okay Declan, I'm going to help you. Short answers. When did it start?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.46,
      "end_seconds": 36.72,
      "duration_seconds": 2.26,
      "text": "Yesterday. One day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 37.92,
      "end_seconds": 42.84,
      "duration_seconds": 4.92,
      "text": "It's been three days, Declan. He's been coughing since Monday."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.28,
      "end_seconds": 56.68,
      "duration_seconds": 11.4,
      "text": "Three days says your wife, one day says you. I'll put it as one to three days. Wheezy?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.96,
      "end_seconds": 60.03,
      "duration_seconds": 2.07,
      "text": "Yes. Chest tight."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 61.42,
      "end_seconds": 71.12,
      "duration_seconds": 9.7,
      "text": "He's used his blue inhaler every hour since this morning, and it only works for a few minutes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.27,
      "end_seconds": 76.25,
      "duration_seconds": 3.98,
      "text": "Any chest pain, or any blue lips?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.49,
      "end_seconds": 81.18,
      "duration_seconds": 2.69,
      "text": "No pain. Just tight."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.51,
      "end_seconds": 85.81,
      "duration_seconds": 3.3,
      "text": "Fever, or coughing up coloured phlegm?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.38,
      "end_seconds": 89.48,
      "duration_seconds": 2.1,
      "text": "No. Dry cough."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.26,
      "end_seconds": 97.58,
      "duration_seconds": 7.32,
      "text": "I'm putting oxygen on you now, and I'm checking your numbers. ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 99.36,
      "end_seconds": 104.16,
      "duration_seconds": 4.8,
      "text": "Is he going to be all right? ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.64,
      "end_seconds": 131.67,
      "duration_seconds": 10.03,
      "text": "Pulse 118, breathing 28 a minute, oxygen 91 percent without oxygen, blood pressure 138 over 86, temperature 36.9."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 134.04,
      "end_seconds": 137.76,
      "duration_seconds": 3.72,
      "text": "That's bad, isn't it? ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.88,
      "end_seconds": 154.2,
      "duration_seconds": 14.32,
      "text": "The oxygen is lower than I want and his breathing is fast, so this is a significant asthma attack, but we can treat it. Declan, I'm listening to your chest. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.58,
      "end_seconds": 171.48,
      "duration_seconds": 0.9,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.21,
      "end_seconds": 182.79,
      "duration_seconds": 9.58,
      "text": "Widespread wheeze all over both lungs, and the air isn't moving as well as I'd like at the bases."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.7,
      "end_seconds": 190.25,
      "duration_seconds": 5.55,
      "text": "What conditions does he have, and what does he take?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 192.91,
      "end_seconds": 206.7,
      "duration_seconds": 13.79,
      "text": "Asthma since he was a boy, and high blood pressure. He takes his blue inhaler and a brown one twice a day, but he's run out of the brown one."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.5,
      "end_seconds": 212.04,
      "duration_seconds": 3.54,
      "text": "When did he run out? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 214.07,
      "end_seconds": 220.08,
      "duration_seconds": 6.01,
      "text": "Last week. I meant to get a repeat. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.66,
      "end_seconds": 225.6,
      "duration_seconds": 3.94,
      "text": "Anyone else in the family with asthma?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 226.42,
      "end_seconds": 229.07,
      "duration_seconds": 2.65,
      "text": "His father, and his sister."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.9,
      "end_seconds": 244.95,
      "duration_seconds": 14.05,
      "text": "Thank you. Declan, I'm going to give you salbutamol through a nebuliser mask, and steroid tablets, prednisolone, 40 mg once a day, for five days."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.83,
      "end_seconds": 250.26,
      "duration_seconds": 2.43,
      "text": "Thank you. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.99,
      "end_seconds": 266.79,
      "duration_seconds": 15.8,
      "text": "I'd like to measure your peak flow once you've had the first treatment, and I'd like to arrange a chest X-ray, to make sure there's nothing else going on, like a collapsed lung."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 267.57,
      "end_seconds": 271.69,
      "duration_seconds": 4.12,
      "text": "Will he need to stay in? ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.65,
      "end_seconds": 287.91,
      "duration_seconds": 13.26,
      "text": "Probably a few hours of treatment first, and then we'll decide. If he's not improving within an hour, he'll go to the ward."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 289.14,
      "end_seconds": 292.69,
      "duration_seconds": 3.55,
      "text": "I'll stay with him. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.68,
      "end_seconds": 303.27,
      "duration_seconds": 8.59,
      "text": "Declan, breathe slowly in the mask, and tell the nurse if you feel worse."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.47,
      "end_seconds": 305.99,
      "duration_seconds": 1.52,
      "text": "Okay. ~"
    }
  ]
}
