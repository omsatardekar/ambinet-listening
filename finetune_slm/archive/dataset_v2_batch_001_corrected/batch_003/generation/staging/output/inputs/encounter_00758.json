{
  "schema_version": "1.0",
  "encounter_id": "00758",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.15,
      "end_seconds": 7.91,
      "duration_seconds": 6.76,
      "text": "Hello. It's my chest again, doctor. I think it's playing up. More than usual."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.13,
      "end_seconds": 14.11,
      "duration_seconds": 3.98,
      "text": "Tell me what's different from your usual."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.29,
      "end_seconds": 26.58,
      "duration_seconds": 10.29,
      "text": "I'm coughing up more, a lot more. And it's gone yellowy green. Usually it's clear, or a bit white."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.12,
      "end_seconds": 32.42,
      "duration_seconds": 4.3,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.92,
      "end_seconds": 38.62,
      "duration_seconds": 3.7,
      "text": "A week, nearly. Since last Wednesday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.6,
      "end_seconds": 48.19,
      "duration_seconds": 6.59,
      "text": "How much are you bringing up in a day, would you say?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.63,
      "end_seconds": 55.37,
      "duration_seconds": 4.74,
      "text": "Half a cupful, maybe. In the morning, mostly."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.55,
      "end_seconds": 61.92,
      "duration_seconds": 4.37,
      "text": "Have you had a fever, or night sweats?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.22,
      "end_seconds": 67.98,
      "duration_seconds": 3.76,
      "text": "No fever, I haven't felt hot."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.67,
      "end_seconds": 72.6,
      "duration_seconds": 2.93,
      "text": "Any blood in the phlegm?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.58,
      "end_seconds": 79.49,
      "duration_seconds": 3.91,
      "text": "No blood. It's just yellow and thick."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.45,
      "end_seconds": 85.49,
      "duration_seconds": 3.04,
      "text": "And breathless, more than usual?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.82,
      "end_seconds": 91.95,
      "duration_seconds": 4.13,
      "text": "A bit, on the stairs. Not at rest."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.11,
      "end_seconds": 98.42,
      "duration_seconds": 5.31,
      "text": "You've had bronchiectasis for a while, haven't you? ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.07,
      "end_seconds": 107.21,
      "duration_seconds": 7.14,
      "text": "Since my thirties. And my chest's been bad since the pneumonia. ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.68,
      "end_seconds": 110.48,
      "duration_seconds": 1.8,
      "text": "Any operations?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.34,
      "end_seconds": 119.54,
      "duration_seconds": 7.2,
      "text": "Just my adenoids, when I was small, I think. Or maybe my tonsils."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.64,
      "end_seconds": 128.61,
      "duration_seconds": 5.97,
      "text": "Let me check your pulse and oxygen, and have a listen. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.7,
      "end_seconds": 132.31,
      "duration_seconds": 1.61,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.25,
      "end_seconds": 151.72,
      "duration_seconds": 4.47,
      "text": "Pulse 88, oxygen 95 percent, temperature 36.9."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.18,
      "end_seconds": 155.8,
      "duration_seconds": 2.62,
      "text": "Is that low? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.54,
      "end_seconds": 182.6,
      "duration_seconds": 8.06,
      "text": "It's a touch lower than I'd like, but typical for you. Breathe in and out."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.66,
      "end_seconds": 187.55,
      "duration_seconds": 2.89,
      "text": "Is it crackly? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.12,
      "end_seconds": 197.1,
      "duration_seconds": 6.98,
      "text": "Yes, crackles at the bottom of both lungs, and a bit of wheeze."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.85,
      "end_seconds": 202.9,
      "duration_seconds": 3.05,
      "text": "What does it mean? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.81,
      "end_seconds": 220.65,
      "duration_seconds": 14.84,
      "text": "A change in your phlegm to yellow-green, more of it, and more breathlessness, fits a flare-up of your bronchiectasis, probably a chest infection on top."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.57,
      "end_seconds": 226.86,
      "duration_seconds": 3.29,
      "text": "What happens now? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.79,
      "end_seconds": 237.09,
      "duration_seconds": 8.3,
      "text": "I'd like to send a sample of your phlegm to the lab, to see which germ is growing."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.65,
      "end_seconds": 241.96,
      "duration_seconds": 2.31,
      "text": "And then? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.12,
      "end_seconds": 252.67,
      "duration_seconds": 9.55,
      "text": "The result will come back to the practice and we'll get it to you. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.71,
      "end_seconds": 266.24,
      "duration_seconds": 10.53,
      "text": "Keep up your daily physiotherapy, the breathing exercises that clear the phlegm, twice a day, and drink plenty of fluids."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.79,
      "end_seconds": 275.57,
      "duration_seconds": 6.78,
      "text": "I haven't been doing them as much as I should. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.84,
      "end_seconds": 283.98,
      "duration_seconds": 6.14,
      "text": "Please do, it makes a big difference in a flare-up. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.01,
      "end_seconds": 287.83,
      "duration_seconds": 1.82,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.21,
      "end_seconds": 301.19,
      "duration_seconds": 11.98,
      "text": "If you get breathless at rest, cough up blood, develop a high temperature, or feel confused, come back or call 999."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.12,
      "end_seconds": 306.01,
      "duration_seconds": 2.89,
      "text": "Right. Thanks, doctor. ~"
    }
  ]
}
