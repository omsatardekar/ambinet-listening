{
  "schema_version": "1.0",
  "encounter_id": "00981",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 0.87,
      "end_seconds": 17.73,
      "duration_seconds": 16.86,
      "text": "Dr Banerjee, Mr Chatterjee is here, he's got a swollen finger. I've done his obs: blood pressure 136 over 84, pulse 78, temperature 36.8, oxygen 98 percent, breathing 16, weight 80 kilos."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.06,
      "end_seconds": 26.01,
      "duration_seconds": 6.95,
      "text": "Thank you, nurse. Please come in, Mr Chatterjee. Which finger? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.36,
      "end_seconds": 39.46,
      "duration_seconds": 12.1,
      "text": "This one. The ring finger, the left one. It's swollen like a sausage, doctor. I... it's been, how do I say, quite a few weeks now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.64,
      "end_seconds": 46.85,
      "duration_seconds": 5.21,
      "text": "A sausage-like swelling of the whole finger. How many weeks?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.5,
      "end_seconds": 52.28,
      "duration_seconds": 3.78,
      "text": "Six weeks, I think. Maybe five."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.82,
      "end_seconds": 57.25,
      "duration_seconds": 2.43,
      "text": "Is it painful?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.18,
      "end_seconds": 63.61,
      "duration_seconds": 5.43,
      "text": "Yes, a throbbing pain, worse in the morning."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.95,
      "end_seconds": 66.84,
      "duration_seconds": 1.89,
      "text": "Any stiffness?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.25,
      "end_seconds": 76.42,
      "duration_seconds": 8.17,
      "text": "Stiff, yes. I cannot make a fist with that hand until about ten o'clock."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.46,
      "end_seconds": 81.13,
      "duration_seconds": 3.67,
      "text": "Any change in the nails?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.05,
      "end_seconds": 90.56,
      "duration_seconds": 8.51,
      "text": "A few little pits, tiny dents in the nails. I noticed last month."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.18,
      "end_seconds": 95.48,
      "duration_seconds": 3.3,
      "text": "Any redness or fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.25,
      "end_seconds": 101.19,
      "duration_seconds": 2.94,
      "text": "No redness, no fever."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.73,
      "end_seconds": 105.65,
      "duration_seconds": 2.92,
      "text": "Any injury to the finger?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.21,
      "end_seconds": 109.31,
      "duration_seconds": 2.1,
      "text": "No, no injury."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.84,
      "end_seconds": 115.89,
      "duration_seconds": 5.05,
      "text": "Any eye problems, redness or pain in the eyes?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.72,
      "end_seconds": 121.11,
      "duration_seconds": 3.39,
      "text": "No, my eyes are fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.7,
      "end_seconds": 127.1,
      "duration_seconds": 4.4,
      "text": "What do you take at the moment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.17,
      "end_seconds": 135.52,
      "duration_seconds": 7.35,
      "text": "Amlodipine, 5 mg, once a day. And omeprazole, 20 mg, in the morning."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.41,
      "end_seconds": 140.15,
      "duration_seconds": 1.74,
      "text": "Any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.34,
      "end_seconds": 143.85,
      "duration_seconds": 2.51,
      "text": "Sulfa. A rash."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.36,
      "end_seconds": 147.1,
      "duration_seconds": 1.74,
      "text": "Medical history?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.08,
      "end_seconds": 155.01,
      "duration_seconds": 5.93,
      "text": "Psoriasis, since my thirties. High blood pressure. And acid reflux."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.43,
      "end_seconds": 158.77,
      "duration_seconds": 1.34,
      "text": "Operations?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.14,
      "end_seconds": 165.55,
      "duration_seconds": 4.41,
      "text": "Appendix, in 1998. And a hernia, in 2012."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.8,
      "end_seconds": 171.61,
      "duration_seconds": 4.81,
      "text": "Any arthritis or skin trouble in the family?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.25,
      "end_seconds": 180.2,
      "duration_seconds": 5.95,
      "text": "My brother has psoriasis, and his joints are bad."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.19,
      "end_seconds": 185.37,
      "duration_seconds": 2.18,
      "text": "What do you do?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.65,
      "end_seconds": 188.79,
      "duration_seconds": 2.14,
      "text": "Retired bank manager."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.39,
      "end_seconds": 192.63,
      "duration_seconds": 1.24,
      "text": "Smoking?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.15,
      "end_seconds": 198.12,
      "duration_seconds": 2.97,
      "text": "I stopped smoking in 2010."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.43,
      "end_seconds": 201.74,
      "duration_seconds": 1.31,
      "text": "Alcohol?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.61,
      "end_seconds": 208.24,
      "duration_seconds": 3.63,
      "text": "A glass of wine with dinner."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.93,
      "end_seconds": 223.37,
      "duration_seconds": 3.44,
      "text": "Let me look at the finger."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.32,
      "end_seconds": 227.07,
      "duration_seconds": 2.75,
      "text": "Please be gentle. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.35,
      "end_seconds": 237.2,
      "duration_seconds": 8.85,
      "text": "The whole left ring finger is swollen evenly, from the knuckle to the tip, and it's tender."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.03,
      "end_seconds": 241.63,
      "duration_seconds": 2.6,
      "text": "That's it. ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.74,
      "end_seconds": 248.74,
      "duration_seconds": 5.0,
      "text": "There's also scaling on the elbows, consistent with psoriasis."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.51,
      "end_seconds": 251.91,
      "duration_seconds": 2.4,
      "text": "Yes, always. ~"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.43,
      "end_seconds": 261.09,
      "duration_seconds": 6.66,
      "text": "Any trouble with your back, stiffness in the lower back in the mornings?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.36,
      "end_seconds": 268.73,
      "duration_seconds": 5.37,
      "text": "No, nothing like that. My back is fine."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.55,
      "end_seconds": 279.45,
      "duration_seconds": 9.9,
      "text": "Mr Chatterjee, a whole finger swollen like this, together with psoriasis and nail pitting, suggests psoriatic arthritis."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.4,
      "end_seconds": 284.44,
      "duration_seconds": 3.04,
      "text": "Arthritis. Oh dear. ~"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.92,
      "end_seconds": 303.79,
      "duration_seconds": 16.87,
      "text": "I'd say it's likely, but I can't rule out a gout attack or an infection in the tendon sheath, though the lack of fever makes infection less likely."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.56,
      "end_seconds": 308.19,
      "duration_seconds": 1.63,
      "text": "Gout? ~"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.33,
      "end_seconds": 328.16,
      "duration_seconds": 18.83,
      "text": "It can do the same thing to a finger. I'd like to arrange an X-ray of both hands, blood tests including uric acid and inflammation markers, and an ultrasound of the finger."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 329.23,
      "end_seconds": 333.79,
      "duration_seconds": 4.56,
      "text": "I'll book the X-ray for this morning. ~"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.11,
      "end_seconds": 342.49,
      "duration_seconds": 6.38,
      "text": "And I'd like to refer you to the rheumatology clinic."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.44,
      "end_seconds": 348.49,
      "duration_seconds": 3.05,
      "text": "Is it urgent? ~"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.06,
      "end_seconds": 359.37,
      "duration_seconds": 9.31,
      "text": "I'll mark it as soon. Meanwhile, keep taking your tablets as usual, and use a warm compress in the morning."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 362.13,
      "end_seconds": 363.83,
      "duration_seconds": 1.7,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.61,
      "end_seconds": 374.04,
      "duration_seconds": 7.43,
      "text": "I'd like to see you again in three weeks with the results."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 376.75,
      "end_seconds": 380.27,
      "duration_seconds": 3.52,
      "text": "Three weeks. Thank you, doctor. ~"
    }
  ]
}
