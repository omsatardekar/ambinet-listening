{
  "schema_version": "1.0",
  "encounter_id": "00827",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 1.36,
      "end_seconds": 11.76,
      "duration_seconds": 10.4,
      "text": "Doctor, please, my husband, he ate prawns, and now his lips are swelling, and he's coming out in hives!"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.43,
      "end_seconds": 22.91,
      "duration_seconds": 9.48,
      "text": "Bring him straight in, sit him up. Sir, can you tell me your name, and how you're feeling? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.21,
      "end_seconds": 31.73,
      "duration_seconds": 6.52,
      "text": "Peter. My lips feel huge. And my throat's a bit tight."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.47,
      "end_seconds": 37.23,
      "duration_seconds": 3.76,
      "text": "When did you eat the prawns?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.52,
      "end_seconds": 47.11,
      "duration_seconds": 6.59,
      "text": "Twenty minutes ago. A prawn curry, at the Thai place."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 48.74,
      "end_seconds": 58.13,
      "duration_seconds": 9.39,
      "text": "No, it was ten minutes. We'd only just got to the car, I looked at my watch. ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.88,
      "end_seconds": 65.48,
      "duration_seconds": 5.6,
      "text": "It doesn't matter exactly, we're acting now. Any trouble breathing?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.37,
      "end_seconds": 73.9,
      "duration_seconds": 5.53,
      "text": "No. Not really. I'm fine, I can breathe."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 75.41,
      "end_seconds": 79.25,
      "duration_seconds": 3.84,
      "text": "He's wheezing, doctor, listen to him."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.55,
      "end_seconds": 86.75,
      "duration_seconds": 6.2,
      "text": "I'll listen. Have you had a reaction like this before? ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.14,
      "end_seconds": 93.92,
      "duration_seconds": 4.78,
      "text": "No. Never. I've eaten prawns all my life. ~"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.57,
      "end_seconds": 103.91,
      "duration_seconds": 7.34,
      "text": "Any allergies to medicines or other foods, as far as you know?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.22,
      "end_seconds": 108.35,
      "duration_seconds": 3.13,
      "text": "None. I've never had any."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.8,
      "end_seconds": 115.03,
      "duration_seconds": 5.23,
      "text": "Let me check you. Pulse, oxygen, pressure. ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 117.64,
      "end_seconds": 119.87,
      "duration_seconds": 2.23,
      "text": "Please hurry. ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.57,
      "end_seconds": 145.05,
      "duration_seconds": 8.48,
      "text": "Pulse 112, blood pressure 102 over 60, oxygen 95 percent, temperature 36.8, respiratory rate 22."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 147.29,
      "end_seconds": 149.78,
      "duration_seconds": 2.49,
      "text": "Is that bad? ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.78,
      "end_seconds": 163.64,
      "duration_seconds": 11.86,
      "text": "Your pulse is fast, the oxygen is a little low, and the pressure is on the low side, which is concerning. Open your mouth, Peter. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.62,
      "end_seconds": 183.04,
      "duration_seconds": 1.42,
      "text": "Ahh."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.38,
      "end_seconds": 196.05,
      "duration_seconds": 11.67,
      "text": "Your lips and tongue are swollen, there are raised red hives over your chest and arms, and I can hear a wheeze in your chest."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.04,
      "end_seconds": 200.94,
      "duration_seconds": 2.9,
      "text": "Is it serious? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.71,
      "end_seconds": 213.22,
      "duration_seconds": 9.51,
      "text": "Yes, it's what we call anaphylaxis, a severe reaction to the prawns. We're treating it now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 214.99,
      "end_seconds": 217.48,
      "duration_seconds": 2.49,
      "text": "Oh God. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.72,
      "end_seconds": 230.31,
      "duration_seconds": 10.59,
      "text": "Nurse, I want you to give adrenaline, intramuscular, point five of a milligram, into his thigh, now. And oxygen, and a drip."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.47,
      "end_seconds": 235.95,
      "duration_seconds": 3.48,
      "text": "Will I be all right? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.65,
      "end_seconds": 245.32,
      "duration_seconds": 7.67,
      "text": "Yes. The adrenaline works fast. You'll feel your heart race for a few minutes. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 247.57,
      "end_seconds": 251.56,
      "duration_seconds": 3.99,
      "text": "Can I stay with him? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.17,
      "end_seconds": 269.63,
      "duration_seconds": 15.46,
      "text": "Yes, please, hold his hand. I'm also going to give an antihistamine and a steroid by injection, and we'll keep you in for at least six hours, to watch for a second reaction."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.03,
      "end_seconds": 273.85,
      "duration_seconds": 1.82,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.78,
      "end_seconds": 287.39,
      "duration_seconds": 10.61,
      "text": "And I'd like a blood test for tryptase, which shows the reaction, and a repeat set of observations every fifteen minutes."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 289.22,
      "end_seconds": 291.95,
      "duration_seconds": 2.73,
      "text": "Thank you, doctor. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.06,
      "end_seconds": 301.41,
      "duration_seconds": 7.35,
      "text": "Peter, don't eat or drink anything, and tell the nurse if your breathing worsens."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.49,
      "end_seconds": 306.0,
      "duration_seconds": 2.51,
      "text": "I will. ~"
    }
  ]
}
