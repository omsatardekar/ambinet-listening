{
  "schema_version": "1.0",
  "encounter_id": "00972",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 2.12,
      "end_seconds": 13.5,
      "duration_seconds": 11.38,
      "text": "I'm in a lot of pain. Gut pain, and I've had the runs for five days. I've been on azathioprine, but this is bad."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.95,
      "end_seconds": 28.46,
      "duration_seconds": 12.51,
      "text": "I'm sorry. Let me ask quickly, then we'll do the examination. How many times a day are you going to the toilet?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.88,
      "end_seconds": 34.86,
      "duration_seconds": 3.98,
      "text": "Eight, nine times. Even at night."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.7,
      "end_seconds": 40.62,
      "duration_seconds": 1.92,
      "text": "Is there blood?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.43,
      "end_seconds": 47.66,
      "duration_seconds": 3.23,
      "text": "Yeah. Bright red, mixed in."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.95,
      "end_seconds": 53.31,
      "duration_seconds": 2.36,
      "text": "Where's the pain?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.36,
      "end_seconds": 59.72,
      "duration_seconds": 3.36,
      "text": "Lower right. Cramping, comes in waves."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.9,
      "end_seconds": 67.72,
      "duration_seconds": 4.82,
      "text": "And how do you feel in yourself?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.58,
      "end_seconds": 72.65,
      "duration_seconds": 2.07,
      "text": "Weak. Wiped out."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.15,
      "end_seconds": 78.89,
      "duration_seconds": 3.74,
      "text": "What medication are you on?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.43,
      "end_seconds": 85.92,
      "duration_seconds": 3.49,
      "text": "Azathioprine, 100 mg, once a day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.46,
      "end_seconds": 90.68,
      "duration_seconds": 2.22,
      "text": "Do you work?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.69,
      "end_seconds": 98.21,
      "duration_seconds": 4.52,
      "text": "Electrician. I haven't been in for three days."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.97,
      "end_seconds": 102.06,
      "duration_seconds": 1.09,
      "text": "Smoke?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.07,
      "end_seconds": 108.96,
      "duration_seconds": 2.89,
      "text": "About ten a day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.77,
      "end_seconds": 136.42,
      "duration_seconds": 9.65,
      "text": "Let me check you. Pulse 108, blood pressure 108 over 66, temperature 37.9, oxygen 98 percent, breathing 18, weight 68 kilos."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.29,
      "end_seconds": 142.51,
      "duration_seconds": 3.22,
      "text": "Is the pulse bad? ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.88,
      "end_seconds": 161.45,
      "duration_seconds": 7.57,
      "text": "It's fast, which fits with you being dehydrated. Lie back, I'll press your tummy."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.91,
      "end_seconds": 167.96,
      "duration_seconds": 3.05,
      "text": "Ow! That one. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.32,
      "end_seconds": 177.28,
      "duration_seconds": 5.96,
      "text": "There's tenderness in the lower right abdomen, with some guarding."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.11,
      "end_seconds": 181.47,
      "duration_seconds": 1.36,
      "text": "Yeah. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.01,
      "end_seconds": 188.83,
      "duration_seconds": 3.82,
      "text": "Your bowel sounds are very active."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.69,
      "end_seconds": 195.44,
      "duration_seconds": 2.75,
      "text": "Noisy, I know. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.1,
      "end_seconds": 200.85,
      "duration_seconds": 2.75,
      "text": "And your mouth is dry."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.9,
      "end_seconds": 209.41,
      "duration_seconds": 5.51,
      "text": "I've not been drinking much. It goes straight through. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.75,
      "end_seconds": 214.69,
      "duration_seconds": 1.94,
      "text": "Any palpitations?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.28,
      "end_seconds": 221.14,
      "duration_seconds": 3.86,
      "text": "No, nothing like that, no palpitations."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.79,
      "end_seconds": 231.77,
      "duration_seconds": 6.98,
      "text": "Right, here's what I think. This looks like a flare of your Crohn's disease."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.03,
      "end_seconds": 238.35,
      "duration_seconds": 3.32,
      "text": "Yeah, that's what I thought. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.8,
      "end_seconds": 255.66,
      "duration_seconds": 13.86,
      "text": "I'd like to arrange a stool test to rule out an infection, blood tests including an inflammation marker, and an X-ray of the abdomen."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.05,
      "end_seconds": 260.41,
      "duration_seconds": 1.36,
      "text": "Today? ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.12,
      "end_seconds": 270.79,
      "duration_seconds": 7.67,
      "text": "Right now. I'll get a nurse to start fluids through a drip. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.04,
      "end_seconds": 276.57,
      "duration_seconds": 2.53,
      "text": "Thank God. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.23,
      "end_seconds": 286.61,
      "duration_seconds": 7.38,
      "text": "Don't take anything for the diarrhoea until we've ruled out infection."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.24,
      "end_seconds": 290.9,
      "duration_seconds": 1.66,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.7,
      "end_seconds": 300.96,
      "duration_seconds": 6.26,
      "text": "If the bleeding or pain gets worse, press the call button straight away."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.84,
      "end_seconds": 306.01,
      "duration_seconds": 2.17,
      "text": "Will do. ~"
    }
  ]
}
