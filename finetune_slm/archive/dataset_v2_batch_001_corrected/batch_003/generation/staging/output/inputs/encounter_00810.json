{
  "schema_version": "1.0",
  "encounter_id": "00810",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.98,
      "end_seconds": 20.54,
      "duration_seconds": 19.56,
      "text": "G'day, doc. Bloody nuisance, this, I'm up four times a night for a pee, and my wife's had enough, she's moved to the spare room, and the dog's been sick too, we had to take him to the vet on Monday..."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.05,
      "end_seconds": 29.78,
      "duration_seconds": 7.73,
      "text": "Sorry to hear about the dog. Four times a night. How long's that been going on?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.53,
      "end_seconds": 37.73,
      "duration_seconds": 7.2,
      "text": "Six months, mate, give or take. Started with two times, now it's four."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.02,
      "end_seconds": 45.12,
      "duration_seconds": 5.1,
      "text": "And when you're at the toilet, how's the flow?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.79,
      "end_seconds": 55.05,
      "duration_seconds": 8.26,
      "text": "Weak. Slow to start, and then it dribbles. I stand there like a statue."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.77,
      "end_seconds": 59.11,
      "duration_seconds": 2.34,
      "text": "Anything after you've finished?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.48,
      "end_seconds": 64.46,
      "duration_seconds": 3.98,
      "text": "Yeah, dribbling after. Down the leg, embarrassing."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.0,
      "end_seconds": 70.18,
      "duration_seconds": 3.18,
      "text": "Any burning when you go?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.24,
      "end_seconds": 73.17,
      "duration_seconds": 1.93,
      "text": "No burning."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.86,
      "end_seconds": 79.04,
      "duration_seconds": 3.18,
      "text": "Any blood in the urine?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.69,
      "end_seconds": 87.04,
      "duration_seconds": 5.35,
      "text": "No blood, I've checked. Well, I think I've checked. No."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.36,
      "end_seconds": 92.96,
      "duration_seconds": 3.6,
      "text": "Are you thirsty all the time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.3,
      "end_seconds": 96.43,
      "duration_seconds": 2.13,
      "text": "Nah, not really."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.36,
      "end_seconds": 101.08,
      "duration_seconds": 1.72,
      "text": "Back pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.99,
      "end_seconds": 108.17,
      "duration_seconds": 6.18,
      "text": "No back pain. That's the one thing that's fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.87,
      "end_seconds": 113.74,
      "duration_seconds": 2.87,
      "text": "What tablets are you on?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.39,
      "end_seconds": 132.25,
      "duration_seconds": 15.86,
      "text": "Amlodipine, 5 mg, once a day. I take it every day, religiously. Well. Except when I'm out on the boat, then I forget it for a couple of days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.18,
      "end_seconds": 137.66,
      "duration_seconds": 3.48,
      "text": "So not quite every day. Allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.99,
      "end_seconds": 147.95,
      "duration_seconds": 7.96,
      "text": "Bactrim. I react to it, but don't ask me how, I can't remember what it did."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.47,
      "end_seconds": 152.38,
      "duration_seconds": 1.91,
      "text": "Okay. Conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.32,
      "end_seconds": 158.37,
      "duration_seconds": 5.05,
      "text": "High blood pressure, gout, and kidney stones, years back."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.14,
      "end_seconds": 162.59,
      "duration_seconds": 1.45,
      "text": "Operations?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.46,
      "end_seconds": 171.1,
      "duration_seconds": 5.64,
      "text": "Kidney stone removed, in 2009. Hernia, in 2015."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.56,
      "end_seconds": 174.55,
      "duration_seconds": 0.99,
      "text": "Family?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.48,
      "end_seconds": 182.09,
      "duration_seconds": 4.61,
      "text": "Dad had prostate cancer. My brother has diabetes."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.96,
      "end_seconds": 187.51,
      "duration_seconds": 2.55,
      "text": "What do you do?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.81,
      "end_seconds": 193.6,
      "duration_seconds": 4.79,
      "text": "Retired farmer. Still go out to the sheds every day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.28,
      "end_seconds": 196.6,
      "duration_seconds": 1.32,
      "text": "Drink?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.34,
      "end_seconds": 201.54,
      "duration_seconds": 3.2,
      "text": "Four beers, Friday and Saturday."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.15,
      "end_seconds": 230.88,
      "duration_seconds": 11.73,
      "text": "Let me check your numbers. Pulse 70, blood pressure 144 over 88, temperature 36.7, oxygen 98 percent, breathing 14, weight 92 kilos."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.5,
      "end_seconds": 235.34,
      "duration_seconds": 2.84,
      "text": "Bit high, eh? ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.22,
      "end_seconds": 249.87,
      "duration_seconds": 5.65,
      "text": "A little. Hop on the bed. I'm feeling your tummy."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.79,
      "end_seconds": 253.74,
      "duration_seconds": 1.95,
      "text": "Cold hands. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.05,
      "end_seconds": 262.73,
      "duration_seconds": 7.68,
      "text": "Your abdomen is soft, and I can't feel your bladder, so you're emptying it reasonably."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.69,
      "end_seconds": 267.41,
      "duration_seconds": 1.72,
      "text": "Reasonably? ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.43,
      "end_seconds": 285.66,
      "duration_seconds": 5.23,
      "text": "I'm also going to do a rectal exam. It's quick."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.55,
      "end_seconds": 291.86,
      "duration_seconds": 3.31,
      "text": "Oh, here we go. ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.1,
      "end_seconds": 297.99,
      "duration_seconds": 3.89,
      "text": "The prostate is smooth, but enlarged."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.06,
      "end_seconds": 302.31,
      "duration_seconds": 3.25,
      "text": "Right. Is that why? ~"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.24,
      "end_seconds": 310.78,
      "duration_seconds": 6.54,
      "text": "And there's no swelling in your ankles. Any trouble breathing, mate?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.88,
      "end_seconds": 316.35,
      "duration_seconds": 3.47,
      "text": "No, nothing, my breathing's fine."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.01,
      "end_seconds": 326.77,
      "duration_seconds": 8.76,
      "text": "An enlarged prostate fits, but I can't rule out diabetes or kidney trouble yet."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.36,
      "end_seconds": 331.84,
      "duration_seconds": 2.48,
      "text": "Is it cancer? ~"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.13,
      "end_seconds": 347.27,
      "duration_seconds": 13.14,
      "text": "It could be nothing. I'd like to arrange a PSA blood test, and an ultrasound scan of your bladder and kidneys."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.26,
      "end_seconds": 351.04,
      "duration_seconds": 1.78,
      "text": "When? ~"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.13,
      "end_seconds": 359.91,
      "duration_seconds": 6.78,
      "text": "This week. And I'd like to start tamsulosin, 400 micrograms, once a day."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 361.93,
      "end_seconds": 366.42,
      "duration_seconds": 4.49,
      "text": "Will it stop the toilet trips? ~"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.93,
      "end_seconds": 374.02,
      "duration_seconds": 6.09,
      "text": "It should help. Cut the beer after dinner, too."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 376.95,
      "end_seconds": 380.65,
      "duration_seconds": 3.7,
      "text": "Ah, that's the hard part. ~"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 382.94,
      "end_seconds": 390.63,
      "duration_seconds": 7.69,
      "text": "I'd like to see you again in two weeks with the results."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 393.48,
      "end_seconds": 396.56,
      "duration_seconds": 3.08,
      "text": "Two weeks. Cheers, doc. ~"
    }
  ]
}
