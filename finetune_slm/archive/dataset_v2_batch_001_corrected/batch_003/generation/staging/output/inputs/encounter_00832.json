{
  "schema_version": "1.0",
  "encounter_id": "00832",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 0.77,
      "end_seconds": 14.07,
      "duration_seconds": 13.3,
      "text": "Hello, Josh? I'm Maria, I'm the nurse from school. Your mum's on the phone, she said it's fine for you to be seen without her. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.94,
      "end_seconds": 16.58,
      "duration_seconds": 1.64,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.42,
      "end_seconds": 24.15,
      "duration_seconds": 6.73,
      "text": "Hello Josh, I'm Dr Hayes. How old are you? ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.92,
      "end_seconds": 28.61,
      "duration_seconds": 1.69,
      "text": "Twelve. ~"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.71,
      "end_seconds": 38.09,
      "duration_seconds": 7.38,
      "text": "Maria says you've been getting tummy cramps at school. Tell me about them."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.33,
      "end_seconds": 49.35,
      "duration_seconds": 10.02,
      "text": "They come after lunch. It's like a squeezing, and sometimes I have to run to the toilet."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.25,
      "end_seconds": 51.73,
      "duration_seconds": 1.48,
      "text": "How often?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.49,
      "end_seconds": 57.74,
      "duration_seconds": 5.25,
      "text": "Most days this week. Not every day before that."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 58.75,
      "end_seconds": 64.96,
      "duration_seconds": 6.21,
      "text": "His mum says it's been about a month, on and off. ~"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.28,
      "end_seconds": 72.16,
      "duration_seconds": 5.88,
      "text": "Do you feel sick, or have you been sick?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.78,
      "end_seconds": 77.09,
      "duration_seconds": 2.31,
      "text": "No. Not sick."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.96,
      "end_seconds": 84.88,
      "duration_seconds": 4.92,
      "text": "Any blood when you go to the toilet?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.96,
      "end_seconds": 87.94,
      "duration_seconds": 0.98,
      "text": "No."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.81,
      "end_seconds": 93.26,
      "duration_seconds": 4.45,
      "text": "What do you eat for lunch? ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.47,
      "end_seconds": 98.95,
      "duration_seconds": 4.48,
      "text": "School dinners. Pasta, mostly. And a flapjack. ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.69,
      "end_seconds": 103.75,
      "duration_seconds": 3.06,
      "text": "Any milk or cheese? ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.98,
      "end_seconds": 109.13,
      "duration_seconds": 4.15,
      "text": "Milk with my cereal. And yoghurt. ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.78,
      "end_seconds": 114.97,
      "duration_seconds": 4.19,
      "text": "Do the cramps happen at the weekend? ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.51,
      "end_seconds": 121.46,
      "duration_seconds": 3.95,
      "text": "Not really. Only school days. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 124.04,
      "end_seconds": 131.91,
      "duration_seconds": 7.87,
      "text": "He's been moved up a class this term, and there's a big test coming. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.4,
      "end_seconds": 139.98,
      "duration_seconds": 6.58,
      "text": "Is school okay, Josh? Is there anything worrying you? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.1,
      "end_seconds": 148.28,
      "duration_seconds": 6.18,
      "text": "A bit. The tests. And there's a boy who's mean. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.99,
      "end_seconds": 159.35,
      "duration_seconds": 9.36,
      "text": "Thank you for telling me. That sounds hard. Does anything else bother you, aching, headaches? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.21,
      "end_seconds": 164.38,
      "duration_seconds": 2.17,
      "text": "Sometimes headaches. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.88,
      "end_seconds": 170.49,
      "duration_seconds": 4.61,
      "text": "What medicines do you take, Maria's notes say?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 171.22,
      "end_seconds": 183.28,
      "duration_seconds": 12.06,
      "text": "His mum says, an inhaler, salbutamol, as needed, for asthma, and a vitamin, Vitamin D, 400 units, once a day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.24,
      "end_seconds": 191.09,
      "duration_seconds": 4.85,
      "text": "Let me check his pulse and temperature. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.24,
      "end_seconds": 194.99,
      "duration_seconds": 1.75,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.89,
      "end_seconds": 216.93,
      "duration_seconds": 6.04,
      "text": "Pulse 84, temperature 36.6, and his weight is 38 kilos."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 219.56,
      "end_seconds": 225.07,
      "duration_seconds": 5.51,
      "text": "That's the same as last term, doctor. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.41,
      "end_seconds": 250.99,
      "duration_seconds": 6.58,
      "text": "Good. Lie back, Josh. I'll press your tummy. Tell me if it hurts."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.03,
      "end_seconds": 254.39,
      "duration_seconds": 2.36,
      "text": "It tickles. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.66,
      "end_seconds": 260.6,
      "duration_seconds": 3.94,
      "text": "His tummy is soft and not tender."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 263.03,
      "end_seconds": 266.14,
      "duration_seconds": 3.11,
      "text": "Is it something serious? ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.12,
      "end_seconds": 282.64,
      "duration_seconds": 15.52,
      "text": "Nothing here worries me. Tummy ache linked to school days is very common, and often related to worry. I'd like to see how it goes, and I don't want to label it yet. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.77,
      "end_seconds": 288.29,
      "duration_seconds": 3.52,
      "text": "Will I have to take medicine? ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.44,
      "end_seconds": 303.9,
      "duration_seconds": 14.46,
      "text": "No medicine, Josh. I'd like you to try a few things. Eat lunch slowly, drink water, and go to the toilet before the tests, not after."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.78,
      "end_seconds": 308.35,
      "duration_seconds": 1.57,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 309.76,
      "end_seconds": 317.38,
      "duration_seconds": 7.62,
      "text": "I'll keep an eye on him, and I'll talk to his teacher about the boy. ~"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.8,
      "end_seconds": 328.8,
      "duration_seconds": 10.0,
      "text": "Thank you, Maria. I'd like to see Josh again in three weeks, with his mum, and we'll talk it through."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 330.88,
      "end_seconds": 333.69,
      "duration_seconds": 2.81,
      "text": "I'll arrange that. ~"
    }
  ]
}
