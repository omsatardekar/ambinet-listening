{
  "schema_version": "1.0",
  "encounter_id": "00984",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.95,
      "end_seconds": 18.49,
      "duration_seconds": 17.54,
      "text": "G'day, doctor. Now, my daughter Kerry reckons I've been forgetting things, and I said it's just old age, but she insisted, so here I am. Lovely clinic, by the way, I like the plants."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.17,
      "end_seconds": 28.58,
      "duration_seconds": 7.41,
      "text": "Thanks, they're my pride and joy. What kind of things are you forgetting?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.29,
      "end_seconds": 40.6,
      "duration_seconds": 11.31,
      "text": "Oh, names. Where I put my keys. Last week I went to the shops for milk and came back with biscuits and no milk."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.79,
      "end_seconds": 47.02,
      "duration_seconds": 4.23,
      "text": "How long has this been going on?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.17,
      "end_seconds": 55.29,
      "duration_seconds": 6.12,
      "text": "Six months, Kerry says, she keeps a diary on the fridge."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.61,
      "end_seconds": 62.99,
      "duration_seconds": 6.38,
      "text": "Do you ever get lost, even in places you know? ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.96,
      "end_seconds": 71.35,
      "duration_seconds": 5.39,
      "text": "No, never. I know every street in this suburb. ~"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.0,
      "end_seconds": 75.9,
      "duration_seconds": 1.9,
      "text": "Any falls?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.11,
      "end_seconds": 79.2,
      "duration_seconds": 2.09,
      "text": "No, no falls."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.04,
      "end_seconds": 81.78,
      "duration_seconds": 1.74,
      "text": "Any headaches?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.86,
      "end_seconds": 84.64,
      "duration_seconds": 1.78,
      "text": "No headaches."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.81,
      "end_seconds": 88.84,
      "duration_seconds": 2.03,
      "text": "Any low mood?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.7,
      "end_seconds": 93.0,
      "duration_seconds": 3.3,
      "text": "No, I'm a cheerful sort."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.58,
      "end_seconds": 98.62,
      "duration_seconds": 3.04,
      "text": "What do you take?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.54,
      "end_seconds": 108.42,
      "duration_seconds": 8.88,
      "text": "A cholesterol tablet, atorvastatin, maybe 20 mg, once a day. I'd have to check with Kerry."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.91,
      "end_seconds": 116.85,
      "duration_seconds": 5.94,
      "text": "Anything for your memory, anything you've bought from the chemist? ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.1,
      "end_seconds": 122.43,
      "duration_seconds": 3.33,
      "text": "No. Just the one. ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.57,
      "end_seconds": 127.14,
      "duration_seconds": 2.57,
      "text": "Any health conditions?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.7,
      "end_seconds": 132.72,
      "duration_seconds": 4.02,
      "text": "High cholesterol, and migraines when I was young."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.89,
      "end_seconds": 150.72,
      "duration_seconds": 5.83,
      "text": "Let me check you. Pulse 70, blood pressure 134 over 80."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.84,
      "end_seconds": 157.16,
      "duration_seconds": 4.32,
      "text": "Good for a man of seventy-eight? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.31,
      "end_seconds": 176.69,
      "duration_seconds": 10.38,
      "text": "Very good. Now I'm going to give you three words to remember, and I'll ask you in a minute. Apple, table, penny."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.46,
      "end_seconds": 183.44,
      "duration_seconds": 3.98,
      "text": "Apple, table, penny. Got it. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.06,
      "end_seconds": 192.47,
      "duration_seconds": 7.41,
      "text": "Now, can you tell me today's date and where we are? ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.01,
      "end_seconds": 203.1,
      "duration_seconds": 9.09,
      "text": "Wednesday, the, er, fourteenth? And this is the medical centre on Station Street. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.93,
      "end_seconds": 212.11,
      "duration_seconds": 6.18,
      "text": "Close. It's the fifteenth. And now, the three words? ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.54,
      "end_seconds": 220.82,
      "duration_seconds": 6.28,
      "text": "Apple. Table. And, er, what's the third, a coin... penny? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.2,
      "end_seconds": 235.44,
      "duration_seconds": 12.24,
      "text": "Yes. So you recalled all three, but needed a hint for one, and you were out by one day on the date."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.97,
      "end_seconds": 239.69,
      "duration_seconds": 2.72,
      "text": "Is that bad? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.35,
      "end_seconds": 250.3,
      "duration_seconds": 8.95,
      "text": "It's not alarming, but I'd like to look further. Any trouble with your balance, or weakness?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.1,
      "end_seconds": 254.52,
      "duration_seconds": 2.42,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.4,
      "end_seconds": 269.82,
      "duration_seconds": 14.42,
      "text": "Here's what I'm thinking. It could be nothing more than stress or poor sleep, but I can't rule out the early stages of a memory problem."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.41,
      "end_seconds": 273.26,
      "duration_seconds": 1.85,
      "text": "Alzheimer's? ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.05,
      "end_seconds": 285.94,
      "duration_seconds": 11.89,
      "text": "I'm not saying that. It's early days. I'd like to arrange blood tests, including vitamin B12 and thyroid, since both can affect memory."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.23,
      "end_seconds": 289.82,
      "duration_seconds": 1.59,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.93,
      "end_seconds": 298.99,
      "duration_seconds": 8.06,
      "text": "And I'd like to arrange a proper memory assessment at the memory clinic."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.79,
      "end_seconds": 303.09,
      "duration_seconds": 3.3,
      "text": "How long's the wait? ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.56,
      "end_seconds": 314.34,
      "duration_seconds": 9.78,
      "text": "A few weeks. And I'd like to start vitamin B12, 1000 micrograms, once a day, in the meantime."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.42,
      "end_seconds": 318.32,
      "duration_seconds": 1.9,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.22,
      "end_seconds": 325.42,
      "duration_seconds": 6.2,
      "text": "Keep a notebook for the things you forget, and bring it along."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.04,
      "end_seconds": 330.43,
      "duration_seconds": 3.39,
      "text": "Kerry will love that. ~"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.56,
      "end_seconds": 335.21,
      "duration_seconds": 3.65,
      "text": "Good. That's all for now. ~"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.88,
      "end_seconds": 339.19,
      "duration_seconds": 2.31,
      "text": "Thanks, doctor. ~"
    }
  ]
}
