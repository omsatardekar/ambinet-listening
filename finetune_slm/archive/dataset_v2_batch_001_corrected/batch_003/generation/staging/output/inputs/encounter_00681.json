{
  "schema_version": "1.0",
  "encounter_id": "00681",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 1.28,
      "end_seconds": 12.68,
      "duration_seconds": 11.4,
      "text": "Mr Okonkwo, is it? I've got your discharge letter from the hospital here, and I've updated your phone number. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.46,
      "end_seconds": 32.41,
      "duration_seconds": 16.95,
      "text": "That's right, though I've told you lot three times, I'm Christopher, not Chris, but never mind. Oh, and the hospital lost my glasses, did they tell you? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 35.16,
      "end_seconds": 43.02,
      "duration_seconds": 7.86,
      "text": "I'm Nurse Ruth, Mr Okonkwo. I'll bring you through. The doctor's got your letter. ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.39,
      "end_seconds": 56.58,
      "duration_seconds": 11.19,
      "text": "Take a seat, Christopher. I'm Dr Banerjee. You were in for pneumonia, I see. How are you feeling now?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.6,
      "end_seconds": 67.68,
      "duration_seconds": 10.08,
      "text": "Better, much better, thank you. The food in there, though, honestly, a week of chicken that tasted of nothing. ~"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.64,
      "end_seconds": 73.0,
      "duration_seconds": 3.36,
      "text": "Hospital food, yes. Any cough left?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.48,
      "end_seconds": 83.27,
      "duration_seconds": 7.79,
      "text": "A little, yes, in the morning. A dry one. It's much better than it was."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.14,
      "end_seconds": 87.37,
      "duration_seconds": 2.23,
      "text": "And your energy?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.3,
      "end_seconds": 102.51,
      "duration_seconds": 12.21,
      "text": "Tired, I still get tired by three o'clock. I was at the gym four times a week and now I can barely make the shops."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.46,
      "end_seconds": 109.79,
      "duration_seconds": 5.33,
      "text": "Understandable, that takes weeks. Any fever since you came home?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.18,
      "end_seconds": 116.03,
      "duration_seconds": 3.85,
      "text": "No, no temperature, I've been checking."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.4,
      "end_seconds": 122.43,
      "duration_seconds": 4.03,
      "text": "Any breathlessness, even on the stairs?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.72,
      "end_seconds": 131.53,
      "duration_seconds": 6.81,
      "text": "Not really. A bit on the hill, but not on the stairs."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.28,
      "end_seconds": 135.33,
      "duration_seconds": 2.05,
      "text": "Any chest pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.6,
      "end_seconds": 138.95,
      "duration_seconds": 2.35,
      "text": "No, none whatsoever."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.03,
      "end_seconds": 145.53,
      "duration_seconds": 3.5,
      "text": "Are you still on antibiotics?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.63,
      "end_seconds": 159.28,
      "duration_seconds": 11.65,
      "text": "Yes, the last few days. Clarithromycin, maybe 500 mg? Twice a day. Honestly I'd have to look at the box, my daughter sorts them out."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 160.63,
      "end_seconds": 165.91,
      "duration_seconds": 5.28,
      "text": "Your letter says the course ends on Friday, Mr Okonkwo."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.87,
      "end_seconds": 171.07,
      "duration_seconds": 4.2,
      "text": "Good, finish it. And do you smoke?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.43,
      "end_seconds": 183.46,
      "duration_seconds": 11.03,
      "text": "I gave it up when I went into hospital. Twenty a day, for thirty years, and I haven't touched one since."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.4,
      "end_seconds": 191.25,
      "duration_seconds": 6.85,
      "text": "That's a big change, well done. How are you managing the cravings? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.27,
      "end_seconds": 196.81,
      "duration_seconds": 4.54,
      "text": "Terrible, honestly, but my daughter hid my lighter. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.74,
      "end_seconds": 206.72,
      "duration_seconds": 7.98,
      "text": "Keep that up. Smoking is the main thing that will help your lungs now. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.83,
      "end_seconds": 212.37,
      "duration_seconds": 4.54,
      "text": "I know. She says that every day. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 215.0,
      "end_seconds": 219.98,
      "duration_seconds": 4.98,
      "text": "Doctor, shall I book his follow-up appointment? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.36,
      "end_seconds": 233.96,
      "duration_seconds": 12.6,
      "text": "Yes please, Joy. Christopher, I'd like to arrange a repeat chest X-ray in six weeks, to be sure the pneumonia has cleared completely."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.33,
      "end_seconds": 241.48,
      "duration_seconds": 5.15,
      "text": "Six weeks. Is that normal, to repeat it? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.73,
      "end_seconds": 255.1,
      "duration_seconds": 11.37,
      "text": "Yes, in people over fifty who smoked, we always check, to make sure nothing else is hiding behind the infection. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.6,
      "end_seconds": 259.07,
      "duration_seconds": 2.47,
      "text": "I see. Right. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.39,
      "end_seconds": 269.07,
      "duration_seconds": 7.68,
      "text": "Keep drinking plenty, build up walking gradually, and rest when you need to."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.83,
      "end_seconds": 276.53,
      "duration_seconds": 5.7,
      "text": "I'll try, though the stairs at home are a trial. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.43,
      "end_seconds": 284.97,
      "duration_seconds": 6.54,
      "text": "And I'd like to see you again in six weeks with the X-ray."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 287.09,
      "end_seconds": 295.12,
      "duration_seconds": 8.03,
      "text": "I'll put it in for you, Mr Okonkwo, after you've seen the nurse. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.23,
      "end_seconds": 305.99,
      "duration_seconds": 8.76,
      "text": "Thank you all. And if you find my glasses, tell the hospital they're brown. ~"
    }
  ]
}
