{
  "schema_version": "1.0",
  "encounter_id": "00678",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 0.61,
      "end_seconds": 12.34,
      "duration_seconds": 11.73,
      "text": "Doctor, Mr Hale, hives on and off for a fortnight. I've done his obs. Temperature 36.8, pulse 80, blood pressure 124 over 76."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.2,
      "end_seconds": 18.94,
      "duration_seconds": 5.74,
      "text": "Can we crack on? I've got a shift at six. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.72,
      "end_seconds": 27.62,
      "duration_seconds": 6.9,
      "text": "We'll be as quick as we can. Tell me about the hives."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.11,
      "end_seconds": 41.32,
      "duration_seconds": 12.21,
      "text": "Big red lumps, wherever. Arms, back, thighs. They itch like mad, last a few hours, then go, and come back somewhere else."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.68,
      "end_seconds": 47.1,
      "duration_seconds": 4.42,
      "text": "How long has it been going on?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.16,
      "end_seconds": 51.99,
      "duration_seconds": 3.83,
      "text": "Two weeks. Maybe a bit more."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.91,
      "end_seconds": 58.02,
      "duration_seconds": 5.11,
      "text": "Any swelling of your lips or tongue, or your face?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.9,
      "end_seconds": 60.81,
      "duration_seconds": 1.91,
      "text": "No. Never."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.62,
      "end_seconds": 66.18,
      "duration_seconds": 3.56,
      "text": "Any difficulty breathing, or wheeze?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.97,
      "end_seconds": 75.66,
      "duration_seconds": 6.69,
      "text": "No, nothing like that. I'd be in A and E if that happened."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.0,
      "end_seconds": 82.38,
      "duration_seconds": 4.38,
      "text": "Any fever, or have you felt unwell?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.3,
      "end_seconds": 89.28,
      "duration_seconds": 4.98,
      "text": "No fever. I feel fine, apart from the itching."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.34,
      "end_seconds": 99.38,
      "duration_seconds": 8.04,
      "text": "Have you changed anything recently, new soap, washing powder, food, medicines, a new job? ~"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.76,
      "end_seconds": 109.56,
      "duration_seconds": 8.8,
      "text": "Nothing that I know of. I started doing nights at the bar last month, but that's it."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.13,
      "end_seconds": 116.66,
      "duration_seconds": 4.53,
      "text": "What's the bar? Anything you handle that's new? ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.21,
      "end_seconds": 124.86,
      "duration_seconds": 6.65,
      "text": "Lemons, limes, loads of them. I'm cutting them all night. ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.86,
      "end_seconds": 134.45,
      "duration_seconds": 8.59,
      "text": "That's worth noting. Does anyone in your family get skin things or hay fever?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.79,
      "end_seconds": 139.06,
      "duration_seconds": 3.27,
      "text": "My mum gets hay fever. Bad."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.9,
      "end_seconds": 146.38,
      "duration_seconds": 4.48,
      "text": "And do you drink at work, or after?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.76,
      "end_seconds": 153.66,
      "duration_seconds": 4.9,
      "text": "A couple of pints after the shift."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 155.49,
      "end_seconds": 159.46,
      "duration_seconds": 3.97,
      "text": "Doctor, shall I check his chest? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.84,
      "end_seconds": 165.12,
      "duration_seconds": 3.28,
      "text": "Please, Sam. And his arms. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 178.26,
      "end_seconds": 181.33,
      "duration_seconds": 3.07,
      "text": "Chest is clear, no wheeze."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.53,
      "end_seconds": 196.33,
      "duration_seconds": 12.8,
      "text": "Thanks. There are raised red wheals on his forearms and upper back, some joining up, and no swelling of the lips or tongue."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.55,
      "end_seconds": 201.09,
      "duration_seconds": 3.54,
      "text": "What are they, then? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.56,
      "end_seconds": 209.71,
      "duration_seconds": 7.15,
      "text": "What you describe, itchy raised weals that come and go, is typical of urticaria, hives."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.37,
      "end_seconds": 216.49,
      "duration_seconds": 4.12,
      "text": "Great. Can you stop them? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.66,
      "end_seconds": 228.14,
      "duration_seconds": 9.48,
      "text": "I'm going to start you on cetirizine, 10 mg once a day, taken at night. It blocks the itch."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.34,
      "end_seconds": 232.61,
      "duration_seconds": 3.27,
      "text": "Will it make me sleepy? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.01,
      "end_seconds": 243.34,
      "duration_seconds": 9.33,
      "text": "A bit, perhaps, but it's better at night, and see how you go before a shift. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.54,
      "end_seconds": 247.58,
      "duration_seconds": 2.04,
      "text": "Fine. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.85,
      "end_seconds": 260.61,
      "duration_seconds": 10.76,
      "text": "I'd also like to arrange a blood test, to look for anything underlying, like thyroid or infection."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.98,
      "end_seconds": 264.35,
      "duration_seconds": 2.37,
      "text": "Is that necessary? ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.36,
      "end_seconds": 270.38,
      "duration_seconds": 5.02,
      "text": "With two weeks of hives, yes, it's sensible. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.82,
      "end_seconds": 277.1,
      "duration_seconds": 4.28,
      "text": "Okay, fine, I'll get it done tomorrow. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.04,
      "end_seconds": 286.79,
      "duration_seconds": 6.75,
      "text": "Try not to scratch, keep cool, and wear gloves when you cut the fruit."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.79,
      "end_seconds": 291.83,
      "duration_seconds": 2.04,
      "text": "Gloves. Cheers. ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.2,
      "end_seconds": 301.29,
      "duration_seconds": 8.09,
      "text": "If your lips or tongue swell, or you get difficulty breathing, call 999 immediately."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.88,
      "end_seconds": 305.99,
      "duration_seconds": 2.11,
      "text": "I will. ~"
    }
  ]
}
