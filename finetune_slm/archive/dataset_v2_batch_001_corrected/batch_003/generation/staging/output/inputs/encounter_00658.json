{
  "schema_version": "1.0",
  "encounter_id": "00658",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.17,
      "end_seconds": 16.01,
      "duration_seconds": 14.84,
      "text": "Hi. Um, thanks for seeing me. I'm still getting this ache in my lower tummy, even after the treatment, and I wasn't sure if that's normal."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.9,
      "end_seconds": 27.0,
      "duration_seconds": 10.1,
      "text": "No, you did the right thing coming back. Remind me, how long since we started the treatment? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.28,
      "end_seconds": 34.64,
      "duration_seconds": 5.36,
      "text": "Two weeks. I've nearly finished the course. ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.62,
      "end_seconds": 39.1,
      "duration_seconds": 3.48,
      "text": "And the ache, where exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.48,
      "end_seconds": 53.53,
      "duration_seconds": 13.05,
      "text": "Low down, in the middle and a bit on the right. A dull ache, mostly. It's better than it was, but it's not gone."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.77,
      "end_seconds": 62.02,
      "duration_seconds": 7.25,
      "text": "Good, that's an improvement. Have you had any fever since the first week?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.82,
      "end_seconds": 69.67,
      "duration_seconds": 5.85,
      "text": "No. The fever went after about three days. Nothing since."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.92,
      "end_seconds": 72.71,
      "duration_seconds": 1.79,
      "text": "Any discharge?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.25,
      "end_seconds": 78.36,
      "duration_seconds": 3.11,
      "text": "Not now, no. That's stopped."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.28,
      "end_seconds": 84.69,
      "duration_seconds": 4.41,
      "text": "And any burning when you pass urine?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.24,
      "end_seconds": 89.73,
      "duration_seconds": 2.49,
      "text": "No, none of that."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.83,
      "end_seconds": 96.98,
      "duration_seconds": 6.15,
      "text": "Let's check what you're taking, to make sure it all matches."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.93,
      "end_seconds": 112.07,
      "duration_seconds": 12.14,
      "text": "Doxycycline, 100 mg twice a day, and metronidazole, 400 mg twice a day. And ibuprofen, 400 mg when it's really bad."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.95,
      "end_seconds": 121.24,
      "duration_seconds": 6.29,
      "text": "Good. Any trouble with the tablets, sickness, upset stomach? ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.01,
      "end_seconds": 133.38,
      "duration_seconds": 9.37,
      "text": "A bit queasy with the metronidazole, but I take it with food and that helps. ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.21,
      "end_seconds": 138.21,
      "duration_seconds": 3.0,
      "text": "Right. Any allergies to medicines?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.5,
      "end_seconds": 143.45,
      "duration_seconds": 3.95,
      "text": "No allergies that I know of."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.3,
      "end_seconds": 152.45,
      "duration_seconds": 6.15,
      "text": "And is there anything on your record I should be aware of?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.01,
      "end_seconds": 157.96,
      "duration_seconds": 2.95,
      "text": "Endometriosis, diagnosed three years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.23,
      "end_seconds": 163.23,
      "duration_seconds": 3.0,
      "text": "And do you smoke?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.81,
      "end_seconds": 173.0,
      "duration_seconds": 7.19,
      "text": "I smoke about five a day, I've been meaning to cut down."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.39,
      "end_seconds": 182.72,
      "duration_seconds": 7.33,
      "text": "We can talk about that another time. Your temperature and pulse, please. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.91,
      "end_seconds": 185.58,
      "duration_seconds": 1.67,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.41,
      "end_seconds": 201.24,
      "duration_seconds": 2.83,
      "text": "Temperature 36.8, pulse 76."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.36,
      "end_seconds": 206.8,
      "duration_seconds": 3.44,
      "text": "That's good, isn't it? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.43,
      "end_seconds": 214.07,
      "duration_seconds": 4.64,
      "text": "Very good. No fever, nothing worrying there. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.44,
      "end_seconds": 221.58,
      "duration_seconds": 5.14,
      "text": "So what's the ache, if the infection's going? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.96,
      "end_seconds": 233.81,
      "duration_seconds": 10.85,
      "text": "It could be the last of the inflammation settling, but I can't rule out an ovarian cyst, especially with your history of endometriosis."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.57,
      "end_seconds": 239.85,
      "duration_seconds": 3.28,
      "text": "Oh. Is that serious? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.57,
      "end_seconds": 250.99,
      "duration_seconds": 10.42,
      "text": "Usually not. Many cysts are harmless and settle by themselves. But I'd like to keep an eye on it. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.75,
      "end_seconds": 254.92,
      "duration_seconds": 3.17,
      "text": "What should I do? ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.87,
      "end_seconds": 268.72,
      "duration_seconds": 10.85,
      "text": "Finish both courses, even if you feel better, and take the ibuprofen with food only when you need it."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.14,
      "end_seconds": 275.9,
      "duration_seconds": 4.76,
      "text": "Okay. And what if the ache doesn't go? ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.77,
      "end_seconds": 283.53,
      "duration_seconds": 6.76,
      "text": "If it's still there in two weeks, I'll arrange a pelvic ultrasound."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.38,
      "end_seconds": 286.01,
      "duration_seconds": 1.63,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.6,
      "end_seconds": 295.22,
      "duration_seconds": 7.62,
      "text": "And I'd like to see you again in two weeks anyway, either way."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.34,
      "end_seconds": 301.07,
      "duration_seconds": 3.73,
      "text": "Two weeks. Okay. Thank you. ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.1,
      "end_seconds": 312.43,
      "duration_seconds": 10.33,
      "text": "Take care. Come back sooner if the pain suddenly gets worse or you get a temperature."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.39,
      "end_seconds": 315.41,
      "duration_seconds": 2.02,
      "text": "I will. ~"
    }
  ]
}
