{
  "schema_version": "1.0",
  "encounter_id": "00844",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 0.88,
      "end_seconds": 7.74,
      "duration_seconds": 6.86,
      "text": "Good afternoon. Can I just check, it's Mrs Eleanor Whitcombe? ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.62,
      "end_seconds": 18.49,
      "duration_seconds": 7.87,
      "text": "It is, thank you, doctor. How kind of you to see me. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 20.85,
      "end_seconds": 29.73,
      "duration_seconds": 8.88,
      "text": "I'm her daughter, Fiona. And this is Callum from the home, he's helped with the transport. ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 32.55,
      "end_seconds": 39.12,
      "duration_seconds": 6.57,
      "text": "Pleased to meet you, doctor. I'll just sit at the back. ~"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.95,
      "end_seconds": 48.29,
      "duration_seconds": 8.34,
      "text": "Welcome. Mrs Whitcombe, Fiona tells me you're feeling low since the move. Is that right?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.98,
      "end_seconds": 64.95,
      "duration_seconds": 13.97,
      "text": "I suppose I am. I don't like to complain. I've felt rather low since I moved into the home, about six weeks ago."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.89,
      "end_seconds": 70.87,
      "duration_seconds": 2.98,
      "text": "How has it affected you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.14,
      "end_seconds": 83.01,
      "duration_seconds": 10.87,
      "text": "I've lost interest in my knitting, which I've done all my life. I sit and look at the wool."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 85.84,
      "end_seconds": 91.63,
      "duration_seconds": 5.79,
      "text": "She's also awake at four every morning, Mum, you told me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.5,
      "end_seconds": 102.62,
      "duration_seconds": 10.12,
      "text": "Yes, I wake at four and can't get back to sleep. I lie there listening to the corridor."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.68,
      "end_seconds": 107.7,
      "duration_seconds": 4.02,
      "text": "Any thoughts of ending your life?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.81,
      "end_seconds": 111.8,
      "duration_seconds": 1.99,
      "text": "Goodness, no. Never."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.15,
      "end_seconds": 116.34,
      "duration_seconds": 3.19,
      "text": "Any falls since the move?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.2,
      "end_seconds": 122.5,
      "duration_seconds": 4.3,
      "text": "No falls. The staff are very careful."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.33,
      "end_seconds": 127.25,
      "duration_seconds": 2.92,
      "text": "Any new aches or pains?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.24,
      "end_seconds": 130.0,
      "duration_seconds": 1.76,
      "text": "Nothing new."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.52,
      "end_seconds": 137.35,
      "duration_seconds": 4.83,
      "text": "Fiona, can you tell me her tablets?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 139.48,
      "end_seconds": 151.94,
      "duration_seconds": 12.46,
      "text": "Amlodipine, 5 mg, once a day. Simvastatin, 20 mg, at night. Levothyroxine, 50 micrograms, in the morning. And paracetamol, 500 mg, when she needs it."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.06,
      "end_seconds": 156.64,
      "duration_seconds": 2.58,
      "text": "Thank you. Any allergies?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.06,
      "end_seconds": 162.32,
      "duration_seconds": 4.26,
      "text": "Codeine. It made me quite confused."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.65,
      "end_seconds": 165.54,
      "duration_seconds": 1.89,
      "text": "Medical history?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.38,
      "end_seconds": 170.48,
      "duration_seconds": 4.1,
      "text": "An underactive thyroid, high blood pressure, and arthritis."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.16,
      "end_seconds": 174.18,
      "duration_seconds": 1.02,
      "text": "Operations?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.44,
      "end_seconds": 180.09,
      "duration_seconds": 3.65,
      "text": "A hip replacement, in 2018."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.31,
      "end_seconds": 186.35,
      "duration_seconds": 4.04,
      "text": "Any family history of low mood?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.39,
      "end_seconds": 193.18,
      "duration_seconds": 4.79,
      "text": "My sister was treated for depression, many years ago."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.09,
      "end_seconds": 198.95,
      "duration_seconds": 2.86,
      "text": "Where were you living before?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.06,
      "end_seconds": 213.5,
      "duration_seconds": 12.44,
      "text": "In our own house for fifty years, until my husband passed and the stairs became too much. I moved into assisted living, you see."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.39,
      "end_seconds": 219.51,
      "duration_seconds": 3.12,
      "text": "And your work, before that?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.42,
      "end_seconds": 224.87,
      "duration_seconds": 4.45,
      "text": "I taught infants for thirty-five years. Retired."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.18,
      "end_seconds": 231.26,
      "duration_seconds": 4.08,
      "text": "Do you get out and about?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.17,
      "end_seconds": 237.67,
      "duration_seconds": 5.5,
      "text": "I walk in the garden, when it's dry."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.56,
      "end_seconds": 240.87,
      "duration_seconds": 2.31,
      "text": "And any company?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.85,
      "end_seconds": 249.54,
      "duration_seconds": 5.69,
      "text": "Bridge on Thursdays, though I haven't gone these last weeks."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.94,
      "end_seconds": 277.98,
      "duration_seconds": 12.04,
      "text": "Let me check you. Pulse 68, blood pressure 130 over 76, temperature 36.4, oxygen 97 percent, breathing 14, and weight 58 kilos."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 279.86,
      "end_seconds": 283.92,
      "duration_seconds": 4.06,
      "text": "She's lost a bit, hasn't she? ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.67,
      "end_seconds": 301.15,
      "duration_seconds": 7.48,
      "text": "A little. Let me look at you, Mrs Whitcombe. You look tearful."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.13,
      "end_seconds": 306.91,
      "duration_seconds": 2.78,
      "text": "I'm sorry, dear. ~"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.9,
      "end_seconds": 318.72,
      "duration_seconds": 8.82,
      "text": "Your speech is a little slow, and you were slow to answer, but your thinking is clear."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.96,
      "end_seconds": 323.31,
      "duration_seconds": 3.35,
      "text": "Is that all right? ~"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.62,
      "end_seconds": 328.63,
      "duration_seconds": 3.01,
      "text": "Your heart sounds are normal."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.25,
      "end_seconds": 332.28,
      "duration_seconds": 2.03,
      "text": "Good. ~"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.45,
      "end_seconds": 336.13,
      "duration_seconds": 2.68,
      "text": "Any trouble with your breathing?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.44,
      "end_seconds": 341.79,
      "duration_seconds": 4.35,
      "text": "No, nothing, I'm fine in that way."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.07,
      "end_seconds": 352.91,
      "duration_seconds": 9.84,
      "text": "This could well be an adjustment reaction to the move, but I can't rule out depression."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 355.44,
      "end_seconds": 358.98,
      "duration_seconds": 3.54,
      "text": "What do we do? ~"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.16,
      "end_seconds": 374.03,
      "duration_seconds": 12.87,
      "text": "I'd like to arrange blood tests for thyroid and vitamin B12, since low levels can cause this, and a urine test."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 375.84,
      "end_seconds": 382.79,
      "duration_seconds": 6.95,
      "text": "I can bring her for the blood test on Tuesday. ~"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 385.68,
      "end_seconds": 393.25,
      "duration_seconds": 7.57,
      "text": "Thank you, Callum. Also, Mrs Whitcombe, please go back to bridge on Thursday."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 394.72,
      "end_seconds": 397.87,
      "duration_seconds": 3.15,
      "text": "I will try. ~"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 399.29,
      "end_seconds": 405.12,
      "duration_seconds": 5.83,
      "text": "I'd like to see you again in four weeks."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 407.69,
      "end_seconds": 411.21,
      "duration_seconds": 3.52,
      "text": "Four weeks. We'll book it. ~"
    }
  ]
}
