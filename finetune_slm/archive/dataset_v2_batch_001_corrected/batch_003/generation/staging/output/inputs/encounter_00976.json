{
  "schema_version": "1.0",
  "encounter_id": "00976",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.19,
      "end_seconds": 12.82,
      "duration_seconds": 11.63,
      "text": "Good morning, doctor. I'm afraid I have a rather embarrassing problem. I've been noticing bright red blood when I wipe, for about three weeks."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.38,
      "end_seconds": 27.3,
      "duration_seconds": 12.92,
      "text": "Thank you for telling me, it's very common. Is the blood on the paper, in the toilet bowl, or mixed in the stool?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.16,
      "end_seconds": 36.58,
      "duration_seconds": 7.42,
      "text": "On the paper, mainly. And a few spots in the bowl. ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.34,
      "end_seconds": 42.08,
      "duration_seconds": 2.74,
      "text": "Is there any itching?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.45,
      "end_seconds": 49.85,
      "duration_seconds": 6.4,
      "text": "Yes, quite a lot of itching, and a sort of soreness."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.1,
      "end_seconds": 54.29,
      "duration_seconds": 3.19,
      "text": "Have you noticed a lump?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.06,
      "end_seconds": 63.01,
      "duration_seconds": 6.95,
      "text": "A small lump, just outside, that I can feel when I wash."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.33,
      "end_seconds": 68.68,
      "duration_seconds": 4.35,
      "text": "Does it hurt to pass a stool?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.52,
      "end_seconds": 73.88,
      "duration_seconds": 4.36,
      "text": "Yes, a sharp pain, especially when I'm constipated."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.19,
      "end_seconds": 81.88,
      "duration_seconds": 6.69,
      "text": "Now, some questions to rule out other things. Any weight loss?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.88,
      "end_seconds": 86.12,
      "duration_seconds": 3.24,
      "text": "No, my weight is stable."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.86,
      "end_seconds": 96.83,
      "duration_seconds": 8.97,
      "text": "Any change in your bowel habit, looser or harder than usual, for more than a few weeks?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.62,
      "end_seconds": 103.65,
      "duration_seconds": 5.03,
      "text": "No change, other than the constipation I've always had."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.03,
      "end_seconds": 107.39,
      "duration_seconds": 2.36,
      "text": "Any black stools?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.91,
      "end_seconds": 111.58,
      "duration_seconds": 2.67,
      "text": "No. They're a normal brown."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.56,
      "end_seconds": 115.51,
      "duration_seconds": 1.95,
      "text": "Any mucus?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.5,
      "end_seconds": 120.35,
      "duration_seconds": 1.85,
      "text": "No mucus."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.02,
      "end_seconds": 125.19,
      "duration_seconds": 3.17,
      "text": "Any pain in the abdomen?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.35,
      "end_seconds": 130.65,
      "duration_seconds": 3.3,
      "text": "No pain in my tummy."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.81,
      "end_seconds": 134.35,
      "duration_seconds": 2.54,
      "text": "Any allergies to medicines?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.58,
      "end_seconds": 139.77,
      "duration_seconds": 3.19,
      "text": "Penicillin. I developed a rash."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.58,
      "end_seconds": 142.21,
      "duration_seconds": 1.63,
      "text": "Medical history?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.76,
      "end_seconds": 148.53,
      "duration_seconds": 3.77,
      "text": "Chronic constipation, and irritable bowel syndrome."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.61,
      "end_seconds": 151.67,
      "duration_seconds": 2.06,
      "text": "Any operations?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.38,
      "end_seconds": 156.24,
      "duration_seconds": 2.86,
      "text": "My tonsils, as a child."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.22,
      "end_seconds": 161.53,
      "duration_seconds": 3.31,
      "text": "Bowel problems in the family?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.99,
      "end_seconds": 169.23,
      "duration_seconds": 6.24,
      "text": "My father had bowel cancer, in his seventies. My mother has haemorrhoids."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.23,
      "end_seconds": 172.15,
      "duration_seconds": 1.92,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.92,
      "end_seconds": 175.07,
      "duration_seconds": 2.15,
      "text": "I've never smoked."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.79,
      "end_seconds": 179.09,
      "duration_seconds": 1.3,
      "text": "Alcohol?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.19,
      "end_seconds": 185.69,
      "duration_seconds": 4.5,
      "text": "Two glasses of wine at the weekend."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.5,
      "end_seconds": 191.36,
      "duration_seconds": 3.86,
      "text": "What do you do for a living?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.89,
      "end_seconds": 199.0,
      "duration_seconds": 5.11,
      "text": "I'm a lorry driver, so I sit all day."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.01,
      "end_seconds": 203.35,
      "duration_seconds": 2.34,
      "text": "And your diet?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.51,
      "end_seconds": 208.64,
      "duration_seconds": 4.13,
      "text": "Not much fibre, I'm afraid. Sandwiches, mostly."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.2,
      "end_seconds": 227.03,
      "duration_seconds": 6.83,
      "text": "Let me take two numbers. Blood pressure 134 over 82, pulse 72."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.55,
      "end_seconds": 230.59,
      "duration_seconds": 2.04,
      "text": "That's fine? ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.03,
      "end_seconds": 259.51,
      "duration_seconds": 6.48,
      "text": "Fine. I'll examine you now. Lie on your left side, knees to chest."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.42,
      "end_seconds": 263.51,
      "duration_seconds": 2.09,
      "text": "Like this? ~"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.4,
      "end_seconds": 274.49,
      "duration_seconds": 8.09,
      "text": "I can see a small swelling at the edge of the back passage, soft, a little tender."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.27,
      "end_seconds": 279.3,
      "duration_seconds": 3.03,
      "text": "That's the lump. ~"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.17,
      "end_seconds": 288.58,
      "duration_seconds": 6.41,
      "text": "And the internal examination shows a soft swelling inside, with no hard mass."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.32,
      "end_seconds": 294.56,
      "duration_seconds": 4.24,
      "text": "Does that mean it's not cancer? ~"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.8,
      "end_seconds": 307.43,
      "duration_seconds": 10.63,
      "text": "It's reassuring, but with your father's history I want to be thorough. Any trouble with your waterworks?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.23,
      "end_seconds": 313.28,
      "duration_seconds": 3.05,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.97,
      "end_seconds": 327.75,
      "duration_seconds": 11.78,
      "text": "What I think this is, is piles, haemorrhoids. But I can't rule out a small tear, a fissure, as part of the pain."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.11,
      "end_seconds": 333.14,
      "duration_seconds": 4.03,
      "text": "What can I do about it? ~"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.11,
      "end_seconds": 342.01,
      "duration_seconds": 6.9,
      "text": "First, soften the stool. I'd like to start lactulose, 15 ml, twice a day."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.44,
      "end_seconds": 346.19,
      "duration_seconds": 1.75,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.42,
      "end_seconds": 358.14,
      "duration_seconds": 9.72,
      "text": "And I'd like to start hydrocortisone cream, twice a day, applied after you wash, for a week."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 360.94,
      "end_seconds": 363.59,
      "duration_seconds": 2.65,
      "text": "Is it messy? ~"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.6,
      "end_seconds": 367.62,
      "duration_seconds": 2.02,
      "text": "A little. ~"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 368.39,
      "end_seconds": 370.29,
      "duration_seconds": 1.9,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 372.68,
      "end_seconds": 380.87,
      "duration_seconds": 8.19,
      "text": "And because of your father, I'd like to arrange a colonoscopy, and a blood count."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 382.49,
      "end_seconds": 384.36,
      "duration_seconds": 1.87,
      "text": "A colonoscopy? ~"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 386.16,
      "end_seconds": 400.57,
      "duration_seconds": 14.41,
      "text": "A camera test of the bowel. It's precautionary. I'd also like you to eat more fibre, oats, fruit, vegetables, and drink plenty of water."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 401.8,
      "end_seconds": 405.05,
      "duration_seconds": 3.25,
      "text": "I'll make an effort. ~"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 406.73,
      "end_seconds": 411.63,
      "duration_seconds": 4.9,
      "text": "I'd like to see you again in six weeks."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 412.81,
      "end_seconds": 417.16,
      "duration_seconds": 4.35,
      "text": "Six weeks. Thank you, doctor. ~"
    }
  ]
}
