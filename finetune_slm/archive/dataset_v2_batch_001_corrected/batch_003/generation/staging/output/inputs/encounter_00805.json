{
  "schema_version": "1.0",
  "encounter_id": "00805",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.23,
      "end_seconds": 16.13,
      "duration_seconds": 14.9,
      "text": "Hello. I've been told my potassium's high, after the new tablet, and to come and see you. I'm trying to remember what the new tablet is."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.69,
      "end_seconds": 22.51,
      "duration_seconds": 4.82,
      "text": "Let's go through your medicines. What's the new one?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.24,
      "end_seconds": 34.57,
      "duration_seconds": 9.33,
      "text": "Ramipril, 2.5 mg, once a day. It's for my kidneys. And the old one is the amlodipine, 5 mg."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.49,
      "end_seconds": 42.63,
      "duration_seconds": 5.14,
      "text": "How have you been since starting the ramipril?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.85,
      "end_seconds": 54.33,
      "duration_seconds": 8.48,
      "text": "Tired. And my legs are a bit weak, and my heart skips. Not often."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.87,
      "end_seconds": 61.01,
      "duration_seconds": 4.14,
      "text": "When did you start it? ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.65,
      "end_seconds": 66.59,
      "duration_seconds": 3.94,
      "text": "Three weeks ago. Or four. ~"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.25,
      "end_seconds": 73.8,
      "duration_seconds": 5.55,
      "text": "Any muscle weakness, tingling, or palpitations that scare you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.61,
      "end_seconds": 79.65,
      "duration_seconds": 3.04,
      "text": "No, nothing frightening. No tingling."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.79,
      "end_seconds": 87.18,
      "duration_seconds": 4.39,
      "text": "Any vomiting, or diarrhoea, any fluid loss?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.59,
      "end_seconds": 91.02,
      "duration_seconds": 1.43,
      "text": "No."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.26,
      "end_seconds": 96.57,
      "duration_seconds": 3.31,
      "text": "Remind me of your health background."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.17,
      "end_seconds": 102.96,
      "duration_seconds": 4.79,
      "text": "Chronic kidney disease, diabetes, and high blood pressure."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.43,
      "end_seconds": 110.3,
      "duration_seconds": 5.87,
      "text": "Do you take any supplements, salt substitute, or anti-inflammatory painkillers? ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.17,
      "end_seconds": 123.33,
      "duration_seconds": 11.16,
      "text": "I use a low-salt substitute, because of my blood pressure. And ibuprofen, now and then, for my back. ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.23,
      "end_seconds": 135.26,
      "duration_seconds": 10.03,
      "text": "That's important. Salt substitutes contain potassium, and ibuprofen can harm the kidneys. Let me check you. Pulse, pressure. ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.27,
      "end_seconds": 140.12,
      "duration_seconds": 1.85,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.11,
      "end_seconds": 161.74,
      "duration_seconds": 8.63,
      "text": "Pulse 66 and regular, blood pressure 132 over 78, temperature 36.6, oxygen 98 percent."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.13,
      "end_seconds": 167.0,
      "duration_seconds": 1.87,
      "text": "Fine? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.01,
      "end_seconds": 172.93,
      "duration_seconds": 3.92,
      "text": "Fine. Any breathlessness or chest tightness?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.62,
      "end_seconds": 177.58,
      "duration_seconds": 1.96,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.15,
      "end_seconds": 203.98,
      "duration_seconds": 23.83,
      "text": "Your potassium was 5.9, and normal is up to 5.0. It's likely the ramipril, plus the salt substitute, on top of kidney disease. I'd say this is a raised potassium caused by the new tablet and the salt substitute."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.54,
      "end_seconds": 208.15,
      "duration_seconds": 2.61,
      "text": "Is it dangerous? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.23,
      "end_seconds": 225.22,
      "duration_seconds": 13.99,
      "text": "At 5.9, it needs attention. Above 6.5 it can affect the heart. So I'd like to stop the salt substitute straight away, and avoid the ibuprofen completely."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.26,
      "end_seconds": 231.04,
      "duration_seconds": 2.78,
      "text": "I'll throw it out. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.4,
      "end_seconds": 243.0,
      "duration_seconds": 8.6,
      "text": "And I'm going to ask you to stop the ramipril for now, until we recheck the potassium."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.72,
      "end_seconds": 247.12,
      "duration_seconds": 1.4,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.26,
      "end_seconds": 257.07,
      "duration_seconds": 6.81,
      "text": "I'll have the nurse take a repeat blood test today."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.22,
      "end_seconds": 261.29,
      "duration_seconds": 2.07,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.56,
      "end_seconds": 270.89,
      "duration_seconds": 7.33,
      "text": "Eat a normal diet, but go easy on bananas, oranges and potatoes for now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.0,
      "end_seconds": 277.72,
      "duration_seconds": 4.72,
      "text": "I eat a banana every day. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.07,
      "end_seconds": 285.21,
      "duration_seconds": 4.14,
      "text": "Leave it a few days. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.7,
      "end_seconds": 289.47,
      "duration_seconds": 1.77,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.68,
      "end_seconds": 299.56,
      "duration_seconds": 7.88,
      "text": "I'd like to see you again in a week, with the result and a plan."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.28,
      "end_seconds": 305.99,
      "duration_seconds": 3.71,
      "text": "A week. Thank you. ~"
    }
  ]
}
