{
  "schema_version": "1.0",
  "encounter_id": "00889",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 2.23,
      "end_seconds": 19.57,
      "duration_seconds": 17.34,
      "text": "I'm back about my heel, doctor. I'm a nurse, and the long shifts are killing my feet, so I'm hoping the treatment is working but it's not quite there."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.75,
      "end_seconds": 30.61,
      "duration_seconds": 7.86,
      "text": "Good to see you again. Let's review. How is the heel pain compared with last time?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.05,
      "end_seconds": 39.36,
      "duration_seconds": 6.31,
      "text": "A bit better, but the first steps in the morning are still awful."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.29,
      "end_seconds": 46.75,
      "duration_seconds": 4.46,
      "text": "How about by the end of a shift?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.32,
      "end_seconds": 55.87,
      "duration_seconds": 6.55,
      "text": "Throbbing along the bottom of the foot. By the evening I'm limping."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.18,
      "end_seconds": 62.44,
      "duration_seconds": 3.26,
      "text": "Any numbness, tingling or swelling?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.33,
      "end_seconds": 71.04,
      "duration_seconds": 5.71,
      "text": "No numbness, no tingling. No swelling that I've seen."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.97,
      "end_seconds": 78.41,
      "duration_seconds": 5.44,
      "text": "What have you been using since the last visit?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.67,
      "end_seconds": 88.69,
      "duration_seconds": 8.02,
      "text": "The ibuprofen gel, three times a day, and I've been doing the stretches."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.4,
      "end_seconds": 95.4,
      "duration_seconds": 4.0,
      "text": "Good. And the insoles I recommended?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.06,
      "end_seconds": 107.5,
      "duration_seconds": 8.44,
      "text": "I haven't got them yet. I didn't have the time. I'll order them."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.51,
      "end_seconds": 112.3,
      "duration_seconds": 2.79,
      "text": "Any other medical conditions?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.15,
      "end_seconds": 125.72,
      "duration_seconds": 10.57,
      "text": "Not much. I had a stress fracture in my foot when I was twenty. And my knees ache sometimes."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.15,
      "end_seconds": 129.56,
      "duration_seconds": 1.41,
      "text": "Any surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.23,
      "end_seconds": 138.49,
      "duration_seconds": 5.26,
      "text": "Only my appendix, years ago, when I was fourteen."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.11,
      "end_seconds": 146.9,
      "duration_seconds": 4.79,
      "text": "Let me check your pulse and temperature first. ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.81,
      "end_seconds": 160.03,
      "duration_seconds": 1.22,
      "text": "Fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.59,
      "end_seconds": 165.15,
      "duration_seconds": 2.56,
      "text": "Pulse 70, temperature 36.6."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.52,
      "end_seconds": 169.89,
      "duration_seconds": 1.37,
      "text": "Great. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.88,
      "end_seconds": 178.88,
      "duration_seconds": 7.0,
      "text": "Please take off your shoe. I'm going to press along the heel. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.17,
      "end_seconds": 196.47,
      "duration_seconds": 2.3,
      "text": "Careful, it's sore."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.3,
      "end_seconds": 206.29,
      "duration_seconds": 7.99,
      "text": "There's tenderness at the inner part of the heel bone, and the arch looks quite flat."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.98,
      "end_seconds": 213.63,
      "duration_seconds": 4.65,
      "text": "So the stretches haven't fixed it? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.86,
      "end_seconds": 223.2,
      "duration_seconds": 6.34,
      "text": "They help, but it takes weeks. This remains plantar fasciitis."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.78,
      "end_seconds": 231.82,
      "duration_seconds": 5.04,
      "text": "How long will it take to go? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.0,
      "end_seconds": 240.62,
      "duration_seconds": 6.62,
      "text": "Often several months. Nobody wants to hear that, I know. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.65,
      "end_seconds": 249.24,
      "duration_seconds": 5.59,
      "text": "Not when I'm on my feet for twelve hours. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.41,
      "end_seconds": 262.67,
      "duration_seconds": 11.26,
      "text": "Please get supportive insoles, and wear cushioned shoes at work, and keep up the calf stretches before and after the shift."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.51,
      "end_seconds": 268.87,
      "duration_seconds": 4.36,
      "text": "Okay. I'll order the insoles tonight. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.02,
      "end_seconds": 282.68,
      "duration_seconds": 11.66,
      "text": "I'd also like to see you again in six weeks, and then talk about a steroid injection if it's still painful."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.12,
      "end_seconds": 289.51,
      "duration_seconds": 3.39,
      "text": "Six weeks. That's fine. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.43,
      "end_seconds": 299.76,
      "duration_seconds": 7.33,
      "text": "Make sure you rest your feet when you can, even for ten minutes. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.22,
      "end_seconds": 306.01,
      "duration_seconds": 3.79,
      "text": "I'll do my best. Thanks, doctor. ~"
    }
  ]
}
