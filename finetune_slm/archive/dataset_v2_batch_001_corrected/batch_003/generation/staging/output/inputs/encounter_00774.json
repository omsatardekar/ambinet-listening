{
  "schema_version": "1.0",
  "encounter_id": "00774",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.29,
      "end_seconds": 13.04,
      "duration_seconds": 11.75,
      "text": "Hello, doctor. It's the whiplash, from the car crash in the summer. I'm better but not right, if you know what I mean."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.73,
      "end_seconds": 19.61,
      "duration_seconds": 3.88,
      "text": "Tell me how it is now."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.41,
      "end_seconds": 33.76,
      "duration_seconds": 12.35,
      "text": "My neck's stiff, especially in the mornings, and I get a pain across my shoulders by the afternoon. Worse after driving."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.41,
      "end_seconds": 41.62,
      "duration_seconds": 5.21,
      "text": "How long is it since the accident? ~"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.73,
      "end_seconds": 51.2,
      "duration_seconds": 7.47,
      "text": "Four months. It was better at two months, then it plateaued. ~"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.33,
      "end_seconds": 58.98,
      "duration_seconds": 6.65,
      "text": "Is the pain going down your arms, any numbness or tingling?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.32,
      "end_seconds": 64.96,
      "duration_seconds": 4.64,
      "text": "No, nothing in my arms. No tingling."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.18,
      "end_seconds": 70.46,
      "duration_seconds": 4.28,
      "text": "What are you using for the pain?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.25,
      "end_seconds": 83.82,
      "duration_seconds": 11.57,
      "text": "Naproxen, 250 mg, twice a day, maybe? And paracetamol, 1 gram, but I only take that when it's bad, so not every day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.4,
      "end_seconds": 99.8,
      "duration_seconds": 13.4,
      "text": "Right. So 250 mg twice a day, as you recall it, and the paracetamol only when it's bad. Remind me of your history."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.66,
      "end_seconds": 111.92,
      "duration_seconds": 9.26,
      "text": "High blood pressure, a stomach ulcer, years ago, and my back's not great. Slipped disc."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.69,
      "end_seconds": 115.95,
      "duration_seconds": 3.26,
      "text": "Have you had any operations?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.09,
      "end_seconds": 123.26,
      "duration_seconds": 6.17,
      "text": "An operation on my lower back, a discectomy, in 2014."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.91,
      "end_seconds": 127.36,
      "duration_seconds": 2.45,
      "text": "Are you working?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.41,
      "end_seconds": 134.63,
      "duration_seconds": 5.22,
      "text": "Yes, I'm a delivery driver. Hours in the van."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.43,
      "end_seconds": 141.9,
      "duration_seconds": 5.47,
      "text": "Let me look at your neck. Sit on the couch. ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.06,
      "end_seconds": 162.27,
      "duration_seconds": 1.21,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.06,
      "end_seconds": 178.67,
      "duration_seconds": 15.61,
      "text": "Tender over the muscles on both sides of the neck, tight and knotted in the upper shoulder muscles, and the movement is limited when you look over your shoulder."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.71,
      "end_seconds": 184.04,
      "duration_seconds": 4.33,
      "text": "Is that normal for four months on? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.74,
      "end_seconds": 197.94,
      "duration_seconds": 12.2,
      "text": "It's common. Whiplash can take months to settle, and the muscles tighten and guard. I'd say this is a persisting whiplash strain."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.01,
      "end_seconds": 202.11,
      "duration_seconds": 3.1,
      "text": "Will it ever clear? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.02,
      "end_seconds": 213.21,
      "duration_seconds": 10.19,
      "text": "Most people recover, usually by six months, but you need to keep the neck moving. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.09,
      "end_seconds": 216.97,
      "duration_seconds": 2.88,
      "text": "I've been scared to. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.71,
      "end_seconds": 228.17,
      "duration_seconds": 9.46,
      "text": "I understand. Gentle exercises and physiotherapy help most. I'd like to arrange a referral for physio."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.06,
      "end_seconds": 232.67,
      "duration_seconds": 1.61,
      "text": "When? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.6,
      "end_seconds": 246.85,
      "duration_seconds": 11.25,
      "text": "A few weeks. Meanwhile, I'd like to arrange an X-ray of the neck, to be thorough, given the time that's passed."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.21,
      "end_seconds": 250.85,
      "duration_seconds": 1.64,
      "text": "Fine. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.84,
      "end_seconds": 262.78,
      "duration_seconds": 9.94,
      "text": "Also, naproxen and your old stomach ulcer don't mix well, so please always take it with food."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.08,
      "end_seconds": 269.99,
      "duration_seconds": 5.91,
      "text": "I've been taking it on an empty stomach, I'll stop. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.52,
      "end_seconds": 283.03,
      "duration_seconds": 10.51,
      "text": "Take it only with food, and if you get stomach pain, or black stools, stop it and ring us. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.58,
      "end_seconds": 288.48,
      "duration_seconds": 2.9,
      "text": "Right. Thank you. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.92,
      "end_seconds": 298.94,
      "duration_seconds": 8.02,
      "text": "Use a warm pack, and break up your driving with stops to stretch."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.86,
      "end_seconds": 304.11,
      "duration_seconds": 2.25,
      "text": "I will. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.29,
      "end_seconds": 317.43,
      "duration_seconds": 11.14,
      "text": "If the pain spreads into your arm, or you get weakness or numbness in your hands, come back that day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.19,
      "end_seconds": 322.7,
      "duration_seconds": 3.51,
      "text": "I will. Thanks, doctor. ~"
    }
  ]
}
