{
  "schema_version": "1.0",
  "encounter_id": "00821",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 1.23,
      "end_seconds": 10.66,
      "duration_seconds": 9.43,
      "text": "Mrs Tully? I'm Orla on reception. The doctor's running ten minutes late, but the nurse can take your measurements. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.62,
      "end_seconds": 23.13,
      "duration_seconds": 9.51,
      "text": "Oh, that's fine, I'm in no rush. I'm a bit vague today, I haven't slept. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 39.72,
      "end_seconds": 47.23,
      "duration_seconds": 7.51,
      "text": "I'm Rhona, the nurse. Blood pressure 130 over 80, pulse 76, oxygen 98 percent."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.65,
      "end_seconds": 56.42,
      "duration_seconds": 7.77,
      "text": "Hello, Mrs Tully. This is your health check, isn't it? Anything on your mind? ~"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.61,
      "end_seconds": 69.34,
      "duration_seconds": 11.73,
      "text": "Well, nothing really. Only I get a burning in my upper tummy, after meals. I didn't think it was worth mentioning."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.75,
      "end_seconds": 74.18,
      "duration_seconds": 3.43,
      "text": "Tell me about it. How often?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.07,
      "end_seconds": 88.22,
      "duration_seconds": 11.15,
      "text": "A few times a week. A hot, burning feeling, under my ribs. It's worse after a big meal, or tomato sauce."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.99,
      "end_seconds": 91.99,
      "duration_seconds": 3.0,
      "text": "Any vomiting, or trouble swallowing?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.85,
      "end_seconds": 95.71,
      "duration_seconds": 2.86,
      "text": "No. Nothing like that."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.48,
      "end_seconds": 102.81,
      "duration_seconds": 4.33,
      "text": "Any black stools, or weight loss? ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.59,
      "end_seconds": 109.58,
      "duration_seconds": 3.99,
      "text": "No, I've actually put weight on. ~"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.74,
      "end_seconds": 115.39,
      "duration_seconds": 4.65,
      "text": "What are you taking at the moment?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.25,
      "end_seconds": 127.23,
      "duration_seconds": 9.98,
      "text": "A blood pressure tablet, ramipril, 5 mg once a day. And a vitamin D tablet, 800 units, every morning."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.15,
      "end_seconds": 134.29,
      "duration_seconds": 4.14,
      "text": "Any conditions apart from the blood pressure?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.25,
      "end_seconds": 143.52,
      "duration_seconds": 7.27,
      "text": "High blood pressure, and I've had an underactive thyroid since the nineties."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.41,
      "end_seconds": 146.33,
      "duration_seconds": 1.92,
      "text": "Any operations?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.6,
      "end_seconds": 151.51,
      "duration_seconds": 3.91,
      "text": "My gallbladder, taken out in 2008."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.2,
      "end_seconds": 158.15,
      "duration_seconds": 4.95,
      "text": "Any family history of stomach problems or bowel cancer?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.11,
      "end_seconds": 168.01,
      "duration_seconds": 6.9,
      "text": "My mother had a stomach ulcer, and my brother had bowel polyps."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.94,
      "end_seconds": 172.65,
      "duration_seconds": 3.71,
      "text": "And do you smoke, or drink alcohol?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.35,
      "end_seconds": 179.56,
      "duration_seconds": 5.21,
      "text": "I don't smoke. A glass of wine, most evenings."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 181.64,
      "end_seconds": 187.07,
      "duration_seconds": 5.43,
      "text": "Doctor, would you like me to do her breathing check?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.22,
      "end_seconds": 191.57,
      "duration_seconds": 2.35,
      "text": "Please, Rhona, thanks. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 194.52,
      "end_seconds": 198.48,
      "duration_seconds": 3.96,
      "text": "Mrs Tully, any breathlessness or wheeze?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.82,
      "end_seconds": 203.14,
      "duration_seconds": 3.32,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 206.05,
      "end_seconds": 209.59,
      "duration_seconds": 3.54,
      "text": "Any chest pain with the burning?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.89,
      "end_seconds": 216.62,
      "duration_seconds": 5.73,
      "text": "No. It's right under the ribs, not in my chest."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.64,
      "end_seconds": 235.6,
      "duration_seconds": 2.96,
      "text": "Let me press your tummy."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.46,
      "end_seconds": 240.89,
      "duration_seconds": 3.43,
      "text": "Oh, careful, that's tender. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.21,
      "end_seconds": 250.0,
      "duration_seconds": 6.79,
      "text": "A little tender at the top, in the middle, and nothing else."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.98,
      "end_seconds": 253.94,
      "duration_seconds": 2.96,
      "text": "Is that normal? ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.75,
      "end_seconds": 272.22,
      "duration_seconds": 16.47,
      "text": "Fairly. Burning after meals is very common, and I'm not going to put a name on it today. But because of your age and your family history, I'd like to check a few things. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.9,
      "end_seconds": 277.7,
      "duration_seconds": 3.8,
      "text": "What sort of things? ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.62,
      "end_seconds": 286.29,
      "duration_seconds": 7.67,
      "text": "I'd like to arrange a breath test for the stomach bacterium, Helicobacter pylori."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 288.31,
      "end_seconds": 294.62,
      "duration_seconds": 6.31,
      "text": "I'll give you the instructions about stopping tablets, Mrs Tully. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.38,
      "end_seconds": 308.99,
      "duration_seconds": 13.61,
      "text": "Meanwhile, eat smaller meals, avoid tomato, spicy food, and coffee late in the day, and leave three hours between your last meal and bed."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.17,
      "end_seconds": 314.25,
      "duration_seconds": 4.08,
      "text": "I like my wine with dinner. ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.99,
      "end_seconds": 323.69,
      "duration_seconds": 6.7,
      "text": "It may be adding to it, so try to cut back a little."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.08,
      "end_seconds": 328.46,
      "duration_seconds": 2.38,
      "text": "I'll try. ~"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.89,
      "end_seconds": 344.15,
      "duration_seconds": 13.26,
      "text": "I'd like to see you again in four weeks. If you vomit, find it hard to swallow, or notice black stools, come back sooner."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.64,
      "end_seconds": 349.43,
      "duration_seconds": 2.79,
      "text": "Thank you, doctor. ~"
    }
  ]
}
