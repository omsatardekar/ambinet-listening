{
  "schema_version": "1.0",
  "encounter_id": "00682",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 2.34,
      "end_seconds": 14.76,
      "duration_seconds": 12.42,
      "text": "Morning, Mr Kelly, I'm Anna, I'll do your measurements first and then the doctor will see you. Shoes off, up on the scales. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.98,
      "end_seconds": 19.46,
      "duration_seconds": 1.48,
      "text": "Righto. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 42.42,
      "end_seconds": 51.52,
      "duration_seconds": 9.1,
      "text": "Weight 68 kilos, height 178 centimetres. Blood pressure 136 over 74, pulse 104, temperature 37.0."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.49,
      "end_seconds": 57.95,
      "duration_seconds": 2.46,
      "text": "Is that normal? ~"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 61.69,
      "end_seconds": 70.34,
      "duration_seconds": 8.65,
      "text": "I'll leave it to the doctor to talk through. Pop in when you're ready. ~"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.02,
      "end_seconds": 79.13,
      "duration_seconds": 5.11,
      "text": "Come in, Mr Kelly. What's brought you in? ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.04,
      "end_seconds": 89.84,
      "duration_seconds": 6.8,
      "text": "I've been losing weight, doc, and I'm eating like a horse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.47,
      "end_seconds": 97.15,
      "duration_seconds": 4.68,
      "text": "How much weight, and over what time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.92,
      "end_seconds": 104.32,
      "duration_seconds": 4.4,
      "text": "About eight kilos since Christmas. I was seventy-six."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.92,
      "end_seconds": 114.64,
      "duration_seconds": 6.72,
      "text": "That's a lot. And you're eating normally, or more than normal? ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.5,
      "end_seconds": 124.52,
      "duration_seconds": 7.02,
      "text": "More. I'm hungry all the time, and I've still lost it. ~"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.66,
      "end_seconds": 133.08,
      "duration_seconds": 4.42,
      "text": "Anything else you've noticed along with it? ~"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.99,
      "end_seconds": 141.39,
      "duration_seconds": 5.4,
      "text": "I'm sweating. Even sitting still, even in winter."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.03,
      "end_seconds": 146.38,
      "duration_seconds": 2.35,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.36,
      "end_seconds": 151.64,
      "duration_seconds": 2.28,
      "text": "Never. Not once."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.38,
      "end_seconds": 168.72,
      "duration_seconds": 13.34,
      "text": "Your pulse is quicker than I'd expect when you're sitting, and I can see you've got a bit of a tremor in your hands. ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.38,
      "end_seconds": 178.59,
      "duration_seconds": 6.21,
      "text": "Yeah, I noticed that. I put it down to coffee. ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.6,
      "end_seconds": 194.26,
      "duration_seconds": 12.66,
      "text": "Possibly, but with the weight loss and the sweating, I'd like to check your thyroid. I'm going to arrange a blood test today."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.39,
      "end_seconds": 200.79,
      "duration_seconds": 3.4,
      "text": "Right. Whatever it takes. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.89,
      "end_seconds": 215.64,
      "duration_seconds": 11.75,
      "text": "The nurse will take it before you go. We'll ring you with the result in a few days. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.63,
      "end_seconds": 222.15,
      "duration_seconds": 3.52,
      "text": "Should I be worried? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.99,
      "end_seconds": 234.77,
      "duration_seconds": 8.78,
      "text": "Not yet. There are a few reasons for this, and many are easy to treat. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.53,
      "end_seconds": 242.82,
      "duration_seconds": 5.29,
      "text": "Okay. What should I do in the meantime? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.41,
      "end_seconds": 253.97,
      "duration_seconds": 7.56,
      "text": "Eat as you normally do, don't skip meals, and cut down the coffee."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.94,
      "end_seconds": 259.49,
      "duration_seconds": 2.55,
      "text": "That'll be hard. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.37,
      "end_seconds": 265.58,
      "duration_seconds": 3.21,
      "text": "Try one a day. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.4,
      "end_seconds": 270.07,
      "duration_seconds": 1.67,
      "text": "Fine. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.92,
      "end_seconds": 281.76,
      "duration_seconds": 8.84,
      "text": "If the weight keeps falling, or you get palpitations or a high temperature, ring us earlier."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.82,
      "end_seconds": 288.04,
      "duration_seconds": 3.22,
      "text": "I will. Thanks, doc. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 291.74,
      "end_seconds": 300.28,
      "duration_seconds": 8.54,
      "text": "I'll take that blood now, Mr Kelly, if you'd like to follow me. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.21,
      "end_seconds": 305.97,
      "duration_seconds": 2.76,
      "text": "Lead the way. ~"
    }
  ]
}
