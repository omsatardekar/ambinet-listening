{
  "schema_version": "1.0",
  "encounter_id": "00861",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.68,
      "end_seconds": 25.88,
      "duration_seconds": 25.2,
      "text": "Oh, doctor, I've done my back. Lifting a patient at work, a big chap, he slipped, and I caught him, and something went in my lower back. It's been three days. I'm a nurse, I should know better, and my mum says it's because I never stretch."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.79,
      "end_seconds": 34.76,
      "duration_seconds": 6.97,
      "text": "Ouch. A spasm in the lower back, three days ago. Is that right?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.41,
      "end_seconds": 45.84,
      "duration_seconds": 9.43,
      "text": "Yes, a back spasm, right across the bottom. I couldn't get out of the car."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.61,
      "end_seconds": 52.39,
      "duration_seconds": 3.78,
      "text": "Does the pain go anywhere?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.94,
      "end_seconds": 61.63,
      "duration_seconds": 6.69,
      "text": "Down the left leg, as far as the knee. Not below."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.2,
      "end_seconds": 65.61,
      "duration_seconds": 2.41,
      "text": "Does it feel stiff?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.7,
      "end_seconds": 72.19,
      "duration_seconds": 4.49,
      "text": "Stiff, like a board, especially in the morning."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.4,
      "end_seconds": 76.21,
      "duration_seconds": 2.81,
      "text": "What about coughing or sneezing?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.93,
      "end_seconds": 85.1,
      "duration_seconds": 8.17,
      "text": "Oh, I yelp when I cough. The cat sneezed and I nearly died."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.68,
      "end_seconds": 94.59,
      "duration_seconds": 6.91,
      "text": "Now, some important questions. Any numbness between your legs, in the saddle area?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.19,
      "end_seconds": 98.99,
      "duration_seconds": 2.8,
      "text": "No, no numbness there."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.2,
      "end_seconds": 102.62,
      "duration_seconds": 2.42,
      "text": "Any trouble passing urine?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.78,
      "end_seconds": 106.71,
      "duration_seconds": 2.93,
      "text": "No, my bladder's fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.85,
      "end_seconds": 110.99,
      "duration_seconds": 3.14,
      "text": "Bowels? Any loss of control?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.25,
      "end_seconds": 114.9,
      "duration_seconds": 2.65,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.34,
      "end_seconds": 119.31,
      "duration_seconds": 2.97,
      "text": "Any weakness in the legs?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.21,
      "end_seconds": 125.88,
      "duration_seconds": 3.67,
      "text": "No weakness, I can walk. Slowly."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.88,
      "end_seconds": 129.85,
      "duration_seconds": 1.97,
      "text": "Any fever?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.57,
      "end_seconds": 133.35,
      "duration_seconds": 1.78,
      "text": "No fever."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.24,
      "end_seconds": 136.43,
      "duration_seconds": 2.19,
      "text": "What have you taken?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.95,
      "end_seconds": 145.9,
      "duration_seconds": 7.95,
      "text": "Ibuprofen, 400 mg, three times a day. And paracetamol, 1 gram, four times a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.67,
      "end_seconds": 150.85,
      "duration_seconds": 2.18,
      "text": "Allergies to medicines?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.34,
      "end_seconds": 154.49,
      "duration_seconds": 2.15,
      "text": "No, no allergies."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.37,
      "end_seconds": 158.21,
      "duration_seconds": 2.84,
      "text": "Anything in your medical background?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.05,
      "end_seconds": 166.63,
      "duration_seconds": 5.58,
      "text": "Asthma, migraine, and a bit of scoliosis since my teens."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.34,
      "end_seconds": 168.51,
      "duration_seconds": 1.17,
      "text": "Operations?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.99,
      "end_seconds": 174.1,
      "duration_seconds": 3.11,
      "text": "A caesarean, in 2016."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.54,
      "end_seconds": 179.72,
      "duration_seconds": 3.18,
      "text": "Back problems in the family?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.84,
      "end_seconds": 189.09,
      "duration_seconds": 7.25,
      "text": "Mum has bad back trouble. Dad has high blood pressure, no, that's irrelevant, sorry."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.27,
      "end_seconds": 194.99,
      "duration_seconds": 3.72,
      "text": "Tell me about your work."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.78,
      "end_seconds": 202.57,
      "duration_seconds": 5.79,
      "text": "I'm a nurse on a care ward. Lots of lifting."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.03,
      "end_seconds": 206.44,
      "duration_seconds": 1.41,
      "text": "Smoking?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.3,
      "end_seconds": 210.6,
      "duration_seconds": 1.3,
      "text": "Never."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.18,
      "end_seconds": 213.73,
      "duration_seconds": 1.55,
      "text": "Alcohol?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.37,
      "end_seconds": 219.13,
      "duration_seconds": 3.76,
      "text": "Gin at the weekend, a couple."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.05,
      "end_seconds": 221.08,
      "duration_seconds": 1.03,
      "text": "Exercise?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.06,
      "end_seconds": 227.89,
      "duration_seconds": 3.83,
      "text": "Zumba on Wednesdays, though not this week."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.84,
      "end_seconds": 256.04,
      "duration_seconds": 10.2,
      "text": "Right, let me check you. Pulse 76, blood pressure 124 over 78, temperature 36.7, oxygen 99 percent, breathing 14, weight 68 kilos."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.63,
      "end_seconds": 259.82,
      "duration_seconds": 2.19,
      "text": "Normal then? ~"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.86,
      "end_seconds": 278.4,
      "duration_seconds": 7.54,
      "text": "Normal. Now, I'll feel along your back. Tell me where it's worst."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.18,
      "end_seconds": 283.17,
      "duration_seconds": 2.99,
      "text": "There. And there. ~"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.28,
      "end_seconds": 292.59,
      "duration_seconds": 8.31,
      "text": "There's tenderness and tightness in the muscles on the left side of the lower back."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.97,
      "end_seconds": 296.63,
      "duration_seconds": 1.66,
      "text": "Mm. ~"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.08,
      "end_seconds": 313.63,
      "duration_seconds": 7.55,
      "text": "Lift your left leg straight, lying down. Does that reproduce the leg pain?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.47,
      "end_seconds": 319.54,
      "duration_seconds": 4.07,
      "text": "A bit, at about forty degrees. ~"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.36,
      "end_seconds": 328.76,
      "duration_seconds": 6.4,
      "text": "So the straight leg raise is mildly positive on the left."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.53,
      "end_seconds": 333.34,
      "duration_seconds": 2.81,
      "text": "Is that bad? ~"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.34,
      "end_seconds": 338.04,
      "duration_seconds": 3.7,
      "text": "Any problem with your breathing?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.44,
      "end_seconds": 342.39,
      "duration_seconds": 2.95,
      "text": "No, nothing, my asthma's quiet."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.97,
      "end_seconds": 350.8,
      "duration_seconds": 6.83,
      "text": "Any problem with your water or tummy, apart from what we've said?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.08,
      "end_seconds": 355.05,
      "duration_seconds": 2.97,
      "text": "No, nothing, all normal."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.11,
      "end_seconds": 370.51,
      "duration_seconds": 14.4,
      "text": "Let me repeat what I think. A pulled muscle in the lower back, but I can't rule out a slipped disc pressing on a nerve, given the leg pain."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 373.02,
      "end_seconds": 376.99,
      "duration_seconds": 3.97,
      "text": "Do I need a scan? ~"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.92,
      "end_seconds": 387.47,
      "duration_seconds": 7.55,
      "text": "Not today. I'd like to arrange physiotherapy for you, and an X-ray of the spine."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 389.99,
      "end_seconds": 391.79,
      "duration_seconds": 1.8,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 394.17,
      "end_seconds": 405.71,
      "duration_seconds": 11.54,
      "text": "If the leg pain isn't better in two weeks, I'd like to arrange an MRI of your lower back."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 408.57,
      "end_seconds": 413.58,
      "duration_seconds": 5.01,
      "text": "Right. And if it gets worse? ~"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 414.81,
      "end_seconds": 426.53,
      "duration_seconds": 11.72,
      "text": "If you get numbness between your legs, or any trouble with your bladder or bowels, go straight to the emergency department."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 428.77,
      "end_seconds": 433.15,
      "duration_seconds": 4.38,
      "text": "Understood. Is that the only red flag? ~"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 434.91,
      "end_seconds": 440.44,
      "duration_seconds": 5.53,
      "text": "The main one. Keep moving, gentle walking, no bed rest."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 443.17,
      "end_seconds": 446.32,
      "duration_seconds": 3.15,
      "text": "Alright, thank you. ~"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 447.9,
      "end_seconds": 455.74,
      "duration_seconds": 7.84,
      "text": "If it's not better in two weeks, come back and see me."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 457.12,
      "end_seconds": 460.32,
      "duration_seconds": 3.2,
      "text": "I will. Thanks, doctor. ~"
    }
  ]
}
