{
  "schema_version": "1.0",
  "encounter_id": "00776",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 2.9,
      "end_seconds": 20.53,
      "duration_seconds": 17.63,
      "text": "Morning, doctor! I'm on a blood thinner, as you know, and I notice I bruise like a peach, so I thought I'd have it looked at. Nothing alarming, I don't think."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.72,
      "end_seconds": 30.73,
      "duration_seconds": 6.01,
      "text": "Very sensible. Remind me which one, and how long you've taken it?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.75,
      "end_seconds": 46.29,
      "duration_seconds": 11.54,
      "text": "Apixaban, 5 mg, twice a day. Since my operation last year, they put me on it for my irregular heartbeat."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.16,
      "end_seconds": 52.24,
      "duration_seconds": 3.08,
      "text": "Which operation was that?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.13,
      "end_seconds": 59.68,
      "duration_seconds": 4.55,
      "text": "A knee replacement, in March. The right one."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.48,
      "end_seconds": 67.0,
      "duration_seconds": 3.52,
      "text": "Where are you getting bruises? ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.61,
      "end_seconds": 79.67,
      "duration_seconds": 10.06,
      "text": "Forearms, mostly, from bumping into things, and a few on my shins. They look worse than they feel. ~"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.42,
      "end_seconds": 89.91,
      "duration_seconds": 6.49,
      "text": "Any nosebleeds, bleeding gums, or blood in your urine or stools?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.51,
      "end_seconds": 99.04,
      "duration_seconds": 6.53,
      "text": "No, nothing like that. No nosebleeds, no blood, no black stools."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.42,
      "end_seconds": 105.58,
      "duration_seconds": 3.16,
      "text": "Any head injuries, or falls?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.38,
      "end_seconds": 113.3,
      "duration_seconds": 4.92,
      "text": "No, no falls. I'm a sensible old thing."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.98,
      "end_seconds": 118.95,
      "duration_seconds": 2.97,
      "text": "Any allergies to medicines?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.87,
      "end_seconds": 125.33,
      "duration_seconds": 2.46,
      "text": "No allergies, never."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.86,
      "end_seconds": 132.86,
      "duration_seconds": 4.0,
      "text": "Anyone in the family with bleeding problems?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.07,
      "end_seconds": 142.58,
      "duration_seconds": 6.51,
      "text": "My mother bruised easily too, she was always covered in them."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.37,
      "end_seconds": 148.78,
      "duration_seconds": 2.41,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.56,
      "end_seconds": 158.29,
      "duration_seconds": 5.73,
      "text": "A glass of sherry in the evenings, no more."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.19,
      "end_seconds": 167.21,
      "duration_seconds": 5.02,
      "text": "Let me check your numbers. Pulse and pressure. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.33,
      "end_seconds": 173.11,
      "duration_seconds": 1.78,
      "text": "Of course. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.02,
      "end_seconds": 194.28,
      "duration_seconds": 7.26,
      "text": "Pulse 70 and irregular, blood pressure 130 over 76, temperature 36.5, oxygen 98 percent."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.92,
      "end_seconds": 200.2,
      "duration_seconds": 3.28,
      "text": "Irregular? Is that bad? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.51,
      "end_seconds": 211.81,
      "duration_seconds": 8.3,
      "text": "It's your atrial fibrillation, as expected, and the rate is fine. Any breathlessness, chest pain?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.61,
      "end_seconds": 216.91,
      "duration_seconds": 2.3,
      "text": "No, none whatsoever."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.56,
      "end_seconds": 232.58,
      "duration_seconds": 13.02,
      "text": "Good. Easy bruising on apixaban is common and usually harmless. I'd like to check a blood count and kidney function, because the dose depends on both."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.2,
      "end_seconds": 237.57,
      "duration_seconds": 2.37,
      "text": "Of course. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.27,
      "end_seconds": 245.94,
      "duration_seconds": 5.67,
      "text": "Don't stop the apixaban, it's protecting you from a stroke. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.54,
      "end_seconds": 250.57,
      "duration_seconds": 2.03,
      "text": "Understood. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.24,
      "end_seconds": 262.51,
      "duration_seconds": 9.27,
      "text": "Wear long sleeves when gardening, pad any sharp corners at home, and use a soft toothbrush."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.61,
      "end_seconds": 271.15,
      "duration_seconds": 5.54,
      "text": "I'll get some foam for the coffee table. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.51,
      "end_seconds": 279.73,
      "duration_seconds": 5.22,
      "text": "And avoid anti-inflammatory painkillers like ibuprofen, which increase bleeding risk."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.43,
      "end_seconds": 287.11,
      "duration_seconds": 3.68,
      "text": "I only take paracetamol. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.85,
      "end_seconds": 298.9,
      "duration_seconds": 8.05,
      "text": "That's the right one. I'd like to see you again in four weeks, with the blood results."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.72,
      "end_seconds": 306.0,
      "duration_seconds": 3.28,
      "text": "Four weeks. Thank you. ~"
    }
  ]
}
