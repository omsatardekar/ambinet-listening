{
  "schema_version": "1.0",
  "encounter_id": "00809",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.27,
      "end_seconds": 18.1,
      "duration_seconds": 16.83,
      "text": "Good morning. I'll be direct. I'm eleven weeks pregnant, and I was in contact with a child with chickenpox on Tuesday, and I don't know if I'm immune."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.89,
      "end_seconds": 29.48,
      "duration_seconds": 9.59,
      "text": "Thank you, that's exactly the right thing to ask about. How long were you with the child? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.34,
      "end_seconds": 42.05,
      "duration_seconds": 9.71,
      "text": "About an hour, indoors. My niece. She came out in spots the next day. ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.45,
      "end_seconds": 48.21,
      "duration_seconds": 3.76,
      "text": "Have you ever had chickenpox yourself?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.51,
      "end_seconds": 60.04,
      "duration_seconds": 8.53,
      "text": "I don't think so. I was never told I'd had it. I can't remember a rash."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.55,
      "end_seconds": 68.54,
      "duration_seconds": 5.99,
      "text": "Any sign of a rash on you, or a fever?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.84,
      "end_seconds": 74.51,
      "duration_seconds": 4.67,
      "text": "No rash. A slight headache yesterday. No fever."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.82,
      "end_seconds": 80.2,
      "duration_seconds": 3.38,
      "text": "And how's the pregnancy going otherwise?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.87,
      "end_seconds": 87.18,
      "duration_seconds": 5.31,
      "text": "A bit sick in the mornings, and tired. Nothing alarming."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.09,
      "end_seconds": 94.27,
      "duration_seconds": 4.18,
      "text": "What are you taking at the moment?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.77,
      "end_seconds": 106.82,
      "duration_seconds": 11.05,
      "text": "Folic acid, 400 micrograms once a day, and a pregnancy multivitamin. I'm supposed to take them daily, but I miss a few days."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.57,
      "end_seconds": 112.76,
      "duration_seconds": 4.19,
      "text": "Noted, and that's fine. Any other conditions?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.79,
      "end_seconds": 118.72,
      "duration_seconds": 2.93,
      "text": "I have asthma, and hypothyroidism."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.15,
      "end_seconds": 123.15,
      "duration_seconds": 3.0,
      "text": "Do you use inhalers? ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.42,
      "end_seconds": 129.2,
      "duration_seconds": 3.78,
      "text": "The blue one, as needed. ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.43,
      "end_seconds": 135.73,
      "duration_seconds": 4.3,
      "text": "Let me check your pulse and pressure. ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.23,
      "end_seconds": 138.97,
      "duration_seconds": 1.74,
      "text": "Of course. ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.44,
      "end_seconds": 159.64,
      "duration_seconds": 7.2,
      "text": "Pulse 80, blood pressure 108 over 66, temperature 36.7, oxygen 99 percent."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.08,
      "end_seconds": 164.43,
      "duration_seconds": 2.35,
      "text": "All right? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.82,
      "end_seconds": 185.23,
      "duration_seconds": 4.41,
      "text": "All fine. I'll listen to your chest."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.14,
      "end_seconds": 190.05,
      "duration_seconds": 2.91,
      "text": "Is it clear? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.28,
      "end_seconds": 210.52,
      "duration_seconds": 17.24,
      "text": "Clear, no wheeze. Now, what matters is whether you're immune. If you haven't had chickenpox, you could catch it, and in pregnancy it can be serious for you and the baby."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.69,
      "end_seconds": 215.57,
      "duration_seconds": 2.88,
      "text": "What can be done? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.0,
      "end_seconds": 228.86,
      "duration_seconds": 11.86,
      "text": "I'd like to arrange a blood test today, to check for antibodies against chickenpox, with a result within a day or two."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.91,
      "end_seconds": 235.84,
      "duration_seconds": 3.93,
      "text": "And if I'm not immune? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.01,
      "end_seconds": 250.91,
      "duration_seconds": 12.9,
      "text": "Then you'd be offered a treatment within ten days of the contact, either an antiviral, or an injection of antibodies, and it's best given early. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.27,
      "end_seconds": 256.38,
      "duration_seconds": 4.11,
      "text": "I'm within the ten days. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.74,
      "end_seconds": 267.48,
      "duration_seconds": 9.74,
      "text": "You are, comfortably. I'd say it's a possible exposure, and I'd call it a high-priority check, not an emergency."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.76,
      "end_seconds": 271.39,
      "duration_seconds": 1.63,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.63,
      "end_seconds": 285.75,
      "duration_seconds": 11.12,
      "text": "Meanwhile, avoid contact with other pregnant women and newborns, and if a rash, fever, cough or breathing trouble appears, call me straight away."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.32,
      "end_seconds": 290.04,
      "duration_seconds": 2.72,
      "text": "I'll do that. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.7,
      "end_seconds": 302.12,
      "duration_seconds": 10.42,
      "text": "I'll ring you with the result, and I'd like to see you again if you're not immune. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.49,
      "end_seconds": 305.99,
      "duration_seconds": 2.5,
      "text": "Thank you, doctor. ~"
    }
  ]
}
