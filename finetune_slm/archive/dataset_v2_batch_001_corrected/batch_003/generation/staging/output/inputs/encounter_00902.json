{
  "schema_version": "1.0",
  "encounter_id": "00902",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 0.41,
      "end_seconds": 9.03,
      "duration_seconds": 8.62,
      "text": "Mr Brannigan, is it Frank, with a K, or a C? I never remember. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.07,
      "end_seconds": 18.67,
      "duration_seconds": 8.6,
      "text": "Frank with a K. Come on, doctor, I have a rehab class at noon. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.63,
      "end_seconds": 26.35,
      "duration_seconds": 6.72,
      "text": "Then let's be quick. How's the pulmonary rehab going? ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.72,
      "end_seconds": 38.05,
      "duration_seconds": 10.33,
      "text": "Good, actually. I'm short of breath on the stairs less than before. Three flights now, I used to stop at one."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.63,
      "end_seconds": 44.62,
      "duration_seconds": 3.99,
      "text": "That's real progress. And the cough?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.26,
      "end_seconds": 52.27,
      "duration_seconds": 6.01,
      "text": "Mornings, a bit, clear stuff. I cough it up and I'm fine."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.98,
      "end_seconds": 56.19,
      "duration_seconds": 1.21,
      "text": "Wheezing?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.57,
      "end_seconds": 60.34,
      "duration_seconds": 2.77,
      "text": "At night, sometimes, a whistle."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.98,
      "end_seconds": 63.99,
      "duration_seconds": 2.01,
      "text": "How's your energy?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.91,
      "end_seconds": 69.73,
      "duration_seconds": 2.82,
      "text": "Wiped out by three."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.66,
      "end_seconds": 75.18,
      "duration_seconds": 2.52,
      "text": "Any chest pain?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.05,
      "end_seconds": 77.93,
      "duration_seconds": 1.88,
      "text": "No chest pain."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.76,
      "end_seconds": 79.76,
      "duration_seconds": 1.0,
      "text": "Fever?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.23,
      "end_seconds": 83.97,
      "duration_seconds": 1.74,
      "text": "No fever."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.57,
      "end_seconds": 88.74,
      "duration_seconds": 2.17,
      "text": "Coughing up blood?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.55,
      "end_seconds": 92.56,
      "duration_seconds": 2.01,
      "text": "No blood."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.21,
      "end_seconds": 98.87,
      "duration_seconds": 3.66,
      "text": "Any swelling in your ankles?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.58,
      "end_seconds": 104.0,
      "duration_seconds": 2.42,
      "text": "No, no swelling."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.38,
      "end_seconds": 106.82,
      "duration_seconds": 1.44,
      "text": "Which inhalers?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.26,
      "end_seconds": 117.94,
      "duration_seconds": 8.68,
      "text": "Tiotropium, 18 micrograms, once a day. And the albuterol, the rescue one, when I need it."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.57,
      "end_seconds": 121.88,
      "duration_seconds": 2.31,
      "text": "Good. Any allergies?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.67,
      "end_seconds": 133.8,
      "duration_seconds": 9.13,
      "text": "Hm. I think a hospital gave me a rash once, maybe from an antibiotic, I really don't know."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.61,
      "end_seconds": 139.22,
      "duration_seconds": 4.61,
      "text": "I'll record it as a possible allergy, unconfirmed. History?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.87,
      "end_seconds": 146.16,
      "duration_seconds": 4.29,
      "text": "COPD, high blood pressure, and osteoporosis."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.89,
      "end_seconds": 148.92,
      "duration_seconds": 1.03,
      "text": "Operations?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.82,
      "end_seconds": 154.42,
      "duration_seconds": 2.6,
      "text": "Hernia repair in 2010."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.07,
      "end_seconds": 159.94,
      "duration_seconds": 2.87,
      "text": "Lung problems in the family?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.86,
      "end_seconds": 167.27,
      "duration_seconds": 5.41,
      "text": "My mother had emphysema. My brother has heart disease."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.84,
      "end_seconds": 172.77,
      "duration_seconds": 3.93,
      "text": "And smoking, I recall you quit."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.57,
      "end_seconds": 178.79,
      "duration_seconds": 5.22,
      "text": "Quit smoking in 2018. Thirty pack-years before that."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.09,
      "end_seconds": 181.31,
      "duration_seconds": 1.22,
      "text": "Drink?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.46,
      "end_seconds": 185.01,
      "duration_seconds": 2.55,
      "text": "One drink on Sundays."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.58,
      "end_seconds": 187.91,
      "duration_seconds": 1.33,
      "text": "Rehab classes?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.36,
      "end_seconds": 195.09,
      "duration_seconds": 5.73,
      "text": "Three times a week. I'm the oldest guy there."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.84,
      "end_seconds": 200.26,
      "duration_seconds": 2.42,
      "text": "And your work?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.48,
      "end_seconds": 207.56,
      "duration_seconds": 5.08,
      "text": "I was a welder, retired now. Welding fumes, probably."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.18,
      "end_seconds": 238.55,
      "duration_seconds": 13.37,
      "text": "Let me check you. Oxygen 93 percent, pulse 80, blood pressure 136 over 82, temperature 36.7, breathing 18, and weight 77 kilos."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.74,
      "end_seconds": 243.04,
      "duration_seconds": 3.3,
      "text": "Ninety-three, is that good? ~"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.73,
      "end_seconds": 261.55,
      "duration_seconds": 5.82,
      "text": "For you, that's your usual. Let me listen. Big breaths."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.01,
      "end_seconds": 266.87,
      "duration_seconds": 3.86,
      "text": "In and out, like a pro. ~"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.58,
      "end_seconds": 277.49,
      "duration_seconds": 7.91,
      "text": "I can hear wheeze on both sides, and the air entry is reduced at the bases."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.6,
      "end_seconds": 281.51,
      "duration_seconds": 2.91,
      "text": "That's normal for me. ~"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.58,
      "end_seconds": 285.16,
      "duration_seconds": 1.58,
      "text": "Any palpitations?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.01,
      "end_seconds": 290.93,
      "duration_seconds": 2.92,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.77,
      "end_seconds": 295.18,
      "duration_seconds": 3.41,
      "text": "Any heartburn or trouble swallowing?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.32,
      "end_seconds": 299.31,
      "duration_seconds": 2.99,
      "text": "No, nothing, that's all fine."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.15,
      "end_seconds": 311.64,
      "duration_seconds": 11.49,
      "text": "You're doing well, but I can't rule out a COPD flare-up brewing, and I can't rule out the heart contributing to the breathlessness."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.18,
      "end_seconds": 315.1,
      "duration_seconds": 1.92,
      "text": "My heart? ~"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.99,
      "end_seconds": 326.67,
      "duration_seconds": 8.68,
      "text": "Just ruling things out. I'd like to arrange spirometry, a chest X-ray, and a six-minute walk test."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.88,
      "end_seconds": 331.07,
      "duration_seconds": 3.19,
      "text": "I do that at rehab. ~"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.31,
      "end_seconds": 341.38,
      "duration_seconds": 8.07,
      "text": "We'll do it here as well, for the record. And blood tests, including a blood count."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.12,
      "end_seconds": 345.72,
      "duration_seconds": 1.6,
      "text": "Fine. ~"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.14,
      "end_seconds": 352.47,
      "duration_seconds": 5.33,
      "text": "I'd like to see you again in six weeks."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 354.54,
      "end_seconds": 358.0,
      "duration_seconds": 3.46,
      "text": "Six weeks. I'll be late. ~"
    }
  ]
}
