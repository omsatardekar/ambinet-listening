{
  "schema_version": "1.0",
  "encounter_id": "00921",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 0.68,
      "end_seconds": 15.98,
      "duration_seconds": 15.3,
      "text": "Dr Rao, this is Ms Kapoor, she's here about her periods. I've done her obs: blood pressure 110 over 70, pulse 72, weight 72 kilos. She's a bit nervous."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.87,
      "end_seconds": 27.39,
      "duration_seconds": 9.52,
      "text": "Thank you, nurse. Come in, Ms Kapoor, sit down. You said your periods have gone strange? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.26,
      "end_seconds": 42.71,
      "duration_seconds": 14.45,
      "text": "Yes, doctor, I'm so worried. Ever since I stopped the pill six months ago, my periods are irregular, sometimes forty days, sometimes sixty, and I think something is wrong."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.95,
      "end_seconds": 52.33,
      "duration_seconds": 8.38,
      "text": "So irregular cycles since stopping the pill. What's the bleeding like when it does come?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.4,
      "end_seconds": 60.89,
      "duration_seconds": 6.49,
      "text": "Heavy. Very heavy the first two days, I'm soaking through pads."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.75,
      "end_seconds": 65.01,
      "duration_seconds": 2.26,
      "text": "And your skin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.92,
      "end_seconds": 75.35,
      "duration_seconds": 7.43,
      "text": "Acne, along the jaw. It was never this bad before. Is it hormones?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.81,
      "end_seconds": 80.64,
      "duration_seconds": 2.83,
      "text": "Anything else you've noticed?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.82,
      "end_seconds": 93.34,
      "duration_seconds": 11.52,
      "text": "Some coarse hair on my chin, and I've started shaving it. And I'm moody, I snap at my mother."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.44,
      "end_seconds": 101.05,
      "duration_seconds": 5.61,
      "text": "Have you noticed any milky discharge from the breasts?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.48,
      "end_seconds": 104.33,
      "duration_seconds": 1.85,
      "text": "No, nothing."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.27,
      "end_seconds": 110.04,
      "duration_seconds": 3.77,
      "text": "Any headaches or changes in your vision?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.16,
      "end_seconds": 115.34,
      "duration_seconds": 3.18,
      "text": "No headaches, no vision changes."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.6,
      "end_seconds": 119.25,
      "duration_seconds": 1.65,
      "text": "Weight loss?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.61,
      "end_seconds": 124.34,
      "duration_seconds": 3.73,
      "text": "No, I've put on a little."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.1,
      "end_seconds": 130.07,
      "duration_seconds": 4.97,
      "text": "Are you taking anything at the moment?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.8,
      "end_seconds": 140.9,
      "duration_seconds": 10.1,
      "text": "Just a folic acid, maybe 400 micrograms? I got it from the chemist when we were thinking of trying."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.84,
      "end_seconds": 146.19,
      "duration_seconds": 2.35,
      "text": "Okay. Any allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.39,
      "end_seconds": 157.89,
      "duration_seconds": 10.5,
      "text": "Aspirin. I react to it, but I don't remember what happens, I only know it's on my record."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.0,
      "end_seconds": 162.27,
      "duration_seconds": 2.27,
      "text": "Fine. Medical history?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.26,
      "end_seconds": 170.04,
      "duration_seconds": 5.78,
      "text": "Anaemia a few years ago, and asthma as a child."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.18,
      "end_seconds": 172.5,
      "duration_seconds": 1.32,
      "text": "Surgery?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.64,
      "end_seconds": 181.5,
      "duration_seconds": 6.86,
      "text": "Tonsils, when I was seven. And my wisdom teeth, in 2019."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.17,
      "end_seconds": 188.03,
      "duration_seconds": 4.86,
      "text": "Anyone in the family with similar problems?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.12,
      "end_seconds": 191.65,
      "duration_seconds": 2.53,
      "text": "My mother has diabetes."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.85,
      "end_seconds": 196.41,
      "duration_seconds": 3.56,
      "text": "What do you do for work?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.99,
      "end_seconds": 204.33,
      "duration_seconds": 5.34,
      "text": "I'm a software tester. Long hours, lots of sitting."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.53,
      "end_seconds": 207.76,
      "duration_seconds": 2.23,
      "text": "Do you drink?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.4,
      "end_seconds": 213.3,
      "duration_seconds": 2.9,
      "text": "No alcohol at all."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.48,
      "end_seconds": 216.42,
      "duration_seconds": 0.94,
      "text": "Exercise?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.76,
      "end_seconds": 221.09,
      "duration_seconds": 2.33,
      "text": "Yoga, twice a week."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.28,
      "end_seconds": 243.7,
      "duration_seconds": 9.42,
      "text": "Let me examine you. Is that all right? Lie back and I'll feel your tummy."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.9,
      "end_seconds": 246.39,
      "duration_seconds": 1.49,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.17,
      "end_seconds": 252.52,
      "duration_seconds": 4.35,
      "text": "Your abdomen is soft and not tender."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.28,
      "end_seconds": 257.04,
      "duration_seconds": 1.76,
      "text": "Good. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.56,
      "end_seconds": 266.16,
      "duration_seconds": 6.6,
      "text": "I can see acne along the jaw, and coarser hair on the chin."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.49,
      "end_seconds": 270.44,
      "duration_seconds": 2.95,
      "text": "Is it serious? ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.78,
      "end_seconds": 275.32,
      "duration_seconds": 2.54,
      "text": "Any trouble passing urine?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.59,
      "end_seconds": 279.6,
      "duration_seconds": 3.01,
      "text": "No, nothing, it's normal."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.0,
      "end_seconds": 291.89,
      "duration_seconds": 9.89,
      "text": "What I'm seeing, with the long cycles, the acne and the chin hair, is probably polycystic ovary syndrome."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.76,
      "end_seconds": 297.63,
      "duration_seconds": 4.87,
      "text": "PCOS? Will I be able to have children? ~"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.64,
      "end_seconds": 310.76,
      "duration_seconds": 11.12,
      "text": "Very likely yes. Let me confirm first. I'd like to arrange a pelvic ultrasound, hormone blood tests, and a pregnancy test today."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 312.74,
      "end_seconds": 317.92,
      "duration_seconds": 5.18,
      "text": "I can do the pregnancy test now, doctor. ~"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.75,
      "end_seconds": 329.23,
      "duration_seconds": 10.48,
      "text": "Thank you. And I'd like to start norethisterone, 5 mg, twice a day for ten days, to bring on a proper period."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.72,
      "end_seconds": 334.71,
      "duration_seconds": 2.99,
      "text": "Is it safe? ~"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.66,
      "end_seconds": 341.4,
      "duration_seconds": 5.74,
      "text": "Yes. Expect a bleed a few days after you finish. ~"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.33,
      "end_seconds": 344.34,
      "duration_seconds": 2.01,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.77,
      "end_seconds": 350.51,
      "duration_seconds": 4.74,
      "text": "I'd like to see you again in four weeks."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.85,
      "end_seconds": 356.08,
      "duration_seconds": 3.23,
      "text": "Four weeks. Thank you, doctor. ~"
    }
  ]
}
