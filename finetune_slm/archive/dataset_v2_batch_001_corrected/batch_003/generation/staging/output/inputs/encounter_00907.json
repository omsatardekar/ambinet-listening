{
  "schema_version": "1.0",
  "encounter_id": "00907",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.59,
      "end_seconds": 8.86,
      "duration_seconds": 7.27,
      "text": "My periods have been really heavy for several months now, and I'm sick of it."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.98,
      "end_seconds": 19.45,
      "duration_seconds": 7.47,
      "text": "I'm sorry, that sounds exhausting. How many days do you bleed for?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.6,
      "end_seconds": 28.27,
      "duration_seconds": 5.67,
      "text": "Seven or eight days. The first three are the worst."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.03,
      "end_seconds": 38.52,
      "duration_seconds": 8.49,
      "text": "How often do you need to change a pad on the heaviest days?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.76,
      "end_seconds": 47.73,
      "duration_seconds": 5.97,
      "text": "Every hour, sometimes more. I've bled through at night twice."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.35,
      "end_seconds": 55.37,
      "duration_seconds": 5.02,
      "text": "Are the periods regular, or all over the place? ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.52,
      "end_seconds": 61.96,
      "duration_seconds": 4.44,
      "text": "Regular. Every twenty-eight days, like clockwork. ~"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.2,
      "end_seconds": 69.94,
      "duration_seconds": 4.74,
      "text": "Any pain between periods, or bleeding after sex?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.84,
      "end_seconds": 75.18,
      "duration_seconds": 2.34,
      "text": "No. Neither of those."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.87,
      "end_seconds": 80.82,
      "duration_seconds": 3.95,
      "text": "Do you have any allergies to medicines?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.77,
      "end_seconds": 86.54,
      "duration_seconds": 3.77,
      "text": "No, I don't have any allergies."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.82,
      "end_seconds": 95.79,
      "duration_seconds": 6.97,
      "text": "Any other medical problems, or anyone in the family with similar bleeding?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.56,
      "end_seconds": 102.54,
      "duration_seconds": 4.98,
      "text": "My sister had fibroids removed. That's all I know."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.29,
      "end_seconds": 110.21,
      "duration_seconds": 5.92,
      "text": "What do you do for work, and how is it affecting you?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.78,
      "end_seconds": 124.06,
      "duration_seconds": 10.28,
      "text": "I'm a teacher. I'm on my feet all day, and I'm so tired I can hardly think."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.82,
      "end_seconds": 133.88,
      "duration_seconds": 7.06,
      "text": "I'm going to check your pulse and pressure and weigh you. ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.87,
      "end_seconds": 149.89,
      "duration_seconds": 1.02,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.93,
      "end_seconds": 161.0,
      "duration_seconds": 8.07,
      "text": "Pulse 88, blood pressure 112 over 70, temperature 36.6, oxygen 98 percent, breathing 16."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.32,
      "end_seconds": 166.65,
      "duration_seconds": 3.33,
      "text": "Is the pulse high? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.68,
      "end_seconds": 182.26,
      "duration_seconds": 13.58,
      "text": "A little quick, which can go with tiredness from blood loss. Let me look at your eyes and press on your tummy. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.53,
      "end_seconds": 200.55,
      "duration_seconds": 2.02,
      "text": "Go on."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.32,
      "end_seconds": 208.79,
      "duration_seconds": 6.47,
      "text": "Your inner eyelids look pale, and your tummy is soft with no lumps."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.82,
      "end_seconds": 214.57,
      "duration_seconds": 3.75,
      "text": "Pale means anaemia, doesn't it? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.59,
      "end_seconds": 223.42,
      "duration_seconds": 6.83,
      "text": "It can. That's why I'd like a blood count and iron levels today."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.63,
      "end_seconds": 228.52,
      "duration_seconds": 1.89,
      "text": "Fine. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.45,
      "end_seconds": 240.31,
      "duration_seconds": 9.86,
      "text": "And I'd like a scan of the pelvis, to look at the womb for fibroids or polyps, given your sister's history."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.86,
      "end_seconds": 247.63,
      "duration_seconds": 3.77,
      "text": "When would the scan be? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.61,
      "end_seconds": 257.74,
      "duration_seconds": 8.13,
      "text": "I'll ask the department to book it within two weeks. You'll get a letter. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.33,
      "end_seconds": 263.65,
      "duration_seconds": 3.32,
      "text": "Will I have treatment today? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.67,
      "end_seconds": 275.76,
      "duration_seconds": 9.09,
      "text": "Not until the bloods and scan are back. I don't want to guess what is causing it. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.18,
      "end_seconds": 280.08,
      "duration_seconds": 1.9,
      "text": "I understand. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.62,
      "end_seconds": 292.71,
      "duration_seconds": 10.09,
      "text": "If you soak through a pad every hour for several hours, or feel faint, come straight to the emergency department."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.71,
      "end_seconds": 298.16,
      "duration_seconds": 3.45,
      "text": "I will. Thank you, doctor. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.03,
      "end_seconds": 306.01,
      "duration_seconds": 4.98,
      "text": "I'll see you once I have the results. ~"
    }
  ]
}
