{
  "schema_version": "1.0",
  "encounter_id": "00974",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 0.81,
      "end_seconds": 7.47,
      "duration_seconds": 6.66,
      "text": "Mr Fenwick, Mrs Fenwick, come in. Is this about the gabapentin? ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 8.7,
      "end_seconds": 24.49,
      "duration_seconds": 15.79,
      "text": "Er, yes. It's the, what do you call it, the tablets. The drowsy. I've been so sleepy I can't, er, I fell asleep in the garden, in the rain."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 25.64,
      "end_seconds": 36.25,
      "duration_seconds": 10.61,
      "text": "He's nodding off all day, doctor. At the table, in front of the telly, in the car, I won't let him drive."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.55,
      "end_seconds": 40.1,
      "duration_seconds": 1.55,
      "text": "Since when?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 41.57,
      "end_seconds": 46.43,
      "duration_seconds": 4.86,
      "text": "Since they put the dose up last month."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.46,
      "end_seconds": 52.45,
      "duration_seconds": 4.99,
      "text": "Are you steady on your feet, Mr Fenwick?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.09,
      "end_seconds": 59.69,
      "duration_seconds": 4.6,
      "text": "A bit wobbly. Like I've had a few."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.03,
      "end_seconds": 64.47,
      "duration_seconds": 2.44,
      "text": "And your vision?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.42,
      "end_seconds": 71.1,
      "duration_seconds": 4.68,
      "text": "Blurry, now and then. Especially on the stairs."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.56,
      "end_seconds": 75.48,
      "duration_seconds": 2.92,
      "text": "Have you had any falls?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 78.39,
      "end_seconds": 83.64,
      "duration_seconds": 5.25,
      "text": "No, thank goodness, but he's had a few near misses."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.29,
      "end_seconds": 87.08,
      "duration_seconds": 1.79,
      "text": "Any confusion?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.27,
      "end_seconds": 92.55,
      "duration_seconds": 4.28,
      "text": "No, I'm not confused. Just sleepy."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.27,
      "end_seconds": 98.06,
      "duration_seconds": 3.79,
      "text": "Any swelling in the ankles?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 99.58,
      "end_seconds": 102.18,
      "duration_seconds": 2.6,
      "text": "No, they look the same."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.36,
      "end_seconds": 106.31,
      "duration_seconds": 1.95,
      "text": "Any low mood?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.09,
      "end_seconds": 112.29,
      "duration_seconds": 3.2,
      "text": "No, I'm cheerful, if tired."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.24,
      "end_seconds": 121.65,
      "duration_seconds": 7.41,
      "text": "Remind me, what dose were you on, and what is it now?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 123.53,
      "end_seconds": 136.58,
      "duration_seconds": 13.05,
      "text": "He was on 300 mg three times a day, then the pain clinic put it to 600 mg three times a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.0,
      "end_seconds": 141.66,
      "duration_seconds": 3.66,
      "text": "Thank you. Any allergies to medicines?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.5,
      "end_seconds": 146.99,
      "duration_seconds": 2.49,
      "text": "None. No allergies."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.39,
      "end_seconds": 151.22,
      "duration_seconds": 1.83,
      "text": "Your history?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 153.54,
      "end_seconds": 162.05,
      "duration_seconds": 8.51,
      "text": "Nerve pain in his feet, from the diabetes. And the diabetes itself, type 2."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.36,
      "end_seconds": 164.36,
      "duration_seconds": 1.0,
      "text": "Operations?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.18,
      "end_seconds": 168.67,
      "duration_seconds": 3.49,
      "text": "A hip replacement, in 2018."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.03,
      "end_seconds": 171.78,
      "duration_seconds": 1.75,
      "text": "Family history?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.72,
      "end_seconds": 177.68,
      "duration_seconds": 4.96,
      "text": "My father had a stroke. My brother has diabetes."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.25,
      "end_seconds": 183.57,
      "duration_seconds": 4.32,
      "text": "What did you do, Mr Fenwick?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.28,
      "end_seconds": 186.6,
      "duration_seconds": 2.32,
      "text": "Bus driver. Retired."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.08,
      "end_seconds": 190.46,
      "duration_seconds": 2.38,
      "text": "Do you drink?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.48,
      "end_seconds": 195.2,
      "duration_seconds": 2.72,
      "text": "A pint on a Friday."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.55,
      "end_seconds": 202.08,
      "duration_seconds": 4.53,
      "text": "And what do you do now to keep active?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 204.45,
      "end_seconds": 209.41,
      "duration_seconds": 4.96,
      "text": "He plays bowls on Wednesdays, when he's awake."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.23,
      "end_seconds": 236.7,
      "duration_seconds": 10.47,
      "text": "Let me check you. Pulse 68, blood pressure 130 over 76, temperature 36.5, oxygen 97 percent, breathing 14, weight 83 kilos."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 238.37,
      "end_seconds": 241.64,
      "duration_seconds": 3.27,
      "text": "Is that all right? ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.45,
      "end_seconds": 260.44,
      "duration_seconds": 5.99,
      "text": "All fine. Mr Fenwick, walk to the door and back for me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.88,
      "end_seconds": 264.03,
      "duration_seconds": 2.15,
      "text": "I'll try. ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.09,
      "end_seconds": 271.93,
      "duration_seconds": 5.84,
      "text": "You're steady but slow, and you veer slightly to the left."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 273.82,
      "end_seconds": 277.04,
      "duration_seconds": 3.22,
      "text": "He does that. ~"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.66,
      "end_seconds": 286.46,
      "duration_seconds": 6.8,
      "text": "Let me tap your ankles. The reflexes at the ankles are reduced."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.4,
      "end_seconds": 291.53,
      "duration_seconds": 3.13,
      "text": "That's the diabetes. ~"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.92,
      "end_seconds": 300.43,
      "duration_seconds": 6.51,
      "text": "And the feeling in your feet is reduced to light touch."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.35,
      "end_seconds": 306.18,
      "duration_seconds": 2.83,
      "text": "Yes, they're numb. ~"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.34,
      "end_seconds": 311.42,
      "duration_seconds": 4.08,
      "text": "And there's no swelling in the ankles."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 312.54,
      "end_seconds": 314.55,
      "duration_seconds": 2.01,
      "text": "Good. ~"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.62,
      "end_seconds": 319.4,
      "duration_seconds": 2.78,
      "text": "Any trouble with your breathing?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.31,
      "end_seconds": 322.94,
      "duration_seconds": 2.63,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.47,
      "end_seconds": 337.02,
      "duration_seconds": 11.55,
      "text": "Here's what I think. The drowsiness and unsteadiness fit the higher dose of gabapentin. I think the dose is too high for you."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 339.05,
      "end_seconds": 342.68,
      "duration_seconds": 3.63,
      "text": "Can he just stop it? ~"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.18,
      "end_seconds": 355.35,
      "duration_seconds": 11.17,
      "text": "No, stopping suddenly isn't safe. I'd like to reduce the gabapentin to 300 mg, three times a day."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 357.22,
      "end_seconds": 361.14,
      "duration_seconds": 3.92,
      "text": "Will the pain come back? ~"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.45,
      "end_seconds": 376.5,
      "duration_seconds": 14.05,
      "text": "Possibly a little. That's why we'll go step by step. I'd also like to arrange blood tests, including kidney function, since gabapentin is cleared by the kidneys."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 378.2,
      "end_seconds": 381.35,
      "duration_seconds": 3.15,
      "text": "Is it his kidneys? ~"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 383.76,
      "end_seconds": 395.4,
      "duration_seconds": 11.64,
      "text": "Unlikely, but worth checking. I'd also like an HbA1c, and a vitamin B12 level, since these can cause nerve problems."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 398.07,
      "end_seconds": 399.82,
      "duration_seconds": 1.75,
      "text": "Fine. ~"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 401.57,
      "end_seconds": 405.86,
      "duration_seconds": 4.29,
      "text": "Please don't drive until the sleepiness has settled."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 408.09,
      "end_seconds": 410.34,
      "duration_seconds": 2.25,
      "text": "He won't. ~"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 412.59,
      "end_seconds": 419.15,
      "duration_seconds": 6.56,
      "text": "If the drowsiness doesn't improve in two weeks, come back and see me."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 420.03,
      "end_seconds": 423.38,
      "duration_seconds": 3.35,
      "text": "Two weeks. We'll watch him. ~"
    }
  ]
}
