{
  "schema_version": "1.0",
  "encounter_id": "00826",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.77,
      "end_seconds": 14.88,
      "duration_seconds": 14.11,
      "text": "Morning, doctor! It's my eye. The left one. It's been watering, nonstop, for about three weeks, and it's driving me up the wall. I'm forever dabbing it."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.68,
      "end_seconds": 25.53,
      "duration_seconds": 7.85,
      "text": "Tell me more about the watering. Is it worse at certain times?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.9,
      "end_seconds": 39.7,
      "duration_seconds": 12.8,
      "text": "In the wind, definitely. And when I'm reading. But even indoors, there's always a bit of a tear running down my cheek."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.78,
      "end_seconds": 44.67,
      "duration_seconds": 3.89,
      "text": "Is the eye red or painful?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.21,
      "end_seconds": 52.93,
      "duration_seconds": 6.72,
      "text": "No, no pain. It's not red, just wet. Honestly, I look like I'm crying."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.54,
      "end_seconds": 62.04,
      "duration_seconds": 6.5,
      "text": "Any discharge, or is it sticky in the morning? ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.18,
      "end_seconds": 70.29,
      "duration_seconds": 7.11,
      "text": "A tiny bit of crust, now and then. Nothing yellow. ~"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.9,
      "end_seconds": 77.26,
      "duration_seconds": 4.36,
      "text": "Any change in your vision? ~"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.21,
      "end_seconds": 83.03,
      "duration_seconds": 2.82,
      "text": "No, it's the same. ~"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.66,
      "end_seconds": 92.61,
      "duration_seconds": 6.95,
      "text": "Did you have a cold, or any eye infection before this? ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.74,
      "end_seconds": 107.28,
      "duration_seconds": 13.54,
      "text": "A cold, in the autumn. And I had my eye tested at the optician, and she said I had a bit of dryness, funnily enough."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.67,
      "end_seconds": 114.59,
      "duration_seconds": 5.92,
      "text": "Interesting, that can cause watering. What do you do for work?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.7,
      "end_seconds": 122.77,
      "duration_seconds": 6.07,
      "text": "I'm a taxi driver. Windows down in summer, a lot."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.66,
      "end_seconds": 126.94,
      "duration_seconds": 3.28,
      "text": "Pulse and temperature, please. ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.67,
      "end_seconds": 130.93,
      "duration_seconds": 2.26,
      "text": "Go on. ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.5,
      "end_seconds": 146.49,
      "duration_seconds": 2.99,
      "text": "Pulse 72, temperature 36.6."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.06,
      "end_seconds": 150.88,
      "duration_seconds": 1.82,
      "text": "Fine? ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.58,
      "end_seconds": 176.1,
      "duration_seconds": 5.52,
      "text": "Fine. Let me look at the eye. Look up, look down."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.87,
      "end_seconds": 181.1,
      "duration_seconds": 2.23,
      "text": "Like this? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.01,
      "end_seconds": 199.42,
      "duration_seconds": 17.41,
      "text": "I'm pressing gently on the corner of the eye by the nose. A little fluid comes out the wrong way, and the opening of the tear duct looks narrow."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.46,
      "end_seconds": 203.88,
      "duration_seconds": 3.42,
      "text": "What does that mean? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.7,
      "end_seconds": 219.22,
      "duration_seconds": 13.52,
      "text": "The tear drains through a tiny channel into your nose. When it's blocked or narrow, the tears have nowhere to go, and they spill over. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.76,
      "end_seconds": 223.98,
      "duration_seconds": 3.22,
      "text": "Blocked? Can that happen? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.48,
      "end_seconds": 241.13,
      "duration_seconds": 14.65,
      "text": "Yes, often with age, or after an infection. I'd say this is a partly blocked tear duct, but I can't rule out dryness of the surface, which also makes the eye water."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.05,
      "end_seconds": 246.22,
      "duration_seconds": 3.17,
      "text": "What can be done? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.84,
      "end_seconds": 259.02,
      "duration_seconds": 10.18,
      "text": "First, I'd like to arrange for you to see the eye clinic, where they can syringe the duct and check it."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.49,
      "end_seconds": 263.2,
      "duration_seconds": 2.71,
      "text": "Is it painful? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.0,
      "end_seconds": 278.3,
      "duration_seconds": 13.3,
      "text": "A little uncomfortable, not painful. And in the meantime, massage the corner of the eye gently, downwards towards the nose, a few times a day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.55,
      "end_seconds": 281.01,
      "duration_seconds": 1.46,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.87,
      "end_seconds": 290.61,
      "duration_seconds": 7.74,
      "text": "Use a warm flannel on the eye in the morning, to clear the crusts. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.86,
      "end_seconds": 294.43,
      "duration_seconds": 1.57,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.07,
      "end_seconds": 308.27,
      "duration_seconds": 12.2,
      "text": "I'd like to see you again in four weeks. If it turns red, painful, or swollen at the corner, come back sooner."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.93,
      "end_seconds": 314.54,
      "duration_seconds": 3.61,
      "text": "Four weeks. Thank you, doctor. ~"
    }
  ]
}
