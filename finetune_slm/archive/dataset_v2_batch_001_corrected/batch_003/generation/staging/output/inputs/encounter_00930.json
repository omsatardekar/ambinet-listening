{
  "schema_version": "1.0",
  "encounter_id": "00930",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 3.22,
      "end_seconds": 17.0,
      "duration_seconds": 13.78,
      "text": "Hello. I've been very tired since the doctor put me on a new heart tablet, and I get out of breath. My daughter thinks I should say something."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 21.33,
      "end_seconds": 30.4,
      "duration_seconds": 9.07,
      "text": "I'm her daughter. She's been much slower since the tablet. She naps all afternoon now."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.65,
      "end_seconds": 40.22,
      "duration_seconds": 5.57,
      "text": "Thank you. Which tablet is it, Mrs Silva? ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.45,
      "end_seconds": 49.06,
      "duration_seconds": 4.61,
      "text": "A beta-blocker, I think. It's called bisoprolol."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.39,
      "end_seconds": 58.23,
      "duration_seconds": 5.84,
      "text": "Do you remember how long ago it was started? ~"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.57,
      "end_seconds": 66.98,
      "duration_seconds": 4.41,
      "text": "Two months ago, after the heart attack."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.37,
      "end_seconds": 76.3,
      "duration_seconds": 5.93,
      "text": "I'm sorry to hear that. When does the breathlessness happen?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.31,
      "end_seconds": 87.37,
      "duration_seconds": 7.06,
      "text": "Climbing stairs, and when I walk to the shops. I used to manage it fine."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.24,
      "end_seconds": 95.07,
      "duration_seconds": 3.83,
      "text": "Any chest pain, palpitations, or fainting?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.95,
      "end_seconds": 101.07,
      "duration_seconds": 3.12,
      "text": "No chest pain. No fainting."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.5,
      "end_seconds": 108.72,
      "duration_seconds": 4.22,
      "text": "Any wheeze, or swelling in the ankles?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 112.54,
      "end_seconds": 117.68,
      "duration_seconds": 5.14,
      "text": "No swelling. She does cough a little at night."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.96,
      "end_seconds": 126.79,
      "duration_seconds": 4.83,
      "text": "Does anyone smoke at home, or have you smoked?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.65,
      "end_seconds": 134.77,
      "duration_seconds": 4.12,
      "text": "I stopped when I had the heart attack."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.54,
      "end_seconds": 144.59,
      "duration_seconds": 6.05,
      "text": "Good for you. Do you have any allergies to medicines?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.34,
      "end_seconds": 150.08,
      "duration_seconds": 1.74,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.98,
      "end_seconds": 161.45,
      "duration_seconds": 7.47,
      "text": "Let me listen to your heart and lungs and feel your pulse. ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.91,
      "end_seconds": 181.6,
      "duration_seconds": 1.69,
      "text": "Go on."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.73,
      "end_seconds": 195.87,
      "duration_seconds": 11.14,
      "text": "Your heart rate is slow, around fifty, and regular. Your lungs are clear, and your ankles are not swollen."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 199.69,
      "end_seconds": 202.85,
      "duration_seconds": 3.16,
      "text": "Is that too slow? ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.86,
      "end_seconds": 220.23,
      "duration_seconds": 13.37,
      "text": "A bit slow, which can make people feel tired. It may be the beta-blocker, and her heart condition may also play a part."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.21,
      "end_seconds": 227.25,
      "duration_seconds": 4.04,
      "text": "Do I have to stop it? ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.93,
      "end_seconds": 242.93,
      "duration_seconds": 12.0,
      "text": "Please don't stop it on your own, because it protects your heart after a heart attack. I'd like to check things first. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 245.87,
      "end_seconds": 247.96,
      "duration_seconds": 2.09,
      "text": "What checks? ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.99,
      "end_seconds": 259.0,
      "duration_seconds": 7.01,
      "text": "I'll arrange a heart tracing today, and a blood test for anaemia and thyroid."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 262.59,
      "end_seconds": 264.8,
      "duration_seconds": 2.21,
      "text": "And then? ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.8,
      "end_seconds": 276.48,
      "duration_seconds": 7.68,
      "text": "Depending on the results, I might lower the dose, or discuss it with her cardiologist."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.37,
      "end_seconds": 283.92,
      "duration_seconds": 4.55,
      "text": "All right. I'd rather feel less tired. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.0,
      "end_seconds": 299.12,
      "duration_seconds": 11.12,
      "text": "I'll phone you with the results. If you become faint, get chest pain, or are very breathless, call an ambulance."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 302.36,
      "end_seconds": 305.97,
      "duration_seconds": 3.61,
      "text": "We will. Thank you, doctor. ~"
    }
  ]
}
