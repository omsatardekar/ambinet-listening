{
  "schema_version": "1.0",
  "encounter_id": "00940",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 0.86,
      "end_seconds": 8.81,
      "duration_seconds": 7.95,
      "text": "Mrs Thackeray? Is that Moira, or Maureen? I've two on the list this morning. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.59,
      "end_seconds": 16.09,
      "duration_seconds": 6.5,
      "text": "Moira, love. Maureen's my sister, she's the one with the hip. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.06,
      "end_seconds": 23.18,
      "duration_seconds": 6.12,
      "text": "Moira it is. So, what can I do for you today? ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.43,
      "end_seconds": 37.59,
      "duration_seconds": 12.16,
      "text": "Oh, I'm after a check on my tablet, the omeprazole, for the heartburn. It's due, they sent me a text."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.38,
      "end_seconds": 42.48,
      "duration_seconds": 4.1,
      "text": "Good. Tell me how you take it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.72,
      "end_seconds": 55.02,
      "duration_seconds": 10.3,
      "text": "One a day, 20 milligrams, I think. Maybe 40? The box is at home. In the morning, before breakfast, when I remember."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.24,
      "end_seconds": 60.91,
      "duration_seconds": 4.67,
      "text": "When you remember. How often do you forget?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.23,
      "end_seconds": 75.4,
      "duration_seconds": 12.17,
      "text": "Oh, the odd day. A few days a week, perhaps. I put it by the kettle, but then I have my tea and off I go."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.42,
      "end_seconds": 84.79,
      "duration_seconds": 7.37,
      "text": "Thank you for being honest. Is that the only tablet you take? ~"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.19,
      "end_seconds": 90.24,
      "duration_seconds": 3.05,
      "text": "That's the only one, yes. ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.14,
      "end_seconds": 99.89,
      "duration_seconds": 8.75,
      "text": "Now, I see here a note on your allergies. Can you tell me about that?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.56,
      "end_seconds": 111.63,
      "duration_seconds": 10.07,
      "text": "Penicillin. Years ago, I came out in a rash, all over my back. The doctor said never again."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.22,
      "end_seconds": 121.28,
      "duration_seconds": 7.06,
      "text": "That's very clear. Anything else in your medical history I should know about?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.34,
      "end_seconds": 127.21,
      "duration_seconds": 4.87,
      "text": "The reflux, of course, and the blood pressure."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.36,
      "end_seconds": 133.29,
      "duration_seconds": 3.93,
      "text": "Is the blood pressure treated? ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.41,
      "end_seconds": 139.77,
      "duration_seconds": 4.36,
      "text": "With diet, they said. Less salt. ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.4,
      "end_seconds": 147.39,
      "duration_seconds": 4.99,
      "text": "Good. And how are you getting on generally? ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.56,
      "end_seconds": 155.25,
      "duration_seconds": 6.69,
      "text": "Oh, can't complain. Busy, you know. I've got the grandchildren Tuesdays. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.96,
      "end_seconds": 184.34,
      "duration_seconds": 12.38,
      "text": "Lovely. Let me check your numbers. Pulse 70, blood pressure 130 over 78, temperature 36.6, oxygen 98 percent, breathing 14, weight 71 kilos."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.22,
      "end_seconds": 190.14,
      "duration_seconds": 2.92,
      "text": "Is that good? ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.52,
      "end_seconds": 203.72,
      "duration_seconds": 4.2,
      "text": "Very good. Let me feel your tummy."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.15,
      "end_seconds": 208.57,
      "duration_seconds": 2.42,
      "text": "Cold hands. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.73,
      "end_seconds": 217.5,
      "duration_seconds": 7.77,
      "text": "Your abdomen is soft. And there's no tenderness at the top of the tummy."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.8,
      "end_seconds": 221.76,
      "duration_seconds": 1.96,
      "text": "Good. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.24,
      "end_seconds": 226.86,
      "duration_seconds": 3.62,
      "text": "So the reflux sounds well controlled."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.55,
      "end_seconds": 231.51,
      "duration_seconds": 2.96,
      "text": "It has been, yes. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.83,
      "end_seconds": 241.26,
      "duration_seconds": 8.43,
      "text": "How about the number of tablets you miss? Do you think we could change the routine? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.33,
      "end_seconds": 245.65,
      "duration_seconds": 3.32,
      "text": "Put it with my toothbrush? ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.24,
      "end_seconds": 253.49,
      "duration_seconds": 5.25,
      "text": "That's an excellent idea. Brush, then tablet, then breakfast. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.48,
      "end_seconds": 257.87,
      "duration_seconds": 2.39,
      "text": "I'll try that. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.58,
      "end_seconds": 268.29,
      "duration_seconds": 9.71,
      "text": "I'll check the pharmacy record for the exact dose, because 20 and 40 are quite different. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.73,
      "end_seconds": 274.32,
      "duration_seconds": 4.59,
      "text": "I'd hate to be on the wrong one. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.79,
      "end_seconds": 281.35,
      "duration_seconds": 4.56,
      "text": "Anything else you wanted to talk about? ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.98,
      "end_seconds": 287.32,
      "duration_seconds": 3.34,
      "text": "No, that's it, love. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.59,
      "end_seconds": 294.94,
      "duration_seconds": 6.35,
      "text": "Good. I'd like to see you again in three months to review it."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.85,
      "end_seconds": 301.72,
      "duration_seconds": 5.87,
      "text": "Three months. I'll put it in my diary. ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.17,
      "end_seconds": 306.47,
      "duration_seconds": 3.3,
      "text": "Lovely. Look after yourself, Moira. ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.85,
      "end_seconds": 314.15,
      "duration_seconds": 6.3,
      "text": "And you, love. Give my best to the nurse. ~"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.04,
      "end_seconds": 317.56,
      "duration_seconds": 2.52,
      "text": "I will. ~"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.4,
      "end_seconds": 322.24,
      "duration_seconds": 2.84,
      "text": "Right, that's me. ~"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.29,
      "end_seconds": 325.94,
      "duration_seconds": 2.65,
      "text": "Bye for now. ~"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.8,
      "end_seconds": 331.14,
      "duration_seconds": 2.34,
      "text": "Bye bye. ~"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.85,
      "end_seconds": 335.73,
      "duration_seconds": 1.88,
      "text": "Take care. ~"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.68,
      "end_seconds": 340.26,
      "duration_seconds": 1.58,
      "text": "Cheerio. ~"
    }
  ]
}
