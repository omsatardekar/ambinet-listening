{
  "schema_version": "1.0",
  "encounter_id": "00846",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 0.98,
      "end_seconds": 11.26,
      "duration_seconds": 10.28,
      "text": "Doctor, this is Mr Ahmed, thirty-one, back from Karachi nine days ago, fever, abdominal pain, and he looks unwell. Obs done."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.74,
      "end_seconds": 26.41,
      "duration_seconds": 12.67,
      "text": "Doctor, I have a high fever, a terrible headache, and my tummy hurts. I think I ate some street food, chaat, in Karachi."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.02,
      "end_seconds": 36.09,
      "duration_seconds": 7.07,
      "text": "Mr Ahmed, I'm Dr Reid. Let's go through this carefully. When did the fever start?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.42,
      "end_seconds": 46.64,
      "duration_seconds": 9.22,
      "text": "Five days ago. It has gone up every evening, to about 39 or 40. And I feel so weak."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.15,
      "end_seconds": 51.56,
      "duration_seconds": 2.41,
      "text": "Any diarrhoea, or constipation?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.67,
      "end_seconds": 56.63,
      "duration_seconds": 2.96,
      "text": "First some diarrhoea. Now constipated."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.48,
      "end_seconds": 60.38,
      "duration_seconds": 2.9,
      "text": "Where is the tummy pain?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.1,
      "end_seconds": 67.39,
      "duration_seconds": 4.29,
      "text": "Around the belly button, and on the right."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.68,
      "end_seconds": 70.39,
      "duration_seconds": 1.71,
      "text": "Any vomiting?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.3,
      "end_seconds": 74.62,
      "duration_seconds": 3.32,
      "text": "No vomiting. A little nausea."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.35,
      "end_seconds": 80.59,
      "duration_seconds": 3.24,
      "text": "Any rash on your chest?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.44,
      "end_seconds": 83.19,
      "duration_seconds": 1.75,
      "text": "No rash."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.99,
      "end_seconds": 88.9,
      "duration_seconds": 4.91,
      "text": "Any blood in the stool, or bleeding anywhere?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.7,
      "end_seconds": 92.68,
      "duration_seconds": 1.98,
      "text": "No blood."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 110.62,
      "end_seconds": 120.27,
      "duration_seconds": 9.65,
      "text": "Doctor, his observations. Temperature 39.2, pulse 84, blood pressure 108 over 66, oxygen 97 percent, respiratory rate 20."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.56,
      "end_seconds": 134.58,
      "duration_seconds": 13.02,
      "text": "Thank you, Faith. Mr Ahmed, a slow pulse with a high fever is a clue. Did you have typhoid vaccination before the trip? ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.03,
      "end_seconds": 143.59,
      "duration_seconds": 6.56,
      "text": "No. I was born there, I thought I was immune. ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.01,
      "end_seconds": 148.58,
      "duration_seconds": 2.57,
      "text": "Any allergies to medicines?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.47,
      "end_seconds": 151.07,
      "duration_seconds": 1.6,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.22,
      "end_seconds": 155.98,
      "duration_seconds": 3.76,
      "text": "Do you take any tablets?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.44,
      "end_seconds": 163.75,
      "duration_seconds": 5.31,
      "text": "Paracetamol, 1 gram, every six hours, for the fever."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.23,
      "end_seconds": 169.16,
      "duration_seconds": 3.93,
      "text": "What do you do for work?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.52,
      "end_seconds": 173.78,
      "duration_seconds": 2.26,
      "text": "I'm a chef."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.66,
      "end_seconds": 196.69,
      "duration_seconds": 3.03,
      "text": "Let me examine your tummy."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.13,
      "end_seconds": 202.18,
      "duration_seconds": 3.05,
      "text": "Ahh, it hurts. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.05,
      "end_seconds": 214.15,
      "duration_seconds": 10.1,
      "text": "Your tummy is tender in the lower right, and there's a mild fullness, and I can feel your spleen tip."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.12,
      "end_seconds": 217.94,
      "duration_seconds": 2.82,
      "text": "Is it appendicitis? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.45,
      "end_seconds": 236.87,
      "duration_seconds": 16.42,
      "text": "I don't think so. A prolonged fever rising each evening, a slow pulse for the temperature, abdominal pain, after travel to South Asia, and street food, makes me think of typhoid fever."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.61,
      "end_seconds": 242.07,
      "duration_seconds": 3.46,
      "text": "Typhoid? Is it serious? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.22,
      "end_seconds": 260.54,
      "duration_seconds": 16.32,
      "text": "It can be, but it's treatable with the right antibiotics. It needs blood cultures to confirm. I'd like to take blood cultures now, and a full set of blood tests, and a stool sample."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 262.34,
      "end_seconds": 266.56,
      "duration_seconds": 4.22,
      "text": "I'll set up the cultures, doctor. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.1,
      "end_seconds": 281.58,
      "duration_seconds": 12.48,
      "text": "And I'm going to send you to the infectious diseases ward today, to be admitted, so you can have intravenous antibiotics, and be monitored."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.47,
      "end_seconds": 286.05,
      "duration_seconds": 2.58,
      "text": "Admitted? How long? ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.1,
      "end_seconds": 292.56,
      "duration_seconds": 5.46,
      "text": "A few days. Until the fever settles. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.32,
      "end_seconds": 297.87,
      "duration_seconds": 4.55,
      "text": "Will my family be at risk? ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.0,
      "end_seconds": 311.55,
      "duration_seconds": 12.55,
      "text": "Typhoid can spread through contaminated food and water, so wash your hands thoroughly, don't prepare food for others, and don't share utensils."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.14,
      "end_seconds": 316.14,
      "duration_seconds": 3.0,
      "text": "I'll be careful. ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.78,
      "end_seconds": 325.67,
      "duration_seconds": 6.89,
      "text": "Faith will arrange the ward, and I'll see you there this evening."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.69,
      "end_seconds": 329.35,
      "duration_seconds": 2.66,
      "text": "Thank you, doctor. ~"
    }
  ]
}
