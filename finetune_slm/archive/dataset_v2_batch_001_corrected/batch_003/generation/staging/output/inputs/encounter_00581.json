{
  "schema_version": "1.0",
  "encounter_id": "00581",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.7,
      "end_seconds": 9.8,
      "duration_seconds": 9.1,
      "text": "Doctor, I've been feeling so dizzy since the new tablet, and I'm honestly a bit scared."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.94,
      "end_seconds": 15.57,
      "duration_seconds": 4.63,
      "text": "Okay, let's work through it. Which new tablet is that?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.16,
      "end_seconds": 25.17,
      "duration_seconds": 8.01,
      "text": "The blood pressure one. Amlodipine, 5 mg, in the morning. You started it two weeks ago."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.92,
      "end_seconds": 29.36,
      "duration_seconds": 3.44,
      "text": "Right. And when does the dizziness hit?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.22,
      "end_seconds": 38.4,
      "duration_seconds": 8.18,
      "text": "When I stand up quick. The room kind of tilts, and I've got to grab the bench."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.97,
      "end_seconds": 43.03,
      "duration_seconds": 3.06,
      "text": "How long does it last?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.7,
      "end_seconds": 55.15,
      "duration_seconds": 9.45,
      "text": "Ten seconds or so. Then it passes. But what if I fall? I drive a taxi, doctor."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.08,
      "end_seconds": 61.41,
      "duration_seconds": 4.33,
      "text": "I understand. Anything else that's changed since the tablet?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.43,
      "end_seconds": 68.65,
      "duration_seconds": 5.22,
      "text": "Headaches. Mild ones, behind my eyes, mostly in the afternoon."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.13,
      "end_seconds": 71.65,
      "duration_seconds": 1.52,
      "text": "Anything else?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.11,
      "end_seconds": 79.62,
      "duration_seconds": 6.51,
      "text": "Tired. I'm flat out by three o'clock, and I used to be fine."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.39,
      "end_seconds": 86.74,
      "duration_seconds": 5.35,
      "text": "Has your heart been doing anything odd? Racing, skipping?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.04,
      "end_seconds": 95.91,
      "duration_seconds": 6.87,
      "text": "Sometimes it's racing, like it's thumping, when I get the dizzy spell."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.73,
      "end_seconds": 100.79,
      "duration_seconds": 4.06,
      "text": "Okay. Any blurred vision with the spells?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.66,
      "end_seconds": 107.39,
      "duration_seconds": 4.73,
      "text": "A bit blurry, yes, just for a second or two."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.66,
      "end_seconds": 112.77,
      "duration_seconds": 4.11,
      "text": "Have you actually fainted or passed out?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.59,
      "end_seconds": 121.55,
      "duration_seconds": 7.96,
      "text": "No, I've never passed out. Got close once at the servo but I held on."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.35,
      "end_seconds": 127.4,
      "duration_seconds": 5.05,
      "text": "Any numbness or weakness down one side, or trouble speaking?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.71,
      "end_seconds": 133.85,
      "duration_seconds": 4.14,
      "text": "No, nothing like that. Just the dizziness."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.17,
      "end_seconds": 138.25,
      "duration_seconds": 3.08,
      "text": "Any chest pain with this?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.51,
      "end_seconds": 144.42,
      "duration_seconds": 4.91,
      "text": "No chest pain. I'd have called an ambulance."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.29,
      "end_seconds": 148.28,
      "duration_seconds": 2.99,
      "text": "Good. Any trouble with your breathing?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.69,
      "end_seconds": 152.62,
      "duration_seconds": 2.93,
      "text": "Breathing's fine. Same as always."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.26,
      "end_seconds": 157.46,
      "duration_seconds": 4.2,
      "text": "And your stomach and bowels? Anything off there?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.61,
      "end_seconds": 161.51,
      "duration_seconds": 2.9,
      "text": "All normal, thanks. Nothing there."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.26,
      "end_seconds": 167.53,
      "duration_seconds": 5.27,
      "text": "Let's go through your tablets. Amlodipine, and what else?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.81,
      "end_seconds": 178.91,
      "duration_seconds": 10.1,
      "text": "Atorvastatin, 40 mg at night. And the water tablet, um, maybe 20 mg? I'd have to check the box."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.9,
      "end_seconds": 185.01,
      "duration_seconds": 4.11,
      "text": "That's the frusemide you take with breakfast?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.26,
      "end_seconds": 193.58,
      "duration_seconds": 7.32,
      "text": "Yeah, that's the one. I just call it the water tablet. The dose, I'm not sure."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.99,
      "end_seconds": 203.59,
      "duration_seconds": 7.6,
      "text": "We'll check the box before you go. And have you ever had any allergies to medicines?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.91,
      "end_seconds": 215.59,
      "duration_seconds": 9.68,
      "text": "Penicillin, when I was a kid. I came out in a rash. Mum said never again, so I've avoided it since."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.76,
      "end_seconds": 223.51,
      "duration_seconds": 5.75,
      "text": "Penicillin, with a rash. I'll put that on your record."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.89,
      "end_seconds": 231.05,
      "duration_seconds": 5.16,
      "text": "What other conditions are you managing? Apart from your blood pressure."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.91,
      "end_seconds": 242.6,
      "duration_seconds": 10.69,
      "text": "High blood pressure for about five years. And high cholesterol. And a bit of reflux, which flares up at night."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.82,
      "end_seconds": 246.53,
      "duration_seconds": 1.71,
      "text": "Any operations?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.57,
      "end_seconds": 250.82,
      "duration_seconds": 3.25,
      "text": "A hernia repair, in 2019."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.93,
      "end_seconds": 255.79,
      "duration_seconds": 3.86,
      "text": "Any heart trouble or strokes in the family?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.48,
      "end_seconds": 264.07,
      "duration_seconds": 6.59,
      "text": "Dad had a heart attack at fifty-eight. And Mum had a stroke in her seventies."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.28,
      "end_seconds": 269.79,
      "duration_seconds": 3.51,
      "text": "Thanks, that's important. Do you smoke?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.47,
      "end_seconds": 274.4,
      "duration_seconds": 2.93,
      "text": "Never smoked. Never really liked it."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.67,
      "end_seconds": 278.57,
      "duration_seconds": 1.9,
      "text": "And alcohol?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.11,
      "end_seconds": 284.3,
      "duration_seconds": 4.19,
      "text": "A couple of beers on the weekend. Nothing silly."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.97,
      "end_seconds": 290.53,
      "duration_seconds": 3.56,
      "text": "You said you drive a taxi. Full-time?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.72,
      "end_seconds": 302.03,
      "duration_seconds": 9.31,
      "text": "Yep, nights mostly. Twelve hours. I live with my wife, she's the one who nags me to come in."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.2,
      "end_seconds": 314.32,
      "duration_seconds": 7.12,
      "text": "Let me check you over. Stay seated while I take your pressure."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.31,
      "end_seconds": 328.98,
      "duration_seconds": 7.67,
      "text": "Sitting, your blood pressure is 128 over 76. Now stand up for me, slowly."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.18,
      "end_seconds": 336.68,
      "duration_seconds": 6.5,
      "text": "Standing, it drops to 112 over 70. How do you feel?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.59,
      "end_seconds": 341.88,
      "duration_seconds": 3.29,
      "text": "A bit swimmy, but I'm all right."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.28,
      "end_seconds": 349.47,
      "duration_seconds": 5.19,
      "text": "Pulse is 82, temperature 36.6 degrees, and oxygen is 97 percent."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.12,
      "end_seconds": 361.51,
      "duration_seconds": 4.39,
      "text": "A modest drop. Let me listen to your chest."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.85,
      "end_seconds": 369.64,
      "duration_seconds": 5.79,
      "text": "Heart sounds are normal, and your chest is clear on both sides."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.31,
      "end_seconds": 380.54,
      "duration_seconds": 7.23,
      "text": "I can see mild swelling around both ankles, though. Your calves are soft, with no tenderness."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 382.22,
      "end_seconds": 387.26,
      "duration_seconds": 5.04,
      "text": "The ankles, yeah. I noticed my socks leave marks."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 389.07,
      "end_seconds": 397.16,
      "duration_seconds": 8.09,
      "text": "That fits. Amlodipine can cause ankle swelling and a drop in pressure when you stand."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 399.17,
      "end_seconds": 403.42,
      "duration_seconds": 4.25,
      "text": "So it's the tablet? Should I stop it?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 404.13,
      "end_seconds": 412.4,
      "duration_seconds": 8.27,
      "text": "From what you've told me and what I found, it looks like a side effect of the amlodipine."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 413.46,
      "end_seconds": 419.89,
      "duration_seconds": 6.43,
      "text": "Is it dangerous? Could I have a heart problem on top of it?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 422.19,
      "end_seconds": 431.81,
      "duration_seconds": 9.62,
      "text": "I don't think so, but because your dad had a heart attack, I'd like to arrange an ECG today."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 432.84,
      "end_seconds": 434.42,
      "duration_seconds": 1.58,
      "text": "Okay. Now?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 436.46,
      "end_seconds": 445.5,
      "duration_seconds": 9.04,
      "text": "The nurse can do it before you leave. I'd also like to order blood tests, for your kidneys and your salts."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 447.91,
      "end_seconds": 450.94,
      "duration_seconds": 3.03,
      "text": "Because of the water tablet?"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 453.21,
      "end_seconds": 458.76,
      "duration_seconds": 5.55,
      "text": "Exactly. Water tablets can upset the salts, which can also cause dizziness."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 461.27,
      "end_seconds": 465.75,
      "duration_seconds": 4.48,
      "text": "So do I keep taking everything meanwhile?"
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 468.19,
      "end_seconds": 478.69,
      "duration_seconds": 10.5,
      "text": "Yes, for now. Stand up slowly, sit on the edge of the bed first, and drink water through the day."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 480.44,
      "end_seconds": 484.34,
      "duration_seconds": 3.9,
      "text": "And driving? I can't afford to stop."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 486.63,
      "end_seconds": 493.13,
      "duration_seconds": 6.5,
      "text": "Don't drive if you feel a spell coming. Pull over until it passes."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 495.11,
      "end_seconds": 498.65,
      "duration_seconds": 3.54,
      "text": "Okay. What if it doesn't go away?"
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 499.9,
      "end_seconds": 508.16,
      "duration_seconds": 8.26,
      "text": "If the dizziness doesn't settle in two weeks, come back and see me, and we'll change the tablet."
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 509.87,
      "end_seconds": 514.38,
      "duration_seconds": 4.51,
      "text": "Righto. Thanks, doctor. You've settled my nerves a bit."
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 516.66,
      "end_seconds": 524.97,
      "duration_seconds": 8.31,
      "text": "Good. Check that water tablet box on your way out, and tell the nurse the dose."
    }
  ]
}
