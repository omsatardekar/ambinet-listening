{
  "schema_version": "1.0",
  "encounter_id": "00637",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.82,
      "end_seconds": 12.78,
      "duration_seconds": 11.96,
      "text": "Morning. I'll not keep you long. I've still got this chest, and I thought it would have gone by now."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.54,
      "end_seconds": 21.22,
      "duration_seconds": 5.68,
      "text": "It's no bother, take your time. What's it been like? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.38,
      "end_seconds": 35.31,
      "duration_seconds": 12.93,
      "text": "I've had it nearly two weeks. I had a course from the walk-in centre, finished it on Sunday, and I'm no better, really."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.99,
      "end_seconds": 43.19,
      "duration_seconds": 5.2,
      "text": "What are you noticing? Cough, or breathlessness, or both?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.19,
      "end_seconds": 55.85,
      "duration_seconds": 9.66,
      "text": "A cough, mainly. Wet, and I'm bringing up green phlegm in the mornings. Most of the day, really."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.86,
      "end_seconds": 62.11,
      "duration_seconds": 4.25,
      "text": "How much, would you say, a spoonful, more?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.55,
      "end_seconds": 70.63,
      "duration_seconds": 6.08,
      "text": "A couple of spoonfuls in the morning, less in the day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.82,
      "end_seconds": 75.94,
      "duration_seconds": 2.12,
      "text": "And your breathing?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.49,
      "end_seconds": 85.7,
      "duration_seconds": 7.21,
      "text": "Breathless on the stairs. I stop halfway up at work, and I never used to."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.8,
      "end_seconds": 92.47,
      "duration_seconds": 5.67,
      "text": "Does anything make it worse, lying down, cold air? ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.53,
      "end_seconds": 102.21,
      "duration_seconds": 6.68,
      "text": "Not that I've noticed. It's worse when I get a coughing fit. ~"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.01,
      "end_seconds": 106.1,
      "duration_seconds": 2.09,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.05,
      "end_seconds": 113.09,
      "duration_seconds": 4.04,
      "text": "About ten a day. I know, I know."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.91,
      "end_seconds": 126.28,
      "duration_seconds": 11.37,
      "text": "Tell you what, I won't lecture you today, but I'll bring it up again, if that's all right. ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.06,
      "end_seconds": 131.39,
      "duration_seconds": 2.33,
      "text": "Fair enough. ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.06,
      "end_seconds": 142.98,
      "duration_seconds": 8.92,
      "text": "Take a deep breath in for me, through your mouth. I'll listen to your back. ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.07,
      "end_seconds": 148.05,
      "duration_seconds": 1.98,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.2,
      "end_seconds": 170.15,
      "duration_seconds": 1.95,
      "text": "And out. Again."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.91,
      "end_seconds": 174.26,
      "duration_seconds": 2.35,
      "text": "Is it bad? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.5,
      "end_seconds": 187.96,
      "duration_seconds": 12.46,
      "text": "I can hear some crackles at the bottom of the right lung, and a bit of wheeze on the left."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.19,
      "end_seconds": 192.71,
      "duration_seconds": 2.52,
      "text": "Is that pneumonia? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.94,
      "end_seconds": 204.35,
      "duration_seconds": 10.41,
      "text": "I'm not going to jump to a label yet. It tells me there's still some infection or inflammation down there. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.85,
      "end_seconds": 211.97,
      "duration_seconds": 6.12,
      "text": "What do we do? I thought the tablets would sort it. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.5,
      "end_seconds": 227.57,
      "duration_seconds": 13.07,
      "text": "Sometimes a chest takes longer to settle than the course lasts, especially in a smoker. I'd like you to give it a few more days. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.2,
      "end_seconds": 234.07,
      "duration_seconds": 3.87,
      "text": "And if it's not better? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.53,
      "end_seconds": 248.45,
      "duration_seconds": 11.92,
      "text": "If it's not better in a week, I'd want a chest X-ray to see what's going on in the lung."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.54,
      "end_seconds": 252.55,
      "duration_seconds": 3.01,
      "text": "A week. Right. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.21,
      "end_seconds": 264.6,
      "duration_seconds": 10.39,
      "text": "Keep drinking lots of fluids, and try not to suppress the cough at night, you want to clear it."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.82,
      "end_seconds": 269.54,
      "duration_seconds": 3.72,
      "text": "Should I stay off work? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.19,
      "end_seconds": 277.93,
      "duration_seconds": 6.74,
      "text": "Only if you feel you need to. Rest when you can. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.15,
      "end_seconds": 285.75,
      "duration_seconds": 4.6,
      "text": "Right. I'll see how I go. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.29,
      "end_seconds": 296.38,
      "duration_seconds": 9.09,
      "text": "And come in sooner if you cough up blood, get a high temperature, or get much more breathless."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.17,
      "end_seconds": 301.18,
      "duration_seconds": 3.01,
      "text": "I will, doctor. Thanks. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.72,
      "end_seconds": 306.03,
      "duration_seconds": 2.31,
      "text": "Take care. ~"
    }
  ]
}
