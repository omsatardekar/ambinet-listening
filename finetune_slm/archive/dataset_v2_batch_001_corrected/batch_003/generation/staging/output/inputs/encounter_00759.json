{
  "schema_version": "1.0",
  "encounter_id": "00759",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 3.15,
      "end_seconds": 6.79,
      "duration_seconds": 3.64,
      "text": "Morning. Come for the stroke review."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.58,
      "end_seconds": 18.04,
      "duration_seconds": 7.46,
      "text": "Good morning, Mr Hale. It's three months since your stroke. How's the physio going?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.95,
      "end_seconds": 25.2,
      "duration_seconds": 3.25,
      "text": "Good. Walking better. Hand's slower."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.37,
      "end_seconds": 29.69,
      "duration_seconds": 1.32,
      "text": "Which hand?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.52,
      "end_seconds": 35.96,
      "duration_seconds": 3.44,
      "text": "Right. Can't do buttons yet."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.46,
      "end_seconds": 43.46,
      "duration_seconds": 4.0,
      "text": "Any new weakness, numbness, or speech problems?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.24,
      "end_seconds": 49.05,
      "duration_seconds": 1.81,
      "text": "No. None."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.98,
      "end_seconds": 55.93,
      "duration_seconds": 2.95,
      "text": "Any falls, or near-falls?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.7,
      "end_seconds": 60.16,
      "duration_seconds": 1.46,
      "text": "No falls."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.81,
      "end_seconds": 70.22,
      "duration_seconds": 6.41,
      "text": "Good. Let me see you do some things. Squeeze my fingers. ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.31,
      "end_seconds": 88.95,
      "duration_seconds": 1.64,
      "text": "Like this?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.09,
      "end_seconds": 100.77,
      "duration_seconds": 8.68,
      "text": "Good grip, a bit weaker on the right than the left, but better than last time."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.97,
      "end_seconds": 108.05,
      "duration_seconds": 3.08,
      "text": "Is that good? ~"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.11,
      "end_seconds": 122.4,
      "duration_seconds": 11.29,
      "text": "It's improving. Now walk to the door and back, and then touch your nose with your right finger. ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.72,
      "end_seconds": 146.11,
      "duration_seconds": 1.39,
      "text": "Right."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.68,
      "end_seconds": 159.43,
      "duration_seconds": 9.75,
      "text": "A slightly slow, careful gait with a mild drag of the right foot, steady, no stumbling. ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.01,
      "end_seconds": 166.54,
      "duration_seconds": 3.53,
      "text": "I've been doing the exercises. ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.82,
      "end_seconds": 178.31,
      "duration_seconds": 7.49,
      "text": "It shows. Have you started anything new, a new activity, or driving? ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.28,
      "end_seconds": 185.46,
      "duration_seconds": 3.18,
      "text": "Not driving. Doctor said no. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.32,
      "end_seconds": 194.6,
      "duration_seconds": 5.28,
      "text": "Correct. Sensible. And how are you managing at home?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.46,
      "end_seconds": 201.45,
      "duration_seconds": 3.99,
      "text": "I live with my daughter. She helps."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.91,
      "end_seconds": 210.7,
      "duration_seconds": 5.79,
      "text": "Your operation was on your neck, wasn't it, your carotid artery?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.6,
      "end_seconds": 219.3,
      "duration_seconds": 4.7,
      "text": "Yes. The left. Before the stroke. A year ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.1,
      "end_seconds": 234.47,
      "duration_seconds": 11.37,
      "text": "Right. The surgeon wanted a scan of that side, to check it's staying open, so I'd like to arrange a carotid ultrasound."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.68,
      "end_seconds": 239.32,
      "duration_seconds": 1.64,
      "text": "When? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.48,
      "end_seconds": 248.01,
      "duration_seconds": 4.53,
      "text": "Within a month. The hospital will write. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.37,
      "end_seconds": 253.37,
      "duration_seconds": 2.0,
      "text": "Fine. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.65,
      "end_seconds": 266.79,
      "duration_seconds": 9.14,
      "text": "Keep up the exercises, and the hand ones are important, with putty or buttons or coins."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.97,
      "end_seconds": 273.31,
      "duration_seconds": 2.34,
      "text": "Buttons. Yes. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.62,
      "end_seconds": 285.33,
      "duration_seconds": 8.71,
      "text": "And if you notice a sudden weakness, a drooping face, slurred speech, call 999 immediately, don't wait."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.38,
      "end_seconds": 292.2,
      "duration_seconds": 2.82,
      "text": "I know. FAST. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.5,
      "end_seconds": 300.36,
      "duration_seconds": 4.86,
      "text": "Exactly. Well done for working so hard. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.65,
      "end_seconds": 306.02,
      "duration_seconds": 2.37,
      "text": "Thank you. ~"
    }
  ]
}
