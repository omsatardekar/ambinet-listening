{
  "schema_version": "1.0",
  "encounter_id": "00839",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 0.45,
      "end_seconds": 10.46,
      "duration_seconds": 10.01,
      "text": "Hello, doctor. I'm Chloe's mum. It's about her wetting the bed. She's eight. I feel awful about it."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.18,
      "end_seconds": 19.62,
      "duration_seconds": 8.44,
      "text": "Please don't. It's very common. Chloe, how are you feeling about coming today? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.62,
      "end_seconds": 23.54,
      "duration_seconds": 1.92,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.8,
      "end_seconds": 30.33,
      "duration_seconds": 4.53,
      "text": "Mum, how often does she wet the bed?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 32.61,
      "end_seconds": 43.51,
      "duration_seconds": 10.9,
      "text": "Almost every night, five or six nights a week. She's never been dry for more than a week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.41,
      "end_seconds": 50.55,
      "duration_seconds": 6.14,
      "text": "Has she ever been dry for a long time, like six months? ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 52.58,
      "end_seconds": 55.66,
      "duration_seconds": 3.08,
      "text": "No, never, not once. ~"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.6,
      "end_seconds": 62.72,
      "duration_seconds": 4.12,
      "text": "Does she wet during the day, too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 65.67,
      "end_seconds": 68.94,
      "duration_seconds": 3.27,
      "text": "No. Never in the day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.3,
      "end_seconds": 78.59,
      "duration_seconds": 7.29,
      "text": "Any burning or pain when she passes urine, or going very often?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 81.09,
      "end_seconds": 83.78,
      "duration_seconds": 2.69,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.09,
      "end_seconds": 89.13,
      "duration_seconds": 3.04,
      "text": "And her bowels, any constipation?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 91.48,
      "end_seconds": 94.03,
      "duration_seconds": 2.55,
      "text": "No, they're regular."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.62,
      "end_seconds": 100.79,
      "duration_seconds": 4.17,
      "text": "Is she very thirsty, or drinking lots? ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 102.46,
      "end_seconds": 108.55,
      "duration_seconds": 6.09,
      "text": "No, she drinks normally, but mostly in the evening. ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.98,
      "end_seconds": 115.09,
      "duration_seconds": 5.11,
      "text": "Chloe, do you want to be dry at night? ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.45,
      "end_seconds": 122.11,
      "duration_seconds": 4.66,
      "text": "Yes. I don't like sleepovers. I'm scared. ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.99,
      "end_seconds": 129.62,
      "duration_seconds": 4.63,
      "text": "That sounds hard. Does it run in the family?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 131.62,
      "end_seconds": 137.93,
      "duration_seconds": 6.31,
      "text": "Yes. Her dad was a bed-wetter until he was ten. And his sister."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.79,
      "end_seconds": 141.99,
      "duration_seconds": 2.2,
      "text": "Any health conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 144.45,
      "end_seconds": 149.36,
      "duration_seconds": 4.91,
      "text": "She has eczema, and she's had her tonsils out."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.21,
      "end_seconds": 154.71,
      "duration_seconds": 2.5,
      "text": "When was that?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 157.68,
      "end_seconds": 159.44,
      "duration_seconds": 1.76,
      "text": "Last year."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.49,
      "end_seconds": 162.83,
      "duration_seconds": 1.34,
      "text": "Any medicines?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 164.23,
      "end_seconds": 169.15,
      "duration_seconds": 4.92,
      "text": "Just an emollient for the eczema, twice a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.38,
      "end_seconds": 178.65,
      "duration_seconds": 8.27,
      "text": "Let me weigh her, and check her. Chloe, hop on the scales. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.38,
      "end_seconds": 183.12,
      "duration_seconds": 1.74,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.0,
      "end_seconds": 207.08,
      "duration_seconds": 6.08,
      "text": "Weight 26 kilos, pulse 88, temperature 36.7, blood pressure 98 over 60."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 209.45,
      "end_seconds": 212.97,
      "duration_seconds": 3.52,
      "text": "Is that all right? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.15,
      "end_seconds": 241.58,
      "duration_seconds": 9.43,
      "text": "All normal. I'll feel her tummy, and check her back, and her bottom is not needed today."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.5,
      "end_seconds": 245.83,
      "duration_seconds": 2.33,
      "text": "Hee hee. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.22,
      "end_seconds": 257.25,
      "duration_seconds": 10.03,
      "text": "Her tummy is soft, and there's no lump, and her spine looks completely normal, no dimples or hair."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 258.04,
      "end_seconds": 260.66,
      "duration_seconds": 2.62,
      "text": "So what's wrong? ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.96,
      "end_seconds": 279.3,
      "duration_seconds": 16.34,
      "text": "Nothing is wrong, in the sense of disease. This is what we call primary nocturnal enuresis, a delay in the bladder and brain working together at night."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 281.99,
      "end_seconds": 287.02,
      "duration_seconds": 5.03,
      "text": "Will she grow out of it? ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.89,
      "end_seconds": 305.93,
      "duration_seconds": 16.04,
      "text": "Most do. But at eight, with her upset, we can help. I'd like to arrange a urine test today, to check for sugar or infection, to be certain."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 308.45,
      "end_seconds": 310.32,
      "duration_seconds": 1.87,
      "text": "Fine. ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.47,
      "end_seconds": 326.67,
      "duration_seconds": 15.2,
      "text": "And treatment starts with simple measures. Drink most fluids earlier in the day, less after six, go to the toilet just before bed, and avoid fizzy drinks and squash in the evening."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 328.85,
      "end_seconds": 330.59,
      "duration_seconds": 1.74,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.96,
      "end_seconds": 338.88,
      "duration_seconds": 5.92,
      "text": "A reward chart for dry nights, not punishment. And no blame, ever."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.72,
      "end_seconds": 345.46,
      "duration_seconds": 3.74,
      "text": "Can I have a sticker? ~"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.99,
      "end_seconds": 351.54,
      "duration_seconds": 3.55,
      "text": "Of course you can. ~"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 354.28,
      "end_seconds": 358.23,
      "duration_seconds": 3.95,
      "text": "And if that doesn't work? ~"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.37,
      "end_seconds": 370.99,
      "duration_seconds": 11.62,
      "text": "Then an enuresis alarm, a small sensor that wakes her when she starts to wet, works very well. ~"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 373.16,
      "end_seconds": 377.49,
      "duration_seconds": 4.33,
      "text": "When would we try that? ~"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.61,
      "end_seconds": 391.3,
      "duration_seconds": 11.69,
      "text": "Let's do the simple steps for a month. I'd like to see you again in four weeks, and we'll decide about the alarm."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 393.28,
      "end_seconds": 396.88,
      "duration_seconds": 3.6,
      "text": "Four weeks. Thank you. ~"
    }
  ]
}
