{
  "schema_version": "1.0",
  "encounter_id": "00710",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.19,
      "end_seconds": 12.93,
      "duration_seconds": 11.74,
      "text": "Hello, doctor. I can't smell anything. It's the strangest thing. Nothing. I had a cold in September and it never came back."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.11,
      "end_seconds": 18.04,
      "duration_seconds": 2.93,
      "text": "How long has it been?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.07,
      "end_seconds": 30.53,
      "duration_seconds": 10.46,
      "text": "Eleven weeks. I counted, because I'm a chef, and it's a nightmare. I can't taste, either. Everything tastes of cardboard."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.03,
      "end_seconds": 36.26,
      "duration_seconds": 3.23,
      "text": "Is your nose blocked as well?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.32,
      "end_seconds": 46.44,
      "duration_seconds": 8.12,
      "text": "A bit, on the left, on and off. And a bit of post-nasal drip."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.92,
      "end_seconds": 52.98,
      "duration_seconds": 4.06,
      "text": "Any fever, or pain in your face?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.45,
      "end_seconds": 57.75,
      "duration_seconds": 3.3,
      "text": "No fever, and no face pain."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.5,
      "end_seconds": 64.01,
      "duration_seconds": 4.51,
      "text": "Any bang on the head before this started?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.38,
      "end_seconds": 74.87,
      "duration_seconds": 7.49,
      "text": "No. I'd have remembered that. Oh, did I mention I've lost my keys?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.2,
      "end_seconds": 86.49,
      "duration_seconds": 8.29,
      "text": "Let's stick with the nose for now. What do you use for it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.72,
      "end_seconds": 99.19,
      "duration_seconds": 10.47,
      "text": "A steroid nasal spray, fluticasone, two sprays each nostril once a day, and cetirizine, 10 mg, for my hay fever."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.23,
      "end_seconds": 106.42,
      "duration_seconds": 4.19,
      "text": "Do you have any other conditions?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.99,
      "end_seconds": 112.13,
      "duration_seconds": 4.14,
      "text": "Hay fever, as I said, and asthma."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.44,
      "end_seconds": 116.87,
      "duration_seconds": 2.43,
      "text": "Any previous nose operations?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.34,
      "end_seconds": 123.54,
      "duration_seconds": 4.2,
      "text": "Yes, my septum was straightened. Septoplasty. In 2015."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.87,
      "end_seconds": 128.14,
      "duration_seconds": 2.27,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.38,
      "end_seconds": 138.07,
      "duration_seconds": 6.69,
      "text": "I gave up four years ago. Twenty a day, for years, before that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.45,
      "end_seconds": 147.93,
      "duration_seconds": 6.48,
      "text": "Let me take your pulse, pressure and so on. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.74,
      "end_seconds": 152.22,
      "duration_seconds": 2.48,
      "text": "Go on. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.31,
      "end_seconds": 176.6,
      "duration_seconds": 8.29,
      "text": "Pulse 70, blood pressure 124 over 80, temperature 36.6, oxygen 99 percent, breathing 14 a minute."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.24,
      "end_seconds": 181.68,
      "duration_seconds": 3.44,
      "text": "I'm all right then. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.71,
      "end_seconds": 188.59,
      "duration_seconds": 4.88,
      "text": "Any wheeze or breathlessness, with the asthma?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.29,
      "end_seconds": 193.64,
      "duration_seconds": 3.35,
      "text": "No, the asthma's quiet. No wheeze."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.74,
      "end_seconds": 216.82,
      "duration_seconds": 20.08,
      "text": "I'm not going to give this a name just yet. A cold can damage the smell nerves for a time, and mostly it comes back, but at eleven weeks, I want to look properly. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.45,
      "end_seconds": 220.02,
      "duration_seconds": 1.57,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.4,
      "end_seconds": 230.67,
      "duration_seconds": 8.27,
      "text": "I'd like to arrange a smell identification test, where you sniff a set of scratch-and-sniff cards."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.43,
      "end_seconds": 235.17,
      "duration_seconds": 2.74,
      "text": "That sounds fun. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.88,
      "end_seconds": 247.45,
      "duration_seconds": 9.57,
      "text": "And I'd like to arrange a CT scan of your sinuses, to check there's no blockage."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.42,
      "end_seconds": 252.43,
      "duration_seconds": 3.01,
      "text": "Fine. Is it permanent? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.93,
      "end_seconds": 264.8,
      "duration_seconds": 10.87,
      "text": "Often not. Smell training, sniffing four strong scents twice a day, like rose, lemon, clove and eucalyptus, helps nerves recover."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.45,
      "end_seconds": 273.18,
      "duration_seconds": 5.73,
      "text": "I've got those in the pantry. Cloves, lemon. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.54,
      "end_seconds": 285.64,
      "duration_seconds": 10.1,
      "text": "Perfect. Keep using the nasal spray, and make sure your smoke and gas alarms are working, since you can't smell a leak."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.27,
      "end_seconds": 291.62,
      "duration_seconds": 4.35,
      "text": "Oh, that's a good point. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.52,
      "end_seconds": 299.9,
      "duration_seconds": 6.38,
      "text": "I'd like to see you again in four weeks, after the tests."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.4,
      "end_seconds": 306.02,
      "duration_seconds": 4.62,
      "text": "Four weeks. Right. Thank you, doctor. ~"
    }
  ]
}
