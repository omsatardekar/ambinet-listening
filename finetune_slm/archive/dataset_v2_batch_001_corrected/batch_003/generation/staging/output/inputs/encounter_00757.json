{
  "schema_version": "1.0",
  "encounter_id": "00757",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.11,
      "end_seconds": 14.45,
      "duration_seconds": 13.34,
      "text": "I'm fine, doc. Just a stiff neck from the accident. The guy ran a red light and hit my driver's side. The ambulance people insisted I come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.16,
      "end_seconds": 19.68,
      "duration_seconds": 4.52,
      "text": "I'm glad you came. When was the accident?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.17,
      "end_seconds": 31.98,
      "duration_seconds": 10.81,
      "text": "About two hours ago. I've got a pain at the back of my neck, that's all, nothing serious."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.16,
      "end_seconds": 41.16,
      "duration_seconds": 8.0,
      "text": "So, neck pain since the crash, two hours. Is it stiff as well?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.11,
      "end_seconds": 49.34,
      "duration_seconds": 7.23,
      "text": "A bit stiff turning to the left. I can still do it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.45,
      "end_seconds": 53.53,
      "duration_seconds": 2.08,
      "text": "Any headache?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.28,
      "end_seconds": 59.33,
      "duration_seconds": 4.05,
      "text": "A mild one, started in the ambulance."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.74,
      "end_seconds": 64.71,
      "duration_seconds": 2.97,
      "text": "How about your shoulders, arms?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.21,
      "end_seconds": 71.7,
      "duration_seconds": 5.49,
      "text": "The left shoulder aches where the belt caught me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.13,
      "end_seconds": 80.33,
      "duration_seconds": 6.2,
      "text": "Did you hit your head or black out at any point?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.18,
      "end_seconds": 89.41,
      "duration_seconds": 6.23,
      "text": "No, nothing like that. I was awake the whole time."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.41,
      "end_seconds": 95.54,
      "duration_seconds": 5.13,
      "text": "Any numbness or tingling in your arms or hands?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.68,
      "end_seconds": 100.14,
      "duration_seconds": 2.46,
      "text": "No numbness. No tingling."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.35,
      "end_seconds": 108.19,
      "duration_seconds": 6.84,
      "text": "So no blackout, no tingling. What medications do you take?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.3,
      "end_seconds": 120.8,
      "duration_seconds": 10.5,
      "text": "Lisinopril, 20 mg, once a day. Metformin, 1000 mg, twice a day. And I took ibuprofen, 400 mg, in the ambulance."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.14,
      "end_seconds": 127.08,
      "duration_seconds": 3.94,
      "text": "Thanks. Any allergies, any drug allergies?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.41,
      "end_seconds": 137.63,
      "duration_seconds": 8.22,
      "text": "Morphine. When I was in my twenties it made me throw up. I've avoided it since."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.06,
      "end_seconds": 142.25,
      "duration_seconds": 2.19,
      "text": "Noted. Other medical conditions?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.2,
      "end_seconds": 151.17,
      "duration_seconds": 5.97,
      "text": "High blood pressure, type 2 diabetes, asthma, and sleep apnea."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.92,
      "end_seconds": 154.09,
      "duration_seconds": 1.17,
      "text": "Surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.7,
      "end_seconds": 158.24,
      "duration_seconds": 2.54,
      "text": "Gallbladder out, in 2014."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.47,
      "end_seconds": 165.06,
      "duration_seconds": 4.59,
      "text": "Heart disease or stroke in the family?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.65,
      "end_seconds": 170.1,
      "duration_seconds": 3.45,
      "text": "My father had a stroke."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.58,
      "end_seconds": 175.05,
      "duration_seconds": 2.47,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.9,
      "end_seconds": 180.57,
      "duration_seconds": 3.67,
      "text": "I quit smoking five years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.51,
      "end_seconds": 183.84,
      "duration_seconds": 1.33,
      "text": "Drink?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.37,
      "end_seconds": 189.16,
      "duration_seconds": 3.79,
      "text": "A couple of beers on weekends."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.25,
      "end_seconds": 194.87,
      "duration_seconds": 3.62,
      "text": "What do you do for work?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.52,
      "end_seconds": 201.54,
      "duration_seconds": 4.02,
      "text": "Electrician. I'm up on ladders all day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.72,
      "end_seconds": 203.77,
      "duration_seconds": 1.05,
      "text": "Exercise?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.95,
      "end_seconds": 209.49,
      "duration_seconds": 3.54,
      "text": "Golf, when the weather's okay."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.01,
      "end_seconds": 240.69,
      "duration_seconds": 14.68,
      "text": "Let me get your vitals. Blood pressure 152 over 92, pulse 96, temperature 36.9, oxygen 97 percent, respiratory rate 18, and your weight is 94 kilos."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.9,
      "end_seconds": 246.22,
      "duration_seconds": 3.32,
      "text": "That's just the adrenaline. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.87,
      "end_seconds": 263.46,
      "duration_seconds": 5.59,
      "text": "Probably. Let me feel your neck. Tell me if anything hurts."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.59,
      "end_seconds": 268.02,
      "duration_seconds": 3.43,
      "text": "There. Right there, a bit. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.25,
      "end_seconds": 279.75,
      "duration_seconds": 10.5,
      "text": "There's tenderness over the muscles on both sides of the neck, but no tenderness over the bones in the middle."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.6,
      "end_seconds": 285.37,
      "duration_seconds": 2.77,
      "text": "See, it's nothing. ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.66,
      "end_seconds": 296.61,
      "duration_seconds": 8.95,
      "text": "You've got a seat belt mark on the left shoulder, and I can see a bruise coming up."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.09,
      "end_seconds": 302.58,
      "duration_seconds": 3.49,
      "text": "That's the belt, yeah. ~"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.84,
      "end_seconds": 307.97,
      "duration_seconds": 4.13,
      "text": "Any trouble breathing, chest pain from the belt?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.57,
      "end_seconds": 314.14,
      "duration_seconds": 3.57,
      "text": "No, nothing like that. Breathing's fine."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.01,
      "end_seconds": 332.83,
      "duration_seconds": 16.82,
      "text": "What you're telling me is that you can move your neck and there's no tingling. That's reassuring. But I can't rule out a fracture of the neck bones, and with a collision like this we scan."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.35,
      "end_seconds": 339.14,
      "duration_seconds": 3.79,
      "text": "A scan? For a stiff neck? ~"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.79,
      "end_seconds": 352.02,
      "duration_seconds": 10.23,
      "text": "For safety. I'd like to arrange a CT scan of the neck, and an X-ray of the left shoulder."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 353.52,
      "end_seconds": 357.29,
      "duration_seconds": 3.77,
      "text": "How long will it take? ~"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.59,
      "end_seconds": 368.35,
      "duration_seconds": 9.76,
      "text": "About an hour. I'd also like to get a CT scan of the head, because of the headache."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 369.66,
      "end_seconds": 373.36,
      "duration_seconds": 3.7,
      "text": "If you say so. ~"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 375.34,
      "end_seconds": 384.36,
      "duration_seconds": 9.02,
      "text": "Until it's done, you stay lying flat with the collar on. I'll come back with the results."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 385.27,
      "end_seconds": 387.42,
      "duration_seconds": 2.15,
      "text": "Alright, doc. ~"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 390.27,
      "end_seconds": 399.24,
      "duration_seconds": 8.97,
      "text": "If any numbness or weakness appears before the scan, tell the nurse straight away and we'll act immediately."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 401.42,
      "end_seconds": 403.49,
      "duration_seconds": 2.07,
      "text": "Will do. ~"
    }
  ]
}
