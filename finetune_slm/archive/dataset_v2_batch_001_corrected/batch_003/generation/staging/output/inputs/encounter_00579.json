{
  "schema_version": "1.0",
  "encounter_id": "00579",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.9,
      "end_seconds": 10.97,
      "duration_seconds": 10.07,
      "text": "Hi. Sorry, I almost didn't make it, the snow was... the lot behind the building was a mess."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 12.31,
      "end_seconds": 25.01,
      "duration_seconds": 12.7,
      "text": "Tell me about it. They never plow that lot till noon. Come on in. So, you're here about your cycles and your weight?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.02,
      "end_seconds": 38.52,
      "duration_seconds": 11.5,
      "text": "Yeah. Well, mostly my periods. They're, um, I don't know how to say it. They're all over the place."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.51,
      "end_seconds": 45.39,
      "duration_seconds": 5.88,
      "text": "What does all over the place look like? Give me an example."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.52,
      "end_seconds": 56.94,
      "duration_seconds": 9.42,
      "text": "Like, I'll skip a month. Or two. And then I'll get one that lasts, you know, forever."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.12,
      "end_seconds": 61.77,
      "duration_seconds": 3.65,
      "text": "How long has this been going on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.71,
      "end_seconds": 71.66,
      "duration_seconds": 7.95,
      "text": "About eight months, I think. Before that it was, I mean, not perfect, but..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.2,
      "end_seconds": 75.64,
      "duration_seconds": 2.44,
      "text": "But more regular?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.63,
      "end_seconds": 83.15,
      "duration_seconds": 4.52,
      "text": "Right. More regular. Every five weeks or so."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.14,
      "end_seconds": 88.13,
      "duration_seconds": 3.99,
      "text": "Okay. When was your last period?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.5,
      "end_seconds": 100.89,
      "duration_seconds": 11.39,
      "text": "Um. About seven weeks ago? I'd have to check my phone. I track it but I forgot to look."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.95,
      "end_seconds": 110.37,
      "duration_seconds": 7.42,
      "text": "That's fine, bring it next time. When you do get one, is it heavy?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.31,
      "end_seconds": 123.84,
      "duration_seconds": 10.53,
      "text": "It's heavy at the start, then it kind of trickles on. I don't know if that's, like, normal."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.52,
      "end_seconds": 132.86,
      "duration_seconds": 7.34,
      "text": "It's common with irregular cycles. What's the weight thing? What's bothering you there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.61,
      "end_seconds": 141.88,
      "duration_seconds": 8.27,
      "text": "I just feel like I'm gaining and I can't... it doesn't matter what I try. It's frustrating."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.0,
      "end_seconds": 153.27,
      "duration_seconds": 9.27,
      "text": "I hear you. A lot of my patients feel the same way. Let's get your numbers first."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.14,
      "end_seconds": 167.35,
      "duration_seconds": 3.21,
      "text": "Weight today is 82 kilograms."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.91,
      "end_seconds": 173.69,
      "duration_seconds": 4.78,
      "text": "Oh. It's more than last time. I figured."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.62,
      "end_seconds": 194.31,
      "duration_seconds": 7.69,
      "text": "Slightly. And your blood pressure is 118 over 74, which is great."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.68,
      "end_seconds": 198.69,
      "duration_seconds": 3.01,
      "text": "Okay. That's good, right?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.97,
      "end_seconds": 210.51,
      "duration_seconds": 10.54,
      "text": "That's excellent. Now let me have a quick look. Any spots on your face or jawline that bother you?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.7,
      "end_seconds": 222.5,
      "duration_seconds": 9.8,
      "text": "Yeah, a few. Mostly along my chin. They come and go with my cycle, or what's left of it."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.47,
      "end_seconds": 236.44,
      "duration_seconds": 6.97,
      "text": "I see a few small acne spots along your jawline, nothing deep."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.67,
      "end_seconds": 241.44,
      "duration_seconds": 3.77,
      "text": "Is that connected? To the periods?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.89,
      "end_seconds": 254.5,
      "duration_seconds": 11.61,
      "text": "It can be. Hormones affect skin, cycles and weight all together. That's why I want to look at the hormone side."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.95,
      "end_seconds": 260.09,
      "duration_seconds": 3.14,
      "text": "So what kind of tests?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.42,
      "end_seconds": 270.48,
      "duration_seconds": 9.06,
      "text": "I'd like to order a blood test for your hormone levels. You'd get it done at the lab downstairs."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.85,
      "end_seconds": 278.85,
      "duration_seconds": 6.0,
      "text": "Do I need to fast for that? I hate fasting."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.43,
      "end_seconds": 287.92,
      "duration_seconds": 7.49,
      "text": "Yes, from midnight, water only. Early morning is best, and the lab opens at seven."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.64,
      "end_seconds": 293.57,
      "duration_seconds": 2.93,
      "text": "Okay. Is there anything else?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.16,
      "end_seconds": 305.9,
      "duration_seconds": 9.74,
      "text": "I'm also going to book a pelvic ultrasound, so we can look at your ovaries and the lining of the uterus."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.89,
      "end_seconds": 311.95,
      "duration_seconds": 5.06,
      "text": "Is that the one where you need a full bladder?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.67,
      "end_seconds": 326.08,
      "duration_seconds": 13.41,
      "text": "For the one over your belly, yes. Drink about a liter of water an hour before. The tech will tell you more."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.57,
      "end_seconds": 335.81,
      "duration_seconds": 8.24,
      "text": "A liter. Right. I always manage to forget that and then they send me away..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.82,
      "end_seconds": 345.77,
      "duration_seconds": 8.95,
      "text": "Set an alarm on your phone. I'll note it on the order so they don't send you away."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.82,
      "end_seconds": 354.94,
      "duration_seconds": 8.12,
      "text": "Thanks. And in the meantime, should I be doing anything for the weight? I just..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.37,
      "end_seconds": 366.54,
      "duration_seconds": 9.17,
      "text": "Small, steady changes beat crash plans. Regular meals, more protein and fiber, and some movement you actually enjoy."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 367.67,
      "end_seconds": 374.22,
      "duration_seconds": 6.55,
      "text": "I've tried all that. Well, some of that. Not very consistently."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 376.07,
      "end_seconds": 387.04,
      "duration_seconds": 10.97,
      "text": "That's honest, and totally normal. Pick one thing and keep it going for a month, rather than ten things for a week."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 389.45,
      "end_seconds": 394.64,
      "duration_seconds": 5.19,
      "text": "One thing. Okay. I can probably do that."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 396.09,
      "end_seconds": 407.27,
      "duration_seconds": 11.18,
      "text": "The results will help us explain a lot of this. Our front desk will call you when the ultrasound is booked."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 408.45,
      "end_seconds": 416.4,
      "duration_seconds": 7.95,
      "text": "Okay. Thank you. I feel like I needed to hear it's not just me."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 418.98,
      "end_seconds": 424.93,
      "duration_seconds": 5.95,
      "text": "It isn't. Take care of yourself, and watch the ice out there."
    }
  ]
}
