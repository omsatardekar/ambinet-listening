{
  "schema_version": "1.0",
  "encounter_id": "00557",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.48,
      "end_seconds": 7.89,
      "duration_seconds": 7.41,
      "text": "Pain, doctor. Very bad pain on the right side of my stomach."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.87,
      "end_seconds": 15.53,
      "duration_seconds": 4.66,
      "text": "Okay. I'm here now. Tell me about it."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.97,
      "end_seconds": 26.16,
      "duration_seconds": 8.19,
      "text": "Since morning. First near the navel, then it moved to the right side."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.6,
      "end_seconds": 29.82,
      "duration_seconds": 1.22,
      "text": "Mm-hm."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.71,
      "end_seconds": 42.04,
      "duration_seconds": 3.33,
      "text": "What does it feel like?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.96,
      "end_seconds": 48.75,
      "duration_seconds": 5.79,
      "text": "Sharp. Like a knife. When I walk, it is worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.88,
      "end_seconds": 55.32,
      "duration_seconds": 4.44,
      "text": "Would you call it mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.29,
      "end_seconds": 59.3,
      "duration_seconds": 1.01,
      "text": "Severe."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.24,
      "end_seconds": 71.79,
      "duration_seconds": 4.55,
      "text": "I see. What else has been happening?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.57,
      "end_seconds": 79.68,
      "duration_seconds": 5.11,
      "text": "Vomiting. Two times, at home. And nausea, all the time."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.62,
      "end_seconds": 87.7,
      "duration_seconds": 6.08,
      "text": "And what about your appetite, how has that been?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.74,
      "end_seconds": 96.84,
      "duration_seconds": 7.1,
      "text": "Not eating. Since... I don't know. Maybe two days, maybe four. I can't say exactly."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.74,
      "end_seconds": 102.55,
      "duration_seconds": 3.81,
      "text": "That's all right. Any loose motions?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.67,
      "end_seconds": 104.65,
      "duration_seconds": 0.98,
      "text": "No."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.62,
      "end_seconds": 111.23,
      "duration_seconds": 3.61,
      "text": "And any problems with passing urine?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.28,
      "end_seconds": 113.44,
      "duration_seconds": 1.16,
      "text": "Normal."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.37,
      "end_seconds": 121.63,
      "duration_seconds": 6.26,
      "text": "Do you have any illness you are being treated for?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.15,
      "end_seconds": 125.46,
      "duration_seconds": 2.31,
      "text": "Diabetes. Sugar problem."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.95,
      "end_seconds": 131.24,
      "duration_seconds": 4.29,
      "text": "What do you take for the diabetes?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.03,
      "end_seconds": 139.76,
      "duration_seconds": 6.73,
      "text": "Metformin. Maybe 500 milligrams? Morning and night. I do not remember properly."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.02,
      "end_seconds": 146.51,
      "duration_seconds": 4.49,
      "text": "Fine. Have you had any operations in the past?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.07,
      "end_seconds": 152.22,
      "duration_seconds": 3.15,
      "text": "Tonsils. When I was ten."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.23,
      "end_seconds": 165.26,
      "duration_seconds": 11.03,
      "text": "All right. Lie back and bend your knees. I am going to press on your tummy, and you tell me where it hurts."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.68,
      "end_seconds": 167.72,
      "duration_seconds": 1.04,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.99,
      "end_seconds": 178.92,
      "duration_seconds": 0.93,
      "text": "Here?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.83,
      "end_seconds": 184.5,
      "duration_seconds": 2.67,
      "text": "Aah! There. Yes, there."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.4,
      "end_seconds": 199.66,
      "duration_seconds": 14.26,
      "text": "Tender in the lower right side of your abdomen, and I can feel the muscles tightening under my hand. You can relax now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.91,
      "end_seconds": 204.7,
      "duration_seconds": 2.79,
      "text": "Doctor, is it serious?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.05,
      "end_seconds": 212.84,
      "duration_seconds": 6.79,
      "text": "Let me finish the checks first. I will read your numbers."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.88,
      "end_seconds": 231.66,
      "duration_seconds": 4.78,
      "text": "Pressure 118 over 74. Pulse 104. Temperature 38.1."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.78,
      "end_seconds": 239.93,
      "duration_seconds": 6.15,
      "text": "Oxygen saturation 98 per cent, and breathing rate 20 per minute."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.17,
      "end_seconds": 246.64,
      "duration_seconds": 4.47,
      "text": "Is the fever also from this?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.79,
      "end_seconds": 258.92,
      "duration_seconds": 10.13,
      "text": "It can be. Putting it together, this looks like appendicitis, the appendix being inflamed. I want to confirm it today."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.74,
      "end_seconds": 265.34,
      "duration_seconds": 3.6,
      "text": "Appendix. My cousin had that."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.14,
      "end_seconds": 274.15,
      "duration_seconds": 7.01,
      "text": "It is common. First I would like blood tests now, to look for infection."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.07,
      "end_seconds": 279.02,
      "duration_seconds": 1.95,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.95,
      "end_seconds": 287.74,
      "duration_seconds": 7.79,
      "text": "Then we will do an ultrasound scan of your abdomen, today itself."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.65,
      "end_seconds": 290.37,
      "duration_seconds": 1.72,
      "text": "Scan also."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.51,
      "end_seconds": 299.97,
      "duration_seconds": 7.46,
      "text": "Yes. And let's get a urine test, to be sure nothing else is going on."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.73,
      "end_seconds": 302.09,
      "duration_seconds": 1.36,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.06,
      "end_seconds": 317.21,
      "duration_seconds": 13.15,
      "text": "I will ask the surgical team to see you once the scan is done. Until then, please do not eat or drink anything."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.51,
      "end_seconds": 321.7,
      "duration_seconds": 2.19,
      "text": "Not even water?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.33,
      "end_seconds": 328.89,
      "duration_seconds": 5.56,
      "text": "Not even water. You can wet your lips."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.75,
      "end_seconds": 332.57,
      "duration_seconds": 2.82,
      "text": "Will they operate today?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.76,
      "end_seconds": 344.91,
      "duration_seconds": 11.15,
      "text": "I cannot say yet. The surgeons will decide after the scan. I will not leave you without telling you what is happening."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.95,
      "end_seconds": 351.39,
      "duration_seconds": 5.44,
      "text": "Okay. My wife is outside. Can she come in?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.31,
      "end_seconds": 362.65,
      "duration_seconds": 8.34,
      "text": "Yes, I will call her. She can sit with you while we wait for the test."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 364.48,
      "end_seconds": 367.17,
      "duration_seconds": 2.69,
      "text": "Thank you, doctor."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.72,
      "end_seconds": 376.56,
      "duration_seconds": 6.84,
      "text": "Try to stay still. The nurse will be with you in a minute."
    }
  ]
}
