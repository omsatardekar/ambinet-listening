{
  "schema_version": "1.0",
  "encounter_id": "00790",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 1.12,
      "end_seconds": 14.22,
      "duration_seconds": 13.1,
      "text": "Morning, doctor. I'm Lorraine, Tyler's foster carer. He's sixteen, and he's got a rash that won't go away. He won't say much, so I'll help."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.54,
      "end_seconds": 22.61,
      "duration_seconds": 6.07,
      "text": "Hello Tyler, hello Lorraine. Tyler, tell me about the rash."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.8,
      "end_seconds": 25.18,
      "duration_seconds": 1.38,
      "text": "Itchy."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 28.16,
      "end_seconds": 37.32,
      "duration_seconds": 9.16,
      "text": "Under his watch strap, on his left wrist, and around his belly button, where his jeans button rubs."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.03,
      "end_seconds": 42.59,
      "duration_seconds": 3.56,
      "text": "Tyler, when did you notice it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.63,
      "end_seconds": 47.06,
      "duration_seconds": 2.43,
      "text": "A few weeks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 48.09,
      "end_seconds": 54.67,
      "duration_seconds": 6.58,
      "text": "And his ear lobes were red and weeping, after he got the new piercings."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.79,
      "end_seconds": 59.01,
      "duration_seconds": 2.22,
      "text": "Anything else? Blisters?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.7,
      "end_seconds": 64.14,
      "duration_seconds": 2.44,
      "text": "Some. On my wrist."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.13,
      "end_seconds": 73.98,
      "duration_seconds": 6.85,
      "text": "Any fever, or has it spread to your face, or inside your mouth?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.39,
      "end_seconds": 76.29,
      "duration_seconds": 0.9,
      "text": "No."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.32,
      "end_seconds": 85.94,
      "duration_seconds": 7.62,
      "text": "Does it ooze, is there any yellow crust, or does it hurt more than itch?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 87.09,
      "end_seconds": 94.94,
      "duration_seconds": 7.85,
      "text": "A bit of crusting on the wrist, but it's mostly itchy. No yellow pus."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.2,
      "end_seconds": 102.24,
      "duration_seconds": 5.04,
      "text": "Do you have any history of skin trouble?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 103.36,
      "end_seconds": 110.96,
      "duration_seconds": 7.6,
      "text": "He had eczema as a little boy. He has asthma, and hay fever too."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.99,
      "end_seconds": 116.59,
      "duration_seconds": 3.6,
      "text": "Does he take any tablets? ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 118.1,
      "end_seconds": 121.14,
      "duration_seconds": 3.04,
      "text": "No. Nothing regular. ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.96,
      "end_seconds": 126.52,
      "duration_seconds": 2.56,
      "text": "Pulse and temperature. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.29,
      "end_seconds": 128.9,
      "duration_seconds": 1.61,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.63,
      "end_seconds": 148.15,
      "duration_seconds": 6.52,
      "text": "Pulse 70, temperature 36.7, blood pressure 114 over 70, oxygen 99 percent."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 150.7,
      "end_seconds": 152.54,
      "duration_seconds": 1.84,
      "text": "Good. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.81,
      "end_seconds": 156.79,
      "duration_seconds": 2.98,
      "text": "Any breathing trouble, wheeze?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.64,
      "end_seconds": 158.58,
      "duration_seconds": 0.94,
      "text": "No."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.43,
      "end_seconds": 162.63,
      "duration_seconds": 3.2,
      "text": "Any cough or tight chest?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.7,
      "end_seconds": 165.11,
      "duration_seconds": 1.41,
      "text": "No."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.53,
      "end_seconds": 185.44,
      "duration_seconds": 3.91,
      "text": "Let me look at the wrist."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.03,
      "end_seconds": 210.11,
      "duration_seconds": 23.08,
      "text": "There's a sharply defined red patch on the underside of the wrist exactly where the watch back sits, with small blisters and a little crusting, and a similar patch near the navel, and the ear lobes are red and scaly. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 211.71,
      "end_seconds": 214.49,
      "duration_seconds": 2.78,
      "text": "What is it? ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.46,
      "end_seconds": 230.53,
      "duration_seconds": 15.07,
      "text": "The distribution fits nickel, which is in the metal of the watch back, belt buckles, jean buttons, and cheap earrings. I'd say contact dermatitis from nickel."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 231.52,
      "end_seconds": 235.29,
      "duration_seconds": 3.77,
      "text": "A reaction to the metal? ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.42,
      "end_seconds": 242.33,
      "duration_seconds": 5.91,
      "text": "Yes. The skin reacts every time it touches nickel. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.81,
      "end_seconds": 246.41,
      "duration_seconds": 2.6,
      "text": "So no jewellery? ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.08,
      "end_seconds": 260.5,
      "duration_seconds": 11.42,
      "text": "Nickel-free jewellery, surgical steel or titanium, and cover the back of the watch with clear nail varnish, or switch to a plastic strap."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.3,
      "end_seconds": 262.84,
      "duration_seconds": 1.54,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.75,
      "end_seconds": 277.29,
      "duration_seconds": 11.54,
      "text": "I'd like to confirm it with patch testing, where we tape small samples of metals to your back for two days."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 280.11,
      "end_seconds": 283.24,
      "duration_seconds": 3.13,
      "text": "Where do we go? ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.93,
      "end_seconds": 293.74,
      "duration_seconds": 8.81,
      "text": "The dermatology department. I'd also like to take a swab from the crusted wrist, to check it isn't infected."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.45,
      "end_seconds": 296.81,
      "duration_seconds": 1.36,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.71,
      "end_seconds": 306.0,
      "duration_seconds": 6.29,
      "text": "Use a plain moisturiser a few times a day, and don't scratch."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 307.99,
      "end_seconds": 312.3,
      "duration_seconds": 4.31,
      "text": "I'll keep an eye on him. ~"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.27,
      "end_seconds": 323.34,
      "duration_seconds": 9.07,
      "text": "If the rash looks yellow, weepy, or you see a fever, come back the same day."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 324.32,
      "end_seconds": 327.49,
      "duration_seconds": 3.17,
      "text": "Thank you, doctor. ~"
    }
  ]
}
