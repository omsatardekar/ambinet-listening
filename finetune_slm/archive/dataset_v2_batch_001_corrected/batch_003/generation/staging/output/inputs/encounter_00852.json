{
  "schema_version": "1.0",
  "encounter_id": "00852",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 0.77,
      "end_seconds": 10.72,
      "duration_seconds": 9.95,
      "text": "Doctor, thank you. It's Rory, he's fifteen, he did his knee playing rugby six weeks ago, and he's still limping."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.02,
      "end_seconds": 17.02,
      "duration_seconds": 4.0,
      "text": "Hello Rory. Which knee, and what happened?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.85,
      "end_seconds": 28.0,
      "duration_seconds": 10.15,
      "text": "The left. I got tackled from the side, and my knee twisted, and I felt a pop."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.42,
      "end_seconds": 33.1,
      "duration_seconds": 2.68,
      "text": "Was there swelling, immediately?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.86,
      "end_seconds": 40.23,
      "duration_seconds": 4.37,
      "text": "Yeah. Within an hour. It was huge."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 43.0,
      "end_seconds": 53.33,
      "duration_seconds": 10.33,
      "text": "It was like a balloon. We took him to the emergency department, they said sprain, gave him a brace."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.29,
      "end_seconds": 59.38,
      "duration_seconds": 3.09,
      "text": "How is it now?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.17,
      "end_seconds": 70.36,
      "duration_seconds": 8.19,
      "text": "It's better, but it gives way on stairs, and it clicks, and I can't straighten it fully."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.11,
      "end_seconds": 78.07,
      "duration_seconds": 4.96,
      "text": "Is there any locking, where it gets stuck?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.98,
      "end_seconds": 83.15,
      "duration_seconds": 3.17,
      "text": "Once or twice. It catches."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.9,
      "end_seconds": 89.04,
      "duration_seconds": 4.14,
      "text": "Any numbness, or any pain at night?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.42,
      "end_seconds": 94.17,
      "duration_seconds": 2.75,
      "text": "No. Nothing like that."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.41,
      "end_seconds": 99.64,
      "duration_seconds": 4.23,
      "text": "Any fever, or redness on the knee?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.47,
      "end_seconds": 101.5,
      "duration_seconds": 1.03,
      "text": "No."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.06,
      "end_seconds": 108.84,
      "duration_seconds": 4.78,
      "text": "What have you been taking for the pain?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.79,
      "end_seconds": 116.57,
      "duration_seconds": 4.78,
      "text": "Ibuprofen, 200 mg, three times a day, with food."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 117.78,
      "end_seconds": 127.63,
      "duration_seconds": 9.85,
      "text": "No, it's 400 mg, Rory. I gave him two tablets. And paracetamol, 500 mg, when he needs it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.12,
      "end_seconds": 138.82,
      "duration_seconds": 8.7,
      "text": "I'll note that you and Mum gave different doses of ibuprofen, and I'll check which. Any other conditions?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 140.86,
      "end_seconds": 145.32,
      "duration_seconds": 4.46,
      "text": "He has mild asthma, hay fever, and eczema."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.27,
      "end_seconds": 151.45,
      "duration_seconds": 4.18,
      "text": "Let me check pulse and the rest. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.76,
      "end_seconds": 154.51,
      "duration_seconds": 1.75,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.15,
      "end_seconds": 178.53,
      "duration_seconds": 6.38,
      "text": "Pulse 72, blood pressure 118 over 70, temperature 36.6, weight 62 kilos."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 179.5,
      "end_seconds": 181.25,
      "duration_seconds": 1.75,
      "text": "Fine? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.01,
      "end_seconds": 193.92,
      "duration_seconds": 10.91,
      "text": "Fine. Rory, lie down on the couch, and I'll examine the knee. Tell me when it hurts. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.8,
      "end_seconds": 217.98,
      "duration_seconds": 1.18,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.08,
      "end_seconds": 236.02,
      "duration_seconds": 16.94,
      "text": "There's a little fluid in the left knee, and tenderness over the inner side of the joint line, and when I twist it, I get a click and pain. The ligaments feel stable."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 237.51,
      "end_seconds": 240.4,
      "duration_seconds": 2.89,
      "text": "What does that mean? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.73,
      "end_seconds": 257.43,
      "duration_seconds": 15.7,
      "text": "It suggests a tear in the cartilage, the meniscus, rather than a ligament. Considering the twist and the locking, I'd say this is a probable meniscal tear."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 258.6,
      "end_seconds": 261.82,
      "duration_seconds": 3.22,
      "text": "Will he need surgery? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.65,
      "end_seconds": 271.28,
      "duration_seconds": 8.63,
      "text": "Possibly. I'd like to arrange an MRI scan of the left knee, to see exactly what's torn."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.96,
      "end_seconds": 276.7,
      "duration_seconds": 2.74,
      "text": "Can I play? ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.16,
      "end_seconds": 286.42,
      "duration_seconds": 7.26,
      "text": "No rugby for now. Keep the knee moving, gentle exercises, and no twisting or running."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 287.41,
      "end_seconds": 290.76,
      "duration_seconds": 3.35,
      "text": "He won't like that. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.57,
      "end_seconds": 293.19,
      "duration_seconds": 1.62,
      "text": "No. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.34,
      "end_seconds": 305.41,
      "duration_seconds": 11.07,
      "text": "I know, Rory, and I'm sorry. But playing on a torn meniscus can make it worse. I'll refer you to the physio as well."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 308.1,
      "end_seconds": 310.04,
      "duration_seconds": 1.94,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.73,
      "end_seconds": 320.71,
      "duration_seconds": 7.98,
      "text": "I'd like to see you again in three weeks, with the MRI result."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 322.74,
      "end_seconds": 326.13,
      "duration_seconds": 3.39,
      "text": "Three weeks. Thanks, doctor. ~"
    }
  ]
}
