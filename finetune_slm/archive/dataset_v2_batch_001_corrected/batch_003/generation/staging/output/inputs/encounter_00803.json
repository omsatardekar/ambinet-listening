{
  "schema_version": "1.0",
  "encounter_id": "00803",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 0.97,
      "end_seconds": 13.22,
      "duration_seconds": 12.25,
      "text": "Morning, doctor. I'm Kerry, I'm Mrs Keane's carer. She's got a lump on her eyelid, and she's been rubbing it."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.39,
      "end_seconds": 20.94,
      "duration_seconds": 5.55,
      "text": "Good morning, Mrs Keane. Which eye is it?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.55,
      "end_seconds": 29.02,
      "duration_seconds": 6.47,
      "text": "The right one. The top lid. It's been there a week."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.63,
      "end_seconds": 33.63,
      "duration_seconds": 2.0,
      "text": "Is it painful?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.96,
      "end_seconds": 39.63,
      "duration_seconds": 4.67,
      "text": "It's sore, and it's red. And the eye waters."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 41.86,
      "end_seconds": 50.31,
      "duration_seconds": 8.45,
      "text": "She's been dabbing it with a hankie. I told her not to. ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.49,
      "end_seconds": 56.08,
      "duration_seconds": 3.59,
      "text": "Any change in your vision? ~"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.78,
      "end_seconds": 62.86,
      "duration_seconds": 4.08,
      "text": "No, I can see fine. ~"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.38,
      "end_seconds": 68.52,
      "duration_seconds": 3.14,
      "text": "Anything like this before?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 70.68,
      "end_seconds": 79.38,
      "duration_seconds": 8.7,
      "text": "She's had them before. Years ago. And her eyelids get crusty, with that blepharitis."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.08,
      "end_seconds": 86.75,
      "duration_seconds": 4.67,
      "text": "Do you have any other conditions, Mrs Keane?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.83,
      "end_seconds": 95.37,
      "duration_seconds": 5.54,
      "text": "Diabetes, just diet, and my heart, a little."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.57,
      "end_seconds": 102.3,
      "duration_seconds": 4.73,
      "text": "Is there anyone in the family with eye problems?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.06,
      "end_seconds": 106.84,
      "duration_seconds": 2.78,
      "text": "My sister has glaucoma."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.98,
      "end_seconds": 113.85,
      "duration_seconds": 5.87,
      "text": "Let me look at the eyelid. Look down for me. ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.97,
      "end_seconds": 132.51,
      "duration_seconds": 1.54,
      "text": "Like this?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.19,
      "end_seconds": 149.59,
      "duration_seconds": 14.4,
      "text": "There's a small, red, tender lump on the edge of the upper lid, with a tiny yellow head at the centre, and the rest of the eye is white and calm."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 152.16,
      "end_seconds": 155.22,
      "duration_seconds": 3.06,
      "text": "Is it a stye? ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.41,
      "end_seconds": 160.97,
      "duration_seconds": 4.56,
      "text": "Yes, a stye, an infected eyelash gland, I'd say."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.95,
      "end_seconds": 167.94,
      "duration_seconds": 3.99,
      "text": "How long will it last? ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.47,
      "end_seconds": 177.68,
      "duration_seconds": 8.21,
      "text": "Usually a week or two. It often bursts and settles on its own. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.59,
      "end_seconds": 182.66,
      "duration_seconds": 3.07,
      "text": "Do I need drops? ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.13,
      "end_seconds": 201.74,
      "duration_seconds": 17.61,
      "text": "Not usually. The best treatment is a warm compress, a clean flannel soaked in warm water, held on the eyelid for ten minutes, three or four times a day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 204.56,
      "end_seconds": 208.02,
      "duration_seconds": 3.46,
      "text": "I'll do that for her. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.19,
      "end_seconds": 222.02,
      "duration_seconds": 10.83,
      "text": "And I'd like you to wash the eyelid edge gently with cooled boiled water, twice a day, to keep it clean."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.22,
      "end_seconds": 227.31,
      "duration_seconds": 2.09,
      "text": "All right. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.73,
      "end_seconds": 233.47,
      "duration_seconds": 4.74,
      "text": "Don't squeeze it, and avoid eye make-up. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.64,
      "end_seconds": 239.16,
      "duration_seconds": 3.52,
      "text": "I don't wear any. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.27,
      "end_seconds": 251.74,
      "duration_seconds": 11.47,
      "text": "Because of her diabetes, I'd like to check her blood sugar control, so I'd like to arrange an HbA1c blood test."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 254.63,
      "end_seconds": 258.19,
      "duration_seconds": 3.56,
      "text": "Can she have it today? ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.4,
      "end_seconds": 266.19,
      "duration_seconds": 5.79,
      "text": "Yes, the nurse can take it before you go. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 268.27,
      "end_seconds": 270.24,
      "duration_seconds": 1.97,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.05,
      "end_seconds": 285.57,
      "duration_seconds": 12.52,
      "text": "If the swelling spreads to the cheek, the eye becomes very red or painful, or her vision changes, come back immediately."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 287.7,
      "end_seconds": 290.06,
      "duration_seconds": 2.36,
      "text": "I will. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.91,
      "end_seconds": 300.68,
      "duration_seconds": 8.77,
      "text": "I'd like to see her in two weeks, to check the stye has gone."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 301.77,
      "end_seconds": 306.03,
      "duration_seconds": 4.26,
      "text": "Two weeks. Thank you, doctor. ~"
    }
  ]
}
