{
  "schema_version": "1.0",
  "encounter_id": "00939",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.77,
      "end_seconds": 13.13,
      "duration_seconds": 12.36,
      "text": "Good morning, doctor. I've had a headache at my temple for a couple of weeks, and now my jaw hurts when I chew."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.04,
      "end_seconds": 25.27,
      "duration_seconds": 10.23,
      "text": "Thank you for coming promptly. That combination is something I want to take seriously. Which temple is it?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.19,
      "end_seconds": 37.31,
      "duration_seconds": 9.12,
      "text": "The right one. It's a throbbing pain, and the scalp is tender when I brush my hair."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.33,
      "end_seconds": 43.4,
      "duration_seconds": 4.07,
      "text": "How long has it been going on?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.34,
      "end_seconds": 49.69,
      "duration_seconds": 3.35,
      "text": "Two weeks. It's getting worse."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.09,
      "end_seconds": 55.73,
      "duration_seconds": 4.64,
      "text": "And the jaw pain, when exactly does it happen?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.7,
      "end_seconds": 63.92,
      "duration_seconds": 7.22,
      "text": "When I chew. Even a sandwich. I have to stop and rest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.53,
      "end_seconds": 72.63,
      "duration_seconds": 6.1,
      "text": "Any changes in your vision, double vision, or a curtain coming across?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.93,
      "end_seconds": 79.23,
      "duration_seconds": 4.3,
      "text": "No, not yet. My vision is the same."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.26,
      "end_seconds": 85.91,
      "duration_seconds": 3.65,
      "text": "Any fever, night sweats, or weight loss?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.77,
      "end_seconds": 94.79,
      "duration_seconds": 7.02,
      "text": "I've felt a bit feverish, but no sweats, no weight loss."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.9,
      "end_seconds": 101.66,
      "duration_seconds": 5.76,
      "text": "Any stiffness in the shoulders or hips in the mornings?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.94,
      "end_seconds": 108.21,
      "duration_seconds": 4.27,
      "text": "Yes. I thought that was just my age."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.42,
      "end_seconds": 113.43,
      "duration_seconds": 3.01,
      "text": "What medicines are you taking?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.14,
      "end_seconds": 123.42,
      "duration_seconds": 7.28,
      "text": "Just paracetamol, 1 gram, now and then. It's not touching the headache."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.48,
      "end_seconds": 129.14,
      "duration_seconds": 2.66,
      "text": "Any allergies to medicines?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.09,
      "end_seconds": 133.15,
      "duration_seconds": 2.06,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.1,
      "end_seconds": 138.3,
      "duration_seconds": 3.2,
      "text": "Any other medical conditions?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.66,
      "end_seconds": 147.98,
      "duration_seconds": 7.32,
      "text": "High blood pressure, but I take nothing for it. I'm trying diet."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.01,
      "end_seconds": 152.23,
      "duration_seconds": 2.22,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.65,
      "end_seconds": 158.07,
      "duration_seconds": 3.42,
      "text": "I gave up thirty years ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.14,
      "end_seconds": 166.27,
      "duration_seconds": 5.13,
      "text": "Let me take your pulse, blood pressure and temperature. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.08,
      "end_seconds": 178.83,
      "duration_seconds": 1.75,
      "text": "Go on."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.21,
      "end_seconds": 186.64,
      "duration_seconds": 5.43,
      "text": "Pulse 82, blood pressure 148 over 88, temperature 37.4."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.15,
      "end_seconds": 192.06,
      "duration_seconds": 2.91,
      "text": "A bit high? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.89,
      "end_seconds": 201.08,
      "duration_seconds": 6.19,
      "text": "A little, yes. Now let me feel your temples. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.38,
      "end_seconds": 218.82,
      "duration_seconds": 1.44,
      "text": "Ouch."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.38,
      "end_seconds": 228.22,
      "duration_seconds": 7.84,
      "text": "The right temporal artery is tender and thickened, and the pulse in it is weak."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.57,
      "end_seconds": 234.27,
      "duration_seconds": 3.7,
      "text": "What does that mean? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.14,
      "end_seconds": 245.36,
      "duration_seconds": 9.22,
      "text": "It makes me worried about giant cell arteritis, which can threaten the vision if untreated. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.3,
      "end_seconds": 251.19,
      "duration_seconds": 3.89,
      "text": "Do I need treatment now? ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.29,
      "end_seconds": 267.76,
      "duration_seconds": 13.47,
      "text": "Yes. I'd like you to take prednisolone, 60 mg, today, and I'm arranging an urgent blood test and a referral to the eye and rheumatology team."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.72,
      "end_seconds": 273.48,
      "duration_seconds": 3.76,
      "text": "Steroids? What about the side effects? ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.56,
      "end_seconds": 283.24,
      "duration_seconds": 7.68,
      "text": "They're a concern, but protecting your sight comes first, and we'll manage the risks. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.81,
      "end_seconds": 289.95,
      "duration_seconds": 5.14,
      "text": "All right, if you think that's best. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.02,
      "end_seconds": 301.26,
      "duration_seconds": 9.24,
      "text": "If you get any change in vision, call 999 or go to the emergency department at once."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.76,
      "end_seconds": 305.99,
      "duration_seconds": 3.23,
      "text": "I will. Thank you. ~"
    }
  ]
}
