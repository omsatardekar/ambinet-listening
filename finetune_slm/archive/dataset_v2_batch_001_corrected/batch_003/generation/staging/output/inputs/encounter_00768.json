{
  "schema_version": "1.0",
  "encounter_id": "00768",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.24,
      "end_seconds": 13.26,
      "duration_seconds": 12.02,
      "text": "Good morning, doctor. Thank you for seeing me. I was told at the kidney clinic that I'm anaemic, and I should come and discuss it."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.75,
      "end_seconds": 22.99,
      "duration_seconds": 8.24,
      "text": "Good morning, Mrs Fletcher. Yes, I've seen the letter. How have you been feeling lately? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.69,
      "end_seconds": 36.07,
      "duration_seconds": 10.38,
      "text": "Tired, I must say. More than usual. I used to garden every day, and now I sit down after twenty minutes."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.2,
      "end_seconds": 41.03,
      "duration_seconds": 2.83,
      "text": "And what about your breathing?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.88,
      "end_seconds": 50.93,
      "duration_seconds": 8.05,
      "text": "A bit short of breath on the hills, and the stairs. Not terrible."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.22,
      "end_seconds": 59.77,
      "duration_seconds": 7.55,
      "text": "Have you had any chest pain, or dizzy spells, or palpitations? ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.78,
      "end_seconds": 65.37,
      "duration_seconds": 4.59,
      "text": "No, none of that, thank goodness. ~"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.47,
      "end_seconds": 73.95,
      "duration_seconds": 5.48,
      "text": "How long has the tiredness been going on? ~"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.02,
      "end_seconds": 79.01,
      "duration_seconds": 3.99,
      "text": "Since the new year. Gradually creeping up."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.85,
      "end_seconds": 85.88,
      "duration_seconds": 5.03,
      "text": "You have chronic kidney disease, I see, stage three."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.26,
      "end_seconds": 94.45,
      "duration_seconds": 7.19,
      "text": "Yes, they told me eighteen months ago. It's stable, they say."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.71,
      "end_seconds": 102.34,
      "duration_seconds": 5.63,
      "text": "That's right. Let me check your pulse and blood pressure. ~"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.0,
      "end_seconds": 106.88,
      "duration_seconds": 1.88,
      "text": "Of course. ~"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.9,
      "end_seconds": 126.91,
      "duration_seconds": 6.01,
      "text": "Pulse 80, blood pressure 132 over 76, oxygen 97 percent."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.55,
      "end_seconds": 131.24,
      "duration_seconds": 2.69,
      "text": "Are those good? ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.53,
      "end_seconds": 141.45,
      "duration_seconds": 7.92,
      "text": "They're fine. I'll also look at your eyelids and your nails, which can show anaemia. ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.27,
      "end_seconds": 146.7,
      "duration_seconds": 3.43,
      "text": "Do I look pale? ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.41,
      "end_seconds": 151.84,
      "duration_seconds": 2.43,
      "text": "A little. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.96,
      "end_seconds": 156.04,
      "duration_seconds": 2.08,
      "text": "Oh dear. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.68,
      "end_seconds": 168.97,
      "duration_seconds": 10.29,
      "text": "Your blood test last month showed your haemoglobin was low, at 98. Normal for a woman is above 120. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.59,
      "end_seconds": 174.86,
      "duration_seconds": 4.27,
      "text": "That's quite a lot lower. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.76,
      "end_seconds": 191.43,
      "duration_seconds": 14.67,
      "text": "It is, and kidneys make a hormone that tells your bone marrow to make red blood cells, so when the kidneys are weaker, you can become anaemic. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.72,
      "end_seconds": 196.38,
      "duration_seconds": 2.66,
      "text": "So it's the kidneys? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.53,
      "end_seconds": 206.55,
      "duration_seconds": 8.02,
      "text": "I think that's the most likely cause, I'd say anaemia of chronic kidney disease."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.91,
      "end_seconds": 210.54,
      "duration_seconds": 2.63,
      "text": "Can it be treated? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.89,
      "end_seconds": 223.46,
      "duration_seconds": 11.57,
      "text": "Yes. First, I'd like to arrange more blood tests, to check your iron, vitamin B12 and folate levels, because other causes need ruling out."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.26,
      "end_seconds": 229.65,
      "duration_seconds": 3.39,
      "text": "Will it need injections? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.91,
      "end_seconds": 241.82,
      "duration_seconds": 10.91,
      "text": "Possibly, if your iron is normal and the anaemia is due to the kidneys. There are injections that help the bone marrow. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.08,
      "end_seconds": 247.64,
      "duration_seconds": 3.56,
      "text": "I'm not keen on injections. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.97,
      "end_seconds": 258.45,
      "duration_seconds": 8.48,
      "text": "They're small, and you can learn to do them yourself. We'll decide after the tests. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.84,
      "end_seconds": 263.83,
      "duration_seconds": 3.99,
      "text": "Right. Anything I can do? ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.65,
      "end_seconds": 274.92,
      "duration_seconds": 8.27,
      "text": "Eat iron-rich foods, like red meat, spinach, and beans, and don't take iron tablets until we've checked."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.8,
      "end_seconds": 281.3,
      "duration_seconds": 3.5,
      "text": "I take a multivitamin. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.29,
      "end_seconds": 285.36,
      "duration_seconds": 2.07,
      "text": "That's fine. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.55,
      "end_seconds": 288.61,
      "duration_seconds": 2.06,
      "text": "And rest? ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.15,
      "end_seconds": 300.8,
      "duration_seconds": 9.65,
      "text": "Pace yourself, build up your gardening slowly. I'd like to see you again in two weeks with the results."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.7,
      "end_seconds": 305.98,
      "duration_seconds": 3.28,
      "text": "Two weeks. Thank you, doctor. ~"
    }
  ]
}
