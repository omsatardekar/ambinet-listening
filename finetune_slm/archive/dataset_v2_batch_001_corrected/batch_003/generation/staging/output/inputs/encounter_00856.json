{
  "schema_version": "1.0",
  "encounter_id": "00856",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 1.12,
      "end_seconds": 15.24,
      "duration_seconds": 14.12,
      "text": "Doctor, I'm precise, so listen. My daughter Lily, she's five, pushed a bead into her left ear this morning at eight forty. She says it hurts."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.27,
      "end_seconds": 19.49,
      "duration_seconds": 2.22,
      "text": "It doesn't hurt."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 20.62,
      "end_seconds": 25.23,
      "duration_seconds": 4.61,
      "text": "Lily, you said it hurt, you were crying."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.06,
      "end_seconds": 30.78,
      "duration_seconds": 4.72,
      "text": "Hello Lily. Does your ear hurt now, sweetheart?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.74,
      "end_seconds": 36.95,
      "duration_seconds": 3.21,
      "text": "No. It's just there."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.57,
      "end_seconds": 49.27,
      "duration_seconds": 9.7,
      "text": "I'll note that you say it doesn't hurt, and Mum says you were crying. What was the bead like?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 51.08,
      "end_seconds": 57.86,
      "duration_seconds": 6.78,
      "text": "Small, round, red plastic, from her craft box. About five millimetres. ~"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.72,
      "end_seconds": 64.57,
      "duration_seconds": 3.85,
      "text": "Did anything come out of the ear?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 65.84,
      "end_seconds": 68.58,
      "duration_seconds": 2.74,
      "text": "No blood, no fluid."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.42,
      "end_seconds": 76.3,
      "duration_seconds": 4.88,
      "text": "Has she had any ear problems before? ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 78.26,
      "end_seconds": 80.46,
      "duration_seconds": 2.2,
      "text": "No, never. ~"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.68,
      "end_seconds": 85.24,
      "duration_seconds": 3.56,
      "text": "Is she on any medicines?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 86.52,
      "end_seconds": 94.43,
      "duration_seconds": 7.91,
      "text": "A teaspoon of something, I think. Calpol, maybe, five mil, at breakfast, because I was worried."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.48,
      "end_seconds": 98.93,
      "duration_seconds": 3.45,
      "text": "Thank you. How long ago? ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 100.41,
      "end_seconds": 105.29,
      "duration_seconds": 4.88,
      "text": "It's now ten-thirty, so about two hours. ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.4,
      "end_seconds": 118.59,
      "duration_seconds": 12.19,
      "text": "Lily, I'm going to look in your ear with a torch. You must keep very still. Can you do that for me? ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.62,
      "end_seconds": 138.72,
      "duration_seconds": 1.1,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.56,
      "end_seconds": 157.89,
      "duration_seconds": 17.33,
      "text": "I can see a small red bead in the outer part of the ear canal, and the skin around it is a little pink, but there's no bleeding, and I can't see the eardrum behind it. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 159.07,
      "end_seconds": 163.04,
      "duration_seconds": 3.97,
      "text": "Can you get it out? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.21,
      "end_seconds": 180.69,
      "duration_seconds": 15.48,
      "text": "I'd like to try. I'll use a small hook, and a gentle suction. It takes a few minutes, and she must stay still. Mum, will you hold her on your lap?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 183.23,
      "end_seconds": 186.01,
      "duration_seconds": 2.78,
      "text": "Yes. Of course. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.76,
      "end_seconds": 233.08,
      "duration_seconds": 4.32,
      "text": "Lily, you're going to hear a funny noise."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.93,
      "end_seconds": 238.01,
      "duration_seconds": 4.08,
      "text": "Got it. Here it is. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.47,
      "end_seconds": 242.22,
      "duration_seconds": 2.75,
      "text": "Can I see? ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.65,
      "end_seconds": 248.64,
      "duration_seconds": 3.99,
      "text": "Yes, look. A little red bead. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 250.88,
      "end_seconds": 254.13,
      "duration_seconds": 3.25,
      "text": "Oh, thank goodness. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.29,
      "end_seconds": 276.05,
      "duration_seconds": 5.76,
      "text": "I'll check the ear again, to make sure there's no scratch."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.82,
      "end_seconds": 289.06,
      "duration_seconds": 10.24,
      "text": "The ear canal has a tiny graze at the entrance, but the eardrum looks normal, and there's no damage. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 290.81,
      "end_seconds": 293.72,
      "duration_seconds": 2.91,
      "text": "Will she need antibiotics? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.47,
      "end_seconds": 308.23,
      "duration_seconds": 11.76,
      "text": "No. Don't put anything in the ear, keep it dry for a couple of days, and don't let her poke at it."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 309.88,
      "end_seconds": 311.68,
      "duration_seconds": 1.8,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.99,
      "end_seconds": 321.07,
      "duration_seconds": 7.08,
      "text": "If she gets earache, discharge, or says she can't hear, bring her back."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 322.86,
      "end_seconds": 324.66,
      "duration_seconds": 1.8,
      "text": "Understood. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.47,
      "end_seconds": 339.27,
      "duration_seconds": 11.8,
      "text": "And a word to keep the craft beads out of reach, and teach her to tell you if she puts something in. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 340.56,
      "end_seconds": 345.44,
      "duration_seconds": 4.88,
      "text": "I will. Thank you so much, doctor. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.29,
      "end_seconds": 349.25,
      "duration_seconds": 1.96,
      "text": "Bye bye. ~"
    }
  ]
}
