{
  "schema_version": "1.0",
  "encounter_id": "00831",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.95,
      "end_seconds": 10.15,
      "duration_seconds": 9.2,
      "text": "Um, hello? Sorry, I've had a nosebleed for about forty minutes, and it won't stop, and I'm a bit scared."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 12.51,
      "end_seconds": 22.39,
      "duration_seconds": 9.88,
      "text": "Sit forward, please, and keep pinching the soft part of your nose. I'm Dr Reilly. Which side is bleeding?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.57,
      "end_seconds": 32.05,
      "duration_seconds": 8.48,
      "text": "The right nostril, mostly. It started at breakfast, and it's been pouring on and off."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.88,
      "end_seconds": 40.11,
      "duration_seconds": 5.23,
      "text": "Have you swallowed much blood, or been sick?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.36,
      "end_seconds": 49.82,
      "duration_seconds": 8.46,
      "text": "A bit. I felt sick, so I spat it out. I've got blood all down my shirt."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.43,
      "end_seconds": 55.2,
      "duration_seconds": 2.77,
      "text": "Any history of nosebleeds? ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.67,
      "end_seconds": 62.05,
      "duration_seconds": 4.38,
      "text": "Now and then, but never like this. ~"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.92,
      "end_seconds": 68.26,
      "duration_seconds": 5.34,
      "text": "Did you knock your nose, or blow it hard?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.55,
      "end_seconds": 73.81,
      "duration_seconds": 4.26,
      "text": "No, nothing. It came on by itself."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.52,
      "end_seconds": 79.43,
      "duration_seconds": 3.91,
      "text": "Are you on any blood-thinning tablets?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.32,
      "end_seconds": 86.73,
      "duration_seconds": 4.41,
      "text": "Aspirin, 75 mg, once a day. That's all."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.21,
      "end_seconds": 90.84,
      "duration_seconds": 2.63,
      "text": "Any allergies to medicines?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.61,
      "end_seconds": 94.87,
      "duration_seconds": 1.26,
      "text": "None."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.14,
      "end_seconds": 98.03,
      "duration_seconds": 1.89,
      "text": "Any other conditions?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.81,
      "end_seconds": 108.76,
      "duration_seconds": 9.95,
      "text": "High blood pressure, and I take a tablet for it. And my heart, a stent, two years ago."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.7,
      "end_seconds": 114.29,
      "duration_seconds": 2.59,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.11,
      "end_seconds": 118.71,
      "duration_seconds": 3.6,
      "text": "A couple of pints most evenings."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.03,
      "end_seconds": 126.83,
      "duration_seconds": 5.8,
      "text": "I'll check your pressure and pulse. Keep pinching. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.55,
      "end_seconds": 128.92,
      "duration_seconds": 1.37,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.67,
      "end_seconds": 150.36,
      "duration_seconds": 5.69,
      "text": "Pulse 96, blood pressure 168 over 98, oxygen 98 percent."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.18,
      "end_seconds": 154.18,
      "duration_seconds": 3.0,
      "text": "Is that bad? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.32,
      "end_seconds": 168.53,
      "duration_seconds": 12.21,
      "text": "Your pressure is high, which can make nosebleeds worse. Let me look inside, I'll use the light and a suction. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.37,
      "end_seconds": 195.62,
      "duration_seconds": 1.25,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.03,
      "end_seconds": 211.32,
      "duration_seconds": 13.29,
      "text": "There's an active bleed from the front of the septum on the right side, a visible vessel, and a lot of clot in the nostril."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.67,
      "end_seconds": 215.35,
      "duration_seconds": 2.68,
      "text": "Can you stop it? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.86,
      "end_seconds": 227.07,
      "duration_seconds": 10.21,
      "text": "Yes. First, I'm going to put a swab soaked with a numbing and constricting solution in, and you hold it. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.83,
      "end_seconds": 261.26,
      "duration_seconds": 1.43,
      "text": "All right."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.52,
      "end_seconds": 278.5,
      "duration_seconds": 15.98,
      "text": "That's slowed it a lot. I'd say this is a bleed from a vessel at the front of the nose, made worse by high blood pressure and the aspirin."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.95,
      "end_seconds": 283.42,
      "duration_seconds": 3.47,
      "text": "Will it start again? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.97,
      "end_seconds": 297.44,
      "duration_seconds": 11.47,
      "text": "It might, so I'm going to cauterise the vessel with silver nitrate, a small sting, and then I'll put a small dressing in."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.19,
      "end_seconds": 302.96,
      "duration_seconds": 2.77,
      "text": "Does it hurt? ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.28,
      "end_seconds": 327.28,
      "duration_seconds": 2.0,
      "text": "A brief sting."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.11,
      "end_seconds": 342.01,
      "duration_seconds": 11.9,
      "text": "Done. Keep your head forward, don't blow your nose for a few days, and avoid hot drinks and alcohol for 24 hours."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.74,
      "end_seconds": 346.51,
      "duration_seconds": 1.77,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.17,
      "end_seconds": 364.62,
      "duration_seconds": 16.45,
      "text": "Don't take any more aspirin until I've checked with your heart doctor, and I'll see you in the morning to check the nose and your blood pressure."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 367.33,
      "end_seconds": 370.04,
      "duration_seconds": 2.71,
      "text": "Thank you, doctor. ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 372.47,
      "end_seconds": 380.93,
      "duration_seconds": 8.46,
      "text": "If it bleeds again, sit forward, pinch for fifteen minutes, and if it doesn't stop, come straight back."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 381.67,
      "end_seconds": 382.99,
      "duration_seconds": 1.32,
      "text": "Right. ~"
    }
  ]
}
