{
  "schema_version": "1.0",
  "encounter_id": "00911",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 2.47,
      "end_seconds": 14.67,
      "duration_seconds": 12.2,
      "text": "My leg is swollen and painful, and I'm terrified it's a blood clot. I read about it last night and I haven't slept."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.61,
      "end_seconds": 28.04,
      "duration_seconds": 9.43,
      "text": "I can hear how worried you are. Let's go through it carefully. Which leg is it?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.48,
      "end_seconds": 36.69,
      "duration_seconds": 5.21,
      "text": "The right calf. It's tight and sore when I walk."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.35,
      "end_seconds": 43.01,
      "duration_seconds": 3.66,
      "text": "When did you first notice it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.62,
      "end_seconds": 54.34,
      "duration_seconds": 7.72,
      "text": "Two days ago? Or three. I'm honestly not sure, I was away for work."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.19,
      "end_seconds": 62.74,
      "duration_seconds": 5.55,
      "text": "Have you been travelling or sitting for long periods? ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.13,
      "end_seconds": 70.95,
      "duration_seconds": 4.82,
      "text": "A long drive on Monday, about six hours. ~"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.6,
      "end_seconds": 76.8,
      "duration_seconds": 3.2,
      "text": "Any chest pain or breathlessness?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.19,
      "end_seconds": 85.7,
      "duration_seconds": 5.51,
      "text": "No chest pain. A bit worried, but no breathlessness."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.02,
      "end_seconds": 94.67,
      "duration_seconds": 5.65,
      "text": "Any redness, warmth or a recent injury to the leg?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.94,
      "end_seconds": 103.22,
      "duration_seconds": 5.28,
      "text": "No injury. It's not red. A bit warm, maybe."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.8,
      "end_seconds": 112.3,
      "duration_seconds": 5.5,
      "text": "Have you or anyone in your family had a clot before?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.33,
      "end_seconds": 119.63,
      "duration_seconds": 4.3,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.91,
      "end_seconds": 126.31,
      "duration_seconds": 3.4,
      "text": "Are you taking any medicines?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.14,
      "end_seconds": 137.49,
      "duration_seconds": 7.35,
      "text": "Just the blood thinner, rivaroxaban, 20 mg, once a day, with dinner."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.73,
      "end_seconds": 144.5,
      "duration_seconds": 3.77,
      "text": "Why were you prescribed that?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.18,
      "end_seconds": 162.57,
      "duration_seconds": 14.39,
      "text": "I had a clot in my leg three years ago. I was told to take it for a year, and I just carried on."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.53,
      "end_seconds": 171.05,
      "duration_seconds": 5.52,
      "text": "Are you taking it every day, including this week?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.95,
      "end_seconds": 182.3,
      "duration_seconds": 8.35,
      "text": "I think so. I missed two doses on the trip, maybe three. I'm not certain."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.25,
      "end_seconds": 193.53,
      "duration_seconds": 8.28,
      "text": "Thank you for being honest. That matters. I'd like to look at your leg. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.3,
      "end_seconds": 212.06,
      "duration_seconds": 1.76,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.1,
      "end_seconds": 224.77,
      "duration_seconds": 8.67,
      "text": "The right calf is swollen, about two centimetres bigger than the left, and tender along the vein."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.59,
      "end_seconds": 230.99,
      "duration_seconds": 3.4,
      "text": "Is it a clot? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.32,
      "end_seconds": 243.89,
      "duration_seconds": 9.57,
      "text": "It could be, and it could be a muscle strain. I can't tell which by feel alone."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.27,
      "end_seconds": 250.27,
      "duration_seconds": 3.0,
      "text": "What do we do? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.21,
      "end_seconds": 263.93,
      "duration_seconds": 10.72,
      "text": "I'd like you to have an ultrasound scan of the leg veins today, and a blood test for clotting."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.06,
      "end_seconds": 270.25,
      "duration_seconds": 2.19,
      "text": "Today? Okay. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.82,
      "end_seconds": 280.65,
      "duration_seconds": 6.83,
      "text": "I'll phone the department now. Please keep taking the rivaroxaban every day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.7,
      "end_seconds": 289.51,
      "duration_seconds": 4.81,
      "text": "I will. I won't miss any. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.25,
      "end_seconds": 299.59,
      "duration_seconds": 7.34,
      "text": "If you get chest pain, breathlessness, or cough up blood, call an ambulance."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.82,
      "end_seconds": 306.01,
      "duration_seconds": 3.19,
      "text": "I understand. Thank you. ~"
    }
  ]
}
