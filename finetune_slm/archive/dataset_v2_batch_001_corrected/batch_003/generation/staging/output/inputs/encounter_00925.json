{
  "schema_version": "1.0",
  "encounter_id": "00925",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 1.03,
      "end_seconds": 12.3,
      "duration_seconds": 11.27,
      "text": "Doctor, my mother-in-law has her days and nights mixed up. She's awake all night and sleeping all day, and we're all worn out."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.72,
      "end_seconds": 21.0,
      "duration_seconds": 7.28,
      "text": "That sounds exhausting for everyone. Mrs Banerjee, how do you feel about your sleep?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.61,
      "end_seconds": 27.99,
      "duration_seconds": 5.38,
      "text": "I sleep when I'm tired. What's wrong with that? ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 30.92,
      "end_seconds": 37.27,
      "duration_seconds": 6.35,
      "text": "She wanders around the house at three in the morning, turning lights on."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.83,
      "end_seconds": 43.88,
      "duration_seconds": 4.05,
      "text": "How long has it been going on?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 46.88,
      "end_seconds": 52.5,
      "duration_seconds": 5.62,
      "text": "Since she came out of hospital, about a month ago."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.56,
      "end_seconds": 60.99,
      "duration_seconds": 6.43,
      "text": "Is she confused at night, or does she know where she is?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 63.8,
      "end_seconds": 72.65,
      "duration_seconds": 8.85,
      "text": "Sometimes she thinks she's back in her old house, and she asks for people who passed away."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.0,
      "end_seconds": 81.14,
      "duration_seconds": 7.14,
      "text": "I know where I am. I'm just looking for my things. ~"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.29,
      "end_seconds": 86.42,
      "duration_seconds": 4.13,
      "text": "Has she had any falls, or bumped herself?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 87.8,
      "end_seconds": 90.7,
      "duration_seconds": 2.9,
      "text": "No falls. Thank goodness."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.01,
      "end_seconds": 97.12,
      "duration_seconds": 5.11,
      "text": "Any pain, fever or changes in her passing urine?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 98.92,
      "end_seconds": 101.42,
      "duration_seconds": 2.5,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.33,
      "end_seconds": 107.74,
      "duration_seconds": 3.41,
      "text": "What medicines is she taking?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 109.17,
      "end_seconds": 114.72,
      "duration_seconds": 5.55,
      "text": "Just the blood pressure tablet, amlodipine, 5 mg, in the morning."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.07,
      "end_seconds": 122.6,
      "duration_seconds": 6.53,
      "text": "No sleeping tablets or anything new from the hospital? ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 125.1,
      "end_seconds": 129.34,
      "duration_seconds": 4.24,
      "text": "No, nothing new. They checked all that. ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.1,
      "end_seconds": 133.71,
      "duration_seconds": 2.61,
      "text": "Any past medical problems?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 134.51,
      "end_seconds": 143.31,
      "duration_seconds": 8.8,
      "text": "High blood pressure, a mild stroke some years ago, and she had a chest infection in the hospital."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.35,
      "end_seconds": 152.05,
      "duration_seconds": 6.7,
      "text": "Does she go out in daylight, or sit by a window? ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 152.97,
      "end_seconds": 159.32,
      "duration_seconds": 6.35,
      "text": "Not really. She stays in her room with the curtains drawn. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.13,
      "end_seconds": 170.42,
      "duration_seconds": 8.29,
      "text": "That could be part of the problem. Let me check her pulse and pressure. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.76,
      "end_seconds": 186.18,
      "duration_seconds": 3.42,
      "text": "I don't like all this fuss."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.42,
      "end_seconds": 192.07,
      "duration_seconds": 4.65,
      "text": "Pulse 78, blood pressure 140 over 82."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 193.96,
      "end_seconds": 197.74,
      "duration_seconds": 3.78,
      "text": "Is that all right? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.98,
      "end_seconds": 209.2,
      "duration_seconds": 10.22,
      "text": "A little high, but fine. I'd like to look at her briefly, and ask her a few memory questions. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.19,
      "end_seconds": 231.48,
      "duration_seconds": 2.29,
      "text": "Go on, then."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.47,
      "end_seconds": 241.06,
      "duration_seconds": 7.59,
      "text": "She is alert, a little muddled about the date, and her chest is clear."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 243.54,
      "end_seconds": 246.13,
      "duration_seconds": 2.59,
      "text": "Is it dementia? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.54,
      "end_seconds": 260.0,
      "duration_seconds": 12.46,
      "text": "I can't say that today. A hospital stay can unsettle the body clock, and I'd like to rule out other causes with a blood and urine test."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 260.78,
      "end_seconds": 264.82,
      "duration_seconds": 4.04,
      "text": "When can we do those? ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.71,
      "end_seconds": 279.39,
      "duration_seconds": 11.68,
      "text": "Today, if you can wait. And the first step is routine, so open the curtains in the morning, and get her out in daylight."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 281.32,
      "end_seconds": 284.07,
      "duration_seconds": 2.75,
      "text": "I'll do that. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.52,
      "end_seconds": 296.14,
      "duration_seconds": 10.62,
      "text": "Keep her active in the day, avoid long naps after lunch, and keep the evenings calm and quiet. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 297.19,
      "end_seconds": 299.42,
      "duration_seconds": 2.23,
      "text": "We'll try. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.95,
      "end_seconds": 309.46,
      "duration_seconds": 7.51,
      "text": "I'll see her again in three weeks, and we'll see if the pattern has shifted."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 310.89,
      "end_seconds": 313.75,
      "duration_seconds": 2.86,
      "text": "Thank you, doctor. ~"
    }
  ]
}
