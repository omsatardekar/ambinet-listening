{
  "schema_version": "1.0",
  "encounter_id": "00894",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 3.01,
      "end_seconds": 11.34,
      "duration_seconds": 8.33,
      "text": "I'm here for my injection review. I haven't got long, I've a meeting at eleven."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.79,
      "end_seconds": 23.02,
      "duration_seconds": 8.23,
      "text": "Understood, we'll be quick but thorough. Which injection do you have at the moment?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.32,
      "end_seconds": 31.2,
      "duration_seconds": 3.88,
      "text": "Adalimumab. Forty milligrams, every two weeks."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.22,
      "end_seconds": 39.08,
      "duration_seconds": 3.86,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.82,
      "end_seconds": 45.19,
      "duration_seconds": 2.37,
      "text": "Just over a year."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.97,
      "end_seconds": 52.33,
      "duration_seconds": 3.36,
      "text": "And how are your joints?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.68,
      "end_seconds": 69.63,
      "duration_seconds": 12.95,
      "text": "Much better than before. My hands are stiff when I wake up, but it passes in half an hour or so."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.72,
      "end_seconds": 78.24,
      "duration_seconds": 5.52,
      "text": "When did the stiffness last get really bad?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.27,
      "end_seconds": 87.98,
      "duration_seconds": 5.71,
      "text": "Not sure. Some time in the autumn? Maybe winter."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.12,
      "end_seconds": 97.39,
      "duration_seconds": 6.27,
      "text": "Any infections since the last visit, coughs, fevers or night sweats?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.56,
      "end_seconds": 104.46,
      "duration_seconds": 2.9,
      "text": "No. None of that."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.45,
      "end_seconds": 112.95,
      "duration_seconds": 4.5,
      "text": "Have you had any injection-site reactions? ~"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.23,
      "end_seconds": 122.36,
      "duration_seconds": 5.13,
      "text": "A little redness sometimes, but it goes. ~"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.36,
      "end_seconds": 132.68,
      "duration_seconds": 6.32,
      "text": "Any problems with the pen, or have you missed doses? ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.2,
      "end_seconds": 140.06,
      "duration_seconds": 3.86,
      "text": "No, I'm quite regimented about it. ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.4,
      "end_seconds": 152.46,
      "duration_seconds": 8.06,
      "text": "Good. And are you happy with how you manage the injections yourself? ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.56,
      "end_seconds": 159.91,
      "duration_seconds": 3.35,
      "text": "Yes. It takes a minute. ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.07,
      "end_seconds": 168.72,
      "duration_seconds": 5.65,
      "text": "That's useful. Have you had your blood tests done recently? ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.13,
      "end_seconds": 179.43,
      "duration_seconds": 6.3,
      "text": "A month ago. The nurse said they were fine. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.57,
      "end_seconds": 190.41,
      "duration_seconds": 6.84,
      "text": "Great. I've seen the results. Your inflammatory markers are low. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.08,
      "end_seconds": 197.34,
      "duration_seconds": 3.26,
      "text": "That's good, isn't it? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.57,
      "end_seconds": 207.66,
      "duration_seconds": 6.09,
      "text": "It is. It suggests the drug is working well. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.74,
      "end_seconds": 216.07,
      "duration_seconds": 5.33,
      "text": "So we carry on as we are? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.21,
      "end_seconds": 225.95,
      "duration_seconds": 6.74,
      "text": "Yes, I'd continue the same dose and the same interval. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.28,
      "end_seconds": 235.91,
      "duration_seconds": 6.63,
      "text": "Good. I don't want to change a winning team. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.83,
      "end_seconds": 247.36,
      "duration_seconds": 7.53,
      "text": "I'll also remind you to tell us before any live vaccine or planned surgery. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.69,
      "end_seconds": 253.7,
      "duration_seconds": 2.01,
      "text": "I will. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.16,
      "end_seconds": 269.6,
      "duration_seconds": 11.44,
      "text": "Please keep to the schedule. If you develop a fever or a new infection, hold the next injection and call us."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.62,
      "end_seconds": 275.34,
      "duration_seconds": 1.72,
      "text": "Understood. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.49,
      "end_seconds": 284.47,
      "duration_seconds": 4.98,
      "text": "Otherwise we'll review you in six months. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.32,
      "end_seconds": 292.08,
      "duration_seconds": 3.76,
      "text": "Six months. Right. Thank you. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.15,
      "end_seconds": 299.15,
      "duration_seconds": 3.0,
      "text": "Have a good meeting. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.39,
      "end_seconds": 306.0,
      "duration_seconds": 2.61,
      "text": "Thanks, I'll try. ~"
    }
  ]
}
