{
  "schema_version": "1.0",
  "encounter_id": "00686",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_4",
      "role": "CAREGIVER",
      "start_seconds": 0.92,
      "end_seconds": 9.32,
      "duration_seconds": 8.4,
      "text": "Morning, doctor. I'm Tolu, I'm Fiona's support worker, I come in with her to appointments. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.92,
      "end_seconds": 18.73,
      "duration_seconds": 7.81,
      "text": "Welcome, Tolu. Fiona, I'm Dr Marsh. I know you've been referred about your voice. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.92,
      "end_seconds": 28.87,
      "duration_seconds": 7.95,
      "text": "Yes. I'm a teacher, and my voice is going by Wednesday every week."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.79,
      "end_seconds": 35.63,
      "duration_seconds": 3.84,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.87,
      "end_seconds": 45.07,
      "duration_seconds": 8.2,
      "text": "Four months. It's rough and croaky, and then it gives out in the afternoons."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.86,
      "end_seconds": 49.06,
      "duration_seconds": 3.2,
      "text": "Is it worse at certain times?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.12,
      "end_seconds": 58.61,
      "duration_seconds": 7.49,
      "text": "By the end of the school day. By Friday, it's nearly a whisper."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.76,
      "end_seconds": 61.54,
      "duration_seconds": 1.78,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.63,
      "end_seconds": 66.57,
      "duration_seconds": 2.94,
      "text": "Never. I've never smoked."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.99,
      "end_seconds": 71.13,
      "duration_seconds": 3.14,
      "text": "Tell me about your work."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.55,
      "end_seconds": 83.99,
      "duration_seconds": 10.44,
      "text": "I teach Year 3, twenty-eight children, in a noisy classroom. I talk all day, and I'm always raising my voice over them."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.41,
      "end_seconds": 91.3,
      "duration_seconds": 4.89,
      "text": "That fits. What about your health generally?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.47,
      "end_seconds": 103.24,
      "duration_seconds": 9.77,
      "text": "I have cerebral palsy, which affects my legs, so I use the wheelchair. It's never affected my voice before."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "CAREGIVER",
      "start_seconds": 105.54,
      "end_seconds": 111.28,
      "duration_seconds": 5.74,
      "text": "She's very brave. She won't take a day off. ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.58,
      "end_seconds": 115.82,
      "duration_seconds": 3.24,
      "text": "Any reflux, acid coming up?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.48,
      "end_seconds": 125.81,
      "duration_seconds": 7.33,
      "text": "Yes, a bit, and I take omeprazole, 20 mg once a day, for it."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.39,
      "end_seconds": 132.31,
      "duration_seconds": 4.92,
      "text": "Good. Nurse Beth, could you set up the nasendoscope? ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 134.27,
      "end_seconds": 143.45,
      "duration_seconds": 9.18,
      "text": "Of course, doctor. Fiona, I'll just spray your nose with a numbing spray. It tastes a bit odd. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.42,
      "end_seconds": 146.23,
      "duration_seconds": 1.81,
      "text": "Ugh, yes. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 168.0,
      "end_seconds": 170.17,
      "duration_seconds": 2.17,
      "text": "All ready, doctor."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.56,
      "end_seconds": 185.98,
      "duration_seconds": 14.42,
      "text": "Fiona, I'm going to pass the camera through your nose to look at your vocal cords. Breathe normally, and say eeee when I ask. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.99,
      "end_seconds": 189.94,
      "duration_seconds": 1.95,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.77,
      "end_seconds": 192.86,
      "duration_seconds": 2.09,
      "text": "Say eeee. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.73,
      "end_seconds": 209.81,
      "duration_seconds": 1.08,
      "text": "Eeeeee."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.51,
      "end_seconds": 216.42,
      "duration_seconds": 4.91,
      "text": "Thank you. That's it, camera's out. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.5,
      "end_seconds": 221.64,
      "duration_seconds": 3.14,
      "text": "What did you see? ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.43,
      "end_seconds": 232.94,
      "duration_seconds": 8.51,
      "text": "There are small swellings on both vocal cords, in the middle where they meet."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "CAREGIVER",
      "start_seconds": 235.14,
      "end_seconds": 237.96,
      "duration_seconds": 2.82,
      "text": "What does that mean? ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.06,
      "end_seconds": 247.71,
      "duration_seconds": 8.65,
      "text": "With the history of heavy voice use, I think these are vocal cord nodules."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.47,
      "end_seconds": 252.46,
      "duration_seconds": 2.99,
      "text": "Nodules? Is it serious? ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.21,
      "end_seconds": 264.8,
      "duration_seconds": 9.59,
      "text": "They're not cancer, they're like calluses, from overuse. The best treatment is voice therapy, not surgery. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.79,
      "end_seconds": 269.42,
      "duration_seconds": 2.63,
      "text": "That's a relief. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.5,
      "end_seconds": 282.5,
      "duration_seconds": 11.0,
      "text": "I'll refer you to the speech and language therapist, who'll teach you ways to use your voice without strain."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "CAREGIVER",
      "start_seconds": 284.12,
      "end_seconds": 288.38,
      "duration_seconds": 4.26,
      "text": "How long will that take? ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.55,
      "end_seconds": 296.71,
      "duration_seconds": 6.16,
      "text": "They'll write with an appointment, usually within a few weeks. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.05,
      "end_seconds": 301.56,
      "duration_seconds": 3.51,
      "text": "And in the meantime? ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.8,
      "end_seconds": 314.63,
      "duration_seconds": 11.83,
      "text": "Drink plenty of water, rest your voice at breaks, and use a microphone in class, if your school can provide one."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.86,
      "end_seconds": 319.13,
      "duration_seconds": 3.27,
      "text": "I'll ask the head. ~"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.14,
      "end_seconds": 325.94,
      "duration_seconds": 5.8,
      "text": "Avoid shouting and whispering. A normal gentle voice is better. ~"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.84,
      "end_seconds": 329.9,
      "duration_seconds": 3.06,
      "text": "Thank you, doctor. ~"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 331.86,
      "end_seconds": 339.63,
      "duration_seconds": 7.77,
      "text": "I'll take you out through the side door, it's easier for the chair. ~"
    }
  ]
}
