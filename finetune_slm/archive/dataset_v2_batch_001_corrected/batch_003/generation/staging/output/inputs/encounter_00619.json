{
  "schema_version": "1.0",
  "encounter_id": "00619",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.4,
      "end_seconds": 11.95,
      "duration_seconds": 11.55,
      "text": "Good morning, doctor. Thank you for seeing me. I'm back about my rash, though it is much improved, I must say."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.8,
      "end_seconds": 21.9,
      "duration_seconds": 8.1,
      "text": "Good morning. Lovely to hear. Remind me where it began, because I see you were away. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.19,
      "end_seconds": 36.53,
      "duration_seconds": 13.34,
      "text": "Yes, we went to Goa for a week and my back and chest came out in tiny red spots, very prickly and itchy."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.07,
      "end_seconds": 47.99,
      "duration_seconds": 8.92,
      "text": "And how are those spots now, compared to when you came to me first?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.79,
      "end_seconds": 66.08,
      "duration_seconds": 15.29,
      "text": "Mostly gone from the chest. The itching has gone away from my back too, thank God. It is only my neck now that is still red."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.64,
      "end_seconds": 79.25,
      "duration_seconds": 11.61,
      "text": "So the chest rash has settled, the itch on the back has settled, and the neck is still active?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.56,
      "end_seconds": 91.67,
      "duration_seconds": 11.11,
      "text": "Exactly so. The neck is still a bit itchy, especially at night when I'm warm under the blanket."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.6,
      "end_seconds": 100.21,
      "duration_seconds": 5.61,
      "text": "And any new blisters, or skin breaking down or weeping?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.43,
      "end_seconds": 106.9,
      "duration_seconds": 4.47,
      "text": "No, no blisters at all. Nothing weeping either."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.2,
      "end_seconds": 116.91,
      "duration_seconds": 7.71,
      "text": "Wonderful. Now, tell me which creams you are using, so I can check them. ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.15,
      "end_seconds": 132.95,
      "duration_seconds": 14.8,
      "text": "I am using hydrocortisone cream 1% twice a day on the neck, calamine lotion when it itches, and also cetirizine 10 mg at night."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.07,
      "end_seconds": 144.86,
      "duration_seconds": 9.79,
      "text": "Good. Cetirizine at night helps with itching. Are you allergic to any medicines, or have you ever been?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.92,
      "end_seconds": 152.82,
      "duration_seconds": 5.9,
      "text": "No, I have no known allergies. None at all."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.02,
      "end_seconds": 160.28,
      "duration_seconds": 6.26,
      "text": "Thank you. Your medical history, anything long-term that I should know?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.11,
      "end_seconds": 173.4,
      "duration_seconds": 12.29,
      "text": "I have type 2 diabetes, and I take tablets for it. Also asthma since childhood, but it is quiet nowadays."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.25,
      "end_seconds": 179.81,
      "duration_seconds": 3.56,
      "text": "Noted. Any operations in the past?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.53,
      "end_seconds": 186.42,
      "duration_seconds": 4.89,
      "text": "Gallbladder removal, in 2017. Done by keyhole, very neat."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.63,
      "end_seconds": 198.31,
      "duration_seconds": 9.68,
      "text": "Good. Let me look at your skin. Please turn around and lift your shirt. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.77,
      "end_seconds": 202.31,
      "duration_seconds": 2.54,
      "text": "Of course, doctor. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.02,
      "end_seconds": 226.16,
      "duration_seconds": 9.14,
      "text": "Pulse 78, blood pressure 130 over 82, temperature 36.7, oxygen 98 percent, respiratory rate 16."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.71,
      "end_seconds": 231.76,
      "duration_seconds": 4.05,
      "text": "These are good numbers, no? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.04,
      "end_seconds": 254.1,
      "duration_seconds": 10.06,
      "text": "Very good. Back and chest are clear now, just faint marks. The neck has a patch of red pinpoint spots."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.93,
      "end_seconds": 265.4,
      "duration_seconds": 8.47,
      "text": "It looks worse when I look in the mirror than it feels. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.73,
      "end_seconds": 280.63,
      "duration_seconds": 13.9,
      "text": "Heat rash usually looks dramatic. This looks like it is settling, and I would call it heat rash that is clearing, with some irritation on top of it."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.78,
      "end_seconds": 286.51,
      "duration_seconds": 4.73,
      "text": "Is it contagious? My daughter is worried. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.5,
      "end_seconds": 299.83,
      "duration_seconds": 10.33,
      "text": "Not at all. Keep the neck cool and loosely covered, cotton collars, no tight chains or scarves."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.2,
      "end_seconds": 308.17,
      "duration_seconds": 5.97,
      "text": "I have been wearing my gold chain, I will remove it. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.63,
      "end_seconds": 316.8,
      "duration_seconds": 7.17,
      "text": "Please do. Continue the hydrocortisone on the neck for another five days, then stop."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.96,
      "end_seconds": 322.99,
      "duration_seconds": 4.03,
      "text": "Another five days. Good. And the cetirizine? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.65,
      "end_seconds": 338.87,
      "duration_seconds": 14.22,
      "text": "Take it at night until the itching has gone, then you may stop. I would like to see you again in two weeks to make sure it has gone."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.55,
      "end_seconds": 348.32,
      "duration_seconds": 6.77,
      "text": "In two weeks. I will book on the way out. Thank you, doctor. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.7,
      "end_seconds": 357.83,
      "duration_seconds": 7.13,
      "text": "My pleasure. Keep cool, and enjoy the rest of the monsoon. ~"
    }
  ]
}
