{
  "schema_version": "1.0",
  "encounter_id": "00693",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 1.17,
      "end_seconds": 9.39,
      "duration_seconds": 8.22,
      "text": "Good morning, Mr Iyer. Terrible rain today. Did you manage to park? ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.79,
      "end_seconds": 20.7,
      "duration_seconds": 8.91,
      "text": "Good morning, doctor. Yes, thank you, third floor of the car park, very inconvenient, but I managed. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.29,
      "end_seconds": 29.56,
      "duration_seconds": 6.27,
      "text": "Always the third floor. So, the knee. Tell me from the beginning. ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.16,
      "end_seconds": 42.87,
      "duration_seconds": 10.71,
      "text": "Certainly. My right knee locks, sometimes it gets stuck and I cannot straighten it. This has been going on for two months."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.97,
      "end_seconds": 47.32,
      "duration_seconds": 2.35,
      "text": "Locks how, stuck bent?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.27,
      "end_seconds": 57.8,
      "duration_seconds": 8.53,
      "text": "Yes, bent, about thirty degrees I think. Then I wiggle it and it clicks free."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.63,
      "end_seconds": 64.4,
      "duration_seconds": 4.77,
      "text": "Interesting. And does it also let you down?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.21,
      "end_seconds": 77.47,
      "duration_seconds": 10.26,
      "text": "Yes, giving way. On the stairs mostly, going down. Last week I nearly fell at the office."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.37,
      "end_seconds": 80.25,
      "duration_seconds": 1.88,
      "text": "Any swelling?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.8,
      "end_seconds": 88.23,
      "duration_seconds": 6.43,
      "text": "After badminton on Sundays, it swells up like a small football."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.34,
      "end_seconds": 93.43,
      "duration_seconds": 3.09,
      "text": "And pain on the stairs?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.97,
      "end_seconds": 102.91,
      "duration_seconds": 6.94,
      "text": "Pain, yes, on the inside of the knee when I climb the stairs."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.62,
      "end_seconds": 107.17,
      "duration_seconds": 3.55,
      "text": "Did you fall or twist it?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.17,
      "end_seconds": 113.68,
      "duration_seconds": 4.51,
      "text": "No fall, no twisting that I recall."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.76,
      "end_seconds": 118.36,
      "duration_seconds": 3.6,
      "text": "Any redness or heat over the knee?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.22,
      "end_seconds": 123.9,
      "duration_seconds": 2.68,
      "text": "No redness, no heat."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.44,
      "end_seconds": 127.5,
      "duration_seconds": 1.06,
      "text": "Fever?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.9,
      "end_seconds": 131.43,
      "duration_seconds": 2.53,
      "text": "No fever, doctor."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.18,
      "end_seconds": 137.36,
      "duration_seconds": 3.18,
      "text": "Let's go through your tablets."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.32,
      "end_seconds": 152.64,
      "duration_seconds": 13.32,
      "text": "Metformin, 500 mg, twice a day, every day, I take it regularly. Well, mostly. I sometimes miss the evening one if I come home late."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.77,
      "end_seconds": 167.48,
      "duration_seconds": 12.71,
      "text": "Amlodipine, 5 mg, once a day. And diclofenac, maybe 50 mg? When the knee is bad. I will check the packet."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.58,
      "end_seconds": 173.64,
      "duration_seconds": 4.06,
      "text": "Thank you. Any allergies to medicines?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.78,
      "end_seconds": 179.57,
      "duration_seconds": 3.79,
      "text": "No allergies, none that I know of."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.9,
      "end_seconds": 184.16,
      "duration_seconds": 3.26,
      "text": "And your other health conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.91,
      "end_seconds": 193.47,
      "duration_seconds": 8.56,
      "text": "Type 2 diabetes, high blood pressure, and some osteoarthritis in the other knee."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.71,
      "end_seconds": 198.17,
      "duration_seconds": 2.46,
      "text": "Any previous operations?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.55,
      "end_seconds": 207.27,
      "duration_seconds": 6.72,
      "text": "My appendix as a teenager, and a hernia repair in 2015."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.99,
      "end_seconds": 212.6,
      "duration_seconds": 2.61,
      "text": "Diabetes in the family?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.7,
      "end_seconds": 216.36,
      "duration_seconds": 2.66,
      "text": "My mother had diabetes."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.09,
      "end_seconds": 220.5,
      "duration_seconds": 3.41,
      "text": "What do you do for work?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.42,
      "end_seconds": 225.49,
      "duration_seconds": 4.07,
      "text": "I am a bank manager, so much sitting."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.4,
      "end_seconds": 229.52,
      "duration_seconds": 2.12,
      "text": "Do you drink?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.05,
      "end_seconds": 234.97,
      "duration_seconds": 2.92,
      "text": "I don't drink any alcohol."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.78,
      "end_seconds": 238.49,
      "duration_seconds": 2.71,
      "text": "And badminton, how often?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.33,
      "end_seconds": 247.15,
      "duration_seconds": 6.82,
      "text": "Every Sunday morning with my son. I would hate to give it up."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.61,
      "end_seconds": 279.27,
      "duration_seconds": 14.66,
      "text": "Right, let me see the knee. Pulse 78, blood pressure 130 over 82, temperature 36.6, oxygen 98 percent, breathing 16, and weight 80 kilos."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.41,
      "end_seconds": 284.51,
      "duration_seconds": 3.1,
      "text": "A little high, the pressure? ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.8,
      "end_seconds": 302.85,
      "duration_seconds": 7.05,
      "text": "A touch, nothing alarming. Lie back, please. I'm going to bend the knee."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.43,
      "end_seconds": 309.14,
      "duration_seconds": 4.71,
      "text": "Ah, that is the sore spot. ~"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.32,
      "end_seconds": 321.43,
      "duration_seconds": 11.11,
      "text": "There's tenderness along the inner joint line, and I can feel a click when I bend and rotate it."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.93,
      "end_seconds": 327.65,
      "duration_seconds": 3.72,
      "text": "Is that the lock? ~"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.14,
      "end_seconds": 335.27,
      "duration_seconds": 6.13,
      "text": "Possibly. Any trouble with your breathing, chest, anything like that?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.93,
      "end_seconds": 339.62,
      "duration_seconds": 2.69,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.69,
      "end_seconds": 349.53,
      "duration_seconds": 7.84,
      "text": "My impression is a torn meniscus, the cartilage in the knee, but the scan will tell."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.45,
      "end_seconds": 355.2,
      "duration_seconds": 2.75,
      "text": "Will I need surgery? ~"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.15,
      "end_seconds": 367.27,
      "duration_seconds": 11.12,
      "text": "Maybe not. I'd like to arrange an MRI of the knee, and an X-ray of the knee as well."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 369.05,
      "end_seconds": 371.8,
      "duration_seconds": 2.75,
      "text": "And how soon? ~"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 374.65,
      "end_seconds": 385.45,
      "duration_seconds": 10.8,
      "text": "The MRI is a few weeks. I'd also like to do a blood test for your HbA1c, since the sugar affects healing."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 387.27,
      "end_seconds": 390.07,
      "duration_seconds": 2.8,
      "text": "And is badminton allowed? ~"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 392.78,
      "end_seconds": 401.31,
      "duration_seconds": 8.53,
      "text": "I'd rest it until the scan. Also, let's get a physiotherapist to see you."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 404.2,
      "end_seconds": 406.58,
      "duration_seconds": 2.38,
      "text": "Very well. ~"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 408.5,
      "end_seconds": 415.48,
      "duration_seconds": 6.98,
      "text": "If it locks again before the scan, come back sooner and we'll see you urgently."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 417.55,
      "end_seconds": 421.43,
      "duration_seconds": 3.88,
      "text": "Yes, understood, thank you, doctor. ~"
    }
  ]
}
