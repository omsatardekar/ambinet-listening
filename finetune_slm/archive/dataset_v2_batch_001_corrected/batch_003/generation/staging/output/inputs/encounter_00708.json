{
  "schema_version": "1.0",
  "encounter_id": "00708",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 2.68,
      "end_seconds": 13.34,
      "duration_seconds": 10.66,
      "text": "Good morning. I'll be precise: I started rosuvastatin eight weeks ago, and I have joint aches since, in my hands and knees."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.1,
      "end_seconds": 22.96,
      "duration_seconds": 6.86,
      "text": "Thank you, that helps. Tell me about the aches, which joints, when?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.27,
      "end_seconds": 35.28,
      "duration_seconds": 10.01,
      "text": "Both hands, particularly the knuckles, and both knees. Worse in the morning, easing by about ten."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.53,
      "end_seconds": 42.35,
      "duration_seconds": 3.82,
      "text": "Any swelling or redness in the joints?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.2,
      "end_seconds": 48.37,
      "duration_seconds": 3.17,
      "text": "No visible swelling. No redness."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.3,
      "end_seconds": 54.53,
      "duration_seconds": 3.23,
      "text": "And what are you taking?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.3,
      "end_seconds": 63.59,
      "duration_seconds": 6.29,
      "text": "Rosuvastatin, 10 mg once a day, in the evening. Nothing else at all."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.18,
      "end_seconds": 70.22,
      "duration_seconds": 3.04,
      "text": "What conditions do you have?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.69,
      "end_seconds": 81.1,
      "duration_seconds": 8.41,
      "text": "High cholesterol, which is why I started it, and osteoarthritis in the right hip, diagnosed last year."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.54,
      "end_seconds": 86.76,
      "duration_seconds": 2.22,
      "text": "Do you exercise?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.11,
      "end_seconds": 97.05,
      "duration_seconds": 7.94,
      "text": "I swim three times a week, one kilometre. I've done it for years."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.79,
      "end_seconds": 107.52,
      "duration_seconds": 6.73,
      "text": "Any breathlessness, chest tightness, or cough, while we're checking you over?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.05,
      "end_seconds": 114.11,
      "duration_seconds": 4.06,
      "text": "No, nothing like that. My breathing's fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.44,
      "end_seconds": 120.12,
      "duration_seconds": 3.68,
      "text": "Let me take your numbers. ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.57,
      "end_seconds": 124.41,
      "duration_seconds": 1.84,
      "text": "Please. ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.98,
      "end_seconds": 151.04,
      "duration_seconds": 9.06,
      "text": "Pulse 66, blood pressure 120 over 74, temperature 36.5, oxygen 99 percent, weight 71 kilos."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.04,
      "end_seconds": 157.27,
      "duration_seconds": 3.23,
      "text": "All as I'd expect. ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.06,
      "end_seconds": 170.1,
      "duration_seconds": 9.04,
      "text": "Good. Now, when you say it began after the statin, can you narrow it down? ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.08,
      "end_seconds": 185.56,
      "duration_seconds": 11.48,
      "text": "Around week three. But I'd had a cold in week two, so I can't be certain it's the tablet. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.37,
      "end_seconds": 204.02,
      "duration_seconds": 15.65,
      "text": "A sensible point. Joint aches are less typical than muscle aches with statins, but they do happen. I'd say a statin side effect is possible, rather than certain."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.76,
      "end_seconds": 211.01,
      "duration_seconds": 3.25,
      "text": "What else could it be? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.97,
      "end_seconds": 226.39,
      "duration_seconds": 12.42,
      "text": "Early inflammatory arthritis is on the list because of the morning stiffness in your knuckles, though the stiffness is brief. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.3,
      "end_seconds": 233.09,
      "duration_seconds": 3.79,
      "text": "Should I stop the rosuvastatin? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.24,
      "end_seconds": 247.29,
      "duration_seconds": 11.05,
      "text": "Not yet. I'd like to arrange blood tests, to check your muscle enzymes, thyroid and inflammation markers, and an X-ray of both hands."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.61,
      "end_seconds": 254.39,
      "duration_seconds": 3.78,
      "text": "When can I have them? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.91,
      "end_seconds": 266.04,
      "duration_seconds": 9.13,
      "text": "This week. The nurse will take the bloods, and the X-ray department will book you. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.64,
      "end_seconds": 271.38,
      "duration_seconds": 1.74,
      "text": "Excellent. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.96,
      "end_seconds": 282.53,
      "duration_seconds": 7.57,
      "text": "Take paracetamol if the aches get in the way, but not more than the packet says."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.99,
      "end_seconds": 289.77,
      "duration_seconds": 3.78,
      "text": "I rarely take any. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.65,
      "end_seconds": 299.61,
      "duration_seconds": 6.96,
      "text": "I'd like to see you in two weeks with the results."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.24,
      "end_seconds": 305.98,
      "duration_seconds": 3.74,
      "text": "Two weeks. I'll bring my notes. ~"
    }
  ]
}
