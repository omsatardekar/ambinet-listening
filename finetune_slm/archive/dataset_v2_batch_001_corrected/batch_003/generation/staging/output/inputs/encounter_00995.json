{
  "schema_version": "1.0",
  "encounter_id": "00995",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 3.46,
      "end_seconds": 13.34,
      "duration_seconds": 9.88,
      "text": "Hello. Um. I want to catch up on my vaccinations. I moved here for university and my records are missing."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.59,
      "end_seconds": 24.13,
      "duration_seconds": 6.54,
      "text": "That's common. Before we plan anything, how are you today? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.6,
      "end_seconds": 31.34,
      "duration_seconds": 3.74,
      "text": "A bit of a cold. Mild."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.36,
      "end_seconds": 37.8,
      "duration_seconds": 2.44,
      "text": "Tell me more."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.85,
      "end_seconds": 45.65,
      "duration_seconds": 3.8,
      "text": "A dry cough, since two days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.19,
      "end_seconds": 50.88,
      "duration_seconds": 1.69,
      "text": "Runny nose?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.87,
      "end_seconds": 57.01,
      "duration_seconds": 2.14,
      "text": "Yes, a bit."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.14,
      "end_seconds": 62.93,
      "duration_seconds": 1.79,
      "text": "Sore throat?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.63,
      "end_seconds": 69.79,
      "duration_seconds": 3.16,
      "text": "A little, in the mornings."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.3,
      "end_seconds": 74.64,
      "duration_seconds": 1.34,
      "text": "Fever?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.34,
      "end_seconds": 81.37,
      "duration_seconds": 2.03,
      "text": "No fever."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.86,
      "end_seconds": 88.6,
      "duration_seconds": 2.74,
      "text": "Any operations or procedures?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.25,
      "end_seconds": 96.01,
      "duration_seconds": 2.76,
      "text": "A hernia repair, in 2018."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.45,
      "end_seconds": 102.47,
      "duration_seconds": 3.02,
      "text": "Any illnesses in the family?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.97,
      "end_seconds": 109.04,
      "duration_seconds": 3.07,
      "text": "My father has diabetes."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.57,
      "end_seconds": 115.27,
      "duration_seconds": 2.7,
      "text": "And you're a student?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.17,
      "end_seconds": 120.68,
      "duration_seconds": 1.51,
      "text": "Yes. Engineering."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.97,
      "end_seconds": 149.21,
      "duration_seconds": 12.24,
      "text": "Let me take your numbers. Pulse 76, blood pressure 118 over 72, temperature 36.7, oxygen 99 percent, breathing 14, weight 70 kilos."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.05,
      "end_seconds": 158.07,
      "duration_seconds": 5.02,
      "text": "Is it okay to get vaccines with a cold? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.66,
      "end_seconds": 169.22,
      "duration_seconds": 7.56,
      "text": "A mild cold, no fever, is no reason to delay. Any problem with your breathing?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.83,
      "end_seconds": 177.68,
      "duration_seconds": 3.85,
      "text": "No, nothing, just the cough."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.53,
      "end_seconds": 191.2,
      "duration_seconds": 9.67,
      "text": "I think this looks like a mild cold, but I can't rule out early flu."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.05,
      "end_seconds": 196.76,
      "duration_seconds": 1.71,
      "text": "Flu? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.44,
      "end_seconds": 205.6,
      "duration_seconds": 5.16,
      "text": "Unlikely without fever. If a fever develops, we'll postpone. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.56,
      "end_seconds": 211.34,
      "duration_seconds": 1.78,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.08,
      "end_seconds": 223.51,
      "duration_seconds": 8.43,
      "text": "For the records, I'll request your old vaccination history from your home country's clinic. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.05,
      "end_seconds": 230.75,
      "duration_seconds": 3.7,
      "text": "My mother can send photos. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.3,
      "end_seconds": 240.04,
      "duration_seconds": 4.74,
      "text": "Even better. Send them to the surgery."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.88,
      "end_seconds": 245.96,
      "duration_seconds": 2.08,
      "text": "Today. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.78,
      "end_seconds": 256.32,
      "duration_seconds": 6.54,
      "text": "Once we have them, we'll work out what's missing and book it. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.06,
      "end_seconds": 261.73,
      "duration_seconds": 1.67,
      "text": "When? ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.44,
      "end_seconds": 267.78,
      "duration_seconds": 2.34,
      "text": "Next week. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.77,
      "end_seconds": 273.73,
      "duration_seconds": 1.96,
      "text": "Good. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.64,
      "end_seconds": 286.87,
      "duration_seconds": 9.23,
      "text": "If your arm becomes very red, hot, or swollen after any jab, come back and see me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.41,
      "end_seconds": 292.14,
      "duration_seconds": 1.73,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.98,
      "end_seconds": 300.17,
      "duration_seconds": 4.19,
      "text": "Rest, fluids, and wash your hands often."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.04,
      "end_seconds": 305.99,
      "duration_seconds": 1.95,
      "text": "Yes. ~"
    }
  ]
}
