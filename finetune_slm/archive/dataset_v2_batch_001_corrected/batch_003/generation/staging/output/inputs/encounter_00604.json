{
  "schema_version": "1.0",
  "encounter_id": "00604",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.65,
      "end_seconds": 13.46,
      "duration_seconds": 12.81,
      "text": "Hi there, I'm Dr. Hanley. Before anything, can you tell me your full name so I know I've got the right chart?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.22,
      "end_seconds": 16.58,
      "duration_seconds": 1.36,
      "text": "Luis Delgado."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.82,
      "end_seconds": 24.33,
      "duration_seconds": 5.51,
      "text": "Mr. Delgado, perfect, that matches. What brought you in tonight?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.84,
      "end_seconds": 33.28,
      "duration_seconds": 6.44,
      "text": "Probably nothing. My neck's been stiff, and my wife made me come."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.88,
      "end_seconds": 45.18,
      "duration_seconds": 9.3,
      "text": "Your wife made you come, and your neck is stiff. How long has the stiff neck been going on?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.69,
      "end_seconds": 50.22,
      "duration_seconds": 3.53,
      "text": "Since Sunday. So two days."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.86,
      "end_seconds": 57.81,
      "duration_seconds": 5.95,
      "text": "Two days. Is it worse when you move, or all the time?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 60.35,
      "end_seconds": 66.86,
      "duration_seconds": 6.51,
      "text": "When I look down, mostly. Like trying to tie my shoes."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.53,
      "end_seconds": 73.84,
      "duration_seconds": 5.31,
      "text": "Okay, worse looking down. Does bright light bother your eyes?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.77,
      "end_seconds": 80.42,
      "duration_seconds": 4.65,
      "text": "Not really. Well, the lamp at home, no."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.12,
      "end_seconds": 89.14,
      "duration_seconds": 7.02,
      "text": "So the light isn't bothering you. Have you been throwing up?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 90.02,
      "end_seconds": 91.16,
      "duration_seconds": 1.14,
      "text": "Nope."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.91,
      "end_seconds": 97.18,
      "duration_seconds": 4.27,
      "text": "Good. Have you taken anything for it?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.19,
      "end_seconds": 108.77,
      "duration_seconds": 10.58,
      "text": "Tylenol, 500 mg. Every six hours. And some ibuprofen, 200 mg, I took two doses since yesterday."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.79,
      "end_seconds": 120.07,
      "duration_seconds": 10.28,
      "text": "Tylenol 500 mg every six hours, and ibuprofen 200 mg, twice. Thanks, that helps me know what's in your system."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.83,
      "end_seconds": 125.07,
      "duration_seconds": 4.24,
      "text": "I'm fine, honestly. I should be at work."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.81,
      "end_seconds": 129.92,
      "duration_seconds": 3.11,
      "text": "What do you do for work?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.14,
      "end_seconds": 139.3,
      "duration_seconds": 7.16,
      "text": "I'm a roofer. Got a job on the east side I'm already behind on."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.27,
      "end_seconds": 166.94,
      "duration_seconds": 9.67,
      "text": "A roofer, so lots of ladders. Let me check your numbers now. Give me your arm, please."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.48,
      "end_seconds": 176.68,
      "duration_seconds": 7.2,
      "text": "Temperature is 39.4 °C. Heart rate is 112. And blood pressure is 118/72."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 179.21,
      "end_seconds": 186.85,
      "duration_seconds": 7.64,
      "text": "Is that bad? I felt warm in the truck, I figured it was the heater."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.03,
      "end_seconds": 200.84,
      "duration_seconds": 11.81,
      "text": "Your temperature is high, Mr. Delgado, 39.4. I want to be straight with you, that's a real fever, and I'm taking it seriously."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 203.19,
      "end_seconds": 205.83,
      "duration_seconds": 2.64,
      "text": "Huh. All right."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.91,
      "end_seconds": 214.08,
      "duration_seconds": 6.17,
      "text": "Any allergies to medicines or anything else I should know about?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 215.67,
      "end_seconds": 218.56,
      "duration_seconds": 2.89,
      "text": "No allergies. Never had one."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.69,
      "end_seconds": 231.51,
      "duration_seconds": 10.82,
      "text": "No allergies, thank you. Now I'm going to move your head a little. Let me know if it's sore."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 237.18,
      "end_seconds": 238.6,
      "duration_seconds": 1.42,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.37,
      "end_seconds": 257.15,
      "duration_seconds": 5.78,
      "text": "I'm bringing your chin toward your chest now. Does that hurt?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 258.26,
      "end_seconds": 263.31,
      "duration_seconds": 5.05,
      "text": "Yeah, that's tight. Pulling right down my neck."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.24,
      "end_seconds": 293.35,
      "duration_seconds": 15.11,
      "text": "Your neck is stiff when I bend your head forward. And I'm looking at your skin, your arms and chest, and it's clear. No rash anywhere."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 296.0,
      "end_seconds": 298.57,
      "duration_seconds": 2.57,
      "text": "Okay. That's good, right?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.92,
      "end_seconds": 313.64,
      "duration_seconds": 13.72,
      "text": "The skin is good news. Let me ask about the rest of you. Any trouble with your thinking, your speech, feeling confused, or weakness?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 316.61,
      "end_seconds": 321.78,
      "duration_seconds": 5.17,
      "text": "Nothing like that. I'm normal in my head."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.36,
      "end_seconds": 335.08,
      "duration_seconds": 11.72,
      "text": "Okay, that's reassuring. So, here is what happens next. I'm ordering blood cultures right now, the nurse will draw them."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 337.01,
      "end_seconds": 339.19,
      "duration_seconds": 2.18,
      "text": "Okay. Is that necessary?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 340.89,
      "end_seconds": 348.74,
      "duration_seconds": 7.85,
      "text": "Yes. Fever with a stiff neck is something we check carefully, not something we guess at."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 349.52,
      "end_seconds": 352.46,
      "duration_seconds": 2.94,
      "text": "Fine, whatever you need."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 353.46,
      "end_seconds": 369.49,
      "duration_seconds": 16.03,
      "text": "And I'd also like to do a lumbar puncture, which is a sample of the fluid around your spine, with a small needle in your lower back."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 371.43,
      "end_seconds": 372.98,
      "duration_seconds": 1.55,
      "text": "Sounds unpleasant."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 375.26,
      "end_seconds": 384.39,
      "duration_seconds": 9.13,
      "text": "It's uncomfortable for a few minutes, and we numb the area first. It gives us very useful information."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 386.4,
      "end_seconds": 388.71,
      "duration_seconds": 2.31,
      "text": "Okay. I trust you."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 391.24,
      "end_seconds": 402.02,
      "duration_seconds": 10.78,
      "text": "Thank you. To go through it again: you'll have blood drawn now, then the lumbar puncture, and you'll stay with us for monitoring."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 402.75,
      "end_seconds": 407.33,
      "duration_seconds": 4.58,
      "text": "Stay overnight? My wife's going to freak out."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 409.37,
      "end_seconds": 419.86,
      "duration_seconds": 10.49,
      "text": "I'll call her myself if you'd like. Meanwhile, I'll check in on you again in two hours."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 421.64,
      "end_seconds": 423.88,
      "duration_seconds": 2.24,
      "text": "Okay. Thanks, doc."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 426.16,
      "end_seconds": 433.99,
      "duration_seconds": 7.83,
      "text": "You did the right thing coming in. The nurse will be with you in a minute."
    }
  ]
}
