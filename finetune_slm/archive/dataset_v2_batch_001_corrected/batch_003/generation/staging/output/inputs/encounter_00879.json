{
  "schema_version": "1.0",
  "encounter_id": "00879",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 2.46,
      "end_seconds": 13.5,
      "duration_seconds": 11.04,
      "text": "I'm so thirsty all the time and I'm passing a huge amount of urine. I wondered if it might be diabetes."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.33,
      "end_seconds": 25.04,
      "duration_seconds": 7.71,
      "text": "That's a sensible thing to ask. How long has this been going on?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.84,
      "end_seconds": 36.14,
      "duration_seconds": 8.3,
      "text": "About one month. I get up three times a night just to drink water."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 39.6,
      "end_seconds": 48.65,
      "duration_seconds": 9.05,
      "text": "I'll take your blood pressure and weight while you talk to the doctor. ~"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.49,
      "end_seconds": 58.57,
      "duration_seconds": 6.08,
      "text": "Thank you. Do you have any family history of diabetes?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.13,
      "end_seconds": 66.98,
      "duration_seconds": 4.85,
      "text": "My father had it. He was on tablets."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.11,
      "end_seconds": 74.61,
      "duration_seconds": 4.5,
      "text": "Have you lost weight, or have blurred vision?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.04,
      "end_seconds": 81.72,
      "duration_seconds": 3.68,
      "text": "I haven't lost weight. My vision's fine."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.64,
      "end_seconds": 88.87,
      "duration_seconds": 4.23,
      "text": "What medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.71,
      "end_seconds": 105.53,
      "duration_seconds": 12.82,
      "text": "Ramipril, 10 mg, once a day. A cholesterol tablet, I think it's simvastatin. And a water tablet, which I can't name."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.45,
      "end_seconds": 114.39,
      "duration_seconds": 4.94,
      "text": "Do you remember the dose of the simvastatin?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.08,
      "end_seconds": 123.54,
      "duration_seconds": 5.46,
      "text": "Forty, I think. Or twenty. I'd have to check the box."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.07,
      "end_seconds": 133.02,
      "duration_seconds": 6.95,
      "text": "Don't worry, you can bring it next time. Any other conditions?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.97,
      "end_seconds": 139.77,
      "duration_seconds": 3.8,
      "text": "High blood pressure and high cholesterol."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 143.18,
      "end_seconds": 147.91,
      "duration_seconds": 4.73,
      "text": "Blood pressure 142 over 88, weight 94 kilograms."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.97,
      "end_seconds": 162.19,
      "duration_seconds": 10.22,
      "text": "Thank you. A bit up on the pressure. I'll check your blood sugar with a finger prick now."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.96,
      "end_seconds": 183.25,
      "duration_seconds": 2.29,
      "text": "Oh, of course."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.09,
      "end_seconds": 191.75,
      "duration_seconds": 4.66,
      "text": "The finger-prick sugar is 14.2, which is high."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.66,
      "end_seconds": 198.25,
      "duration_seconds": 2.59,
      "text": "Is that diabetes? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.6,
      "end_seconds": 207.73,
      "duration_seconds": 6.13,
      "text": "It strongly suggests it, but I need a proper blood test to confirm."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.71,
      "end_seconds": 213.46,
      "duration_seconds": 2.75,
      "text": "Will it need insulin? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.01,
      "end_seconds": 225.67,
      "duration_seconds": 8.66,
      "text": "Not necessarily. Many people start with tablets, diet and exercise. Let's get the tests first. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.83,
      "end_seconds": 230.96,
      "duration_seconds": 2.13,
      "text": "What tests? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.45,
      "end_seconds": 244.18,
      "duration_seconds": 9.73,
      "text": "I will arrange a blood test for HbA1c, kidney function and cholesterol, and a urine test."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.04,
      "end_seconds": 249.47,
      "duration_seconds": 1.43,
      "text": "When? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.51,
      "end_seconds": 264.43,
      "duration_seconds": 11.92,
      "text": "The nurse can take the blood today, and I'd like to see you again in a week with the results."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.45,
      "end_seconds": 269.71,
      "duration_seconds": 2.26,
      "text": "That's fine. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.23,
      "end_seconds": 282.26,
      "duration_seconds": 10.03,
      "text": "Until then, drink water rather than sugary drinks, and try to cut back on sweet foods."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.78,
      "end_seconds": 287.71,
      "duration_seconds": 1.93,
      "text": "I will. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.66,
      "end_seconds": 299.61,
      "duration_seconds": 8.95,
      "text": "If you start vomiting, feel very drowsy, or become short of breath, go to the emergency department."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.23,
      "end_seconds": 305.99,
      "duration_seconds": 2.76,
      "text": "Understood. Thanks, doctor. ~"
    }
  ]
}
