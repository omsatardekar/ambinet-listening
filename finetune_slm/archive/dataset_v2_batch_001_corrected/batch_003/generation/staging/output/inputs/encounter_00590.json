{
  "schema_version": "1.0",
  "encounter_id": "00590",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 0.31,
      "end_seconds": 10.19,
      "duration_seconds": 9.88,
      "text": "Come in, come in, and look at you, soaked through. Is it still pouring out there?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.97,
      "end_seconds": 21.84,
      "duration_seconds": 9.87,
      "text": "Oh, it's coming down in buckets. And the lot was full, so I had to park way down by the pharmacy."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.91,
      "end_seconds": 34.7,
      "duration_seconds": 10.79,
      "text": "Ugh, that's a trek when you're feeling poorly. Okay, let's get you sitting down. What brought you in today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.64,
      "end_seconds": 45.41,
      "duration_seconds": 7.77,
      "text": "I've got this awful burning when I pee, and I just feel terrible all over."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.22,
      "end_seconds": 50.09,
      "duration_seconds": 3.87,
      "text": "I'm sorry. When did it start?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.55,
      "end_seconds": 60.4,
      "duration_seconds": 7.85,
      "text": "Monday. No, wait, Wednesday. It was Wednesday, because I'd just come home from my book club."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.06,
      "end_seconds": 67.96,
      "duration_seconds": 5.9,
      "text": "Okay, Wednesday. Is there anything else going on besides the burning?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.75,
      "end_seconds": 76.33,
      "duration_seconds": 7.58,
      "text": "I'm peeing all the time, practically every half hour, and I can't get comfortable."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.94,
      "end_seconds": 82.38,
      "duration_seconds": 4.44,
      "text": "Any pain anywhere? Your belly, your back?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.59,
      "end_seconds": 93.73,
      "duration_seconds": 10.14,
      "text": "A pain in my side. The left... no, sorry, the right side, down low by my back."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.24,
      "end_seconds": 103.86,
      "duration_seconds": 7.62,
      "text": "The right side, got it. Have you felt feverish or had chills?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.81,
      "end_seconds": 113.46,
      "duration_seconds": 8.65,
      "text": "I've been shivery since last night. Shaking under two blankets, and it's not even cold."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.26,
      "end_seconds": 119.88,
      "duration_seconds": 3.62,
      "text": "That sounds miserable. Any vomiting?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.2,
      "end_seconds": 124.36,
      "duration_seconds": 3.16,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.49,
      "end_seconds": 130.08,
      "duration_seconds": 3.59,
      "text": "Any blood in your urine?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.85,
      "end_seconds": 136.74,
      "duration_seconds": 5.89,
      "text": "No, I checked. Twice, actually. Or maybe three times."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.74,
      "end_seconds": 139.27,
      "duration_seconds": 1.53,
      "text": "Any diarrhea?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.08,
      "end_seconds": 145.64,
      "duration_seconds": 5.56,
      "text": "No diarrhea. My stomach is fine, apart from feeling generally awful."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.69,
      "end_seconds": 152.35,
      "duration_seconds": 5.66,
      "text": "Got it. Are you taking any medicines at the moment?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.03,
      "end_seconds": 163.46,
      "duration_seconds": 8.43,
      "text": "Just two. The metoprolol, 50 mg twice a day, and a vitamin D."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.21,
      "end_seconds": 169.61,
      "duration_seconds": 5.4,
      "text": "And what dose is the vitamin D, do you know?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.09,
      "end_seconds": 180.24,
      "duration_seconds": 9.15,
      "text": "1000 units, once a day. It says so right on the bottle, I just forgot to bring it."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.91,
      "end_seconds": 190.41,
      "duration_seconds": 8.5,
      "text": "That's helpful, thank you. Let's get your numbers. Nurse, could you take her vitals, please?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 193.04,
      "end_seconds": 199.11,
      "duration_seconds": 6.07,
      "text": "Sure thing. Arm up on the armrest for me, Mrs. Hadley."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 200.82,
      "end_seconds": 207.0,
      "duration_seconds": 6.18,
      "text": "All done, Doctor. I've put everything on the screen for you."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.98,
      "end_seconds": 218.98,
      "duration_seconds": 10.0,
      "text": "Thanks. Blood pressure is 118 over 72, pulse 104, temperature 38.4 degrees Celsius, breathing 18 breaths per minute, oxygen 97 percent."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.37,
      "end_seconds": 227.46,
      "duration_seconds": 6.09,
      "text": "Is that bad? I'm so foggy today I can barely follow."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.1,
      "end_seconds": 240.13,
      "duration_seconds": 10.03,
      "text": "The temperature and pulse are up, so your body's busy fighting something. May I press on your back, Mrs. Hadley?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.06,
      "end_seconds": 247.01,
      "duration_seconds": 3.95,
      "text": "Go ahead. Ow! Right there, yes."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.83,
      "end_seconds": 269.18,
      "duration_seconds": 6.35,
      "text": "There's tenderness over your right flank, just below the ribs."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.14,
      "end_seconds": 276.62,
      "duration_seconds": 6.48,
      "text": "It really hurts when you press. What does that mean?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.55,
      "end_seconds": 290.39,
      "duration_seconds": 12.84,
      "text": "It tells me this is more than a bladder problem. Most likely it's a urine infection that's moved up toward your kidney."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.44,
      "end_seconds": 296.91,
      "duration_seconds": 4.47,
      "text": "Oh dear. So what do we do?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.8,
      "end_seconds": 306.79,
      "duration_seconds": 8.99,
      "text": "First, I'd like a urine sample sent to the lab for culture. Can you manage that now?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.48,
      "end_seconds": 315.09,
      "duration_seconds": 6.61,
      "text": "I think so. I've been going every half hour, after all. Ha."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 317.55,
      "end_seconds": 330.26,
      "duration_seconds": 12.71,
      "text": "Hi, I'm Priya from the front desk. Here's the sample cup and the labeled bag. The restroom is down the hall to the left."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.44,
      "end_seconds": 339.08,
      "duration_seconds": 6.64,
      "text": "Left... or was it right? Sorry, I keep mixing them up today."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 340.82,
      "end_seconds": 352.83,
      "duration_seconds": 12.01,
      "text": "Left, just past the water fountain. I'll run it to the lab myself as soon as you bring it back."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 354.96,
      "end_seconds": 359.04,
      "duration_seconds": 4.08,
      "text": "Thank you, dear. I'll be right back."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.24,
      "end_seconds": 370.08,
      "duration_seconds": 8.84,
      "text": "Take your time. Nurse, once she's done, could you settle her in the treatment room with a blanket?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 372.08,
      "end_seconds": 381.75,
      "duration_seconds": 9.67,
      "text": "Of course. I'll bring a warm blanket and a glass of water for you, Mrs. Hadley."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 383.82,
      "end_seconds": 390.3,
      "duration_seconds": 6.48,
      "text": "Sip water steadily while you wait, as much as you comfortably can."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 391.59,
      "end_seconds": 398.54,
      "duration_seconds": 6.95,
      "text": "Will do. Thank you all, I feel better already just being looked after."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 400.7,
      "end_seconds": 404.9,
      "duration_seconds": 4.2,
      "text": "That's what we're here for. Rest up now."
    }
  ]
}
