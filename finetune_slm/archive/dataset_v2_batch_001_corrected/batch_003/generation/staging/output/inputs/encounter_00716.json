{
  "schema_version": "1.0",
  "encounter_id": "00716",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.33,
      "end_seconds": 13.39,
      "duration_seconds": 12.06,
      "text": "Hi. Um, I think I might have malaria. I got back from Ghana ten days ago, and I've been getting these fevers."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.92,
      "end_seconds": 21.41,
      "duration_seconds": 5.49,
      "text": "Thank you for coming promptly. Tell me about the fevers."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.75,
      "end_seconds": 39.62,
      "duration_seconds": 14.87,
      "text": "They come in waves. I'll be fine, then I get cold and shivering, and then burning hot, and drenched in sweat. It's every second day, I think."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.23,
      "end_seconds": 46.51,
      "duration_seconds": 4.28,
      "text": "How long does each episode last?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.59,
      "end_seconds": 54.08,
      "duration_seconds": 4.49,
      "text": "Five or six hours. Then I'm wiped out."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.53,
      "end_seconds": 62.17,
      "duration_seconds": 4.64,
      "text": "Did you take malaria tablets on the trip? ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.55,
      "end_seconds": 73.97,
      "duration_seconds": 9.42,
      "text": "I took them for the first week, and then I stopped. I felt sick on them. ~"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.72,
      "end_seconds": 81.2,
      "duration_seconds": 4.48,
      "text": "That's useful to know. Any diarrhoea or vomiting?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.33,
      "end_seconds": 92.11,
      "duration_seconds": 8.78,
      "text": "No. No diarrhoea. I was a bit nauseous during the fevers, but I haven't been sick."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.83,
      "end_seconds": 99.9,
      "duration_seconds": 5.07,
      "text": "Any rash, or yellowing of your skin or eyes?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.27,
      "end_seconds": 104.64,
      "duration_seconds": 2.37,
      "text": "No rash. No yellow."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.47,
      "end_seconds": 110.53,
      "duration_seconds": 3.06,
      "text": "Any breathing problems, or cough?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.65,
      "end_seconds": 117.09,
      "duration_seconds": 4.44,
      "text": "No, nothing like that. My chest is fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.12,
      "end_seconds": 122.62,
      "duration_seconds": 2.5,
      "text": "Any medical conditions?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.16,
      "end_seconds": 131.21,
      "duration_seconds": 5.05,
      "text": "Asthma, mild, I use a blue inhaler occasionally."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.06,
      "end_seconds": 137.23,
      "duration_seconds": 4.17,
      "text": "Let me examine you. Lie back. ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.87,
      "end_seconds": 161.09,
      "duration_seconds": 1.22,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.34,
      "end_seconds": 173.27,
      "duration_seconds": 8.93,
      "text": "Your tummy is soft, and I can feel your spleen edge, it's a little bit enlarged."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.43,
      "end_seconds": 179.49,
      "duration_seconds": 3.06,
      "text": "Is that bad? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.96,
      "end_seconds": 202.26,
      "duration_seconds": 19.3,
      "text": "It's what happens with malaria, so I'm taking it seriously. From what you describe, fevers every second day after a trip to West Africa, I'd say malaria is the likely cause until proven otherwise."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.9,
      "end_seconds": 208.52,
      "duration_seconds": 3.62,
      "text": "Oh God. Is it dangerous? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.36,
      "end_seconds": 223.14,
      "duration_seconds": 11.78,
      "text": "It can be, if it's left, and the most serious type can get bad quickly. But it's very treatable when caught early. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.79,
      "end_seconds": 228.68,
      "duration_seconds": 2.89,
      "text": "What happens now? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.46,
      "end_seconds": 241.05,
      "duration_seconds": 10.59,
      "text": "I'm sending you straight to the hospital this afternoon, and I want a malaria blood film done today. I'll ring ahead."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.17,
      "end_seconds": 246.34,
      "duration_seconds": 2.17,
      "text": "Today? Right. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.14,
      "end_seconds": 257.87,
      "duration_seconds": 8.73,
      "text": "Yes, today. They'll test your blood and probably start treatment straight away if it's positive. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.66,
      "end_seconds": 263.85,
      "duration_seconds": 3.19,
      "text": "Can I drive myself? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.0,
      "end_seconds": 273.84,
      "duration_seconds": 7.84,
      "text": "I'd rather you didn't. Is there someone who can take you? ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.45,
      "end_seconds": 278.65,
      "duration_seconds": 2.2,
      "text": "My flatmate. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.45,
      "end_seconds": 291.22,
      "duration_seconds": 10.77,
      "text": "Please call them now. If you become confused, very drowsy, vomit repeatedly, or get a severe headache on the way, call 999."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.93,
      "end_seconds": 297.56,
      "duration_seconds": 3.63,
      "text": "Okay. Okay, thank you, doctor. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.19,
      "end_seconds": 306.01,
      "duration_seconds": 5.82,
      "text": "You did the right thing. Go straight there. ~"
    }
  ]
}
