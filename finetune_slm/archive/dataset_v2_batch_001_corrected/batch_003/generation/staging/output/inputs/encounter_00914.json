{
  "schema_version": "1.0",
  "encounter_id": "00914",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 0.68,
      "end_seconds": 11.01,
      "duration_seconds": 10.33,
      "text": "Good morning, Mr Jarrah. The booking says sleep study results. Before I give you them, how have you been feeling? ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.56,
      "end_seconds": 26.01,
      "duration_seconds": 13.45,
      "text": "Tired, doctor. I'm always tired, I fall asleep in front of the telly by seven, and my wife says I snore like a chainsaw. Is it bad news?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.81,
      "end_seconds": 35.59,
      "duration_seconds": 7.78,
      "text": "Let's go step by step. How long has the snoring been going on?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.0,
      "end_seconds": 43.34,
      "duration_seconds": 6.34,
      "text": "Years, I think. Maybe ten years? Mick says it's been worse lately."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.36,
      "end_seconds": 49.09,
      "duration_seconds": 4.73,
      "text": "And the daytime sleepiness? When did it start?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.01,
      "end_seconds": 58.2,
      "duration_seconds": 8.19,
      "text": "I'm not sure. A year? Two? I can't really put a date on it."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.88,
      "end_seconds": 63.65,
      "duration_seconds": 3.77,
      "text": "Do you wake up at night gasping?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.34,
      "end_seconds": 73.82,
      "duration_seconds": 7.48,
      "text": "Yes, a few times a week. I sit bolt upright, my heart pounding."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.68,
      "end_seconds": 78.14,
      "duration_seconds": 2.46,
      "text": "Headaches in the morning?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.18,
      "end_seconds": 83.94,
      "duration_seconds": 3.76,
      "text": "Most mornings. Gone by ten."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.82,
      "end_seconds": 88.01,
      "duration_seconds": 3.19,
      "text": "Any chest pain at night?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.38,
      "end_seconds": 91.24,
      "duration_seconds": 1.86,
      "text": "No chest pain."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.99,
      "end_seconds": 96.12,
      "duration_seconds": 4.13,
      "text": "Have you ever fallen asleep while driving?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.52,
      "end_seconds": 102.54,
      "duration_seconds": 5.02,
      "text": "No, never. Thank God. I'd stop the cab."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.19,
      "end_seconds": 107.84,
      "duration_seconds": 3.65,
      "text": "Any swelling in the ankles?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.61,
      "end_seconds": 112.45,
      "duration_seconds": 1.84,
      "text": "No swelling."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.18,
      "end_seconds": 115.81,
      "duration_seconds": 1.63,
      "text": "Your medicines?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.01,
      "end_seconds": 128.26,
      "duration_seconds": 11.25,
      "text": "Amlodipine, 5 mg, once a day. Metformin, 500 mg, twice a day. And omeprazole, 20 mg, once a day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.37,
      "end_seconds": 131.76,
      "duration_seconds": 1.39,
      "text": "Allergies?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.77,
      "end_seconds": 134.89,
      "duration_seconds": 2.12,
      "text": "Penicillin. A rash."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.01,
      "end_seconds": 137.56,
      "duration_seconds": 1.55,
      "text": "Medical history?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.82,
      "end_seconds": 143.3,
      "duration_seconds": 4.48,
      "text": "Type 2 diabetes, and high blood pressure."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.37,
      "end_seconds": 147.05,
      "duration_seconds": 1.68,
      "text": "Any operations?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.86,
      "end_seconds": 154.74,
      "duration_seconds": 4.88,
      "text": "They straightened my nose, a deviated septum, in 2010."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.43,
      "end_seconds": 160.44,
      "duration_seconds": 4.01,
      "text": "Anyone in the family with sleep trouble?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.81,
      "end_seconds": 165.55,
      "duration_seconds": 3.74,
      "text": "My father had sleep apnoea."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.95,
      "end_seconds": 170.42,
      "duration_seconds": 2.47,
      "text": "What do you do?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.85,
      "end_seconds": 175.12,
      "duration_seconds": 2.27,
      "text": "Taxi driver, thirty years."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.91,
      "end_seconds": 178.33,
      "duration_seconds": 1.42,
      "text": "Alcohol?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.08,
      "end_seconds": 182.58,
      "duration_seconds": 2.5,
      "text": "Two beers every night."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.75,
      "end_seconds": 211.55,
      "duration_seconds": 11.8,
      "text": "Let me check you. Blood pressure 148 over 92, pulse 80, temperature 36.6, oxygen 95 percent, breathing 16, and weight 118 kilos."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.06,
      "end_seconds": 215.72,
      "duration_seconds": 2.66,
      "text": "Is that high? ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.0,
      "end_seconds": 230.82,
      "duration_seconds": 4.82,
      "text": "A little. Open your mouth wide for me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.69,
      "end_seconds": 234.4,
      "duration_seconds": 1.71,
      "text": "Ahh. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.73,
      "end_seconds": 244.95,
      "duration_seconds": 8.22,
      "text": "Your neck is thick, and the space at the back of the throat is narrow and crowded."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.32,
      "end_seconds": 251.12,
      "duration_seconds": 3.8,
      "text": "Is that why I snore? ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.93,
      "end_seconds": 260.93,
      "duration_seconds": 7.0,
      "text": "It's part of it. And there's no swelling in your legs."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.49,
      "end_seconds": 265.1,
      "duration_seconds": 1.61,
      "text": "Good. ~"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.02,
      "end_seconds": 269.04,
      "duration_seconds": 3.02,
      "text": "Any heartburn at night?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.61,
      "end_seconds": 274.0,
      "duration_seconds": 3.39,
      "text": "No, nothing, the tablet works."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.84,
      "end_seconds": 286.05,
      "duration_seconds": 10.21,
      "text": "Now the study. You had the overnight sleep study last month, and it showed that you stopped breathing 28 times an hour."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.45,
      "end_seconds": 291.77,
      "duration_seconds": 3.32,
      "text": "Twenty-eight? Is that a lot? ~"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.7,
      "end_seconds": 305.79,
      "duration_seconds": 12.09,
      "text": "It's in the moderate range. It looks like moderate obstructive sleep apnoea, but I can't rule out an underactive thyroid adding to the tiredness."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.85,
      "end_seconds": 310.46,
      "duration_seconds": 3.61,
      "text": "Will I lose my licence? ~"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.49,
      "end_seconds": 326.82,
      "duration_seconds": 15.33,
      "text": "Not if we treat it. I'd like to arrange a trial of a CPAP machine, a mask that keeps your airway open, and I'd like to do a thyroid blood test."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.46,
      "end_seconds": 332.83,
      "duration_seconds": 3.37,
      "text": "A mask? Every night? ~"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.04,
      "end_seconds": 344.67,
      "duration_seconds": 9.63,
      "text": "It sounds worse than it is. Most people feel the difference within a week. Cut the beers, too."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.63,
      "end_seconds": 348.33,
      "duration_seconds": 2.7,
      "text": "Both are fair. ~"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.62,
      "end_seconds": 356.24,
      "duration_seconds": 5.62,
      "text": "I'd like to see you again in six weeks."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.76,
      "end_seconds": 362.01,
      "duration_seconds": 3.25,
      "text": "Six weeks. Thank you, doctor. ~"
    }
  ]
}
