{
  "schema_version": "1.0",
  "encounter_id": "00813",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.16,
      "end_seconds": 7.53,
      "duration_seconds": 6.37,
      "text": "G'day. It's my feet. They burn. Mostly at night. Drives me mad."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.11,
      "end_seconds": 13.57,
      "duration_seconds": 4.46,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.0,
      "end_seconds": 25.56,
      "duration_seconds": 8.56,
      "text": "Eight months, nearly. It started in my toes, and now it's the whole of both feet."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.05,
      "end_seconds": 30.42,
      "duration_seconds": 2.37,
      "text": "Can you describe it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.2,
      "end_seconds": 41.09,
      "duration_seconds": 7.89,
      "text": "Like they've been dipped in hot water, or a pins and needles. Sheets feel too heavy."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.67,
      "end_seconds": 49.23,
      "duration_seconds": 5.56,
      "text": "Does it affect your hands, or other parts? ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.41,
      "end_seconds": 55.38,
      "duration_seconds": 3.97,
      "text": "No, only the feet, so far. ~"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.73,
      "end_seconds": 63.45,
      "duration_seconds": 4.72,
      "text": "Any weakness, or tripping over things? ~"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.02,
      "end_seconds": 69.91,
      "duration_seconds": 3.89,
      "text": "No, I can walk fine. ~"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.52,
      "end_seconds": 76.57,
      "duration_seconds": 4.05,
      "text": "What are you taking at the moment?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.38,
      "end_seconds": 85.1,
      "duration_seconds": 5.72,
      "text": "Metformin, 1000 mg twice a day, for my diabetes."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.41,
      "end_seconds": 92.03,
      "duration_seconds": 3.62,
      "text": "Is the diabetes well controlled? ~"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.81,
      "end_seconds": 100.37,
      "duration_seconds": 6.56,
      "text": "It was a bit high at my last check, 60-something. ~"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.44,
      "end_seconds": 105.35,
      "duration_seconds": 2.91,
      "text": "Any allergies to medicines?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.21,
      "end_seconds": 116.89,
      "duration_seconds": 8.68,
      "text": "Gabapentin. I had a swollen face, a few years back. The GP said never again."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.73,
      "end_seconds": 126.66,
      "duration_seconds": 7.93,
      "text": "That's important, thank you. Let me check your feet. Take your socks off. ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.79,
      "end_seconds": 147.74,
      "duration_seconds": 0.95,
      "text": "Right."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.79,
      "end_seconds": 168.3,
      "duration_seconds": 18.51,
      "text": "Your skin is dry, and you've lost some feeling to light touch on the soles of both feet, and the vibration sense is reduced at the toes, but the pulses are good."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.15,
      "end_seconds": 174.29,
      "duration_seconds": 3.14,
      "text": "Is that the diabetes? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.47,
      "end_seconds": 182.98,
      "duration_seconds": 6.51,
      "text": "This looks like diabetic nerve damage, peripheral neuropathy, I'd say."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.52,
      "end_seconds": 187.27,
      "duration_seconds": 2.75,
      "text": "Is it permanent? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.6,
      "end_seconds": 202.89,
      "duration_seconds": 12.29,
      "text": "The damage can't always be reversed, but better sugar control stops it getting worse, and the burning can be treated. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.28,
      "end_seconds": 208.72,
      "duration_seconds": 3.44,
      "text": "What do we do? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.93,
      "end_seconds": 225.84,
      "duration_seconds": 14.91,
      "text": "I'd like to arrange a blood test for your sugar control, the HbA1c, and your vitamin B12, as metformin can lower it, and other causes need ruling out."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.14,
      "end_seconds": 231.01,
      "duration_seconds": 1.87,
      "text": "Fine. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.52,
      "end_seconds": 245.67,
      "duration_seconds": 12.15,
      "text": "Since you can't take gabapentin, I'd like to think about a different pain treatment once we have the results. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.52,
      "end_seconds": 250.48,
      "duration_seconds": 1.96,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.71,
      "end_seconds": 263.31,
      "duration_seconds": 9.6,
      "text": "Meanwhile, check your feet every day for blisters or cuts, wear well-fitting shoes, and never walk barefoot."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.23,
      "end_seconds": 270.08,
      "duration_seconds": 3.85,
      "text": "I walk barefoot all the time. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.72,
      "end_seconds": 281.66,
      "duration_seconds": 8.94,
      "text": "Not any more, I'm afraid. Your feet can't warn you if you tread on something. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.34,
      "end_seconds": 286.1,
      "duration_seconds": 1.76,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.55,
      "end_seconds": 299.9,
      "duration_seconds": 12.35,
      "text": "If you notice a sore that doesn't heal, a blister, or any redness or swelling, come in the same day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.32,
      "end_seconds": 305.99,
      "duration_seconds": 2.67,
      "text": "I will. Thanks. ~"
    }
  ]
}
