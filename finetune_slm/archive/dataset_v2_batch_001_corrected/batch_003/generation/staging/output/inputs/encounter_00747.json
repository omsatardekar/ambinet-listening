{
  "schema_version": "1.0",
  "encounter_id": "00747",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 1.11,
      "end_seconds": 8.25,
      "duration_seconds": 7.14,
      "text": "Morning. Awful weather, isn't it? Did the bus get you here all right? ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.04,
      "end_seconds": 11.84,
      "duration_seconds": 2.8,
      "text": "Fine. Late, though. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 12.66,
      "end_seconds": 18.02,
      "duration_seconds": 5.36,
      "text": "Well, you're here. What can I do for you? ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.39,
      "end_seconds": 22.78,
      "duration_seconds": 3.39,
      "text": "Constipation. Getting worse. Six months now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.82,
      "end_seconds": 26.55,
      "duration_seconds": 2.73,
      "text": "What's normal for you, normally?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.01,
      "end_seconds": 33.68,
      "duration_seconds": 4.67,
      "text": "Every day. Now it's every four, five days."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.51,
      "end_seconds": 37.28,
      "duration_seconds": 2.77,
      "text": "Are the stools hard?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.27,
      "end_seconds": 43.17,
      "duration_seconds": 2.9,
      "text": "Rock hard. I strain."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.03,
      "end_seconds": 48.4,
      "duration_seconds": 3.37,
      "text": "Anything else with it, bloating, pain?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.21,
      "end_seconds": 56.26,
      "duration_seconds": 5.05,
      "text": "Bloated, yes. And cramps, low down on the left."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.23,
      "end_seconds": 62.72,
      "duration_seconds": 3.49,
      "text": "Any blood when you go?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.03,
      "end_seconds": 65.83,
      "duration_seconds": 1.8,
      "text": "No blood."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.63,
      "end_seconds": 69.16,
      "duration_seconds": 1.53,
      "text": "Black stools?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.97,
      "end_seconds": 71.17,
      "duration_seconds": 1.2,
      "text": "No."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.99,
      "end_seconds": 75.38,
      "duration_seconds": 3.39,
      "text": "Any weight loss that you've noticed?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.85,
      "end_seconds": 78.29,
      "duration_seconds": 1.44,
      "text": "None."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.89,
      "end_seconds": 81.2,
      "duration_seconds": 1.31,
      "text": "Vomiting?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.16,
      "end_seconds": 84.8,
      "duration_seconds": 1.64,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.79,
      "end_seconds": 88.37,
      "duration_seconds": 2.58,
      "text": "What are you taking?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.44,
      "end_seconds": 98.7,
      "duration_seconds": 8.26,
      "text": "Codeine, 30 mg, twice a day, for my back. And lactulose, 15 ml, twice a day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.7,
      "end_seconds": 106.5,
      "duration_seconds": 5.8,
      "text": "Right. The codeine is often a culprit. Any allergies to medicines?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.74,
      "end_seconds": 111.49,
      "duration_seconds": 2.75,
      "text": "Aspirin. Makes me wheeze."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.47,
      "end_seconds": 116.71,
      "duration_seconds": 3.24,
      "text": "What's in your history?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.06,
      "end_seconds": 122.51,
      "duration_seconds": 3.45,
      "text": "Haemorrhoids. A slipped disc. And anxiety."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.98,
      "end_seconds": 124.91,
      "duration_seconds": 0.93,
      "text": "Operations?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.69,
      "end_seconds": 128.62,
      "duration_seconds": 1.93,
      "text": "Appendix, 1998."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.19,
      "end_seconds": 134.21,
      "duration_seconds": 3.02,
      "text": "Bowel problems in the family?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.83,
      "end_seconds": 141.01,
      "duration_seconds": 5.18,
      "text": "My father had bowel cancer. In his seventies."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.47,
      "end_seconds": 145.18,
      "duration_seconds": 2.71,
      "text": "And how's your diet?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.92,
      "end_seconds": 150.12,
      "duration_seconds": 3.2,
      "text": "White bread, mostly. Not much fruit."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.8,
      "end_seconds": 152.94,
      "duration_seconds": 1.14,
      "text": "Exercise?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.04,
      "end_seconds": 158.78,
      "duration_seconds": 4.74,
      "text": "I sit at a desk all day. No exercise."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.57,
      "end_seconds": 185.23,
      "duration_seconds": 10.66,
      "text": "Let me check you over. Pulse 74, blood pressure 128 over 80, temperature 36.6, oxygen 98 percent, breathing 16, and weight 82 kilos."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.86,
      "end_seconds": 189.71,
      "duration_seconds": 1.85,
      "text": "Fine? ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.23,
      "end_seconds": 205.72,
      "duration_seconds": 4.49,
      "text": "All fine. Lie back, I'll feel your tummy."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.82,
      "end_seconds": 210.08,
      "duration_seconds": 2.26,
      "text": "Cold hands. ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.69,
      "end_seconds": 220.07,
      "duration_seconds": 8.38,
      "text": "Sorry. It's soft, but tender in the lower left. And the bowel sounds are normal."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.02,
      "end_seconds": 225.5,
      "duration_seconds": 3.48,
      "text": "That's where it hurts. ~"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.99,
      "end_seconds": 231.11,
      "duration_seconds": 3.12,
      "text": "I can't feel any lumps."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.89,
      "end_seconds": 234.37,
      "duration_seconds": 1.48,
      "text": "Good. ~"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.02,
      "end_seconds": 241.84,
      "duration_seconds": 4.82,
      "text": "Any trouble with your water, passing urine?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.68,
      "end_seconds": 244.4,
      "duration_seconds": 1.72,
      "text": "No, nothing."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.99,
      "end_seconds": 251.4,
      "duration_seconds": 5.41,
      "text": "Anything like a cough or breathlessness, with your aspirin wheeze?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.51,
      "end_seconds": 258.42,
      "duration_seconds": 5.91,
      "text": "No, I'm fine with that. Haven't had it for years."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.45,
      "end_seconds": 267.42,
      "duration_seconds": 7.97,
      "text": "I think the codeine is the main cause of this constipation, along with the low fibre."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.81,
      "end_seconds": 273.18,
      "duration_seconds": 3.37,
      "text": "Can I stop it? ~"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.97,
      "end_seconds": 289.49,
      "duration_seconds": 13.52,
      "text": "Not suddenly. We'll talk about the back pain. I'd like to arrange blood tests for thyroid and calcium, and a stool test for blood, because of your father."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.77,
      "end_seconds": 292.08,
      "duration_seconds": 1.31,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.97,
      "end_seconds": 299.73,
      "duration_seconds": 5.76,
      "text": "And eat more fibre, oats, fruit, and drink water."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.1,
      "end_seconds": 304.35,
      "duration_seconds": 2.25,
      "text": "I'll try. ~"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.8,
      "end_seconds": 311.58,
      "duration_seconds": 4.78,
      "text": "I'd like to see you again in four weeks."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.25,
      "end_seconds": 315.65,
      "duration_seconds": 2.4,
      "text": "Four weeks. Right. ~"
    }
  ]
}
