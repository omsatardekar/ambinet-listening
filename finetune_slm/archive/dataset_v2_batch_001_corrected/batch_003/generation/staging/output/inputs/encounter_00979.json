{
  "schema_version": "1.0",
  "encounter_id": "00979",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.79,
      "end_seconds": 14.84,
      "duration_seconds": 14.05,
      "text": "G'day, doctor. It's my right elbow. Hurts on the outside. I've been painting the house, and I think I've done it. Um, what was I saying."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.67,
      "end_seconds": 23.32,
      "duration_seconds": 6.65,
      "text": "The outside of the right elbow. When did it start?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.39,
      "end_seconds": 35.06,
      "duration_seconds": 9.67,
      "text": "Last month? No, the month before. I painted the fence, then the shed. Not sure. ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.22,
      "end_seconds": 43.39,
      "duration_seconds": 7.17,
      "text": "Is it there all the time, or only with certain things? ~"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.34,
      "end_seconds": 53.84,
      "duration_seconds": 7.5,
      "text": "When I grip the brush. Or lift the kettle. Or shake hands, which is embarrassing."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.96,
      "end_seconds": 61.27,
      "duration_seconds": 6.31,
      "text": "Have you noticed any numbness or tingling in the fingers?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.32,
      "end_seconds": 65.19,
      "duration_seconds": 2.87,
      "text": "No numbness. No tingling."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.86,
      "end_seconds": 69.83,
      "duration_seconds": 1.97,
      "text": "Any neck pain?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.44,
      "end_seconds": 73.96,
      "duration_seconds": 2.52,
      "text": "No, the neck's fine."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.06,
      "end_seconds": 79.4,
      "duration_seconds": 3.34,
      "text": "What do you do for work?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.18,
      "end_seconds": 85.79,
      "duration_seconds": 3.61,
      "text": "I'm a painter. Which is the irony."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.79,
      "end_seconds": 90.49,
      "duration_seconds": 3.7,
      "text": "Any conditions I should know about?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.75,
      "end_seconds": 94.48,
      "duration_seconds": 2.73,
      "text": "Psoriasis. On my knees."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.78,
      "end_seconds": 111.89,
      "duration_seconds": 6.11,
      "text": "Let me feel the elbow. Tell me when you feel it."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.97,
      "end_seconds": 116.31,
      "duration_seconds": 2.34,
      "text": "There. Ow. ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.38,
      "end_seconds": 125.63,
      "duration_seconds": 7.25,
      "text": "There's tenderness right over the bony bump on the outside of the elbow."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.67,
      "end_seconds": 130.29,
      "duration_seconds": 2.62,
      "text": "That's the spot. ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.07,
      "end_seconds": 149.12,
      "duration_seconds": 8.05,
      "text": "Now hold your wrist up straight, and I'll push down on the back of your hand."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.93,
      "end_seconds": 152.78,
      "duration_seconds": 1.85,
      "text": "Like this? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.81,
      "end_seconds": 162.08,
      "duration_seconds": 7.27,
      "text": "Ah, yes. That reproduces the pain on the outside of the elbow when you resist."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.74,
      "end_seconds": 167.47,
      "duration_seconds": 2.73,
      "text": "That's the one. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.57,
      "end_seconds": 185.31,
      "duration_seconds": 16.74,
      "text": "Let me explain what's going on, without putting a name on it today. A tendon on the outside of the elbow takes the strain of gripping, and when it's overused, it gets sore and irritated. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.8,
      "end_seconds": 190.47,
      "duration_seconds": 3.67,
      "text": "So I've overdone it. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.78,
      "end_seconds": 197.46,
      "duration_seconds": 5.68,
      "text": "That's the picture. The tendon needs rest to recover. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.37,
      "end_seconds": 202.3,
      "duration_seconds": 3.93,
      "text": "I've got a job to finish. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.13,
      "end_seconds": 212.38,
      "duration_seconds": 8.25,
      "text": "I understand. Try to use the other hand for painting where you can, and take regular breaks."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.51,
      "end_seconds": 216.85,
      "duration_seconds": 2.34,
      "text": "I'm right-handed. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.48,
      "end_seconds": 226.98,
      "duration_seconds": 8.5,
      "text": "Switch for the heavy parts, or use a roller on an extension pole. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.29,
      "end_seconds": 231.46,
      "duration_seconds": 3.17,
      "text": "That's a good idea. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.07,
      "end_seconds": 243.05,
      "duration_seconds": 9.98,
      "text": "A tennis elbow strap, a band just below the elbow, can take the strain. You can buy one at the pharmacy."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.41,
      "end_seconds": 248.25,
      "duration_seconds": 2.84,
      "text": "Does it work? ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.92,
      "end_seconds": 255.06,
      "duration_seconds": 5.14,
      "text": "It helps many people. Wear it when you're gripping. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.25,
      "end_seconds": 258.0,
      "duration_seconds": 1.75,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.71,
      "end_seconds": 267.32,
      "duration_seconds": 8.61,
      "text": "Avoid lifting with your palm facing down. Lift with your palm facing up, it's gentler."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.87,
      "end_seconds": 274.34,
      "duration_seconds": 4.47,
      "text": "That's the opposite of what I do. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.44,
      "end_seconds": 278.71,
      "duration_seconds": 2.27,
      "text": "Try it. ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.67,
      "end_seconds": 283.81,
      "duration_seconds": 2.14,
      "text": "I will. ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.4,
      "end_seconds": 293.75,
      "duration_seconds": 8.35,
      "text": "If it's not better in six weeks, come back and we'll look at other options."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.39,
      "end_seconds": 300.29,
      "duration_seconds": 4.9,
      "text": "Six weeks. I'll write it on the fence. ~"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.79,
      "end_seconds": 305.97,
      "duration_seconds": 3.18,
      "text": "Ha. Take care. ~"
    }
  ]
}
