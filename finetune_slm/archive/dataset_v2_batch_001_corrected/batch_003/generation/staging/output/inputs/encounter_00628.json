{
  "schema_version": "1.0",
  "encounter_id": "00628",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 1.11,
      "end_seconds": 14.38,
      "duration_seconds": 13.27,
      "text": "Doctor, this is Ananya, seventeen, brought in by ambulance. Her mother is parking and will be here shortly. She took paracetamol at lunchtime. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.57,
      "end_seconds": 24.88,
      "duration_seconds": 8.31,
      "text": "Thanks, Priya. Hello Ananya, I'm Dr Rao. Can you tell me what happened? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.62,
      "end_seconds": 34.65,
      "duration_seconds": 8.03,
      "text": "I, um. I took some tablets. Paracetamol. Too many. I don't know exactly how many."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.75,
      "end_seconds": 43.66,
      "duration_seconds": 6.91,
      "text": "Thank you for telling me. Roughly how many, and when? ~"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.38,
      "end_seconds": 55.43,
      "duration_seconds": 9.05,
      "text": "Maybe ten, or twelve? The 500 mg ones. At about one o'clock. I was in the school toilets. ~"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.56,
      "end_seconds": 63.39,
      "duration_seconds": 6.83,
      "text": "That's about three hours ago. Did you take anything else along with them? ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.14,
      "end_seconds": 67.62,
      "duration_seconds": 2.48,
      "text": "No. Just those. ~"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.71,
      "end_seconds": 74.49,
      "duration_seconds": 4.78,
      "text": "Okay. How are you feeling right now?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.13,
      "end_seconds": 82.42,
      "duration_seconds": 6.29,
      "text": "A bit sick. And my stomach hurts, on the top, here."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 85.24,
      "end_seconds": 90.27,
      "duration_seconds": 5.03,
      "text": "She was sick once in the ambulance, doctor."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.85,
      "end_seconds": 101.89,
      "duration_seconds": 10.04,
      "text": "Have you been sick any more than that, or seen any blood when you were sick?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.37,
      "end_seconds": 107.47,
      "duration_seconds": 4.1,
      "text": "No, only the once. No blood."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.54,
      "end_seconds": 114.82,
      "duration_seconds": 5.28,
      "text": "Do you feel drowsy or confused at all?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.61,
      "end_seconds": 121.14,
      "duration_seconds": 4.53,
      "text": "No. I'm awake. I'm just really scared."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.28,
      "end_seconds": 132.17,
      "duration_seconds": 9.89,
      "text": "That's completely understandable, and you've done the right thing being honest. Do you have any allergies to medicines?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.7,
      "end_seconds": 136.55,
      "duration_seconds": 1.85,
      "text": "No. None."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.63,
      "end_seconds": 142.9,
      "duration_seconds": 5.27,
      "text": "What medicines or health problems do you normally have?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.73,
      "end_seconds": 156.45,
      "duration_seconds": 10.72,
      "text": "I take sertraline, 50 mg, once a day. And I have a blue inhaler, salbutamol, when I wheeze."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 157.16,
      "end_seconds": 164.62,
      "duration_seconds": 7.46,
      "text": "It says on her record that she has anxiety and asthma, doctor."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.65,
      "end_seconds": 174.45,
      "duration_seconds": 7.8,
      "text": "Thanks. And is something going on at school or at home that's got you this stressed?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.36,
      "end_seconds": 184.17,
      "duration_seconds": 7.81,
      "text": "It's my mocks. I'm in Year 12 and I just couldn't, I couldn't cope."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.16,
      "end_seconds": 194.77,
      "duration_seconds": 7.61,
      "text": "Thank you for telling me. Priya, can we get her observations? ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 197.04,
      "end_seconds": 199.47,
      "duration_seconds": 2.43,
      "text": "Of course, doctor. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 220.97,
      "end_seconds": 231.59,
      "duration_seconds": 10.62,
      "text": "Heart rate 96, blood pressure 112 over 70, temperature 36.9, oxygen 99 percent, breathing 18 a minute."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.26,
      "end_seconds": 242.61,
      "duration_seconds": 8.35,
      "text": "Thank you. Ananya, I'm going to press your tummy, tell me if it hurts. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.44,
      "end_seconds": 248.87,
      "duration_seconds": 3.43,
      "text": "It's sore at the top. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.22,
      "end_seconds": 270.16,
      "duration_seconds": 6.94,
      "text": "Mild tenderness in the upper abdomen, and you're alert, talking in full sentences."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.93,
      "end_seconds": 277.23,
      "duration_seconds": 4.3,
      "text": "Am I going to be okay? ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.55,
      "end_seconds": 304.66,
      "duration_seconds": 25.11,
      "text": "With paracetamol, the important thing is to act early, and you've come in early. The blood level we take at four hours tells us how much treatment you need, so I'd like to arrange a paracetamol level when it's four hours since you took them."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 307.62,
      "end_seconds": 311.91,
      "duration_seconds": 4.29,
      "text": "That'll be about five o'clock, doctor."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.88,
      "end_seconds": 322.0,
      "duration_seconds": 9.12,
      "text": "Yes, five. And I'd like to check your liver with blood tests now as well."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.19,
      "end_seconds": 328.1,
      "duration_seconds": 3.91,
      "text": "Will it damage my liver? ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.03,
      "end_seconds": 343.42,
      "duration_seconds": 13.39,
      "text": "It can, which is why we check. I can't rule out liver injury yet, but your numbers at the moment are reassuring."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.3,
      "end_seconds": 348.16,
      "duration_seconds": 3.86,
      "text": "Okay. Can my mum come in? ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 349.61,
      "end_seconds": 356.09,
      "duration_seconds": 6.48,
      "text": "She's just coming through the doors, I'll bring her to you. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.97,
      "end_seconds": 372.67,
      "duration_seconds": 15.7,
      "text": "Ananya, I'll also ask our mental health team to see you before you go home, because I want to make sure you get proper support with the stress. Is that okay?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 375.6,
      "end_seconds": 380.38,
      "duration_seconds": 4.78,
      "text": "Yes. I want to talk to somebody. ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 381.51,
      "end_seconds": 388.96,
      "duration_seconds": 7.45,
      "text": "Good. You won't be on your own. Priya will stay with you. ~"
    }
  ]
}
