{
  "schema_version": "1.0",
  "encounter_id": "00737",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 0.43,
      "end_seconds": 8.0,
      "duration_seconds": 7.57,
      "text": "Hello, can I just check, is it Mrs Pickering, Joan Pickering? ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.77,
      "end_seconds": 20.76,
      "duration_seconds": 10.99,
      "text": "It is, dear, Joan, born in the very same village as the doctor's mother, I'd wager. This is my Helen. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 22.38,
      "end_seconds": 29.82,
      "duration_seconds": 7.44,
      "text": "Hi. Mum's been dizzy since they changed her blood pressure tablets, that's why we're here."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.65,
      "end_seconds": 33.58,
      "duration_seconds": 1.93,
      "text": "Dizzy how, Joan?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.9,
      "end_seconds": 52.49,
      "duration_seconds": 17.59,
      "text": "When I stand up, the room goes round and I have to hold the sideboard. It's been going on a while, a fortnight, perhaps longer, I couldn't tell you."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 54.61,
      "end_seconds": 63.15,
      "duration_seconds": 8.54,
      "text": "It was before Easter, wasn't it? Or after. I can't be sure either, honestly."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.27,
      "end_seconds": 70.56,
      "duration_seconds": 5.29,
      "text": "That's fine. What does the dizziness feel like?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.28,
      "end_seconds": 78.0,
      "duration_seconds": 6.72,
      "text": "Light-headed, as if I might faint. I haven't, but it's close."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.93,
      "end_seconds": 83.23,
      "duration_seconds": 2.3,
      "text": "Anything with your vision?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.05,
      "end_seconds": 90.8,
      "duration_seconds": 6.75,
      "text": "It goes blurry for a few seconds when I get up."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.11,
      "end_seconds": 95.45,
      "duration_seconds": 3.34,
      "text": "Have you had any falls?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.34,
      "end_seconds": 100.24,
      "duration_seconds": 2.9,
      "text": "Not yet, touch wood."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.8,
      "end_seconds": 104.74,
      "duration_seconds": 1.94,
      "text": "Chest pain?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.09,
      "end_seconds": 109.67,
      "duration_seconds": 3.58,
      "text": "No pain in the chest."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.4,
      "end_seconds": 113.31,
      "duration_seconds": 0.91,
      "text": "Palpitations?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.25,
      "end_seconds": 120.15,
      "duration_seconds": 4.9,
      "text": "No, my heart's quiet as a mouse."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.84,
      "end_seconds": 124.41,
      "duration_seconds": 1.57,
      "text": "Headaches?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.32,
      "end_seconds": 127.45,
      "duration_seconds": 2.13,
      "text": "No headaches, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.55,
      "end_seconds": 133.14,
      "duration_seconds": 4.59,
      "text": "Which tablets has she got now, Helen?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 134.62,
      "end_seconds": 145.83,
      "duration_seconds": 11.21,
      "text": "Ramipril, 10 mg, once a day. Amlodipine, 10 mg, once a day, that's the new one. And indapamide, 1.5 mg, in the morning."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.73,
      "end_seconds": 150.82,
      "duration_seconds": 3.09,
      "text": "Thank you. Any allergies, Joan?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.34,
      "end_seconds": 161.26,
      "duration_seconds": 8.92,
      "text": "Codeine, when I was a girl. It made me terribly sick. I've avoided it ever since."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.3,
      "end_seconds": 165.93,
      "duration_seconds": 2.63,
      "text": "Good. Other health problems?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.11,
      "end_seconds": 172.6,
      "duration_seconds": 5.49,
      "text": "High blood pressure, and arthritis in my hands."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.95,
      "end_seconds": 175.36,
      "duration_seconds": 1.41,
      "text": "Surgery?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.05,
      "end_seconds": 180.37,
      "duration_seconds": 2.32,
      "text": "A hysterectomy, in 1985."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.06,
      "end_seconds": 183.73,
      "duration_seconds": 1.67,
      "text": "Family illnesses?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.84,
      "end_seconds": 187.88,
      "duration_seconds": 3.04,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.96,
      "end_seconds": 190.97,
      "duration_seconds": 2.01,
      "text": "Who's at home?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.96,
      "end_seconds": 201.74,
      "duration_seconds": 8.78,
      "text": "I live with Helen and her husband now, since the stairs got too much."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.78,
      "end_seconds": 205.17,
      "duration_seconds": 2.39,
      "text": "And before you retired?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 206.29,
      "end_seconds": 210.42,
      "duration_seconds": 4.13,
      "text": "She was a seamstress for forty years."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.21,
      "end_seconds": 234.8,
      "duration_seconds": 7.59,
      "text": "Let me check your pressure lying down first. Blood pressure lying is 148 over 84."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.85,
      "end_seconds": 237.76,
      "duration_seconds": 1.91,
      "text": "Good. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.81,
      "end_seconds": 270.45,
      "duration_seconds": 11.64,
      "text": "Now stand up for me, slowly. Take your time. Standing, it's 108 over 64, and your pulse is 78."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.89,
      "end_seconds": 276.18,
      "duration_seconds": 4.29,
      "text": "Oh, I do feel odd. ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.03,
      "end_seconds": 297.19,
      "duration_seconds": 9.16,
      "text": "Sit down, Joan. That's quite a drop. Temperature is 36.5, oxygen 97 percent, and your weight is 62 kilos."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 298.02,
      "end_seconds": 300.85,
      "duration_seconds": 2.83,
      "text": "Is that bad? ~"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.28,
      "end_seconds": 317.12,
      "duration_seconds": 4.84,
      "text": "It explains the dizziness. Let me listen to you."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.57,
      "end_seconds": 324.71,
      "duration_seconds": 5.14,
      "text": "Heart sounds are normal, and the lungs are clear."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.61,
      "end_seconds": 328.42,
      "duration_seconds": 1.81,
      "text": "Good. ~"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.79,
      "end_seconds": 336.85,
      "duration_seconds": 7.06,
      "text": "There's no swelling in the ankles, and the mouth looks a little dry."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.8,
      "end_seconds": 342.87,
      "duration_seconds": 5.07,
      "text": "I don't drink as much as I should. ~"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.35,
      "end_seconds": 347.88,
      "duration_seconds": 3.53,
      "text": "Any trouble with your breathing, Joan?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.99,
      "end_seconds": 354.26,
      "duration_seconds": 4.27,
      "text": "No, nothing, I'm fine for breath."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.63,
      "end_seconds": 370.32,
      "duration_seconds": 14.69,
      "text": "The blood pressure is dropping too low when you stand, which looks like the new tablet, but I can't rule out you being dried out as well."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 371.87,
      "end_seconds": 374.8,
      "duration_seconds": 2.93,
      "text": "What happens now? ~"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 377.64,
      "end_seconds": 385.9,
      "duration_seconds": 8.26,
      "text": "I'd like to arrange an ECG, a blood test for kidney function and salts, and a urine test."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 386.65,
      "end_seconds": 389.16,
      "duration_seconds": 2.51,
      "text": "All today? ~"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 390.15,
      "end_seconds": 396.25,
      "duration_seconds": 6.1,
      "text": "Yes. I'd also like to fit a 24-hour blood pressure monitor."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 398.03,
      "end_seconds": 402.13,
      "duration_seconds": 4.1,
      "text": "I'll bring her back for it. ~"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 403.19,
      "end_seconds": 415.4,
      "duration_seconds": 12.21,
      "text": "Good. Drink plenty, stand up slowly. I'll decide about the tablets once I've seen the results, so please change nothing for now."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 416.36,
      "end_seconds": 418.19,
      "duration_seconds": 1.83,
      "text": "Understood. ~"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 419.03,
      "end_seconds": 424.32,
      "duration_seconds": 5.29,
      "text": "I'd like to see you again in two weeks."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 425.2,
      "end_seconds": 430.68,
      "duration_seconds": 5.48,
      "text": "Two weeks, dear. Lovely to meet you. ~"
    }
  ]
}
