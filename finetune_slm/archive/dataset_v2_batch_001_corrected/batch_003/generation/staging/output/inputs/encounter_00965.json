{
  "schema_version": "1.0",
  "encounter_id": "00965",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.74,
      "end_seconds": 13.62,
      "duration_seconds": 12.88,
      "text": "Doctor, I had a funny turn on Saturday night, chest discomfort after a very big meal, and my wife insisted I come, although I'm sure it's nothing."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.46,
      "end_seconds": 22.87,
      "duration_seconds": 6.41,
      "text": "I'm glad she did. Tell me exactly what happened. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.74,
      "end_seconds": 43.35,
      "duration_seconds": 17.61,
      "text": "We had a large roast, with a great deal of crackling, and about an hour after, I felt a pressure behind my breastbone. It lasted about twenty minutes, and it's not happened since."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.25,
      "end_seconds": 51.45,
      "duration_seconds": 6.2,
      "text": "So once, only on Saturday. How would you describe it? ~"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.65,
      "end_seconds": 60.45,
      "duration_seconds": 6.8,
      "text": "A burning, a sort of heat, rising up behind the bone."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.73,
      "end_seconds": 64.15,
      "duration_seconds": 2.42,
      "text": "Did it spread anywhere?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.78,
      "end_seconds": 73.01,
      "duration_seconds": 7.23,
      "text": "No, not to my arm or my jaw. It stayed where it was."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.11,
      "end_seconds": 81.63,
      "duration_seconds": 6.52,
      "text": "And do you get it when you walk, or climb stairs?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.85,
      "end_seconds": 91.5,
      "duration_seconds": 8.65,
      "text": "No, I walk to the farm gate and back every day. Nothing like that."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.86,
      "end_seconds": 95.4,
      "duration_seconds": 2.54,
      "text": "Did you feel bloated?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.62,
      "end_seconds": 100.05,
      "duration_seconds": 3.43,
      "text": "Yes, very. Full to the neck."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.57,
      "end_seconds": 104.55,
      "duration_seconds": 2.98,
      "text": "Any breathlessness at the time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.85,
      "end_seconds": 112.41,
      "duration_seconds": 5.56,
      "text": "A little short of breath. Just for the first few minutes."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.53,
      "end_seconds": 116.47,
      "duration_seconds": 2.94,
      "text": "Do you have any allergies?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.18,
      "end_seconds": 119.7,
      "duration_seconds": 1.52,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.89,
      "end_seconds": 123.24,
      "duration_seconds": 2.35,
      "text": "And your medical history?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.35,
      "end_seconds": 132.32,
      "duration_seconds": 6.97,
      "text": "Reflux, years ago. High cholesterol. And gallstones, they found them by accident."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.8,
      "end_seconds": 135.19,
      "duration_seconds": 1.39,
      "text": "Any operations?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.58,
      "end_seconds": 139.02,
      "duration_seconds": 2.44,
      "text": "My appendix, in 1990."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.83,
      "end_seconds": 143.67,
      "duration_seconds": 2.84,
      "text": "Heart problems in the family?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.63,
      "end_seconds": 151.13,
      "duration_seconds": 4.5,
      "text": "My father had a heart attack at fifty-eight."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.99,
      "end_seconds": 156.37,
      "duration_seconds": 2.38,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.06,
      "end_seconds": 163.07,
      "duration_seconds": 4.01,
      "text": "I gave up smoking twenty years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.79,
      "end_seconds": 165.1,
      "duration_seconds": 1.31,
      "text": "Alcohol?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.44,
      "end_seconds": 171.83,
      "duration_seconds": 4.39,
      "text": "Three beers a night, I'm afraid."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.6,
      "end_seconds": 176.54,
      "duration_seconds": 2.94,
      "text": "What do you do?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.62,
      "end_seconds": 180.31,
      "duration_seconds": 2.69,
      "text": "I'm a farmer. Dairy."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.01,
      "end_seconds": 186.46,
      "duration_seconds": 4.45,
      "text": "And what do you eat usually?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.54,
      "end_seconds": 195.32,
      "duration_seconds": 6.78,
      "text": "Very good, except Sundays, when my wife does a roast and a pudding."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.0,
      "end_seconds": 225.43,
      "duration_seconds": 12.43,
      "text": "Let me take your numbers. Pulse 78, blood pressure 138 over 84, temperature 36.6, oxygen 98 percent, breathing 16, weight 96 kilos."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.45,
      "end_seconds": 229.85,
      "duration_seconds": 3.4,
      "text": "Is the pressure all right? ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.95,
      "end_seconds": 250.76,
      "duration_seconds": 8.81,
      "text": "A little up, but nothing to worry about. Let me listen to your heart."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.37,
      "end_seconds": 255.95,
      "duration_seconds": 2.58,
      "text": "Go ahead. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.84,
      "end_seconds": 261.22,
      "duration_seconds": 3.38,
      "text": "Heart sounds are normal, regular rhythm."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.37,
      "end_seconds": 264.18,
      "duration_seconds": 1.81,
      "text": "Good. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.82,
      "end_seconds": 269.06,
      "duration_seconds": 3.24,
      "text": "Your chest is clear."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.68,
      "end_seconds": 273.17,
      "duration_seconds": 1.49,
      "text": "Good. ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.97,
      "end_seconds": 289.4,
      "duration_seconds": 5.43,
      "text": "And I'm pressing your tummy. Tell me if it's tender."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.06,
      "end_seconds": 297.53,
      "duration_seconds": 5.47,
      "text": "Slightly, there. Under the ribs, in the middle. ~"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.98,
      "end_seconds": 305.04,
      "duration_seconds": 6.06,
      "text": "There's mild tenderness in the upper middle of your abdomen."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.95,
      "end_seconds": 310.47,
      "duration_seconds": 3.52,
      "text": "That's where it was. ~"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.28,
      "end_seconds": 313.69,
      "duration_seconds": 2.41,
      "text": "Any palpitations, any sweating?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.43,
      "end_seconds": 318.98,
      "duration_seconds": 2.55,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.45,
      "end_seconds": 323.29,
      "duration_seconds": 1.84,
      "text": "Any vomiting?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.12,
      "end_seconds": 328.31,
      "duration_seconds": 2.19,
      "text": "No, I didn't vomit."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.48,
      "end_seconds": 346.56,
      "duration_seconds": 17.08,
      "text": "Let me repeat. One episode, an hour after a heavy meal, burning, bloating, settled by itself, none since, and nothing on exertion. This sounds most likely like reflux after a heavy meal."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.48,
      "end_seconds": 350.19,
      "duration_seconds": 2.71,
      "text": "Not my heart? ~"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.27,
      "end_seconds": 365.86,
      "duration_seconds": 14.59,
      "text": "It's unlikely, but because of your father and your cholesterol, I'd like to arrange an ECG today, and a blood test to check your heart muscle, called a troponin."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 368.04,
      "end_seconds": 369.76,
      "duration_seconds": 1.72,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 372.25,
      "end_seconds": 380.38,
      "duration_seconds": 8.13,
      "text": "Meanwhile, I'd like to start omeprazole, 20 mg, once a day, before breakfast."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 382.63,
      "end_seconds": 384.03,
      "duration_seconds": 1.4,
      "text": "Fine. ~"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 384.8,
      "end_seconds": 390.56,
      "duration_seconds": 5.76,
      "text": "And an antacid liquid, 10 ml, after meals when needed."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 393.1,
      "end_seconds": 396.8,
      "duration_seconds": 3.7,
      "text": "I can do that. ~"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 398.12,
      "end_seconds": 407.79,
      "duration_seconds": 9.67,
      "text": "If it happens again, especially if it comes on when you're walking, go straight to the emergency department."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 409.64,
      "end_seconds": 411.88,
      "duration_seconds": 2.24,
      "text": "I understand. ~"
    }
  ]
}
