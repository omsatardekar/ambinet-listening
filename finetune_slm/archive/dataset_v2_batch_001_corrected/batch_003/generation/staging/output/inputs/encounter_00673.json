{
  "schema_version": "1.0",
  "encounter_id": "00673",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.1,
      "end_seconds": 13.02,
      "duration_seconds": 11.92,
      "text": "Doctor, I need help, now. It's my back, my right side. I can't stay still, I'm pacing, I can't sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.09,
      "end_seconds": 23.83,
      "duration_seconds": 8.74,
      "text": "I can see how uncomfortable you are. Let's get you sorted. When did it start?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.25,
      "end_seconds": 39.27,
      "duration_seconds": 13.02,
      "text": "About two hours ago. Came out of nowhere. It comes in waves, then I think it's gone, and then it's worse."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.6,
      "end_seconds": 43.38,
      "duration_seconds": 2.78,
      "text": "Where does it go?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.66,
      "end_seconds": 55.69,
      "duration_seconds": 11.03,
      "text": "From the back round to the front, down towards my groin. It's the worst pain of my life, honestly. I'd say it's severe."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.82,
      "end_seconds": 62.68,
      "duration_seconds": 3.86,
      "text": "Have you had this before?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.87,
      "end_seconds": 76.38,
      "duration_seconds": 12.51,
      "text": "Yes, I've had stones. One, two years ago, and they blasted it with a lithotripsy, I think that's the word."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.59,
      "end_seconds": 83.19,
      "duration_seconds": 4.6,
      "text": "That helps. Have you been feeling feverish?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.56,
      "end_seconds": 88.94,
      "duration_seconds": 4.38,
      "text": "No fever. No shivers. Nothing like that."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.56,
      "end_seconds": 94.85,
      "duration_seconds": 4.29,
      "text": "Do you have any allergies to medicines?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.95,
      "end_seconds": 106.85,
      "duration_seconds": 9.9,
      "text": "Penicillin, I come out in a rash. Doctor, please, can I have something for the pain?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.94,
      "end_seconds": 118.88,
      "duration_seconds": 9.94,
      "text": "Yes, we're going to sort that out right now. Pulse and the rest first, so I'm safe. ~"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.13,
      "end_seconds": 123.9,
      "duration_seconds": 2.77,
      "text": "Go on, quickly. ~"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.32,
      "end_seconds": 148.94,
      "duration_seconds": 7.62,
      "text": "Pulse 98, blood pressure 156 over 92, temperature 36.9, oxygen 99 percent, breathing 18."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.52,
      "end_seconds": 154.08,
      "duration_seconds": 2.56,
      "text": "Is that okay? ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.57,
      "end_seconds": 167.53,
      "duration_seconds": 11.96,
      "text": "It's what I'd expect with pain like yours. I'm going to press on your back and tummy. Tell me when it's sore. ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.64,
      "end_seconds": 171.26,
      "duration_seconds": 2.62,
      "text": "There! Right there! ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.22,
      "end_seconds": 181.37,
      "duration_seconds": 8.15,
      "text": "Very tender over the right loin, but your tummy is soft, with no guarding."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.93,
      "end_seconds": 185.65,
      "duration_seconds": 2.72,
      "text": "What is it? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.48,
      "end_seconds": 201.27,
      "duration_seconds": 13.79,
      "text": "Judging by the pain, how it comes in waves and goes to the groin, and your history, this looks most like a kidney stone."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.15,
      "end_seconds": 207.66,
      "duration_seconds": 3.51,
      "text": "Right. I knew it. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.5,
      "end_seconds": 217.87,
      "duration_seconds": 8.37,
      "text": "I'm going to give you diclofenac, 75 mg, by injection, now, for kidney stone pain. It acts quickly."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.79,
      "end_seconds": 223.16,
      "duration_seconds": 3.37,
      "text": "Thank God. Will it hurt? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.33,
      "end_seconds": 241.58,
      "duration_seconds": 17.25,
      "text": "A small jab in the thigh, that's all. Nurse will help. And I'd like to arrange a CT scan of your kidneys and bladder, to see the stone's size and where it sits."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.47,
      "end_seconds": 246.68,
      "duration_seconds": 3.21,
      "text": "Do I need that? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.02,
      "end_seconds": 259.02,
      "duration_seconds": 10.0,
      "text": "Yes, I want to rule out a blockage. And a urine test too, to check for infection and blood."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.92,
      "end_seconds": 264.74,
      "duration_seconds": 3.82,
      "text": "Fine. Do what you need. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.64,
      "end_seconds": 278.3,
      "duration_seconds": 10.66,
      "text": "Drink plenty of water, and we'll strain your urine to catch the stone, in case we can analyse it."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.87,
      "end_seconds": 283.22,
      "duration_seconds": 2.35,
      "text": "Strain? Lovely. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.11,
      "end_seconds": 301.02,
      "duration_seconds": 14.91,
      "text": "It helps to know what type it is. If the pain isn't controlled within an hour, or you develop a fever, tell the nurse straight away and we'll review you."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.55,
      "end_seconds": 305.99,
      "duration_seconds": 3.44,
      "text": "I will. Thank you. ~"
    }
  ]
}
