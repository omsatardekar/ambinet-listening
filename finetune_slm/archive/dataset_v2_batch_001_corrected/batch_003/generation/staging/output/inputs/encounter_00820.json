{
  "schema_version": "1.0",
  "encounter_id": "00820",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.87,
      "end_seconds": 10.45,
      "duration_seconds": 9.58,
      "text": "Hi. I've started a night-shift job, three weeks ago, and I can't sleep in the daytime, and I'm wrecked."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.34,
      "end_seconds": 15.24,
      "duration_seconds": 3.9,
      "text": "What sort of work, and what hours?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.43,
      "end_seconds": 26.62,
      "duration_seconds": 9.19,
      "text": "I'm a warehouse picker. Ten at night to six in the morning, four nights a week."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.51,
      "end_seconds": 33.04,
      "duration_seconds": 4.53,
      "text": "And when do you try to sleep?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.07,
      "end_seconds": 49.49,
      "duration_seconds": 14.42,
      "text": "When I get home at seven. I lie there, and my mind's awake. Then I get two or three hours, and wake up hot."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.92,
      "end_seconds": 55.98,
      "duration_seconds": 4.06,
      "text": "Do you feel sleepy on shift?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.59,
      "end_seconds": 63.77,
      "duration_seconds": 6.18,
      "text": "Yeah. I nearly dropped off driving home last week. That scared me."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.74,
      "end_seconds": 68.44,
      "duration_seconds": 3.7,
      "text": "Any snoring, or waking up gasping?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.56,
      "end_seconds": 73.39,
      "duration_seconds": 3.83,
      "text": "No. My girlfriend says I don't snore."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.85,
      "end_seconds": 79.88,
      "duration_seconds": 5.03,
      "text": "Do you take any tablets to sleep? ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.37,
      "end_seconds": 87.68,
      "duration_seconds": 6.31,
      "text": "No, nothing. I thought about it, but I don't know what's safe. ~"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.27,
      "end_seconds": 94.54,
      "duration_seconds": 4.27,
      "text": "How about caffeine, and energy drinks? ~"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.67,
      "end_seconds": 103.76,
      "duration_seconds": 8.09,
      "text": "Loads. Four coffees a shift, and an energy drink before the drive home. ~"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.89,
      "end_seconds": 106.81,
      "duration_seconds": 1.92,
      "text": "Any health conditions?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.04,
      "end_seconds": 114.3,
      "duration_seconds": 5.26,
      "text": "Asthma, and I get a bit of anxiety."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.54,
      "end_seconds": 120.7,
      "duration_seconds": 5.16,
      "text": "Any family history of sleep problems or mental health?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.11,
      "end_seconds": 125.03,
      "duration_seconds": 2.92,
      "text": "My mum has anxiety."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.79,
      "end_seconds": 132.7,
      "duration_seconds": 4.91,
      "text": "Let me check your pulse and blood pressure. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.6,
      "end_seconds": 135.1,
      "duration_seconds": 1.5,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.4,
      "end_seconds": 153.69,
      "duration_seconds": 5.29,
      "text": "Pulse 78, blood pressure 120 over 74, weight 72 kilos."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.64,
      "end_seconds": 159.28,
      "duration_seconds": 2.64,
      "text": "Is that normal? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.64,
      "end_seconds": 182.6,
      "duration_seconds": 6.96,
      "text": "Yes. I'll listen to your chest too, because of the asthma."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.58,
      "end_seconds": 187.06,
      "duration_seconds": 3.48,
      "text": "It's fine, I think. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.7,
      "end_seconds": 190.84,
      "duration_seconds": 2.14,
      "text": "Clear, no wheeze."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.8,
      "end_seconds": 196.49,
      "duration_seconds": 3.69,
      "text": "So what do I do? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.67,
      "end_seconds": 209.53,
      "duration_seconds": 10.86,
      "text": "Shift work sleep disorder is very common. I'd say you've got this, with the caffeine making it worse."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.3,
      "end_seconds": 216.17,
      "duration_seconds": 3.87,
      "text": "Right. How do I fix it? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.1,
      "end_seconds": 228.1,
      "duration_seconds": 11.0,
      "text": "Make your bedroom dark and cool, use blackout curtains and an eye mask, and keep it quiet, earplugs, phone on silent."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.88,
      "end_seconds": 231.96,
      "duration_seconds": 3.08,
      "text": "I have thin curtains. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.86,
      "end_seconds": 242.9,
      "duration_seconds": 10.04,
      "text": "Get blackout ones. And have no caffeine or energy drinks in the second half of your shift."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.79,
      "end_seconds": 250.67,
      "duration_seconds": 4.88,
      "text": "Even the drink for the drive home? ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.48,
      "end_seconds": 258.71,
      "duration_seconds": 6.23,
      "text": "Especially that. Have a snack and some water instead. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.43,
      "end_seconds": 261.27,
      "duration_seconds": 1.84,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.01,
      "end_seconds": 273.98,
      "duration_seconds": 9.97,
      "text": "I'd also like you to take melatonin, 3 mg, an hour before you go to bed after your shift."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.0,
      "end_seconds": 277.89,
      "duration_seconds": 2.89,
      "text": "Is that safe? ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.63,
      "end_seconds": 284.92,
      "duration_seconds": 6.29,
      "text": "It's mild and non-addictive. I'd like you to start with that. ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.77,
      "end_seconds": 288.82,
      "duration_seconds": 3.05,
      "text": "And the driving? ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.27,
      "end_seconds": 300.58,
      "duration_seconds": 10.31,
      "text": "If you feel drowsy, pull over and have a nap. Or ask a friend for a lift, or get the bus."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.8,
      "end_seconds": 305.08,
      "duration_seconds": 3.28,
      "text": "I'll try the bus. ~"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.9,
      "end_seconds": 318.77,
      "duration_seconds": 11.87,
      "text": "I'd also like to arrange a blood test, to check your thyroid and iron, since tiredness can come from those."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.61,
      "end_seconds": 323.16,
      "duration_seconds": 1.55,
      "text": "Fine. ~"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.75,
      "end_seconds": 333.75,
      "duration_seconds": 8.0,
      "text": "Let's see how it goes. I'd like to see you again in four weeks."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.36,
      "end_seconds": 338.71,
      "duration_seconds": 3.35,
      "text": "Four weeks. Thank you. ~"
    }
  ]
}
