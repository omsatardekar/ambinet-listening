{
  "schema_version": "1.0",
  "encounter_id": "00823",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 1.17,
      "end_seconds": 12.48,
      "duration_seconds": 11.31,
      "text": "Hello, I'm Pat, the practice nurse. I'll weigh the baby and take her temperature before you see the doctor. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 15.22,
      "end_seconds": 19.08,
      "duration_seconds": 3.86,
      "text": "Thank you. She's been so unsettled. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 36.92,
      "end_seconds": 42.04,
      "duration_seconds": 5.12,
      "text": "Temperature 36.9, weight 8.4 kilos, heart rate 128."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.03,
      "end_seconds": 47.96,
      "duration_seconds": 4.93,
      "text": "Hello, I'm Dr Walsh. Who's this? ~"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 50.85,
      "end_seconds": 60.46,
      "duration_seconds": 9.61,
      "text": "Evie, she's ten months. It's her nappy rash, doctor. It won't clear, and nothing's working."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.54,
      "end_seconds": 63.83,
      "duration_seconds": 1.29,
      "text": "Waaah. ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.74,
      "end_seconds": 70.54,
      "duration_seconds": 3.8,
      "text": "How long has it been going on?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 73.19,
      "end_seconds": 82.48,
      "duration_seconds": 9.29,
      "text": "Nearly three weeks, I'd say. It's red and raw, and now there are little spots round the edge."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.72,
      "end_seconds": 87.6,
      "duration_seconds": 2.88,
      "text": "Where is it exactly?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 88.72,
      "end_seconds": 94.79,
      "duration_seconds": 6.07,
      "text": "The whole nappy area, in the folds, and between her legs."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.4,
      "end_seconds": 100.88,
      "duration_seconds": 4.48,
      "text": "Any fever, or has she seemed unwell?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 102.67,
      "end_seconds": 108.9,
      "duration_seconds": 6.23,
      "text": "No fever. She's feeding well, but she's grizzly when I change her."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.56,
      "end_seconds": 114.84,
      "duration_seconds": 3.28,
      "text": "Any blisters, or weeping?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 116.81,
      "end_seconds": 121.41,
      "duration_seconds": 4.6,
      "text": "No blisters. A bit weepy in the creases."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.95,
      "end_seconds": 126.75,
      "duration_seconds": 3.8,
      "text": "What have you been putting on? ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 127.9,
      "end_seconds": 139.47,
      "duration_seconds": 11.57,
      "text": "Barrier cream, every change, and I've switched nappies twice. And I leave her bare for a bit each day. ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.44,
      "end_seconds": 147.2,
      "duration_seconds": 4.76,
      "text": "Any allergies, as far as you know?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 148.81,
      "end_seconds": 153.95,
      "duration_seconds": 5.14,
      "text": "No allergies. She's had no reactions to anything."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.35,
      "end_seconds": 162.09,
      "duration_seconds": 5.74,
      "text": "Has she had eczema, or any other skin conditions?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 164.49,
      "end_seconds": 168.59,
      "duration_seconds": 4.1,
      "text": "A little eczema on her cheeks."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.69,
      "end_seconds": 173.29,
      "duration_seconds": 3.6,
      "text": "Has she had antibiotics recently? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 176.07,
      "end_seconds": 181.8,
      "duration_seconds": 5.73,
      "text": "Yes, for an ear infection, a fortnight ago. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.76,
      "end_seconds": 206.73,
      "duration_seconds": 4.97,
      "text": "Let me look. Lay her on the couch."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.99,
      "end_seconds": 209.84,
      "duration_seconds": 1.85,
      "text": "Waaah! ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.84,
      "end_seconds": 225.26,
      "duration_seconds": 12.42,
      "text": "There's a bright red rash across the groin and buttocks, with satellite red spots around the edges, and the skin folds are involved."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 227.57,
      "end_seconds": 230.28,
      "duration_seconds": 2.71,
      "text": "Is it thrush? ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.86,
      "end_seconds": 244.45,
      "duration_seconds": 11.59,
      "text": "That's what it looks like, a fungal nappy rash, but I can't rule out a bacterial infection on top."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 245.43,
      "end_seconds": 248.33,
      "duration_seconds": 2.9,
      "text": "What can I do? ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.82,
      "end_seconds": 268.44,
      "duration_seconds": 18.62,
      "text": "I'd like to take a swab from the rash, to check, and I'd like to start an anti-fungal cream, clotrimazole, apply it three times a day for a week, after cleaning."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 269.9,
      "end_seconds": 273.38,
      "duration_seconds": 3.48,
      "text": "And the barrier cream? ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.85,
      "end_seconds": 282.82,
      "duration_seconds": 6.97,
      "text": "Keep using it over the top, but not before the anti-fungal cream. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 284.78,
      "end_seconds": 286.38,
      "duration_seconds": 1.6,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.57,
      "end_seconds": 296.79,
      "duration_seconds": 9.22,
      "text": "Change her nappy often, clean with water and cotton wool, no wipes, and let the skin air dry."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 298.13,
      "end_seconds": 300.03,
      "duration_seconds": 1.9,
      "text": "I will. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.75,
      "end_seconds": 314.34,
      "duration_seconds": 13.59,
      "text": "If the rash spreads, blisters, or she gets a fever, or if it's not better in a week, come back and see me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 316.74,
      "end_seconds": 320.24,
      "duration_seconds": 3.5,
      "text": "I will. Thank you. ~"
    }
  ]
}
