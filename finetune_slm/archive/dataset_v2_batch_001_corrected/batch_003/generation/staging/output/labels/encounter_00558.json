  "clinical_uncertainties": [],
  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "This wheezing, doctor. It's mostly at night, and again first thing in the morning. Sounds like a squeaky gate.",
      "start_timestamp": "00:40",
      "end_timestamp": "00:48",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "I can hear it from the hall. Around four, usually. I look in and he's sitting up on the edge of the bed.",
      "start_timestamp": "00:50",
      "end_timestamp": "01:01",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "About six weeks. It started around the time the lawn crew did their last cut of the season. Funny what you remember.",
      "start_timestamp": "01:13",
      "end_timestamp": "01:23",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Cold air makes it worse. Sitting up on two pillows helps, and a warm shower.",
      "start_timestamp": "01:30",
      "end_timestamp": "01:38",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What about during the day? Any shortness of breath?",
      "start_timestamp": "01:40",
      "end_timestamp": "01:45",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "On the stairs, yes. I get puffed halfway up to the second floor. I used to take them in one go carrying a laundry basket.",
      "start_timestamp": "01:47",
      "end_timestamp": "01:59",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And do you cough at all?",
      "start_timestamp": "02:01",
      "end_timestamp": "02:04",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A dry cough, a little tickle, mostly when I lie down.",
      "start_timestamp": "02:06",
      "end_timestamp": "02:11",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you. Now I'm going to ask about a few things you may not have. Any fever, chest pain, swelling in your legs, or coughing up blood?",
      "start_timestamp": "02:12",
      "end_timestamp": "02:26",
      "supports": [
        "negative_findings[0]",
        "negative_findings[1]",
        "negative_findings[2]",
        "negative_findings[3]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, none of those. Thank goodness. My buddy Walt had a chest scare last spring and it frightened us all half to death.",
      "start_timestamp": "02:27",
      "end_timestamp": "02:38",
      "supports": [
        "negative_findings[0]",
        "negative_findings[1]",
        "negative_findings[2]",
        "negative_findings[3]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'm glad you're clear of those. What medicines are you taking at the moment?",
      "start_timestamp": "02:40",
      "end_timestamp": "02:47",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Lisinopril, 10 milligrams once a day. Metformin, 500 milligrams twice a day. Tanya, what's the third one?",
      "start_timestamp": "02:49",
      "end_timestamp": "02:59",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Atorvastatin, 20 milligrams at bedtime. I do the pill cups.",
      "start_timestamp": "03:00",
      "end_timestamp": "03:05",
      "supports": [
        "medications[2]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Perfect. Now, do you have any allergies?",
      "start_timestamp": "03:07",
      "end_timestamp": "03:11",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Shellfish. I'm allergic to shellfish, it gives me hives. I found that out at my niece's wedding, after the shrimp cocktail. She still brings it up.",
      "start_timestamp": "03:13",
      "end_timestamp": "03:24",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "High blood pressure, type 2 diabetes, and high cholesterol. That's the holy trinity at my age.",
      "start_timestamp": "03:35",
      "end_timestamp": "03:43",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And any operations in the past?",
      "start_timestamp": "03:46",
      "end_timestamp": "03:49",
      "supports": [
        "medical_history.surgical_history[0]",
        "medical_history.surgical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Knee replacement in 2015, and my gallbladder came out about eight years ago. The knee's a champ.",
      "start_timestamp": "03:50",
      "end_timestamp": "03:58",
      "supports": [
        "medical_history.surgical_history[0]",
        "medical_history.surgical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good to hear. Does any lung trouble run in your family?",
      "start_timestamp": "04:00",
      "end_timestamp": "04:06",
      "supports": [
        "medical_history.family_history[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My mother had asthma. She kept an old inhaler in every coat pocket.",
      "start_timestamp": "04:07",
      "end_timestamp": "04:15",
      "supports": [
        "medical_history.family_history[0]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Interesting. Have you ever smoked, Gene?",
      "start_timestamp": "04:17",
      "end_timestamp": "04:20",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A pack a day for years. I smoked until about twenty years ago, then my wife made me quit.",
      "start_timestamp": "04:22",
      "end_timestamp": "04:31",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good for her. And where do you live these days?",
      "start_timestamp": "04:32",
      "end_timestamp": "04:38",
      "supports": [
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_024",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I live at Maplewood, the care home, third floor. Best part is the bingo on Thursdays.",
      "start_timestamp": "04:39",
      "end_timestamp": "04:47",
      "supports": [
        "medical_history.social_history[1]"
