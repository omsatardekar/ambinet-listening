  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My thumbs. The base of both thumbs, they've been paining me. Pain at the base of the thumbs, when I grip things.",
      "start_timestamp": "00:25",
      "end_timestamp": "00:38",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long?",
      "start_timestamp": "00:41",
      "end_timestamp": "00:43",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Oh, I don't know. It was before Diwali. Or after? Last year? I really can't say when it started.",
      "start_timestamp": "00:46",
      "end_timestamp": "00:56",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Opening jars. Turning keys. I was a tailor for forty years, so the thumbs were my life.",
      "start_timestamp": "01:21",
      "end_timestamp": "01:31",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any numbness or tingling in the fingers?",
      "start_timestamp": "01:33",
      "end_timestamp": "01:38",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No numbness. No tingling.",
      "start_timestamp": "01:40",
      "end_timestamp": "01:43",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any allergies, to medicines or anything else?",
      "start_timestamp": "01:45",
      "end_timestamp": "01:49",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hm. I think I came out in a rash once, around my eyelids, after some eye drops. But I don't remember which ones. And I'm not sure it was an allergy.",
      "start_timestamp": "01:50",
      "end_timestamp": "02:06",
      "supports": [
        "allergies[0]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'll note it as a possible, unconfirmed reaction. Let me take two numbers. Pulse 74, blood pressure 136 over 84.",
      "start_timestamp": "02:18",
      "end_timestamp": "02:29",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I can see a bony swelling at the base of the right thumb, and it's tender when I press.",
      "start_timestamp": "03:05",
      "end_timestamp": "03:16",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes, please, Anita. For the night, Mr Bhatt, a thumb splint can rest the joint.",
      "start_timestamp": "03:51",
      "end_timestamp": "03:58",
      "supports": [
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. Wear it at night and for heavy jobs. Soak your hands in warm water in the morning before you start.",
      "start_timestamp": "04:18",
      "end_timestamp": "04:31",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes, a basin of warm water, five minutes. And use the large-handled tools at home, they take the strain off the thumb.",
      "start_timestamp": "04:37",
      "end_timestamp": "04:51",
      "supports": [
        "clinical_actions[2]"
      ]
