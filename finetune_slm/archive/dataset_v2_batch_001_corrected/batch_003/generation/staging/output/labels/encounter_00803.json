  "clinical_uncertainties": [],
  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Morning, doctor. I'm Kerry, I'm Mrs Keane's carer. She's got a lump on her eyelid, and she's been rubbing it.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:13",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good morning, Mrs Keane. Which eye is it?",
      "start_timestamp": "00:15",
      "end_timestamp": "00:20",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "The right one. The top lid. It's been there a week.",
      "start_timestamp": "00:22",
      "end_timestamp": "00:29",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is it painful?",
      "start_timestamp": "00:31",
      "end_timestamp": "00:33",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It's sore, and it's red. And the eye waters.",
      "start_timestamp": "00:34",
      "end_timestamp": "00:39",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Anything like this before?",
      "start_timestamp": "01:05",
      "end_timestamp": "01:08",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "She's had them before. Years ago. And her eyelids get crusty, with that blepharitis.",
      "start_timestamp": "01:10",
      "end_timestamp": "01:19",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you have any other conditions, Mrs Keane?",
      "start_timestamp": "01:22",
      "end_timestamp": "01:26",
      "supports": [
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Diabetes, just diet, and my heart, a little.",
      "start_timestamp": "01:29",
      "end_timestamp": "01:35",
      "supports": [
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is there anyone in the family with eye problems?",
      "start_timestamp": "01:37",
      "end_timestamp": "01:42",
      "supports": [
        "medical_history.family_history[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My sister has glaucoma.",
      "start_timestamp": "01:44",
      "end_timestamp": "01:46",
      "supports": [
        "medical_history.family_history[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "There's a small, red, tender lump on the edge of the upper lid, with a tiny yellow head at the centre, and the rest of the eye is white and calm.",
      "start_timestamp": "02:15",
      "end_timestamp": "02:29",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes, a stye, an infected eyelash gland, I'd say.",
      "start_timestamp": "02:36",
      "end_timestamp": "02:40",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Not usually. The best treatment is a warm compress, a clean flannel soaked in warm water, held on the eyelid for ten minutes, three or four times a day.",
      "start_timestamp": "03:04",
      "end_timestamp": "03:21",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And I'd like you to wash the eyelid edge gently with cooled boiled water, twice a day, to keep it clean.",
      "start_timestamp": "03:31",
      "end_timestamp": "03:42",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Because of her diabetes, I'd like to check her blood sugar control, so I'd like to arrange an HbA1c blood test.",
      "start_timestamp": "04:00",
      "end_timestamp": "04:11",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If the swelling spreads to the cheek, the eye becomes very red or painful, or her vision changes, come back immediately.",
      "start_timestamp": "04:33",
      "end_timestamp": "04:45",
      "supports": [
        "clinical_actions[4]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to see her in two weeks, to check the stye has gone.",
      "start_timestamp": "04:51",
      "end_timestamp": "05:00",
      "supports": [
        "clinical_actions[1]",
        "follow_up[0]"
      ]
    }
