  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Doctor, there's a dark curtain coming down over my left eye, I noticed it this morning while I was doing the toast, and I nearly dropped the lot.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:13",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It starts at the top and drifts down, like a blind. My sister had a blind in her kitchen like that, always stuck halfway.",
      "start_timestamp": "00:31",
      "end_timestamp": "00:42",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It is, yes. About a third of the way over, I'd say. I can see around the edges, like looking through a keyhole.",
      "start_timestamp": "00:51",
      "end_timestamp": "01:04",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I do, for my high blood pressure. Bisoprolol, maybe 5 mg? I'd have to check the box, to be honest.",
      "start_timestamp": "01:20",
      "end_timestamp": "01:32",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medications[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "No worries. 5 mg, maybe, so we can confirm it later. How often do you take it?",
      "start_timestamp": "01:34",
      "end_timestamp": "01:44",
      "supports": [
        "medications[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Every morning with my tea. Never miss it. Well, that's not strictly true, the odd morning I forget, usually when the grandchildren are here.",
      "start_timestamp": "01:44",
      "end_timestamp": "01:58",
      "supports": [
        "medications[0]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's very common, so no judgement. Every morning, with a few missed. Now, let me take your pressure and pulse.",
      "start_timestamp": "02:00",
      "end_timestamp": "02:10",
      "supports": [
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your blood pressure is 158/94, and your pulse is 78.",
      "start_timestamp": "02:35",
      "end_timestamp": "02:41",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Just try not to sneeze for me. Both pupils are equal, and they react to light normally.",
      "start_timestamp": "03:41",
      "end_timestamp": "03:50",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's reassuring. And the front of both eyes looks clear, nice and clean.",
      "start_timestamp": "04:03",
      "end_timestamp": "04:10",
      "supports": [
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Please don't, not with this. Tell me, apart from the eye, how has the rest of you been? Your general health?",
      "start_timestamp": "04:23",
      "end_timestamp": "04:35",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Fine, really. Fit as a fiddle for my age, I walk the dog every day.",
      "start_timestamp": "04:36",
      "end_timestamp": "04:44",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Today, yes. I'll write a letter and send you straight to the eye casualty at the hospital. Can someone drive you?",
      "start_timestamp": "05:29",
      "end_timestamp": "05:40",
      "supports": [
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Perfect. Please don't drive yourself, and don't wait until later this afternoon.",
      "start_timestamp": "05:52",
      "end_timestamp": "05:59",
      "supports": [
        "clinical_actions[1]"
      ]
    }
