  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Then your wife is a sensible woman. Tell me what happened this morning, in your own words.",
      "start_timestamp": "00:48",
      "end_timestamp": "00:56",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I was in the kitchen having my tea and I tried to say something to her and the words came out slurred. Like I'd had a few pints. It lasted about five minutes and then it was gone, just like that.",
      "start_timestamp": "00:59",
      "end_timestamp": "01:19",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "There was a bit of tingling in my right hand. Pins and needles, as the wife says. That was gone at the same time.",
      "start_timestamp": "01:57",
      "end_timestamp": "02:08",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pins and needles in your right hand, and it settled with the speech. Anything else, like a headache, or feeling dizzy?",
      "start_timestamp": "02:11",
      "end_timestamp": "02:21",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I did feel dizzy for a minute, when I stood up from the table, and then it was gone. But I'd been up since five, so it's probably that.",
      "start_timestamp": "02:24",
      "end_timestamp": "02:38",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Perhaps. Now, I'll ask a few things that might sound blunt. Did your face droop, or any weakness in an arm or leg?",
      "start_timestamp": "02:39",
      "end_timestamp": "02:50",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, no weakness. My wife says my face looked normal, she'd have said otherwise, believe me.",
      "start_timestamp": "02:53",
      "end_timestamp": "03:01",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. And any trouble with your vision, double vision, or part of it going dark?",
      "start_timestamp": "03:02",
      "end_timestamp": "03:11",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, nothing like that. My eyes were fine.",
      "start_timestamp": "03:12",
      "end_timestamp": "03:17",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Okay. Any chest pain or a racing heartbeat this morning, or lately?",
      "start_timestamp": "03:19",
      "end_timestamp": "03:26",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, nothing wrong with my chest. I walk the dog every day and I'm fine.",
      "start_timestamp": "03:27",
      "end_timestamp": "03:35",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And your breathing, any trouble there?",
      "start_timestamp": "03:38",
      "end_timestamp": "03:42",
      "supports": [
        "review_of_systems[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No. Is this going to take long? I've still got to find somewhere to park for the other thing.",
      "start_timestamp": "03:44",
      "end_timestamp": "03:55",
      "supports": [
        "review_of_systems[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "High blood pressure, the doctor told me a few years ago. And I'm borderline diabetic, they said, but I manage it with my diet.",
      "start_timestamp": "04:08",
      "end_timestamp": "04:22",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "So high blood pressure, and diabetes managed with diet. Do you smoke?",
      "start_timestamp": "04:24",
      "end_timestamp": "04:31",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Ten a day, give or take. I know, I know, don't start.",
      "start_timestamp": "04:33",
      "end_timestamp": "04:40",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I won't lecture you today. Are you allergic to anything that I should write down?",
      "start_timestamp": "04:42",
      "end_timestamp": "04:50",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Latex. Rubber gloves give me a horrible rash on my hands. Hospitals always put a sticker on my notes about it.",
      "start_timestamp": "04:51",
      "end_timestamp": "05:03",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Latex and a rash from gloves, noted. I'll tell the nurse to use non-latex ones. Let me do your readings now. Blood pressure is 158 over 94.",
      "start_timestamp": "05:13",
      "end_timestamp": "05:30",
      "supports": [
        "vital_signs[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse is 88, temperature 36.8, oxygen saturation 97 percent, and your breathing is 16 a minute.",
      "start_timestamp": "05:31",
      "end_timestamp": "05:40",
      "supports": [
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your face moves evenly on both sides, and your speech is perfectly clear now. Squeeze my fingers as hard as you can.",
      "start_timestamp": "06:31",
      "end_timestamp": "06:44",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes, both hands are equally strong. That's reassuring. So, I know you're in a hurry, but I want to arrange a CT scan of your head today, at the hospital.",
      "start_timestamp": "06:51",
      "end_timestamp": "07:06",
      "supports": [
        "physical_examination[1]",
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I understand, but what happened this morning needs to be looked at properly and soon. I also want an ECG done here before you leave, to check your heart rhythm.",
      "start_timestamp": "07:15",
      "end_timestamp": "07:29",
      "supports": [
        "procedures_and_investigations[1]",
