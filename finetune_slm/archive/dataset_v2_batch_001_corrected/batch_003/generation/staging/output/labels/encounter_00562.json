  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Doctor, my chest has gone all tight and I think it's the pollen. I've got hay fever, you see, and I'm frightened it's turned into something worse.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:13",
      "supports": [
        "chief_complaint",
        "symptoms[0]",
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Sunday. So four days ago. I was watching my nephew at a cricket match, sitting on the grass, and I could feel it creeping in.",
      "start_timestamp": "00:25",
      "end_timestamp": "00:39",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Comes and goes. Worse in the afternoon, and when I'm outside, especially near the park.",
      "start_timestamp": "01:05",
      "end_timestamp": "01:13",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Coming indoors and sitting down helps a bit. But then I sit there and worry, which doesn't help.",
      "start_timestamp": "01:20",
      "end_timestamp": "01:30",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's very human. Is it actually painful, or just tight?",
      "start_timestamp": "01:31",
      "end_timestamp": "01:36",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No pain. Just tight. Is that better or worse?",
      "start_timestamp": "01:38",
      "end_timestamp": "01:42",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "All right. Let me ask about the rest of you. How are your tummy and bowels?",
      "start_timestamp": "02:10",
      "end_timestamp": "02:18",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Fine. Nothing to report there.",
      "start_timestamp": "02:21",
      "end_timestamp": "02:25",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your chest is clear all the way down, and your throat looks completely normal.",
      "start_timestamp": "03:23",
      "end_timestamp": "03:31",
      "supports": [
        "physical_examination[0]",
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Oxygen is 98 per cent and your pulse is 76. Both sit right where I'd want them.",
      "start_timestamp": "03:54",
      "end_timestamp": "04:04",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Possibly, but we can test it instead of assuming. I'd like to arrange a breathing test, spirometry, which you blow into a tube and it measures how well the air moves.",
      "start_timestamp": "04:34",
      "end_timestamp": "04:49",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Understood. Meanwhile, check the pollen forecast in the morning, keep your bedroom window shut on high days, and change your clothes when you come in from outside.",
      "start_timestamp": "05:38",
      "end_timestamp": "05:54",
      "supports": [
        "clinical_actions[1]"
      ]
    }
