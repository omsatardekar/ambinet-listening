  "clinical_uncertainties": [],
  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Morning, doctor! Well, I did it, I've cut my sleeping tablets down, and I want you to tell me I'm brilliant.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:11",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd be delighted to, once I hear the details. What are you taking now?",
      "start_timestamp": "00:13",
      "end_timestamp": "00:22",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Zopiclone, 7.5 mg at night, which is half of what I was taking in the summer. Took me ten weeks.",
      "start_timestamp": "00:24",
      "end_timestamp": "00:35",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's a real achievement. How have the nights been?",
      "start_timestamp": "00:36",
      "end_timestamp": "00:41",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Up and down. Some nights I'm out like a light, others I'm staring at the ceiling thinking about the bins.",
      "start_timestamp": "00:43",
      "end_timestamp": "00:54",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And if you don't take the tablet at all?",
      "start_timestamp": "00:56",
      "end_timestamp": "01:01",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Then I can't sleep. I can't sleep a wink. I tried on Sunday, and I was up until four, wired.",
      "start_timestamp": "01:04",
      "end_timestamp": "01:15",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any shakes, sweats, or feeling very anxious when you cut down?",
      "start_timestamp": "01:17",
      "end_timestamp": "01:23",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A bit jittery, but no, nothing dreadful. My mood's been steady, actually. No low spells.",
      "start_timestamp": "01:26",
      "end_timestamp": "01:35",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. And remind me of your background, apart from the sleep.",
      "start_timestamp": "01:37",
      "end_timestamp": "01:43",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Depression, years ago, which is much better now, and anxiety, which comes and goes.",
      "start_timestamp": "01:45",
      "end_timestamp": "01:53",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How much coffee do you drink?",
      "start_timestamp": "01:55",
      "end_timestamp": "01:58",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Three a day, the last around four. I know, I know, you've said.",
      "start_timestamp": "02:01",
      "end_timestamp": "02:08",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 70, blood pressure 124 over 78.",
      "start_timestamp": "02:33",
      "end_timestamp": "02:37",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "They're steady, no tremor. And you look calm and relaxed to me today.",
      "start_timestamp": "03:09",
      "end_timestamp": "03:18",
      "supports": [
        "physical_examination[0]",
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What I'm seeing is a dependence on zopiclone that's easing, but not yet resolved, because you can't sleep without it.",
      "start_timestamp": "03:25",
      "end_timestamp": "03:34",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Halve the dose again, so 3.75 mg at night, for two weeks. Slowly does it.",
      "start_timestamp": "04:03",
      "end_timestamp": "04:11",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Get up after twenty minutes, go to another room, read something dull, and come back when you're sleepy. Don't watch the clock.",
      "start_timestamp": "04:20",
      "end_timestamp": "04:31",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to see you again in four weeks.",
      "start_timestamp": "04:53",
      "end_timestamp": "04:59",
      "supports": [
        "clinical_actions[0]",
        "follow_up[0]"
      ]
    }
