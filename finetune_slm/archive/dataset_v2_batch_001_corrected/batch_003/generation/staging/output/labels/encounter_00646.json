  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "The fever, Ramesh. The one from the rains. He's better, doctor, but he's still not himself.",
      "start_timestamp": "00:12",
      "end_timestamp": "00:22",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That sounds like a hard week. How are you now, Ramesh?",
      "start_timestamp": "00:53",
      "end_timestamp": "00:59",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Tired. I get so tired by the afternoon, I can't do what I used to. I just have to lie down.",
      "start_timestamp": "01:01",
      "end_timestamp": "01:11",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "He's asleep by three every day. He was never like that.",
      "start_timestamp": "01:12",
      "end_timestamp": "01:18",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any fever since it broke?",
      "start_timestamp": "01:21",
      "end_timestamp": "01:24",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No fever. No, that's gone.",
      "start_timestamp": "01:26",
      "end_timestamp": "01:30",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. What tablets are you taking, let's go through them with Lakshmi's help.",
      "start_timestamp": "01:32",
      "end_timestamp": "01:40",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Paracetamol, 650 mg, when needed. And, what's the other, for the sugar...",
      "start_timestamp": "01:42",
      "end_timestamp": "01:48",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Metformin, 500 mg twice a day. And the one for blood pressure, amlodipine, 5 mg once a day. You never remember that one.",
      "start_timestamp": "01:49",
      "end_timestamp": "02:00",
      "supports": [
        "medications[1]",
        "medications[2]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Are you allergic to anything, any allergies to medicines?",
      "start_timestamp": "02:04",
      "end_timestamp": "02:10",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I had some rash from a sulfa tablet once. Years ago.",
      "start_timestamp": "02:10",
      "end_timestamp": "02:17",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Noted. And what other conditions do you have?",
      "start_timestamp": "02:19",
      "end_timestamp": "02:25",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Diabetes, for twelve years, and high blood pressure. Nothing else.",
      "start_timestamp": "02:26",
      "end_timestamp": "02:31",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Who's at home with you?",
      "start_timestamp": "02:32",
      "end_timestamp": "02:36",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My wife and the two boys. We all live together, in the old house.",
      "start_timestamp": "02:38",
      "end_timestamp": "02:46",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 78, blood pressure 138 over 84, temperature 36.8, oxygen 98 percent, weight 71 kilos.",
      "start_timestamp": "03:14",
      "end_timestamp": "03:24",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Soft, and no tenderness, and I can't feel your liver edge.",
      "start_timestamp": "03:59",
      "end_timestamp": "04:05",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It's what I wanted to find. So, all in all, the tiredness fits with the recovery period after a viral illness like dengue, and I'd call it post-viral fatigue.",
      "start_timestamp": "04:12",
      "end_timestamp": "04:28",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Short walks, regular meals, and rest when you need it, but not all afternoon, or the nights get worse.",
      "start_timestamp": "04:51",
      "end_timestamp": "05:00",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Please, Ramesh, drink more, especially in this heat. Aim for eight glasses.",
      "start_timestamp": "05:08",
      "end_timestamp": "05:15",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
