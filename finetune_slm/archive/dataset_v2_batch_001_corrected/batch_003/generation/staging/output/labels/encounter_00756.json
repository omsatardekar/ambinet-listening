  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Um, hi doctor. I've been checking my blood pressure at home, because my mum said I should, and it's been high. Is that something?",
      "start_timestamp": "00:03",
      "end_timestamp": "00:14",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Consistently high, in the morning and evening, for two weeks. Higher than the machine says is normal, anyway.",
      "start_timestamp": "00:28",
      "end_timestamp": "00:37",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And how are you feeling?",
      "start_timestamp": "00:40",
      "end_timestamp": "00:43",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Well, sometimes a bit of a headache. Otherwise fine.",
      "start_timestamp": "00:46",
      "end_timestamp": "00:51",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you have any family history of blood pressure or heart problems?",
      "start_timestamp": "00:54",
      "end_timestamp": "01:01",
      "supports": [
        "medical_history.family_history[1]",
        "clinical_actions[1]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Mum has high blood pressure. And my granddad had a heart attack.",
      "start_timestamp": "01:04",
      "end_timestamp": "01:11",
      "supports": [
        "medical_history.family_history[0]",
        "medical_history.family_history[1]",
        "clinical_actions[1]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any allergies I should know about before we go on?",
      "start_timestamp": "01:14",
      "end_timestamp": "01:20",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Latex. I get a rash when I wear the gloves at work, on my hands.",
      "start_timestamp": "01:23",
      "end_timestamp": "01:31",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Noted. Any operations?",
      "start_timestamp": "01:34",
      "end_timestamp": "01:36",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I had my appendix out, when I was fifteen.",
      "start_timestamp": "01:40",
      "end_timestamp": "01:45",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you drink alcohol, or have a lot of caffeine or salt in your diet?",
      "start_timestamp": "01:48",
      "end_timestamp": "01:56",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A few drinks at weekends, I suppose. I like crisps, though.",
      "start_timestamp": "02:00",
      "end_timestamp": "02:06",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any other medical conditions?",
      "start_timestamp": "02:09",
      "end_timestamp": "02:11",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, only the occasional migraine.",
      "start_timestamp": "02:14",
      "end_timestamp": "02:17",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It's good that you checked. I'd say this is probably high blood pressure, but I want it confirmed properly.",
      "start_timestamp": "03:28",
      "end_timestamp": "03:38",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to arrange a 24-hour blood pressure monitor, which you wear on your arm for a day, and it takes readings every half hour.",
      "start_timestamp": "03:45",
      "end_timestamp": "03:57",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Not until we have the results. Many people with mildly raised readings start with lifestyle changes, so cut down on salt, crisps, and alcohol, and be active.",
      "start_timestamp": "04:24",
      "end_timestamp": "04:38",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And if you ever get severe headache with blurred vision, chest pain, or breathlessness, come in straight away.",
