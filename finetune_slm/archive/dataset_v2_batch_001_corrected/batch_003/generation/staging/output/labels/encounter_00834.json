  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "nurse",
      "transcript_text": "Pulse 62, blood pressure 118 over 72, weight 66 kilos.",
      "start_timestamp": "00:40",
      "end_timestamp": "00:45",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I've been tired all the time for a month, doctor. I'm worn out by two in the afternoon. I wonder if it's my thyroid.",
      "start_timestamp": "00:56",
      "end_timestamp": "01:09",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Because I had it treated last year, the radioactive iodine, and I've been on the thyroid tablets since. My sister says it's the thyroid.",
      "start_timestamp": "01:16",
      "end_timestamp": "01:27",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any feeling of being cold, constipation, dry skin?",
      "start_timestamp": "01:43",
      "end_timestamp": "01:49",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A bit cold, yes. And dry skin on my shins.",
      "start_timestamp": "01:50",
      "end_timestamp": "01:55",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And your mood? Any low mood, or lost interest in things?",
      "start_timestamp": "01:56",
      "end_timestamp": "02:03",
      "supports": [
        "symptoms[2]",
        "negative_findings[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, I'm not low. I'm just tired. I'm perfectly fine in my mood.",
      "start_timestamp": "02:06",
      "end_timestamp": "02:12",
      "supports": [
        "negative_findings[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_4",
      "speaker_role": "caregiver",
      "transcript_text": "She has been low, doctor. She hasn't wanted to go to her craft group for weeks. And she's cried a couple of times.",
      "start_timestamp": "02:14",
      "end_timestamp": "02:25",
      "supports": [
        "symptoms[2]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Bridget, honestly.",
      "start_timestamp": "02:28",
      "end_timestamp": "02:29",
      "supports": [
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'll note both, Maureen, that you say your mood is fine, and Bridget's noticed you've been withdrawn. What medicines do you take?",
      "start_timestamp": "02:30",
      "end_timestamp": "02:43",
      "supports": [
        "medications[0]",
        "medications[1]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Levothyroxine, 100 micrograms, once a day, before breakfast. And vitamin D, 1000 units.",
      "start_timestamp": "02:43",
      "end_timestamp": "02:52",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Tea and calcium can reduce absorption. Any allergies?",
      "start_timestamp": "03:05",
      "end_timestamp": "03:09",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, none, love.",
      "start_timestamp": "03:12",
      "end_timestamp": "03:14",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you drink alcohol?",
      "start_timestamp": "03:16",
      "end_timestamp": "03:19",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A sherry on Sundays.",
      "start_timestamp": "03:19",
      "end_timestamp": "03:22",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your skin is dry, your reflexes are slow, and there's no lump in the neck.",
      "start_timestamp": "04:09",
      "end_timestamp": "04:18",
      "supports": [
        "physical_examination[0]",
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Possibly. After thyroid treatment, the tablet dose often needs adjusting. I'd say this could be an underactive thyroid from too low a dose, but I can't rule out another cause of tiredness, such as anaemia or low mood.",
      "start_timestamp": "04:24",
      "end_timestamp": "04:42",
      "supports": [
        "clinical_assessment[0]",
        "clinical_assessment[1]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to arrange a blood test for your thyroid function, your blood count, and your iron and vitamin B12 levels.",
      "start_timestamp": "04:47",
      "end_timestamp": "04:59",
      "supports": [
        "procedures_and_investigations[0]",
        "procedures_and_investigations[1]",
        "clinical_actions[0]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And I'd like a blood sugar, to be complete.",
      "start_timestamp": "05:08",
      "end_timestamp": "05:14",
      "supports": [
        "procedures_and_investigations[2]",
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "In the meantime, take the levothyroxine on its own, with water, half an hour before breakfast, and don't have tea or milk with it.",
      "start_timestamp": "05:19",
      "end_timestamp": "05:33",
      "supports": [
        "clinical_actions[4]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And Maureen, if your mood gets lower, or you feel hopeless, please tell us.",
      "start_timestamp": "05:40",
      "end_timestamp": "05:48",
      "supports": [
        "clinical_actions[5]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If you get very drowsy, very cold, confused, or short of breath, come in straight away.",
      "start_timestamp": "05:53",
