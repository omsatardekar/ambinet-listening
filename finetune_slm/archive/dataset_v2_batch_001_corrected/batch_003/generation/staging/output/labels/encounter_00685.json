      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It used to be a day of cramps. Now it's three, four days, and I'm on the bathroom floor on the second one.",
