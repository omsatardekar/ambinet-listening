  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Oh, I'm after a check on my tablet, the omeprazole, for the heartburn. It's due, they sent me a text.",
      "start_timestamp": "00:25",
      "end_timestamp": "00:37",
      "supports": [
        "chief_complaint",
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. Tell me how you take it.",
      "start_timestamp": "00:38",
      "end_timestamp": "00:42",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "One a day, 20 milligrams, I think. Maybe 40? The box is at home. In the morning, before breakfast, when I remember.",
      "start_timestamp": "00:44",
      "end_timestamp": "00:55",
      "supports": [
        "medications[0]",
        "clinical_uncertainties[0]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "When you remember. How often do you forget?",
      "start_timestamp": "00:56",
      "end_timestamp": "01:00",
      "supports": [
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Oh, the odd day. A few days a week, perhaps. I put it by the kettle, but then I have my tea and off I go.",
      "start_timestamp": "01:03",
      "end_timestamp": "01:15",
      "supports": [
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Now, I see here a note on your allergies. Can you tell me about that?",
      "start_timestamp": "01:31",
      "end_timestamp": "01:39",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Penicillin. Years ago, I came out in a rash, all over my back. The doctor said never again.",
      "start_timestamp": "01:41",
      "end_timestamp": "01:51",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's very clear. Anything else in your medical history I should know about?",
      "start_timestamp": "01:54",
      "end_timestamp": "02:01",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "The reflux, of course, and the blood pressure.",
      "start_timestamp": "02:02",
      "end_timestamp": "02:07",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Lovely. Let me check your numbers. Pulse 70, blood pressure 130 over 78, temperature 36.6, oxygen 98 percent, breathing 14, weight 71 kilos.",
      "start_timestamp": "02:51",
      "end_timestamp": "03:04",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]",
        "vital_signs[5]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your abdomen is soft. And there's no tenderness at the top of the tummy.",
      "start_timestamp": "03:29",
      "end_timestamp": "03:37",
      "supports": [
        "physical_examination[0]",
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "So the reflux sounds well controlled.",
      "start_timestamp": "03:43",
      "end_timestamp": "03:46",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
