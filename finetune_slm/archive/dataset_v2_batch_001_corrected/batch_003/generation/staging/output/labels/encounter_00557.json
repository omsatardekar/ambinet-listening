      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Tonsils. When I was ten.",
      "start_timestamp": "02:29",
      "end_timestamp": "02:32",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Tender in the lower right side of your abdomen, and I can feel the muscles tightening under my hand. You can relax now.",
