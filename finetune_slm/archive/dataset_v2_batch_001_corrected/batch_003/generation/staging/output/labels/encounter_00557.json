    {
      "evidence_id": "EV_023",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It is common. First I would like blood tests now, to look for infection.",
      "start_timestamp": "04:27",
      "end_timestamp": "04:34",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_024",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Then we will do an ultrasound scan of your abdomen, today itself.",
      "start_timestamp": "04:39",
      "end_timestamp": "04:47",
      "supports": [
        "procedures_and_investigations[1]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_025",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes. And let's get a urine test, to be sure nothing else is going on.",
