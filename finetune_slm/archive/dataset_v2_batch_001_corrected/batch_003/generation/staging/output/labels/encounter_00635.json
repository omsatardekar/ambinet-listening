  "clinical_uncertainties": [],
  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Sort of. It's odd, really. My back pain gets better the more I do, which my mum says is the wrong way round.",
      "start_timestamp": "00:16",
      "end_timestamp": "00:28",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Not wrong at all, it's actually a clue. Remind me how long it's been going on?",
      "start_timestamp": "00:31",
      "end_timestamp": "00:39",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Let me think. It started gradually, around when we moved flat, so about eight months now.",
      "start_timestamp": "00:41",
      "end_timestamp": "00:49",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And where do you feel it?",
      "start_timestamp": "00:51",
      "end_timestamp": "00:55",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Low down, right across the bottom of my back. Sometimes it shoots into my right buttock.",
      "start_timestamp": "00:56",
      "end_timestamp": "01:05",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What's it like first thing in the morning?",
      "start_timestamp": "01:06",
      "end_timestamp": "01:11",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Awful, I'm stiff as a board. It takes me a good hour to loosen up and I can barely get my socks on.",
      "start_timestamp": "01:12",
      "end_timestamp": "01:23",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Does it ever wake you at night?",
      "start_timestamp": "01:24",
      "end_timestamp": "01:28",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yeah, I get night pain, usually around four. I have to get up and shuffle about the kitchen.",
      "start_timestamp": "01:30",
      "end_timestamp": "01:39",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Worse. Sitting is the enemy. But a swim or a bike ride and it's far better, so exercise helps it.",
      "start_timestamp": "01:49",
      "end_timestamp": "02:01",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That pattern matters. Let me ask about some other things. Any red or painful eyes?",
      "start_timestamp": "02:02",
      "end_timestamp": "02:11",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, my eyes have been fine.",
      "start_timestamp": "02:12",
      "end_timestamp": "02:16",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any diarrhoea or blood when you go to the toilet?",
      "start_timestamp": "02:17",
      "end_timestamp": "02:23",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Nope, nothing like that.",
      "start_timestamp": "02:25",
      "end_timestamp": "02:28",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any numbness or weakness in your legs?",
      "start_timestamp": "02:30",
      "end_timestamp": "02:33",
      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No numbness, my legs work fine. It's all just the back.",
      "start_timestamp": "02:34",
      "end_timestamp": "02:40",
      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. Any allergies to medicines that I should know about?",
      "start_timestamp": "02:41",
      "end_timestamp": "02:46",
      "supports": [
        "negative_findings[3]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, no allergies that I know of.",
      "start_timestamp": "02:48",
      "end_timestamp": "02:52",
      "supports": [
        "negative_findings[3]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. Now your background. Are you well otherwise?",
      "start_timestamp": "02:55",
      "end_timestamp": "02:59",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I get skin trouble, psoriasis, on my scalp and my elbows. Since I was about nineteen.",
      "start_timestamp": "03:01",
      "end_timestamp": "03:09",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Right, that's worth knowing. Anything else?",
      "start_timestamp": "03:10",
      "end_timestamp": "03:14",
      "supports": [
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Migraines now and then, nothing dramatic.",
      "start_timestamp": "03:17",
      "end_timestamp": "03:21",
      "supports": [
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any operations in the past?",
      "start_timestamp": "03:24",
      "end_timestamp": "03:27",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_024",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I had my appendix out when I was fifteen. That's all.",
      "start_timestamp": "03:28",
      "end_timestamp": "03:34",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_025",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And does anyone in the family have back problems?",
      "start_timestamp": "03:35",
      "end_timestamp": "03:40",
      "supports": [
        "medical_history.family_history[0]"
      ]
    },
    {
      "evidence_id": "EV_026",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My dad does. He has ankylosing spondylitis, he's had it for years. It's why I came in, to be honest.",
      "start_timestamp": "03:43",
      "end_timestamp": "03:54",
      "supports": [
        "medical_history.family_history[0]"
      ]
    },
    {
      "evidence_id": "EV_027",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's helpful. Do you smoke?",
