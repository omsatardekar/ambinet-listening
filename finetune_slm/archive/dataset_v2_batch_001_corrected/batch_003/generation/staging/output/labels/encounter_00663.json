  "clinical_uncertainties": [],
  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Doctor, thank you for seeing us. It's my father, he doesn't complain, so I'm going to do the talking. He has fallen twice in the last month.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:17",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'm sorry to hear that. Mr Nair, tell me in your own words, what happened?",
      "start_timestamp": "00:19",
      "end_timestamp": "00:27",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It is nothing. I stood up from the chair, and my legs went. That's all.",
      "start_timestamp": "00:29",
      "end_timestamp": "00:38",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "The second time he was getting out of bed at night, to go to the toilet. I found him on the floor in the morning.",
      "start_timestamp": "00:39",
      "end_timestamp": "00:54",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Mr Nair, do you remember feeling anything before you fell?",
      "start_timestamp": "00:55",
      "end_timestamp": "01:01",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A bit dizzy. When I stand up fast, the room goes grey for a moment.",
      "start_timestamp": "01:03",
      "end_timestamp": "01:11",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Did you hit your head on either fall?",
      "start_timestamp": "01:12",
      "end_timestamp": "01:17",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No. My arm only, a bruise.",
      "start_timestamp": "01:20",
      "end_timestamp": "01:23",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any chest pain, or palpitations with it?",
      "start_timestamp": "01:25",
      "end_timestamp": "01:29",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No pain. Nothing in the chest.",
      "start_timestamp": "01:31",
      "end_timestamp": "01:35",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Did you black out, lose consciousness at all, or is it more that your legs gave way?",
      "start_timestamp": "01:37",
      "end_timestamp": "01:47",
      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No blackout. I was awake the whole time.",
      "start_timestamp": "01:49",
      "end_timestamp": "01:54",
      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you. What medicines does he take, Anita?",
      "start_timestamp": "01:55",
      "end_timestamp": "02:00",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Amlodipine, 5 mg once a day, and atenolol, 50 mg once a day. He takes them in the morning.",
      "start_timestamp": "02:03",
      "end_timestamp": "02:13",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Okay. And any allergies to medicines?",
      "start_timestamp": "02:14",
      "end_timestamp": "02:18",
      "supports": [
        "negative_findings[3]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "No, none. He has never had any problem.",
      "start_timestamp": "02:19",
      "end_timestamp": "02:24",
      "supports": [
        "negative_findings[3]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let me ask about his health background.",
      "start_timestamp": "02:25",
      "end_timestamp": "02:29",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "High blood pressure for twenty years, and diabetes, but it's diet-controlled.",
      "start_timestamp": "02:30",
      "end_timestamp": "02:37",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good for you. Any operations?",
      "start_timestamp": "02:45",
      "end_timestamp": "02:48",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Cataract operation on the right eye, last year.",
      "start_timestamp": "02:50",
      "end_timestamp": "02:55",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any strokes or heart disease in the family?",
      "start_timestamp": "02:56",
      "end_timestamp": "03:01",
      "supports": [
        "medical_history.family_history[0]",
        "clinical_actions[1]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My father had a stroke, at seventy.",
      "start_timestamp": "03:04",
      "end_timestamp": "03:09",
      "supports": [
        "medical_history.family_history[0]",
        "clinical_actions[1]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Lying down, 148 over 82. Now stand up for me slowly, and wait a minute. Standing, 118 over 70.",
      "start_timestamp": "04:25",
      "end_timestamp": "04:35",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]"
      ]
    },
    {
      "evidence_id": "EV_024",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I also watched you walk in. You walk slowly with a stoop, and your feet have good feeling when I test them.",
      "start_timestamp": "05:05",
      "end_timestamp": "05:16",
      "supports": [
        "physical_examination[0]",
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_025",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "When his pressure drops by 30 points on standing, that's what makes him dizzy and unsteady. It looks like postural hypotension, and I'd say it's the most likely cause of the falls.",
      "start_timestamp": "05:24",
      "end_timestamp": "05:38",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_026",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "They may be contributing, so I'll review them, but I don't want to change anything without looking at his heart tracing first. I'd like to arrange an ECG today.",
      "start_timestamp": "05:46",
      "end_timestamp": "06:03",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_027",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Get up slowly, sit on the edge of the bed for a minute before standing, and drink enough water during the day. Keep a light on at night.",
      "start_timestamp": "06:23",
      "end_timestamp": "06:40",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_028",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good idea. And I'd like to see you both in two weeks, to go over the ECG and decide about the tablets.",
      "start_timestamp": "06:50",
      "end_timestamp": "07:02",
      "supports": [
        "medical_history.family_history[0]",
        "clinical_actions[1]",
        "follow_up[0]"
      ]
    }
