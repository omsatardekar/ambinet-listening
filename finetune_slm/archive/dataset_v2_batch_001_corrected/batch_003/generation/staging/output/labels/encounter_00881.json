  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Good afternoon, doctor. This is a bit awkward to talk about, but I think my antidepressant is affecting my sex life.",
      "start_timestamp": "00:02",
      "end_timestamp": "00:14",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you for raising it, it's a very common concern and nothing to be embarrassed about. Which antidepressant are you taking?",
      "start_timestamp": "00:17",
      "end_timestamp": "00:28",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Sertraline, 100 mg, once a day, in the morning.",
      "start_timestamp": "00:31",
      "end_timestamp": "00:37",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long have you been on it?",
