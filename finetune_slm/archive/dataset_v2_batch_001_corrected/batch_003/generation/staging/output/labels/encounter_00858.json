  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Doctor, I'm Anjali, I'm Mrs Pereira's carer. She's been dizzy when she stands up, and I'm worried she'll fall.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:09",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Oh, it's not so bad, a little giddy sometimes.",
      "start_timestamp": "00:11",
      "end_timestamp": "00:16",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Mrs Pereira, tell me when it happens.",
      "start_timestamp": "00:18",
      "end_timestamp": "00:23",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "When I get out of bed, or up from my chair. Everything goes grey.",
      "start_timestamp": "00:25",
      "end_timestamp": "00:34",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long has this been going on?",
      "start_timestamp": "00:36",
      "end_timestamp": "00:41",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A week or two, perhaps.",
      "start_timestamp": "00:43",
      "end_timestamp": "00:46",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "It's been a month at least. I've seen her hold the wall since the start of last month.",
      "start_timestamp": "00:46",
      "end_timestamp": "00:56",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "So a week or two from you, a month or more from Anjali. I'll put it as two weeks to a month. Any fainting?",
      "start_timestamp": "00:57",
      "end_timestamp": "01:08",
      "supports": [
        "symptoms[0]",
        "negative_findings[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No. I've not fainted.",
      "start_timestamp": "01:10",
      "end_timestamp": "01:13",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any chest pain or palpitations?",
      "start_timestamp": "01:15",
      "end_timestamp": "01:18",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No.",
      "start_timestamp": "01:21",
      "end_timestamp": "01:22",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any falls?",
      "start_timestamp": "01:24",
      "end_timestamp": "01:25",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "She had a near fall last Tuesday. I caught her.",
      "start_timestamp": "01:26",
      "end_timestamp": "01:32",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What tablets does she take?",
      "start_timestamp": "01:35",
      "end_timestamp": "01:38",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Amlodipine, 10 mg, once a day, and a water tablet, bendroflumethiazide, 2.5 mg, in the morning.",
      "start_timestamp": "01:39",
      "end_timestamp": "01:49",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any allergies?",
      "start_timestamp": "01:49",
      "end_timestamp": "01:51",
      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "No, none.",
      "start_timestamp": "01:54",
      "end_timestamp": "01:55",
      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any other conditions?",
      "start_timestamp": "01:57",
      "end_timestamp": "02:00",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Just high blood pressure. And her hips are bad.",
      "start_timestamp": "02:03",
      "end_timestamp": "02:08",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is she eating and drinking enough?",
      "start_timestamp": "02:10",
      "end_timestamp": "02:14",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "She's not drinking much, and she's eating less. Her appetite has gone.",
      "start_timestamp": "02:16",
      "end_timestamp": "02:24",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Sitting, 142 over 80, pulse 70. Now standing, 108 over 62, pulse 82.",
      "start_timestamp": "03:48",
      "end_timestamp": "03:56",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes, a drop of more than 30 points on standing. That fits her symptoms. I'd say this is postural hypotension, likely from the blood pressure tablets together with not drinking enough.",
      "start_timestamp": "04:03",
      "end_timestamp": "04:19",
      "supports": [
        "clinical_assessment[0]",
        "clinical_assessment[1]"
      ]
    },
    {
      "evidence_id": "EV_024",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes. I'd like to stop the water tablet, bendroflumethiazide, and keep the amlodipine for now, but at 5 mg.",
      "start_timestamp": "04:26",
      "end_timestamp": "04:37",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_025",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And please encourage her to drink at least six glasses of fluid a day, and to sit on the bed for a minute before standing.",
      "start_timestamp": "04:42",
      "end_timestamp": "04:55",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_026",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to see her again in two weeks, to recheck her pressure. If she faints, falls, or has chest pain, call 999.",
      "start_timestamp": "05:02",
      "end_timestamp": "05:14",
      "supports": [
        "clinical_actions[0]",
