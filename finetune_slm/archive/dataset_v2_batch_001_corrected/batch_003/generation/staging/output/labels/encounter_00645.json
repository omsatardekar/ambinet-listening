  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Doctor, I have pain in my chest, since about one hour. Please, I am very scared.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:08",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Okay, I'm here. Let's take this step by step. Where is the pain, exactly?",
      "start_timestamp": "00:09",
      "end_timestamp": "00:18",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Here, in the middle. It is like a pressure, or someone sitting on me.",
      "start_timestamp": "00:20",
      "end_timestamp": "00:29",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Does it go anywhere, to the arm, the jaw, your back?",
      "start_timestamp": "00:30",
      "end_timestamp": "00:37",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, no. It stays in the middle. Not the arm.",
      "start_timestamp": "00:40",
      "end_timestamp": "00:46",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A little breathless, no, not really. Not so much. Just the pressure and my heart is going fast.",
      "start_timestamp": "00:51",
      "end_timestamp": "01:00",
      "supports": [
        "symptoms[1]",
        "symptoms[3]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your heart racing, you mean?",
      "start_timestamp": "01:01",
      "end_timestamp": "01:04",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, like drumming. And I am sweating, look, my shirt is wet.",
      "start_timestamp": "01:06",
      "end_timestamp": "01:13",
      "supports": [
        "symptoms[1]",
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I can see that. Doctor to patient, I have to ask something honestly, and I'm not here to judge. Have you taken any drugs or anything unusual today?",
      "start_timestamp": "01:13",
      "end_timestamp": "01:27",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes. Cocaine. I took cocaine about one hour before this started. I am sorry, doctor.",
      "start_timestamp": "01:29",
      "end_timestamp": "01:37",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Understood. Any vomiting or feeling sick?",
      "start_timestamp": "02:00",
      "end_timestamp": "02:03",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No vomiting. Only a little sick feeling, no, none.",
      "start_timestamp": "02:06",
      "end_timestamp": "02:12",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And have you any medical conditions, or take any regular medicines?",
      "start_timestamp": "02:14",
      "end_timestamp": "02:20",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I have asthma, and I use the salbutamol inhaler, only when needed.",
      "start_timestamp": "02:21",
      "end_timestamp": "02:27",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any operations?",
      "start_timestamp": "02:29",
      "end_timestamp": "02:31",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I had my appendix removed, as a child.",
      "start_timestamp": "02:34",
      "end_timestamp": "02:39",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 118, blood pressure 152 over 94, oxygen 98 percent.",
      "start_timestamp": "03:05",
      "end_timestamp": "03:11",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your heart is going fast and your pressure is up, which fits what cocaine does. I'm going to listen to your chest too.",
      "start_timestamp": "03:18",
      "end_timestamp": "03:32",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your chest is clear and your skin is damp and clammy.",
      "start_timestamp": "03:49",
      "end_timestamp": "03:55",
      "supports": [
        "physical_examination[0]",
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I can't tell yet. The chest pain you describe, after cocaine, may well be cocaine-related, but I don't want to assume.",
      "start_timestamp": "04:02",
      "end_timestamp": "04:12",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to do an ECG right now, to look at your heart's electrical tracing.",
      "start_timestamp": "04:18",
      "end_timestamp": "04:27",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'm also going to order a troponin blood test, which shows heart muscle damage, and we'll repeat it after a few hours.",
      "start_timestamp": "04:32",
      "end_timestamp": "04:42",
      "supports": [
        "procedures_and_investigations[1]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And I'll get a chest X-ray to look at your lungs and the size of your heart.",
      "start_timestamp": "04:49",
      "end_timestamp": "04:58",
      "supports": [
        "procedures_and_investigations[2]",
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_024",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "The team will look after you while we find out what's going on. Stay on the monitor, and tell the nurse straight away if the pain gets worse.",
      "start_timestamp": "05:06",
      "end_timestamp": "05:23",
      "supports": [
        "clinical_actions[3]"
      ]
