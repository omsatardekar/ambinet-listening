  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_4",
      "speaker_role": "clinical_staff",
      "transcript_text": "22 kilos, doctor will have it in the notes.",
      "start_timestamp": "00:19",
