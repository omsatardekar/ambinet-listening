  "clinical_uncertainties": [],
  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Doctor, I am not able to put the drops properly. Half goes on my cheek, half goes on my saree, and I am sure nothing goes in the eye.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:16",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Exactly like that. And my right eye has also started watering a lot, ever since I started struggling with this.",
      "start_timestamp": "01:02",
      "end_timestamp": "01:12",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long has the watering been going on?",
      "start_timestamp": "01:13",
      "end_timestamp": "01:18",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Ten days, I think. Yes, ten days, because it began just before my sister's housewarming and she said, why are you crying at my party.",
      "start_timestamp": "01:19",
      "end_timestamp": "01:32",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Ha. Is it only watering, or does it also hurt? Any pain in the eye?",
      "start_timestamp": "01:33",
      "end_timestamp": "01:40",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No pain, no. Only watering, that is all, but it is very irritating.",
      "start_timestamp": "01:41",
      "end_timestamp": "01:48",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And has the sight changed at all, any change in your vision, blurring or anything?",
      "start_timestamp": "01:49",
      "end_timestamp": "01:56",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, vision is the same as always. I can still thread a needle, that is my test.",
      "start_timestamp": "01:58",
      "end_timestamp": "02:06",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, I stitch blouses at home for the ladies in our colony. Forty blouses before Diwali, last year, I did. So my eyes are very important to me.",
      "start_timestamp": "02:13",
      "end_timestamp": "02:29",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I can see that. And you have glaucoma, if I read your file correctly. How long has it been?",
      "start_timestamp": "02:30",
      "end_timestamp": "02:40",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Two years now. The earlier doctor told me, pressure in the eye can damage the nerve silently, so I must be regular.",
      "start_timestamp": "02:42",
      "end_timestamp": "02:52",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That works for some people, but you don't need a husband. Think of your lower eyelid as a little pocket. Put your finger just under the eye and gently pull the skin down, so the pocket opens.",
      "start_timestamp": "03:22",
      "end_timestamp": "03:44",
      "supports": [
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Not a secret. It is like putting your thumb over a tap, it stops the drop draining away down the little channel into the nose, so it stays in the eye longer and does its work.",
      "start_timestamp": "05:16",
      "end_timestamp": "05:37",
      "supports": [
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes, I'd like to see you in three weeks. Bring the bottle, and I'll watch you put one in on your own.",
      "start_timestamp": "07:02",
      "end_timestamp": "07:15",
      "supports": [
        "clinical_actions[1]",
        "follow_up[0]"
      ]
    }
