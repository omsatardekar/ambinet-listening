  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hello. I'm here for the results of my cholesterol thing, I think. Or is it a new thing? I've forgotten what I booked.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:12",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It's the follow-up for the cholesterol, yes. Three months ago we started a statin. How have you got on?",
      "start_timestamp": "00:13",
      "end_timestamp": "00:23",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Oh, the tablets, yes. The little white one at bedtime. Atorvastatin, 40 mg, once a day.",
      "start_timestamp": "00:24",
      "end_timestamp": "00:33",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And how are you feeling in yourself on it?",
      "start_timestamp": "00:34",
      "end_timestamp": "00:40",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Well, my legs ache. Both thighs, mostly, since about the second week. Like I've run a marathon.",
      "start_timestamp": "00:42",
      "end_timestamp": "00:53",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is the ache constant or does it come and go?",
      "start_timestamp": "00:55",
      "end_timestamp": "01:02",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It's there most days, worse on the stairs. And I'm tired, tired all the time, I've been dragging.",
      "start_timestamp": "01:04",
      "end_timestamp": "01:15",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any headaches or stomach trouble?",
      "start_timestamp": "01:18",
      "end_timestamp": "01:21",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A few headaches, yes, in the afternoon. Nothing terrible.",
      "start_timestamp": "01:24",
      "end_timestamp": "01:30",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any dark urine, or muscle weakness, difficulty getting out of a chair?",
      "start_timestamp": "01:32",
      "end_timestamp": "01:39",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, nothing like that. The urine's normal.",
      "start_timestamp": "01:41",
      "end_timestamp": "01:45",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you take anything else?",
      "start_timestamp": "01:47",
      "end_timestamp": "01:50",
      "supports": [
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Aspirin, 75 mg, once a day. I thought I'd mentioned.",
