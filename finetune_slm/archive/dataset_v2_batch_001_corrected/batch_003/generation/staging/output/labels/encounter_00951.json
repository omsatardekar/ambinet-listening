  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hi, doctor. Thanks for fitting me in. I've got a pain in my left Achilles tendon, and it's been bugging me.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:12",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Tell me about it. Where exactly?",
      "start_timestamp": "00:14",
      "end_timestamp": "00:17",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "About two inches above the heel, at the back. It's sore when I go for a run, especially the first few minutes.",
      "start_timestamp": "00:20",
      "end_timestamp": "00:33",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Did you feel a pop or a sudden snap at any point?",
      "start_timestamp": "01:14",
      "end_timestamp": "01:20",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No pop. Nothing sudden. It built up slowly.",
      "start_timestamp": "01:22",
      "end_timestamp": "01:27",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long has it been building up?",
      "start_timestamp": "01:29",
      "end_timestamp": "01:33",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "About six weeks, I'd say.",
      "start_timestamp": "01:35",
      "end_timestamp": "01:39",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "There's tenderness about two inches above the heel, right over the tendon.",
      "start_timestamp": "02:22",
      "end_timestamp": "02:29",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And the tendon feels thickened there, compared with the right one.",
      "start_timestamp": "02:37",
      "end_timestamp": "02:42",
      "supports": [
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any problem with the other leg, or any numbness, anything like that?",
      "start_timestamp": "02:48",
      "end_timestamp": "02:55",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, nothing like that. It's only that heel.",
      "start_timestamp": "02:56",
      "end_timestamp": "03:02",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let me explain what I think is going on. The tendon has been overloaded and has become irritated and thickened. I think this looks like Achilles tendinopathy.",
      "start_timestamp": "03:03",
      "end_timestamp": "03:17",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to start naproxen, 250 mg, twice a day with food, for one week.",
      "start_timestamp": "03:43",
      "end_timestamp": "03:52",
      "supports": [
        "medications[0]",
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd cut your running by half and avoid hills and speed work for now.",
      "start_timestamp": "04:01",
      "end_timestamp": "04:10",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd also like to arrange an ultrasound of the Achilles tendon, and I'll refer you to physiotherapy for a loading programme.",
      "start_timestamp": "04:17",
      "end_timestamp": "04:29",
      "supports": [
        "procedures_and_investigations[0]",
        "procedures_and_investigations[1]",
        "clinical_actions[0]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do the calf stretches that the physio shows you, and avoid stretching the tendon hard until then.",
      "start_timestamp": "04:49",
      "end_timestamp": "04:57",
      "supports": [
        "clinical_actions[4]"
      ]
    }
