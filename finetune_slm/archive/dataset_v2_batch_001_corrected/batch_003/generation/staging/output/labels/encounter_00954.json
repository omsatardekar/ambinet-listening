  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hi, thank you for seeing me. I hit my head two days ago, and I've had a headache since, and I wanted to make sure it's nothing serious.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:17",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Did you lose consciousness?",
      "start_timestamp": "00:45",
      "end_timestamp": "00:48",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, I don't think so. I was dazed for a minute, but I remember everything, including the ambulance guy asking my name.",
      "start_timestamp": "00:50",
      "end_timestamp": "01:01",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. Tell me about the headache.",
      "start_timestamp": "01:04",
      "end_timestamp": "01:07",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It's a dull ache, all across the back and the right side. Worse in the afternoon. It started the same evening.",
      "start_timestamp": "01:09",
      "end_timestamp": "01:21",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any nausea?",
      "start_timestamp": "01:24",
      "end_timestamp": "01:26",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A bit queasy, mostly the first day. Still a little today.",
      "start_timestamp": "01:27",
      "end_timestamp": "01:33",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good thinking. Do you have any health conditions?",
      "start_timestamp": "02:04",
      "end_timestamp": "02:09",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Migraines, since college. And high blood pressure, but it's controlled with exercise.",
      "start_timestamp": "02:10",
      "end_timestamp": "02:16",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What do you do for work?",
      "start_timestamp": "02:19",
      "end_timestamp": "02:22",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I'm a construction foreman. Mostly on sites, rarely on ladders, which is the irony.",
      "start_timestamp": "02:23",
      "end_timestamp": "02:30",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let me take your numbers. Blood pressure 128 over 80, pulse 68, and oxygen 98 percent.",
      "start_timestamp": "02:41",
      "end_timestamp": "02:49",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "There's a bruise and a tender swelling on the right side at the back of your head, about the size of an egg.",
      "start_timestamp": "03:20",
      "end_timestamp": "03:32",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your pupils are equal and react to light, and your eye movements are normal.",
      "start_timestamp": "03:59",
      "end_timestamp": "04:07",
      "supports": [
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It's steady enough. Your balance is normal.",
      "start_timestamp": "04:40",
      "end_timestamp": "04:44",
      "supports": [
        "physical_examination[2]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any weakness, numbness, or trouble speaking since the fall?",
      "start_timestamp": "04:49",
      "end_timestamp": "04:54",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, nothing like that. My speech is normal, and my arms and legs feel fine.",
      "start_timestamp": "04:56",
      "end_timestamp": "05:05",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Here's what I think. This looks like a concussion, but with a head injury like this, I can't rule out a small bleed inside the head.",
      "start_timestamp": "05:06",
      "end_timestamp": "05:22",
      "supports": [
        "clinical_assessment[0]",
        "clinical_assessment[1]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It's unlikely, but I'd rather be safe. I'd like to arrange a CT scan of your head today.",
      "start_timestamp": "05:29",
      "end_timestamp": "05:38",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "The scan takes minutes, the wait is longer. I'd also like to start paracetamol, 1 gram, every six hours, for the headache.",
      "start_timestamp": "05:47",
      "end_timestamp": "06:00",
      "supports": [
        "medications[0]",
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Avoid ibuprofen for now. And rest, no work, no screens for a day or two.",
      "start_timestamp": "06:05",
      "end_timestamp": "06:13",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If the headache gets worse, you vomit, or you feel confused or very drowsy, come back to the emergency department immediately.",
      "start_timestamp": "06:19",
      "end_timestamp": "06:31",
      "supports": [
        "clinical_actions[1]",
        "follow_up[0]"
      ]
    }
