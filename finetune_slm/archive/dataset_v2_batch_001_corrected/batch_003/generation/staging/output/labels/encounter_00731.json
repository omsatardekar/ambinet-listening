  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Morning. Spring's started and my eyes are streaming, itching, the lot. I want my usual sorted before it gets bad, so can we go through it quickly?",
      "start_timestamp": "00:02",
      "end_timestamp": "00:16",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Of course. Tell me what you're using at the moment.",
      "start_timestamp": "00:19",
      "end_timestamp": "00:25",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]",
        "medications[3]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Olopatadine eye drops, twice a day. Cetirizine, 10 mg, once a day. Fluticasone nasal spray, two sprays once a day. And montelukast, 10 mg, maybe? At night? I take it for the asthma.",
      "start_timestamp": "00:27",
      "end_timestamp": "00:45",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]",
        "medications[3]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And is the montelukast 10 mg? You said maybe.",
      "start_timestamp": "00:50",
      "end_timestamp": "00:54",
      "supports": [
        "medications[3]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It's 10, I'm fairly sure. It might be 5. I'd have to check the box.",
      "start_timestamp": "00:58",
      "end_timestamp": "01:06",
      "supports": [
        "medications[3]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Sensible. And your wider health, what do you have on the record?",
      "start_timestamp": "01:52",
      "end_timestamp": "01:59",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hay fever, obviously, asthma, since I was a child, and eczema. Classic trio.",
      "start_timestamp": "02:02",
      "end_timestamp": "02:09",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any operations?",
      "start_timestamp": "02:13",
      "end_timestamp": "02:14",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A squint operation, when I was four.",
      "start_timestamp": "02:18",
      "end_timestamp": "02:22",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. Here's what I suggest, given the season. Start the nasal spray now, every day, rather than occasionally, because it works by building up.",
      "start_timestamp": "02:45",
      "end_timestamp": "02:57",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And start the cetirizine and the eye drops a week before your worst weeks, if you can predict them.",
      "start_timestamp": "03:06",
      "end_timestamp": "03:18",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Then start in early May. Keep windows closed in the morning, shower when you get in, and wipe your eyes with a cool damp cloth.",
      "start_timestamp": "03:27",
      "end_timestamp": "03:41",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to see you again in six weeks, to see how the season's going and check your asthma.",
      "start_timestamp": "04:10",
      "end_timestamp": "04:19",
