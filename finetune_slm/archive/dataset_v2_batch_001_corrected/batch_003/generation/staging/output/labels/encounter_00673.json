  "clinical_uncertainties": [],
  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Doctor, I need help, now. It's my back, my right side. I can't stay still, I'm pacing, I can't sit.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:13",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I can see how uncomfortable you are. Let's get you sorted. When did it start?",
      "start_timestamp": "00:15",
      "end_timestamp": "00:23",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "About two hours ago. Came out of nowhere. It comes in waves, then I think it's gone, and then it's worse.",
      "start_timestamp": "00:26",
      "end_timestamp": "00:39",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Where does it go?",
      "start_timestamp": "00:40",
      "end_timestamp": "00:43",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "From the back round to the front, down towards my groin. It's the worst pain of my life, honestly. I'd say it's severe.",
      "start_timestamp": "00:44",
      "end_timestamp": "00:55",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you had this before?",
      "start_timestamp": "00:58",
      "end_timestamp": "01:02",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, I've had stones. One, two years ago, and they blasted it with a lithotripsy, I think that's the word.",
      "start_timestamp": "01:03",
      "end_timestamp": "01:16",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That helps. Have you been feeling feverish?",
      "start_timestamp": "01:18",
      "end_timestamp": "01:23",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No fever. No shivers. Nothing like that.",
      "start_timestamp": "01:24",
      "end_timestamp": "01:28",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you have any allergies to medicines?",
      "start_timestamp": "01:30",
      "end_timestamp": "01:34",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Penicillin, I come out in a rash. Doctor, please, can I have something for the pain?",
      "start_timestamp": "01:36",
      "end_timestamp": "01:46",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 98, blood pressure 156 over 92, temperature 36.9, oxygen 99 percent, breathing 18.",
      "start_timestamp": "02:21",
      "end_timestamp": "02:28",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Very tender over the right loin, but your tummy is soft, with no guarding.",
      "start_timestamp": "02:53",
      "end_timestamp": "03:01",
      "supports": [
        "physical_examination[0]",
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Judging by the pain, how it comes in waves and goes to the groin, and your history, this looks most like a kidney stone.",
      "start_timestamp": "03:07",
      "end_timestamp": "03:21",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'm going to give you diclofenac, 75 mg, by injection, now, for kidney stone pain. It acts quickly.",
      "start_timestamp": "03:29",
      "end_timestamp": "03:37",
      "supports": [
        "medications[0]",
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "A small jab in the thigh, that's all. Nurse will help. And I'd like to arrange a CT scan of your kidneys and bladder, to see the stone's size and where it sits.",
      "start_timestamp": "03:44",
      "end_timestamp": "04:01",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes, I want to rule out a blockage. And a urine test too, to check for infection and blood.",
      "start_timestamp": "04:09",
      "end_timestamp": "04:19",
      "supports": [
        "procedures_and_investigations[1]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Drink plenty of water, and we'll strain your urine to catch the stone, in case we can analyse it.",
      "start_timestamp": "04:27",
      "end_timestamp": "04:38",
      "supports": [
        "clinical_actions[4]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It helps to know what type it is. If the pain isn't controlled within an hour, or you develop a fever, tell the nurse straight away and we'll review you.",
      "start_timestamp": "04:46",
      "end_timestamp": "05:01",
      "supports": [
        "clinical_actions[2]",
        "follow_up[0]"
      ]
    }
