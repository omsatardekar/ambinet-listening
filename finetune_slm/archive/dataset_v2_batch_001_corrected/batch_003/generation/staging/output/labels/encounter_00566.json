  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Honestly? It's my left foot, and it's probably nothing. My daughter nagged me into coming.",
      "start_timestamp": "00:32",
      "end_timestamp": "00:40",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good for you. Now, a few questions about the nerves. Do you have any weakness in the leg?",
      "start_timestamp": "01:04",
      "end_timestamp": "01:15",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No weakness. It has never given way on me or anything.",
      "start_timestamp": "01:17",
