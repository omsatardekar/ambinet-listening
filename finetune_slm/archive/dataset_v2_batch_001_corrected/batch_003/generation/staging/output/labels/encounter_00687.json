  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hello, doctor, I got this letter about my eyes, the screening, the photos, and I've brought it but I can't find my glasses, so I can't read it.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:15",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "No problem, I've got the result on screen. The screening shows early changes at the back of your eyes from the diabetes.",
      "start_timestamp": "00:17",
      "end_timestamp": "00:29",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "No, not at all. It's the earliest stage, called background retinopathy. Tiny changes in the small blood vessels, and your vision isn't affected yet.",
      "start_timestamp": "00:38",
      "end_timestamp": "00:50",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Right. Well, I do get blurry some days.",
      "start_timestamp": "00:52",
      "end_timestamp": "00:57",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Tell me about the blurriness.",
      "start_timestamp": "00:58",
      "end_timestamp": "01:01",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Mostly the afternoon, when I've been at the computer. Things go fuzzy for a bit, then clear up.",
      "start_timestamp": "01:04",
      "end_timestamp": "01:14",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any floaters, or flashing lights?",
      "start_timestamp": "01:16",
      "end_timestamp": "01:20",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No flashing. A few floaters, I think, but they've been there for years.",
      "start_timestamp": "01:21",
      "end_timestamp": "01:29",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any pain in your eyes, or loss of part of your vision?",
      "start_timestamp": "01:31",
      "end_timestamp": "01:38",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, no pain. No loss, nothing like that.",
      "start_timestamp": "01:39",
      "end_timestamp": "01:44",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Now the diabetes treatment. What are you taking for it?",
      "start_timestamp": "01:46",
      "end_timestamp": "01:51",
      "supports": [
        "medications[0]",
        "clinical_uncertainties[0]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Metformin. 1000 mg, twice a day, I think. I'm honestly not sure of the dose, my wife organises it. And if I'm honest, I miss the evening one a lot.",
      "start_timestamp": "01:53",
      "end_timestamp": "02:09",
      "supports": [
        "medications[0]",
        "clinical_uncertainties[0]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "So the plan is twice a day, 1000 mg as you recall it, but some evenings it's missed. That's honest, thank you.",
      "start_timestamp": "02:10",
      "end_timestamp": "02:20",
      "supports": [
        "medications[0]",
        "clinical_uncertainties[0]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "No row. It's the control that matters, so we'll try to make it easier. Any allergies I should know about?",
      "start_timestamp": "02:31",
      "end_timestamp": "02:42",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Sulfa drugs, but only as a child. I came out in a rash, and I've never had one since. They told my mum to keep me away from them.",
      "start_timestamp": "02:44",
      "end_timestamp": "02:59",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 78, blood pressure 136 over 84.",
      "start_timestamp": "03:23",
      "end_timestamp": "03:27",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to arrange an HbA1c blood test, to see how your sugar has averaged over the last three months.",
      "start_timestamp": "03:48",
      "end_timestamp": "04:00",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
