  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Mr Gilligan, thanks for coming. The booking says a review of your tablets, because of the nosebleeds.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:10",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let's go through your tablets, one by one.",
      "start_timestamp": "00:21",
      "end_timestamp": "00:25",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]",
        "medications[3]",
        "medications[4]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Apixaban, 5 mg, twice a day. Bisoprolol, 5 mg, once a day. Ramipril, 5 mg, once a day. Atorvastatin, 40 mg, at night. And omeprazole, 20 mg, in the morning.",
      "start_timestamp": "00:27",
      "end_timestamp": "00:46",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]",
        "medications[3]",
        "medications[4]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's an excellent system. Any health conditions that go with them?",
      "start_timestamp": "01:04",
      "end_timestamp": "01:11",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "The heart rhythm thing, atrial fibrillation. And high blood pressure.",
      "start_timestamp": "01:12",
      "end_timestamp": "01:19",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let me check you. Pulse 64, blood pressure 130 over 76, temperature 36.6, oxygen 98 percent, breathing 14, weight 85 kilos.",
      "start_timestamp": "01:35",
      "end_timestamp": "01:46",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]",
        "vital_signs[5]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any dizzy spells, Mr Gilligan?",
      "start_timestamp": "02:08",
      "end_timestamp": "02:11",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, no dizziness at all.",
      "start_timestamp": "02:14",
      "end_timestamp": "02:17",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Keep the inside of the nose moist. A small amount of petroleum jelly, just inside each nostril, twice a day.",
      "start_timestamp": "03:12",
      "end_timestamp": "03:22",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "A saline spray works as well. And avoid picking and forceful nose blowing.",
      "start_timestamp": "03:30",
      "end_timestamp": "03:37",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "When a nosebleed does come, sit up, lean forward, pinch the soft part of your nose for ten minutes, and breathe through your mouth.",
      "start_timestamp": "03:54",
      "end_timestamp": "04:07",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If a nosebleed lasts more than twenty minutes, go straight to the emergency department.",
      "start_timestamp": "04:40",
      "end_timestamp": "04:48",
      "supports": [
        "clinical_actions[0]",
        "follow_up[0]"
      ]
    }
