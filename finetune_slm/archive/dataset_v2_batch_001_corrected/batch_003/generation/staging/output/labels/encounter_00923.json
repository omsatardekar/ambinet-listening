  "clinical_uncertainties": [],
  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I can't sleep, and my head won't stop racing about work. I'm exhausted, and I came in because I didn't know where else to go at this hour.",
      "start_timestamp": "00:03",
      "end_timestamp": "00:16",
      "supports": [
        "chief_complaint",
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'm glad you did. Let's sort this out together. How long has the sleep been bad?",
      "start_timestamp": "00:19",
      "end_timestamp": "00:28",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "About three weeks. I lie awake until four in the morning.",
      "start_timestamp": "00:31",
      "end_timestamp": "00:37",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What is the worry about?",
      "start_timestamp": "00:41",
      "end_timestamp": "00:44",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A big project at work, and I've been told there may be redundancies. I can't switch off.",
      "start_timestamp": "00:48",
      "end_timestamp": "00:58",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you had any thoughts of harming yourself?",
      "start_timestamp": "01:01",
      "end_timestamp": "01:06",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No. Nothing like that. I just need sleep.",
      "start_timestamp": "01:10",
      "end_timestamp": "01:15",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good, thank you for telling me. Any panic attacks or chest pain?",
      "start_timestamp": "01:19",
      "end_timestamp": "01:25",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No panic attacks. No chest pain.",
      "start_timestamp": "01:28",
      "end_timestamp": "01:31",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_3",
      "speaker_role": "nurse",
      "transcript_text": "Doctor, I've done his observations. Pulse 88, blood pressure 134 over 86, temperature 36.6, oxygen 99 percent, breathing 16.",
      "start_timestamp": "01:35",
      "end_timestamp": "01:45",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you. Those are fine, a little up from stress. Do you drink alcohol or coffee?",
      "start_timestamp": "01:49",
      "end_timestamp": "01:59",
      "supports": [
        "medical_history.social_history[0]",
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A glass or two of wine to wind down. And plenty of coffee, I'm afraid.",
      "start_timestamp": "02:02",
      "end_timestamp": "02:10",
      "supports": [
        "medical_history.social_history[0]",
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How much coffee?",
      "start_timestamp": "02:13",
      "end_timestamp": "02:15",
      "supports": [
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Six cups a day.",
      "start_timestamp": "02:19",
      "end_timestamp": "02:21",
      "supports": [
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That will be affecting your sleep. Any medical problems?",
      "start_timestamp": "02:25",
      "end_timestamp": "02:30",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Just mild asthma.",
      "start_timestamp": "02:33",
      "end_timestamp": "02:35",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to avoid sleeping tablets as a first step. Cut the coffee to two cups, none after noon, and swap the wine for a non-alcoholic wind-down.",
      "start_timestamp": "03:21",
      "end_timestamp": "03:35",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I know. I'd also like to give you a short course of a mild sleeping tablet, zopiclone, 3.75 mg, at night for five nights.",
      "start_timestamp": "03:47",
      "end_timestamp": "04:01",
      "supports": [
        "medications[0]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Not in five nights, but we keep it short on purpose. Don't drive the next morning if you feel drowsy.",
      "start_timestamp": "04:11",
      "end_timestamp": "04:23",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd also like you to book a review with your own GP this week, to talk about the work stress and plan the next steps.",
      "start_timestamp": "04:33",
      "end_timestamp": "04:45",
      "supports": [
        "clinical_actions[0]",
        "follow_up[0]"
      ]
    }
