  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Doctor, the tablets are not working. Still the room is spinning every time I turn in bed. I have not slept properly for days.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:13",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "About five weeks back. First I thought it was because of the heat, or low sugar, so I ate something and lay down, but it came again.",
      "start_timestamp": "00:51",
      "end_timestamp": "01:03",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Every morning, when I turn on my side to get up. Sometimes also at night. Mostly when I turn to the right.",
      "start_timestamp": "01:11",
      "end_timestamp": "01:23",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Looking up at the shelf in the kitchen. Yesterday I looked up for the salt box and I had to catch the counter.",
      "start_timestamp": "01:39",
      "end_timestamp": "01:49",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Closing my eyes helps, and keeping still. That is all. Doctor, I saw a video on WhatsApp saying such things are from a brain tumour. Is it so?",
      "start_timestamp": "01:57",
      "end_timestamp": "02:12",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any vomiting with the spinning?",
      "start_timestamp": "02:35",
      "end_timestamp": "02:38",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No vomiting, only a little uneasy feeling in the stomach, and that passes.",
      "start_timestamp": "02:40",
      "end_timestamp": "02:47",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any ringing in your ears?",
      "start_timestamp": "02:48",
      "end_timestamp": "02:51",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, no ringing. My hearing is the same as always, my husband still says I don't listen, ha ha.",
      "start_timestamp": "02:52",
      "end_timestamp": "03:02",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Ha, that's a universal complaint. Now, you came to see the other doctor two weeks ago, and he started something. What are you taking?",
      "start_timestamp": "03:03",
      "end_timestamp": "03:15",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Betahistine, 16 mg, three times a day. He said it is for the dizziness.",
      "start_timestamp": "03:18",
      "end_timestamp": "03:26",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I get migraines sometimes, not often, maybe four times a year. And neck problem, cervical spondylosis, the X-ray was done long back, but I take no tablets for it.",
      "start_timestamp": "04:48",
      "end_timestamp": "05:03",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Blood pressure is 128 over 80, and your pulse is 74 beats per minute.",
      "start_timestamp": "05:27",
      "end_timestamp": "05:35",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I don't want to guess yet. What I'd like is to arrange a hearing and balance test, called audiometry, so we can see how the ears and balance system are working.",
      "start_timestamp": "06:01",
      "end_timestamp": "06:15",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Three simple things. Sit at the edge of the bed for a minute before you stand. Turn slowly rather than jerking over. And put a night light on the way to the bathroom.",
      "start_timestamp": "06:50",
      "end_timestamp": "07:07",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Ha, a simple fix. I'd like to see you again in three weeks, once the test is done, and we can look at everything together.",
      "start_timestamp": "07:45",
      "end_timestamp": "07:56",
      "supports": [
        "clinical_actions[3]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If you notice weakness in an arm or leg, trouble speaking, double vision or a severe headache, go to the emergency department straight away. Otherwise, continue as you are.",
      "start_timestamp": "08:05",
      "end_timestamp": "08:20",
      "supports": [
        "clinical_actions[2]"
      ]
    }
