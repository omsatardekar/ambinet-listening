  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I wanted to talk about my eating. I've been restricting a lot, and my friend said I should speak to someone.",
      "start_timestamp": "00:02",
      "end_timestamp": "00:12",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you for telling us. That took courage. Can you tell me what restricting looks like for you?",
      "start_timestamp": "00:16",
      "end_timestamp": "00:25",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I skip breakfast and lunch most days, and I only have a small dinner. I count everything.",
      "start_timestamp": "00:29",
      "end_timestamp": "00:37",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long has it been like this?",
      "start_timestamp": "00:40",
      "end_timestamp": "00:45",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "About one year. It got worse after exams last summer.",
      "start_timestamp": "00:48",
      "end_timestamp": "00:54",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you been making yourself sick, or using laxatives?",
      "start_timestamp": "00:59",
      "end_timestamp": "01:04",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No. Never. I just don't eat.",
      "start_timestamp": "01:07",
      "end_timestamp": "01:11",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you for being honest. Are you on any medicines?",
      "start_timestamp": "01:34",
      "end_timestamp": "01:39",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Just the contraceptive pill, I think it's Microgynon, but I'm not sure.",
      "start_timestamp": "01:43",
      "end_timestamp": "01:49",
      "supports": [
        "medications[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you. That's a low pulse, and a body mass index around seventeen.",
      "start_timestamp": "02:06",
      "end_timestamp": "02:14",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It's lower than I'd like. Your body is working hard to protect you. Have you had any dizziness or fainting?",
      "start_timestamp": "02:23",
      "end_timestamp": "02:33",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Dizzy when I stand up quickly. Never fainted.",
      "start_timestamp": "02:37",
      "end_timestamp": "02:43",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any past medical conditions?",
      "start_timestamp": "03:01",
      "end_timestamp": "03:04",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Asthma as a child. And anxiety, last year, but I was never treated.",
      "start_timestamp": "03:07",
      "end_timestamp": "03:14",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any operations?",
      "start_timestamp": "03:18",
      "end_timestamp": "03:20",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My tonsils, when I was nine.",
      "start_timestamp": "03:23",
      "end_timestamp": "03:27",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you drink alcohol or smoke?",
      "start_timestamp": "03:32",
      "end_timestamp": "03:36",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No. I never have.",
      "start_timestamp": "03:39",
      "end_timestamp": "03:42",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to be honest with you. What you describe sounds like an eating disorder, and I'd like to arrange a proper assessment.",
      "start_timestamp": "03:46",
      "end_timestamp": "03:58",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "We're not talking about that now. I'm going to refer you to the eating disorder team, and we'll run bloods and an ECG.",
      "start_timestamp": "04:11",
      "end_timestamp": "04:23",
      "supports": [
        "procedures_and_investigations[0]",
        "procedures_and_investigations[1]",
        "clinical_actions[0]",
        "clinical_actions[1]",
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And I'd like to see you again in one week, so we can check how you're managing.",
      "start_timestamp": "04:47",
      "end_timestamp": "04:57",
      "supports": [
