  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Doctor, I'll be direct, because I'm at the end of my rope. Walter has been up wandering the house at night, and I'm not sleeping.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:13",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'm sorry to hear it. Walter, what do you make of it?",
      "start_timestamp": "00:17",
      "end_timestamp": "00:23",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I get up for a stretch, that's all. It's been a week, one week, maybe.",
      "start_timestamp": "00:26",
      "end_timestamp": "00:34",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "It's three weeks, Walter. I've counted. The first night was the Thursday after his birthday.",
      "start_timestamp": "00:37",
      "end_timestamp": "00:45",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "So, one week from your side, three from Mrs Pearce's side. I'll write that down as one to three weeks. What does he do when he's up?",
      "start_timestamp": "00:48",
      "end_timestamp": "01:03",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "He goes to the front door and tries the handle. Or he goes into the kitchen and opens every cupboard.",
      "start_timestamp": "01:06",
      "end_timestamp": "01:19",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I'm looking for something. I forget what.",
      "start_timestamp": "01:22",
      "end_timestamp": "01:26",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Has he had any falls on his night walks?",
      "start_timestamp": "01:29",
      "end_timestamp": "01:34",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "No falls. He's steady, I always hear him and go down.",
      "start_timestamp": "01:35",
      "end_timestamp": "01:41",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is there anyone in the family with memory trouble?",
      "start_timestamp": "01:44",
      "end_timestamp": "01:49",
      "supports": [
        "medical_history.family_history[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "His mother had it, in her eighties. Walter's seventy-nine.",
      "start_timestamp": "01:52",
      "end_timestamp": "01:57",
      "supports": [
        "medical_history.family_history[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "He walks steadily, turns well, and doesn't need to hold on to anything.",
      "start_timestamp": "02:29",
      "end_timestamp": "02:35",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "A few practical things. Keep the house well lit at night, with a lamp in the hall and the bathroom, and keep a regular bedtime.",
      "start_timestamp": "03:02",
      "end_timestamp": "03:15",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Then a simple alarm on the front door, a bell or a chime, so you wake when he tries it. And lock away anything unsafe.",
      "start_timestamp": "03:27",
      "end_timestamp": "03:39",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Try keeping the naps short, and get some daylight and a walk in the morning.",
      "start_timestamp": "04:00",
      "end_timestamp": "04:08",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Mrs Pearce, you need support as well. I'm going to refer you both to the community team for older people, who can talk about respite and what's available.",
      "start_timestamp": "04:16",
      "end_timestamp": "04:32",
      "supports": [
        "clinical_actions[0]"
      ]
    }
