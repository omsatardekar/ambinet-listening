  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "nurse",
      "transcript_text": "Doctor, this is Mr Barnes, forty-six. Sudden hearing loss in the left ear since this morning and he's very dizzy. Obs are done.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:13",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I can't hear a thing out of this ear. And the room's spinning, I've been sick twice, I'm really scared.",
      "start_timestamp": "00:15",
      "end_timestamp": "00:27",
      "supports": [
        "symptoms[0]",
        "symptoms[1]",
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Mr Barnes, I'm Dr Ellis. I know you're frightened, we're going to look after you. When did it start?",
      "start_timestamp": "00:30",
      "end_timestamp": "00:41",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I woke up with it. About six this morning. Muffled, like cotton wool, and then it got worse, and now I hear nothing.",
      "start_timestamp": "00:43",
      "end_timestamp": "00:57",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any ringing or noise in the ear?",
      "start_timestamp": "00:59",
      "end_timestamp": "01:03",
      "supports": [
        "symptoms[3]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A loud hiss. Constant.",
      "start_timestamp": "01:05",
      "end_timestamp": "01:07",
      "supports": [
        "symptoms[3]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Has the spinning been constant?",
      "start_timestamp": "01:10",
      "end_timestamp": "01:13",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It comes and goes, but it's bad when I move my head.",
      "start_timestamp": "01:15",
      "end_timestamp": "01:21",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Did you bang your head, or have any injury?",
      "start_timestamp": "01:23",
      "end_timestamp": "01:29",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No. Nothing at all.",
      "start_timestamp": "01:30",
      "end_timestamp": "01:33",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any allergies to medicines?",
      "start_timestamp": "01:36",
      "end_timestamp": "01:38",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "None.",
      "start_timestamp": "01:40",
      "end_timestamp": "01:42",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you had any ear problems before, or other conditions?",
      "start_timestamp": "01:43",
      "end_timestamp": "01:49",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I had grommets as a child, in both ears. And migraines.",
      "start_timestamp": "01:52",
      "end_timestamp": "01:57",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What work do you do?",
      "start_timestamp": "02:00",
      "end_timestamp": "02:03",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I'm a piano tuner. My ears are my living.",
      "start_timestamp": "02:04",
      "end_timestamp": "02:09",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_3",
      "speaker_role": "nurse",
      "transcript_text": "Doctor, his observations. Blood pressure 138 over 86, pulse 90, temperature 36.8, oxygen 98 percent, respiratory rate 18.",
      "start_timestamp": "02:26",
      "end_timestamp": "02:36",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "They are, there's a little flick when you look to the left. And I'll test your hearing with a tuning fork.",
      "start_timestamp": "03:18",
      "end_timestamp": "03:30",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That fits. Your left ear is not hearing the tuning fork, and your eye movements show a flicker to one side, which fits an inner-ear problem.",
      "start_timestamp": "03:54",
      "end_timestamp": "04:07",
      "supports": [
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Sudden hearing loss with vertigo like this, in one ear, looks most like sudden sensorineural hearing loss, which needs urgent treatment, ideally within days.",
      "start_timestamp": "04:14",
      "end_timestamp": "04:26",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'm going to arrange an urgent hearing test, an audiogram, here, this morning.",
      "start_timestamp": "04:48",
      "end_timestamp": "04:55",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd also like to arrange an MRI scan of your ears and brain, to rule out other causes.",
      "start_timestamp": "05:03",
      "end_timestamp": "05:11",
      "supports": [
        "procedures_and_investigations[1]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It's very unlikely, but we check. And I'd like to take blood tests, to look for infection and other causes.",
      "start_timestamp": "05:17",
      "end_timestamp": "05:27",
      "supports": [
        "procedures_and_investigations[2]",
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_024",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "The ENT team will see you today and decide on treatment, and I'd like them to review you again in a few days.",
      "start_timestamp": "05:34",
      "end_timestamp": "05:47",
