  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Doctor, I'm Amrit's wife. A colleague told him his eyes look yellow, and I'm worried about it, so I made him come in.",
      "start_timestamp": "00:02",
      "end_timestamp": "00:16",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "You were right to come. Mr Dhillon, when did you or anyone first notice the yellow in your eyes?",
      "start_timestamp": "00:18",
      "end_timestamp": "00:29",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A colleague mentioned it on Monday, but I think it was there before. I wasn't looking.",
      "start_timestamp": "00:32",
      "end_timestamp": "00:42",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "I noticed his eyes were a bit yellow about two weeks ago, but I thought it was the lighting.",
      "start_timestamp": "00:44",
      "end_timestamp": "00:55",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "So somewhere between a few days and two weeks. Have you noticed dark urine or pale stools?",
      "start_timestamp": "00:58",
      "end_timestamp": "01:06",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "The urine has been dark, like tea. I didn't think about it.",
      "start_timestamp": "01:10",
      "end_timestamp": "01:16",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any itching, tummy pain or fever?",
      "start_timestamp": "01:19",
      "end_timestamp": "01:22",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No itching. No pain. No fever.",
      "start_timestamp": "01:25",
      "end_timestamp": "01:28",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "He's been very tired, though.",
      "start_timestamp": "01:30",
      "end_timestamp": "01:34",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How much alcohol do you drink, Mr Dhillon?",
      "start_timestamp": "01:37",
      "end_timestamp": "01:43",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A couple of whiskies on a Friday night, no more.",
      "start_timestamp": "01:46",
      "end_timestamp": "01:53",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Are you taking any regular medicines?",
      "start_timestamp": "01:56",
      "end_timestamp": "02:00",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Just the blood pressure tablet, amlodipine, 5 mg, once a day.",
      "start_timestamp": "02:03",
      "end_timestamp": "02:09",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes, please. Pulse, pressure, temperature, and we'll take blood for liver tests and a full blood count.",
      "start_timestamp": "02:24",
      "end_timestamp": "02:33",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_4",
      "speaker_role": "nurse",
      "transcript_text": "Pulse 78, blood pressure 130 over 82, temperature 36.8.",
      "start_timestamp": "03:01",
      "end_timestamp": "03:07",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "They're fine. What worries me is the yellow colour, and your dark urine, which could be a liver or bile duct problem.",
      "start_timestamp": "03:15",
      "end_timestamp": "03:26",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It can be, and that's why I want the blood tests today, and an ultrasound scan of your liver as soon as we can.",
      "start_timestamp": "03:35",
      "end_timestamp": "03:46",
      "supports": [
        "procedures_and_investigations[0]",
        "procedures_and_investigations[1]",
        "clinical_actions[0]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I understand. If your skin gets more yellow, you become feverish with pain, or you can't keep fluids down, go to the emergency department.",
      "start_timestamp": "04:31",
      "end_timestamp": "04:44",
      "supports": [
        "clinical_actions[2]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
