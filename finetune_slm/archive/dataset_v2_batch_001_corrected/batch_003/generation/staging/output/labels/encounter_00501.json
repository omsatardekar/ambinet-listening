  "clinical_uncertainties": [],
  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Better, honestly. Not gone, but better. I still get the racing heart, like my chest is a drum solo, maybe twice a week now instead of every day.",
      "start_timestamp": "00:31",
      "end_timestamp": "00:45",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Twice a week. And what's usually going on when it starts?",
      "start_timestamp": "00:48",
      "end_timestamp": "00:54",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Crowded subway cars are the worst. I took a different train all last month just to avoid the rush, which added forty minutes, and my husband said I was being ridiculous, but it worked.",
      "start_timestamp": "01:25",
      "end_timestamp": "01:40",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Ten minutes, give or take. Then I'm wiped out, like I ran a marathon. I teach fifth grade, so you can imagine how that goes when it happens at recess.",
      "start_timestamp": "01:49",
      "end_timestamp": "02:06",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "The sertraline, 50 milligrams, once a day in the morning. The propranolol, ten milligrams, only when I feel one coming on. And the lisinopril for my blood pressure, ten milligrams every morning.",
      "start_timestamp": "02:19",
      "end_timestamp": "02:34",
      "supports": [
        "medical_history.past_medical_history[1]",
        "medications[0]",
        "medications[1]",
        "medications[2]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. Any chest pain with the episodes, or have you passed out at all?",
      "start_timestamp": "02:36",
      "end_timestamp": "02:43",
      "supports": [
        "negative_findings[0]",
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No chest pain. And no fainting, I've never actually fainted, I just feel like the floor is tilting a little.",
      "start_timestamp": "02:46",
      "end_timestamp": "02:57",
      "supports": [
        "negative_findings[0]",
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Fine. Any other conditions I should have on file besides the blood pressure?",
      "start_timestamp": "02:59",
      "end_timestamp": "03:06",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Just the panic disorder, which you know about. My mother always says I get it from worrying, but I told her it's not that simple.",
      "start_timestamp": "03:08",
      "end_timestamp": "03:19",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Blood pressure is 126 over 78. Pulse is 72 and regular.",
      "start_timestamp": "03:46",
      "end_timestamp": "03:52",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's good. Oxygen saturation is 98 percent, breathing rate is 14 a minute, and your weight is 142 pounds.",
      "start_timestamp": "04:05",
      "end_timestamp": "04:15",
      "supports": [
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Heart sounds are normal, regular rhythm, and no murmur that I can hear. Lungs are clear.",
      "start_timestamp": "05:10",
      "end_timestamp": "05:18",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I understand that fear. Right now, this still looks most likely like panic attacks rather than a rhythm problem. But because you describe it so vividly, I'd like to be sure.",
      "start_timestamp": "05:30",
      "end_timestamp": "05:45",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Fair point. I'm going to arrange a twenty-four hour heart monitor so we catch an actual episode on tape, and I'd like to order a thyroid blood test, since an overactive thyroid can mimic this.",
      "start_timestamp": "06:03",
      "end_timestamp": "06:20",
      "supports": [
        "procedures_and_investigations[0]",
        "procedures_and_investigations[1]",
        "clinical_actions[0]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Not at all. Try slow breathing in those first couple of minutes, in for four, out for six. It actually works on the heart rate.",
      "start_timestamp": "07:30",
      "end_timestamp": "07:42",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's the idea. I'd like to see you again in six weeks, with the results in hand.",
      "start_timestamp": "07:54",
      "end_timestamp": "08:04",
      "supports": [
        "clinical_actions[3]",
        "follow_up[0]"
      ]
    }
