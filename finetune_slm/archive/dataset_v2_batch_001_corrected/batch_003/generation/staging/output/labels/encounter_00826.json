  "clinical_uncertainties": [],
  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Morning, doctor! It's my eye. The left one. It's been watering, nonstop, for about three weeks, and it's driving me up the wall. I'm forever dabbing it.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:14",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Tell me more about the watering. Is it worse at certain times?",
      "start_timestamp": "00:17",
      "end_timestamp": "00:25",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "In the wind, definitely. And when I'm reading. But even indoors, there's always a bit of a tear running down my cheek.",
      "start_timestamp": "00:26",
      "end_timestamp": "00:39",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is the eye red or painful?",
      "start_timestamp": "00:40",
      "end_timestamp": "00:44",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, no pain. It's not red, just wet. Honestly, I look like I'm crying.",
      "start_timestamp": "00:46",
      "end_timestamp": "00:52",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A cold, in the autumn. And I had my eye tested at the optician, and she said I had a bit of dryness, funnily enough.",
      "start_timestamp": "01:33",
      "end_timestamp": "01:47",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Interesting, that can cause watering. What do you do for work?",
      "start_timestamp": "01:48",
      "end_timestamp": "01:54",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I'm a taxi driver. Windows down in summer, a lot.",
      "start_timestamp": "01:56",
      "end_timestamp": "02:02",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 72, temperature 36.6.",
      "start_timestamp": "02:23",
      "end_timestamp": "02:26",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'm pressing gently on the corner of the eye by the nose. A little fluid comes out the wrong way, and the opening of the tear duct looks narrow.",
      "start_timestamp": "03:02",
      "end_timestamp": "03:19",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes, often with age, or after an infection. I'd say this is a partly blocked tear duct, but I can't rule out dryness of the surface, which also makes the eye water.",
      "start_timestamp": "03:46",
      "end_timestamp": "04:01",
      "supports": [
        "clinical_assessment[0]",
        "clinical_assessment[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "First, I'd like to arrange for you to see the eye clinic, where they can syringe the duct and check it.",
      "start_timestamp": "04:08",
      "end_timestamp": "04:19",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "A little uncomfortable, not painful. And in the meantime, massage the corner of the eye gently, downwards towards the nose, a few times a day.",
      "start_timestamp": "04:25",
      "end_timestamp": "04:38",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to see you again in four weeks. If it turns red, painful, or swollen at the corner, come back sooner.",
      "start_timestamp": "04:56",
      "end_timestamp": "05:08",
      "supports": [
        "clinical_actions[1]",
        "follow_up[0]"
      ]
    }
