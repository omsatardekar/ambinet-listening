  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Good morning. I've got my phone with the photos, if that helps. I'd like a proper review of my skincare regime, because the scarring is bothering me more than the new breakouts.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:18",
      "supports": [
        "chief_complaint"
