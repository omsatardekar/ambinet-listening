    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Please show me. While I look, tell me what you're using at the moment.",
      "start_timestamp": "00:20",
      "end_timestamp": "00:28",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]",
        "medications[3]",
        "medications[4]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Adapalene gel, once a day, at night. Benzoyl peroxide gel, in the morning. Lymecycline, 408 mg, once a day. Azelaic acid cream, twice a day. And a moisturiser, CeraVe, twice a day.",
      "start_timestamp": "00:31",
      "end_timestamp": "00:47",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]",
        "medications[3]",
        "medications[4]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's a thorough routine. Are you finding the combination irritating?",
      "start_timestamp": "00:48",
      "end_timestamp": "00:55",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No peeling, no stinging, which surprised me. The dryness is fine.",
      "start_timestamp": "00:57",
      "end_timestamp": "01:03",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And what's changed recently?",
      "start_timestamp": "01:05",
      "end_timestamp": "01:07",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "New spots, on the jawline. About three weeks of them, mostly before my period.",
      "start_timestamp": "01:10",
      "end_timestamp": "01:17",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you have any allergies to medicines?",
