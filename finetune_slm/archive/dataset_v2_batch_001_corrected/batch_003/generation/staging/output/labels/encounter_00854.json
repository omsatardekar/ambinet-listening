  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Right. I'm here because my partner says I've got a temper, and I need to sort it. I don't want to lose my job.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:11",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you for coming. Tell me what's been happening.",
      "start_timestamp": "00:14",
      "end_timestamp": "00:20",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I get short with people. At work, at home. Small things, someone leaves a door open, and I blow. I shout. Then I feel terrible.",
      "start_timestamp": "00:22",
      "end_timestamp": "00:35",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long has this been going on?",
      "start_timestamp": "00:38",
      "end_timestamp": "00:42",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A year? Maybe longer. I can't say when it started. It got worse after Christmas.",
      "start_timestamp": "00:44",
      "end_timestamp": "00:53",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How's your sleep?",
      "start_timestamp": "01:12",
      "end_timestamp": "01:15",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Four hours a night, broken.",
      "start_timestamp": "01:18",
      "end_timestamp": "01:21",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any thoughts of harming yourself, or anyone else?",
      "start_timestamp": "01:23",
      "end_timestamp": "01:27",
      "supports": [
        "negative_findings[0]",
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No. No, I'd never. Not anyone.",
      "start_timestamp": "01:29",
      "end_timestamp": "01:34",
      "supports": [
        "negative_findings[0]",
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What are you taking?",
      "start_timestamp": "01:36",
      "end_timestamp": "01:39",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Propranolol, 10 mg, when I feel wound up, but not sure it does anything. Something for my stomach, omeprazole, 20 mg. And I take St John's wort, maybe 300 mg, a day.",
      "start_timestamp": "01:41",
      "end_timestamp": "01:58",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I need to stop you there, because St John's wort interacts with a lot of drugs. So it's 300 mg, as you recall it. Any other conditions?",
      "start_timestamp": "02:01",
      "end_timestamp": "02:15",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medications[2]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Acid reflux. That's all.",
      "start_timestamp": "02:17",
      "end_timestamp": "02:20",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you drink, or use any substances?",
      "start_timestamp": "02:22",
      "end_timestamp": "02:26",
      "supports": [
        "medical_history.social_history[0]",
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A few beers at night, to switch off. Four, five. And lots of coffee.",
      "start_timestamp": "02:29",
      "end_timestamp": "02:36",
      "supports": [
        "medical_history.social_history[0]",
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And what do you do for exercise, or to relax?",
      "start_timestamp": "02:39",
      "end_timestamp": "02:45",
      "supports": [
