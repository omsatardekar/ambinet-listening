  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Good morning, doctor. Thank you for seeing me. I'm back about my rash, though it is much improved, I must say.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:11",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, we went to Goa for a week and my back and chest came out in tiny red spots, very prickly and itchy.",
      "start_timestamp": "00:23",
      "end_timestamp": "00:36",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And how are those spots now, compared to when you came to me first?",
      "start_timestamp": "00:39",
      "end_timestamp": "00:47",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Mostly gone from the chest. The itching has gone away from my back too, thank God. It is only my neck now that is still red.",
      "start_timestamp": "00:50",
      "end_timestamp": "01:06",
      "supports": [
        "symptoms[0]",
        "symptoms[1]",
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "So the chest rash has settled, the itch on the back has settled, and the neck is still active?",
      "start_timestamp": "01:07",
      "end_timestamp": "01:19",
      "supports": [
        "symptoms[1]",
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Exactly so. The neck is still a bit itchy, especially at night when I'm warm under the blanket.",
      "start_timestamp": "01:20",
      "end_timestamp": "01:31",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And any new blisters, or skin breaking down or weeping?",
      "start_timestamp": "01:34",
      "end_timestamp": "01:40",
      "supports": [
        "negative_findings[0]",
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, no blisters at all. Nothing weeping either.",
      "start_timestamp": "01:42",
      "end_timestamp": "01:46",
      "supports": [
        "negative_findings[0]",
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I am using hydrocortisone cream 1% twice a day on the neck, calamine lotion when it itches, and also cetirizine 10 mg at night.",
      "start_timestamp": "01:58",
      "end_timestamp": "02:12",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. Cetirizine at night helps with itching. Are you allergic to any medicines, or have you ever been?",
      "start_timestamp": "02:15",
      "end_timestamp": "02:24",
      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, I have no known allergies. None at all.",
      "start_timestamp": "02:26",
      "end_timestamp": "02:32",
      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you. Your medical history, anything long-term that I should know?",
      "start_timestamp": "02:34",
      "end_timestamp": "02:40",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I have type 2 diabetes, and I take tablets for it. Also asthma since childhood, but it is quiet nowadays.",
      "start_timestamp": "02:41",
      "end_timestamp": "02:53",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Noted. Any operations in the past?",
      "start_timestamp": "02:56",
      "end_timestamp": "02:59",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Gallbladder removal, in 2017. Done by keyhole, very neat.",
      "start_timestamp": "03:01",
      "end_timestamp": "03:06",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 78, blood pressure 130 over 82, temperature 36.7, oxygen 98 percent, respiratory rate 16.",
      "start_timestamp": "03:37",
      "end_timestamp": "03:46",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Very good. Back and chest are clear now, just faint marks. The neck has a patch of red pinpoint spots.",
      "start_timestamp": "04:04",
      "end_timestamp": "04:14",
      "supports": [
        "physical_examination[0]",
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Heat rash usually looks dramatic. This looks like it is settling, and I would call it heat rash that is clearing, with some irritation on top of it.",
      "start_timestamp": "04:26",
      "end_timestamp": "04:40",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Not at all. Keep the neck cool and loosely covered, cotton collars, no tight chains or scarves.",
      "start_timestamp": "04:49",
      "end_timestamp": "04:59",
      "supports": [
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Please do. Continue the hydrocortisone on the neck for another five days, then stop.",
      "start_timestamp": "05:09",
      "end_timestamp": "05:16",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Take it at night until the itching has gone, then you may stop. I would like to see you again in two weeks to make sure it has gone.",
      "start_timestamp": "05:24",
      "end_timestamp": "05:38",
