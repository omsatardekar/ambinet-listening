  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Thank you, my dear. I'm afraid I've been rather foolish. I fell off a ladder, cleaning the gutters.",
      "start_timestamp": "00:14",
      "end_timestamp": "00:25",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_3",
      "speaker_role": "nurse",
      "transcript_text": "Pulse 88, blood pressure 144 over 86, temperature 36.7.",
      "start_timestamp": "00:39",
      "end_timestamp": "00:44",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I was about eight feet up, and the ladder slipped, and I came down on my left hand, with my arm out.",
      "start_timestamp": "00:55",
      "end_timestamp": "01:07",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "When was that?",
      "start_timestamp": "01:08",
      "end_timestamp": "01:11",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "About two hours ago. And my wrist has swollen up, rather alarmingly.",
      "start_timestamp": "01:13",
      "end_timestamp": "01:19",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How bad is the pain?",
      "start_timestamp": "01:22",
      "end_timestamp": "01:25",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Severe when I move it. I can hardly turn my hand over.",
      "start_timestamp": "01:26",
      "end_timestamp": "01:32",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Did you hit your head, or hurt anywhere else?",
      "start_timestamp": "01:33",
      "end_timestamp": "01:38",
      "supports": [
        "symptoms[1]",
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, no head injury. My right knee is a bit sore, but nothing much.",
      "start_timestamp": "01:39",
      "end_timestamp": "01:46",
      "supports": [
        "symptoms[1]",
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any numbness or tingling in your fingers?",
      "start_timestamp": "01:47",
      "end_timestamp": "01:51",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A little tingling in my thumb and index finger.",
      "start_timestamp": "01:53",
      "end_timestamp": "01:59",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you have any medical problems?",
      "start_timestamp": "02:00",
      "end_timestamp": "02:03",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "High blood pressure and an underactive thyroid.",
      "start_timestamp": "02:05",
      "end_timestamp": "02:09",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And do you do anything which might affect healing, do you smoke?",
      "start_timestamp": "02:10",
      "end_timestamp": "02:17",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I gave up thirty years ago.",
      "start_timestamp": "02:19",
      "end_timestamp": "02:23",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "The wrist is swollen, with a visible bump, a deformity, on the back of it, it's very tender over the end of the radius, and the fingers are warm with a good pulse.",
      "start_timestamp": "02:55",
      "end_timestamp": "03:10",
      "supports": [
        "physical_examination[0]",
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you, Chloe. Mr Hartley, this looks like a broken wrist, a fracture of the radius, called a Colles' fracture.",
      "start_timestamp": "03:18",
      "end_timestamp": "03:28",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I can't be certain without an X-ray, and it could also involve a small bone in the wrist, so I'd like an X-ray of the wrist, and one of the knee.",
      "start_timestamp": "03:34",
      "end_timestamp": "03:53",
      "supports": [
        "procedures_and_investigations[0]",
        "procedures_and_investigations[1]",
        "clinical_actions[0]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Please keep the arm raised on a pillow, and don't eat or drink anything until the X-rays are done, in case you need it set.",
      "start_timestamp": "04:14",
      "end_timestamp": "04:26",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Chloe will take you through to radiology. If your fingers go cold, blue or numb, tell her at once.",
      "start_timestamp": "04:50",
      "end_timestamp": "05:00",
      "supports": [
        "clinical_actions[2]",
        "follow_up[0]"
      ]
    }
