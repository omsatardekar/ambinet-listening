  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Morning. I'm here about the dizziness. The room spins, mostly when I roll over in bed.",
      "start_timestamp": "00:03",
      "end_timestamp": "00:10",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long has it been going on?",
      "start_timestamp": "00:15",
      "end_timestamp": "00:19",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Since the ear infection. Maybe three weeks after? Or was it before? I can't say when it started exactly.",
      "start_timestamp": "00:22",
      "end_timestamp": "00:32",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And how long does each spin last?",
      "start_timestamp": "00:36",
      "end_timestamp": "00:40",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A minute, perhaps. Then it eases. But I feel off for the rest of the day.",
      "start_timestamp": "00:44",
      "end_timestamp": "00:53",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any change in your hearing, or ringing in the ear?",
      "start_timestamp": "00:57",
      "end_timestamp": "01:02",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No. Hearing's the same. No ringing.",
      "start_timestamp": "01:06",
      "end_timestamp": "01:09",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What medicines are you taking?",
      "start_timestamp": "01:14",
      "end_timestamp": "01:17",
      "supports": [
        "medications[0]",
        "medications[1]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Betahistine, 16 mg, three times a day, maybe? The GP started it. And amlodipine, 5 mg once a day.",
      "start_timestamp": "01:21",
      "end_timestamp": "01:31",
      "supports": [
        "medications[0]",
        "medications[1]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is the betahistine making a difference, as far as you can tell?",
      "start_timestamp": "01:35",
      "end_timestamp": "01:42",
      "supports": [
        "medications[0]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Right. Tell me about your health background.",
      "start_timestamp": "01:52",
      "end_timestamp": "01:57",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Ear infection, left ear, last spring. High blood pressure. And migraines, for years.",
      "start_timestamp": "02:01",
      "end_timestamp": "02:09",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "From what you tell me, the spinning when you roll over, lasting a minute, after the ear infection, it fits best with benign positional vertigo.",
      "start_timestamp": "02:50",
      "end_timestamp": "03:02",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Sometimes. I'd like to arrange a hearing test as well, to be thorough, given the earlier ear infection.",
      "start_timestamp": "03:58",
      "end_timestamp": "04:07",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Until then, get up slowly, avoid sudden head turns, and sleep with your head slightly raised.",
      "start_timestamp": "04:16",
      "end_timestamp": "04:25",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to see you in four weeks, to see how the vertigo is.",
      "start_timestamp": "04:52",
