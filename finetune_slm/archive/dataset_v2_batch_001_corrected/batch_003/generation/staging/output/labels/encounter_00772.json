  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hello doctor. I've got, um, my periods have gone irregular, and I'm getting hair on my chin and cheeks. I forget exactly when it began.",
      "start_timestamp": "00:02",
      "end_timestamp": "00:14",
      "supports": [
        "chief_complaint",
        "symptoms[0]",
        "symptoms[1]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let's take it one at a time. How are your periods?",
      "start_timestamp": "00:17",
      "end_timestamp": "00:23",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Every two or three months. Sometimes I skip. Before, they were regular.",
      "start_timestamp": "00:27",
      "end_timestamp": "00:33",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "When did they change, roughly?",
      "start_timestamp": "00:36",
      "end_timestamp": "00:39",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I think two years ago? Or maybe three. I really can't tell.",
      "start_timestamp": "00:43",
      "end_timestamp": "00:50",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's fine. And the hair?",
      "start_timestamp": "00:53",
      "end_timestamp": "00:56",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Dark, coarse hairs on the chin, and some on my upper lip. I wax it every week.",
      "start_timestamp": "01:00",
      "end_timestamp": "01:10",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Are you on any medicine?",
      "start_timestamp": "01:32",
      "end_timestamp": "01:35",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Metformin, 500 mg, twice a day, which my last doctor gave me, and spironolactone, 50 mg, once a day, for the hair.",
      "start_timestamp": "01:38",
      "end_timestamp": "01:50",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. Any allergies to medicines?",
      "start_timestamp": "01:53",
      "end_timestamp": "01:56",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Penicillin. As a child, I had hives. I haven't taken it since.",
      "start_timestamp": "01:59",
      "end_timestamp": "02:05",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 74, blood pressure 118 over 74, weight 68 kilos.",
      "start_timestamp": "02:35",
      "end_timestamp": "02:40",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes. The picture of irregular periods, excess hair and spots fits with something called polycystic ovary syndrome, but I'd like to confirm that with blood tests and a scan.",
      "start_timestamp": "02:50",
      "end_timestamp": "03:05",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It's very common. I'd like to arrange blood tests for hormones, including testosterone, and a pelvic ultrasound.",
      "start_timestamp": "03:16",
      "end_timestamp": "03:25",
      "supports": [
        "procedures_and_investigations[0]",
        "procedures_and_investigations[1]",
        "clinical_actions[0]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If you miss a period and think you could be pregnant, take a test straight away and see me, because you must not take spironolactone in pregnancy.",
      "start_timestamp": "04:26",
      "end_timestamp": "04:40",
      "supports": [
