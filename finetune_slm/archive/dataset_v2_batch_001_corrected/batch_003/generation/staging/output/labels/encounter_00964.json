  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "I'm Diane, his daughter. And this is Rosa, who's with him in the daytime. He's been having terrible headaches since he started the new spray.",
      "start_timestamp": "00:23",
      "end_timestamp": "00:36",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you both. Mr Simmons, tell me about the headaches.",
      "start_timestamp": "00:38",
      "end_timestamp": "00:43",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "They come within minutes of using it. A pounding across my forehead. It's been about two weeks, since the spray was started.",
      "start_timestamp": "00:46",
      "end_timestamp": "00:58",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_4",
      "speaker_role": "caregiver",
      "transcript_text": "He grips his head, doctor, and has to sit down for twenty minutes.",
      "start_timestamp": "01:00",
      "end_timestamp": "01:07",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you feel anything else when you use it?",
      "start_timestamp": "01:09",
      "end_timestamp": "01:14",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A flushed face. Very warm. I go quite red.",
      "start_timestamp": "01:17",
      "end_timestamp": "01:22",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And dizziness?",
      "start_timestamp": "01:33",
      "end_timestamp": "01:35",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A touch, when I stand after the spray.",
      "start_timestamp": "01:37",
      "end_timestamp": "01:42",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Which spray is it, Diane?",
      "start_timestamp": "01:43",
      "end_timestamp": "01:47",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "The nitroglycerin spray, 0.4 mg, under the tongue, when he gets chest tightness.",
      "start_timestamp": "01:49",
      "end_timestamp": "01:56",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And what else does he take?",
      "start_timestamp": "01:59",
      "end_timestamp": "02:03",
      "supports": [
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "An aspirin, 81 mg, every morning.",
      "start_timestamp": "02:05",
      "end_timestamp": "02:09",
      "supports": [
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any allergies, Mr Simmons?",
      "start_timestamp": "02:10",
      "end_timestamp": "02:13",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Sulfa drugs. I came out in a rash.",
      "start_timestamp": "02:15",
      "end_timestamp": "02:19",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you. And your medical history?",
      "start_timestamp": "02:21",
      "end_timestamp": "02:25",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Angina, high blood pressure, and gout.",
      "start_timestamp": "02:28",
      "end_timestamp": "02:32",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Who do you live with?",
      "start_timestamp": "02:34",
      "end_timestamp": "02:37",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I live with Diane and her husband.",
      "start_timestamp": "02:40",
      "end_timestamp": "02:44",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let me check you. Blood pressure 132 over 78, pulse 70.",
      "start_timestamp": "02:56",
      "end_timestamp": "03:03",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your neck moves freely, with no stiffness.",
      "start_timestamp": "03:31",
      "end_timestamp": "03:35",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And follow my finger. Your pupils are equal and react normally.",
      "start_timestamp": "03:41",
      "end_timestamp": "03:46",
      "supports": [
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any weakness, numbness or trouble speaking?",
      "start_timestamp": "03:53",
      "end_timestamp": "03:57",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Not at all, my speech is fine, and my arms and legs are normal.",
      "start_timestamp": "03:58",
      "end_timestamp": "04:06",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_024",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Here is my thinking. Headaches and flushing within minutes of a nitrate spray is a well-known side effect. I think the headache is a side effect of the spray.",
      "start_timestamp": "04:08",
      "end_timestamp": "04:22",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_025",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Not without a plan. Chest tightness needs a medicine to treat it. I'd like to arrange an ECG to look at your heart today.",
      "start_timestamp": "04:30",
      "end_timestamp": "04:44",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_026",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes, it takes five minutes. And I'd like to fit a 24-hour blood pressure monitor, to see what happens to your pressure around the spray.",
      "start_timestamp": "04:50",
      "end_timestamp": "05:04",
      "supports": [
        "procedures_and_investigations[1]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_027",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "In the meantime, sit down before you use the spray, and have a sip of water.",
      "start_timestamp": "05:12",
      "end_timestamp": "05:19",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_028",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If the headaches don't settle in two weeks, come back and we'll look at the options.",
      "start_timestamp": "05:26",
      "end_timestamp": "05:35",
      "supports": [
        "clinical_actions[2]",
        "follow_up[0]"
      ]
