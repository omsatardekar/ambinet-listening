  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Hi, doctor, sorry, we're a bit rushed, I've got the other two in the car with their dad. This is Ollie, he's eight, and he won't eat anything.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:18",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Pasta. Plain. And chicken nuggets. And toast.",
      "start_timestamp": "00:29",
      "end_timestamp": "00:33",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long has the pickiness been going on, Mum?",
      "start_timestamp": "00:43",
      "end_timestamp": "00:49",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Six months, since he started Year 4. He used to eat fruit and a bit of veg.",
      "start_timestamp": "00:50",
      "end_timestamp": "00:59",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Two months. It's not six. I stopped liking things at Easter.",
      "start_timestamp": "01:01",
      "end_timestamp": "01:07",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "So Ollie says two months and Mum says six months. We'll write two to six. Ollie, does your tummy hurt when you eat?",
      "start_timestamp": "01:08",
      "end_timestamp": "01:22",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any allergies, to food or medicine?",
      "start_timestamp": "01:56",
      "end_timestamp": "01:59",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "No allergies at all.",
      "start_timestamp": "02:01",
      "end_timestamp": "02:03",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Weight 21.5 kilos, height 118 centimetres, BMI 15.4. Pulse 86, temperature 36.7.",
      "start_timestamp": "02:39",
      "end_timestamp": "02:47",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Fussy eating is very common in this age group, and as long as he's growing and has energy, I'm not worried. I'd say this is most likely simple picky eating.",
      "start_timestamp": "03:29",
      "end_timestamp": "03:44",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Keep offering new foods without pressure, a tiny bit on his plate, and eat together as a family where you can.",
      "start_timestamp": "03:51",
      "end_timestamp": "04:03",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It can take fifteen or twenty exposures. Don't bribe, don't argue, and don't make a separate meal every time.",
      "start_timestamp": "04:12",
      "end_timestamp": "04:22",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "A child multivitamin is reasonable, but not essential. I'd like to see him again in six weeks, to check his weight.",
      "start_timestamp": "04:49",
      "end_timestamp": "05:01",
      "supports": [
        "clinical_actions[0]",
