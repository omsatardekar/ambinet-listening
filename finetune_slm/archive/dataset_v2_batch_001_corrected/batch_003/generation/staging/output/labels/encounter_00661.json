  "clinical_uncertainties": [],
  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hello again, doctor. I know it's only a cough, but it's been going on for three weeks now and it's driving me round the bend.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:13",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Not just a cough if it's driven you in. Tell me what it's like.",
      "start_timestamp": "00:16",
      "end_timestamp": "00:24",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Dry, tickly, mostly. It starts as soon as I lie down at night, and I'm getting no sleep. Oh, and sometimes I cough so hard I feel sick.",
      "start_timestamp": "00:26",
      "end_timestamp": "00:43",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And it began with a cold?",
      "start_timestamp": "00:45",
      "end_timestamp": "00:48",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A bad cold, yes, three weeks ago. The cold went, but the cough stayed.",
      "start_timestamp": "00:50",
      "end_timestamp": "00:57",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any fever, or coughing up blood?",
      "start_timestamp": "00:59",
      "end_timestamp": "01:03",
      "supports": [
        "negative_findings[0]",
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No fever, no blood. Nothing like that.",
      "start_timestamp": "01:04",
      "end_timestamp": "01:08",
      "supports": [
        "negative_findings[0]",
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Weight loss, sweats at night, anything of that kind?",
      "start_timestamp": "01:09",
      "end_timestamp": "01:14",
      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, I've actually put on a bit of weight, sadly.",
      "start_timestamp": "01:15",
      "end_timestamp": "01:22",
      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. Let's check what you take regularly.",
      "start_timestamp": "01:24",
      "end_timestamp": "01:28",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "The ramipril, 5 mg once a day, for my blood pressure, and metformin, 500 mg twice a day. That's it.",
      "start_timestamp": "01:29",
      "end_timestamp": "01:39",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And remind me of your other conditions, apart from the blood pressure.",
      "start_timestamp": "01:41",
      "end_timestamp": "01:49",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I've got type 2 diabetes, and I had asthma as a child, but I grew out of it.",
      "start_timestamp": "01:50",
      "end_timestamp": "01:59",
      "supports": [
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Temperature 36.7, pulse 76, oxygen 98 percent.",
      "start_timestamp": "02:26",
      "end_timestamp": "02:30",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your chest is clear, no crackles and no wheeze. Open wide. Your throat is a bit red at the back.",
      "start_timestamp": "03:21",
      "end_timestamp": "03:32",
      "supports": [
        "physical_examination[0]",
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "After a cold, it's common for the airways to stay twitchy for weeks, so I think this is most likely a post-viral cough.",
      "start_timestamp": "03:41",
      "end_timestamp": "03:54",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It can last up to eight weeks. But there's one other thing. Ramipril, your blood pressure tablet, can itself cause a dry, tickly cough in some people, so I can't rule out a side effect of the ramipril.",
      "start_timestamp": "04:03",
      "end_timestamp": "04:22",
      "supports": [
        "clinical_assessment[1]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Because it's been three weeks, I'd like to do a chest X-ray, to be sure there's nothing in the lungs. And a spirometry test to check your airways.",
      "start_timestamp": "04:51",
      "end_timestamp": "05:04",
      "supports": [
        "procedures_and_investigations[0]",
        "procedures_and_investigations[1]",
        "clinical_actions[0]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes, a blood test as well, to check your blood count and sugar control while we're at it.",
      "start_timestamp": "05:11",
      "end_timestamp": "05:20",
      "supports": [
        "procedures_and_investigations[2]",
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Honey and warm water at night can soothe the throat, and propping up on an extra pillow helps with lying down.",
      "start_timestamp": "05:29",
      "end_timestamp": "05:39",
      "supports": [
        "clinical_actions[4]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to see you again in three weeks, with the results, and we'll decide about the ramipril then.",
      "start_timestamp": "05:46",
      "end_timestamp": "05:58",
      "supports": [
        "clinical_actions[3]",
        "follow_up[0]"
      ]
    }
