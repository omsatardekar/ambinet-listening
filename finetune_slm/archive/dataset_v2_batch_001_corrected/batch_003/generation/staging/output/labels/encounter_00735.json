  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "nurse",
      "transcript_text": "Blood pressure 124 over 76, pulse 70, temperature 36.7, oxygen 98 percent.",
      "start_timestamp": "00:39",
      "end_timestamp": "00:45",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good morning, Mrs Vega. Thank you for coming back. You had your gastroscopy, the camera test of your stomach, on the second of October.",
      "start_timestamp": "00:47",
      "end_timestamp": "01:01",
      "supports": [
        "procedures_and_investigations[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Was it? I'd have said September. Yes, I thought it was earlier.",
      "start_timestamp": "01:02",
      "end_timestamp": "01:09",
      "supports": [
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Still the burning in my upper stomach, after meals, especially at night. I'm using more pillows.",
      "start_timestamp": "01:24",
      "end_timestamp": "01:32",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And when did that start, roughly?",
      "start_timestamp": "01:33",
      "end_timestamp": "01:37",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Oh, a year ago? Maybe longer. I couldn't tell you the month.",
      "start_timestamp": "01:39",
      "end_timestamp": "01:44",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's fine. Any vomiting, trouble swallowing, or black stools?",
      "start_timestamp": "01:46",
      "end_timestamp": "01:51",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No vomiting, no trouble swallowing. Nothing black.",
      "start_timestamp": "01:54",
      "end_timestamp": "01:57",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you have any allergies?",
      "start_timestamp": "02:00",
      "end_timestamp": "02:03",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, none.",
      "start_timestamp": "02:04",
      "end_timestamp": "02:06",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And your background?",
      "start_timestamp": "02:07",
      "end_timestamp": "02:09",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Acid reflux, for years, and I had my appendix out, in 1998.",
      "start_timestamp": "02:12",
      "end_timestamp": "02:18",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you smoke or drink?",
      "start_timestamp": "02:21",
      "end_timestamp": "02:23",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I don't smoke. A glass of wine, now and then.",
      "start_timestamp": "02:26",
      "end_timestamp": "02:31",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your tummy is soft, a little tender at the top, in the middle, and no masses.",
      "start_timestamp": "02:58",
      "end_timestamp": "03:07",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "No. The biopsies we took showed inflammation but no cancer cells. This fits with acid reflux, and I'd call it reflux oesophagitis.",
      "start_timestamp": "03:34",
      "end_timestamp": "03:44",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It's very treatable, and not dangerous, but it needs proper management. I'd like to arrange a test for a stomach bacterium called Helicobacter, with a breath test.",
      "start_timestamp": "03:51",
      "end_timestamp": "04:04",
      "supports": [
        "procedures_and_investigations[1]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "You breathe into a bag after a drink. Painless. And a blood test to check you aren't anaemic.",
      "start_timestamp": "04:12",
      "end_timestamp": "04:21",
      "supports": [
        "procedures_and_investigations[2]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you, Hayley. Mrs Vega, raise the head of the bed by a few inches, eat dinner at least three hours before sleep, and cut out large, fatty meals.",
      "start_timestamp": "04:33",
      "end_timestamp": "04:46",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to see you in six weeks to review how you are, and the test results.",
      "start_timestamp": "05:07",
      "end_timestamp": "05:15",
      "supports": [
        "clinical_actions[2]",
        "follow_up[0]"
      ]
