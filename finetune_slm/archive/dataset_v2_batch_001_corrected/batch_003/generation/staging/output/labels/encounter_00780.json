  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "nurse",
      "transcript_text": "Doctor, this is Mr Pryce, fifty-two, sharp chest pain since this morning, worse on breathing in. ECG's being done.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:09",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It's a stabbing pain, here on the left, and it's worse when I breathe in or cough. I'm really worried it's my heart.",
      "start_timestamp": "00:10",
      "end_timestamp": "00:24",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Mr Pryce, I'm Dr Evans. Let's look at this carefully. When did it start?",
      "start_timestamp": "00:25",
      "end_timestamp": "00:33",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "About six this morning. I woke with it.",
      "start_timestamp": "00:34",
      "end_timestamp": "00:38",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Does it spread to your arm or jaw?",
      "start_timestamp": "00:39",
      "end_timestamp": "00:44",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No. It stays in the one place. It's worse when I lie flat.",
      "start_timestamp": "00:47",
      "end_timestamp": "00:54",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any breathlessness, a cough, or a fever?",
      "start_timestamp": "00:57",
      "end_timestamp": "01:01",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No fever. A bit of a cough, nothing coming up.",
      "start_timestamp": "01:03",
      "end_timestamp": "01:08",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_3",
      "speaker_role": "nurse",
      "transcript_text": "Doctor, his observations. Blood pressure 126 over 78, pulse 88, temperature 37.2, oxygen 98 percent, respiratory rate 18.",
      "start_timestamp": "01:39",
      "end_timestamp": "01:49",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thanks, Zara. Any allergies to medicines?",
      "start_timestamp": "01:50",
      "end_timestamp": "01:54",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, none.",
      "start_timestamp": "01:55",
      "end_timestamp": "01:57",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your history?",
      "start_timestamp": "01:58",
      "end_timestamp": "02:00",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "High cholesterol, and reflux. And I had my appendix out, maybe in 2005?",
      "start_timestamp": "02:02",
      "end_timestamp": "02:10",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And what do you take?",
      "start_timestamp": "02:12",
      "end_timestamp": "02:15",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Atorvastatin, 20 mg, maybe? At night. I'd have to check.",
      "start_timestamp": "02:17",
      "end_timestamp": "02:23",
      "supports": [
        "medications[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'll check the record. Let me listen to your chest.",
      "start_timestamp": "02:24",
      "end_timestamp": "02:30",
      "supports": [
        "medications[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "There's a scratchy sound, a friction rub, over the left lower chest when you breathe, your heart sounds are normal, and your calves are soft and not tender.",
      "start_timestamp": "02:54",
      "end_timestamp": "03:08",
      "supports": [
        "physical_examination[0]",
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_3",
      "speaker_role": "nurse",
      "transcript_text": "Doctor, I've already done the ECG.",
      "start_timestamp": "03:16",
      "end_timestamp": "03:19",
      "supports": [
        "procedures_and_investigations[2]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "The commonest cause, after a cold, is inflammation of the lining of the heart or lung, pericarditis or pleurisy. I'd like to rule out other causes, so I'd like to arrange a blood test for heart markers and inflammation, and a chest X-ray.",
      "start_timestamp": "03:44",
      "end_timestamp": "04:05",
      "supports": [
        "procedures_and_investigations[0]",
        "procedures_and_investigations[1]",
        "clinical_actions[0]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes, for now. And I'm going to start you on ibuprofen, 400 mg, three times a day, with food.",
      "start_timestamp": "04:11",
      "end_timestamp": "04:22",
      "supports": [
        "medications[1]",
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Take it easy for a few days, no heavy exercise.",
      "start_timestamp": "04:44",
      "end_timestamp": "04:50",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If the pain gets worse, you become breathless, feel faint, or the pain's like a crushing pressure, call 999.",
      "start_timestamp": "04:54",
      "end_timestamp": "05:03",
