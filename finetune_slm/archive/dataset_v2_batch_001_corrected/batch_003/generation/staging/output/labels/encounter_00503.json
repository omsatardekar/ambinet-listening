  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Well, I'm back. My wife made me come. It's the jaw again, but honestly it's not that bad, I'm sure other folks have it worse.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:15",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yeah. My jaw feels tight, especially first thing in the morning. Like I've been clenching all night.",
      "start_timestamp": "00:29",
      "end_timestamp": "00:38",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And the ear? You mentioned an ear ache on that side before, if I remember right.",
      "start_timestamp": "00:41",
      "end_timestamp": "00:49",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "That's still going. The ear ache is a dull thing, mostly on the right. It's been about three months now. Not sharp, just there.",
      "start_timestamp": "00:50",
      "end_timestamp": "01:02",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Chewing, mostly. Steak is the worst. I had a burger on Saturday and regretted it for the rest of the day.",
      "start_timestamp": "01:12",
      "end_timestamp": "01:22",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's a pretty strong hint from your jaw, actually. How about your hearing, any trouble with that?",
      "start_timestamp": "01:53",
      "end_timestamp": "02:03",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, hearing's fine. I'd tell you if it wasn't. My hearing's better than my wife's, to be honest.",
      "start_timestamp": "02:05",
      "end_timestamp": "02:16",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Right, cyclobenzaprine, 5 mg, at bedtime, every night. And I take another little white tablet in the morning, I couldn't tell you the name, my wife picks them up from the pharmacy.",
      "start_timestamp": "02:32",
      "end_timestamp": "02:49",
      "supports": [
        "medications[0]",
        "medications[1]",
        "clinical_uncertainties[0]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "The acid thing. For the heartburn. I think it starts with a P, or maybe an O. Sorry.",
      "start_timestamp": "02:57",
      "end_timestamp": "03:08",
      "supports": [
        "medications[1]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Well, most nights. I forget it a couple of nights a week, if I'm honest. I fall asleep on the couch and then I'm too tired to go back for it.",
      "start_timestamp": "03:22",
      "end_timestamp": "03:37",
      "supports": [
        "medications[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I drive a delivery truck. Mostly local, up and down the same twenty streets.",
      "start_timestamp": "03:54",
      "end_timestamp": "04:02",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any other conditions I should have on file? I've got the migraines and anxiety listed.",
      "start_timestamp": "04:18",
      "end_timestamp": "04:26",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "And the acid reflux, which is what the little tablet is for. That's it. Oh, and my dad had arthritis, bad in his hands and his jaw, if that counts for anything.",
      "start_timestamp": "04:28",
      "end_timestamp": "04:43",
      "supports": [
        "medical_history.past_medical_history[2]",
        "medical_history.family_history[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It might. Let me measure your numbers, then I'll have a look at the joint. Your blood pressure is 132 over 84.",
      "start_timestamp": "04:46",
      "end_timestamp": "04:58",
      "supports": [
        "vital_signs[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse is 68, oxygen saturation 99 percent, breathing rate 16 a minute, and you've put on a couple of pounds, 178 now.",
      "start_timestamp": "05:09",
      "end_timestamp": "05:20",
      "supports": [
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Hm. Okay, you can relax. Here is what I think. This looks most likely like a problem with the jaw joint, probably with clenching and grinding at night adding to it.",
      "start_timestamp": "05:59",
      "end_timestamp": "06:15",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Exactly like that. I'd like to order an X-ray of your jaw, a panoramic one, so we can see the joint and the teeth.",
      "start_timestamp": "06:43",
      "end_timestamp": "06:56",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Not at all, you just stand still for a few seconds. And for the next few weeks, soft foods, no gum, and a warm cloth against the jaw in the evening.",
      "start_timestamp": "07:06",
      "end_timestamp": "07:22",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Try the cyclobenzaprine every night as well, even the couch nights, set an alarm if it helps.",
      "start_timestamp": "07:34",
      "end_timestamp": "07:44",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to see you again in six weeks, with the X-ray report in hand.",
      "start_timestamp": "07:55",
      "end_timestamp": "08:03",
      "supports": [
        "clinical_actions[2]",
