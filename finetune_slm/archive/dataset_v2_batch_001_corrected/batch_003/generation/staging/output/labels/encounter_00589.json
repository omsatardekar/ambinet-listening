  "clinical_uncertainties": [],
  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Oh, Susan fusses. It's two falls, that's all, and one of them was only because the cat was under my feet.",
      "start_timestamp": "00:14",
      "end_timestamp": "00:27",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Tell me about the unsteadiness itself. When did you first notice it?",
      "start_timestamp": "00:28",
      "end_timestamp": "00:36",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "About six weeks ago I started feeling unsteady on my feet, like standing on a boat deck. My late wife always said I walked like a sailor anyway.",
      "start_timestamp": "00:38",
      "end_timestamp": "00:54",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Ha. And the falls, when did they happen?",
      "start_timestamp": "00:57",
      "end_timestamp": "01:01",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Getting out of the armchair, interesting. We'll come back to that. Let's go through your tablets, since you've brought the list.",
      "start_timestamp": "01:17",
      "end_timestamp": "01:28",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Lovely. Start at the top. What's the first one?",
      "start_timestamp": "01:42",
      "end_timestamp": "01:47",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Ramipril, 10 mg once a day, and that's for my high blood pressure.",
      "start_timestamp": "01:49",
      "end_timestamp": "01:56",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. And the next one?",
      "start_timestamp": "01:58",
      "end_timestamp": "02:01",
      "supports": [
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Tamsulosin, 400 micrograms once a day, for my enlarged prostate. I always call it the plumbing tablet, though.",
      "start_timestamp": "02:02",
      "end_timestamp": "02:13",
      "supports": [
        "medical_history.past_medical_history[1]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Simvastatin, 40 mg, which I take at night. And aspirin, 75 mg, one a day.",
      "start_timestamp": "02:20",
      "end_timestamp": "02:29",
      "supports": [
        "medications[2]",
        "medications[3]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "There's the stomach one, lansoprazole, 15 mg every morning. That's the five of them altogether.",
      "start_timestamp": "02:36",
      "end_timestamp": "02:45",
      "supports": [
        "medications[4]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Sitting, it's 128 over 74 and your pulse is 66. Now stand up for me, nice and slowly.",
      "start_timestamp": "03:32",
      "end_timestamp": "03:41",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Standing, 104 over 62. Oxygen is 97 percent, and temperature 36.5 degrees Celsius.",
      "start_timestamp": "03:57",
      "end_timestamp": "04:03",
      "supports": [
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I think the tablets are probably dropping your pressure too much when you stand, which would make anyone wobbly.",
      "start_timestamp": "04:46",
      "end_timestamp": "04:56",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I won't change anything today. I'd like some blood tests first, to check your kidneys and your blood count.",
      "start_timestamp": "05:13",
      "end_timestamp": "05:23",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Just the one tube this time. And I'd like a heart tracing, an ECG, while you're here.",
      "start_timestamp": "05:33",
      "end_timestamp": "05:42",
      "supports": [
        "procedures_and_investigations[1]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It takes a few minutes. First, a bit of history. Have you had any operations?",
      "start_timestamp": "05:50",
      "end_timestamp": "05:59",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A cataract operation, two years ago. Lovely job, I could suddenly see the telly clearer than the plot.",
      "start_timestamp": "06:01",
      "end_timestamp": "06:09",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Ha. And in the family, anyone with brittle bones?",
      "start_timestamp": "06:12",
      "end_timestamp": "06:17",
      "supports": [
        "medical_history.family_history[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My mother had osteoporosis. Bent right over by the end, poor soul.",
      "start_timestamp": "06:19",
      "end_timestamp": "06:25",
      "supports": [
        "medical_history.family_history[0]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you. Until the results are back, sit for a count of ten before you stand, and hold on to something solid.",
      "start_timestamp": "06:27",
      "end_timestamp": "06:40",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Please do. I'd like to see you again in two weeks, with the results.",
      "start_timestamp": "06:51",
      "end_timestamp": "06:58",
      "supports": [
        "clinical_actions[3]",
        "follow_up[0]"
      ]
    }
