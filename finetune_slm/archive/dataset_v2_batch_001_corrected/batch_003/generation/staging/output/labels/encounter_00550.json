  "clinical_uncertainties": [],
  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "The headline is that I've been stable, mostly. Breathing is the same as it was. The one new thing is my ankles swell up in the evenings, and that began ten days ago.",
      "start_timestamp": "00:49",
      "end_timestamp": "01:07",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Ten days. Is that every evening or only some?",
      "start_timestamp": "01:08",
      "end_timestamp": "01:14",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Most evenings, if I'm honest. It's worse after a long day on my feet, and it eases when I put my feet up on the footstool for an hour.",
      "start_timestamp": "01:15",
      "end_timestamp": "01:28",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's a very good record, thank you. Now, a few questions I always ask with a heart that's been through what yours has. Any chest pain?",
      "start_timestamp": "01:54",
      "end_timestamp": "02:08",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No chest pain at all. I'd have written it in red if there had been.",
      "start_timestamp": "02:10",
      "end_timestamp": "02:19",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And at night, do you ever wake up breathless?",
      "start_timestamp": "02:22",
      "end_timestamp": "02:28",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, I sleep on two pillows, as I always have, and I haven't woken up breathless once. That's in the diary too.",
      "start_timestamp": "02:30",
      "end_timestamp": "02:40",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any fainting, or blackouts?",
      "start_timestamp": "02:41",
      "end_timestamp": "02:44",
      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No fainting. I did stand up too fast on the fourth, and the room swam for a second, but I didn't go anywhere.",
      "start_timestamp": "02:47",
      "end_timestamp": "02:58",
      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Fine, a head rush isn't a faint. Let me check I have your medicine right. What are you taking?",
      "start_timestamp": "03:00",
      "end_timestamp": "03:10",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Furosemide, the water tablet, 40 mg every morning. I take it at seven, with a glass of water, just before I do my weight.",
      "start_timestamp": "03:12",
      "end_timestamp": "03:27",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. And you've had the heart failure how long now?",
      "start_timestamp": "03:34",
      "end_timestamp": "03:40",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Four years in October. I remember because the cardiologist told me the week after my sister's wedding.",
      "start_timestamp": "03:42",
      "end_timestamp": "03:50",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you. And how are you managing at home in general? Diet, activity?",
      "start_timestamp": "03:52",
      "end_timestamp": "04:00",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I keep to a low-salt diet. Under five grams a day, I weigh it out on the kitchen scales for the first week and then I get the hang of it.",
      "start_timestamp": "04:01",
      "end_timestamp": "04:18",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Excellent. And exercise?",
      "start_timestamp": "04:19",
      "end_timestamp": "04:20",
      "supports": [
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I walk the dog twice a day, about twenty minutes each, at an easy pace. If I can't talk while I walk, I slow down.",
      "start_timestamp": "04:22",
      "end_timestamp": "04:34",
      "supports": [
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Sleeve up, left arm, please. Your blood pressure is 118/72 and your pulse is 64 bpm, steady. On the scales you're 82.4 kg.",
      "start_timestamp": "05:05",
      "end_timestamp": "05:16",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I can see mild pitting swelling in both ankles, the dent from my thumb fills back slowly. And your chest is clear, no crackles at the bases.",
      "start_timestamp": "06:04",
      "end_timestamp": "06:17",
      "supports": [
        "physical_examination[0]",
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let me list what I think and what we can do. My impression is that this is most likely mild fluid retention, and your heart failure is otherwise steady. Overall that's reassuring.",
      "start_timestamp": "06:26",
      "end_timestamp": "06:42",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's my preference too. I'd like to arrange a blood test today, to look at your kidney function and salts, and we'll leave the furosemide where it is for now.",
      "start_timestamp": "07:20",
      "end_timestamp": "07:36",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "In the meantime, keep your feet up in the evenings, keep the salt low, and carry on with the diary. It's genuinely useful.",
      "start_timestamp": "07:57",
      "end_timestamp": "08:08",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to see you again in three months. We'll fix a date at reception.",
      "start_timestamp": "08:11",
      "end_timestamp": "08:19",
      "supports": [
        "clinical_actions[2]",
        "follow_up[0]"
      ]
    }
