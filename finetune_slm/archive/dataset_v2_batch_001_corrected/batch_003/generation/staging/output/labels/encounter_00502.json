  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good afternoon. The note on the booking says nose problems and a nasal spray you can't seem to put down. Is that about right?",
      "start_timestamp": "00:01",
      "end_timestamp": "00:13",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It's blocked. Always blocked. I can't breathe through it unless I use the spray, and then it's fine for an hour, maybe two, and then it's blocked again.",
      "start_timestamp": "00:50",
      "end_timestamp": "01:06",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Three or four times a day. Sometimes in the night too, I keep it right by the lamp.",
      "start_timestamp": "01:16",
      "end_timestamp": "01:25",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And how long has the nose been stuffed up like this?",
      "start_timestamp": "01:27",
      "end_timestamp": "01:33",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Oh, goodness. I don't know. A long time. Rosa, when did it start?",
      "start_timestamp": "01:36",
      "end_timestamp": "01:44",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "I honestly couldn't say. It was already bad when I started with you, but you'd told me it was bothering you before that, so I don't know where it began.",
      "start_timestamp": "01:46",
      "end_timestamp": "02:01",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Could have been last winter. Could have been the winter before. I really can't pin it down, doctor.",
      "start_timestamp": "02:03",
      "end_timestamp": "02:13",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's fine, we'll work with that. Anything else going on, like mucus down the back of the throat?",
      "start_timestamp": "02:16",
      "end_timestamp": "02:25",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, there's a drip down the back of my throat at night, and I wake up coughing and clearing it. That's new, that's more recent.",
      "start_timestamp": "02:27",
      "end_timestamp": "02:39",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any fever lately? Or nosebleeds?",
      "start_timestamp": "02:41",
      "end_timestamp": "02:45",
      "supports": [
        "negative_findings[0]",
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No fever. No nosebleeds either, thank goodness, I've got good linens and I'd like to keep them that way.",
      "start_timestamp": "02:47",
      "end_timestamp": "02:57",
      "supports": [
        "negative_findings[0]",
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "The nasal spray, the oxymetazoline one. Then amlodipine, 5 mg, one a day. And metformin, 500 mg, twice a day with food.",
      "start_timestamp": "03:07",
      "end_timestamp": "03:17",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "The amlodipine is for my high blood pressure, and the metformin is for type 2 diabetes. And the stomach acid, I get that too, I've had acid reflux for years.",
      "start_timestamp": "04:18",
      "end_timestamp": "04:33",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]",
        "medications[1]",
        "medications[2]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good to know. Any allergies I should be aware of? To medicines, or anything else?",
      "start_timestamp": "04:35",
      "end_timestamp": "04:44",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Well, wait. At the dentist two years ago she came out in something, a rash, maybe, after the numbing stuff. They weren't sure if it was the numbing stuff or her nerves. So possibly allergic, but we never found out.",
      "start_timestamp": "04:50",
      "end_timestamp": "05:10",
      "supports": [
        "allergies[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "The lining inside is red and swollen, and there's no sign of bleeding.",
      "start_timestamp": "05:56",
      "end_timestamp": "06:03",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Most likely it's rebound congestion from the spray, yes. Let me check your numbers quickly. Blood pressure is 138 over 82, and oxygen saturation is 97 percent.",
      "start_timestamp": "06:09",
      "end_timestamp": "06:22",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It's a little up, nothing to worry about today. Here's my plan. I'd like to order an HbA1c blood test, because I don't have a recent sugar reading for you.",
      "start_timestamp": "06:31",
      "end_timestamp": "06:46",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It doesn't need fasting, any morning is fine. I also want to book allergy skin testing, so we can settle that dentist question once and for all.",
      "start_timestamp": "06:55",
      "end_timestamp": "07:11",
      "supports": [
        "procedures_and_investigations[1]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Just tiny pricks on the forearm. Nothing like a blood draw. And if the nose isn't better after we get you off the spray, I'd consider a CT scan of the sinuses, but I'm not doing that now.",
      "start_timestamp": "07:20",
      "end_timestamp": "07:39",
      "supports": [
        "procedures_and_investigations[2]",
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Cut it down slowly. Use it in one nostril only for a week, leave the other one alone, and rinse both with warm salt water a couple of times a day.",
      "start_timestamp": "07:49",
      "end_timestamp": "08:05",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes, I'd like to see you in three weeks, and we'll see how the nose has settled. Rosa, you're welcome to come along.",
      "start_timestamp": "08:25",
      "end_timestamp": "08:35",
      "supports": [
        "clinical_actions[4]",
        "follow_up[0]"
      ]
    }
