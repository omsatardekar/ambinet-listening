  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Hello doctor. This is my son Arjun, he's seven. He starts wheezing whenever he runs around, and it worries me.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:12",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good lad. Mum, can you tell me what the wheezing is like?",
      "start_timestamp": "00:31",
      "end_timestamp": "00:38",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "It's a whistling sound from his chest, after he's been running for a few minutes at school.",
      "start_timestamp": "00:41",
      "end_timestamp": "00:49",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long does it last once he stops?",
      "start_timestamp": "00:51",
      "end_timestamp": "00:56",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Ten minutes or so, then it settles.",
      "start_timestamp": "00:59",
      "end_timestamp": "01:03",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Has it happened at night, or when he has a cold?",
      "start_timestamp": "01:06",
      "end_timestamp": "01:13",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "When he has a cold, yes, he gets a cough with it. But not usually at night.",
      "start_timestamp": "01:15",
      "end_timestamp": "01:24",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Does he take anything for it?",
      "start_timestamp": "01:41",
      "end_timestamp": "01:45",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "A blue inhaler, salbutamol, two puffs when he needs it, with a spacer. He has used it a few times.",
      "start_timestamp": "01:48",
      "end_timestamp": "01:58",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Does anyone in the family have asthma or eczema?",
      "start_timestamp": "02:13",
      "end_timestamp": "02:18",
      "supports": [
        "medical_history.family_history[0]",
        "medical_history.family_history[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "His mother, that's me, had asthma as a child, and his father has hay fever.",
      "start_timestamp": "02:21",
      "end_timestamp": "02:28",
      "supports": [
        "medical_history.family_history[0]",
        "medical_history.family_history[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Does Arjun have any allergies, to medicines or food?",
      "start_timestamp": "02:31",
      "end_timestamp": "02:36",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "A rash after eating peanuts when he was three. We've avoided them since.",
      "start_timestamp": "02:39",
      "end_timestamp": "02:47",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Oxygen 98 percent, pulse 90, breathing 22 a minute. His chest is clear now, no wheeze.",
      "start_timestamp": "03:38",
      "end_timestamp": "03:47",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Between episodes it often is. From what you describe, this sounds like exercise-induced asthma.",
      "start_timestamp": "03:57",
      "end_timestamp": "04:04",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It's common and very treatable. He should take two puffs of the salbutamol with the spacer ten minutes before sport.",
      "start_timestamp": "04:12",
      "end_timestamp": "04:23",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'll write a letter for the school. And I'd like to see him again in four weeks, to see how he's getting on.",
      "start_timestamp": "04:34",
      "end_timestamp": "04:46",
      "supports": [
        "clinical_actions[0]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If he's struggling to speak, or the inhaler isn't helping, call an ambulance.",
      "start_timestamp": "04:54",
      "end_timestamp": "05:01",
      "supports": [
        "clinical_actions[2]"
      ]
    }
  ],
