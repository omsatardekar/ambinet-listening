  "clinical_uncertainties": [],
  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Good afternoon, doctor. I'm afraid my thumb is still not right, three weeks on. I'd hoped to be skiing again by now.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:12",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A fall on the second day of the trip, my thumb caught in the strap of my pole. It swelled up almost immediately, and it's been painful at the base since.",
      "start_timestamp": "00:32",
      "end_timestamp": "00:51",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How painful is it today?",
      "start_timestamp": "00:53",
      "end_timestamp": "00:56",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Moderate, I'd say. It's worst when I try to grip, or pinch a pen.",
      "start_timestamp": "00:59",
      "end_timestamp": "01:06",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And is the thumb stiff?",
      "start_timestamp": "01:08",
      "end_timestamp": "01:11",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, a bit stiff in the morning, though that eases.",
      "start_timestamp": "01:13",
      "end_timestamp": "01:19",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any numbness or tingling in the thumb or fingers?",
      "start_timestamp": "01:20",
      "end_timestamp": "01:25",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, there's no numbness.",
      "start_timestamp": "01:26",
      "end_timestamp": "01:29",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What are you taking for it?",
      "start_timestamp": "01:31",
      "end_timestamp": "01:35",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Ibuprofen, 400 mg three times a day, and paracetamol, 1 gram, as well when it's bad. And omeprazole, 20 mg once a day, to protect my stomach.",
      "start_timestamp": "01:37",
      "end_timestamp": "01:53",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good thinking. Any allergies?",
      "start_timestamp": "01:55",
      "end_timestamp": "01:57",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "None that I'm aware of. No allergies.",
      "start_timestamp": "01:59",
      "end_timestamp": "02:03",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any other conditions?",
      "start_timestamp": "02:04",
      "end_timestamp": "02:06",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Osteoarthritis in the other hand, nothing in this one.",
      "start_timestamp": "02:08",
      "end_timestamp": "02:14",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Did you have the thumb X-rayed in the resort?",
      "start_timestamp": "02:16",
      "end_timestamp": "02:22",
      "supports": [
        "procedures_and_investigations[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, they did an X-ray on the first day. They said there was no fracture.",
      "start_timestamp": "02:24",
      "end_timestamp": "02:33",
      "supports": [
        "procedures_and_investigations[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Swollen and tender on the inner side of the thumb joint, and the joint opens up a bit more than the other side when I stress it.",
      "start_timestamp": "03:16",
      "end_timestamp": "03:30",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "The X-ray says no. What I suspect is a torn ligament, what we call skier's thumb.",
      "start_timestamp": "03:35",
      "end_timestamp": "03:43",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It's common, and it matters, because a ligament that's fully torn may need surgery. I'd like to arrange an MRI scan to see how badly it's damaged.",
      "start_timestamp": "03:54",
      "end_timestamp": "04:09",
      "supports": [
        "procedures_and_investigations[1]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "A couple of weeks for the appointment. Meanwhile, wear the thumb splint all day, and take it off only to wash.",
      "start_timestamp": "04:17",
      "end_timestamp": "04:29",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to see you again in three weeks, with the scan.",
      "start_timestamp": "04:54",
      "end_timestamp": "05:00",
      "supports": [
        "clinical_actions[1]",
        "follow_up[0]"
      ]
    }
