  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Doctor, I just don't get it. I've got a whole bag of pills, and nobody ever tells me what half of them are for.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:11",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Oh, I'm fine, mostly. I'm just wiped out a lot of the time.",
      "start_timestamp": "01:08",
      "end_timestamp": "01:15",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Wiped out. Is that all day long, or worse at certain times?",
      "start_timestamp": "01:17",
      "end_timestamp": "01:23",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Worse in the afternoons. By three o'clock I'm like a wet dishrag.",
      "start_timestamp": "01:24",
      "end_timestamp": "01:31",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And when did the wiped out feeling start, roughly?",
      "start_timestamp": "01:34",
      "end_timestamp": "01:39",
      "supports": [
        "symptoms[1]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Oh, gosh. Was it before Christmas? Or maybe after? I really couldn't tell you.",
      "start_timestamp": "01:40",
      "end_timestamp": "01:47",
      "supports": [
        "symptoms[1]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "I can't pin it down either. It sort of crept up on both of us.",
      "start_timestamp": "01:48",
      "end_timestamp": "01:56",
      "supports": [
        "symptoms[1]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's fine, it doesn't need an exact date. Are you getting dizzy at all, Dorothy?",
      "start_timestamp": "01:58",
      "end_timestamp": "02:08",
      "supports": [
        "symptoms[0]",
        "negative_findings[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, not me. I'm not dizzy.",
      "start_timestamp": "02:11",
      "end_timestamp": "02:15",
      "supports": [
        "negative_findings[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Well, she is, though. She gets dizzy when she stands up fast. Twice last week I had to grab her arm.",
      "start_timestamp": "02:15",
      "end_timestamp": "02:26",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Oh, Marcus, that's nothing. I just got up too quick.",
      "start_timestamp": "02:27",
      "end_timestamp": "02:33",
      "supports": [
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Sitting, your blood pressure is 134 over 78, and your pulse is 72.",
      "start_timestamp": "03:02",
      "end_timestamp": "03:09",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Standing, it comes down to 108 over 66.",
      "start_timestamp": "03:50",
      "end_timestamp": "03:55",
      "supports": [
        "vital_signs[2]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It's a bigger drop than I'd like. My best guess is that the combination of tablets is pushing your pressure down when you stand up.",
      "start_timestamp": "04:03",
      "end_timestamp": "04:17",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It might. Let me ask about a few other things. How about your breathing, any trouble there?",
      "start_timestamp": "04:26",
      "end_timestamp": "04:34",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, that's fine. Breathing's been fine.",
      "start_timestamp": "04:36",
      "end_timestamp": "04:40",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. And what conditions have you been carrying around over the years?",
      "start_timestamp": "04:41",
      "end_timestamp": "04:48",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Oh, high blood pressure, for ages. And the arthritis in my knees. That one's a real pain.",
      "start_timestamp": "04:50",
      "end_timestamp": "04:59",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Okay. And you're at home on your own, is that right?",
      "start_timestamp": "05:01",
      "end_timestamp": "05:06",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, I live on my own. Marcus comes by every morning, bless him.",
      "start_timestamp": "05:09",
      "end_timestamp": "05:17",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Alright. Here's what I'd like to do. I'll order a blood test to check how your kidneys and salts are doing.",
      "start_timestamp": "05:25",
      "end_timestamp": "05:37",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "In the meantime, Dorothy, when you get up from a chair or bed, sit for a moment first, then stand slowly.",
      "start_timestamp": "06:01",
      "end_timestamp": "06:13",
      "supports": [
        "clinical_actions[1]"
