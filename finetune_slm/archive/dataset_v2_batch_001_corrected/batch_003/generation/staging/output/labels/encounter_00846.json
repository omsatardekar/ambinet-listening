    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Doctor, I have a high fever, a terrible headache, and my tummy hurts. I think I ate some street food, chaat, in Karachi.",
