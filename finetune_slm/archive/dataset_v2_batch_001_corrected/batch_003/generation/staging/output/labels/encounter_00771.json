  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Doctor, my wife burnt her arm with hot oil, in the kitchen. I put it under the tap straight away, for I don't know how long.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:14",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It hurts so much.",
      "start_timestamp": "00:16",
      "end_timestamp": "00:19",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Mrs Gupta, I'm Dr Mehra. Let me see. How long ago did this happen?",
      "start_timestamp": "00:20",
      "end_timestamp": "00:27",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "About an hour. Maybe more. I don't remember, I was so shocked.",
      "start_timestamp": "00:29",
      "end_timestamp": "00:36",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "It was less than an hour, I'm sure, because I looked at the clock when I phoned the ambulance.",
      "start_timestamp": "00:37",
      "end_timestamp": "00:46",
      "supports": [
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's good, that's the right thing to do. Are you diabetic, or do you have any other conditions?",
      "start_timestamp": "01:19",
      "end_timestamp": "01:28",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I have diabetes and high blood pressure.",
      "start_timestamp": "01:31",
      "end_timestamp": "01:35",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And what do you do for a living?",
      "start_timestamp": "01:37",
      "end_timestamp": "01:41",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I'm a school teacher. I use my arms all day, writing.",
      "start_timestamp": "01:44",
      "end_timestamp": "01:50",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I know, we'll sort the pain in a moment. There's a red area about ten centimetres by six on the inner forearm, with a few blisters, and it's very tender. The skin around is intact.",
      "start_timestamp": "02:18",
      "end_timestamp": "02:39",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It's a partial thickness burn, so the top layers of skin are damaged, but it isn't the deepest kind.",
      "start_timestamp": "02:45",
      "end_timestamp": "02:54",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 92, blood pressure 138 over 84, temperature 36.8, oxygen 99 percent.",
      "start_timestamp": "03:26",
      "end_timestamp": "03:32",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to check your blood sugar now, because with diabetes, infection is a bigger risk.",
      "start_timestamp": "04:00",
      "end_timestamp": "04:08",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. I'd also like to arrange a dressing review in two days, with the nurse, to check for signs of infection.",
      "start_timestamp": "04:15",
      "end_timestamp": "04:26",
      "supports": [
        "procedures_and_investigations[1]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Keep the arm raised on a pillow, don't pop the blisters, and keep the dressing dry.",
      "start_timestamp": "04:30",
      "end_timestamp": "04:39",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If the dressing becomes soaked, the redness spreads, you get a fever, or a bad smell, come back immediately.",
      "start_timestamp": "04:57",
      "end_timestamp": "05:07",
      "supports": [
        "clinical_actions[2]",
