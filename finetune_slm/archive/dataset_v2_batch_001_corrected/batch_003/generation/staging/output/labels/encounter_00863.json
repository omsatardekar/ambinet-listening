    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "There's a black area of dead tissue, about three centimetres across, on the back of the left heel, with a red margin around it, some pus under the edge, and a foul smell, and the foot is warm.",
      "start_timestamp": "03:26",
      "end_timestamp": "03:45",
      "supports": [
        "physical_examination[0]",
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes, I think it is, and I can't rule out the infection reaching the bone. This is a grade three pressure ulcer with infection, an infected pressure ulcer.",
      "start_timestamp": "03:52",
      "end_timestamp": "04:06",
      "supports": [
        "clinical_assessment[0]",
        "clinical_assessment[1]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "He needs to come into hospital today. I'd like to arrange blood tests and an X-ray of the heel, and intravenous antibiotics, given your penicillin allergy, a different type.",
      "start_timestamp": "04:15",
      "end_timestamp": "04:30",
      "supports": [
        "procedures_and_investigations[0]",
        "procedures_and_investigations[1]",
        "clinical_actions[0]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'll arrange an ambulance now, and I'll ring the ward. Please keep the heel off the bed and don't let anything press on it.",
