      "end_timestamp": "00:48",
      "supports": [
        "symptoms[1]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's fine. Does it feel stiff?",
