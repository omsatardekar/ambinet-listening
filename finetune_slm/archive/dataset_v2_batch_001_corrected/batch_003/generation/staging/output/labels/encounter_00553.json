  "clinical_uncertainties": [],
  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yeah, it was getting better, I was really pleased. But then on Saturday my shoulder is acting up again, and this time it's a whole different kind of thing.",
      "start_timestamp": "00:19",
      "end_timestamp": "00:34",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Three days ago. I was lifting a box of books off the top shelf in the garage, and I felt something go. Not a crack, more like a rubber band snapping.",
      "start_timestamp": "01:11",
      "end_timestamp": "01:28",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Anything over my head makes it worse, like putting a shirt on or reaching up for a coffee mug. Resting it against my side is the only thing that helps.",
      "start_timestamp": "02:10",
      "end_timestamp": "02:25",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Overhead movements are the trigger, and resting it against your side eases it. Okay. Are you taking anything for it?",
      "start_timestamp": "02:27",
      "end_timestamp": "02:37",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Just ibuprofen, 400 mg, about every six hours when it's bad. It takes the edge off, but not all the way.",
      "start_timestamp": "02:39",
      "end_timestamp": "02:51",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Ibuprofen 400 mg, as needed. Fine. Any numbness or tingling in your arm or hand, or anything with your nerves?",
      "start_timestamp": "02:52",
      "end_timestamp": "03:02",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, nothing like that. My hand feels totally normal.",
      "start_timestamp": "03:04",
      "end_timestamp": "03:09",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yeah, I have type 2 diabetes, about seven years now, and high blood pressure too. Both pretty well controlled.",
      "start_timestamp": "03:23",
      "end_timestamp": "03:33",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Type 2 diabetes and high blood pressure, noted. Any surgeries in the past?",
      "start_timestamp": "03:34",
      "end_timestamp": "03:41",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I had my gallbladder out, about eight years ago. That's the only one.",
      "start_timestamp": "03:44",
      "end_timestamp": "03:52",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_3",
      "speaker_role": "nurse",
      "transcript_text": "Sure. Blood pressure is 134/82, pulse 76 bpm, temperature 36.9 °C, and oxygen saturation 98 %. All taken about ten minutes ago.",
      "start_timestamp": "04:04",
      "end_timestamp": "04:17",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "You have weakness lifting the arm out to the side past about shoulder height, and it drops when you let go. That's an important finding.",
      "start_timestamp": "05:25",
      "end_timestamp": "05:39",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "No, this is my thinking face. Let me explain my thinking. The tendon that did well in physio may have been aggravated, and I think the most likely explanation is a partial rotator cuff tear on top of your old problem.",
      "start_timestamp": "05:48",
      "end_timestamp": "06:08",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "A partial one, most likely. But I can't rule out a full-thickness tear yet, and the only way to tell the two apart is to look at the tendon.",
      "start_timestamp": "06:14",
      "end_timestamp": "06:29",
      "supports": [
        "clinical_assessment[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to arrange an ultrasound of your shoulder today. The nurse will check whether the scan room is free.",
      "start_timestamp": "06:40",
      "end_timestamp": "06:53",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And if the ultrasound isn't clear enough, we might consider an MRI, but let's see what the ultrasound shows first.",
      "start_timestamp": "07:16",
      "end_timestamp": "07:27",
      "supports": [
        "procedures_and_investigations[1]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Keep the arm close to your side for now, avoid lifting anything overhead, and keep taking the ibuprofen the way you have been.",
      "start_timestamp": "07:39",
      "end_timestamp": "07:50",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Exactly. And if the pain gets much worse, or the arm gets weaker over the next few days, call us and we'll get you back in right away.",
      "start_timestamp": "07:58",
      "end_timestamp": "08:13",
      "supports": [
        "clinical_actions[3]",
        "follow_up[0]"
      ]
    }
