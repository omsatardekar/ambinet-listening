  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Take a seat, Christopher. I'm Dr Banerjee. You were in for pneumonia, I see. How are you feeling now?",
      "start_timestamp": "00:45",
      "end_timestamp": "00:56",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Hospital food, yes. Any cough left?",
      "start_timestamp": "01:09",
      "end_timestamp": "01:13",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A little, yes, in the morning. A dry one. It's much better than it was.",
      "start_timestamp": "01:15",
      "end_timestamp": "01:23",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And your energy?",
      "start_timestamp": "01:25",
      "end_timestamp": "01:27",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Tired, I still get tired by three o'clock. I was at the gym four times a week and now I can barely make the shops.",
      "start_timestamp": "01:30",
      "end_timestamp": "01:42",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Understandable, that takes weeks. Any fever since you came home?",
      "start_timestamp": "01:44",
      "end_timestamp": "01:49",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, no temperature, I've been checking.",
      "start_timestamp": "01:52",
      "end_timestamp": "01:56",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any breathlessness, even on the stairs?",
      "start_timestamp": "01:58",
      "end_timestamp": "02:02",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Not really. A bit on the hill, but not on the stairs.",
      "start_timestamp": "02:04",
      "end_timestamp": "02:11",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any chest pain?",
      "start_timestamp": "02:13",
      "end_timestamp": "02:15",
      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, none whatsoever.",
      "start_timestamp": "02:16",
      "end_timestamp": "02:18",
      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Are you still on antibiotics?",
      "start_timestamp": "02:22",
      "end_timestamp": "02:25",
      "supports": [
        "medications[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, the last few days. Clarithromycin, maybe 500 mg? Twice a day. Honestly I'd have to look at the box, my daughter sorts them out.",
      "start_timestamp": "02:27",
      "end_timestamp": "02:39",
      "supports": [
        "medications[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_3",
      "speaker_role": "nurse",
      "transcript_text": "Your letter says the course ends on Friday, Mr Okonkwo.",
      "start_timestamp": "02:40",
      "end_timestamp": "02:45",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good, finish it. And do you smoke?",
      "start_timestamp": "02:46",
      "end_timestamp": "02:51",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I gave it up when I went into hospital. Twenty a day, for thirty years, and I haven't touched one since.",
      "start_timestamp": "02:52",
      "end_timestamp": "03:03",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes please, Joy. Christopher, I'd like to arrange a repeat chest X-ray in six weeks, to be sure the pneumonia has cleared completely.",
      "start_timestamp": "03:41",
      "end_timestamp": "03:53",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Keep drinking plenty, build up walking gradually, and rest when you need to.",
      "start_timestamp": "04:21",
      "end_timestamp": "04:29",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And I'd like to see you again in six weeks with the X-ray.",
      "start_timestamp": "04:38",
      "end_timestamp": "04:44",
      "supports": [
