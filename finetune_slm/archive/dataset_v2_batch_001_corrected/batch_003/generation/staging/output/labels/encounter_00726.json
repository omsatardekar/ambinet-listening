  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "nurse",
      "transcript_text": "Pulse 76, oxygen 96 percent.",
      "start_timestamp": "00:41",
      "end_timestamp": "00:44",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good morning. It's your sarcoidosis follow-up, six months since last time. How have you been?",
      "start_timestamp": "00:46",
      "end_timestamp": "00:55",
      "supports": [
        "chief_complaint",
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Well, my chest has been quiet, I get a bit of a cough in the mornings, that's all, and I'm on the steroids and the methotrexate, as you know.",
      "start_timestamp": "00:56",
      "end_timestamp": "01:12",
      "supports": [
        "symptoms[0]",
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Tell me about the cough.",
      "start_timestamp": "01:13",
      "end_timestamp": "01:16",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Dry, a few coughs when I get up, and then it's gone by breakfast. Nothing to worry about, I'd say.",
      "start_timestamp": "01:18",
      "end_timestamp": "01:28",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. Let's check the tablets, so I can match them to the record.",
      "start_timestamp": "01:30",
      "end_timestamp": "01:37",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Prednisolone, 5 mg once a day, down from 10 in the spring. And methotrexate, 10 mg once a week, on Sundays, with folic acid on Mondays.",
      "start_timestamp": "01:39",
      "end_timestamp": "01:55",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Right, that matches. And remind me of the other conditions.",
      "start_timestamp": "01:57",
      "end_timestamp": "02:03",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Sarcoidosis, since 2019, found on a chest X-ray, by accident, and osteoporosis, which they say is from the steroids.",
      "start_timestamp": "02:06",
      "end_timestamp": "02:16",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_3",
      "speaker_role": "nurse",
      "transcript_text": "Doctor, do you want his bloods taken today?",
      "start_timestamp": "02:17",
      "end_timestamp": "02:22",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes, please, Sue. Mr Evans, since you're on methotrexate, we check your blood count, liver and kidneys every few months.",
      "start_timestamp": "02:24",
      "end_timestamp": "02:35",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "No fasting. I'd also like you to have a chest X-ray, and a lung function test, to compare with last time.",
      "start_timestamp": "02:43",
      "end_timestamp": "02:56",
      "supports": [
        "procedures_and_investigations[1]",
        "procedures_and_investigations[2]",
        "clinical_actions[1]",
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Overall, I'd say the sarcoidosis is well controlled, and possibly even in remission, as far as I can tell from how you are. But I'd like the tests to confirm it.",
      "start_timestamp": "03:49",
      "end_timestamp": "04:05",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Not on your own, please. If your results stay good, we can reduce them slowly over the next months.",
      "start_timestamp": "04:31",
      "end_timestamp": "04:41",
      "supports": [
        "clinical_actions[3]"
      ]
    }
