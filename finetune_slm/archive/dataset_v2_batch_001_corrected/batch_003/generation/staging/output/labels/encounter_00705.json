  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Good morning, doctor. I hope this isn't too trivial. My ears feel blocked, ever since I flew back from Boston on Friday.",
      "start_timestamp": "00:02",
      "end_timestamp": "00:16",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Not trivial at all. Tell me what the blocked feeling is like.",
      "start_timestamp": "00:20",
      "end_timestamp": "00:27",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Like I'm underwater. Muffled, and a sort of fullness, mostly in the right ear.",
      "start_timestamp": "00:30",
      "end_timestamp": "00:38",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "When did it begin, exactly?",
      "start_timestamp": "00:42",
      "end_timestamp": "00:46",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "On the descent. They popped in the first ear, but the right one never did, and it's been four days now.",
      "start_timestamp": "00:49",
      "end_timestamp": "00:59",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Does it crackle or pop when you swallow?",
      "start_timestamp": "01:20",
      "end_timestamp": "01:25",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Occasionally, a little crackle. Then it goes quiet again.",
      "start_timestamp": "01:28",
      "end_timestamp": "01:34",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "The right eardrum is slightly pulled in, but it's intact and there's no fluid or infection that I can see.",
      "start_timestamp": "02:28",
      "end_timestamp": "02:39",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Chew gum or suck a sweet, yawn, and do that gentle blowing with your nose pinched, a few times a day.",
      "start_timestamp": "03:27",
      "end_timestamp": "03:37",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And don't fly again for now if you can avoid it, and don't put anything in the ear.",
      "start_timestamp": "04:04",
      "end_timestamp": "04:15",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If it's not better in two weeks, or you get pain, discharge or dizziness, come back and see me.",
      "start_timestamp": "04:26",
      "end_timestamp": "04:36",
      "supports": [
        "clinical_actions[0]",
        "follow_up[0]"
      ]
    }
