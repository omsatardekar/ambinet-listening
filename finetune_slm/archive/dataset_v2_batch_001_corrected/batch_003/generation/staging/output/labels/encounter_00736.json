  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Good morning. Let me be precise: I have a painful bump on the side of my right big toe, which is worse in shoes.",
      "start_timestamp": "00:02",
      "end_timestamp": "00:14",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you. How long has it been there?",
      "start_timestamp": "00:18",
      "end_timestamp": "00:23",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "The bump, about three years. The pain, the last four months, since I started a job on my feet.",
      "start_timestamp": "00:26",
      "end_timestamp": "00:36",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What sort of pain?",
      "start_timestamp": "00:40",
      "end_timestamp": "00:43",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Sharp, rubbing, and a throb by the end of the day. And the skin over it is red and sore.",
      "start_timestamp": "00:45",
      "end_timestamp": "00:56",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What shoes make it worse?",
      "start_timestamp": "01:00",
      "end_timestamp": "01:03",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Anything narrow. Work shoes, and heels. In trainers, it's bearable.",
      "start_timestamp": "01:06",
      "end_timestamp": "01:12",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any numbness, tingling, or burning in the toe?",
      "start_timestamp": "01:16",
      "end_timestamp": "01:20",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No numbness. No tingling.",
      "start_timestamp": "01:23",
      "end_timestamp": "01:25",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any swelling of the whole toe, or heat, or discharge from the skin?",
      "start_timestamp": "01:28",
      "end_timestamp": "01:35",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, nothing like that. Just the bump, and the redness around it.",
      "start_timestamp": "01:39",
      "end_timestamp": "01:46",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Most people do. First, wider shoes with a deeper toe box, soft insoles, and a gel pad over the bump.",
      "start_timestamp": "03:27",
      "end_timestamp": "03:37",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Keep them for special occasions only.",
      "start_timestamp": "04:03",
      "end_timestamp": "04:07",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If it's still bothering you after two months of that, or the toe gets red and hot, or the skin breaks, come back and I'll refer you to the foot specialist.",
      "start_timestamp": "04:34",
      "end_timestamp": "04:50",
