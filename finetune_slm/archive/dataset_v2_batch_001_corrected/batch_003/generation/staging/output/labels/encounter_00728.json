      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It's not that bad. A couple of weeks, perhaps.",
      "start_timestamp": "00:29",
      "end_timestamp": "00:35",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "It's a month at least, Mrs Haddad. I do your washing.",
