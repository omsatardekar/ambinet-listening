        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "So two weeks from you, a month from Mrs Haddad's side. I'll put it down as two weeks to a month. What are they like?",
      "start_timestamp": "00:50",
      "end_timestamp": "01:02",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I wake up drenched. Nightdress wet through, and I have to change. Three or four times a week.",
      "start_timestamp": "01:07",
      "end_timestamp": "01:17",
      "supports": [
        "symptoms[0]"
