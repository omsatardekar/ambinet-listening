  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Um, hello. I think I might have broken my ankle? I came down the stairs wrong about an hour ago.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:11",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I missed the last two steps, I think, and I landed on the side of my foot. It sort of folded under me.",
      "start_timestamp": "00:21",
      "end_timestamp": "00:33",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Did you hear or feel anything crack when it happened?",
      "start_timestamp": "00:36",
      "end_timestamp": "00:40",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I felt something, a sort of pop. I'm not sure if I heard it. Is that bad?",
      "start_timestamp": "00:42",
      "end_timestamp": "00:50",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It can mean different things, so don't read too much into it. Can you put weight on it at all?",
      "start_timestamp": "00:52",
      "end_timestamp": "01:02",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Not really. I tried to hobble and it hurt too much. I'd say it's severe when I stand.",
      "start_timestamp": "01:04",
      "end_timestamp": "01:15",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Where exactly is the pain?",
      "start_timestamp": "01:17",
      "end_timestamp": "01:20",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Outside of the ankle, down towards the little toe side. And it's swollen, it's gone puffy already.",
      "start_timestamp": "01:22",
      "end_timestamp": "01:32",
      "supports": [
        "symptoms[1]",
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Anything else? Numbness, tingling, anything odd in the foot?",
      "start_timestamp": "01:33",
      "end_timestamp": "01:37",
      "supports": [
        "symptoms[3]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My toes have been tingling a bit, but I can't say when that started. Maybe in the car, maybe before.",
      "start_timestamp": "01:38",
      "end_timestamp": "01:48",
      "supports": [
        "symptoms[3]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Okay, I'll test that properly in a moment. Any pain in your knee?",
      "start_timestamp": "01:50",
      "end_timestamp": "01:57",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, my knee's fine. Foot's just a bit stiff.",
      "start_timestamp": "01:58",
      "end_timestamp": "02:03",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Did you bang your head or hurt anywhere else when you fell?",
      "start_timestamp": "02:04",
      "end_timestamp": "02:11",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, I only fell the last bit. Just the ankle.",
      "start_timestamp": "02:14",
      "end_timestamp": "02:20",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. Have you hurt this ankle before?",
      "start_timestamp": "02:23",
      "end_timestamp": "02:28",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A few years ago I twisted it playing netball, but nothing like this.",
      "start_timestamp": "02:30",
      "end_timestamp": "02:37",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 84, blood pressure 124 over 76, temperature 36.7.",
      "start_timestamp": "03:00",
      "end_timestamp": "03:05",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's tender over the outer ankle bone and there's swelling around it. Your toes are warm and pink and you can feel me touching them.",
      "start_timestamp": "03:49",
      "end_timestamp": "04:01",
      "supports": [
        "physical_examination[0]",
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It could be a fracture, or a bad sprain, and I can't tell which by looking. That's why I'd like an X-ray of the ankle now.",
      "start_timestamp": "04:08",
      "end_timestamp": "04:22",
      "supports": [
        "clinical_assessment[0]",
        "clinical_assessment[1]",
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "We'll take you straight there. Meanwhile keep the foot raised on this stool.",
      "start_timestamp": "04:29",
      "end_timestamp": "04:36",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Please don't put any weight through it at all. Ask a nurse for a wheelchair if you need to go.",
      "start_timestamp": "04:47",
