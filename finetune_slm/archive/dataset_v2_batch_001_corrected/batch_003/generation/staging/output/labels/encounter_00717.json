  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hello, doctor. It's my eyes, the contact lenses, they've gone uncomfortable. I forgot to say on the phone, I wear them every day.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:13",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What does uncomfortable mean?",
      "start_timestamp": "00:14",
      "end_timestamp": "00:17",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Dry, and sort of scratchy by the afternoon. I have to take them out by about four, and my eyes feel tired.",
      "start_timestamp": "00:19",
      "end_timestamp": "00:32",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's fine. What are you putting in your eyes?",
      "start_timestamp": "00:56",
      "end_timestamp": "01:01",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Lubricating drops, four times a day. Hypromellose, I think the packet says. Does that sound right?",
      "start_timestamp": "01:03",
      "end_timestamp": "01:11",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's right. And the other tablets you mentioned on the form?",
      "start_timestamp": "01:14",
      "end_timestamp": "01:20",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Cetirizine, 10 mg once a day, for my hay fever.",
      "start_timestamp": "01:23",
      "end_timestamp": "01:29",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Not serious. I'd say it's dry eye related to your lens wear, made worse by the screen and the air conditioning.",
      "start_timestamp": "03:38",
      "end_timestamp": "03:49",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Wear glasses on some days to give your eyes a rest, take the lenses out by the time you get home, and use preservative-free drops.",
      "start_timestamp": "03:56",
      "end_timestamp": "04:09",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Blink fully when you're at the screen, and look away every twenty minutes, twenty seconds.",
      "start_timestamp": "04:33",
      "end_timestamp": "04:41",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to see you again in six weeks, to see if the lenses are more comfortable.",
      "start_timestamp": "04:49",
      "end_timestamp": "04:59",
      "supports": [
        "clinical_actions[0]",
