  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thanks, and welcome. Mia, you've been having ear problems, haven't you?",
      "start_timestamp": "00:23",
      "end_timestamp": "00:29",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes. My ear hurts, and I can't hear Miss.",
      "start_timestamp": "00:31",
      "end_timestamp": "00:36",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Which ear?",
      "start_timestamp": "00:38",
      "end_timestamp": "00:40",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "The left one. Sometimes the right.",
      "start_timestamp": "00:42",
      "end_timestamp": "00:46",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_3",
      "speaker_role": "clinical_staff",
      "transcript_text": "Dad's notes say she's had five ear infections this year, and she's been shouting at the telly.",
      "start_timestamp": "00:48",
      "end_timestamp": "00:58",
      "supports": [
        "symptoms[0]",
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long has the left ear been sore this time?",
      "start_timestamp": "01:00",
      "end_timestamp": "01:06",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Since Monday.",
      "start_timestamp": "01:08",
      "end_timestamp": "01:10",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Mia, do you get a fever, or a runny nose?",
      "start_timestamp": "01:12",
      "end_timestamp": "01:17",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No fever. My nose is a bit blocked.",
      "start_timestamp": "01:20",
      "end_timestamp": "01:25",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_3",
      "speaker_role": "clinical_staff",
      "transcript_text": "The notes say she's on drops and tablets. Let me read. Olive oil drops, and a nose spray, and the tablets.",
      "start_timestamp": "01:27",
      "end_timestamp": "01:39",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[3]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Which ones, can you read me the names?",
      "start_timestamp": "01:40",
      "end_timestamp": "01:44",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[3]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_3",
      "speaker_role": "clinical_staff",
      "transcript_text": "The nasal spray is fluticasone, one spray each nostril once a day. The tablets are cetirizine, 5 mg once a day, and the drops are olive oil, two drops at night in the left ear.",
      "start_timestamp": "01:46",
      "end_timestamp": "02:04",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[3]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Does she have any allergies, to medicines?",
      "start_timestamp": "02:06",
      "end_timestamp": "02:10",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_3",
      "speaker_role": "clinical_staff",
      "transcript_text": "Dad's written, no allergies.",
      "start_timestamp": "02:13",
      "end_timestamp": "02:15",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And any other problems?",
      "start_timestamp": "02:17",
      "end_timestamp": "02:20",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_3",
      "speaker_role": "clinical_staff",
      "transcript_text": "Hay fever, he's written that.",
      "start_timestamp": "02:22",
      "end_timestamp": "02:26",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "The left eardrum is red and bulging, and there's no hole. The right eardrum is dull, with fluid behind it.",
      "start_timestamp": "03:01",
      "end_timestamp": "03:10",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes, a left ear infection, and fluid in the right ear, which is likely a glue ear. I can't rule out hearing loss from the fluid.",
      "start_timestamp": "03:19",
      "end_timestamp": "03:33",
      "supports": [
        "clinical_assessment[0]",
        "clinical_assessment[1]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It'll be sore for a couple of days. I'm going to prescribe an antibiotic for the left ear, and your dad can collect it.",
      "start_timestamp": "03:41",
      "end_timestamp": "03:54",
      "supports": [
        "medications[2]",
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Please tell him, and I'll put it on the record. Mia has had five infections this year, so I'd like to arrange a hearing test, and I'll refer her to the ENT team to talk about grommets.",
      "start_timestamp": "04:03",
      "end_timestamp": "04:20",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to see Mia again in four weeks, to check the right ear.",
      "start_timestamp": "04:50",
      "end_timestamp": "04:59",
      "supports": [
        "clinical_actions[2]",
        "follow_up[0]"
      ]
