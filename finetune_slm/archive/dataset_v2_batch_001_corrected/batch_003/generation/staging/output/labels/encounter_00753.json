  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Morning, doctor. I'm Rosa, I'm Mr Quinn's carer, and this is his son, Danny. We're worried about his tiredness and his skin.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:12",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I'm fine. A bit tired, that's all.",
      "start_timestamp": "00:24",
      "end_timestamp": "00:28",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_4",
      "speaker_role": "family_member",
      "transcript_text": "He's more than a bit tired, Dad. He's been exhausted for months, and his skin is going dark, especially his hands, and around his elbows.",
      "start_timestamp": "00:31",
      "end_timestamp": "00:43",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Mr Quinn, when did the tiredness start?",
      "start_timestamp": "00:46",
      "end_timestamp": "00:51",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Oh, I couldn't say, I've been slow for a while.",
      "start_timestamp": "00:52",
      "end_timestamp": "00:58",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And the darker skin, did you notice it, when did it begin?",
      "start_timestamp": "01:00",
      "end_timestamp": "01:05",
      "supports": [
        "symptoms[1]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I haven't noticed it. Danny's the one who points it out. I couldn't tell you when.",
      "start_timestamp": "01:08",
      "end_timestamp": "01:16",
      "supports": [
        "symptoms[1]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "I noticed it in the spring, in his palm creases, but I'm not sure when exactly.",
      "start_timestamp": "01:18",
      "end_timestamp": "01:26",
      "supports": [
        "symptoms[1]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'll note that none of you can pin it down. Mr Quinn, any dizziness, especially when you stand up?",
      "start_timestamp": "01:28",
      "end_timestamp": "01:37",
      "supports": [
        "symptoms[2]",
        "negative_findings[0]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No. No dizziness.",
      "start_timestamp": "01:38",
      "end_timestamp": "01:41",
      "supports": [
        "negative_findings[0]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "He does get dizzy, doctor. He held the wall twice last week, getting up from the chair.",
      "start_timestamp": "01:43",
      "end_timestamp": "01:53",
      "supports": [
        "symptoms[2]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_4",
      "speaker_role": "family_member",
      "transcript_text": "And he nearly fell in the bathroom.",
      "start_timestamp": "01:54",
      "end_timestamp": "01:58",
      "supports": [
        "symptoms[2]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'll record that Mr Quinn says no, and Rosa and Danny say yes. What medicines does he take?",
      "start_timestamp": "02:01",
      "end_timestamp": "02:10",
      "supports": [
        "medications[0]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Just the hydrocortisone, 10 mg in the morning and 5 mg in the afternoon, but I'm not sure he's been taking the afternoon dose.",
      "start_timestamp": "02:13",
      "end_timestamp": "02:28",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Hydrocortisone, for what condition?",
      "start_timestamp": "02:29",
      "end_timestamp": "02:32",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_4",
      "speaker_role": "family_member",
      "transcript_text": "Addison's disease, diagnosed ten years ago.",
      "start_timestamp": "02:33",
      "end_timestamp": "02:36",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And is there anything else?",
      "start_timestamp": "02:38",
      "end_timestamp": "02:41",
      "supports": [
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Underactive thyroid too.",
      "start_timestamp": "02:43",
      "end_timestamp": "02:45",
      "supports": [
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Right. Because of the possible dizziness, the dark skin, and the missed doses, I'd say this looks like his Addison's disease is under-treated, an adrenal problem.",
      "start_timestamp": "03:36",
      "end_timestamp": "03:49",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It can be, if it gets worse, because a low steroid level can cause a crisis. I'd like to arrange blood tests today, to check his sodium, potassium and cortisol.",
      "start_timestamp": "03:56",
      "end_timestamp": "04:12",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes. Please make sure he takes his hydrocortisone, including the afternoon dose, and use a pill box.",
      "start_timestamp": "04:19",
      "end_timestamp": "04:28",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And if he's vomiting, very dizzy, confused, or collapses, take him straight to the emergency department, and tell them he has Addison's.",
      "start_timestamp": "04:35",
      "end_timestamp": "04:47",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. I'd like to see you again in a week.",
      "start_timestamp": "04:55",
      "end_timestamp": "05:01",
      "supports": [
        "clinical_actions[1]",
        "follow_up[0]"
      ]
    }
