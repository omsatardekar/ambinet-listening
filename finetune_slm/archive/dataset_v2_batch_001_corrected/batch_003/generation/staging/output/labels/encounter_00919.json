  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Doctor, I'm Meera, her daughter-in-law. Mrs Rao has had a dry mouth and sores under her dentures for a good while now.",
      "start_timestamp": "00:02",
      "end_timestamp": "00:13",
      "supports": [
        "chief_complaint",
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you for coming with her. Mrs Rao, tell me about your mouth.",
      "start_timestamp": "00:16",
      "end_timestamp": "00:24",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It's so dry, I can't taste anything. And the sores hurt when I eat.",
      "start_timestamp": "00:28",
      "end_timestamp": "00:36",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Where are the sores?",
      "start_timestamp": "00:40",
      "end_timestamp": "00:43",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "On the roof of my mouth, and on the gums at the front.",
      "start_timestamp": "00:46",
      "end_timestamp": "00:53",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "She's been eating only soft things for a few weeks.",
      "start_timestamp": "00:57",
      "end_timestamp": "01:02",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That can make the sores worse. How long have you had the sores?",
      "start_timestamp": "01:47",
      "end_timestamp": "01:54",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Three weeks.",
      "start_timestamp": "01:56",
      "end_timestamp": "01:58",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "There are red, inflamed patches under the upper denture, with some white coating, and the mouth is dry.",
      "start_timestamp": "03:07",
      "end_timestamp": "03:18",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Often tablets, or not drinking enough, or other things. I'd like to look at her medicines list and arrange some blood tests.",
      "start_timestamp": "03:48",
      "end_timestamp": "03:59",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you. In the meantime, she should take the dentures out at night, and keep them in a cup of water.",
      "start_timestamp": "04:07",
      "end_timestamp": "04:19",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'll also refer you to the dentist to have the dentures checked or remade.",
      "start_timestamp": "04:50",
      "end_timestamp": "04:59",
      "supports": [
        "clinical_actions[0]"
      ]
    }
