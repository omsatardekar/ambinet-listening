      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "So three, says Mr Doyle, and Ellen counts five or six. I'll note it as three to six. How long has it been going on?",
