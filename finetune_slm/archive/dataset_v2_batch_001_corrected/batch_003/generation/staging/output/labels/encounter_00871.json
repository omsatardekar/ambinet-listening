    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "There are several flat purple bruises on the forearms and shins, the largest about eight centimetres, and the skin is otherwise intact, no tenderness.",
      "start_timestamp": "03:09",
      "end_timestamp": "03:23",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "No. Bruising is expected on two blood-thinning drugs, and it's not a sign that something is wrong. I'd say these are medication-related bruises, and your other bleeding is minor.",
      "start_timestamp": "03:30",
      "end_timestamp": "03:43",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Use a soft toothbrush, wear long sleeves for gardening, and avoid ibuprofen and other anti-inflammatory painkillers.",
