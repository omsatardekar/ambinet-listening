      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Please stop, and use paracetamol instead.",
      "start_timestamp": "04:29",
      "end_timestamp": "04:32",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your heart clinic will check your tablets. If you bleed heavily, vomit blood, pass black stools, or get a severe headache, go to the emergency department at once.",
      "start_timestamp": "04:36",
      "end_timestamp": "04:52",
      "supports": [
