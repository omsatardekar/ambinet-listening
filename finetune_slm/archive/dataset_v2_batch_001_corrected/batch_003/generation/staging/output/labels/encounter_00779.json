      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 72, oxygen 99 percent, temperature 36.6.",
      "start_timestamp": "02:10",
      "end_timestamp": "02:15",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your nasal lining is pink and swollen on both sides, particularly the left, and the septum looks straight, which is good. There's no pus and no polyps.",
      "start_timestamp": "02:55",
      "end_timestamp": "03:09",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "The swelling of the lining is what's blocking it, probably from your hay fever and the lining reacting, but I can't rule out some scarring inside from the surgery, which we can't see from here.",
      "start_timestamp": "03:17",
      "end_timestamp": "03:38",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Use the fluticasone spray every day, even when you feel clear, for at least six weeks, because it only works when it's regular.",
      "start_timestamp": "03:56",
      "end_timestamp": "04:08",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Add a salt-water rinse in the evenings, to clear the crusts and soothe the lining.",
      "start_timestamp": "04:16",
      "end_timestamp": "04:24",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If you're still blocked after six weeks of regular use, come back and I'll refer you back to the ENT surgeon, who can look inside with a camera.",
