  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hello, doctor. It's my nose again. I thought the operation would sort it, but it's blocked again. Is it always going to be like this?",
      "start_timestamp": "00:02",
      "end_timestamp": "00:15",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Eight months ago. The septum, and the turbinates. And it was lovely for about three months. Then it started creeping back.",
      "start_timestamp": "00:26",
      "end_timestamp": "00:36",
      "supports": [
        "symptoms[0]",
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Which side is blocked?",
      "start_timestamp": "00:39",
      "end_timestamp": "00:42",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "The left, mainly, and sometimes the right. Worse at night.",
      "start_timestamp": "00:45",
      "end_timestamp": "00:51",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What are you using for it?",
      "start_timestamp": "01:09",
      "end_timestamp": "01:13",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "The steroid spray, fluticasone, two sprays each side once a day, though I confess I don't use it every day.",
      "start_timestamp": "01:15",
      "end_timestamp": "01:25",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thanks for being honest. What else is in your medical history?",
      "start_timestamp": "01:27",
      "end_timestamp": "01:34",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hay fever, and asthma.",
      "start_timestamp": "01:36",
      "end_timestamp": "01:38",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
