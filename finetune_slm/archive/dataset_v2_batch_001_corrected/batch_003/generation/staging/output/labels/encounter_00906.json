      "end_timestamp": "02:19",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any long-term conditions, or family history of eye problems?",
      "start_timestamp": "02:22",
      "end_timestamp": "02:27",
      "supports": [
        "medical_history.family_history[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My mother has glaucoma.",
      "start_timestamp": "02:30",
      "end_timestamp": "02:33",
      "supports": [
        "medical_history.family_history[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Blood pressure 118 over 76, pulse 68, temperature 36.5, oxygen 99 percent, breathing 14.",
      "start_timestamp": "03:01",
