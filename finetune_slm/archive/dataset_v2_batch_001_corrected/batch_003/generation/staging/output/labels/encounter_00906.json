      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Perfect. I think this is eye strain, from the screen time and probably needing glasses again.",
      "start_timestamp": "03:18",
      "end_timestamp": "03:27",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "With your mother's glaucoma, I'd like an optician to measure the pressure in your eyes too.",
      "start_timestamp": "03:40",
      "end_timestamp": "03:49",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes, a full eye test, and tell them about your mother.",
      "start_timestamp": "04:00",
      "end_timestamp": "04:06",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Meanwhile, take a break every twenty minutes and look at something far away.",
      "start_timestamp": "04:16",
      "end_timestamp": "04:24",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Exactly. And adjust the screen so it isn't glaring.",
      "start_timestamp": "04:34",
      "end_timestamp": "04:39",
      "supports": [
        "clinical_actions[2]"
      ]
    },
