      "transcript_text": "No. Nothing like that.",
      "start_timestamp": "01:28",
      "end_timestamp": "01:31",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you take anything for the headache?",
      "start_timestamp": "01:34",
      "end_timestamp": "01:39",
