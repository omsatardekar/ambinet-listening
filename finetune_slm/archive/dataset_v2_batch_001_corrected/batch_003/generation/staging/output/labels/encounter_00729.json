  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Er, hi. I've got a lump on my neck, at the back, and it's gone sore. It's a cyst, I think. I've had them before.",
      "start_timestamp": "00:02",
      "end_timestamp": "00:16",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let me hear about it. How long has it been there?",
      "start_timestamp": "00:18",
      "end_timestamp": "00:24",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Ages. A year? It was small and didn't bother me. Then last week it got big and sore.",
      "start_timestamp": "00:27",
      "end_timestamp": "00:37",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Painful how?",
      "start_timestamp": "00:41",
      "end_timestamp": "00:42",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Tender. Throbs a bit. It hurts if my collar rubs it.",
      "start_timestamp": "00:45",
      "end_timestamp": "00:50",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any discharge, or has it burst?",
      "start_timestamp": "00:54",
      "end_timestamp": "00:58",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No. Nothing came out. No.",
      "start_timestamp": "01:01",
      "end_timestamp": "01:04",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What are you using on it?",
      "start_timestamp": "01:07",
      "end_timestamp": "01:11",
      "supports": [
        "medications[0]",
        "medications[1]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Doxycycline, 100 mg, the dentist gave me some, maybe once a day? And the antiseptic wash, I don't know the name, from the pharmacy.",
      "start_timestamp": "01:14",
      "end_timestamp": "01:26",
      "supports": [
        "medications[0]",
        "medications[1]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thanks. So doxycycline, 100 mg, once a day as you recall it. And the wash, you can't name it. Have you had cysts before?",
      "start_timestamp": "01:29",
      "end_timestamp": "01:41",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.surgical_history[0]",
        "medical_history.family_history[0]",
        "medications[0]",
        "clinical_actions[1]",
        "follow_up[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "One on my back, they cut it out, five years ago.",
      "start_timestamp": "01:43",
      "end_timestamp": "01:49",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Does it run in the family?",
      "start_timestamp": "01:52",
      "end_timestamp": "01:56",
      "supports": [
        "medical_history.family_history[0]",
        "clinical_actions[1]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My dad gets them. On his scalp.",
      "start_timestamp": "01:58",
      "end_timestamp": "02:02",
      "supports": [
        "medical_history.family_history[0]",
        "clinical_actions[1]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It looks like an epidermoid cyst, which is a sac under the skin, and it's a little inflamed.",
      "start_timestamp": "02:56",
      "end_timestamp": "03:07",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "A small one, under local anaesthetic. First, I'd like to arrange an ultrasound, to check the size and make sure it's what I think.",
      "start_timestamp": "03:39",
      "end_timestamp": "03:50",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Keep the area clean, don't squeeze it, and put a warm flannel on it for ten minutes a few times a day.",
      "start_timestamp": "03:58",
      "end_timestamp": "04:10",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If it turns very red and hot, gets much more painful, starts to ooze pus, or you get a fever, come back that day.",
