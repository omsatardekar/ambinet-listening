  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hi, doctor. Great to see you. I wanted to ask if I can cut down on my tablets, because my sugar numbers at home have been so much better, and I've been exercising, and my wife says I'm a new man, and, well, I thought it was worth asking.",
      "start_timestamp": "00:03",
      "end_timestamp": "00:25",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Good. A bit dizzy now and then, when I stand up quick.",
      "start_timestamp": "00:43",
      "end_timestamp": "00:49",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Anything else?",
      "start_timestamp": "00:53",
      "end_timestamp": "00:55",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hungry between meals. Like clockwork, at eleven.",
      "start_timestamp": "00:58",
      "end_timestamp": "01:03",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you had any low blood sugar episodes, shakes, sweats?",
