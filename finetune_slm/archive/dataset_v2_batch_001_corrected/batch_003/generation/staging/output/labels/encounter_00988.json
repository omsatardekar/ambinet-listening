      "end_timestamp": "02:53",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "A small step. I'd like to reduce your metformin to 500 mg, twice a day.",
      "start_timestamp": "03:20",
      "end_timestamp": "03:29",
      "supports": [
        "medications[0]",
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes, as long as we check. I'd like to arrange an HbA1c in three months, to make sure your sugar stays well controlled.",
      "start_timestamp": "03:39",
      "end_timestamp": "03:52",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And the dizziness when you stand, drink a glass of water first thing, and stand up slowly.",
