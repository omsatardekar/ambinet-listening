        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, nothing like that.",
      "start_timestamp": "01:16",
      "end_timestamp": "01:19",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any allergies?",
      "start_timestamp": "01:38",
      "end_timestamp": "01:40",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hm. I think I had a reaction to some medicine once, a rash, but I can't remember what it was, or when.",
      "start_timestamp": "01:44",
      "end_timestamp": "01:55",
      "supports": [
        "allergies[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'll record it as a possible, unconfirmed allergy. Any other conditions?",
      "start_timestamp": "01:59",
      "end_timestamp": "02:04",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Just the diabetes. Type 2.",
      "start_timestamp": "02:08",
      "end_timestamp": "02:11",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let me take your numbers. Blood pressure 124 over 76, weight 82 kilos.",
      "start_timestamp": "02:23",
      "end_timestamp": "02:30",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's a huge achievement. Any trouble with your heart, palpitations, when you're dizzy?",
      "start_timestamp": "02:40",
      "end_timestamp": "02:46",
      "supports": [
        "review_of_systems[0]"
