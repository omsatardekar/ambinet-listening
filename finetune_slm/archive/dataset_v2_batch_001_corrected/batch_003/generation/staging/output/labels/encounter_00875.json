  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hello. We've been trying for a baby for a year now and nothing has happened, so I wanted to talk about it.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:13",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's fine. Can you tell me about your periods? Are they regular?",
      "start_timestamp": "00:41",
      "end_timestamp": "00:48",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Mostly. Every twenty-eight to thirty days, I'd say.",
      "start_timestamp": "00:50",
      "end_timestamp": "00:55",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any pain with the periods, or with intercourse?",
      "start_timestamp": "00:56",
      "end_timestamp": "01:01",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Quite painful periods, yes. Intercourse is fine.",
      "start_timestamp": "01:03",
      "end_timestamp": "01:08",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you ever been pregnant before?",
      "start_timestamp": "01:10",
      "end_timestamp": "01:14",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, never. This is the first time we've tried.",
      "start_timestamp": "01:15",
      "end_timestamp": "01:20",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any previous problems with your womb or ovaries, like cysts or fibroids?",
      "start_timestamp": "01:22",
      "end_timestamp": "01:28",
      "supports": [
        "medical_history.family_history[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My mother had fibroids. I've never been told I have any.",
      "start_timestamp": "01:31",
      "end_timestamp": "01:38",
      "supports": [
        "medical_history.family_history[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you smoke, or drink alcohol?",
      "start_timestamp": "01:41",
      "end_timestamp": "01:45",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I don't smoke. I only drink a glass of wine at weekends, that's all.",
      "start_timestamp": "01:47",
      "end_timestamp": "01:55",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_3",
      "speaker_role": "clinical_staff",
      "transcript_text": "Blood pressure 118 over 74, pulse 70, weight 62 kilograms, height 165 centimetres.",
      "start_timestamp": "02:25",
      "end_timestamp": "02:32",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your tummy is soft and not tender, and I don't feel any lumps.",
      "start_timestamp": "02:59",
      "end_timestamp": "03:06",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "There may be several reasons it hasn't happened yet. It could be ovulation, the tubes, the womb, or sperm, and it could be more than one. I can't say which today.",
      "start_timestamp": "03:37",
      "end_timestamp": "03:51",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It might, if there's a condition such as endometriosis, but I wouldn't want to guess without more information.",
      "start_timestamp": "03:59",
      "end_timestamp": "04:08",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "We'll arrange a scan of your pelvis, and blood tests for hormones. Your partner would also need a semen test.",
      "start_timestamp": "04:14",
      "end_timestamp": "04:25",
      "supports": [
        "procedures_and_investigations[0]",
        "procedures_and_investigations[1]",
        "clinical_actions[0]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Try to have intercourse every two to three days through the month, not just around ovulation.",
      "start_timestamp": "04:32",
      "end_timestamp": "04:41",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And please start folic acid, 400 micrograms a day, as soon as you can.",
      "start_timestamp": "04:48",
      "end_timestamp": "04:54",
      "supports": [
        "clinical_actions[3]"
      ]
