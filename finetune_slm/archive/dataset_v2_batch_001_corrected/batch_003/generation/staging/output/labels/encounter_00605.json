      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "G'day. I've got dry eyes and a dry mouth, and it's driving me spare.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:10",
      "supports": [
        "chief_complaint",
