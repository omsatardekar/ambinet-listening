      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Right. How long's that been going on?",
      "start_timestamp": "00:12",
      "end_timestamp": "00:17",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Three months, about.",
      "start_timestamp": "00:19",
      "end_timestamp": "00:22",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Fine. What do you do for work?",
      "start_timestamp": "01:04",
      "end_timestamp": "01:08",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Call centre. I'm on the phone eight hours a day, talking non-stop.",
      "start_timestamp": "01:11",
      "end_timestamp": "01:19",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That'd dry anyone's mouth out, but not usually to this degree. Any history of health problems?",
      "start_timestamp": "01:21",
      "end_timestamp": "01:29",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Underactive thyroid. Years now.",
      "start_timestamp": "01:31",
      "end_timestamp": "01:34",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Okay. How are your joints generally?",
      "start_timestamp": "01:36",
      "end_timestamp": "01:39",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Joints are fine.",
      "start_timestamp": "01:42",
      "end_timestamp": "01:44",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "134 over 82. Pulse 74. Temperature 36.7. Oxygen 98 percent. Breathing 14.",
      "start_timestamp": "02:10",
      "end_timestamp": "02:15",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "All unremarkable. Weight's 68 kilos, too. Now tip your head back for me, open wide.",
      "start_timestamp": "02:27",
      "end_timestamp": "02:34",
      "supports": [
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "The inside of your mouth is dry and sticky, and your tongue's quite smooth and red.",
      "start_timestamp": "02:50",
      "end_timestamp": "02:59",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Now look up. Your eyes are a bit pink along the lids and there's very little moisture.",
      "start_timestamp": "03:06",
      "end_timestamp": "03:16",
      "supports": [
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "So here's my thinking. This looks most likely like Sjogren's syndrome, an autoimmune condition that dries out the glands.",
      "start_timestamp": "03:23",
      "end_timestamp": "03:33",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It's common and very manageable, so try not to worry yet. I can't rule out your thyroid playing a part either, so we keep that in view.",
      "start_timestamp": "03:42",
      "end_timestamp": "03:57",
      "supports": [
        "clinical_assessment[1]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Meantime, sip water through the day, and sugar-free lollies or gum help keep saliva flowing.",
      "start_timestamp": "04:03",
      "end_timestamp": "04:12",
      "supports": [
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Take regular screen breaks at work too. Blinking more often helps the eyes.",
      "start_timestamp": "04:22",
