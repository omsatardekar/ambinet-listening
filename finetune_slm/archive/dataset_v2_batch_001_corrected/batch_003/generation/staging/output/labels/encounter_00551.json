  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Right, Mr Gallagher. The booking note says 'contact of a TB case, wants checking'. Is that why you're here today?",
      "start_timestamp": "00:00",
      "end_timestamp": "00:10",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My father was diagnosed with TB last month. They told us in the hospital, and the nurse there said the family should all get looked at.",
      "start_timestamp": "00:30",
      "end_timestamp": "00:43",
      "supports": [
        "medical_history.family_history[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It's nothing really. I've a bit of a cough, that's all.",
      "start_timestamp": "01:20",
      "end_timestamp": "01:26",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "A bit of a cough. How long have you had it?",
      "start_timestamp": "01:27",
      "end_timestamp": "01:32",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Two weeks, I'd say. It's a dry sort of thing, and it's worse first thing in the morning.",
      "start_timestamp": "01:35",
      "end_timestamp": "01:44",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My voice has gone a bit hoarse, since Monday. The wife says I sound like a corncrake.",
      "start_timestamp": "02:03",
      "end_timestamp": "02:11",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I'm a bit tired in the afternoons, but sure, I'm not twenty any more.",
      "start_timestamp": "02:18",
      "end_timestamp": "02:25",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Maybe so. Have you had any coughing up blood?",
      "start_timestamp": "02:46",
      "end_timestamp": "02:52",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, nothing like that. Not a spot.",
      "start_timestamp": "02:53",
      "end_timestamp": "02:57",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I've an underactive thyroid, years now, and a bit of eczema on my hands. That's the lot of it.",
      "start_timestamp": "03:11",
      "end_timestamp": "03:21",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And for the thyroid, what do you take, and how much? Do you know the dose?",
      "start_timestamp": "03:24",
      "end_timestamp": "03:31",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Levothyroxine, every morning. Maybe 75 micrograms? Or is it 100? I can't mind, to tell you the truth. The chemist fills the little box for me.",
      "start_timestamp": "03:33",
      "end_timestamp": "03:48",
      "supports": [
        "medications[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My appendix out, when I was fifteen. A summer I'll never forget, I missed the whole of the county final.",
      "start_timestamp": "04:00",
      "end_timestamp": "04:10",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_3",
      "speaker_role": "nurse",
      "transcript_text": "Of course, doctor. Blood pressure is 124/80, pulse 78 bpm, temperature 36.9 °C, oxygen saturation 98 %, and respiratory rate 16 breaths/min.",
      "start_timestamp": "04:51",
      "end_timestamp": "05:02",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your throat looks a little red at the back, nothing dramatic. Now take some deep breaths in and out while I listen.",
      "start_timestamp": "05:16",
      "end_timestamp": "05:27",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your chest is clear all over, no crackles, no wheeze, and the air is going in well on both sides.",
      "start_timestamp": "05:43",
      "end_timestamp": "05:54",
      "supports": [
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I think you'll live for a good while yet. What I think is going on, and it is only my working view, is a post-viral cough, a lingering cough after a cold, with the hoarse voice that goes with it.",
      "start_timestamp": "06:00",
      "end_timestamp": "06:21",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Plenty of warm fluids, honey and lemon is as good as anything, and rest your voice. Don't whisper, mind, because whispering strains it more than talking softly.",
      "start_timestamp": "07:25",
      "end_timestamp": "07:38",
      "supports": [
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And if you ever start to cough up blood, or you get fevers and sweats at night, ring the surgery that day, don't wait.",
      "start_timestamp": "07:40",
      "end_timestamp": "07:53",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to see you again in two weeks, to see how the cough and the voice are getting on. The desk will give you a time.",
      "start_timestamp": "08:02",
      "end_timestamp": "08:14",
      "supports": [
        "clinical_actions[2]",
        "follow_up[0]"
      ]
    }
  ],
