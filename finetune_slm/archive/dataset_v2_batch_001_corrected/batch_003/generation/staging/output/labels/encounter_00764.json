  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "nurse",
      "transcript_text": "Doctor, this is Sinead, twenty-three, brought from the main stage by the first aiders. Hot, dizzy, vomiting. She's been in the sun since noon.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:13",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Awful. Dizzy. And my head's pounding. I feel like I'm going to be sick again.",
      "start_timestamp": "00:26",
      "end_timestamp": "00:33",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "When did it start?",
      "start_timestamp": "00:36",
      "end_timestamp": "00:39",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "About an hour ago, in the crowd. I felt my legs go, and everything went spotty.",
      "start_timestamp": "00:40",
      "end_timestamp": "00:49",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any collapse, or did you lose consciousness?",
      "start_timestamp": "01:10",
      "end_timestamp": "01:14",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, I didn't pass out. A friend caught me.",
      "start_timestamp": "01:17",
      "end_timestamp": "01:22",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any chest pain, or palpitations?",
      "start_timestamp": "01:24",
      "end_timestamp": "01:27",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No. Just dizzy and sick.",
      "start_timestamp": "01:29",
      "end_timestamp": "01:33",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you take any regular medicines?",
      "start_timestamp": "01:35",
      "end_timestamp": "01:39",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "The pill, the combined one, every day. And I take cetirizine in the summer, 10 mg.",
      "start_timestamp": "01:41",
      "end_timestamp": "01:50",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_3",
      "speaker_role": "nurse",
      "transcript_text": "Doctor, her obs. Temperature 38.4, pulse 118, blood pressure 98 over 60, oxygen 98 percent, respiratory rate 22.",
      "start_timestamp": "02:07",
      "end_timestamp": "02:17",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your skin is hot and flushed but still sweaty, your mouth is dry, and you're alert and talking sensibly.",
      "start_timestamp": "03:00",
      "end_timestamp": "03:10",
      "supports": [
        "physical_examination[0]",
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Noted. Sinead, I think you've got heat exhaustion, but I can't rule out heat stroke, which is more serious, so we're going to treat you quickly.",
      "start_timestamp": "03:18",
      "end_timestamp": "03:30",
      "supports": [
        "clinical_assessment[0]",
        "clinical_assessment[1]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to check your blood sugar and a blood test, for your kidneys and salts, because heat and dehydration can upset them.",
      "start_timestamp": "04:02",
      "end_timestamp": "04:14",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Sip small amounts of water, and don't have any more alcohol today.",
      "start_timestamp": "04:38",
      "end_timestamp": "04:44",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If you get confused, stop sweating, have a fit, or your temperature keeps going up, tell the nurse straight away.",
      "start_timestamp": "04:51",
      "end_timestamp": "05:02",
      "supports": [
        "clinical_actions[3]"
      ]
    }
