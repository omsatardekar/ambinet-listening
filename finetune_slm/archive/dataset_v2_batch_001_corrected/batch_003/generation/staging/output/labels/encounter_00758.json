  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hello. It's my chest again, doctor. I think it's playing up. More than usual.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:07",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Tell me what's different from your usual.",
      "start_timestamp": "00:10",
      "end_timestamp": "00:14",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I'm coughing up more, a lot more. And it's gone yellowy green. Usually it's clear, or a bit white.",
      "start_timestamp": "00:16",
      "end_timestamp": "00:26",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long has it been like this?",
      "start_timestamp": "00:28",
      "end_timestamp": "00:32",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A week, nearly. Since last Wednesday.",
      "start_timestamp": "00:34",
      "end_timestamp": "00:38",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How much are you bringing up in a day, would you say?",
      "start_timestamp": "00:41",
      "end_timestamp": "00:48",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Half a cupful, maybe. In the morning, mostly.",
      "start_timestamp": "00:50",
      "end_timestamp": "00:55",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you had a fever, or night sweats?",
      "start_timestamp": "00:57",
      "end_timestamp": "01:01",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No fever, I haven't felt hot.",
      "start_timestamp": "01:04",
      "end_timestamp": "01:07",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any blood in the phlegm?",
      "start_timestamp": "01:09",
      "end_timestamp": "01:12",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No blood. It's just yellow and thick.",
      "start_timestamp": "01:15",
      "end_timestamp": "01:19",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And breathless, more than usual?",
      "start_timestamp": "01:22",
      "end_timestamp": "01:25",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A bit, on the stairs. Not at rest.",
      "start_timestamp": "01:27",
      "end_timestamp": "01:31",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any operations?",
      "start_timestamp": "01:48",
      "end_timestamp": "01:50",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Just my adenoids, when I was small, I think. Or maybe my tonsils.",
      "start_timestamp": "01:52",
      "end_timestamp": "01:59",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 88, oxygen 95 percent, temperature 36.9.",
      "start_timestamp": "02:27",
      "end_timestamp": "02:31",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes, crackles at the bottom of both lungs, and a bit of wheeze.",
      "start_timestamp": "03:10",
      "end_timestamp": "03:17",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "A change in your phlegm to yellow-green, more of it, and more breathlessness, fits a flare-up of your bronchiectasis, probably a chest infection on top.",
      "start_timestamp": "03:25",
      "end_timestamp": "03:40",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to send a sample of your phlegm to the lab, to see which germ is growing.",
      "start_timestamp": "03:48",
      "end_timestamp": "03:57",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Keep up your daily physiotherapy, the breathing exercises that clear the phlegm, twice a day, and drink plenty of fluids.",
      "start_timestamp": "04:15",
      "end_timestamp": "04:26",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
