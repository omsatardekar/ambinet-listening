  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Hello, doctor, I'm Beth, I care for Mr Calloway during the day. He's been coughing at meals, and he's frightened to eat.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:14",
      "supports": [
