        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thanks, Beth. Mr Calloway, can you tell me about it?",
      "start_timestamp": "00:17",
      "end_timestamp": "00:23",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It's, well, when I eat, or drink. It goes down the wrong way, and I cough.",
      "start_timestamp": "00:25",
      "end_timestamp": "00:34",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Every meal, doctor. Even a cup of tea.",
      "start_timestamp": "00:37",
      "end_timestamp": "00:42",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Does it feel like food sticks?",
      "start_timestamp": "00:43",
      "end_timestamp": "00:47",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Sometimes, yes. In the throat, like it won't go down.",
      "start_timestamp": "00:50",
      "end_timestamp": "00:56",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How's your voice after you've had a drink?",
      "start_timestamp": "00:59",
      "end_timestamp": "01:03",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "It goes wet and gurgly. You can hear it.",
      "start_timestamp": "01:05",
      "end_timestamp": "01:10",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any weight loss?",
      "start_timestamp": "01:13",
      "end_timestamp": "01:15",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "No, not that I've noticed, we've been giving him milkshakes.",
      "start_timestamp": "01:18",
      "end_timestamp": "01:24",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any chest infections recently?",
      "start_timestamp": "01:26",
      "end_timestamp": "01:29",
      "supports": [
