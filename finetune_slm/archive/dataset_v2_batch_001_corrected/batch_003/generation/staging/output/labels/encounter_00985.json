      ]
    },
    {
      "evidence_id": "EV_025",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let me check your numbers. Pulse 74, blood pressure 138 over 82, temperature 36.7, oxygen 96 percent, breathing 16, weight 66 kilos.",
      "start_timestamp": "03:09",
      "end_timestamp": "03:19",
      "supports": [
