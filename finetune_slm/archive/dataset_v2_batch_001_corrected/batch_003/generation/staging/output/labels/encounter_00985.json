      "speaker_role": "patient",
      "transcript_text": "No. No chest infections.",
      "start_timestamp": "01:30",
      "end_timestamp": "01:33",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What medicines is he taking?",
      "start_timestamp": "01:34",
      "end_timestamp": "01:38",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Levothyroxine, 50 micrograms, every morning. And metoprolol, 25 mg, twice a day, I take both every day.",
      "start_timestamp": "01:38",
      "end_timestamp": "01:47",
      "supports": [
