      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "It's 75 micrograms, Alf, the levothyroxine. And he forgets the evening metoprolol about three times a week.",
