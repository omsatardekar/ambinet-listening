  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Ah, hello doctor. It's this cough of mine, it's been going on forever. Six weeks, near enough.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:10",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Six weeks is a long time, you were right to come. Is it a dry cough or are you bringing anything up?",
      "start_timestamp": "00:12",
      "end_timestamp": "00:22",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Dry, dry as a bone. Nothing comes up at all.",
      "start_timestamp": "00:25",
      "end_timestamp": "00:31",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is it worse at any time of day?",
      "start_timestamp": "00:33",
      "end_timestamp": "00:37",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "At night, mostly. It tickles in my throat when I lie down.",
      "start_timestamp": "00:41",
      "end_timestamp": "00:47",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you had any fever, or been coughing up blood?",
      "start_timestamp": "00:49",
      "end_timestamp": "00:55",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No fever, no blood, thank God.",
      "start_timestamp": "00:57",
      "end_timestamp": "01:01",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And what tablets are you on at the moment?",
      "start_timestamp": "01:04",
      "end_timestamp": "01:09",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Ramipril, 5 mg, once a day, for the blood pressure.",
      "start_timestamp": "01:13",
      "end_timestamp": "01:18",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you. You mentioned blood pressure, is that the only long-term problem?",
      "start_timestamp": "01:22",
      "end_timestamp": "01:28",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "That's the one. Blood pressure, for about eight years.",
      "start_timestamp": "01:31",
      "end_timestamp": "01:36",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Are you a smoker?",
      "start_timestamp": "01:39",
      "end_timestamp": "01:42",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I was, and I still have the odd one if I'm out with the girls.",
      "start_timestamp": "01:45",
      "end_timestamp": "01:54",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Roughly how many would you have in a week?",
      "start_timestamp": "01:57",
      "end_timestamp": "02:02",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Och, not many. Five, maybe six.",
      "start_timestamp": "02:05",
      "end_timestamp": "02:08",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'll arrange a chest X-ray, just to be sure there's nothing in the lungs that I can't hear.",
      "start_timestamp": "03:00",
      "end_timestamp": "03:09",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "There is a possibility that the ramipril is causing it, because dry coughs are a known side effect, but we should check the X-ray first.",
      "start_timestamp": "03:38",
      "end_timestamp": "03:50",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Many people don't. Please don't stop it by yourself, we'll talk after the X-ray.",
      "start_timestamp": "04:00",
      "end_timestamp": "04:07",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
