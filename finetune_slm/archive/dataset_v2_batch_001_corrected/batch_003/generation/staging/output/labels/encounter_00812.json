      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I think my side vision is a bit narrower. I bumped into a door the other day.",
      "start_timestamp": "00:54",
