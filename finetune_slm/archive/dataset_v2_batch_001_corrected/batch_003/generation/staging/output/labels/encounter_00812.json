      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "One drop, in each eye, at night. It's called latanoprost.",
      "start_timestamp": "00:29",
      "end_timestamp": "00:34",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How are your eyes? Any change in your vision?",
