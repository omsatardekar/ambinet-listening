        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How many times would you say you get up?",
      "start_timestamp": "01:09",
      "end_timestamp": "01:14",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Four times, perhaps five, most nights. It's been going on for some weeks now.",
      "start_timestamp": "01:17",
      "end_timestamp": "01:24",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "It's four, I hear him every time. And he's exhausted in the day.",
      "start_timestamp": "01:26",
      "end_timestamp": "01:33",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you. Any burning or stinging when you pass water?",
      "start_timestamp": "01:34",
      "end_timestamp": "01:40",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, there's no burning.",
      "start_timestamp": "01:42",
      "end_timestamp": "01:44",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And any blood in the urine?",
      "start_timestamp": "01:47",
      "end_timestamp": "01:50",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No blood, I've looked.",
      "start_timestamp": "01:51",
      "end_timestamp": "01:54",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let's go through your medicines. Colette, you manage them, don't you?",
      "start_timestamp": "01:57",
      "end_timestamp": "02:03",
      "supports": [
        "medications[0]",
        "medications[1]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "I do. Amlodipine, 10 mg once a day, and tamsulosin, 400 micrograms once a day.",
      "start_timestamp": "02:05",
      "end_timestamp": "02:14",
      "supports": [
        "medications[0]",
        "medications[1]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Forgive me, but I'm quite certain the amlodipine is 5 mg.",
      "start_timestamp": "02:16",
      "end_timestamp": "02:23",
      "supports": [
        "medications[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "It's 10, Mr Ellis. I put it in the box every morning, it's on the label.",
      "start_timestamp": "02:24",
      "end_timestamp": "02:33",
      "supports": [
        "medications[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I can't settle that from here, and I'll note both of your views. We'll check the box and the record. Do you have any allergies?",
      "start_timestamp": "02:35",
      "end_timestamp": "02:48",
      "supports": [
        "allergies[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Penicillin. I came out in a rash, many years ago.",
      "start_timestamp": "02:51",
      "end_timestamp": "02:56",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you. And your wider health?",
      "start_timestamp": "02:59",
