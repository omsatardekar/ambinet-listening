  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It's my sleep, I'm afraid. I'm up and down all night, to the lavatory, and I can't seem to get properly back to sleep.",
