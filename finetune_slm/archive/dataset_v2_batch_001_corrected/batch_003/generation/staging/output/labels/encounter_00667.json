      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Atorvastatin. 40 mg. Nights.",
      "start_timestamp": "02:01",
      "end_timestamp": "02:04",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_3",
      "speaker_role": "nurse",
      "transcript_text": "Observations, doctor. Blood pressure 152 over 94, pulse 102, oxygen 97 percent on air, temperature 36.8, breathing 20 a minute.",
      "start_timestamp": "02:17",
      "end_timestamp": "02:28",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your chest is clear, your heart sounds are normal, but you're pale and clammy.",
      "start_timestamp": "02:58",
      "end_timestamp": "03:06",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your pain, the spread to arm and jaw and the sweating, and the changes on your ECG, make me think it's most likely a heart attack.",
      "start_timestamp": "03:16",
      "end_timestamp": "03:29",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd also like to send a troponin blood test now, to confirm.",
