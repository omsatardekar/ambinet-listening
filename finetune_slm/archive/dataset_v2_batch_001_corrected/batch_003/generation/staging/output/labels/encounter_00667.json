      "end_timestamp": "01:28",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Aspirin. Makes me wheeze.",
      "start_timestamp": "01:30",
