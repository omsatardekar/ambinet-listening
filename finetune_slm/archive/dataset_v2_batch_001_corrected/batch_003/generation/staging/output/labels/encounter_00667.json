    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thanks, Beth. Mr Dalton, I'm Dr Ahmed. Tell me about the pain.",
      "start_timestamp": "00:17",
      "end_timestamp": "00:23",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Chest. Heavy. Like a weight.",
      "start_timestamp": "00:26",
      "end_timestamp": "00:29",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "When did it start, and what were you doing?",
      "start_timestamp": "00:32",
      "end_timestamp": "00:38",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "40 minutes. Mowing the lawn.",
      "start_timestamp": "00:39",
      "end_timestamp": "00:43",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Does it spread anywhere?",
      "start_timestamp": "00:45",
      "end_timestamp": "00:47",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Left arm. And my jaw.",
      "start_timestamp": "00:50",
      "end_timestamp": "00:53",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any sweating or sickness?",
      "start_timestamp": "00:57",
      "end_timestamp": "00:59",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Sweating. Yes. A bit sick.",
      "start_timestamp": "01:03",
      "end_timestamp": "01:06",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any breathlessness?",
