      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you, that's important. Any heart problems before, or other conditions?",
      "start_timestamp": "01:36",
      "end_timestamp": "01:42",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "High cholesterol. And I had a heart scare, years ago. They said it was angina.",
      "start_timestamp": "01:46",
      "end_timestamp": "01:53",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What tablets do you take?",
