  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "nurse",
      "transcript_text": "Doctor, this is Mr Dalton, fifty-eight, sudden crushing chest pain forty minutes ago, ambulance brought him in. ECG's already done, it's on the desk.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:14",
      "supports": [
