  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Hello, Mr Fitzgerald. It's the back, isn't it, and the leg?",
      "start_timestamp": "00:25",
      "end_timestamp": "00:31",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It is, doctor. Lower back, and it runs down the back of my left leg, to the calf, like a hot wire.",
      "start_timestamp": "00:33",
      "end_timestamp": "00:44",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long has that been going on?",
      "start_timestamp": "00:47",
      "end_timestamp": "00:51",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Three weeks. It started after I was lifting sacks of potatoes. I'm a farmer, you see.",
      "start_timestamp": "00:53",
      "end_timestamp": "01:03",
      "supports": [
        "symptoms[0]",
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is it worse sitting, standing, or walking?",
      "start_timestamp": "01:04",
      "end_timestamp": "01:08",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Sitting, mostly. And coughing, or sneezing, that sends a jolt down.",
      "start_timestamp": "01:10",
      "end_timestamp": "01:16",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any numbness, or weakness in the foot?",
      "start_timestamp": "01:19",
      "end_timestamp": "01:23",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A bit of tingling in the toes. But the foot's strong. No weakness.",
      "start_timestamp": "01:25",
      "end_timestamp": "01:31",
      "supports": [
        "symptoms[1]",
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thanks, GrÃ¡inne. Mr Fitzgerald, let's go through the medicines.",
      "start_timestamp": "01:53",
      "end_timestamp": "01:59",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Naproxen, 500 mg twice a day, with food. And paracetamol, 1 gram, four times a day.",
      "start_timestamp": "02:01",
      "end_timestamp": "02:11",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any other conditions?",
