    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes, gentle activity, but no heavy lifting. Staying in bed is worse.",
      "start_timestamp": "04:15",
      "end_timestamp": "04:21",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Keep taking the naproxen with food, and the paracetamol regularly.",
      "start_timestamp": "04:38",
      "end_timestamp": "04:44",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Heat helps, yes. If you develop numbness between your legs, can't control your bladder or bowels, or your foot becomes weak, go to the emergency department right away.",
