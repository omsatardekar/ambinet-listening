    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Hello, Mr Lowe. It's about six weeks since you started the physio and the heel pads. How are the heels?",
      "start_timestamp": "00:50",
      "end_timestamp": "01:03",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A bit better, I think, but not right. I still get this pain at the back of both heels, especially first thing in the morning.",
      "start_timestamp": "01:03",
      "end_timestamp": "01:17",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long does the morning pain last?",
      "start_timestamp": "01:20",
      "end_timestamp": "01:24",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Half an hour, maybe an hour. And then it eases once I'm up and moving. I'm worried it's something nasty.",
      "start_timestamp": "01:25",
      "end_timestamp": "01:37",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you get back stiffness as well, in the morning?",
      "start_timestamp": "01:40",
      "end_timestamp": "01:45",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, my back's fine. No stiffness at all.",
      "start_timestamp": "01:47",
      "end_timestamp": "01:51",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What are you taking at the moment?",
      "start_timestamp": "01:54",
      "end_timestamp": "01:58",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Naproxen, 500 mg, twice a day, with food. It helps a bit.",
      "start_timestamp": "02:01",
      "end_timestamp": "02:08",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Remind me of your other conditions.",
      "start_timestamp": "02:10",
      "end_timestamp": "02:13",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Psoriasis, on my elbows, since my twenties. I had a red, sore eye once, iritis I think they said, two years ago. And acid reflux.",
      "start_timestamp": "02:16",
      "end_timestamp": "02:29",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Tender at the back of both heels, right where the Achilles tendon attaches to the bone, and there's no swelling or redness of the tendons.",
      "start_timestamp": "03:16",
      "end_timestamp": "03:30",
      "supports": [
        "physical_examination[0]",
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Psoriasis, a past inflamed eye, and morning heel pain at the tendon attachments make me think I can't rule out an inflammatory arthritis linked to psoriasis.",
      "start_timestamp": "03:58",
      "end_timestamp": "04:13",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
