  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hello there, doctor. Lovely to meet you. I'm only here because my daughter nagged me, she says I get puffed out.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:12",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It's only when I carry my shopping, you see. Up the hill from the Co-op, two bags, and by the top I've got to stop and catch my breath.",
      "start_timestamp": "00:22",
      "end_timestamp": "00:39",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long has that been happening, would you say?",
      "start_timestamp": "00:40",
      "end_timestamp": "00:45",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Oh, a few months, maybe since the spring. I thought I was just getting old. I'm sixty-eight, you know.",
      "start_timestamp": "00:47",
      "end_timestamp": "00:57",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's not old. Does it ever happen when you're walking without the bags?",
      "start_timestamp": "00:58",
      "end_timestamp": "01:05",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'm sure you have. Any chest pain, or tightness, when you're puffed out?",
      "start_timestamp": "01:24",
      "end_timestamp": "01:31",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No pain, no. Just short of breath.",
      "start_timestamp": "01:34",
      "end_timestamp": "01:37",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And any swelling in your ankles, or waking up at night breathless?",
      "start_timestamp": "01:40",
      "end_timestamp": "01:47",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, I sleep like a log. My ankles are the same as ever.",
      "start_timestamp": "01:50",
      "end_timestamp": "01:56",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. What tablets are you taking at the moment?",
      "start_timestamp": "01:57",
      "end_timestamp": "02:02",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Bisoprolol, 2.5 mg once a day, and ramipril, 5 mg once a day. They're for my blood pressure, I think. Or my heart? One of the two.",
      "start_timestamp": "02:05",
      "end_timestamp": "02:17",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you smoke?",
      "start_timestamp": "02:35",
      "end_timestamp": "02:37",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I gave up in 1998, thank goodness. Twenty a day I was smoking, if you can believe it.",
      "start_timestamp": "02:38",
      "end_timestamp": "02:47",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Just the finger, thanks. Pulse 66 and oxygen 98 percent.",
      "start_timestamp": "03:14",
      "end_timestamp": "03:19",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your lungs are clear, and your heart sounds are normal, no murmur that I can hear.",
      "start_timestamp": "04:09",
      "end_timestamp": "04:17",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Breathlessness when you're carrying a heavy load can come from several things, and from what we have so far, I can't rule out early heart failure yet, though it is only a possibility at this stage.",
      "start_timestamp": "04:27",
      "end_timestamp": "04:44",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It might not be anything much, and I don't want to put a label on it before the tests. I'd like to arrange an echocardiogram, an ultrasound of your heart.",
      "start_timestamp": "04:52",
      "end_timestamp": "05:07",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Exactly the same machine, yes. And I'd like to take a blood test to check a heart strain marker and your kidney function, since you're on ramipril.",
      "start_timestamp": "05:14",
      "end_timestamp": "05:27",
      "supports": [
        "procedures_and_investigations[1]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Not stop, but take it in smaller loads, and rest at the postbox if you need to.",
      "start_timestamp": "05:49",
      "end_timestamp": "05:58",
      "supports": [
        "clinical_actions[2]"
      ]
    }
