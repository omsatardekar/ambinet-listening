      "end_timestamp": "00:46",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long has it been going on?",
      "start_timestamp": "00:47",
      "end_timestamp": "00:52",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Oh, a good while. Months. Maybe since I changed my tablets, or since my holiday, I really can't say when it started.",
      "start_timestamp": "00:54",
      "end_timestamp": "01:07",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any fainting?",
      "start_timestamp": "01:09",
      "end_timestamp": "01:11",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
