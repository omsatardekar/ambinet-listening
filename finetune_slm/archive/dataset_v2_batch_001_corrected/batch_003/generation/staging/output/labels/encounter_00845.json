        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Fine. Your pulse is slow, which fits with the bisoprolol. So here's what I think. Your pressure is on the low side, and it drops when you stand, so I'd say this is mild postural low blood pressure, helped along by the bisoprolol and not enough fluid.",
      "start_timestamp": "04:49",
      "end_timestamp": "05:16",
      "supports": [
