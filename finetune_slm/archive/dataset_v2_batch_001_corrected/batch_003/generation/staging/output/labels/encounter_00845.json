        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Drink two litres of water a day, add a little more salt to your food, and stand up slowly, sit on the edge of the bed first.",
      "start_timestamp": "05:21",
      "end_timestamp": "05:38",
      "supports": [
        "clinical_actions[4]"
      ]
    },
    {
      "evidence_id": "EV_024",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to arrange a blood test for your blood count and thyroid, and a heart tracing, an ECG, and I'd like to review whether you still need the bisoprolol at that dose.",
      "start_timestamp": "05:45",
      "end_timestamp": "06:01",
      "supports": [
        "procedures_and_investigations[0]",
