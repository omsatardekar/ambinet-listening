    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Temperature 36.4, oxygen 99 percent.",
      "start_timestamp": "04:42",
      "end_timestamp": "04:45",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
