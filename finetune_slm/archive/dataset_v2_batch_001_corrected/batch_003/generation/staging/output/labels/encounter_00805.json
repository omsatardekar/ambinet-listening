    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Fine. Any breathlessness or chest tightness?",
      "start_timestamp": "02:49",
      "end_timestamp": "02:52",
