  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hello. I've been told my potassium's high, after the new tablet, and to come and see you. I'm trying to remember what the new tablet is.",
