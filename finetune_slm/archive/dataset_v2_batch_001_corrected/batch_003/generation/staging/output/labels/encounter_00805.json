      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, none.",
      "start_timestamp": "02:55",
      "end_timestamp": "02:57",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your potassium was 5.9, and normal is up to 5.0. It's likely the ramipril, plus the salt substitute, on top of kidney disease. I'd say this is a raised potassium caused by the new tablet and the salt substitute.",
      "start_timestamp": "03:00",
      "end_timestamp": "03:23",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "At 5.9, it needs attention. Above 6.5 it can affect the heart. So I'd like to stop the salt substitute straight away, and avoid the ibuprofen completely.",
      "start_timestamp": "03:31",
      "end_timestamp": "03:45",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And I'm going to ask you to stop the ramipril for now, until we recheck the potassium.",
      "start_timestamp": "03:54",
      "end_timestamp": "04:03",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'll have the nurse take a repeat blood test today.",
      "start_timestamp": "04:10",
      "end_timestamp": "04:17",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Eat a normal diet, but go easy on bananas, oranges and potatoes for now.",
      "start_timestamp": "04:23",
      "end_timestamp": "04:30",
      "supports": [
        "clinical_actions[4]"
      ]
    },
    {
