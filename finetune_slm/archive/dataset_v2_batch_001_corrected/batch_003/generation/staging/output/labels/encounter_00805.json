    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Chronic kidney disease, diabetes, and high blood pressure.",
      "start_timestamp": "01:38",
      "end_timestamp": "01:42",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 66 and regular, blood pressure 132 over 78, temperature 36.6, oxygen 98 percent.",
      "start_timestamp": "02:33",
      "end_timestamp": "02:41",
      "supports": [
        "vital_signs[0]",
