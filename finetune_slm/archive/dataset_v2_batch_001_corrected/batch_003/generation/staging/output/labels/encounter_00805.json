      "end_timestamp": "00:16",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let's go through your medicines. What's the new one?",
      "start_timestamp": "00:17",
      "end_timestamp": "00:22",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Ramipril, 2.5 mg, once a day. It's for my kidneys. And the old one is the amlodipine, 5 mg.",
      "start_timestamp": "00:25",
      "end_timestamp": "00:34",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How have you been since starting the ramipril?",
      "start_timestamp": "00:37",
      "end_timestamp": "00:42",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Tired. And my legs are a bit weak, and my heart skips. Not often.",
      "start_timestamp": "00:45",
      "end_timestamp": "00:54",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
