  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Thank you. Come, Dev. Doctor, we're back about the nosebleeds.",
      "start_timestamp": "00:09",
      "end_timestamp": "00:14",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "A little better, doctor. But he still gets them, two or three a week, mostly in the morning.",
      "start_timestamp": "00:30",
      "end_timestamp": "00:39",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long does each one last?",
      "start_timestamp": "00:41",
      "end_timestamp": "00:46",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Ten minutes, sometimes more, doctor. He holds a tissue and it keeps coming.",
      "start_timestamp": "00:51",
      "end_timestamp": "00:59",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Dev, do you pick your nose?",
      "start_timestamp": "01:00",
      "end_timestamp": "01:04",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "He does. I tell him, but he forgets.",
      "start_timestamp": "01:11",
      "end_timestamp": "01:15",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is the cream helping? You're putting it on every day?",
      "start_timestamp": "01:17",
      "end_timestamp": "01:22",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Twice a day, the nasal cream. We've used it for two weeks.",
      "start_timestamp": "01:23",
      "end_timestamp": "01:30",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any bruising on his body that you've noticed, or bleeding gums?",
      "start_timestamp": "01:32",
      "end_timestamp": "01:39",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "No, nothing like that. His gums are fine. No bruises beyond the football.",
      "start_timestamp": "01:41",
      "end_timestamp": "01:48",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Hay fever, perhaps?",
      "start_timestamp": "02:00",
      "end_timestamp": "02:02",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Yes, he has hay fever, every summer. He rubs his nose a lot.",
      "start_timestamp": "02:04",
      "end_timestamp": "02:11",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_4",
      "speaker_role": "clinical_staff",
      "transcript_text": "Temperature 36.7, pulse 88, blood pressure 102 over 64, oxygen 99 percent, respiratory rate 20.",
      "start_timestamp": "02:28",
      "end_timestamp": "02:36",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to check a blood count and a clotting screen, to make sure his blood clots normally.",
      "start_timestamp": "03:42",
      "end_timestamp": "03:53",
      "supports": [
        "procedures_and_investigations[0]",
        "procedures_and_investigations[1]",
        "clinical_actions[0]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Keep the cream going, twice a day, and keep his nails short. A little petroleum jelly inside the nose at night helps keep it moist.",
      "start_timestamp": "04:17",
      "end_timestamp": "04:30",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Sit up, lean forward, pinch the soft part for ten minutes without letting go. If it lasts more than twenty minutes, or he's pale or drowsy, come in straight away.",
      "start_timestamp": "04:37",
      "end_timestamp": "04:53",
      "supports": [
        "clinical_actions[4]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And if the blood tests show anything unusual, we'll call you in.",
      "start_timestamp": "04:59",
      "end_timestamp": "05:05",
      "supports": [
        "clinical_actions[2]",
        "follow_up[0]"
      ]
    }
