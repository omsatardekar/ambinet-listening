  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Doctor, my mother-in-law has her days and nights mixed up. She's awake all night and sleeping all day, and we're all worn out.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:12",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That sounds exhausting for everyone. Mrs Banerjee, how do you feel about your sleep?",
      "start_timestamp": "00:13",
      "end_timestamp": "00:21",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "She wanders around the house at three in the morning, turning lights on.",
      "start_timestamp": "00:30",
      "end_timestamp": "00:37",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long has it been going on?",
      "start_timestamp": "00:39",
      "end_timestamp": "00:43",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Since she came out of hospital, about a month ago.",
      "start_timestamp": "00:46",
      "end_timestamp": "00:52",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is she confused at night, or does she know where she is?",
      "start_timestamp": "00:54",
      "end_timestamp": "01:00",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Sometimes she thinks she's back in her old house, and she asks for people who passed away.",
      "start_timestamp": "01:03",
      "end_timestamp": "01:12",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Has she had any falls, or bumped herself?",
      "start_timestamp": "01:22",
      "end_timestamp": "01:26",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "No falls. Thank goodness.",
      "start_timestamp": "01:27",
      "end_timestamp": "01:30",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any pain, fever or changes in her passing urine?",
      "start_timestamp": "01:32",
      "end_timestamp": "01:37",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "No, nothing like that.",
      "start_timestamp": "01:38",
      "end_timestamp": "01:41",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What medicines is she taking?",
      "start_timestamp": "01:44",
      "end_timestamp": "01:47",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Just the blood pressure tablet, amlodipine, 5 mg, in the morning.",
      "start_timestamp": "01:49",
      "end_timestamp": "01:54",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any past medical problems?",
      "start_timestamp": "02:11",
      "end_timestamp": "02:13",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "High blood pressure, a mild stroke some years ago, and she had a chest infection in the hospital.",
      "start_timestamp": "02:14",
      "end_timestamp": "02:23",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 78, blood pressure 140 over 82.",
      "start_timestamp": "03:07",
      "end_timestamp": "03:12",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "She is alert, a little muddled about the date, and her chest is clear.",
      "start_timestamp": "03:53",
      "end_timestamp": "04:01",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I can't say that today. A hospital stay can unsettle the body clock, and I'd like to rule out other causes with a blood and urine test.",
      "start_timestamp": "04:07",
      "end_timestamp": "04:20",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Today, if you can wait. And the first step is routine, so open the curtains in the morning, and get her out in daylight.",
      "start_timestamp": "04:27",
      "end_timestamp": "04:39",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'll see her again in three weeks, and we'll see if the pattern has shifted.",
