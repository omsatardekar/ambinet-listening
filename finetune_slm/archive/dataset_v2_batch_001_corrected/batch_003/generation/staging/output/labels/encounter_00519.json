  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Mr. Dombrowski, come on in. I've got the letter from the clinic after your last COPD review here on the screen, and the nurse said you wanted to add something today.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:17",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "Yeah. I coughed up some blood.",
      "start_timestamp": "00:18",
      "end_timestamp": "00:21",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "A streak. In the sink, after a coughing fit. Small, like a thread. Just the once.",
      "start_timestamp": "00:35",
      "end_timestamp": "00:43",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "A small streak of blood once. When was that, roughly? Days ago, weeks?",
      "start_timestamp": "00:46",
      "end_timestamp": "00:54",
      "supports": [
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "Not sure. Last week? Or the week before. I really can't say.",
      "start_timestamp": "00:57",
      "end_timestamp": "01:02",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "No. It's gone. Hasn't come back.",
      "start_timestamp": "01:12",
      "end_timestamp": "01:15",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Good. And your usual cough, the one we've discussed before, is that any different from normal?",
      "start_timestamp": "01:16",
      "end_timestamp": "01:24",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "Same as always. Worse in the morning. I bring up some phlegm, then it eases off.",
      "start_timestamp": "01:25",
      "end_timestamp": "01:34",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "The tiotropium. 18 micrograms, once a day, in the morning. And the lisinopril, maybe 10 mg? I'd have to check the box.",
      "start_timestamp": "02:08",
      "end_timestamp": "02:19",
      "supports": [
        "medications[0]",
        "medications[1]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Maybe 10 milligrams for the lisinopril, and we'll check the box. Anything else, like a rescue inhaler?",
      "start_timestamp": "02:20",
      "end_timestamp": "02:30",
      "supports": [
        "medications[1]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "That's a real improvement, good. Now, I noticed you've given up smoking. Remind me of the history?",
      "start_timestamp": "02:59",
      "end_timestamp": "03:08",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "Quit eight years ago. Smoked a pack a day for thirty years before that.",
      "start_timestamp": "03:09",
      "end_timestamp": "03:16",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "A pack a day for thirty years, and you stopped eight years ago. That took willpower. How's your chest and heart otherwise? Any chest pain or swelling in your legs?",
      "start_timestamp": "03:18",
      "end_timestamp": "03:32",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "No. Nothing like that. Heart's fine.",
      "start_timestamp": "03:35",
      "end_timestamp": "03:38",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Good. And I have to ask, are you allergic to any medicines? It's on the record, but I want to double-check it.",
      "start_timestamp": "03:41",
      "end_timestamp": "03:54",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "Sulfa drugs. They give me hives. Big welts all over.",
      "start_timestamp": "03:54",
      "end_timestamp": "04:00",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "I can hear a bit of wheeze on both sides, more at the bottom, which is in keeping with what you've had before. Now your neck, just to check.",
      "start_timestamp": "04:48",
      "end_timestamp": "05:05",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "The glands. There are no enlarged lymph nodes, nothing lumpy. That's good news.",
      "start_timestamp": "05:21",
      "end_timestamp": "05:28",
      "supports": [
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "I don't want to guess too much from one streak. In someone with your lung history, it could be irritation from all the coughing, but I can't rule out an infection, or something more serious in the lung yet.",
      "start_timestamp": "05:37",
      "end_timestamp": "05:56",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Here's the plan. I'd like to see you back in two weeks, and by then we'll know if it has come back or not. I'll go through everything with you properly then.",
      "start_timestamp": "06:23",
      "end_timestamp": "06:39",
      "supports": [
        "clinical_actions[1]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Keep a note of anything you cough up, how much, and what colour. If you see more blood than a streak, or you get short of breath suddenly, come to the emergency department straight away, don't wait for the appointment.",
      "start_timestamp": "06:45",
      "end_timestamp": "07:05",
      "supports": [
        "clinical_actions[0]"
      ]
    }
