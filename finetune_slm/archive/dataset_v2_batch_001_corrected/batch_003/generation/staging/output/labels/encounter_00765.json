  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Morning, doctor. I'm Ellie, Mr Rowe's carer. He's had the runs since the camping trip, and I can't get him to eat.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:11",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thanks, Ellie. Mr Rowe, how long have you had the diarrhoea?",
      "start_timestamp": "00:13",
      "end_timestamp": "00:20",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Four days. Since Saturday.",
      "start_timestamp": "00:22",
      "end_timestamp": "00:25",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "It's ten days, Mr Rowe. You told me the day after we got back from the lakes.",
      "start_timestamp": "00:26",
      "end_timestamp": "00:35",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "So four days from you and ten from Ellie. I'll put it down as four to ten days. How often are you going?",
      "start_timestamp": "00:38",
      "end_timestamp": "00:51",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Five, six times a day. Watery.",
      "start_timestamp": "00:53",
      "end_timestamp": "00:57",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you been sick? Any vomiting?",
      "start_timestamp": "01:00",
      "end_timestamp": "01:04",
      "supports": [
        "symptoms[1]",
        "negative_findings[0]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No. Not sick.",
      "start_timestamp": "01:06",
      "end_timestamp": "01:09",
      "supports": [
        "negative_findings[0]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "He was sick on the Sunday, twice, in the tent. I held the bucket.",
      "start_timestamp": "01:10",
      "end_timestamp": "01:17",
      "supports": [
        "symptoms[1]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'll note that you each said different things about that. Any blood in the stool, or black stools?",
      "start_timestamp": "01:20",
      "end_timestamp": "01:29",
      "supports": [
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Okay. Any health conditions?",
      "start_timestamp": "02:06",
      "end_timestamp": "02:09",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Type 2 diabetes.",
      "start_timestamp": "02:11",
      "end_timestamp": "02:14",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Anyone in the family with bowel problems?",
      "start_timestamp": "02:16",
      "end_timestamp": "02:21",
      "supports": [
        "medical_history.family_history[0]",
        "clinical_actions[1]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My brother has colitis.",
      "start_timestamp": "02:22",
      "end_timestamp": "02:25",
      "supports": [
        "medical_history.family_history[0]",
        "clinical_actions[1]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 92, blood pressure 118 over 70, temperature 37.8, oxygen 97 percent, weight 74 kilos.",
      "start_timestamp": "02:52",
      "end_timestamp": "02:59",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Soft, with some tenderness around the belly button, no guarding, and your mouth is a little dry.",
      "start_timestamp": "03:30",
      "end_timestamp": "03:39",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Not at this stage. Persistent diarrhoea after drinking stream water makes me think of a parasite, giardia, but I'm not going to put a name on it until we test.",
      "start_timestamp": "03:48",
      "end_timestamp": "04:05",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like you to bring a stool sample, in the pot I'll give you, so we can test for infections.",
      "start_timestamp": "04:11",
      "end_timestamp": "04:21",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Drink lots of water with a pinch of salt and sugar, little and often, and eat plain food.",
      "start_timestamp": "04:28",
      "end_timestamp": "04:37",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "As you have diabetes, check your sugars more often while you're unwell.",
      "start_timestamp": "04:42",
      "end_timestamp": "04:49",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to see you again in a week, with the results.",
      "start_timestamp": "04:55",
