  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hello, doctor. I can't smell anything. It's the strangest thing. Nothing. I had a cold in September and it never came back.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:12",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long has it been?",
      "start_timestamp": "00:15",
      "end_timestamp": "00:18",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Eleven weeks. I counted, because I'm a chef, and it's a nightmare. I can't taste, either. Everything tastes of cardboard.",
      "start_timestamp": "00:20",
      "end_timestamp": "00:30",
      "supports": [
        "symptoms[0]",
        "symptoms[1]",
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is your nose blocked as well?",
      "start_timestamp": "00:33",
      "end_timestamp": "00:36",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A bit, on the left, on and off. And a bit of post-nasal drip.",
      "start_timestamp": "00:38",
      "end_timestamp": "00:46",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any fever, or pain in your face?",
      "start_timestamp": "00:48",
      "end_timestamp": "00:52",
      "supports": [
        "negative_findings[0]",
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No fever, and no face pain.",
      "start_timestamp": "00:54",
      "end_timestamp": "00:57",
      "supports": [
        "negative_findings[0]",
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any bang on the head before this started?",
      "start_timestamp": "00:59",
      "end_timestamp": "01:04",
      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No. I'd have remembered that. Oh, did I mention I've lost my keys?",
      "start_timestamp": "01:07",
      "end_timestamp": "01:14",
      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let's stick with the nose for now. What do you use for it?",
      "start_timestamp": "01:18",
      "end_timestamp": "01:26",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A steroid nasal spray, fluticasone, two sprays each nostril once a day, and cetirizine, 10 mg, for my hay fever.",
      "start_timestamp": "01:28",
      "end_timestamp": "01:39",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you have any other conditions?",
      "start_timestamp": "01:42",
      "end_timestamp": "01:46",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hay fever, as I said, and asthma.",
      "start_timestamp": "01:47",
      "end_timestamp": "01:52",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any previous nose operations?",
      "start_timestamp": "01:54",
      "end_timestamp": "01:56",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, my septum was straightened. Septoplasty. In 2015.",
      "start_timestamp": "01:59",
      "end_timestamp": "02:03",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you smoke?",
      "start_timestamp": "02:05",
      "end_timestamp": "02:08",
      "supports": [
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I gave up four years ago. Twenty a day, for years, before that.",
      "start_timestamp": "02:11",
      "end_timestamp": "02:18",
      "supports": [
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 70, blood pressure 124 over 80, temperature 36.6, oxygen 99 percent, breathing 14 a minute.",
      "start_timestamp": "02:48",
      "end_timestamp": "02:56",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any wheeze or breathlessness, with the asthma?",
      "start_timestamp": "03:03",
      "end_timestamp": "03:08",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, the asthma's quiet. No wheeze.",
      "start_timestamp": "03:10",
      "end_timestamp": "03:13",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to arrange a smell identification test, where you sniff a set of scratch-and-sniff cards.",
      "start_timestamp": "03:42",
      "end_timestamp": "03:50",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And I'd like to arrange a CT scan of your sinuses, to check there's no blockage.",
      "start_timestamp": "03:57",
      "end_timestamp": "04:07",
      "supports": [
        "procedures_and_investigations[1]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Often not. Smell training, sniffing four strong scents twice a day, like rose, lemon, clove and eucalyptus, helps nerves recover.",
      "start_timestamp": "04:13",
      "end_timestamp": "04:24",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_024",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Perfect. Keep using the nasal spray, and make sure your smoke and gas alarms are working, since you can't smell a leak.",
      "start_timestamp": "04:35",
      "end_timestamp": "04:45",
      "supports": [
        "clinical_actions[4]"
      ]
    },
    {
      "evidence_id": "EV_025",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to see you again in four weeks, after the tests.",
      "start_timestamp": "04:53",
      "end_timestamp": "04:59",
      "supports": [
        "clinical_actions[2]",
        "follow_up[0]"
      ]
