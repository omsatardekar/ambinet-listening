  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Honestly, not great. I've been worrying myself sick since you said the word pre-diabetes. Does that mean I'm definitely going to get diabetes?",
      "start_timestamp": "00:33",
      "end_timestamp": "00:45",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Um, a bit tired, I suppose. Wiped out by mid-afternoon, which isn't like me at all.",
      "start_timestamp": "02:12",
      "end_timestamp": "02:21",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Mm. And how long has the tiredness been hanging around?",
      "start_timestamp": "02:22",
      "end_timestamp": "02:28",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "About two weeks, I'd say. It started just before the blood test.",
      "start_timestamp": "02:30",
      "end_timestamp": "02:36",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Oh, it's longer than that, love. It's been three weeks at least. You fell asleep in front of the footy the Saturday before your mum's birthday.",
      "start_timestamp": "02:37",
      "end_timestamp": "02:51",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "So somewhere between two and three weeks, then. We'll call it that and not argue over the calendar.",
      "start_timestamp": "03:02",
      "end_timestamp": "03:11",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Now, have you been unusually thirsty, or getting up in the night to pass water?",
      "start_timestamp": "03:14",
      "end_timestamp": "03:21",
      "supports": [
        "negative_findings[0]",
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, nothing like that. I'm not up in the night at all, and I'm not thirsty any more than usual.",
      "start_timestamp": "03:22",
      "end_timestamp": "03:32",
      "supports": [
        "negative_findings[0]",
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Blood pressure is 132 over 84, which is fine, just a touch on the upper side. And you're 86 kilograms on the scales.",
      "start_timestamp": "03:58",
      "end_timestamp": "04:12",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's exactly the right question. From what we have so far, this looks like pre-diabetes, and it's been caught early, which is the best time to catch it.",
      "start_timestamp": "04:36",
      "end_timestamp": "04:49",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "For many people, yes. Steady changes make the biggest difference. Walking for thirty minutes most days, and swapping sugary drinks for water. Nothing drastic.",
      "start_timestamp": "04:57",
      "end_timestamp": "05:09",
      "supports": [
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Lovely, that's a team effort. Now, I'd like to see you again in three months so we can see how things are travelling.",
      "start_timestamp": "06:07",
      "end_timestamp": "06:19",
      "supports": [
