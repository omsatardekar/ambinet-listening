  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Doctor, I'm so worried. I've not wanted any food and I've lost weight, and I don't know what's happening to me.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:12",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you, Dee, that's helpful. Mr Okonkwo, let me check I have it right. You're not wanting food and you've lost weight.",
      "start_timestamp": "00:38",
      "end_timestamp": "00:50",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'll tell you everything as I learn it. First, how long has the appetite been poor?",
      "start_timestamp": "00:59",
      "end_timestamp": "01:08",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "About three weeks. He leaves nearly the whole plate, and he used to love his stew.",
      "start_timestamp": "01:11",
      "end_timestamp": "01:19",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Three weeks, yes, it sounds right. Though it feels longer.",
      "start_timestamp": "01:22",
      "end_timestamp": "01:29",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And the weight. When did you first notice that?",
      "start_timestamp": "01:31",
      "end_timestamp": "01:36",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Oh, I couldn't tell you. My trousers were loose one day and I couldn't say when it began.",
      "start_timestamp": "01:37",
      "end_timestamp": "01:46",
      "supports": [
        "symptoms[1]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "His belt's gone in two holes, but I only started keeping an eye on it recently, so I can't give a date either.",
      "start_timestamp": "01:54",
      "end_timestamp": "02:06",
      "supports": [
        "symptoms[1]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "And I'm very tired, doctor. Very tired, all day, even after sleeping.",
      "start_timestamp": "02:17",
      "end_timestamp": "02:25",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Very tired all day. Noted. Any vomiting?",
      "start_timestamp": "02:26",
      "end_timestamp": "02:30",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No vomiting.",
      "start_timestamp": "02:33",
      "end_timestamp": "02:34",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And does it hurt when you swallow food?",
      "start_timestamp": "02:35",
      "end_timestamp": "02:40",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, no, swallowing's fine. I just don't fancy anything.",
      "start_timestamp": "02:43",
      "end_timestamp": "02:48",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Bisoprolol. 2.5 mg, every morning. I give it to him myself.",
      "start_timestamp": "03:04",
      "end_timestamp": "03:10",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Bisoprolol, 2.5 mg every morning. Any other long-term problems?",
      "start_timestamp": "03:12",
      "end_timestamp": "03:17",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "High blood pressure. Years and years.",
      "start_timestamp": "03:20",
      "end_timestamp": "03:24",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Right. Do you have any allergies to medicines?",
      "start_timestamp": "03:25",
      "end_timestamp": "03:30",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Oh dear. I think I came out in something once, years ago, after an antibiotic. But I can't remember which one, or what happened.",
      "start_timestamp": "03:32",
      "end_timestamp": "03:44",
      "supports": [
        "allergies[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Not at all, it's simply a precaution. Now, you live on your own, I believe?",
      "start_timestamp": "04:03",
      "end_timestamp": "04:12",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, since my wife passed. The house is very quiet, you know.",
      "start_timestamp": "04:14",
      "end_timestamp": "04:22",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Blood pressure 108 over 64. Pulse 96. Temperature 36.9. Oxygen 97 percent. Breathing 16. And your weight is 58 kilos.",
      "start_timestamp": "04:57",
      "end_timestamp": "05:07",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]",
        "vital_signs[5]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your mouth is rather dry. Now let me press your tummy. Tell me if it hurts.",
      "start_timestamp": "05:59",
      "end_timestamp": "06:09",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your tummy is soft and not tender. That's a good sign.",
      "start_timestamp": "06:16",
      "end_timestamp": "06:24",
      "supports": [
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_024",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "What do you think it is, doctor? Is it cancer?",
      "start_timestamp": "06:25",
      "end_timestamp": "06:31",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_025",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I understand why you ask. I don't want to guess about that today. What I think most likely is that you're mildly dehydrated because you've hardly been eating or drinking.",
      "start_timestamp": "06:31",
      "end_timestamp": "06:48",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_026",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It can. So we'll deal with it in steps. Today I'd like to order some blood tests, to check your kidneys, salts and blood count.",
      "start_timestamp": "06:54",
      "end_timestamp": "07:06",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_027",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes, please do. I'd also like to arrange a chest X-ray at the same time, since we're checking everything.",
      "start_timestamp": "07:14",
      "end_timestamp": "07:25",
      "supports": [
        "procedures_and_investigations[1]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_028",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I do. In the meantime, Dee, small sips of fluid through the day, and little snacks rather than big plates.",
      "start_timestamp": "07:49",
      "end_timestamp": "08:00",
      "supports": [
        "clinical_actions[2]"
      ]
