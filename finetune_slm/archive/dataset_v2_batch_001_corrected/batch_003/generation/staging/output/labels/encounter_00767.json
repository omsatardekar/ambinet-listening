  "clinical_uncertainties": [],
  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "nurse",
      "transcript_text": "Hi Jess, I'm Dana, the nurse. I did your urine dip when you came in, and I'll pass that to the doctor.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:12",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Hello Jess. It's the urine infections again. Tell me what's different this time.",
      "start_timestamp": "00:25",
      "end_timestamp": "00:33",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "The usual, burning when I pee, going all the time, and a dull ache low down. It started on Monday.",
      "start_timestamp": "00:37",
      "end_timestamp": "00:46",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_3",
      "speaker_role": "nurse",
      "transcript_text": "The dip showed leucocytes and nitrites, doctor, both positive.",
      "start_timestamp": "00:50",
      "end_timestamp": "00:55",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thanks, Dana. Jess, any fever, back pain, or blood in the urine?",
      "start_timestamp": "00:57",
      "end_timestamp": "01:04",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No fever. No back pain. A tiny bit of blood, I think, yesterday.",
      "start_timestamp": "01:06",
      "end_timestamp": "01:12",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What do you drink, how much fluid in a day?",
      "start_timestamp": "01:28",
      "end_timestamp": "01:33",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "About a litre, I think. Mostly coffee, to be honest.",
      "start_timestamp": "01:36",
      "end_timestamp": "01:42",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "A little tender over the bladder, and no tenderness over the kidneys.",
      "start_timestamp": "02:34",
      "end_timestamp": "02:41",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It fits with a bladder infection again. But with four in six months, I can't rule out something that makes you prone to them, like a stone, or a problem with emptying the bladder.",
      "start_timestamp": "02:50",
      "end_timestamp": "03:07",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to send a urine sample off to the lab, to grow the germ and see which antibiotic works.",
      "start_timestamp": "03:15",
      "end_timestamp": "03:26",
      "supports": [
        "procedures_and_investigations[1]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And I'd like to arrange a kidney and bladder ultrasound, to look for a cause.",
      "start_timestamp": "03:35",
      "end_timestamp": "03:43",
      "supports": [
        "procedures_and_investigations[2]",
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'll write that up when the lab has answered, because I want to choose the right drug, so drink plenty of water now, and a glass every hour.",
      "start_timestamp": "04:08",
      "end_timestamp": "04:22",
      "supports": [
        "clinical_actions[4]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Empty your bladder fully, wipe front to back, and go as soon as you need to, even at work.",
      "start_timestamp": "04:29",
      "end_timestamp": "04:41",
      "supports": [
        "clinical_actions[5]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If you get a fever, shaking, or back pain, come in the same day, because that could mean the kidneys.",
      "start_timestamp": "04:50",
      "end_timestamp": "05:00",
      "supports": [
        "clinical_actions[3]",
        "follow_up[0]"
      ]
    }
