    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thanks, they're my pride and joy. What kind of things are you forgetting?",
      "start_timestamp": "00:21",
