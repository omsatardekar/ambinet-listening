    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes. So you recalled all three, but needed a hint for one, and you were out by one day on the date.",
      "start_timestamp": "03:43",
      "end_timestamp": "03:55",
      "supports": [
        "physical_examination[0]"
