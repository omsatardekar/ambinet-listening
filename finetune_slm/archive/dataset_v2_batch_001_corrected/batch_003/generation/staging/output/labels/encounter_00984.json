        "clinical_assessment[1]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'm not saying that. It's early days. I'd like to arrange blood tests, including vitamin B12 and thyroid, since both can affect memory.",
      "start_timestamp": "04:34",
      "end_timestamp": "04:45",
      "supports": [
        "procedures_and_investigations[0]",
