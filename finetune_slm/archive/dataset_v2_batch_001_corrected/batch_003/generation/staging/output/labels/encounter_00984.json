      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And I'd like to arrange a proper memory assessment at the memory clinic.",
      "start_timestamp": "04:50",
      "end_timestamp": "04:58",
      "supports": [
        "procedures_and_investigations[1]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "A few weeks. And I'd like to start vitamin B12, 1000 micrograms, once a day, in the meantime.",
