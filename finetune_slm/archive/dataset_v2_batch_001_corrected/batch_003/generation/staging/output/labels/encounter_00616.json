  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Just the usual health check the company pays for. Oh, and my headaches keep coming back, by the way.",
      "start_timestamp": "00:22",
      "end_timestamp": "00:33",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Tell me about them.",
      "start_timestamp": "00:34",
      "end_timestamp": "00:37",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Tight, like a band round my forehead. Mostly late afternoon at my desk.",
      "start_timestamp": "00:38",
      "end_timestamp": "00:45",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long has that been going on, and how bad do they get?",
      "start_timestamp": "00:47",
      "end_timestamp": "00:54",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "About three months. Mild, honestly. It's more of a nuisance than anything.",
      "start_timestamp": "00:57",
      "end_timestamp": "01:04",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any nausea with them, or changes in your vision?",
      "start_timestamp": "01:05",
      "end_timestamp": "01:10",
      "supports": [
        "negative_findings[0]",
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No nausea, and my vision's fine. Sleep's fine too, before you ask.",
      "start_timestamp": "01:12",
      "end_timestamp": "01:19",
      "supports": [
        "negative_findings[0]",
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. Any tablets you take regularly?",
      "start_timestamp": "01:22",
      "end_timestamp": "01:26",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Candesartan, 8 mg once a day, for my high blood pressure.",
      "start_timestamp": "01:28",
      "end_timestamp": "01:35",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And are you allergic to anything, medicines especially?",
      "start_timestamp": "01:38",
      "end_timestamp": "01:43",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Penicillin. Came up in a rash when I was a kid, so they've kept it off my list ever since.",
      "start_timestamp": "01:44",
      "end_timestamp": "01:56",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thanks. Any heart disease or strokes in the family?",
      "start_timestamp": "01:58",
      "end_timestamp": "02:03",
      "supports": [
        "medical_history.family_history[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Dad had a heart attack at sixty. That's really why I come for these checks every year.",
      "start_timestamp": "02:06",
      "end_timestamp": "02:16",
      "supports": [
        "medical_history.family_history[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Blood pressure 128 over 80, pulse 68, temperature 36.6, oxygen 98 percent, and you're 84 kilos.",
      "start_timestamp": "02:55",
      "end_timestamp": "03:04",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "All right indeed. Any cough, wheeze or breathlessness when you're active?",
      "start_timestamp": "03:10",
      "end_timestamp": "03:16",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, nothing. I run on Saturdays and have no trouble at all.",
      "start_timestamp": "03:18",
      "end_timestamp": "03:24",
      "supports": [
        "medical_history.social_history[0]",
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any chest pain, palpitations or ankle swelling?",
      "start_timestamp": "03:26",
      "end_timestamp": "03:30",
      "supports": [
        "review_of_systems[1]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No. None of that.",
      "start_timestamp": "03:31",
      "end_timestamp": "03:34",
      "supports": [
        "review_of_systems[1]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your shoulders are tight and the neck moves freely. A couple of tender knots across the top, nothing sinister.",
      "start_timestamp": "03:47",
      "end_timestamp": "03:56",
      "supports": [
        "physical_examination[0]",
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Nothing in what you've told me or what I've found sets off any alarm bells. Since you're on candesartan, I'd like to check your cholesterol and kidney function with a blood test too.",
      "start_timestamp": "04:07",
      "end_timestamp": "04:23",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Take a screen break every hour, raise your monitor a little, and drink water through the afternoon. Your shoulders will thank you.",
      "start_timestamp": "04:48",
      "end_timestamp": "04:59",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Not unless they get worse or change in character. If they do, ring the surgery rather than waiting.",
      "start_timestamp": "05:09",
