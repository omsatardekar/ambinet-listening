  "clinical_uncertainties": [],
  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Doctor, please, I have a terrible headache. It came on suddenly, about thirty minutes ago, while I was lifting weights at the gym. It's the worst headache of my life.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:18",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'm taking this very seriously. Where is it?",
      "start_timestamp": "00:21",
      "end_timestamp": "00:25",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "At the back of my head, like a blow. It reached the worst in seconds, I have never had anything like it.",
      "start_timestamp": "00:28",
      "end_timestamp": "00:40",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you have any neck pain or stiffness?",
      "start_timestamp": "00:42",
      "end_timestamp": "00:47",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, my neck is stiff and sore. I can't put my chin down.",
      "start_timestamp": "00:50",
      "end_timestamp": "00:57",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you feel sick?",
      "start_timestamp": "00:59",
      "end_timestamp": "01:02",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Very nauseous. I vomited once in the car park.",
      "start_timestamp": "01:05",
      "end_timestamp": "01:10",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Did you hit your head, or have an injury?",
      "start_timestamp": "01:12",
      "end_timestamp": "01:18",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, no injury. I did not hit my head.",
      "start_timestamp": "01:21",
      "end_timestamp": "01:26",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you have any allergies?",
      "start_timestamp": "01:28",
      "end_timestamp": "01:31",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Penicillin, I developed a rash.",
      "start_timestamp": "01:33",
      "end_timestamp": "01:37",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'll note that. What do you do for work?",
      "start_timestamp": "01:39",
      "end_timestamp": "01:44",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I am a software developer.",
      "start_timestamp": "01:47",
      "end_timestamp": "01:50",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let me check your numbers quickly. Blood pressure 168 over 98, pulse 92, temperature 36.9, oxygen 98 percent, breathing 18.",
      "start_timestamp": "02:03",
      "end_timestamp": "02:14",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your neck is stiff when I bend it forward.",
      "start_timestamp": "02:44",
      "end_timestamp": "02:48",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And your pupils are equal and react to light.",
      "start_timestamp": "02:57",
      "end_timestamp": "03:02",
      "supports": [
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let me tell you what I'm thinking. A sudden, severe headache like this can be a bleed around the brain, called a subarachnoid haemorrhage. I can't rule that out, and I won't take any risks.",
      "start_timestamp": "03:11",
      "end_timestamp": "03:31",
      "supports": [
        "symptoms[0]",
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It's not the most likely cause, but it's the one we must exclude. I'd like to arrange a CT scan of your head, right now.",
      "start_timestamp": "03:39",
      "end_timestamp": "03:52",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If the CT scan is normal, I might do a lumbar puncture, a test of the fluid around the spine, because the scan can miss small bleeds.",
      "start_timestamp": "03:59",
      "end_timestamp": "04:13",
      "supports": [
        "procedures_and_investigations[1]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Uncomfortable, but quick. I'd also like to do blood tests, including a clotting profile.",
      "start_timestamp": "04:19",
      "end_timestamp": "04:27",
      "supports": [
        "procedures_and_investigations[2]",
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Please lie flat, and don't eat or drink anything until we have the scan.",
      "start_timestamp": "04:34",
      "end_timestamp": "04:42",
      "supports": [
        "clinical_actions[4]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If the headache gets worse, or you become drowsy or confused, tell the nurse immediately.",
      "start_timestamp": "04:50",
      "end_timestamp": "04:58",
      "supports": [
        "clinical_actions[3]",
        "follow_up[0]"
      ]
    }
