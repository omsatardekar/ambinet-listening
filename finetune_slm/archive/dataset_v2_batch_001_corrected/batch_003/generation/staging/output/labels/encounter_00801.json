        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]",
        "vital_signs[5]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good morning, Mrs Ingram. It's your bone density review, after the wrist fracture. How have you been?",
      "start_timestamp": "01:10",
      "end_timestamp": "01:18",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Fine, in the main. My back has been aching, low down, for some months, since the autumn, I think. Or was it the summer? I'm not sure.",
      "start_timestamp": "01:20",
      "end_timestamp": "01:35",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is it constant, or does it come with movement?",
      "start_timestamp": "01:38",
      "end_timestamp": "01:43",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Worse when I bend, or lift, or get out of the car.",
      "start_timestamp": "01:46",
      "end_timestamp": "01:53",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any sudden severe back pain, a particular moment when it started?",
      "start_timestamp": "01:54",
      "end_timestamp": "02:01",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, it crept up. But I did slip on the ice in December, and landed on my bottom.",
      "start_timestamp": "02:02",
      "end_timestamp": "02:12",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any weakness in your legs, numbness, or trouble with your bladder or bowels?",
      "start_timestamp": "02:14",
      "end_timestamp": "02:22",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, none of that.",
      "start_timestamp": "02:23",
      "end_timestamp": "02:25",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you lost height that you know of?",
      "start_timestamp": "02:28",
      "end_timestamp": "02:32",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "About three centimetres, I think. My trousers are longer.",
      "start_timestamp": "02:35",
      "end_timestamp": "02:39",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any allergies to medicines?",
      "start_timestamp": "02:42",
      "end_timestamp": "02:45",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Alendronate, I came out in a terrible stomach upset and a rash, so they stopped it.",
      "start_timestamp": "02:47",
      "end_timestamp": "02:57",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you, that's noted. Medical history?",
      "start_timestamp": "02:59",
      "end_timestamp": "03:02",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I broke my wrist, two years ago, and I had an early menopause at forty-three.",
      "start_timestamp": "03:05",
      "end_timestamp": "03:13",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you smoke?",
      "start_timestamp": "03:16",
      "end_timestamp": "03:18",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I gave up in 2010. Twenty a day, for thirty years.",
      "start_timestamp": "03:20",
      "end_timestamp": "03:27",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "There's tenderness over the lower spine, a mild curve in the upper back, and the movement is stiff.",
      "start_timestamp": "03:52",
      "end_timestamp": "04:02",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you, Sally. Mrs Ingram, your bone density scan shows osteoporosis in the spine and the hip. I'd say this is osteoporosis, and your back pain could be from a small compression fracture.",
      "start_timestamp": "04:09",
      "end_timestamp": "04:29",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Possibly, the loss of height fits. I'd like to arrange an X-ray of your spine, to look for fractures, and blood tests, including calcium and vitamin D.",
      "start_timestamp": "04:34",
      "end_timestamp": "04:49",
      "supports": [
        "procedures_and_investigations[0]",
        "procedures_and_investigations[1]",
        "clinical_actions[0]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Please do. Mrs Ingram, take calcium in your diet, get daily light exercise, and avoid heavy lifting.",
      "start_timestamp": "05:30",
      "end_timestamp": "05:39",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And if you get sudden severe back pain, or any numbness in your legs, or trouble passing water, come in straight away.",
      "start_timestamp": "05:46",
      "end_timestamp": "05:59",
