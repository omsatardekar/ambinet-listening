    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "nurse",
      "transcript_text": "Weight 54 kilos, height 160 centimetres, BMI 21.1. Blood pressure 120 over 74, pulse 70, temperature 36.5.",
      "start_timestamp": "00:43",
      "end_timestamp": "00:53",
      "supports": [
