  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Mostly a routine check of my nose and throat. It's been about two years since anyone looked.",
      "start_timestamp": "00:41",
      "end_timestamp": "00:50",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Fair enough, and I'm glad you came. Let me run through some standard questions. Any nosebleeds?",
      "start_timestamp": "01:15",
      "end_timestamp": "01:22",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No nosebleeds. I checked my notes, and not in the last few years either.",
      "start_timestamp": "01:23",
      "end_timestamp": "01:30",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. What about pain in either ear?",
      "start_timestamp": "01:31",
      "end_timestamp": "01:35",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No ear pain at all.",
      "start_timestamp": "01:36",
      "end_timestamp": "01:39",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And your breathing in general, any trouble with it, day or night?",
      "start_timestamp": "01:41",
      "end_timestamp": "01:48",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It's fine, honestly. I can climb three flights of stairs without stopping.",
      "start_timestamp": "01:49",
      "end_timestamp": "01:56",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Acid reflux, for about six years now. It's mild, and I keep it quiet by eating smaller dinners.",
      "start_timestamp": "02:04",
      "end_timestamp": "02:14",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My father has sleep apnea. I put it on the list because I read that it can run in families.",
      "start_timestamp": "02:29",
      "end_timestamp": "02:37",
      "supports": [
        "medical_history.family_history[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I teach high school chemistry. It's a lot of talking all day, so I'm careful with my voice.",
      "start_timestamp": "02:49",
      "end_timestamp": "02:58",
      "supports": [
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Blood pressure is 118 over 76, pulse is 68 and regular, and your temperature is 36.7 degrees Celsius.",
      "start_timestamp": "03:19",
      "end_timestamp": "03:27",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your oxygen saturation is 99 percent, and your respiratory rate is 14 breaths per minute.",
      "start_timestamp": "03:28",
      "end_timestamp": "03:35",
      "supports": [
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Hm, give me a moment here. The lining inside your nose is a touch swollen on both sides, like a slightly puffy pillow.",
      "start_timestamp": "04:27",
      "end_timestamp": "04:37",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Not worried, just interested. Most likely this is mild nasal congestion, the kind of thing that builds up quietly over time.",
      "start_timestamp": "04:44",
      "end_timestamp": "04:54",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "There is. I'd like to book a nasal endoscopy, a tiny camera on a thin tube that lets us see the whole pipe.",
      "start_timestamp": "05:04",
      "end_timestamp": "05:16",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Run a humidifier at night if you have one, and sip water through your teaching day. Like watering a houseplant.",
      "start_timestamp": "05:58",
      "end_timestamp": "06:07",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Then you're ahead of schedule already. I'd like to see you again in four weeks, once the camera test is done.",
