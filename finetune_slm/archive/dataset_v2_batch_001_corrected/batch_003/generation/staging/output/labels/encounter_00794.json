  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hi, hi. I'm worried about my hands, they're awful, they're cracked and bleeding, and I'm scared it's going to get infected. I work in a care home, and we wash our hands constantly.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:17",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That sounds sore. When did it start?",
      "start_timestamp": "00:18",
      "end_timestamp": "00:22",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Oh, a few months, I think, or since the winter, I can't remember when it began, maybe before. I keep meaning to come.",
      "start_timestamp": "00:24",
      "end_timestamp": "00:36",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Which parts of the hands?",
      "start_timestamp": "00:38",
      "end_timestamp": "00:42",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Between the fingers, and the backs, and my knuckles are split. And the skin's red, and itchy.",
      "start_timestamp": "00:44",
      "end_timestamp": "00:54",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any weeping or crusting, any yellow, any signs of infection?",
      "start_timestamp": "00:55",
      "end_timestamp": "01:01",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A bit of crusting on one knuckle. No pus.",
      "start_timestamp": "01:04",
      "end_timestamp": "01:08",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is there any eczema in the past, or asthma, hay fever?",
      "start_timestamp": "01:42",
      "end_timestamp": "01:48",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I had eczema as a child.",
      "start_timestamp": "01:49",
      "end_timestamp": "01:53",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How many times a day do you wash your hands?",
      "start_timestamp": "01:54",
      "end_timestamp": "02:00",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Thirty, forty times a shift. And sanitiser, the gel, it stings.",
      "start_timestamp": "02:02",
      "end_timestamp": "02:08",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you have any other work involving chemicals, like cleaning products?",
      "start_timestamp": "02:10",
      "end_timestamp": "02:16",
      "supports": [
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, the cleaning products, bleach and disinfectant.",
      "start_timestamp": "02:17",
      "end_timestamp": "02:21",
      "supports": [
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 78, temperature 36.7.",
      "start_timestamp": "02:43",
      "end_timestamp": "02:46",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "There are dry, red, scaly patches with deep cracks across the knuckles, and in the finger webs, and one knuckle has a crust, but there's no spreading redness or pus.",
      "start_timestamp": "03:19",
      "end_timestamp": "03:34",
      "supports": [
        "physical_examination[0]",
        "physical_examination[1]",
        "physical_examination[2]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It looks like irritant contact dermatitis, caused by the constant washing and cleaning products.",
      "start_timestamp": "03:39",
      "end_timestamp": "03:47",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It can be controlled. I'm going to start you on a steroid ointment, betamethasone, apply it once a day to the red areas, for two weeks, and a thick emollient.",
      "start_timestamp": "03:56",
      "end_timestamp": "04:13",
      "supports": [
        "medications[0]",
        "medications[1]",
        "clinical_actions[2]",
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Steroid once a day, thin layer, only on the red cracked areas, and the emollient, as often as you can, particularly after washing.",
      "start_timestamp": "04:23",
      "end_timestamp": "04:36",
      "supports": [
        "medications[0]",
        "medications[1]",
        "clinical_actions[2]",
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Wear cotton gloves under waterproof ones, use a soap substitute, and dry your hands carefully.",
      "start_timestamp": "04:44",
      "end_timestamp": "04:52",
      "supports": [
        "clinical_actions[4]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And I'd like to take a swab from the crusted knuckle, and a skin patch test referral, because I'd like to rule out a reaction to something at work.",
      "start_timestamp": "04:59",
      "end_timestamp": "05:14",
      "supports": [
        "procedures_and_investigations[0]",
        "procedures_and_investigations[1]",
        "clinical_actions[0]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Please let your manager know, occupational health may help with a different glove.",
      "start_timestamp": "05:20",
      "end_timestamp": "05:27",
      "supports": [
        "clinical_actions[5]"
      ]
