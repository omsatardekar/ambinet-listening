    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "The distribution fits nickel, which is in the metal of the watch back, belt buckles, jean buttons, and cheap earrings. I'd say contact dermatitis from nickel.",
      "start_timestamp": "03:35",
      "end_timestamp": "03:50",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Nickel-free jewellery, surgical steel or titanium, and cover the back of the watch with clear nail varnish, or switch to a plastic strap.",
      "start_timestamp": "04:09",
      "end_timestamp": "04:20",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to confirm it with patch testing, where we tape small samples of metals to your back for two days.",
      "start_timestamp": "04:25",
      "end_timestamp": "04:37",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_024",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "The dermatology department. I'd also like to take a swab from the crusted wrist, to check it isn't infected.",
