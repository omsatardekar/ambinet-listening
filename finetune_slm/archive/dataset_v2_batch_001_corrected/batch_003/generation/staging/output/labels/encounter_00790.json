      "end_timestamp": "04:53",
      "supports": [
        "procedures_and_investigations[1]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_025",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Use a plain moisturiser a few times a day, and don't scratch.",
      "start_timestamp": "04:59",
      "end_timestamp": "05:06",
      "supports": [
        "clinical_actions[4]"
      ]
