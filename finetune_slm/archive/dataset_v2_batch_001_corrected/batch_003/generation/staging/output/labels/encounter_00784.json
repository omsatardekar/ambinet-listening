  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hi. Um, it's the anxiety. It's been bad again. I can't switch my head off at night.",
