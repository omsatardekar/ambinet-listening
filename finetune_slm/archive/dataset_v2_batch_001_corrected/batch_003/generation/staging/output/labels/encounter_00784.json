    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Tell me what happens at night.",
      "start_timestamp": "00:13",
      "end_timestamp": "00:18",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I get into bed and my mind races. Work, money, everything. I lie there for two hours, then wake at four, and I'm back on the treadmill.",
      "start_timestamp": "00:19",
      "end_timestamp": "00:34",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long has it been like this?",
      "start_timestamp": "00:37",
