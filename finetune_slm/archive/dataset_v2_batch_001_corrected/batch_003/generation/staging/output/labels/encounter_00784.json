      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "About six weeks. Since I changed jobs.",
      "start_timestamp": "00:44",
      "end_timestamp": "00:49",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any physical symptoms with it?",
      "start_timestamp": "00:50",
      "end_timestamp": "00:53",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My heart pounds, my chest feels tight, and I get sweaty hands. And I'm not eating much.",
      "start_timestamp": "00:56",
      "end_timestamp": "01:05",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
