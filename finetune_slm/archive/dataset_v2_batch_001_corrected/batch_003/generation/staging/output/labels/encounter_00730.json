  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Doctor, I'm Sinead, I care for Mrs Dolan during the week. It's her knees, they're getting so bad she won't go out.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:11",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Mrs Dolan, tell me about the knees.",
      "start_timestamp": "00:20",
      "end_timestamp": "00:25",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Sore, both of them, especially the right. Stiff when I get up, and they ache at night.",
      "start_timestamp": "00:26",
      "end_timestamp": "00:35",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How far can you walk now?",
      "start_timestamp": "00:38",
      "end_timestamp": "00:41",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "To the corner shop, and I have to stop twice. It used to be to the church and back, a mile.",
      "start_timestamp": "00:44",
      "end_timestamp": "00:55",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long has it been getting worse?",
      "start_timestamp": "00:56",
      "end_timestamp": "01:00",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Over the last year, I'd say.",
      "start_timestamp": "01:01",
      "end_timestamp": "01:05",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any swelling or redness of the knees, or heat?",
      "start_timestamp": "01:08",
      "end_timestamp": "01:12",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, no swelling. They crack, though, like a bag of crisps.",
      "start_timestamp": "01:14",
      "end_timestamp": "01:19",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any falls, or giving way?",
      "start_timestamp": "01:21",
      "end_timestamp": "01:25",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, I haven't fallen, thank God.",
      "start_timestamp": "01:26",
      "end_timestamp": "01:30",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What are you taking for the pain?",
      "start_timestamp": "01:33",
      "end_timestamp": "01:37",
      "supports": [
        "medications[0]",
        "medications[1]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Paracetamol, 1 gram, four times a day, and naproxen, 250 mg, twice a day, with food.",
      "start_timestamp": "01:39",
      "end_timestamp": "01:47",
      "supports": [
        "medications[0]",
        "medications[1]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I don't take the paracetamol four times, I take it when I remember.",
      "start_timestamp": "01:48",
      "end_timestamp": "01:55",
      "supports": [
        "medications[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "She forgets it, doctor. I put it out, but I'm not always there.",
      "start_timestamp": "01:57",
      "end_timestamp": "02:04",
      "supports": [
        "medications[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "So it's prescribed four times a day, but you take it as you remember. I won't be cross. What's your history?",
      "start_timestamp": "02:05",
      "end_timestamp": "02:18",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medications[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Osteoarthritis, they said, in my knees and hands.",
      "start_timestamp": "02:21",
      "end_timestamp": "02:26",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any operations?",
      "start_timestamp": "02:29",
      "end_timestamp": "02:31",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A hip replacement on the left, eight years ago.",
      "start_timestamp": "02:34",
      "end_timestamp": "02:40",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And who helps you at home?",
      "start_timestamp": "02:42",
      "end_timestamp": "02:46",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Her son comes at weekends. I come on weekdays. She lives alone.",
      "start_timestamp": "02:48",
      "end_timestamp": "02:55",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Both knees are a bit enlarged, with crunching when I bend them, and tender along the joint line, more on the right. No heat.",
      "start_timestamp": "03:23",
      "end_timestamp": "03:36",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That fits wear-and-tear arthritis, osteoarthritis, but I can't rule out something inflammatory because of the night aches, so I'd like to check.",
      "start_timestamp": "03:44",
      "end_timestamp": "03:55",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_024",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to arrange an X-ray of both knees, and a blood test for inflammation.",
      "start_timestamp": "04:01",
      "end_timestamp": "04:10",
      "supports": [
        "procedures_and_investigations[0]",
        "procedures_and_investigations[1]",
        "clinical_actions[0]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_025",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Gentle exercise helps, swimming, cycling, a chair-based class. Walking sticks help too, I'll arrange a physio assessment.",
      "start_timestamp": "04:36",
      "end_timestamp": "04:44",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_026",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to see you again in three weeks, with the results.",
      "start_timestamp": "04:54",
      "end_timestamp": "05:01",
