      "speaker_id": "person_4",
      "speaker_role": "clinical_staff",
      "transcript_text": "Pulse 104, blood pressure 124 over 78, oxygen 98 percent, temperature 36.7, breathing 18.",
      "start_timestamp": "01:55",
      "end_timestamp": "02:03",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
