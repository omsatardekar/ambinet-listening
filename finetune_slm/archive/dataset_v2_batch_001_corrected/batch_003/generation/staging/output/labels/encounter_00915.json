      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Wasps, I suppose. Not sure of the reaction, I was little.",
      "start_timestamp": "01:26",
      "end_timestamp": "01:32",
      "supports": [
        "allergies[0]"
      ]
