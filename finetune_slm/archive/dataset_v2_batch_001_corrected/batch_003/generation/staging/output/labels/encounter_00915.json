    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you. His lip is swollen on the left side, and the tongue looks normal, and I can see the back of the throat clearly.",
      "start_timestamp": "02:07",
      "end_timestamp": "02:22",
      "supports": [
        "physical_examination[0]",
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I think so, but a sting inside the mouth can swell, so we're going to watch you closely.",
      "start_timestamp": "02:35",
      "end_timestamp": "02:46",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Not yet, because your breathing is fine and you have no hives. If it gets worse, we'll give adrenaline straight away.",
      "start_timestamp": "02:59",
      "end_timestamp": "03:10",
      "supports": [
        "clinical_actions[1]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. I'm going to give you an antihistamine, chlorphenamine, 10 mg, by injection.",
      "start_timestamp": "03:23",
      "end_timestamp": "03:30",
      "supports": [
        "medications[0]",
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And I'd like to keep you in the department for a few hours of observation.",
      "start_timestamp": "03:51",
      "end_timestamp": "04:00",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "At least four. I'd like you to put some ice on the lip, and sip cold water if you can swallow.",
      "start_timestamp": "04:11",
      "end_timestamp": "04:24",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
