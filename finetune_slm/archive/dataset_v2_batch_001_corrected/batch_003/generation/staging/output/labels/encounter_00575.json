  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Darren's good. Look, I'm a bit freaked out. There's this ringing in my left ear and it won't stop.",
      "start_timestamp": "00:09",
      "end_timestamp": "00:19",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Three days now. Started on Sunday arvo while I was out in the yard.",
      "start_timestamp": "00:27",
      "end_timestamp": "00:36",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Pretty much constant. It goes quiet when the telly's on, but at night it's really loud.",
      "start_timestamp": "00:42",
      "end_timestamp": "00:51",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Right. Anything else going on in that ear? Blocked, sore, fluid coming out?",
      "start_timestamp": "01:10",
      "end_timestamp": "01:18",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It feels sort of muffled, like I've got cotton wool in there. That's new too.",
      "start_timestamp": "01:21",
      "end_timestamp": "01:30",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any spinning or dizziness with it?",
      "start_timestamp": "01:47",
      "end_timestamp": "01:51",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, thank god. I'd have gone straight to emergency. Is this something awful? My neighbour had a tumour thing on his hearing nerve.",
      "start_timestamp": "01:53",
      "end_timestamp": "02:04",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Left ear canal is partly blocked by a plug of wax. The eardrum behind it looks normal and intact, from what I can see.",
      "start_timestamp": "02:49",
      "end_timestamp": "03:04",
      "supports": [
        "physical_examination[0]",
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Wax can press on the eardrum and cause ringing and that muffled feeling. It's common.",
      "start_timestamp": "03:12",
      "end_timestamp": "03:21",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Even occasionally is enough to pack it in. Best to stop using them altogether.",
      "start_timestamp": "03:31",
      "end_timestamp": "03:39",
      "supports": [
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "A bit of cotton wool with Vaseline on it in the outer ear is plenty. Don't poke anything in.",
      "start_timestamp": "04:11",
      "end_timestamp": "04:21",
      "supports": [
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Okay. Before I forget, you probably want to know about allergies. I've got none.",
      "start_timestamp": "05:07",
      "end_timestamp": "05:14",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It should ease over a week or so as the wax shifts. If it's still ringing in two weeks, come back and see me.",
      "start_timestamp": "05:35",
      "end_timestamp": "05:47",
      "supports": [
        "clinical_actions[1]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Then ring the clinic the same day. Sudden loss in one ear is something we act on quickly.",
      "start_timestamp": "05:58",
      "end_timestamp": "06:07",
      "supports": [
        "clinical_actions[2]"
      ]
