    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any rash, or difficulty swallowing your saliva?",
      "start_timestamp": "01:00",
      "end_timestamp": "01:05",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No rash. I can swallow, it just hurts.",
      "start_timestamp": "01:08",
