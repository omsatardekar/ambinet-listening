      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What are you taking at the moment?",
      "start_timestamp": "01:16",
      "end_timestamp": "01:21",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Just paracetamol, 1 gram, four times a day.",
      "start_timestamp": "01:24",
      "end_timestamp": "01:30",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your tonsils are red and swollen with white spots on both, and there are tender swollen glands under your jaw.",
      "start_timestamp": "02:01",
      "end_timestamp": "02:11",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It's typical. I'd say this is strep throat, bacterial tonsillitis, as the swab confirms.",
      "start_timestamp": "02:21",
      "end_timestamp": "02:29",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes. I'll prescribe penicillin V, 500 mg, four times a day, for ten days.",
      "start_timestamp": "02:39",
      "end_timestamp": "02:48",
      "supports": [
        "medications[1]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 82, temperature 37.6, oxygen 98 percent.",
      "start_timestamp": "03:41",
      "end_timestamp": "03:46",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Fine. A mild temperature, as expected. Rest, drink plenty, and use paracetamol for the pain. Salt-water gargles help too.",
      "start_timestamp": "03:54",
      "end_timestamp": "04:04",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Stay off until you've had two days of the antibiotic, and your fever has gone.",
      "start_timestamp": "04:13",
      "end_timestamp": "04:23",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If you can't swallow, drool, have a very stiff neck, or a one-sided swollen throat, come back at once.",
