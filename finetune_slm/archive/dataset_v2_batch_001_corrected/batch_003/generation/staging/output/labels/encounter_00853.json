    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Morning. Er, the memory clinic. My daughter says I should come. I'm fine, though I do forget a few things. Not much.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:12",
      "supports": [
