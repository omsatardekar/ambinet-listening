  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hi. I've started a night-shift job, three weeks ago, and I can't sleep in the daytime, and I'm wrecked.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:10",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What sort of work, and what hours?",
      "start_timestamp": "00:11",
      "end_timestamp": "00:15",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I'm a warehouse picker. Ten at night to six in the morning, four nights a week.",
      "start_timestamp": "00:17",
      "end_timestamp": "00:26",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And when do you try to sleep?",
      "start_timestamp": "00:28",
      "end_timestamp": "00:33",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "When I get home at seven. I lie there, and my mind's awake. Then I get two or three hours, and wake up hot.",
      "start_timestamp": "00:35",
      "end_timestamp": "00:49",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you feel sleepy on shift?",
      "start_timestamp": "00:51",
      "end_timestamp": "00:55",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yeah. I nearly dropped off driving home last week. That scared me.",
      "start_timestamp": "00:57",
      "end_timestamp": "01:03",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any snoring, or waking up gasping?",
      "start_timestamp": "01:04",
      "end_timestamp": "01:08",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No. My girlfriend says I don't snore.",
      "start_timestamp": "01:09",
      "end_timestamp": "01:13",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any health conditions?",
      "start_timestamp": "01:44",
      "end_timestamp": "01:46",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Asthma, and I get a bit of anxiety.",
      "start_timestamp": "01:49",
      "end_timestamp": "01:54",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any family history of sleep problems or mental health?",
      "start_timestamp": "01:55",
      "end_timestamp": "02:00",
      "supports": [
        "medical_history.family_history[0]",
        "clinical_actions[1]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My mum has anxiety.",
      "start_timestamp": "02:02",
      "end_timestamp": "02:05",
      "supports": [
        "medical_history.family_history[0]",
        "clinical_actions[1]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 78, blood pressure 120 over 74, weight 72 kilos.",
      "start_timestamp": "02:28",
      "end_timestamp": "02:33",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Clear, no wheeze.",
      "start_timestamp": "03:08",
      "end_timestamp": "03:10",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Shift work sleep disorder is very common. I'd say you've got this, with the caffeine making it worse.",
      "start_timestamp": "03:18",
      "end_timestamp": "03:29",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Make your bedroom dark and cool, use blackout curtains and an eye mask, and keep it quiet, earplugs, phone on silent.",
      "start_timestamp": "03:37",
      "end_timestamp": "03:48",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Get blackout ones. And have no caffeine or energy drinks in the second half of your shift.",
      "start_timestamp": "03:52",
      "end_timestamp": "04:02",
      "supports": [
        "clinical_actions[4]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd also like you to take melatonin, 3 mg, an hour before you go to bed after your shift.",
      "start_timestamp": "04:24",
      "end_timestamp": "04:33",
      "supports": [
        "medications[0]",
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If you feel drowsy, pull over and have a nap. Or ask a friend for a lift, or get the bus.",
      "start_timestamp": "04:50",
      "end_timestamp": "05:00",
      "supports": [
        "clinical_actions[5]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd also like to arrange a blood test, to check your thyroid and iron, since tiredness can come from those.",
      "start_timestamp": "05:06",
      "end_timestamp": "05:18",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let's see how it goes. I'd like to see you again in four weeks.",
      "start_timestamp": "05:25",
      "end_timestamp": "05:33",
      "supports": [
        "medical_history.family_history[0]",
