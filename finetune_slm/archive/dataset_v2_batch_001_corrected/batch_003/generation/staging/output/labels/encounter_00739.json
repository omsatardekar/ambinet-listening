  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "nurse",
      "transcript_text": "Blood pressure lying 126 over 78, and standing 122 over 76, pulse 68, oxygen 98 percent.",
      "start_timestamp": "01:05",
      "end_timestamp": "01:14",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good morning, Mr Corrigan, I'll be as quick as thoroughness allows. This is your follow-up after the faint at the wedding.",
      "start_timestamp": "01:16",
      "end_timestamp": "01:27",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, the wedding. I was standing in the sun for the photos, and the next thing, I'm looking up at the bridesmaid's shoes.",
      "start_timestamp": "01:28",
      "end_timestamp": "01:39",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Tell me exactly what you remember.",
      "start_timestamp": "01:41",
      "end_timestamp": "01:45",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hot, a bit woozy, my vision went grey, and then I woke up on the grass. About a minute, they said.",
      "start_timestamp": "01:48",
      "end_timestamp": "01:58",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any warning in your chest, palpitations, pain, before you went?",
      "start_timestamp": "01:59",
      "end_timestamp": "02:05",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No chest pain. No palpitations. Nothing like that.",
      "start_timestamp": "02:07",
      "end_timestamp": "02:11",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Did you bite your tongue, or wet yourself, or feel confused afterwards?",
      "start_timestamp": "02:13",
      "end_timestamp": "02:19",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No. I was a bit sweaty and clammy, and fine in five minutes.",
      "start_timestamp": "02:20",
      "end_timestamp": "02:28",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What are you taking?",
      "start_timestamp": "02:43",
      "end_timestamp": "02:45",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Ramipril, 5 mg once a day. And bisoprolol, 2.5 mg once a day. For the blood pressure.",
      "start_timestamp": "02:47",
      "end_timestamp": "02:56",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And your history?",
      "start_timestamp": "02:57",
      "end_timestamp": "03:00",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]",
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "High blood pressure, high cholesterol, and I had gout, the once. I had a hernia repair too, in 2016.",
      "start_timestamp": "03:02",
      "end_timestamp": "03:11",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]",
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any breathlessness or palpitations at all, with the golf?",
      "start_timestamp": "03:12",
      "end_timestamp": "03:17",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, I can walk eighteen holes with no trouble.",
      "start_timestamp": "03:19",
      "end_timestamp": "03:24",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes. Drink plenty of water, don't stand still for too long in the heat, and sit down at once if you feel woozy.",
      "start_timestamp": "04:13",
      "end_timestamp": "04:27",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "No, Aoife, thank you. Mr Corrigan, if it happens again, particularly if it happens while you're sitting, with exercise, or with palpitations or chest pain, come back at once and I'll arrange further tests.",
