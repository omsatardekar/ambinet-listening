      "supports": [
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. Have you had a diagnosis of anything in the past, anything long term?",
