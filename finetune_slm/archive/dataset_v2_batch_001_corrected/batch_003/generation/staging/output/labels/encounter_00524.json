    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I couldn't tell you. It might've been there before, when he was getting worse. I don't know.",
      "start_timestamp": "02:11",
      "end_timestamp": "02:22",
      "supports": [
        "symptoms[1]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I have to ask this of everyone in your position. Have you had any thoughts of harming yourself?",
