  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "nurse",
      "transcript_text": "Doctor, Mr Kowalski, forty-one, vomiting since last night, can't keep anything down, even water.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:07",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you. Mr Kowalski, I'm Dr Hughes. How many times have you been sick?",
      "start_timestamp": "00:08",
      "end_timestamp": "00:16",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I've lost count. Ten, twelve? All night, and this morning, even when it's just water. I want a drip, honestly.",
      "start_timestamp": "00:17",
      "end_timestamp": "00:29",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'll get to that. When did it start?",
      "start_timestamp": "00:30",
      "end_timestamp": "00:34",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "About eight last night, after dinner. A kebab. I'm blaming the kebab.",
      "start_timestamp": "00:35",
      "end_timestamp": "00:42",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any pain in your tummy?",
      "start_timestamp": "00:51",
      "end_timestamp": "00:54",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yeah, cramps. Across the middle, they come and go, and they're bad.",
      "start_timestamp": "00:56",
      "end_timestamp": "01:04",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Dizzy when you stand?",
      "start_timestamp": "01:05",
      "end_timestamp": "01:08",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yeah, a bit. I nearly fell getting out of the car.",
      "start_timestamp": "01:11",
      "end_timestamp": "01:17",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any blood in what you've brought up, or black, coffee-ground stuff?",
      "start_timestamp": "01:19",
      "end_timestamp": "01:25",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, just yellow stuff at the end. No blood.",
      "start_timestamp": "01:27",
      "end_timestamp": "01:32",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any fever or shivers?",
      "start_timestamp": "01:35",
      "end_timestamp": "01:37",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Not that I know of. No.",
      "start_timestamp": "01:40",
      "end_timestamp": "01:43",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What tablets do you take?",
      "start_timestamp": "01:46",
      "end_timestamp": "01:49",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Metformin, 500 mg, twice a day, and omeprazole, 20 mg once a day. Haven't taken them today, obviously.",
      "start_timestamp": "01:50",
      "end_timestamp": "02:01",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Sensible not to. Any previous operations?",
      "start_timestamp": "02:03",
      "end_timestamp": "02:06",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Gallbladder out, in 2015.",
      "start_timestamp": "02:08",
      "end_timestamp": "02:10",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_3",
      "speaker_role": "nurse",
      "transcript_text": "Blood pressure 100 over 62, pulse 112, temperature 37.4, oxygen 97 percent, respiratory rate 20.",
      "start_timestamp": "02:38",
      "end_timestamp": "02:48",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thanks, Jenny. Your pressure's on the low side and your pulse is fast, which is the dehydration. Any breathing trouble?",
      "start_timestamp": "02:50",
      "end_timestamp": "03:01",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, breathing's fine.",
      "start_timestamp": "03:02",
      "end_timestamp": "03:04",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your mouth is very dry, and your tummy is tender in the upper middle but soft, with no guarding.",
      "start_timestamp": "03:29",
      "end_timestamp": "03:40",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "No, that's not where it is. I think this is most likely gastroenteritis from something you ate, but I can't rule out a gallstone problem in the bile duct yet.",
      "start_timestamp": "03:47",
      "end_timestamp": "04:03",
      "supports": [
        "clinical_assessment[0]",
        "clinical_assessment[1]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "First, we'll start intravenous fluids right now, so you stop drying out. Jenny, a cannula please.",
      "start_timestamp": "04:11",
      "end_timestamp": "04:20",
      "supports": [
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_024",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd also like to send blood tests, including your kidney function and electrolytes, and a liver profile.",
      "start_timestamp": "04:25",
      "end_timestamp": "04:35",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_025",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And I'd like to arrange an abdominal ultrasound, given the pain and your history.",
      "start_timestamp": "04:40",
      "end_timestamp": "04:49",
      "supports": [
        "procedures_and_investigations[1]",
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_026",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "When you're home, small sips of fluid, nothing greasy, and I'd like to see you again tomorrow morning to check how you're doing.",
      "start_timestamp": "05:27",
