  "clinical_uncertainties": [],
  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hello. Um, I'm back about the pain in my chest, when I breathe. I had that chest infection last month, and the pain didn't go with it.",
      "start_timestamp": "00:02",
      "end_timestamp": "00:15",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Tell me about the pain. Where is it?",
      "start_timestamp": "00:18",
      "end_timestamp": "00:23",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "On the right, low down, at the side. Sharp. It catches when I take a deep breath, or cough.",
      "start_timestamp": "00:25",
      "end_timestamp": "00:35",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long have you had it?",
      "start_timestamp": "00:39",
      "end_timestamp": "00:42",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Three weeks. It was worse at first, and it's a bit better now, but it's still there.",
      "start_timestamp": "00:45",
      "end_timestamp": "00:55",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No fever, and the cough's much less. It's dry.",
      "start_timestamp": "01:05",
      "end_timestamp": "01:10",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What are you taking?",
      "start_timestamp": "01:29",
      "end_timestamp": "01:32",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Ibuprofen, 400 mg, three times a day. For the pain.",
      "start_timestamp": "01:35",
      "end_timestamp": "01:41",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any allergies?",
      "start_timestamp": "01:45",
      "end_timestamp": "01:47",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No allergies.",
      "start_timestamp": "01:50",
      "end_timestamp": "01:52",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any history of lung problems?",
      "start_timestamp": "01:55",
      "end_timestamp": "01:58",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Asthma, mild.",
      "start_timestamp": "02:00",
      "end_timestamp": "02:02",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 74, blood pressure 128 over 80, temperature 36.6, oxygen 97 percent, respiratory rate 16.",
      "start_timestamp": "02:30",
      "end_timestamp": "02:37",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "There's a scratchy sound, a friction rub, at the right base when you breathe in, and the rest of your chest is clear.",
      "start_timestamp": "03:14",
      "end_timestamp": "03:25",
      "supports": [
        "physical_examination[0]",
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Together with your history, a recent chest infection, and now sharp pain with breathing, that sound is classic for pleurisy, inflammation of the lining of the lung, after the infection.",
      "start_timestamp": "03:33",
      "end_timestamp": "03:47",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Usually it settles by itself. But because it's lasted three weeks, I'd like a chest X-ray, to check there's no fluid or anything else.",
      "start_timestamp": "03:56",
      "end_timestamp": "04:08",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "This week. Carry on with the ibuprofen, but take it with food, and not more than the label says.",
      "start_timestamp": "04:17",
      "end_timestamp": "04:27",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If the pain gets worse, you become breathless at rest, cough up blood, or get a fever, come back that day.",
      "start_timestamp": "04:50",
      "end_timestamp": "05:00",
      "supports": [
        "clinical_actions[1]",
        "follow_up[0]"
      ]
    }
