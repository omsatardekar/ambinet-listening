  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hello! I've come about a rash, and I've got to say, it's the strangest thing, because I've been on a course of tablets from the dentist, for a tooth, and I started to itch on day four.",
      "start_timestamp": "00:02",
      "end_timestamp": "00:22",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let's slow down. When did the rash appear?",
      "start_timestamp": "00:25",
      "end_timestamp": "00:30",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Day five, so yesterday morning. It started on my chest, and now it's on my back and my arms. Little red blotches.",
      "start_timestamp": "00:33",
      "end_timestamp": "00:44",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do they itch?",
      "start_timestamp": "00:48",
      "end_timestamp": "00:50",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Terribly. I was scratching in the night, my husband said I was like a dog with fleas.",
      "start_timestamp": "00:53",
      "end_timestamp": "01:02",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Of course. I'm a hairdresser, so my arms are usually fine, but I've had to wear long sleeves.",
      "start_timestamp": "02:18",
      "end_timestamp": "02:28",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It should fade by itself over a few days. A cool shower, and loose cotton clothing, will help the itch.",
      "start_timestamp": "03:39",
      "end_timestamp": "03:50",
      "supports": [
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Go back to the dentist and tell them about the rash. They'll choose a different treatment if you still need one.",
      "start_timestamp": "03:58",
      "end_timestamp": "04:08",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It usually peaks and settles, but if you develop swelling of the face or lips, difficulty breathing, blistering, or a fever, call 999 or come straight in.",
