      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Well, nothing really. Only I get a burning in my upper tummy, after meals. I didn't think it was worth mentioning.",
      "start_timestamp": "00:57",
      "end_timestamp": "01:09",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Tell me about it. How often?",
      "start_timestamp": "01:10",
      "end_timestamp": "01:14",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A few times a week. A hot, burning feeling, under my ribs. It's worse after a big meal, or tomato sauce.",
      "start_timestamp": "01:17",
      "end_timestamp": "01:28",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any vomiting, or trouble swallowing?",
      "start_timestamp": "01:28",
