    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "A little tender at the top, in the middle, and nothing else.",
      "start_timestamp": "04:03",
      "end_timestamp": "04:10",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to arrange a breath test for the stomach bacterium, Helicobacter pylori.",
      "start_timestamp": "04:38",
      "end_timestamp": "04:46",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_024",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Meanwhile, eat smaller meals, avoid tomato, spicy food, and coffee late in the day, and leave three hours between your last meal and bed.",
