  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "nurse",
      "transcript_text": "I'm Rhona, the nurse. Blood pressure 130 over 80, pulse 76, oxygen 98 percent.",
      "start_timestamp": "00:39",
