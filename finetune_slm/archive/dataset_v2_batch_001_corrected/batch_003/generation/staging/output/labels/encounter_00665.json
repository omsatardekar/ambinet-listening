      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I don't know. Maybe after. Maybe before. I cannot say.",
      "start_timestamp": "01:12",
      "end_timestamp": "01:18",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
