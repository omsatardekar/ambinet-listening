  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Morning. Er, I'd like a sexual health check, please. I've just ended a relationship and I want to be sure.",
      "start_timestamp": "00:02",
      "end_timestamp": "00:13",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Of course, and it's completely routine. Is there anything that prompted it, any symptoms?",
      "start_timestamp": "00:16",
      "end_timestamp": "00:24",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Not really. A tiny bit of itching, down there, on and off, for about a fortnight. Nothing else.",
      "start_timestamp": "00:28",
      "end_timestamp": "00:37",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Anything else medically I should know about?",
      "start_timestamp": "00:54",
      "end_timestamp": "00:58",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I get eczema, mostly on my hands. That's all.",
      "start_timestamp": "01:01",
      "end_timestamp": "01:07",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 68, temperature 36.5.",
      "start_timestamp": "01:32",
      "end_timestamp": "01:35",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you. I can't see any sores, rash, or warts, and nothing else of concern.",
      "start_timestamp": "02:25",
      "end_timestamp": "02:35",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to take swabs for chlamydia and gonorrhoea, and arrange a urine sample, and a blood test for HIV, syphilis and hepatitis.",
      "start_timestamp": "03:06",
      "end_timestamp": "03:18",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "You'll get a text saying so. And I'd like you to come back in two weeks, to make sure the itch has settled.",
      "start_timestamp": "04:04",
      "end_timestamp": "04:18",
      "supports": [
        "clinical_actions[1]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Use condoms with any new partner until you've had the results, and ideally for a while after.",
