  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Morning, doctor. My diabetes check is due, but I also get tingling in my feet now, and I wanted to ask about that.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:13",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good morning. Let's start with the tingling. Which part of the feet?",
      "start_timestamp": "00:16",
      "end_timestamp": "00:22",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "The toes, mostly, on both sides. Like pins and needles.",
      "start_timestamp": "00:24",
      "end_timestamp": "00:30",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "When did you first notice it?",
      "start_timestamp": "00:33",
      "end_timestamp": "00:36",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Oh, I couldn't say. Maybe the spring? Or last winter. I really don't remember.",
      "start_timestamp": "00:40",
      "end_timestamp": "00:48",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is it there all the time, or does it come and go?",
      "start_timestamp": "00:49",
      "end_timestamp": "00:55",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It's worse in the evening, when I'm sitting down.",
      "start_timestamp": "00:59",
      "end_timestamp": "01:04",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any weakness in the legs, or falls?",
      "start_timestamp": "01:07",
      "end_timestamp": "01:12",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, nothing like that. My legs feel strong.",
      "start_timestamp": "01:15",
      "end_timestamp": "01:19",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Tell me about the diabetes medicines you're on.",
      "start_timestamp": "01:23",
      "end_timestamp": "01:28",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Metformin, 500 mg, twice a day. Then a small yellow one in the morning, I don't know the name. And the injection at night.",
      "start_timestamp": "01:30",
      "end_timestamp": "01:43",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you know how many units of the injection you take?",
      "start_timestamp": "01:45",
      "end_timestamp": "01:51",
      "supports": [
        "medications[2]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Twenty, I think. Or perhaps twenty-four. My wife does it, she writes it down.",
      "start_timestamp": "01:53",
      "end_timestamp": "02:00",
      "supports": [
        "medications[2]",
        "clinical_uncertainties[2]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'll ask you to bring her diary next time, then we'll be sure. Any other conditions besides the diabetes?",
      "start_timestamp": "02:02",
      "end_timestamp": "02:13",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Diabetes, for about ten years. That's all, really.",
      "start_timestamp": "02:16",
      "end_timestamp": "02:21",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you noticed any trouble with your eyes, or sores on your feet?",
      "start_timestamp": "02:23",
      "end_timestamp": "02:31",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No. My eyes are fine, and my feet have no sores.",
      "start_timestamp": "02:34",
      "end_timestamp": "02:40",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 74, blood pressure 134 over 80, weight 88 kilograms, temperature 36.6.",
      "start_timestamp": "03:07",
      "end_timestamp": "03:14",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "The tingling may well be early nerve damage from the diabetes, but I'd like the tests to say so.",
      "start_timestamp": "04:15",
      "end_timestamp": "04:25",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It's common, and it often settles when the sugars are steady. Please check your feet daily, and wear shoes that fit well.",
      "start_timestamp": "04:33",
      "end_timestamp": "04:44",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Come back in three weeks with your wife's diary, and I'll go through the results with you.",
