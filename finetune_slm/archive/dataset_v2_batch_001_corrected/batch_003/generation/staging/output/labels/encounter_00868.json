  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "nurse",
      "transcript_text": "Blood pressure 152 over 88, pulse 74, temperature 36.6, oxygen 97 percent, weight 71 kilos.",
      "start_timestamp": "00:34",
