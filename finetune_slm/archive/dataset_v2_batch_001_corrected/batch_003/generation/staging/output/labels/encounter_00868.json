        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Hello Mr Winters. It's the itching, isn't it? Tell me about it.",
      "start_timestamp": "00:46",
      "end_timestamp": "00:52",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "All over. Mostly my back, my legs, my arms. Worse at night. I scratch until I bleed.",
      "start_timestamp": "00:54",
      "end_timestamp": "01:05",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long has it been going on?",
      "start_timestamp": "01:08",
      "end_timestamp": "01:11",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Two months. Since my kidneys got worse, I think.",
      "start_timestamp": "01:15",
      "end_timestamp": "01:20",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is there a rash?",
      "start_timestamp": "01:23",
      "end_timestamp": "01:25",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No rash. Just the itch. My skin's dry.",
      "start_timestamp": "01:29",
      "end_timestamp": "01:33",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any jaundice, or dark urine?",
      "start_timestamp": "01:36",
      "end_timestamp": "01:39",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No. Nothing like that.",
      "start_timestamp": "01:41",
      "end_timestamp": "01:44",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Remind me of your history.",
      "start_timestamp": "01:46",
      "end_timestamp": "01:50",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Chronic kidney disease, for about eight years, and diabetes.",
      "start_timestamp": "01:53",
      "end_timestamp": "01:58",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you smoke or drink?",
      "start_timestamp": "02:00",
      "end_timestamp": "02:03",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Neither. Not for years.",
      "start_timestamp": "02:05",
      "end_timestamp": "02:07",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any allergies?",
      "start_timestamp": "02:09",
      "end_timestamp": "02:11",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Codeine. Makes me vomit.",
      "start_timestamp": "02:12",
      "end_timestamp": "02:15",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "There's dry, scaly skin, and scratch marks on his back and arms, but no rash, and no signs of infection.",
      "start_timestamp": "02:45",
      "end_timestamp": "02:54",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you, Alan. Mr Winters, the itch is very common in kidney disease, uraemic itch. I'd say that's what you've got, with dry skin adding to it.",
      "start_timestamp": "03:08",
      "end_timestamp": "03:22",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes. First, moisturise twice a day with a plain thick cream, keep your showers short and lukewarm, and avoid scented soaps.",
      "start_timestamp": "03:30",
      "end_timestamp": "03:43",
      "supports": [
        "clinical_actions[4]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd also like to start you on a tablet to lower your phosphate, calcium acetate, 500 mg, three times a day, with meals.",
      "start_timestamp": "03:49",
      "end_timestamp": "04:01",
      "supports": [
        "medications[0]",
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you, Alan. I'd also like to arrange more blood tests, for your parathyroid hormone, calcium and liver tests, and a review with the kidney team.",
      "start_timestamp": "04:25",
      "end_timestamp": "04:39",
      "supports": [
        "procedures_and_investigations[0]",
        "procedures_and_investigations[1]",
        "clinical_actions[0]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Keep your nails short, and wear cotton at night.",
      "start_timestamp": "04:44",
      "end_timestamp": "04:49",
      "supports": [
        "clinical_actions[5]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to see you again in four weeks.",
