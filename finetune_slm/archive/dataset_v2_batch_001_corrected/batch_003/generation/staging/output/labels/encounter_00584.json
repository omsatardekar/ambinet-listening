  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Nothing much. I just do the sleepwalking thing. Honestly, it's not a big deal.",
      "start_timestamp": "00:49",
      "end_timestamp": "00:57",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If you're asleep at the time, how do you even know it's happening?",
      "start_timestamp": "00:59",
      "end_timestamp": "01:07",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Mum or my brother finds me. Standing in the hallway, or halfway into the fridge. I don't remember any of it.",
      "start_timestamp": "01:08",
      "end_timestamp": "01:19",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long has this been going on, would you say?",
      "start_timestamp": "01:21",
      "end_timestamp": "01:27",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "About three months, I guess.",
      "start_timestamp": "01:27",
      "end_timestamp": "01:30",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And how often do you get one of these nights?",
      "start_timestamp": "01:32",
      "end_timestamp": "01:38",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A couple of times a week. Sometimes less, sometimes a bit more.",
      "start_timestamp": "01:41",
      "end_timestamp": "01:49",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Has it ever taken you out of the house, or onto the street?",
      "start_timestamp": "02:05",
      "end_timestamp": "02:13",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, never. Just downstairs once, into the kitchen.",
      "start_timestamp": "02:16",
      "end_timestamp": "02:21",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And have you ever hurt yourself, bumped into things, anything like that?",
      "start_timestamp": "02:23",
      "end_timestamp": "02:30",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, nothing like that. Mum says I walk round stuff better asleep than awake.",
      "start_timestamp": "02:31",
      "end_timestamp": "02:40",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Just melatonin. Mum picked it up from the chemist after the last doctor's visit.",
      "start_timestamp": "03:09",
      "end_timestamp": "03:16",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And how much do you take, and how often?",
      "start_timestamp": "03:17",
      "end_timestamp": "03:23",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "One before bed, every night. 3 milligrams, I think? Maybe it's 5, I'd have to check the box.",
      "start_timestamp": "03:25",
      "end_timestamp": "03:34",
      "supports": [
        "medications[0]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you manage to take it every single night?",
      "start_timestamp": "03:37",
      "end_timestamp": "03:42",
      "supports": [
        "medications[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yeah, every night. Well, most nights. I forget a couple of times a week if I'm wrecked.",
      "start_timestamp": "03:44",
      "end_timestamp": "03:54",
      "supports": [
        "medications[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Now, before we go any further, are there any allergies I should write down?",
      "start_timestamp": "04:04",
      "end_timestamp": "04:13",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yeah, penicillin, I think. Mum says I reacted to it when I was little, but I don't know what actually happened.",
      "start_timestamp": "04:16",
      "end_timestamp": "04:27",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "So you react to penicillin, but nobody remembers how.",
      "start_timestamp": "04:29",
      "end_timestamp": "04:33",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Blood pressure is 112 over 68, and your pulse is 64.",
      "start_timestamp": "05:14",
      "end_timestamp": "05:20",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Mostly it's about the bedroom set-up, nothing fancy. First, keep the same bedtime and wake-up time every day, weekends included.",
      "start_timestamp": "05:45",
      "end_timestamp": "05:55",
      "supports": [
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I know, lie-ins are tempting. Also keep the floor clear and shut the windows at night.",
      "start_timestamp": "06:03",
      "end_timestamp": "06:11",
      "supports": [
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Hard to promise. Let's not change anything today. Keep taking it, and try to get it in every night.",
      "start_timestamp": "06:36",
      "end_timestamp": "06:48",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_024",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If it's still happening in six weeks, come back and see me and we'll talk about what else we can try.",
      "start_timestamp": "07:25",
      "end_timestamp": "07:35",
      "supports": [
        "clinical_actions[2]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_025",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If you ever go outside or hurt yourself, ring the clinic that same day, don't wait for the six weeks.",
      "start_timestamp": "07:42",
      "end_timestamp": "07:53",
      "supports": [
        "clinical_actions[3]"
