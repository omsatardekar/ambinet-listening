  "clinical_uncertainties": [],
  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Good morning, Doctor. I do apologise for taking up your time, but I have been left with sore ribs since a dreadful bout last week.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:14",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "The right side, low down towards the back. It began one week ago, quite suddenly, in the middle of a coughing fit.",
      "start_timestamp": "00:26",
      "end_timestamp": "00:39",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, when I cough, and also a deep breath. Laughing is rather out of the question at the moment.",
      "start_timestamp": "00:46",
      "end_timestamp": "00:57",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Sharp, I would say, but only at those moments. In between it is a dull soreness. Moderate overall, though it does keep me awake if I roll onto that side.",
      "start_timestamp": "01:06",
      "end_timestamp": "01:21",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Fair enough. Are you coughing up any blood?",
      "start_timestamp": "01:23",
      "end_timestamp": "01:28",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, nothing like that, thank goodness.",
      "start_timestamp": "01:30",
      "end_timestamp": "01:33",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. And are you short of breath at rest, or going upstairs?",
      "start_timestamp": "01:34",
      "end_timestamp": "01:42",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, not at all. My breathing seems perfectly all right, it is only the pain that catches me.",
      "start_timestamp": "01:44",
      "end_timestamp": "01:53",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you taken anything for it?",
      "start_timestamp": "01:55",
      "end_timestamp": "01:59",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I haven't, I am afraid. I am not fond of tablets. I only take amlodipine, 5 mg every morning, and I have not changed that.",
      "start_timestamp": "02:01",
      "end_timestamp": "02:13",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Fine, carry on with that. Any allergies I should write down before we go further?",
      "start_timestamp": "02:14",
      "end_timestamp": "02:22",
      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, none that I am aware of. I have never had a reaction to anything.",
      "start_timestamp": "02:24",
      "end_timestamp": "02:32",
      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. Have you had any operations in the past?",
      "start_timestamp": "02:33",
      "end_timestamp": "02:38",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Just the one. I had my appendix removed about twelve years ago, and it all went smoothly.",
      "start_timestamp": "02:39",
      "end_timestamp": "02:48",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thanks. And do you smoke, or have you ever?",
      "start_timestamp": "02:50",
      "end_timestamp": "02:56",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I gave up smoking in my fifties. It was the best decision I ever made, if I may say so.",
      "start_timestamp": "02:58",
      "end_timestamp": "03:09",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your pulse is 76 beats per minute, and your oxygen saturation is 98 percent.",
      "start_timestamp": "03:34",
      "end_timestamp": "03:41",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Perfectly. Temperature is 36.8 degrees Celsius too. So nothing there that worries me.",
      "start_timestamp": "03:49",
      "end_timestamp": "03:56",
      "supports": [
        "vital_signs[2]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let me lay out the options. We can wait and see, we can get a picture, or we can do both. I'd like to arrange a chest X-ray today.",
      "start_timestamp": "04:08",
      "end_timestamp": "04:24",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes. Hug a pillow against your side when you cough, and keep walking gently. Resting completely tends to make it stiffer.",
      "start_timestamp": "05:18",
      "end_timestamp": "05:29",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Try short, shallow breaths first, then build up to a few slow deep ones every hour or so.",
      "start_timestamp": "05:40",
      "end_timestamp": "05:50",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes, let's see you again in two weeks, and we'll go over how it's settling and what the picture showed.",
      "start_timestamp": "05:59",
      "end_timestamp": "06:10",
      "supports": [
        "clinical_actions[2]",
        "follow_up[0]"
      ]
    }
