  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Hello! This is Bella, she's six, and she gets tummy aches before school, every morning, and I'm at my wits' end.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:12",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It hurts. Here.",
      "start_timestamp": "00:23",
      "end_timestamp": "00:25",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "When does it hurt?",
      "start_timestamp": "00:26",
      "end_timestamp": "00:29",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "She means weekdays, doctor. Monday to Friday, before school, then it goes by the time we get there, and she's running about by break.",
      "start_timestamp": "00:35",
      "end_timestamp": "00:49",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "She says that, but she cries when I leave her at the gate, doctor.",
      "start_timestamp": "01:13",
      "end_timestamp": "01:21",
      "supports": [
        "symptoms[1]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I don't cry.",
      "start_timestamp": "01:24",
      "end_timestamp": "01:26",
      "supports": [
        "negative_findings[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "You do, sweetheart, you cry every morning.",
      "start_timestamp": "01:28",
      "end_timestamp": "01:32",
      "supports": [
        "symptoms[1]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'll write down that Bella says she doesn't cry and Mum says she does. Bella, is there anything about school that's difficult, or any person who's unkind?",
      "start_timestamp": "01:34",
      "end_timestamp": "01:48",
      "supports": [
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Her tummy is soft, and there's no tenderness anywhere, even when I press deep.",
      "start_timestamp": "02:43",
      "end_timestamp": "02:50",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "A calm, consistent goodbye routine, and a firm, kind drop-off. Don't linger. And talk to her teacher so they can greet her at the gate.",
      "start_timestamp": "03:38",
      "end_timestamp": "03:51",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "You are good, Bella. And I'd like to arrange a urine test, just to rule out a simple infection that could be causing tummy aches.",
      "start_timestamp": "04:14",
      "end_timestamp": "04:29",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to see you again in three weeks, to see how the mornings are going.",
      "start_timestamp": "04:49",
      "end_timestamp": "04:59",
      "supports": [
