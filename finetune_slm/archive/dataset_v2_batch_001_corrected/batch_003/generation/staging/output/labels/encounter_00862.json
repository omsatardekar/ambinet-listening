  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hello, doctor. I'm sorry, this is rather embarrassing. I've been leaking urine. Mainly when I cough or sneeze, but also when I can't get to the toilet in time.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:16",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Please don't be embarrassed, it's very common, and very treatable. How long has this been happening?",
      "start_timestamp": "00:19",
      "end_timestamp": "00:29",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Oh, I really couldn't say. It's crept up. A year? Two? I only noticed when I had to start wearing pads.",
      "start_timestamp": "00:32",
      "end_timestamp": "00:43",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How often do you leak?",
      "start_timestamp": "00:44",
      "end_timestamp": "00:47",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Most days. A few drops on a cough. And if I get the urge, I have to run, and sometimes I don't make it.",
      "start_timestamp": "00:50",
      "end_timestamp": "01:03",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How often do you pass urine in a day, and at night?",
      "start_timestamp": "01:06",
      "end_timestamp": "01:13",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Eight, nine times in the day. And twice at night.",
      "start_timestamp": "01:15",
      "end_timestamp": "01:21",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What tablets are you taking?",
      "start_timestamp": "01:33",
      "end_timestamp": "01:37",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Furosemide, 40 mg, in the morning, for my ankles. A blood pressure tablet, I couldn't tell you the name, it's a little pink one. And a vitamin.",
      "start_timestamp": "01:38",
      "end_timestamp": "01:51",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "So the water tablet is 40 mg in the morning, and the pink blood-pressure tablet you can't name. What's the vitamin?",
      "start_timestamp": "01:54",
      "end_timestamp": "02:05",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Vitamin D, I think, 800 units, once a day.",
      "start_timestamp": "02:07",
      "end_timestamp": "02:13",
      "supports": [
        "medications[2]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you. Any other conditions?",
      "start_timestamp": "02:13",
      "end_timestamp": "02:17",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "High blood pressure, and I've had four children.",
      "start_timestamp": "02:20",
      "end_timestamp": "02:25",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd say what you describe, leaking on coughing and sneezing, and also an urgent need to go that you sometimes can't hold, is a mixture of stress and urge incontinence.",
      "start_timestamp": "03:32",
      "end_timestamp": "03:48",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "First, pelvic floor exercises, squeezing the muscles you'd use to stop passing wind or urine, ten squeezes, three times a day.",
      "start_timestamp": "04:06",
      "end_timestamp": "04:18",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "They work for most people if done regularly for three months. I'll also refer you to the continence physiotherapist, who will teach you properly.",
      "start_timestamp": "04:23",
      "end_timestamp": "04:35",
      "supports": [
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Cut down the tea, coffee and fizzy drinks, and don't drink too much in the evening. Keep a bladder diary for three days.",
      "start_timestamp": "04:41",
      "end_timestamp": "04:53",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to see you again in six weeks, with the diary.",
      "start_timestamp": "05:13",
      "end_timestamp": "05:20",
