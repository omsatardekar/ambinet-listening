  "clinical_uncertainties": [],
  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Lovely. So, Doris, it's about six weeks since you broke your hip. How's the walking?",
      "start_timestamp": "00:31",
      "end_timestamp": "00:39",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "A tortoise that's getting about, that's the main thing. Any pain when you walk?",
      "start_timestamp": "00:56",
      "end_timestamp": "01:05",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It's not so much pain, it's more that my hip is stiff, first thing in the morning especially. It loosens up by the time I've had my toast.",
      "start_timestamp": "01:07",
      "end_timestamp": "01:21",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's grand. Any falls since you came home?",
      "start_timestamp": "01:34",
      "end_timestamp": "01:39",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Not one. Bev won't let me, she hovers like a hawk.",
      "start_timestamp": "01:42",
      "end_timestamp": "01:49",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Not a single fall, Doctor, I'd have rung you.",
      "start_timestamp": "01:51",
      "end_timestamp": "01:57",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good, that's what I wanted to hear. Let's go through the tablets, because I want to be sure they all match what I've got on screen.",
      "start_timestamp": "01:58",
      "end_timestamp": "02:13",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "I put them out every morning in the little box. There's the amlodipine, 5 mg, once a day, for her blood pressure.",
      "start_timestamp": "02:15",
      "end_timestamp": "02:28",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "And the one for my bones. I can never remember what it's called.",
      "start_timestamp": "02:30",
      "end_timestamp": "02:36",
      "supports": [
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Alendronic acid, 70 mg once a week. It's Sundays, because she has to take it on an empty stomach and sit up for half an hour.",
      "start_timestamp": "02:39",
      "end_timestamp": "02:51",
      "supports": [
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Perfect, Sundays is a good routine. Anything for pain?",
      "start_timestamp": "02:54",
      "end_timestamp": "02:59",
      "supports": [
        "medications[2]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Only the paracetamol, 500 mg, when my hip's playing up. I don't like taking tablets for the sake of it.",
      "start_timestamp": "03:00",
      "end_timestamp": "03:10",
      "supports": [
        "medications[2]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's the right way round. I notice you've got osteoporosis on your notes, and the high blood pressure.",
      "start_timestamp": "03:12",
      "end_timestamp": "03:22",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "That's me. Osteoporosis, they said, which is why the hip went when I only tripped on the cat.",
      "start_timestamp": "03:25",
      "end_timestamp": "03:35",
      "supports": [
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 72, blood pressure 134 over 80, temperature 36.5, oxygen 97 percent, and you weigh 58 kilos.",
      "start_timestamp": "04:16",
      "end_timestamp": "04:25",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It's steady, and it's the same as last time, so you're not losing weight. Since you've had the fracture, I'd like to arrange a bone density scan, to see how strong the bones are now.",
      "start_timestamp": "04:36",
      "end_timestamp": "04:52",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And I'd like to see you again in three months, once the scan is done, to talk about the results.",
      "start_timestamp": "05:41",
      "end_timestamp": "05:50",
      "supports": [
        "clinical_actions[1]",
        "follow_up[0]"
      ]
    }
