  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hi. Mum said I had to come on my own, because she's at work and I'm fifteen. I've got chickenpox. At least I think so.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:15",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's fine, I'll make sure we talk through everything. When did the spots start?",
      "start_timestamp": "00:17",
      "end_timestamp": "00:25",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Three days ago. Now they're all over, but nothing in my mouth.",
      "start_timestamp": "00:26",
      "end_timestamp": "00:33",
      "supports": [
        "symptoms[0]",
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And what's been done about it so far? Let me go through what you're using.",
      "start_timestamp": "00:51",
      "end_timestamp": "01:00",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]",
        "medications[3]",
        "medications[4]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Calamine lotion, on the spots. Paracetamol, 500 mg, when I'm hot, maybe three a day. Cetirizine, 10 mg at night, so I can sleep. My inhaler, the blue one, when I wheeze. And emollient cream, for my eczema, twice a day.",
      "start_timestamp": "01:02",
      "end_timestamp": "01:23",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]",
        "medications[3]",
        "medications[4]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's a lot, and it sounds sensible. Any conditions apart from the chickenpox?",
      "start_timestamp": "01:26",
      "end_timestamp": "01:33",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Asthma, and eczema.",
      "start_timestamp": "01:35",
      "end_timestamp": "01:37",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any operations?",
      "start_timestamp": "01:38",
      "end_timestamp": "01:40",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Just my tonsils, when I was eight.",
      "start_timestamp": "01:43",
      "end_timestamp": "01:47",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you do sport, or go out anywhere?",
      "start_timestamp": "01:49",
      "end_timestamp": "01:54",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I play netball. But obviously not now.",
      "start_timestamp": "01:56",
      "end_timestamp": "02:01",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you have any allergies to medicines?",
      "start_timestamp": "02:04",
      "end_timestamp": "02:08",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No. None that I know of.",
      "start_timestamp": "02:11",
      "end_timestamp": "02:14",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "There are red spots and blisters in different stages, some scabbed, over your chest, back and arms, and none look infected.",
      "start_timestamp": "02:40",
      "end_timestamp": "02:51",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Until every spot has scabbed over, usually about five days after the spots began, so stay home.",
      "start_timestamp": "03:10",
      "end_timestamp": "03:18",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Keep away from her until you're better.",
      "start_timestamp": "03:44",
      "end_timestamp": "03:48",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Keep taking the paracetamol, but avoid ibuprofen, it can make chickenpox skin infections worse, and with asthma, it's best avoided.",
      "start_timestamp": "03:54",
      "end_timestamp": "04:06",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Come back if the spots become red, swollen and sore, you get a high fever, breathing problems, or you can't keep fluids down.",
      "start_timestamp": "04:49",
      "end_timestamp": "05:01",
