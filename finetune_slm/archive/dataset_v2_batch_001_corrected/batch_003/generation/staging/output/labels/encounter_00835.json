    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good questions, both of you. Mrs Rafferty, how long have you been on the prednisolone?",
      "start_timestamp": "00:21",
      "end_timestamp": "00:29",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "About five years, since the polymyalgia.",
      "start_timestamp": "00:31",
