  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Doctor, I'm worried. Mum's been on steroid tablets for a long time, and I've read they can thin the bones.",
