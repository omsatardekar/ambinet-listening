        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What other conditions do you have?",
      "start_timestamp": "02:20",
      "end_timestamp": "02:24",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "She had polymyalgia rheumatica, which is why the steroids, high blood pressure, and an underactive thyroid.",
      "start_timestamp": "02:25",
      "end_timestamp": "02:35",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is there any family history of osteoporosis?",
      "start_timestamp": "02:36",
      "end_timestamp": "02:40",
      "supports": [
        "medical_history.family_history[0]",
        "clinical_actions[2]",
        "follow_up[0]"
