      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Five milligrams, once a day.",
      "start_timestamp": "00:49",
      "end_timestamp": "00:52",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you. Any aches or pain in your back, any fractures, or loss of height?",
      "start_timestamp": "00:54",
      "end_timestamp": "01:04",
      "supports": [
        "symptoms[0]",
        "negative_findings[0]",
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No fractures. A little backache, now and then, for about two months.",
      "start_timestamp": "01:05",
      "end_timestamp": "01:11",
      "supports": [
        "symptoms[0]",
        "negative_findings[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "It's six months, Mum. You were holding your back at Christmas.",
      "start_timestamp": "01:13",
      "end_timestamp": "01:20",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "So two months from you and six months from your daughter. I'll record it as two to six months.",
      "start_timestamp": "01:23",
      "end_timestamp": "01:34",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "She's lost height, Mum. You used to be taller than me.",
      "start_timestamp": "01:37",
      "end_timestamp": "01:44",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_1",
