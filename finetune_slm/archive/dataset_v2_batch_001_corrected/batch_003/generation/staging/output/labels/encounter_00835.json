      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'll record that you say no, and your daughter says yes. I'll measure you today. Any other symptoms, bruising easily, or thin skin?",
