      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Bruises, yes, on my arms.",
      "start_timestamp": "02:07",
      "end_timestamp": "02:10",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
