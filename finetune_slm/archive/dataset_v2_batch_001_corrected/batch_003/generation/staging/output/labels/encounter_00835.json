      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Her mother broke her hip at eighty.",
      "start_timestamp": "02:41",
      "end_timestamp": "02:45",
      "supports": [
        "medical_history.family_history[0]",
        "clinical_actions[2]",
