      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I walk a mile a day. I've never smoked.",
      "start_timestamp": "02:52",
      "end_timestamp": "02:57",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Weight 58 kilos, and your height is 154 centimetres. In your notes it was 160, six years ago.",
      "start_timestamp": "03:36",
      "end_timestamp": "03:47",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_024",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's a loss of six centimetres, and it's a clue that the bones in your spine may be thinning.",
      "start_timestamp": "03:59",
      "end_timestamp": "04:09",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_025",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes. Long-term steroids do thin bones, and the earlier we protect them, the better. I'm going to prescribe a bone-protecting tablet, alendronic acid, 70 mg, once a week, with calcium and vitamin D.",
      "start_timestamp": "04:16",
      "end_timestamp": "04:34",
      "supports": [
        "medications[1]",
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_026",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes, but only one a week for the bone one. Take it first thing, with a full glass of water, and stay upright for thirty minutes.",
      "start_timestamp": "04:42",
      "end_timestamp": "04:56",
      "supports": [
        "clinical_actions[4]"
      ]
    },
    {
      "evidence_id": "EV_027",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd also like to arrange a bone density scan, and a blood test for your vitamin D and calcium.",
      "start_timestamp": "05:04",
      "end_timestamp": "05:14",
      "supports": [
        "procedures_and_investigations[0]",
        "procedures_and_investigations[1]",
        "clinical_actions[0]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_028",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And walking is excellent. Keep it up. If you get sudden severe back pain, or you fall, come in the same day.",
      "start_timestamp": "05:19",
      "end_timestamp": "05:31",
