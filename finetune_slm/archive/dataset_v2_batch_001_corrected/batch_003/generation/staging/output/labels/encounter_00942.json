      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Latex, as a child. I got a rash on my hands from balloons. I haven't had it since, but I always wear nitrile now.",
