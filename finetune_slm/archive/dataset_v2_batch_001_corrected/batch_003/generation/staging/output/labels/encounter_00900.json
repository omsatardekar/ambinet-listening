      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Penicillin, when I was a baby, my mother told me I had a rash. I've avoided it since.",
      "start_timestamp": "02:18",
      "end_timestamp": "02:28",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Noted. Any other conditions?",
