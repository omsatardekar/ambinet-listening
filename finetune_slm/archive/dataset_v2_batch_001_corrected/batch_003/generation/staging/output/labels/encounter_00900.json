      "end_timestamp": "01:21",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What medicines are you taking, if any?",
      "start_timestamp": "01:57",
      "end_timestamp": "02:01",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]"
      ]
    },
    {
