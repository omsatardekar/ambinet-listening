      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A multivitamin, a thyroid tablet, levothyroxine, 50 micrograms, and the contraceptive pill.",
      "start_timestamp": "02:03",
      "end_timestamp": "02:09",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any allergies to medicines or plasters?",
