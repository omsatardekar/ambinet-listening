      "speaker_role": "patient",
      "transcript_text": "Underactive thyroid. That's all.",
      "start_timestamp": "02:36",
      "end_timestamp": "02:39",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you. Pulse 72, blood pressure 118 over 74, weight 66 kilograms, I see. Perfect.",
      "start_timestamp": "02:51",
      "end_timestamp": "03:00",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It's an irregular brown mole, about seven millimetres, with an uneven edge and two shades of colour.",
      "start_timestamp": "03:36",
      "end_timestamp": "03:46",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I can't say from looking, and I don't like the irregular edge and the change that you describe.",
      "start_timestamp": "03:53",
      "end_timestamp": "04:04",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to remove the whole mole under local anaesthetic, and send it to the laboratory.",
      "start_timestamp": "04:13",
      "end_timestamp": "04:23",
