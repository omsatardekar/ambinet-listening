  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hello, doctor. I've noticed a new mole on my shoulder, and my husband insisted I get it looked at.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:10",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_4",
      "speaker_role": "family_member",
      "transcript_text": "I'm the husband. I spotted it in the summer when she was in her swimsuit. It looked different from her other moles.",
      "start_timestamp": "00:12",
      "end_timestamp": "00:25",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you both for coming. Where exactly is it?",
      "start_timestamp": "00:27",
      "end_timestamp": "00:32",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "On the back of my left shoulder. I can't see it, so I only know what he says.",
      "start_timestamp": "00:34",
      "end_timestamp": "00:44",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Has it changed in size or colour, according to your husband?",
      "start_timestamp": "00:45",
      "end_timestamp": "00:53",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_4",
      "speaker_role": "family_member",
      "transcript_text": "It's gotten bigger, I think, and darker at one edge.",
      "start_timestamp": "00:54",
      "end_timestamp": "01:00",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It does sometimes itch a little, and once it bled when I scratched it.",
      "start_timestamp": "01:01",
      "end_timestamp": "01:09",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any other moles that have changed?",
      "start_timestamp": "01:11",
      "end_timestamp": "01:14",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, the rest are the same as always.",
