  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Good morning, doctor. Thank you for seeing me. I was told at the kidney clinic that I'm anaemic, and I should come and discuss it.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:13",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Tired, I must say. More than usual. I used to garden every day, and now I sit down after twenty minutes.",
      "start_timestamp": "00:25",
      "end_timestamp": "00:36",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And what about your breathing?",
      "start_timestamp": "00:38",
      "end_timestamp": "00:41",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A bit short of breath on the hills, and the stairs. Not terrible.",
      "start_timestamp": "00:42",
      "end_timestamp": "00:50",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Since the new year. Gradually creeping up.",
      "start_timestamp": "01:15",
      "end_timestamp": "01:19",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "You have chronic kidney disease, I see, stage three.",
      "start_timestamp": "01:20",
      "end_timestamp": "01:25",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, they told me eighteen months ago. It's stable, they say.",
      "start_timestamp": "01:27",
      "end_timestamp": "01:34",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 80, blood pressure 132 over 76, oxygen 97 percent.",
      "start_timestamp": "02:00",
      "end_timestamp": "02:06",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I think that's the most likely cause, I'd say anaemia of chronic kidney disease.",
      "start_timestamp": "03:18",
      "end_timestamp": "03:26",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes. First, I'd like to arrange more blood tests, to check your iron, vitamin B12 and folate levels, because other causes need ruling out.",
      "start_timestamp": "03:31",
      "end_timestamp": "03:43",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Eat iron-rich foods, like red meat, spinach, and beans, and don't take iron tablets until we've checked.",
      "start_timestamp": "04:26",
      "end_timestamp": "04:34",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pace yourself, build up your gardening slowly. I'd like to see you again in two weeks with the results.",
      "start_timestamp": "04:51",
      "end_timestamp": "05:00",
      "supports": [
        "clinical_actions[1]",
        "follow_up[0]"
      ]
    }
