  "clinical_uncertainties": [],
  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Morning, doctor. I'm sorry to come about this, but I've got this awful pain in my face, on the right, when I chew. It's like an electric shock.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:13",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Tell me more about it. How long has it been going on?",
      "start_timestamp": "00:14",
      "end_timestamp": "00:21",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Two weeks. It started with a shooting pain in my cheek, when I was brushing my teeth, and it's been coming and going ever since.",
      "start_timestamp": "00:23",
      "end_timestamp": "00:35",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long does each attack last?",
      "start_timestamp": "00:37",
      "end_timestamp": "00:41",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A few seconds. Maybe ten. It's sharp, and then it's gone, and I'm left waiting for the next one.",
      "start_timestamp": "00:43",
      "end_timestamp": "00:52",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What sets it off?",
      "start_timestamp": "00:55",
      "end_timestamp": "00:58",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Chewing, brushing my teeth, a cold breeze on my face, even talking, sometimes.",
      "start_timestamp": "01:00",
      "end_timestamp": "01:07",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Where exactly is the pain?",
      "start_timestamp": "01:09",
      "end_timestamp": "01:13",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Along the cheek, to the corner of my mouth, and my upper jaw, on the right.",
      "start_timestamp": "01:16",
      "end_timestamp": "01:25",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any pain between the attacks, or toothache?",
      "start_timestamp": "01:28",
      "end_timestamp": "01:32",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No pain in between. And my teeth are fine, I've seen the dentist, who found nothing.",
      "start_timestamp": "01:33",
      "end_timestamp": "01:43",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any numbness, or weakness of the face, or changes in your vision?",
      "start_timestamp": "01:46",
      "end_timestamp": "01:53",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, none of those.",
      "start_timestamp": "01:55",
      "end_timestamp": "01:58",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any previous health conditions?",
      "start_timestamp": "02:01",
      "end_timestamp": "02:03",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "High blood pressure, that's all.",
      "start_timestamp": "02:05",
      "end_timestamp": "02:08",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Anyone in the family with similar pain?",
      "start_timestamp": "02:11",
      "end_timestamp": "02:15",
      "supports": [
        "medical_history.family_history[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My aunt had a nerve thing in her face, I think.",
      "start_timestamp": "02:16",
      "end_timestamp": "02:23",
      "supports": [
        "medical_history.family_history[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any allergies to medicines?",
      "start_timestamp": "02:25",
      "end_timestamp": "02:28",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Years ago, carbamazepine, I think I broke out in a rash, so I haven't had it since.",
      "start_timestamp": "02:29",
      "end_timestamp": "02:39",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 72, blood pressure 140 over 86, temperature 36.6.",
      "start_timestamp": "03:05",
      "end_timestamp": "03:11",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "The feeling is normal on both sides of the face, your jaw muscles are strong, and I can trigger a shooting pain by lightly touching the right cheek.",
      "start_timestamp": "03:49",
      "end_timestamp": "04:04",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What you describe, brief electric-shock pains in the cheek and jaw, triggered by touch, chewing and cold air, with a normal examination, fits trigeminal neuralgia, a condition of the facial nerve.",
      "start_timestamp": "04:09",
      "end_timestamp": "04:28",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "There's a medicine for nerve pain, but the usual first choice, carbamazepine, is the one that gave you a rash. So I'd like to start you on a different one, gabapentin.",
      "start_timestamp": "04:44",
      "end_timestamp": "05:01",
      "supports": [
        "medications[0]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_024",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It can. Start with 300 mg at night, and we'll increase it slowly.",
      "start_timestamp": "05:08",
      "end_timestamp": "05:15",
      "supports": [
        "medications[0]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_025",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Avoid triggers where you can, a scarf over your face in cold air, chew on the left, and brush gently.",
      "start_timestamp": "05:19",
      "end_timestamp": "05:30",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_026",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to see you in two weeks to see how it's working.",
      "start_timestamp": "05:36",
      "end_timestamp": "05:43",
      "supports": [
        "clinical_actions[0]",
        "follow_up[0]"
      ]
    }
