      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "A sudden husky voice after heavy use, with some reflux in the background, looks most like laryngitis.",
      "start_timestamp": "03:15",
      "end_timestamp": "03:25",
      "supports": [
        "clinical_assessment[0]"
