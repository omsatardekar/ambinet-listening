    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I can hear it, a bit husky. When did it come on, exactly?",
      "start_timestamp": "00:39",
      "end_timestamp": "00:47",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Ten days ago, rather suddenly. I woke up and it simply wasn't there, I could only whisper.",
      "start_timestamp": "00:48",
      "end_timestamp": "00:56",
      "supports": [
        "symptoms[0]"
      ]
