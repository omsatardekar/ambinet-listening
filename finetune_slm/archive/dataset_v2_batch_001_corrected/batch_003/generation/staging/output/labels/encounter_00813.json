    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long has that been going on?",
      "start_timestamp": "00:09",
      "end_timestamp": "00:13",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Eight months, nearly. It started in my toes, and now it's the whole of both feet.",
      "start_timestamp": "00:17",
      "end_timestamp": "00:25",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Can you describe it?",
      "start_timestamp": "00:28",
      "end_timestamp": "00:30",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Like they've been dipped in hot water, or a pins and needles. Sheets feel too heavy.",
      "start_timestamp": "00:33",
      "end_timestamp": "00:41",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What are you taking at the moment?",
      "start_timestamp": "01:12",
      "end_timestamp": "01:16",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Metformin, 1000 mg twice a day, for my diabetes.",
      "start_timestamp": "01:19",
      "end_timestamp": "01:25",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any allergies to medicines?",
      "start_timestamp": "01:42",
      "end_timestamp": "01:45",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Gabapentin. I had a swollen face, a few years back. The GP said never again.",
      "start_timestamp": "01:48",
      "end_timestamp": "01:56",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your skin is dry, and you've lost some feeling to light touch on the soles of both feet, and the vibration sense is reduced at the toes, but the pulses are good.",
      "start_timestamp": "02:29",
      "end_timestamp": "02:48",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "This looks like diabetic nerve damage, peripheral neuropathy, I'd say.",
      "start_timestamp": "02:56",
      "end_timestamp": "03:02",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to arrange a blood test for your sugar control, the HbA1c, and your vitamin B12, as metformin can lower it, and other causes need ruling out.",
      "start_timestamp": "03:30",
      "end_timestamp": "03:45",
      "supports": [
        "procedures_and_investigations[0]",
        "procedures_and_investigations[1]",
        "clinical_actions[0]",
