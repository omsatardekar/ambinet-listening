      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Meanwhile, check your feet every day for blisters or cuts, wear well-fitting shoes, and never walk barefoot.",
