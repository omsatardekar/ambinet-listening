  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "G'day. It's my feet. They burn. Mostly at night. Drives me mad.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:07",
      "supports": [
        "chief_complaint",
