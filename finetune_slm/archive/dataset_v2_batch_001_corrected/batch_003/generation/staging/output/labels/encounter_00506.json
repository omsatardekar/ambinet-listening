  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A scratchy throat, mostly. It started two days ago, and it's mild, really. I woke up on Tuesday feeling like I'd swallowed a cheese grater but nothing dreadful.",
      "start_timestamp": "01:31",
      "end_timestamp": "01:44",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Mild, two days. Have you been short of breath at all?",
      "start_timestamp": "01:46",
      "end_timestamp": "01:53",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, none, my breathing's fine. I did the stairs at the home twice this morning before she sent me off.",
      "start_timestamp": "01:55",
      "end_timestamp": "02:07",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Oh, it's a lot. I'm at the home six days out of seven, mornings mostly. Lifting, washing, feeding, chatting. Mr. Hollis in room nine tells me the same joke every single day, and I laugh every single day.",
      "start_timestamp": "02:20",
      "end_timestamp": "02:39",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That sounds like the best part of the job. And at home, who do you live with?",
      "start_timestamp": "02:40",
      "end_timestamp": "02:51",
      "supports": [
        "medical_history.social_history[2]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My daughter and her two little ones, so I'm covered in germs from both ends, to be honest. The youngest brought something home from nursery last week, so I wonder if that's where it started.",
      "start_timestamp": "02:52",
      "end_timestamp": "03:11",
      "supports": [
        "medical_history.social_history[2]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Quite possibly. Do you smoke at all?",
      "start_timestamp": "03:12",
      "end_timestamp": "03:16",
      "supports": [
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I used to. Gave up smoking about two years ago, after thirty years of cigarettes, and I still miss them on a bad day.",
      "start_timestamp": "03:18",
      "end_timestamp": "03:30",
      "supports": [
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Migraines, but only a few a year now. And irritable bowel syndrome, which flares when the home is short-staffed. Nothing else, thank goodness.",
      "start_timestamp": "03:41",
      "end_timestamp": "03:53",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your throat is a little red at the back, with no white patches. That's quite mild.",
      "start_timestamp": "04:28",
      "end_timestamp": "04:37",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Now your numbers, which Priya got ready for me. Blood pressure is 118 over 74, and your pulse is 84.",
      "start_timestamp": "04:46",
      "end_timestamp": "04:57",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Temperature is 37.9, so just slightly raised. Oxygen saturation is 98 percent, and your breathing rate is 16 a minute.",
      "start_timestamp": "05:09",
      "end_timestamp": "05:18",
      "supports": [
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It's only just up. What matters is what we do about work. Because of who you look after, I'd like to do a swab for flu and COVID, so we know what you are dealing with before you go back.",
      "start_timestamp": "05:33",
      "end_timestamp": "05:55",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Ha, I'll leave that one with you. Priya will do the swab in the next room. And in the meantime, stay off work until the result is back, and then until you've gone a couple of days without a temperature.",
      "start_timestamp": "06:31",
      "end_timestamp": "06:55",
      "supports": [
        "clinical_actions[1]"
      ]
    }
