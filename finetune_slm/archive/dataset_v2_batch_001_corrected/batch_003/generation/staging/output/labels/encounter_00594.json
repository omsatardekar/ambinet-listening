  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Good afternoon, doctor. I was told to come for my follow-up after losing the baby, three weeks on from the hospital.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:10",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "There's some cramping low down, like period pains, mainly in the evenings.",
      "start_timestamp": "01:02",
      "end_timestamp": "01:09",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "When did the cramping begin? Was it straight after you came home?",
      "start_timestamp": "01:12",
      "end_timestamp": "01:20",
      "supports": [
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Goodness, I really couldn't say. It might have been the week after, or perhaps before, it's all rather a blur.",
      "start_timestamp": "01:20",
      "end_timestamp": "01:30",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I've been terribly tired, for about three weeks. I'm in bed by eight, which is not like me at all.",
      "start_timestamp": "01:37",
      "end_timestamp": "01:48",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Mm. Have you had any fever or shivers since you came home?",
      "start_timestamp": "01:51",
      "end_timestamp": "01:58",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, no fever at all. I did check, because the nurse at the ward told me to.",
      "start_timestamp": "02:00",
      "end_timestamp": "02:09",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Only my appendix, taken out when I was fifteen. Nothing since.",
      "start_timestamp": "02:21",
      "end_timestamp": "02:27",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My mother had fibroids, if that's relevant. She never really spoke about it.",
      "start_timestamp": "02:36",
      "end_timestamp": "02:43",
      "supports": [
        "medical_history.family_history[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Well, that's the odd thing. I think I might be allergic to something they gave me in hospital, but nobody could tell me what.",
      "start_timestamp": "02:57",
      "end_timestamp": "03:11",
      "supports": [
        "allergies[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you remember what happened when you took it?",
      "start_timestamp": "03:13",
      "end_timestamp": "03:18",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I see. So we have a possible allergy, no name, no clear reaction. I'll ask the hospital to send their notes, but let's be careful in the meantime.",
      "start_timestamp": "03:31",
      "end_timestamp": "03:45",
      "supports": [
        "allergies[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "The abdomen feels soft, and there's no tenderness in the lower right side.",
      "start_timestamp": "05:14",
      "end_timestamp": "05:21",
      "supports": [
        "physical_examination[0]",
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Now, what I'm seeing and hearing is most likely a womb that's settling back down normally. The cramps fit with that.",
      "start_timestamp": "05:45",
      "end_timestamp": "05:57",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "The tiredness is common too, but I'd like to give you iron tablets. Ferrous sulfate 200 mg twice a day, with a little orange juice if you can bear it.",
      "start_timestamp": "06:07",
      "end_timestamp": "06:25",
      "supports": [
        "medications[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Ha. Tea can block the iron, so keep your cuppa away from the tablets by an hour or so.",
      "start_timestamp": "06:34",
      "end_timestamp": "06:44",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Gentle walks are good for you. Go at your own pace and rest when you need to.",
      "start_timestamp": "07:00",
      "end_timestamp": "07:09",
      "supports": [
        "clinical_actions[1]"
      ]
    }
