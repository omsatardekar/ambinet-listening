  "clinical_uncertainties": [],
  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Doctor, it's the blurred vision when I'm reading. The words go all fuzzy and I'm terrified it's the start of something awful, like going blind.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:12",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "About three months ago, give or take.",
      "start_timestamp": "00:19",
      "end_timestamp": "00:23",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It's worse in the evenings, under the lamp. In the morning it's not so bad. Is that a bad sign?",
      "start_timestamp": "00:32",
      "end_timestamp": "00:42",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Holding the page further away helps a bit.",
      "start_timestamp": "00:53",
      "end_timestamp": "00:57",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Okay, that's useful. What about the eyes themselves, how do they feel?",
      "start_timestamp": "01:00",
      "end_timestamp": "01:07",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Tired. My eyes feel tired by the evening, like I've been staring too long, even when I haven't.",
      "start_timestamp": "01:12",
      "end_timestamp": "01:20",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Mm-hm. Any headaches that go with it?",
      "start_timestamp": "01:20",
      "end_timestamp": "01:24",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I did get headaches in the first month, behind the eyes. But they've gone now. I haven't had one in weeks.",
      "start_timestamp": "01:25",
      "end_timestamp": "01:37",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good, so that part has settled. Have you seen any flashing lights, or a curtain coming across your vision?",
      "start_timestamp": "01:38",
      "end_timestamp": "01:47",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, nothing like that. No flashes. Oh, goodness, would that be worse?",
      "start_timestamp": "01:50",
      "end_timestamp": "01:56",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Well, I'm on the metformin, 500 milligrams twice a day, for the diabetes. Then there's the ramipril, 5 milligrams every morning, for my blood pressure.",
      "start_timestamp": "02:16",
      "end_timestamp": "02:27",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, sorry, the atorvastatin, 40 milligrams at night, for the cholesterol.",
      "start_timestamp": "02:31",
      "end_timestamp": "02:36",
      "supports": [
        "medications[2]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "The diabetes about nine years now. The blood pressure I've had even longer.",
      "start_timestamp": "02:50",
      "end_timestamp": "02:56",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "No one's pointing fingers. Let's see what we're dealing with. Have you had any trouble with your heart or chest? Chest pain, puffing on the stairs?",
      "start_timestamp": "02:59",
      "end_timestamp": "03:10",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, nothing there.",
      "start_timestamp": "03:11",
      "end_timestamp": "03:13",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's good to hear. Now, about smoking. Do you smoke at all?",
      "start_timestamp": "03:14",
      "end_timestamp": "03:20",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, I stopped smoking about ten years ago.",
      "start_timestamp": "03:23",
      "end_timestamp": "03:27",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pressure is 142 over 86, and your pulse is 72 beats per minute.",
      "start_timestamp": "03:48",
      "end_timestamp": "03:54",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I can see some slight cloudiness in the lens of both eyes, like a window that's got a bit of fog on it. And at the back of the eye there's no bleeding, which is one thing I was keen to check, with your diabetes.",
      "start_timestamp": "05:01",
      "end_timestamp": "05:20",
      "supports": [
        "physical_examination[0]",
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "From what I can see, this looks like early cataracts. That's the lens clouding over slowly, common as we get older.",
      "start_timestamp": "05:26",
      "end_timestamp": "05:36",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "First, I'd like to get a blood test called HbA1c, that tells us your average sugar over the last three months.",
      "start_timestamp": "06:06",
      "end_timestamp": "06:15",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Whatever it says, we can work with it. And second, I'd like to arrange retinal photographs, where we take a picture of the back of both eyes.",
      "start_timestamp": "06:24",
      "end_timestamp": "06:37",
      "supports": [
        "procedures_and_investigations[1]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "In the meantime, use a brighter light for reading, and take a break from the phone every half hour or so.",
      "start_timestamp": "07:00",
      "end_timestamp": "07:10",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_024",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "No rush at all. Once I've got the blood results and the photos, I'd like you back in four weeks, so we can go over it all together and decide on the next step.",
      "start_timestamp": "07:43",
      "end_timestamp": "08:00",
      "supports": [
        "clinical_actions[3]",
        "follow_up[0]"
      ]
    }
