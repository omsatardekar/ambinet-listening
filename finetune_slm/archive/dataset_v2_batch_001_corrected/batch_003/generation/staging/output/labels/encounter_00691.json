  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Morning. I'll be honest, I've got forty minutes before a site meeting, so can we be efficient? It's about my gout, and my kidneys.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:14",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "We'll be efficient but thorough, because the two are connected. Tell me about the gout first.",
      "start_timestamp": "00:16",
      "end_timestamp": "00:26",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Big toe, left foot, swelled up last week, red and agony. It's gone down now, three days of tablets.",
      "start_timestamp": "00:28",
      "end_timestamp": "00:38",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And what did you take for it?",
      "start_timestamp": "00:41",
      "end_timestamp": "00:45",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Naproxen, 500 mg, twice a day, from the stash I keep. I always have some.",
      "start_timestamp": "00:47",
      "end_timestamp": "00:56",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's important. Let's go through everything you take.",
      "start_timestamp": "00:58",
      "end_timestamp": "01:03",
      "supports": [
        "medications[1]",
        "medications[2]",
        "medications[3]",
        "medications[4]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Allopurinol, 100 mg once a day. Ramipril, 5 mg once a day. Amlodipine, 5 mg once a day. And atorvastatin, 20 mg at night.",
      "start_timestamp": "01:07",
      "end_timestamp": "01:20",
      "supports": [
        "medications[1]",
        "medications[2]",
        "medications[3]",
        "medications[4]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. And your conditions, remind me.",
      "start_timestamp": "01:23",
      "end_timestamp": "01:27",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Gout, obviously. Kidney function, the blood tests said it's dropped a bit, chronic kidney disease, they called it. And high blood pressure.",
      "start_timestamp": "01:29",
      "end_timestamp": "01:39",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any gout in the family?",
      "start_timestamp": "01:42",
      "end_timestamp": "01:45",
      "supports": [
        "medical_history.family_history[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My father had it terribly, in his fifties.",
      "start_timestamp": "01:48",
      "end_timestamp": "01:53",
      "supports": [
        "medical_history.family_history[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 72, blood pressure 144 over 88, temperature 36.6, oxygen 98 percent, weight 94 kilos.",
      "start_timestamp": "02:20",
      "end_timestamp": "02:27",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "The big toe joint is no longer red or swollen, just a little tender.",
      "start_timestamp": "03:04",
      "end_timestamp": "03:12",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Here's the thing. Naproxen is an anti-inflammatory, and with kidney disease, and on ramipril, it can damage the kidneys further. I'd like you to stop using it.",
      "start_timestamp": "03:21",
      "end_timestamp": "03:37",
      "supports": [
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "There are safer options for a flare, and we'll agree them. For now, keep the naproxen out of the drawer.",
      "start_timestamp": "03:48",
      "end_timestamp": "03:58",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's the right drug for preventing attacks, and the dose is suitable for your kidneys. Keep taking it daily, even when the toe's fine.",
      "start_timestamp": "04:06",
      "end_timestamp": "04:18",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And drink plenty of water, at least two litres, and keep the beer low.",
      "start_timestamp": "04:25",
      "end_timestamp": "04:34",
      "supports": [
        "clinical_actions[3]"
      ]
    }
