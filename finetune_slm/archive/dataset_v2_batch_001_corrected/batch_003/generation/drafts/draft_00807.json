{
 "encounter_id": "00807",
 "speakers": {
  "person_1": "PATIENT",
  "person_2": "DOCTOR",
  "person_3": "FAMILY_MEMBER"
 },
 "turns": [
  {
   "s": "person_2",
   "t": "Good morning. How would you like to be addressed, Mr Arkwright, or Walter? ~"
  },
  {
   "s": "person_1",
   "t": "Mr Arkwright, if you'd be so kind. This is my son, Philip, who insisted on driving me. ~"
  },
  {
   "s": "person_3",
   "t": "Dad's been coughing up green sputum and I think it's a chest infection, so I booked it."
  },
  {
   "s": "person_2",
   "t": "Thank you, Philip. Mr Arkwright, when did the green sputum start?"
  },
  {
   "s": "person_1",
   "t": "Let me think. It was before the Bank Holiday. Or just after it. I really couldn't say with any confidence."
  },
  {
   "s": "person_3",
   "t": "Early last month, Dad? Or was it after the anniversary? I can't pin it down either."
  },
  {
   "s": "person_2",
   "t": "That's all right. Do you wheeze?"
  },
  {
   "s": "person_1",
   "t": "Yes, particularly at night. A sort of whistle when I breathe out."
  },
  {
   "s": "person_2",
   "t": "And how is your energy?"
  },
  {
   "s": "person_1",
   "t": "Poor. I'm tired all day."
  },
  {
   "s": "person_2",
   "t": "Do you cough up blood?"
  },
  {
   "s": "person_1",
   "t": "Certainly not."
  },
  {
   "s": "person_2",
   "t": "Fever or shivers?"
  },
  {
   "s": "person_1",
   "t": "No fever."
  },
  {
   "s": "person_2",
   "t": "Chest pain?"
  },
  {
   "s": "person_1",
   "t": "No pain, no."
  },
  {
   "s": "person_2",
   "t": "Weight loss?"
  },
  {
   "s": "person_1",
   "t": "None that I'm aware of."
  },
  {
   "s": "person_2",
   "t": "Swollen ankles?"
  },
  {
   "s": "person_1",
   "t": "No, my ankles are as they've always been."
  },
  {
   "s": "person_2",
   "t": "What inhalers do you use?"
  },
  {
   "s": "person_1",
   "t": "Tiotropium, maybe 18 micrograms, once a day, though I'd have to check the box. And salbutamol, when I'm wheezy."
  },
  {
   "s": "person_2",
   "t": "We'll verify the tiotropium. Any allergies?"
  },
  {
   "s": "person_1",
   "t": "Septrin. I broke out in a rash."
  },
  {
   "s": "person_2",
   "t": "Medical history?"
  },
  {
   "s": "person_1",
   "t": "COPD, high blood pressure, osteoporosis, and reflux."
  },
  {
   "s": "person_2",
   "t": "Operations?"
  },
  {
   "s": "person_1",
   "t": "A hip replacement in 2019, and cataracts in 2021."
  },
  {
   "s": "person_2",
   "t": "Lung problems in the family?"
  },
  {
   "s": "person_1",
   "t": "My father had emphysema. My sister has asthma."
  },
  {
   "s": "person_2",
   "t": "You smoked, I think."
  },
  {
   "s": "person_1",
   "t": "I gave up smoking twelve years ago. Forty a day for forty years, before that."
  },
  {
   "s": "person_2",
   "t": "Alcohol?"
  },
  {
   "s": "person_1",
   "t": "A sherry at Christmas."
  },
  {
   "s": "person_2",
   "t": "Who's at home?"
  },
  {
   "s": "person_1",
   "t": "I live with Philip now."
  },
  {
   "s": "person_2",
   "t": "And your work?"
  },
  {
   "s": "person_1",
   "t": "I was a factory foreman. Retired for eleven years."
  },
  {
   "s": "person_2",
   "t": "Let me check you. Oxygen 92 percent, pulse 88, temperature 37.6, breathing 20, blood pressure 142 over 84, weight 70 kilos.",
   "pause": 15.0
  },
  {
   "s": "person_3",
   "t": "Is the oxygen low? ~"
  },
  {
   "s": "person_2",
   "t": "A bit low for him, yes. Let me listen. Deep breaths, Mr Arkwright.",
   "pause": 10.0
  },
  {
   "s": "person_1",
   "t": "Is this how you want it? ~"
  },
  {
   "s": "person_2",
   "t": "Perfect. I can hear crackles at the right base, and wheeze throughout both lungs."
  },
  {
   "s": "person_1",
   "t": "Is that serious? ~"
  },
  {
   "s": "person_2",
   "t": "There's no swelling in the legs, which is good. Any trouble with your heart, palpitations, fluttering?"
  },
  {
   "s": "person_1",
   "t": "No, nothing at all."
  },
  {
   "s": "person_2",
   "t": "And your tummy, any trouble with your bowels?"
  },
  {
   "s": "person_1",
   "t": "No, nothing, all regular."
  },
  {
   "s": "person_2",
   "t": "This looks like a chest infection on top of the COPD, but I can't rule out pneumonia."
  },
  {
   "s": "person_3",
   "t": "Does he need antibiotics? ~"
  },
  {
   "s": "person_2",
   "t": "I'll decide after the X-ray. I'd like to arrange a chest X-ray today, and a sputum sample."
  },
  {
   "s": "person_3",
   "t": "I'll take him down now. ~"
  },
  {
   "s": "person_2",
   "t": "And I'd like to see you again in a week."
  },
  {
   "s": "person_1",
   "t": "A week. Thank you, doctor. ~"
  }
