{
 "encounter_id": "00901",
 "speakers": {
  "person_1": "PATIENT",
  "person_2": "DOCTOR",
  "person_3": "NURSE"
 },
 "turns": [
  {
   "s": "person_1",
   "t": "I'm here for the follow-up after my kidney stone procedure. I don't have long, so can we get on with it?"
  },
  {
   "s": "person_2",
   "t": "Of course. Can you remind me when the procedure was?"
  },
  {
   "s": "person_1",
   "t": "A few weeks ago. Maybe three, maybe four. I've lost track since the stent came out."
  },
  {
   "s": "person_2",
   "t": "How have you been since then? Any pain in the side?"
  },
  {
   "s": "person_1",
   "t": "No pain in the side. Not like before."
  },
  {
   "s": "person_2",
   "t": "Any blood in the urine?"
  },
  {
   "s": "person_1",
   "t": "Pink the first few days, but it's gone now."
  },
  {
   "s": "person_2",
   "t": "Any burning when passing urine, or fever?"
  },
  {
   "s": "person_1",
   "t": "No burning. No fever."
  },
  {
   "s": "person_2",
   "t": "How often are you passing urine?"
  },
  {
   "s": "person_1",
   "t": "More often than usual, and urgent. It's irritating."
  },
  {
   "s": "person_2",
   "t": "That can happen after a stent. What medicines are you taking?"
  },
  {
   "s": "person_1",
   "t": "Just tamsulosin, 400 micrograms, once a day."
  },
  {
   "s": "person_2",
   "t": "Do you have any allergies to medicines?"
  },
  {
   "s": "person_1",
   "t": "No, I don't have any."
  },
  {
   "s": "person_2",
   "t": "Any other conditions?"
  },
  {
   "s": "person_1",
   "t": "Gout, and high blood pressure."
  },
  {
   "s": "person_3",
   "t": "Doctor, I've taken his pulse and pressure, 74 and 132 over 80."
  },
  {
   "s": "person_2",
   "t": "Thank you. That's fine. Have you been drinking plenty of water? ~"
  },
  {
   "s": "person_1",
   "t": "I try to, about two litres. ~"
  },
  {
   "s": "person_2",
   "t": "That's good. The stone went to the lab. The result came back as a calcium oxalate stone."
  },
  {
   "s": "person_1",
   "t": "What does that mean for me? ~"
  },
  {
   "s": "person_2",
   "t": "It's the most common type. Drinking enough water, less salt, and moderate animal protein all help."
  },
  {
   "s": "person_1",
   "t": "Fine. I can do that. ~"
  },
  {
   "s": "person_2",
   "t": "I'd like to examine your tummy and loin now. ~"
  },
  {
   "s": "person_1",
   "t": "Go on.",
   "pause": 14.0
  },
  {
   "s": "person_2",
   "t": "No tenderness in either loin, and your abdomen is soft."
  },
  {
   "s": "person_1",
   "t": "Good. Are we done? ~"
  },
  {
   "s": "person_2",
   "t": "Nearly. I'd like to arrange a scan in three months, to check for any new stones."
  },
  {
   "s": "person_1",
   "t": "Three months. All right. ~"
  },
  {
   "s": "person_2",
   "t": "If you get severe pain, fever, or can't pass urine, come in straight away."
  },
  {
   "s": "person_1",
   "t": "I will. Thank you. ~"
  }
 ],
