{
 "encounter_id": "00837",
 "speakers": {
  "person_1": "PATIENT",
  "person_2": "DOCTOR",
  "person_3": "NURSE",
  "person_4": "FAMILY_MEMBER"
 },
 "turns": [
  {
   "s": "person_2",
   "t": "Mr Pryce, the booking says a painful big toe. Come in, sit, and I'll help you with that foot. Is this your wife? ~"
  },
  {
   "s": "person_4",
   "t": "I'm Gwen. He's been up all night. I told him to ring last week. ~"
  },
  {
   "s": "person_1",
   "t": "It's my big toe, doctor, the left one. It came on suddenly two days ago and it's the worst pain I've ever had. Is it broken? Is it infected? Is it going to be amputated?"
  },
  {
   "s": "person_2",
   "t": "It's very unlikely to be any of those. Describe the pain."
  },
  {
   "s": "person_1",
   "t": "Throbbing, severe, ten out of ten. Even the bedsheet on it is agony."
  },
  {
   "s": "person_2",
   "t": "Is it swollen?"
  },
  {
   "s": "person_1",
   "t": "Swollen like a plum, and hot."
  },
  {
   "s": "person_2",
   "t": "Are you limping?"
  },
  {
   "s": "person_4",
   "t": "He couldn't get his shoe on this morning. He's hopping about the kitchen."
  },
  {
   "s": "person_2",
   "t": "Did you knock it, or drop something on it?"
  },
  {
   "s": "person_1",
   "t": "No, nothing. I didn't hurt it."
  },
  {
   "s": "person_2",
   "t": "Any fever or shivers?"
  },
  {
   "s": "person_1",
   "t": "A bit warm last night, but no fever, no."
  },
  {
   "s": "person_2",
   "t": "Pain in any other joints?"
  },
  {
   "s": "person_1",
   "t": "No, just the toe."
  },
  {
   "s": "person_2",
   "t": "Any rash?"
  },
  {
   "s": "person_1",
   "t": "No rash."
  },
  {
   "s": "person_3",
   "t": "Doctor, would you like him on the couch with the foot up? ~"
  },
  {
   "s": "person_2",
   "t": "Yes please, nurse. Mr Pryce, what medicines are you taking?"
  },
  {
   "s": "person_1",
   "t": "Allopurinol, 100 mg, once a day. And naproxen, 250 mg, I took one last night, it did nothing."
  },
  {
   "s": "person_2",
   "t": "Any allergies?"
  },
  {
   "s": "person_1",
   "t": "Penicillin, when I was a boy. I had a rash."
  },
  {
   "s": "person_2",
   "t": "Medical history?"
  },
  {
   "s": "person_1",
   "t": "Gout, from years ago. High blood pressure. And I'm overweight, I know."
  },
  {
   "s": "person_2",
   "t": "Surgery?"
  },
  {
   "s": "person_1",
   "t": "Gallbladder, in 2016."
  },
  {
   "s": "person_2",
   "t": "Gout in the family?"
  },
  {
   "s": "person_1",
   "t": "My father had it terribly."
  },
  {
   "s": "person_2",
   "t": "What do you do?"
  },
  {
   "s": "person_1",
   "t": "I drive a bus. Twelve hours. It's my foot on the pedal, doctor, I can't work like this."
  },
  {
   "s": "person_2",
   "t": "Do you drink?"
  },
  {
   "s": "person_1",
   "t": "Four pints on a Saturday, and wine with dinner."
  },
  {
   "s": "person_2",
   "t": "And what do you eat?"
  },
  {
   "s": "person_4",
   "t": "Red meat, and he loves shellfish at the weekend."
  },
  {
   "s": "person_2",
   "t": "Let me check you. Pulse 86, blood pressure 150 over 94, temperature 37.4, oxygen 97 percent, breathing 16, weight 104 kilos.",
   "pause": 15.0
  },
  {
   "s": "person_1",
   "t": "Is the pressure dangerous? ~"
  },
  {
   "s": "person_2",
   "t": "High, from the pain. Now, the toe. I'll be gentle.",
   "pause": 10.0
  },
  {
   "s": "person_1",
   "t": "Ow! Stop! ~"
  },
  {
   "s": "person_2",
   "t": "The base of the left big toe is red, hot and swollen, and it's extremely tender to touch."
  },
  {
   "s": "person_1",
   "t": "I told you. ~"
  },
  {
   "s": "person_2",
   "t": "The other toes look fine, and the ankle moves normally."
  },
  {
   "s": "person_4",
   "t": "Is it infected? ~"
  },
  {
   "s": "person_2",
   "t": "Any trouble with your chest or breathing, Mr Pryce?"
  },
  {
   "s": "person_1",
   "t": "No, nothing, I'm fine in that way."
  },
  {
   "s": "person_2",
   "t": "This looks like a gout flare, the classic big toe."
  },
  {
   "s": "person_1",
   "t": "Not broken then? ~"
  },
  {
   "s": "person_2",
   "t": "I don't think so, but I'd like to arrange a uric acid blood test, a kidney function test, and an X-ray of the foot."
  },
  {
   "s": "person_3",
   "t": "I'll book the X-ray for this afternoon. ~"
  },
  {
   "s": "person_2",
   "t": "Thank you. Keep taking the naproxen with food, rest the foot, and drink plenty of water."
  },
  {
   "s": "person_1",
   "t": "Can I go to work? ~"
  },
  {
   "s": "person_2",
   "t": "Not on the pedal for a few days. I'd like to see you again in two weeks."
  },
  {
   "s": "person_4",
   "t": "Two weeks, I'll make sure he comes. ~"
  }
 ],
