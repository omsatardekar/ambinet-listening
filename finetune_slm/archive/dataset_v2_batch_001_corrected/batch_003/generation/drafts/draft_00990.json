 "turns": [
  {
   "s": "person_1",
   "t": "Doctor, it's a bit awkward. I've been itchy around the back passage for about three weeks."
  },
  {
   "s": "person_2",
   "t": "Thank you for saying. Is it worse at any time?"
  },
