  "person_4": "CLINICAL_STAFF"
 },
 "turns": [
  {
   "s": "person_1",
   "t": "Wasp. In the mouth. Throat feels funny."
  },
  {
   "s": "person_2",
   "t": "Okay. When did it happen?"
  },
  {
   "s": "person_1",
   "t": "Ten minutes ago. Drinking from a can."
  },
  {
   "s": "person_2",
   "t": "Do you have trouble breathing or swallowing?"
  },
  {
   "s": "person_1",
   "t": "Swallowing, a bit tight. No problem breathing."
  },
  {
   "s": "person_2",
   "t": "Any hives, or itching over your body?"
  },
  {
   "s": "person_1",
   "t": "No. Just the lip."
  },
  {
   "s": "person_2",
   "t": "Have you been stung before?"
  },
  {
   "s": "person_1",
   "t": "Once as a kid. Swelled up. Haven't been near them since."
  },
  {
   "s": "person_2",
   "t": "Any allergies we know about?"
  },
  {
   "s": "person_1",
   "t": "Wasps, I suppose. Not sure of the reaction, I was little."
  },
  {
   "s": "person_3",
   "t": "Doctor, the monitor is on. Do you want a drip in? ~"
  },
  {
   "s": "person_2",
   "t": "Yes, please. And let's get his observations. ~"
  },
  {
   "s": "person_4",
   "t": "Pulse 104, blood pressure 124 over 78, oxygen 98 percent, temperature 36.7, breathing 18."
  },
  {
   "s": "person_2",
   "t": "Thank you. His lip is swollen on the left side, and the tongue looks normal, and I can see the back of the throat clearly."
  },
  {
   "s": "person_1",
   "t": "Am I going to be okay? ~"
  },
  {
   "s": "person_2",
   "t": "I think so, but a sting inside the mouth can swell, so we're going to watch you closely."
  },
  {
   "s": "person_1",
   "t": "Will I get an injection? ~"
  },
  {
   "s": "person_2",
   "t": "Not yet, because your breathing is fine and you have no hives. If it gets worse, we'll give adrenaline straight away."
  },
  {
   "s": "person_3",
   "t": "Adrenaline is drawn up and by the bed, doctor. ~"
  },
  {
   "s": "person_2",
   "t": "Good. I'm going to give you an antihistamine, chlorphenamine, 10 mg, by injection."
  },
  {
   "s": "person_1",
   "t": "Okay.",
   "pause": 14.0
  },
  {
   "s": "person_2",
   "t": "And I'd like to keep you in the department for a few hours of observation."
  },
  {
   "s": "person_1",
   "t": "How many hours? ~"
  },
  {
   "s": "person_2",
   "t": "At least four. I'd like you to put some ice on the lip, and sip cold water if you can swallow."
  },
  {
   "s": "person_1",
   "t": "Right. I'll try. ~"
  },
  {
   "s": "person_2",
   "t": "If your breathing gets harder, or your voice changes, press the call button immediately."
  },
  {
   "s": "person_1",
   "t": "I will. ~"
  },
  {
   "s": "person_2",
   "t": "And before you go, we'll talk about carrying an adrenaline pen."
  },
  {
   "s": "person_1",
   "t": "Okay. Thank you. ~"
  }
 ],
