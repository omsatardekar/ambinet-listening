{
 "encounter_id": "00950",
 "speakers": {
  "person_1": "PATIENT",
  "person_2": "DOCTOR",
  "person_3": "CAREGIVER"
 },
 "turns": [
  {
   "s": "person_3",
   "t": "Morning, doctor. This is Ellie, she's three. I'm her childminder, Becca, her mum asked me to bring her in, and I've written everything down. She's had a fever for two days."
  },
  {
   "s": "person_2",
   "t": "Thank you, Becca. A fever for two days. How high has it been?"
  },
  {
   "s": "person_3",
   "t": "Thirty-eight point five at its highest, last night. This morning thirty-eight point two. ~"
  },
  {
   "s": "person_2",
   "t": "Ellie, hello. Can you tell me if your tummy hurts?"
  },
  {
   "s": "person_1",
   "t": "No tummy!"
  },
  {
   "s": "person_3",
   "t": "She was clutching her tummy at lunch yesterday, doctor. She curled up on the sofa and held it."
  },
  {
   "s": "person_2",
   "t": "I'll write down what you both say. Ellie, you say no tummy, Becca says tummy yesterday. Any rash, Becca?"
  },
  {
   "s": "person_3",
   "t": "No rash. I checked her all over at bath time."
  },
  {
   "s": "person_2",
   "t": "What have you been giving her for the fever?"
  },
  {
   "s": "person_3",
   "t": "Paracetamol syrup, 5 ml, every six hours. And ibuprofen syrup, 5 ml, in between, as her mum said."
  },
  {
   "s": "person_2",
   "t": "That's fine. Any history I should know about?"
  },
  {
   "s": "person_3",
   "t": "She's got eczema, mild."
  },
  {
   "s": "person_2",
   "t": "Let me take her numbers. Ellie, can I put this little clip on your finger?",
   "pause": 10.0
  },
  {
   "s": "person_1",
   "t": "Finger! ~"
  },
  {
   "s": "person_2",
   "t": "Temperature 38.4, pulse 130, and weight 13 kilos.",
   "pause": 10.0
  },
  {
   "s": "person_3",
   "t": "Is that high? ~"
  },
  {
   "s": "person_2",
   "t": "The pulse is quick, which is expected with a fever. Becca, any cough or runny nose?"
  },
  {
   "s": "person_3",
   "t": "No, nothing like that, her chest has been clear."
  },
  {
   "s": "person_2",
   "t": "Is she drinking? ~"
  },
  {
   "s": "person_3",
   "t": "Yes, she's had milk and juice, she's weeing normally. ~"
  },
  {
   "s": "person_2",
   "t": "Is she playing? ~"
  },
  {
   "s": "person_3",
   "t": "In bursts. Then she flops. ~"
  },
  {
   "s": "person_2",
   "t": "That's a good sign that she's perking up in between. Ellie, you're being very brave. ~"
  },
  {
   "s": "person_1",
   "t": "Bye-bye, doctor. ~"
  },
  {
   "s": "person_2",
   "t": "Not yet, sweetheart. Becca, I don't want to label this today. I'd like to watch her. ~"
  },
  {
   "s": "person_3",
   "t": "What should I watch for? ~"
  },
  {
   "s": "person_2",
   "t": "Keep giving the fluids and keep the paracetamol and ibuprofen going as you have been."
  },
  {
   "s": "person_3",
   "t": "Okay. ~"
  },
  {
   "s": "person_2",
   "t": "If she stops drinking, has a rash, or seems very sleepy, ring us or go to the emergency department right away."
  },
  {
   "s": "person_3",
   "t": "I will. ~"
  },
  {
   "s": "person_2",
   "t": "I'd like to see her again tomorrow."
  },
  {
   "s": "person_3",
   "t": "Tomorrow, yes. I'll let her mum know. ~"
  }
 ],
