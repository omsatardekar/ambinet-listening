{
 "encounter_id": "00879",
 "speakers": {
  "person_1": "PATIENT",
  "person_2": "DOCTOR",
  "person_3": "CLINICAL_STAFF"
 },
 "turns": [
  {
   "s": "person_1",
   "t": "I'm so thirsty all the time and I'm passing a huge amount of urine. I wondered if it might be diabetes."
  },
  {
   "s": "person_2",
   "t": "That's a sensible thing to ask. How long has this been going on?"
  },
  {
   "s": "person_1",
   "t": "About one month. I get up three times a night just to drink water."
  },
  {
   "s": "person_3",
   "t": "I'll take your blood pressure and weight while you talk to the doctor. ~"
  },
  {
   "s": "person_2",
   "t": "Thank you. Do you have any family history of diabetes?"
  },
  {
   "s": "person_1",
   "t": "My father had it. He was on tablets."
  },
  {
   "s": "person_2",
   "t": "Have you lost weight, or have blurred vision?"
  },
  {
   "s": "person_1",
   "t": "I haven't lost weight. My vision's fine."
  },
  {
   "s": "person_2",
   "t": "What medicines do you take at the moment?"
  },
  {
   "s": "person_1",
   "t": "Ramipril, 10 mg, once a day. A cholesterol tablet, I think it's simvastatin. And a water tablet, which I can't name."
  },
  {
   "s": "person_2",
   "t": "Do you remember the dose of the simvastatin?"
  },
  {
   "s": "person_1",
   "t": "Forty, I think. Or twenty. I'd have to check the box."
  },
  {
   "s": "person_2",
   "t": "Don't worry, you can bring it next time. Any other conditions?"
  },
  {
   "s": "person_1",
   "t": "High blood pressure and high cholesterol."
  },
  {
   "s": "person_3",
   "t": "Blood pressure 142 over 88, weight 94 kilograms."
  },
  {
   "s": "person_2",
   "t": "Thank you. A bit up on the pressure. I'll check your blood sugar with a finger prick now."
  },
  {
   "s": "person_1",
   "t": "Oh, of course.",
   "pause": 18.0
  },
  {
   "s": "person_2",
   "t": "The finger-prick sugar is 14.2, which is high."
  },
  {
   "s": "person_1",
   "t": "Is that diabetes? ~"
  },
  {
   "s": "person_2",
   "t": "It strongly suggests it, but I need a proper blood test to confirm."
  },
  {
   "s": "person_1",
   "t": "Will it need insulin? ~"
  },
  {
   "s": "person_2",
   "t": "Not necessarily. Many people start with tablets, diet and exercise. Let's get the tests first. ~"
  },
  {
   "s": "person_1",
   "t": "What tests? ~"
  },
  {
   "s": "person_2",
   "t": "I will arrange a blood test for HbA1c, kidney function and cholesterol, and a urine test."
  },
  {
   "s": "person_1",
   "t": "When? ~"
  },
  {
   "s": "person_2",
   "t": "The nurse can take the blood today, and I'd like to see you again in a week with the results."
  },
  {
   "s": "person_1",
   "t": "That's fine. ~"
  },
  {
   "s": "person_2",
   "t": "Until then, drink water rather than sugary drinks, and try to cut back on sweet foods."
  },
  {
   "s": "person_1",
   "t": "I will. ~"
  },
  {
   "s": "person_2",
   "t": "If you start vomiting, feel very drowsy, or become short of breath, go to the emergency department."
  },
  {
   "s": "person_1",
   "t": "Understood. Thanks, doctor. ~"
  }
 ],
