{
 "encounter_id": "00986",
 "speakers": {
  "person_1": "PATIENT",
  "person_2": "DOCTOR",
  "person_3": "UNKNOWN"
 },
 "turns": [
  {
   "s": "person_2",
   "t": "Hello Tamsin, come in. How far along are you now? ~"
  },
  {
   "s": "person_1",
   "t": "Twenty-four weeks. I'm here for the asthma, the midwife said I should have a review."
  },
  {
   "s": "person_2",
   "t": "Good plan. How's your breathing been?"
  },
  {
   "s": "person_1",
   "t": "A bit wheezy at night. Not every night."
  },
  {
   "s": "person_2",
   "t": "And during the day?"
  },
  {
   "s": "person_1",
   "t": "A little short of breath on the stairs at work."
  },
  {
   "s": "person_3",
   "t": "[from the corridor] She's been coughing all week!"
  },
  {
   "s": "person_2",
   "t": "Sorry, who was that? ~"
  },
  {
   "s": "person_1",
   "t": "No idea, doctor. Someone passing. ~"
  },
  {
   "s": "person_2",
   "t": "I'll note a voice from the corridor says you've coughed all week. Is that right?"
  },
  {
   "s": "person_1",
   "t": "A bit, yes. A dry tickly one."
  },
  {
   "s": "person_2",
   "t": "Any chest pain?"
  },
  {
   "s": "person_1",
   "t": "No chest pain."
  },
  {
   "s": "person_2",
   "t": "Fever?"
  },
  {
   "s": "person_1",
   "t": "No fever."
  },
  {
   "s": "person_2",
   "t": "Any swelling in your legs?"
  },
  {
   "s": "person_1",
   "t": "No swelling."
  },
  {
   "s": "person_2",
   "t": "What do you use for it?"
  },
  {
   "s": "person_1",
   "t": "Budesonide, 200 micrograms, twice a day, and salbutamol when I'm wheezy."
  },
  {
   "s": "person_2",
   "t": "And allergies?"
  },
  {
   "s": "person_1",
   "t": "Penicillin. I get a rash."
  },
  {
   "s": "person_2",
   "t": "Any other conditions?"
  },
  {
   "s": "person_1",
   "t": "Asthma, since I was a kid, and hay fever."
  },
  {
   "s": "person_2",
   "t": "Operations?"
  },
  {
   "s": "person_1",
   "t": "Tonsils, when I was ten."
  },
  {
   "s": "person_2",
   "t": "Asthma or allergies in the family?"
  },
  {
   "s": "person_1",
   "t": "My mum has asthma, and my sister has eczema."
  },
  {
   "s": "person_2",
   "t": "Do you smoke?"
  },
  {
   "s": "person_1",
   "t": "Never."
  },
  {
   "s": "person_2",
   "t": "What do you do for work?"
  },
  {
   "s": "person_1",
   "t": "I'm a physiotherapist."
  },
  {
   "s": "person_2",
   "t": "And exercise?"
  },
  {
   "s": "person_1",
   "t": "Prenatal yoga, twice a week."
  },
  {
   "s": "person_2",
   "t": "Let me check you. Pulse 84, blood pressure 112 over 68, temperature 36.7, oxygen 98 percent, breathing 18, and weight 72 kilos.",
   "pause": 15.0
  },
  {
   "s": "person_1",
   "t": "Good? ~"
  },
  {
   "s": "person_2",
   "t": "Good. Take a deep breath in and out for me.",
   "pause": 10.0
  },
  {
   "s": "person_2",
   "t": "I can hear a little wheeze at the end of each breath out."
  },
  {
   "s": "person_1",
   "t": "That's the one. ~"
  },
  {
   "s": "person_2",
   "t": "Your chest is moving equally on both sides, and your heart sounds are normal."
  },
  {
   "s": "person_1",
   "t": "Good. ~"
  },
  {
   "s": "person_2",
   "t": "And there's no swelling in your ankles."
  },
  {
   "s": "person_1",
   "t": "That's a relief. ~"
  },
  {
   "s": "person_2",
   "t": "Any palpitations, any fluttering?"
  },
  {
   "s": "person_1",
   "t": "No, nothing like that."
  },
  {
   "s": "person_2",
   "t": "What I'm hearing is that your asthma control is a little worse in pregnancy, which is common."
  },
  {
   "s": "person_1",
   "t": "Is it safe for the baby? ~"
  },
  {
   "s": "person_2",
   "t": "Yes, the biggest risk to the baby is uncontrolled asthma, not the medicine. Keep using your inhalers."
  },
  {
   "s": "person_1",
   "t": "That's reassuring. ~"
  },
  {
   "s": "person_2",
   "t": "I'd like to arrange spirometry to check your lungs, and a blood count, since you're in the second trimester."
  },
  {
   "s": "person_1",
   "t": "Okay. ~"
  },
  {
   "s": "person_2",
   "t": "I'd like to see you again in four weeks."
  },
  {
   "s": "person_1",
   "t": "Four weeks. Thanks, doctor. ~"
  }
 ],
