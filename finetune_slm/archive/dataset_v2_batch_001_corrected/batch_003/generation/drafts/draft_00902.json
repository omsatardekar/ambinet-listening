{
 "encounter_id": "00902",
 "speakers": {
  "person_1": "PATIENT",
  "person_2": "DOCTOR"
 },
 "turns": [
  {
   "s": "person_2",
   "t": "Mr Brannigan, is it Frank, with a K, or a C? I never remember. ~"
  },
  {
   "s": "person_1",
   "t": "Frank with a K. Come on, doctor, I have a rehab class at noon. ~"
  },
  {
   "s": "person_2",
   "t": "Then let's be quick. How's the pulmonary rehab going? ~"
  },
  {
   "s": "person_1",
   "t": "Good, actually. I'm short of breath on the stairs less than before. Three flights now, I used to stop at one."
  },
  {
   "s": "person_2",
   "t": "That's real progress. And the cough?"
  },
  {
   "s": "person_1",
   "t": "Mornings, a bit, clear stuff. I cough it up and I'm fine."
  },
  {
   "s": "person_2",
   "t": "Wheezing?"
  },
  {
   "s": "person_1",
   "t": "At night, sometimes, a whistle."
  },
  {
   "s": "person_2",
   "t": "How's your energy?"
  },
  {
   "s": "person_1",
   "t": "Wiped out by three."
  },
  {
   "s": "person_2",
   "t": "Any chest pain?"
  },
  {
   "s": "person_1",
   "t": "No chest pain."
  },
  {
   "s": "person_2",
   "t": "Fever?"
  },
  {
   "s": "person_1",
   "t": "No fever."
  },
  {
   "s": "person_2",
   "t": "Coughing up blood?"
  },
  {
   "s": "person_1",
   "t": "No blood."
  },
  {
   "s": "person_2",
   "t": "Any swelling in your ankles?"
  },
  {
   "s": "person_1",
   "t": "No, no swelling."
  },
  {
   "s": "person_2",
   "t": "Which inhalers?"
  },
  {
   "s": "person_1",
   "t": "Tiotropium, 18 micrograms, once a day. And the albuterol, the rescue one, when I need it."
  },
  {
   "s": "person_2",
   "t": "Good. Any allergies?"
  },
  {
   "s": "person_1",
   "t": "Hm. I think a hospital gave me a rash once, maybe from an antibiotic, I really don't know."
  },
  {
   "s": "person_2",
   "t": "I'll record it as a possible allergy, unconfirmed. History?"
  },
  {
   "s": "person_1",
   "t": "COPD, high blood pressure, and osteoporosis."
  },
  {
   "s": "person_2",
   "t": "Operations?"
  },
  {
   "s": "person_1",
   "t": "Hernia repair in 2010."
  },
  {
   "s": "person_2",
   "t": "Lung problems in the family?"
  },
  {
   "s": "person_1",
   "t": "My mother had emphysema. My brother has heart disease."
  },
  {
   "s": "person_2",
   "t": "And smoking, I recall you quit."
  },
  {
   "s": "person_1",
   "t": "Quit smoking in 2018. Thirty pack-years before that."
  },
  {
   "s": "person_2",
   "t": "Drink?"
  },
  {
   "s": "person_1",
   "t": "One drink on Sundays."
  },
  {
   "s": "person_2",
   "t": "Rehab classes?"
  },
  {
   "s": "person_1",
   "t": "Three times a week. I'm the oldest guy there."
  },
  {
   "s": "person_2",
   "t": "And your work?"
  },
  {
   "s": "person_1",
   "t": "I was a welder, retired now. Welding fumes, probably."
  },
  {
   "s": "person_2",
   "t": "Let me check you. Oxygen 93 percent, pulse 80, blood pressure 136 over 82, temperature 36.7, breathing 18, and weight 77 kilos.",
   "pause": 15.0
  },
  {
   "s": "person_1",
   "t": "Ninety-three, is that good? ~"
  },
  {
   "s": "person_2",
   "t": "For you, that's your usual. Let me listen. Big breaths.",
   "pause": 10.0
  },
  {
   "s": "person_1",
   "t": "In and out, like a pro. ~"
  },
  {
   "s": "person_2",
   "t": "I can hear wheeze on both sides, and the air entry is reduced at the bases."
  },
  {
   "s": "person_1",
   "t": "That's normal for me. ~"
  },
  {
   "s": "person_2",
   "t": "Any palpitations?"
  },
  {
   "s": "person_1",
   "t": "No, nothing like that."
  },
  {
   "s": "person_2",
   "t": "Any heartburn or trouble swallowing?"
  },
  {
   "s": "person_1",
   "t": "No, nothing, that's all fine."
  },
  {
   "s": "person_2",
   "t": "You're doing well, but I can't rule out a COPD flare-up brewing, and I can't rule out the heart contributing to the breathlessness."
  },
  {
   "s": "person_1",
   "t": "My heart? ~"
  },
  {
   "s": "person_2",
   "t": "Just ruling things out. I'd like to arrange spirometry, a chest X-ray, and a six-minute walk test."
  },
  {
   "s": "person_1",
   "t": "I do that at rehab. ~"
  },
  {
   "s": "person_2",
   "t": "We'll do it here as well, for the record. And blood tests, including a blood count."
  },
  {
   "s": "person_1",
   "t": "Fine. ~"
  },
  {
   "s": "person_2",
   "t": "I'd like to see you again in six weeks."
  },
  {
   "s": "person_1",
   "t": "Six weeks. I'll be late. ~"
  }
