{
 "encounter_id": "00764",
 "speakers": {
  "person_1": "PATIENT",
  "person_2": "DOCTOR",
  "person_3": "NURSE"
 },
 "turns": [
  {
   "s": "person_3",
   "t": "Doctor, this is Sinead, twenty-three, brought from the main stage by the first aiders. Hot, dizzy, vomiting. She's been in the sun since noon."
  },
  {
   "s": "person_2",
   "t": "Thanks, Orla. Sinead, I'm Dr Flynn. Can you hear me? How are you feeling? ~"
  },
  {
   "s": "person_1",
   "t": "Awful. Dizzy. And my head's pounding. I feel like I'm going to be sick again."
  },
  {
   "s": "person_2",
   "t": "When did it start?"
  },
  {
   "s": "person_1",
   "t": "About an hour ago, in the crowd. I felt my legs go, and everything went spotty."
  },
  {
   "s": "person_2",
   "t": "Have you been drinking water today? ~"
  },
  {
   "s": "person_1",
   "t": "Not much. A few beers, and a coffee. I forgot to drink. I was dancing. ~"
  },
  {
   "s": "person_2",
   "t": "Any collapse, or did you lose consciousness?"
  },
  {
   "s": "person_1",
   "t": "No, I didn't pass out. A friend caught me."
  },
  {
   "s": "person_2",
   "t": "Any chest pain, or palpitations?"
  },
  {
   "s": "person_1",
   "t": "No. Just dizzy and sick."
  },
  {
   "s": "person_2",
   "t": "Do you take any regular medicines?"
  },
  {
   "s": "person_1",
   "t": "The pill, the combined one, every day. And I take cetirizine in the summer, 10 mg."
  },
  {
   "s": "person_3",
   "t": "Doctor, her obs. Temperature 38.4, pulse 118, blood pressure 98 over 60, oxygen 98 percent, respiratory rate 22.",
   "pause": 15.0
  },
  {
   "s": "person_2",
   "t": "Thank you, Orla. Sinead, you're hot, your heart's fast, and your pressure's a bit low, which fits with dehydration and overheating. Let me look at you. ~"
  },
  {
   "s": "person_1",
   "t": "Okay.",
   "pause": 18.0
  },
  {
   "s": "person_2",
   "t": "Your skin is hot and flushed but still sweaty, your mouth is dry, and you're alert and talking sensibly."
  },
  {
   "s": "person_3",
   "t": "Her capillary refill is a little slow, doctor. ~"
  },
  {
   "s": "person_2",
   "t": "Noted. Sinead, I think you've got heat exhaustion, but I can't rule out heat stroke, which is more serious, so we're going to treat you quickly."
  },
  {
   "s": "person_1",
   "t": "Is that bad? ~"
  },
  {
   "s": "person_2",
   "t": "It's treatable. We'll cool you down and give you fluids. Orla, can you start fluids through a drip, and put cool wet towels and ice packs on her neck, armpits and groin? ~"
  },
  {
   "s": "person_3",
   "t": "On it, doctor. ~"
  },
  {
   "s": "person_2",
   "t": "I'd like to check your blood sugar and a blood test, for your kidneys and salts, because heat and dehydration can upset them."
  },
  {
   "s": "person_1",
   "t": "Okay. ~"
  },
  {
   "s": "person_2",
   "t": "And I'll arrange a repeat set of observations in thirty minutes to make sure your temperature's coming down. ~"
  },
  {
   "s": "person_3",
   "t": "I'll chart it. ~"
  },
  {
   "s": "person_2",
   "t": "Sip small amounts of water, and don't have any more alcohol today."
  },
  {
   "s": "person_1",
   "t": "Definitely not. ~"
  },
  {
   "s": "person_2",
   "t": "If you get confused, stop sweating, have a fit, or your temperature keeps going up, tell the nurse straight away."
  },
  {
   "s": "person_1",
   "t": "I will. ~"
  }
 ],
