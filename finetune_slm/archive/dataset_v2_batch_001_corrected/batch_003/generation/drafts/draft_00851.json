{
 "encounter_id": "00851",
 "speakers": {
  "person_1": "PATIENT",
  "person_2": "DOCTOR"
 },
 "turns": [
  {
   "s": "person_2",
   "t": "Good morning, Miss Fairweather. I've got the letter from the ward here. This is your check ten days after the tonsillectomy, yes? ~"
  },
  {
   "s": "person_1",
   "t": "Yes. I've brought my notes, I wrote down every day since I came home. May I read the key points? ~"
  },
  {
   "s": "person_2",
   "t": "Please do. ~"
  },
  {
   "s": "person_1",
   "t": "Day one to three, severe sore throat, a pain scale of eight. Now it's about four, it's easing. So my sore throat is better, but still sore when I swallow dry things."
  },
  {
   "s": "person_2",
   "t": "Good, that's the usual pattern. Anything in the ears?"
  },
  {
   "s": "person_1",
   "t": "Earache on both sides, days four to seven. It's lessened now, but it's there when I swallow."
  },
  {
   "s": "person_2",
   "t": "And your breath?"
  },
  {
   "s": "person_1",
   "t": "Terrible. Sorry, it's a bad smell, my mum says, it's the healing."
  },
  {
   "s": "person_2",
   "t": "Any bleeding?"
  },
  {
   "s": "person_1",
   "t": "No bleeding. Not a drop, I've checked the pillow every morning."
  },
  {
   "s": "person_2",
   "t": "Any fever?"
  },
  {
   "s": "person_1",
   "t": "No fever, my highest was 37.2."
  },
  {
   "s": "person_2",
   "t": "Trouble drinking?"
  },
  {
   "s": "person_1",
   "t": "No, I'm drinking plenty."
  },
  {
   "s": "person_2",
   "t": "Vomiting?"
  },
  {
   "s": "person_1",
   "t": "None."
  },
  {
   "s": "person_2",
   "t": "Noisy breathing at night?"
  },
  {
   "s": "person_1",
   "t": "No, nothing like that."
  },
  {
   "s": "person_2",
   "t": "What painkillers are you taking?"
  },
  {
   "s": "person_1",
   "t": "Paracetamol, 1 gram, four times a day. Ibuprofen, 400 mg, three times a day. Lansoprazole, 15 mg, once a day, the hospital gave me it. And cetirizine, 10 mg, once a day."
  },
  {
   "s": "person_2",
   "t": "Good. Any allergies?"
  },
  {
   "s": "person_1",
   "t": "Penicillin. I had hives as a teenager."
  },
  {
   "s": "person_2",
   "t": "History?"
  },
  {
   "s": "person_1",
   "t": "Recurrent tonsillitis, six episodes last year. Hay fever. And migraines."
  },
  {
   "s": "person_2",
   "t": "Surgery?"
  },
  {
   "s": "person_1",
   "t": "The tonsillectomy ten days ago. And grommets in my ears, as a child."
  },
  {
   "s": "person_2",
   "t": "Tonsil trouble in the family?"
  },
  {
   "s": "person_1",
   "t": "My sister had her tonsils out at fifteen."
  },
  {
   "s": "person_2",
   "t": "Do you smoke?"
  },
  {
   "s": "person_1",
   "t": "I've never smoked."
  },
  {
   "s": "person_2",
   "t": "What's your job?"
  },
  {
   "s": "person_1",
   "t": "I teach secondary school. I'm off for two weeks."
  },
  {
   "s": "person_2",
   "t": "Alcohol?"
  },
  {
   "s": "person_1",
   "t": "None since the operation."
  },
  {
   "s": "person_2",
   "t": "Let me check. Pulse 70, blood pressure 114 over 70, temperature 36.8, oxygen 99 percent, breathing 14, weight 58 kilos.",
   "pause": 15.0
  },
  {
   "s": "person_1",
   "t": "All normal? ~"
  },
  {
   "s": "person_2",
   "t": "All normal. Open wide. Say ahh.",
   "pause": 8.0
  },
  {
   "s": "person_1",
   "t": "Ahh. ~"
  },
  {
   "s": "person_2",
   "t": "The tonsil beds are covered in a white-yellow coating, which is normal healing, and there's no active bleeding."
  },
  {
   "s": "person_1",
   "t": "The coating's not infection? ~"
  },
  {
   "s": "person_2",
   "t": "Not usually. It looks like the tonsil beds are healing normally."
  },
  {
   "s": "person_1",
   "t": "Great. Any tests? ~"
  },
  {
   "s": "person_2",
   "t": "Not routinely. If the pain gets worse, I might do a throat swab."
  },
  {
   "s": "person_1",
   "t": "And if I'm feverish? ~"
  },
  {
   "s": "person_2",
   "t": "Then I'd consider a blood test too."
  },
  {
   "s": "person_1",
   "t": "That's reassuring. ~"
  },
  {
   "s": "person_2",
   "t": "Any trouble with your breathing today?"
  },
  {
   "s": "person_1",
   "t": "No, nothing. Breathing's fine."
  },
  {
   "s": "person_2",
   "t": "Keep drinking, and soft foods, and avoid anything sharp, like crisps, until two weeks after."
  },
  {
   "s": "person_1",
   "t": "Noted. ~"
  },
  {
   "s": "person_2",
   "t": "If you have any bleeding, go straight to the emergency department, and ring us."
  },
  {
   "s": "person_1",
   "t": "I will. Thank you, doctor. ~"
  }
 ],
