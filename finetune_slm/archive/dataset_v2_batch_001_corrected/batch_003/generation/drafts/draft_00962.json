{
 "encounter_id": "00962",
 "speakers": {
  "person_1": "PATIENT",
  "person_2": "DOCTOR"
 },
 "turns": [
  {
   "s": "person_2",
   "t": "Is it Siobhan Brennan? Siobhan, with the two b's? ~"
  },
  {
   "s": "person_1",
   "t": "That's me, doctor, one b and two n's, but sure, you're close enough. Isn't it a grand morning for a broken wrist!"
  },
  {
   "s": "person_2",
   "t": "Ha. So, this is your fracture clinic check, the cast comes off next week. How's it been going? ~"
  },
  {
   "s": "person_1",
   "t": "Grand, mostly. It was my own fault, I came off the bike on the Phoenix Park road, hit a pothole, my husband never lets me forget it. Five weeks ago now."
  },
  {
   "s": "person_2",
   "t": "Five weeks. Any itching under the cast?"
  },
  {
   "s": "person_1",
   "t": "Desperately. I've been poking a knitting needle down it, don't tell the nurse."
  },
  {
   "s": "person_2",
   "t": "I won't. Any swelling in the fingers?"
  },
  {
   "s": "person_1",
   "t": "A bit in the evenings, they feel fat, like sausages."
  },
  {
   "s": "person_2",
   "t": "Are the fingers stiff?"
  },
  {
   "s": "person_1",
   "t": "Very. I can barely make a fist."
  },
  {
   "s": "person_2",
   "t": "Any aching at night?"
  },
  {
   "s": "person_1",
   "t": "In the wrist, yes, when I lie on it."
  },
  {
   "s": "person_2",
   "t": "Any numbness in the hand?"
  },
  {
   "s": "person_1",
   "t": "No numbness."
  },
  {
   "s": "person_2",
   "t": "Pins and needles?"
  },
  {
   "s": "person_1",
   "t": "No, none."
  },
  {
   "s": "person_2",
   "t": "Any sores, or rubbing under the edge of the cast?"
  },
  {
   "s": "person_1",
   "t": "No sores. I looked with a torch."
  },
  {
   "s": "person_2",
   "t": "Any smell coming from it?"
  },
  {
   "s": "person_1",
   "t": "No smell. I put my nose right up to it."
  },
  {
   "s": "person_2",
   "t": "What are you taking?"
  },
  {
   "s": "person_1",
   "t": "Paracetamol, maybe 1 gram, when it's sore. And a big white chewy tablet for the bones, I don't know what it's called, my mother takes the same one. And omeprazole, 20 mg, in the morning."
  },
  {
   "s": "person_2",
   "t": "We'll find the chewable on your record. Any allergies?"
  },
  {
   "s": "person_1",
   "t": "None at all. No allergies."
  },
  {
   "s": "person_2",
   "t": "Medical history?"
  },
  {
   "s": "person_1",
   "t": "A bit of thin bones, osteopenia, and acid reflux."
  },
  {
   "s": "person_2",
   "t": "Any operations?"
  },
  {
   "s": "person_1",
   "t": "A caesarean, in 2015."
  },
  {
   "s": "person_2",
   "t": "Bone problems in the family?"
  },
  {
   "s": "person_1",
   "t": "My mother has osteoporosis."
  },
  {
   "s": "person_2",
   "t": "What do you do?"
  },
  {
   "s": "person_1",
   "t": "Primary school teacher. Thirty small children and one broken wrist, you can imagine."
  },
  {
   "s": "person_2",
   "t": "And the cycling, how often?"
  },
  {
   "s": "person_1",
   "t": "Three times a week, before this."
  },
  {
   "s": "person_2",
   "t": "Let me check you. Blood pressure 124 over 76, pulse 70.",
   "pause": 10.0
  },
  {
   "s": "person_1",
   "t": "Is that all right? ~"
  },
  {
   "s": "person_2",
   "t": "Perfect. Let me look at the cast.",
   "pause": 8.0
  },
  {
   "s": "person_1",
   "t": "Be gentle. ~"
  },
  {
   "s": "person_2",
   "t": "The cast is intact and dry, no cracks."
  },
  {
   "s": "person_1",
   "t": "I've been very careful in the shower. ~"
  },
  {
   "s": "person_2",
   "t": "And the fingers are warm, pink, with good colour."
  },
  {
   "s": "person_1",
   "t": "They're a bit puffy. ~"
  },
  {
   "s": "person_2",
   "t": "Wiggle them for me. I can see you move all five fingers well."
  },
  {
   "s": "person_1",
   "t": "There, like a pianist. ~"
  },
  {
   "s": "person_2",
   "t": "Any problem with feeling in your hand?"
  },
  {
   "s": "person_1",
   "t": "No, nothing, it's all normal."
  },
  {
   "s": "person_2",
   "t": "Any problem with your breathing?"
  },
  {
   "s": "person_1",
   "t": "No, nothing."
  },
  {
   "s": "person_2",
   "t": "Here's what I think. The fracture is healing well so far, from how it looks and feels."
  },
  {
   "s": "person_1",
   "t": "That's great. ~"
  },
  {
   "s": "person_2",
   "t": "Next week, before the cast comes off, I'd like to arrange an X-ray of the wrist, to see the bone."
  },
  {
   "s": "person_1",
   "t": "That's what I was hoping. ~"
  },
  {
   "s": "person_2",
   "t": "Given your thin bones and family history, I'd also like to arrange a bone density scan, and a vitamin D blood test."
  },
  {
   "s": "person_1",
   "t": "Goodness, the full works. ~"
  },
  {
   "s": "person_2",
   "t": "Better to be thorough. I'd like to see you again next week to take the cast off."
  },
  {
   "s": "person_1",
   "t": "Next week. I'll bring a cake. ~"
  }
 ],
