{
 "encounter_id": "00863",
 "speakers": {
  "person_1": "PATIENT",
  "person_2": "DOCTOR",
  "person_3": "FAMILY_MEMBER"
 },
 "turns": [
  {
   "s": "person_3",
   "t": "Doctor, thank you for seeing us so quickly. It's my father, he has a sore on his heel, and today it looks terrible."
  },
  {
   "s": "person_1",
   "t": "It's only a small thing. I told her. ~"
  },
  {
   "s": "person_2",
   "t": "Mr Kearney, can I have a look? Which heel?"
  },
  {
   "s": "person_1",
   "t": "The left. It's been sore a few weeks."
  },
  {
   "s": "person_3",
   "t": "A pressure sore. The district nurse noticed it, and it's got worse this week, it's black in the middle, and it smells."
  },
  {
   "s": "person_2",
   "t": "Are you able to walk, Mr Kearney? ~"
  },
  {
   "s": "person_1",
   "t": "Not much. I'm in the chair most of the day. ~"
  },
  {
   "s": "person_2",
   "t": "Any fever, or have you felt unwell?"
  },
  {
   "s": "person_3",
   "t": "He's been shivery since yesterday."
  },
  {
   "s": "person_1",
   "t": "I'm fine. ~"
  },
  {
   "s": "person_2",
   "t": "Any pain in the heel?"
  },
  {
   "s": "person_1",
   "t": "Not really. I can't feel it much."
  },
  {
   "s": "person_2",
   "t": "What are you taking?"
  },
  {
   "s": "person_3",
   "t": "Clopidogrel, 75 mg, once a day, and metformin, 500 mg, twice a day. He takes the clopidogrel every day, I give it. The metformin, I'm not sure he takes."
  },
  {
   "s": "person_1",
   "t": "I take it."
  },
  {
   "s": "person_2",
   "t": "I'll note that you take it, Mr Kearney, and your daughter isn't sure. Any allergies?"
  },
  {
   "s": "person_3",
   "t": "Penicillin. He gets a rash."
  },
  {
   "s": "person_2",
   "t": "Thank you. Do you smoke?"
  },
  {
   "s": "person_1",
   "t": "Gave it up after my stroke."
  },
  {
   "s": "person_2",
   "t": "Pulse and temperature, please. ~"
  },
  {
   "s": "person_3",
   "t": "Go ahead. ~"
  },
  {
   "s": "person_2",
   "t": "Temperature 37.9, pulse 98, blood pressure 138 over 80, oxygen 97 percent.",
   "pause": 15.0
  },
  {
   "s": "person_3",
   "t": "Is that bad? ~"
  },
  {
   "s": "person_2",
   "t": "A raised temperature and a fast pulse, which worries me alongside the heel. Let me see it.",
   "pause": 20.0
  },
  {
   "s": "person_2",
   "t": "There's a black area of dead tissue, about three centimetres across, on the back of the left heel, with a red margin around it, some pus under the edge, and a foul smell, and the foot is warm."
  },
  {
   "s": "person_3",
   "t": "Is it infected? ~"
  },
  {
   "s": "person_2",
   "t": "Yes, I think it is, and I can't rule out the infection reaching the bone. This is a grade three pressure ulcer with infection, an infected pressure ulcer."
  },
  {
   "s": "person_3",
   "t": "What do we do? ~"
  },
  {
   "s": "person_2",
   "t": "He needs to come into hospital today. I'd like to arrange blood tests and an X-ray of the heel, and intravenous antibiotics, given your penicillin allergy, a different type."
  },
  {
   "s": "person_1",
   "t": "Hospital? I'd rather not. ~"
  },
  {
   "s": "person_2",
   "t": "Mr Kearney, I understand, but the infection could spread to your blood or the bone, and that's dangerous. ~"
  },
  {
   "s": "person_1",
   "t": "All right. ~"
  },
  {
   "s": "person_2",
   "t": "I'll arrange an ambulance now, and I'll ring the ward. Please keep the heel off the bed and don't let anything press on it."
  },
  {
   "s": "person_3",
   "t": "I'll pack a bag. ~"
  },
  {
   "s": "person_2",
   "t": "Bring his tablets and a list. If he becomes drowsy, confused, or very hot, tell the ambulance crew."
  },
  {
   "s": "person_3",
   "t": "Thank you, doctor. ~"
  }
 ],
