  "person_3": "FAMILY_MEMBER"
 },
 "turns": [
  {
   "s": "person_3",
   "t": "Doctor, quick, it's my husband, he can't breathe, his inhaler's not working!"
  },
  {
   "s": "person_2",
   "t": "Bring him straight in, sit him up. Sir, can you tell me your name? ~"
  },
  {
   "s": "person_1",
   "t": "Declan. Can't. Breathe."
  },
  {
   "s": "person_2",
   "t": "Okay Declan, I'm going to help you. Short answers. When did it start?"
  },
  {
   "s": "person_1",
   "t": "Yesterday. One day."
  },
  {
   "s": "person_3",
   "t": "It's been three days, Declan. He's been coughing since Monday."
  },
  {
   "s": "person_2",
   "t": "Three days says your wife, one day says you. I'll put it as one to three days. Wheezy?"
  },
  {
   "s": "person_1",
   "t": "Yes. Chest tight."
  },
  {
   "s": "person_3",
   "t": "He's used his blue inhaler every hour since this morning, and it only works for a few minutes."
  },
  {
   "s": "person_2",
   "t": "Any chest pain, or any blue lips?"
  },
  {
   "s": "person_1",
   "t": "No pain. Just tight."
  },
  {
   "s": "person_2",
   "t": "Fever, or coughing up coloured phlegm?"
  },
  {
   "s": "person_1",
   "t": "No. Dry cough."
  },
  {
   "s": "person_2",
   "t": "I'm putting oxygen on you now, and I'm checking your numbers. ~"
  },
  {
   "s": "person_3",
   "t": "Is he going to be all right? ~"
  },
  {
   "s": "person_2",
   "t": "Pulse 118, breathing 28 a minute, oxygen 91 percent without oxygen, blood pressure 138 over 86, temperature 36.9.",
   "pause": 15.0
  },
  {
   "s": "person_3",
   "t": "That's bad, isn't it? ~"
  },
  {
   "s": "person_2",
   "t": "The oxygen is lower than I want and his breathing is fast, so this is a significant asthma attack, but we can treat it. Declan, I'm listening to your chest. ~"
  },
  {
   "s": "person_1",
   "t": "Okay.",
   "pause": 15.0
  },
  {
   "s": "person_2",
   "t": "Widespread wheeze all over both lungs, and the air isn't moving as well as I'd like at the bases."
  },
  {
   "s": "person_2",
   "t": "What conditions does he have, and what does he take?"
  },
  {
   "s": "person_3",
   "t": "Asthma since he was a boy, and high blood pressure. He takes his blue inhaler and a brown one twice a day, but he's run out of the brown one."
  },
  {
   "s": "person_2",
   "t": "When did he run out? ~"
  },
  {
   "s": "person_3",
   "t": "Last week. I meant to get a repeat. ~"
  },
  {
   "s": "person_2",
   "t": "Anyone else in the family with asthma?"
  },
  {
   "s": "person_3",
   "t": "His father, and his sister."
  },
  {
   "s": "person_2",
   "t": "Thank you. Declan, I'm going to give you salbutamol through a nebuliser mask, and steroid tablets, prednisolone, 40 mg once a day, for five days."
  },
  {
   "s": "person_1",
   "t": "Thank you. ~"
  },
  {
   "s": "person_2",
   "t": "I'd like to measure your peak flow once you've had the first treatment, and I'd like to arrange a chest X-ray, to make sure there's nothing else going on, like a collapsed lung."
  },
  {
   "s": "person_3",
   "t": "Will he need to stay in? ~"
  },
  {
   "s": "person_2",
   "t": "Probably a few hours of treatment first, and then we'll decide. If he's not improving within an hour, he'll go to the ward."
  },
  {
   "s": "person_3",
   "t": "I'll stay with him. ~"
  },
  {
   "s": "person_2",
   "t": "Declan, breathe slowly in the mask, and tell the nurse if you feel worse."
  },
  {
   "s": "person_1",
   "t": "Okay. ~"
  }
 ],
