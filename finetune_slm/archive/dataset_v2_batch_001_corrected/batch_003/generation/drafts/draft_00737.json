{
 "encounter_id": "00737",
 "speakers": {
  "person_1": "PATIENT",
  "person_2": "DOCTOR",
  "person_3": "FAMILY_MEMBER"
 },
 "turns": [
  {
   "s": "person_2",
   "t": "Hello, can I just check, is it Mrs Pickering, Joan Pickering? ~"
  },
  {
   "s": "person_1",
   "t": "It is, dear, Joan, born in the very same village as the doctor's mother, I'd wager. This is my Helen. ~"
  },
  {
   "s": "person_3",
   "t": "Hi. Mum's been dizzy since they changed her blood pressure tablets, that's why we're here."
  },
  {
   "s": "person_2",
   "t": "Dizzy how, Joan?"
  },
  {
   "s": "person_1",
   "t": "When I stand up, the room goes round and I have to hold the sideboard. It's been going on a while, a fortnight, perhaps longer, I couldn't tell you."
  },
  {
   "s": "person_3",
   "t": "It was before Easter, wasn't it? Or after. I can't be sure either, honestly."
  },
  {
   "s": "person_2",
   "t": "That's fine. What does the dizziness feel like?"
  },
  {
   "s": "person_1",
   "t": "Light-headed, as if I might faint. I haven't, but it's close."
  },
  {
   "s": "person_2",
   "t": "Anything with your vision?"
  },
  {
   "s": "person_1",
   "t": "It goes blurry for a few seconds when I get up."
  },
  {
   "s": "person_2",
   "t": "Have you had any falls?"
  },
  {
   "s": "person_1",
   "t": "Not yet, touch wood."
  },
  {
   "s": "person_2",
   "t": "Chest pain?"
  },
  {
   "s": "person_1",
   "t": "No pain in the chest."
  },
  {
   "s": "person_2",
   "t": "Palpitations?"
  },
  {
   "s": "person_1",
   "t": "No, my heart's quiet as a mouse."
  },
  {
   "s": "person_2",
   "t": "Headaches?"
  },
  {
   "s": "person_1",
   "t": "No headaches, no."
  },
  {
   "s": "person_2",
   "t": "Which tablets has she got now, Helen?"
  },
  {
   "s": "person_3",
   "t": "Ramipril, 10 mg, once a day. Amlodipine, 10 mg, once a day, that's the new one. And indapamide, 1.5 mg, in the morning."
  },
  {
   "s": "person_2",
   "t": "Thank you. Any allergies, Joan?"
  },
  {
   "s": "person_1",
   "t": "Codeine, when I was a girl. It made me terribly sick. I've avoided it ever since."
  },
  {
   "s": "person_2",
   "t": "Good. Other health problems?"
  },
  {
   "s": "person_1",
   "t": "High blood pressure, and arthritis in my hands."
  },
  {
   "s": "person_2",
   "t": "Surgery?"
  },
  {
   "s": "person_1",
   "t": "A hysterectomy, in 1985."
  },
  {
   "s": "person_2",
   "t": "Family illnesses?"
  },
  {
   "s": "person_1",
   "t": "My mother had a stroke."
  },
  {
   "s": "person_2",
   "t": "Who's at home?"
  },
  {
   "s": "person_1",
   "t": "I live with Helen and her husband now, since the stairs got too much."
  },
  {
   "s": "person_2",
   "t": "And before you retired?"
  },
  {
   "s": "person_3",
   "t": "She was a seamstress for forty years."
  },
  {
   "s": "person_2",
   "t": "Let me check your pressure lying down first. Blood pressure lying is 148 over 84.",
   "pause": 15.0
  },
  {
   "s": "person_1",
   "t": "Good. ~"
  },
  {
   "s": "person_2",
   "t": "Now stand up for me, slowly. Take your time. Standing, it's 108 over 64, and your pulse is 78.",
   "pause": 20.0
  },
  {
   "s": "person_1",
   "t": "Oh, I do feel odd. ~"
  },
  {
   "s": "person_2",
   "t": "Sit down, Joan. That's quite a drop. Temperature is 36.5, oxygen 97 percent, and your weight is 62 kilos.",
   "pause": 10.0
  },
  {
   "s": "person_3",
   "t": "Is that bad? ~"
  },
  {
   "s": "person_2",
   "t": "It explains the dizziness. Let me listen to you.",
   "pause": 10.0
  },
  {
   "s": "person_2",
   "t": "Heart sounds are normal, and the lungs are clear."
  },
  {
   "s": "person_1",
   "t": "Good. ~"
  },
  {
   "s": "person_2",
   "t": "There's no swelling in the ankles, and the mouth looks a little dry."
  },
  {
   "s": "person_1",
   "t": "I don't drink as much as I should. ~"
  },
  {
   "s": "person_2",
   "t": "Any trouble with your breathing, Joan?"
  },
  {
   "s": "person_1",
   "t": "No, nothing, I'm fine for breath."
  },
  {
   "s": "person_2",
   "t": "The blood pressure is dropping too low when you stand, which looks like the new tablet, but I can't rule out you being dried out as well."
  },
  {
   "s": "person_3",
   "t": "What happens now? ~"
  },
  {
   "s": "person_2",
   "t": "I'd like to arrange an ECG, a blood test for kidney function and salts, and a urine test."
  },
  {
   "s": "person_1",
   "t": "All today? ~"
  },
  {
   "s": "person_2",
   "t": "Yes. I'd also like to fit a 24-hour blood pressure monitor."
  },
  {
   "s": "person_3",
   "t": "I'll bring her back for it. ~"
  },
  {
   "s": "person_2",
   "t": "Good. Drink plenty, stand up slowly. I'll decide about the tablets once I've seen the results, so please change nothing for now."
  },
  {
   "s": "person_3",
   "t": "Understood. ~"
  },
  {
   "s": "person_2",
   "t": "I'd like to see you again in two weeks."
  },
  {
   "s": "person_1",
   "t": "Two weeks, dear. Lovely to meet you. ~"
  }
 ],
