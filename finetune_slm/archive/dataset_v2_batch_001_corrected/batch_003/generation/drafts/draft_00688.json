{
 "encounter_id": "00688",
 "speakers": {
  "person_1": "PATIENT",
  "person_2": "DOCTOR",
  "person_3": "FAMILY_MEMBER"
 },
 "turns": [
  {
   "s": "person_1",
   "t": "Sorry I'm late, doctor, traffic was dreadful. Marcia drove me. ~"
  },
  {
   "s": "person_2",
   "t": "No problem. Mr Delaney, what brings you in? ~"
  },
  {
   "s": "person_1",
   "t": "Oh, it's nothing much. I've been feeling a bit low since Dorothy passed. My daughter thinks I should come."
  },
  {
   "s": "person_2",
   "t": "I'm sorry for your loss. How long ago?"
  },
  {
   "s": "person_1",
   "t": "About three months. I'm managing, you know."
  },
  {
   "s": "person_3",
   "t": "He's not eating, doctor. He's lost weight, his trousers are held up with a belt now."
  },
  {
   "s": "person_1",
   "t": "I eat fine. I just don't have much appetite."
  },
  {
   "s": "person_2",
   "t": "Mr Delaney, is that right, you don't have much appetite? ~"
  },
  {
   "s": "person_1",
   "t": "A bit less, maybe. That's all."
  },
  {
   "s": "person_2",
   "t": "How are you sleeping?"
  },
  {
   "s": "person_1",
   "t": "Sleeping fine. No trouble sleeping."
  },
  {
   "s": "person_3",
   "t": "Dad, you're up at three every single night. I hear the kettle."
  },
  {
   "s": "person_1",
   "t": "I get a cup of tea. It's not a problem. ~"
  },
  {
   "s": "person_2",
   "t": "Any thoughts that life isn't worth living, or of harming yourself?"
  },
  {
   "s": "person_1",
   "t": "No. Nothing like that."
  },
  {
   "s": "person_3",
   "t": "He wouldn't say if he did, but he hasn't said anything like it to me. ~"
  },
  {
   "s": "person_2",
   "t": "Okay. What medicines do you take?"
  },
  {
   "s": "person_1",
   "t": "Lisinopril, 10 mg, once a day. And metformin, 500 mg, twice a day."
  },
  {
   "s": "person_3",
   "t": "It's 20 mg, Dad. I fill the pill box. The lisinopril is 20."
  },
  {
   "s": "person_1",
   "t": "I'm sure it's 10, it's what Dorothy used to give me."
  },
  {
   "s": "person_2",
   "t": "We'll check the lisinopril dose with the pharmacy. Any allergies to medicines?"
  },
  {
   "s": "person_1",
   "t": "Well. In hospital once something gave me a rash, I think. I don't know what it was. Marcia may remember."
  },
  {
   "s": "person_3",
   "t": "I don't. They never told us."
  },
  {
   "s": "person_2",
   "t": "I'll record it as a possible allergy. What other health conditions do you have?"
  },
  {
   "s": "person_1",
   "t": "High blood pressure, diabetes, the type two, and arthritis in my hands."
  },
  {
   "s": "person_2",
   "t": "Any operations?"
  },
  {
   "s": "person_1",
   "t": "A hernia repair, back in 2008."
  },
  {
   "s": "person_2",
   "t": "Anyone in the family with depression?"
  },
  {
   "s": "person_1",
   "t": "My brother Frank had it, years ago."
  },
  {
   "s": "person_2",
   "t": "How are you living at the moment?"
  },
  {
   "s": "person_1",
   "t": "On my own now, in the same house. I'm a widower."
  },
  {
   "s": "person_2",
   "t": "And before you retired?"
  },
  {
   "s": "person_1",
   "t": "I was a mechanic for forty years. Retired now."
  },
  {
   "s": "person_2",
   "t": "Let me check your numbers. Blood pressure 134 over 80, pulse 72, temperature 36.5, oxygen 97 percent, breathing 16, and your weight is 70 kilos.",
   "pause": 15.0
  },
  {
   "s": "person_3",
   "t": "That's six kilos down from last year. ~"
  },
  {
   "s": "person_2",
   "t": "Noted. Let me look at you. You look a little thin, and your eyes are tired.",
   "pause": 8.0
  },
  {
   "s": "person_1",
   "t": "Everybody says I look tired. ~"
  },
  {
   "s": "person_2",
   "t": "There's no swelling in your ankles. And your heart sounds are normal."
  },
  {
   "s": "person_1",
   "t": "That's good, isn't it? ~"
  },
  {
   "s": "person_2",
   "t": "Any trouble with your breathing or chest?"
  },
  {
   "s": "person_1",
   "t": "No, nothing. Breathing's fine."
  },
  {
   "s": "person_2",
   "t": "And your tummy, any vomiting or pain?"
  },
  {
   "s": "person_1",
   "t": "No, nothing there either."
  },
  {
   "s": "person_2",
   "t": "This looks like a grief reaction to me, but I can't rule out depression, and I want to check your body too."
  },
  {
   "s": "person_1",
   "t": "There's nothing wrong with my body. ~"
  },
  {
   "s": "person_2",
   "t": "Maybe not, but I'd like to arrange a thyroid blood test, a vitamin B12 level, an HbA1c, and kidney function."
  },
  {
   "s": "person_3",
   "t": "All today? ~"
  },
  {
   "s": "person_2",
   "t": "Today, yes. And please eat small meals more often."
  },
  {
   "s": "person_1",
   "t": "If you say so. ~"
  },
  {
   "s": "person_2",
   "t": "If the sleep and appetite haven't improved in four weeks, come back and we'll talk about support and counselling."
  },
  {
   "s": "person_3",
   "t": "I'll make sure he does. ~"
  }
 ],
