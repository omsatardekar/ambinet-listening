 "encounter_id": "00719",
 "speakers": {
  "person_1": "PATIENT",
  "person_2": "DOCTOR",
  "person_3": "CAREGIVER"
 },
 "turns": [
  {
   "s": "person_1",
   "t": "Sorry we're late, doctor. Rosa got lost in the parking lot, and I wouldn't have come at all, it's just a foot check. ~"
  },
  {
   "s": "person_2",
   "t": "No problem, Mr Dale. How are you feeling about the feet, from your side? ~"
  },
  {
   "s": "person_1",
   "t": "They're fine. I have a little blister on the left heel, that's all, it came up last week from my work boots."
  },
  {
   "s": "person_3",
   "t": "It's been a week, doctor, and it's not healing. And his heels are cracked, they've been cracked all winter."
  },
  {
   "s": "person_2",
   "t": "Rosa, thank you. Any numbness or tingling in the feet, Mr Dale?"
  },
  {
   "s": "person_1",
   "t": "No, no numbness. My feet feel fine."
  },
  {
   "s": "person_3",
   "t": "Frank, you couldn't feel the bathwater yesterday, I had to tell you it was too hot. You never feel it on your feet."
  },
  {
   "s": "person_1",
   "t": "I felt it. It was a bit warm, that's all. ~"
  },
  {
   "s": "person_2",
   "t": "I'll write both down. Any fever or chills?"
  },
  {
   "s": "person_1",
   "t": "No fever."
  },
  {
   "s": "person_2",
   "t": "What about the legs, cramps?"
  },
  {
   "s": "person_1",
   "t": "Cramps in the calves at night, on and off."
  },
  {
   "s": "person_2",
   "t": "And your energy?"
  },
  {
   "s": "person_1",
   "t": "Tired. But I'm old."
  },
  {
   "s": "person_2",
   "t": "Let's go through your medications."
  },
  {
   "s": "person_1",
   "t": "Insulin glargine, 20 units, at bedtime. Metformin, 1000 mg, twice a day, I never miss it. Atorvastatin, 40 mg, at night. And lisinopril, 10 mg, once a day."
  },
  {
   "s": "person_3",
   "t": "The insulin is 24 units, Frank, I draw it up myself. And you skip the evening metformin, at least three times a week."
  },
  {
   "s": "person_1",
   "t": "It's 20. And I take the metformin. Mostly."
  },
  {
   "s": "person_2",
   "t": "So the insulin dose is 20 or 24 units, and I'll check with the pharmacy. Any allergies, Mr Dale?"
  },
  {
   "s": "person_1",
   "t": "Sulfa. I got hives from it."
  },
  {
   "s": "person_2",
   "t": "What conditions do you have?"
  },
  {
   "s": "person_1",
   "t": "Type 2 diabetes, fifteen years. High blood pressure. And high cholesterol."
  },
  {
   "s": "person_2",
   "t": "Any operations?"
  },
  {
   "s": "person_1",
   "t": "My right second toe was amputated, in 2021."
  },
  {
   "s": "person_2",
   "t": "Diabetes in the family?"
  },
  {
   "s": "person_1",
   "t": "My mother had it."
  },
  {
   "s": "person_2",
   "t": "Do you smoke?"
  },
  {
   "s": "person_1",
   "t": "I quit smoking six years ago."
  },
  {
   "s": "person_2",
   "t": "Alcohol?"
  },
  {
   "s": "person_1",
   "t": "A beer on Fridays."
  },
  {
   "s": "person_2",
   "t": "What did you do for work?"
  },
  {
   "s": "person_1",
   "t": "Trucker, thirty years. Retired."
  },
  {
   "s": "person_2",
   "t": "And at home?"
  },
  {
   "s": "person_1",
   "t": "I live with Rosa, she's my daughter-in-law, she looks after me."
  },
  {
   "s": "person_2",
   "t": "Let me check you. Blood pressure 138 over 82, pulse 78, temperature 36.9, oxygen 97 percent, breathing 16, and weight 98 kilos.",
   "pause": 15.0
  },
  {
   "s": "person_1",
   "t": "All good. ~"
  },
  {
   "s": "person_2",
   "t": "Take your socks off, please. Rosa, can you help?",
   "pause": 12.0
  },
  {
   "s": "person_3",
   "t": "Of course. ~"
  },
  {
   "s": "person_2",
   "t": "There's a blister on the left heel, about two centimetres, with no redness around it."
  },
  {
   "s": "person_3",
   "t": "Is it infected? ~"
  },
  {
   "s": "person_2",
   "t": "Not that I can see. The skin on both heels is dry and cracked."
  },
  {
   "s": "person_1",
   "t": "Told you, nothing serious. ~"
  },
  {
   "s": "person_2",
   "t": "Now I'll touch your soles with a thin plastic fibre. Tell me when you feel it.",
   "pause": 15.0
  },
  {
   "s": "person_1",
   "t": "Yes. Yes. Hm. ~"
  },
  {
   "s": "person_2",
   "t": "You couldn't feel it on the left sole at all, and only some of the right. So the sensation in the feet is reduced."
  },
  {
   "s": "person_1",
   "t": "Is it? ~"
  },
  {
   "s": "person_3",
   "t": "That's what I said. ~"
  },
  {
   "s": "person_2",
   "t": "Any trouble breathing?"
  },
  {
   "s": "person_1",
   "t": "No, nothing at all."
  },
  {
   "s": "person_2",
   "t": "This blister looks like a pressure blister from the boots, but because of your diabetes I want to be careful."
  },
  {
   "s": "person_3",
   "t": "What do we do? ~"
  },
  {
   "s": "person_2",
   "t": "I'd like to arrange an HbA1c, and an X-ray of the left foot."
  },
  {
   "s": "person_1",
   "t": "Fine. ~"
  },
  {
   "s": "person_2",
   "t": "Wear soft shoes, check your feet every day, Rosa too. I'd like to see you again in two weeks."
  },
  {
   "s": "person_3",
   "t": "Two weeks. I'll keep an eye on it. ~"
  }
 ],
