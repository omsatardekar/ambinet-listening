{
 "encounter_id": "00667",
 "speakers": {
  "person_1": "PATIENT",
  "person_2": "DOCTOR",
  "person_3": "NURSE"
 },
 "turns": [
  {
   "s": "person_3",
   "t": "Doctor, this is Mr Dalton, fifty-eight, sudden crushing chest pain forty minutes ago, ambulance brought him in. ECG's already done, it's on the desk."
  },
  {
   "s": "person_2",
   "t": "Thanks, Beth. Mr Dalton, I'm Dr Ahmed. Tell me about the pain."
  },
  {
   "s": "person_1",
   "t": "Chest. Heavy. Like a weight."
  },
  {
   "s": "person_2",
   "t": "When did it start, and what were you doing?"
  },
  {
   "s": "person_1",
   "t": "40 minutes. Mowing the lawn."
  },
  {
   "s": "person_2",
   "t": "Does it spread anywhere?"
  },
  {
   "s": "person_1",
   "t": "Left arm. And my jaw."
  },
  {
   "s": "person_2",
   "t": "Any sweating or sickness?"
  },
  {
   "s": "person_1",
   "t": "Sweating. Yes. A bit sick."
  },
  {
   "s": "person_2",
   "t": "Any breathlessness?"
  },
  {
   "s": "person_1",
   "t": "No. Not breathless."
  },
  {
   "s": "person_2",
   "t": "Have you fainted?"
  },
  {
   "s": "person_1",
   "t": "No."
  },
  {
   "s": "person_2",
   "t": "Any allergies to medicines?"
  },
  {
   "s": "person_1",
   "t": "Aspirin. Makes me wheeze."
  },
  {
   "s": "person_2",
   "t": "Thank you, that's important. Any heart problems before, or other conditions?"
  },
  {
   "s": "person_1",
   "t": "High cholesterol. And I had a heart scare, years ago. They said it was angina."
  },
  {
   "s": "person_2",
   "t": "What tablets do you take?"
  },
  {
   "s": "person_1",
   "t": "Atorvastatin. 40 mg. Nights."
  },
  {
   "s": "person_3",
   "t": "Observations, doctor. Blood pressure 152 over 94, pulse 102, oxygen 97 percent on air, temperature 36.8, breathing 20 a minute.",
   "pause": 12.0
  },
  {
   "s": "person_2",
   "t": "Thank you, Beth. Mr Dalton, I'm going to listen to your chest. ~"
  },
  {
   "s": "person_1",
   "t": "Go on. ~"
  },
  {
   "s": "person_2",
   "t": "Your chest is clear, your heart sounds are normal, but you're pale and clammy.",
   "pause": 15.0
  },
  {
   "s": "person_1",
   "t": "Is it a heart attack? ~"
  },
  {
   "s": "person_2",
   "t": "Your pain, the spread to arm and jaw and the sweating, and the changes on your ECG, make me think it's most likely a heart attack."
  },
  {
   "s": "person_1",
   "t": "Right. ~"
  },
  {
   "s": "person_2",
   "t": "We're going to treat you straight away, and a specialist team will take over your care. Beth, please get the heart team on the phone. ~"
  },
  {
   "s": "person_3",
   "t": "Calling now, doctor. ~"
  },
  {
   "s": "person_2",
   "t": "I'd also like to send a troponin blood test now, to confirm."
  },
  {
   "s": "person_1",
   "t": "What about the aspirin? ~"
  },
  {
   "s": "person_2",
   "t": "I'm glad you told me. We won't give you aspirin, we'll choose something else. ~"
  },
  {
   "s": "person_1",
   "t": "Thank you. I'd not have said, in the panic. ~"
  },
  {
   "s": "person_2",
   "t": "Stay lying down, don't eat or drink anything, and tell Beth immediately if the pain changes."
  },
  {
   "s": "person_3",
   "t": "I'll stay with you, Mr Dalton. ~"
  },
  {
   "s": "person_2",
   "t": "The cardiologist will see you tomorrow morning on the ward as well."
  },
  {
   "s": "person_1",
   "t": "Right. Thank you. ~"
  }
 ],
