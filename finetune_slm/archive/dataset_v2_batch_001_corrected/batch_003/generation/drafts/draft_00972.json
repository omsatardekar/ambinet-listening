{
 "encounter_id": "00972",
 "speakers": {
  "person_1": "PATIENT",
  "person_2": "DOCTOR"
 },
 "turns": [
  {
   "s": "person_1",
   "t": "I'm in a lot of pain. Gut pain, and I've had the runs for five days. I've been on azathioprine, but this is bad."
  },
  {
   "s": "person_2",
   "t": "I'm sorry. Let me ask quickly, then we'll do the examination. How many times a day are you going to the toilet?"
  },
  {
   "s": "person_1",
   "t": "Eight, nine times. Even at night."
  },
  {
   "s": "person_2",
   "t": "Is there blood?"
  },
  {
   "s": "person_1",
   "t": "Yeah. Bright red, mixed in."
  },
  {
   "s": "person_2",
   "t": "Where's the pain?"
  },
  {
   "s": "person_1",
   "t": "Lower right. Cramping, comes in waves."
  },
  {
   "s": "person_2",
   "t": "And how do you feel in yourself?"
  },
  {
   "s": "person_1",
   "t": "Weak. Wiped out."
  },
  {
   "s": "person_2",
   "t": "What medication are you on?"
  },
  {
   "s": "person_1",
   "t": "Azathioprine, 100 mg, once a day."
  },
  {
   "s": "person_2",
   "t": "Do you work?"
  },
  {
   "s": "person_1",
   "t": "Electrician. I haven't been in for three days."
  },
  {
   "s": "person_2",
   "t": "Smoke?"
  },
  {
   "s": "person_1",
   "t": "About ten a day."
  },
  {
   "s": "person_2",
   "t": "Let me check you. Pulse 108, blood pressure 108 over 66, temperature 37.9, oxygen 98 percent, breathing 18, weight 68 kilos.",
   "pause": 15.0
  },
  {
   "s": "person_1",
   "t": "Is the pulse bad? ~"
  },
  {
   "s": "person_2",
   "t": "It's fast, which fits with you being dehydrated. Lie back, I'll press your tummy.",
   "pause": 10.0
  },
  {
   "s": "person_1",
   "t": "Ow! That one. ~"
  },
  {
   "s": "person_2",
   "t": "There's tenderness in the lower right abdomen, with some guarding."
  },
  {
   "s": "person_1",
   "t": "Yeah. ~"
  },
  {
   "s": "person_2",
   "t": "Your bowel sounds are very active."
  },
  {
   "s": "person_1",
   "t": "Noisy, I know. ~"
  },
  {
   "s": "person_2",
   "t": "And your mouth is dry."
  },
  {
   "s": "person_1",
   "t": "I've not been drinking much. It goes straight through. ~"
  },
  {
   "s": "person_2",
   "t": "Any palpitations?"
  },
  {
   "s": "person_1",
   "t": "No, nothing like that, no palpitations."
  },
  {
   "s": "person_2",
   "t": "Right, here's what I think. This looks like a flare of your Crohn's disease."
  },
  {
   "s": "person_1",
   "t": "Yeah, that's what I thought. ~"
  },
  {
   "s": "person_2",
   "t": "I'd like to arrange a stool test to rule out an infection, blood tests including an inflammation marker, and an X-ray of the abdomen."
  },
  {
   "s": "person_1",
   "t": "Today? ~"
  },
  {
   "s": "person_2",
   "t": "Right now. I'll get a nurse to start fluids through a drip. ~"
  },
  {
   "s": "person_1",
   "t": "Thank God. ~"
  },
  {
   "s": "person_2",
   "t": "Don't take anything for the diarrhoea until we've ruled out infection."
  },
  {
   "s": "person_1",
   "t": "Okay. ~"
  },
  {
   "s": "person_2",
   "t": "If the bleeding or pain gets worse, press the call button straight away."
  },
  {
   "s": "person_1",
   "t": "Will do. ~"
  }
 ],
