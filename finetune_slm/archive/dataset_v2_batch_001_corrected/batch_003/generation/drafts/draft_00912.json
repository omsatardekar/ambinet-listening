{
 "encounter_id": "00912",
 "speakers": {
  "person_1": "PATIENT",
  "person_2": "DOCTOR",
  "person_3": "NURSE"
 },
 "turns": [
  {
   "s": "person_1",
   "t": "I wanted to talk about my eating. I've been restricting a lot, and my friend said I should speak to someone."
  },
  {
   "s": "person_2",
   "t": "Thank you for telling us. That took courage. Can you tell me what restricting looks like for you?"
  },
  {
   "s": "person_1",
   "t": "I skip breakfast and lunch most days, and I only have a small dinner. I count everything."
  },
  {
   "s": "person_2",
   "t": "How long has it been like this?"
  },
  {
   "s": "person_1",
   "t": "About one year. It got worse after exams last summer."
  },
  {
   "s": "person_2",
   "t": "Have you been making yourself sick, or using laxatives?"
  },
  {
   "s": "person_1",
   "t": "No. Never. I just don't eat."
  },
  {
   "s": "person_2",
   "t": "How do you feel about your weight and body? ~"
  },
  {
   "s": "person_1",
   "t": "I feel too big, even though people say I'm thin. ~"
  },
  {
   "s": "person_2",
   "t": "Thank you for being honest. Are you on any medicines?"
  },
  {
   "s": "person_1",
   "t": "Just the contraceptive pill, I think it's Microgynon, but I'm not sure."
  },
  {
   "s": "person_3",
   "t": "Doctor, I've weighed her and taken her pulse. Weight 46 kilos, height 165, pulse 54. ~"
  },
  {
   "s": "person_2",
   "t": "Thank you. That's a low pulse, and a body mass index around seventeen."
  },
  {
   "s": "person_1",
   "t": "Is that bad? ~"
  },
  {
   "s": "person_2",
   "t": "It's lower than I'd like. Your body is working hard to protect you. Have you had any dizziness or fainting?"
  },
  {
   "s": "person_1",
   "t": "Dizzy when I stand up quickly. Never fainted."
  },
  {
   "s": "person_2",
   "t": "Have your periods been regular? ~"
  },
  {
   "s": "person_1",
   "t": "They stopped about six months ago. ~"
  },
  {
   "s": "person_2",
   "t": "Any past medical conditions?"
  },
  {
   "s": "person_1",
   "t": "Asthma as a child. And anxiety, last year, but I was never treated."
  },
  {
   "s": "person_2",
   "t": "Any operations?"
  },
  {
   "s": "person_1",
   "t": "My tonsils, when I was nine."
  },
  {
   "s": "person_2",
   "t": "Do you drink alcohol or smoke?"
  },
  {
   "s": "person_1",
   "t": "No. I never have."
  },
  {
   "s": "person_2",
   "t": "I'd like to be honest with you. What you describe sounds like an eating disorder, and I'd like to arrange a proper assessment."
  },
  {
   "s": "person_1",
   "t": "I don't want to be put in hospital. ~"
  },
  {
   "s": "person_2",
   "t": "We're not talking about that now. I'm going to refer you to the eating disorder team, and we'll run bloods and an ECG."
  },
  {
   "s": "person_1",
   "t": "Okay. I think I do need help. ~"
  },
  {
   "s": "person_3",
   "t": "I'll book the bloods with you before you leave today. ~"
  },
  {
   "s": "person_2",
   "t": "And I'd like to see you again in one week, so we can check how you're managing."
  },
  {
   "s": "person_1",
   "t": "One week. Thank you for not judging me. ~"
  }
 ],
