{
 "encounter_id": "00654",
 "speakers": {
  "person_1": "PATIENT",
  "person_2": "DOCTOR"
 },
 "turns": [
  {
   "s": "person_1",
   "t": "I'm here for the methotrexate bloods review. Hands are stiff but manageable."
  },
  {
   "s": "person_2",
   "t": "Thanks for coming. Let's start with how the hands feel through the day."
  },
  {
   "s": "person_1",
   "t": "Stiff in the morning, about an hour. Gone by lunch."
  },
  {
   "s": "person_2",
   "t": "Any swelling in the knuckles?"
  },
  {
   "s": "person_1",
   "t": "A bit. Right hand, the middle knuckles."
  },
  {
   "s": "person_2",
   "t": "How about your energy?"
  },
  {
   "s": "person_1",
   "t": "Tired. Mostly afternoons."
  },
  {
   "s": "person_2",
   "t": "Any mouth ulcers since the dose went up? That's a common side effect."
  },
  {
   "s": "person_1",
   "t": "A couple. They come and go."
  },
  {
   "s": "person_2",
   "t": "Any cough or breathlessness, the kind that's new?"
  },
  {
   "s": "person_1",
   "t": "No. No cough."
  },
  {
   "s": "person_2",
   "t": "Fever or chills?"
  },
  {
   "s": "person_1",
   "t": "None."
  },
  {
   "s": "person_2",
   "t": "Easy bruising or bleeding gums?"
  },
  {
   "s": "person_1",
   "t": "No. Neither."
  },
  {
   "s": "person_2",
   "t": "Nausea after the weekly dose?"
  },
  {
   "s": "person_1",
   "t": "No, not really."
  },
  {
   "s": "person_2",
   "t": "Walk me through all the tablets, please."
  },
  {
   "s": "person_1",
   "t": "Methotrexate, maybe 20 mg? Once a week. Folic acid, 5 mg, the day after. Hydroxychloroquine, 200 mg twice a day. And omeprazole, 20 mg, in the morning."
  },
  {
   "s": "person_2",
   "t": "You said maybe 20 for the methotrexate. Do you have the box with you?"
  },
  {
   "s": "person_1",
   "t": "No. Left it on the side. ~"
  },
  {
   "s": "person_2",
   "t": "I'll check with the pharmacy before we change anything. Any allergies to medicines?"
  },
  {
   "s": "person_1",
   "t": "Penicillin. Hives."
  },
  {
   "s": "person_2",
   "t": "Thank you. Any other health problems?"
  },
  {
   "s": "person_1",
   "t": "Rheumatoid arthritis, since 2019. Acid reflux. And mild asthma."
  },
  {
   "s": "person_2",
   "t": "Previous surgery?"
  },
  {
   "s": "person_1",
   "t": "Carpal tunnel release, right wrist, three years ago."
  },
  {
   "s": "person_2",
   "t": "Arthritis in the family?"
  },
  {
   "s": "person_1",
   "t": "My mother had rheumatoid arthritis too."
  },
  {
   "s": "person_2",
   "t": "Do you smoke?"
  },
  {
   "s": "person_1",
   "t": "Never smoked."
  },
  {
   "s": "person_2",
   "t": "Alcohol? With methotrexate we like it to be low."
  },
  {
   "s": "person_1",
   "t": "A glass of wine. Saturdays."
  },
  {
   "s": "person_2",
   "t": "And your work?"
  },
  {
   "s": "person_1",
   "t": "Primary school teacher."
  },
  {
   "s": "person_2",
   "t": "Any exercise?"
  },
  {
   "s": "person_1",
   "t": "Yoga, twice a week. It helps the hands."
  },
  {
   "s": "person_2",
   "t": "Good. Your pulse is 70, blood pressure 118 over 74, temperature 36.6, oxygen 98 percent, breathing 14, and your weight is 66 kilos.",
   "pause": 15.0
  },
  {
   "s": "person_1",
   "t": "Same as before? ~"
  },
  {
   "s": "person_2",
   "t": "Very similar. Show me your hands, please.",
   "pause": 8.0
  },
  {
   "s": "person_1",
   "t": "There. ~"
  },
  {
   "s": "person_2",
   "t": "I can see swelling over the right middle knuckles, and there's tenderness squeezing across the right hand."
  },
  {
   "s": "person_1",
   "t": "Yes, that hurts. ~"
  },
  {
   "s": "person_2",
   "t": "The left hand looks normal, no swelling. And in your mouth there are two small ulcers on the inner cheek."
  },
  {
   "s": "person_1",
   "t": "I told you. ~"
  },
  {
   "s": "person_2",
   "t": "Now your chest. Any problem with your breathing today?"
  },
  {
   "s": "person_1",
   "t": "No. Breathing's fine."
  },
  {
   "s": "person_2",
   "t": "Good. My impression is a mild flare of the arthritis, but I can't rule out the methotrexate causing those mouth ulcers."
  },
  {
   "s": "person_1",
   "t": "So what now? ~"
  },
  {
   "s": "person_2",
   "t": "I'd like to arrange blood tests for your blood count and liver, and a chest X-ray, since you've been on this a while."
  },
  {
   "s": "person_1",
   "t": "And the hands? ~"
  },
  {
   "s": "person_2",
   "t": "I'll also arrange X-rays of your hands to check the joints haven't changed."
  },
  {
   "s": "person_1",
   "t": "Okay. ~"
  },
  {
   "s": "person_2",
   "t": "I'd like to see you again in three months, sooner if the ulcers get worse."
  },
  {
   "s": "person_1",
   "t": "Three months. Fine. ~"
  }
 ],
