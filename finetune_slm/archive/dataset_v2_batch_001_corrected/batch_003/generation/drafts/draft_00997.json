 "speakers": {
  "person_1": "PATIENT",
  "person_2": "DOCTOR"
 },
 "turns": [
  {
   "s": "person_1",
   "t": "The splint isn't helping. I've worn it at night for six weeks, for my carpal tunnel, and I still get tingling."
  },
  {
   "s": "person_2",
   "t": "Tell me exactly where the tingling is."
  },
  {
   "s": "person_1",
   "t": "Thumb, index and middle finger of the right hand. Not the little finger."
  },
  {
   "s": "person_2",
   "t": "When is it worst?"
  },
  {
   "s": "person_1",
   "t": "At night. It wakes me about three times."
  },
  {
   "s": "person_2",
   "t": "Any weakness?"
  },
  {
   "s": "person_1",
   "t": "My grip is weaker. I dropped a mug last week."
  },
  {
   "s": "person_2",
   "t": "Do you drop things often?"
  },
  {
   "s": "person_1",
   "t": "Twice this month."
  },
  {
   "s": "person_2",
   "t": "Any neck pain?"
  },
  {
   "s": "person_1",
   "t": "No neck pain."
  },
  {
   "s": "person_2",
   "t": "Any numbness in the feet?"
  },
  {
   "s": "person_1",
   "t": "No, just the hand."
  },
  {
   "s": "person_2",
   "t": "What are you taking for it?"
  },
  {
   "s": "person_1",
   "t": "Ibuprofen, 400 mg, when it's bad."
  },
  {
   "s": "person_2",
   "t": "Your history?"
  },
  {
   "s": "person_1",
   "t": "Carpal tunnel on the left, diagnosed two years ago."
  },
  {
   "s": "person_2",
   "t": "Let me take two numbers. Blood pressure 122 over 76, pulse 68.",
   "pause": 10.0
  },
  {
   "s": "person_1",
   "t": "Normal. ~"
  },
  {
   "s": "person_2",
   "t": "Hold your wrists bent, backs of the hands together, for a minute.",
   "pause": 15.0
  },
  {
   "s": "person_1",
   "t": "Ah. There it is. The tingling. ~"
  },
  {
   "s": "person_2",
   "t": "That reproduces the tingling in the thumb, index and middle fingers."
  },
  {
   "s": "person_1",
   "t": "Exactly. ~"
  },
  {
   "s": "person_2",
   "t": "Any weakness or numbness in your legs?"
  },
  {
   "s": "person_1",
   "t": "No, nothing like that."
  },
  {
   "s": "person_2",
   "t": "My impression is that the carpal tunnel on this side persists despite the splint."
  },
  {
   "s": "person_1",
   "t": "What next? ~"
  },
  {
   "s": "person_2",
   "t": "Make sure the splint holds the wrist straight, not bent, a lot of people wear it too loose."
  },
  {
   "s": "person_1",
   "t": "I'll check. ~"
  },
  {
   "s": "person_2",
   "t": "If it's not better in four weeks, I'll arrange a nerve conduction test and consider an injection."
  },
  {
   "s": "person_1",
   "t": "And if the weakness gets worse? ~"
  },
  {
   "s": "person_2",
   "t": "Come straight back. ~"
  },
  {
   "s": "person_1",
   "t": "Will do. ~"
  }
