{
 "encounter_id": "00844",
 "speakers": {
  "person_1": "PATIENT",
  "person_2": "DOCTOR",
  "person_3": "FAMILY_MEMBER",
  "person_4": "CLINICAL_STAFF"
 },
 "turns": [
  {
   "s": "person_2",
   "t": "Good afternoon. Can I just check, it's Mrs Eleanor Whitcombe? ~"
  },
  {
   "s": "person_1",
   "t": "It is, thank you, doctor. How kind of you to see me. ~"
  },
  {
   "s": "person_3",
   "t": "I'm her daughter, Fiona. And this is Callum from the home, he's helped with the transport. ~"
  },
  {
   "s": "person_4",
   "t": "Pleased to meet you, doctor. I'll just sit at the back. ~"
  },
  {
   "s": "person_2",
   "t": "Welcome. Mrs Whitcombe, Fiona tells me you're feeling low since the move. Is that right?"
  },
  {
   "s": "person_1",
   "t": "I suppose I am. I don't like to complain. I've felt rather low since I moved into the home, about six weeks ago."
  },
  {
   "s": "person_2",
   "t": "How has it affected you?"
  },
  {
   "s": "person_1",
   "t": "I've lost interest in my knitting, which I've done all my life. I sit and look at the wool."
  },
  {
   "s": "person_3",
   "t": "She's also awake at four every morning, Mum, you told me."
  },
  {
   "s": "person_1",
   "t": "Yes, I wake at four and can't get back to sleep. I lie there listening to the corridor."
  },
  {
   "s": "person_2",
   "t": "Any thoughts of ending your life?"
  },
  {
   "s": "person_1",
   "t": "Goodness, no. Never."
  },
  {
   "s": "person_2",
   "t": "Any falls since the move?"
  },
  {
   "s": "person_1",
   "t": "No falls. The staff are very careful."
  },
  {
   "s": "person_2",
   "t": "Any new aches or pains?"
  },
  {
   "s": "person_1",
   "t": "Nothing new."
  },
  {
   "s": "person_2",
   "t": "Fiona, can you tell me her tablets?"
  },
  {
   "s": "person_3",
   "t": "Amlodipine, 5 mg, once a day. Simvastatin, 20 mg, at night. Levothyroxine, 50 micrograms, in the morning. And paracetamol, 500 mg, when she needs it."
  },
  {
   "s": "person_2",
   "t": "Thank you. Any allergies?"
  },
  {
   "s": "person_1",
   "t": "Codeine. It made me quite confused."
  },
  {
   "s": "person_2",
   "t": "Medical history?"
  },
  {
   "s": "person_1",
   "t": "An underactive thyroid, high blood pressure, and arthritis."
  },
  {
   "s": "person_2",
   "t": "Operations?"
  },
  {
   "s": "person_1",
   "t": "A hip replacement, in 2018."
  },
  {
   "s": "person_2",
   "t": "Any family history of low mood?"
  },
  {
   "s": "person_1",
   "t": "My sister was treated for depression, many years ago."
  },
  {
   "s": "person_2",
   "t": "Where were you living before?"
  },
  {
   "s": "person_1",
   "t": "In our own house for fifty years, until my husband passed and the stairs became too much. I moved into assisted living, you see."
  },
  {
   "s": "person_2",
   "t": "And your work, before that?"
  },
  {
   "s": "person_1",
   "t": "I taught infants for thirty-five years. Retired."
  },
  {
   "s": "person_2",
   "t": "Do you get out and about?"
  },
  {
   "s": "person_1",
   "t": "I walk in the garden, when it's dry."
  },
  {
   "s": "person_2",
   "t": "And any company?"
  },
  {
   "s": "person_1",
   "t": "Bridge on Thursdays, though I haven't gone these last weeks."
  },
  {
   "s": "person_2",
   "t": "Let me check you. Pulse 68, blood pressure 130 over 76, temperature 36.4, oxygen 97 percent, breathing 14, and weight 58 kilos.",
   "pause": 15.0
  },
  {
   "s": "person_3",
   "t": "She's lost a bit, hasn't she? ~"
  },
  {
   "s": "person_2",
   "t": "A little. Let me look at you, Mrs Whitcombe. You look tearful.",
   "pause": 8.0
  },
  {
   "s": "person_1",
   "t": "I'm sorry, dear. ~"
  },
  {
   "s": "person_2",
   "t": "Your speech is a little slow, and you were slow to answer, but your thinking is clear."
  },
  {
   "s": "person_1",
   "t": "Is that all right? ~"
  },
  {
   "s": "person_2",
   "t": "Your heart sounds are normal."
  },
  {
   "s": "person_1",
   "t": "Good. ~"
  },
  {
   "s": "person_2",
   "t": "Any trouble with your breathing?"
  },
  {
   "s": "person_1",
   "t": "No, nothing, I'm fine in that way."
  },
  {
   "s": "person_2",
   "t": "This could well be an adjustment reaction to the move, but I can't rule out depression."
  },
  {
   "s": "person_3",
   "t": "What do we do? ~"
  },
  {
   "s": "person_2",
   "t": "I'd like to arrange blood tests for thyroid and vitamin B12, since low levels can cause this, and a urine test."
  },
  {
   "s": "person_4",
   "t": "I can bring her for the blood test on Tuesday. ~"
  },
  {
   "s": "person_2",
   "t": "Thank you, Callum. Also, Mrs Whitcombe, please go back to bridge on Thursday."
  },
  {
   "s": "person_1",
   "t": "I will try. ~"
  },
  {
   "s": "person_2",
   "t": "I'd like to see you again in four weeks."
  },
  {
   "s": "person_3",
   "t": "Four weeks. We'll book it. ~"
  }
 ],
