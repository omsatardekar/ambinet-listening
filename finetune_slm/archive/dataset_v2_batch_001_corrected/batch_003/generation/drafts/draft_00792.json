{
 "encounter_id": "00792",
 "speakers": {
  "person_1": "PATIENT",
  "person_2": "DOCTOR",
  "person_3": "NURSE"
 },
 "turns": [
  {
   "s": "person_3",
   "t": "Dr Hale, this is Mrs Banks. I've done her obs. Blood pressure 124 over 78, pulse 80, temperature 36.7, oxygen 98 percent, breathing 16, weight 69 kilos. She's got food sticking in her chest."
  },
  {
   "s": "person_2",
   "t": "Thank you, nurse. Come in, Mrs Banks. Sit down. Sticking where, exactly?"
  },
  {
   "s": "person_1",
   "t": "Oh, hello, dear. Here, behind the breastbone, it's like a lump of bread that won't go down. My sister had it, you see, well, no, she had something else, and I do hope this isn't the same."
  },
  {
   "s": "person_2",
   "t": "How long have you had the food sticking?"
  },
  {
   "s": "person_1",
   "t": "Three months, give or take. It's worse with meat, and with the dry toast, oh, I do love toast."
  },
  {
   "s": "person_2",
   "t": "Do you get heartburn?"
  },
  {
   "s": "person_1",
   "t": "Terrible heartburn. Years of it, but it's worse now at night."
  },
  {
   "s": "person_2",
   "t": "Any burping, belching?"
  },
  {
   "s": "person_1",
   "t": "All the time, I'm so embarrassed."
  },
  {
   "s": "person_2",
   "t": "Do you vomit blood?"
  },
  {
   "s": "person_1",
   "t": "No, no blood."
  },
  {
   "s": "person_2",
   "t": "Have you lost weight?"
  },
  {
   "s": "person_1",
   "t": "No, if anything I've put it on."
  },
  {
   "s": "person_2",
   "t": "Black stools?"
  },
  {
   "s": "person_1",
   "t": "No, nothing like that."
  },
  {
   "s": "person_2",
   "t": "Is swallowing painful, or only stuck?"
  },
  {
   "s": "person_1",
   "t": "Not painful, no. Just stuck."
  },
  {
   "s": "person_2",
   "t": "Allergies to medicines or foods?"
  },
  {
   "s": "person_1",
   "t": "Shellfish. My lips swell up. I've learned to be careful."
  },
  {
   "s": "person_2",
   "t": "Good. And your history?"
  },
  {
   "s": "person_1",
   "t": "The reflux, mild asthma, and I was anaemic a few years ago."
  },
  {
   "s": "person_2",
   "t": "Operations?"
  },
  {
   "s": "person_1",
   "t": "Appendix, as a girl."
  },
  {
   "s": "person_2",
   "t": "Stomach or gullet problems in the family?"
  },
  {
   "s": "person_1",
   "t": "My mother had cancer of the gullet, poor soul. And my sister has coeliac disease."
  },
  {
   "s": "person_2",
   "t": "Do you smoke?"
  },
  {
   "s": "person_1",
   "t": "Ten a day, I'm afraid."
  },
  {
   "s": "person_2",
   "t": "And drink?"
  },
  {
   "s": "person_1",
   "t": "A glass of wine most nights. Maybe two."
  },
  {
   "s": "person_2",
   "t": "Let me look at you. Lie back. I'm pressing your tummy, tell me if it's sore.",
   "pause": 10.0
  },
  {
   "s": "person_1",
   "t": "Not at all. ~"
  },
  {
   "s": "person_2",
   "t": "The abdomen is soft and not tender, and I can't feel any lumps in your neck."
  },
  {
   "s": "person_1",
   "t": "Is that good? ~"
  },
  {
   "s": "person_2",
   "t": "Any trouble with your breathing, with your asthma?"
  },
  {
   "s": "person_1",
   "t": "No, nothing, it's been quiet."
  },
  {
   "s": "person_2",
   "t": "Any chest pain on exertion, apart from the sticking?"
  },
  {
   "s": "person_1",
   "t": "No, nothing like that."
  },
  {
   "s": "person_2",
   "t": "With years of reflux and food catching, I think it's the acid irritating the gullet, but I can't rule out a narrowing, and with your mother's history I want to look."
  },
  {
   "s": "person_1",
   "t": "Oh dear. Is it cancer? ~"
  },
  {
   "s": "person_2",
   "t": "I don't think so, but I'd like to arrange a camera test of the gullet, a gastroscopy."
  },
  {
   "s": "person_1",
   "t": "Will I be asleep? ~"
  },
  {
   "s": "person_2",
   "t": "Sedated, yes. I'd also like to do blood tests for anaemia, and a barium swallow."
  },
  {
   "s": "person_1",
   "t": "Anything for the heartburn meanwhile? ~"
  },
  {
   "s": "person_2",
   "t": "Yes, let's start omeprazole 40 mg once a day."
  },
  {
   "s": "person_3",
   "t": "I'll print the instructions for the camera test. ~"
  },
  {
   "s": "person_2",
   "t": "Thank you. I'd like to see you again in six weeks, after the tests."
  },
  {
   "s": "person_1",
   "t": "Six weeks. Thank you, dears. ~"
  }
 ],
