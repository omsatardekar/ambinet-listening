{
  "schema_version": "1.0",
  "encounter_id": "00997",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 3.76,
      "end_seconds": 15.4,
      "duration_seconds": 11.64,
      "text": "The splint isn't helping. I've worn it at night for six weeks, for my carpal tunnel, and I still get tingling."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.23,
      "end_seconds": 23.61,
      "duration_seconds": 4.38,
      "text": "Tell me exactly where the tingling is."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.35,
      "end_seconds": 35.88,
      "duration_seconds": 7.53,
      "text": "Thumb, index and middle finger of the right hand. Not the little finger."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.87,
      "end_seconds": 42.13,
      "duration_seconds": 2.26,
      "text": "When is it worst?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.32,
      "end_seconds": 51.63,
      "duration_seconds": 5.31,
      "text": "At night. It wakes me about three times."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.9,
      "end_seconds": 57.54,
      "duration_seconds": 1.64,
      "text": "Any weakness?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.52,
      "end_seconds": 66.78,
      "duration_seconds": 5.26,
      "text": "My grip is weaker. I dropped a mug last week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.78,
      "end_seconds": 73.89,
      "duration_seconds": 3.11,
      "text": "Do you drop things often?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.06,
      "end_seconds": 79.99,
      "duration_seconds": 1.93,
      "text": "Twice this month."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.56,
      "end_seconds": 86.69,
      "duration_seconds": 2.13,
      "text": "Any neck pain?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.78,
      "end_seconds": 93.12,
      "duration_seconds": 2.34,
      "text": "No neck pain."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.84,
      "end_seconds": 101.27,
      "duration_seconds": 3.43,
      "text": "Any numbness in the feet?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.85,
      "end_seconds": 108.34,
      "duration_seconds": 2.49,
      "text": "No, just the hand."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.09,
      "end_seconds": 116.31,
      "duration_seconds": 3.22,
      "text": "What are you taking for it?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.61,
      "end_seconds": 124.36,
      "duration_seconds": 3.75,
      "text": "Ibuprofen, 400 mg, when it's bad."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.87,
      "end_seconds": 130.71,
      "duration_seconds": 1.84,
      "text": "Your history?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.04,
      "end_seconds": 139.79,
      "duration_seconds": 4.75,
      "text": "Carpal tunnel on the left, diagnosed two years ago."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.6,
      "end_seconds": 157.62,
      "duration_seconds": 7.02,
      "text": "Let me take two numbers. Blood pressure 122 over 76, pulse 68."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.59,
      "end_seconds": 163.18,
      "duration_seconds": 1.59,
      "text": "Normal. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.46,
      "end_seconds": 185.94,
      "duration_seconds": 6.48,
      "text": "Hold your wrists bent, backs of the hands together, for a minute."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.49,
      "end_seconds": 194.98,
      "duration_seconds": 4.49,
      "text": "Ah. There it is. The tingling. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.98,
      "end_seconds": 205.66,
      "duration_seconds": 6.68,
      "text": "That reproduces the tingling in the thumb, index and middle fingers."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.4,
      "end_seconds": 212.09,
      "duration_seconds": 1.69,
      "text": "Exactly. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.81,
      "end_seconds": 221.39,
      "duration_seconds": 4.58,
      "text": "Any weakness or numbness in your legs?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.93,
      "end_seconds": 229.12,
      "duration_seconds": 3.19,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.71,
      "end_seconds": 241.18,
      "duration_seconds": 8.47,
      "text": "My impression is that the carpal tunnel on this side persists despite the splint."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.5,
      "end_seconds": 247.38,
      "duration_seconds": 1.88,
      "text": "What next? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.61,
      "end_seconds": 262.88,
      "duration_seconds": 11.27,
      "text": "Make sure the splint holds the wrist straight, not bent, a lot of people wear it too loose."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.62,
      "end_seconds": 268.38,
      "duration_seconds": 1.76,
      "text": "I'll check. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.02,
      "end_seconds": 283.14,
      "duration_seconds": 10.12,
      "text": "If it's not better in four weeks, I'll arrange a nerve conduction test and consider an injection."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.81,
      "end_seconds": 291.94,
      "duration_seconds": 4.13,
      "text": "And if the weakness gets worse? ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.86,
      "end_seconds": 298.88,
      "duration_seconds": 3.02,
      "text": "Come straight back. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.56,
      "end_seconds": 306.0,
      "duration_seconds": 2.44,
      "text": "Will do. ~"
    }
  ]
}
