{
  "schema_version": "1.0",
  "encounter_id": "00667",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 1.5,
      "end_seconds": 14.78,
      "duration_seconds": 13.28,
      "text": "Doctor, this is Mr Dalton, fifty-eight, sudden crushing chest pain forty minutes ago, ambulance brought him in. ECG's already done, it's on the desk."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.85,
      "end_seconds": 23.72,
      "duration_seconds": 5.87,
      "text": "Thanks, Beth. Mr Dalton, I'm Dr Ahmed. Tell me about the pain."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.46,
      "end_seconds": 29.51,
      "duration_seconds": 3.05,
      "text": "Chest. Heavy. Like a weight."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.54,
      "end_seconds": 38.18,
      "duration_seconds": 5.64,
      "text": "When did it start, and what were you doing?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.95,
      "end_seconds": 43.13,
      "duration_seconds": 3.18,
      "text": "40 minutes. Mowing the lawn."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.21,
      "end_seconds": 47.8,
      "duration_seconds": 2.59,
      "text": "Does it spread anywhere?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.41,
      "end_seconds": 53.85,
      "duration_seconds": 3.44,
      "text": "Left arm. And my jaw."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.41,
      "end_seconds": 59.76,
      "duration_seconds": 2.35,
      "text": "Any sweating or sickness?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.25,
      "end_seconds": 66.45,
      "duration_seconds": 3.2,
      "text": "Sweating. Yes. A bit sick."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.26,
      "end_seconds": 70.8,
      "duration_seconds": 1.54,
      "text": "Any breathlessness?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.28,
      "end_seconds": 75.52,
      "duration_seconds": 2.24,
      "text": "No. Not breathless."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.44,
      "end_seconds": 80.45,
      "duration_seconds": 2.01,
      "text": "Have you fainted?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.43,
      "end_seconds": 83.33,
      "duration_seconds": 0.9,
      "text": "No."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.54,
      "end_seconds": 88.1,
      "duration_seconds": 2.56,
      "text": "Any allergies to medicines?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.39,
      "end_seconds": 93.18,
      "duration_seconds": 2.79,
      "text": "Aspirin. Makes me wheeze."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.28,
      "end_seconds": 102.9,
      "duration_seconds": 6.62,
      "text": "Thank you, that's important. Any heart problems before, or other conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.01,
      "end_seconds": 113.29,
      "duration_seconds": 7.28,
      "text": "High cholesterol. And I had a heart scare, years ago. They said it was angina."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.63,
      "end_seconds": 119.53,
      "duration_seconds": 2.9,
      "text": "What tablets do you take?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.31,
      "end_seconds": 124.19,
      "duration_seconds": 2.88,
      "text": "Atorvastatin. 40 mg. Nights."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 137.75,
      "end_seconds": 148.28,
      "duration_seconds": 10.53,
      "text": "Observations, doctor. Blood pressure 152 over 94, pulse 102, oxygen 97 percent on air, temperature 36.8, breathing 20 a minute."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.09,
      "end_seconds": 158.33,
      "duration_seconds": 8.24,
      "text": "Thank you, Beth. Mr Dalton, I'm going to listen to your chest. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.06,
      "end_seconds": 162.25,
      "duration_seconds": 2.19,
      "text": "Go on. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.95,
      "end_seconds": 186.85,
      "duration_seconds": 7.9,
      "text": "Your chest is clear, your heart sounds are normal, but you're pale and clammy."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.58,
      "end_seconds": 193.14,
      "duration_seconds": 3.56,
      "text": "Is it a heart attack? ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.09,
      "end_seconds": 209.43,
      "duration_seconds": 13.34,
      "text": "Your pain, the spread to arm and jaw and the sweating, and the changes on your ECG, make me think it's most likely a heart attack."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.59,
      "end_seconds": 214.4,
      "duration_seconds": 1.81,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.76,
      "end_seconds": 230.48,
      "duration_seconds": 13.72,
      "text": "We're going to treat you straight away, and a specialist team will take over your care. Beth, please get the heart team on the phone. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 233.52,
      "end_seconds": 236.1,
      "duration_seconds": 2.58,
      "text": "Calling now, doctor. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.23,
      "end_seconds": 244.41,
      "duration_seconds": 6.18,
      "text": "I'd also like to send a troponin blood test now, to confirm."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.05,
      "end_seconds": 249.92,
      "duration_seconds": 2.87,
      "text": "What about the aspirin? ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.42,
      "end_seconds": 261.15,
      "duration_seconds": 8.73,
      "text": "I'm glad you told me. We won't give you aspirin, we'll choose something else. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.73,
      "end_seconds": 270.03,
      "duration_seconds": 6.3,
      "text": "Thank you. I'd not have said, in the panic. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.66,
      "end_seconds": 282.94,
      "duration_seconds": 9.28,
      "text": "Stay lying down, don't eat or drink anything, and tell Beth immediately if the pain changes."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 285.97,
      "end_seconds": 290.19,
      "duration_seconds": 4.22,
      "text": "I'll stay with you, Mr Dalton. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.5,
      "end_seconds": 299.3,
      "duration_seconds": 6.8,
      "text": "The cardiologist will see you tomorrow morning on the ward as well."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.87,
      "end_seconds": 306.0,
      "duration_seconds": 3.13,
      "text": "Right. Thank you. ~"
    }
  ]
}
