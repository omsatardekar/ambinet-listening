{
  "schema_version": "1.0",
  "encounter_id": "00933",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 3.04,
      "end_seconds": 18.69,
      "duration_seconds": 15.65,
      "text": "G'day, doctor. It's Bruce here, Kev's wife, no, sorry, I'm Kev's brother. Kev's got joint pain since a tick bit him, and he won't say. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.66,
      "end_seconds": 26.59,
      "duration_seconds": 3.93,
      "text": "Thanks, Bruce. Kev, what's been happening? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.43,
      "end_seconds": 35.73,
      "duration_seconds": 5.3,
      "text": "Um. It's my knee. The right one. It's sore."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.1,
      "end_seconds": 43.37,
      "duration_seconds": 3.27,
      "text": "How long's it been sore?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.68,
      "end_seconds": 49.09,
      "duration_seconds": 2.41,
      "text": "About two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 52.59,
      "end_seconds": 62.35,
      "duration_seconds": 9.76,
      "text": "Three, mate. It was three weeks. You went camping, remember, the long weekend, and you had the tick after."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.63,
      "end_seconds": 69.95,
      "duration_seconds": 3.32,
      "text": "Two. It feels like two."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.01,
      "end_seconds": 78.52,
      "duration_seconds": 5.51,
      "text": "Two to three weeks, then. Does it swell? ~"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.93,
      "end_seconds": 84.26,
      "duration_seconds": 2.33,
      "text": "A bit. ~"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.99,
      "end_seconds": 91.48,
      "duration_seconds": 3.49,
      "text": "Have you had a fever?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.55,
      "end_seconds": 97.6,
      "duration_seconds": 2.05,
      "text": "No. No fever."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 101.85,
      "end_seconds": 112.39,
      "duration_seconds": 10.54,
      "text": "He was burning up on Tuesday night, doctor. He had a fever, he just won't admit it."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.84,
      "end_seconds": 120.93,
      "duration_seconds": 5.09,
      "text": "I'll write both down. Kev, any allergies, to medicines?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.95,
      "end_seconds": 133.32,
      "duration_seconds": 9.37,
      "text": "Um. Penicillin. I'm allergic to it. I get a reaction, but I don't know what. Mum would know."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.55,
      "end_seconds": 140.78,
      "duration_seconds": 4.23,
      "text": "Okay. Anything wrong with your health in general?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.11,
      "end_seconds": 147.51,
      "duration_seconds": 3.4,
      "text": "Asthma. Since I was a kid."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.67,
      "end_seconds": 165.59,
      "duration_seconds": 5.92,
      "text": "Let me look at the knee. Roll up the trouser leg."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.0,
      "end_seconds": 172.02,
      "duration_seconds": 2.02,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.17,
      "end_seconds": 181.64,
      "duration_seconds": 6.47,
      "text": "There's swelling of the right knee, and it's warm compared to the left."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.85,
      "end_seconds": 187.81,
      "duration_seconds": 2.96,
      "text": "It's been like that. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.62,
      "end_seconds": 200.69,
      "duration_seconds": 9.07,
      "text": "And on your thigh, I can see a ring-shaped red patch, about the size of a coaster."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 204.84,
      "end_seconds": 209.08,
      "duration_seconds": 4.24,
      "text": "That's where the tick was, I think. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.48,
      "end_seconds": 218.41,
      "duration_seconds": 5.93,
      "text": "Did you get the tick out in one piece? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 222.39,
      "end_seconds": 227.83,
      "duration_seconds": 5.44,
      "text": "With tweezers, yes. I got the head and all. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.0,
      "end_seconds": 237.11,
      "duration_seconds": 5.11,
      "text": "Good, that's the right way to do it. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.77,
      "end_seconds": 243.63,
      "duration_seconds": 2.86,
      "text": "I forgot about that. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.17,
      "end_seconds": 257.34,
      "duration_seconds": 10.17,
      "text": "With the knee, the tick, and the ring on the thigh, I can't rule out Lyme disease."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.05,
      "end_seconds": 262.76,
      "duration_seconds": 1.71,
      "text": "Lyme? ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.64,
      "end_seconds": 281.15,
      "duration_seconds": 14.51,
      "text": "It's an infection from ticks. I'm not going to guess today. I'd like to see you again in a week to see how it's behaving."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 284.31,
      "end_seconds": 288.19,
      "duration_seconds": 3.88,
      "text": "A week. I'll drive him. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.16,
      "end_seconds": 299.78,
      "duration_seconds": 7.62,
      "text": "If you get a fever or the knee gets worse before then, ring us. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.08,
      "end_seconds": 305.99,
      "duration_seconds": 1.91,
      "text": "Okay. ~"
    }
  ]
}
