{
  "schema_version": "1.0",
  "encounter_id": "00903",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 2.76,
      "end_seconds": 16.76,
      "duration_seconds": 14.0,
      "text": "I don't know what happened. I was in the shopping centre and then I was on the floor and people were standing over me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.33,
      "end_seconds": 30.79,
      "duration_seconds": 10.46,
      "text": "That must have been frightening. I'm glad you're here. What's the last thing you remember before it happened?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.81,
      "end_seconds": 43.54,
      "duration_seconds": 9.73,
      "text": "I was walking, and I felt a bit hot, and my vision went sort of grey."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.93,
      "end_seconds": 52.13,
      "duration_seconds": 4.2,
      "text": "And the next thing you remember? ~"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.38,
      "end_seconds": 61.86,
      "duration_seconds": 5.48,
      "text": "A lady holding my hand. And the ambulance people. ~"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 65.64,
      "end_seconds": 74.64,
      "duration_seconds": 9.0,
      "text": "Doctor, the ambulance crew said he was out for about a minute, and a bystander saw no shaking."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.06,
      "end_seconds": 84.58,
      "duration_seconds": 6.52,
      "text": "Thank you. Did you bite your tongue or lose control of your bladder?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.54,
      "end_seconds": 90.2,
      "duration_seconds": 2.66,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.21,
      "end_seconds": 98.18,
      "duration_seconds": 4.97,
      "text": "Did you have chest pain, or a racing heart before?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.1,
      "end_seconds": 105.57,
      "duration_seconds": 4.47,
      "text": "No chest pain. My heart wasn't racing."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.63,
      "end_seconds": 113.45,
      "duration_seconds": 3.82,
      "text": "Have you eaten today? ~"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.51,
      "end_seconds": 126.33,
      "duration_seconds": 8.82,
      "text": "Not really. A coffee this morning, that's all. I was in a rush. ~"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.95,
      "end_seconds": 133.78,
      "duration_seconds": 3.83,
      "text": "And have you fainted before? ~"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.36,
      "end_seconds": 141.75,
      "duration_seconds": 4.39,
      "text": "Never. This is the first time. ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.91,
      "end_seconds": 147.82,
      "duration_seconds": 2.91,
      "text": "Do you take any tablets?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.99,
      "end_seconds": 161.24,
      "duration_seconds": 9.25,
      "text": "Tamsulosin in the evenings, I can't remember the strength. And a baby aspirin, 75 mg, in the morning."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.69,
      "end_seconds": 168.64,
      "duration_seconds": 3.95,
      "text": "Do you have any medical problems?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.01,
      "end_seconds": 176.33,
      "duration_seconds": 3.32,
      "text": "An enlarged prostate. That's it."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 179.4,
      "end_seconds": 192.79,
      "duration_seconds": 13.39,
      "text": "Doctor, I've done his observations on arrival. Pulse 62, blood pressure 108 over 64 sitting, temperature 36.4, oxygen 98 percent, breathing 16."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.58,
      "end_seconds": 203.78,
      "duration_seconds": 7.2,
      "text": "Thank you. Let me check it standing as well, if you're steady. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.37,
      "end_seconds": 226.24,
      "duration_seconds": 1.87,
      "text": "I'll try."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.56,
      "end_seconds": 236.71,
      "duration_seconds": 7.15,
      "text": "Standing blood pressure is 92 over 58, and you feel light-headed? ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.14,
      "end_seconds": 243.0,
      "duration_seconds": 2.86,
      "text": "Yes. A little, yes. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.96,
      "end_seconds": 255.43,
      "duration_seconds": 9.47,
      "text": "That drop explains it. I think you fainted because your pressure dropped on standing, with not eating, and the tamsulosin."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.78,
      "end_seconds": 261.54,
      "duration_seconds": 2.76,
      "text": "Is it serious? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.82,
      "end_seconds": 276.68,
      "duration_seconds": 11.86,
      "text": "Usually not, but I want to be sure about your heart, so I'll record a heart tracing now and take blood."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.73,
      "end_seconds": 281.26,
      "duration_seconds": 1.53,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 285.45,
      "end_seconds": 289.88,
      "duration_seconds": 4.43,
      "text": "I'll take you through to the bay. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.31,
      "end_seconds": 300.1,
      "duration_seconds": 6.79,
      "text": "Please drink fluids and have something to eat before you leave."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.06,
      "end_seconds": 306.0,
      "duration_seconds": 2.94,
      "text": "I will. Thank you. ~"
    }
  ]
}
