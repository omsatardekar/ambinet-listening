{
  "schema_version": "1.0",
  "encounter_id": "00635",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 0.68,
      "end_seconds": 15.08,
      "duration_seconds": 14.4,
      "text": "Morning Callum, come in. I've got your GP's letter here, and I remember you saying last time that the back was easing a little. Is that still the story? ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.74,
      "end_seconds": 28.31,
      "duration_seconds": 11.57,
      "text": "Sort of. It's odd, really. My back pain gets better the more I do, which my mum says is the wrong way round."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.2,
      "end_seconds": 39.46,
      "duration_seconds": 8.26,
      "text": "Not wrong at all, it's actually a clue. Remind me how long it's been going on?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.7,
      "end_seconds": 49.45,
      "duration_seconds": 7.75,
      "text": "Let me think. It started gradually, around when we moved flat, so about eight months now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.86,
      "end_seconds": 55.79,
      "duration_seconds": 3.93,
      "text": "And where do you feel it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.79,
      "end_seconds": 65.51,
      "duration_seconds": 8.72,
      "text": "Low down, right across the bottom of my back. Sometimes it shoots into my right buttock."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.33,
      "end_seconds": 71.77,
      "duration_seconds": 5.44,
      "text": "What's it like first thing in the morning?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.48,
      "end_seconds": 83.68,
      "duration_seconds": 11.2,
      "text": "Awful, I'm stiff as a board. It takes me a good hour to loosen up and I can barely get my socks on."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.91,
      "end_seconds": 88.76,
      "duration_seconds": 3.85,
      "text": "Does it ever wake you at night?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.1,
      "end_seconds": 99.94,
      "duration_seconds": 9.84,
      "text": "Yeah, I get night pain, usually around four. I have to get up and shuffle about the kitchen."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.78,
      "end_seconds": 108.89,
      "duration_seconds": 7.11,
      "text": "And if you've been sitting a long while, say at work? ~"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.93,
      "end_seconds": 121.02,
      "duration_seconds": 11.09,
      "text": "Worse. Sitting is the enemy. But a swim or a bike ride and it's far better, so exercise helps it."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.21,
      "end_seconds": 131.18,
      "duration_seconds": 8.97,
      "text": "That pattern matters. Let me ask about some other things. Any red or painful eyes?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.85,
      "end_seconds": 136.09,
      "duration_seconds": 3.24,
      "text": "No, my eyes have been fine."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.91,
      "end_seconds": 143.81,
      "duration_seconds": 5.9,
      "text": "Any diarrhoea or blood when you go to the toilet?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.3,
      "end_seconds": 148.0,
      "duration_seconds": 2.7,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.14,
      "end_seconds": 153.88,
      "duration_seconds": 3.74,
      "text": "Any numbness or weakness in your legs?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.79,
      "end_seconds": 160.68,
      "duration_seconds": 5.89,
      "text": "No numbness, my legs work fine. It's all just the back."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.63,
      "end_seconds": 166.71,
      "duration_seconds": 5.08,
      "text": "Good. Any allergies to medicines that I should know about?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.12,
      "end_seconds": 172.77,
      "duration_seconds": 4.65,
      "text": "No, no allergies that I know of."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.55,
      "end_seconds": 179.93,
      "duration_seconds": 4.38,
      "text": "Good. Now your background. Are you well otherwise?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.84,
      "end_seconds": 189.91,
      "duration_seconds": 8.07,
      "text": "I get skin trouble, psoriasis, on my scalp and my elbows. Since I was about nineteen."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.96,
      "end_seconds": 194.8,
      "duration_seconds": 3.84,
      "text": "Right, that's worth knowing. Anything else?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.67,
      "end_seconds": 201.26,
      "duration_seconds": 3.59,
      "text": "Migraines now and then, nothing dramatic."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.0,
      "end_seconds": 207.01,
      "duration_seconds": 3.01,
      "text": "Any operations in the past?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.36,
      "end_seconds": 214.2,
      "duration_seconds": 5.84,
      "text": "I had my appendix out when I was fifteen. That's all."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.26,
      "end_seconds": 220.79,
      "duration_seconds": 5.53,
      "text": "And does anyone in the family have back problems?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.46,
      "end_seconds": 234.76,
      "duration_seconds": 11.3,
      "text": "My dad does. He has ankylosing spondylitis, he's had it for years. It's why I came in, to be honest."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.83,
      "end_seconds": 238.76,
      "duration_seconds": 2.93,
      "text": "That's helpful. Do you smoke?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.62,
      "end_seconds": 245.09,
      "duration_seconds": 4.47,
      "text": "About ten cigarettes a day, I know, I know."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.85,
      "end_seconds": 250.1,
      "duration_seconds": 3.25,
      "text": "Noted. And what about alcohol?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.6,
      "end_seconds": 257.82,
      "duration_seconds": 6.22,
      "text": "I only drink a couple of pints of beer on a Saturday."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.41,
      "end_seconds": 263.56,
      "duration_seconds": 3.15,
      "text": "What do you do for work?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.92,
      "end_seconds": 272.29,
      "duration_seconds": 7.37,
      "text": "I'm a delivery driver, so loads of sitting. That's probably why it's worse some weeks."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.98,
      "end_seconds": 276.7,
      "duration_seconds": 3.72,
      "text": "And you mentioned swimming. How often?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.75,
      "end_seconds": 285.67,
      "duration_seconds": 7.92,
      "text": "I swim on Tuesdays and Thursdays before work. It's the best bit of my week."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.46,
      "end_seconds": 316.25,
      "duration_seconds": 13.79,
      "text": "Lovely. Let's check you over. Your pulse is 66, blood pressure 124 over 78, temperature 36.7, oxygen 99 percent, breathing 14 a minute, and weight 78 kilos."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.71,
      "end_seconds": 321.42,
      "duration_seconds": 3.71,
      "text": "Is that all fine? ~"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.31,
      "end_seconds": 337.11,
      "duration_seconds": 6.8,
      "text": "All normal. Can you bend forward and try to touch your toes for me?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.26,
      "end_seconds": 344.84,
      "duration_seconds": 5.58,
      "text": "That's as far as I go. It pulls right here. ~"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.39,
      "end_seconds": 355.49,
      "duration_seconds": 9.1,
      "text": "Yes, I can see bending forwards is reduced, and it's tender when I press over the right sacroiliac joint."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 356.83,
      "end_seconds": 360.01,
      "duration_seconds": 3.18,
      "text": "Ouch, yes, that's the spot. ~"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.61,
      "end_seconds": 373.2,
      "duration_seconds": 6.59,
      "text": "Now take a deep breath in. Your chest expands fully, which is good."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 374.96,
      "end_seconds": 378.77,
      "duration_seconds": 3.81,
      "text": "Is that good for the back? ~"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.3,
      "end_seconds": 389.65,
      "duration_seconds": 9.35,
      "text": "It tells me the ribs and spine up top aren't stuck. I can also see patches of psoriasis on your elbows."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 391.83,
      "end_seconds": 395.55,
      "duration_seconds": 3.72,
      "text": "Yeah, they come and go. ~"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 396.57,
      "end_seconds": 401.6,
      "duration_seconds": 5.03,
      "text": "Any trouble with your breathing or chest at all?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 402.99,
      "end_seconds": 407.07,
      "duration_seconds": 4.08,
      "text": "No, nothing, my chest is fine."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 408.69,
      "end_seconds": 426.14,
      "duration_seconds": 17.45,
      "text": "Good. Now, I can't rule out an inflammatory back condition at this stage, which would fit with the morning stiffness and your dad's history. We need tests to separate it from ordinary mechanical pain."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 427.44,
      "end_seconds": 431.86,
      "duration_seconds": 4.42,
      "text": "So it could be what dad has? ~"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 434.47,
      "end_seconds": 448.78,
      "duration_seconds": 14.31,
      "text": "It could, but it's early. I'd like to arrange an MRI of your sacroiliac joints, and we'll do blood tests including a marker called HLA-B27."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 450.68,
      "end_seconds": 453.93,
      "duration_seconds": 3.25,
      "text": "Is the MRI noisy? ~"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 455.13,
      "end_seconds": 462.14,
      "duration_seconds": 7.01,
      "text": "Very, you get earplugs. I'd also like to get an X-ray of your pelvis."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 463.33,
      "end_seconds": 469.64,
      "duration_seconds": 6.31,
      "text": "Fine by me. And will you give me something for it? ~"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 471.0,
      "end_seconds": 477.37,
      "duration_seconds": 6.37,
      "text": "Yes, let's start naproxen 500 mg twice a day with food."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 479.47,
      "end_seconds": 483.8,
      "duration_seconds": 4.33,
      "text": "Any side effects I should watch for? ~"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 485.13,
      "end_seconds": 493.4,
      "duration_seconds": 8.27,
      "text": "Stomach upset mainly, so I'll also start omeprazole 20 mg once a day to protect your stomach."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 495.06,
      "end_seconds": 500.14,
      "duration_seconds": 5.08,
      "text": "Okay. And the swimming, I should keep going? ~"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 502.0,
      "end_seconds": 506.6,
      "duration_seconds": 4.6,
      "text": "Absolutely, keep swimming, it's part of the treatment."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 507.37,
      "end_seconds": 510.24,
      "duration_seconds": 2.87,
      "text": "Brilliant, that's a relief. ~"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 511.5,
      "end_seconds": 519.11,
      "duration_seconds": 7.61,
      "text": "I'd like to see you again in six weeks to go through the results."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 521.88,
      "end_seconds": 524.99,
      "duration_seconds": 3.11,
      "text": "Six weeks, great. Thanks, doctor. ~"
    }
  ]
}
