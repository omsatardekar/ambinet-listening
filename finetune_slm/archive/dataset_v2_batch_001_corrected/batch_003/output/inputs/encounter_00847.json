{
  "schema_version": "1.0",
  "encounter_id": "00847",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.53,
      "end_seconds": 7.47,
      "duration_seconds": 5.94,
      "text": "Hi. I'm a runner. Skipped beats. Sometimes. It worries me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.03,
      "end_seconds": 13.42,
      "duration_seconds": 3.39,
      "text": "How often do you notice them?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.02,
      "end_seconds": 21.72,
      "duration_seconds": 6.7,
      "text": "A few times a month. During recovery, after a run. Never during."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.26,
      "end_seconds": 26.67,
      "duration_seconds": 3.41,
      "text": "What does it feel like?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.16,
      "end_seconds": 33.98,
      "duration_seconds": 4.82,
      "text": "A thump. Then a pause. Then a big beat."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.62,
      "end_seconds": 40.97,
      "duration_seconds": 4.35,
      "text": "Any dizziness, chest pain or fainting with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.66,
      "end_seconds": 45.41,
      "duration_seconds": 2.75,
      "text": "No. None of those."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.84,
      "end_seconds": 50.69,
      "duration_seconds": 3.85,
      "text": "How much do you run? ~"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.9,
      "end_seconds": 59.14,
      "duration_seconds": 5.24,
      "text": "Forty miles a week. Training for a marathon. ~"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.67,
      "end_seconds": 67.49,
      "duration_seconds": 5.82,
      "text": "Any family history of heart problems or sudden death? ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.11,
      "end_seconds": 74.04,
      "duration_seconds": 3.93,
      "text": "No. Not that I know of. ~"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.24,
      "end_seconds": 77.96,
      "duration_seconds": 2.72,
      "text": "What do you take?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.73,
      "end_seconds": 94.08,
      "duration_seconds": 13.35,
      "text": "A tablet from the sports clinic, a small orange one, for iron, I think. I can't remember the name. I take it most days. Not every day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.6,
      "end_seconds": 105.08,
      "duration_seconds": 8.48,
      "text": "So it's meant to be daily, you take it most days, and you can't name it. Any allergies?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.75,
      "end_seconds": 107.7,
      "duration_seconds": 0.95,
      "text": "None."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.14,
      "end_seconds": 111.42,
      "duration_seconds": 2.28,
      "text": "Any other health history?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.13,
      "end_seconds": 119.19,
      "duration_seconds": 5.06,
      "text": "Asthma, as a child. And an ankle fracture, years ago."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.4,
      "end_seconds": 127.41,
      "duration_seconds": 5.01,
      "text": "Do you use caffeine, energy gels, or supplements? ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.27,
      "end_seconds": 135.34,
      "duration_seconds": 5.07,
      "text": "Three coffees. And gels on long runs. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.27,
      "end_seconds": 140.75,
      "duration_seconds": 3.48,
      "text": "Let me check your numbers. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.8,
      "end_seconds": 144.61,
      "duration_seconds": 1.81,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.14,
      "end_seconds": 165.94,
      "duration_seconds": 6.8,
      "text": "Resting pulse 48, blood pressure 108 over 66, temperature 36.5, oxygen 99 percent."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.74,
      "end_seconds": 172.57,
      "duration_seconds": 3.83,
      "text": "My pulse is always low. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.87,
      "end_seconds": 199.81,
      "duration_seconds": 7.94,
      "text": "It's what I'd expect for a distance runner. Let me listen to your heart."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.73,
      "end_seconds": 203.33,
      "duration_seconds": 1.6,
      "text": "Sure. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.52,
      "end_seconds": 211.79,
      "duration_seconds": 6.27,
      "text": "Slow and regular, with the odd extra beat, and no murmur."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.48,
      "end_seconds": 217.98,
      "duration_seconds": 3.5,
      "text": "What does that mean? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.48,
      "end_seconds": 232.0,
      "duration_seconds": 11.52,
      "text": "The skipped beats you describe are most likely ectopic beats, extra beats that are common in athletes and usually harmless."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.61,
      "end_seconds": 237.76,
      "duration_seconds": 3.15,
      "text": "Should I stop running? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.68,
      "end_seconds": 250.49,
      "duration_seconds": 10.81,
      "text": "No. I'd like to confirm it, so I'd like to arrange an ECG today, and a 24-hour heart monitor."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.87,
      "end_seconds": 253.24,
      "duration_seconds": 1.37,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.98,
      "end_seconds": 268.84,
      "duration_seconds": 12.86,
      "text": "Cut back on the coffee a bit, drink enough, and keep your salts up. Take the iron tablet with vitamin C, not with coffee."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.52,
      "end_seconds": 272.19,
      "duration_seconds": 1.67,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.55,
      "end_seconds": 286.7,
      "duration_seconds": 12.15,
      "text": "If you ever get chest pain, faint, or the palpitations last more than a few minutes, or happen during a run, stop and see us."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.99,
      "end_seconds": 291.91,
      "duration_seconds": 1.92,
      "text": "I will. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.51,
      "end_seconds": 300.97,
      "duration_seconds": 7.46,
      "text": "I'd like to see you again in three weeks, with the results."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.14,
      "end_seconds": 306.02,
      "duration_seconds": 2.88,
      "text": "Three weeks. Thanks. ~"
    }
  ]
}
