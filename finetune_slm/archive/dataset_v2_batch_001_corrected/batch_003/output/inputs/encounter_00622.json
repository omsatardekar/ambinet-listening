{
  "schema_version": "1.0",
  "encounter_id": "00622",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.64,
      "end_seconds": 11.09,
      "duration_seconds": 10.45,
      "text": "Um, hello. I think I might have broken my ankle? I came down the stairs wrong about an hour ago."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 12.08,
      "end_seconds": 20.04,
      "duration_seconds": 7.96,
      "text": "Oh dear, let's have a look at it in a second. Tell me what happened. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.06,
      "end_seconds": 33.86,
      "duration_seconds": 12.8,
      "text": "I missed the last two steps, I think, and I landed on the side of my foot. It sort of folded under me."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.0,
      "end_seconds": 40.91,
      "duration_seconds": 4.91,
      "text": "Did you hear or feel anything crack when it happened?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.36,
      "end_seconds": 50.54,
      "duration_seconds": 8.18,
      "text": "I felt something, a sort of pop. I'm not sure if I heard it. Is that bad?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.86,
      "end_seconds": 62.65,
      "duration_seconds": 9.79,
      "text": "It can mean different things, so don't read too much into it. Can you put weight on it at all?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.48,
      "end_seconds": 75.34,
      "duration_seconds": 10.86,
      "text": "Not really. I tried to hobble and it hurt too much. I'd say it's severe when I stand."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.06,
      "end_seconds": 80.17,
      "duration_seconds": 3.11,
      "text": "Where exactly is the pain?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.58,
      "end_seconds": 92.16,
      "duration_seconds": 9.58,
      "text": "Outside of the ankle, down towards the little toe side. And it's swollen, it's gone puffy already."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.22,
      "end_seconds": 97.93,
      "duration_seconds": 4.71,
      "text": "Anything else? Numbness, tingling, anything odd in the foot?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.71,
      "end_seconds": 108.39,
      "duration_seconds": 9.68,
      "text": "My toes have been tingling a bit, but I can't say when that started. Maybe in the car, maybe before."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.17,
      "end_seconds": 117.58,
      "duration_seconds": 7.41,
      "text": "Okay, I'll test that properly in a moment. Any pain in your knee?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.9,
      "end_seconds": 123.51,
      "duration_seconds": 4.61,
      "text": "No, my knee's fine. Foot's just a bit stiff."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.52,
      "end_seconds": 131.58,
      "duration_seconds": 7.06,
      "text": "Did you bang your head or hurt anywhere else when you fell?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.22,
      "end_seconds": 140.66,
      "duration_seconds": 6.44,
      "text": "No, I only fell the last bit. Just the ankle."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.51,
      "end_seconds": 148.15,
      "duration_seconds": 4.64,
      "text": "Good. Have you hurt this ankle before?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.42,
      "end_seconds": 157.29,
      "duration_seconds": 6.87,
      "text": "A few years ago I twisted it playing netball, but nothing like this."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.19,
      "end_seconds": 165.3,
      "duration_seconds": 6.11,
      "text": "Okay. Let me check your pulse and so on first. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.76,
      "end_seconds": 169.44,
      "duration_seconds": 1.68,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.39,
      "end_seconds": 185.63,
      "duration_seconds": 5.24,
      "text": "Pulse 84, blood pressure 124 over 76, temperature 36.7."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.83,
      "end_seconds": 194.16,
      "duration_seconds": 6.33,
      "text": "Is that all right? I feel a bit shaky. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.98,
      "end_seconds": 208.26,
      "duration_seconds": 13.28,
      "text": "Perfectly fine, the shakiness is just the shock. Now I'm going to press along the bone gently, and tell me when it hurts. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.52,
      "end_seconds": 212.65,
      "duration_seconds": 3.13,
      "text": "Ow, right there! ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.5,
      "end_seconds": 241.54,
      "duration_seconds": 12.04,
      "text": "That's tender over the outer ankle bone and there's swelling around it. Your toes are warm and pink and you can feel me touching them."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.91,
      "end_seconds": 246.97,
      "duration_seconds": 3.06,
      "text": "So is it broken? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.95,
      "end_seconds": 262.04,
      "duration_seconds": 13.09,
      "text": "It could be a fracture, or a bad sprain, and I can't tell which by looking. That's why I'd like an X-ray of the ankle now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.07,
      "end_seconds": 267.34,
      "duration_seconds": 4.27,
      "text": "Oh. Right. How long will that take? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.27,
      "end_seconds": 276.1,
      "duration_seconds": 6.83,
      "text": "We'll take you straight there. Meanwhile keep the foot raised on this stool."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.96,
      "end_seconds": 285.75,
      "duration_seconds": 6.79,
      "text": "Raised. Okay. Can I walk on it to the toilet? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.54,
      "end_seconds": 297.45,
      "duration_seconds": 9.91,
      "text": "Please don't put any weight through it at all. Ask a nurse for a wheelchair if you need to go."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.93,
      "end_seconds": 306.02,
      "duration_seconds": 6.09,
      "text": "No weight. Right. And what happens after the X-ray? ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.32,
      "end_seconds": 314.22,
      "duration_seconds": 6.9,
      "text": "I'll come and tell you what it shows, and we'll plan from there. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.8,
      "end_seconds": 321.43,
      "duration_seconds": 4.63,
      "text": "Thank you. Sorry, I'm very nervous. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.53,
      "end_seconds": 329.52,
      "duration_seconds": 5.99,
      "text": "Perfectly understandable. You've done the right thing coming in. ~"
    }
  ]
}
