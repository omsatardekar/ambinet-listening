{
  "schema_version": "1.0",
  "encounter_id": "00756",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 3.04,
      "end_seconds": 14.94,
      "duration_seconds": 11.9,
      "text": "Um, hi doctor. I've been checking my blood pressure at home, because my mum said I should, and it's been high. Is that something?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.58,
      "end_seconds": 24.68,
      "duration_seconds": 6.1,
      "text": "It certainly could be. What have you been seeing? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.78,
      "end_seconds": 37.46,
      "duration_seconds": 8.68,
      "text": "Consistently high, in the morning and evening, for two weeks. Higher than the machine says is normal, anyway."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.43,
      "end_seconds": 43.84,
      "duration_seconds": 3.41,
      "text": "And how are you feeling?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.58,
      "end_seconds": 51.37,
      "duration_seconds": 4.79,
      "text": "Well, sometimes a bit of a headache. Otherwise fine."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.35,
      "end_seconds": 61.37,
      "duration_seconds": 7.02,
      "text": "Do you have any family history of blood pressure or heart problems?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.71,
      "end_seconds": 71.13,
      "duration_seconds": 6.42,
      "text": "Mum has high blood pressure. And my granddad had a heart attack."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.31,
      "end_seconds": 80.76,
      "duration_seconds": 6.45,
      "text": "Any allergies I should know about before we go on?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.64,
      "end_seconds": 91.54,
      "duration_seconds": 7.9,
      "text": "Latex. I get a rash when I wear the gloves at work, on my hands."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.74,
      "end_seconds": 96.81,
      "duration_seconds": 2.07,
      "text": "Noted. Any operations?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.58,
      "end_seconds": 105.46,
      "duration_seconds": 4.88,
      "text": "I had my appendix out, when I was fifteen."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.54,
      "end_seconds": 116.06,
      "duration_seconds": 7.52,
      "text": "Do you drink alcohol, or have a lot of caffeine or salt in your diet?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.15,
      "end_seconds": 126.26,
      "duration_seconds": 6.11,
      "text": "A few drinks at weekends, I suppose. I like crisps, though."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.05,
      "end_seconds": 131.24,
      "duration_seconds": 2.19,
      "text": "Any other medical conditions?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.49,
      "end_seconds": 137.96,
      "duration_seconds": 3.47,
      "text": "No, only the occasional migraine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.54,
      "end_seconds": 149.68,
      "duration_seconds": 8.14,
      "text": "Is the home machine one that goes on your upper arm, and is it validated? ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.56,
      "end_seconds": 161.47,
      "duration_seconds": 7.91,
      "text": "Upper arm, yes. I bought it from a pharmacy. It was recommended. ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.96,
      "end_seconds": 173.25,
      "duration_seconds": 8.29,
      "text": "Good. I'd like to check it, can you bring it along sometime? ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.36,
      "end_seconds": 179.69,
      "duration_seconds": 3.33,
      "text": "I can bring it Monday. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.29,
      "end_seconds": 195.59,
      "duration_seconds": 12.3,
      "text": "Right. High readings at home are often higher than in the clinic or lower, depending, so I won't diagnose from them alone. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.46,
      "end_seconds": 204.85,
      "duration_seconds": 5.39,
      "text": "That makes sense. I'm a bit worried though. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.4,
      "end_seconds": 218.31,
      "duration_seconds": 9.91,
      "text": "It's good that you checked. I'd say this is probably high blood pressure, but I want it confirmed properly."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.06,
      "end_seconds": 222.85,
      "duration_seconds": 1.79,
      "text": "How? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.67,
      "end_seconds": 237.61,
      "duration_seconds": 11.94,
      "text": "I'd like to arrange a 24-hour blood pressure monitor, which you wear on your arm for a day, and it takes readings every half hour."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.79,
      "end_seconds": 246.32,
      "duration_seconds": 4.53,
      "text": "Like a cuff that squeezes by itself? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.19,
      "end_seconds": 253.6,
      "duration_seconds": 3.41,
      "text": "Exactly. It's the gold standard. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.73,
      "end_seconds": 261.05,
      "duration_seconds": 4.32,
      "text": "Okay. Do I need tablets? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.38,
      "end_seconds": 278.24,
      "duration_seconds": 13.86,
      "text": "Not until we have the results. Many people with mildly raised readings start with lifestyle changes, so cut down on salt, crisps, and alcohol, and be active."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.32,
      "end_seconds": 285.6,
      "duration_seconds": 3.28,
      "text": "I can do the crisps. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.06,
      "end_seconds": 298.85,
      "duration_seconds": 9.79,
      "text": "And if you ever get severe headache with blurred vision, chest pain, or breathlessness, come in straight away."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.66,
      "end_seconds": 306.02,
      "duration_seconds": 3.36,
      "text": "I will. Thank you. ~"
    }
  ]
}
