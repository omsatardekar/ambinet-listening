{
  "schema_version": "1.0",
  "encounter_id": "00722",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.0,
      "end_seconds": 15.36,
      "duration_seconds": 14.36,
      "text": "Hiya. I've got a swollen gland in my neck, it's been three weeks, my mate Dean says it's glandular fever but he thinks everything's glandular fever."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.79,
      "end_seconds": 19.71,
      "duration_seconds": 1.92,
      "text": "Which side?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.01,
      "end_seconds": 32.93,
      "duration_seconds": 11.92,
      "text": "The left, under the jaw. Size of a grape. Hurts if I press it, which I do, constantly, in the mirror."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.49,
      "end_seconds": 38.12,
      "duration_seconds": 3.63,
      "text": "Anything before it came up?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.18,
      "end_seconds": 45.64,
      "duration_seconds": 6.46,
      "text": "A sore throat, about a week, then it settled. Nothing since."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.45,
      "end_seconds": 50.27,
      "duration_seconds": 3.82,
      "text": "Any earache or a blocked nose?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.37,
      "end_seconds": 63.13,
      "duration_seconds": 10.76,
      "text": "Earache on the left, on and off, and my nose is blocked half the time, but that's the hay fever."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.91,
      "end_seconds": 66.09,
      "duration_seconds": 2.18,
      "text": "Any night sweats?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.27,
      "end_seconds": 70.63,
      "duration_seconds": 2.36,
      "text": "No sweats, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.13,
      "end_seconds": 74.65,
      "duration_seconds": 1.52,
      "text": "Weight loss?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.75,
      "end_seconds": 81.17,
      "duration_seconds": 4.42,
      "text": "None, I'm the same as ever, sadly."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.22,
      "end_seconds": 84.65,
      "duration_seconds": 1.43,
      "text": "Fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.51,
      "end_seconds": 88.5,
      "duration_seconds": 1.99,
      "text": "No fever."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.37,
      "end_seconds": 92.37,
      "duration_seconds": 2.0,
      "text": "Any trouble swallowing?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.73,
      "end_seconds": 98.89,
      "duration_seconds": 4.16,
      "text": "No, I eat like a horse."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.67,
      "end_seconds": 101.85,
      "duration_seconds": 1.18,
      "text": "Hoarseness?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.47,
      "end_seconds": 111.21,
      "duration_seconds": 6.74,
      "text": "Nope, my voice is the same. Ask my sister, she'd tell you."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.98,
      "end_seconds": 115.29,
      "duration_seconds": 2.31,
      "text": "What are you on?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.17,
      "end_seconds": 127.31,
      "duration_seconds": 9.14,
      "text": "Cetirizine, 10 mg, once a day, for the hay fever. And omeprazole, 20 mg, in the morning."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.41,
      "end_seconds": 131.46,
      "duration_seconds": 3.05,
      "text": "Any allergies to medicines?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.33,
      "end_seconds": 139.29,
      "duration_seconds": 5.96,
      "text": "Penicillin. I came out in a rash when I was about ten."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.34,
      "end_seconds": 144.15,
      "duration_seconds": 2.81,
      "text": "Anything else in your history?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.52,
      "end_seconds": 152.5,
      "duration_seconds": 5.98,
      "text": "The reflux, the hay fever, and eczema on my hands."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.51,
      "end_seconds": 155.56,
      "duration_seconds": 1.05,
      "text": "Operations?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.76,
      "end_seconds": 161.99,
      "duration_seconds": 4.23,
      "text": "Tonsils out when I was twelve."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.57,
      "end_seconds": 166.83,
      "duration_seconds": 2.26,
      "text": "Illnesses in the family?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.02,
      "end_seconds": 172.55,
      "duration_seconds": 3.53,
      "text": "Mum's got a thyroid problem."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.28,
      "end_seconds": 177.34,
      "duration_seconds": 2.06,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.22,
      "end_seconds": 182.85,
      "duration_seconds": 4.63,
      "text": "About five a day, I know, I know."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.09,
      "end_seconds": 186.3,
      "duration_seconds": 1.21,
      "text": "Drink?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.18,
      "end_seconds": 191.86,
      "duration_seconds": 4.68,
      "text": "Couple of glasses of wine at the weekend."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.16,
      "end_seconds": 195.84,
      "duration_seconds": 2.68,
      "text": "What do you do?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.39,
      "end_seconds": 203.59,
      "duration_seconds": 5.2,
      "text": "I'm a hairdresser, so I'm in people's faces all day."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.31,
      "end_seconds": 230.13,
      "duration_seconds": 9.82,
      "text": "Let me examine you. Pulse 68, blood pressure 118 over 72, temperature 36.7, oxygen 99 percent, breathing 14, weight 64 kilos."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.9,
      "end_seconds": 233.28,
      "duration_seconds": 2.38,
      "text": "All normal then? ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.05,
      "end_seconds": 258.85,
      "duration_seconds": 13.8,
      "text": "All normal. Chin up for me. I can feel a single firm lymph node under the left jaw, about two centimetres, tender and mobile."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.35,
      "end_seconds": 264.27,
      "duration_seconds": 2.92,
      "text": "That's the one. ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.88,
      "end_seconds": 278.79,
      "duration_seconds": 11.91,
      "text": "Your throat looks a little red but there's no swelling of the tonsils, and I can't feel any other lumps in the neck."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.42,
      "end_seconds": 284.98,
      "duration_seconds": 3.56,
      "text": "So it's not serious? ~"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.04,
      "end_seconds": 292.91,
      "duration_seconds": 5.87,
      "text": "Any trouble breathing, a cough, anything on the chest?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.95,
      "end_seconds": 296.29,
      "duration_seconds": 2.34,
      "text": "No, nothing, chest's fine."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.12,
      "end_seconds": 308.11,
      "duration_seconds": 9.99,
      "text": "This looks like a reactive lymph node after the throat infection. They can stay up for weeks."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.13,
      "end_seconds": 313.53,
      "duration_seconds": 3.4,
      "text": "Should I be worried? ~"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.23,
      "end_seconds": 329.95,
      "duration_seconds": 13.72,
      "text": "I don't think so, but I'd like to arrange blood tests including a full blood count, and an ultrasound scan of the neck."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.74,
      "end_seconds": 336.15,
      "duration_seconds": 4.41,
      "text": "And what about the chest thing? ~"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.46,
      "end_seconds": 344.87,
      "duration_seconds": 6.41,
      "text": "I'd like to do a chest X-ray too, as you smoke."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.98,
      "end_seconds": 349.13,
      "duration_seconds": 2.15,
      "text": "Fair enough. ~"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.05,
      "end_seconds": 361.22,
      "duration_seconds": 9.17,
      "text": "I'd like to see you again in three weeks to see whether it's gone down."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 363.65,
      "end_seconds": 366.91,
      "duration_seconds": 3.26,
      "text": "Three weeks. Brilliant, ta. ~"
    }
  ]
}
