{
  "schema_version": "1.0",
  "encounter_id": "00662",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 0.34,
      "end_seconds": 10.0,
      "duration_seconds": 9.66,
      "text": "We were told to come back today. The midwife said the baby was a bit yellow on Tuesday."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.49,
      "end_seconds": 19.29,
      "duration_seconds": 7.8,
      "text": "Yes, I've got the note. Come in, sit down. I'm Dr Shah. And you are? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 20.72,
      "end_seconds": 26.22,
      "duration_seconds": 5.5,
      "text": "Elena, I'm Sofia's mum. She's five days old now. ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 28.26,
      "end_seconds": 36.85,
      "duration_seconds": 8.59,
      "text": "Hello, I'm Marsha, the healthcare assistant. I did her bilirubin reading just before you came in."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.77,
      "end_seconds": 47.03,
      "duration_seconds": 7.26,
      "text": "Thank you, Marsha. Elena, tell me how she's been since the midwife saw her. ~"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 48.51,
      "end_seconds": 61.24,
      "duration_seconds": 12.73,
      "text": "She's been sleepy, very sleepy, I have to wake her for feeds. And she's not finishing them, she falls asleep on the breast."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.46,
      "end_seconds": 68.28,
      "duration_seconds": 5.82,
      "text": "How many feeds is she taking in a day, roughly?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 70.38,
      "end_seconds": 76.5,
      "duration_seconds": 6.12,
      "text": "Six or seven, but short ones. I'm not sure it's enough."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.99,
      "end_seconds": 80.94,
      "duration_seconds": 1.95,
      "text": "Waaah. ~"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.83,
      "end_seconds": 91.44,
      "duration_seconds": 7.61,
      "text": "She's telling us she's hungry. When did you first notice the yellow colour?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 93.99,
      "end_seconds": 105.3,
      "duration_seconds": 11.31,
      "text": "I couldn't tell you exactly. Maybe Monday, maybe Tuesday morning, I honestly don't know. I'm not good at remembering with so little sleep."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.22,
      "end_seconds": 113.56,
      "duration_seconds": 7.34,
      "text": "That's absolutely fine. Are her nappies wet and what colour are her poos?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 114.28,
      "end_seconds": 125.28,
      "duration_seconds": 11.0,
      "text": "Wet, plenty. The poos are yellow-green, not pale. I looked at them in the light, like they said."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.94,
      "end_seconds": 132.27,
      "duration_seconds": 5.33,
      "text": "Good. Has she had any fevers or felt hot?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 133.87,
      "end_seconds": 140.69,
      "duration_seconds": 6.82,
      "text": "No, nothing hot. She's actually a bit cool, with her little hands."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.66,
      "end_seconds": 146.74,
      "duration_seconds": 5.08,
      "text": "How was the birth? Was she born on time?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 147.81,
      "end_seconds": 154.1,
      "duration_seconds": 6.29,
      "text": "Thirty-seven weeks, so a bit early, but she was a good weight."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 155.75,
      "end_seconds": 161.83,
      "duration_seconds": 6.08,
      "text": "Doctor, the reading I got was 210. I did it twice."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.76,
      "end_seconds": 182.99,
      "duration_seconds": 4.23,
      "text": "Thanks, Marsha. Let me weigh and measure her."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.83,
      "end_seconds": 193.79,
      "duration_seconds": 7.96,
      "text": "Heart rate 142, temperature 36.9, breathing rate 38, oxygen 98 percent, weight 3.1 kilos."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 195.52,
      "end_seconds": 198.55,
      "duration_seconds": 3.03,
      "text": "Is she losing weight? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.34,
      "end_seconds": 213.36,
      "duration_seconds": 12.02,
      "text": "She's a little under her birth weight, which is common at this stage, but I'd like to keep a close eye. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.33,
      "end_seconds": 217.27,
      "duration_seconds": 1.94,
      "text": "Waaah. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.74,
      "end_seconds": 224.61,
      "duration_seconds": 5.87,
      "text": "I'll examine her. Marsha, would you hold her head? ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 247.46,
      "end_seconds": 249.52,
      "duration_seconds": 2.06,
      "text": "Yes, doctor."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.59,
      "end_seconds": 263.0,
      "duration_seconds": 11.41,
      "text": "She's yellow down to her chest, her soft spot is flat and normal, and she's alert when she's awake, with good tone."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 264.18,
      "end_seconds": 268.37,
      "duration_seconds": 4.19,
      "text": "Is that bad, the yellow? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.38,
      "end_seconds": 285.52,
      "duration_seconds": 16.14,
      "text": "Many newborns get jaundice, and it's usually harmless. But at five days, with the sleepiness and the reading Marsha took, I want to check it with a blood test. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 286.43,
      "end_seconds": 290.86,
      "duration_seconds": 4.43,
      "text": "A blood test on a baby? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.62,
      "end_seconds": 306.89,
      "duration_seconds": 13.27,
      "text": "It's a heel prick, just a few drops. I'd like to send a bilirubin blood test today, and I'd like her feed volumes checked with the midwife."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 309.38,
      "end_seconds": 313.36,
      "duration_seconds": 3.98,
      "text": "I'll book the heel prick now. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 316.08,
      "end_seconds": 320.15,
      "duration_seconds": 4.07,
      "text": "What do I do for her, meantime? ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.97,
      "end_seconds": 340.19,
      "duration_seconds": 17.22,
      "text": "Feed her at least eight times a day, wake her if she sleeps more than three hours, and keep her in daylight, near a window, not in direct sun."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 342.55,
      "end_seconds": 347.54,
      "duration_seconds": 4.99,
      "text": "Okay. And if she gets more yellow? ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.46,
      "end_seconds": 359.63,
      "duration_seconds": 10.17,
      "text": "If she's very sleepy, won't feed, or her poos go pale, ring us straight away, any hour."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 361.03,
      "end_seconds": 363.4,
      "duration_seconds": 2.37,
      "text": "I will. ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.77,
      "end_seconds": 373.09,
      "duration_seconds": 8.32,
      "text": "And I'd like to see you both tomorrow, to review the result and her weight."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 375.34,
      "end_seconds": 378.02,
      "duration_seconds": 2.68,
      "text": "Tomorrow. Thank you, doctor. ~"
    }
  ]
}
