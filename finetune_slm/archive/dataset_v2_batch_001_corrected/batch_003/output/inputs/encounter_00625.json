{
  "schema_version": "1.0",
  "encounter_id": "00625",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.51,
      "end_seconds": 14.33,
      "duration_seconds": 13.82,
      "text": "Good morning, Doctor. I do apologise for taking up your time, but I have been left with sore ribs since a dreadful bout last week."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.44,
      "end_seconds": 24.44,
      "duration_seconds": 9.0,
      "text": "Morning. No need to apologise. Which side is it, and when exactly did it start?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.66,
      "end_seconds": 39.09,
      "duration_seconds": 12.43,
      "text": "The right side, low down towards the back. It began one week ago, quite suddenly, in the middle of a coughing fit."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.88,
      "end_seconds": 45.51,
      "duration_seconds": 3.63,
      "text": "Right. Does anything make it worse?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.29,
      "end_seconds": 57.72,
      "duration_seconds": 11.43,
      "text": "Yes, when I cough, and also a deep breath. Laughing is rather out of the question at the moment."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.26,
      "end_seconds": 65.74,
      "duration_seconds": 5.48,
      "text": "Is it a sharp pain or more of an ache?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.85,
      "end_seconds": 81.46,
      "duration_seconds": 14.61,
      "text": "Sharp, I would say, but only at those moments. In between it is a dull soreness. Moderate overall, though it does keep me awake if I roll onto that side."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.83,
      "end_seconds": 88.78,
      "duration_seconds": 4.95,
      "text": "Fair enough. Are you coughing up any blood?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.1,
      "end_seconds": 93.45,
      "duration_seconds": 3.35,
      "text": "No, nothing like that, thank goodness."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.97,
      "end_seconds": 102.69,
      "duration_seconds": 7.72,
      "text": "Good. And are you short of breath at rest, or going upstairs?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.89,
      "end_seconds": 113.61,
      "duration_seconds": 8.72,
      "text": "No, not at all. My breathing seems perfectly all right, it is only the pain that catches me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.05,
      "end_seconds": 119.09,
      "duration_seconds": 4.04,
      "text": "Have you taken anything for it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.54,
      "end_seconds": 133.56,
      "duration_seconds": 12.02,
      "text": "I haven't, I am afraid. I am not fond of tablets. I only take amlodipine, 5 mg every morning, and I have not changed that."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.95,
      "end_seconds": 142.76,
      "duration_seconds": 7.81,
      "text": "Fine, carry on with that. Any allergies I should write down before we go further?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.7,
      "end_seconds": 152.05,
      "duration_seconds": 7.35,
      "text": "No, none that I am aware of. I have never had a reaction to anything."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.45,
      "end_seconds": 158.45,
      "duration_seconds": 5.0,
      "text": "Good. Have you had any operations in the past?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.76,
      "end_seconds": 168.43,
      "duration_seconds": 8.67,
      "text": "Just the one. I had my appendix removed about twelve years ago, and it all went smoothly."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.73,
      "end_seconds": 176.45,
      "duration_seconds": 5.72,
      "text": "Thanks. And do you smoke, or have you ever?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.85,
      "end_seconds": 189.15,
      "duration_seconds": 10.3,
      "text": "I gave up smoking in my fifties. It was the best decision I ever made, if I may say so."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.1,
      "end_seconds": 197.83,
      "duration_seconds": 6.73,
      "text": "Well done. Right, I'll take a few readings so I have a baseline."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.75,
      "end_seconds": 221.83,
      "duration_seconds": 7.08,
      "text": "Your pulse is 76 beats per minute, and your oxygen saturation is 98 percent."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.36,
      "end_seconds": 226.51,
      "duration_seconds": 2.15,
      "text": "Is that satisfactory?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.29,
      "end_seconds": 236.59,
      "duration_seconds": 7.3,
      "text": "Perfectly. Temperature is 36.8 degrees Celsius too. So nothing there that worries me."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.28,
      "end_seconds": 246.18,
      "duration_seconds": 7.9,
      "text": "That is a relief. My daughter was convinced I had done something terrible to myself."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.79,
      "end_seconds": 264.61,
      "duration_seconds": 15.82,
      "text": "Let me lay out the options. We can wait and see, we can get a picture, or we can do both. I'd like to arrange a chest X-ray today."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.74,
      "end_seconds": 273.58,
      "duration_seconds": 6.84,
      "text": "Would that be necessary? I should not like to waste anyone's resources."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.53,
      "end_seconds": 287.29,
      "duration_seconds": 11.76,
      "text": "It's not a waste. After a hard cough, a picture settles the question, and then we can plan properly."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.25,
      "end_seconds": 296.97,
      "duration_seconds": 6.72,
      "text": "In that case, certainly. Where do I go for it?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.52,
      "end_seconds": 308.19,
      "duration_seconds": 8.67,
      "text": "Radiology is down the corridor on the left. Reception will give you a form, and it's usually quick."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.8,
      "end_seconds": 316.53,
      "duration_seconds": 6.73,
      "text": "Splendid. And in the meantime, is there anything I ought to be doing?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.29,
      "end_seconds": 329.79,
      "duration_seconds": 11.5,
      "text": "Yes. Hug a pillow against your side when you cough, and keep walking gently. Resting completely tends to make it stiffer."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.66,
      "end_seconds": 338.61,
      "duration_seconds": 5.95,
      "text": "A pillow. I would not have thought of that."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.81,
      "end_seconds": 350.31,
      "duration_seconds": 9.5,
      "text": "Try short, shallow breaths first, then build up to a few slow deep ones every hour or so."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.29,
      "end_seconds": 357.78,
      "duration_seconds": 5.49,
      "text": "Every hour, understood. Shall I come back to see you afterwards?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.77,
      "end_seconds": 370.3,
      "duration_seconds": 10.53,
      "text": "Yes, let's see you again in two weeks, and we'll go over how it's settling and what the picture showed."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 372.69,
      "end_seconds": 379.1,
      "duration_seconds": 6.41,
      "text": "In two weeks. I shall ask the receptionist to book it."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.11,
      "end_seconds": 387.06,
      "duration_seconds": 6.95,
      "text": "Good idea. She'll find a slot for you on your way out."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 388.78,
      "end_seconds": 393.4,
      "duration_seconds": 4.62,
      "text": "And if the pain gets worse before then?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 395.91,
      "end_seconds": 400.49,
      "duration_seconds": 4.58,
      "text": "Ring the surgery straight away. Don't sit on it."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 402.69,
      "end_seconds": 408.26,
      "duration_seconds": 5.57,
      "text": "I will not. Thank you very much indeed, Doctor."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 410.55,
      "end_seconds": 416.35,
      "duration_seconds": 5.8,
      "text": "You're welcome. Mind the corridor floor, it's just been washed."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 418.9,
      "end_seconds": 420.8,
      "duration_seconds": 1.9,
      "text": "Thank you. Goodbye."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 421.93,
      "end_seconds": 423.16,
      "duration_seconds": 1.23,
      "text": "Goodbye."
    }
  ]
}
