{
  "schema_version": "1.0",
  "encounter_id": "00788",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.58,
      "end_seconds": 20.73,
      "duration_seconds": 20.15,
      "text": "Doctor, my cholesterol is still high, even though I've changed my diet completely, and the tablet, and now I get this tightness in my chest when I walk fast, and my wife says come, so I came."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.84,
      "end_seconds": 26.89,
      "duration_seconds": 4.05,
      "text": "Thank you. Take me through the tightness."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.2,
      "end_seconds": 48.98,
      "duration_seconds": 20.78,
      "text": "It's like a band across the middle. When I walk fast up the road to the temple. It started two months ago. Oh, and last week I was at my nephew's wedding, such a grand affair..."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.91,
      "end_seconds": 55.81,
      "duration_seconds": 4.9,
      "text": "Mm. What happens when you stop walking? ~"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.71,
      "end_seconds": 62.6,
      "duration_seconds": 3.89,
      "text": "It goes away in a few minutes."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.17,
      "end_seconds": 65.73,
      "duration_seconds": 1.56,
      "text": "Any breathlessness?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.6,
      "end_seconds": 69.98,
      "duration_seconds": 3.38,
      "text": "On hills, yes, I'm puffing."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.56,
      "end_seconds": 73.82,
      "duration_seconds": 2.26,
      "text": "How's your energy?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.63,
      "end_seconds": 81.17,
      "duration_seconds": 4.54,
      "text": "Tired. Every afternoon, I feel like a wet cloth."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.75,
      "end_seconds": 86.43,
      "duration_seconds": 2.68,
      "text": "Anything in your legs?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.37,
      "end_seconds": 91.23,
      "duration_seconds": 3.86,
      "text": "Calf cramps at night, sometimes. Both sides."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.0,
      "end_seconds": 96.16,
      "duration_seconds": 4.16,
      "text": "Does the chest tightness come when you're resting?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.79,
      "end_seconds": 101.46,
      "duration_seconds": 2.67,
      "text": "No, never at rest."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.17,
      "end_seconds": 105.08,
      "duration_seconds": 0.91,
      "text": "Palpitations?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.76,
      "end_seconds": 110.18,
      "duration_seconds": 2.42,
      "text": "No, no palpitations."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.15,
      "end_seconds": 114.45,
      "duration_seconds": 1.3,
      "text": "Fainting?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.94,
      "end_seconds": 119.23,
      "duration_seconds": 2.29,
      "text": "Never fainted, doctor."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.76,
      "end_seconds": 123.33,
      "duration_seconds": 1.57,
      "text": "Which tablets?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.13,
      "end_seconds": 132.75,
      "duration_seconds": 6.62,
      "text": "Atorvastatin, 20 mg, at night. And aspirin, 75 mg, once a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.69,
      "end_seconds": 135.24,
      "duration_seconds": 1.55,
      "text": "Any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.33,
      "end_seconds": 145.6,
      "duration_seconds": 9.27,
      "text": "Penicillin, as a baby. My mother said I came out in a rash. I've never taken it since."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.06,
      "end_seconds": 150.5,
      "duration_seconds": 3.44,
      "text": "What conditions do you have?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.55,
      "end_seconds": 157.3,
      "duration_seconds": 5.75,
      "text": "High cholesterol, pre-diabetes, a fatty liver, and gout in the big toe."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.31,
      "end_seconds": 160.47,
      "duration_seconds": 1.16,
      "text": "Surgery?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.73,
      "end_seconds": 169.03,
      "duration_seconds": 7.3,
      "text": "My appendix as a teenager, and a knee arthroscopy in 2016."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.28,
      "end_seconds": 173.4,
      "duration_seconds": 3.12,
      "text": "Heart problems in the family?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.34,
      "end_seconds": 185.4,
      "duration_seconds": 9.06,
      "text": "My father had a heart attack at fifty-two. And my brother has high cholesterol too."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.69,
      "end_seconds": 190.65,
      "duration_seconds": 2.96,
      "text": "Tell me about your diet."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.16,
      "end_seconds": 198.19,
      "duration_seconds": 6.03,
      "text": "No meat, I'm vegetarian. But fried snacks, sweets, ghee, I admit it."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.2,
      "end_seconds": 201.55,
      "duration_seconds": 2.35,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.3,
      "end_seconds": 206.0,
      "duration_seconds": 3.7,
      "text": "I've never smoked in my life."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.38,
      "end_seconds": 209.28,
      "duration_seconds": 0.9,
      "text": "Exercise?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.24,
      "end_seconds": 216.27,
      "duration_seconds": 5.03,
      "text": "I walk twenty minutes a day, that's all."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.4,
      "end_seconds": 244.81,
      "duration_seconds": 12.41,
      "text": "Let me check you. Pulse 76, blood pressure 138 over 86, temperature 36.6, oxygen 98 percent, breathing 16, weight 88 kilos."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.49,
      "end_seconds": 249.8,
      "duration_seconds": 3.31,
      "text": "Is the pressure all right? ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.07,
      "end_seconds": 265.97,
      "duration_seconds": 4.9,
      "text": "A little high. Let me listen to your heart."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.89,
      "end_seconds": 270.23,
      "duration_seconds": 3.34,
      "text": "Heart sounds are normal, no murmurs."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.96,
      "end_seconds": 275.25,
      "duration_seconds": 2.29,
      "text": "Thank God. ~"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.82,
      "end_seconds": 285.43,
      "duration_seconds": 8.61,
      "text": "I can feel the pulses at your ankles, but the right one is weaker than the left."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.64,
      "end_seconds": 289.18,
      "duration_seconds": 2.54,
      "text": "Is that bad? ~"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.2,
      "end_seconds": 294.59,
      "duration_seconds": 4.39,
      "text": "Any trouble with your breathing at rest?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.31,
      "end_seconds": 298.56,
      "duration_seconds": 2.25,
      "text": "No, nothing at rest."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.77,
      "end_seconds": 314.57,
      "duration_seconds": 14.8,
      "text": "Your cholesterol may run in the family, which would explain why diet isn't enough. But the chest tightness on walking could mean narrowed heart arteries, and I can't rule that out."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.77,
      "end_seconds": 319.86,
      "duration_seconds": 4.09,
      "text": "Oh my God. Is it serious? ~"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.82,
      "end_seconds": 334.18,
      "duration_seconds": 12.36,
      "text": "It needs checking, that's all. I'd like to arrange a fasting cholesterol blood test, an ECG, and an exercise stress test."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.61,
      "end_seconds": 337.5,
      "duration_seconds": 1.89,
      "text": "When? ~"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.22,
      "end_seconds": 347.78,
      "duration_seconds": 7.56,
      "text": "The ECG today, the stress test this month. Keep taking the aspirin. ~"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.19,
      "end_seconds": 352.43,
      "duration_seconds": 2.24,
      "text": "Yes, doctor. ~"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.16,
      "end_seconds": 361.06,
      "duration_seconds": 5.9,
      "text": "I'd like to see you again in three weeks, with the results."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 363.5,
      "end_seconds": 366.4,
      "duration_seconds": 2.9,
      "text": "Three weeks. Thank you. ~"
    }
  ]
}
