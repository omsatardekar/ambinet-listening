{
  "schema_version": "1.0",
  "encounter_id": "00867",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 0.74,
      "end_seconds": 11.91,
      "duration_seconds": 11.17,
      "text": "Doctor, it's my mother's legs. They've swollen up again, and she sits in the wheelchair all day now."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.98,
      "end_seconds": 23.36,
      "duration_seconds": 9.38,
      "text": "Thank you, I'm glad you came together. Mrs Pillai, can you tell me about the swelling?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.65,
      "end_seconds": 32.45,
      "duration_seconds": 6.8,
      "text": "Both my legs are swollen, from the feet to the knees."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.01,
      "end_seconds": 39.18,
      "duration_seconds": 4.17,
      "text": "When did you first notice it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.92,
      "end_seconds": 46.55,
      "duration_seconds": 4.63,
      "text": "I don't remember. My daughter noticed it first."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 47.62,
      "end_seconds": 56.38,
      "duration_seconds": 8.76,
      "text": "I think it was around the festival, but I can't be sure. It might have been earlier."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.64,
      "end_seconds": 63.07,
      "duration_seconds": 4.43,
      "text": "Is it worse at any time of day?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.26,
      "end_seconds": 70.39,
      "duration_seconds": 6.13,
      "text": "In the evenings. By the morning it is a bit less."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.83,
      "end_seconds": 78.2,
      "duration_seconds": 5.37,
      "text": "Is there pain, redness or any warmth in the legs?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 81.03,
      "end_seconds": 86.73,
      "duration_seconds": 5.7,
      "text": "No, no redness. She says it just feels heavy."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.73,
      "end_seconds": 93.53,
      "duration_seconds": 5.8,
      "text": "Does she have any health problems that we should know about?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 94.64,
      "end_seconds": 101.43,
      "duration_seconds": 6.79,
      "text": "She has had heart failure for years, and high blood pressure."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.79,
      "end_seconds": 108.08,
      "duration_seconds": 4.29,
      "text": "Is she taking her water tablet regularly?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.33,
      "end_seconds": 112.9,
      "duration_seconds": 3.57,
      "text": "Yes, I take the water tablet."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 116.07,
      "end_seconds": 128.17,
      "duration_seconds": 12.1,
      "text": "She does, mostly, but I only see her in the evenings. Her carer gives the morning ones, and she sometimes refuses."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.64,
      "end_seconds": 134.74,
      "duration_seconds": 5.1,
      "text": "And which water tablet is that, and what dose?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 136.94,
      "end_seconds": 141.74,
      "duration_seconds": 4.8,
      "text": "Furosemide, 40 milligrams, once in the morning."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.23,
      "end_seconds": 149.94,
      "duration_seconds": 5.71,
      "text": "Do you have any allergies to medicines, Mrs Pillai?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.06,
      "end_seconds": 156.02,
      "duration_seconds": 3.96,
      "text": "Penicillin. It gave me a rash once."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.27,
      "end_seconds": 164.15,
      "duration_seconds": 5.88,
      "text": "Thank you. I'll note that. Is she short of breath lying flat?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 166.23,
      "end_seconds": 171.88,
      "duration_seconds": 5.65,
      "text": "No, she sleeps with two pillows as she always has."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.03,
      "end_seconds": 184.05,
      "duration_seconds": 10.02,
      "text": "I'd like to look at her legs and listen to her chest. Could you help me lift the footrest? ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 201.92,
      "end_seconds": 204.16,
      "duration_seconds": 2.24,
      "text": "Yes, of course."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.69,
      "end_seconds": 214.41,
      "duration_seconds": 7.72,
      "text": "There is pitting swelling of both lower legs up to the knees, and no redness."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.35,
      "end_seconds": 219.08,
      "duration_seconds": 2.73,
      "text": "Is it bad, doctor? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.82,
      "end_seconds": 230.27,
      "duration_seconds": 8.45,
      "text": "It's a fluid build-up. With her heart condition and sitting all day, that's the usual cause."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 233.37,
      "end_seconds": 236.47,
      "duration_seconds": 3.1,
      "text": "Should we change her tablets? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.06,
      "end_seconds": 248.13,
      "duration_seconds": 10.07,
      "text": "I would like to increase the furosemide to 40 milligrams twice a day, morning and early afternoon, and I'll prescribe that."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 250.95,
      "end_seconds": 255.53,
      "duration_seconds": 4.58,
      "text": "We'll make sure the carer knows. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.87,
      "end_seconds": 265.85,
      "duration_seconds": 8.98,
      "text": "Please keep her legs raised when she is resting, and encourage her to take the tablets."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 268.34,
      "end_seconds": 270.26,
      "duration_seconds": 1.92,
      "text": "I will. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.17,
      "end_seconds": 283.43,
      "duration_seconds": 11.26,
      "text": "I would also like a blood test to check her kidneys and salts, since we are changing the dose."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 286.18,
      "end_seconds": 290.42,
      "duration_seconds": 4.24,
      "text": "When should we do that? ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.13,
      "end_seconds": 300.54,
      "duration_seconds": 7.41,
      "text": "Within the week. Then I'll see her again once the results are in. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.35,
      "end_seconds": 305.98,
      "duration_seconds": 2.63,
      "text": "Thank you, doctor. ~"
    }
  ]
}
