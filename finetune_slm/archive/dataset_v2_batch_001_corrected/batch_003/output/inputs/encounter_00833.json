{
  "schema_version": "1.0",
  "encounter_id": "00833",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 1.13,
      "end_seconds": 10.45,
      "duration_seconds": 9.32,
      "text": "Doctor, I'm Hannah, Greg's wife. He won't say it, so I will: I'm worried about how much he's drinking."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.37,
      "end_seconds": 18.24,
      "duration_seconds": 5.87,
      "text": "Hannah, I'm fine. It's a glass of wine in the evenings. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.09,
      "end_seconds": 31.12,
      "duration_seconds": 10.03,
      "text": "Greg, I'd like to hear from you first. How much do you drink in a typical day?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.76,
      "end_seconds": 40.82,
      "duration_seconds": 7.06,
      "text": "A bottle of wine, give or take. Maybe a bit more at weekends."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 42.83,
      "end_seconds": 53.28,
      "duration_seconds": 10.45,
      "text": "It's more than that. There's a bottle every night, and he's started before lunch on his days off."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.25,
      "end_seconds": 61.65,
      "duration_seconds": 7.4,
      "text": "Thank you both. When did the drinking go up, would you say?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.46,
      "end_seconds": 71.54,
      "duration_seconds": 8.08,
      "text": "I don't know. Gradually. Since I changed jobs, I think. Or maybe before."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 74.48,
      "end_seconds": 82.78,
      "duration_seconds": 8.3,
      "text": "It's the last year, I think, but I honestly couldn't say when it tipped over."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.17,
      "end_seconds": 87.36,
      "duration_seconds": 3.19,
      "text": "How are your mornings?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.34,
      "end_seconds": 95.55,
      "duration_seconds": 6.21,
      "text": "Shaky. My hands tremble. I settle down after a coffee."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 97.96,
      "end_seconds": 104.65,
      "duration_seconds": 6.69,
      "text": "And he's sweaty and irritable until he has a drink at lunchtime."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.41,
      "end_seconds": 109.45,
      "duration_seconds": 2.04,
      "text": "How's your sleep?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.77,
      "end_seconds": 118.47,
      "duration_seconds": 7.7,
      "text": "Poor. I fall asleep fine, and wake at three, and lie there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.17,
      "end_seconds": 122.99,
      "duration_seconds": 2.82,
      "text": "And how's your mood?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.42,
      "end_seconds": 129.75,
      "duration_seconds": 4.33,
      "text": "A bit flat. And anxious, that's the word."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.87,
      "end_seconds": 134.8,
      "duration_seconds": 2.93,
      "text": "Any thoughts of harming yourself?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.1,
      "end_seconds": 140.14,
      "duration_seconds": 3.04,
      "text": "No. No, not at all."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.93,
      "end_seconds": 145.24,
      "duration_seconds": 3.31,
      "text": "Any tablets at the moment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.84,
      "end_seconds": 157.86,
      "duration_seconds": 10.02,
      "text": "Just a vitamin B tablet, thiamine, 100 mg, once a day, that Hannah makes me take."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.38,
      "end_seconds": 164.02,
      "duration_seconds": 4.64,
      "text": "Good. Any allergies to medicines or anything else?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.12,
      "end_seconds": 168.81,
      "duration_seconds": 3.69,
      "text": "No. I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 170.07,
      "end_seconds": 181.54,
      "duration_seconds": 11.47,
      "text": "He reacted to codeine once, Greg, you came out in hives, and your face swelled. It was years ago, before we married."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.55,
      "end_seconds": 195.15,
      "duration_seconds": 12.6,
      "text": "I'll note that you say no allergies and Hannah recalls a reaction to codeine, and I'll record both. Any health conditions?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.13,
      "end_seconds": 207.75,
      "duration_seconds": 9.62,
      "text": "High blood pressure, an ulcer a few years ago, and I had some depression, a while back."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.01,
      "end_seconds": 213.23,
      "duration_seconds": 4.22,
      "text": "Let me check you. Pulse, pressure, temperature. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.14,
      "end_seconds": 216.49,
      "duration_seconds": 2.35,
      "text": "Go on. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.07,
      "end_seconds": 242.89,
      "duration_seconds": 8.82,
      "text": "Pulse 92, blood pressure 150 over 94, temperature 36.8, oxygen 98 percent, weight 94 kilos."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 245.2,
      "end_seconds": 248.43,
      "duration_seconds": 3.23,
      "text": "That's high, isn't it? ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.44,
      "end_seconds": 259.47,
      "duration_seconds": 9.03,
      "text": "The pressure and pulse are up, which fits with the alcohol and the morning shakes. Any breathlessness, chest pain?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.85,
      "end_seconds": 263.71,
      "duration_seconds": 1.86,
      "text": "No. Nothing."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.33,
      "end_seconds": 282.41,
      "duration_seconds": 16.08,
      "text": "Greg, from what you and Hannah describe, drinking a bottle of wine or more daily, shakes in the morning and drinking to settle them, this looks like harmful alcohol use with early dependence."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.15,
      "end_seconds": 287.31,
      "duration_seconds": 3.16,
      "text": "Dependence. That's a strong word. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.4,
      "end_seconds": 296.17,
      "duration_seconds": 6.77,
      "text": "It's a medical description, and it's treatable. And it's good that you've come. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 299.04,
      "end_seconds": 302.91,
      "duration_seconds": 3.87,
      "text": "Can he stop on his own? ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.69,
      "end_seconds": 314.85,
      "duration_seconds": 9.16,
      "text": "Please don't stop suddenly, because with this level of drinking, withdrawal can be dangerous. We'll plan it safely."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.65,
      "end_seconds": 320.73,
      "duration_seconds": 3.08,
      "text": "What does that involve? ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.21,
      "end_seconds": 335.47,
      "duration_seconds": 13.26,
      "text": "I'd like to refer you to the community alcohol service, and I'd like to arrange blood tests, for your liver and blood count, today."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.12,
      "end_seconds": 339.96,
      "duration_seconds": 1.84,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.23,
      "end_seconds": 347.17,
      "duration_seconds": 5.94,
      "text": "Keep taking the thiamine, eat regular meals, and don't drive after drinking."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 349.75,
      "end_seconds": 353.55,
      "duration_seconds": 3.8,
      "text": "I'll keep an eye on him. ~"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.72,
      "end_seconds": 368.72,
      "duration_seconds": 14.0,
      "text": "I'd like to see you again in a week. If you get severe shakes, confusion, hallucinations, or a fit, go to the emergency department."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 370.79,
      "end_seconds": 373.5,
      "duration_seconds": 2.71,
      "text": "Okay. Thank you. ~"
    }
  ]
}
