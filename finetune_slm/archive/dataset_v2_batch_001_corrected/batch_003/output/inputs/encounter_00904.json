{
  "schema_version": "1.0",
  "encounter_id": "00904",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.75,
      "end_seconds": 11.86,
      "duration_seconds": 10.11,
      "text": "Hello. My irritable bowel is flaring up again, and I've got exams in two weeks, so I'm panicking a bit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.41,
      "end_seconds": 22.0,
      "duration_seconds": 8.59,
      "text": "Okay, let's see what we can do. What's your tummy doing at the moment?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.45,
      "end_seconds": 32.35,
      "duration_seconds": 7.9,
      "text": "Cramping and cramping. Mostly lower down. Then I'm in the toilet a lot."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.95,
      "end_seconds": 38.19,
      "duration_seconds": 3.24,
      "text": "When did this flare start?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.47,
      "end_seconds": 48.96,
      "duration_seconds": 8.49,
      "text": "I'm not sure. Maybe a week ago, or ten days? It crept up on me."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.77,
      "end_seconds": 55.67,
      "duration_seconds": 3.9,
      "text": "Is the stool loose or hard?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.98,
      "end_seconds": 64.07,
      "duration_seconds": 5.09,
      "text": "Loose, mostly. Sometimes constipated for a day, then loose again."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.37,
      "end_seconds": 71.81,
      "duration_seconds": 4.44,
      "text": "Any blood in the stool, or weight loss?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.35,
      "end_seconds": 80.32,
      "duration_seconds": 5.97,
      "text": "No blood. I've not lost any weight that I know of."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.33,
      "end_seconds": 86.43,
      "duration_seconds": 4.1,
      "text": "Has this happened during exams before?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.74,
      "end_seconds": 94.59,
      "duration_seconds": 5.85,
      "text": "Yes, every exam season. I've had IBS since I was sixteen."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.99,
      "end_seconds": 106.12,
      "duration_seconds": 8.13,
      "text": "Fine, that's helpful. I'd like to check your pulse, temperature and blood pressure. ~"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.15,
      "end_seconds": 118.78,
      "duration_seconds": 1.63,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.16,
      "end_seconds": 131.03,
      "duration_seconds": 8.87,
      "text": "Pulse 78, blood pressure 116 over 72, temperature 36.7, oxygen 99 percent, breathing 14."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.6,
      "end_seconds": 135.67,
      "duration_seconds": 3.07,
      "text": "Are they all right? ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.86,
      "end_seconds": 147.45,
      "duration_seconds": 8.59,
      "text": "All normal. Let me press on your tummy. Tell me if anything is sore. ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.9,
      "end_seconds": 166.83,
      "duration_seconds": 3.93,
      "text": "A bit there, on the left."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.7,
      "end_seconds": 176.11,
      "duration_seconds": 7.41,
      "text": "Mild tenderness in the left lower abdomen, soft, no guarding and no lumps."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.95,
      "end_seconds": 181.96,
      "duration_seconds": 3.01,
      "text": "Is that the IBS? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.08,
      "end_seconds": 191.98,
      "duration_seconds": 7.9,
      "text": "It fits with an IBS flare brought on by stress. Nothing here worries me."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.06,
      "end_seconds": 198.48,
      "duration_seconds": 4.42,
      "text": "Is there anything I can take? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.99,
      "end_seconds": 208.4,
      "duration_seconds": 8.41,
      "text": "Peppermint oil capsules can ease the cramping. And a low-FODMAP diet can help for a few weeks."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.72,
      "end_seconds": 214.05,
      "duration_seconds": 2.33,
      "text": "What's low-FODMAP? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.7,
      "end_seconds": 225.79,
      "duration_seconds": 9.09,
      "text": "A diet that cuts out certain fermentable carbohydrates, like onions, garlic, and some fruits. I'll give you a leaflet."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.93,
      "end_seconds": 231.9,
      "duration_seconds": 3.97,
      "text": "Okay. I can try that. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.9,
      "end_seconds": 241.05,
      "duration_seconds": 6.15,
      "text": "How are you sleeping and eating during revision? ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.53,
      "end_seconds": 249.41,
      "duration_seconds": 6.88,
      "text": "Badly, to be honest. Lots of coffee and not much food. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.48,
      "end_seconds": 260.62,
      "duration_seconds": 8.14,
      "text": "Try regular meals and less coffee. Even a short walk each day helps a flare."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.35,
      "end_seconds": 265.53,
      "duration_seconds": 2.18,
      "text": "I'll try. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.89,
      "end_seconds": 278.68,
      "duration_seconds": 9.79,
      "text": "I'll also arrange a blood test and a stool test, just to be certain that nothing else is going on."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.24,
      "end_seconds": 286.94,
      "duration_seconds": 5.7,
      "text": "Will I get the results before my exams? ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.35,
      "end_seconds": 299.5,
      "duration_seconds": 10.15,
      "text": "Yes, within the week. If you're not better in two weeks, come back and we'll talk again."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.91,
      "end_seconds": 306.0,
      "duration_seconds": 4.09,
      "text": "Thank you, doctor. That's a relief. ~"
    }
  ]
}
