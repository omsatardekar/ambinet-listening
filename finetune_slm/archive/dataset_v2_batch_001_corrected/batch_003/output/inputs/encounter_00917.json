{
  "schema_version": "1.0",
  "encounter_id": "00917",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 3.78,
      "end_seconds": 10.94,
      "duration_seconds": 7.16,
      "text": "Right, I'm here for my regular check. Lithium levels and all that."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.39,
      "end_seconds": 21.51,
      "duration_seconds": 6.12,
      "text": "Good to see you. How have you been since the last visit?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.44,
      "end_seconds": 33.97,
      "duration_seconds": 7.53,
      "text": "Steady, mostly. A bit of a tremor in my hands again, mind."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.81,
      "end_seconds": 42.88,
      "duration_seconds": 5.07,
      "text": "Is it constant, or does it come and go?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.33,
      "end_seconds": 53.9,
      "duration_seconds": 6.57,
      "text": "Worse when I hold a cup. Settles when I rest my hands."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.83,
      "end_seconds": 64.16,
      "duration_seconds": 6.33,
      "text": "Any other changes, thirst, passing more urine, or tummy upset?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.06,
      "end_seconds": 72.24,
      "duration_seconds": 3.18,
      "text": "No thirst. No tummy upset."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.68,
      "end_seconds": 79.8,
      "duration_seconds": 3.12,
      "text": "And your mood? ~"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.65,
      "end_seconds": 90.46,
      "duration_seconds": 6.81,
      "text": "Level. No highs and no lows for a good few months now. ~"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 94.32,
      "end_seconds": 104.97,
      "duration_seconds": 10.65,
      "text": "Doctor, I took his blood this morning for the lithium level. The lab says it'll be ready by this afternoon. ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.73,
      "end_seconds": 115.15,
      "duration_seconds": 6.42,
      "text": "Thank you. Are you drinking enough water in this heat? ~"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.38,
      "end_seconds": 122.93,
      "duration_seconds": 3.55,
      "text": "Plenty. A couple of litres. ~"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.72,
      "end_seconds": 138.49,
      "duration_seconds": 10.77,
      "text": "Good, because dehydration can raise the lithium level. And are you taking any painkillers, like ibuprofen? ~"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.05,
      "end_seconds": 148.01,
      "duration_seconds": 4.96,
      "text": "No, I was told to avoid them. Only paracetamol. ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.47,
      "end_seconds": 156.4,
      "duration_seconds": 3.93,
      "text": "That's right. Any allergies I should record?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.53,
      "end_seconds": 173.24,
      "duration_seconds": 12.71,
      "text": "When I was a child, I came out in a rash with penicillin. They told me to avoid it, and I have."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.62,
      "end_seconds": 181.54,
      "duration_seconds": 3.92,
      "text": "Thank you. Any operations in your history?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.46,
      "end_seconds": 189.39,
      "duration_seconds": 3.93,
      "text": "Just my appendix, when I was nineteen."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.27,
      "end_seconds": 198.49,
      "duration_seconds": 4.22,
      "text": "And are you drinking or smoking?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.35,
      "end_seconds": 207.52,
      "duration_seconds": 5.17,
      "text": "No smoking. I have a pint now and then."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.44,
      "end_seconds": 218.11,
      "duration_seconds": 6.67,
      "text": "Good. I'd like to explain what we do with the level today. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.52,
      "end_seconds": 224.83,
      "duration_seconds": 2.31,
      "text": "Go on. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.13,
      "end_seconds": 240.56,
      "duration_seconds": 11.43,
      "text": "If it's within the usual range, we carry on exactly as we are. If it's high, I'll phone you the same day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.24,
      "end_seconds": 249.26,
      "duration_seconds": 4.02,
      "text": "Fine. I'll keep my phone on. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.04,
      "end_seconds": 259.74,
      "duration_seconds": 5.7,
      "text": "Please don't change your dose yourself, and keep up the water."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.64,
      "end_seconds": 265.62,
      "duration_seconds": 1.98,
      "text": "I won't. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.71,
      "end_seconds": 280.18,
      "duration_seconds": 10.47,
      "text": "I'd also like to see you in three months for the routine check, and we'll look at your kidneys and thyroid again."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.08,
      "end_seconds": 288.88,
      "duration_seconds": 3.8,
      "text": "Three months. All right. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 293.65,
      "end_seconds": 298.67,
      "duration_seconds": 5.02,
      "text": "I'll book that for you before you leave. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.9,
      "end_seconds": 305.99,
      "duration_seconds": 3.09,
      "text": "Thank you both. ~"
    }
  ]
}
