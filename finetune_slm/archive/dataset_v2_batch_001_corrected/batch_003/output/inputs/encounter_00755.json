{
  "schema_version": "1.0",
  "encounter_id": "00755",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 2.68,
      "end_seconds": 10.2,
      "duration_seconds": 7.52,
      "text": "It's this cough. Dry. Since I started the new blood pressure tablet."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.25,
      "end_seconds": 16.01,
      "duration_seconds": 2.76,
      "text": "Which tablet is that?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.1,
      "end_seconds": 22.58,
      "duration_seconds": 3.48,
      "text": "Ramipril. 5 mg. Once a day."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.15,
      "end_seconds": 29.25,
      "duration_seconds": 4.1,
      "text": "When did you start it? ~"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.33,
      "end_seconds": 35.39,
      "duration_seconds": 2.06,
      "text": "Three months ago."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.21,
      "end_seconds": 40.64,
      "duration_seconds": 2.43,
      "text": "Describe the cough."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.66,
      "end_seconds": 48.72,
      "duration_seconds": 5.06,
      "text": "Tickly. Dry. Worse at night. Nothing comes up."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.89,
      "end_seconds": 55.92,
      "duration_seconds": 4.03,
      "text": "Any fever, or breathlessness, or wheeze? ~"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.73,
      "end_seconds": 61.83,
      "duration_seconds": 3.1,
      "text": "No. Just the tickle. ~"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.16,
      "end_seconds": 67.59,
      "duration_seconds": 2.43,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.81,
      "end_seconds": 72.53,
      "duration_seconds": 1.72,
      "text": "Never have."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.65,
      "end_seconds": 78.55,
      "duration_seconds": 2.9,
      "text": "Any allergies to medicines?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.71,
      "end_seconds": 85.31,
      "duration_seconds": 2.6,
      "text": "Aspirin. I wheeze."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.25,
      "end_seconds": 92.86,
      "duration_seconds": 3.61,
      "text": "Anything else in your medical history?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.95,
      "end_seconds": 100.5,
      "duration_seconds": 3.55,
      "text": "High blood pressure. That's it."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.53,
      "end_seconds": 109.4,
      "duration_seconds": 4.87,
      "text": "Let me check your pulse and oxygen. ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.74,
      "end_seconds": 115.08,
      "duration_seconds": 2.34,
      "text": "Go on. ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.94,
      "end_seconds": 131.83,
      "duration_seconds": 5.89,
      "text": "Pulse 70, oxygen 98 percent, blood pressure 130 over 80."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.52,
      "end_seconds": 136.34,
      "duration_seconds": 1.82,
      "text": "Fine? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.01,
      "end_seconds": 158.09,
      "duration_seconds": 4.08,
      "text": "All fine. I'll listen to your chest."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.18,
      "end_seconds": 163.64,
      "duration_seconds": 1.46,
      "text": "Clear? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.66,
      "end_seconds": 173.2,
      "duration_seconds": 5.54,
      "text": "Clear as a bell. No wheeze, no crackles. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.87,
      "end_seconds": 180.06,
      "duration_seconds": 3.19,
      "text": "So it's the tablet? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.75,
      "end_seconds": 197.29,
      "duration_seconds": 14.54,
      "text": "A dry, tickly cough that started a few weeks after ramipril, with a clear chest, is the classic pattern, so I can't rule out a cough caused by the ramipril."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.24,
      "end_seconds": 204.51,
      "duration_seconds": 3.27,
      "text": "Can you change it? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.34,
      "end_seconds": 216.45,
      "duration_seconds": 9.11,
      "text": "Yes, there's an almost identical type of tablet, called losartan, that doesn't cause the cough. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.53,
      "end_seconds": 221.84,
      "duration_seconds": 2.31,
      "text": "Same effect? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.14,
      "end_seconds": 234.81,
      "duration_seconds": 9.67,
      "text": "Same blood pressure control. I'd like you to stop the ramipril and start losartan 50 mg once a day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.25,
      "end_seconds": 240.73,
      "duration_seconds": 2.48,
      "text": "Right. Today? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.39,
      "end_seconds": 250.48,
      "duration_seconds": 7.09,
      "text": "Today. Take the first one tomorrow morning, and don't take both."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.35,
      "end_seconds": 254.92,
      "duration_seconds": 1.57,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.05,
      "end_seconds": 270.45,
      "duration_seconds": 11.4,
      "text": "The cough can take a few weeks to fade after stopping, so don't expect it to vanish overnight. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.37,
      "end_seconds": 275.26,
      "duration_seconds": 1.89,
      "text": "How long? ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.86,
      "end_seconds": 289.31,
      "duration_seconds": 10.45,
      "text": "Up to four weeks. If it hasn't gone after four weeks, come back and I'll think again."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.8,
      "end_seconds": 294.85,
      "duration_seconds": 2.05,
      "text": "Fair. Thanks. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.95,
      "end_seconds": 301.35,
      "duration_seconds": 2.4,
      "text": "Take care. ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.39,
      "end_seconds": 305.97,
      "duration_seconds": 1.58,
      "text": "Bye. ~"
    }
  ]
}
