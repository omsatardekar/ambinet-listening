{
  "schema_version": "1.0",
  "encounter_id": "00639",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.97,
      "end_seconds": 13.75,
      "duration_seconds": 12.78,
      "text": "Doctor, it's the shoulder. I can't lift my arm above my head any more, I was trying to reach the press and, ah, I just couldn't."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.28,
      "end_seconds": 19.54,
      "duration_seconds": 3.26,
      "text": "Which side, and how long?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.78,
      "end_seconds": 25.41,
      "duration_seconds": 4.63,
      "text": "The right. Three weeks now, give or take."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.14,
      "end_seconds": 32.14,
      "duration_seconds": 4.0,
      "text": "Does it hurt or is it just stuck?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.8,
      "end_seconds": 43.09,
      "duration_seconds": 9.29,
      "text": "Both, sure. There's a sort of, an ache at night, mostly, when I lie on it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.85,
      "end_seconds": 47.64,
      "duration_seconds": 2.79,
      "text": "Anything when you move it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.75,
      "end_seconds": 61.96,
      "duration_seconds": 12.21,
      "text": "There's a clicking. Started... I'm not sure when. Before the weakness, I think? Or maybe along with it. I couldn't tell you."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.69,
      "end_seconds": 67.27,
      "duration_seconds": 4.58,
      "text": "Fine. Any fall or knock to it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.17,
      "end_seconds": 73.1,
      "duration_seconds": 3.93,
      "text": "No, no fall. I didn't hurt it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.17,
      "end_seconds": 75.95,
      "duration_seconds": 1.78,
      "text": "Neck pain?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.82,
      "end_seconds": 80.47,
      "duration_seconds": 3.65,
      "text": "Not really, no. The neck's grand."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.84,
      "end_seconds": 88.03,
      "duration_seconds": 5.19,
      "text": "Any numbness or pins and needles down the arm?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.83,
      "end_seconds": 93.8,
      "duration_seconds": 2.97,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.44,
      "end_seconds": 100.46,
      "duration_seconds": 4.02,
      "text": "Fever or feeling unwell with it?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.74,
      "end_seconds": 104.63,
      "duration_seconds": 2.89,
      "text": "No, I'm well in myself."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.92,
      "end_seconds": 109.64,
      "duration_seconds": 3.72,
      "text": "Medicines. What are you on?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.75,
      "end_seconds": 124.15,
      "duration_seconds": 13.4,
      "text": "Ramipril for the pressure, 5 mg, once a day. Atorvastatin, 20 mg, at night. And paracetamol, 1 gram, up to four times a day, for the shoulder."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.02,
      "end_seconds": 130.59,
      "duration_seconds": 4.57,
      "text": "Good. Are you allergic to anything, any allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.88,
      "end_seconds": 144.03,
      "duration_seconds": 12.15,
      "text": "Ah. Maybe. I think I came out in a rash, years ago, after one of the antibiotics. But I couldn't tell you which one."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.12,
      "end_seconds": 150.48,
      "duration_seconds": 5.36,
      "text": "I'll record that as unconfirmed. Health history, apart from the shoulder?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.49,
      "end_seconds": 158.91,
      "duration_seconds": 6.42,
      "text": "High blood pressure, high cholesterol, the gout, and the arthritis in my knees."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.7,
      "end_seconds": 161.17,
      "duration_seconds": 1.47,
      "text": "Any operations?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.04,
      "end_seconds": 169.22,
      "duration_seconds": 5.18,
      "text": "A knee replacement, the left one, about six years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.68,
      "end_seconds": 175.2,
      "duration_seconds": 4.52,
      "text": "Heart or joint problems in the family?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.16,
      "end_seconds": 184.03,
      "duration_seconds": 6.87,
      "text": "My father had a heart attack at sixty. And my sister has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.48,
      "end_seconds": 188.38,
      "duration_seconds": 1.9,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.89,
      "end_seconds": 193.48,
      "duration_seconds": 3.59,
      "text": "I gave up smoking in 2015."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.19,
      "end_seconds": 197.52,
      "duration_seconds": 1.33,
      "text": "Alcohol?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.67,
      "end_seconds": 206.47,
      "duration_seconds": 6.8,
      "text": "A glass of wine at the weekend, I'd say. Sure, that's all."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.66,
      "end_seconds": 237.32,
      "duration_seconds": 13.66,
      "text": "Let me look at it. Pulse 74, blood pressure 142 over 86, temperature 36.5, oxygen 97 percent, breathing 16, weight 91 kilos."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.16,
      "end_seconds": 242.81,
      "duration_seconds": 3.65,
      "text": "Is the pressure all right? ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.12,
      "end_seconds": 262.24,
      "duration_seconds": 10.12,
      "text": "A touch up from the pain, I'd say. Now lift your arm out to the side for me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.14,
      "end_seconds": 268.45,
      "duration_seconds": 4.31,
      "text": "That's as high as it goes. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.2,
      "end_seconds": 285.29,
      "duration_seconds": 14.09,
      "text": "Yes, I can see you can only lift the arm to shoulder height. And there's tenderness at the front of the right shoulder."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.51,
      "end_seconds": 290.09,
      "duration_seconds": 2.58,
      "text": "Oh, that's sore. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.56,
      "end_seconds": 296.0,
      "duration_seconds": 4.44,
      "text": "Any trouble with your chest, breathlessness on exertion?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.7,
      "end_seconds": 302.24,
      "duration_seconds": 4.54,
      "text": "No, nothing like that, my chest is fine."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.58,
      "end_seconds": 311.12,
      "duration_seconds": 7.54,
      "text": "Right. This looks most like a rotator cuff problem, the tendons that lift the arm."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.92,
      "end_seconds": 317.12,
      "duration_seconds": 3.2,
      "text": "Is it a tear? ~"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.0,
      "end_seconds": 332.7,
      "duration_seconds": 12.7,
      "text": "Could be partial, which is why I'd like to arrange an X-ray of the shoulder and an ultrasound scan of the shoulder."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.51,
      "end_seconds": 337.31,
      "duration_seconds": 3.8,
      "text": "Grand. Will that be today? ~"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.11,
      "end_seconds": 345.99,
      "duration_seconds": 7.88,
      "text": "The ultrasound is booked by reception. I'd also like to do a blood test for inflammation."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.18,
      "end_seconds": 351.93,
      "duration_seconds": 4.75,
      "text": "Fine so. What about the pain at night? ~"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.89,
      "end_seconds": 360.79,
      "duration_seconds": 7.9,
      "text": "Keep taking the paracetamol, and try a pillow under the arm when you lie down."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 362.6,
      "end_seconds": 365.33,
      "duration_seconds": 2.73,
      "text": "I'll do that. ~"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.59,
      "end_seconds": 375.47,
      "duration_seconds": 7.88,
      "text": "I'd like to see you again in two weeks with the results."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 376.87,
      "end_seconds": 381.34,
      "duration_seconds": 4.47,
      "text": "Two weeks, so. Thanks, doctor. ~"
    }
  ]
}
