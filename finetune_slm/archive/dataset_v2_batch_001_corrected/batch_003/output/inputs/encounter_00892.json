{
  "schema_version": "1.0",
  "encounter_id": "00892",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.27,
      "end_seconds": 12.68,
      "duration_seconds": 11.41,
      "text": "Hi. I've got this itchy rash on my arms, and I think it's from the new washing powder."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.45,
      "end_seconds": 22.2,
      "duration_seconds": 6.75,
      "text": "Okay, let's have a look at the story. Where exactly is the rash?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.92,
      "end_seconds": 28.7,
      "duration_seconds": 4.78,
      "text": "Both forearms, and a bit on my neck."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.16,
      "end_seconds": 35.34,
      "duration_seconds": 4.18,
      "text": "How long have you had it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.48,
      "end_seconds": 40.36,
      "duration_seconds": 1.88,
      "text": "Four days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.73,
      "end_seconds": 47.79,
      "duration_seconds": 5.06,
      "text": "And when did you change the washing powder?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.24,
      "end_seconds": 57.45,
      "duration_seconds": 7.21,
      "text": "The weekend before. I bought a different brand because it was on offer."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.83,
      "end_seconds": 66.32,
      "duration_seconds": 6.49,
      "text": "Is the itch constant, or does it come and go?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.49,
      "end_seconds": 72.09,
      "duration_seconds": 4.6,
      "text": "It's worse at night. I keep scratching."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.66,
      "end_seconds": 79.55,
      "duration_seconds": 5.89,
      "text": "Any blisters, or any swelling of your lips or face?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.08,
      "end_seconds": 86.59,
      "duration_seconds": 4.51,
      "text": "No blisters. No swelling of the face, thankfully."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.44,
      "end_seconds": 93.42,
      "duration_seconds": 4.98,
      "text": "Have you had any trouble breathing, or wheeze?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.48,
      "end_seconds": 98.96,
      "duration_seconds": 4.48,
      "text": "No, nothing like that. My chest is fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.87,
      "end_seconds": 107.06,
      "duration_seconds": 5.19,
      "text": "Have you tried anything on it so far? ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.23,
      "end_seconds": 113.78,
      "duration_seconds": 4.55,
      "text": "Only moisturiser. It didn't do much. ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.65,
      "end_seconds": 123.63,
      "duration_seconds": 6.98,
      "text": "Let me take your pulse, temperature and oxygen level first. ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.47,
      "end_seconds": 136.03,
      "duration_seconds": 1.56,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.42,
      "end_seconds": 146.45,
      "duration_seconds": 9.03,
      "text": "Pulse 76, blood pressure 122 over 78, temperature 36.7, oxygen 99 percent, breathing 16 a minute."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.66,
      "end_seconds": 151.32,
      "duration_seconds": 2.66,
      "text": "All normal? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.42,
      "end_seconds": 162.87,
      "duration_seconds": 9.45,
      "text": "All normal. Now let me look at your arms, please roll up your sleeves. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.51,
      "end_seconds": 180.72,
      "duration_seconds": 2.21,
      "text": "Here you go."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.3,
      "end_seconds": 194.21,
      "duration_seconds": 11.91,
      "text": "There are red, slightly scaly patches on both forearms and on the side of the neck, with scratch marks. No blisters."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.75,
      "end_seconds": 199.53,
      "duration_seconds": 3.78,
      "text": "Is it the detergent, then? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.6,
      "end_seconds": 210.94,
      "duration_seconds": 10.34,
      "text": "It looks like contact dermatitis, an irritation of the skin from something it has touched, and a new washing powder fits."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.4,
      "end_seconds": 216.68,
      "duration_seconds": 3.28,
      "text": "So what do I do? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.44,
      "end_seconds": 225.52,
      "duration_seconds": 7.08,
      "text": "Go back to your old washing powder, and run the clothes through an extra rinse."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.21,
      "end_seconds": 232.17,
      "duration_seconds": 4.96,
      "text": "Easy enough. Should I throw away the new box? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.15,
      "end_seconds": 245.86,
      "duration_seconds": 11.71,
      "text": "Keep it for now. If it doesn't settle, we may do a patch test to find out exactly what you react to."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.32,
      "end_seconds": 250.73,
      "duration_seconds": 3.41,
      "text": "A patch test? What's that? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.94,
      "end_seconds": 261.84,
      "duration_seconds": 9.9,
      "text": "Small patches of different substances on your back for a few days. It tells us what triggers the skin. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.83,
      "end_seconds": 269.31,
      "duration_seconds": 5.48,
      "text": "Oh, okay. I'd do that if I had to. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.47,
      "end_seconds": 282.32,
      "duration_seconds": 9.85,
      "text": "For now, I'd like to take a swab from the skin to rule out infection, if the scratching has broken it."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.53,
      "end_seconds": 289.27,
      "duration_seconds": 4.74,
      "text": "I think it's only scratched, not broken. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.87,
      "end_seconds": 301.14,
      "duration_seconds": 10.27,
      "text": "Then we'll not need to. But I'll keep the option, and decide next week if it is not better. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.89,
      "end_seconds": 305.99,
      "duration_seconds": 3.1,
      "text": "Fine, thank you. ~"
    }
  ]
}
