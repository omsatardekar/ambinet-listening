{
  "schema_version": "1.0",
  "encounter_id": "00975",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 3.21,
      "end_seconds": 17.61,
      "duration_seconds": 14.4,
      "text": "Hello, doctor. I'm Maya, I'm Mr Okafor's carer, I drove him in. He's got a sore lower back since he helped move his daughter's house on the weekend. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.94,
      "end_seconds": 27.93,
      "duration_seconds": 6.99,
      "text": "Thanks for bringing him, Maya. Mr Okafor, how are you? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.58,
      "end_seconds": 39.3,
      "duration_seconds": 7.72,
      "text": "Sore, doctor. Right across my lower back. I lifted a lot of boxes."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.6,
      "end_seconds": 45.06,
      "duration_seconds": 2.46,
      "text": "When did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.95,
      "end_seconds": 54.0,
      "duration_seconds": 5.05,
      "text": "Saturday afternoon, after the sofa. It's Monday now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.87,
      "end_seconds": 62.84,
      "duration_seconds": 4.97,
      "text": "Is it a dull ache or sharp? ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.86,
      "end_seconds": 72.54,
      "duration_seconds": 5.68,
      "text": "A dull ache, but sharp when I bend. ~"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.85,
      "end_seconds": 79.15,
      "duration_seconds": 3.3,
      "text": "Does it go anywhere? ~"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.2,
      "end_seconds": 85.52,
      "duration_seconds": 3.32,
      "text": "No. Just the back. ~"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.26,
      "end_seconds": 102.15,
      "duration_seconds": 5.89,
      "text": "Let me have a feel. Can you stand up for me?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.58,
      "end_seconds": 108.74,
      "duration_seconds": 2.16,
      "text": "Slowly. ~"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.55,
      "end_seconds": 122.23,
      "duration_seconds": 9.68,
      "text": "There's tenderness in the muscles on both sides of the lower back, and they feel tight."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.13,
      "end_seconds": 129.63,
      "duration_seconds": 3.5,
      "text": "That's where it hurts. ~"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 133.65,
      "end_seconds": 138.0,
      "duration_seconds": 4.35,
      "text": "He's been walking about all morning, doctor. ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.87,
      "end_seconds": 148.29,
      "duration_seconds": 6.42,
      "text": "That's good. Mr Okafor, does anyone in your family have back trouble?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.52,
      "end_seconds": 157.13,
      "duration_seconds": 5.61,
      "text": "My mother had a bad back all her life."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.61,
      "end_seconds": 168.58,
      "duration_seconds": 7.97,
      "text": "That's useful to know. Here's what I'd advise. Keep moving, short gentle walks, little and often."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.96,
      "end_seconds": 176.3,
      "duration_seconds": 3.34,
      "text": "I thought I should rest. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.59,
      "end_seconds": 186.46,
      "duration_seconds": 6.87,
      "text": "Bed rest makes it worse. Gentle movement helps it recover. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 190.34,
      "end_seconds": 194.76,
      "duration_seconds": 4.42,
      "text": "That's what the physio told his sister. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.71,
      "end_seconds": 207.79,
      "duration_seconds": 9.08,
      "text": "Use a hot water bottle on the sore area, for twenty minutes at a time."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.95,
      "end_seconds": 214.24,
      "duration_seconds": 3.29,
      "text": "Warm, not hot. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.33,
      "end_seconds": 225.85,
      "duration_seconds": 7.52,
      "text": "Exactly. And avoid heavy lifting for two weeks, even a bag of shopping."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 229.75,
      "end_seconds": 232.91,
      "duration_seconds": 3.16,
      "text": "I'll carry the shopping. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.61,
      "end_seconds": 239.87,
      "duration_seconds": 3.26,
      "text": "That's a relief. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.92,
      "end_seconds": 250.33,
      "duration_seconds": 6.41,
      "text": "Sleep on your side with a pillow between your knees."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.15,
      "end_seconds": 256.34,
      "duration_seconds": 2.19,
      "text": "I'll try. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.77,
      "end_seconds": 266.05,
      "duration_seconds": 6.28,
      "text": "Most back pain like this settles in a couple of weeks. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.19,
      "end_seconds": 273.82,
      "duration_seconds": 3.63,
      "text": "That's good to hear. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.14,
      "end_seconds": 287.31,
      "duration_seconds": 10.17,
      "text": "If it hasn't improved in two weeks, or if you get any weakness in your legs, come back and see me."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 290.87,
      "end_seconds": 294.31,
      "duration_seconds": 3.44,
      "text": "I'll watch for that. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.97,
      "end_seconds": 300.99,
      "duration_seconds": 3.02,
      "text": "Thank you, doctor. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.14,
      "end_seconds": 306.02,
      "duration_seconds": 1.88,
      "text": "Take care. ~"
    }
  ]
}
