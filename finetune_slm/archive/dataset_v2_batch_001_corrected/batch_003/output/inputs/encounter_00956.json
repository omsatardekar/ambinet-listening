{
  "schema_version": "1.0",
  "encounter_id": "00956",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 1.75,
      "end_seconds": 15.03,
      "duration_seconds": 13.28,
      "text": "Doctor, I'm Meena, I look after Mrs Rao in the daytime. Her fingers go white, very white, in the cold. She wanted me here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.22,
      "end_seconds": 18.68,
      "duration_seconds": 1.46,
      "text": "Yes. White."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.05,
      "end_seconds": 24.88,
      "duration_seconds": 3.83,
      "text": "When does it happen, Mrs Rao?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.85,
      "end_seconds": 29.15,
      "duration_seconds": 2.3,
      "text": "Cold. Fridge. Winter."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 32.65,
      "end_seconds": 45.55,
      "duration_seconds": 12.9,
      "text": "Even when she takes the milk out of the fridge, doctor. And the tips of the fingers go blue after, and then red."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.54,
      "end_seconds": 50.37,
      "duration_seconds": 1.83,
      "text": "Is it painful?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.82,
      "end_seconds": 55.42,
      "duration_seconds": 2.6,
      "text": "When warm. Tingling. Pain."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 58.45,
      "end_seconds": 66.67,
      "duration_seconds": 8.22,
      "text": "It's worse in the evening, she rubs her hands together and she cries a little."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.88,
      "end_seconds": 72.63,
      "duration_seconds": 2.75,
      "text": "Any sores on the fingertips?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.16,
      "end_seconds": 76.76,
      "duration_seconds": 1.6,
      "text": "No sores."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.73,
      "end_seconds": 83.06,
      "duration_seconds": 4.33,
      "text": "What do you take at the moment?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.16,
      "end_seconds": 87.79,
      "duration_seconds": 2.63,
      "text": "Nifedipine. Ten. Two times."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 91.13,
      "end_seconds": 98.46,
      "duration_seconds": 7.33,
      "text": "Nifedipine, 10 mg, twice a day, doctor, that's what it says on the box."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.42,
      "end_seconds": 104.7,
      "duration_seconds": 3.28,
      "text": "Good. Is it helping? ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.74,
      "end_seconds": 109.8,
      "duration_seconds": 2.06,
      "text": "Little. ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 112.96,
      "end_seconds": 119.32,
      "duration_seconds": 6.36,
      "text": "A little, yes. She's not been wearing the gloves. ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.07,
      "end_seconds": 137.7,
      "duration_seconds": 5.63,
      "text": "Let me check you. Blood pressure 118 over 72, pulse 78."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.0,
      "end_seconds": 141.6,
      "duration_seconds": 1.6,
      "text": "Fine? ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.88,
      "end_seconds": 156.83,
      "duration_seconds": 4.95,
      "text": "Fine. Let me see your hands. Hold them out."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 160.58,
      "end_seconds": 163.09,
      "duration_seconds": 2.51,
      "text": "Show the doctor. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.44,
      "end_seconds": 167.41,
      "duration_seconds": 1.97,
      "text": "Here. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.28,
      "end_seconds": 177.49,
      "duration_seconds": 7.21,
      "text": "Your fingertips are pale and cool compared to the rest of your hand."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 180.36,
      "end_seconds": 185.56,
      "duration_seconds": 5.2,
      "text": "That's how they look in the clinic, too. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.46,
      "end_seconds": 198.43,
      "duration_seconds": 10.97,
      "text": "Now I'll explain. Raynaud's is when the small blood vessels in the fingers squeeze too tightly in the cold. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.74,
      "end_seconds": 202.9,
      "duration_seconds": 2.16,
      "text": "Squeeze. Yes. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.83,
      "end_seconds": 217.24,
      "duration_seconds": 12.41,
      "text": "It can be on its own, but sometimes it's linked to another condition, like an autoimmune one, and I can't rule that out yet."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 220.8,
      "end_seconds": 223.38,
      "duration_seconds": 2.58,
      "text": "Is it dangerous? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.05,
      "end_seconds": 238.73,
      "duration_seconds": 11.68,
      "text": "Not on its own. But I'd like to keep an eye on it. Keep her hands warm, wear gloves, and avoid smoking and caffeine."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 241.23,
      "end_seconds": 246.64,
      "duration_seconds": 5.41,
      "text": "She doesn't smoke. She drinks a lot of tea. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.07,
      "end_seconds": 253.02,
      "duration_seconds": 3.95,
      "text": "Maybe cut it to a few cups. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.62,
      "end_seconds": 257.4,
      "duration_seconds": 1.78,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 259.73,
      "end_seconds": 265.17,
      "duration_seconds": 5.44,
      "text": "Should she wear the gloves at night, too? ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.58,
      "end_seconds": 271.25,
      "duration_seconds": 3.67,
      "text": "Thin cotton ones can help, yes. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 274.14,
      "end_seconds": 276.87,
      "duration_seconds": 2.73,
      "text": "I'll make sure. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.73,
      "end_seconds": 284.68,
      "duration_seconds": 4.95,
      "text": "Mrs Rao, do you understand what I've said? ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.89,
      "end_seconds": 290.72,
      "duration_seconds": 2.83,
      "text": "Yes. Gloves. Warm. ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.28,
      "end_seconds": 298.98,
      "duration_seconds": 5.7,
      "text": "Exactly. I'd like to see you again in six weeks."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 302.48,
      "end_seconds": 306.0,
      "duration_seconds": 3.52,
      "text": "Six weeks. I'll bring her. ~"
    }
  ]
}
