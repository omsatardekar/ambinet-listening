{
  "schema_version": "1.0",
  "encounter_id": "00801",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 1.22,
      "end_seconds": 14.02,
      "duration_seconds": 12.8,
      "text": "Mrs Ingram, I'm Sally, the nurse. I'll do your measurements, then the doctor will go through the scan. Shoes off, please. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.37,
      "end_seconds": 21.17,
      "duration_seconds": 5.8,
      "text": "Oh dear, I hope it's not bad news. I'm so nervous. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 43.45,
      "end_seconds": 53.5,
      "duration_seconds": 10.05,
      "text": "Weight 54 kilos, height 160 centimetres, BMI 21.1. Blood pressure 120 over 74, pulse 70, temperature 36.5."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.06,
      "end_seconds": 59.95,
      "duration_seconds": 4.89,
      "text": "That height's gone down, hasn't it? ~"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 62.87,
      "end_seconds": 68.67,
      "duration_seconds": 5.8,
      "text": "A little, from last year. The doctor will explain. ~"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.31,
      "end_seconds": 78.41,
      "duration_seconds": 8.1,
      "text": "Good morning, Mrs Ingram. It's your bone density review, after the wrist fracture. How have you been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.26,
      "end_seconds": 95.77,
      "duration_seconds": 15.51,
      "text": "Fine, in the main. My back has been aching, low down, for some months, since the autumn, I think. Or was it the summer? I'm not sure."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.18,
      "end_seconds": 103.88,
      "duration_seconds": 5.7,
      "text": "Is it constant, or does it come with movement?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.74,
      "end_seconds": 113.59,
      "duration_seconds": 6.85,
      "text": "Worse when I bend, or lift, or get out of the car."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.68,
      "end_seconds": 121.17,
      "duration_seconds": 6.49,
      "text": "Any sudden severe back pain, a particular moment when it started?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.29,
      "end_seconds": 132.19,
      "duration_seconds": 9.9,
      "text": "No, it crept up. But I did slip on the ice in December, and landed on my bottom."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.69,
      "end_seconds": 142.53,
      "duration_seconds": 7.84,
      "text": "Any weakness in your legs, numbness, or trouble with your bladder or bowels?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.32,
      "end_seconds": 145.68,
      "duration_seconds": 2.36,
      "text": "No, none of that."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.45,
      "end_seconds": 152.85,
      "duration_seconds": 4.4,
      "text": "Have you lost height that you know of?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.09,
      "end_seconds": 159.84,
      "duration_seconds": 4.75,
      "text": "About three centimetres, I think. My trousers are longer."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.76,
      "end_seconds": 165.89,
      "duration_seconds": 3.13,
      "text": "Any allergies to medicines?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.14,
      "end_seconds": 177.09,
      "duration_seconds": 9.95,
      "text": "Alendronate, I came out in a terrible stomach upset and a rash, so they stopped it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.19,
      "end_seconds": 182.96,
      "duration_seconds": 3.77,
      "text": "Thank you, that's noted. Medical history?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.2,
      "end_seconds": 193.85,
      "duration_seconds": 8.65,
      "text": "I broke my wrist, two years ago, and I had an early menopause at forty-three."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.59,
      "end_seconds": 198.99,
      "duration_seconds": 2.4,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.23,
      "end_seconds": 207.1,
      "duration_seconds": 6.87,
      "text": "I gave up in 2010. Twenty a day, for thirty years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.4,
      "end_seconds": 229.95,
      "duration_seconds": 3.55,
      "text": "Let me look at your back."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.38,
      "end_seconds": 242.68,
      "duration_seconds": 10.3,
      "text": "There's tenderness over the lower spine, a mild curve in the upper back, and the movement is stiff."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 244.16,
      "end_seconds": 247.95,
      "duration_seconds": 3.79,
      "text": "Doctor, her scan result is in. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.95,
      "end_seconds": 269.71,
      "duration_seconds": 19.76,
      "text": "Thank you, Sally. Mrs Ingram, your bone density scan shows osteoporosis in the spine and the hip. I'd say this is osteoporosis, and your back pain could be from a small compression fracture."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.98,
      "end_seconds": 274.19,
      "duration_seconds": 3.21,
      "text": "Oh no. A fracture? ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.91,
      "end_seconds": 289.81,
      "duration_seconds": 14.9,
      "text": "Possibly, the loss of height fits. I'd like to arrange an X-ray of your spine, to look for fractures, and blood tests, including calcium and vitamin D."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.56,
      "end_seconds": 294.77,
      "duration_seconds": 3.21,
      "text": "Is it serious? ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.79,
      "end_seconds": 306.7,
      "duration_seconds": 9.91,
      "text": "It's treatable. Because the usual tablets upset your stomach, we'll choose a different treatment, such as a yearly infusion. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.29,
      "end_seconds": 311.87,
      "duration_seconds": 2.58,
      "text": "An infusion? ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.4,
      "end_seconds": 321.95,
      "duration_seconds": 7.55,
      "text": "A drip, once a year. I'll discuss it with you after the tests. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 323.43,
      "end_seconds": 328.75,
      "duration_seconds": 5.32,
      "text": "Shall I book the X-ray for tomorrow? ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.0,
      "end_seconds": 339.31,
      "duration_seconds": 9.31,
      "text": "Please do. Mrs Ingram, take calcium in your diet, get daily light exercise, and avoid heavy lifting."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.05,
      "end_seconds": 344.02,
      "duration_seconds": 1.97,
      "text": "I'll try. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.99,
      "end_seconds": 359.46,
      "duration_seconds": 12.47,
      "text": "And if you get sudden severe back pain, or any numbness in your legs, or trouble passing water, come in straight away."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 361.64,
      "end_seconds": 364.99,
      "duration_seconds": 3.35,
      "text": "I will. Thank you. ~"
    }
  ]
}
