{
  "schema_version": "1.0",
  "encounter_id": "00745",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.14,
      "end_seconds": 16.46,
      "duration_seconds": 15.32,
      "text": "Good afternoon, doctor. I'll be precise: I had a tick bite on my left thigh twelve days ago, and there's now a red patch that keeps getting bigger."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.04,
      "end_seconds": 24.34,
      "duration_seconds": 6.3,
      "text": "Thank you, that's very helpful. How big is it now?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.74,
      "end_seconds": 35.86,
      "duration_seconds": 10.12,
      "text": "I measured it this morning, about fifteen centimetres across. The centre's paler, so it looks like a target."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.24,
      "end_seconds": 41.35,
      "duration_seconds": 3.11,
      "text": "Is it painful or itchy?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.89,
      "end_seconds": 46.82,
      "duration_seconds": 3.93,
      "text": "A bit warm, and slightly itchy. Not painful."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.96,
      "end_seconds": 52.41,
      "duration_seconds": 3.45,
      "text": "Any fever, shivers, or headache?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.49,
      "end_seconds": 64.16,
      "duration_seconds": 9.67,
      "text": "No fever. I've felt a little tired, and I had a mild headache on Tuesday, but no stiff neck."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.27,
      "end_seconds": 70.84,
      "duration_seconds": 4.57,
      "text": "Any stiff neck, or facial drooping, or joint swelling?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.48,
      "end_seconds": 76.52,
      "duration_seconds": 3.04,
      "text": "No, none of that."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.32,
      "end_seconds": 82.49,
      "duration_seconds": 3.17,
      "text": "Are you on any medicines?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.29,
      "end_seconds": 88.65,
      "duration_seconds": 3.36,
      "text": "Omeprazole, 20 mg once a day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.51,
      "end_seconds": 92.55,
      "duration_seconds": 2.04,
      "text": "Any other conditions?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.42,
      "end_seconds": 97.2,
      "duration_seconds": 2.78,
      "text": "Asthma, mild, and eczema."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.61,
      "end_seconds": 100.02,
      "duration_seconds": 1.41,
      "text": "Any operations?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.25,
      "end_seconds": 105.53,
      "duration_seconds": 3.28,
      "text": "Tonsils out as a child."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.23,
      "end_seconds": 111.11,
      "duration_seconds": 3.88,
      "text": "Where were you when you were bitten?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.88,
      "end_seconds": 119.89,
      "duration_seconds": 7.01,
      "text": "Walking in the Scottish Highlands, I do a lot of hill walking."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.59,
      "end_seconds": 126.08,
      "duration_seconds": 3.49,
      "text": "Pulse and temperature first, please. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.96,
      "end_seconds": 129.77,
      "duration_seconds": 1.81,
      "text": "Of course. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.71,
      "end_seconds": 153.15,
      "duration_seconds": 8.44,
      "text": "Temperature 36.8, pulse 70, blood pressure 122 over 76, oxygen 99 percent, respiratory rate 14."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.52,
      "end_seconds": 158.18,
      "duration_seconds": 3.66,
      "text": "Good, no fever then. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.63,
      "end_seconds": 167.43,
      "duration_seconds": 6.8,
      "text": "Let me look at the patch. Could you pull your trousers up? ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.82,
      "end_seconds": 184.79,
      "duration_seconds": 0.97,
      "text": "Certainly."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.03,
      "end_seconds": 199.96,
      "duration_seconds": 13.93,
      "text": "There's an expanding red ring on the left thigh about fifteen centimetres across, with central clearing, and a tiny scab at the centre where the tick was."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.79,
      "end_seconds": 206.12,
      "duration_seconds": 4.33,
      "text": "That's what I thought, erythema migrans. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.19,
      "end_seconds": 221.03,
      "duration_seconds": 12.84,
      "text": "You've done your homework. The look of it, plus the tick bite, makes Lyme disease very likely, though I can't rule out cellulitis, which can look similar."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.18,
      "end_seconds": 225.44,
      "duration_seconds": 3.26,
      "text": "Do I need blood tests? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.13,
      "end_seconds": 244.57,
      "duration_seconds": 16.44,
      "text": "Not to start treatment, because the rash itself is enough. But I'd like to arrange blood tests, to check your baseline, and Lyme serology, though it can be negative this early."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.51,
      "end_seconds": 250.16,
      "duration_seconds": 2.65,
      "text": "Right. And treatment? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.0,
      "end_seconds": 259.54,
      "duration_seconds": 7.54,
      "text": "I'm going to prescribe doxycycline, 100 mg twice a day, for three weeks."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.65,
      "end_seconds": 264.91,
      "duration_seconds": 3.26,
      "text": "Three weeks? Not two? ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.87,
      "end_seconds": 279.52,
      "duration_seconds": 11.65,
      "text": "It's the current recommendation. Take it with food and a full glass of water, and stay out of strong sun."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.57,
      "end_seconds": 284.27,
      "duration_seconds": 2.7,
      "text": "I will. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.45,
      "end_seconds": 301.26,
      "duration_seconds": 15.81,
      "text": "If the rash is still spreading after a few days of treatment, or you develop a fever, a stiff neck, a droopy face, or joint swelling, come back or go to hospital."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.2,
      "end_seconds": 306.01,
      "duration_seconds": 1.81,
      "text": "Understood. ~"
    }
  ]
}
