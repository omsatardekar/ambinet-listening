{
  "schema_version": "1.0",
  "encounter_id": "00987",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 0.72,
      "end_seconds": 10.49,
      "duration_seconds": 9.77,
      "text": "Mr Gallagher, Paul, thanks for coming in. I understand you'd like to talk about planning ahead. Is that right? ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.55,
      "end_seconds": 22.84,
      "duration_seconds": 11.29,
      "text": "That's right. My son, Declan, thinks it's time, and I agree. I've been breathless lately, and it's made me think."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 24.47,
      "end_seconds": 29.13,
      "duration_seconds": 4.66,
      "text": "He's been getting puffed just crossing the room, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.15,
      "end_seconds": 38.68,
      "duration_seconds": 8.53,
      "text": "Let's talk about how you've been, first. How long has the breathlessness been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.63,
      "end_seconds": 44.71,
      "duration_seconds": 4.08,
      "text": "Since the winter. A few months now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.6,
      "end_seconds": 49.41,
      "duration_seconds": 2.81,
      "text": "Are you tired as well?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.54,
      "end_seconds": 54.7,
      "duration_seconds": 3.16,
      "text": "Wiped out by the afternoon."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.54,
      "end_seconds": 59.74,
      "duration_seconds": 3.2,
      "text": "Any swelling in your legs?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 60.75,
      "end_seconds": 64.41,
      "duration_seconds": 3.66,
      "text": "His ankles blow up by the evening."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.43,
      "end_seconds": 67.84,
      "duration_seconds": 2.41,
      "text": "Any chest pain?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.69,
      "end_seconds": 73.36,
      "duration_seconds": 2.67,
      "text": "No chest pain, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.34,
      "end_seconds": 77.87,
      "duration_seconds": 1.53,
      "text": "Any falls?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.94,
      "end_seconds": 81.76,
      "duration_seconds": 1.82,
      "text": "No falls."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.65,
      "end_seconds": 85.34,
      "duration_seconds": 1.69,
      "text": "Any confusion?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 87.14,
      "end_seconds": 90.18,
      "duration_seconds": 3.04,
      "text": "No, sharp as ever."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.55,
      "end_seconds": 96.27,
      "duration_seconds": 3.72,
      "text": "What tablets are you on?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.86,
      "end_seconds": 109.19,
      "duration_seconds": 10.33,
      "text": "Furosemide, 40 mg, in the morning. Ramipril, 2.5 mg, once a day. And bisoprolol, 1.25 mg, once a day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.24,
      "end_seconds": 112.13,
      "duration_seconds": 1.89,
      "text": "Any allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.8,
      "end_seconds": 118.37,
      "duration_seconds": 3.57,
      "text": "Morphine. It made me very sick."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.98,
      "end_seconds": 123.09,
      "duration_seconds": 2.11,
      "text": "Your health history?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.89,
      "end_seconds": 132.47,
      "duration_seconds": 6.58,
      "text": "Heart failure, high blood pressure, arthritis in my knees, and the prostate."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.88,
      "end_seconds": 135.27,
      "duration_seconds": 1.39,
      "text": "Operations?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.3,
      "end_seconds": 142.63,
      "duration_seconds": 5.33,
      "text": "A pacemaker, in 2019. And a hernia, in 2005."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.91,
      "end_seconds": 146.86,
      "duration_seconds": 2.95,
      "text": "Heart problems in the family?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.7,
      "end_seconds": 155.02,
      "duration_seconds": 5.32,
      "text": "My father had heart disease. My mother had a stroke."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.18,
      "end_seconds": 158.42,
      "duration_seconds": 2.24,
      "text": "Where do you live?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 159.4,
      "end_seconds": 166.74,
      "duration_seconds": 7.34,
      "text": "He lives alone, since Mum died. I'm ten minutes down the road."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.91,
      "end_seconds": 171.97,
      "duration_seconds": 4.06,
      "text": "And what did you do for work?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.69,
      "end_seconds": 175.63,
      "duration_seconds": 2.94,
      "text": "Farmer, forty years. Retired."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.41,
      "end_seconds": 177.64,
      "duration_seconds": 1.23,
      "text": "Smoking?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.82,
      "end_seconds": 183.47,
      "duration_seconds": 3.65,
      "text": "I gave up smoking in 1995."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.94,
      "end_seconds": 214.8,
      "duration_seconds": 13.86,
      "text": "Let me check you. Pulse 70, blood pressure 128 over 72, temperature 36.5, oxygen 94 percent, breathing 20, and weight 82 kilos."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 216.3,
      "end_seconds": 220.6,
      "duration_seconds": 4.3,
      "text": "Is the oxygen all right? ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.52,
      "end_seconds": 238.93,
      "duration_seconds": 6.41,
      "text": "A touch lower than I'd like, but it's his normal. Let me listen."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.0,
      "end_seconds": 243.35,
      "duration_seconds": 2.35,
      "text": "Take your time. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.41,
      "end_seconds": 248.93,
      "duration_seconds": 4.52,
      "text": "There's a little crackle at both lung bases."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.72,
      "end_seconds": 254.34,
      "duration_seconds": 2.62,
      "text": "That's the fluid. ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.47,
      "end_seconds": 262.36,
      "duration_seconds": 5.89,
      "text": "And I can see swelling at both ankles, pitting."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 263.6,
      "end_seconds": 267.52,
      "duration_seconds": 3.92,
      "text": "It was worse last week. ~"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.87,
      "end_seconds": 276.65,
      "duration_seconds": 6.78,
      "text": "Heart sounds are regular, and I can feel the pacemaker under the skin."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.29,
      "end_seconds": 282.38,
      "duration_seconds": 4.09,
      "text": "Yes, it's been good to me. ~"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.59,
      "end_seconds": 286.39,
      "duration_seconds": 2.8,
      "text": "Any palpitations or fluttering?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.68,
      "end_seconds": 290.94,
      "duration_seconds": 2.26,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.26,
      "end_seconds": 299.29,
      "duration_seconds": 6.03,
      "text": "What I see is heart failure that's stable but not perfect."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 302.01,
      "end_seconds": 305.7,
      "duration_seconds": 3.69,
      "text": "Is it getting worse? ~"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.09,
      "end_seconds": 324.32,
      "duration_seconds": 16.23,
      "text": "Slowly, over time, which is why this conversation matters. I'd like to arrange blood tests, including kidney function, an ECG, and an echocardiogram, to see how the heart is doing."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.24,
      "end_seconds": 329.68,
      "duration_seconds": 2.44,
      "text": "All right. ~"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.1,
      "end_seconds": 341.95,
      "duration_seconds": 9.85,
      "text": "And I'd like to sit down with you, Paul, and complete an advance care plan, so your wishes are written down."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.75,
      "end_seconds": 346.33,
      "duration_seconds": 3.58,
      "text": "That's what I came for. ~"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.46,
      "end_seconds": 353.6,
      "duration_seconds": 5.14,
      "text": "Let's talk about what matters most to you. ~"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 356.18,
      "end_seconds": 362.72,
      "duration_seconds": 6.54,
      "text": "Staying at home. And not being a burden to Declan. ~"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 364.17,
      "end_seconds": 367.6,
      "duration_seconds": 3.43,
      "text": "Dad, you're not a burden. ~"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.93,
      "end_seconds": 387.07,
      "duration_seconds": 17.14,
      "text": "Thank you for saying so, both of you. I'll write down that your priority is to stay at home, and we'll talk about hospital treatment another day, when we have the results."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 388.86,
      "end_seconds": 391.54,
      "duration_seconds": 2.68,
      "text": "That sounds sensible. ~"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 394.0,
      "end_seconds": 403.91,
      "duration_seconds": 9.91,
      "text": "If you become more breathless, or you're admitted to hospital, I'd like to see you again straight away."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 406.39,
      "end_seconds": 409.86,
      "duration_seconds": 3.47,
      "text": "We'll ring the surgery. ~"
    }
  ]
}
