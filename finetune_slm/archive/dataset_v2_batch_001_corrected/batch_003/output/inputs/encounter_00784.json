{
  "schema_version": "1.0",
  "encounter_id": "00784",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.02,
      "end_seconds": 10.58,
      "duration_seconds": 9.56,
      "text": "Hi. Um, it's the anxiety. It's been bad again. I can't switch my head off at night."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.89,
      "end_seconds": 18.25,
      "duration_seconds": 4.36,
      "text": "Tell me what happens at night."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.79,
      "end_seconds": 34.46,
      "duration_seconds": 14.67,
      "text": "I get into bed and my mind races. Work, money, everything. I lie there for two hours, then wake at four, and I'm back on the treadmill."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.57,
      "end_seconds": 42.39,
      "duration_seconds": 4.82,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.83,
      "end_seconds": 49.22,
      "duration_seconds": 4.39,
      "text": "About six weeks. Since I changed jobs."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.82,
      "end_seconds": 53.93,
      "duration_seconds": 3.11,
      "text": "Any physical symptoms with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.41,
      "end_seconds": 65.48,
      "duration_seconds": 9.07,
      "text": "My heart pounds, my chest feels tight, and I get sweaty hands. And I'm not eating much."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.79,
      "end_seconds": 71.36,
      "duration_seconds": 4.57,
      "text": "Any panic attacks, or thoughts of harming yourself?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.66,
      "end_seconds": 82.1,
      "duration_seconds": 9.44,
      "text": "A couple of panic attacks, on the train. But no, no thoughts of harming myself."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.27,
      "end_seconds": 89.82,
      "duration_seconds": 4.55,
      "text": "What are you taking at the moment?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.11,
      "end_seconds": 98.3,
      "duration_seconds": 6.19,
      "text": "Sertraline, 50 mg once a day. I've been on it three months."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.32,
      "end_seconds": 104.24,
      "duration_seconds": 2.92,
      "text": "Is it helping? ~"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.32,
      "end_seconds": 111.48,
      "duration_seconds": 5.16,
      "text": "A bit, in the daytime. Not at night. ~"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.6,
      "end_seconds": 116.65,
      "duration_seconds": 2.05,
      "text": "Any other conditions?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.3,
      "end_seconds": 121.64,
      "duration_seconds": 3.34,
      "text": "I had depression, years ago."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.23,
      "end_seconds": 126.14,
      "duration_seconds": 1.91,
      "text": "Any operations?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.59,
      "end_seconds": 130.95,
      "duration_seconds": 3.36,
      "text": "Wisdom teeth out, three years ago."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.85,
      "end_seconds": 138.19,
      "duration_seconds": 5.34,
      "text": "Do you have a drink to calm you down? ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.28,
      "end_seconds": 148.05,
      "duration_seconds": 6.77,
      "text": "A glass of wine, a couple of nights a week. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.45,
      "end_seconds": 155.09,
      "duration_seconds": 5.64,
      "text": "Let me check your pulse and blood pressure. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.18,
      "end_seconds": 159.99,
      "duration_seconds": 1.81,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.06,
      "end_seconds": 179.98,
      "duration_seconds": 5.92,
      "text": "Pulse 88, blood pressure 124 over 78, temperature 36.6."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.6,
      "end_seconds": 184.32,
      "duration_seconds": 2.72,
      "text": "Is it high? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.43,
      "end_seconds": 194.28,
      "duration_seconds": 6.85,
      "text": "Slightly fast, but normal. Any breathlessness, or chest pain that worries you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.95,
      "end_seconds": 200.53,
      "duration_seconds": 4.58,
      "text": "No, just tightness when I'm anxious. Nothing otherwise."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.73,
      "end_seconds": 213.97,
      "duration_seconds": 10.24,
      "text": "Right. I'd say this is a flare of your anxiety, on top of a big life change, with sleep suffering."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.57,
      "end_seconds": 218.15,
      "duration_seconds": 2.58,
      "text": "Will it go? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.49,
      "end_seconds": 234.48,
      "duration_seconds": 14.99,
      "text": "It usually settles with the right help. I'd like to arrange a blood test, to rule out something physical like your thyroid, and check your vitamin levels."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.72,
      "end_seconds": 237.64,
      "duration_seconds": 1.92,
      "text": "Fine. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.83,
      "end_seconds": 256.21,
      "duration_seconds": 17.38,
      "text": "And I'd like you to try a sleep routine, no screens an hour before bed, a notepad by your bed to write the worries down, and keep caffeine before noon."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.53,
      "end_seconds": 261.12,
      "duration_seconds": 3.59,
      "text": "The notepad's a good idea. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.13,
      "end_seconds": 271.19,
      "duration_seconds": 8.06,
      "text": "I'm also going to refer you for talking therapy, cognitive behavioural therapy, which is very effective."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.86,
      "end_seconds": 276.85,
      "duration_seconds": 2.99,
      "text": "How long's the wait? ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.88,
      "end_seconds": 286.39,
      "duration_seconds": 7.51,
      "text": "A few weeks. In the meantime, there are breathing exercises on the practice website."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.7,
      "end_seconds": 291.9,
      "duration_seconds": 3.2,
      "text": "I'll look them up. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.2,
      "end_seconds": 300.32,
      "duration_seconds": 7.12,
      "text": "I'd like to see you again in three weeks, to see how you're sleeping."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.29,
      "end_seconds": 305.97,
      "duration_seconds": 3.68,
      "text": "Three weeks. Thank you, doctor. ~"
    }
  ]
}
