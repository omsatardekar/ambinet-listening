{
  "schema_version": "1.0",
  "encounter_id": "00587",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 0.58,
      "end_seconds": 12.55,
      "duration_seconds": 11.97,
      "text": "Come in, Brendan, sit down. I have the note from your last visit here, and it seems Maureen is worried about your weight."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.42,
      "end_seconds": 22.68,
      "duration_seconds": 8.26,
      "text": "She is, doctor, and so am I now, to be honest. I can't stop thinking about it."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.27,
      "end_seconds": 30.72,
      "duration_seconds": 6.45,
      "text": "Okay. Tell me in your own words what's been happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.8,
      "end_seconds": 41.21,
      "duration_seconds": 9.41,
      "text": "I'm losing weight. My trousers are hanging off me, and the belt's on the last hole now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.64,
      "end_seconds": 44.81,
      "duration_seconds": 2.17,
      "text": "Since when, roughly?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.78,
      "end_seconds": 55.45,
      "duration_seconds": 7.67,
      "text": "About three months. Maybe a bit longer. Is that very bad? Should I be worried?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.13,
      "end_seconds": 61.59,
      "duration_seconds": 4.46,
      "text": "Let's find out first. Has your appetite changed?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.15,
      "end_seconds": 73.43,
      "duration_seconds": 9.28,
      "text": "I'm off my food, yeah. Maureen did a roast on Sunday and I couldn't finish it, which never happens."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.24,
      "end_seconds": 78.66,
      "duration_seconds": 3.42,
      "text": "Anything else you've noticed alongside that?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.94,
      "end_seconds": 87.43,
      "duration_seconds": 7.49,
      "text": "I'm tired too. Wrecked by the afternoon, even when I've done nothing at all."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.69,
      "end_seconds": 91.55,
      "duration_seconds": 2.86,
      "text": "Any vomiting at all?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.42,
      "end_seconds": 97.3,
      "duration_seconds": 2.88,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.53,
      "end_seconds": 104.22,
      "duration_seconds": 4.69,
      "text": "Any blood in your stool, or black motions?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.72,
      "end_seconds": 114.78,
      "duration_seconds": 8.06,
      "text": "No. Not that I've seen. Is that something I should be looking for?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.75,
      "end_seconds": 121.43,
      "duration_seconds": 5.68,
      "text": "It's a standard question. What about a cough that won't shift?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.33,
      "end_seconds": 127.03,
      "duration_seconds": 3.7,
      "text": "No cough. My chest has been grand."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.04,
      "end_seconds": 131.82,
      "duration_seconds": 2.78,
      "text": "Have you had fevers?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.36,
      "end_seconds": 139.42,
      "duration_seconds": 6.06,
      "text": "No fevers. I'd be at the thermometer all day, I'm that anxious."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.27,
      "end_seconds": 145.81,
      "duration_seconds": 3.54,
      "text": "And any trouble swallowing your food?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.63,
      "end_seconds": 152.35,
      "duration_seconds": 5.72,
      "text": "No, it all goes down fine. I just don't want it."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.97,
      "end_seconds": 158.92,
      "duration_seconds": 3.95,
      "text": "What about passing water, any trouble there?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.81,
      "end_seconds": 163.68,
      "duration_seconds": 2.87,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.32,
      "end_seconds": 172.28,
      "duration_seconds": 6.96,
      "text": "Okay. Let's go through your health history. What are you being treated for?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.45,
      "end_seconds": 183.07,
      "duration_seconds": 8.62,
      "text": "High blood pressure and high cholesterol. And an underactive thyroid. And reflux, now and then."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.0,
      "end_seconds": 189.5,
      "duration_seconds": 4.5,
      "text": "And what tablets are you on for those?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.26,
      "end_seconds": 200.41,
      "duration_seconds": 9.15,
      "text": "Ramipril, 5 mg once a day, for the blood pressure. And atorvastatin, 20 mg at night, for the cholesterol."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.14,
      "end_seconds": 205.13,
      "duration_seconds": 2.99,
      "text": "And the third one?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.51,
      "end_seconds": 214.79,
      "duration_seconds": 8.28,
      "text": "The thyroid tablet. 75 micrograms, maybe? I'd have to look at the box to be sure."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.93,
      "end_seconds": 224.9,
      "duration_seconds": 7.97,
      "text": "Fair enough, we'll check that. Have you had any surgery over the years?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.58,
      "end_seconds": 237.04,
      "duration_seconds": 9.46,
      "text": "I had my appendix out when I was twelve. And a knee replacement about six years ago."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.25,
      "end_seconds": 242.56,
      "duration_seconds": 3.31,
      "text": "Good. Any allergies to medicines?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.78,
      "end_seconds": 252.99,
      "duration_seconds": 9.21,
      "text": "Penicillin. I came out in a rash all over, years ago. My mother never let me forget it."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.06,
      "end_seconds": 258.25,
      "duration_seconds": 4.19,
      "text": "Noted. Is there anything serious in the family?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.05,
      "end_seconds": 270.38,
      "duration_seconds": 10.33,
      "text": "My father had bowel cancer. And my mother had a stroke. That's why I'm so on edge about all this."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.32,
      "end_seconds": 276.49,
      "duration_seconds": 4.17,
      "text": "That's understandable. Do you smoke, Brendan?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.41,
      "end_seconds": 284.23,
      "duration_seconds": 6.82,
      "text": "I stopped smoking fifteen years ago. Twenty a day for years before that, though."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.98,
      "end_seconds": 286.93,
      "duration_seconds": 1.95,
      "text": "And alcohol?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.53,
      "end_seconds": 296.82,
      "duration_seconds": 8.29,
      "text": "I drink a couple of pints on a Saturday, and that's the height of it."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.86,
      "end_seconds": 302.96,
      "duration_seconds": 5.1,
      "text": "What do you do for work, or are you retired?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.74,
      "end_seconds": 313.56,
      "duration_seconds": 9.82,
      "text": "Retired, I was a postman for thirty years. I live with Maureen, just the two of us now."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.06,
      "end_seconds": 323.57,
      "duration_seconds": 8.51,
      "text": "Right, let me take your vitals, and then have a feel of your tummy."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.64,
      "end_seconds": 349.71,
      "duration_seconds": 10.07,
      "text": "Blood pressure 138 over 84, pulse 88, temperature 36.8 degrees Celsius, oxygen 97 percent, and your weight is 71 kilograms."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.14,
      "end_seconds": 354.34,
      "duration_seconds": 3.2,
      "text": "Is that good or bad?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.14,
      "end_seconds": 375.74,
      "duration_seconds": 9.6,
      "text": "Mostly fine. The weight is the one that tells the story. Now lie back for me."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 396.02,
      "end_seconds": 403.89,
      "duration_seconds": 7.87,
      "text": "Your tummy is soft and there's no tenderness. There are no lumps in your neck either."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 404.72,
      "end_seconds": 409.06,
      "duration_seconds": 4.34,
      "text": "Thank God. So what is it, doctor?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 411.13,
      "end_seconds": 426.14,
      "duration_seconds": 15.01,
      "text": "I can't say for sure yet. My leading suspicion is that your thyroid tablet is a bit too strong for you, which can cause weight loss."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 427.33,
      "end_seconds": 434.26,
      "duration_seconds": 6.93,
      "text": "And the bowel cancer, with my father? I keep thinking about it."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 435.2,
      "end_seconds": 443.19,
      "duration_seconds": 7.99,
      "text": "We're going to rule things out properly. I'll order blood tests today, including your thyroid."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 445.83,
      "end_seconds": 456.57,
      "duration_seconds": 10.74,
      "text": "And I'd like a stool sample too, to be thorough, given your father's history. I'll give you a pot."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 458.99,
      "end_seconds": 466.04,
      "duration_seconds": 7.05,
      "text": "Right. Is there anything I should be doing in the meantime?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 468.03,
      "end_seconds": 478.03,
      "duration_seconds": 10.0,
      "text": "Three things. Eat little and often, add full-fat milk and butter where you can, and weigh yourself once a week."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 480.09,
      "end_seconds": 483.34,
      "duration_seconds": 3.25,
      "text": "Weekly. Maureen will love that."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 485.16,
      "end_seconds": 495.7,
      "duration_seconds": 10.54,
      "text": "And don't change any tablets yourself. Bring the thyroid box in so we can check the dose."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 497.36,
      "end_seconds": 508.76,
      "duration_seconds": 11.4,
      "text": "If you lose any more weight before the results are back, ring me straight away and I'll see you sooner."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 510.38,
      "end_seconds": 517.21,
      "duration_seconds": 6.83,
      "text": "I will, doctor. Thank you, I feel a little calmer now."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 518.52,
      "end_seconds": 525.02,
      "duration_seconds": 6.5,
      "text": "Good man. Mind yourself, and say hello to Maureen for me."
    }
  ]
}
