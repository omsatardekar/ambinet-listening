{
  "schema_version": "1.0",
  "encounter_id": "00896",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 3.18,
      "end_seconds": 12.08,
      "duration_seconds": 8.9,
      "text": "Doctor, I've got that awful pain again in my right side, like the kidney stone I had before."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.09,
      "end_seconds": 20.48,
      "duration_seconds": 5.39,
      "text": "I'm sorry to hear that. When did it start this time?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.8,
      "end_seconds": 31.88,
      "duration_seconds": 7.08,
      "text": "Yesterday evening, I think. Or maybe the night before, honestly I lost track."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.29,
      "end_seconds": 38.28,
      "duration_seconds": 2.99,
      "text": "Where do you feel it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.63,
      "end_seconds": 47.86,
      "duration_seconds": 5.23,
      "text": "Right side of my back, going round to the front."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.95,
      "end_seconds": 57.51,
      "duration_seconds": 5.56,
      "text": "Is it constant, or does it come in waves?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.07,
      "end_seconds": 65.44,
      "duration_seconds": 4.37,
      "text": "Waves. It builds, then eases off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.71,
      "end_seconds": 73.02,
      "duration_seconds": 4.31,
      "text": "Have you passed any blood in your urine?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.26,
      "end_seconds": 81.45,
      "duration_seconds": 5.19,
      "text": "No blood that I've seen, but it's dark."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.54,
      "end_seconds": 88.79,
      "duration_seconds": 3.25,
      "text": "Any fever or shivering? ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.07,
      "end_seconds": 95.2,
      "duration_seconds": 2.13,
      "text": "No fever. ~"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.55,
      "end_seconds": 103.55,
      "duration_seconds": 5.0,
      "text": "What medicines are you on at the moment?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.7,
      "end_seconds": 119.37,
      "duration_seconds": 12.67,
      "text": "Tamsulosin, 400 micrograms, once a day, from the last time. And diclofenac, 50 mg, three times a day, when the pain is bad."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.3,
      "end_seconds": 125.64,
      "duration_seconds": 3.34,
      "text": "Is the tamsulosin helping? ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.88,
      "end_seconds": 135.65,
      "duration_seconds": 6.77,
      "text": "I think so. It's not as bad as last time. ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.67,
      "end_seconds": 145.13,
      "duration_seconds": 6.46,
      "text": "Do you have any history of kidney stones, or other kidney problems?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.2,
      "end_seconds": 154.57,
      "duration_seconds": 5.37,
      "text": "One stone, two years ago. It passed by itself."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.59,
      "end_seconds": 163.21,
      "duration_seconds": 5.62,
      "text": "Let me check your numbers. Pulse, pressure, temperature. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.94,
      "end_seconds": 175.23,
      "duration_seconds": 1.29,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.57,
      "end_seconds": 187.13,
      "duration_seconds": 7.56,
      "text": "Pulse 84, blood pressure 136 over 86, temperature 36.9, oxygen 98 percent, breathing 16."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.25,
      "end_seconds": 192.34,
      "duration_seconds": 2.09,
      "text": "All right? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.42,
      "end_seconds": 208.06,
      "duration_seconds": 12.64,
      "text": "Nothing alarming, given you're in pain. I'd like to send a urine sample and do a blood test for your kidney function."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.15,
      "end_seconds": 216.36,
      "duration_seconds": 5.21,
      "text": "Okay. Can I give the urine sample here? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.43,
      "end_seconds": 224.47,
      "duration_seconds": 5.04,
      "text": "The nurse will show you the toilet. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.36,
      "end_seconds": 230.69,
      "duration_seconds": 3.33,
      "text": "And what happens after? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.57,
      "end_seconds": 244.04,
      "duration_seconds": 9.47,
      "text": "Depending on the results, a scan might be needed, but I'd rather wait for the tests first. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.63,
      "end_seconds": 251.3,
      "duration_seconds": 3.67,
      "text": "Should I keep taking the diclofenac? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.65,
      "end_seconds": 265.54,
      "duration_seconds": 10.89,
      "text": "Yes, with food, and not for more than a few days. Drink plenty of water through the day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.04,
      "end_seconds": 271.26,
      "duration_seconds": 2.22,
      "text": "How much? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.32,
      "end_seconds": 278.16,
      "duration_seconds": 3.84,
      "text": "Aim for two to three litres."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.51,
      "end_seconds": 284.69,
      "duration_seconds": 2.18,
      "text": "I'll try. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.62,
      "end_seconds": 298.68,
      "duration_seconds": 10.06,
      "text": "If you get a fever, vomiting, or the pain gets suddenly worse, come to the emergency department."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.87,
      "end_seconds": 306.02,
      "duration_seconds": 3.15,
      "text": "Right. Thank you. ~"
    }
  ]
}
