{
  "schema_version": "1.0",
  "encounter_id": "00872",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.58,
      "end_seconds": 17.85,
      "duration_seconds": 16.27,
      "text": "Hi, doctor! I'm Priya, and I'm here for my epilepsy review, I've got so much to tell you, because I had a seizure, one, since my last visit, and I haven't stopped worrying about it."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.99,
      "end_seconds": 26.31,
      "duration_seconds": 5.32,
      "text": "Thank you for telling me. When was the seizure?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.9,
      "end_seconds": 42.55,
      "duration_seconds": 12.65,
      "text": "Six weeks ago, on a Tuesday night. I was asleep, my husband woke up and I was shaking. It lasted about two minutes, he said."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.89,
      "end_seconds": 49.51,
      "duration_seconds": 3.62,
      "text": "How did you feel afterwards?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.34,
      "end_seconds": 59.88,
      "duration_seconds": 7.54,
      "text": "Awful. Confused, exhausted, a headache, and I'd bitten my tongue. I slept for twelve hours."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.21,
      "end_seconds": 66.19,
      "duration_seconds": 3.98,
      "text": "Did anything seem to trigger it? ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.28,
      "end_seconds": 80.19,
      "duration_seconds": 10.91,
      "text": "I'd missed two doses of my tablet that week, and I'd had a few late nights. And a glass of wine. ~"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.01,
      "end_seconds": 91.47,
      "duration_seconds": 9.46,
      "text": "That's an honest answer, thank you. Any other seizures, or odd episodes like staring or jerking?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.93,
      "end_seconds": 96.54,
      "duration_seconds": 2.61,
      "text": "No. None. Nothing else."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.89,
      "end_seconds": 104.54,
      "duration_seconds": 4.65,
      "text": "Any injuries, falls, or fits during the day?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.46,
      "end_seconds": 108.51,
      "duration_seconds": 1.05,
      "text": "No."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.24,
      "end_seconds": 113.51,
      "duration_seconds": 3.27,
      "text": "What are you taking?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.26,
      "end_seconds": 122.86,
      "duration_seconds": 6.6,
      "text": "Lamotrigine, 150 mg, twice a day. I've been on it for four years."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.21,
      "end_seconds": 129.31,
      "duration_seconds": 4.1,
      "text": "Any side effects, rashes, dizziness, double vision?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.16,
      "end_seconds": 134.85,
      "duration_seconds": 2.69,
      "text": "No. Nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.3,
      "end_seconds": 140.57,
      "duration_seconds": 2.27,
      "text": "Any other conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.46,
      "end_seconds": 151.11,
      "duration_seconds": 8.65,
      "text": "Epilepsy since I was fifteen. And I'm planning a pregnancy next year, that's partly why I came."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.55,
      "end_seconds": 157.18,
      "duration_seconds": 2.63,
      "text": "Good thinking. Any operations?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.84,
      "end_seconds": 162.6,
      "duration_seconds": 3.76,
      "text": "My appendix, when I was twenty."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.27,
      "end_seconds": 170.45,
      "duration_seconds": 5.18,
      "text": "Let me check your reflexes and coordination, for completeness. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.03,
      "end_seconds": 194.55,
      "duration_seconds": 1.52,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.08,
      "end_seconds": 210.41,
      "duration_seconds": 13.33,
      "text": "Everything looks normal. Priya, a single seizure after missed doses and poor sleep isn't a failure of treatment. The tablet works, when it's taken regularly. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.45,
      "end_seconds": 215.39,
      "duration_seconds": 2.94,
      "text": "That's a relief. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.82,
      "end_seconds": 230.52,
      "duration_seconds": 12.7,
      "text": "I'm not going to change the dose, but I'd like you to set a phone alarm for both doses, and use a weekly pill box."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.48,
      "end_seconds": 236.13,
      "duration_seconds": 2.65,
      "text": "I'll do both. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.28,
      "end_seconds": 244.76,
      "duration_seconds": 6.48,
      "text": "Keep a regular sleep routine, limit alcohol, and avoid skipping meals."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.85,
      "end_seconds": 249.44,
      "duration_seconds": 1.59,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.18,
      "end_seconds": 265.37,
      "duration_seconds": 13.19,
      "text": "For your pregnancy plans, lamotrigine is one of the safer options, but you'll need folic acid at a higher dose before you conceive, 5 mg once a day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.35,
      "end_seconds": 272.47,
      "duration_seconds": 4.12,
      "text": "Five milligrams. Okay. I'll start it. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.82,
      "end_seconds": 282.49,
      "duration_seconds": 7.67,
      "text": "Please come and see me before you try, and tell the pharmacy you're planning a pregnancy."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.1,
      "end_seconds": 287.4,
      "duration_seconds": 2.3,
      "text": "I will. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.22,
      "end_seconds": 301.03,
      "duration_seconds": 11.81,
      "text": "Keep the driving restriction in mind, you must not drive for the period the rules set after a seizure. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.17,
      "end_seconds": 306.01,
      "duration_seconds": 1.84,
      "text": "Understood. ~"
    }
  ]
}
