{
  "schema_version": "1.0",
  "encounter_id": "00570",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "FAMILY_MEMBER",
      "start_seconds": 1.01,
      "end_seconds": 11.19,
      "duration_seconds": 10.18,
      "text": "Hello, doctor. Sorry, it's Mia, she's been screaming in the night and I'm at my wits' end."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.8,
      "end_seconds": 24.62,
      "duration_seconds": 10.82,
      "text": "Come in, both of you. Hello Mia. Mum sounds tired, so let's work out what's going on, shall we?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 25.79,
      "end_seconds": 28.72,
      "duration_seconds": 2.93,
      "text": "Hello. I got a bunny."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.8,
      "end_seconds": 37.24,
      "duration_seconds": 6.44,
      "text": "A bunny, lovely. Mum, tell me what actually happens at night."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "FAMILY_MEMBER",
      "start_seconds": 40.05,
      "end_seconds": 52.9,
      "duration_seconds": 12.85,
      "text": "About an hour after she goes down, she sits up screaming, eyes wide open, but she doesn't know me. I'm holding her and she pushes me away."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.32,
      "end_seconds": 59.73,
      "duration_seconds": 4.41,
      "text": "How long does each episode go on for?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "FAMILY_MEMBER",
      "start_seconds": 60.94,
      "end_seconds": 70.08,
      "duration_seconds": 9.14,
      "text": "Ten minutes, maybe fifteen. Then she just flops back to sleep, and in the morning she remembers nothing."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.69,
      "end_seconds": 74.86,
      "duration_seconds": 3.17,
      "text": "And how often is this happening?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "FAMILY_MEMBER",
      "start_seconds": 77.56,
      "end_seconds": 84.66,
      "duration_seconds": 7.1,
      "text": "Two or three times a week now. It's been three weeks since it started."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.1,
      "end_seconds": 90.97,
      "duration_seconds": 3.87,
      "text": "Understood. Has anything changed at home lately?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "FAMILY_MEMBER",
      "start_seconds": 92.96,
      "end_seconds": 103.8,
      "duration_seconds": 10.84,
      "text": "We had a new baby in July, so it's all been a bit upside down. Mia's been very clingy since."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.5,
      "end_seconds": 112.78,
      "duration_seconds": 8.28,
      "text": "That's a big change for a four-year-old. Is she tired during the day?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "FAMILY_MEMBER",
      "start_seconds": 114.17,
      "end_seconds": 122.52,
      "duration_seconds": 8.35,
      "text": "Very. She's grumpy by lunchtime, and I had to carry her home from nursery on Monday."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.37,
      "end_seconds": 132.73,
      "duration_seconds": 8.36,
      "text": "Any fever, or has she banged her head, or been poorly in some other way?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "FAMILY_MEMBER",
      "start_seconds": 133.6,
      "end_seconds": 141.16,
      "duration_seconds": 7.56,
      "text": "No fever, and no bangs to the head. She's just had a stuffy nose for ages."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.87,
      "end_seconds": 149.91,
      "duration_seconds": 8.04,
      "text": "Let's come to the nose. Mia, can you breathe through your nose for me?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 150.72,
      "end_seconds": 153.3,
      "duration_seconds": 2.58,
      "text": "It's all stuck, Mummy."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.78,
      "end_seconds": 161.13,
      "duration_seconds": 5.35,
      "text": "Poor you. And how's her tummy and her bowels, generally?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "FAMILY_MEMBER",
      "start_seconds": 163.95,
      "end_seconds": 167.13,
      "duration_seconds": 3.18,
      "text": "All normal, regular as anything."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.0,
      "end_seconds": 176.96,
      "duration_seconds": 6.96,
      "text": "Good. Any other health problems, or operations she's had in the past?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "FAMILY_MEMBER",
      "start_seconds": 179.22,
      "end_seconds": 192.73,
      "duration_seconds": 13.51,
      "text": "She's had eczema since she was a baby, it's quiet at the moment. And she had grommets put in when she was two."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.57,
      "end_seconds": 203.75,
      "duration_seconds": 10.18,
      "text": "Right. Mia, I'm going to look in your nose with this little torch. Can you be brave?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 206.5,
      "end_seconds": 210.19,
      "duration_seconds": 3.69,
      "text": "Is it going to hurt?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.92,
      "end_seconds": 215.87,
      "duration_seconds": 3.95,
      "text": "Not a bit. It tickles, like a feather."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.83,
      "end_seconds": 246.32,
      "duration_seconds": 12.49,
      "text": "Her nose is blocked up on both sides, with clear mucus. Temperature is 36.8 degrees, pulse 98, and oxygen 99 percent."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.58,
      "end_seconds": 255.76,
      "duration_seconds": 8.18,
      "text": "Now let me listen to your chest, Mia. Big breath in, like a dragon."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 258.6,
      "end_seconds": 259.57,
      "duration_seconds": 0.97,
      "text": "Rawr."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.38,
      "end_seconds": 277.55,
      "duration_seconds": 5.17,
      "text": "Chest sounds clear, with good air going in and out."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "FAMILY_MEMBER",
      "start_seconds": 278.62,
      "end_seconds": 286.23,
      "duration_seconds": 7.61,
      "text": "Is that normal? Is something wrong with her? I keep thinking I'm doing something wrong."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.66,
      "end_seconds": 302.52,
      "duration_seconds": 13.86,
      "text": "You're not doing anything wrong. Tiredness and a blocked nose can both make sleep rougher, and so can a big change like a new baby."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "FAMILY_MEMBER",
      "start_seconds": 303.67,
      "end_seconds": 309.59,
      "duration_seconds": 5.92,
      "text": "What can we do? I can't keep going like this."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.03,
      "end_seconds": 324.7,
      "duration_seconds": 13.67,
      "text": "Three things. One, a steady bedtime routine at the same time every night. Two, something to clear that nose. Three, how you handle an episode when it happens."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "FAMILY_MEMBER",
      "start_seconds": 326.23,
      "end_seconds": 331.06,
      "duration_seconds": 4.83,
      "text": "Should I wake her up when she screams?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.87,
      "end_seconds": 346.41,
      "duration_seconds": 12.54,
      "text": "No, don't try to wake her. Stay close, keep her safe, speak softly, and let it pass. She won't remember it."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "FAMILY_MEMBER",
      "start_seconds": 349.22,
      "end_seconds": 353.58,
      "duration_seconds": 4.36,
      "text": "And what would you give for the nose?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.83,
      "end_seconds": 367.38,
      "duration_seconds": 11.55,
      "text": "I'll prescribe saline nose drops for the blocked nose, two drops in each nostril, twice a day, for a week or so."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "FAMILY_MEMBER",
      "start_seconds": 368.4,
      "end_seconds": 374.04,
      "duration_seconds": 5.64,
      "text": "Okay. Can she have anything to help her sleep?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 376.23,
      "end_seconds": 383.58,
      "duration_seconds": 7.35,
      "text": "No sleeping medicine, not at her age. The routine is safer and works better."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "FAMILY_MEMBER",
      "start_seconds": 386.21,
      "end_seconds": 391.57,
      "duration_seconds": 5.36,
      "text": "Right. Should I put her to bed earlier, or later?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 392.69,
      "end_seconds": 402.93,
      "duration_seconds": 10.24,
      "text": "Earlier, by half an hour. Overtired children often sleep worse, so try that for a couple of weeks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 405.46,
      "end_seconds": 409.25,
      "duration_seconds": 3.79,
      "text": "Mummy, can I have a sticker?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 411.7,
      "end_seconds": 418.56,
      "duration_seconds": 6.86,
      "text": "You've been so brave, Mia. Choose one from the pot, any colour you like."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "FAMILY_MEMBER",
      "start_seconds": 421.07,
      "end_seconds": 424.43,
      "duration_seconds": 3.36,
      "text": "What if it doesn't stop?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 425.72,
      "end_seconds": 435.22,
      "duration_seconds": 9.5,
      "text": "If it carries on for another month, bring her back and we'll think about the next steps."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "FAMILY_MEMBER",
      "start_seconds": 436.61,
      "end_seconds": 440.75,
      "duration_seconds": 4.14,
      "text": "And if she hurts herself during one?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 443.03,
      "end_seconds": 452.77,
      "duration_seconds": 9.74,
      "text": "Then ring us straight away, or go to A and E if it's out of hours."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "FAMILY_MEMBER",
      "start_seconds": 454.59,
      "end_seconds": 460.65,
      "duration_seconds": 6.06,
      "text": "Okay. Thank you, doctor. I feel a bit better just knowing that."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 463.21,
      "end_seconds": 467.93,
      "duration_seconds": 4.72,
      "text": "You're doing fine. Bye for now, Mia."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 470.11,
      "end_seconds": 472.44,
      "duration_seconds": 2.33,
      "text": "Bye bye, doctor."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "FAMILY_MEMBER",
      "start_seconds": 474.24,
      "end_seconds": 476.88,
      "duration_seconds": 2.64,
      "text": "Bye, and thanks again."
    }
  ]
}
