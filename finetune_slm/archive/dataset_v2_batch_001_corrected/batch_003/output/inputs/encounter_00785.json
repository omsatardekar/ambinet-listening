{
  "schema_version": "1.0",
  "encounter_id": "00785",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 2.54,
      "end_seconds": 13.28,
      "duration_seconds": 10.74,
      "text": "Doctor, thank you for fitting us in. It's Mum, she's getting out of breath just walking to the bathroom."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.33,
      "end_seconds": 25.3,
      "duration_seconds": 8.97,
      "text": "Hello, Mrs Brennan. Is that right, short of breath on the way to the bathroom?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.83,
      "end_seconds": 35.18,
      "duration_seconds": 6.35,
      "text": "Well, it's not that bad. I get a bit puffed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 38.14,
      "end_seconds": 45.41,
      "duration_seconds": 7.27,
      "text": "Mum, you have to sit down on the landing. Every time."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.41,
      "end_seconds": 52.42,
      "duration_seconds": 3.01,
      "text": "When did it start?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.41,
      "end_seconds": 62.18,
      "duration_seconds": 6.77,
      "text": "Oh, a while ago. A month? Two? I don't keep track."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 64.79,
      "end_seconds": 76.27,
      "duration_seconds": 11.48,
      "text": "I'd say it's been six weeks, since the cold, but I'm not certain either, Mum was already slow before it."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.28,
      "end_seconds": 86.03,
      "duration_seconds": 5.75,
      "text": "I'll note that neither of you is sure. Any chest pain?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.65,
      "end_seconds": 92.21,
      "duration_seconds": 2.56,
      "text": "No pain. No."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.08,
      "end_seconds": 100.71,
      "duration_seconds": 4.63,
      "text": "Any swelling of your legs, or a cough?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.24,
      "end_seconds": 107.92,
      "duration_seconds": 4.68,
      "text": "My ankles puff up by evening. No cough."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.93,
      "end_seconds": 114.42,
      "duration_seconds": 3.49,
      "text": "What tablets are you on?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 117.88,
      "end_seconds": 125.86,
      "duration_seconds": 7.98,
      "text": "Bisoprolol, 5 mg once a day, and furosemide, 40 mg in the morning."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.49,
      "end_seconds": 132.01,
      "duration_seconds": 3.52,
      "text": "And what are those for?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 136.06,
      "end_seconds": 141.34,
      "duration_seconds": 5.28,
      "text": "Her heart, she has heart failure, and high blood pressure."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.74,
      "end_seconds": 148.3,
      "duration_seconds": 4.56,
      "text": "Who is at home with you, Mrs Brennan?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.31,
      "end_seconds": 156.72,
      "duration_seconds": 4.41,
      "text": "I live alone. Sheila here pops in every day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.13,
      "end_seconds": 162.86,
      "duration_seconds": 3.73,
      "text": "Let me listen to your chest. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.64,
      "end_seconds": 180.68,
      "duration_seconds": 2.04,
      "text": "Go on."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.46,
      "end_seconds": 194.27,
      "duration_seconds": 9.81,
      "text": "The heart sounds are regular, and there are fine crackles at the bottom of both lungs. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 197.36,
      "end_seconds": 201.56,
      "duration_seconds": 4.2,
      "text": "Is it her heart, doctor? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.06,
      "end_seconds": 214.89,
      "duration_seconds": 10.83,
      "text": "With the heart failure history, and the ankle swelling, I'd say this is likely her heart failure getting worse, with fluid building up."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.07,
      "end_seconds": 220.49,
      "duration_seconds": 2.42,
      "text": "Oh, I see. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.97,
      "end_seconds": 235.32,
      "duration_seconds": 11.35,
      "text": "It's treatable. I'd like to arrange blood tests and a heart scan, an echocardiogram, to see how the heart is pumping."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 238.59,
      "end_seconds": 243.66,
      "duration_seconds": 5.07,
      "text": "Will she need to go into hospital? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.19,
      "end_seconds": 258.48,
      "duration_seconds": 11.29,
      "text": "Not today, if you can both watch her closely. The blood tests today, and the scan in the next two weeks."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 262.12,
      "end_seconds": 263.61,
      "duration_seconds": 1.49,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.9,
      "end_seconds": 280.53,
      "duration_seconds": 13.63,
      "text": "Please weigh her each morning, and ring me if her weight rises by two kilos in three days, or she's breathless at rest."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 283.55,
      "end_seconds": 285.4,
      "duration_seconds": 1.85,
      "text": "I will. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.14,
      "end_seconds": 299.73,
      "duration_seconds": 10.59,
      "text": "I'd like to see you both in a week, to check how she is and look at the blood results."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 302.12,
      "end_seconds": 306.0,
      "duration_seconds": 3.88,
      "text": "A week. Thank you, doctor. ~"
    }
  ]
}
