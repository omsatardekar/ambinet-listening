{
  "schema_version": "1.0",
  "encounter_id": "00993",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 5.17,
      "end_seconds": 16.06,
      "duration_seconds": 10.89,
      "text": "Morning, doctor. I'm Joy, I look after Mrs Hartnell. She's not sleeping, she's drenched at night, and I think it's her age."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.81,
      "end_seconds": 26.89,
      "duration_seconds": 5.08,
      "text": "Thank you, Joy. Mrs Hartnell, how are your nights?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.46,
      "end_seconds": 37.14,
      "duration_seconds": 4.68,
      "text": "Oh, not too bad, dear. A bit warm."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 42.66,
      "end_seconds": 47.02,
      "duration_seconds": 4.36,
      "text": "She changes her nightdress twice a night."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.13,
      "end_seconds": 54.97,
      "duration_seconds": 2.84,
      "text": "When did the sweats start?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.12,
      "end_seconds": 65.01,
      "duration_seconds": 4.89,
      "text": "Oh, I couldn't say. A while ago. Spring?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 70.4,
      "end_seconds": 75.99,
      "duration_seconds": 5.59,
      "text": "Before Easter, I thought. Or after. We've both lost track."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.72,
      "end_seconds": 86.85,
      "duration_seconds": 5.13,
      "text": "Fair enough. And during the day, any hot flushes?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.4,
      "end_seconds": 95.25,
      "duration_seconds": 2.85,
      "text": "No, none in the day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 100.4,
      "end_seconds": 109.36,
      "duration_seconds": 8.96,
      "text": "She goes bright red in the afternoons, doctor, and fans herself with the paper."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.1,
      "end_seconds": 129.8,
      "duration_seconds": 8.7,
      "text": "I'll write both. Let me check two numbers. Blood pressure 128 over 80, pulse 72."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.11,
      "end_seconds": 138.23,
      "duration_seconds": 3.12,
      "text": "Is it normal? ~"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.49,
      "end_seconds": 149.1,
      "duration_seconds": 5.61,
      "text": "Fine. Your skin feels warm and a little damp."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 154.82,
      "end_seconds": 160.13,
      "duration_seconds": 5.31,
      "text": "That's how she is at night, too. ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.41,
      "end_seconds": 173.94,
      "duration_seconds": 8.53,
      "text": "Here's what I'd suggest. Keep the bedroom cool, light cotton nightwear, and a fan."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 179.2,
      "end_seconds": 182.09,
      "duration_seconds": 2.89,
      "text": "We've got a fan. ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.57,
      "end_seconds": 193.01,
      "duration_seconds": 5.44,
      "text": "Avoid hot drinks and spicy food in the evening."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.19,
      "end_seconds": 201.64,
      "duration_seconds": 3.45,
      "text": "I do like my tea. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.94,
      "end_seconds": 210.53,
      "duration_seconds": 3.59,
      "text": "Decaf in the evening, then. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.68,
      "end_seconds": 218.31,
      "duration_seconds": 2.63,
      "text": "Very well. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.91,
      "end_seconds": 227.8,
      "duration_seconds": 3.89,
      "text": "Keep a note of when it happens."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 233.2,
      "end_seconds": 237.23,
      "duration_seconds": 4.03,
      "text": "I'll write it in her diary. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.55,
      "end_seconds": 245.11,
      "duration_seconds": 2.56,
      "text": "Thank you, dear. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.65,
      "end_seconds": 252.48,
      "duration_seconds": 1.83,
      "text": "You're welcome. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 257.94,
      "end_seconds": 260.35,
      "duration_seconds": 2.41,
      "text": "Thanks, doctor. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.86,
      "end_seconds": 267.55,
      "duration_seconds": 1.69,
      "text": "Goodbye. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.09,
      "end_seconds": 275.87,
      "duration_seconds": 2.78,
      "text": "Take care, both. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 281.2,
      "end_seconds": 283.05,
      "duration_seconds": 1.85,
      "text": "Bye. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.62,
      "end_seconds": 290.52,
      "duration_seconds": 1.9,
      "text": "Bye. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.89,
      "end_seconds": 298.36,
      "duration_seconds": 2.47,
      "text": "Safe home. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 304.07,
      "end_seconds": 306.02,
      "duration_seconds": 1.95,
      "text": "We will. ~"
    }
  ]
}
