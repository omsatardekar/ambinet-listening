{
  "schema_version": "1.0",
  "encounter_id": "00744",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.87,
      "end_seconds": 9.78,
      "duration_seconds": 7.91,
      "text": "Morning. It's my eyelid, it's been twitching for weeks. Left one. Drives me mad."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 12.78,
      "end_seconds": 14.97,
      "duration_seconds": 2.19,
      "text": "How many weeks?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.58,
      "end_seconds": 23.03,
      "duration_seconds": 5.45,
      "text": "Three, I think. Or four. Since the Easter break."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.21,
      "end_seconds": 31.32,
      "duration_seconds": 5.11,
      "text": "Is it there all day, or at certain times?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.89,
      "end_seconds": 42.24,
      "duration_seconds": 8.35,
      "text": "When I'm tired, mostly. And at my desk. It comes and goes, ten seconds, a minute."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.01,
      "end_seconds": 50.73,
      "duration_seconds": 5.72,
      "text": "Does your eye close fully, or does the eyelid droop?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.35,
      "end_seconds": 56.93,
      "duration_seconds": 3.58,
      "text": "No, no drooping. It just flickers."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.01,
      "end_seconds": 64.58,
      "duration_seconds": 5.57,
      "text": "Any double vision, or twitching elsewhere on your face?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.49,
      "end_seconds": 71.48,
      "duration_seconds": 4.99,
      "text": "No double vision. And no, only the eyelid."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.1,
      "end_seconds": 78.19,
      "duration_seconds": 3.09,
      "text": "Okay. Let's see what you're taking."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.16,
      "end_seconds": 92.88,
      "duration_seconds": 11.72,
      "text": "Sertraline, 50 mg once a day. And propranolol, 40 mg, maybe? For the shakes, when I need it. I'd have to check the box."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.33,
      "end_seconds": 103.02,
      "duration_seconds": 6.69,
      "text": "I'll check that on the record, thank you. Any other medical history?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.74,
      "end_seconds": 110.58,
      "duration_seconds": 4.84,
      "text": "Anxiety, which is why the tablets. Migraines. And hay fever."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.47,
      "end_seconds": 117.9,
      "duration_seconds": 4.43,
      "text": "How much caffeine are you having? ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.43,
      "end_seconds": 126.64,
      "duration_seconds": 5.21,
      "text": "Five or six coffees, I'm afraid. And energy drinks. ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.73,
      "end_seconds": 132.45,
      "duration_seconds": 2.72,
      "text": "And how's your sleep? ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.99,
      "end_seconds": 142.28,
      "duration_seconds": 6.29,
      "text": "Poor. Five hours a night, since the new project. ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.65,
      "end_seconds": 150.76,
      "duration_seconds": 5.11,
      "text": "Let me check your pulse and blood pressure. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.47,
      "end_seconds": 156.66,
      "duration_seconds": 2.19,
      "text": "Go on. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.44,
      "end_seconds": 175.54,
      "duration_seconds": 4.1,
      "text": "Pulse 78, blood pressure 124 over 80."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.6,
      "end_seconds": 181.04,
      "duration_seconds": 2.44,
      "text": "Is that okay? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.54,
      "end_seconds": 196.85,
      "duration_seconds": 13.31,
      "text": "Fine. You'll be glad to hear this is a very common benign twitch, caused by tiredness, stress and caffeine, and it settles when those do. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.21,
      "end_seconds": 204.46,
      "duration_seconds": 4.25,
      "text": "It's not a nerve thing? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.82,
      "end_seconds": 214.29,
      "duration_seconds": 7.47,
      "text": "Nothing you've described suggests a nerve problem. No droop, no double vision, no other muscles. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.58,
      "end_seconds": 220.27,
      "duration_seconds": 2.69,
      "text": "Right. That's a relief. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.96,
      "end_seconds": 231.32,
      "duration_seconds": 8.36,
      "text": "Cut your caffeine down to two cups, none after lunch, and no energy drinks."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.51,
      "end_seconds": 236.88,
      "duration_seconds": 3.37,
      "text": "That's going to hurt. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.55,
      "end_seconds": 249.61,
      "duration_seconds": 10.06,
      "text": "Try for seven hours' sleep, and take screen breaks every hour, with a few minutes of eyes closed."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.45,
      "end_seconds": 255.6,
      "duration_seconds": 3.15,
      "text": "I'll set an alarm. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.1,
      "end_seconds": 264.97,
      "duration_seconds": 6.87,
      "text": "Most twitches go in a few weeks once you do that. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.65,
      "end_seconds": 270.96,
      "duration_seconds": 3.31,
      "text": "And if it doesn't? ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.32,
      "end_seconds": 287.29,
      "duration_seconds": 13.97,
      "text": "I'd like to see you again in four weeks. If it's spreading to other parts of the face, or the eyelid starts to droop, come sooner."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.21,
      "end_seconds": 294.66,
      "duration_seconds": 5.45,
      "text": "I'll write it down. Where's my phone? ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.97,
      "end_seconds": 299.39,
      "duration_seconds": 2.42,
      "text": "In your hand. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.14,
      "end_seconds": 306.01,
      "duration_seconds": 3.87,
      "text": "So it is. Thank you. ~"
    }
  ]
}
