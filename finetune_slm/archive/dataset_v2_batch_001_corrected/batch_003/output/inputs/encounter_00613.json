{
  "schema_version": "1.0",
  "encounter_id": "00613",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 0.61,
      "end_seconds": 4.65,
      "duration_seconds": 4.04,
      "text": "Good morning. Ms Anjali Deshmukh, is that correct?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 5.75,
      "end_seconds": 8.0,
      "duration_seconds": 2.25,
      "text": "Yes, doctor. Good morning."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.92,
      "end_seconds": 18.2,
      "duration_seconds": 9.28,
      "text": "Please sit. I have a note from reception about your breasts. Tell me what is happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.47,
      "end_seconds": 28.24,
      "duration_seconds": 7.77,
      "text": "Nothing much, actually. Just breast tenderness before my periods. I thought I should mention it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.31,
      "end_seconds": 33.01,
      "duration_seconds": 3.7,
      "text": "Since when are you having this tenderness?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.19,
      "end_seconds": 40.82,
      "duration_seconds": 5.63,
      "text": "About six months now. It is not a big problem."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.63,
      "end_seconds": 46.54,
      "duration_seconds": 4.91,
      "text": "Does it come at a particular time of the month?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.6,
      "end_seconds": 54.45,
      "duration_seconds": 6.85,
      "text": "Yes, the week before my period. Then it goes away once the period starts."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.03,
      "end_seconds": 63.23,
      "duration_seconds": 7.2,
      "text": "That pattern is useful to know. Is anything else also happening in that week?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.51,
      "end_seconds": 72.8,
      "duration_seconds": 7.29,
      "text": "A little bloating. My stomach feels tight. I am also irritable, my husband says."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.52,
      "end_seconds": 77.96,
      "duration_seconds": 3.44,
      "text": "I see. And what about headaches?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.64,
      "end_seconds": 87.59,
      "duration_seconds": 8.95,
      "text": "Headaches, yes. But I cannot tell you when they began. Maybe a year, maybe longer. I never wrote it down."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.94,
      "end_seconds": 97.56,
      "duration_seconds": 7.62,
      "text": "That is fine, we will not worry about the exact timing. Any nipple discharge?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.79,
      "end_seconds": 100.47,
      "duration_seconds": 1.68,
      "text": "No discharge."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.05,
      "end_seconds": 107.63,
      "duration_seconds": 5.58,
      "text": "Any lump that you have felt in either breast?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.12,
      "end_seconds": 113.28,
      "duration_seconds": 4.16,
      "text": "No lumps. I checked in the bath."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.98,
      "end_seconds": 118.78,
      "duration_seconds": 2.8,
      "text": "Good. Any fever recently?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.67,
      "end_seconds": 121.43,
      "duration_seconds": 1.76,
      "text": "No fever."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.47,
      "end_seconds": 126.99,
      "duration_seconds": 4.52,
      "text": "Now, your medicines. What are you taking regularly?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.46,
      "end_seconds": 131.65,
      "duration_seconds": 3.19,
      "text": "Metformin, 500 mg, twice a day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.44,
      "end_seconds": 134.21,
      "duration_seconds": 1.77,
      "text": "Every day, twice?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.63,
      "end_seconds": 147.08,
      "duration_seconds": 10.45,
      "text": "Yes, twice a day. Though some nights I forget the second one. So I am not sure I take it every single day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.41,
      "end_seconds": 154.39,
      "duration_seconds": 5.98,
      "text": "Thank you for being honest. That is important for us. What else?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.48,
      "end_seconds": 162.97,
      "duration_seconds": 6.49,
      "text": "Levothyroxine, in the morning. I think 50 micrograms, maybe? I am not fully sure."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.5,
      "end_seconds": 170.42,
      "duration_seconds": 4.92,
      "text": "We will confirm the dose from your records. Anything else?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.42,
      "end_seconds": 177.16,
      "duration_seconds": 5.74,
      "text": "A vitamin D capsule, 60000 units, once a week on Sundays."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.02,
      "end_seconds": 183.86,
      "duration_seconds": 4.84,
      "text": "Good. Do you have any allergies to medicines?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.35,
      "end_seconds": 192.03,
      "duration_seconds": 6.68,
      "text": "Yes, sulpha drugs. My mother told me. I do not remember what reaction happened."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.2,
      "end_seconds": 199.04,
      "duration_seconds": 5.84,
      "text": "Alright. Sulpha drugs, reaction not remembered. I will note it clearly."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.09,
      "end_seconds": 206.11,
      "duration_seconds": 6.02,
      "text": "What medical conditions do you have, along with those tablets?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.77,
      "end_seconds": 212.49,
      "duration_seconds": 5.72,
      "text": "PCOS, since college. Thyroid problem, hypothyroidism. And sugar, type 2 diabetes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.67,
      "end_seconds": 220.03,
      "duration_seconds": 6.36,
      "text": "PCOS, hypothyroidism and type 2 diabetes. Have you had any operations?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.75,
      "end_seconds": 225.26,
      "duration_seconds": 2.51,
      "text": "Appendix removal, in 2015."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.03,
      "end_seconds": 233.26,
      "duration_seconds": 5.23,
      "text": "Any illnesses in your family that I should know about?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.42,
      "end_seconds": 240.1,
      "duration_seconds": 4.68,
      "text": "My father has high blood pressure. That is all."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.97,
      "end_seconds": 244.74,
      "duration_seconds": 3.77,
      "text": "And what work do you do?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.54,
      "end_seconds": 250.65,
      "duration_seconds": 4.11,
      "text": "I am a software engineer. Sitting job, mostly."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.15,
      "end_seconds": 254.88,
      "duration_seconds": 2.73,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.78,
      "end_seconds": 260.36,
      "duration_seconds": 3.58,
      "text": "No, I do not drink alcohol."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.19,
      "end_seconds": 263.3,
      "duration_seconds": 2.11,
      "text": "And your diet?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.54,
      "end_seconds": 265.94,
      "duration_seconds": 1.4,
      "text": "Vegetarian, always."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.68,
      "end_seconds": 278.83,
      "duration_seconds": 5.15,
      "text": "Thank you. Now, let me take some measurements."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.9,
      "end_seconds": 299.15,
      "duration_seconds": 6.25,
      "text": "Blood pressure 124 over 80. Pulse 76. Oxygen saturation 99 percent."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.12,
      "end_seconds": 303.49,
      "duration_seconds": 2.37,
      "text": "Is it normal?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.57,
      "end_seconds": 314.25,
      "duration_seconds": 8.68,
      "text": "Quite normal. Your weight is 62 kilos and your height is 160 centimetres. That gives a BMI of 24.2."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.92,
      "end_seconds": 319.07,
      "duration_seconds": 4.15,
      "text": "How is your breathing generally? Any trouble?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.68,
      "end_seconds": 322.61,
      "duration_seconds": 1.93,
      "text": "Breathing is fine."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.0,
      "end_seconds": 329.24,
      "duration_seconds": 4.24,
      "text": "And your heart, any chest pain or racing?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.27,
      "end_seconds": 333.88,
      "duration_seconds": 2.61,
      "text": "Heart is fine also."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.79,
      "end_seconds": 354.96,
      "duration_seconds": 5.17,
      "text": "Good. Now I will examine your breasts. Please lie back."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.2,
      "end_seconds": 369.34,
      "duration_seconds": 6.14,
      "text": "Both breasts look symmetrical. There is mild tenderness on pressing, on both sides."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 371.44,
      "end_seconds": 374.57,
      "duration_seconds": 3.13,
      "text": "Yes, that is the tender place."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 384.48,
      "end_seconds": 391.28,
      "duration_seconds": 6.8,
      "text": "I am now checking under the arms. The glands there are not enlarged."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 392.02,
      "end_seconds": 394.77,
      "duration_seconds": 2.75,
      "text": "That is good, no?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 396.54,
      "end_seconds": 404.08,
      "duration_seconds": 7.54,
      "text": "Yes, good. You can sit up now. Let me explain my thinking step by step."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 406.87,
      "end_seconds": 417.1,
      "duration_seconds": 10.23,
      "text": "Pain before periods is usually related to hormone changes. I cannot rule out fibrocystic breast changes, which are harmless but common."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 418.41,
      "end_seconds": 420.82,
      "duration_seconds": 2.41,
      "text": "Fibrocystic? Is it cancer?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 423.46,
      "end_seconds": 431.87,
      "duration_seconds": 8.41,
      "text": "No, it is not a cancer. I only mention the name so you know what we are considering."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 432.97,
      "end_seconds": 442.69,
      "duration_seconds": 9.72,
      "text": "I also cannot rule out a thyroid or hormone imbalance contributing, since you have the thyroid condition."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 444.12,
      "end_seconds": 451.47,
      "duration_seconds": 7.35,
      "text": "So I would like to order a thyroid function test, and a prolactin level."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 454.19,
      "end_seconds": 455.49,
      "duration_seconds": 1.3,
      "text": "Blood test?"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 457.13,
      "end_seconds": 464.37,
      "duration_seconds": 7.24,
      "text": "Yes, one sample. I will add an HbA1c as well, to check your sugar control."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 465.66,
      "end_seconds": 470.62,
      "duration_seconds": 4.96,
      "text": "I will also arrange a breast ultrasound, just to be thorough."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 473.09,
      "end_seconds": 476.42,
      "duration_seconds": 3.33,
      "text": "When can I do it?"
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 478.11,
      "end_seconds": 484.59,
      "duration_seconds": 6.48,
      "text": "The front desk will give you a slot. Please do all tests this week."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 486.96,
      "end_seconds": 489.36,
      "duration_seconds": 2.4,
      "text": "I will go today."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 490.77,
      "end_seconds": 498.08,
      "duration_seconds": 7.31,
      "text": "Good. For the tenderness, a well-fitting supportive bra helps, and cutting down caffeine."
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 500.23,
      "end_seconds": 509.51,
      "duration_seconds": 9.28,
      "text": "Please come back in three weeks with the reports, and we will decide the next step together."
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 510.53,
      "end_seconds": 514.81,
      "duration_seconds": 4.28,
      "text": "Three weeks, I will book it. Thank you, doctor."
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 517.54,
      "end_seconds": 525.0,
      "duration_seconds": 7.46,
      "text": "You are welcome. Take care of yourself, and do not downplay things next time."
    }
  ]
}
