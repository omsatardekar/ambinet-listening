{
  "schema_version": "1.0",
  "encounter_id": "00865",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.56,
      "end_seconds": 19.68,
      "duration_seconds": 19.12,
      "text": "Hello there! I've come for my spirometry results, the breathing test. I don't have any symptoms, I want to be clear, but my daughter says I should have it checked because I've smoked for years."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.95,
      "end_seconds": 32.55,
      "duration_seconds": 10.6,
      "text": "That's a sensible approach. Before we look at the results, let me ask a few things. How many years did you smoke?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.12,
      "end_seconds": 40.12,
      "duration_seconds": 6.0,
      "text": "Thirty-five years. Twenty a day. I gave up two years ago."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.4,
      "end_seconds": 45.47,
      "duration_seconds": 4.07,
      "text": "Any cough, or wheeze, or breathlessness? ~"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.13,
      "end_seconds": 54.24,
      "duration_seconds": 7.11,
      "text": "None, honestly. I walk the dog for an hour every day. ~"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.1,
      "end_seconds": 59.75,
      "duration_seconds": 2.65,
      "text": "What are you taking?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.22,
      "end_seconds": 71.87,
      "duration_seconds": 10.65,
      "text": "A statin, atorvastatin, 20 mg at night, and a tablet for blood pressure, ramipril, 5 mg once a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.48,
      "end_seconds": 76.66,
      "duration_seconds": 2.18,
      "text": "Any health conditions?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.66,
      "end_seconds": 81.52,
      "duration_seconds": 3.86,
      "text": "High cholesterol, and high blood pressure."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.03,
      "end_seconds": 84.83,
      "duration_seconds": 1.8,
      "text": "Any operations?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.14,
      "end_seconds": 90.39,
      "duration_seconds": 4.25,
      "text": "Just my appendix, as a teenager."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.61,
      "end_seconds": 96.17,
      "duration_seconds": 3.56,
      "text": "Any lung problems in the family?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.99,
      "end_seconds": 101.47,
      "duration_seconds": 2.48,
      "text": "My father had emphysema."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.53,
      "end_seconds": 108.26,
      "duration_seconds": 4.73,
      "text": "Right. Let me check your numbers. ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.08,
      "end_seconds": 113.39,
      "duration_seconds": 2.31,
      "text": "Go on. ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.18,
      "end_seconds": 133.43,
      "duration_seconds": 7.25,
      "text": "Pulse 72, blood pressure 130 over 80, oxygen 98 percent, weight 84 kilos."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.46,
      "end_seconds": 137.05,
      "duration_seconds": 1.59,
      "text": "Fine? ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.04,
      "end_seconds": 154.14,
      "duration_seconds": 15.1,
      "text": "Fine. Now, the spirometry results. Your FEV1, the amount you can blow out in one second, is 88 percent of what's predicted for your age and height, and the ratio is normal. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.36,
      "end_seconds": 157.59,
      "duration_seconds": 2.23,
      "text": "Is that good? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.24,
      "end_seconds": 166.43,
      "duration_seconds": 6.19,
      "text": "That's a normal result. There's no sign of COPD or obstruction. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.51,
      "end_seconds": 170.91,
      "duration_seconds": 2.4,
      "text": "That's a relief. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.48,
      "end_seconds": 183.06,
      "duration_seconds": 10.58,
      "text": "Given your history of smoking, I'm glad we checked. It tells me your lungs have come through remarkably well. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.73,
      "end_seconds": 189.54,
      "duration_seconds": 3.81,
      "text": "What about my father's emphysema? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.54,
      "end_seconds": 200.34,
      "duration_seconds": 7.8,
      "text": "Emphysema in a heavy smoker is usually due to smoking itself, and not strongly inherited. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.83,
      "end_seconds": 204.74,
      "duration_seconds": 1.91,
      "text": "That's good. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.2,
      "end_seconds": 214.45,
      "duration_seconds": 8.25,
      "text": "You've done the right thing by stopping. The risk to your lungs falls every year. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.03,
      "end_seconds": 221.11,
      "duration_seconds": 4.08,
      "text": "I feel proud of that. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.04,
      "end_seconds": 236.86,
      "duration_seconds": 13.82,
      "text": "You should. I'd like to arrange a lung cancer screening check, a low-dose scan, as you may qualify, given your age and smoking history."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.82,
      "end_seconds": 242.87,
      "duration_seconds": 3.05,
      "text": "A scan? Is that necessary? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.9,
      "end_seconds": 259.06,
      "duration_seconds": 14.16,
      "text": "It's a screening offer for people in your group, to catch problems early, when they're easiest to treat. I'd like you to have it. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.25,
      "end_seconds": 262.15,
      "duration_seconds": 1.9,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.73,
      "end_seconds": 275.77,
      "duration_seconds": 12.04,
      "text": "And I'd also like to arrange a blood test, to check your cholesterol and kidney function, since you're on the statin and ramipril."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.44,
      "end_seconds": 278.85,
      "duration_seconds": 1.41,
      "text": "Fine. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.41,
      "end_seconds": 287.26,
      "duration_seconds": 6.85,
      "text": "Keep walking the dog, keep off cigarettes, and have your flu and pneumonia jabs."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.05,
      "end_seconds": 292.06,
      "duration_seconds": 4.01,
      "text": "I've had the flu jab. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.5,
      "end_seconds": 301.93,
      "duration_seconds": 7.43,
      "text": "Good. I'd like to see you again in three months, with the scan result."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.25,
      "end_seconds": 307.17,
      "duration_seconds": 3.92,
      "text": "Three months. Thank you, doctor. ~"
    }
  ]
}
