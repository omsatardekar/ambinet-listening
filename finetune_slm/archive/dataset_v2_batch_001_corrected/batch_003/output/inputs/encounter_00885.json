{
  "schema_version": "1.0",
  "encounter_id": "00885",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 2.48,
      "end_seconds": 12.56,
      "duration_seconds": 10.08,
      "text": "Doctor, my tummy has been swelling up over the past few weeks, and I feel full after only a few bites."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.79,
      "end_seconds": 24.64,
      "duration_seconds": 8.85,
      "text": "I'm sorry to hear that. Let's go through it step by step. When did the swelling begin?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.71,
      "end_seconds": 34.09,
      "duration_seconds": 6.38,
      "text": "About six weeks ago. It's gradual, my trousers are getting tight."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.23,
      "end_seconds": 41.92,
      "duration_seconds": 4.69,
      "text": "And the feeling of fullness, is it every meal?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.97,
      "end_seconds": 52.13,
      "duration_seconds": 6.16,
      "text": "Almost every meal. I eat a few bites and that's it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.95,
      "end_seconds": 61.12,
      "duration_seconds": 5.17,
      "text": "Have you lost any weight, or had nausea or vomiting?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.67,
      "end_seconds": 70.01,
      "duration_seconds": 5.34,
      "text": "I think I've lost a little weight, but no vomiting."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.48,
      "end_seconds": 78.22,
      "duration_seconds": 5.74,
      "text": "What about your bowels? Any change, or any blood?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.93,
      "end_seconds": 84.6,
      "duration_seconds": 3.67,
      "text": "No blood. Bowels are as usual."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.41,
      "end_seconds": 91.33,
      "duration_seconds": 2.92,
      "text": "What medicines do you take?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.16,
      "end_seconds": 103.1,
      "duration_seconds": 8.94,
      "text": "Omeprazole, 20 mg, once a day. Amlodipine, 5 mg, once a day. And calcium and vitamin D tablets."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.66,
      "end_seconds": 108.86,
      "duration_seconds": 2.2,
      "text": "Any other conditions?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.93,
      "end_seconds": 119.61,
      "duration_seconds": 7.68,
      "text": "Reflux, for about ten years. High blood pressure. And osteoporosis, diagnosed last year."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.53,
      "end_seconds": 126.77,
      "duration_seconds": 3.24,
      "text": "Thank you. Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.67,
      "end_seconds": 134.57,
      "duration_seconds": 4.9,
      "text": "A glass of wine with dinner, now and then."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.26,
      "end_seconds": 144.13,
      "duration_seconds": 5.87,
      "text": "Let me check your pulse, blood pressure and weight. ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.78,
      "end_seconds": 157.5,
      "duration_seconds": 1.72,
      "text": "Go on."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.63,
      "end_seconds": 168.76,
      "duration_seconds": 8.13,
      "text": "Pulse 80, blood pressure 128 over 80, temperature 36.7, oxygen 98 percent, weight 61 kilograms."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.85,
      "end_seconds": 176.31,
      "duration_seconds": 3.46,
      "text": "Is the weight all right? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.13,
      "end_seconds": 188.52,
      "duration_seconds": 9.39,
      "text": "I'll compare it with your last visit. Now please lie back so I can feel your tummy. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.26,
      "end_seconds": 207.23,
      "duration_seconds": 1.97,
      "text": "All right."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.24,
      "end_seconds": 219.35,
      "duration_seconds": 8.11,
      "text": "Your abdomen is distended, with some fullness in the upper part, and no tenderness."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.86,
      "end_seconds": 224.46,
      "duration_seconds": 2.6,
      "text": "Is it serious? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.0,
      "end_seconds": 239.13,
      "duration_seconds": 12.13,
      "text": "Early fullness and swelling need proper investigation, and I'm not able to say what it is from the examination alone."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.05,
      "end_seconds": 245.22,
      "duration_seconds": 3.17,
      "text": "What will you do? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.25,
      "end_seconds": 260.29,
      "duration_seconds": 12.04,
      "text": "I'll arrange blood tests and an ultrasound scan of your abdomen, and I'd also like you to see a stomach specialist."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.32,
      "end_seconds": 266.41,
      "duration_seconds": 3.09,
      "text": "A specialist? That sounds worrying. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.29,
      "end_seconds": 280.18,
      "duration_seconds": 10.89,
      "text": "It's to make sure we don't miss anything, because the fullness and weight loss need an explanation. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.98,
      "end_seconds": 288.46,
      "duration_seconds": 4.48,
      "text": "I understand. How long will it take? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.96,
      "end_seconds": 297.24,
      "duration_seconds": 6.28,
      "text": "The scan within two weeks, and I'll see you after the results."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.87,
      "end_seconds": 306.02,
      "duration_seconds": 6.15,
      "text": "All right. Thank you for being straight with me. ~"
    }
  ]
}
