{
  "schema_version": "1.0",
  "encounter_id": "00910",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 2.34,
      "end_seconds": 11.94,
      "duration_seconds": 9.6,
      "text": "Doctor, I'm still getting this pressure in my face. The spray you gave me isn't doing much."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.16,
      "end_seconds": 20.44,
      "duration_seconds": 5.28,
      "text": "Thanks for coming back. Where do you feel the pressure?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.99,
      "end_seconds": 29.9,
      "duration_seconds": 6.91,
      "text": "Around my cheeks and across my forehead. It's worse when I bend over."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.52,
      "end_seconds": 38.56,
      "duration_seconds": 5.04,
      "text": "And how long has it been going on now?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.59,
      "end_seconds": 43.62,
      "duration_seconds": 2.03,
      "text": "Nearly three weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.08,
      "end_seconds": 51.19,
      "duration_seconds": 5.11,
      "text": "Is there discharge from the nose, and what colour?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.79,
      "end_seconds": 58.03,
      "duration_seconds": 4.24,
      "text": "Thick and yellowish, mostly in the morning."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.52,
      "end_seconds": 65.14,
      "duration_seconds": 4.62,
      "text": "Any fever, or swelling around the eyes?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.05,
      "end_seconds": 72.59,
      "duration_seconds": 4.54,
      "text": "No fever. And my eyes look normal."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.66,
      "end_seconds": 81.49,
      "duration_seconds": 4.83,
      "text": "Let's go through what you're taking. Which spray is it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.11,
      "end_seconds": 91.61,
      "duration_seconds": 7.5,
      "text": "The steroid nasal spray, fluticasone, two sprays in each nostril, once a day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.25,
      "end_seconds": 97.98,
      "duration_seconds": 3.73,
      "text": "Are you using it every day?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.79,
      "end_seconds": 106.65,
      "duration_seconds": 4.86,
      "text": "Most days. I forget some mornings, to be honest."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.54,
      "end_seconds": 112.57,
      "duration_seconds": 2.03,
      "text": "Anything else?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.08,
      "end_seconds": 124.36,
      "duration_seconds": 9.28,
      "text": "Paracetamol, 1 gram, when the face is sore. And a saline rinse, twice a day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.39,
      "end_seconds": 134.9,
      "duration_seconds": 7.51,
      "text": "Good, the rinse helps. Do you have any other conditions, like hay fever or asthma?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.91,
      "end_seconds": 140.55,
      "duration_seconds": 2.64,
      "text": "Hay fever, every summer."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.34,
      "end_seconds": 149.92,
      "duration_seconds": 6.58,
      "text": "Let me check your pulse, blood pressure and temperature. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.79,
      "end_seconds": 162.14,
      "duration_seconds": 1.35,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.98,
      "end_seconds": 173.29,
      "duration_seconds": 8.31,
      "text": "Pulse 74, blood pressure 124 over 80, temperature 36.8, oxygen 99 percent, breathing 14."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.82,
      "end_seconds": 179.13,
      "duration_seconds": 2.31,
      "text": "All normal? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.04,
      "end_seconds": 189.67,
      "duration_seconds": 7.63,
      "text": "All normal. I'd like to look in your nose and press over the sinuses. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.82,
      "end_seconds": 207.4,
      "duration_seconds": 1.58,
      "text": "Go on."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.86,
      "end_seconds": 222.43,
      "duration_seconds": 12.57,
      "text": "I would say this is sinusitis, probably still viral, though the thick discharge makes me think of a bacterial cause."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.84,
      "end_seconds": 229.23,
      "duration_seconds": 3.39,
      "text": "Do I need antibiotics? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.43,
      "end_seconds": 242.2,
      "duration_seconds": 9.77,
      "text": "Not yet. Three weeks is long enough that I'd consider it, but let's do the basics properly first. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.27,
      "end_seconds": 248.43,
      "duration_seconds": 3.16,
      "text": "What are the basics? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.83,
      "end_seconds": 261.17,
      "duration_seconds": 9.34,
      "text": "Use the spray every single day, keep up the saline rinse, and take steam inhalations at night."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.24,
      "end_seconds": 266.93,
      "duration_seconds": 2.69,
      "text": "I will. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.65,
      "end_seconds": 283.48,
      "duration_seconds": 12.83,
      "text": "If it hasn't improved in a week, or you get a fever or swelling around the eyes, I'll prescribe an antibiotic."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.22,
      "end_seconds": 290.14,
      "duration_seconds": 2.92,
      "text": "That sounds fair. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.76,
      "end_seconds": 299.55,
      "duration_seconds": 5.79,
      "text": "Come back and see me then, and we'll decide together. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.24,
      "end_seconds": 305.99,
      "duration_seconds": 2.75,
      "text": "Thank you, doctor. ~"
    }
  ]
}
