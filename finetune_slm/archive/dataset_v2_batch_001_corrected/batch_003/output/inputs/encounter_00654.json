{
  "schema_version": "1.0",
  "encounter_id": "00654",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.24,
      "end_seconds": 7.36,
      "duration_seconds": 6.12,
      "text": "I'm here for the methotrexate bloods review. Hands are stiff but manageable."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.3,
      "end_seconds": 18.64,
      "duration_seconds": 8.34,
      "text": "Thanks for coming. Let's start with how the hands feel through the day."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.86,
      "end_seconds": 26.17,
      "duration_seconds": 6.31,
      "text": "Stiff in the morning, about an hour. Gone by lunch."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.61,
      "end_seconds": 31.73,
      "duration_seconds": 3.12,
      "text": "Any swelling in the knuckles?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.28,
      "end_seconds": 37.94,
      "duration_seconds": 4.66,
      "text": "A bit. Right hand, the middle knuckles."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.12,
      "end_seconds": 41.36,
      "duration_seconds": 2.24,
      "text": "How about your energy?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.19,
      "end_seconds": 46.08,
      "duration_seconds": 1.89,
      "text": "Tired. Mostly afternoons."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.8,
      "end_seconds": 53.28,
      "duration_seconds": 6.48,
      "text": "Any mouth ulcers since the dose went up? That's a common side effect."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.17,
      "end_seconds": 58.88,
      "duration_seconds": 3.71,
      "text": "A couple. They come and go."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.32,
      "end_seconds": 64.58,
      "duration_seconds": 4.26,
      "text": "Any cough or breathlessness, the kind that's new?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.87,
      "end_seconds": 69.03,
      "duration_seconds": 2.16,
      "text": "No. No cough."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.21,
      "end_seconds": 72.68,
      "duration_seconds": 2.47,
      "text": "Fever or chills?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.77,
      "end_seconds": 75.15,
      "duration_seconds": 1.38,
      "text": "None."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.39,
      "end_seconds": 80.37,
      "duration_seconds": 2.98,
      "text": "Easy bruising or bleeding gums?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.37,
      "end_seconds": 82.75,
      "duration_seconds": 1.38,
      "text": "No. Neither."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.58,
      "end_seconds": 87.16,
      "duration_seconds": 3.58,
      "text": "Nausea after the weekly dose?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.91,
      "end_seconds": 90.92,
      "duration_seconds": 2.01,
      "text": "No, not really."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.14,
      "end_seconds": 97.56,
      "duration_seconds": 4.42,
      "text": "Walk me through all the tablets, please."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.07,
      "end_seconds": 113.87,
      "duration_seconds": 13.8,
      "text": "Methotrexate, maybe 20 mg? Once a week. Folic acid, 5 mg, the day after. Hydroxychloroquine, 200 mg twice a day. And omeprazole, 20 mg, in the morning."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.2,
      "end_seconds": 124.0,
      "duration_seconds": 8.8,
      "text": "You said maybe 20 for the methotrexate. Do you have the box with you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.74,
      "end_seconds": 128.4,
      "duration_seconds": 3.66,
      "text": "No. Left it on the side. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.27,
      "end_seconds": 137.89,
      "duration_seconds": 7.62,
      "text": "I'll check with the pharmacy before we change anything. Any allergies to medicines?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.78,
      "end_seconds": 142.32,
      "duration_seconds": 1.54,
      "text": "Penicillin. Hives."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.07,
      "end_seconds": 149.07,
      "duration_seconds": 4.0,
      "text": "Thank you. Any other health problems?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.98,
      "end_seconds": 155.1,
      "duration_seconds": 5.12,
      "text": "Rheumatoid arthritis, since 2019. Acid reflux. And mild asthma."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.92,
      "end_seconds": 159.48,
      "duration_seconds": 1.56,
      "text": "Previous surgery?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.89,
      "end_seconds": 167.16,
      "duration_seconds": 5.27,
      "text": "Carpal tunnel release, right wrist, three years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.09,
      "end_seconds": 171.04,
      "duration_seconds": 2.95,
      "text": "Arthritis in the family?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.22,
      "end_seconds": 175.99,
      "duration_seconds": 3.77,
      "text": "My mother had rheumatoid arthritis too."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.12,
      "end_seconds": 179.75,
      "duration_seconds": 2.63,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.03,
      "end_seconds": 184.03,
      "duration_seconds": 2.0,
      "text": "Never smoked."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.21,
      "end_seconds": 190.55,
      "duration_seconds": 5.34,
      "text": "Alcohol? With methotrexate we like it to be low."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.96,
      "end_seconds": 195.63,
      "duration_seconds": 3.67,
      "text": "A glass of wine. Saturdays."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.63,
      "end_seconds": 199.41,
      "duration_seconds": 1.78,
      "text": "And your work?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.34,
      "end_seconds": 204.66,
      "duration_seconds": 2.32,
      "text": "Primary school teacher."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.8,
      "end_seconds": 208.8,
      "duration_seconds": 2.0,
      "text": "Any exercise?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.66,
      "end_seconds": 216.29,
      "duration_seconds": 4.63,
      "text": "Yoga, twice a week. It helps the hands."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.45,
      "end_seconds": 246.41,
      "duration_seconds": 13.96,
      "text": "Good. Your pulse is 70, blood pressure 118 over 74, temperature 36.6, oxygen 98 percent, breathing 14, and your weight is 66 kilos."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.1,
      "end_seconds": 252.15,
      "duration_seconds": 3.05,
      "text": "Same as before? ~"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.95,
      "end_seconds": 265.89,
      "duration_seconds": 3.94,
      "text": "Very similar. Show me your hands, please."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.01,
      "end_seconds": 269.7,
      "duration_seconds": 1.69,
      "text": "There. ~"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.14,
      "end_seconds": 280.64,
      "duration_seconds": 8.5,
      "text": "I can see swelling over the right middle knuckles, and there's tenderness squeezing across the right hand."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.49,
      "end_seconds": 285.68,
      "duration_seconds": 2.19,
      "text": "Yes, that hurts. ~"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.13,
      "end_seconds": 298.05,
      "duration_seconds": 10.92,
      "text": "The left hand looks normal, no swelling. And in your mouth there are two small ulcers on the inner cheek."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.96,
      "end_seconds": 302.47,
      "duration_seconds": 2.51,
      "text": "I told you. ~"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.69,
      "end_seconds": 308.56,
      "duration_seconds": 4.87,
      "text": "Now your chest. Any problem with your breathing today?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.87,
      "end_seconds": 311.95,
      "duration_seconds": 2.08,
      "text": "No. Breathing's fine."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.39,
      "end_seconds": 324.98,
      "duration_seconds": 10.59,
      "text": "Good. My impression is a mild flare of the arthritis, but I can't rule out the methotrexate causing those mouth ulcers."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.14,
      "end_seconds": 330.02,
      "duration_seconds": 2.88,
      "text": "So what now? ~"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.69,
      "end_seconds": 345.81,
      "duration_seconds": 14.12,
      "text": "I'd like to arrange blood tests for your blood count and liver, and a chest X-ray, since you've been on this a while."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.03,
      "end_seconds": 349.44,
      "duration_seconds": 2.41,
      "text": "And the hands? ~"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.14,
      "end_seconds": 359.63,
      "duration_seconds": 7.49,
      "text": "I'll also arrange X-rays of your hands to check the joints haven't changed."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 361.6,
      "end_seconds": 363.43,
      "duration_seconds": 1.83,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.64,
      "end_seconds": 373.39,
      "duration_seconds": 8.75,
      "text": "I'd like to see you again in three months, sooner if the ulcers get worse."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 375.41,
      "end_seconds": 378.37,
      "duration_seconds": 2.96,
      "text": "Three months. Fine. ~"
    }
  ]
}
