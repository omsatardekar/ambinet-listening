{
  "schema_version": "1.0",
  "encounter_id": "00588",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.31,
      "end_seconds": 13.98,
      "duration_seconds": 13.67,
      "text": "Doctor, I'll be quick, my parking runs out at half past. My left ear is blocked up and I can barely hear on that side."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.61,
      "end_seconds": 21.72,
      "duration_seconds": 6.11,
      "text": "Right, quick it is. How long has it felt blocked up?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.76,
      "end_seconds": 34.13,
      "duration_seconds": 10.37,
      "text": "About three weeks now. My husband says the telly is far too loud, and I've stopped hearing the kettle."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.12,
      "end_seconds": 47.69,
      "duration_seconds": 10.57,
      "text": "Ha, the kettle, that's a good test. Did it come on suddenly, or creep up on you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.76,
      "end_seconds": 56.58,
      "duration_seconds": 7.82,
      "text": "Crept up. My hearing's worse every week, and I just can't be doing with it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.85,
      "end_seconds": 66.21,
      "duration_seconds": 7.36,
      "text": "What does it feel like inside? Pressure, or water, or something else?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.66,
      "end_seconds": 77.77,
      "duration_seconds": 9.11,
      "text": "Like I'm underwater, all full and muffled. Do you use cotton buds, is that what you're going to ask?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.99,
      "end_seconds": 83.67,
      "duration_seconds": 3.68,
      "text": "You read my mind. Do you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.78,
      "end_seconds": 93.24,
      "duration_seconds": 7.46,
      "text": "Every morning, yes. I know, I know, everybody tells me off for it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.85,
      "end_seconds": 104.12,
      "duration_seconds": 8.27,
      "text": "I'm not telling you off. They tend to push the wax further in, that's all."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 105.4,
      "end_seconds": 113.43,
      "duration_seconds": 8.03,
      "text": "Sorry to interrupt, Doctor. Her repeat prescription list is up on the screen, if you want it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.21,
      "end_seconds": 122.98,
      "duration_seconds": 6.77,
      "text": "Thanks, nurse. While we have it, what are you taking at the moment?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.57,
      "end_seconds": 134.44,
      "duration_seconds": 8.87,
      "text": "Just my blood pressure one and the stomach acid one. Nurse knows the names, I never remember."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 135.52,
      "end_seconds": 143.0,
      "duration_seconds": 7.48,
      "text": "It says amlodipine 5 mg once a day, and omeprazole 20 mg once a day."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.78,
      "end_seconds": 152.21,
      "duration_seconds": 8.43,
      "text": "That's them. The amlodipine's for my high blood pressure, and the omeprazole's for the reflux."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.08,
      "end_seconds": 163.08,
      "duration_seconds": 8.0,
      "text": "Do you take them at the same time every day? I'm always curious how people manage."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.16,
      "end_seconds": 170.98,
      "duration_seconds": 6.82,
      "text": "Amlodipine with breakfast, omeprazole half an hour before. I've an alarm on my phone."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.5,
      "end_seconds": 187.56,
      "duration_seconds": 14.06,
      "text": "Sensible. My own mother used to line hers up next to the kettle. Anyway, anything else in your notes I should ask about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.11,
      "end_seconds": 198.27,
      "duration_seconds": 8.16,
      "text": "I get migraines now and then, but that's a separate matter. Can we get on, please?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.21,
      "end_seconds": 210.28,
      "duration_seconds": 9.07,
      "text": "Of course. From what you describe, it's most likely a plug of wax pressing on the eardrum."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.33,
      "end_seconds": 218.76,
      "duration_seconds": 6.43,
      "text": "Wax? That's all it is? I thought I was going deaf."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.0,
      "end_seconds": 230.6,
      "duration_seconds": 9.6,
      "text": "That's my first thought, yes. I'd like the nurse to syringe your ears and clear it out."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 232.2,
      "end_seconds": 239.38,
      "duration_seconds": 7.18,
      "text": "I can do that. We've a slot on Tuesday morning if that suits."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.11,
      "end_seconds": 248.42,
      "duration_seconds": 6.31,
      "text": "Tuesday's fine. Does it hurt, though? I'm not good with needles."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 249.97,
      "end_seconds": 258.52,
      "duration_seconds": 8.55,
      "text": "There's no needle, it's just warm water. It's a bit noisy, and over in a few minutes."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.02,
      "end_seconds": 263.37,
      "duration_seconds": 3.35,
      "text": "Fine. As long as it's quick."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.22,
      "end_seconds": 274.64,
      "duration_seconds": 9.42,
      "text": "Then come and see me after the syringing, next Tuesday, and I'll check how your hearing is doing."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.43,
      "end_seconds": 283.42,
      "duration_seconds": 6.99,
      "text": "So Tuesday for both. Can the same parking ticket cover it, do you know?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 284.45,
      "end_seconds": 291.18,
      "duration_seconds": 6.73,
      "text": "Ha, afraid not. But reception can give you a token for the machine."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.78,
      "end_seconds": 301.44,
      "duration_seconds": 7.66,
      "text": "Until then, leave the cotton buds alone, and keep water out of that ear."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.37,
      "end_seconds": 309.26,
      "duration_seconds": 6.89,
      "text": "Hard habit to break, but I'll try. I'll hide them from myself."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.98,
      "end_seconds": 320.53,
      "duration_seconds": 8.55,
      "text": "Put them at the back of the cupboard. Out of sight helps with most habits."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.4,
      "end_seconds": 325.98,
      "duration_seconds": 4.58,
      "text": "True. Right, I really must dash. Thank you both."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.68,
      "end_seconds": 332.8,
      "duration_seconds": 6.12,
      "text": "Go on, off you go before the meter runs out. See you Tuesday."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.63,
      "end_seconds": 337.32,
      "duration_seconds": 2.69,
      "text": "Bye, Doctor. Bye, nurse."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 338.4,
      "end_seconds": 346.96,
      "duration_seconds": 8.56,
      "text": "Mind how you go. Pop to reception on the way out for that token."
    }
  ]
}
