{
  "schema_version": "1.0",
  "encounter_id": "00926",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.84,
      "end_seconds": 15.27,
      "duration_seconds": 13.43,
      "text": "Good afternoon, doctor. I'm a bit worried because my shoulders have been very stiff and sore, and a friend said it might be polymyalgia."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.47,
      "end_seconds": 27.09,
      "duration_seconds": 8.62,
      "text": "Thank you for coming. Tell me about the shoulders. When do they feel worst?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.85,
      "end_seconds": 42.52,
      "duration_seconds": 12.67,
      "text": "In the morning. I can hardly lift my arms to wash my hair. It takes about an hour to loosen up."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.0,
      "end_seconds": 48.25,
      "duration_seconds": 3.25,
      "text": "Is it both shoulders?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.24,
      "end_seconds": 55.74,
      "duration_seconds": 4.5,
      "text": "Both. And my hips, a little, too."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.08,
      "end_seconds": 63.11,
      "duration_seconds": 4.03,
      "text": "How long has this been going on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.88,
      "end_seconds": 67.68,
      "duration_seconds": 1.8,
      "text": "About five weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.11,
      "end_seconds": 74.11,
      "duration_seconds": 5.0,
      "text": "Any fever, weight loss, or headaches over your temples?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.21,
      "end_seconds": 81.23,
      "duration_seconds": 4.02,
      "text": "No fever. No weight loss. No headaches."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.43,
      "end_seconds": 88.79,
      "duration_seconds": 5.36,
      "text": "Any pain when you chew, or changes in your vision?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.46,
      "end_seconds": 95.67,
      "duration_seconds": 4.21,
      "text": "No, nothing like that. My jaw is fine."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.19,
      "end_seconds": 102.55,
      "duration_seconds": 4.36,
      "text": "Have you had any joint swelling, or rashes?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.47,
      "end_seconds": 108.78,
      "duration_seconds": 4.31,
      "text": "No swelling, and my skin is fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.11,
      "end_seconds": 119.12,
      "duration_seconds": 7.01,
      "text": "Let me take your pulse, blood pressure, temperature and oxygen level. ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.84,
      "end_seconds": 133.51,
      "duration_seconds": 1.67,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.26,
      "end_seconds": 142.71,
      "duration_seconds": 7.45,
      "text": "Pulse 72, blood pressure 130 over 78, temperature 36.7, oxygen 98 percent, breathing 15."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.19,
      "end_seconds": 146.71,
      "duration_seconds": 2.52,
      "text": "Everything's normal? ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.47,
      "end_seconds": 155.52,
      "duration_seconds": 6.05,
      "text": "Normal. I'd like to move your shoulders and check the strength. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.21,
      "end_seconds": 174.68,
      "duration_seconds": 1.47,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.81,
      "end_seconds": 187.46,
      "duration_seconds": 9.65,
      "text": "You have a good range of movement but it's painful at the extremes, and your strength is normal."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.7,
      "end_seconds": 193.76,
      "duration_seconds": 4.06,
      "text": "So what do you think it is? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.82,
      "end_seconds": 205.47,
      "duration_seconds": 9.65,
      "text": "The pattern fits polymyalgia rheumatica, but I can't be certain until the blood tests are back."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.88,
      "end_seconds": 210.75,
      "duration_seconds": 1.87,
      "text": "What blood tests?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.31,
      "end_seconds": 220.26,
      "duration_seconds": 7.95,
      "text": "Inflammatory markers, a full blood count, and a check of your kidneys and thyroid."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.16,
      "end_seconds": 226.43,
      "duration_seconds": 3.27,
      "text": "And if they're high? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.01,
      "end_seconds": 235.05,
      "duration_seconds": 7.04,
      "text": "Then we'd talk about a short steroid course, which usually works very quickly. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.37,
      "end_seconds": 244.68,
      "duration_seconds": 7.31,
      "text": "Is there anyone in the family I should be concerned about? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.22,
      "end_seconds": 253.18,
      "duration_seconds": 5.96,
      "text": "Does anyone in your family have rheumatic or autoimmune conditions?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.54,
      "end_seconds": 259.9,
      "duration_seconds": 3.36,
      "text": "My mother had rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.44,
      "end_seconds": 267.99,
      "duration_seconds": 5.55,
      "text": "Thank you, that's useful. Do you smoke or drink?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.23,
      "end_seconds": 277.28,
      "duration_seconds": 6.05,
      "text": "I gave up smoking ten years ago. And I drink very little."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.57,
      "end_seconds": 285.39,
      "duration_seconds": 5.82,
      "text": "Good. I'll phone you as soon as the results are in. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.03,
      "end_seconds": 289.45,
      "duration_seconds": 2.42,
      "text": "Thank you. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.0,
      "end_seconds": 301.05,
      "duration_seconds": 9.05,
      "text": "If you get a new headache, jaw pain or changes to your vision, call us the same day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.27,
      "end_seconds": 306.03,
      "duration_seconds": 1.76,
      "text": "I will. ~"
    }
  ]
}
