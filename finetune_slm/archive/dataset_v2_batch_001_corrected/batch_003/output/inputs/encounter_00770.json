{
  "schema_version": "1.0",
  "encounter_id": "00770",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 1.04,
      "end_seconds": 12.15,
      "duration_seconds": 11.11,
      "text": "Hello! This is Bella, she's six, and she gets tummy aches before school, every morning, and I'm at my wits' end."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.05,
      "end_seconds": 20.3,
      "duration_seconds": 6.25,
      "text": "Hello Bella. Can you tell me about your tummy? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.15,
      "end_seconds": 25.15,
      "duration_seconds": 2.0,
      "text": "It hurts. Here."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.8,
      "end_seconds": 29.24,
      "duration_seconds": 2.44,
      "text": "When does it hurt?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.64,
      "end_seconds": 33.1,
      "duration_seconds": 2.46,
      "text": "Not at school. ~"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 35.47,
      "end_seconds": 49.93,
      "duration_seconds": 14.46,
      "text": "She means weekdays, doctor. Monday to Friday, before school, then it goes by the time we get there, and she's running about by break."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.13,
      "end_seconds": 54.71,
      "duration_seconds": 3.58,
      "text": "And on Saturdays and Sundays? ~"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 57.68,
      "end_seconds": 60.45,
      "duration_seconds": 2.77,
      "text": "Fine. Never a problem. ~"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.9,
      "end_seconds": 66.43,
      "duration_seconds": 3.53,
      "text": "Bella, do you like school? ~"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.49,
      "end_seconds": 72.42,
      "duration_seconds": 2.93,
      "text": "Yes. I love it. ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 73.99,
      "end_seconds": 81.68,
      "duration_seconds": 7.69,
      "text": "She says that, but she cries when I leave her at the gate, doctor."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.18,
      "end_seconds": 86.41,
      "duration_seconds": 2.23,
      "text": "I don't cry."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 88.66,
      "end_seconds": 92.13,
      "duration_seconds": 3.47,
      "text": "You do, sweetheart, you cry every morning."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.32,
      "end_seconds": 108.51,
      "duration_seconds": 14.19,
      "text": "I'll write down that Bella says she doesn't cry and Mum says she does. Bella, is there anything about school that's difficult, or any person who's unkind?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.47,
      "end_seconds": 111.14,
      "duration_seconds": 1.67,
      "text": "No. ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.87,
      "end_seconds": 120.85,
      "duration_seconds": 7.98,
      "text": "Does your tummy ever hurt when you do a poo, or when you eat? ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.36,
      "end_seconds": 124.89,
      "duration_seconds": 1.53,
      "text": "No. ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 127.43,
      "end_seconds": 134.52,
      "duration_seconds": 7.09,
      "text": "Her bowels are regular, and she eats breakfast, if she can. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.62,
      "end_seconds": 144.34,
      "duration_seconds": 6.72,
      "text": "Let me feel your tummy, Bella. Lie back, it'll tickle. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.4,
      "end_seconds": 162.41,
      "duration_seconds": 2.01,
      "text": "Hee hee."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.95,
      "end_seconds": 170.92,
      "duration_seconds": 6.97,
      "text": "Her tummy is soft, and there's no tenderness anywhere, even when I press deep."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 173.72,
      "end_seconds": 177.35,
      "duration_seconds": 3.63,
      "text": "Is it something physical? ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.96,
      "end_seconds": 195.8,
      "duration_seconds": 16.84,
      "text": "Nothing here worries me. Children often get a real tummy ache in the morning when they're a bit anxious about separating from you, and it goes once they're distracted. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 198.03,
      "end_seconds": 200.5,
      "duration_seconds": 2.47,
      "text": "I feel terrible. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.58,
      "end_seconds": 210.67,
      "duration_seconds": 7.09,
      "text": "Please don't. It's very common at this age, and it's not your fault. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 213.18,
      "end_seconds": 216.29,
      "duration_seconds": 3.11,
      "text": "What can I do? ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.36,
      "end_seconds": 231.74,
      "duration_seconds": 13.38,
      "text": "A calm, consistent goodbye routine, and a firm, kind drop-off. Don't linger. And talk to her teacher so they can greet her at the gate."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 234.65,
      "end_seconds": 240.93,
      "duration_seconds": 6.28,
      "text": "I do linger. I give her a hundred cuddles. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.18,
      "end_seconds": 248.42,
      "duration_seconds": 5.24,
      "text": "One big cuddle, a quick wave, and off you go. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.67,
      "end_seconds": 253.46,
      "duration_seconds": 2.79,
      "text": "Mummy, I'll be good. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.82,
      "end_seconds": 269.63,
      "duration_seconds": 14.81,
      "text": "You are good, Bella. And I'd like to arrange a urine test, just to rule out a simple infection that could be causing tummy aches."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 271.62,
      "end_seconds": 275.72,
      "duration_seconds": 4.1,
      "text": "Okay. Can she do it here? ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.45,
      "end_seconds": 283.38,
      "duration_seconds": 5.93,
      "text": "Yes, the nurse will give you a little pot. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 285.53,
      "end_seconds": 287.94,
      "duration_seconds": 2.41,
      "text": "Thank you. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.42,
      "end_seconds": 299.34,
      "duration_seconds": 9.92,
      "text": "I'd like to see you again in three weeks, to see how the mornings are going."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 302.43,
      "end_seconds": 306.03,
      "duration_seconds": 3.6,
      "text": "Three weeks. Thanks, doctor. ~"
    }
  ]
}
