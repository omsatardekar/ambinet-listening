{
  "schema_version": "1.0",
  "encounter_id": "00825",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 1.21,
      "end_seconds": 17.79,
      "duration_seconds": 16.58,
      "text": "Doctor, I'm Beth, Mr Quigley's carer. He's got a pain in his neck that goes down his arm, and he won't say much, so I'm here to help."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.68,
      "end_seconds": 24.18,
      "duration_seconds": 3.5,
      "text": "It's not that bad. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.79,
      "end_seconds": 30.87,
      "duration_seconds": 5.08,
      "text": "Mr Quigley, can you tell me where it hurts?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.8,
      "end_seconds": 37.41,
      "duration_seconds": 4.61,
      "text": "Neck. And down this arm. The right."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.12,
      "end_seconds": 42.83,
      "duration_seconds": 3.71,
      "text": "How long has it been going on?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.09,
      "end_seconds": 47.75,
      "duration_seconds": 2.66,
      "text": "A few weeks. ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 50.33,
      "end_seconds": 56.07,
      "duration_seconds": 5.74,
      "text": "I'd say a month. It started after he painted the ceiling."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.65,
      "end_seconds": 62.56,
      "duration_seconds": 3.91,
      "text": "Is it worse at certain times?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.58,
      "end_seconds": 69.66,
      "duration_seconds": 4.08,
      "text": "At night. And when I turn my head."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.15,
      "end_seconds": 75.22,
      "duration_seconds": 4.07,
      "text": "Any tingling or numbness in your fingers?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.52,
      "end_seconds": 81.45,
      "duration_seconds": 4.93,
      "text": "A bit of tingling. In my thumb, and next finger."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.28,
      "end_seconds": 86.24,
      "duration_seconds": 2.96,
      "text": "Any weakness, dropping things?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.05,
      "end_seconds": 91.88,
      "duration_seconds": 2.83,
      "text": "No. I can grip fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 93.43,
      "end_seconds": 97.61,
      "duration_seconds": 4.18,
      "text": "He's dropped a cup twice, though."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.74,
      "end_seconds": 103.82,
      "duration_seconds": 5.08,
      "text": "I'll note that. What are you taking for it?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 105.74,
      "end_seconds": 123.12,
      "duration_seconds": 17.38,
      "text": "Naproxen, 500 mg twice a day. Paracetamol, 1 gram, four times a day. And a stomach tablet, omeprazole, 20 mg once a day, to go with the naproxen."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.12,
      "end_seconds": 127.38,
      "duration_seconds": 2.26,
      "text": "Any other conditions?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 128.54,
      "end_seconds": 134.36,
      "duration_seconds": 5.82,
      "text": "He had a stroke, two years ago, and high blood pressure."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.9,
      "end_seconds": 139.08,
      "duration_seconds": 3.18,
      "text": "Who's at home with him?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 140.45,
      "end_seconds": 145.39,
      "duration_seconds": 4.94,
      "text": "He lives alone, and I come in morning and evening."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.2,
      "end_seconds": 150.63,
      "duration_seconds": 3.43,
      "text": "Pulse, pressure, and so on. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 152.73,
      "end_seconds": 163.62,
      "duration_seconds": 10.89,
      "text": "I've done them this morning, doctor. Blood pressure 138 over 84, pulse 72, oxygen 97 percent, temperature 36.7."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.81,
      "end_seconds": 188.9,
      "duration_seconds": 4.09,
      "text": "Thanks, Beth. Mr Quigley, I'll test your arm."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.84,
      "end_seconds": 192.6,
      "duration_seconds": 1.76,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.73,
      "end_seconds": 212.98,
      "duration_seconds": 19.25,
      "text": "The strength in your right grip is slightly reduced compared to the left, and your thumb and index finger have reduced feeling, and moving your neck towards the right reproduces the arm pain. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 215.7,
      "end_seconds": 219.18,
      "duration_seconds": 3.48,
      "text": "Is it a trapped nerve? ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.38,
      "end_seconds": 233.2,
      "duration_seconds": 11.82,
      "text": "It looks that way. I'd say this is a pinched nerve in the neck, cervical radiculopathy, probably from wear in the neck bones."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.34,
      "end_seconds": 237.4,
      "duration_seconds": 3.06,
      "text": "Will it get better? ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.58,
      "end_seconds": 252.77,
      "duration_seconds": 14.19,
      "text": "Often, yes, with time, within a few months. But with the dropped cups and the reduced grip, I'd like to be careful. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 255.25,
      "end_seconds": 257.93,
      "duration_seconds": 2.68,
      "text": "What do we do? ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.54,
      "end_seconds": 266.78,
      "duration_seconds": 6.24,
      "text": "Keep using a supportive pillow, avoid heavy lifting, and gentle neck movements."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 269.71,
      "end_seconds": 275.4,
      "duration_seconds": 5.69,
      "text": "I'll make sure he doesn't paint any more ceilings. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.72,
      "end_seconds": 292.14,
      "duration_seconds": 15.42,
      "text": "Please. If the weakness gets worse, you lose feeling in your hand, you have trouble walking, or lose control of your bladder, come in immediately."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 294.84,
      "end_seconds": 298.12,
      "duration_seconds": 3.28,
      "text": "I'll watch for those. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.84,
      "end_seconds": 306.03,
      "duration_seconds": 5.19,
      "text": "Continue the tablets as they are. Thank you, Beth. ~"
    }
  ]
}
