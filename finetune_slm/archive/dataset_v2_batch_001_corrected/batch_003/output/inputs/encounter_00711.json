{
  "schema_version": "1.0",
  "encounter_id": "00711",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 0.5,
      "end_seconds": 9.68,
      "duration_seconds": 9.18,
      "text": "Good morning, Mrs Pillai. I'll weigh Aditi first, if that's all right, then you can go in. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 10.58,
      "end_seconds": 17.54,
      "duration_seconds": 6.96,
      "text": "Of course, thank you. Aditi, stand very still on the scales, beta. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 19.83,
      "end_seconds": 24.77,
      "duration_seconds": 4.94,
      "text": "22 kilos, doctor will have it in the notes."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.75,
      "end_seconds": 33.82,
      "duration_seconds": 8.07,
      "text": "Good morning, Mrs Pillai, hello Aditi. Please sit. What brings you in today? ~"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 36.54,
      "end_seconds": 52.06,
      "duration_seconds": 15.52,
      "text": "Doctor, it is her nose and eyes. Since the beginning of the month she sneezes and sneezes, every morning, and her eyes are red and itchy."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.61,
      "end_seconds": 57.18,
      "duration_seconds": 3.57,
      "text": "Aditi, do your eyes feel itchy?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.47,
      "end_seconds": 62.43,
      "duration_seconds": 2.96,
      "text": "Very itchy. And my nose."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.92,
      "end_seconds": 68.98,
      "duration_seconds": 4.06,
      "text": "When is it worst, indoors or outdoors?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 71.2,
      "end_seconds": 83.06,
      "duration_seconds": 11.86,
      "text": "Outdoors, in the garden, and when we go to school in the morning. By afternoon she is better, and at night nearly normal."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.78,
      "end_seconds": 92.04,
      "duration_seconds": 6.26,
      "text": "Is there a cough or any wheezing, any trouble in the chest?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 93.93,
      "end_seconds": 99.8,
      "duration_seconds": 5.87,
      "text": "No cough, no wheeze. Her chest is fine, thank God."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.92,
      "end_seconds": 108.82,
      "duration_seconds": 6.9,
      "text": "Does Aditi take any medicines, or have any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 111.45,
      "end_seconds": 115.97,
      "duration_seconds": 4.52,
      "text": "No allergies to anything. And no regular medicines."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.8,
      "end_seconds": 120.79,
      "duration_seconds": 3.99,
      "text": "Any other conditions, like eczema or asthma?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 122.61,
      "end_seconds": 130.14,
      "duration_seconds": 7.53,
      "text": "A little eczema on the elbows when she was small, but it has gone now."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.92,
      "end_seconds": 138.5,
      "duration_seconds": 5.58,
      "text": "Does anyone else in the family have hay fever?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 140.44,
      "end_seconds": 147.97,
      "duration_seconds": 7.53,
      "text": "Yes, me, I'm her mother, I get it every spring. And her father too, a little."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.11,
      "end_seconds": 156.9,
      "duration_seconds": 6.79,
      "text": "Let me check her temperature, Aditi, I'll put this under your arm. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.54,
      "end_seconds": 170.68,
      "duration_seconds": 1.14,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.06,
      "end_seconds": 196.82,
      "duration_seconds": 8.76,
      "text": "Temperature 36.6, and I'll listen to your chest too, Aditi. Breathe in and out."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 198.06,
      "end_seconds": 200.66,
      "duration_seconds": 2.6,
      "text": "Is she wheezing? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.79,
      "end_seconds": 216.1,
      "duration_seconds": 13.31,
      "text": "Her chest is clear. I'd say this pattern, sneezing, itchy red eyes, worse outdoors, with a family history, is most likely hay fever."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 217.85,
      "end_seconds": 220.56,
      "duration_seconds": 2.71,
      "text": "Is that serious? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.54,
      "end_seconds": 230.7,
      "duration_seconds": 7.16,
      "text": "Not serious, only annoying. We can control it quite well. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 231.78,
      "end_seconds": 235.49,
      "duration_seconds": 3.71,
      "text": "What can we do? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.12,
      "end_seconds": 250.96,
      "duration_seconds": 12.84,
      "text": "I'm going to start Aditi on cetirizine, 5 mg once a day, in the morning, which helps the sneezing and itching."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 251.9,
      "end_seconds": 254.14,
      "duration_seconds": 2.24,
      "text": "Is it syrup? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.9,
      "end_seconds": 270.3,
      "duration_seconds": 14.4,
      "text": "Yes, the liquid is easiest. I'm also going to start a nasal spray, fluticasone, 50 micrograms, one spray in each nostril once a day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 272.27,
      "end_seconds": 275.59,
      "duration_seconds": 3.32,
      "text": "Will it make her sleepy? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.82,
      "end_seconds": 282.96,
      "duration_seconds": 6.14,
      "text": "Rarely, and if it does, give it at bedtime. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.49,
      "end_seconds": 290.51,
      "duration_seconds": 6.02,
      "text": "Do I have to have it up my nose? ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.22,
      "end_seconds": 296.7,
      "duration_seconds": 5.48,
      "text": "Just a tiny puff, Aditi, like a little breeze. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 298.8,
      "end_seconds": 301.28,
      "duration_seconds": 2.48,
      "text": "And at home? ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.53,
      "end_seconds": 318.8,
      "duration_seconds": 16.27,
      "text": "Wash her face and change her clothes when she comes in from outside, keep bedroom windows closed in the morning, and rinse her eyes with cool water."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 320.51,
      "end_seconds": 324.1,
      "duration_seconds": 3.59,
      "text": "I will do all that. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 325.87,
      "end_seconds": 330.84,
      "duration_seconds": 4.97,
      "text": "Doctor, do you need anything else done? ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.63,
      "end_seconds": 342.53,
      "duration_seconds": 10.9,
      "text": "No, Maya, thank you. Mrs Pillai, if she starts wheezing or coughing, or the eyes become very red or painful, please come back."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 343.61,
      "end_seconds": 346.48,
      "duration_seconds": 2.87,
      "text": "Thank you, doctor. ~"
    }
  ]
}
