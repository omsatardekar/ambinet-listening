{
  "schema_version": "1.0",
  "encounter_id": "00703",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 2.96,
      "end_seconds": 11.77,
      "duration_seconds": 8.81,
      "text": "Afternoon. My ankles swell by evening. Been going on a month. I thought I'd mention it."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.65,
      "end_seconds": 17.78,
      "duration_seconds": 3.13,
      "text": "Both ankles, or one?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.41,
      "end_seconds": 26.65,
      "duration_seconds": 6.24,
      "text": "Both. Worse after a day on my feet, gone by the morning."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.84,
      "end_seconds": 35.87,
      "duration_seconds": 5.03,
      "text": "Any breathlessness, or waking at night short of breath? ~"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.01,
      "end_seconds": 42.06,
      "duration_seconds": 3.05,
      "text": "No. Nothing like that. ~"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.89,
      "end_seconds": 47.93,
      "duration_seconds": 3.04,
      "text": "What tablets do you take?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.75,
      "end_seconds": 58.94,
      "duration_seconds": 7.19,
      "text": "Amlodipine, 10 mg once a day. And omeprazole, 20 mg once a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.81,
      "end_seconds": 69.33,
      "duration_seconds": 6.52,
      "text": "How long have you been on the 10 mg? ~"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.04,
      "end_seconds": 78.49,
      "duration_seconds": 5.45,
      "text": "About six weeks. They put it up from five. ~"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.3,
      "end_seconds": 89.36,
      "duration_seconds": 8.06,
      "text": "That's useful to know. Let's check you over. Pulse, pressure and so on. ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.09,
      "end_seconds": 95.49,
      "duration_seconds": 2.4,
      "text": "Go ahead. ~"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.45,
      "end_seconds": 122.17,
      "duration_seconds": 8.72,
      "text": "Pulse 74, blood pressure 130 over 80, temperature 36.6, oxygen 98 percent, breathing 14 a minute."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.31,
      "end_seconds": 129.09,
      "duration_seconds": 2.78,
      "text": "Is that okay? ~"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.92,
      "end_seconds": 140.68,
      "duration_seconds": 8.76,
      "text": "That's fine. Up on the couch, and let me press on your ankles. ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.05,
      "end_seconds": 148.31,
      "duration_seconds": 4.26,
      "text": "It leaves a dent, doesn't it? ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.59,
      "end_seconds": 174.92,
      "duration_seconds": 10.33,
      "text": "Yes, there's mild swelling around both ankles, and it dents when I press. Your calves are soft and not tender."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.12,
      "end_seconds": 181.95,
      "duration_seconds": 3.83,
      "text": "Is it my heart? ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.83,
      "end_seconds": 196.14,
      "duration_seconds": 11.31,
      "text": "Nothing I've found points to that, and your lungs are clear. I'm not going to put a name on it today. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.09,
      "end_seconds": 202.6,
      "duration_seconds": 3.51,
      "text": "Right. What do we do? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.65,
      "end_seconds": 216.97,
      "duration_seconds": 11.32,
      "text": "Put your feet up in the evenings, above hip height if you can, and don't sit with your legs crossed for long."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.19,
      "end_seconds": 225.81,
      "duration_seconds": 5.62,
      "text": "I sit all day at work, mind. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.02,
      "end_seconds": 237.59,
      "duration_seconds": 8.57,
      "text": "Take a walk at lunchtime, and get up every hour. Compression socks can help, too. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.37,
      "end_seconds": 246.16,
      "duration_seconds": 4.79,
      "text": "Do you want me to stop anything? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.85,
      "end_seconds": 257.1,
      "duration_seconds": 7.25,
      "text": "Not today. Let's see how it settles with the leg raising. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.72,
      "end_seconds": 263.5,
      "duration_seconds": 2.78,
      "text": "And if it doesn't? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.61,
      "end_seconds": 272.38,
      "duration_seconds": 4.77,
      "text": "I'd like to see you again in three weeks."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.57,
      "end_seconds": 279.48,
      "duration_seconds": 2.91,
      "text": "Three weeks. Fine. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.7,
      "end_seconds": 294.65,
      "duration_seconds": 11.95,
      "text": "And if one leg swells much more than the other, or becomes hot and painful, come in the same day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.12,
      "end_seconds": 300.34,
      "duration_seconds": 2.22,
      "text": "Understood. Thanks. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.89,
      "end_seconds": 306.02,
      "duration_seconds": 2.13,
      "text": "Take care. ~"
    }
  ]
}
