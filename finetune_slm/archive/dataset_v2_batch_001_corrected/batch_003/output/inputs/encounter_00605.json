{
  "schema_version": "1.0",
  "encounter_id": "00605",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.75,
      "end_seconds": 10.12,
      "duration_seconds": 8.37,
      "text": "G'day. I've got dry eyes and a dry mouth, and it's driving me spare."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 12.93,
      "end_seconds": 17.31,
      "duration_seconds": 4.38,
      "text": "Right. How long's that been going on?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.96,
      "end_seconds": 22.48,
      "duration_seconds": 2.52,
      "text": "Three months, about."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.47,
      "end_seconds": 27.65,
      "duration_seconds": 3.18,
      "text": "Constant, or worse at certain times?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.69,
      "end_seconds": 37.4,
      "duration_seconds": 7.71,
      "text": "Worse overnight. I wake up with my tongue stuck to the roof of my mouth."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.54,
      "end_seconds": 44.75,
      "duration_seconds": 4.21,
      "text": "And the eyes. What do they feel like?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.23,
      "end_seconds": 52.01,
      "duration_seconds": 5.78,
      "text": "Gritty. Like there's sand in them, mostly by the afternoon."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.8,
      "end_seconds": 56.73,
      "duration_seconds": 2.93,
      "text": "Do you wear contact lenses?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.77,
      "end_seconds": 63.37,
      "duration_seconds": 3.6,
      "text": "Nah, just glasses for reading and driving."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.74,
      "end_seconds": 68.79,
      "duration_seconds": 4.05,
      "text": "Fine. What do you do for work?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.96,
      "end_seconds": 79.56,
      "duration_seconds": 7.6,
      "text": "Call centre. I'm on the phone eight hours a day, talking non-stop."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.29,
      "end_seconds": 89.04,
      "duration_seconds": 7.75,
      "text": "That'd dry anyone's mouth out, but not usually to this degree. Any history of health problems?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.74,
      "end_seconds": 94.04,
      "duration_seconds": 2.3,
      "text": "Underactive thyroid. Years now."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.02,
      "end_seconds": 99.66,
      "duration_seconds": 3.64,
      "text": "Okay. How are your joints generally?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.52,
      "end_seconds": 104.93,
      "duration_seconds": 2.41,
      "text": "Joints are fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.51,
      "end_seconds": 110.78,
      "duration_seconds": 4.27,
      "text": "Let's get some numbers. Blood pressure first."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.9,
      "end_seconds": 115.44,
      "duration_seconds": 2.54,
      "text": "Righto, go for it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.05,
      "end_seconds": 135.83,
      "duration_seconds": 5.78,
      "text": "134 over 82. Pulse 74. Temperature 36.7. Oxygen 98 percent. Breathing 14."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.62,
      "end_seconds": 143.72,
      "duration_seconds": 5.1,
      "text": "Is that all good, or is something off?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.06,
      "end_seconds": 154.47,
      "duration_seconds": 7.41,
      "text": "All unremarkable. Weight's 68 kilos, too. Now tip your head back for me, open wide."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.66,
      "end_seconds": 157.85,
      "duration_seconds": 1.19,
      "text": "Ahh."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.28,
      "end_seconds": 179.39,
      "duration_seconds": 9.11,
      "text": "The inside of your mouth is dry and sticky, and your tongue's quite smooth and red."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.17,
      "end_seconds": 196.25,
      "duration_seconds": 10.08,
      "text": "Now look up. Your eyes are a bit pink along the lids and there's very little moisture."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.18,
      "end_seconds": 202.0,
      "duration_seconds": 3.82,
      "text": "Yeah, that's what the mirror tells me."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.68,
      "end_seconds": 213.26,
      "duration_seconds": 9.58,
      "text": "So here's my thinking. This looks most likely like Sjogren's syndrome, an autoimmune condition that dries out the glands."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.76,
      "end_seconds": 218.88,
      "duration_seconds": 3.12,
      "text": "Autoimmune? That sounds serious."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.22,
      "end_seconds": 237.58,
      "duration_seconds": 15.36,
      "text": "It's common and very manageable, so try not to worry yet. I can't rule out your thyroid playing a part either, so we keep that in view."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.99,
      "end_seconds": 241.34,
      "duration_seconds": 1.35,
      "text": "Right."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.15,
      "end_seconds": 252.31,
      "duration_seconds": 9.16,
      "text": "Meantime, sip water through the day, and sugar-free lollies or gum help keep saliva flowing."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.7,
      "end_seconds": 259.2,
      "duration_seconds": 5.5,
      "text": "Easy enough. I've got a bottle on my desk anyway."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.05,
      "end_seconds": 270.23,
      "duration_seconds": 8.18,
      "text": "Take regular screen breaks at work too. Blinking more often helps the eyes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.3,
      "end_seconds": 277.29,
      "duration_seconds": 3.99,
      "text": "I'll try that. Never thought about blinking."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.88,
      "end_seconds": 287.99,
      "duration_seconds": 9.11,
      "text": "Most people don't. I'd like to dig into this properly, so we'll sort the next steps at reception."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.99,
      "end_seconds": 294.47,
      "duration_seconds": 4.48,
      "text": "Sounds fine to me. Whatever you reckon."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.17,
      "end_seconds": 301.28,
      "duration_seconds": 4.11,
      "text": "Good on you. Thanks for coming in."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.39,
      "end_seconds": 306.0,
      "duration_seconds": 1.61,
      "text": "Cheers, doctor."
    }
  ]
}
