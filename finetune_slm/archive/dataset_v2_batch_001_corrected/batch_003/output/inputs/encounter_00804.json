{
  "schema_version": "1.0",
  "encounter_id": "00804",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 1.64,
      "end_seconds": 10.7,
      "duration_seconds": 9.06,
      "text": "Mr Brennan? I'm Aileen, the nurse. You said your home pulse oximeter was reading low."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.4,
      "end_seconds": 24.16,
      "duration_seconds": 11.76,
      "text": "That's right. I've a wee gadget at home, and it said 88, on Monday, and I nearly dropped dead. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.23,
      "end_seconds": 31.66,
      "duration_seconds": 5.43,
      "text": "Good morning. Come in. Which number is low, and when?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.56,
      "end_seconds": 41.33,
      "duration_seconds": 7.77,
      "text": "88 percent, then 90, 89. It was the same morning and evening, for three days."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 43.54,
      "end_seconds": 47.93,
      "duration_seconds": 4.39,
      "text": "His oxygen today is 93 on our machine."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "UNKNOWN",
      "start_seconds": 49.83,
      "end_seconds": 56.64,
      "duration_seconds": 6.81,
      "text": "[from the corridor] It said 87 on Tuesday, I saw it!"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.88,
      "end_seconds": 67.17,
      "duration_seconds": 7.29,
      "text": "I'll go by what you tell me, Mr Brennan. How have you been feeling?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.13,
      "end_seconds": 76.04,
      "duration_seconds": 5.91,
      "text": "A bit breathless on the hill, and a cough. A dry one."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.92,
      "end_seconds": 80.89,
      "duration_seconds": 1.97,
      "text": "Since when?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.29,
      "end_seconds": 86.52,
      "duration_seconds": 3.23,
      "text": "Since the cold, three weeks ago."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.98,
      "end_seconds": 91.59,
      "duration_seconds": 2.61,
      "text": "Any chest pain?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.02,
      "end_seconds": 96.09,
      "duration_seconds": 3.07,
      "text": "No. None at all."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.88,
      "end_seconds": 100.49,
      "duration_seconds": 2.61,
      "text": "Any fever, or sweats?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.62,
      "end_seconds": 105.14,
      "duration_seconds": 1.52,
      "text": "No."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.86,
      "end_seconds": 112.33,
      "duration_seconds": 5.47,
      "text": "Any swelling in your legs, or waking at night breathless?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.93,
      "end_seconds": 115.83,
      "duration_seconds": 1.9,
      "text": "No, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.58,
      "end_seconds": 121.5,
      "duration_seconds": 3.92,
      "text": "What are you taking at the moment?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.96,
      "end_seconds": 141.0,
      "duration_seconds": 16.04,
      "text": "A small white tablet for the water, I couldn't tell you the name, from the heart clinic. And a blood-thinner, 5 mg, maybe? Twice a day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.12,
      "end_seconds": 152.75,
      "duration_seconds": 9.63,
      "text": "I'll check with the record, the white one and the dose of the blood-thinner. Any operations?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.41,
      "end_seconds": 157.36,
      "duration_seconds": 2.95,
      "text": "A hernia repair, in 2010."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.71,
      "end_seconds": 162.27,
      "duration_seconds": 2.56,
      "text": "And your family history?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.76,
      "end_seconds": 169.44,
      "duration_seconds": 5.68,
      "text": "My father died of emphysema. He smoked like a chimney."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.17,
      "end_seconds": 180.85,
      "duration_seconds": 9.68,
      "text": "Aileen, can we do his observations on our machine, and walk him down the corridor with it on? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 212.12,
      "end_seconds": 214.0,
      "duration_seconds": 1.88,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.33,
      "end_seconds": 225.33,
      "duration_seconds": 9.0,
      "text": "Right. His oxygen was fine at rest, and it dropped a little with walking, then came back up."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.96,
      "end_seconds": 229.96,
      "duration_seconds": 3.0,
      "text": "Is it dangerous? ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.8,
      "end_seconds": 242.44,
      "duration_seconds": 9.64,
      "text": "Those home devices can be inaccurate, especially with cold hands or nail varnish, but your breathlessness and cough deserve checking. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.6,
      "end_seconds": 247.57,
      "duration_seconds": 1.97,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.51,
      "end_seconds": 264.13,
      "duration_seconds": 13.62,
      "text": "I'd say this might be a lingering chest infection, and I'm going to start you on an antibiotic, doxycycline, 100 mg twice a day, for a week."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.94,
      "end_seconds": 269.0,
      "duration_seconds": 2.06,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.83,
      "end_seconds": 280.1,
      "duration_seconds": 8.27,
      "text": "And I'd like you to have an inhaler, salbutamol, two puffs when you're short of breath."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.54,
      "end_seconds": 285.12,
      "duration_seconds": 1.58,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.28,
      "end_seconds": 293.73,
      "duration_seconds": 6.45,
      "text": "Please come back in a week, and I'll check your chest again."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.73,
      "end_seconds": 299.97,
      "duration_seconds": 3.24,
      "text": "A week. Thank you. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 302.14,
      "end_seconds": 305.99,
      "duration_seconds": 3.85,
      "text": "I'll give you the leaflets. ~"
    }
  ]
}
