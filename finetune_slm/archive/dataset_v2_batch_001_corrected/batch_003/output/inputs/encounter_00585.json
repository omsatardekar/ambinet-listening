{
  "schema_version": "1.0",
  "encounter_id": "00585",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.62,
      "end_seconds": 11.68,
      "duration_seconds": 11.06,
      "text": "Doctor, I just don't get it. I've got a whole bag of pills, and nobody ever tells me what half of them are for."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 12.98,
      "end_seconds": 23.75,
      "duration_seconds": 10.77,
      "text": "That's exactly what we're here to sort out today, Dorothy. And I see Marcus has come along with you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 24.72,
      "end_seconds": 33.72,
      "duration_seconds": 9.0,
      "text": "Morning. I'm her carer, I come in every morning and set up the pill organizer for the week."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.42,
      "end_seconds": 42.69,
      "duration_seconds": 6.27,
      "text": "Wonderful. Marcus, how many different medicines is she taking at this point?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 45.66,
      "end_seconds": 55.31,
      "duration_seconds": 9.65,
      "text": "Eleven, the last time I counted. I brought the whole bag in case you want to go through it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.87,
      "end_seconds": 66.38,
      "duration_seconds": 8.51,
      "text": "Good thinking, we'll get to the bag in a minute. First, how have you been feeling, Dorothy?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.24,
      "end_seconds": 75.53,
      "duration_seconds": 7.29,
      "text": "Oh, I'm fine, mostly. I'm just wiped out a lot of the time."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.12,
      "end_seconds": 83.78,
      "duration_seconds": 6.66,
      "text": "Wiped out. Is that all day long, or worse at certain times?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.76,
      "end_seconds": 91.93,
      "duration_seconds": 7.17,
      "text": "Worse in the afternoons. By three o'clock I'm like a wet dishrag."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.37,
      "end_seconds": 99.32,
      "duration_seconds": 4.95,
      "text": "And when did the wiped out feeling start, roughly?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.23,
      "end_seconds": 107.18,
      "duration_seconds": 6.95,
      "text": "Oh, gosh. Was it before Christmas? Or maybe after? I really couldn't tell you."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 108.78,
      "end_seconds": 116.62,
      "duration_seconds": 7.84,
      "text": "I can't pin it down either. It sort of crept up on both of us."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.7,
      "end_seconds": 128.16,
      "duration_seconds": 9.46,
      "text": "That's fine, it doesn't need an exact date. Are you getting dizzy at all, Dorothy?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.02,
      "end_seconds": 135.02,
      "duration_seconds": 4.0,
      "text": "No, not me. I'm not dizzy."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 135.91,
      "end_seconds": 146.22,
      "duration_seconds": 10.31,
      "text": "Well, she is, though. She gets dizzy when she stands up fast. Twice last week I had to grab her arm."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.9,
      "end_seconds": 153.51,
      "duration_seconds": 5.61,
      "text": "Oh, Marcus, that's nothing. I just got up too quick."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.41,
      "end_seconds": 164.47,
      "duration_seconds": 9.06,
      "text": "Let's keep that in mind. I'd like to check your pressure sitting down, and then again standing up."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.33,
      "end_seconds": 169.53,
      "duration_seconds": 3.2,
      "text": "All right, whatever you need."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.47,
      "end_seconds": 189.41,
      "duration_seconds": 6.94,
      "text": "Sitting, your blood pressure is 134 over 78, and your pulse is 72."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.46,
      "end_seconds": 219.09,
      "duration_seconds": 8.63,
      "text": "Now stand up nice and slowly for me, and I'll take it once more."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.98,
      "end_seconds": 235.62,
      "duration_seconds": 4.64,
      "text": "Standing, it comes down to 108 over 66."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.69,
      "end_seconds": 242.64,
      "duration_seconds": 4.95,
      "text": "Is that bad? I feel perfectly okay standing here."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.79,
      "end_seconds": 257.47,
      "duration_seconds": 13.68,
      "text": "It's a bigger drop than I'd like. My best guess is that the combination of tablets is pushing your pressure down when you stand up."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 258.75,
      "end_seconds": 264.26,
      "duration_seconds": 5.51,
      "text": "That would explain why I keep having to catch her."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.09,
      "end_seconds": 274.89,
      "duration_seconds": 8.8,
      "text": "It might. Let me ask about a few other things. How about your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.27,
      "end_seconds": 280.12,
      "duration_seconds": 3.85,
      "text": "No, that's fine. Breathing's been fine."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.21,
      "end_seconds": 288.43,
      "duration_seconds": 7.22,
      "text": "Good. And what conditions have you been carrying around over the years?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.93,
      "end_seconds": 299.64,
      "duration_seconds": 8.71,
      "text": "Oh, high blood pressure, for ages. And the arthritis in my knees. That one's a real pain."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.05,
      "end_seconds": 306.66,
      "duration_seconds": 5.61,
      "text": "Okay. And you're at home on your own, is that right?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.06,
      "end_seconds": 317.37,
      "duration_seconds": 8.31,
      "text": "Yes, I live on my own. Marcus comes by every morning, bless him."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 320.26,
      "end_seconds": 322.96,
      "duration_seconds": 2.7,
      "text": "Every day but Sunday."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.18,
      "end_seconds": 337.92,
      "duration_seconds": 12.74,
      "text": "Alright. Here's what I'd like to do. I'll order a blood test to check how your kidneys and salts are doing."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.07,
      "end_seconds": 344.39,
      "duration_seconds": 4.32,
      "text": "Do I have to fast for it?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.11,
      "end_seconds": 353.59,
      "duration_seconds": 8.48,
      "text": "No need to. Marcus, the lab will take her whenever it suits you both."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 355.84,
      "end_seconds": 359.91,
      "duration_seconds": 4.07,
      "text": "Sure, I can run her over there."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.05,
      "end_seconds": 373.61,
      "duration_seconds": 12.56,
      "text": "In the meantime, Dorothy, when you get up from a chair or bed, sit for a moment first, then stand slowly."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 374.89,
      "end_seconds": 379.48,
      "duration_seconds": 4.59,
      "text": "Sit first, then stand. I can manage that."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 381.19,
      "end_seconds": 391.21,
      "duration_seconds": 10.02,
      "text": "And Marcus, please keep giving everything exactly as you have been until I've gone over that whole bag properly."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 393.65,
      "end_seconds": 396.83,
      "duration_seconds": 3.18,
      "text": "Will do. Thank you, doctor."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 398.65,
      "end_seconds": 406.2,
      "duration_seconds": 7.55,
      "text": "Thank you. I feel better knowing somebody's actually looking at it all."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 407.94,
      "end_seconds": 412.88,
      "duration_seconds": 4.94,
      "text": "You're very welcome. Take care, both of you."
    }
  ]
}
