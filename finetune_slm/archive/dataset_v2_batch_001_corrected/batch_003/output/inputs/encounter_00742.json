{
  "schema_version": "1.0",
  "encounter_id": "00742",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.74,
      "end_seconds": 13.51,
      "duration_seconds": 12.77,
      "text": "Hello, doctor. I've come about the weight clinic, I think? Or was it the diabetes clinic? Oh, the letter's in my bag somewhere."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.62,
      "end_seconds": 24.9,
      "duration_seconds": 10.28,
      "text": "The obesity clinic, yes, I've got your referral here. Don't worry about the letter. Tell me what you're hoping for today. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.37,
      "end_seconds": 39.92,
      "duration_seconds": 13.55,
      "text": "To lose weight. I've been trying for years, diets, the gym, all of it, and I put it all back on. I'm up to the highest I've ever been."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.59,
      "end_seconds": 48.79,
      "duration_seconds": 6.2,
      "text": "How much do you weigh now, as far as you know?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.56,
      "end_seconds": 63.67,
      "duration_seconds": 12.11,
      "text": "I haven't weighed myself in a month, because the scales scare me. Last time it was a hundred and fourteen."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.07,
      "end_seconds": 70.69,
      "duration_seconds": 4.62,
      "text": "And how's that affecting you day to day? ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.0,
      "end_seconds": 80.74,
      "duration_seconds": 7.74,
      "text": "Knees ache, I get out of breath on the stairs, and I'm tired."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.74,
      "end_seconds": 88.24,
      "duration_seconds": 4.5,
      "text": "Any chest pain, or breathlessness at rest?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.83,
      "end_seconds": 94.36,
      "duration_seconds": 4.53,
      "text": "No, nothing at rest. Just on the stairs."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.12,
      "end_seconds": 100.44,
      "duration_seconds": 4.32,
      "text": "Let me measure you. Stand up, please. ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.01,
      "end_seconds": 107.28,
      "duration_seconds": 5.27,
      "text": "Do I have to take my shoes off? ~"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.9,
      "end_seconds": 136.14,
      "duration_seconds": 6.24,
      "text": "Please. I'll measure around your waist, over the belly button."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.09,
      "end_seconds": 141.88,
      "duration_seconds": 2.79,
      "text": "Is that bad? ~"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.59,
      "end_seconds": 152.22,
      "duration_seconds": 9.63,
      "text": "Your waist measures 112 centimetres, which is in the high-risk range for heart and diabetes problems."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.39,
      "end_seconds": 157.18,
      "duration_seconds": 2.79,
      "text": "Hmm. I figured. ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.52,
      "end_seconds": 178.58,
      "duration_seconds": 19.06,
      "text": "I'm going to be honest with you, and kind: this is a medical condition, not a failure of willpower. There are treatments, including injections, but we start by understanding your whole picture. ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.67,
      "end_seconds": 186.43,
      "duration_seconds": 5.76,
      "text": "I've heard about the injections. A neighbour has them. ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.3,
      "end_seconds": 199.88,
      "duration_seconds": 11.58,
      "text": "They can work very well for the right people. I'm not starting anything today, because I want your tests first. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.94,
      "end_seconds": 204.29,
      "duration_seconds": 2.35,
      "text": "What tests? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.34,
      "end_seconds": 222.17,
      "duration_seconds": 15.83,
      "text": "I'd like to arrange blood tests, for sugar, cholesterol, liver, kidneys and thyroid, to see what weight is doing to you and whether anything else is contributing."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.77,
      "end_seconds": 225.5,
      "duration_seconds": 1.73,
      "text": "When? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.37,
      "end_seconds": 233.29,
      "duration_seconds": 4.92,
      "text": "The nurse can take them before you leave. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.88,
      "end_seconds": 236.93,
      "duration_seconds": 2.05,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.76,
      "end_seconds": 247.06,
      "duration_seconds": 8.3,
      "text": "Next, a dietitian will see you, and I'd like you to see them before the next appointment."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.06,
      "end_seconds": 252.67,
      "duration_seconds": 4.61,
      "text": "A dietitian, not just a leaflet? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.06,
      "end_seconds": 262.76,
      "duration_seconds": 7.7,
      "text": "A proper person, for an hour, to look at what you eat and how. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.49,
      "end_seconds": 267.33,
      "duration_seconds": 2.84,
      "text": "That sounds helpful. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.03,
      "end_seconds": 280.94,
      "duration_seconds": 10.91,
      "text": "For now, keep a food diary for two weeks, everything you eat and drink, honestly, and walk twenty minutes a day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.0,
      "end_seconds": 289.44,
      "duration_seconds": 7.44,
      "text": "A diary, I can do that. I'll put it on my phone. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.05,
      "end_seconds": 295.78,
      "duration_seconds": 3.73,
      "text": "Don't change anything yet, just record. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.53,
      "end_seconds": 300.27,
      "duration_seconds": 1.74,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.99,
      "end_seconds": 304.82,
      "duration_seconds": 1.83,
      "text": "Any questions? ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.21,
      "end_seconds": 311.52,
      "duration_seconds": 4.31,
      "text": "Yes, where did I put my keys? ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.47,
      "end_seconds": 315.39,
      "duration_seconds": 2.92,
      "text": "Check your coat pocket. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.56,
      "end_seconds": 320.27,
      "duration_seconds": 3.71,
      "text": "There they are. Thank you, doctor. ~"
    }
  ]
}
