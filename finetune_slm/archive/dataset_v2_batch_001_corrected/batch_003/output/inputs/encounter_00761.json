{
  "schema_version": "1.0",
  "encounter_id": "00761",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 0.7,
      "end_seconds": 10.23,
      "duration_seconds": 9.53,
      "text": "Doctor, this is Callum, nineteen, rugby, collision with another player, can't move his right arm. I've put a sling on."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.55,
      "end_seconds": 17.94,
      "duration_seconds": 6.39,
      "text": "Thanks, Imogen. Callum, I'm Dr Shaw. Tell me what happened. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.44,
      "end_seconds": 29.08,
      "duration_seconds": 8.64,
      "text": "I got tackled. I went down on the shoulder, hard, and I felt it pop out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.86,
      "end_seconds": 33.47,
      "duration_seconds": 2.61,
      "text": "When did it happen?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.8,
      "end_seconds": 38.99,
      "duration_seconds": 4.19,
      "text": "40 minutes ago. Maybe an hour."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.94,
      "end_seconds": 45.01,
      "duration_seconds": 4.07,
      "text": "Where's the pain, and how bad?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.87,
      "end_seconds": 59.34,
      "duration_seconds": 11.47,
      "text": "Right shoulder, it's severe, ten out of ten, when I move it, and it feels like it's hanging off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.61,
      "end_seconds": 66.29,
      "duration_seconds": 4.68,
      "text": "Any numbness or tingling in your arm or hand?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.26,
      "end_seconds": 75.8,
      "duration_seconds": 6.54,
      "text": "Pins and needles in my hand, a bit. And my fingers feel weird."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.69,
      "end_seconds": 82.08,
      "duration_seconds": 5.39,
      "text": "Any head or neck injury, or pain in your neck?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.1,
      "end_seconds": 90.86,
      "duration_seconds": 6.76,
      "text": "No, no neck pain. My head's fine, I didn't bang it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.51,
      "end_seconds": 98.06,
      "duration_seconds": 4.55,
      "text": "Have you had a shoulder dislocation before?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.06,
      "end_seconds": 105.2,
      "duration_seconds": 6.14,
      "text": "Once, in school, the same shoulder. They put it back."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.05,
      "end_seconds": 112.21,
      "duration_seconds": 4.16,
      "text": "Are you taking anything at the moment?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.82,
      "end_seconds": 128.15,
      "duration_seconds": 14.33,
      "text": "Some tablets from the club doctor, a little white one for the muscles, I don't know its name, and creatine, I think, twice a day, but I forget some days."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.97,
      "end_seconds": 142.74,
      "duration_seconds": 12.77,
      "text": "Right. The white tablet you can't name, and the creatine twice a day but sometimes forgotten. Do you smoke or drink?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.57,
      "end_seconds": 150.81,
      "duration_seconds": 6.24,
      "text": "I drink at weekends. A few pints after the match."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 164.05,
      "end_seconds": 170.4,
      "duration_seconds": 6.35,
      "text": "Doctor, his obs. Pulse 92, blood pressure 130 over 80, oxygen 99 percent."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.59,
      "end_seconds": 182.17,
      "duration_seconds": 9.58,
      "text": "Thank you, Imogen. Callum, I'm going to look at the shoulder, and check pulses and feeling in your hand. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.25,
      "end_seconds": 205.09,
      "duration_seconds": 1.84,
      "text": "Go on."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.11,
      "end_seconds": 225.23,
      "duration_seconds": 19.12,
      "text": "The right shoulder looks squared off, the round contour is lost, and the head of the bone feels out of place at the front. Your radial pulse is present, and you have reduced feeling over the outer part of your upper arm."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.4,
      "end_seconds": 229.82,
      "duration_seconds": 2.42,
      "text": "Is it dislocated? ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.64,
      "end_seconds": 244.42,
      "duration_seconds": 11.78,
      "text": "Yes, I think the shoulder is dislocated, but I can't rule out an associated fracture until I've seen an X-ray."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.54,
      "end_seconds": 250.1,
      "duration_seconds": 3.56,
      "text": "Can you put it back? ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.72,
      "end_seconds": 262.9,
      "duration_seconds": 10.18,
      "text": "Yes, but I want an X-ray first, so we don't make anything worse. I'd like an X-ray of the shoulder now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 264.7,
      "end_seconds": 267.24,
      "duration_seconds": 2.54,
      "text": "I'll call radiology. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.47,
      "end_seconds": 273.53,
      "duration_seconds": 4.06,
      "text": "When can it go back in? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.29,
      "end_seconds": 286.77,
      "duration_seconds": 12.48,
      "text": "After the X-ray, we'll give you strong pain relief and sedation, and I'll put it back gently. I'd like Imogen to stay with you."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 288.13,
      "end_seconds": 290.67,
      "duration_seconds": 2.54,
      "text": "Of course. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.4,
      "end_seconds": 302.79,
      "duration_seconds": 10.39,
      "text": "Don't eat or drink anything until we've done it, and keep the sling on, with the arm resting against you."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.78,
      "end_seconds": 306.65,
      "duration_seconds": 1.87,
      "text": "Fine. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.3,
      "end_seconds": 315.83,
      "duration_seconds": 7.53,
      "text": "If your fingers go white, cold or completely numb, shout for the nurse straight away."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.7,
      "end_seconds": 320.13,
      "duration_seconds": 2.43,
      "text": "I will. ~"
    }
  ]
}
