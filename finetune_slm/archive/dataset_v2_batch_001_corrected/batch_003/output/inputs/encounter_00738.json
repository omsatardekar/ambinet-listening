{
  "schema_version": "1.0",
  "encounter_id": "00738",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.7,
      "end_seconds": 14.82,
      "duration_seconds": 14.12,
      "text": "Good morning, doctor. I'm sure it's nothing, but my partner thinks I should talk to someone, because I've been all over the place with my moods."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.8,
      "end_seconds": 23.25,
      "duration_seconds": 6.45,
      "text": "Thank you for coming. What has your partner noticed? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.76,
      "end_seconds": 39.14,
      "duration_seconds": 13.38,
      "text": "That I'm up and down. I can be flying on Monday, full of plans, and then flat by Thursday. And I snap more than I used to. ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.32,
      "end_seconds": 46.13,
      "duration_seconds": 5.81,
      "text": "Do you feel low at all, when you're flat?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.12,
      "end_seconds": 54.63,
      "duration_seconds": 6.51,
      "text": "Flat, not low. No, I wouldn't say low. I don't feel sad."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.83,
      "end_seconds": 63.55,
      "duration_seconds": 7.72,
      "text": "Any thoughts of harming yourself, or of life not being worth it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.78,
      "end_seconds": 67.54,
      "duration_seconds": 2.76,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.43,
      "end_seconds": 76.18,
      "duration_seconds": 7.75,
      "text": "When you're up, do you sleep much less, or feel your thoughts racing?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.05,
      "end_seconds": 84.73,
      "duration_seconds": 7.68,
      "text": "I sleep a bit less, perhaps. But not racing. No, nothing like that."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.85,
      "end_seconds": 88.65,
      "duration_seconds": 1.8,
      "text": "How's work?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.67,
      "end_seconds": 98.82,
      "duration_seconds": 7.15,
      "text": "I'm a marketing manager. It's been crazy, a big launch, sixty-hour weeks."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.55,
      "end_seconds": 104.22,
      "duration_seconds": 3.67,
      "text": "Do you drink, smoke, anything else?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.81,
      "end_seconds": 117.4,
      "duration_seconds": 11.59,
      "text": "I drink a bit at weekends, a few glasses of wine, and I'm trying to cut down on coffee."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.02,
      "end_seconds": 122.98,
      "duration_seconds": 2.96,
      "text": "And do you exercise?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.61,
      "end_seconds": 130.22,
      "duration_seconds": 5.61,
      "text": "I run three times a week, when I'm not too tired."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.81,
      "end_seconds": 136.66,
      "duration_seconds": 4.85,
      "text": "Any history of mental health problems, past or present?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.06,
      "end_seconds": 150.26,
      "duration_seconds": 11.2,
      "text": "I had anxiety at university, and an episode of low mood in my twenties after a break-up. That's all."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.72,
      "end_seconds": 157.86,
      "duration_seconds": 6.14,
      "text": "Let me check you over. Pulse and blood pressure. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.98,
      "end_seconds": 162.34,
      "duration_seconds": 2.36,
      "text": "Go ahead. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.19,
      "end_seconds": 181.84,
      "duration_seconds": 6.65,
      "text": "Pulse 74, blood pressure 118 over 74, temperature 36.6, oxygen 99 percent."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.5,
      "end_seconds": 186.27,
      "duration_seconds": 1.77,
      "text": "Fine? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.6,
      "end_seconds": 194.34,
      "duration_seconds": 6.74,
      "text": "Fine. Any breathlessness or palpitations when you're up, any heat intolerance?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.52,
      "end_seconds": 197.11,
      "duration_seconds": 1.59,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.54,
      "end_seconds": 201.51,
      "duration_seconds": 2.97,
      "text": "Hold your hands out. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.55,
      "end_seconds": 206.13,
      "duration_seconds": 2.58,
      "text": "Like this? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.43,
      "end_seconds": 226.28,
      "duration_seconds": 8.85,
      "text": "Steady, no tremor. And you're making good eye contact, and you speak calmly and clearly."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.16,
      "end_seconds": 229.96,
      "duration_seconds": 2.8,
      "text": "Do I sound mad? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.2,
      "end_seconds": 238.94,
      "duration_seconds": 6.74,
      "text": "Not at all. You sound like someone who's very busy, and tired. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.98,
      "end_seconds": 242.39,
      "duration_seconds": 2.41,
      "text": "That's about right. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.15,
      "end_seconds": 254.43,
      "duration_seconds": 9.28,
      "text": "Sixty-hour weeks, less sleep, and alcohol can all make moods swing without it being a mental illness. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.86,
      "end_seconds": 258.45,
      "duration_seconds": 2.59,
      "text": "That's reassuring, actually. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.63,
      "end_seconds": 268.65,
      "duration_seconds": 8.02,
      "text": "I'm not dismissing it. Keep a mood diary for a month, with your sleep, caffeine and alcohol."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.99,
      "end_seconds": 273.16,
      "duration_seconds": 3.17,
      "text": "My partner will love that. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.87,
      "end_seconds": 282.14,
      "duration_seconds": 7.27,
      "text": "Aim for a regular bedtime, and keep the wine for one or two evenings."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.03,
      "end_seconds": 285.51,
      "duration_seconds": 1.48,
      "text": "Understood. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.5,
      "end_seconds": 299.7,
      "duration_seconds": 11.2,
      "text": "If you start to feel very high, can't sleep at all for several days, or feel low or hopeless, ring us at once."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.48,
      "end_seconds": 306.0,
      "duration_seconds": 3.52,
      "text": "I will. Thank you. ~"
    }
  ]
}
