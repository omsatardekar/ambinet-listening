{
  "schema_version": "1.0",
  "encounter_id": "00657",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.04,
      "end_seconds": 13.86,
      "duration_seconds": 12.82,
      "text": "Yeah, g'day. Look, I'm not really sure why I'm here, the kidney lady said to come and see you. Something about my numbers going down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.9,
      "end_seconds": 23.65,
      "duration_seconds": 7.75,
      "text": "No worries. Do you remember which numbers, or what she said they meant? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.58,
      "end_seconds": 39.74,
      "duration_seconds": 15.16,
      "text": "Nah, not really. Just that the kidney one's been dropping over the last few tests. I didn't ask a lot of questions, to be honest. ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.0,
      "end_seconds": 51.01,
      "duration_seconds": 9.01,
      "text": "That's all right, I've got the results here, and I'll explain them. First, how have you been feeling? ~"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.96,
      "end_seconds": 61.79,
      "duration_seconds": 7.83,
      "text": "Tired, mostly. Dragging myself around. It's been like that since the winter, I reckon."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.46,
      "end_seconds": 67.56,
      "duration_seconds": 3.1,
      "text": "Anything else that you've noticed? ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.8,
      "end_seconds": 77.78,
      "duration_seconds": 7.98,
      "text": "My ankles puff up by the end of the day, my socks leave marks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.32,
      "end_seconds": 81.0,
      "duration_seconds": 1.68,
      "text": "Both ankles?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.72,
      "end_seconds": 88.24,
      "duration_seconds": 4.52,
      "text": "Both, yeah. Though the left's a bit worse."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.78,
      "end_seconds": 97.81,
      "duration_seconds": 7.03,
      "text": "Have you noticed any blood in your urine, or has it been frothy?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.69,
      "end_seconds": 104.78,
      "duration_seconds": 6.09,
      "text": "No blood. It's bubbly sometimes, I suppose, but no blood."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.7,
      "end_seconds": 115.28,
      "duration_seconds": 7.58,
      "text": "Do you get up at night to pass water more than before? ~"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.24,
      "end_seconds": 122.21,
      "duration_seconds": 4.97,
      "text": "Once, maybe twice. About the same as always. ~"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.33,
      "end_seconds": 128.8,
      "duration_seconds": 4.47,
      "text": "Anyone in the family with kidney trouble?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.47,
      "end_seconds": 143.27,
      "duration_seconds": 11.8,
      "text": "My mum. She ended up with kidney failure, around sixty. She was on dialysis for a bit before she passed."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.74,
      "end_seconds": 151.26,
      "duration_seconds": 6.52,
      "text": "I'm sorry. That's helpful for me to know. Any trouble with your breathing?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.58,
      "end_seconds": 156.11,
      "duration_seconds": 2.53,
      "text": "No, my breathing's fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.24,
      "end_seconds": 167.02,
      "duration_seconds": 8.78,
      "text": "Okay, I'm going to have a look at you. Can you pop up on the bed? ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.39,
      "end_seconds": 169.93,
      "duration_seconds": 1.54,
      "text": "Sure. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.34,
      "end_seconds": 191.31,
      "duration_seconds": 4.97,
      "text": "Press here, does that pinch? I'm checking your ankles."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.11,
      "end_seconds": 195.52,
      "duration_seconds": 2.41,
      "text": "Nah, no pain. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.24,
      "end_seconds": 206.95,
      "duration_seconds": 10.71,
      "text": "There's mild swelling around both ankles, a bit more on the left, and when I press it leaves a dent."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.89,
      "end_seconds": 213.18,
      "duration_seconds": 3.29,
      "text": "Is that the kidneys? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.17,
      "end_seconds": 225.65,
      "duration_seconds": 11.48,
      "text": "It can be, it's a sign the body's holding on to fluid. Now your chest, deep breath in. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.26,
      "end_seconds": 228.71,
      "duration_seconds": 1.45,
      "text": "In. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.23,
      "end_seconds": 245.4,
      "duration_seconds": 3.17,
      "text": "Your lungs are clear. Good."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.52,
      "end_seconds": 249.72,
      "duration_seconds": 3.2,
      "text": "What's your thinking, doc? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.46,
      "end_seconds": 271.52,
      "duration_seconds": 19.06,
      "text": "The kidney number, called the eGFR, is lower than it should be and it's been falling. With the tiredness and swelling, I can't rule out something blocking the flow of urine, though a slow, long-term kidney problem is more likely."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.19,
      "end_seconds": 277.75,
      "duration_seconds": 3.56,
      "text": "Right. And what do we do? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.03,
      "end_seconds": 287.61,
      "duration_seconds": 8.58,
      "text": "I'd like to arrange a kidney ultrasound, to look at their size and check there's no blockage."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.11,
      "end_seconds": 293.82,
      "duration_seconds": 4.71,
      "text": "Is that the jelly on the belly? ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.75,
      "end_seconds": 307.87,
      "duration_seconds": 12.12,
      "text": "That's the one. And I'd like a urine test to look for protein. You'll collect a sample in the morning."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.57,
      "end_seconds": 312.57,
      "duration_seconds": 2.0,
      "text": "Easy. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.34,
      "end_seconds": 323.33,
      "duration_seconds": 9.99,
      "text": "Try to eat less salt, because it makes the ankles swell, and put your feet up in the evenings."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.11,
      "end_seconds": 331.54,
      "duration_seconds": 5.43,
      "text": "Salt. Okay. I do love a pie. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.82,
      "end_seconds": 344.31,
      "duration_seconds": 11.49,
      "text": "Maybe fewer pies. If the swelling spreads up your legs, or you start passing much less urine, come back sooner."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.98,
      "end_seconds": 348.86,
      "duration_seconds": 2.88,
      "text": "Right. I'll do that. ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.77,
      "end_seconds": 357.14,
      "duration_seconds": 7.37,
      "text": "I'll have the results to go over with you when they're back. ~"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.74,
      "end_seconds": 361.08,
      "duration_seconds": 2.34,
      "text": "Thanks, doc. ~"
    }
  ]
}
