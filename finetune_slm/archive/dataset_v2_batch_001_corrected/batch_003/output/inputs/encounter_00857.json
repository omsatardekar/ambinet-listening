{
  "schema_version": "1.0",
  "encounter_id": "00857",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 1.15,
      "end_seconds": 17.47,
      "duration_seconds": 16.32,
      "text": "Good morning, doctor. I'm Bimla, I look after Mrs Mehta every day, and she's got this cough and she keeps clearing her throat. It's driving us both mad."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.21,
      "end_seconds": 24.07,
      "duration_seconds": 3.86,
      "text": "Namaste, doctor. Yes, doctor. This cough."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.5,
      "end_seconds": 30.03,
      "duration_seconds": 4.53,
      "text": "How long has it been, Mrs Mehta?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.47,
      "end_seconds": 38.21,
      "duration_seconds": 5.74,
      "text": "Since the pneumonia, doctor. After the hospital. Three months."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 41.01,
      "end_seconds": 49.88,
      "duration_seconds": 8.87,
      "text": "She had a chest infection in July, and ever since, she's been clearing her throat, all day, and coughing."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.94,
      "end_seconds": 58.1,
      "duration_seconds": 7.16,
      "text": "Is it a dry cough, or does it bring up phlegm?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.85,
      "end_seconds": 67.12,
      "duration_seconds": 7.27,
      "text": "Dry, mostly. A tickle in the throat. And the throat clearing."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.95,
      "end_seconds": 70.77,
      "duration_seconds": 2.82,
      "text": "When is it worst?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.25,
      "end_seconds": 75.85,
      "duration_seconds": 3.6,
      "text": "After meals. And lying down."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.19,
      "end_seconds": 81.0,
      "duration_seconds": 2.81,
      "text": "What are you taking?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 82.14,
      "end_seconds": 90.63,
      "duration_seconds": 8.49,
      "text": "Omeprazole, 20 mg, once a day, and a blood pressure tablet, amlodipine, 5 mg."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.9,
      "end_seconds": 95.03,
      "duration_seconds": 3.13,
      "text": "Any other health conditions?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 97.61,
      "end_seconds": 107.41,
      "duration_seconds": 9.8,
      "text": "She had pneumonia, as I said. And high blood pressure. And her thyroid, she had an operation on it, in 2005."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.7,
      "end_seconds": 113.61,
      "duration_seconds": 4.91,
      "text": "Let me ask about the operation. What was it?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 115.03,
      "end_seconds": 119.75,
      "duration_seconds": 4.72,
      "text": "Half her thyroid taken out, in 2005."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.27,
      "end_seconds": 124.54,
      "duration_seconds": 3.27,
      "text": "Does she smoke or drink?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 126.92,
      "end_seconds": 128.63,
      "duration_seconds": 1.71,
      "text": "No. Never."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.36,
      "end_seconds": 135.17,
      "duration_seconds": 3.81,
      "text": "Pulse, pressure, and so on. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 136.12,
      "end_seconds": 145.81,
      "duration_seconds": 9.69,
      "text": "I've taken them, doctor. Pulse 78, blood pressure 138 over 82, oxygen 97 percent, temperature 36.6, weight 58 kilos."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.57,
      "end_seconds": 153.9,
      "duration_seconds": 7.33,
      "text": "Thank you. Mrs Mehta, I'll listen to your chest and look in your throat. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.23,
      "end_seconds": 176.83,
      "duration_seconds": 1.6,
      "text": "Yes, doctor."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.72,
      "end_seconds": 190.62,
      "duration_seconds": 10.9,
      "text": "Your chest is clear, and your throat is slightly red at the back, with some cobblestoning, but nothing worrying."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 193.31,
      "end_seconds": 196.54,
      "duration_seconds": 3.23,
      "text": "Is it the lungs? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.51,
      "end_seconds": 219.46,
      "duration_seconds": 20.95,
      "text": "The chest X-ray they did in hospital after pneumonia was clear, and so is my examination today. The pattern, a dry tickly cough, throat clearing, worse after meals and lying down, makes me think of reflux, silent reflux, or a post-infection cough."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.81,
      "end_seconds": 225.2,
      "duration_seconds": 4.39,
      "text": "Reflux, doctor? I have no heartburn. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.06,
      "end_seconds": 234.59,
      "duration_seconds": 6.53,
      "text": "It can happen without heartburn. We call it laryngopharyngeal reflux. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 237.15,
      "end_seconds": 240.68,
      "duration_seconds": 3.53,
      "text": "Can she take something? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.49,
      "end_seconds": 253.17,
      "duration_seconds": 9.68,
      "text": "She's already on omeprazole once a day. I'd like to increase it to twice a day, and see if that helps."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.55,
      "end_seconds": 256.29,
      "duration_seconds": 1.74,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.61,
      "end_seconds": 272.98,
      "duration_seconds": 15.37,
      "text": "And I'd like to arrange a blood test, to check your thyroid and blood count, because of the operation, and a repeat chest X-ray, and a breathing test, to be thorough."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 275.5,
      "end_seconds": 277.5,
      "duration_seconds": 2.0,
      "text": "When? ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.8,
      "end_seconds": 283.35,
      "duration_seconds": 3.55,
      "text": "Over the next two weeks. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.01,
      "end_seconds": 287.12,
      "duration_seconds": 2.11,
      "text": "Okay, doctor. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.63,
      "end_seconds": 299.49,
      "duration_seconds": 10.86,
      "text": "Avoid eating late, raise the head of the bed, and avoid spicy food, tea and coffee after lunch."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 301.55,
      "end_seconds": 304.25,
      "duration_seconds": 2.7,
      "text": "I'll do that. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.21,
      "end_seconds": 319.07,
      "duration_seconds": 11.86,
      "text": "I'd like to see her again in four weeks. If she coughs up blood, loses weight, or gets breathless, come back sooner."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 319.92,
      "end_seconds": 322.66,
      "duration_seconds": 2.74,
      "text": "Thank you, doctor. ~"
    }
  ]
}
