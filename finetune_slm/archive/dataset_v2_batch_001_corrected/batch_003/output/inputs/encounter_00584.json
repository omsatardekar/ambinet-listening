{
  "schema_version": "1.0",
  "encounter_id": "00584",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 1.22,
      "end_seconds": 8.84,
      "duration_seconds": 7.62,
      "text": "Hello Liam, come in and grab a seat. Bit blowy out there today, isn't it?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.26,
      "end_seconds": 18.25,
      "duration_seconds": 6.99,
      "text": "Yeah, the wind nearly took the car door off in the car park."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.51,
      "end_seconds": 28.87,
      "duration_seconds": 8.36,
      "text": "Parking here is a nightmare on a Thursday. Did you find a spot alright?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.75,
      "end_seconds": 36.45,
      "duration_seconds": 6.7,
      "text": "Mum dropped me round the corner. She's probably circling the block right now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.16,
      "end_seconds": 47.94,
      "duration_seconds": 9.78,
      "text": "Fair enough. Your mum's note says you've been wandering about at night. What's been going on?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.39,
      "end_seconds": 57.32,
      "duration_seconds": 7.93,
      "text": "Nothing much. I just do the sleepwalking thing. Honestly, it's not a big deal."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.64,
      "end_seconds": 67.38,
      "duration_seconds": 7.74,
      "text": "If you're asleep at the time, how do you even know it's happening?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.32,
      "end_seconds": 79.64,
      "duration_seconds": 11.32,
      "text": "Mum or my brother finds me. Standing in the hallway, or halfway into the fridge. I don't remember any of it."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.2,
      "end_seconds": 87.04,
      "duration_seconds": 5.84,
      "text": "How long has this been going on, would you say?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.96,
      "end_seconds": 90.99,
      "duration_seconds": 3.03,
      "text": "About three months, I guess."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.63,
      "end_seconds": 98.96,
      "duration_seconds": 6.33,
      "text": "And how often do you get one of these nights?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.38,
      "end_seconds": 109.14,
      "duration_seconds": 7.76,
      "text": "A couple of times a week. Sometimes less, sometimes a bit more."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.79,
      "end_seconds": 116.33,
      "duration_seconds": 4.54,
      "text": "What time of night do they usually turn up?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.7,
      "end_seconds": 125.05,
      "duration_seconds": 6.35,
      "text": "Mum reckons pretty early, an hour or two after I go to bed."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.83,
      "end_seconds": 133.7,
      "duration_seconds": 7.87,
      "text": "Has it ever taken you out of the house, or onto the street?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.16,
      "end_seconds": 141.23,
      "duration_seconds": 5.07,
      "text": "No, never. Just downstairs once, into the kitchen."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.97,
      "end_seconds": 150.74,
      "duration_seconds": 6.77,
      "text": "And have you ever hurt yourself, bumped into things, anything like that?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.95,
      "end_seconds": 160.67,
      "duration_seconds": 8.72,
      "text": "No, nothing like that. Mum says I walk round stuff better asleep than awake."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.25,
      "end_seconds": 167.15,
      "duration_seconds": 4.9,
      "text": "Ha, that's actually common. People steer around furniture quite well."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.41,
      "end_seconds": 175.99,
      "duration_seconds": 6.58,
      "text": "Right. Anyway, I think it's mostly mum who's worried, not me."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.5,
      "end_seconds": 188.07,
      "duration_seconds": 9.57,
      "text": "She's allowed to be. Are you taking anything at the moment, tablets, vitamins, anything like that?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.39,
      "end_seconds": 196.45,
      "duration_seconds": 7.06,
      "text": "Just melatonin. Mum picked it up from the chemist after the last doctor's visit."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.17,
      "end_seconds": 203.07,
      "duration_seconds": 5.9,
      "text": "And how much do you take, and how often?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.85,
      "end_seconds": 214.66,
      "duration_seconds": 8.81,
      "text": "One before bed, every night. 3 milligrams, I think? Maybe it's 5, I'd have to check the box."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.05,
      "end_seconds": 222.43,
      "duration_seconds": 5.38,
      "text": "Do you manage to take it every single night?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.81,
      "end_seconds": 234.54,
      "duration_seconds": 9.73,
      "text": "Yeah, every night. Well, most nights. I forget a couple of times a week if I'm wrecked."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.28,
      "end_seconds": 242.15,
      "duration_seconds": 5.87,
      "text": "Okay, thanks for being straight with me. That's useful to know."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.55,
      "end_seconds": 253.34,
      "duration_seconds": 8.79,
      "text": "Now, before we go any further, are there any allergies I should write down?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.2,
      "end_seconds": 267.02,
      "duration_seconds": 10.82,
      "text": "Yeah, penicillin, I think. Mum says I reacted to it when I was little, but I don't know what actually happened."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.01,
      "end_seconds": 273.97,
      "duration_seconds": 4.96,
      "text": "So you react to penicillin, but nobody remembers how."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.85,
      "end_seconds": 280.3,
      "duration_seconds": 5.45,
      "text": "Pretty much. It's written in the front of my health book."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.79,
      "end_seconds": 293.69,
      "duration_seconds": 10.9,
      "text": "Good, I'll note it. Let me check your blood pressure and pulse while you're here. Rest your arm on the desk for me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.15,
      "end_seconds": 298.58,
      "duration_seconds": 2.43,
      "text": "Sure, no worries."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.36,
      "end_seconds": 320.29,
      "duration_seconds": 5.93,
      "text": "Blood pressure is 112 over 68, and your pulse is 64."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.03,
      "end_seconds": 324.93,
      "duration_seconds": 1.9,
      "text": "Is that good?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.99,
      "end_seconds": 335.67,
      "duration_seconds": 8.68,
      "text": "That's a nice reading for a teenager. Nothing for you to fret about there."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.54,
      "end_seconds": 344.16,
      "duration_seconds": 5.62,
      "text": "Cool. So what do I do about the sleepwalking?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.71,
      "end_seconds": 355.5,
      "duration_seconds": 9.79,
      "text": "Mostly it's about the bedroom set-up, nothing fancy. First, keep the same bedtime and wake-up time every day, weekends included."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 357.8,
      "end_seconds": 361.7,
      "duration_seconds": 3.9,
      "text": "Weekends are the best bit, though."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.11,
      "end_seconds": 371.26,
      "duration_seconds": 8.15,
      "text": "I know, lie-ins are tempting. Also keep the floor clear and shut the windows at night."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 373.52,
      "end_seconds": 381.04,
      "duration_seconds": 7.52,
      "text": "Mum already put a little bell on my door, which is pretty embarrassing."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 383.49,
      "end_seconds": 388.71,
      "duration_seconds": 5.22,
      "text": "Honestly, that's a smart idea. Leave it there for now."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 389.46,
      "end_seconds": 395.13,
      "duration_seconds": 5.67,
      "text": "Ha, fine. Will the melatonin fix it, d'you reckon?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 396.86,
      "end_seconds": 408.54,
      "duration_seconds": 11.68,
      "text": "Hard to promise. Let's not change anything today. Keep taking it, and try to get it in every night."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 411.32,
      "end_seconds": 416.01,
      "duration_seconds": 4.69,
      "text": "Okay. Is it going to get worse?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 418.79,
      "end_seconds": 427.85,
      "duration_seconds": 9.06,
      "text": "Plenty of teenagers grow out of these nights over time. Does it bother you much yourself?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 430.53,
      "end_seconds": 434.79,
      "duration_seconds": 4.26,
      "text": "Nah, it's just annoying for mum, mostly."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 435.58,
      "end_seconds": 442.99,
      "duration_seconds": 7.41,
      "text": "Fair enough. Here's the plan. Give the changes a good go and see how you travel."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 445.86,
      "end_seconds": 455.94,
      "duration_seconds": 10.08,
      "text": "If it's still happening in six weeks, come back and see me and we'll talk about what else we can try."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 457.16,
      "end_seconds": 460.88,
      "duration_seconds": 3.72,
      "text": "What if something happens before then?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 462.7,
      "end_seconds": 473.88,
      "duration_seconds": 11.18,
      "text": "If you ever go outside or hurt yourself, ring the clinic that same day, don't wait for the six weeks."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 475.71,
      "end_seconds": 478.14,
      "duration_seconds": 2.43,
      "text": "Okay. I'll tell mum."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 479.21,
      "end_seconds": 485.11,
      "duration_seconds": 5.9,
      "text": "Good. And you can tell her she's free to park now."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 487.82,
      "end_seconds": 491.74,
      "duration_seconds": 3.92,
      "text": "Ha, I'll text her. Thanks, doc."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 492.76,
      "end_seconds": 498.0,
      "duration_seconds": 5.24,
      "text": "Cheers, mate. Mind the wind on your way out."
    }
  ]
}
