{
  "schema_version": "1.0",
  "encounter_id": "00800",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 1.38,
      "end_seconds": 10.38,
      "duration_seconds": 9.0,
      "text": "Mr Gallagher? I'm Una, I'll check you first. You're looking flushed. Arm out. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.49,
      "end_seconds": 16.31,
      "duration_seconds": 3.82,
      "text": "I feel rotten. Cold. Aching. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 32.53,
      "end_seconds": 40.27,
      "duration_seconds": 7.74,
      "text": "Temperature 37.9, pulse 104, blood pressure 108 over 66, oxygen 97 percent."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.43,
      "end_seconds": 52.69,
      "duration_seconds": 10.26,
      "text": "Mr Gallagher, I'm Dr Moran. Una says you're unwell with a cold and you take adrenal tablets. Tell me."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.24,
      "end_seconds": 62.57,
      "duration_seconds": 8.33,
      "text": "I've got Addison's. Hydrocortisone. I've a cold since Monday. Aching, sore throat, snotty. And I feel weak."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.54,
      "end_seconds": 65.31,
      "duration_seconds": 1.77,
      "text": "Weak how?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.26,
      "end_seconds": 71.05,
      "duration_seconds": 3.79,
      "text": "Legs heavy. Dizzy when I stand."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.13,
      "end_seconds": 76.67,
      "duration_seconds": 2.54,
      "text": "Any vomiting or diarrhoea?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.53,
      "end_seconds": 81.88,
      "duration_seconds": 2.35,
      "text": "No. Not yet."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.99,
      "end_seconds": 89.85,
      "duration_seconds": 5.86,
      "text": "Have you doubled your hydrocortisone, the sick day rule? ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.62,
      "end_seconds": 96.96,
      "duration_seconds": 4.34,
      "text": "I took my usual. Didn't think. ~"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.14,
      "end_seconds": 104.82,
      "duration_seconds": 6.68,
      "text": "That's the reason you're feeling so rough, probably. Any abdominal pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.5,
      "end_seconds": 107.68,
      "duration_seconds": 1.18,
      "text": "No."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.02,
      "end_seconds": 114.6,
      "duration_seconds": 4.58,
      "text": "Any confusion, or have you passed out?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.43,
      "end_seconds": 117.33,
      "duration_seconds": 0.9,
      "text": "No."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.34,
      "end_seconds": 121.63,
      "duration_seconds": 3.29,
      "text": "Have you had any operations?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.59,
      "end_seconds": 126.5,
      "duration_seconds": 1.91,
      "text": "Appendix, in 1999."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.29,
      "end_seconds": 135.36,
      "duration_seconds": 6.07,
      "text": "Who do you live with, who'd notice if you got worse?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.03,
      "end_seconds": 139.39,
      "duration_seconds": 1.36,
      "text": "My brother."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.58,
      "end_seconds": 144.1,
      "duration_seconds": 3.52,
      "text": "Let me examine you. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.52,
      "end_seconds": 164.9,
      "duration_seconds": 1.38,
      "text": "Right."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.23,
      "end_seconds": 177.52,
      "duration_seconds": 10.29,
      "text": "Your throat's red, your chest is clear, and your skin is warm and dry, but you're a little dehydrated."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 178.39,
      "end_seconds": 183.33,
      "duration_seconds": 4.94,
      "text": "His blood pressure's low for him, doctor. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.48,
      "end_seconds": 202.52,
      "duration_seconds": 18.04,
      "text": "Noted. Mr Gallagher, with Addison's, a cold can tip you into a crisis if your steroid dose isn't increased. So I'd say this is early adrenal insufficiency brought on by the infection, but I can't rule out a crisis."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.15,
      "end_seconds": 205.97,
      "duration_seconds": 1.82,
      "text": "A crisis? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.92,
      "end_seconds": 224.9,
      "duration_seconds": 15.98,
      "text": "A dangerous drop in your steroid level. We'll prevent it. I'd like you to take hydrocortisone 20 mg now, and then 20 mg twice a day for three days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 227.76,
      "end_seconds": 232.53,
      "duration_seconds": 4.77,
      "text": "I'll get his first dose now, doctor. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.7,
      "end_seconds": 243.49,
      "duration_seconds": 9.79,
      "text": "I'd also like you to take paracetamol, 1 gram, for the fever and aches, up to four times a day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.9,
      "end_seconds": 246.46,
      "duration_seconds": 1.56,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.21,
      "end_seconds": 262.21,
      "duration_seconds": 14.0,
      "text": "I'd like to take blood tests for salts, sugar and infection, and I'd like him to wait here for an hour, until the BP improves."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 264.01,
      "end_seconds": 268.42,
      "duration_seconds": 4.41,
      "text": "I'll set him up in the bay. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.94,
      "end_seconds": 275.84,
      "duration_seconds": 4.9,
      "text": "Drink plenty of fluids, salty ones if you can."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.08,
      "end_seconds": 278.6,
      "duration_seconds": 1.52,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.51,
      "end_seconds": 295.52,
      "duration_seconds": 14.01,
      "text": "If you vomit, can't keep your tablets down, or get very drowsy, you need an injection, and the ambulance, straight away. Tell your brother."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.05,
      "end_seconds": 302.52,
      "duration_seconds": 4.47,
      "text": "I will. I carry the injection kit. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.56,
      "end_seconds": 305.96,
      "duration_seconds": 1.4,
      "text": "Good. ~"
    }
  ]
}
