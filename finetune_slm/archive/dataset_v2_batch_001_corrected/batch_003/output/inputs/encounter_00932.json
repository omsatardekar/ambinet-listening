{
  "schema_version": "1.0",
  "encounter_id": "00932",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.24,
      "end_seconds": 11.8,
      "duration_seconds": 7.56,
      "text": "Good afternoon. How would you like me to call you, Finn, or Mr Gallagher? ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.81,
      "end_seconds": 20.94,
      "duration_seconds": 4.13,
      "text": "Finn is fine, thank you, doctor. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 25.49,
      "end_seconds": 32.65,
      "duration_seconds": 7.16,
      "text": "And I'm Aoife, I look after him after school. His mum's at work. ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.79,
      "end_seconds": 45.48,
      "duration_seconds": 8.69,
      "text": "Lovely. Finn, you're here for your follow-up after the sore throat. How's it been? ~"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.98,
      "end_seconds": 55.24,
      "duration_seconds": 5.26,
      "text": "Better, thanks. My throat's been sore for about three days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 59.76,
      "end_seconds": 66.68,
      "duration_seconds": 6.92,
      "text": "Five days, Finn. It was before the weekend, I'd say five at least."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.09,
      "end_seconds": 77.94,
      "duration_seconds": 6.85,
      "text": "So between three and five days, we'll say. And is it still sore?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.2,
      "end_seconds": 86.38,
      "duration_seconds": 4.18,
      "text": "A little bit, when I swallow. ~"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.57,
      "end_seconds": 94.79,
      "duration_seconds": 4.22,
      "text": "Any fever since the antibiotic started?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 98.86,
      "end_seconds": 103.63,
      "duration_seconds": 4.77,
      "text": "No, nothing. His temperature's been normal, I checked."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.3,
      "end_seconds": 111.52,
      "duration_seconds": 3.22,
      "text": "And what's he taking, Aoife?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 116.09,
      "end_seconds": 124.09,
      "duration_seconds": 8.0,
      "text": "Amoxicillin, 10 ml, three times a day. And paracetamol syrup when he needs it."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.27,
      "end_seconds": 132.3,
      "duration_seconds": 4.03,
      "text": "It's 5 ml. I measure it myself."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 137.27,
      "end_seconds": 143.59,
      "duration_seconds": 6.32,
      "text": "It's 10, Finn, I've the bottle here and I do it."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.57,
      "end_seconds": 156.39,
      "duration_seconds": 8.82,
      "text": "Two different amounts, so I'll check the prescription. Finn, have you had any problems like this before?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 160.39,
      "end_seconds": 164.45,
      "duration_seconds": 4.06,
      "text": "He's had tonsillitis three times this year."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.84,
      "end_seconds": 170.34,
      "duration_seconds": 1.5,
      "text": "Any operations?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 175.31,
      "end_seconds": 179.61,
      "duration_seconds": 4.3,
      "text": "Grommets in his ears when he was three."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.44,
      "end_seconds": 198.3,
      "duration_seconds": 6.86,
      "text": "Right, let me have a look. Open wide and say ahh."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.29,
      "end_seconds": 205.13,
      "duration_seconds": 1.84,
      "text": "Ahh. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.12,
      "end_seconds": 216.97,
      "duration_seconds": 6.85,
      "text": "The tonsils are much less red and swollen than last time."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 221.2,
      "end_seconds": 224.17,
      "duration_seconds": 2.97,
      "text": "Is that good? ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.37,
      "end_seconds": 235.09,
      "duration_seconds": 6.72,
      "text": "Very good. And I can't see any white patches on them now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.65,
      "end_seconds": 243.81,
      "duration_seconds": 4.16,
      "text": "Can I go back to school? ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.4,
      "end_seconds": 257.89,
      "duration_seconds": 9.49,
      "text": "Once you're eating and drinking normally and you've finished the antibiotic, yes. I think the tonsillitis is clearing up."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 262.34,
      "end_seconds": 265.69,
      "duration_seconds": 3.35,
      "text": "Does he need anything else? ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.7,
      "end_seconds": 279.67,
      "duration_seconds": 9.97,
      "text": "Not at the moment. If it doesn't settle by the end of the course, I might do a throat swab."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 283.94,
      "end_seconds": 285.86,
      "duration_seconds": 1.92,
      "text": "That's fine. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.21,
      "end_seconds": 298.63,
      "duration_seconds": 8.42,
      "text": "Make sure he finishes all of the amoxicillin, even when he feels well."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 303.71,
      "end_seconds": 305.99,
      "duration_seconds": 2.28,
      "text": "I will. ~"
    }
  ]
}
