{
  "schema_version": "1.0",
  "encounter_id": "00938",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 3.31,
      "end_seconds": 15.91,
      "duration_seconds": 12.6,
      "text": "Um, sorry, I've got these blisters on my chest, and they're very painful. I think it might be shingles, but I'm not sure."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.09,
      "end_seconds": 25.9,
      "duration_seconds": 5.81,
      "text": "Let's have a look at the story. Where are they, exactly?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.2,
      "end_seconds": 38.03,
      "duration_seconds": 7.83,
      "text": "On the right side of my chest, in a band, round to my back."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.36,
      "end_seconds": 46.86,
      "duration_seconds": 4.5,
      "text": "When did you first notice them?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.63,
      "end_seconds": 56.39,
      "duration_seconds": 5.76,
      "text": "Four days ago? Maybe five? I think it started with a tingling."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 60.63,
      "end_seconds": 66.49,
      "duration_seconds": 5.86,
      "text": "In the triage notes you said Tuesday, so that's four days."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.76,
      "end_seconds": 73.24,
      "duration_seconds": 2.48,
      "text": "Yes, Tuesday, I suppose."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.84,
      "end_seconds": 79.89,
      "duration_seconds": 3.05,
      "text": "Is it painful or itchy?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.05,
      "end_seconds": 87.9,
      "duration_seconds": 3.85,
      "text": "Burning, mostly. It's worse at night."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.98,
      "end_seconds": 95.4,
      "duration_seconds": 3.42,
      "text": "Any fever, or feeling unwell?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.8,
      "end_seconds": 103.66,
      "duration_seconds": 3.86,
      "text": "A bit achy, but no fever."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.25,
      "end_seconds": 111.33,
      "duration_seconds": 4.08,
      "text": "Any blisters near your eyes, or your face?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.98,
      "end_seconds": 119.48,
      "duration_seconds": 3.5,
      "text": "No. Only on the chest."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.36,
      "end_seconds": 127.44,
      "duration_seconds": 4.08,
      "text": "Have you had chickenpox in the past?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.54,
      "end_seconds": 133.94,
      "duration_seconds": 2.4,
      "text": "As a child, yes."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.91,
      "end_seconds": 142.57,
      "duration_seconds": 4.66,
      "text": "Do you have any allergies to medicines?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.01,
      "end_seconds": 149.27,
      "duration_seconds": 3.26,
      "text": "No, I don't have any allergies."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 153.8,
      "end_seconds": 164.87,
      "duration_seconds": 11.07,
      "text": "Doctor, I've done his observations. Pulse 78, blood pressure 130 over 82, temperature 36.9, oxygen 98 percent, breathing 16."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.07,
      "end_seconds": 176.55,
      "duration_seconds": 7.48,
      "text": "Thank you. Let me look at the rash. Please lift your shirt. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.33,
      "end_seconds": 197.02,
      "duration_seconds": 1.69,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.38,
      "end_seconds": 212.62,
      "duration_seconds": 11.24,
      "text": "Clusters of blisters on a red base, in a band on the right chest wall, not crossing the middle. That is classic for shingles."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.25,
      "end_seconds": 219.16,
      "duration_seconds": 2.91,
      "text": "So it is shingles? ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.76,
      "end_seconds": 235.48,
      "duration_seconds": 11.72,
      "text": "Yes. Because you're within the first few days, I'd like to start an antiviral, aciclovir, 800 mg, five times a day for seven days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.04,
      "end_seconds": 242.18,
      "duration_seconds": 3.14,
      "text": "Five times a day? ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.66,
      "end_seconds": 255.26,
      "duration_seconds": 8.6,
      "text": "Yes, about every four hours while you're awake. And simple painkillers for the pain. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.72,
      "end_seconds": 262.2,
      "duration_seconds": 2.48,
      "text": "Is it contagious? ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.25,
      "end_seconds": 277.45,
      "duration_seconds": 11.2,
      "text": "To anyone who hasn't had chickenpox, yes, until the blisters crust over. Please avoid pregnant women, babies and anyone with a weak immune system."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 281.65,
      "end_seconds": 286.43,
      "duration_seconds": 4.78,
      "text": "I'll give you a leaflet on that. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.92,
      "end_seconds": 299.6,
      "duration_seconds": 8.68,
      "text": "I'd like to see you again in a week, to check how it's healing."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.15,
      "end_seconds": 305.98,
      "duration_seconds": 2.83,
      "text": "Thank you, doctor. ~"
    }
  ]
}
