{
  "schema_version": "1.0",
  "encounter_id": "00795",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 0.47,
      "end_seconds": 7.83,
      "duration_seconds": 7.36,
      "text": "Mr Menon, the booking says headaches with light sensitivity. Is that right?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.72,
      "end_seconds": 22.86,
      "duration_seconds": 12.14,
      "text": "Yes, doctor. I've been so worried. They're throbbing, on the right side, and the light hurts my eyes, and I keep thinking it's a tumour."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.34,
      "end_seconds": 31.24,
      "duration_seconds": 6.9,
      "text": "I understand the worry. Let's find out what's going on. How long?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.37,
      "end_seconds": 41.23,
      "duration_seconds": 8.86,
      "text": "About six months. Two times a week, roughly. Do you think it could be serious?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.99,
      "end_seconds": 47.92,
      "duration_seconds": 5.93,
      "text": "Let's get the facts first. When one starts, what happens?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.54,
      "end_seconds": 58.73,
      "duration_seconds": 9.19,
      "text": "First, I see zigzag lights, for twenty minutes. Then the headache. And then I feel sick. Nauseous, I mean."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.92,
      "end_seconds": 64.46,
      "duration_seconds": 4.54,
      "text": "Does light bother you during the headache?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.6,
      "end_seconds": 73.98,
      "duration_seconds": 8.38,
      "text": "Yes, I have to go into a dark room. Even my phone screen hurts."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.87,
      "end_seconds": 80.49,
      "duration_seconds": 4.62,
      "text": "Any weakness on one side, or trouble speaking?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.88,
      "end_seconds": 86.75,
      "duration_seconds": 3.87,
      "text": "No weakness, doctor. Is that good?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.12,
      "end_seconds": 94.48,
      "duration_seconds": 5.36,
      "text": "It is. Any fever or stiff neck with it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.72,
      "end_seconds": 98.96,
      "duration_seconds": 3.24,
      "text": "No fever, no stiff neck."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.64,
      "end_seconds": 103.44,
      "duration_seconds": 2.8,
      "text": "Any head injury recently?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.34,
      "end_seconds": 108.68,
      "duration_seconds": 3.34,
      "text": "No, I haven't hit my head."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.91,
      "end_seconds": 114.07,
      "duration_seconds": 3.16,
      "text": "What medicines do you use?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.43,
      "end_seconds": 128.2,
      "duration_seconds": 12.77,
      "text": "Paracetamol, 1 gram, when the headache comes. Ibuprofen, 400 mg, also when it comes. And amitriptyline, 10 mg, at night, my GP started it."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.56,
      "end_seconds": 133.12,
      "duration_seconds": 2.56,
      "text": "Any allergies to medicines?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.27,
      "end_seconds": 137.95,
      "duration_seconds": 3.68,
      "text": "Penicillin. My face swelled up once."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.97,
      "end_seconds": 141.37,
      "duration_seconds": 2.4,
      "text": "Your health history?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.08,
      "end_seconds": 150.28,
      "duration_seconds": 6.2,
      "text": "Anxiety, since college. And iron deficiency anaemia, two years ago."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.07,
      "end_seconds": 153.14,
      "duration_seconds": 1.07,
      "text": "Operations?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.37,
      "end_seconds": 159.3,
      "duration_seconds": 4.93,
      "text": "Tonsillectomy at seven. Wisdom teeth, in 2018."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.81,
      "end_seconds": 163.65,
      "duration_seconds": 2.84,
      "text": "Headaches in the family?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.57,
      "end_seconds": 167.96,
      "duration_seconds": 2.39,
      "text": "My mother gets migraines."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.33,
      "end_seconds": 172.85,
      "duration_seconds": 2.52,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.46,
      "end_seconds": 181.29,
      "duration_seconds": 5.83,
      "text": "Software engineer, ten hours a day in front of screens."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.31,
      "end_seconds": 183.35,
      "duration_seconds": 1.04,
      "text": "Caffeine?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.49,
      "end_seconds": 190.46,
      "duration_seconds": 5.97,
      "text": "Three cups of chai every day, and a coffee."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.15,
      "end_seconds": 210.51,
      "duration_seconds": 8.36,
      "text": "Let me check your pulse and pressure. Pulse 72, blood pressure 120 over 76."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.46,
      "end_seconds": 213.94,
      "duration_seconds": 1.48,
      "text": "Normal? ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.21,
      "end_seconds": 228.59,
      "duration_seconds": 5.38,
      "text": "Normal. Now follow my finger with your eyes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.8,
      "end_seconds": 232.7,
      "duration_seconds": 1.9,
      "text": "Like this? ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.5,
      "end_seconds": 242.22,
      "duration_seconds": 6.72,
      "text": "Your pupils are equal and react to light, and the eye movements are normal."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.95,
      "end_seconds": 248.62,
      "duration_seconds": 3.67,
      "text": "What does that mean? ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.43,
      "end_seconds": 262.15,
      "duration_seconds": 11.72,
      "text": "It means no sign of pressure on the nerves. Your neck is supple and not stiff either, and there's no tenderness over the temples."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.78,
      "end_seconds": 267.21,
      "duration_seconds": 2.43,
      "text": "And the tumour? ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.61,
      "end_seconds": 275.66,
      "duration_seconds": 6.05,
      "text": "Let me ask about your vision between headaches. Any changes, double vision?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.49,
      "end_seconds": 280.55,
      "duration_seconds": 4.06,
      "text": "No, nothing, my vision is fine between them."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.64,
      "end_seconds": 285.32,
      "duration_seconds": 2.68,
      "text": "And any numbness, tingling?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.4,
      "end_seconds": 288.3,
      "duration_seconds": 1.9,
      "text": "No, no tingling."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.76,
      "end_seconds": 303.04,
      "duration_seconds": 13.28,
      "text": "Everything points to migraine, with aura, the zigzag lights. I can't rule out a tension-type headache contributing, given the screens and the stress."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.86,
      "end_seconds": 309.34,
      "duration_seconds": 3.48,
      "text": "But why not a tumour? ~"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.57,
      "end_seconds": 321.47,
      "duration_seconds": 10.9,
      "text": "Nothing in the examination suggests it, but because you're worried I'd like to arrange an MRI of the brain."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.95,
      "end_seconds": 326.83,
      "duration_seconds": 3.88,
      "text": "Thank you, I will sleep better. ~"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.47,
      "end_seconds": 339.68,
      "duration_seconds": 10.21,
      "text": "I'd also like to do blood tests for thyroid and iron, and an eye test with an optometrist."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.83,
      "end_seconds": 346.22,
      "duration_seconds": 4.39,
      "text": "Good, good. And the headaches themselves? ~"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.45,
      "end_seconds": 355.69,
      "duration_seconds": 7.24,
      "text": "Keep a headache diary, and take the paracetamol early, at the first sign."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.47,
      "end_seconds": 361.64,
      "duration_seconds": 3.17,
      "text": "I'll start tonight. ~"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.89,
      "end_seconds": 368.34,
      "duration_seconds": 4.45,
      "text": "I'd like to see you again in six weeks."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 369.11,
      "end_seconds": 375.62,
      "duration_seconds": 6.51,
      "text": "Six weeks. Thank you, doctor, I feel better already. ~"
    }
  ]
}
