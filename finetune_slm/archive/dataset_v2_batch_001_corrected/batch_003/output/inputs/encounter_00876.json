{
  "schema_version": "1.0",
  "encounter_id": "00876",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 2.56,
      "end_seconds": 10.1,
      "duration_seconds": 7.54,
      "text": "Um, hello. It's my tonsils again, they seem to be infected. I'm sorry to bother you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.96,
      "end_seconds": 20.25,
      "duration_seconds": 6.29,
      "text": "You're not bothering me at all. Tell me how it started."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.11,
      "end_seconds": 31.1,
      "duration_seconds": 6.99,
      "text": "A sore throat, about four days ago. Now it's hard to swallow."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.72,
      "end_seconds": 37.5,
      "duration_seconds": 3.78,
      "text": "Is it on one side or both?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.26,
      "end_seconds": 45.08,
      "duration_seconds": 3.82,
      "text": "Both, but the left is worse."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.17,
      "end_seconds": 54.98,
      "duration_seconds": 5.81,
      "text": "Have you had a fever, or white spots on the tonsils?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.74,
      "end_seconds": 67.52,
      "duration_seconds": 8.78,
      "text": "I felt hot and shivery two nights ago. I didn't look at my tonsils, I'm too nervous."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.05,
      "end_seconds": 74.36,
      "duration_seconds": 3.31,
      "text": "Any rash, or trouble breathing?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.65,
      "end_seconds": 81.04,
      "duration_seconds": 3.39,
      "text": "No rash. No trouble breathing."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.72,
      "end_seconds": 90.26,
      "duration_seconds": 5.54,
      "text": "How many times have you had tonsillitis this year?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.4,
      "end_seconds": 98.11,
      "duration_seconds": 4.71,
      "text": "This is the fourth time. Maybe the fifth."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.5,
      "end_seconds": 106.31,
      "duration_seconds": 4.81,
      "text": "That's a lot. What are you taking now?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.26,
      "end_seconds": 116.96,
      "duration_seconds": 6.7,
      "text": "Paracetamol, 1 gram, four times a day. And lozenges, whenever I remember."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.39,
      "end_seconds": 122.89,
      "duration_seconds": 2.5,
      "text": "Any other tablets?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.58,
      "end_seconds": 128.54,
      "duration_seconds": 2.96,
      "text": "Just the pill, the contraceptive."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.62,
      "end_seconds": 135.08,
      "duration_seconds": 2.46,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.21,
      "end_seconds": 139.73,
      "duration_seconds": 1.52,
      "text": "No. Never."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.4,
      "end_seconds": 147.56,
      "duration_seconds": 5.16,
      "text": "Let me take your temperature and pulse. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.37,
      "end_seconds": 160.97,
      "duration_seconds": 1.6,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.6,
      "end_seconds": 167.36,
      "duration_seconds": 2.76,
      "text": "Temperature 37.9, pulse 92."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.85,
      "end_seconds": 173.55,
      "duration_seconds": 2.7,
      "text": "Is that high? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.77,
      "end_seconds": 183.54,
      "duration_seconds": 6.77,
      "text": "A mild fever. Now open your mouth for me, and say ah. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.99,
      "end_seconds": 202.26,
      "duration_seconds": 1.27,
      "text": "Ahh."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.9,
      "end_seconds": 216.08,
      "duration_seconds": 11.18,
      "text": "Both tonsils are red and swollen, with white patches on the left, and the glands in your neck are tender."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.36,
      "end_seconds": 223.27,
      "duration_seconds": 3.91,
      "text": "Does that mean it's infected? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.92,
      "end_seconds": 237.58,
      "duration_seconds": 10.66,
      "text": "Yes, it looks like bacterial tonsillitis. I'll prescribe penicillin V, 500 mg, four times a day for ten days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.26,
      "end_seconds": 245.41,
      "duration_seconds": 5.15,
      "text": "Ten days? I'd rather it was shorter. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.0,
      "end_seconds": 256.84,
      "duration_seconds": 7.84,
      "text": "Ten days is needed to clear it properly. I know it's a long time. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.26,
      "end_seconds": 263.88,
      "duration_seconds": 3.62,
      "text": "All right. I'll do it. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.07,
      "end_seconds": 280.52,
      "duration_seconds": 13.45,
      "text": "With four or five episodes in a year, I'd also like to refer you to an ENT surgeon about taking the tonsils out."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.58,
      "end_seconds": 287.33,
      "duration_seconds": 2.75,
      "text": "Oh. That sounds scary. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.36,
      "end_seconds": 300.09,
      "duration_seconds": 9.73,
      "text": "It's very common, and it often helps people who get infections this often. They'll explain everything. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.77,
      "end_seconds": 305.99,
      "duration_seconds": 3.22,
      "text": "Okay. Thank you for explaining. ~"
    }
  ]
}
