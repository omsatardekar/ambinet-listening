{
  "schema_version": "1.0",
  "encounter_id": "00576",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.95,
      "end_seconds": 6.73,
      "duration_seconds": 5.78,
      "text": "Hi, sorry I'm late. The parking garage was full, so I circled twice."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.86,
      "end_seconds": 13.44,
      "duration_seconds": 5.58,
      "text": "That garage is a nightmare, and this rain didn't help."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.69,
      "end_seconds": 23.46,
      "duration_seconds": 7.77,
      "text": "I love the rain, it's the humidity that gets me. Anyway, such a week."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 26.0,
      "end_seconds": 31.88,
      "duration_seconds": 5.88,
      "text": "Hi again, Maria. I'll get your vitals before the doctor starts."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.16,
      "end_seconds": 39.29,
      "duration_seconds": 5.13,
      "text": "Sure. My daughter's recital is tonight, so I'm kind of distracted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 47.08,
      "end_seconds": 52.19,
      "duration_seconds": 5.11,
      "text": "Arm out for me. Doctor, numbers are on the screen."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.87,
      "end_seconds": 57.83,
      "duration_seconds": 3.96,
      "text": "Thanks, Jess. Maria, how's the lichen planus been?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.45,
      "end_seconds": 65.58,
      "duration_seconds": 6.13,
      "text": "Up and down. The rash on my wrists came back about four months ago."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.62,
      "end_seconds": 70.37,
      "duration_seconds": 3.75,
      "text": "Is it itchy, painful, or both?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.96,
      "end_seconds": 76.46,
      "duration_seconds": 4.5,
      "text": "Itchy, mostly. I scratch at night and wake up."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.42,
      "end_seconds": 83.0,
      "duration_seconds": 4.58,
      "text": "So the itching at night is waking you?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.69,
      "end_seconds": 91.33,
      "duration_seconds": 6.64,
      "text": "Yes, most nights. Oh, and my mouth too. These sore patches inside my cheeks."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.78,
      "end_seconds": 98.24,
      "duration_seconds": 4.46,
      "text": "Tell me about the mouth. When did that start?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.18,
      "end_seconds": 105.46,
      "duration_seconds": 6.28,
      "text": "Maybe two months back? They sting when I eat spicy food."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.13,
      "end_seconds": 112.1,
      "duration_seconds": 4.97,
      "text": "Okay. Any trouble swallowing, or feeling like food is catching?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.63,
      "end_seconds": 118.77,
      "duration_seconds": 4.14,
      "text": "No, swallowing's fine. Everything goes down okay."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.49,
      "end_seconds": 124.07,
      "duration_seconds": 3.58,
      "text": "Any fever or feeling feverish recently?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.07,
      "end_seconds": 131.51,
      "duration_seconds": 6.44,
      "text": "No fever. Just a scratchy throat last week, probably my son's cold."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.98,
      "end_seconds": 138.62,
      "duration_seconds": 4.64,
      "text": "Noted. Any hair falling out, or changes in your nails?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.48,
      "end_seconds": 143.81,
      "duration_seconds": 4.33,
      "text": "No, hair's the same. Nails are fine too."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.19,
      "end_seconds": 149.04,
      "duration_seconds": 2.85,
      "text": "What about joint pain or stiffness?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.96,
      "end_seconds": 152.9,
      "duration_seconds": 2.94,
      "text": "Nope, my joints are good."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.58,
      "end_seconds": 160.63,
      "duration_seconds": 6.05,
      "text": "Let's go over your medications. What are you taking right now?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.83,
      "end_seconds": 169.45,
      "duration_seconds": 7.62,
      "text": "Okay, so there's the levothyroxine, 50 micrograms in the morning. And the omeprazole, 20 mg before breakfast."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.01,
      "end_seconds": 174.94,
      "duration_seconds": 2.93,
      "text": "Good. And for the itching?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.59,
      "end_seconds": 186.24,
      "duration_seconds": 8.65,
      "text": "The hydroxyzine, 25 mg at bedtime, for the itch. It makes me groggy, but it helps."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.58,
      "end_seconds": 191.38,
      "duration_seconds": 2.8,
      "text": "Any creams at the moment?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.04,
      "end_seconds": 199.19,
      "duration_seconds": 6.15,
      "text": "I ran out of the steroid cream last month. Is that bad?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.62,
      "end_seconds": 209.7,
      "duration_seconds": 8.08,
      "text": "No, we'll talk about it. Let me ask about allergies first. Any allergies to medicines?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.08,
      "end_seconds": 216.56,
      "duration_seconds": 5.48,
      "text": "Yes, sulfa drugs. I got hives from a sulfa antibiotic years ago."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.14,
      "end_seconds": 225.36,
      "duration_seconds": 6.22,
      "text": "I'll flag that. Any other medical history besides the lichen planus?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.5,
      "end_seconds": 235.5,
      "duration_seconds": 9.0,
      "text": "The thyroid, obviously, my underactive thyroid for about ten years. And acid reflux. And I get migraines now and then."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.67,
      "end_seconds": 241.92,
      "duration_seconds": 4.25,
      "text": "Okay. How long have you had the lichen planus?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.94,
      "end_seconds": 249.71,
      "duration_seconds": 5.77,
      "text": "Two years. I was diagnosed after the mouth thing first showed up."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.64,
      "end_seconds": 252.33,
      "duration_seconds": 1.69,
      "text": "Any surgeries?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.21,
      "end_seconds": 260.81,
      "duration_seconds": 6.6,
      "text": "Just my tonsils out as a kid. I was eight, I think."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.24,
      "end_seconds": 266.59,
      "duration_seconds": 4.35,
      "text": "Family history? Anything like autoimmune disease, skin problems, diabetes?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.93,
      "end_seconds": 275.14,
      "duration_seconds": 6.21,
      "text": "My mom has diabetes, type 2. And my dad had melanoma."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.58,
      "end_seconds": 280.77,
      "duration_seconds": 4.19,
      "text": "Thanks. Let me ask about habits. Do you smoke?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.88,
      "end_seconds": 288.55,
      "duration_seconds": 6.67,
      "text": "I quit smoking about ten years ago. I was never a heavy smoker anyway."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.91,
      "end_seconds": 292.29,
      "duration_seconds": 1.38,
      "text": "And alcohol?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.01,
      "end_seconds": 298.52,
      "duration_seconds": 5.51,
      "text": "I drink maybe two glasses of wine a week."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.02,
      "end_seconds": 303.32,
      "duration_seconds": 3.3,
      "text": "What do you do for work?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.91,
      "end_seconds": 312.5,
      "duration_seconds": 7.59,
      "text": "I teach fifth grade. And I live with my husband and the two kids."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.12,
      "end_seconds": 319.87,
      "duration_seconds": 5.75,
      "text": "Busy household. Now, any chest symptoms, cough or trouble with your breathing?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.89,
      "end_seconds": 324.12,
      "duration_seconds": 3.23,
      "text": "No, my breathing's totally fine."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.45,
      "end_seconds": 339.27,
      "duration_seconds": 5.82,
      "text": "Good. Let me examine you. Wrists first, then mouth, scalp and nails."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.27,
      "end_seconds": 354.01,
      "duration_seconds": 9.74,
      "text": "On both wrists there are flat-topped, purple bumps with fine white lines. Inside both cheeks I see a white lacy pattern."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 354.93,
      "end_seconds": 359.93,
      "duration_seconds": 5.0,
      "text": "Is that bad? It looks worse than I thought."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.02,
      "end_seconds": 371.47,
      "duration_seconds": 10.45,
      "text": "It's consistent with what we expect. Your scalp has no scarring or bald patches, and your nails look normal."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.5,
      "end_seconds": 382.47,
      "duration_seconds": 8.97,
      "text": "Let me read your numbers. Blood pressure is 126 over 80, and pulse is 74."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 384.96,
      "end_seconds": 392.09,
      "duration_seconds": 7.13,
      "text": "Temperature is 36.8 degrees, and oxygen saturation is 99 percent. Weight is 71 kilograms."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 392.93,
      "end_seconds": 395.18,
      "duration_seconds": 2.25,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 396.8,
      "end_seconds": 402.34,
      "duration_seconds": 5.54,
      "text": "All reasonable. This looks like an active flare of lichen planus."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 404.28,
      "end_seconds": 408.84,
      "duration_seconds": 4.56,
      "text": "So it's not something new? Not something worse?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 410.89,
      "end_seconds": 415.84,
      "duration_seconds": 4.95,
      "text": "It doesn't look like it. But a closer look is sensible."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 418.06,
      "end_seconds": 421.78,
      "duration_seconds": 3.72,
      "text": "Meaning what? You're going to cut me?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 422.96,
      "end_seconds": 431.91,
      "duration_seconds": 8.95,
      "text": "A small punch biopsy of the wrist, yes. I'd like to arrange it for next week, under local anesthetic."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 433.45,
      "end_seconds": 436.16,
      "duration_seconds": 2.71,
      "text": "Ugh. Okay. Will it scar?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 438.9,
      "end_seconds": 444.01,
      "duration_seconds": 5.11,
      "text": "A tiny mark, no bigger than a pencil eraser."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 446.09,
      "end_seconds": 455.23,
      "duration_seconds": 9.14,
      "text": "I'd also like to order a hepatitis C blood test. It's linked with lichen planus, and we've never checked."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 457.84,
      "end_seconds": 461.13,
      "duration_seconds": 3.29,
      "text": "Okay. That makes me nervous."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 461.82,
      "end_seconds": 467.72,
      "duration_seconds": 5.9,
      "text": "Most people test negative. And we'll do a thyroid level too."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 470.04,
      "end_seconds": 475.28,
      "duration_seconds": 5.24,
      "text": "Fine. Does the steroid cream matter in the meantime?"
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 477.54,
      "end_seconds": 483.99,
      "duration_seconds": 6.45,
      "text": "Keep using it in thin layers on the wrists. My staff will renew it."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 485.08,
      "end_seconds": 495.48,
      "duration_seconds": 10.4,
      "text": "I can send the refill to your pharmacy today, and the lab slips are ready at the front desk."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 497.65,
      "end_seconds": 501.37,
      "duration_seconds": 3.72,
      "text": "Great. And if the rash isn't getting better?"
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 503.8,
      "end_seconds": 512.86,
      "duration_seconds": 9.06,
      "text": "If it's not improving in six weeks, come back and see me and we'll talk about stronger options."
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 514.78,
      "end_seconds": 518.99,
      "duration_seconds": 4.21,
      "text": "Okay. Thanks, I'm off to that recital now."
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 520.44,
      "end_seconds": 524.98,
      "duration_seconds": 4.54,
      "text": "Good luck, Maria. Drive safely and enjoy the show."
    }
  ]
}
