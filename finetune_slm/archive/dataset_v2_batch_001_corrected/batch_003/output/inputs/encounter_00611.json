{
  "schema_version": "1.0",
  "encounter_id": "00611",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 0.47,
      "end_seconds": 6.79,
      "duration_seconds": 6.32,
      "text": "Good afternoon. Mr Harold Bellamy? Have I got the right gentleman?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 7.75,
      "end_seconds": 12.59,
      "duration_seconds": 4.84,
      "text": "Harold, yes. Well, Harry. Everyone says Harry. Bellamy, yes."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.92,
      "end_seconds": 18.23,
      "duration_seconds": 3.31,
      "text": "Harry it is. And you are?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 19.53,
      "end_seconds": 26.74,
      "duration_seconds": 7.21,
      "text": "I'm Gwen, his daughter. I'm here most days. I'll fill in what he can't."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.68,
      "end_seconds": 37.74,
      "duration_seconds": 8.06,
      "text": "Good. I'm told the problem is the bowels. Harry, tell me in your words."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.31,
      "end_seconds": 47.02,
      "duration_seconds": 6.71,
      "text": "Constipation. I haven't been, um, for days. Four days. No, five. Gwen?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 48.15,
      "end_seconds": 56.07,
      "duration_seconds": 7.92,
      "text": "Five days since it last properly went, Dad. I wrote it down this morning."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.74,
      "end_seconds": 64.12,
      "duration_seconds": 6.38,
      "text": "Right. And did it start suddenly, or has it been creeping up?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.43,
      "end_seconds": 72.73,
      "duration_seconds": 6.3,
      "text": "It was last week. Or the week before. I really couldn't say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 75.28,
      "end_seconds": 85.9,
      "duration_seconds": 10.62,
      "text": "I couldn't give you a date either. He's always been a bit slow, but it got worse some time ago."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.42,
      "end_seconds": 95.34,
      "duration_seconds": 6.92,
      "text": "Fine, we'll leave the start date. Any bloating or tummy discomfort now?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.76,
      "end_seconds": 102.78,
      "duration_seconds": 6.02,
      "text": "I feel bloated. Like a drum. Like a football, really."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.66,
      "end_seconds": 107.53,
      "duration_seconds": 1.87,
      "text": "Any vomiting?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.03,
      "end_seconds": 113.5,
      "duration_seconds": 3.47,
      "text": "No, no vomiting. Just full."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.34,
      "end_seconds": 121.86,
      "duration_seconds": 6.52,
      "text": "Good. Gwen, which medicines is he taking? I want every one."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 123.25,
      "end_seconds": 126.22,
      "duration_seconds": 2.97,
      "text": "Amlodipine, 5 mg every morning."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.48,
      "end_seconds": 132.84,
      "duration_seconds": 4.36,
      "text": "Amlodipine 5 mg in the morning. Next?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 134.32,
      "end_seconds": 139.64,
      "duration_seconds": 5.32,
      "text": "Aspirin, 75 mg, once a day, with his breakfast."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.21,
      "end_seconds": 148.06,
      "duration_seconds": 6.85,
      "text": "The little pink one. Is it pink? Or is it white?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 150.12,
      "end_seconds": 158.88,
      "duration_seconds": 8.76,
      "text": "Dad, the pink one is the aspirin, I do it every breakfast. Leave the tablets to me."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.81,
      "end_seconds": 165.28,
      "duration_seconds": 4.47,
      "text": "We'll stay with the aspirin. And the third?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 166.1,
      "end_seconds": 174.43,
      "duration_seconds": 8.33,
      "text": "Co-codamol, for the arthritis in his hips. Two when it's bad, usually in the evening."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.3,
      "end_seconds": 183.54,
      "duration_seconds": 7.24,
      "text": "Co-codamol, as needed, for arthritis. Noted. Harry, what other health problems have you had?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.38,
      "end_seconds": 194.87,
      "duration_seconds": 9.49,
      "text": "A stroke. That's why I'm in the bed. It was... a few years ago. Four? Six?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 196.2,
      "end_seconds": 199.6,
      "duration_seconds": 3.4,
      "text": "Five years in March, Dad."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.35,
      "end_seconds": 207.87,
      "duration_seconds": 7.52,
      "text": "Five. Yes. And the blood pressure, the high blood pressure. And the arthritis."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.3,
      "end_seconds": 215.67,
      "duration_seconds": 5.37,
      "text": "Stroke, high blood pressure, arthritis. Anything I've missed?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 216.82,
      "end_seconds": 219.51,
      "duration_seconds": 2.69,
      "text": "That's all of it."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.2,
      "end_seconds": 225.33,
      "duration_seconds": 4.13,
      "text": "Right. And who lives here with him?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 226.74,
      "end_seconds": 236.35,
      "duration_seconds": 9.61,
      "text": "Mum died, so it's just Dad here. I stay over, three nights a week. A carer pops in as well."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.13,
      "end_seconds": 245.41,
      "duration_seconds": 6.28,
      "text": "Good. How are your waterworks, Harry? Passing water without trouble?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.4,
      "end_seconds": 249.41,
      "duration_seconds": 3.01,
      "text": "Fine. Fine, thank you. Normal."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.82,
      "end_seconds": 261.47,
      "duration_seconds": 4.65,
      "text": "Let me do your readings. Arm out, Harry."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.79,
      "end_seconds": 284.91,
      "duration_seconds": 8.12,
      "text": "Blood pressure 142 over 80. Pulse 78. Temperature 36.6. Oxygen 96 percent. Breathing 16."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 287.03,
      "end_seconds": 291.21,
      "duration_seconds": 4.18,
      "text": "Is that all right for him?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.74,
      "end_seconds": 302.82,
      "duration_seconds": 9.08,
      "text": "Perfectly acceptable. Now Harry, I'm going to feel your tummy. Tell me if anything hurts."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.7,
      "end_seconds": 307.43,
      "duration_seconds": 3.73,
      "text": "Go on. Oh, that's cold. Your hands."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.06,
      "end_seconds": 317.97,
      "duration_seconds": 1.91,
      "text": "Sorry about that."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.68,
      "end_seconds": 336.96,
      "duration_seconds": 6.28,
      "text": "Your tummy is swollen and firm on the left side."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.38,
      "end_seconds": 342.79,
      "duration_seconds": 3.41,
      "text": "That's where it feels full."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.69,
      "end_seconds": 349.05,
      "duration_seconds": 5.36,
      "text": "And there's no tenderness when I press. No wincing."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.38,
      "end_seconds": 354.0,
      "duration_seconds": 3.62,
      "text": "I'm a tough old boot."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 356.33,
      "end_seconds": 361.9,
      "duration_seconds": 5.57,
      "text": "He is not, he cried at the telly yesterday."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 363.34,
      "end_seconds": 364.61,
      "duration_seconds": 1.27,
      "text": "Gwen!"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.1,
      "end_seconds": 378.22,
      "duration_seconds": 12.12,
      "text": "Right. So here's what I want to do. I'd like to arrange an abdominal X-ray, to see what's going on inside."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 380.46,
      "end_seconds": 385.64,
      "duration_seconds": 5.18,
      "text": "Does he need to go to the hospital for it?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 386.42,
      "end_seconds": 396.21,
      "duration_seconds": 9.79,
      "text": "Yes, a transport service takes him and brings him back. The surgery will book it and ring you."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 396.92,
      "end_seconds": 400.07,
      "duration_seconds": 3.15,
      "text": "All right. That's fine."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 401.97,
      "end_seconds": 411.12,
      "duration_seconds": 9.15,
      "text": "Meanwhile, plenty of fluids, Gwen. A drink every hour he's awake. Prunes, porridge, whatever he'll eat."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 414.07,
      "end_seconds": 416.94,
      "duration_seconds": 2.87,
      "text": "I don't like prunes."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 419.71,
      "end_seconds": 423.78,
      "duration_seconds": 4.07,
      "text": "Then pears, or the juice. Whatever he'll take."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 424.65,
      "end_seconds": 429.46,
      "duration_seconds": 4.81,
      "text": "Pear juice. I can manage that. I think."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 432.09,
      "end_seconds": 434.74,
      "duration_seconds": 2.65,
      "text": "I'll sort it, Dad."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 436.51,
      "end_seconds": 446.14,
      "duration_seconds": 9.63,
      "text": "And keep giving the medicines exactly as you do now. Don't change anything till I've seen the X-ray."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 448.54,
      "end_seconds": 451.75,
      "duration_seconds": 3.21,
      "text": "Understood. Should I be worried?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 452.86,
      "end_seconds": 464.02,
      "duration_seconds": 11.16,
      "text": "You did the right thing calling us. I'll see you both again in one week, and we'll go through the picture."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 466.31,
      "end_seconds": 471.67,
      "duration_seconds": 5.36,
      "text": "One week. I'll be here. I'm not going anywhere, ha."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 472.58,
      "end_seconds": 480.77,
      "duration_seconds": 8.19,
      "text": "Thank you, doctor. I'll make us all a cup of tea before you go."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 483.17,
      "end_seconds": 489.94,
      "duration_seconds": 6.77,
      "text": "Kind of you, but I've another visit waiting. Take care, Harry."
    }
  ]
}
