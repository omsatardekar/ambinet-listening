{
  "schema_version": "1.0",
  "encounter_id": "00998",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 1.09,
      "end_seconds": 9.94,
      "duration_seconds": 8.85,
      "text": "Good to see you, Marcus. It's four weeks since the last injection. How have you been?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.17,
      "end_seconds": 13.88,
      "duration_seconds": 1.71,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.41,
      "end_seconds": 18.06,
      "duration_seconds": 1.65,
      "text": "Any voices?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.61,
      "end_seconds": 27.83,
      "duration_seconds": 7.22,
      "text": "Sometimes. Muffled. Not like before. I can't say when it last happened. Last week? Two?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.58,
      "end_seconds": 31.29,
      "duration_seconds": 1.71,
      "text": "And sleep?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.09,
      "end_seconds": 35.31,
      "duration_seconds": 3.22,
      "text": "Broken. Wake up a lot."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.14,
      "end_seconds": 41.62,
      "duration_seconds": 3.48,
      "text": "Any suspicious thoughts, feeling watched?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.2,
      "end_seconds": 48.07,
      "duration_seconds": 3.87,
      "text": "No. Not for a while."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.31,
      "end_seconds": 53.54,
      "duration_seconds": 3.23,
      "text": "Let's check the medications."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.52,
      "end_seconds": 66.41,
      "duration_seconds": 9.89,
      "text": "The injection, paliperidone, maybe 100 mg, monthly. Benztropine, 1 mg, at night. And sertraline, 50 mg, in the morning."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.21,
      "end_seconds": 75.84,
      "duration_seconds": 7.63,
      "text": "The nurse will check the injection dose on the chart. Any conditions I should record?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.19,
      "end_seconds": 82.55,
      "duration_seconds": 5.36,
      "text": "Schizophrenia. Anxiety. And I'm heavier than I was."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.46,
      "end_seconds": 86.42,
      "duration_seconds": 2.96,
      "text": "Where are you living?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.24,
      "end_seconds": 90.46,
      "duration_seconds": 2.22,
      "text": "Supported housing. Same place."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.62,
      "end_seconds": 93.07,
      "duration_seconds": 1.45,
      "text": "And work?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.77,
      "end_seconds": 98.45,
      "duration_seconds": 3.68,
      "text": "Garden centre. Three days a week."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.21,
      "end_seconds": 106.36,
      "duration_seconds": 7.15,
      "text": "You look calm today, and I see no tremor in your hands."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.76,
      "end_seconds": 110.61,
      "duration_seconds": 1.85,
      "text": "Good. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.4,
      "end_seconds": 118.17,
      "duration_seconds": 4.77,
      "text": "I'd say you're stable, with a few rough nights."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.97,
      "end_seconds": 122.34,
      "duration_seconds": 2.37,
      "text": "Stable. Okay. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.08,
      "end_seconds": 137.07,
      "duration_seconds": 11.99,
      "text": "Because the injection can raise weight and sugar, I'd like to arrange blood tests to check your cholesterol and sugar."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.66,
      "end_seconds": 140.27,
      "duration_seconds": 1.61,
      "text": "Fine. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.83,
      "end_seconds": 151.16,
      "duration_seconds": 8.33,
      "text": "Keep taking everything as prescribed, and keep your garden centre days, they're good for you."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.09,
      "end_seconds": 155.03,
      "duration_seconds": 2.94,
      "text": "I like the plants. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.21,
      "end_seconds": 169.89,
      "duration_seconds": 12.68,
      "text": "What are you growing at the moment? Tell me about the garden centre, I'm always looking for tips for my own patch. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.83,
      "end_seconds": 184.42,
      "duration_seconds": 13.59,
      "text": "Mostly tomatoes and herbs this month. The manager lets me look after the small greenhouse by myself on Wednesdays, and I water everything and write down the numbers. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.73,
      "end_seconds": 198.49,
      "duration_seconds": 12.76,
      "text": "That sounds like exactly the kind of routine that helps people stay well. Does anyone at work know about your treatment, or is that private? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.95,
      "end_seconds": 212.59,
      "duration_seconds": 12.64,
      "text": "The manager knows a bit. Nobody else. I prefer it that way, and she never asks me questions I don't want to answer. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.01,
      "end_seconds": 222.37,
      "duration_seconds": 8.36,
      "text": "That sounds like a very sensible and supportive arrangement, and it's your decision who knows. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.07,
      "end_seconds": 237.06,
      "duration_seconds": 12.99,
      "text": "I do think about telling one friend there, Dale, because he's kind. Maybe in the spring when things are quieter. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.83,
      "end_seconds": 255.01,
      "duration_seconds": 16.18,
      "text": "There's no hurry at all. If you'd like to talk it through, we can do that at your next visit, or the support team can help too. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.77,
      "end_seconds": 263.56,
      "duration_seconds": 6.79,
      "text": "Maybe. I'll think about it over the next few weeks while I'm planting. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.01,
      "end_seconds": 276.74,
      "duration_seconds": 10.73,
      "text": "Good. And how is the bus journey to work these days, is that still manageable for you on the three days? ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.21,
      "end_seconds": 287.46,
      "duration_seconds": 9.25,
      "text": "It's fine now. I leave early, and I sit at the front, and the driver knows me. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.73,
      "end_seconds": 295.5,
      "duration_seconds": 5.77,
      "text": "I'm glad. Little routines like that make a real difference. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.03,
      "end_seconds": 302.49,
      "duration_seconds": 5.46,
      "text": "I'd like to see you again in four weeks."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.17,
      "end_seconds": 305.99,
      "duration_seconds": 1.82,
      "text": "Okay. ~"
    }
  ]
}
