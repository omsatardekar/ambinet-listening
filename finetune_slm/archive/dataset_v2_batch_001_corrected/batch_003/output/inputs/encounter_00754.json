{
  "schema_version": "1.0",
  "encounter_id": "00754",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 0.79,
      "end_seconds": 12.52,
      "duration_seconds": 11.73,
      "text": "Mr Teague? Ben? I'm Kim, the nurse, I'll do your obs while we wait. You've got a bump there. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.68,
      "end_seconds": 24.55,
      "duration_seconds": 9.87,
      "text": "It's nothing. I stood up under a door frame, that's all. I've a job to finish. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 41.95,
      "end_seconds": 50.18,
      "duration_seconds": 8.23,
      "text": "Blood pressure 134 over 82, pulse 76, temperature 36.7, oxygen 99 percent, respiratory rate 16."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.43,
      "end_seconds": 62.45,
      "duration_seconds": 10.02,
      "text": "Hello, Ben, I'm Dr Lawson. I'll be quick, but I'd like you to tell me the whole story. What happened? ~"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.23,
      "end_seconds": 75.56,
      "duration_seconds": 10.33,
      "text": "Carpenter's mistake. I was kneeling, stood up and caught my forehead on a steel door frame. Hard."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.19,
      "end_seconds": 84.21,
      "duration_seconds": 6.02,
      "text": "Did you black out, or lose consciousness, even for a second?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.94,
      "end_seconds": 92.44,
      "duration_seconds": 7.5,
      "text": "No. I was dizzy for about a minute, saw stars, and then it went away."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.77,
      "end_seconds": 99.08,
      "duration_seconds": 4.31,
      "text": "And how are you feeling now?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.23,
      "end_seconds": 107.58,
      "duration_seconds": 6.35,
      "text": "Headache, a dull one, at the front. And a lump, which hurts."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.27,
      "end_seconds": 112.43,
      "duration_seconds": 3.16,
      "text": "Have you been sick since?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.42,
      "end_seconds": 117.7,
      "duration_seconds": 2.28,
      "text": "No, no sickness."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.49,
      "end_seconds": 124.42,
      "duration_seconds": 5.93,
      "text": "Any memory gap, where you can't remember what happened? ~"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.84,
      "end_seconds": 130.29,
      "duration_seconds": 4.45,
      "text": "No. I remember it all, unfortunately. ~"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.33,
      "end_seconds": 134.49,
      "duration_seconds": 2.16,
      "text": "Allergies to medicines?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.45,
      "end_seconds": 138.21,
      "duration_seconds": 1.76,
      "text": "Penicillin, rash."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.89,
      "end_seconds": 142.83,
      "duration_seconds": 1.94,
      "text": "And medical conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.35,
      "end_seconds": 148.08,
      "duration_seconds": 2.73,
      "text": "Migraines, and asthma, mild."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.54,
      "end_seconds": 154.59,
      "duration_seconds": 5.05,
      "text": "Does anyone in your family have blood or brain problems?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.5,
      "end_seconds": 161.54,
      "duration_seconds": 4.04,
      "text": "My mother had a stroke, at seventy."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.03,
      "end_seconds": 168.23,
      "duration_seconds": 5.2,
      "text": "And your work, you're a carpenter, any heavy machinery?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.91,
      "end_seconds": 176.26,
      "duration_seconds": 6.35,
      "text": "Yes, a lot, which is why I want to get back."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.76,
      "end_seconds": 184.65,
      "duration_seconds": 5.89,
      "text": "Let me examine you. Look at my finger. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.96,
      "end_seconds": 206.21,
      "duration_seconds": 1.25,
      "text": "Right."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.08,
      "end_seconds": 224.25,
      "duration_seconds": 15.17,
      "text": "There's a swollen, tender lump about three centimetres on the right of your forehead, the skin is intact, your pupils are equal and react normally, and your eye movements and balance are normal."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 226.95,
      "end_seconds": 229.98,
      "duration_seconds": 3.03,
      "text": "GCS is fifteen, doctor. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.46,
      "end_seconds": 244.62,
      "duration_seconds": 13.16,
      "text": "Thanks, Kim. Ben, I'm not going to send you for a scan, because you don't have any of the warning signs, and your examination is normal. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.24,
      "end_seconds": 247.88,
      "duration_seconds": 1.64,
      "text": "Good. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.45,
      "end_seconds": 257.77,
      "duration_seconds": 7.32,
      "text": "This looks like a minor head injury, with a bruise to the forehead."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.81,
      "end_seconds": 263.36,
      "duration_seconds": 4.55,
      "text": "Can I go back to work? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.53,
      "end_seconds": 278.08,
      "duration_seconds": 13.55,
      "text": "Not on the saws or at height today. Rest, ice the lump for twenty minutes every few hours, and take paracetamol if the headache troubles you."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.41,
      "end_seconds": 282.03,
      "duration_seconds": 2.62,
      "text": "I'll manage. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 283.75,
      "end_seconds": 288.45,
      "duration_seconds": 4.7,
      "text": "Someone should stay with you tonight, Ben. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.53,
      "end_seconds": 294.28,
      "duration_seconds": 4.75,
      "text": "My wife will be home at six. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 296.46,
      "end_seconds": 298.04,
      "duration_seconds": 1.58,
      "text": "Good. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.82,
      "end_seconds": 313.47,
      "duration_seconds": 12.65,
      "text": "Come back or call 999 if you become very drowsy, vomit repeatedly, have a fit, develop worsening headache, confusion, or clear fluid from the nose or ears."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.2,
      "end_seconds": 316.49,
      "duration_seconds": 2.29,
      "text": "Understood. Thanks, both. ~"
    }
  ]
}
