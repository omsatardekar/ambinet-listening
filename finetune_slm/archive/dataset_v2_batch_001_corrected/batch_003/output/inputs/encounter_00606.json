{
  "schema_version": "1.0",
  "encounter_id": "00606",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.91,
      "end_seconds": 11.26,
      "duration_seconds": 10.35,
      "text": "Hi, doc. Sorry, I know I'm early. My sister dropped me off and she drives like there's a fire behind her."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 12.66,
      "end_seconds": 18.15,
      "duration_seconds": 5.49,
      "text": "No problem at all. Take a seat. What's been going on?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.64,
      "end_seconds": 31.9,
      "duration_seconds": 12.26,
      "text": "The nights have been really hard. I can't even tell you. Last night I sat on the porch till four a.m."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.23,
      "end_seconds": 42.14,
      "duration_seconds": 7.91,
      "text": "That sounds exhausting. So the nights have been really hard, and it's wearing you down."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.12,
      "end_seconds": 53.15,
      "duration_seconds": 9.03,
      "text": "Yes! And my neighbor's dog barking doesn't help, he's got this bark like a rusty gate."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.94,
      "end_seconds": 61.94,
      "duration_seconds": 8.0,
      "text": "Let's focus on you for a moment. Are you still taking your usual medicines?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.98,
      "end_seconds": 71.57,
      "duration_seconds": 7.59,
      "text": "Oh, yes. I take the olanzapine, 10 milligrams, at bedtime, same as always."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.53,
      "end_seconds": 78.48,
      "duration_seconds": 4.95,
      "text": "Olanzapine, 10 milligrams at bedtime. Got it. Anything else?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.06,
      "end_seconds": 86.25,
      "duration_seconds": 5.19,
      "text": "The sertraline, 50 mg every morning with my coffee."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.06,
      "end_seconds": 94.59,
      "duration_seconds": 6.53,
      "text": "Sertraline, 50 mg every morning. Nurse, could you check the chart for me?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 96.09,
      "end_seconds": 102.54,
      "duration_seconds": 6.45,
      "text": "Sure, one second. The chart here says olanzapine, 15 milligrams at bedtime."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.52,
      "end_seconds": 111.61,
      "duration_seconds": 8.09,
      "text": "Fifteen? No, no. It's 10. Isn't it? The pharmacy gave me those little white ones."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 114.56,
      "end_seconds": 122.49,
      "duration_seconds": 7.93,
      "text": "The last prescription on file does say 15, but I can't see the bottle."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.07,
      "end_seconds": 138.15,
      "duration_seconds": 13.08,
      "text": "So we have 10 from you and 15 on the chart. We'll sort that out, don't worry. Did you bring the bottle?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.5,
      "end_seconds": 149.72,
      "duration_seconds": 9.22,
      "text": "I left it at my sister's. She told me to bring it, and of course I forgot."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.92,
      "end_seconds": 158.4,
      "duration_seconds": 7.48,
      "text": "Easy fix, we'll call the pharmacy afterwards. And the sertraline matches the chart, nurse?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 159.15,
      "end_seconds": 163.65,
      "duration_seconds": 4.5,
      "text": "Yes, 50 mg in the morning matches."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.14,
      "end_seconds": 174.78,
      "duration_seconds": 8.64,
      "text": "Good. Have you had a diagnosis of anything in the past, anything long term?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.5,
      "end_seconds": 183.32,
      "duration_seconds": 6.82,
      "text": "Schizophrenia. Since my twenties. I've been pretty stable for years until this month."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.14,
      "end_seconds": 192.36,
      "duration_seconds": 8.22,
      "text": "Thank you for telling me. Any allergies to medicines that I should know about?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.65,
      "end_seconds": 197.73,
      "duration_seconds": 4.08,
      "text": "Allergies? No, none that I know of."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.5,
      "end_seconds": 222.44,
      "duration_seconds": 9.94,
      "text": "Okay, none known. Let me check your vitals. Your blood pressure is 126 over 78 and your pulse is 88."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.27,
      "end_seconds": 229.67,
      "duration_seconds": 6.4,
      "text": "Is that okay? I never know what the numbers are supposed to be."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.09,
      "end_seconds": 241.53,
      "duration_seconds": 10.44,
      "text": "Both numbers are fine for you right now. Hold your hands out in front of you for me."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.69,
      "end_seconds": 245.39,
      "duration_seconds": 1.7,
      "text": "Like this?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.3,
      "end_seconds": 259.86,
      "duration_seconds": 4.56,
      "text": "Yes. Your hands are steady. That's reassuring."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.83,
      "end_seconds": 270.12,
      "duration_seconds": 9.29,
      "text": "My sister always checks my hands, and I always worry about it. Silly, I know."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.0,
      "end_seconds": 284.07,
      "duration_seconds": 11.07,
      "text": "Plenty of people worry about that, and nothing here suggests it. Now, when did the nights get worse?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.9,
      "end_seconds": 295.77,
      "duration_seconds": 8.87,
      "text": "About the time my work changed shifts. I'm on the late schedule now, and it's a mess."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.43,
      "end_seconds": 306.45,
      "duration_seconds": 8.02,
      "text": "So a new shift, less sleep, and the nights getting harder. Is that fair?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.78,
      "end_seconds": 317.93,
      "duration_seconds": 10.15,
      "text": "That's fair. I get home at midnight, and then the evening just drags on and on."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.13,
      "end_seconds": 328.04,
      "duration_seconds": 8.91,
      "text": "Here's my impression. This is most likely stress and broken sleep from the shift change, making your nights tougher."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.63,
      "end_seconds": 333.94,
      "duration_seconds": 3.31,
      "text": "So it's not the medicine failing?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.93,
      "end_seconds": 347.01,
      "duration_seconds": 11.08,
      "text": "I can't tell yet, and that's why the dose question matters. I'd like to order a blood test to check your medicine levels."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.79,
      "end_seconds": 352.16,
      "duration_seconds": 2.37,
      "text": "Okay. Does it hurt?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.29,
      "end_seconds": 363.35,
      "duration_seconds": 10.06,
      "text": "Just a quick needle in the arm. The nurse will take you through to the lab after we're done."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 365.97,
      "end_seconds": 369.65,
      "duration_seconds": 3.68,
      "text": "Right this way when you're ready."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 372.33,
      "end_seconds": 378.93,
      "duration_seconds": 6.6,
      "text": "My sister's going to say I told you so about the bottle."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.46,
      "end_seconds": 391.99,
      "duration_seconds": 11.53,
      "text": "Ha. Tell her the pharmacy call is on me. And keep taking both medicines exactly as you do now until we know the dose."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 393.83,
      "end_seconds": 401.93,
      "duration_seconds": 8.1,
      "text": "Same as now. 10 at night, 50 in the morning, as I said."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 403.61,
      "end_seconds": 414.67,
      "duration_seconds": 11.06,
      "text": "As you remember them, yes. Until we confirm. Try to wind down an hour before bed, dim lights, no phone."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 417.23,
      "end_seconds": 422.64,
      "duration_seconds": 5.41,
      "text": "I can try. The phone is my worst habit."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 424.53,
      "end_seconds": 432.88,
      "duration_seconds": 8.35,
      "text": "Come back and see me in two weeks, and we'll go through the blood results together."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 434.6,
      "end_seconds": 438.96,
      "duration_seconds": 4.36,
      "text": "Two weeks. I'll put it in my calendar."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 440.93,
      "end_seconds": 448.74,
      "duration_seconds": 7.81,
      "text": "And if the nights get frightening before then, call the clinic, day or night."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 450.95,
      "end_seconds": 455.76,
      "duration_seconds": 4.81,
      "text": "I will. Thanks for not rushing me, doc."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 457.94,
      "end_seconds": 465.73,
      "duration_seconds": 7.79,
      "text": "Anytime. So, to recap: bloods today, pharmacy call, same medicines, and back in two weeks."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 468.03,
      "end_seconds": 473.52,
      "duration_seconds": 5.49,
      "text": "Got it. Bloods, pharmacy, same pills, two weeks."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 474.62,
      "end_seconds": 477.65,
      "duration_seconds": 3.03,
      "text": "Perfect. Take care of yourself."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 479.84,
      "end_seconds": 483.48,
      "duration_seconds": 3.64,
      "text": "Follow me, I'll walk you out."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 484.88,
      "end_seconds": 486.49,
      "duration_seconds": 1.61,
      "text": "Bye, everybody."
    }
  ]
}
