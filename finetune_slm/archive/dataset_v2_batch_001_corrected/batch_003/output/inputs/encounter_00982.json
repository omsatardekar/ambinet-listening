{
  "schema_version": "1.0",
  "encounter_id": "00982",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 0.77,
      "end_seconds": 17.91,
      "duration_seconds": 17.14,
      "text": "Hi, doctor. I'm Tanya, Zoe's mum, and this is Nan, my mum, who looks after Zoe after school. Zoe's got her mock exams, and she's been in a state. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.88,
      "end_seconds": 26.43,
      "duration_seconds": 7.55,
      "text": "Hi, Zoe. Do you want to tell me, or would you rather Mum starts? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.75,
      "end_seconds": 29.57,
      "duration_seconds": 1.82,
      "text": "Mum. ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 31.89,
      "end_seconds": 45.74,
      "duration_seconds": 13.85,
      "text": "She's been getting these awful butterflies, and her heart races before every exam, and she's been waking up at three in the morning going over things."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.68,
      "end_seconds": 53.04,
      "duration_seconds": 4.36,
      "text": "Zoe, is that how it feels to you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.86,
      "end_seconds": 57.47,
      "duration_seconds": 1.61,
      "text": "Yeah. ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.51,
      "end_seconds": 61.43,
      "duration_seconds": 2.92,
      "text": "When did it start?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.74,
      "end_seconds": 65.45,
      "duration_seconds": 2.71,
      "text": "Dunno. Term two? Maybe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "CAREGIVER",
      "start_seconds": 67.75,
      "end_seconds": 71.44,
      "duration_seconds": 3.69,
      "text": "It was before Christmas, love."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 72.14,
      "end_seconds": 79.64,
      "duration_seconds": 7.5,
      "text": "I thought it was after the first mock. I can't be sure."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.95,
      "end_seconds": 84.36,
      "duration_seconds": 2.41,
      "text": "Fine. What about sleep?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.4,
      "end_seconds": 86.45,
      "duration_seconds": 1.05,
      "text": "Bad."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.09,
      "end_seconds": 93.69,
      "duration_seconds": 4.6,
      "text": "Anything running in the family, anxiety, worrying?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 96.57,
      "end_seconds": 101.65,
      "duration_seconds": 5.08,
      "text": "Me, yes, her mum. I was anxious as a teenager."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.68,
      "end_seconds": 106.77,
      "duration_seconds": 4.09,
      "text": "What year are you in, Zoe?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.34,
      "end_seconds": 109.65,
      "duration_seconds": 1.31,
      "text": "Twelve."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.85,
      "end_seconds": 114.4,
      "duration_seconds": 3.55,
      "text": "And outside school, what do you do?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.33,
      "end_seconds": 118.03,
      "duration_seconds": 1.7,
      "text": "Swim. Mornings."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.2,
      "end_seconds": 135.99,
      "duration_seconds": 5.79,
      "text": "Let me check you. Pulse 96, blood pressure 112 over 70."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 138.72,
      "end_seconds": 143.08,
      "duration_seconds": 4.36,
      "text": "That's a bit fast, isn't it? ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.59,
      "end_seconds": 159.15,
      "duration_seconds": 5.56,
      "text": "Slightly, she's nervous being here. Zoe, show me your hands?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.01,
      "end_seconds": 164.12,
      "duration_seconds": 3.11,
      "text": "They're always sweaty. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.76,
      "end_seconds": 171.42,
      "duration_seconds": 4.66,
      "text": "Your hands are cool and a bit clammy."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.62,
      "end_seconds": 174.2,
      "duration_seconds": 1.58,
      "text": "Gross. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.99,
      "end_seconds": 183.79,
      "duration_seconds": 7.8,
      "text": "Here's what I think. This looks like exam anxiety, and it's very common at this age."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 186.27,
      "end_seconds": 189.3,
      "duration_seconds": 3.03,
      "text": "Is it serious? ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.07,
      "end_seconds": 198.47,
      "duration_seconds": 6.4,
      "text": "Not dangerous, but it's making life hard, and it's worth helping. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "CAREGIVER",
      "start_seconds": 200.69,
      "end_seconds": 203.48,
      "duration_seconds": 2.79,
      "text": "What can we do? ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.69,
      "end_seconds": 215.86,
      "duration_seconds": 11.17,
      "text": "A few things. For the nights, I'd like to start melatonin, 2 mg, half an hour before bed."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 217.45,
      "end_seconds": 221.58,
      "duration_seconds": 4.13,
      "text": "Is it safe for her age? ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.05,
      "end_seconds": 241.51,
      "duration_seconds": 18.46,
      "text": "For short use, yes, and I'll review it. And for the exam days, I'd like to give propranolol, 10 mg, to take an hour before an exam, only on those days."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 243.46,
      "end_seconds": 246.96,
      "duration_seconds": 3.5,
      "text": "Will it make her drowsy? ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.71,
      "end_seconds": 257.66,
      "duration_seconds": 8.95,
      "text": "Not usually. It calms the shaky, racing feeling. Zoe, you can try it on a practice day first. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.5,
      "end_seconds": 262.31,
      "duration_seconds": 1.81,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.22,
      "end_seconds": 272.41,
      "duration_seconds": 8.19,
      "text": "And slow breathing helps. In for four, hold for four, out for six."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.58,
      "end_seconds": 276.57,
      "duration_seconds": 2.99,
      "text": "I do that already. ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.99,
      "end_seconds": 283.0,
      "duration_seconds": 4.01,
      "text": "Keep going, and cut caffeine after lunchtime."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.6,
      "end_seconds": 286.65,
      "duration_seconds": 2.05,
      "text": "Energy drinks? ~"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.58,
      "end_seconds": 291.71,
      "duration_seconds": 2.13,
      "text": "Those too. ~"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.33,
      "end_seconds": 296.29,
      "duration_seconds": 1.96,
      "text": "Fine. ~"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.04,
      "end_seconds": 306.47,
      "duration_seconds": 8.43,
      "text": "I'd like to see you again in three weeks, before the real exams."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 308.42,
      "end_seconds": 312.69,
      "duration_seconds": 4.27,
      "text": "Three weeks. Thank you, doctor. ~"
    }
  ]
}
