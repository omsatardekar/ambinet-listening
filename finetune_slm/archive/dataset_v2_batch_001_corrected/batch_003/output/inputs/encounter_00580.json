{
  "schema_version": "1.0",
  "encounter_id": "00580",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 0.48,
      "end_seconds": 12.01,
      "duration_seconds": 11.53,
      "text": "Mr Venkataraman, the booking says you want a review and that something to do with an old reaction is worrying you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.45,
      "end_seconds": 26.3,
      "duration_seconds": 11.85,
      "text": "Yes, yes, doctor. Please call me Venkat, everyone does. That reaction business I will come to, but first let me tell you about this chest."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.32,
      "end_seconds": 32.83,
      "duration_seconds": 4.51,
      "text": "Go ahead. What is the chest doing?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.65,
      "end_seconds": 46.94,
      "duration_seconds": 13.29,
      "text": "When I climb the stairs to my daughter's flat, third floor only, I get a tightness here in the middle. Then I stop, wait, and it goes."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.52,
      "end_seconds": 59.17,
      "duration_seconds": 10.65,
      "text": "So tightness in the middle of the chest when you climb. How long has this been happening?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.45,
      "end_seconds": 71.01,
      "duration_seconds": 9.56,
      "text": "For about one month only. Before that I was climbing like a goat. My grandson says I am slowing down."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.34,
      "end_seconds": 77.5,
      "duration_seconds": 5.16,
      "text": "How long does it last when you stop?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.45,
      "end_seconds": 87.18,
      "duration_seconds": 8.73,
      "text": "Two minutes, maybe three. I have to hold the railing and pretend I am admiring the view."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.53,
      "end_seconds": 95.23,
      "duration_seconds": 5.7,
      "text": "Ha. Does it spread anywhere, the arm or the jaw?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.03,
      "end_seconds": 101.52,
      "duration_seconds": 4.49,
      "text": "Not that I noticed. Same spot every time."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.44,
      "end_seconds": 108.56,
      "duration_seconds": 5.12,
      "text": "Have you been short of breath with it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.48,
      "end_seconds": 121.5,
      "duration_seconds": 10.02,
      "text": "No, no. Breath is fine. Only the tightness, and my heart doesn't flutter or anything like that."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.2,
      "end_seconds": 130.05,
      "duration_seconds": 5.85,
      "text": "Good. Now, tell me about the reaction. What's worrying you?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.88,
      "end_seconds": 144.45,
      "duration_seconds": 13.57,
      "text": "See, my cousin in Chennai had a terrible thing with a tablet. He nearly died, doctor. So now I am worried about every tablet."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.81,
      "end_seconds": 157.84,
      "duration_seconds": 11.03,
      "text": "I'm sorry to hear that. But I'm asking about you. Do you have a reaction of your own?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.67,
      "end_seconds": 174.84,
      "duration_seconds": 14.17,
      "text": "Yes. Years ago, I took some antibiotic for my throat and I reacted to it. My wife was there, she remembers more than me."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.74,
      "end_seconds": 182.38,
      "duration_seconds": 5.64,
      "text": "What kind of reaction? A rash, swelling, breathing trouble?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.06,
      "end_seconds": 195.5,
      "duration_seconds": 11.44,
      "text": "That is the problem, I cannot recall. I only remember the doctor said, never take that antibiotic again. Hospital people made a note."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.61,
      "end_seconds": 199.89,
      "duration_seconds": 3.28,
      "text": "Do you remember the name?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.86,
      "end_seconds": 210.58,
      "duration_seconds": 9.72,
      "text": "No. It was something ending in 'cillin' or maybe 'mycin'. I told my wife to remember but she says ask Venkat."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.71,
      "end_seconds": 222.72,
      "duration_seconds": 11.01,
      "text": "Ha. So we know it's an antibiotic, and you had some kind of reaction, but not which one or what happened."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.24,
      "end_seconds": 232.54,
      "duration_seconds": 7.3,
      "text": "Exactly. Is it a problem? Because you will be giving me tablets also, no?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.81,
      "end_seconds": 245.6,
      "duration_seconds": 11.79,
      "text": "I'm not prescribing anything today. But I want it on your record as an allergy to an antibiotic, so nobody gives you the wrong one."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.01,
      "end_seconds": 258.35,
      "duration_seconds": 10.34,
      "text": "Good. Good. That is why I came. My wife was telling me, do it before the next emergency."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.34,
      "end_seconds": 269.75,
      "duration_seconds": 9.41,
      "text": "Sensible wife. Can you find the old hospital papers? Or ask your wife whether she kept the discharge letter?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.7,
      "end_seconds": 279.44,
      "duration_seconds": 8.74,
      "text": "She keeps everything. Forty-five years of marriage and she has every bill. I will search the almirah."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.01,
      "end_seconds": 293.73,
      "duration_seconds": 11.72,
      "text": "Please bring whatever you find. Also, if the old GP's surgery still exists, we can ask them for the note."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.38,
      "end_seconds": 303.6,
      "duration_seconds": 7.22,
      "text": "That one is closed now. The doctor retired, and his son went to Dubai."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.29,
      "end_seconds": 313.51,
      "duration_seconds": 8.22,
      "text": "Then the papers at home are our best chance. What did you do for work, Venkat?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.87,
      "end_seconds": 327.6,
      "duration_seconds": 12.73,
      "text": "I am a retired bank manager. Thirty-five years in the State Bank. Many files, I know the value of a record."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.69,
      "end_seconds": 335.94,
      "duration_seconds": 6.25,
      "text": "Then you'll appreciate this. A clear record is worth more than ten guesses."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.82,
      "end_seconds": 351.88,
      "duration_seconds": 14.06,
      "text": "Let me repeat that back to be sure. Tightness on the stairs for a month, settling in minutes, and an antibiotic reaction years ago, details unknown."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 354.18,
      "end_seconds": 364.45,
      "duration_seconds": 10.27,
      "text": "Correct. You should work for the bank, doctor. Tell me one thing. This chest tightness. Is it dangerous?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.23,
      "end_seconds": 379.26,
      "duration_seconds": 12.03,
      "text": "I can't say yet, and I don't want to guess. That is exactly why I'd like to see you again once the papers are found."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 380.24,
      "end_seconds": 383.33,
      "duration_seconds": 3.09,
      "text": "Okay. When should I come?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 384.31,
      "end_seconds": 393.15,
      "duration_seconds": 8.84,
      "text": "Let's say in four weeks. That gives you time to search the almirah and ask around."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 393.88,
      "end_seconds": 401.17,
      "duration_seconds": 7.29,
      "text": "Four weeks is fine. Should my wife come along? She remembers more than me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 402.98,
      "end_seconds": 408.51,
      "duration_seconds": 5.53,
      "text": "Please do bring her. Two memories are better than one."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 410.96,
      "end_seconds": 417.87,
      "duration_seconds": 6.91,
      "text": "Good. Four weeks is fine. Should I climb those stairs in the meantime?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 420.07,
      "end_seconds": 432.89,
      "duration_seconds": 12.82,
      "text": "Take the lift if there is one, and rest when the tightness comes. If it lasts longer than ten minutes, call an ambulance."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 434.79,
      "end_seconds": 441.26,
      "duration_seconds": 6.47,
      "text": "Ten minutes. I will tell my daughter also. She will be so anxious."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 443.09,
      "end_seconds": 449.52,
      "duration_seconds": 6.43,
      "text": "Tell her yes. And Venkat, thank you for being so organised about this."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 450.69,
      "end_seconds": 460.82,
      "duration_seconds": 10.13,
      "text": "It's my pleasure. Thank you, doctor. I will bring the papers and some of my wife's homemade sweets."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 462.05,
      "end_seconds": 467.23,
      "duration_seconds": 5.18,
      "text": "The papers will do nicely. Goodbye, and mind the stairs."
    }
  ]
}
