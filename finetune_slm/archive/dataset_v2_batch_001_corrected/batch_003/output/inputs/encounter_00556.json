{
  "schema_version": "1.0",
  "encounter_id": "00556",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 1.17,
      "end_seconds": 7.19,
      "duration_seconds": 6.02,
      "text": "Ruth Abernethy? Just checking I've got the right file open."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.68,
      "end_seconds": 17.41,
      "duration_seconds": 7.73,
      "text": "That's me. And this is my husband Graham. He's the reason I'm here, really."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 19.09,
      "end_seconds": 24.66,
      "duration_seconds": 5.57,
      "text": "She'd have cancelled again if I hadn't driven her."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.02,
      "end_seconds": 33.43,
      "duration_seconds": 7.41,
      "text": "Good man. Right, colitis review. How have you been since I last saw you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.89,
      "end_seconds": 43.66,
      "duration_seconds": 7.77,
      "text": "Quite well, actually. It's been quiet. Well, mostly. I've been tired in the afternoons."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.82,
      "end_seconds": 49.31,
      "duration_seconds": 4.49,
      "text": "Tired how? Needing a nap, or just flat?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.81,
      "end_seconds": 59.55,
      "duration_seconds": 8.74,
      "text": "Flat, I think. Not a nap. Well, perhaps a nap on Sunday, but that's the roast."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.45,
      "end_seconds": 64.61,
      "duration_seconds": 4.16,
      "text": "Fine. Any bleeding at the moment?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.59,
      "end_seconds": 80.57,
      "duration_seconds": 13.98,
      "text": "Not now. I had blood when I went to the loo last winter, but that settled in the spring. Or was it the summer? Graham?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 81.81,
      "end_seconds": 88.9,
      "duration_seconds": 7.09,
      "text": "Spring. March. You were fed up to the back teeth with it."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.61,
      "end_seconds": 95.43,
      "duration_seconds": 3.82,
      "text": "Good. Have you lost any weight?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.89,
      "end_seconds": 102.2,
      "duration_seconds": 5.31,
      "text": "No, if anything I've put some on. Graham's baking."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.95,
      "end_seconds": 105.29,
      "duration_seconds": 2.34,
      "text": "Any mouth ulcers?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.22,
      "end_seconds": 108.74,
      "duration_seconds": 1.52,
      "text": "None, thankfully."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.84,
      "end_seconds": 114.25,
      "duration_seconds": 3.41,
      "text": "Any trouble with your breathing?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.2,
      "end_seconds": 118.97,
      "duration_seconds": 2.77,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.52,
      "end_seconds": 123.0,
      "duration_seconds": 2.48,
      "text": "And your waterworks?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.06,
      "end_seconds": 126.24,
      "duration_seconds": 2.18,
      "text": "Normal. Perfectly boring."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.91,
      "end_seconds": 132.63,
      "duration_seconds": 4.72,
      "text": "What are you taking for the colitis these days?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.34,
      "end_seconds": 143.76,
      "duration_seconds": 9.42,
      "text": "The mesalazine, 2.4 g once a day, I think. Or was it twice? Graham does the box."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 144.84,
      "end_seconds": 153.99,
      "duration_seconds": 9.15,
      "text": "It's 1.6 g since the spring. They cut it down. And it's once a day, in the morning."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.18,
      "end_seconds": 159.02,
      "duration_seconds": 3.84,
      "text": "Is it? Well, he'd know."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.02,
      "end_seconds": 168.07,
      "duration_seconds": 7.05,
      "text": "We'll sort that against the prescription record. Anything else you take?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.58,
      "end_seconds": 174.55,
      "duration_seconds": 4.97,
      "text": "Vitamin D. The chewable ones. That's the lot."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.65,
      "end_seconds": 176.88,
      "duration_seconds": 1.23,
      "text": "Allergies?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.69,
      "end_seconds": 193.47,
      "duration_seconds": 13.78,
      "text": "Penicillin. I was allergic to it as a child, came out in a rash, and I've been told to avoid it ever since."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.13,
      "end_seconds": 202.66,
      "duration_seconds": 6.53,
      "text": "Noted. Any other conditions I should have on the list?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.39,
      "end_seconds": 215.53,
      "duration_seconds": 12.14,
      "text": "Migraines, a few a year. And my knees, the osteoarthritis. Oh, and the colitis itself, of course. Twelve years. No, hang on. Graham?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 218.0,
      "end_seconds": 222.78,
      "duration_seconds": 4.78,
      "text": "Eleven. You were diagnosed the year we moved."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.32,
      "end_seconds": 226.83,
      "duration_seconds": 2.51,
      "text": "Eleven years, then."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.89,
      "end_seconds": 230.26,
      "duration_seconds": 2.37,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.17,
      "end_seconds": 235.48,
      "duration_seconds": 3.31,
      "text": "Never smoked in my life."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.84,
      "end_seconds": 238.33,
      "duration_seconds": 1.49,
      "text": "And alcohol?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.84,
      "end_seconds": 247.19,
      "duration_seconds": 7.35,
      "text": "A glass of wine on Saturdays. I only drink at weekends."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.46,
      "end_seconds": 252.13,
      "duration_seconds": 3.67,
      "text": "Right. Let me do your numbers."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.26,
      "end_seconds": 273.29,
      "duration_seconds": 5.03,
      "text": "Blood pressure 118 over 74. Pulse 68. Temperature 36.7."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.62,
      "end_seconds": 281.37,
      "duration_seconds": 5.75,
      "text": "Oxygen 98 per cent, and you're 71 kilograms on the scales."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.32,
      "end_seconds": 285.13,
      "duration_seconds": 1.81,
      "text": "Is that up?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.86,
      "end_seconds": 293.66,
      "duration_seconds": 5.8,
      "text": "A little. Nothing to worry about. Hop onto the couch, please."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.13,
      "end_seconds": 305.83,
      "duration_seconds": 9.7,
      "text": "Do I need to take my cardigan off? Oh, I've left my glasses in the car."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 308.26,
      "end_seconds": 311.32,
      "duration_seconds": 3.06,
      "text": "They're on your head, love."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.24,
      "end_seconds": 333.4,
      "duration_seconds": 9.16,
      "text": "Lie flat for me. I'll press on your tummy. Tell me if anything's sore."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.12,
      "end_seconds": 341.2,
      "duration_seconds": 6.08,
      "text": "Your abdomen is soft all over. Sit up when you're ready."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.63,
      "end_seconds": 347.01,
      "duration_seconds": 4.38,
      "text": "Marvellous. I thought you'd find something awful."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.07,
      "end_seconds": 354.47,
      "duration_seconds": 6.4,
      "text": "The way things look today, it fits with the colitis being in remission."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 355.55,
      "end_seconds": 358.86,
      "duration_seconds": 3.31,
      "text": "Remission. That sounds so grand."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.63,
      "end_seconds": 372.51,
      "duration_seconds": 10.88,
      "text": "It is, for a colitis patient. Carry on as you are with the tablets. Graham keeps the box, so we're in good hands."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 375.39,
      "end_seconds": 378.28,
      "duration_seconds": 2.89,
      "text": "I've got a spreadsheet."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 379.89,
      "end_seconds": 382.13,
      "duration_seconds": 2.24,
      "text": "He really has."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 383.74,
      "end_seconds": 390.24,
      "duration_seconds": 6.5,
      "text": "I'll see you in three months, and you can bring the spreadsheet."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 392.68,
      "end_seconds": 399.95,
      "duration_seconds": 7.27,
      "text": "Three months. I'll put it in the diary. Where is my diary? Graham?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 401.27,
      "end_seconds": 403.07,
      "duration_seconds": 1.8,
      "text": "In your handbag."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 404.08,
      "end_seconds": 406.53,
      "duration_seconds": 2.45,
      "text": "Of course it is."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 407.59,
      "end_seconds": 415.98,
      "duration_seconds": 8.39,
      "text": "Right, off you go, both of you. Mind the step on the way out."
    }
  ]
}
