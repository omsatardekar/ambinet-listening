{
  "schema_version": "1.0",
  "encounter_id": "00860",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.91,
      "end_seconds": 13.84,
      "duration_seconds": 12.93,
      "text": "Morning, doctor. I'm sorry to come about this, but I've got this awful pain in my face, on the right, when I chew. It's like an electric shock."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.76,
      "end_seconds": 21.03,
      "duration_seconds": 6.27,
      "text": "Tell me more about it. How long has it been going on?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.04,
      "end_seconds": 35.04,
      "duration_seconds": 12.0,
      "text": "Two weeks. It started with a shooting pain in my cheek, when I was brushing my teeth, and it's been coming and going ever since."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.97,
      "end_seconds": 41.53,
      "duration_seconds": 3.56,
      "text": "How long does each attack last?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.14,
      "end_seconds": 52.39,
      "duration_seconds": 9.25,
      "text": "A few seconds. Maybe ten. It's sharp, and then it's gone, and I'm left waiting for the next one."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.16,
      "end_seconds": 58.21,
      "duration_seconds": 3.05,
      "text": "What sets it off?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.32,
      "end_seconds": 67.16,
      "duration_seconds": 6.84,
      "text": "Chewing, brushing my teeth, a cold breeze on my face, even talking, sometimes."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.55,
      "end_seconds": 73.32,
      "duration_seconds": 3.77,
      "text": "Where exactly is the pain?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.14,
      "end_seconds": 85.61,
      "duration_seconds": 9.47,
      "text": "Along the cheek, to the corner of my mouth, and my upper jaw, on the right."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.61,
      "end_seconds": 92.38,
      "duration_seconds": 3.77,
      "text": "Any pain between the attacks, or toothache?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.23,
      "end_seconds": 103.28,
      "duration_seconds": 10.05,
      "text": "No pain in between. And my teeth are fine, I've seen the dentist, who found nothing."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.23,
      "end_seconds": 113.18,
      "duration_seconds": 6.95,
      "text": "Any numbness, or weakness of the face, or changes in your vision?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.79,
      "end_seconds": 118.3,
      "duration_seconds": 2.51,
      "text": "No, none of those."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.05,
      "end_seconds": 123.32,
      "duration_seconds": 2.27,
      "text": "Any previous health conditions?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.44,
      "end_seconds": 128.63,
      "duration_seconds": 3.19,
      "text": "High blood pressure, that's all."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.61,
      "end_seconds": 135.41,
      "duration_seconds": 3.8,
      "text": "Anyone in the family with similar pain?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.64,
      "end_seconds": 143.48,
      "duration_seconds": 6.84,
      "text": "My aunt had a nerve thing in her face, I think."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.51,
      "end_seconds": 148.3,
      "duration_seconds": 2.79,
      "text": "Any allergies to medicines?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.31,
      "end_seconds": 159.15,
      "duration_seconds": 9.84,
      "text": "Years ago, carbamazepine, I think I broke out in a rash, so I haven't had it since."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.71,
      "end_seconds": 166.61,
      "duration_seconds": 5.9,
      "text": "That's important, thank you. Let me check your numbers. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.77,
      "end_seconds": 170.94,
      "duration_seconds": 2.17,
      "text": "Go on. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.71,
      "end_seconds": 191.43,
      "duration_seconds": 5.72,
      "text": "Pulse 72, blood pressure 140 over 86, temperature 36.6."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.06,
      "end_seconds": 196.05,
      "duration_seconds": 2.99,
      "text": "Is that high? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.13,
      "end_seconds": 204.26,
      "duration_seconds": 7.13,
      "text": "Slightly, but fine. Now I'll test the feeling in your face. Close your eyes. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.39,
      "end_seconds": 226.63,
      "duration_seconds": 1.24,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.48,
      "end_seconds": 244.05,
      "duration_seconds": 14.57,
      "text": "The feeling is normal on both sides of the face, your jaw muscles are strong, and I can trigger a shooting pain by lightly touching the right cheek."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.78,
      "end_seconds": 247.34,
      "duration_seconds": 2.56,
      "text": "That's the one. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.98,
      "end_seconds": 268.72,
      "duration_seconds": 18.74,
      "text": "What you describe, brief electric-shock pains in the cheek and jaw, triggered by touch, chewing and cold air, with a normal examination, fits trigeminal neuralgia, a condition of the facial nerve."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.17,
      "end_seconds": 274.12,
      "duration_seconds": 2.95,
      "text": "Is it serious? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.09,
      "end_seconds": 279.91,
      "duration_seconds": 4.82,
      "text": "It's very painful, but not dangerous. It's treatable. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.74,
      "end_seconds": 282.81,
      "duration_seconds": 2.07,
      "text": "How? ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.08,
      "end_seconds": 301.18,
      "duration_seconds": 17.1,
      "text": "There's a medicine for nerve pain, but the usual first choice, carbamazepine, is the one that gave you a rash. So I'd like to start you on a different one, gabapentin."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.67,
      "end_seconds": 307.28,
      "duration_seconds": 3.61,
      "text": "Will it make me sleepy? ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.32,
      "end_seconds": 315.19,
      "duration_seconds": 6.87,
      "text": "It can. Start with 300 mg at night, and we'll increase it slowly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.85,
      "end_seconds": 318.39,
      "duration_seconds": 1.54,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.42,
      "end_seconds": 330.73,
      "duration_seconds": 11.31,
      "text": "Avoid triggers where you can, a scarf over your face in cold air, chew on the left, and brush gently."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.68,
      "end_seconds": 335.07,
      "duration_seconds": 1.39,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.73,
      "end_seconds": 343.0,
      "duration_seconds": 6.27,
      "text": "I'd like to see you in two weeks to see how it's working."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.64,
      "end_seconds": 349.26,
      "duration_seconds": 3.62,
      "text": "Two weeks. Thank you. ~"
    }
  ]
}
