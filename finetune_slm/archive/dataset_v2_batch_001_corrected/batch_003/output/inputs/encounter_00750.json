{
  "schema_version": "1.0",
  "encounter_id": "00750",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.68,
      "end_seconds": 13.21,
      "duration_seconds": 12.53,
      "text": "Hello, doctor. I'm not sure what I've come about, to be honest. The hospital said to come back and see you after I was in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.18,
      "end_seconds": 25.58,
      "duration_seconds": 11.4,
      "text": "Yes, you were in for a chest infection three weeks ago. How have you been since you came home? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.27,
      "end_seconds": 36.32,
      "duration_seconds": 9.05,
      "text": "Grand, grand. Only I've no appetite. None at all. I push the food around the plate."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.03,
      "end_seconds": 41.9,
      "duration_seconds": 3.87,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.59,
      "end_seconds": 53.55,
      "duration_seconds": 8.96,
      "text": "Since the hospital? Or before it? Honestly, I couldn't say. I've been off my food a while."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.97,
      "end_seconds": 58.47,
      "duration_seconds": 2.5,
      "text": "Have you lost weight?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.35,
      "end_seconds": 70.12,
      "duration_seconds": 8.77,
      "text": "My trousers are loose, so I must have. A couple of stone, maybe? I don't weigh myself."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.03,
      "end_seconds": 80.28,
      "duration_seconds": 7.25,
      "text": "Do you feel sick, or does food stick, or does it hurt to eat? ~"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.5,
      "end_seconds": 86.64,
      "duration_seconds": 5.14,
      "text": "No, none of that. I'm just not hungry. ~"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.47,
      "end_seconds": 93.27,
      "duration_seconds": 3.8,
      "text": "What tablets are you on?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.25,
      "end_seconds": 104.5,
      "duration_seconds": 8.25,
      "text": "Mirtazapine, 15 mg, maybe? At bedtime, the little white one. And omeprazole, 20 mg in the morning."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.35,
      "end_seconds": 113.56,
      "duration_seconds": 7.21,
      "text": "Is the mirtazapine 15 mg, do you think? You said maybe."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.35,
      "end_seconds": 122.93,
      "duration_seconds": 7.58,
      "text": "It could be 30. The chemist knows. I only take what they give me."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.18,
      "end_seconds": 129.49,
      "duration_seconds": 5.31,
      "text": "I'll check with the record. What's it for? ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.76,
      "end_seconds": 137.63,
      "duration_seconds": 5.87,
      "text": "For my mood, after my wife died. Two years ago."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.49,
      "end_seconds": 142.77,
      "duration_seconds": 3.28,
      "text": "I'm very sorry. Any operations?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.2,
      "end_seconds": 146.61,
      "duration_seconds": 2.41,
      "text": "Gallbladder, in the nineties."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.39,
      "end_seconds": 154.18,
      "duration_seconds": 5.79,
      "text": "Let me weigh you, and check your numbers. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.96,
      "end_seconds": 158.05,
      "duration_seconds": 3.09,
      "text": "Go on then. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.03,
      "end_seconds": 187.65,
      "duration_seconds": 8.62,
      "text": "Pulse 82, blood pressure 118 over 72, temperature 36.6, oxygen 96 percent, and you weigh 64 kilos."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.3,
      "end_seconds": 193.98,
      "duration_seconds": 3.68,
      "text": "Is that a lot? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.14,
      "end_seconds": 210.39,
      "duration_seconds": 14.25,
      "text": "Your record says 74 kilos a year ago, so you've lost about ten kilos, which is significant. Any cough or breathlessness left from the chest infection?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.9,
      "end_seconds": 217.9,
      "duration_seconds": 5.0,
      "text": "A little cough in the morning. No breathlessness."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.4,
      "end_seconds": 233.03,
      "duration_seconds": 12.63,
      "text": "I'd say the main thing is poor appetite after your recent illness, in the setting of low mood, so I'd call it reduced appetite following illness."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.2,
      "end_seconds": 238.81,
      "duration_seconds": 4.61,
      "text": "Do you think it's my mood? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.49,
      "end_seconds": 256.37,
      "duration_seconds": 15.88,
      "text": "It's likely part of it, but with that much weight loss, I don't want to assume. I'd like to arrange blood tests, to look for anaemia, thyroid, and other causes."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.58,
      "end_seconds": 260.39,
      "duration_seconds": 1.81,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.11,
      "end_seconds": 273.27,
      "duration_seconds": 10.16,
      "text": "Meanwhile, small meals and snacks, six times a day, and a build-up drink between meals, rather than big plates."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.17,
      "end_seconds": 278.22,
      "duration_seconds": 4.05,
      "text": "I could manage a milky drink. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.66,
      "end_seconds": 287.55,
      "duration_seconds": 7.89,
      "text": "That's the idea. And try to eat with someone, if you can, a neighbour or a friend."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.54,
      "end_seconds": 292.07,
      "duration_seconds": 3.53,
      "text": "My daughter comes on Sundays. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.24,
      "end_seconds": 302.42,
      "duration_seconds": 8.18,
      "text": "Good. I'd like to see you again in two weeks, and weigh you again."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.04,
      "end_seconds": 307.94,
      "duration_seconds": 3.9,
      "text": "Two weeks. Fine. Thank you, doctor. ~"
    }
  ]
}
