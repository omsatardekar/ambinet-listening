{
  "schema_version": "1.0",
  "encounter_id": "00699",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.44,
      "end_seconds": 14.79,
      "duration_seconds": 14.35,
      "text": "Morning! Right, so my big toe blew up like a balloon overnight on Tuesday, and I couldn't even put a sheet over it."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.26,
      "end_seconds": 23.21,
      "duration_seconds": 5.95,
      "text": "That sounds miserable. Which toe, and how is it now?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.77,
      "end_seconds": 39.99,
      "duration_seconds": 14.22,
      "text": "Left big toe. It's calmer now, but still red, and when it was at its worst, the pain woke me at three in the morning."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.74,
      "end_seconds": 44.39,
      "duration_seconds": 2.65,
      "text": "Has it happened before?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.38,
      "end_seconds": 61.36,
      "duration_seconds": 13.98,
      "text": "Once, I think. Last year? Or the year before that. I honestly couldn't tell you when, I just remember it was a bank holiday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.69,
      "end_seconds": 72.05,
      "duration_seconds": 8.36,
      "text": "Okay, I'll note that you can't date it. Have you had any fever, or felt unwell with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.67,
      "end_seconds": 78.29,
      "duration_seconds": 3.62,
      "text": "No fever. Felt fine otherwise."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.11,
      "end_seconds": 84.97,
      "duration_seconds": 3.86,
      "text": "Did you knock it or injure it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.96,
      "end_seconds": 88.86,
      "duration_seconds": 2.9,
      "text": "No, nothing. I'd have remembered."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.83,
      "end_seconds": 92.39,
      "duration_seconds": 2.56,
      "text": "Any other joints swollen?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.13,
      "end_seconds": 95.66,
      "duration_seconds": 2.53,
      "text": "No, just the toe."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.76,
      "end_seconds": 100.74,
      "duration_seconds": 3.98,
      "text": "What did you take for it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.93,
      "end_seconds": 118.62,
      "duration_seconds": 16.69,
      "text": "Naproxen, 250 mg, twice a day, maybe? I took a few from my wife's pack, then I took them when I remembered, so it was a bit random."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.98,
      "end_seconds": 129.92,
      "duration_seconds": 9.94,
      "text": "Understood. So 250 mg twice a day as you recall it, but taken when you remembered. Any health conditions?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.01,
      "end_seconds": 135.02,
      "duration_seconds": 3.01,
      "text": "High blood pressure, that's all."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.92,
      "end_seconds": 142.32,
      "duration_seconds": 4.4,
      "text": "What do you drink, and how's your diet?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.28,
      "end_seconds": 153.78,
      "duration_seconds": 10.5,
      "text": "Five or six pints at the weekend, and I do love a prawn curry. Well, I did."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.74,
      "end_seconds": 164.04,
      "duration_seconds": 7.3,
      "text": "Let me check your pulse and blood pressure, and then look at the toe. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.95,
      "end_seconds": 166.85,
      "duration_seconds": 1.9,
      "text": "Go on. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.19,
      "end_seconds": 186.23,
      "duration_seconds": 5.04,
      "text": "Pulse 80, blood pressure 138 over 88, temperature 36.8."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.4,
      "end_seconds": 189.06,
      "duration_seconds": 1.66,
      "text": "Good. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.71,
      "end_seconds": 209.76,
      "duration_seconds": 4.05,
      "text": "Now the toe, tell me if it hurts."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.44,
      "end_seconds": 215.18,
      "duration_seconds": 2.74,
      "text": "Ow. Yes, there. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.06,
      "end_seconds": 231.75,
      "duration_seconds": 13.69,
      "text": "The base of the big toe is a bit red and warm, and tender when I press. No swelling elsewhere in the foot."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.74,
      "end_seconds": 236.87,
      "duration_seconds": 3.13,
      "text": "Gout? Everyone says gout. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.15,
      "end_seconds": 254.74,
      "duration_seconds": 16.59,
      "text": "I'm not going to put a name on it from one look. It's a typical picture, but I'd rather confirm it. I'd like to arrange a blood test for uric acid."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.05,
      "end_seconds": 259.22,
      "duration_seconds": 2.17,
      "text": "When? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.32,
      "end_seconds": 270.18,
      "duration_seconds": 9.86,
      "text": "Ideally two weeks after an attack, when it's settled, so book it in a fortnight. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.48,
      "end_seconds": 275.49,
      "duration_seconds": 3.01,
      "text": "Right. And the tablets? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.8,
      "end_seconds": 291.05,
      "duration_seconds": 13.25,
      "text": "Don't take someone else's tablets, please. Rest the foot, raise it, and cool it with a cold pack wrapped in a cloth."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.35,
      "end_seconds": 296.35,
      "duration_seconds": 4.0,
      "text": "Fair. What about the beer? ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.3,
      "end_seconds": 304.93,
      "duration_seconds": 5.63,
      "text": "Less beer and fewer prawns would help, and plenty of water."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.12,
      "end_seconds": 309.63,
      "duration_seconds": 2.51,
      "text": "Ah. I'll try. ~"
    }
  ]
}
