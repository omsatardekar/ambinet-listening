{
  "schema_version": "1.0",
  "encounter_id": "00602",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.83,
      "end_seconds": 9.99,
      "duration_seconds": 9.16,
      "text": "Hi, come on in. Before we start, what would you like me to call you? Your chart says Danielle."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.44,
      "end_seconds": 19.35,
      "duration_seconds": 7.91,
      "text": "Oh, um, Dani is fine. Or, well, Danielle at work, but... Dani's good."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.08,
      "end_seconds": 31.67,
      "duration_seconds": 9.59,
      "text": "Dani it is. I'm Dr. Reyes. This is your follow-up on your treatment. How are you feeling overall?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.31,
      "end_seconds": 39.67,
      "duration_seconds": 6.36,
      "text": "Better, I think. Mostly. It's... well, it's hard to say."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.05,
      "end_seconds": 47.55,
      "duration_seconds": 5.5,
      "text": "Let's take it piece by piece. Is the cough still around?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.93,
      "end_seconds": 57.12,
      "duration_seconds": 7.19,
      "text": "A little. In the mornings, mostly. It's, um, not as bad as it was."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.02,
      "end_seconds": 65.15,
      "duration_seconds": 5.13,
      "text": "How long has it been going on now?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.01,
      "end_seconds": 71.33,
      "duration_seconds": 5.32,
      "text": "Since... um. About three months, I guess? Maybe more."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.26,
      "end_seconds": 77.57,
      "duration_seconds": 3.31,
      "text": "Okay. Any night sweats lately?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.35,
      "end_seconds": 88.63,
      "duration_seconds": 9.28,
      "text": "Those are gone. They stopped, like, a month ago. I used to wake up soaked, and now... nothing."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.95,
      "end_seconds": 96.38,
      "duration_seconds": 5.43,
      "text": "Good, that's a real sign of progress. What about energy?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.45,
      "end_seconds": 107.76,
      "duration_seconds": 5.31,
      "text": "I'm still tired. Like, I get home and I just..."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.03,
      "end_seconds": 110.77,
      "duration_seconds": 1.74,
      "text": "Go on."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.86,
      "end_seconds": 119.23,
      "duration_seconds": 7.37,
      "text": "I just can't do much. I fall asleep on the couch by eight."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.73,
      "end_seconds": 125.51,
      "duration_seconds": 3.78,
      "text": "That'll improve. Now, any coughing up blood?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 127.0,
      "end_seconds": 129.1,
      "duration_seconds": 2.1,
      "text": "No. No blood."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.28,
      "end_seconds": 135.62,
      "duration_seconds": 4.34,
      "text": "Have you lost weight in the last month?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 138.04,
      "end_seconds": 143.67,
      "duration_seconds": 5.63,
      "text": "No, I don't think so. Maybe I gained, actually."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.36,
      "end_seconds": 148.28,
      "duration_seconds": 1.92,
      "text": "Any chest pain?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.83,
      "end_seconds": 153.56,
      "duration_seconds": 2.73,
      "text": "No... not really. No."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.6,
      "end_seconds": 160.63,
      "duration_seconds": 6.03,
      "text": "You're on your medicine every day? Remind me of the dose."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.86,
      "end_seconds": 169.01,
      "duration_seconds": 7.15,
      "text": "Yeah, the rifampin. 600 mg, once a day. In the morning, before I eat."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.58,
      "end_seconds": 178.93,
      "duration_seconds": 8.35,
      "text": "Good. How about your stomach and your general digestion, since starting it? Any trouble?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.21,
      "end_seconds": 183.64,
      "duration_seconds": 2.43,
      "text": "It's fine. Nothing there."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.4,
      "end_seconds": 194.77,
      "duration_seconds": 10.37,
      "text": "Great. I see TB listed in your history, with the treatment about four months in. Does that match your memory?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 195.81,
      "end_seconds": 199.62,
      "duration_seconds": 3.81,
      "text": "Yes. Four months. It feels longer."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.85,
      "end_seconds": 207.3,
      "duration_seconds": 5.45,
      "text": "I bet. Any past surgery I should know about?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 208.48,
      "end_seconds": 213.32,
      "duration_seconds": 4.84,
      "text": "My gallbladder. Um, it was taken out in 2015."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.12,
      "end_seconds": 219.27,
      "duration_seconds": 5.15,
      "text": "Okay. Anyone in your family with TB or lung disease?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 221.38,
      "end_seconds": 231.37,
      "duration_seconds": 9.99,
      "text": "My uncle had TB. A long time ago, in the old country. I think. I don't really know the details."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.17,
      "end_seconds": 241.44,
      "duration_seconds": 7.27,
      "text": "That's fine. What work do you do, and who do you live with?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 244.07,
      "end_seconds": 253.19,
      "duration_seconds": 9.12,
      "text": "I work in a bakery. Early shifts. And I... I live with two roommates."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.91,
      "end_seconds": 261.96,
      "duration_seconds": 7.05,
      "text": "Okay. Hop up on the table, and I'll listen to your lungs."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 267.61,
      "end_seconds": 268.61,
      "duration_seconds": 1.0,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 287.3,
      "end_seconds": 291.13,
      "duration_seconds": 3.83,
      "text": "Deep breath in, and out. Again."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.87,
      "end_seconds": 308.75,
      "duration_seconds": 6.88,
      "text": "Chest sounds clear on both sides. And the glands in your neck aren't swollen."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 309.65,
      "end_seconds": 311.49,
      "duration_seconds": 1.84,
      "text": "That's good, right?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 313.89,
      "end_seconds": 322.04,
      "duration_seconds": 8.15,
      "text": "Yes, that's good. Sit up. Keep the rifampin going, same dose, every morning, don't skip."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 324.23,
      "end_seconds": 329.97,
      "duration_seconds": 5.74,
      "text": "I won't. I haven't, I think... I mean, I haven't."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 332.24,
      "end_seconds": 340.96,
      "duration_seconds": 8.72,
      "text": "Good. Keep the bakery mask on, and tell your roommates to cover their coughs, too."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 343.6,
      "end_seconds": 347.1,
      "duration_seconds": 3.5,
      "text": "Oh. Yeah, they know. Okay."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 349.1,
      "end_seconds": 353.48,
      "duration_seconds": 4.38,
      "text": "I'll see you again in four weeks."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 359.59,
      "end_seconds": 364.06,
      "duration_seconds": 4.47,
      "text": "Four weeks. Okay. Um, and if the cough..."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 365.43,
      "end_seconds": 372.08,
      "duration_seconds": 6.65,
      "text": "If it gets worse before then, call the clinic. Anything else, Dani?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 373.16,
      "end_seconds": 377.8,
      "duration_seconds": 4.64,
      "text": "No, that's all. Thank you, Dr. Reyes."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 378.84,
      "end_seconds": 383.43,
      "duration_seconds": 4.59,
      "text": "Take care. Front desk will book that visit."
    }
  ]
}
