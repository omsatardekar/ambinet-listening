{
  "schema_version": "1.0",
  "encounter_id": "00817",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.35,
      "end_seconds": 12.36,
      "duration_seconds": 12.01,
      "text": "Sorry, sorry, I'm so late, the bus, then I went to the wrong floor, I thought it was... never mind. It's my heel."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.57,
      "end_seconds": 17.65,
      "duration_seconds": 3.08,
      "text": "No problem. Which heel? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.08,
      "end_seconds": 32.48,
      "duration_seconds": 12.4,
      "text": "The right. It's the first steps in the morning, it feels like a nail going in. Heel pain, I mean, when I get out of bed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.24,
      "end_seconds": 36.98,
      "duration_seconds": 3.74,
      "text": "How long has it been going on?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.84,
      "end_seconds": 49.26,
      "duration_seconds": 11.42,
      "text": "Since... the summer? No. The summer before. Or maybe the spring. I honestly can't tell you, it just sort of arrived."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.27,
      "end_seconds": 56.3,
      "duration_seconds": 5.03,
      "text": "Does it ease off once you're up? ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.18,
      "end_seconds": 65.33,
      "duration_seconds": 7.15,
      "text": "After about ten minutes, yes, then it comes back after I've been sitting. ~"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.65,
      "end_seconds": 71.0,
      "duration_seconds": 3.35,
      "text": "Anywhere else in the foot?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.2,
      "end_seconds": 76.42,
      "duration_seconds": 4.22,
      "text": "Along the arch, a tight ache, yes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.27,
      "end_seconds": 80.5,
      "duration_seconds": 1.23,
      "text": "Calves?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.17,
      "end_seconds": 87.72,
      "duration_seconds": 4.55,
      "text": "Very tight, yes. I get cramp after shifts."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.63,
      "end_seconds": 92.41,
      "duration_seconds": 3.78,
      "text": "Any numbness or tingling in the foot?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.92,
      "end_seconds": 95.5,
      "duration_seconds": 1.58,
      "text": "No numbness."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.26,
      "end_seconds": 101.76,
      "duration_seconds": 4.5,
      "text": "Did you twist it or injure it?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.07,
      "end_seconds": 106.87,
      "duration_seconds": 2.8,
      "text": "No, I never injured it."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.16,
      "end_seconds": 110.69,
      "duration_seconds": 1.53,
      "text": "Any swelling?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.33,
      "end_seconds": 115.57,
      "duration_seconds": 2.24,
      "text": "No swelling, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.55,
      "end_seconds": 121.63,
      "duration_seconds": 4.08,
      "text": "What are you taking for it?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.45,
      "end_seconds": 134.45,
      "duration_seconds": 12.0,
      "text": "Naproxen, maybe 250 mg? Twice a day. And omeprazole, 20 mg, once a day. Every morning. Well, most mornings. I forget it on my days off."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.96,
      "end_seconds": 138.04,
      "duration_seconds": 1.08,
      "text": "Allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.69,
      "end_seconds": 150.2,
      "duration_seconds": 9.51,
      "text": "Tramadol. I react to it. I've been told. But don't ask me what it does to me."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.56,
      "end_seconds": 154.15,
      "duration_seconds": 2.59,
      "text": "Okay. Medical history?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.14,
      "end_seconds": 162.64,
      "duration_seconds": 5.5,
      "text": "Reflux, flat feet, and carpal tunnel in both wrists."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.07,
      "end_seconds": 166.52,
      "duration_seconds": 1.45,
      "text": "Surgery?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.59,
      "end_seconds": 172.85,
      "duration_seconds": 5.26,
      "text": "Bunion surgery in 2012. And a hysterectomy in 2019."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.48,
      "end_seconds": 176.0,
      "duration_seconds": 1.52,
      "text": "Family?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.82,
      "end_seconds": 181.8,
      "duration_seconds": 4.98,
      "text": "My mother has arthritis in her feet."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.48,
      "end_seconds": 185.65,
      "duration_seconds": 2.17,
      "text": "What's your job?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.55,
      "end_seconds": 190.97,
      "duration_seconds": 4.42,
      "text": "Nurse, twelve-hour shifts on a surgical ward."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.88,
      "end_seconds": 193.32,
      "duration_seconds": 1.44,
      "text": "Exercise?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.03,
      "end_seconds": 199.14,
      "duration_seconds": 4.11,
      "text": "I run, parkrun on Saturdays. Or I did."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.12,
      "end_seconds": 202.62,
      "duration_seconds": 2.5,
      "text": "And on shift?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.03,
      "end_seconds": 212.39,
      "duration_seconds": 7.36,
      "text": "Hard floors all day. About eight miles a shift, the app says."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.12,
      "end_seconds": 230.25,
      "duration_seconds": 7.13,
      "text": "Let me check you. Blood pressure 128 over 80, weight 82 kilos."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.68,
      "end_seconds": 236.45,
      "duration_seconds": 3.77,
      "text": "Same as last time? ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.72,
      "end_seconds": 251.36,
      "duration_seconds": 5.64,
      "text": "Same. Sit up on the couch. I'm pressing the heel."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.52,
      "end_seconds": 255.62,
      "duration_seconds": 2.1,
      "text": "Ow! There. ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.57,
      "end_seconds": 264.36,
      "duration_seconds": 7.79,
      "text": "There's tenderness at the inner side of the heel, and your calf muscles are very tight."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.05,
      "end_seconds": 269.44,
      "duration_seconds": 2.39,
      "text": "Told you. ~"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.41,
      "end_seconds": 276.9,
      "duration_seconds": 4.49,
      "text": "And your arches are flat when you stand."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.73,
      "end_seconds": 280.5,
      "duration_seconds": 2.77,
      "text": "Yes, always have been. ~"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.95,
      "end_seconds": 286.0,
      "duration_seconds": 3.05,
      "text": "Any trouble with your breathing?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.93,
      "end_seconds": 290.51,
      "duration_seconds": 2.58,
      "text": "No, nothing, I'm fine."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.81,
      "end_seconds": 298.07,
      "duration_seconds": 6.26,
      "text": "This looks like plantar fasciitis, but I can't rule out a heel spur."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.36,
      "end_seconds": 302.68,
      "duration_seconds": 2.32,
      "text": "What's the difference? ~"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.23,
      "end_seconds": 319.13,
      "duration_seconds": 13.9,
      "text": "A spur is a bony lump you can see on X-ray. I'd like to arrange an X-ray of the foot, and an ultrasound of the heel."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.99,
      "end_seconds": 325.37,
      "duration_seconds": 3.38,
      "text": "Is it a long wait? ~"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.39,
      "end_seconds": 339.31,
      "duration_seconds": 11.92,
      "text": "A few weeks. I'd also like to do blood tests for inflammation, and refer you to a podiatrist for insoles."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.43,
      "end_seconds": 346.0,
      "duration_seconds": 4.57,
      "text": "Right. And what do I do meanwhile? ~"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.83,
      "end_seconds": 356.21,
      "duration_seconds": 8.38,
      "text": "Stretch the calves three times a day, and roll your foot over a frozen water bottle."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 357.2,
      "end_seconds": 361.07,
      "duration_seconds": 3.87,
      "text": "I'll try, thank you. ~"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.42,
      "end_seconds": 373.06,
      "duration_seconds": 9.64,
      "text": "If it's not better in six weeks, come back and we'll talk about an injection."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 375.48,
      "end_seconds": 381.54,
      "duration_seconds": 6.06,
      "text": "Okay, six weeks. Sorry again about being late. ~"
    }
  ]
}
