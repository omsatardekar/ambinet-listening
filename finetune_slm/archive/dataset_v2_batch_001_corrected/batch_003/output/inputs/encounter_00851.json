{
  "schema_version": "1.0",
  "encounter_id": "00851",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 0.4,
      "end_seconds": 13.82,
      "duration_seconds": 13.42,
      "text": "Good morning, Miss Fairweather. I've got the letter from the ward here. This is your check ten days after the tonsillectomy, yes? ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.67,
      "end_seconds": 28.44,
      "duration_seconds": 12.77,
      "text": "Yes. I've brought my notes, I wrote down every day since I came home. May I read the key points? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.08,
      "end_seconds": 32.27,
      "duration_seconds": 2.19,
      "text": "Please do. ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.26,
      "end_seconds": 48.94,
      "duration_seconds": 15.68,
      "text": "Day one to three, severe sore throat, a pain scale of eight. Now it's about four, it's easing. So my sore throat is better, but still sore when I swallow dry things."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.84,
      "end_seconds": 55.34,
      "duration_seconds": 4.5,
      "text": "Good, that's the usual pattern. Anything in the ears?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.09,
      "end_seconds": 68.73,
      "duration_seconds": 10.64,
      "text": "Earache on both sides, days four to seven. It's lessened now, but it's there when I swallow."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.19,
      "end_seconds": 72.27,
      "duration_seconds": 2.08,
      "text": "And your breath?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.7,
      "end_seconds": 81.64,
      "duration_seconds": 7.94,
      "text": "Terrible. Sorry, it's a bad smell, my mum says, it's the healing."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.15,
      "end_seconds": 85.95,
      "duration_seconds": 1.8,
      "text": "Any bleeding?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.19,
      "end_seconds": 92.86,
      "duration_seconds": 5.67,
      "text": "No bleeding. Not a drop, I've checked the pillow every morning."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.55,
      "end_seconds": 97.52,
      "duration_seconds": 1.97,
      "text": "Any fever?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.37,
      "end_seconds": 102.81,
      "duration_seconds": 3.44,
      "text": "No fever, my highest was 37.2."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.52,
      "end_seconds": 106.09,
      "duration_seconds": 1.57,
      "text": "Trouble drinking?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.88,
      "end_seconds": 111.79,
      "duration_seconds": 2.91,
      "text": "No, I'm drinking plenty."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.89,
      "end_seconds": 113.81,
      "duration_seconds": 0.92,
      "text": "Vomiting?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.11,
      "end_seconds": 116.12,
      "duration_seconds": 1.01,
      "text": "None."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.74,
      "end_seconds": 121.46,
      "duration_seconds": 2.72,
      "text": "Noisy breathing at night?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.13,
      "end_seconds": 126.01,
      "duration_seconds": 2.88,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.58,
      "end_seconds": 131.01,
      "duration_seconds": 3.43,
      "text": "What painkillers are you taking?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.57,
      "end_seconds": 147.62,
      "duration_seconds": 15.05,
      "text": "Paracetamol, 1 gram, four times a day. Ibuprofen, 400 mg, three times a day. Lansoprazole, 15 mg, once a day, the hospital gave me it. And cetirizine, 10 mg, once a day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.0,
      "end_seconds": 151.19,
      "duration_seconds": 2.19,
      "text": "Good. Any allergies?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.28,
      "end_seconds": 156.55,
      "duration_seconds": 4.27,
      "text": "Penicillin. I had hives as a teenager."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.2,
      "end_seconds": 159.23,
      "duration_seconds": 1.03,
      "text": "History?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.12,
      "end_seconds": 167.36,
      "duration_seconds": 6.24,
      "text": "Recurrent tonsillitis, six episodes last year. Hay fever. And migraines."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.96,
      "end_seconds": 170.11,
      "duration_seconds": 1.15,
      "text": "Surgery?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.42,
      "end_seconds": 179.66,
      "duration_seconds": 8.24,
      "text": "The tonsillectomy ten days ago. And grommets in my ears, as a child."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.42,
      "end_seconds": 183.36,
      "duration_seconds": 2.94,
      "text": "Tonsil trouble in the family?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.34,
      "end_seconds": 189.4,
      "duration_seconds": 5.06,
      "text": "My sister had her tonsils out at fifteen."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.48,
      "end_seconds": 194.1,
      "duration_seconds": 2.62,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.15,
      "end_seconds": 198.35,
      "duration_seconds": 2.2,
      "text": "I've never smoked."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.32,
      "end_seconds": 202.6,
      "duration_seconds": 2.28,
      "text": "What's your job?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.34,
      "end_seconds": 210.32,
      "duration_seconds": 5.98,
      "text": "I teach secondary school. I'm off for two weeks."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.72,
      "end_seconds": 214.21,
      "duration_seconds": 1.49,
      "text": "Alcohol?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.87,
      "end_seconds": 218.58,
      "duration_seconds": 2.71,
      "text": "None since the operation."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.06,
      "end_seconds": 244.8,
      "duration_seconds": 9.74,
      "text": "Let me check. Pulse 70, blood pressure 114 over 70, temperature 36.8, oxygen 99 percent, breathing 14, weight 58 kilos."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.2,
      "end_seconds": 248.38,
      "duration_seconds": 2.18,
      "text": "All normal? ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.19,
      "end_seconds": 260.58,
      "duration_seconds": 3.39,
      "text": "All normal. Open wide. Say ahh."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.67,
      "end_seconds": 263.31,
      "duration_seconds": 1.64,
      "text": "Ahh. ~"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.28,
      "end_seconds": 277.26,
      "duration_seconds": 10.98,
      "text": "The tonsil beds are covered in a white-yellow coating, which is normal healing, and there's no active bleeding."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.14,
      "end_seconds": 283.58,
      "duration_seconds": 3.44,
      "text": "The coating's not infection? ~"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.87,
      "end_seconds": 290.74,
      "duration_seconds": 5.87,
      "text": "Not usually. It looks like the tonsil beds are healing normally."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.4,
      "end_seconds": 295.06,
      "duration_seconds": 2.66,
      "text": "Great. Any tests? ~"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.21,
      "end_seconds": 304.08,
      "duration_seconds": 7.87,
      "text": "Not routinely. If the pain gets worse, I might do a throat swab."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.89,
      "end_seconds": 307.99,
      "duration_seconds": 3.1,
      "text": "And if I'm feverish? ~"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.11,
      "end_seconds": 314.8,
      "duration_seconds": 4.69,
      "text": "Then I'd consider a blood test too."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.82,
      "end_seconds": 318.3,
      "duration_seconds": 2.48,
      "text": "That's reassuring. ~"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.09,
      "end_seconds": 324.63,
      "duration_seconds": 3.54,
      "text": "Any trouble with your breathing today?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.02,
      "end_seconds": 328.58,
      "duration_seconds": 2.56,
      "text": "No, nothing. Breathing's fine."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.02,
      "end_seconds": 337.41,
      "duration_seconds": 7.39,
      "text": "Keep drinking, and soft foods, and avoid anything sharp, like crisps, until two weeks after."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.46,
      "end_seconds": 340.11,
      "duration_seconds": 1.65,
      "text": "Noted. ~"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.41,
      "end_seconds": 349.61,
      "duration_seconds": 8.2,
      "text": "If you have any bleeding, go straight to the emergency department, and ring us."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.33,
      "end_seconds": 356.04,
      "duration_seconds": 3.71,
      "text": "I will. Thank you, doctor. ~"
    }
  ]
}
