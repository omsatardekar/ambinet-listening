{
  "schema_version": "1.0",
  "encounter_id": "00688",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.95,
      "end_seconds": 8.2,
      "duration_seconds": 7.25,
      "text": "Sorry I'm late, doctor, traffic was dreadful. Marcia drove me. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.0,
      "end_seconds": 14.82,
      "duration_seconds": 5.82,
      "text": "No problem. Mr Delaney, what brings you in? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.77,
      "end_seconds": 26.95,
      "duration_seconds": 11.18,
      "text": "Oh, it's nothing much. I've been feeling a bit low since Dorothy passed. My daughter thinks I should come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.79,
      "end_seconds": 35.39,
      "duration_seconds": 5.6,
      "text": "I'm sorry for your loss. How long ago?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.13,
      "end_seconds": 41.04,
      "duration_seconds": 3.91,
      "text": "About three months. I'm managing, you know."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 42.97,
      "end_seconds": 52.76,
      "duration_seconds": 9.79,
      "text": "He's not eating, doctor. He's lost weight, his trousers are held up with a belt now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.45,
      "end_seconds": 60.35,
      "duration_seconds": 5.9,
      "text": "I eat fine. I just don't have much appetite."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.86,
      "end_seconds": 69.7,
      "duration_seconds": 6.84,
      "text": "Mr Delaney, is that right, you don't have much appetite? ~"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.6,
      "end_seconds": 74.79,
      "duration_seconds": 3.19,
      "text": "A bit less, maybe. That's all."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.54,
      "end_seconds": 80.32,
      "duration_seconds": 2.78,
      "text": "How are you sleeping?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.51,
      "end_seconds": 84.45,
      "duration_seconds": 2.94,
      "text": "Sleeping fine. No trouble sleeping."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 86.39,
      "end_seconds": 93.82,
      "duration_seconds": 7.43,
      "text": "Dad, you're up at three every single night. I hear the kettle."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.68,
      "end_seconds": 101.13,
      "duration_seconds": 5.45,
      "text": "I get a cup of tea. It's not a problem. ~"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.44,
      "end_seconds": 109.42,
      "duration_seconds": 5.98,
      "text": "Any thoughts that life isn't worth living, or of harming yourself?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.15,
      "end_seconds": 114.74,
      "duration_seconds": 2.59,
      "text": "No. Nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 117.53,
      "end_seconds": 125.85,
      "duration_seconds": 8.32,
      "text": "He wouldn't say if he did, but he hasn't said anything like it to me. ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.29,
      "end_seconds": 131.0,
      "duration_seconds": 3.71,
      "text": "Okay. What medicines do you take?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.87,
      "end_seconds": 141.75,
      "duration_seconds": 7.88,
      "text": "Lisinopril, 10 mg, once a day. And metformin, 500 mg, twice a day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 144.17,
      "end_seconds": 151.41,
      "duration_seconds": 7.24,
      "text": "It's 20 mg, Dad. I fill the pill box. The lisinopril is 20."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.39,
      "end_seconds": 161.36,
      "duration_seconds": 6.97,
      "text": "I'm sure it's 10, it's what Dorothy used to give me."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.16,
      "end_seconds": 168.77,
      "duration_seconds": 6.61,
      "text": "We'll check the lisinopril dose with the pharmacy. Any allergies to medicines?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.58,
      "end_seconds": 182.58,
      "duration_seconds": 11.0,
      "text": "Well. In hospital once something gave me a rash, I think. I don't know what it was. Marcia may remember."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 184.52,
      "end_seconds": 188.04,
      "duration_seconds": 3.52,
      "text": "I don't. They never told us."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.97,
      "end_seconds": 199.43,
      "duration_seconds": 8.46,
      "text": "I'll record it as a possible allergy. What other health conditions do you have?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.82,
      "end_seconds": 207.2,
      "duration_seconds": 6.38,
      "text": "High blood pressure, diabetes, the type two, and arthritis in my hands."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.45,
      "end_seconds": 211.11,
      "duration_seconds": 1.66,
      "text": "Any operations?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.07,
      "end_seconds": 217.67,
      "duration_seconds": 3.6,
      "text": "A hernia repair, back in 2008."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.52,
      "end_seconds": 224.04,
      "duration_seconds": 3.52,
      "text": "Anyone in the family with depression?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.24,
      "end_seconds": 229.53,
      "duration_seconds": 4.29,
      "text": "My brother Frank had it, years ago."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.23,
      "end_seconds": 236.19,
      "duration_seconds": 3.96,
      "text": "How are you living at the moment?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.78,
      "end_seconds": 244.57,
      "duration_seconds": 5.79,
      "text": "On my own now, in the same house. I'm a widower."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.9,
      "end_seconds": 248.42,
      "duration_seconds": 2.52,
      "text": "And before you retired?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.33,
      "end_seconds": 253.82,
      "duration_seconds": 4.49,
      "text": "I was a mechanic for forty years. Retired now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.9,
      "end_seconds": 283.5,
      "duration_seconds": 13.6,
      "text": "Let me check your numbers. Blood pressure 134 over 80, pulse 72, temperature 36.5, oxygen 97 percent, breathing 16, and your weight is 70 kilos."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 285.2,
      "end_seconds": 289.66,
      "duration_seconds": 4.46,
      "text": "That's six kilos down from last year. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.51,
      "end_seconds": 308.68,
      "duration_seconds": 9.17,
      "text": "Noted. Let me look at you. You look a little thin, and your eyes are tired."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.73,
      "end_seconds": 313.15,
      "duration_seconds": 3.42,
      "text": "Everybody says I look tired. ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.32,
      "end_seconds": 321.69,
      "duration_seconds": 6.37,
      "text": "There's no swelling in your ankles. And your heart sounds are normal."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.75,
      "end_seconds": 326.76,
      "duration_seconds": 3.01,
      "text": "That's good, isn't it? ~"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.22,
      "end_seconds": 332.22,
      "duration_seconds": 4.0,
      "text": "Any trouble with your breathing or chest?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.65,
      "end_seconds": 337.79,
      "duration_seconds": 3.14,
      "text": "No, nothing. Breathing's fine."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.03,
      "end_seconds": 343.01,
      "duration_seconds": 3.98,
      "text": "And your tummy, any vomiting or pain?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.27,
      "end_seconds": 346.81,
      "duration_seconds": 2.54,
      "text": "No, nothing there either."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.75,
      "end_seconds": 360.6,
      "duration_seconds": 11.85,
      "text": "This looks like a grief reaction to me, but I can't rule out depression, and I want to check your body too."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 362.96,
      "end_seconds": 366.8,
      "duration_seconds": 3.84,
      "text": "There's nothing wrong with my body. ~"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.97,
      "end_seconds": 378.07,
      "duration_seconds": 10.1,
      "text": "Maybe not, but I'd like to arrange a thyroid blood test, a vitamin B12 level, an HbA1c, and kidney function."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 380.42,
      "end_seconds": 382.19,
      "duration_seconds": 1.77,
      "text": "All today? ~"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 384.08,
      "end_seconds": 388.75,
      "duration_seconds": 4.67,
      "text": "Today, yes. And please eat small meals more often."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 391.08,
      "end_seconds": 394.03,
      "duration_seconds": 2.95,
      "text": "If you say so. ~"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 395.13,
      "end_seconds": 404.16,
      "duration_seconds": 9.03,
      "text": "If the sleep and appetite haven't improved in four weeks, come back and we'll talk about support and counselling."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 406.37,
      "end_seconds": 409.91,
      "duration_seconds": 3.54,
      "text": "I'll make sure he does. ~"
    }
  ]
}
