{
  "schema_version": "1.0",
  "encounter_id": "00789",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 2.57,
      "end_seconds": 6.22,
      "duration_seconds": 3.65,
      "text": "Morning. Isotretinoin check. All fine, I think."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.55,
      "end_seconds": 14.63,
      "duration_seconds": 5.08,
      "text": "Good. You're about four months in. How's your skin?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.39,
      "end_seconds": 22.16,
      "duration_seconds": 4.77,
      "text": "Much better. Spots almost gone. Lips are chapped."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.18,
      "end_seconds": 28.27,
      "duration_seconds": 3.09,
      "text": "Any dry eyes, or nosebleeds?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.48,
      "end_seconds": 38.87,
      "duration_seconds": 7.39,
      "text": "Dry eyes, a bit. I've taken my contacts out. No nosebleeds."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.12,
      "end_seconds": 45.54,
      "duration_seconds": 3.42,
      "text": "Any muscle or joint aches?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.59,
      "end_seconds": 52.14,
      "duration_seconds": 2.55,
      "text": "No. Nothing like that."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.21,
      "end_seconds": 62.07,
      "duration_seconds": 6.86,
      "text": "Any low mood, or changes in your mood or thoughts since starting?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.79,
      "end_seconds": 70.92,
      "duration_seconds": 6.13,
      "text": "No. I feel good, actually. Better than before, because of the skin."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.67,
      "end_seconds": 81.09,
      "duration_seconds": 6.42,
      "text": "Excellent. And you're still avoiding sun, and using the lip balm? ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.85,
      "end_seconds": 89.12,
      "duration_seconds": 5.27,
      "text": "Yes. Factor 50. And the lip balm all day. ~"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.73,
      "end_seconds": 95.8,
      "duration_seconds": 3.07,
      "text": "Do you have any allergies?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.42,
      "end_seconds": 105.41,
      "duration_seconds": 6.99,
      "text": "Peanuts. Swell up, lips and tongue. I carry an adrenaline pen."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.23,
      "end_seconds": 116.72,
      "duration_seconds": 7.49,
      "text": "Thanks, that's on your record. Let me look at your face. ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.87,
      "end_seconds": 133.89,
      "duration_seconds": 1.02,
      "text": "Fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.24,
      "end_seconds": 147.94,
      "duration_seconds": 10.7,
      "text": "The acne's nearly clear, there are a few faint marks, and your lips are dry and slightly cracked."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.32,
      "end_seconds": 153.51,
      "duration_seconds": 2.19,
      "text": "Is that normal? ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.39,
      "end_seconds": 163.06,
      "duration_seconds": 5.67,
      "text": "Completely normal on this treatment. I'd say you're responding very well."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.57,
      "end_seconds": 167.75,
      "duration_seconds": 2.18,
      "text": "What next? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.16,
      "end_seconds": 180.08,
      "duration_seconds": 8.92,
      "text": "Keep going with the same dose. Your blood tests last month were fine, I had them checked."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.69,
      "end_seconds": 184.42,
      "duration_seconds": 1.73,
      "text": "Great. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.24,
      "end_seconds": 193.87,
      "duration_seconds": 5.63,
      "text": "Do you ever feel breathless, wheezy or have chest tightness?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.19,
      "end_seconds": 200.03,
      "duration_seconds": 2.84,
      "text": "No. Nothing at all."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.6,
      "end_seconds": 205.55,
      "duration_seconds": 1.95,
      "text": "Any alcohol?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.5,
      "end_seconds": 212.44,
      "duration_seconds": 3.94,
      "text": "Not really. A glass at a party."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.25,
      "end_seconds": 220.13,
      "duration_seconds": 4.88,
      "text": "Good. Try to avoid it for the duration. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.43,
      "end_seconds": 225.41,
      "duration_seconds": 1.98,
      "text": "I will. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.41,
      "end_seconds": 239.38,
      "duration_seconds": 9.97,
      "text": "Moisturise your lips, use eye drops for the dryness, and avoid waxing or laser while you're on it."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.75,
      "end_seconds": 245.74,
      "duration_seconds": 2.99,
      "text": "I haven't waxed. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.11,
      "end_seconds": 255.39,
      "duration_seconds": 6.28,
      "text": "Good. Keep up the sun protection, even in winter. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.3,
      "end_seconds": 260.81,
      "duration_seconds": 1.51,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.32,
      "end_seconds": 267.12,
      "duration_seconds": 3.8,
      "text": "Any questions before you go? ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.8,
      "end_seconds": 274.48,
      "duration_seconds": 3.68,
      "text": "When do I finish? ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.19,
      "end_seconds": 284.5,
      "duration_seconds": 6.31,
      "text": "Another two months or so, depending on your total dose. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.98,
      "end_seconds": 289.61,
      "duration_seconds": 1.63,
      "text": "Brilliant. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.17,
      "end_seconds": 299.6,
      "duration_seconds": 7.43,
      "text": "If you get severe headaches, vision problems, or any low mood, ring us immediately."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.43,
      "end_seconds": 306.0,
      "duration_seconds": 2.57,
      "text": "I will. Thanks. ~"
    }
  ]
}
