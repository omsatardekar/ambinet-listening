{
  "schema_version": "1.0",
  "encounter_id": "00931",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 1.93,
      "end_seconds": 15.86,
      "duration_seconds": 13.93,
      "text": "Doctor, I'm Lena's aunt, I look after her while her mum is working abroad. She's got swollen glands in her neck and she's exhausted, and it's been weeks."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.07,
      "end_seconds": 23.7,
      "duration_seconds": 5.63,
      "text": "Thank you for bringing her. Lena, how are you feeling? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.98,
      "end_seconds": 31.62,
      "duration_seconds": 4.64,
      "text": "Tired. All the time. I can't concentrate at school."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.67,
      "end_seconds": 37.02,
      "duration_seconds": 3.35,
      "text": "Where are the swollen glands?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.2,
      "end_seconds": 46.98,
      "duration_seconds": 6.78,
      "text": "Both sides of my neck. They're sore when I touch them."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.29,
      "end_seconds": 53.1,
      "duration_seconds": 3.81,
      "text": "How long have you had them?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.09,
      "end_seconds": 59.26,
      "duration_seconds": 3.17,
      "text": "Three weeks, I think."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 61.73,
      "end_seconds": 67.91,
      "duration_seconds": 6.18,
      "text": "Longer, I think. Closer to four weeks, since her birthday."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.57,
      "end_seconds": 78.99,
      "duration_seconds": 7.42,
      "text": "I'll note three to four weeks. Have you had a sore throat, or a fever?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.78,
      "end_seconds": 88.54,
      "duration_seconds": 5.76,
      "text": "The sore throat was last week, but it's gone. No fever."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.73,
      "end_seconds": 95.28,
      "duration_seconds": 4.55,
      "text": "Any rash, night sweats or weight loss?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.55,
      "end_seconds": 102.96,
      "duration_seconds": 5.41,
      "text": "No rash. No sweats. I don't think I've lost weight."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.61,
      "end_seconds": 108.43,
      "duration_seconds": 2.82,
      "text": "What have you been taking?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.04,
      "end_seconds": 122.79,
      "duration_seconds": 11.75,
      "text": "Paracetamol, 500 mg, when I get a headache. And the antibiotic, penicillin, I had it for a sore throat."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.86,
      "end_seconds": 128.53,
      "duration_seconds": 3.67,
      "text": "Did you finish the penicillin?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.7,
      "end_seconds": 133.44,
      "duration_seconds": 2.74,
      "text": "I think so. Mostly."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 137.04,
      "end_seconds": 144.28,
      "duration_seconds": 7.24,
      "text": "I'm not sure she did. I found a few tablets in her bag."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.2,
      "end_seconds": 152.94,
      "duration_seconds": 5.74,
      "text": "Thank you for being honest. Do you have any allergies, Lena?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 156.2,
      "end_seconds": 165.35,
      "duration_seconds": 9.15,
      "text": "She had a rash on amoxicillin when she was a toddler, her mum told me. We've avoided it since."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.55,
      "end_seconds": 169.92,
      "duration_seconds": 2.37,
      "text": "Noted. Any other conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.29,
      "end_seconds": 177.17,
      "duration_seconds": 3.88,
      "text": "Asthma. And I get eczema sometimes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 179.26,
      "end_seconds": 183.42,
      "duration_seconds": 4.16,
      "text": "She had her tonsils out at six."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.06,
      "end_seconds": 191.84,
      "duration_seconds": 5.78,
      "text": "Thank you. Let me check your pulse and temperature. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.82,
      "end_seconds": 205.86,
      "duration_seconds": 1.04,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.33,
      "end_seconds": 211.19,
      "duration_seconds": 2.86,
      "text": "Pulse 82, temperature 36.8."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 213.94,
      "end_seconds": 217.33,
      "duration_seconds": 3.39,
      "text": "Is that all right? ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.41,
      "end_seconds": 230.83,
      "duration_seconds": 10.42,
      "text": "Normal. I'd like to feel the glands in your neck, under the arms, and your tummy. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.89,
      "end_seconds": 247.3,
      "duration_seconds": 1.41,
      "text": "It tickles."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.28,
      "end_seconds": 259.48,
      "duration_seconds": 9.2,
      "text": "I'm going to arrange a blood test to look at glandular fever and a full blood count."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.46,
      "end_seconds": 264.17,
      "duration_seconds": 1.71,
      "text": "Needles? ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.35,
      "end_seconds": 276.64,
      "duration_seconds": 9.29,
      "text": "Just a small one. If it is glandular fever, rest and fluids are the main treatment."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 280.32,
      "end_seconds": 285.58,
      "duration_seconds": 5.26,
      "text": "How long will she be off school? ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.45,
      "end_seconds": 300.03,
      "duration_seconds": 11.58,
      "text": "Let's see the result first. And I'd like to see her again in a week to go through it."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 303.76,
      "end_seconds": 306.0,
      "duration_seconds": 2.24,
      "text": "Thank you. ~"
    }
  ]
}
