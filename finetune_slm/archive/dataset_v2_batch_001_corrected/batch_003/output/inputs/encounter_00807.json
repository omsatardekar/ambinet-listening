{
  "schema_version": "1.0",
  "encounter_id": "00807",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 0.5,
      "end_seconds": 7.89,
      "duration_seconds": 7.39,
      "text": "Good morning. How would you like to be addressed, Mr Arkwright, or Walter? ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.72,
      "end_seconds": 19.84,
      "duration_seconds": 9.12,
      "text": "Mr Arkwright, if you'd be so kind. This is my son, Philip, who insisted on driving me. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 20.58,
      "end_seconds": 28.63,
      "duration_seconds": 8.05,
      "text": "Dad's been coughing up green sputum and I think it's a chest infection, so I booked it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.36,
      "end_seconds": 36.67,
      "duration_seconds": 5.31,
      "text": "Thank you, Philip. Mr Arkwright, when did the green sputum start?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.53,
      "end_seconds": 48.37,
      "duration_seconds": 9.84,
      "text": "Let me think. It was before the Bank Holiday. Or just after it. I really couldn't say with any confidence."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 51.31,
      "end_seconds": 61.58,
      "duration_seconds": 10.27,
      "text": "Early last month, Dad? Or was it after the anniversary? I can't pin it down either."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.27,
      "end_seconds": 68.03,
      "duration_seconds": 3.76,
      "text": "That's all right. Do you wheeze?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.09,
      "end_seconds": 75.34,
      "duration_seconds": 6.25,
      "text": "Yes, particularly at night. A sort of whistle when I breathe out."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.77,
      "end_seconds": 80.87,
      "duration_seconds": 3.1,
      "text": "And how is your energy?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.4,
      "end_seconds": 86.82,
      "duration_seconds": 3.42,
      "text": "Poor. I'm tired all day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.37,
      "end_seconds": 92.12,
      "duration_seconds": 2.75,
      "text": "Do you cough up blood?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.1,
      "end_seconds": 96.46,
      "duration_seconds": 1.36,
      "text": "Certainly not."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.2,
      "end_seconds": 99.69,
      "duration_seconds": 2.49,
      "text": "Fever or shivers?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.16,
      "end_seconds": 103.87,
      "duration_seconds": 1.71,
      "text": "No fever."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.54,
      "end_seconds": 108.17,
      "duration_seconds": 1.63,
      "text": "Chest pain?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.87,
      "end_seconds": 113.47,
      "duration_seconds": 2.6,
      "text": "No pain, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.3,
      "end_seconds": 115.87,
      "duration_seconds": 1.57,
      "text": "Weight loss?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.23,
      "end_seconds": 120.42,
      "duration_seconds": 3.19,
      "text": "None that I'm aware of."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.57,
      "end_seconds": 123.34,
      "duration_seconds": 1.77,
      "text": "Swollen ankles?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.37,
      "end_seconds": 129.11,
      "duration_seconds": 4.74,
      "text": "No, my ankles are as they've always been."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.1,
      "end_seconds": 133.76,
      "duration_seconds": 2.66,
      "text": "What inhalers do you use?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.12,
      "end_seconds": 146.06,
      "duration_seconds": 10.94,
      "text": "Tiotropium, maybe 18 micrograms, once a day, though I'd have to check the box. And salbutamol, when I'm wheezy."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.79,
      "end_seconds": 150.92,
      "duration_seconds": 4.13,
      "text": "We'll verify the tiotropium. Any allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.76,
      "end_seconds": 158.48,
      "duration_seconds": 4.72,
      "text": "Septrin. I broke out in a rash."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.45,
      "end_seconds": 160.89,
      "duration_seconds": 1.44,
      "text": "Medical history?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.34,
      "end_seconds": 166.04,
      "duration_seconds": 3.7,
      "text": "COPD, high blood pressure, osteoporosis, and reflux."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.18,
      "end_seconds": 168.19,
      "duration_seconds": 1.01,
      "text": "Operations?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.47,
      "end_seconds": 174.01,
      "duration_seconds": 4.54,
      "text": "A hip replacement in 2019, and cataracts in 2021."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.19,
      "end_seconds": 179.23,
      "duration_seconds": 3.04,
      "text": "Lung problems in the family?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.15,
      "end_seconds": 185.33,
      "duration_seconds": 4.18,
      "text": "My father had emphysema. My sister has asthma."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.93,
      "end_seconds": 189.68,
      "duration_seconds": 2.75,
      "text": "You smoked, I think."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.66,
      "end_seconds": 200.0,
      "duration_seconds": 8.34,
      "text": "I gave up smoking twelve years ago. Forty a day for forty years, before that."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.3,
      "end_seconds": 203.56,
      "duration_seconds": 1.26,
      "text": "Alcohol?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.61,
      "end_seconds": 207.87,
      "duration_seconds": 3.26,
      "text": "A sherry at Christmas."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.62,
      "end_seconds": 212.76,
      "duration_seconds": 2.14,
      "text": "Who's at home?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.51,
      "end_seconds": 218.4,
      "duration_seconds": 2.89,
      "text": "I live with Philip now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.36,
      "end_seconds": 221.73,
      "duration_seconds": 2.37,
      "text": "And your work?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.08,
      "end_seconds": 229.71,
      "duration_seconds": 5.63,
      "text": "I was a factory foreman. Retired for eleven years."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.3,
      "end_seconds": 257.35,
      "duration_seconds": 11.05,
      "text": "Let me check you. Oxygen 92 percent, pulse 88, temperature 37.6, breathing 20, blood pressure 142 over 84, weight 70 kilos."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 258.38,
      "end_seconds": 261.62,
      "duration_seconds": 3.24,
      "text": "Is the oxygen low? ~"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.13,
      "end_seconds": 279.76,
      "duration_seconds": 6.63,
      "text": "A bit low for him, yes. Let me listen. Deep breaths, Mr Arkwright."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.68,
      "end_seconds": 285.66,
      "duration_seconds": 3.98,
      "text": "Is this how you want it? ~"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.41,
      "end_seconds": 295.84,
      "duration_seconds": 7.43,
      "text": "Perfect. I can hear crackles at the right base, and wheeze throughout both lungs."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.65,
      "end_seconds": 300.26,
      "duration_seconds": 2.61,
      "text": "Is that serious? ~"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.63,
      "end_seconds": 310.34,
      "duration_seconds": 8.71,
      "text": "There's no swelling in the legs, which is good. Any trouble with your heart, palpitations, fluttering?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.74,
      "end_seconds": 315.8,
      "duration_seconds": 3.06,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.93,
      "end_seconds": 322.1,
      "duration_seconds": 4.17,
      "text": "And your tummy, any trouble with your bowels?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.58,
      "end_seconds": 327.37,
      "duration_seconds": 2.79,
      "text": "No, nothing, all regular."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.75,
      "end_seconds": 339.11,
      "duration_seconds": 9.36,
      "text": "This looks like a chest infection on top of the COPD, but I can't rule out pneumonia."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 341.7,
      "end_seconds": 344.55,
      "duration_seconds": 2.85,
      "text": "Does he need antibiotics? ~"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.01,
      "end_seconds": 356.49,
      "duration_seconds": 10.48,
      "text": "I'll decide after the X-ray. I'd like to arrange a chest X-ray today, and a sputum sample."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 358.58,
      "end_seconds": 362.83,
      "duration_seconds": 4.25,
      "text": "I'll take him down now. ~"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.37,
      "end_seconds": 369.39,
      "duration_seconds": 5.02,
      "text": "And I'd like to see you again in a week."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 371.01,
      "end_seconds": 374.57,
      "duration_seconds": 3.56,
      "text": "A week. Thank you, doctor. ~"
    }
  ]
}
