{
  "schema_version": "1.0",
  "encounter_id": "00950",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 2.15,
      "end_seconds": 18.02,
      "duration_seconds": 15.87,
      "text": "Morning, doctor. This is Ellie, she's three. I'm her childminder, Becca, her mum asked me to bring her in, and I've written everything down. She's had a fever for two days."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.71,
      "end_seconds": 28.44,
      "duration_seconds": 7.73,
      "text": "Thank you, Becca. A fever for two days. How high has it been?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 32.32,
      "end_seconds": 38.95,
      "duration_seconds": 6.63,
      "text": "Thirty-eight point five at its highest, last night. This morning thirty-eight point two. ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.13,
      "end_seconds": 48.61,
      "duration_seconds": 6.48,
      "text": "Ellie, hello. Can you tell me if your tummy hurts?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.59,
      "end_seconds": 53.24,
      "duration_seconds": 1.65,
      "text": "No tummy!"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 56.07,
      "end_seconds": 64.84,
      "duration_seconds": 8.77,
      "text": "She was clutching her tummy at lunch yesterday, doctor. She curled up on the sofa and held it."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.72,
      "end_seconds": 77.84,
      "duration_seconds": 9.12,
      "text": "I'll write down what you both say. Ellie, you say no tummy, Becca says tummy yesterday. Any rash, Becca?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 81.64,
      "end_seconds": 87.46,
      "duration_seconds": 5.82,
      "text": "No rash. I checked her all over at bath time."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.38,
      "end_seconds": 95.18,
      "duration_seconds": 4.8,
      "text": "What have you been giving her for the fever?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 98.45,
      "end_seconds": 107.8,
      "duration_seconds": 9.35,
      "text": "Paracetamol syrup, 5 ml, every six hours. And ibuprofen syrup, 5 ml, in between, as her mum said."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.71,
      "end_seconds": 115.25,
      "duration_seconds": 4.54,
      "text": "That's fine. Any history I should know about?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 118.97,
      "end_seconds": 121.68,
      "duration_seconds": 2.71,
      "text": "She's got eczema, mild."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.69,
      "end_seconds": 141.91,
      "duration_seconds": 9.22,
      "text": "Let me take her numbers. Ellie, can I put this little clip on your finger?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.26,
      "end_seconds": 147.01,
      "duration_seconds": 1.75,
      "text": "Finger! ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.85,
      "end_seconds": 162.46,
      "duration_seconds": 4.61,
      "text": "Temperature 38.4, pulse 130, and weight 13 kilos."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 164.79,
      "end_seconds": 167.46,
      "duration_seconds": 2.67,
      "text": "Is that high? ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.12,
      "end_seconds": 178.58,
      "duration_seconds": 7.46,
      "text": "The pulse is quick, which is expected with a fever. Becca, any cough or runny nose?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 181.47,
      "end_seconds": 186.18,
      "duration_seconds": 4.71,
      "text": "No, nothing like that, her chest has been clear."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.27,
      "end_seconds": 192.09,
      "duration_seconds": 2.82,
      "text": "Is she drinking? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 194.46,
      "end_seconds": 199.94,
      "duration_seconds": 5.48,
      "text": "Yes, she's had milk and juice, she's weeing normally. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.04,
      "end_seconds": 205.97,
      "duration_seconds": 2.93,
      "text": "Is she playing? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 208.47,
      "end_seconds": 212.05,
      "duration_seconds": 3.58,
      "text": "In bursts. Then she flops. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.38,
      "end_seconds": 224.53,
      "duration_seconds": 10.15,
      "text": "That's a good sign that she's perking up in between. Ellie, you're being very brave. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.25,
      "end_seconds": 229.59,
      "duration_seconds": 2.34,
      "text": "Bye-bye, doctor. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.08,
      "end_seconds": 241.26,
      "duration_seconds": 9.18,
      "text": "Not yet, sweetheart. Becca, I don't want to label this today. I'd like to watch her. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 244.38,
      "end_seconds": 248.48,
      "duration_seconds": 4.1,
      "text": "What should I watch for? ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.78,
      "end_seconds": 261.2,
      "duration_seconds": 9.42,
      "text": "Keep giving the fluids and keep the paracetamol and ibuprofen going as you have been."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 265.2,
      "end_seconds": 267.04,
      "duration_seconds": 1.84,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.99,
      "end_seconds": 283.62,
      "duration_seconds": 12.63,
      "text": "If she stops drinking, has a rash, or seems very sleepy, ring us or go to the emergency department right away."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 287.58,
      "end_seconds": 289.92,
      "duration_seconds": 2.34,
      "text": "I will. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.43,
      "end_seconds": 298.1,
      "duration_seconds": 4.67,
      "text": "I'd like to see her again tomorrow."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 301.53,
      "end_seconds": 306.02,
      "duration_seconds": 4.49,
      "text": "Tomorrow, yes. I'll let her mum know. ~"
    }
  ]
}
