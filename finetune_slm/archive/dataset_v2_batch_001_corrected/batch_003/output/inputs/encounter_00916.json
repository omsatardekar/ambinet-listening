{
  "schema_version": "1.0",
  "encounter_id": "00916",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 1.01,
      "end_seconds": 14.89,
      "duration_seconds": 13.88,
      "text": "Hello doctor! I'm Mrs Okafor's friend, I drive her to appointments. She says she's got something stuck in her throat, and it's been bothering her for weeks."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.48,
      "end_seconds": 24.9,
      "duration_seconds": 7.42,
      "text": "Thank you for bringing her. Mrs Okafor, can you describe it for me?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.61,
      "end_seconds": 34.14,
      "duration_seconds": 7.53,
      "text": "It feels like a lump, right in the middle, here. Even when I haven't eaten."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.48,
      "end_seconds": 40.25,
      "duration_seconds": 3.77,
      "text": "When did you first notice it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.32,
      "end_seconds": 45.73,
      "duration_seconds": 2.41,
      "text": "About six weeks ago."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 48.56,
      "end_seconds": 54.5,
      "duration_seconds": 5.94,
      "text": "She told me at book club, and that was in the spring."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.8,
      "end_seconds": 61.37,
      "duration_seconds": 5.57,
      "text": "Does it get worse when you swallow food or drinks?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.04,
      "end_seconds": 71.4,
      "duration_seconds": 8.36,
      "text": "No, it's actually better when I eat. It's there when I swallow my saliva."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.59,
      "end_seconds": 78.92,
      "duration_seconds": 4.33,
      "text": "Any weight loss, hoarseness, or coughing up blood?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.84,
      "end_seconds": 87.01,
      "duration_seconds": 6.17,
      "text": "No weight loss. My voice is the same. No blood."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.17,
      "end_seconds": 94.02,
      "duration_seconds": 4.85,
      "text": "Do you have any heartburn or a sour taste?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.25,
      "end_seconds": 98.53,
      "duration_seconds": 3.28,
      "text": "Sometimes, yes. A burning after dinner."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.16,
      "end_seconds": 103.67,
      "duration_seconds": 3.51,
      "text": "What medicines are you taking?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.27,
      "end_seconds": 113.19,
      "duration_seconds": 7.92,
      "text": "Amlodipine, 5 mg, once a day. And a thyroid tablet, levothyroxine, 100 micrograms."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.9,
      "end_seconds": 118.28,
      "duration_seconds": 2.38,
      "text": "Any other conditions?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.03,
      "end_seconds": 127.5,
      "duration_seconds": 7.47,
      "text": "High blood pressure, underactive thyroid, and I'm a bit anxious, I admit."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 129.41,
      "end_seconds": 133.53,
      "duration_seconds": 4.12,
      "text": "She's been worried it's something terrible. ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.59,
      "end_seconds": 141.31,
      "duration_seconds": 4.72,
      "text": "That's understandable. Do you smoke or drink alcohol?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.08,
      "end_seconds": 149.53,
      "duration_seconds": 5.45,
      "text": "No smoking. A glass of wine now and then."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.72,
      "end_seconds": 159.16,
      "duration_seconds": 6.44,
      "text": "Let me take your pulse, pressure, temperature and oxygen. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.09,
      "end_seconds": 172.53,
      "duration_seconds": 1.44,
      "text": "Go on."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.61,
      "end_seconds": 184.24,
      "duration_seconds": 8.63,
      "text": "Pulse 74, blood pressure 130 over 80, temperature 36.6, oxygen 99 percent, breathing 14."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 185.79,
      "end_seconds": 188.42,
      "duration_seconds": 2.63,
      "text": "Is that good? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.46,
      "end_seconds": 199.16,
      "duration_seconds": 7.7,
      "text": "Very good. Now let me feel your neck and look at your throat. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.11,
      "end_seconds": 218.52,
      "duration_seconds": 1.41,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.09,
      "end_seconds": 229.53,
      "duration_seconds": 9.44,
      "text": "Your throat looks normal, there's no lump in the neck, and your thyroid isn't enlarged. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.23,
      "end_seconds": 234.85,
      "duration_seconds": 3.62,
      "text": "So there's nothing there? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.44,
      "end_seconds": 248.94,
      "duration_seconds": 11.5,
      "text": "Nothing I can see. What you describe is a feeling called globus, which is common and usually harmless, and acid reflux can be involved."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.91,
      "end_seconds": 254.82,
      "duration_seconds": 3.91,
      "text": "Is that a relief or not? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.36,
      "end_seconds": 271.68,
      "duration_seconds": 14.32,
      "text": "It is a relief, mostly. I'd like to arrange a blood test for your thyroid and a check of your iron levels, just to be thorough."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.49,
      "end_seconds": 276.59,
      "duration_seconds": 2.1,
      "text": "All right. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.68,
      "end_seconds": 285.92,
      "duration_seconds": 7.24,
      "text": "Try smaller meals, avoid late dinners, and cut down on strong coffee and spicy food."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 288.17,
      "end_seconds": 292.84,
      "duration_seconds": 4.67,
      "text": "I'll make sure she keeps to that. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.42,
      "end_seconds": 301.96,
      "duration_seconds": 6.54,
      "text": "Let me see you in four weeks, and we'll talk again."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.34,
      "end_seconds": 306.01,
      "duration_seconds": 2.67,
      "text": "Four weeks. Thank you. ~"
    }
  ]
}
