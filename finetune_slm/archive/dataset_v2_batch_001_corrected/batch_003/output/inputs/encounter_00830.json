{
  "schema_version": "1.0",
  "encounter_id": "00830",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 0.3,
      "end_seconds": 11.93,
      "duration_seconds": 11.63,
      "text": "Mr Lindsay, I'm Una, the nurse, and I've got your tablet list ready for the doctor. Your carer's welcome to sit in. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_4",
      "role": "CAREGIVER",
      "start_seconds": 13.54,
      "end_seconds": 20.6,
      "duration_seconds": 7.06,
      "text": "Thank you. I'm Denise, I look after Mr Lindsay on weekday mornings. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.77,
      "end_seconds": 33.01,
      "duration_seconds": 11.24,
      "text": "Good morning. I should say that I'd like this to be accurate, so I shall be precise. ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.49,
      "end_seconds": 40.45,
      "duration_seconds": 5.96,
      "text": "That suits me, Mr Lindsay. What brings you in? ~"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.16,
      "end_seconds": 58.16,
      "duration_seconds": 17.0,
      "text": "Last Tuesday, at 10.40 in the morning, I lost the vision in my left eye. Completely, like a curtain coming down from above. It lasted about four minutes, and then it went away."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.36,
      "end_seconds": 64.76,
      "duration_seconds": 5.4,
      "text": "That's very clear, thank you. Was it just the one eye?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.88,
      "end_seconds": 77.8,
      "duration_seconds": 10.92,
      "text": "Yes. When I covered the right eye, I could see nothing. When I covered the left, the right was normal."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "CAREGIVER",
      "start_seconds": 78.73,
      "end_seconds": 84.31,
      "duration_seconds": 5.58,
      "text": "He phoned me straight away. I think he was shaken. ~"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.62,
      "end_seconds": 90.49,
      "duration_seconds": 3.87,
      "text": "Has it happened before or since? ~"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.03,
      "end_seconds": 96.55,
      "duration_seconds": 3.52,
      "text": "Not before. Not since. ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.38,
      "end_seconds": 102.08,
      "duration_seconds": 4.7,
      "text": "Any pain in the eye, headache, or flashing lights?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.78,
      "end_seconds": 108.13,
      "duration_seconds": 3.35,
      "text": "No pain. No headache. No flashes."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.07,
      "end_seconds": 117.81,
      "duration_seconds": 8.74,
      "text": "Any weakness in your face or limbs, or any trouble with speech at that time?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.01,
      "end_seconds": 121.46,
      "duration_seconds": 2.45,
      "text": "None of those."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.98,
      "end_seconds": 127.57,
      "duration_seconds": 3.59,
      "text": "Let me look at your medicines."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 129.46,
      "end_seconds": 142.7,
      "duration_seconds": 13.24,
      "text": "I've got the list, doctor. Aspirin, 75 mg, once a day. Atorvastatin, 40 mg at night. And amlodipine, 5 mg, once a day."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.68,
      "end_seconds": 146.09,
      "duration_seconds": 2.41,
      "text": "That is correct. ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.82,
      "end_seconds": 151.72,
      "duration_seconds": 2.9,
      "text": "And your medical history?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 152.61,
      "end_seconds": 161.41,
      "duration_seconds": 8.8,
      "text": "High blood pressure, high cholesterol, and he had a heart attack, six years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.17,
      "end_seconds": 168.49,
      "duration_seconds": 6.32,
      "text": "Let me check your eyes and your neck. Look straight ahead. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.42,
      "end_seconds": 191.13,
      "duration_seconds": 1.71,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.98,
      "end_seconds": 208.57,
      "duration_seconds": 15.59,
      "text": "Your vision, pupils and eye movements are normal, and the back of the eye looks healthy. There's a swishing sound, a bruit, over the left side of your neck."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.5,
      "end_seconds": 213.55,
      "duration_seconds": 3.05,
      "text": "What does that signify? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.6,
      "end_seconds": 235.9,
      "duration_seconds": 20.3,
      "text": "It can mean the artery in the neck is narrowed. Together with what you describe, a brief curtain across one eye, this is typical of a temporary blockage of the blood supply to the eye, from a narrowed neck artery. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "CAREGIVER",
      "start_seconds": 238.57,
      "end_seconds": 240.61,
      "duration_seconds": 2.04,
      "text": "A mini-stroke? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.77,
      "end_seconds": 258.12,
      "duration_seconds": 16.35,
      "text": "Of the eye, yes, it's the same process. It's a warning. I'd like you to have an urgent ultrasound scan of the arteries in your neck, a carotid scan, within days, and blood tests."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.29,
      "end_seconds": 262.39,
      "duration_seconds": 3.1,
      "text": "Is that a priority? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.27,
      "end_seconds": 276.01,
      "duration_seconds": 10.74,
      "text": "Yes, it needs to be done quickly. I'll arrange it as urgent, and the vascular team will see you. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 277.33,
      "end_seconds": 282.41,
      "duration_seconds": 5.08,
      "text": "I'll book the scan for the earliest slot, doctor. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.3,
      "end_seconds": 290.29,
      "duration_seconds": 6.99,
      "text": "Thank you, Una. Keep taking all your tablets, especially the aspirin and the atorvastatin."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.86,
      "end_seconds": 295.71,
      "duration_seconds": 3.85,
      "text": "I never miss them. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.02,
      "end_seconds": 310.23,
      "duration_seconds": 13.21,
      "text": "If it happens again, or you get weakness in the face or an arm, slurred speech, or loss of vision that doesn't clear, call 999 immediately."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "CAREGIVER",
      "start_seconds": 311.12,
      "end_seconds": 314.65,
      "duration_seconds": 3.53,
      "text": "I'll make sure he knows. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.54,
      "end_seconds": 321.2,
      "duration_seconds": 3.66,
      "text": "Thank you. I appreciate your clarity. ~"
    }
  ]
}
