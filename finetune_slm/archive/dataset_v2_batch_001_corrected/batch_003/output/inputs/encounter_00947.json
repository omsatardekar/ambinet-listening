{
  "schema_version": "1.0",
  "encounter_id": "00947",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 1.25,
      "end_seconds": 9.67,
      "duration_seconds": 8.42,
      "text": "Good afternoon, Mr Doyle, Mrs Doyle. The booking says inhaler technique review. What's been happening? ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.52,
      "end_seconds": 18.78,
      "duration_seconds": 8.26,
      "text": "Well, the breathing, you know. Not good. A bit all over the place."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.8,
      "end_seconds": 25.61,
      "duration_seconds": 4.81,
      "text": "Can you say more? When are you breathless?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.96,
      "end_seconds": 35.47,
      "duration_seconds": 7.51,
      "text": "Going up the hill to the shops. Or, I don't know, sometimes sitting."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 36.74,
      "end_seconds": 44.3,
      "duration_seconds": 7.56,
      "text": "Not sitting, Tom. When you hurry. And he coughs all the time, doctor, morning mostly."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.32,
      "end_seconds": 49.06,
      "duration_seconds": 2.74,
      "text": "And does he wheeze?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 50.63,
      "end_seconds": 57.64,
      "duration_seconds": 7.01,
      "text": "At night, yes. I can hear it from my side of the bed."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.59,
      "end_seconds": 61.97,
      "duration_seconds": 2.38,
      "text": "Any chest pain?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.52,
      "end_seconds": 66.67,
      "duration_seconds": 2.15,
      "text": "No pain, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.64,
      "end_seconds": 70.18,
      "duration_seconds": 1.54,
      "text": "Fever?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.27,
      "end_seconds": 73.99,
      "duration_seconds": 1.72,
      "text": "No fever."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.72,
      "end_seconds": 78.0,
      "duration_seconds": 2.28,
      "text": "Coughing up blood?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.4,
      "end_seconds": 81.96,
      "duration_seconds": 1.56,
      "text": "No blood."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.1,
      "end_seconds": 85.79,
      "duration_seconds": 1.69,
      "text": "Swollen ankles?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 87.34,
      "end_seconds": 90.52,
      "duration_seconds": 3.18,
      "text": "No, his ankles are fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.44,
      "end_seconds": 93.83,
      "duration_seconds": 1.39,
      "text": "Weight loss?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 95.51,
      "end_seconds": 100.43,
      "duration_seconds": 4.92,
      "text": "No, if anything he's put on a bit."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.19,
      "end_seconds": 108.61,
      "duration_seconds": 5.42,
      "text": "And which inhalers do you use at the moment, Tom?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.86,
      "end_seconds": 120.53,
      "duration_seconds": 9.67,
      "text": "The blue one. The puffer. I can't remember what it's called. The blue one, for when I'm wheezy."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 122.38,
      "end_seconds": 133.3,
      "duration_seconds": 10.92,
      "text": "It's in his bag, doctor, I can read it for you later, but I think the label's worn off."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.3,
      "end_seconds": 141.76,
      "duration_seconds": 6.46,
      "text": "That's fine, we'll find it on the record. Any allergies to medicines?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.73,
      "end_seconds": 145.16,
      "duration_seconds": 1.43,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.94,
      "end_seconds": 150.82,
      "duration_seconds": 2.88,
      "text": "What conditions have you got?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.09,
      "end_seconds": 157.96,
      "duration_seconds": 4.87,
      "text": "Asthma, since I was a boy. And hay fever."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.73,
      "end_seconds": 160.63,
      "duration_seconds": 1.9,
      "text": "Any operations?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.38,
      "end_seconds": 167.94,
      "duration_seconds": 5.56,
      "text": "Tonsils, as a lad. And a hernia in 2012."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.71,
      "end_seconds": 172.49,
      "duration_seconds": 2.78,
      "text": "Asthma in the family?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.92,
      "end_seconds": 177.45,
      "duration_seconds": 2.53,
      "text": "My mother had it."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.34,
      "end_seconds": 180.84,
      "duration_seconds": 2.5,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.47,
      "end_seconds": 185.78,
      "duration_seconds": 3.31,
      "text": "I stopped smoking ten years ago."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.02,
      "end_seconds": 192.05,
      "duration_seconds": 4.03,
      "text": "And what did you do for work?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 195.0,
      "end_seconds": 199.66,
      "duration_seconds": 4.66,
      "text": "He was a postman, thirty years. Retired."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.44,
      "end_seconds": 205.54,
      "duration_seconds": 3.1,
      "text": "Do you get out walking?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.13,
      "end_seconds": 213.57,
      "duration_seconds": 5.44,
      "text": "When I can. The dog needs it more than me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.09,
      "end_seconds": 242.84,
      "duration_seconds": 11.75,
      "text": "Let me check you. Pulse 84, blood pressure 140 over 86, temperature 36.7, oxygen 94 percent, breathing 18, weight 80 kilos."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 245.26,
      "end_seconds": 249.34,
      "duration_seconds": 4.08,
      "text": "Is the oxygen all right? ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.34,
      "end_seconds": 267.86,
      "duration_seconds": 7.52,
      "text": "A bit lower than I'd like, but not alarming. Let me listen. Big breaths, Tom."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.08,
      "end_seconds": 271.18,
      "duration_seconds": 2.1,
      "text": "Like this? ~"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.65,
      "end_seconds": 281.63,
      "duration_seconds": 7.98,
      "text": "I can hear wheeze on both sides, mostly when you breathe out."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.28,
      "end_seconds": 286.69,
      "duration_seconds": 2.41,
      "text": "That's the whistle. ~"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.6,
      "end_seconds": 297.89,
      "duration_seconds": 8.29,
      "text": "And your chest is moving well, with no signs of struggling. Your heart sounds are normal."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 299.06,
      "end_seconds": 301.31,
      "duration_seconds": 2.25,
      "text": "That's good. ~"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.1,
      "end_seconds": 309.17,
      "duration_seconds": 5.07,
      "text": "Any palpitations, any trouble with your heart?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.46,
      "end_seconds": 313.25,
      "duration_seconds": 2.79,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.31,
      "end_seconds": 318.44,
      "duration_seconds": 3.13,
      "text": "Any heartburn or trouble swallowing?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.99,
      "end_seconds": 323.88,
      "duration_seconds": 3.89,
      "text": "No, nothing. I eat like a horse."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.57,
      "end_seconds": 338.84,
      "duration_seconds": 12.27,
      "text": "Now I'd like to see how you use the blue puffer. Priya, would you hand him the demonstration one? ~"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 341.26,
      "end_seconds": 351.23,
      "duration_seconds": 9.97,
      "text": "Of course. Here you are, Mr Doyle. Breathe out first, then press, and breathe in slowly. ~"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 354.07,
      "end_seconds": 356.2,
      "duration_seconds": 2.13,
      "text": "Like that? ~"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 357.17,
      "end_seconds": 366.34,
      "duration_seconds": 9.17,
      "text": "You pressed, and then you breathed in too fast, and held it for just a second. ~"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.19,
      "end_seconds": 378.94,
      "duration_seconds": 9.75,
      "text": "That's the common problem. The medicine is hitting the back of your throat instead of the lungs. ~"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 381.16,
      "end_seconds": 384.4,
      "duration_seconds": 3.24,
      "text": "So it's not working? ~"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 386.25,
      "end_seconds": 396.79,
      "duration_seconds": 10.54,
      "text": "Not as well as it could. I think the poor technique is limiting the benefit of the inhaler."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 399.4,
      "end_seconds": 404.65,
      "duration_seconds": 5.25,
      "text": "Oh dear. I've been doing it wrong for years. ~"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 405.91,
      "end_seconds": 424.15,
      "duration_seconds": 18.24,
      "text": "It's very common, you're not alone. I'd like to start tiotropium, 18 micrograms, once a day, from a different type of inhaler, and a budesonide inhaler, 200 micrograms, twice a day."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 426.54,
      "end_seconds": 430.58,
      "duration_seconds": 4.04,
      "text": "Will he need a spacer? ~"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 431.42,
      "end_seconds": 439.61,
      "duration_seconds": 8.19,
      "text": "I'll show you both devices and a spacer, Mrs Doyle. They make it much easier. ~"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 442.57,
      "end_seconds": 453.15,
      "duration_seconds": 10.58,
      "text": "Thank you, Priya. I'd also like to arrange spirometry, to measure your breathing properly, and a chest X-ray."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 454.1,
      "end_seconds": 455.61,
      "duration_seconds": 1.51,
      "text": "When? ~"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 458.08,
      "end_seconds": 468.22,
      "duration_seconds": 10.14,
      "text": "This month. And I'd like to see you again in four weeks to see how the new inhalers are doing."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 469.48,
      "end_seconds": 474.81,
      "duration_seconds": 5.33,
      "text": "Four weeks. We'll write it on the calendar. ~"
    }
  ]
}
