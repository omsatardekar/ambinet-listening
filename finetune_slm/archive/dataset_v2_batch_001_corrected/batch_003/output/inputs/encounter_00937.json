{
  "schema_version": "1.0",
  "encounter_id": "00937",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 1.27,
      "end_seconds": 9.65,
      "duration_seconds": 8.38,
      "text": "Good morning, Mr Deshpande. Terrible weather, and I hear the car park is full again. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.21,
      "end_seconds": 20.05,
      "duration_seconds": 7.84,
      "text": "Good morning, doctor. Yes, I circled three times. Thankfully the weather doesn't affect itching. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.96,
      "end_seconds": 29.55,
      "duration_seconds": 6.59,
      "text": "Itching, that's what we're here about. Tell me everything. ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.08,
      "end_seconds": 45.11,
      "duration_seconds": 14.03,
      "text": "I have prepared a timeline. The itching is worse at night, and it began late last month, or perhaps early this month. I cannot be exact."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.49,
      "end_seconds": 51.77,
      "duration_seconds": 4.28,
      "text": "That's fine. Where do you itch?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.34,
      "end_seconds": 62.11,
      "duration_seconds": 7.77,
      "text": "Mainly between the fingers, and on my wrists. There's a rash, small red bumps in lines."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.95,
      "end_seconds": 65.12,
      "duration_seconds": 2.17,
      "text": "Any scratch marks?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.91,
      "end_seconds": 74.16,
      "duration_seconds": 7.25,
      "text": "Yes, many. My wife says I look like I fought a cat."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.63,
      "end_seconds": 80.64,
      "duration_seconds": 5.01,
      "text": "And in the family? Is anyone else itching? ~"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.17,
      "end_seconds": 89.1,
      "duration_seconds": 5.93,
      "text": "My wife and my daughter, yes. Since last week. ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.86,
      "end_seconds": 91.56,
      "duration_seconds": 1.7,
      "text": "Any fever?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.1,
      "end_seconds": 95.64,
      "duration_seconds": 1.54,
      "text": "No fever."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.48,
      "end_seconds": 99.74,
      "duration_seconds": 2.26,
      "text": "Any swollen glands?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.39,
      "end_seconds": 103.47,
      "duration_seconds": 2.08,
      "text": "No swollen glands."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.3,
      "end_seconds": 109.96,
      "duration_seconds": 4.66,
      "text": "Any pus, anything oozing from the spots?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.05,
      "end_seconds": 112.75,
      "duration_seconds": 1.7,
      "text": "No pus."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.39,
      "end_seconds": 117.12,
      "duration_seconds": 2.73,
      "text": "Rash on the face?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.85,
      "end_seconds": 123.02,
      "duration_seconds": 3.17,
      "text": "No, not on the face."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.59,
      "end_seconds": 130.11,
      "duration_seconds": 5.52,
      "text": "Have you started any new soaps or washing powder?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.02,
      "end_seconds": 137.62,
      "duration_seconds": 4.6,
      "text": "No new soaps, I checked with my wife."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 138.73,
      "end_seconds": 142.66,
      "duration_seconds": 3.93,
      "text": "Doctor, shall I weigh him? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.52,
      "end_seconds": 149.51,
      "duration_seconds": 5.99,
      "text": "Not yet, nurse, I'll call you. What have you been using?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.41,
      "end_seconds": 167.16,
      "duration_seconds": 14.75,
      "text": "Cetirizine, 10 mg, at night. Calamine lotion, twice a day. And a cream from the pharmacist, a white tube, I cannot recall the name, I'm sorry."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.59,
      "end_seconds": 172.92,
      "duration_seconds": 3.33,
      "text": "We'll find it. Any allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.81,
      "end_seconds": 187.2,
      "duration_seconds": 13.39,
      "text": "Possibly. In hospital I think something gave me a rash, a sticking plaster or maybe a medicine, I am not sure which."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.72,
      "end_seconds": 194.24,
      "duration_seconds": 5.52,
      "text": "I'll note a possible, unconfirmed allergy. Other health problems?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.88,
      "end_seconds": 200.81,
      "duration_seconds": 3.93,
      "text": "Eczema, since childhood, and mild asthma."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.76,
      "end_seconds": 205.05,
      "duration_seconds": 1.29,
      "text": "Operations?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.62,
      "end_seconds": 209.53,
      "duration_seconds": 1.91,
      "text": "Appendicectomy, in 2008."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.29,
      "end_seconds": 215.21,
      "duration_seconds": 2.92,
      "text": "Illnesses in the family?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.02,
      "end_seconds": 223.6,
      "duration_seconds": 6.58,
      "text": "My mother has diabetes. My father has high blood pressure."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.6,
      "end_seconds": 229.46,
      "duration_seconds": 2.86,
      "text": "What do you do?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.35,
      "end_seconds": 232.35,
      "duration_seconds": 2.0,
      "text": "Chartered accountant."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.03,
      "end_seconds": 237.05,
      "duration_seconds": 2.02,
      "text": "And at home?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.39,
      "end_seconds": 247.5,
      "duration_seconds": 9.11,
      "text": "I live with my wife, two children and my mother-in-law. We all share the sofa."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.48,
      "end_seconds": 251.83,
      "duration_seconds": 1.35,
      "text": "Smoking?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.78,
      "end_seconds": 254.99,
      "duration_seconds": 1.21,
      "text": "Never."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.88,
      "end_seconds": 257.12,
      "duration_seconds": 1.24,
      "text": "Alcohol?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.06,
      "end_seconds": 259.51,
      "duration_seconds": 1.45,
      "text": "None."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.28,
      "end_seconds": 288.05,
      "duration_seconds": 11.77,
      "text": "Let me check you. Pulse 74, blood pressure 124 over 80, temperature 36.7, oxygen 99 percent, breathing 14, weight 76 kilos."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.24,
      "end_seconds": 290.86,
      "duration_seconds": 1.62,
      "text": "Normal? ~"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.83,
      "end_seconds": 306.37,
      "duration_seconds": 3.54,
      "text": "All normal. Let me see your hands."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.79,
      "end_seconds": 309.38,
      "duration_seconds": 1.59,
      "text": "Here. ~"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.33,
      "end_seconds": 322.27,
      "duration_seconds": 9.94,
      "text": "There are small red bumps and thin, wavy lines between your fingers and across your wrists, with scratch marks."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.48,
      "end_seconds": 327.83,
      "duration_seconds": 3.35,
      "text": "Those are the burrows? ~"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.42,
      "end_seconds": 337.52,
      "duration_seconds": 7.1,
      "text": "Possibly. And the skin on your waist has scratch marks too, but no infection."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.08,
      "end_seconds": 342.0,
      "duration_seconds": 1.92,
      "text": "Good. ~"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.67,
      "end_seconds": 347.79,
      "duration_seconds": 3.12,
      "text": "Any trouble with your breathing today?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.59,
      "end_seconds": 352.42,
      "duration_seconds": 3.83,
      "text": "No, nothing, my chest is fine."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.83,
      "end_seconds": 367.37,
      "duration_seconds": 13.54,
      "text": "This could be scabies, given the night itching and the whole household itching, but I can't rule out a flare of your eczema."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 369.41,
      "end_seconds": 372.39,
      "duration_seconds": 2.98,
      "text": "Scabies. Oh dear. ~"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.65,
      "end_seconds": 385.63,
      "duration_seconds": 11.98,
      "text": "It's very common, nothing to do with cleanliness. I'd like to arrange a skin scraping, and I'd like to look at the lines with a dermatoscope."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 386.64,
      "end_seconds": 391.48,
      "duration_seconds": 4.84,
      "text": "I can get the scraping kit now. ~"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 394.07,
      "end_seconds": 401.27,
      "duration_seconds": 7.2,
      "text": "Please. And I'd like to do blood tests to check for a skin infection."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 402.39,
      "end_seconds": 406.94,
      "duration_seconds": 4.55,
      "text": "Will the others need checking too? ~"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 408.05,
      "end_seconds": 412.46,
      "duration_seconds": 4.41,
      "text": "Yes, the whole household, once we know. ~"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 413.72,
      "end_seconds": 416.59,
      "duration_seconds": 2.87,
      "text": "I'll tell them. ~"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 418.04,
      "end_seconds": 425.64,
      "duration_seconds": 7.6,
      "text": "If the itching continues two weeks after treatment, come back and see me."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 426.87,
      "end_seconds": 430.26,
      "duration_seconds": 3.39,
      "text": "I will. Thank you, doctor. ~"
    }
  ]
}
