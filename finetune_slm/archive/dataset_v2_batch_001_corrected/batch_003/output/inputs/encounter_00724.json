{
  "schema_version": "1.0",
  "encounter_id": "00724",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 0.76,
      "end_seconds": 10.68,
      "duration_seconds": 9.92,
      "text": "Good morning. I'm Pauline, Mia's foster carer. We're here for her twelve-month jabs, and I've got her red book."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 12.13,
      "end_seconds": 22.01,
      "duration_seconds": 9.88,
      "text": "Lovely, I'm Nurse Priya, and I'll give the jabs after the doctor's had a look. Hello, Mia! ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.97,
      "end_seconds": 33.21,
      "duration_seconds": 10.24,
      "text": "Good morning. Let me just ask a few questions before we vaccinate. How's Mia been this week? ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 34.73,
      "end_seconds": 42.26,
      "duration_seconds": 7.53,
      "text": "She's had a snuffly nose since Monday, but she's feeding well and playing."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.29,
      "end_seconds": 47.05,
      "duration_seconds": 2.76,
      "text": "Any fever or temperature?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 48.62,
      "end_seconds": 53.39,
      "duration_seconds": 4.77,
      "text": "No, I've checked every morning. Never above normal."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.45,
      "end_seconds": 57.24,
      "duration_seconds": 2.79,
      "text": "Any vomiting or diarrhoea?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 58.52,
      "end_seconds": 61.24,
      "duration_seconds": 2.72,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.44,
      "end_seconds": 68.08,
      "duration_seconds": 4.64,
      "text": "Does Mia have any allergies, including to foods?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 70.23,
      "end_seconds": 84.56,
      "duration_seconds": 14.33,
      "text": "Egg. She came out in hives and was sick after a bit of scrambled egg at her last foster home, so they told me to be careful."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.36,
      "end_seconds": 94.63,
      "duration_seconds": 8.27,
      "text": "Thank you, that's important, and it's fine for the jabs we're giving, we'll check. Any other history?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 96.65,
      "end_seconds": 102.83,
      "duration_seconds": 6.18,
      "text": "Eczema, on her cheeks and the backs of her knees. It's mild."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 105.55,
      "end_seconds": 116.29,
      "duration_seconds": 10.74,
      "text": "Doctor, I've got the vaccine record, Mia's had her eight-week and sixteen-week ones, all on time. ~"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.95,
      "end_seconds": 126.38,
      "duration_seconds": 8.43,
      "text": "Excellent. Let me listen to her chest, and look in her ears, given the cold. ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 146.14,
      "end_seconds": 148.76,
      "duration_seconds": 2.62,
      "text": "She's fine with that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.54,
      "end_seconds": 167.61,
      "duration_seconds": 18.07,
      "text": "Her chest is clear, and ears are both normal. The nose is just a bit runny. I can't rule out a brewing ear infection on that left side, but there's no sign yet."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 170.19,
      "end_seconds": 174.26,
      "duration_seconds": 4.07,
      "text": "Does that mean we can't vaccinate? ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.15,
      "end_seconds": 190.72,
      "duration_seconds": 13.57,
      "text": "No, a mild cold without a fever is fine. Egg allergy is also not a problem for these vaccines. I'm happy to go ahead. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 193.57,
      "end_seconds": 195.63,
      "duration_seconds": 2.06,
      "text": "Oh good. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.66,
      "end_seconds": 204.7,
      "duration_seconds": 8.04,
      "text": "Today, Mia's having the MMR, the Hib/MenC, the pneumococcal booster, and the meningitis B booster. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 205.61,
      "end_seconds": 209.29,
      "duration_seconds": 3.68,
      "text": "That's a lot of needles. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.77,
      "end_seconds": 225.52,
      "duration_seconds": 13.75,
      "text": "Four, but quick, and Priya's very good. I'd like to arrange for you to wait fifteen minutes in the waiting room afterwards, so we can check she's well."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 227.92,
      "end_seconds": 229.82,
      "duration_seconds": 1.9,
      "text": "Of course. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 251.18,
      "end_seconds": 256.04,
      "duration_seconds": 4.86,
      "text": "Mia, look at the bubbles, can you see them?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.06,
      "end_seconds": 259.92,
      "duration_seconds": 2.86,
      "text": "Ooh! Ba ba ba. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.58,
      "end_seconds": 262.97,
      "duration_seconds": 1.39,
      "text": "Waaaah! ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 264.6,
      "end_seconds": 269.01,
      "duration_seconds": 4.41,
      "text": "All done, doctor. She was brilliant. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.94,
      "end_seconds": 282.19,
      "duration_seconds": 12.25,
      "text": "Well done, Mia. Pauline, she may be grumpy and a bit warm for a day or two, and she may have a sore leg."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 284.98,
      "end_seconds": 289.47,
      "duration_seconds": 4.49,
      "text": "Can I give her something for it? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.55,
      "end_seconds": 300.9,
      "duration_seconds": 9.35,
      "text": "If she's very upset or hot, you can use infant paracetamol according to the label. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 303.22,
      "end_seconds": 305.02,
      "duration_seconds": 1.8,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.37,
      "end_seconds": 320.98,
      "duration_seconds": 13.61,
      "text": "If she gets a high temperature, a rash that doesn't fade, or a swollen face, or if she's floppy or won't feed, call 999 or come back straight away."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 323.22,
      "end_seconds": 325.46,
      "duration_seconds": 2.24,
      "text": "I will. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.82,
      "end_seconds": 339.3,
      "duration_seconds": 12.48,
      "text": "Her next appointment is at three years, and the practice will send it. I'd like to see her again before then if the ear gets worse."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 341.08,
      "end_seconds": 345.44,
      "duration_seconds": 4.36,
      "text": "Thank you, doctor. Thank you, nurse. ~"
    }
  ]
}
