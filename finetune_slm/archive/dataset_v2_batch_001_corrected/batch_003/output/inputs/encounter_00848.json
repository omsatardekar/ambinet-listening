{
  "schema_version": "1.0",
  "encounter_id": "00848",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.22,
      "end_seconds": 17.2,
      "duration_seconds": 15.98,
      "text": "I need you to take this seriously. I've been up all night reading about it, a lump in the neck, then headaches, then a tight chest, and every time I search the result is cancer."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.19,
      "end_seconds": 29.45,
      "duration_seconds": 11.26,
      "text": "I do take it seriously. Let me repeat that back. Worry about cancer, headaches, and chest tightness. When did the worry start, Daniel?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.58,
      "end_seconds": 36.85,
      "duration_seconds": 5.27,
      "text": "Two months... no, three months. After my colleague's diagnosis."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.58,
      "end_seconds": 43.34,
      "duration_seconds": 3.76,
      "text": "And what's the headache like?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.1,
      "end_seconds": 52.22,
      "duration_seconds": 7.12,
      "text": "Band-like, across the forehead, mostly after I've been on the laptop."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.3,
      "end_seconds": 56.18,
      "duration_seconds": 2.88,
      "text": "And the tight chest?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.93,
      "end_seconds": 68.48,
      "duration_seconds": 10.55,
      "text": "It's, um, it comes when I'm thinking about it. I check my pulse about twenty times a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 69.18,
      "end_seconds": 77.76,
      "duration_seconds": 8.58,
      "text": "He checks it at dinner. It drives me mad, sorry, Daniel. I'm his husband, Marcus. ~"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.59,
      "end_seconds": 84.51,
      "duration_seconds": 4.92,
      "text": "That's all right, Marcus. Daniel, any weight loss?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.75,
      "end_seconds": 90.99,
      "duration_seconds": 5.24,
      "text": "No. I weigh myself every morning, it's the same."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.24,
      "end_seconds": 96.85,
      "duration_seconds": 4.61,
      "text": "And any lump you can actually feel?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.66,
      "end_seconds": 103.53,
      "duration_seconds": 4.87,
      "text": "Well. No lump. I thought there was one. There isn't."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.88,
      "end_seconds": 107.55,
      "duration_seconds": 2.67,
      "text": "Tell me your medication."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.39,
      "end_seconds": 121.05,
      "duration_seconds": 10.66,
      "text": "Sertraline, 50 mg, once a day. Propranolol, 10 mg, twice a day when I'm bad. And omeprazole, 20 mg, once a day."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 121.87,
      "end_seconds": 127.01,
      "duration_seconds": 5.14,
      "text": "It's 100, love. The sertraline. I see the box."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.23,
      "end_seconds": 132.97,
      "duration_seconds": 4.74,
      "text": "It's 50. Is it? I don't know any more."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.89,
      "end_seconds": 141.5,
      "duration_seconds": 5.61,
      "text": "We'll check the pharmacy record for the sertraline. Any allergies?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.82,
      "end_seconds": 145.63,
      "duration_seconds": 1.81,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.5,
      "end_seconds": 147.78,
      "duration_seconds": 1.28,
      "text": "History?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.97,
      "end_seconds": 152.67,
      "duration_seconds": 3.7,
      "text": "Anxiety, since uni. And irritable bowel."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.92,
      "end_seconds": 156.16,
      "duration_seconds": 1.24,
      "text": "Operations?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.9,
      "end_seconds": 164.19,
      "duration_seconds": 7.29,
      "text": "Tonsils, when I was nine. And a mole removed, 2018. It was nothing."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.58,
      "end_seconds": 169.23,
      "duration_seconds": 2.65,
      "text": "Cancer in the family?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.55,
      "end_seconds": 176.22,
      "duration_seconds": 4.67,
      "text": "My mother had breast cancer. That's partly why."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.56,
      "end_seconds": 179.55,
      "duration_seconds": 1.99,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.2,
      "end_seconds": 187.42,
      "duration_seconds": 5.22,
      "text": "IT contractor, so I'm online all day anyway."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.86,
      "end_seconds": 190.76,
      "duration_seconds": 0.9,
      "text": "Alcohol?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.22,
      "end_seconds": 197.89,
      "duration_seconds": 4.67,
      "text": "A few glasses of wine at the weekend."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.15,
      "end_seconds": 200.54,
      "duration_seconds": 1.39,
      "text": "Exercise?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.28,
      "end_seconds": 205.33,
      "duration_seconds": 4.05,
      "text": "I run. When I'm not checking things."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.3,
      "end_seconds": 232.98,
      "duration_seconds": 11.68,
      "text": "Let's check you. Pulse 84, blood pressure 122 over 78, temperature 36.6, oxygen 99 percent, breathing 16, weight 77 kilos."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.59,
      "end_seconds": 238.94,
      "duration_seconds": 3.35,
      "text": "The pulse is fast. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.27,
      "end_seconds": 254.6,
      "duration_seconds": 6.33,
      "text": "It's normal for a worried afternoon. Let me feel your neck."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.04,
      "end_seconds": 259.45,
      "duration_seconds": 3.41,
      "text": "There's nothing, is there? ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.9,
      "end_seconds": 266.11,
      "duration_seconds": 5.21,
      "text": "I can't feel any lumps in your neck or armpits."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 268.42,
      "end_seconds": 273.18,
      "duration_seconds": 4.76,
      "text": "Doctor, shall I get the ECG machine ready? ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.38,
      "end_seconds": 282.38,
      "duration_seconds": 8.0,
      "text": "Please, Priya. Daniel, your heart sounds are normal, and the chest is clear."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.03,
      "end_seconds": 285.76,
      "duration_seconds": 1.73,
      "text": "Good. ~"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.81,
      "end_seconds": 293.39,
      "duration_seconds": 5.58,
      "text": "And your tummy is soft with no tender spots."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.73,
      "end_seconds": 296.63,
      "duration_seconds": 1.9,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.8,
      "end_seconds": 303.32,
      "duration_seconds": 4.52,
      "text": "Any problems with your breathing at the moment?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.29,
      "end_seconds": 307.48,
      "duration_seconds": 3.19,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.15,
      "end_seconds": 314.52,
      "duration_seconds": 4.37,
      "text": "Any trouble with your vision, balance, weakness?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.84,
      "end_seconds": 319.21,
      "duration_seconds": 2.37,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.61,
      "end_seconds": 337.57,
      "duration_seconds": 15.96,
      "text": "So what I'm hearing is an anxious mind that's very good at searching. This looks like health anxiety, but I can't rule out a thyroid problem driving the heart racing."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.54,
      "end_seconds": 341.3,
      "duration_seconds": 2.76,
      "text": "So it's not cancer? ~"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.28,
      "end_seconds": 356.43,
      "duration_seconds": 12.15,
      "text": "Nothing I've found suggests it. To be sure, I'd like to arrange a thyroid blood test, a blood count, and an ECG today."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 357.68,
      "end_seconds": 361.86,
      "duration_seconds": 4.18,
      "text": "I'll do the ECG in room two. ~"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.36,
      "end_seconds": 369.56,
      "duration_seconds": 5.2,
      "text": "And limit the searching to one short check a day."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 370.62,
      "end_seconds": 374.42,
      "duration_seconds": 3.8,
      "text": "I'll hold him to that. ~"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 376.67,
      "end_seconds": 381.73,
      "duration_seconds": 5.06,
      "text": "I'd like to see you again in four weeks."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 383.27,
      "end_seconds": 386.75,
      "duration_seconds": 3.48,
      "text": "Four weeks. Okay. Thank you. ~"
    }
  ]
}
