{
  "schema_version": "1.0",
  "encounter_id": "00573",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.62,
      "end_seconds": 12.69,
      "duration_seconds": 12.07,
      "text": "Doctor, I'm so sorry I'm late. The bus never showed, and then I couldn't find a space for the car. Mortified, so I am."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.75,
      "end_seconds": 23.05,
      "duration_seconds": 9.3,
      "text": "Not at all, you're here now. Take a seat, Mr Fitzmaurice. Your booking says it's a routine check."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.45,
      "end_seconds": 33.24,
      "duration_seconds": 8.79,
      "text": "That's it, a routine check. Sure, the wife says I'm due an MOT, like the car."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.65,
      "end_seconds": 44.9,
      "duration_seconds": 10.25,
      "text": "Good comparison, I'll be stealing that. A yearly service, nothing more. Anything on your mind before we start?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.84,
      "end_seconds": 52.96,
      "duration_seconds": 7.12,
      "text": "Not a thing. I'm grand altogether. I just do what herself tells me."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.05,
      "end_seconds": 63.68,
      "duration_seconds": 9.63,
      "text": "A wise policy. Let's go through the basics. What tablets are you on at the moment?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.29,
      "end_seconds": 74.3,
      "duration_seconds": 8.01,
      "text": "Ramipril, 5 milligrams, one every morning. And a small aspirin, 75 milligrams, with my breakfast."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.21,
      "end_seconds": 81.48,
      "duration_seconds": 4.27,
      "text": "Any other tablets, vitamins, anything from the chemist?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.5,
      "end_seconds": 91.49,
      "duration_seconds": 7.99,
      "text": "That's the lot. I take the two with my tea and a bit of toast."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.19,
      "end_seconds": 99.48,
      "duration_seconds": 5.29,
      "text": "Grand. Any allergies to medicines, or to anything else?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.81,
      "end_seconds": 103.75,
      "duration_seconds": 1.94,
      "text": "None at all."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.66,
      "end_seconds": 111.7,
      "duration_seconds": 5.04,
      "text": "Good. Have you had any operations in the past?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.35,
      "end_seconds": 120.93,
      "duration_seconds": 7.58,
      "text": "One. They trimmed the cartilage in my left knee, a keyhole job, in 2014."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.71,
      "end_seconds": 132.35,
      "duration_seconds": 8.64,
      "text": "Right. And how's your general health, day to day? Energy, appetite, that sort of thing?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.81,
      "end_seconds": 141.8,
      "duration_seconds": 6.99,
      "text": "Sound as a pound. I've more energy than himself next door, and he's forty."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.51,
      "end_seconds": 150.46,
      "duration_seconds": 6.95,
      "text": "Good man. Do you get any chest pain, say when you're out walking?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.28,
      "end_seconds": 164.46,
      "duration_seconds": 12.18,
      "text": "No, never. I walk the dog up the hill every morning, forty minutes, and I come back in great form."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.16,
      "end_seconds": 169.42,
      "duration_seconds": 4.26,
      "text": "Any dizzy spells, or feeling faint?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.98,
      "end_seconds": 173.56,
      "duration_seconds": 2.58,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.7,
      "end_seconds": 184.75,
      "duration_seconds": 9.05,
      "text": "Lovely. Now a couple of questions about how things are working inside. How are your digestion and bowels?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.82,
      "end_seconds": 191.4,
      "duration_seconds": 4.58,
      "text": "Fine, regular as the clock on the church."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.19,
      "end_seconds": 198.1,
      "duration_seconds": 4.91,
      "text": "And the waterworks, passing urine all right?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.55,
      "end_seconds": 204.96,
      "duration_seconds": 4.41,
      "text": "Fine, fine. Nothing to report there at all."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.69,
      "end_seconds": 209.61,
      "duration_seconds": 3.92,
      "text": "Good. Do you drink much alcohol?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.52,
      "end_seconds": 220.91,
      "duration_seconds": 9.39,
      "text": "A couple of pints of Guinness on a Saturday night, down in the club. Two and home."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.47,
      "end_seconds": 229.76,
      "duration_seconds": 7.29,
      "text": "Sensible. Right, I'll take your pressure and pulse, and check your weight."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.93,
      "end_seconds": 235.23,
      "duration_seconds": 3.3,
      "text": "Do I take off the boots?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.71,
      "end_seconds": 241.36,
      "duration_seconds": 3.65,
      "text": "Boots off for the scales, yes."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.2,
      "end_seconds": 266.83,
      "duration_seconds": 6.63,
      "text": "Pressure is 128 over 80, pulse 68, and you weigh 79 kilograms."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.8,
      "end_seconds": 272.18,
      "duration_seconds": 2.38,
      "text": "Is that good, doctor?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.05,
      "end_seconds": 287.54,
      "duration_seconds": 14.49,
      "text": "That's a healthy set of numbers. Think of blood pressure like water pressure in a pipe. You want it firm but not hammering, and yours is firm."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.04,
      "end_seconds": 293.42,
      "duration_seconds": 3.38,
      "text": "I'll tell herself. She'll be delighted."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.59,
      "end_seconds": 311.04,
      "duration_seconds": 16.45,
      "text": "Now, since it's your yearly service, I'd like to check a few things I can't see from here. I'll order blood tests, for your cholesterol and your sugar."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.75,
      "end_seconds": 319.39,
      "duration_seconds": 5.64,
      "text": "Right so. Do I have to fast for it?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.43,
      "end_seconds": 335.95,
      "duration_seconds": 15.52,
      "text": "Not for these. And I'd like to book an ECG too, a tracing of your heart, while you're here. The nurse can do it today."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.08,
      "end_seconds": 340.68,
      "duration_seconds": 2.6,
      "text": "Grand. Will it take long?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.97,
      "end_seconds": 356.54,
      "duration_seconds": 14.57,
      "text": "Ten minutes, a few stickers on your chest, nothing to it. Then I'd like to see you in two weeks, when the results are in."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.48,
      "end_seconds": 363.53,
      "duration_seconds": 5.05,
      "text": "Two weeks, so. I'll put it up on the fridge."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.85,
      "end_seconds": 373.56,
      "duration_seconds": 8.71,
      "text": "And keep up the walking. The dog is doing you good, and you're doing the dog good."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 375.05,
      "end_seconds": 382.37,
      "duration_seconds": 7.32,
      "text": "Ha, she'd agree with you. Thanks very much, doctor, and sorry again for being late."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 385.29,
      "end_seconds": 391.85,
      "duration_seconds": 6.56,
      "text": "Not at all, you're right on time for your MOT. Mind yourself."
    }
  ]
}
