{
  "schema_version": "1.0",
  "encounter_id": "00660",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 0.85,
      "end_seconds": 7.59,
      "duration_seconds": 6.74,
      "text": "Doctor, Mr Kowalski, forty-one, vomiting since last night, can't keep anything down, even water."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.5,
      "end_seconds": 16.29,
      "duration_seconds": 7.79,
      "text": "Thank you. Mr Kowalski, I'm Dr Hughes. How many times have you been sick?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.18,
      "end_seconds": 29.54,
      "duration_seconds": 12.36,
      "text": "I've lost count. Ten, twelve? All night, and this morning, even when it's just water. I want a drip, honestly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.43,
      "end_seconds": 34.69,
      "duration_seconds": 4.26,
      "text": "I'll get to that. When did it start?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.52,
      "end_seconds": 42.82,
      "duration_seconds": 7.3,
      "text": "About eight last night, after dinner. A kebab. I'm blaming the kebab."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 45.01,
      "end_seconds": 50.15,
      "duration_seconds": 5.14,
      "text": "His wife rang ahead, she said he looked grey. ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.82,
      "end_seconds": 54.98,
      "duration_seconds": 3.16,
      "text": "Any pain in your tummy?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.62,
      "end_seconds": 64.26,
      "duration_seconds": 7.64,
      "text": "Yeah, cramps. Across the middle, they come and go, and they're bad."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.23,
      "end_seconds": 68.2,
      "duration_seconds": 2.97,
      "text": "Dizzy when you stand?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.13,
      "end_seconds": 77.85,
      "duration_seconds": 6.72,
      "text": "Yeah, a bit. I nearly fell getting out of the car."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.08,
      "end_seconds": 85.88,
      "duration_seconds": 6.8,
      "text": "Any blood in what you've brought up, or black, coffee-ground stuff?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.76,
      "end_seconds": 92.45,
      "duration_seconds": 4.69,
      "text": "No, just yellow stuff at the end. No blood."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.1,
      "end_seconds": 97.42,
      "duration_seconds": 2.32,
      "text": "Any fever or shivers?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.26,
      "end_seconds": 103.97,
      "duration_seconds": 3.71,
      "text": "Not that I know of. No."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.04,
      "end_seconds": 109.48,
      "duration_seconds": 3.44,
      "text": "What tablets do you take?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.85,
      "end_seconds": 121.72,
      "duration_seconds": 10.87,
      "text": "Metformin, 500 mg, twice a day, and omeprazole, 20 mg once a day. Haven't taken them today, obviously."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.21,
      "end_seconds": 126.85,
      "duration_seconds": 3.64,
      "text": "Sensible not to. Any previous operations?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.35,
      "end_seconds": 130.62,
      "duration_seconds": 2.27,
      "text": "Gallbladder out, in 2015."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 133.19,
      "end_seconds": 137.87,
      "duration_seconds": 4.68,
      "text": "I'll do your observations, Mr Kowalski. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.44,
      "end_seconds": 142.34,
      "duration_seconds": 2.9,
      "text": "Hurry up, please. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 158.73,
      "end_seconds": 168.29,
      "duration_seconds": 9.56,
      "text": "Blood pressure 100 over 62, pulse 112, temperature 37.4, oxygen 97 percent, respiratory rate 20."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.48,
      "end_seconds": 181.14,
      "duration_seconds": 10.66,
      "text": "Thanks, Jenny. Your pressure's on the low side and your pulse is fast, which is the dehydration. Any breathing trouble?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.43,
      "end_seconds": 184.74,
      "duration_seconds": 2.31,
      "text": "No, breathing's fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.53,
      "end_seconds": 189.38,
      "duration_seconds": 3.85,
      "text": "Let me feel your tummy. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.55,
      "end_seconds": 192.92,
      "duration_seconds": 1.37,
      "text": "Ow. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.98,
      "end_seconds": 220.38,
      "duration_seconds": 10.4,
      "text": "Your mouth is very dry, and your tummy is tender in the upper middle but soft, with no guarding."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.7,
      "end_seconds": 225.06,
      "duration_seconds": 2.36,
      "text": "Is it appendicitis? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.1,
      "end_seconds": 243.04,
      "duration_seconds": 15.94,
      "text": "No, that's not where it is. I think this is most likely gastroenteritis from something you ate, but I can't rule out a gallstone problem in the bile duct yet."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.95,
      "end_seconds": 249.84,
      "duration_seconds": 4.89,
      "text": "Right. What are you going to do? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.84,
      "end_seconds": 260.05,
      "duration_seconds": 8.21,
      "text": "First, we'll start intravenous fluids right now, so you stop drying out. Jenny, a cannula please."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 261.94,
      "end_seconds": 263.97,
      "duration_seconds": 2.03,
      "text": "On it. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.28,
      "end_seconds": 275.55,
      "duration_seconds": 10.27,
      "text": "I'd also like to send blood tests, including your kidney function and electrolytes, and a liver profile."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.75,
      "end_seconds": 279.4,
      "duration_seconds": 1.65,
      "text": "Fine. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.6,
      "end_seconds": 289.14,
      "duration_seconds": 8.54,
      "text": "And I'd like to arrange an abdominal ultrasound, given the pain and your history."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.91,
      "end_seconds": 295.29,
      "duration_seconds": 3.38,
      "text": "Will that be today? ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.0,
      "end_seconds": 305.59,
      "duration_seconds": 7.59,
      "text": "If your bloods look suspicious, today. If not, tomorrow. We'll let you know. ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.03,
      "end_seconds": 313.1,
      "duration_seconds": 6.07,
      "text": "Okay. And can I have something for the sickness? ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.38,
      "end_seconds": 321.73,
      "duration_seconds": 6.35,
      "text": "The nurse will bring you something once the line is in. ~"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.98,
      "end_seconds": 325.32,
      "duration_seconds": 2.34,
      "text": "Thank you. ~"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.01,
      "end_seconds": 339.57,
      "duration_seconds": 12.56,
      "text": "When you're home, small sips of fluid, nothing greasy, and I'd like to see you again tomorrow morning to check how you're doing."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.57,
      "end_seconds": 342.52,
      "duration_seconds": 1.95,
      "text": "Tomorrow. Fine. ~"
    }
  ]
}
