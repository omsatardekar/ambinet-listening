{
  "schema_version": "1.0",
  "encounter_id": "00970",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 2.85,
      "end_seconds": 6.28,
      "duration_seconds": 3.43,
      "text": "I want to lose weight."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.96,
      "end_seconds": 14.53,
      "duration_seconds": 4.57,
      "text": "Okay. Tell me what's prompted that. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.35,
      "end_seconds": 22.55,
      "duration_seconds": 5.2,
      "text": "Pants don't fit. Put on about twenty pounds this year."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.05,
      "end_seconds": 32.12,
      "duration_seconds": 6.07,
      "text": "That's a fair amount in a year. What do you think changed?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.15,
      "end_seconds": 37.07,
      "duration_seconds": 1.92,
      "text": "Desk job. New."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.12,
      "end_seconds": 44.16,
      "duration_seconds": 3.04,
      "text": "What did you do before?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.05,
      "end_seconds": 52.93,
      "duration_seconds": 5.88,
      "text": "Warehouse. On my feet. Now I'm at a desk, ten hours."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.0,
      "end_seconds": 62.56,
      "duration_seconds": 5.56,
      "text": "That's quite a change. And how's your eating been? ~"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.51,
      "end_seconds": 69.93,
      "duration_seconds": 3.42,
      "text": "Takeout. Lunch at my desk. ~"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.62,
      "end_seconds": 76.86,
      "duration_seconds": 3.24,
      "text": "What about drinks, soda, juice? ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.36,
      "end_seconds": 84.27,
      "duration_seconds": 3.91,
      "text": "Soda, two cans a day. ~"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.27,
      "end_seconds": 99.44,
      "duration_seconds": 11.17,
      "text": "Okay. Let me ask about how you feel in yourself. Any shortness of breath when you climb stairs?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.18,
      "end_seconds": 103.98,
      "duration_seconds": 1.8,
      "text": "No. Fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.05,
      "end_seconds": 110.25,
      "duration_seconds": 2.2,
      "text": "Any chest pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.98,
      "end_seconds": 116.29,
      "duration_seconds": 2.31,
      "text": "No chest pain."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.16,
      "end_seconds": 123.04,
      "duration_seconds": 2.88,
      "text": "Any other health conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.12,
      "end_seconds": 130.84,
      "duration_seconds": 3.72,
      "text": "High cholesterol. They told me last year."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.65,
      "end_seconds": 144.18,
      "duration_seconds": 9.53,
      "text": "Right. I'm not going to give you a diet sheet. Let's start with two small changes. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.19,
      "end_seconds": 150.83,
      "duration_seconds": 2.64,
      "text": "Like what? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.17,
      "end_seconds": 165.43,
      "duration_seconds": 11.26,
      "text": "First, swap your two cans of soda for water, or sparkling water with lemon. That alone cuts over three hundred calories a day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.1,
      "end_seconds": 171.57,
      "duration_seconds": 3.47,
      "text": "Okay. Hard, but okay. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.58,
      "end_seconds": 181.58,
      "duration_seconds": 6.0,
      "text": "Second, take a ten-minute walk after lunch. Away from the desk."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.29,
      "end_seconds": 188.64,
      "duration_seconds": 3.35,
      "text": "I can do that. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.74,
      "end_seconds": 196.69,
      "duration_seconds": 3.95,
      "text": "Every day, even in the rain. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.76,
      "end_seconds": 202.17,
      "duration_seconds": 1.41,
      "text": "Fine. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.85,
      "end_seconds": 211.42,
      "duration_seconds": 6.57,
      "text": "Third, pack your lunch two days a week instead of buying it."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.64,
      "end_seconds": 217.45,
      "duration_seconds": 2.81,
      "text": "Costs less, too. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.46,
      "end_seconds": 225.35,
      "duration_seconds": 3.89,
      "text": "Exactly. Does that sound doable? ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.0,
      "end_seconds": 229.75,
      "duration_seconds": 1.75,
      "text": "Yeah. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.4,
      "end_seconds": 238.56,
      "duration_seconds": 6.16,
      "text": "Weigh yourself once a week, same day, same time, same scale. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.89,
      "end_seconds": 245.71,
      "duration_seconds": 3.82,
      "text": "I've got a scale. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.79,
      "end_seconds": 255.46,
      "duration_seconds": 6.67,
      "text": "Good. A pound a week is a healthy target. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.37,
      "end_seconds": 260.35,
      "duration_seconds": 1.98,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.52,
      "end_seconds": 269.89,
      "duration_seconds": 5.37,
      "text": "Do you want me to explain anything else? ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.78,
      "end_seconds": 275.39,
      "duration_seconds": 1.61,
      "text": "No. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.23,
      "end_seconds": 289.64,
      "duration_seconds": 10.41,
      "text": "If you haven't lost any weight in two months, come back and we'll talk about what else we can do."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.26,
      "end_seconds": 295.58,
      "duration_seconds": 2.32,
      "text": "Okay. Two months. ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.31,
      "end_seconds": 300.18,
      "duration_seconds": 1.87,
      "text": "Good luck. ~"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.26,
      "end_seconds": 306.0,
      "duration_seconds": 1.74,
      "text": "Thanks. ~"
    }
  ]
}
