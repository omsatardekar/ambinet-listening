{
  "schema_version": "1.0",
  "encounter_id": "00977",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 1.04,
      "end_seconds": 13.74,
      "duration_seconds": 12.7,
      "text": "Dr Mehta, Mrs Iyer's obs are done. Blood pressure 138 over 84, pulse 76, weight 64 kilos. Her companion is with her."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.45,
      "end_seconds": 20.65,
      "duration_seconds": 6.2,
      "text": "Thank you, nurse. Mrs Iyer, welcome. What brings you in today? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.45,
      "end_seconds": 38.45,
      "duration_seconds": 17.0,
      "text": "Good morning, doctor. I am here for my diabetes screening. I read in the newspaper that every person above sixty should be screened, and I did not want to miss it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.7,
      "end_seconds": 46.8,
      "duration_seconds": 6.1,
      "text": "A very sensible reason. This is Shanti, your companion? ~"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "CAREGIVER",
      "start_seconds": 48.24,
      "end_seconds": 54.02,
      "duration_seconds": 5.78,
      "text": "Yes, doctor, I stay with her five days a week. ~"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.23,
      "end_seconds": 61.73,
      "duration_seconds": 5.5,
      "text": "Mrs Iyer, any symptoms that made you think of diabetes?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.7,
      "end_seconds": 71.88,
      "duration_seconds": 8.18,
      "text": "I am thirsty more than before. I carry a bottle with me everywhere now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.03,
      "end_seconds": 74.6,
      "duration_seconds": 1.57,
      "text": "Anything else?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.75,
      "end_seconds": 82.53,
      "duration_seconds": 5.78,
      "text": "I get tired by the afternoon, but I am sixty-eight."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.4,
      "end_seconds": 88.55,
      "duration_seconds": 4.15,
      "text": "Have you lost any weight without trying?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.5,
      "end_seconds": 96.88,
      "duration_seconds": 5.38,
      "text": "No. My weight is the same as last year."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.83,
      "end_seconds": 101.14,
      "duration_seconds": 3.31,
      "text": "What medicines do you take?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.01,
      "end_seconds": 111.62,
      "duration_seconds": 9.61,
      "text": "Amlodipine, 5 mg, in the morning. Atorvastatin, 20 mg, at night. And aspirin, 75 mg, after breakfast."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.47,
      "end_seconds": 117.38,
      "duration_seconds": 2.91,
      "text": "Any allergies to medicines?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.41,
      "end_seconds": 130.86,
      "duration_seconds": 12.45,
      "text": "Perhaps. After an injection at the hospital, I came out in a rash, but I do not know what the injection was."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "CAREGIVER",
      "start_seconds": 133.45,
      "end_seconds": 139.56,
      "duration_seconds": 6.11,
      "text": "She was very itchy that night, I remember she told me."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.03,
      "end_seconds": 146.84,
      "duration_seconds": 4.81,
      "text": "I'll record a possible allergy, unconfirmed. Any medical history?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.83,
      "end_seconds": 152.47,
      "duration_seconds": 3.64,
      "text": "High blood pressure, for many years."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.42,
      "end_seconds": 156.13,
      "duration_seconds": 1.71,
      "text": "Any operations?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.75,
      "end_seconds": 162.9,
      "duration_seconds": 4.15,
      "text": "Cataract surgery in my left eye, in 2020."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.42,
      "end_seconds": 168.41,
      "duration_seconds": 3.99,
      "text": "What did you do before retiring?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.35,
      "end_seconds": 174.69,
      "duration_seconds": 3.34,
      "text": "I was a schoolteacher, thirty-two years."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.12,
      "end_seconds": 179.59,
      "duration_seconds": 3.47,
      "text": "Nurse, did you check her feet? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 180.96,
      "end_seconds": 184.27,
      "duration_seconds": 3.31,
      "text": "Yes, doctor, I looked. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.28,
      "end_seconds": 204.85,
      "duration_seconds": 6.57,
      "text": "Let me see them. Take off your shoes, Mrs Iyer."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.94,
      "end_seconds": 209.11,
      "duration_seconds": 2.17,
      "text": "Of course. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.37,
      "end_seconds": 215.86,
      "duration_seconds": 4.49,
      "text": "There are no sores or cracks on either foot."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.91,
      "end_seconds": 219.41,
      "duration_seconds": 1.5,
      "text": "Good. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.58,
      "end_seconds": 225.7,
      "duration_seconds": 4.12,
      "text": "And the pulses at both ankles are present."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "CAREGIVER",
      "start_seconds": 227.9,
      "end_seconds": 232.64,
      "duration_seconds": 4.74,
      "text": "She looks after her feet very well. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.02,
      "end_seconds": 246.66,
      "duration_seconds": 11.64,
      "text": "Mrs Iyer, nothing in what I find today suggests diabetes. I think you're not showing signs of diabetes at the moment."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.53,
      "end_seconds": 252.34,
      "duration_seconds": 2.81,
      "text": "That is a relief. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.2,
      "end_seconds": 266.77,
      "duration_seconds": 11.57,
      "text": "But a blood test is the only way to be sure, so I'd like to arrange an HbA1c blood test."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.59,
      "end_seconds": 269.53,
      "duration_seconds": 1.94,
      "text": "When? ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.53,
      "end_seconds": 277.34,
      "duration_seconds": 5.81,
      "text": "Today, the nurse will take it before you go. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 278.91,
      "end_seconds": 282.39,
      "duration_seconds": 3.48,
      "text": "I'll do it now. ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.41,
      "end_seconds": 289.53,
      "duration_seconds": 5.12,
      "text": "Keep drinking water, and walk a little every day."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "CAREGIVER",
      "start_seconds": 291.42,
      "end_seconds": 294.96,
      "duration_seconds": 3.54,
      "text": "We walk to the park. ~"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.83,
      "end_seconds": 305.4,
      "duration_seconds": 8.57,
      "text": "I'd like to see you again in a week to go through the result."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.4,
      "end_seconds": 310.56,
      "duration_seconds": 3.16,
      "text": "A week. Thank you, doctor. ~"
    }
  ]
}
