{
  "schema_version": "1.0",
  "encounter_id": "00796",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.46,
      "end_seconds": 17.37,
      "duration_seconds": 16.91,
      "text": "Hello. Um, it's my hip, I think. Or my leg? It hurts when I get up from the chair. I forget which side, hang on, the right. The right hip."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.99,
      "end_seconds": 26.3,
      "duration_seconds": 7.31,
      "text": "Take your time. How long has the right hip been painful?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.21,
      "end_seconds": 37.05,
      "duration_seconds": 9.84,
      "text": "Since the summer. About four months. It's mostly after I've been sitting, and then it eases when I get moving."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.14,
      "end_seconds": 42.05,
      "duration_seconds": 2.91,
      "text": "Where exactly is it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.27,
      "end_seconds": 54.96,
      "duration_seconds": 10.69,
      "text": "In the groin, sort of, and down the front of my thigh. A dull ache, sometimes sharp when I stand."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.78,
      "end_seconds": 61.49,
      "duration_seconds": 3.71,
      "text": "Does it wake you at night? ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.7,
      "end_seconds": 68.16,
      "duration_seconds": 5.46,
      "text": "Not really. Only when I roll onto it. ~"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.96,
      "end_seconds": 77.17,
      "duration_seconds": 6.21,
      "text": "Any back pain, or pins and needles down the leg?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.08,
      "end_seconds": 83.0,
      "duration_seconds": 3.92,
      "text": "No, my back's fine. No tingling."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.31,
      "end_seconds": 89.19,
      "duration_seconds": 3.88,
      "text": "What do you take for it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.22,
      "end_seconds": 106.69,
      "duration_seconds": 15.47,
      "text": "Paracetamol, 1 gram, four times a day, when I remember. Naproxen, 250 mg, twice a day, and a stomach tablet, lansoprazole, 15 mg, once a day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.69,
      "end_seconds": 110.75,
      "duration_seconds": 3.06,
      "text": "Good. Any other conditions?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.21,
      "end_seconds": 118.57,
      "duration_seconds": 6.36,
      "text": "Osteoarthritis, in my knees, high blood pressure, and an underactive thyroid."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.44,
      "end_seconds": 123.16,
      "duration_seconds": 3.72,
      "text": "Does arthritis run in the family?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.78,
      "end_seconds": 129.98,
      "duration_seconds": 5.2,
      "text": "My mother had a hip replaced at seventy."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.46,
      "end_seconds": 134.56,
      "duration_seconds": 3.1,
      "text": "And do you exercise?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.08,
      "end_seconds": 142.49,
      "duration_seconds": 5.41,
      "text": "I walk the dog twice a day, though it's slower lately."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.32,
      "end_seconds": 148.03,
      "duration_seconds": 3.71,
      "text": "Let me check your numbers. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.89,
      "end_seconds": 153.06,
      "duration_seconds": 2.17,
      "text": "Go on. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.92,
      "end_seconds": 176.11,
      "duration_seconds": 8.19,
      "text": "Pulse 70, blood pressure 138 over 82, temperature 36.5, oxygen 98 percent, weight 79 kilos."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.99,
      "end_seconds": 179.46,
      "duration_seconds": 1.47,
      "text": "Okay? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.28,
      "end_seconds": 202.25,
      "duration_seconds": 3.97,
      "text": "Fine. Now I'll move your hip. Lie back."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.7,
      "end_seconds": 205.44,
      "duration_seconds": 1.74,
      "text": "Ow, there. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.38,
      "end_seconds": 216.3,
      "duration_seconds": 9.92,
      "text": "The right hip is stiff and painful on turning it inwards, and a bit restricted compared with the left."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.13,
      "end_seconds": 221.86,
      "duration_seconds": 2.73,
      "text": "Is it the arthritis? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.57,
      "end_seconds": 233.48,
      "duration_seconds": 10.91,
      "text": "With the groin pain, the stiffness after sitting, and the limited inward rotation, this fits with osteoarthritis of the hip, I'd say."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.97,
      "end_seconds": 240.12,
      "duration_seconds": 4.15,
      "text": "Will I need a replacement? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.37,
      "end_seconds": 254.69,
      "duration_seconds": 13.32,
      "text": "Not necessarily, it depends how it progresses. First, I'd like an X-ray of your right hip, and of your pelvis, to see how much the joint has changed."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.98,
      "end_seconds": 258.74,
      "duration_seconds": 1.76,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.31,
      "end_seconds": 268.4,
      "duration_seconds": 8.09,
      "text": "And I'd like to arrange a physiotherapy assessment, because strengthening exercises help a lot."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.43,
      "end_seconds": 275.13,
      "duration_seconds": 4.7,
      "text": "Do I keep taking the tablets? ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.59,
      "end_seconds": 285.15,
      "duration_seconds": 8.56,
      "text": "Yes, but I'd suggest the paracetamol regularly, with the naproxen only when it's bad, and with food."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.63,
      "end_seconds": 289.52,
      "duration_seconds": 2.89,
      "text": "I'll try, I forget. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.06,
      "end_seconds": 302.58,
      "duration_seconds": 11.52,
      "text": "Put the paracetamol next to your toothbrush. And a walking stick in your left hand will take some load off the right hip."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.17,
      "end_seconds": 306.49,
      "duration_seconds": 2.32,
      "text": "A stick. Hm. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.9,
      "end_seconds": 318.16,
      "duration_seconds": 9.26,
      "text": "It helps more than you'd expect. I'd like to see you in six weeks, with the X-ray results."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.13,
      "end_seconds": 325.24,
      "duration_seconds": 4.11,
      "text": "Six weeks. Thank you, doctor. ~"
    }
  ]
}
