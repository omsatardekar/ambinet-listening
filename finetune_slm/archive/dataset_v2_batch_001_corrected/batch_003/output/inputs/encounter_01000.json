{
  "schema_version": "1.0",
  "encounter_id": "01000",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 1.95,
      "end_seconds": 13.8,
      "duration_seconds": 11.85,
      "text": "Oh, hi, doctor, thank you, we came straight from the park. My husband got bitten by a dog on the leg, I'm Lucy."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 16.5,
      "end_seconds": 23.53,
      "duration_seconds": 7.03,
      "text": "I'm Tom, I'm Mr Rivera's support worker, I was walking with him. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.96,
      "end_seconds": 29.58,
      "duration_seconds": 3.62,
      "text": "Hello, all. Mr Rivera, which leg? ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.56,
      "end_seconds": 43.53,
      "duration_seconds": 10.97,
      "text": "The left. The calf. Um, what happened, was a dog, a little terrier, ran across, and, I don't know, bit me. ~"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.21,
      "end_seconds": 48.93,
      "duration_seconds": 1.72,
      "text": "When? ~"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.51,
      "end_seconds": 55.84,
      "duration_seconds": 3.33,
      "text": "About an hour ago. ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 59.11,
      "end_seconds": 65.03,
      "duration_seconds": 5.92,
      "text": "Forty minutes, doctor, I looked at my watch. ~"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.95,
      "end_seconds": 71.37,
      "duration_seconds": 3.42,
      "text": "Whose dog was it? ~"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 73.8,
      "end_seconds": 82.34,
      "duration_seconds": 8.54,
      "text": "A stranger's. He gave us his number, and the dog's vaccinated, he said. ~"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.15,
      "end_seconds": 91.73,
      "duration_seconds": 5.58,
      "text": "Did the dog stay with its owner afterwards? ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 95.06,
      "end_seconds": 103.41,
      "duration_seconds": 8.35,
      "text": "Yes, he was very apologetic and stayed with us until we left. ~"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.23,
      "end_seconds": 114.61,
      "duration_seconds": 8.38,
      "text": "Good, that helps if we ever need to check anything. Any numbness or tingling in the foot?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.23,
      "end_seconds": 120.0,
      "duration_seconds": 1.77,
      "text": "No numbness."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.95,
      "end_seconds": 138.08,
      "duration_seconds": 5.13,
      "text": "Let me check two things. Temperature 36.8, pulse 80."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.91,
      "end_seconds": 143.43,
      "duration_seconds": 2.52,
      "text": "Is that fine? ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.39,
      "end_seconds": 160.85,
      "duration_seconds": 4.46,
      "text": "Fine. Now the leg, let me see."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.69,
      "end_seconds": 174.35,
      "duration_seconds": 10.66,
      "text": "There are two small puncture wounds on the left calf, with a little bruising, and no deep damage."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 176.83,
      "end_seconds": 179.87,
      "duration_seconds": 3.04,
      "text": "Is it bad? ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.69,
      "end_seconds": 191.44,
      "duration_seconds": 7.75,
      "text": "It's superficial. Do you have diabetes in the family, Mr Rivera, or anything that affects healing?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.76,
      "end_seconds": 197.63,
      "duration_seconds": 2.87,
      "text": "My father had diabetes."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.52,
      "end_seconds": 223.62,
      "duration_seconds": 5.1,
      "text": "Noted. I'll wash the wounds thoroughly now, with saline."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 225.93,
      "end_seconds": 229.28,
      "duration_seconds": 3.35,
      "text": "I'll hold the dressings. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.89,
      "end_seconds": 241.72,
      "duration_seconds": 8.83,
      "text": "Thank you, Tom. Keep the leg raised for a few hours, and keep the dressing dry for a day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 244.11,
      "end_seconds": 246.38,
      "duration_seconds": 2.27,
      "text": "We will. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.53,
      "end_seconds": 256.78,
      "duration_seconds": 7.25,
      "text": "Check the wounds each day, and wash them gently with soap and water."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.74,
      "end_seconds": 261.31,
      "duration_seconds": 1.57,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.81,
      "end_seconds": 275.28,
      "duration_seconds": 10.47,
      "text": "If you see redness spreading, pus, a fever, or increasing swelling, come back or go to the emergency department."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 279.18,
      "end_seconds": 282.05,
      "duration_seconds": 2.87,
      "text": "We'll watch for it. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.2,
      "end_seconds": 288.61,
      "duration_seconds": 3.41,
      "text": "Good. That's all for now. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 291.68,
      "end_seconds": 298.3,
      "duration_seconds": 6.62,
      "text": "Thank you so much, doctor, we were quite worried. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.52,
      "end_seconds": 305.98,
      "duration_seconds": 4.46,
      "text": "You did the right thing coming straight in. ~"
    }
  ]
}
