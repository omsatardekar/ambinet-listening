{
  "schema_version": "1.0",
  "encounter_id": "00732",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 0.68,
      "end_seconds": 13.04,
      "duration_seconds": 12.36,
      "text": "Doctor, this is Mr Barnes, forty-six. Sudden hearing loss in the left ear since this morning and he's very dizzy. Obs are done."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.3,
      "end_seconds": 27.55,
      "duration_seconds": 12.25,
      "text": "I can't hear a thing out of this ear. And the room's spinning, I've been sick twice, I'm really scared."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.12,
      "end_seconds": 41.42,
      "duration_seconds": 11.3,
      "text": "Mr Barnes, I'm Dr Ellis. I know you're frightened, we're going to look after you. When did it start?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.27,
      "end_seconds": 57.55,
      "duration_seconds": 14.28,
      "text": "I woke up with it. About six this morning. Muffled, like cotton wool, and then it got worse, and now I hear nothing."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.35,
      "end_seconds": 63.86,
      "duration_seconds": 4.51,
      "text": "Any ringing or noise in the ear?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.11,
      "end_seconds": 67.78,
      "duration_seconds": 2.67,
      "text": "A loud hiss. Constant."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.12,
      "end_seconds": 73.46,
      "duration_seconds": 3.34,
      "text": "Has the spinning been constant?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.74,
      "end_seconds": 81.84,
      "duration_seconds": 6.1,
      "text": "It comes and goes, but it's bad when I move my head."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.74,
      "end_seconds": 89.84,
      "duration_seconds": 6.1,
      "text": "Did you bang your head, or have any injury?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.8,
      "end_seconds": 93.58,
      "duration_seconds": 2.78,
      "text": "No. Nothing at all."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.25,
      "end_seconds": 98.94,
      "duration_seconds": 2.69,
      "text": "Any allergies to medicines?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.75,
      "end_seconds": 102.23,
      "duration_seconds": 1.48,
      "text": "None."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.8,
      "end_seconds": 109.77,
      "duration_seconds": 5.97,
      "text": "Have you had any ear problems before, or other conditions?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.07,
      "end_seconds": 117.39,
      "duration_seconds": 5.32,
      "text": "I had grommets as a child, in both ears. And migraines."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.35,
      "end_seconds": 123.53,
      "duration_seconds": 3.18,
      "text": "What work do you do?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.65,
      "end_seconds": 129.92,
      "duration_seconds": 5.27,
      "text": "I'm a piano tuner. My ears are my living."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 146.32,
      "end_seconds": 156.59,
      "duration_seconds": 10.27,
      "text": "Doctor, his observations. Blood pressure 138 over 86, pulse 90, temperature 36.8, oxygen 98 percent, respiratory rate 18."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.99,
      "end_seconds": 188.22,
      "duration_seconds": 9.23,
      "text": "Thanks, Jade. Mr Barnes, I'm going to test your balance and your hearing. Look at my finger."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.88,
      "end_seconds": 196.01,
      "duration_seconds": 5.13,
      "text": "Okay. My eyes are jumping, aren't they? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.12,
      "end_seconds": 210.56,
      "duration_seconds": 12.44,
      "text": "They are, there's a little flick when you look to the left. And I'll test your hearing with a tuning fork."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.02,
      "end_seconds": 233.11,
      "duration_seconds": 5.09,
      "text": "I can't hear it at all on the left."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.78,
      "end_seconds": 247.38,
      "duration_seconds": 12.6,
      "text": "That fits. Your left ear is not hearing the tuning fork, and your eye movements show a flicker to one side, which fits an inner-ear problem."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.58,
      "end_seconds": 251.91,
      "duration_seconds": 2.33,
      "text": "What is it? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.47,
      "end_seconds": 266.19,
      "duration_seconds": 11.72,
      "text": "Sudden hearing loss with vertigo like this, in one ear, looks most like sudden sensorineural hearing loss, which needs urgent treatment, ideally within days."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.22,
      "end_seconds": 271.16,
      "duration_seconds": 3.94,
      "text": "Will I get my hearing back? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.75,
      "end_seconds": 283.04,
      "duration_seconds": 9.29,
      "text": "Many people do, especially if treated quickly, and you've come quickly. That's why I'm acting today. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.62,
      "end_seconds": 286.79,
      "duration_seconds": 2.17,
      "text": "What happens? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.83,
      "end_seconds": 295.37,
      "duration_seconds": 6.54,
      "text": "I'm going to arrange an urgent hearing test, an audiogram, here, this morning."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 297.93,
      "end_seconds": 302.09,
      "duration_seconds": 4.16,
      "text": "I'll call audiology now, doctor. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.04,
      "end_seconds": 311.45,
      "duration_seconds": 8.41,
      "text": "I'd also like to arrange an MRI scan of your ears and brain, to rule out other causes."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.22,
      "end_seconds": 315.46,
      "duration_seconds": 3.24,
      "text": "Is it a tumour? ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.95,
      "end_seconds": 327.81,
      "duration_seconds": 9.86,
      "text": "It's very unlikely, but we check. And I'd like to take blood tests, to look for infection and other causes."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.36,
      "end_seconds": 332.32,
      "duration_seconds": 1.96,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.14,
      "end_seconds": 347.22,
      "duration_seconds": 13.08,
      "text": "The ENT team will see you today and decide on treatment, and I'd like them to review you again in a few days."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.99,
      "end_seconds": 351.72,
      "duration_seconds": 2.73,
      "text": "Thank you, doctor. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.28,
      "end_seconds": 361.21,
      "duration_seconds": 7.93,
      "text": "Jade will stay with you. Lie still, and tell her if you feel sick. ~"
    }
  ]
}
