{
  "schema_version": "1.0",
  "encounter_id": "00898",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.66,
      "end_seconds": 10.26,
      "duration_seconds": 8.6,
      "text": "Ah, hello doctor. It's this cough of mine, it's been going on forever. Six weeks, near enough."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 12.27,
      "end_seconds": 22.98,
      "duration_seconds": 10.71,
      "text": "Six weeks is a long time, you were right to come. Is it a dry cough or are you bringing anything up?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.15,
      "end_seconds": 31.04,
      "duration_seconds": 5.89,
      "text": "Dry, dry as a bone. Nothing comes up at all."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.27,
      "end_seconds": 37.62,
      "duration_seconds": 4.35,
      "text": "Is it worse at any time of day?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.34,
      "end_seconds": 47.33,
      "duration_seconds": 5.99,
      "text": "At night, mostly. It tickles in my throat when I lie down."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.9,
      "end_seconds": 55.7,
      "duration_seconds": 5.8,
      "text": "Have you had any fever, or been coughing up blood?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.73,
      "end_seconds": 61.35,
      "duration_seconds": 3.62,
      "text": "No fever, no blood, thank God."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.02,
      "end_seconds": 69.39,
      "duration_seconds": 5.37,
      "text": "And what tablets are you on at the moment?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.17,
      "end_seconds": 78.84,
      "duration_seconds": 5.67,
      "text": "Ramipril, 5 mg, once a day, for the blood pressure."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.4,
      "end_seconds": 88.9,
      "duration_seconds": 6.5,
      "text": "Thank you. You mentioned blood pressure, is that the only long-term problem?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.78,
      "end_seconds": 96.23,
      "duration_seconds": 4.45,
      "text": "That's the one. Blood pressure, for about eight years."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.62,
      "end_seconds": 102.62,
      "duration_seconds": 3.0,
      "text": "Are you a smoker?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.99,
      "end_seconds": 114.76,
      "duration_seconds": 8.77,
      "text": "I was, and I still have the odd one if I'm out with the girls."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.44,
      "end_seconds": 122.85,
      "duration_seconds": 5.41,
      "text": "Roughly how many would you have in a week?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.5,
      "end_seconds": 128.78,
      "duration_seconds": 3.28,
      "text": "Och, not many. Five, maybe six."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.55,
      "end_seconds": 137.82,
      "duration_seconds": 6.27,
      "text": "I see. And has the cough been interfering with your sleep? ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.12,
      "end_seconds": 147.89,
      "duration_seconds": 7.77,
      "text": "It has, yes. My husband has moved into the spare room. ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.09,
      "end_seconds": 159.9,
      "duration_seconds": 8.81,
      "text": "That sounds miserable for both of you. Let me listen to your chest for a moment. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.37,
      "end_seconds": 177.14,
      "duration_seconds": 1.77,
      "text": "Go on."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.17,
      "end_seconds": 189.07,
      "duration_seconds": 8.9,
      "text": "I'll arrange a chest X-ray, just to be sure there's nothing in the lungs that I can't hear."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.84,
      "end_seconds": 195.7,
      "duration_seconds": 2.86,
      "text": "Will that take long? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.25,
      "end_seconds": 207.05,
      "duration_seconds": 8.8,
      "text": "It's very quick. You can have it done at the hospital this week, no appointment needed. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.11,
      "end_seconds": 216.18,
      "duration_seconds": 6.07,
      "text": "That's grand. And what about the cough itself? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.69,
      "end_seconds": 230.51,
      "duration_seconds": 11.82,
      "text": "There is a possibility that the ramipril is causing it, because dry coughs are a known side effect, but we should check the X-ray first."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.26,
      "end_seconds": 236.89,
      "duration_seconds": 3.63,
      "text": "I never knew that. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.37,
      "end_seconds": 247.51,
      "duration_seconds": 7.14,
      "text": "Many people don't. Please don't stop it by yourself, we'll talk after the X-ray."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.14,
      "end_seconds": 254.43,
      "duration_seconds": 3.29,
      "text": "I won't, I promise. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.94,
      "end_seconds": 267.12,
      "duration_seconds": 9.18,
      "text": "Would you like to talk about cutting down on the smoking at the same time? ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.61,
      "end_seconds": 273.81,
      "duration_seconds": 4.2,
      "text": "Not today, doctor, if you don't mind. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.11,
      "end_seconds": 283.2,
      "duration_seconds": 7.09,
      "text": "That's fine. The offer is there whenever you want it. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.87,
      "end_seconds": 289.09,
      "duration_seconds": 3.22,
      "text": "Thank you. You're very kind. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.56,
      "end_seconds": 299.19,
      "duration_seconds": 7.63,
      "text": "If you start coughing up blood, or get breathless, come back straight away."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.7,
      "end_seconds": 306.01,
      "duration_seconds": 3.31,
      "text": "I will, I will. ~"
    }
  ]
}
