{
  "schema_version": "1.0",
  "encounter_id": "00741",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 1.09,
      "end_seconds": 18.2,
      "duration_seconds": 17.11,
      "text": "Hi, doctor, sorry, we're a bit rushed, I've got the other two in the car with their dad. This is Ollie, he's eight, and he won't eat anything."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.84,
      "end_seconds": 26.43,
      "duration_seconds": 6.59,
      "text": "Hello Ollie. What do you eat, if I ask you? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.41,
      "end_seconds": 33.41,
      "duration_seconds": 4.0,
      "text": "Pasta. Plain. And chicken nuggets. And toast."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.31,
      "end_seconds": 37.56,
      "duration_seconds": 2.25,
      "text": "Anything green? ~"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.36,
      "end_seconds": 42.94,
      "duration_seconds": 2.58,
      "text": "No. Yuck. ~"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.83,
      "end_seconds": 49.28,
      "duration_seconds": 5.45,
      "text": "How long has the pickiness been going on, Mum?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 50.86,
      "end_seconds": 59.25,
      "duration_seconds": 8.39,
      "text": "Six months, since he started Year 4. He used to eat fruit and a bit of veg."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.11,
      "end_seconds": 67.18,
      "duration_seconds": 6.07,
      "text": "Two months. It's not six. I stopped liking things at Easter."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.84,
      "end_seconds": 82.78,
      "duration_seconds": 13.94,
      "text": "So Ollie says two months and Mum says six months. We'll write two to six. Ollie, does your tummy hurt when you eat?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.8,
      "end_seconds": 86.72,
      "duration_seconds": 1.92,
      "text": "No. ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 89.35,
      "end_seconds": 95.91,
      "duration_seconds": 6.56,
      "text": "He's never complained about his tummy. He just says no. ~"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.64,
      "end_seconds": 104.11,
      "duration_seconds": 5.47,
      "text": "Any problems with how he's growing, Mum? Is he energetic? ~"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 106.66,
      "end_seconds": 114.85,
      "duration_seconds": 8.19,
      "text": "He's a bit tired after school, but he plays football like a maniac. ~"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.35,
      "end_seconds": 119.84,
      "duration_seconds": 3.49,
      "text": "Any allergies, to food or medicine?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 121.26,
      "end_seconds": 123.97,
      "duration_seconds": 2.71,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.11,
      "end_seconds": 133.89,
      "duration_seconds": 8.78,
      "text": "Right, let's weigh and measure him. Ollie, stand up straight against the wall. ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.1,
      "end_seconds": 157.13,
      "duration_seconds": 1.03,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.81,
      "end_seconds": 167.04,
      "duration_seconds": 7.23,
      "text": "Weight 21.5 kilos, height 118 centimetres, BMI 15.4. Pulse 86, temperature 36.7."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 169.66,
      "end_seconds": 172.85,
      "duration_seconds": 3.19,
      "text": "Is he underweight? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.76,
      "end_seconds": 187.76,
      "duration_seconds": 14.0,
      "text": "He's at the lower end of normal for his age, but he's on his growth line, and he's grown since the last time he was measured. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 189.14,
      "end_seconds": 192.05,
      "duration_seconds": 2.91,
      "text": "That's a relief. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.48,
      "end_seconds": 197.36,
      "duration_seconds": 3.88,
      "text": "Do the other two eat well? ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 200.12,
      "end_seconds": 206.84,
      "duration_seconds": 6.72,
      "text": "Yes, the younger one eats everything. He's the odd one. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.48,
      "end_seconds": 224.2,
      "duration_seconds": 14.72,
      "text": "Fussy eating is very common in this age group, and as long as he's growing and has energy, I'm not worried. I'd say this is most likely simple picky eating."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 226.4,
      "end_seconds": 229.17,
      "duration_seconds": 2.77,
      "text": "What should I do? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.37,
      "end_seconds": 243.78,
      "duration_seconds": 12.41,
      "text": "Keep offering new foods without pressure, a tiny bit on his plate, and eat together as a family where you can."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 246.5,
      "end_seconds": 250.16,
      "duration_seconds": 3.66,
      "text": "He won't touch it. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.05,
      "end_seconds": 262.97,
      "duration_seconds": 10.92,
      "text": "It can take fifteen or twenty exposures. Don't bribe, don't argue, and don't make a separate meal every time."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.6,
      "end_seconds": 268.61,
      "duration_seconds": 3.01,
      "text": "I like dessert. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.49,
      "end_seconds": 278.19,
      "duration_seconds": 8.7,
      "text": "Dessert's fine, Ollie, as long as you try one bite of the green thing first. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.17,
      "end_seconds": 283.4,
      "duration_seconds": 2.23,
      "text": "One bite. Maybe. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 285.22,
      "end_seconds": 287.91,
      "duration_seconds": 2.69,
      "text": "Should he take vitamins? ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.87,
      "end_seconds": 301.04,
      "duration_seconds": 11.17,
      "text": "A child multivitamin is reasonable, but not essential. I'd like to see him again in six weeks, to check his weight."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 302.88,
      "end_seconds": 305.98,
      "duration_seconds": 3.1,
      "text": "Six weeks. Thank you, doctor. ~"
    }
  ]
}
