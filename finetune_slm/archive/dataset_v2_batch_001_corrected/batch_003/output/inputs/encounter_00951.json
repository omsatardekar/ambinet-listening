{
  "schema_version": "1.0",
  "encounter_id": "00951",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.86,
      "end_seconds": 12.36,
      "duration_seconds": 11.5,
      "text": "Hi, doctor. Thanks for fitting me in. I've got a pain in my left Achilles tendon, and it's been bugging me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.3,
      "end_seconds": 17.96,
      "duration_seconds": 3.66,
      "text": "Tell me about it. Where exactly?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.27,
      "end_seconds": 33.18,
      "duration_seconds": 12.91,
      "text": "About two inches above the heel, at the back. It's sore when I go for a run, especially the first few minutes."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.05,
      "end_seconds": 40.07,
      "duration_seconds": 5.02,
      "text": "Does it ease once you warm up? ~"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.81,
      "end_seconds": 50.16,
      "duration_seconds": 7.35,
      "text": "Yes, it eases, then it comes back after I've stopped and cooled down. ~"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.91,
      "end_seconds": 61.77,
      "duration_seconds": 8.86,
      "text": "How about first thing in the morning, when you get out of bed? ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.66,
      "end_seconds": 71.57,
      "duration_seconds": 6.91,
      "text": "Stiff and sore for the first few steps. Then it's okay. ~"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.15,
      "end_seconds": 80.13,
      "duration_seconds": 5.98,
      "text": "Did you feel a pop or a sudden snap at any point?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.81,
      "end_seconds": 87.85,
      "duration_seconds": 5.04,
      "text": "No pop. Nothing sudden. It built up slowly."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.19,
      "end_seconds": 93.01,
      "duration_seconds": 3.82,
      "text": "How long has it been building up?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.68,
      "end_seconds": 99.13,
      "duration_seconds": 3.45,
      "text": "About six weeks, I'd say."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.66,
      "end_seconds": 121.94,
      "duration_seconds": 11.28,
      "text": "Okay. Let me have a look at it. Take off your shoe and sock, and stand facing the wall."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.85,
      "end_seconds": 124.59,
      "duration_seconds": 1.74,
      "text": "Sure. ~"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.85,
      "end_seconds": 132.09,
      "duration_seconds": 5.24,
      "text": "Now rise up onto your toes, both feet, slowly. ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.89,
      "end_seconds": 139.95,
      "duration_seconds": 6.06,
      "text": "Okay. That's fine. A bit sore on the left. ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.36,
      "end_seconds": 149.22,
      "duration_seconds": 6.86,
      "text": "There's tenderness about two inches above the heel, right over the tendon."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.8,
      "end_seconds": 155.11,
      "duration_seconds": 3.31,
      "text": "Yes, that's the spot. ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.03,
      "end_seconds": 162.59,
      "duration_seconds": 5.56,
      "text": "And the tendon feels thickened there, compared with the right one."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.58,
      "end_seconds": 167.09,
      "duration_seconds": 2.51,
      "text": "Is that bad? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.02,
      "end_seconds": 175.91,
      "duration_seconds": 7.89,
      "text": "Any problem with the other leg, or any numbness, anything like that?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.97,
      "end_seconds": 182.02,
      "duration_seconds": 5.05,
      "text": "No, nothing like that. It's only that heel."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.78,
      "end_seconds": 197.48,
      "duration_seconds": 13.7,
      "text": "Let me explain what I think is going on. The tendon has been overloaded and has become irritated and thickened. I think this looks like Achilles tendinopathy."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.4,
      "end_seconds": 200.92,
      "duration_seconds": 2.52,
      "text": "Is it torn? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.41,
      "end_seconds": 214.9,
      "duration_seconds": 11.49,
      "text": "There was no pop and you can rise onto your toes, so a full tear is very unlikely. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.47,
      "end_seconds": 220.54,
      "duration_seconds": 3.07,
      "text": "That's a relief. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.33,
      "end_seconds": 232.46,
      "duration_seconds": 9.13,
      "text": "I'd like to start naproxen, 250 mg, twice a day with food, for one week."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.09,
      "end_seconds": 239.5,
      "duration_seconds": 4.41,
      "text": "Okay. And can I keep running? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.28,
      "end_seconds": 250.2,
      "duration_seconds": 8.92,
      "text": "I'd cut your running by half and avoid hills and speed work for now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.29,
      "end_seconds": 256.23,
      "duration_seconds": 3.94,
      "text": "That's going to be hard. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.34,
      "end_seconds": 269.43,
      "duration_seconds": 12.09,
      "text": "I'd also like to arrange an ultrasound of the Achilles tendon, and I'll refer you to physiotherapy for a loading programme."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.94,
      "end_seconds": 275.2,
      "duration_seconds": 3.26,
      "text": "When will that be? ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.35,
      "end_seconds": 282.82,
      "duration_seconds": 6.47,
      "text": "The ultrasound within two weeks, and physiotherapy will call you. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.64,
      "end_seconds": 288.36,
      "duration_seconds": 2.72,
      "text": "Great, thank you. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.22,
      "end_seconds": 297.6,
      "duration_seconds": 8.38,
      "text": "Do the calf stretches that the physio shows you, and avoid stretching the tendon hard until then."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.88,
      "end_seconds": 302.19,
      "duration_seconds": 2.31,
      "text": "I'll be careful. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.91,
      "end_seconds": 305.61,
      "duration_seconds": 2.7,
      "text": "Any other questions? ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.58,
      "end_seconds": 311.22,
      "duration_seconds": 3.64,
      "text": "No, I think that covers it. ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.36,
      "end_seconds": 316.13,
      "duration_seconds": 2.77,
      "text": "Good. Take care. ~"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.83,
      "end_seconds": 318.9,
      "duration_seconds": 2.07,
      "text": "Thanks, doctor. ~"
    }
  ]
}
