{
  "schema_version": "1.0",
  "encounter_id": "00707",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 1.3,
      "end_seconds": 16.64,
      "duration_seconds": 15.34,
      "text": "Sorry, G'day, we're here about Jack's arm. He got stung by a bee, and it went huge. Or was it a wasp? I don't know, he's not sure either."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.34,
      "end_seconds": 24.6,
      "duration_seconds": 5.26,
      "text": "No worries. Jack, how old are you, mate? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.64,
      "end_seconds": 28.34,
      "duration_seconds": 1.7,
      "text": "Seven. ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.32,
      "end_seconds": 36.92,
      "duration_seconds": 5.6,
      "text": "Seven, great. Jack, where did the sting get you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.14,
      "end_seconds": 42.53,
      "duration_seconds": 4.39,
      "text": "Here. On my arm. It got big."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.81,
      "end_seconds": 47.83,
      "duration_seconds": 3.02,
      "text": "And when was it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.08,
      "end_seconds": 54.56,
      "duration_seconds": 4.48,
      "text": "Two days ago. It was on Wednesday."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 55.84,
      "end_seconds": 67.59,
      "duration_seconds": 11.75,
      "text": "No, mate, it's been four days, it was the weekend, at the barbecue. We went to the park on Saturday."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.3,
      "end_seconds": 82.36,
      "duration_seconds": 13.06,
      "text": "So Jack says two days and Mum says four days, I'll put that as two to four days. How big did it get, Mum?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 84.64,
      "end_seconds": 94.72,
      "duration_seconds": 10.08,
      "text": "The whole forearm, red and swollen, like a balloon. It was the size of a sausage roll, honestly."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.41,
      "end_seconds": 99.64,
      "duration_seconds": 3.23,
      "text": "Any trouble breathing when it happened?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 102.55,
      "end_seconds": 108.53,
      "duration_seconds": 5.98,
      "text": "No, nothing like that. He was just crying about the arm."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.77,
      "end_seconds": 114.22,
      "duration_seconds": 4.45,
      "text": "Any hives anywhere else on his body?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 116.28,
      "end_seconds": 119.41,
      "duration_seconds": 3.13,
      "text": "No. Only the arm."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.87,
      "end_seconds": 125.6,
      "duration_seconds": 4.73,
      "text": "Did he vomit, or go floppy or dizzy?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 126.72,
      "end_seconds": 131.76,
      "duration_seconds": 5.04,
      "text": "No. No vomiting, he was running around an hour later."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.74,
      "end_seconds": 137.47,
      "duration_seconds": 4.73,
      "text": "Any allergies that you know of, to anything?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 138.6,
      "end_seconds": 144.56,
      "duration_seconds": 5.96,
      "text": "No, none that we know of. He's been fine with everything."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.28,
      "end_seconds": 148.2,
      "duration_seconds": 2.92,
      "text": "Has Jack had any operations?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 150.77,
      "end_seconds": 157.08,
      "duration_seconds": 6.31,
      "text": "He had grommets put in his ears when he was three."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.89,
      "end_seconds": 163.26,
      "duration_seconds": 3.37,
      "text": "Does he play outside a lot?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 165.2,
      "end_seconds": 170.16,
      "duration_seconds": 4.96,
      "text": "All the time, footy, cricket, the creek. He's a feral."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.39,
      "end_seconds": 191.38,
      "duration_seconds": 3.99,
      "text": "Let me look at the arm."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.23,
      "end_seconds": 206.62,
      "duration_seconds": 14.39,
      "text": "It's still a bit pink and swollen, about five centimetres across, near the elbow, but it's going down, and there's no sign of infection."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 208.82,
      "end_seconds": 212.71,
      "duration_seconds": 3.89,
      "text": "Is it an allergic reaction? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.66,
      "end_seconds": 229.66,
      "duration_seconds": 15.0,
      "text": "This is what we call a big local reaction, where the swelling stays at the site. It's not the dangerous kind that affects the whole body. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 231.98,
      "end_seconds": 234.41,
      "duration_seconds": 2.43,
      "text": "That's a relief. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.38,
      "end_seconds": 241.45,
      "duration_seconds": 6.07,
      "text": "Weight 24 kilos and a pulse of 90, all fine."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 243.28,
      "end_seconds": 247.44,
      "duration_seconds": 4.16,
      "text": "Should we be worried about next time? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.87,
      "end_seconds": 264.73,
      "duration_seconds": 15.86,
      "text": "Reactions like this don't usually get worse, but I'd like to be thorough. I'd like to arrange a skin test for venom, and a blood test for venom antibodies, at the specialist clinic."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 266.04,
      "end_seconds": 268.6,
      "duration_seconds": 2.56,
      "text": "Is that needed? ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.28,
      "end_seconds": 280.45,
      "duration_seconds": 10.17,
      "text": "I'd like to rule out a bigger problem, and it gives us a plan for next time. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 281.88,
      "end_seconds": 283.87,
      "duration_seconds": 1.99,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.86,
      "end_seconds": 300.53,
      "duration_seconds": 13.67,
      "text": "Meanwhile, if he's stung again, wash the area, give a cold pack, and if there's any trouble breathing, swelling of his face, or he goes pale or floppy, call 000."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 301.69,
      "end_seconds": 303.82,
      "duration_seconds": 2.13,
      "text": "Got it. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.52,
      "end_seconds": 312.24,
      "duration_seconds": 6.72,
      "text": "I'd like to see you again in six weeks, once those tests are done."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 313.73,
      "end_seconds": 317.07,
      "duration_seconds": 3.34,
      "text": "Six weeks. Thanks, doc. ~"
    }
  ]
}
