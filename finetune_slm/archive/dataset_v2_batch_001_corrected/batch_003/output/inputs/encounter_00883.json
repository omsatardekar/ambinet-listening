{
  "schema_version": "1.0",
  "encounter_id": "00883",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 1.43,
      "end_seconds": 14.37,
      "duration_seconds": 12.94,
      "text": "Doctor, my neighbour here, Mr Hughes, can't hear properly and can't see well, and he's hardly going out anymore. I'm worried about him."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.41,
      "end_seconds": 23.61,
      "duration_seconds": 7.2,
      "text": "Thank you for bringing him in. Mr Hughes, how are you finding your hearing?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.85,
      "end_seconds": 29.91,
      "duration_seconds": 4.06,
      "text": "What? You'll have to speak up."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.46,
      "end_seconds": 38.51,
      "duration_seconds": 6.05,
      "text": "Your hearing, Mr Hughes. Is it giving you trouble?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.42,
      "end_seconds": 48.62,
      "duration_seconds": 8.2,
      "text": "Aye, I can't follow the telly, and on the phone it's just noise."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 50.64,
      "end_seconds": 58.1,
      "duration_seconds": 7.46,
      "text": "He turns the television up so loud that the whole street can hear it."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.17,
      "end_seconds": 63.3,
      "duration_seconds": 2.13,
      "text": "And your eyes?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.41,
      "end_seconds": 72.03,
      "duration_seconds": 6.62,
      "text": "Everything's blurry, especially reading. I can't read the paper anymore."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.96,
      "end_seconds": 79.18,
      "duration_seconds": 4.22,
      "text": "When did you start noticing these changes?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.2,
      "end_seconds": 87.24,
      "duration_seconds": 7.04,
      "text": "Och, I couldn't tell you. It crept up. A couple of years, maybe."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 88.22,
      "end_seconds": 95.32,
      "duration_seconds": 7.1,
      "text": "I only noticed this past winter, but I think it was going on before."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.4,
      "end_seconds": 101.27,
      "duration_seconds": 4.87,
      "text": "Do you go out and meet friends?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.59,
      "end_seconds": 109.32,
      "duration_seconds": 6.73,
      "text": "Not much now. I get lost in the conversation, so I don't bother."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 112.09,
      "end_seconds": 120.13,
      "duration_seconds": 8.04,
      "text": "He used to go to the bowls club every Thursday, and he stopped last spring."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.6,
      "end_seconds": 127.24,
      "duration_seconds": 5.64,
      "text": "That sounds lonely. How's your mood, Mr Hughes? ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.5,
      "end_seconds": 135.02,
      "duration_seconds": 5.52,
      "text": "I'm all right. Just tired of missing things. ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.02,
      "end_seconds": 140.61,
      "duration_seconds": 3.59,
      "text": "Do you have any medical problems?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 142.68,
      "end_seconds": 151.13,
      "duration_seconds": 8.45,
      "text": "He has high blood pressure, diabetes, and cataracts in the left eye, I think."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.57,
      "end_seconds": 157.59,
      "duration_seconds": 4.02,
      "text": "Let me check your pressure and pulse. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.38,
      "end_seconds": 170.86,
      "duration_seconds": 2.48,
      "text": "Aye, go on."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.74,
      "end_seconds": 178.98,
      "duration_seconds": 6.24,
      "text": "Blood pressure 146 over 84, pulse 72, temperature 36.5, oxygen 97 percent."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 180.56,
      "end_seconds": 183.49,
      "duration_seconds": 2.93,
      "text": "Is that all right? ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.2,
      "end_seconds": 196.24,
      "duration_seconds": 11.04,
      "text": "A little high, but fine for his age. Now I'd like to look in your ears, Mr Hughes. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.61,
      "end_seconds": 213.41,
      "duration_seconds": 1.8,
      "text": "Go on."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.29,
      "end_seconds": 220.94,
      "duration_seconds": 5.65,
      "text": "There's a lot of wax in both ears, blocking the eardrums."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.39,
      "end_seconds": 226.97,
      "duration_seconds": 4.58,
      "text": "Wax? Is that why I can't hear? ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.77,
      "end_seconds": 239.62,
      "duration_seconds": 10.85,
      "text": "It may be a big part of it. I'd like to have it removed and then recheck your hearing."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 242.03,
      "end_seconds": 246.06,
      "duration_seconds": 4.03,
      "text": "Can we do that here? ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.26,
      "end_seconds": 258.78,
      "duration_seconds": 11.52,
      "text": "The nurse can arrange ear syringing next week, and I'll refer him for an eye test and a hearing test after."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 260.02,
      "end_seconds": 262.89,
      "duration_seconds": 2.87,
      "text": "I'll bring him. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.93,
      "end_seconds": 272.94,
      "duration_seconds": 9.01,
      "text": "In the meantime, I'd like him to have an eye test with the optician."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 275.38,
      "end_seconds": 279.06,
      "duration_seconds": 3.68,
      "text": "I'll book it for this month. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.0,
      "end_seconds": 287.88,
      "duration_seconds": 7.88,
      "text": "And I'd encourage him to go back to the bowls club once he can hear again."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.27,
      "end_seconds": 292.61,
      "duration_seconds": 3.34,
      "text": "Aye, maybe I will. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.36,
      "end_seconds": 300.99,
      "duration_seconds": 6.63,
      "text": "If he gets sudden hearing loss or severe dizziness, call us straight away."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 301.88,
      "end_seconds": 305.98,
      "duration_seconds": 4.1,
      "text": "I will. Thank you, doctor. ~"
    }
  ]
}
