{
  "schema_version": "1.0",
  "encounter_id": "00835",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 1.03,
      "end_seconds": 11.16,
      "duration_seconds": 10.13,
      "text": "Doctor, I'm worried. Mum's been on steroid tablets for a long time, and I've read they can thin the bones."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.67,
      "end_seconds": 19.38,
      "duration_seconds": 6.71,
      "text": "It's only a small dose. I've been on them for ages. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.68,
      "end_seconds": 29.88,
      "duration_seconds": 8.2,
      "text": "Good questions, both of you. Mrs Rafferty, how long have you been on the prednisolone?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.74,
      "end_seconds": 35.15,
      "duration_seconds": 3.41,
      "text": "About five years, since the polymyalgia."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 36.51,
      "end_seconds": 42.35,
      "duration_seconds": 5.84,
      "text": "That's right, Mum, it was the year we moved."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.61,
      "end_seconds": 48.05,
      "duration_seconds": 4.44,
      "text": "Five years, thank you. What dose are you on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.52,
      "end_seconds": 52.62,
      "duration_seconds": 3.1,
      "text": "Five milligrams, once a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.89,
      "end_seconds": 64.09,
      "duration_seconds": 9.2,
      "text": "Thank you. Any aches or pain in your back, any fractures, or loss of height?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.79,
      "end_seconds": 71.99,
      "duration_seconds": 6.2,
      "text": "No fractures. A little backache, now and then, for about two months."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 73.86,
      "end_seconds": 80.58,
      "duration_seconds": 6.72,
      "text": "It's six months, Mum. You were holding your back at Christmas."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.11,
      "end_seconds": 94.62,
      "duration_seconds": 11.51,
      "text": "So two months from you and six months from your daughter. I'll record it as two to six months."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 97.02,
      "end_seconds": 104.29,
      "duration_seconds": 7.27,
      "text": "She's lost height, Mum. You used to be taller than me."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.62,
      "end_seconds": 108.54,
      "duration_seconds": 1.92,
      "text": "I haven't."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.61,
      "end_seconds": 124.93,
      "duration_seconds": 14.32,
      "text": "I'll record that you say no, and your daughter says yes. I'll measure you today. Any other symptoms, bruising easily, or thin skin?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.04,
      "end_seconds": 130.63,
      "duration_seconds": 3.59,
      "text": "Bruises, yes, on my arms."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.51,
      "end_seconds": 136.23,
      "duration_seconds": 3.72,
      "text": "Any stomach upset, or black stools?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.89,
      "end_seconds": 139.11,
      "duration_seconds": 1.22,
      "text": "No."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.69,
      "end_seconds": 144.23,
      "duration_seconds": 3.54,
      "text": "What other conditions do you have?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 145.23,
      "end_seconds": 155.0,
      "duration_seconds": 9.77,
      "text": "She had polymyalgia rheumatica, which is why the steroids, high blood pressure, and an underactive thyroid."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.33,
      "end_seconds": 160.68,
      "duration_seconds": 4.35,
      "text": "Is there any family history of osteoporosis?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 161.43,
      "end_seconds": 165.97,
      "duration_seconds": 4.54,
      "text": "Her mother broke her hip at eighty."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.98,
      "end_seconds": 170.6,
      "duration_seconds": 3.62,
      "text": "And does she exercise, or smoke?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.5,
      "end_seconds": 177.45,
      "duration_seconds": 4.95,
      "text": "I walk a mile a day. I've never smoked."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.15,
      "end_seconds": 185.17,
      "duration_seconds": 5.02,
      "text": "Let me weigh and measure you, Mrs Rafferty. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.33,
      "end_seconds": 213.91,
      "duration_seconds": 1.58,
      "text": "Go on."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.51,
      "end_seconds": 227.45,
      "duration_seconds": 10.94,
      "text": "Weight 58 kilos, and your height is 154 centimetres. In your notes it was 160, six years ago."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 228.86,
      "end_seconds": 231.48,
      "duration_seconds": 2.62,
      "text": "I told you. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.07,
      "end_seconds": 236.64,
      "duration_seconds": 2.57,
      "text": "Oh. Well. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.05,
      "end_seconds": 249.53,
      "duration_seconds": 10.48,
      "text": "That's a loss of six centimetres, and it's a clue that the bones in your spine may be thinning."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 251.91,
      "end_seconds": 255.35,
      "duration_seconds": 3.44,
      "text": "Can you do something? ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.61,
      "end_seconds": 274.29,
      "duration_seconds": 17.68,
      "text": "Yes. Long-term steroids do thin bones, and the earlier we protect them, the better. I'm going to prescribe a bone-protecting tablet, alendronic acid, 70 mg, once a week, with calcium and vitamin D."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.91,
      "end_seconds": 281.12,
      "duration_seconds": 4.21,
      "text": "Do I have to take more tablets? ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.72,
      "end_seconds": 296.94,
      "duration_seconds": 14.22,
      "text": "Yes, but only one a week for the bone one. Take it first thing, with a full glass of water, and stay upright for thirty minutes."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 299.75,
      "end_seconds": 302.4,
      "duration_seconds": 2.65,
      "text": "I'll remind her. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.43,
      "end_seconds": 314.66,
      "duration_seconds": 10.23,
      "text": "I'd also like to arrange a bone density scan, and a blood test for your vitamin D and calcium."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.88,
      "end_seconds": 318.82,
      "duration_seconds": 1.94,
      "text": "Fine. ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.54,
      "end_seconds": 331.83,
      "duration_seconds": 12.29,
      "text": "And walking is excellent. Keep it up. If you get sudden severe back pain, or you fall, come in the same day."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 333.72,
      "end_seconds": 336.88,
      "duration_seconds": 3.16,
      "text": "Thank you, doctor. ~"
    }
  ]
}
