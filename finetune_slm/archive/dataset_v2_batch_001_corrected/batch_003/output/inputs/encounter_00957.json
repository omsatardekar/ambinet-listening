{
  "schema_version": "1.0",
  "encounter_id": "00957",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 2.14,
      "end_seconds": 17.92,
      "duration_seconds": 15.78,
      "text": "Morning, Dr Pritchard. I've done Mr Ashworth's obs: blood pressure 128 over 82, pulse 74, weight 92 kilos. He's a bit worried about his liver test."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.71,
      "end_seconds": 29.89,
      "duration_seconds": 9.18,
      "text": "Thank you, nurse. Come in, Mr Ashworth. I understand there's an abnormal liver test from your insurance check?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.1,
      "end_seconds": 44.04,
      "duration_seconds": 11.94,
      "text": "Yes. They sent a letter. The, er, the thing, the numbers, were high. I can't remember which. The liver ones, anyway. ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.44,
      "end_seconds": 53.85,
      "duration_seconds": 6.41,
      "text": "That's what we'll look at. Tell me, any symptoms at the moment? ~"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.24,
      "end_seconds": 63.5,
      "duration_seconds": 7.26,
      "text": "I get tired, but I'm fifty-eight, and I work too much."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.31,
      "end_seconds": 69.82,
      "duration_seconds": 3.51,
      "text": "Any pain, anywhere in the tummy?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.9,
      "end_seconds": 89.02,
      "duration_seconds": 17.12,
      "text": "A dull ache on the right side, under the ribs, mostly after a fatty meal. I had a fish and chip supper last week and it was there all night."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.82,
      "end_seconds": 93.78,
      "duration_seconds": 1.96,
      "text": "Any bloating?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.2,
      "end_seconds": 100.81,
      "duration_seconds": 3.61,
      "text": "Yes, a bit, after big meals."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.11,
      "end_seconds": 107.17,
      "duration_seconds": 4.06,
      "text": "Any yellowing of the skin or eyes?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.05,
      "end_seconds": 113.58,
      "duration_seconds": 3.53,
      "text": "No. My wife would've said."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.15,
      "end_seconds": 120.26,
      "duration_seconds": 3.11,
      "text": "What medicines do you take?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.47,
      "end_seconds": 133.33,
      "duration_seconds": 9.86,
      "text": "One tablet for cholesterol. A little blue one. I couldn't tell you the name, I'm sorry. My wife usually knows."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.04,
      "end_seconds": 141.28,
      "duration_seconds": 5.24,
      "text": "We'll find it on your record. How's your general health?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.01,
      "end_seconds": 150.0,
      "duration_seconds": 5.99,
      "text": "High cholesterol, as I said, and I'm overweight, I know."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.22,
      "end_seconds": 168.15,
      "duration_seconds": 6.93,
      "text": "Let me press on your tummy. Take a deep breath in."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.76,
      "end_seconds": 173.65,
      "duration_seconds": 1.89,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.79,
      "end_seconds": 183.36,
      "duration_seconds": 6.57,
      "text": "There's no tenderness over the liver, and I can't feel it enlarged."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.39,
      "end_seconds": 187.4,
      "duration_seconds": 2.01,
      "text": "That's good? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.18,
      "end_seconds": 195.48,
      "duration_seconds": 4.3,
      "text": "Any problem with your bowels, anything different?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.31,
      "end_seconds": 200.5,
      "duration_seconds": 2.19,
      "text": "No, nothing, they're normal."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.16,
      "end_seconds": 215.69,
      "duration_seconds": 12.53,
      "text": "Here's what I think. Mild liver test abnormalities with high cholesterol and extra weight is most often a fatty liver. That's my provisional thinking."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.39,
      "end_seconds": 221.21,
      "duration_seconds": 2.82,
      "text": "Fatty liver. From drink? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.43,
      "end_seconds": 230.92,
      "duration_seconds": 7.49,
      "text": "Not necessarily. It's more often from weight, sugar and fat in the diet. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.73,
      "end_seconds": 237.12,
      "duration_seconds": 3.39,
      "text": "I don't drink much. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.04,
      "end_seconds": 253.46,
      "duration_seconds": 13.42,
      "text": "Good. The main treatment is gradual weight loss, about five to ten percent of your weight, and cutting down on fatty and sugary foods."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.65,
      "end_seconds": 258.4,
      "duration_seconds": 2.75,
      "text": "That's about nine kilos. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.99,
      "end_seconds": 269.03,
      "duration_seconds": 7.04,
      "text": "Roughly. Slowly, over the next six months. Walk for half an hour every day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.35,
      "end_seconds": 273.79,
      "duration_seconds": 2.44,
      "text": "I'll do it. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.35,
      "end_seconds": 286.91,
      "duration_seconds": 10.56,
      "text": "And I'd like you to bring the box for the cholesterol tablet next time, so we can note the name properly. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.99,
      "end_seconds": 292.06,
      "duration_seconds": 3.07,
      "text": "I'll ask my wife. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.11,
      "end_seconds": 299.46,
      "duration_seconds": 5.35,
      "text": "I'd like to see you again in six weeks."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.88,
      "end_seconds": 305.99,
      "duration_seconds": 3.11,
      "text": "Six weeks. Thank you. ~"
    }
  ]
}
