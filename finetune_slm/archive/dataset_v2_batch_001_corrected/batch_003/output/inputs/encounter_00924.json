{
  "schema_version": "1.0",
  "encounter_id": "00924",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.4,
      "end_seconds": 14.03,
      "duration_seconds": 12.63,
      "text": "It's the swallowing, doctor. Solid food sticks in my chest, and I'm after having the stretching done, and it's still not right."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.01,
      "end_seconds": 25.19,
      "duration_seconds": 9.18,
      "text": "I see from the notes you had the dilatation. Tell me how it's been since."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.82,
      "end_seconds": 34.54,
      "duration_seconds": 6.72,
      "text": "Better for a week, then it came back. Bread and meat especially."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.9,
      "end_seconds": 40.92,
      "duration_seconds": 3.02,
      "text": "Where does it stick?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.72,
      "end_seconds": 47.4,
      "duration_seconds": 3.68,
      "text": "Just here, behind the breastbone."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.86,
      "end_seconds": 52.49,
      "duration_seconds": 2.63,
      "text": "When was the procedure, exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.59,
      "end_seconds": 60.82,
      "duration_seconds": 6.23,
      "text": "Oh, about two months ago. Or six weeks. I'm not sure now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 63.26,
      "end_seconds": 72.38,
      "duration_seconds": 9.12,
      "text": "Our record shows it was done on the twelfth, which would be nine weeks ago."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.62,
      "end_seconds": 84.99,
      "duration_seconds": 9.37,
      "text": "Thank you, Nurse. We'll go with the record, though Mr Walsh remembers it a bit differently. Any pain on swallowing?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.88,
      "end_seconds": 90.96,
      "duration_seconds": 4.08,
      "text": "No pain. It just stops. ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.32,
      "end_seconds": 98.37,
      "duration_seconds": 4.05,
      "text": "Do liquids go down all right? ~"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.0,
      "end_seconds": 103.24,
      "duration_seconds": 3.24,
      "text": "Yes. It's only solids. ~"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.36,
      "end_seconds": 110.78,
      "duration_seconds": 5.42,
      "text": "Any weight loss, or vomiting food back up?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.09,
      "end_seconds": 119.89,
      "duration_seconds": 6.8,
      "text": "I've lost a bit of weight, maybe two kilos. No vomiting."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.89,
      "end_seconds": 124.63,
      "duration_seconds": 2.74,
      "text": "What medicines are you taking?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.83,
      "end_seconds": 131.18,
      "duration_seconds": 4.35,
      "text": "The omeprazole, 20 mg, twice a day."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 133.75,
      "end_seconds": 137.76,
      "duration_seconds": 4.01,
      "text": "The record shows once a day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.86,
      "end_seconds": 145.2,
      "duration_seconds": 4.34,
      "text": "No, it's twice. The consultant said double it."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.54,
      "end_seconds": 156.33,
      "duration_seconds": 8.79,
      "text": "I'll note that you say twice, and the record says once, and we'll check with the pharmacy."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.33,
      "end_seconds": 161.39,
      "duration_seconds": 2.06,
      "text": "Any other conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.03,
      "end_seconds": 169.7,
      "duration_seconds": 5.67,
      "text": "Reflux, for a good few years. That's why I had the stretching."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 172.49,
      "end_seconds": 185.1,
      "duration_seconds": 12.61,
      "text": "Doctor, I've got his observations. Pulse 76, blood pressure 128 over 80, temperature 36.6, oxygen 98 percent, weight 79 kilograms."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.03,
      "end_seconds": 191.85,
      "duration_seconds": 4.82,
      "text": "Thank you. Let me feel your neck and tummy. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.77,
      "end_seconds": 210.52,
      "duration_seconds": 1.75,
      "text": "Go on."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.02,
      "end_seconds": 220.46,
      "duration_seconds": 6.44,
      "text": "Neck is normal, and the abdomen is soft and non-tender."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.74,
      "end_seconds": 227.21,
      "duration_seconds": 3.47,
      "text": "What's going on, doctor? ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.6,
      "end_seconds": 242.4,
      "duration_seconds": 11.8,
      "text": "The narrowing may be coming back, which can happen after a stretch. I'd like to repeat the camera test and see."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.74,
      "end_seconds": 247.9,
      "duration_seconds": 2.16,
      "text": "The endoscopy again?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.55,
      "end_seconds": 259.77,
      "duration_seconds": 9.22,
      "text": "Yes. I'll arrange it within the next two weeks, and we'll take a small sample at the same time."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.75,
      "end_seconds": 265.61,
      "duration_seconds": 3.86,
      "text": "That's fine. I'd rather know. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.76,
      "end_seconds": 275.99,
      "duration_seconds": 7.23,
      "text": "Until then, eat soft foods, cut meat into small pieces, and chew slowly."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.9,
      "end_seconds": 281.04,
      "duration_seconds": 2.14,
      "text": "I will. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.06,
      "end_seconds": 292.77,
      "duration_seconds": 9.71,
      "text": "If food gets completely stuck, you can't swallow your saliva, or you vomit blood, go straight to the emergency department."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.31,
      "end_seconds": 299.62,
      "duration_seconds": 3.31,
      "text": "Understood. Thank you both. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.59,
      "end_seconds": 306.02,
      "duration_seconds": 3.43,
      "text": "I'll see you after the endoscopy."
    }
  ]
}
