{
  "schema_version": "1.0",
  "encounter_id": "00991",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.78,
      "end_seconds": 13.15,
      "duration_seconds": 9.37,
      "text": "Mr Menon, hello. This is your six-week check on the knee, I believe. And you've brought your daughter?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 18.01,
      "end_seconds": 27.5,
      "duration_seconds": 9.49,
      "text": "I'm Priya, I wanted to hear what the doctor says. He doesn't tell me everything. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.38,
      "end_seconds": 37.94,
      "duration_seconds": 5.56,
      "text": "I tell her enough. The knee is better, doctor, but stiff."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.17,
      "end_seconds": 43.59,
      "duration_seconds": 1.42,
      "text": "How stiff?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.16,
      "end_seconds": 54.47,
      "duration_seconds": 6.31,
      "text": "In the mornings, I cannot bend it fully until about nine o'clock."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 59.39,
      "end_seconds": 66.3,
      "duration_seconds": 6.91,
      "text": "And it swells in the evening, doctor, he puts his foot up."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.28,
      "end_seconds": 72.83,
      "duration_seconds": 1.55,
      "text": "Any fever?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.2,
      "end_seconds": 78.93,
      "duration_seconds": 1.73,
      "text": "No fever."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.77,
      "end_seconds": 88.18,
      "duration_seconds": 4.41,
      "text": "Any pain or swelling in the calf?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.04,
      "end_seconds": 96.7,
      "duration_seconds": 3.66,
      "text": "No pain in the calf, no."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.88,
      "end_seconds": 103.71,
      "duration_seconds": 2.83,
      "text": "What are you taking?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.29,
      "end_seconds": 117.47,
      "duration_seconds": 9.18,
      "text": "Paracetamol, 1 gram, four times a day. And aspirin, 150 mg, once a day, for the blood clots."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.63,
      "end_seconds": 124.18,
      "duration_seconds": 2.55,
      "text": "Good. Your other conditions?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.57,
      "end_seconds": 135.46,
      "duration_seconds": 6.89,
      "text": "Type 2 diabetes, high blood pressure, and arthritis in the other knee."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.82,
      "end_seconds": 153.84,
      "duration_seconds": 7.02,
      "text": "Let me check you. Temperature 36.8, blood pressure 130 over 78."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 157.87,
      "end_seconds": 161.08,
      "duration_seconds": 3.21,
      "text": "Is he all right? ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.53,
      "end_seconds": 173.26,
      "duration_seconds": 7.73,
      "text": "Very good. I won't put a label on anything today, he's doing as expected. ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 178.28,
      "end_seconds": 180.51,
      "duration_seconds": 2.23,
      "text": "That's good. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.19,
      "end_seconds": 188.05,
      "duration_seconds": 2.86,
      "text": "How's the physiotherapy? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.79,
      "end_seconds": 199.97,
      "duration_seconds": 7.18,
      "text": "Twice a week. The exercises at home, I do them every day. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 204.65,
      "end_seconds": 207.89,
      "duration_seconds": 3.24,
      "text": "He does, I watch him. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.25,
      "end_seconds": 217.52,
      "duration_seconds": 5.27,
      "text": "Keep doing them. They matter more than any tablet."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.1,
      "end_seconds": 224.06,
      "duration_seconds": 1.96,
      "text": "Yes. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.84,
      "end_seconds": 232.39,
      "duration_seconds": 3.55,
      "text": "How is your sleep? ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.27,
      "end_seconds": 243.02,
      "duration_seconds": 5.75,
      "text": "The knee wakes me if I turn onto it. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.62,
      "end_seconds": 251.27,
      "duration_seconds": 3.65,
      "text": "A pillow between the knees helps."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.27,
      "end_seconds": 258.98,
      "duration_seconds": 2.71,
      "text": "I will try. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.29,
      "end_seconds": 271.96,
      "duration_seconds": 8.67,
      "text": "I'd like to arrange an X-ray of the knee, to see that everything is sitting well."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 276.59,
      "end_seconds": 278.3,
      "duration_seconds": 1.71,
      "text": "When? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.3,
      "end_seconds": 290.73,
      "duration_seconds": 7.43,
      "text": "Before your next visit. I'd like to see you again in six weeks."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 295.52,
      "end_seconds": 298.79,
      "duration_seconds": 3.27,
      "text": "Six weeks. I'll bring him. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.12,
      "end_seconds": 306.0,
      "duration_seconds": 2.88,
      "text": "Thank you, doctor. ~"
    }
  ]
}
