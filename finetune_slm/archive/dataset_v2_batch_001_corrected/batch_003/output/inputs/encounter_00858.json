{
  "schema_version": "1.0",
  "encounter_id": "00858",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 0.44,
      "end_seconds": 9.98,
      "duration_seconds": 9.54,
      "text": "Doctor, I'm Anjali, I'm Mrs Pereira's carer. She's been dizzy when she stands up, and I'm worried she'll fall."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.5,
      "end_seconds": 16.54,
      "duration_seconds": 5.04,
      "text": "Oh, it's not so bad, a little giddy sometimes."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.92,
      "end_seconds": 23.25,
      "duration_seconds": 4.33,
      "text": "Mrs Pereira, tell me when it happens."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.78,
      "end_seconds": 34.66,
      "duration_seconds": 8.88,
      "text": "When I get out of bed, or up from my chair. Everything goes grey."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.8,
      "end_seconds": 41.03,
      "duration_seconds": 4.23,
      "text": "How long has this been going on?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.14,
      "end_seconds": 46.0,
      "duration_seconds": 2.86,
      "text": "A week or two, perhaps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 46.81,
      "end_seconds": 56.68,
      "duration_seconds": 9.87,
      "text": "It's been a month at least. I've seen her hold the wall since the start of last month."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.81,
      "end_seconds": 68.78,
      "duration_seconds": 10.97,
      "text": "So a week or two from you, a month or more from Anjali. I'll put it as two weeks to a month. Any fainting?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.94,
      "end_seconds": 73.33,
      "duration_seconds": 2.39,
      "text": "No. I've not fainted."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.67,
      "end_seconds": 78.39,
      "duration_seconds": 2.72,
      "text": "Any chest pain or palpitations?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.31,
      "end_seconds": 82.56,
      "duration_seconds": 1.25,
      "text": "No."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.2,
      "end_seconds": 85.56,
      "duration_seconds": 1.36,
      "text": "Any falls?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 86.94,
      "end_seconds": 92.5,
      "duration_seconds": 5.56,
      "text": "She had a near fall last Tuesday. I caught her."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.24,
      "end_seconds": 98.72,
      "duration_seconds": 3.48,
      "text": "What tablets does she take?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 99.77,
      "end_seconds": 109.11,
      "duration_seconds": 9.34,
      "text": "Amlodipine, 10 mg, once a day, and a water tablet, bendroflumethiazide, 2.5 mg, in the morning."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.93,
      "end_seconds": 111.77,
      "duration_seconds": 1.84,
      "text": "Any allergies?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 114.09,
      "end_seconds": 115.83,
      "duration_seconds": 1.74,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.85,
      "end_seconds": 120.01,
      "duration_seconds": 2.16,
      "text": "Any other conditions?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 123.0,
      "end_seconds": 128.7,
      "duration_seconds": 5.7,
      "text": "Just high blood pressure. And her hips are bad."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.83,
      "end_seconds": 134.67,
      "duration_seconds": 3.84,
      "text": "Is she eating and drinking enough?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 136.71,
      "end_seconds": 144.1,
      "duration_seconds": 7.39,
      "text": "She's not drinking much, and she's eating less. Her appetite has gone."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.75,
      "end_seconds": 149.55,
      "duration_seconds": 2.8,
      "text": "I'm not hungry, dear. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.47,
      "end_seconds": 159.76,
      "duration_seconds": 8.29,
      "text": "Let me check her pulse and blood pressure, first sitting, then standing. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 162.42,
      "end_seconds": 165.92,
      "duration_seconds": 3.5,
      "text": "I'll help her up. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.72,
      "end_seconds": 236.66,
      "duration_seconds": 7.94,
      "text": "Sitting, 142 over 80, pulse 70. Now standing, 108 over 62, pulse 82."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 238.28,
      "end_seconds": 241.18,
      "duration_seconds": 2.9,
      "text": "That's a big drop. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.6,
      "end_seconds": 259.39,
      "duration_seconds": 15.79,
      "text": "Yes, a drop of more than 30 points on standing. That fits her symptoms. I'd say this is postural hypotension, likely from the blood pressure tablets together with not drinking enough."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 261.99,
      "end_seconds": 265.4,
      "duration_seconds": 3.41,
      "text": "Can we change the tablets? ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.29,
      "end_seconds": 277.05,
      "duration_seconds": 10.76,
      "text": "Yes. I'd like to stop the water tablet, bendroflumethiazide, and keep the amlodipine for now, but at 5 mg."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 279.36,
      "end_seconds": 281.27,
      "duration_seconds": 1.91,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.81,
      "end_seconds": 295.72,
      "duration_seconds": 12.91,
      "text": "And please encourage her to drink at least six glasses of fluid a day, and to sit on the bed for a minute before standing."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 297.92,
      "end_seconds": 300.82,
      "duration_seconds": 2.9,
      "text": "I'll do that. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.72,
      "end_seconds": 314.45,
      "duration_seconds": 11.73,
      "text": "I'd like to see her again in two weeks, to recheck her pressure. If she faints, falls, or has chest pain, call 999."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 316.84,
      "end_seconds": 319.63,
      "duration_seconds": 2.79,
      "text": "Thank you, doctor. ~"
    }
  ]
}
