{
  "schema_version": "1.0",
  "encounter_id": "00959",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 2.12,
      "end_seconds": 20.01,
      "duration_seconds": 17.89,
      "text": "Morning, doctor. It's his cough, you see. Mr Whitfield, Alan, has had this dry cough for three weeks, ever since he started the new blood pressure tablet. I'm Gemma, his carer."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.54,
      "end_seconds": 29.74,
      "duration_seconds": 6.2,
      "text": "Thank you, Gemma. Alan, is it a dry cough?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.13,
      "end_seconds": 39.27,
      "duration_seconds": 6.14,
      "text": "Dry as a bone. Tickly. Right at the back of my throat."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 41.24,
      "end_seconds": 49.35,
      "duration_seconds": 8.11,
      "text": "It's worse at night, and he's up half the night coughing. We've both been up."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.78,
      "end_seconds": 53.17,
      "duration_seconds": 1.39,
      "text": "Any fever?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.24,
      "end_seconds": 57.27,
      "duration_seconds": 2.03,
      "text": "No fever."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.43,
      "end_seconds": 61.49,
      "duration_seconds": 2.06,
      "text": "Short of breath?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.56,
      "end_seconds": 67.17,
      "duration_seconds": 3.61,
      "text": "No, I'm not breathless. Just coughing."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.1,
      "end_seconds": 72.28,
      "duration_seconds": 2.18,
      "text": "Coughing up blood?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.01,
      "end_seconds": 77.48,
      "duration_seconds": 2.47,
      "text": "No blood, no."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.46,
      "end_seconds": 83.89,
      "duration_seconds": 3.43,
      "text": "Which tablet is it, Gemma?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 87.42,
      "end_seconds": 93.91,
      "duration_seconds": 6.49,
      "text": "Lisinopril, 10 mg, once a day. Started three weeks ago."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.6,
      "end_seconds": 99.92,
      "duration_seconds": 3.32,
      "text": "Thank you. Any allergies, Alan?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.89,
      "end_seconds": 105.21,
      "duration_seconds": 2.32,
      "text": "Penicillin. A rash."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.34,
      "end_seconds": 108.89,
      "duration_seconds": 1.55,
      "text": "Medical history?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.86,
      "end_seconds": 116.04,
      "duration_seconds": 5.18,
      "text": "High blood pressure, obviously. And arthritis in my hips."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.26,
      "end_seconds": 142.72,
      "duration_seconds": 10.46,
      "text": "Let me check you. Pulse 76, blood pressure 138 over 84, temperature 36.6, oxygen 97 percent, breathing 16, weight 79 kilos."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 145.58,
      "end_seconds": 148.7,
      "duration_seconds": 3.12,
      "text": "Is that all right? ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.3,
      "end_seconds": 165.92,
      "duration_seconds": 5.62,
      "text": "All good. Take some deep breaths for me, Alan."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.69,
      "end_seconds": 171.74,
      "duration_seconds": 3.05,
      "text": "In and out. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.79,
      "end_seconds": 180.38,
      "duration_seconds": 6.59,
      "text": "Your chest is clear on both sides, no wheeze, no crackles."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 183.16,
      "end_seconds": 185.26,
      "duration_seconds": 2.1,
      "text": "That's good. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.29,
      "end_seconds": 200.78,
      "duration_seconds": 12.49,
      "text": "It sounds as if the cough is coming from the lisinopril. It's a known side effect of that group of tablets."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.03,
      "end_seconds": 208.24,
      "duration_seconds": 4.21,
      "text": "Really? I thought it was a cold. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.21,
      "end_seconds": 222.06,
      "duration_seconds": 11.85,
      "text": "It can last for weeks, and it can come on after starting. I'm not going to change anything this minute, though. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 225.26,
      "end_seconds": 227.16,
      "duration_seconds": 1.9,
      "text": "Why not? ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.84,
      "end_seconds": 239.79,
      "duration_seconds": 8.95,
      "text": "I'd like to rule out other causes first. I'd like to arrange a chest X-ray, and some blood tests."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 243.44,
      "end_seconds": 245.15,
      "duration_seconds": 1.71,
      "text": "Today? ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.08,
      "end_seconds": 255.52,
      "duration_seconds": 8.44,
      "text": "This week. I'll think about changing the tablet once I have the X-ray results. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.99,
      "end_seconds": 261.6,
      "duration_seconds": 3.61,
      "text": "Will the cough go away? ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.7,
      "end_seconds": 270.08,
      "duration_seconds": 6.38,
      "text": "Usually it settles within a few weeks once the tablet is changed. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.79,
      "end_seconds": 276.32,
      "duration_seconds": 2.53,
      "text": "That's a relief. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.36,
      "end_seconds": 286.79,
      "duration_seconds": 8.43,
      "text": "In the meantime, a spoonful of honey before bed can help soothe the tickle."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 288.71,
      "end_seconds": 291.44,
      "duration_seconds": 2.73,
      "text": "I'll get some honey. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.0,
      "end_seconds": 299.82,
      "duration_seconds": 4.82,
      "text": "I'd like to see you again in two weeks."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 302.04,
      "end_seconds": 306.03,
      "duration_seconds": 3.99,
      "text": "Two weeks. Thank you, doctor. ~"
    }
  ]
}
