{
  "schema_version": "1.0",
  "encounter_id": "00764",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 1.22,
      "end_seconds": 13.17,
      "duration_seconds": 11.95,
      "text": "Doctor, this is Sinead, twenty-three, brought from the main stage by the first aiders. Hot, dizzy, vomiting. She's been in the sun since noon."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.08,
      "end_seconds": 23.83,
      "duration_seconds": 7.75,
      "text": "Thanks, Orla. Sinead, I'm Dr Flynn. Can you hear me? How are you feeling? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.27,
      "end_seconds": 33.64,
      "duration_seconds": 7.37,
      "text": "Awful. Dizzy. And my head's pounding. I feel like I'm going to be sick again."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.62,
      "end_seconds": 39.33,
      "duration_seconds": 2.71,
      "text": "When did it start?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.74,
      "end_seconds": 49.13,
      "duration_seconds": 8.39,
      "text": "About an hour ago, in the crowd. I felt my legs go, and everything went spotty."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.68,
      "end_seconds": 54.72,
      "duration_seconds": 4.04,
      "text": "Have you been drinking water today? ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.79,
      "end_seconds": 67.55,
      "duration_seconds": 9.76,
      "text": "Not much. A few beers, and a coffee. I forgot to drink. I was dancing. ~"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.47,
      "end_seconds": 74.18,
      "duration_seconds": 3.71,
      "text": "Any collapse, or did you lose consciousness?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.07,
      "end_seconds": 82.88,
      "duration_seconds": 5.81,
      "text": "No, I didn't pass out. A friend caught me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.24,
      "end_seconds": 87.94,
      "duration_seconds": 3.7,
      "text": "Any chest pain, or palpitations?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.31,
      "end_seconds": 93.05,
      "duration_seconds": 3.74,
      "text": "No. Just dizzy and sick."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.54,
      "end_seconds": 99.64,
      "duration_seconds": 4.1,
      "text": "Do you take any regular medicines?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.71,
      "end_seconds": 110.43,
      "duration_seconds": 8.72,
      "text": "The pill, the combined one, every day. And I take cetirizine in the summer, 10 mg."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 127.4,
      "end_seconds": 137.21,
      "duration_seconds": 9.81,
      "text": "Doctor, her obs. Temperature 38.4, pulse 118, blood pressure 98 over 60, oxygen 98 percent, respiratory rate 22."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.37,
      "end_seconds": 155.94,
      "duration_seconds": 15.57,
      "text": "Thank you, Orla. Sinead, you're hot, your heart's fast, and your pressure's a bit low, which fits with dehydration and overheating. Let me look at you. ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.41,
      "end_seconds": 177.31,
      "duration_seconds": 0.9,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.26,
      "end_seconds": 190.23,
      "duration_seconds": 9.97,
      "text": "Your skin is hot and flushed but still sweaty, your mouth is dry, and you're alert and talking sensibly."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 191.94,
      "end_seconds": 196.61,
      "duration_seconds": 4.67,
      "text": "Her capillary refill is a little slow, doctor. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.71,
      "end_seconds": 210.93,
      "duration_seconds": 12.22,
      "text": "Noted. Sinead, I think you've got heat exhaustion, but I can't rule out heat stroke, which is more serious, so we're going to treat you quickly."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.73,
      "end_seconds": 215.18,
      "duration_seconds": 2.45,
      "text": "Is that bad? ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.23,
      "end_seconds": 234.53,
      "duration_seconds": 18.3,
      "text": "It's treatable. We'll cool you down and give you fluids. Orla, can you start fluids through a drip, and put cool wet towels and ice packs on her neck, armpits and groin? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 237.23,
      "end_seconds": 239.96,
      "duration_seconds": 2.73,
      "text": "On it, doctor. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.08,
      "end_seconds": 254.84,
      "duration_seconds": 12.76,
      "text": "I'd like to check your blood sugar and a blood test, for your kidneys and salts, because heat and dehydration can upset them."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.93,
      "end_seconds": 258.55,
      "duration_seconds": 1.62,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.26,
      "end_seconds": 271.2,
      "duration_seconds": 9.94,
      "text": "And I'll arrange a repeat set of observations in thirty minutes to make sure your temperature's coming down. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 273.17,
      "end_seconds": 275.84,
      "duration_seconds": 2.67,
      "text": "I'll chart it. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.43,
      "end_seconds": 284.37,
      "duration_seconds": 5.94,
      "text": "Sip small amounts of water, and don't have any more alcohol today."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.32,
      "end_seconds": 289.61,
      "duration_seconds": 2.29,
      "text": "Definitely not. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.5,
      "end_seconds": 302.38,
      "duration_seconds": 10.88,
      "text": "If you get confused, stop sweating, have a fit, or your temperature keeps going up, tell the nurse straight away."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.19,
      "end_seconds": 306.0,
      "duration_seconds": 1.81,
      "text": "I will. ~"
    }
  ]
}
