{
  "schema_version": "1.0",
  "encounter_id": "00915",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 3.49,
      "end_seconds": 8.21,
      "duration_seconds": 4.72,
      "text": "Wasp. In the mouth. Throat feels funny."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 12.93,
      "end_seconds": 16.23,
      "duration_seconds": 3.3,
      "text": "Okay. When did it happen?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.91,
      "end_seconds": 25.24,
      "duration_seconds": 4.33,
      "text": "Ten minutes ago. Drinking from a can."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.05,
      "end_seconds": 32.79,
      "duration_seconds": 3.74,
      "text": "Do you have trouble breathing or swallowing?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.52,
      "end_seconds": 40.83,
      "duration_seconds": 4.31,
      "text": "Swallowing, a bit tight. No problem breathing."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.19,
      "end_seconds": 49.89,
      "duration_seconds": 4.7,
      "text": "Any hives, or itching over your body?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.76,
      "end_seconds": 56.23,
      "duration_seconds": 2.47,
      "text": "No. Just the lip."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.42,
      "end_seconds": 63.27,
      "duration_seconds": 2.85,
      "text": "Have you been stung before?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.74,
      "end_seconds": 74.46,
      "duration_seconds": 6.72,
      "text": "Once as a kid. Swelled up. Haven't been near them since."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.6,
      "end_seconds": 81.62,
      "duration_seconds": 3.02,
      "text": "Any allergies we know about?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.16,
      "end_seconds": 92.33,
      "duration_seconds": 6.17,
      "text": "Wasps, I suppose. Not sure of the reaction, I was little."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 96.22,
      "end_seconds": 102.51,
      "duration_seconds": 6.29,
      "text": "Doctor, the monitor is on. Do you want a drip in? ~"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.15,
      "end_seconds": 111.5,
      "duration_seconds": 4.35,
      "text": "Yes, please. And let's get his observations. ~"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 115.48,
      "end_seconds": 123.89,
      "duration_seconds": 8.41,
      "text": "Pulse 104, blood pressure 124 over 78, oxygen 98 percent, temperature 36.7, breathing 18."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.49,
      "end_seconds": 142.46,
      "duration_seconds": 14.97,
      "text": "Thank you. His lip is swollen on the left side, and the tongue looks normal, and I can see the back of the throat clearly."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.67,
      "end_seconds": 151.15,
      "duration_seconds": 4.48,
      "text": "Am I going to be okay? ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.93,
      "end_seconds": 166.32,
      "duration_seconds": 10.39,
      "text": "I think so, but a sting inside the mouth can swell, so we're going to watch you closely."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.74,
      "end_seconds": 174.87,
      "duration_seconds": 4.13,
      "text": "Will I get an injection? ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.67,
      "end_seconds": 190.06,
      "duration_seconds": 10.39,
      "text": "Not yet, because your breathing is fine and you have no hives. If it gets worse, we'll give adrenaline straight away."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 194.02,
      "end_seconds": 199.75,
      "duration_seconds": 5.73,
      "text": "Adrenaline is drawn up and by the bed, doctor. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.98,
      "end_seconds": 210.45,
      "duration_seconds": 6.47,
      "text": "Good. I'm going to give you an antihistamine, chlorphenamine, 10 mg, by injection."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.95,
      "end_seconds": 227.04,
      "duration_seconds": 1.09,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.81,
      "end_seconds": 240.55,
      "duration_seconds": 8.74,
      "text": "And I'd like to keep you in the department for a few hours of observation."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.08,
      "end_seconds": 247.67,
      "duration_seconds": 2.59,
      "text": "How many hours? ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.27,
      "end_seconds": 264.03,
      "duration_seconds": 12.76,
      "text": "At least four. I'd like you to put some ice on the lip, and sip cold water if you can swallow."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.96,
      "end_seconds": 270.69,
      "duration_seconds": 2.73,
      "text": "Right. I'll try. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.29,
      "end_seconds": 281.99,
      "duration_seconds": 7.7,
      "text": "If your breathing gets harder, or your voice changes, press the call button immediately."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.97,
      "end_seconds": 287.93,
      "duration_seconds": 1.96,
      "text": "I will. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.54,
      "end_seconds": 299.64,
      "duration_seconds": 7.1,
      "text": "And before you go, we'll talk about carrying an adrenaline pen."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.52,
      "end_seconds": 306.0,
      "duration_seconds": 2.48,
      "text": "Okay. Thank you. ~"
    }
  ]
}
