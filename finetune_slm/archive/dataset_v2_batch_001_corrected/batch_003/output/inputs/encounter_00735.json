{
  "schema_version": "1.0",
  "encounter_id": "00735",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 0.8,
      "end_seconds": 11.68,
      "duration_seconds": 10.88,
      "text": "Good morning, Mrs Vega. I'm Hayley, I'll do your observations while you wait for the doctor. Arm out, please. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.79,
      "end_seconds": 23.17,
      "duration_seconds": 10.38,
      "text": "Of course. I'm a little anxious, I can't quite remember when I had the endoscopy. Was it September? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 39.61,
      "end_seconds": 45.67,
      "duration_seconds": 6.06,
      "text": "Blood pressure 124 over 76, pulse 70, temperature 36.7, oxygen 98 percent."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.42,
      "end_seconds": 61.71,
      "duration_seconds": 14.29,
      "text": "Good morning, Mrs Vega. Thank you for coming back. You had your gastroscopy, the camera test of your stomach, on the second of October."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.6,
      "end_seconds": 69.79,
      "duration_seconds": 7.19,
      "text": "Was it? I'd have said September. Yes, I thought it was earlier."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.82,
      "end_seconds": 81.69,
      "duration_seconds": 9.87,
      "text": "It was October, I have the report. Before we go through it, how have you been? ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.31,
      "end_seconds": 92.31,
      "duration_seconds": 8.0,
      "text": "Still the burning in my upper stomach, after meals, especially at night. I'm using more pillows."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.69,
      "end_seconds": 97.2,
      "duration_seconds": 3.51,
      "text": "And when did that start, roughly?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.05,
      "end_seconds": 104.91,
      "duration_seconds": 5.86,
      "text": "Oh, a year ago? Maybe longer. I couldn't tell you the month."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.82,
      "end_seconds": 111.96,
      "duration_seconds": 5.14,
      "text": "That's fine. Any vomiting, trouble swallowing, or black stools?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.24,
      "end_seconds": 117.92,
      "duration_seconds": 3.68,
      "text": "No vomiting, no trouble swallowing. Nothing black."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.45,
      "end_seconds": 123.44,
      "duration_seconds": 2.99,
      "text": "Do you have any allergies?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.54,
      "end_seconds": 126.19,
      "duration_seconds": 1.65,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.32,
      "end_seconds": 129.36,
      "duration_seconds": 2.04,
      "text": "And your background?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.06,
      "end_seconds": 138.88,
      "duration_seconds": 6.82,
      "text": "Acid reflux, for years, and I had my appendix out, in 1998."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.02,
      "end_seconds": 143.89,
      "duration_seconds": 2.87,
      "text": "Do you smoke or drink?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.28,
      "end_seconds": 151.49,
      "duration_seconds": 5.21,
      "text": "I don't smoke. A glass of wine, now and then."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 153.18,
      "end_seconds": 159.12,
      "duration_seconds": 5.94,
      "text": "Doctor, shall I put her on the couch for you? ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.98,
      "end_seconds": 176.93,
      "duration_seconds": 0.95,
      "text": "Please."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.71,
      "end_seconds": 187.41,
      "duration_seconds": 8.7,
      "text": "Your tummy is soft, a little tender at the top, in the middle, and no masses."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.04,
      "end_seconds": 192.27,
      "duration_seconds": 3.23,
      "text": "Is that normal? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.93,
      "end_seconds": 208.51,
      "duration_seconds": 13.58,
      "text": "Right, the results. The camera showed some redness and inflammation at the bottom of the gullet, and the lining looked a bit swollen in the stomach. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.28,
      "end_seconds": 213.04,
      "duration_seconds": 2.76,
      "text": "Is it cancer? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.3,
      "end_seconds": 224.53,
      "duration_seconds": 10.23,
      "text": "No. The biopsies we took showed inflammation but no cancer cells. This fits with acid reflux, and I'd call it reflux oesophagitis."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.22,
      "end_seconds": 229.25,
      "duration_seconds": 3.03,
      "text": "Reflux oesophagitis. Right. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.42,
      "end_seconds": 244.72,
      "duration_seconds": 13.3,
      "text": "It's very treatable, and not dangerous, but it needs proper management. I'd like to arrange a test for a stomach bacterium called Helicobacter, with a breath test."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.7,
      "end_seconds": 250.19,
      "duration_seconds": 2.49,
      "text": "A breath test? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.6,
      "end_seconds": 261.36,
      "duration_seconds": 8.76,
      "text": "You breathe into a bag after a drink. Painless. And a blood test to check you aren't anaemic."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 263.36,
      "end_seconds": 272.39,
      "duration_seconds": 9.03,
      "text": "I can book the breath test, doctor, I'll give her instructions about stopping her tablets before it. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.41,
      "end_seconds": 286.72,
      "duration_seconds": 13.31,
      "text": "Thank you, Hayley. Mrs Vega, raise the head of the bed by a few inches, eat dinner at least three hours before sleep, and cut out large, fatty meals."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.34,
      "end_seconds": 293.59,
      "duration_seconds": 4.25,
      "text": "Right. I do love my midnight cheese. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.55,
      "end_seconds": 300.02,
      "duration_seconds": 4.47,
      "text": "The cheese will have to be earlier. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.16,
      "end_seconds": 304.6,
      "duration_seconds": 2.44,
      "text": "Oh dear. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.43,
      "end_seconds": 315.88,
      "duration_seconds": 8.45,
      "text": "I'd like to see you in six weeks to review how you are, and the test results."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.39,
      "end_seconds": 322.66,
      "duration_seconds": 4.27,
      "text": "Six weeks. Thank you very much, doctor. ~"
    }
  ]
}
