{
  "schema_version": "1.0",
  "encounter_id": "00842",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 2.52,
      "end_seconds": 8.72,
      "duration_seconds": 6.2,
      "text": "Mm. It's the winter. I get low. Every year. It's started again."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.83,
      "end_seconds": 15.7,
      "duration_seconds": 3.87,
      "text": "How long has it been this time?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.17,
      "end_seconds": 20.65,
      "duration_seconds": 2.48,
      "text": "Since October. Six weeks."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.94,
      "end_seconds": 27.35,
      "duration_seconds": 3.41,
      "text": "What's different from your normal self?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.58,
      "end_seconds": 36.65,
      "duration_seconds": 6.07,
      "text": "No energy. I sleep more. Eat more. Don't want to see anyone."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.02,
      "end_seconds": 43.29,
      "duration_seconds": 3.27,
      "text": "How's your concentration, at work?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.75,
      "end_seconds": 50.39,
      "duration_seconds": 4.64,
      "text": "Poor. I read the same page three times."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.9,
      "end_seconds": 57.01,
      "duration_seconds": 3.11,
      "text": "Any thoughts of harming yourself?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.92,
      "end_seconds": 63.71,
      "duration_seconds": 2.79,
      "text": "No. No, nothing like that."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.34,
      "end_seconds": 71.07,
      "duration_seconds": 4.73,
      "text": "Any thoughts that life's not worth living?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.2,
      "end_seconds": 75.14,
      "duration_seconds": 0.94,
      "text": "No."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.85,
      "end_seconds": 86.06,
      "duration_seconds": 7.21,
      "text": "And do you ever feel the opposite, very high, unable to sleep, full of ideas?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.75,
      "end_seconds": 91.91,
      "duration_seconds": 2.16,
      "text": "No. Never."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.89,
      "end_seconds": 99.87,
      "duration_seconds": 3.98,
      "text": "What are you taking at the moment?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.83,
      "end_seconds": 109.23,
      "duration_seconds": 6.4,
      "text": "Sertraline, 100 mg, maybe? Once a day. And vitamin D, 1000 units."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.81,
      "end_seconds": 118.02,
      "duration_seconds": 5.21,
      "text": "Is it 100 or 50, do you think?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.88,
      "end_seconds": 123.95,
      "duration_seconds": 3.07,
      "text": "I believe 100. The chemist knows."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.45,
      "end_seconds": 133.01,
      "duration_seconds": 6.56,
      "text": "I'll check on the record. Any conditions, apart from the winter lows?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.5,
      "end_seconds": 138.44,
      "duration_seconds": 2.94,
      "text": "Depression, years ago. And migraines."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.67,
      "end_seconds": 146.98,
      "duration_seconds": 5.31,
      "text": "Right. Is there anything in your life that's changed? ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.1,
      "end_seconds": 154.48,
      "duration_seconds": 4.38,
      "text": "Not really. Just the dark mornings. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.43,
      "end_seconds": 161.65,
      "duration_seconds": 4.22,
      "text": "Do you get outdoors at lunchtime? ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.33,
      "end_seconds": 174.98,
      "duration_seconds": 9.65,
      "text": "No. I work in an office. I leave in the dark, and come home in the dark. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.64,
      "end_seconds": 183.16,
      "duration_seconds": 5.52,
      "text": "Any breathlessness, or chest tightness, with the low mood?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.41,
      "end_seconds": 188.65,
      "duration_seconds": 2.24,
      "text": "No. Nothing physical."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.44,
      "end_seconds": 203.27,
      "duration_seconds": 11.83,
      "text": "What you describe, low mood every autumn and winter, with oversleeping and overeating, lifting in spring, fits seasonal affective disorder."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.76,
      "end_seconds": 209.44,
      "duration_seconds": 3.68,
      "text": "Is that a real thing? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.24,
      "end_seconds": 218.78,
      "duration_seconds": 6.54,
      "text": "It is, and it's common. It's linked to less daylight. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.54,
      "end_seconds": 225.83,
      "duration_seconds": 3.29,
      "text": "What can I do? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.45,
      "end_seconds": 239.27,
      "duration_seconds": 9.82,
      "text": "Get outdoors for half an hour at lunchtime, even if it's cloudy, and keep a regular sleep routine."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.6,
      "end_seconds": 246.07,
      "duration_seconds": 3.47,
      "text": "I could do that. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.66,
      "end_seconds": 259.87,
      "duration_seconds": 11.21,
      "text": "A light box, a bright light you sit in front of for thirty minutes each morning, has good evidence."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.37,
      "end_seconds": 265.73,
      "duration_seconds": 3.36,
      "text": "Can I buy one? ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.69,
      "end_seconds": 285.67,
      "duration_seconds": 15.98,
      "text": "Yes, look for one with 10,000 lux. And keep taking the sertraline. I'd like to arrange a blood test, to check your thyroid and vitamin D, as these can add to low mood."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.39,
      "end_seconds": 291.12,
      "duration_seconds": 1.73,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.77,
      "end_seconds": 301.01,
      "duration_seconds": 7.24,
      "text": "I'd like to see you in four weeks, to see how you're doing."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.34,
      "end_seconds": 305.99,
      "duration_seconds": 2.65,
      "text": "Four weeks. Thanks. ~"
    }
  ]
}
