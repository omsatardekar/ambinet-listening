{
  "schema_version": "1.0",
  "encounter_id": "00645",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.68,
      "end_seconds": 8.32,
      "duration_seconds": 7.64,
      "text": "Doctor, I have pain in my chest, since about one hour. Please, I am very scared."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.95,
      "end_seconds": 18.07,
      "duration_seconds": 8.12,
      "text": "Okay, I'm here. Let's take this step by step. Where is the pain, exactly?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.6,
      "end_seconds": 29.23,
      "duration_seconds": 8.63,
      "text": "Here, in the middle. It is like a pressure, or someone sitting on me."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.98,
      "end_seconds": 37.68,
      "duration_seconds": 6.7,
      "text": "Does it go anywhere, to the arm, the jaw, your back?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.54,
      "end_seconds": 46.54,
      "duration_seconds": 6.0,
      "text": "No, no. It stays in the middle. Not the arm."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.43,
      "end_seconds": 49.76,
      "duration_seconds": 2.33,
      "text": "Are you breathless?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.08,
      "end_seconds": 60.47,
      "duration_seconds": 9.39,
      "text": "A little breathless, no, not really. Not so much. Just the pressure and my heart is going fast."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.95,
      "end_seconds": 64.89,
      "duration_seconds": 2.94,
      "text": "Your heart racing, you mean?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.61,
      "end_seconds": 73.01,
      "duration_seconds": 6.4,
      "text": "Yes, like drumming. And I am sweating, look, my shirt is wet."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.84,
      "end_seconds": 87.76,
      "duration_seconds": 13.92,
      "text": "I can see that. Doctor to patient, I have to ask something honestly, and I'm not here to judge. Have you taken any drugs or anything unusual today?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.65,
      "end_seconds": 97.19,
      "duration_seconds": 7.54,
      "text": "Yes. Cocaine. I took cocaine about one hour before this started. I am sorry, doctor."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.25,
      "end_seconds": 107.33,
      "duration_seconds": 9.08,
      "text": "Thank you for telling me, that really helps me look after you. How much, roughly? ~"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.02,
      "end_seconds": 119.45,
      "duration_seconds": 9.43,
      "text": "Some lines, two, three. I do not do it often. First time this month. ~"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.52,
      "end_seconds": 123.7,
      "duration_seconds": 3.18,
      "text": "Understood. Any vomiting or feeling sick?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.57,
      "end_seconds": 132.03,
      "duration_seconds": 5.46,
      "text": "No vomiting. Only a little sick feeling, no, none."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.27,
      "end_seconds": 140.4,
      "duration_seconds": 6.13,
      "text": "And have you any medical conditions, or take any regular medicines?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.17,
      "end_seconds": 147.5,
      "duration_seconds": 6.33,
      "text": "I have asthma, and I use the salbutamol inhaler, only when needed."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.98,
      "end_seconds": 151.61,
      "duration_seconds": 1.63,
      "text": "Any operations?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.55,
      "end_seconds": 159.16,
      "duration_seconds": 4.61,
      "text": "I had my appendix removed, as a child."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.22,
      "end_seconds": 165.25,
      "duration_seconds": 5.03,
      "text": "Okay. I'm going to check your numbers now. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.85,
      "end_seconds": 169.39,
      "duration_seconds": 1.54,
      "text": "Please. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.17,
      "end_seconds": 191.26,
      "duration_seconds": 6.09,
      "text": "Pulse 118, blood pressure 152 over 94, oxygen 98 percent."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.17,
      "end_seconds": 197.17,
      "duration_seconds": 3.0,
      "text": "Is it dangerous? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.13,
      "end_seconds": 212.36,
      "duration_seconds": 14.23,
      "text": "Your heart is going fast and your pressure is up, which fits what cocaine does. I'm going to listen to your chest too."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.27,
      "end_seconds": 214.8,
      "duration_seconds": 1.53,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.5,
      "end_seconds": 235.15,
      "duration_seconds": 5.65,
      "text": "Your chest is clear and your skin is damp and clammy."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.68,
      "end_seconds": 241.53,
      "duration_seconds": 3.85,
      "text": "Am I having a heart attack? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.38,
      "end_seconds": 252.9,
      "duration_seconds": 10.52,
      "text": "I can't tell yet. The chest pain you describe, after cocaine, may well be cocaine-related, but I don't want to assume."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.65,
      "end_seconds": 257.67,
      "duration_seconds": 3.02,
      "text": "What will you do? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.83,
      "end_seconds": 267.83,
      "duration_seconds": 9.0,
      "text": "I'd like to do an ECG right now, to look at your heart's electrical tracing."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.05,
      "end_seconds": 271.65,
      "duration_seconds": 1.6,
      "text": "Yes. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.45,
      "end_seconds": 282.98,
      "duration_seconds": 10.53,
      "text": "I'm also going to order a troponin blood test, which shows heart muscle damage, and we'll repeat it after a few hours."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.61,
      "end_seconds": 287.8,
      "duration_seconds": 2.19,
      "text": "Yes, please. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.58,
      "end_seconds": 298.0,
      "duration_seconds": 8.42,
      "text": "And I'll get a chest X-ray to look at your lungs and the size of your heart."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.82,
      "end_seconds": 304.39,
      "duration_seconds": 5.57,
      "text": "I understand. Can I be helped for the fast heart? ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.61,
      "end_seconds": 323.15,
      "duration_seconds": 16.54,
      "text": "The team will look after you while we find out what's going on. Stay on the monitor, and tell the nurse straight away if the pain gets worse."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.07,
      "end_seconds": 329.36,
      "duration_seconds": 4.29,
      "text": "I will. Thank you, doctor. ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.11,
      "end_seconds": 336.42,
      "duration_seconds": 4.31,
      "text": "You did the right thing coming in. ~"
    }
  ]
}
