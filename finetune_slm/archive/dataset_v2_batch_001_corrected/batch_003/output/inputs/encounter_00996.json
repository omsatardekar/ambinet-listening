{
  "schema_version": "1.0",
  "encounter_id": "00996",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 5.01,
      "end_seconds": 13.68,
      "duration_seconds": 8.67,
      "text": "I've been sick all night. Nausea since about ten, and I've vomited four times."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.21,
      "end_seconds": 27.84,
      "duration_seconds": 8.63,
      "text": "Sorry to hear that. Let me ask a few things. Is it only vomiting, or diarrhoea as well?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.79,
      "end_seconds": 37.92,
      "duration_seconds": 5.13,
      "text": "Just vomiting. Four times, between midnight and five."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.19,
      "end_seconds": 45.78,
      "duration_seconds": 2.59,
      "text": "Any blood in it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.87,
      "end_seconds": 52.69,
      "duration_seconds": 1.82,
      "text": "No blood."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.62,
      "end_seconds": 59.14,
      "duration_seconds": 1.52,
      "text": "Any fever?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.14,
      "end_seconds": 65.93,
      "duration_seconds": 1.79,
      "text": "No fever."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.14,
      "end_seconds": 74.89,
      "duration_seconds": 3.75,
      "text": "What did you eat yesterday? ~"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.41,
      "end_seconds": 85.76,
      "duration_seconds": 5.35,
      "text": "Takeaway curry, about eight in the evening. ~"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.97,
      "end_seconds": 94.76,
      "duration_seconds": 3.79,
      "text": "Did anyone else have it? ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.19,
      "end_seconds": 103.7,
      "duration_seconds": 3.51,
      "text": "My partner, but she's fine. ~"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.66,
      "end_seconds": 110.89,
      "duration_seconds": 2.23,
      "text": "Any previous conditions?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.29,
      "end_seconds": 119.74,
      "duration_seconds": 3.45,
      "text": "Migraines. They also make me sick."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.86,
      "end_seconds": 128.17,
      "duration_seconds": 3.31,
      "text": "Any tummy problems in the family?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.78,
      "end_seconds": 136.34,
      "duration_seconds": 2.56,
      "text": "My father had gallstones."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.62,
      "end_seconds": 154.07,
      "duration_seconds": 5.45,
      "text": "Let me press your tummy. Tell me if it hurts."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.95,
      "end_seconds": 162.82,
      "duration_seconds": 3.87,
      "text": "Slightly, in the middle, up top. ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.06,
      "end_seconds": 175.01,
      "duration_seconds": 6.95,
      "text": "Your abdomen is soft, with mild tenderness in the upper middle."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.0,
      "end_seconds": 182.12,
      "duration_seconds": 2.12,
      "text": "That fits. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.71,
      "end_seconds": 200.57,
      "duration_seconds": 12.86,
      "text": "Here's what I'd suggest, without making a big thing of it. Sip fluids little and often. Oral rehydration drinks are best."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.57,
      "end_seconds": 207.9,
      "duration_seconds": 2.33,
      "text": "How much? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.79,
      "end_seconds": 219.38,
      "duration_seconds": 6.59,
      "text": "A few sips every five minutes, increasing as you tolerate. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.57,
      "end_seconds": 226.52,
      "duration_seconds": 1.95,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.6,
      "end_seconds": 237.96,
      "duration_seconds": 6.36,
      "text": "Avoid solid food for several hours, then try plain things, toast, rice."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.44,
      "end_seconds": 245.79,
      "duration_seconds": 2.35,
      "text": "And painkillers? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.37,
      "end_seconds": 257.76,
      "duration_seconds": 6.39,
      "text": "Avoid anti-inflammatories for now, as they irritate the stomach. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.21,
      "end_seconds": 265.3,
      "duration_seconds": 2.09,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.27,
      "end_seconds": 276.54,
      "duration_seconds": 6.27,
      "text": "Rest, and wash your hands carefully so nobody else catches it."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.65,
      "end_seconds": 283.76,
      "duration_seconds": 2.11,
      "text": "Will do. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.2,
      "end_seconds": 297.73,
      "duration_seconds": 8.53,
      "text": "If you can't keep fluids down for 24 hours, come back and see me."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.19,
      "end_seconds": 306.01,
      "duration_seconds": 2.82,
      "text": "I will. Thanks. ~"
    }
  ]
}
