{
  "schema_version": "1.0",
  "encounter_id": "00655",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 0.62,
      "end_seconds": 12.15,
      "duration_seconds": 11.53,
      "text": "Doctor, this is Josh Whelan, twenty-six, brought in by ambulance after a first fit at home. He's been a bit muddled, but he's coming round."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.56,
      "end_seconds": 21.02,
      "duration_seconds": 7.46,
      "text": "Thanks, Jenny. Josh, can you hear me? I'm Dr Park. You're in hospital, you're safe. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.73,
      "end_seconds": 33.79,
      "duration_seconds": 11.06,
      "text": "Yeah. Yeah, I can hear you. What happened? I've got a headache and I feel like I've been hit by a bus."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.72,
      "end_seconds": 43.97,
      "duration_seconds": 7.25,
      "text": "That's what we're here to work out. What's the last thing you remember? ~"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.97,
      "end_seconds": 57.17,
      "duration_seconds": 10.2,
      "text": "Making toast. Then nothing. Then the ambos were there. I don't even know how I got on the floor. ~"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 59.08,
      "end_seconds": 71.55,
      "duration_seconds": 12.47,
      "text": "Paramedics say his flatmate saw him shaking all over for about two minutes, went stiff first, and he wasn't responding."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.6,
      "end_seconds": 79.76,
      "duration_seconds": 7.16,
      "text": "Thank you, Jenny. Josh, you bit your tongue, I see. Does it hurt?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.39,
      "end_seconds": 86.4,
      "duration_seconds": 4.01,
      "text": "Yeah, it's sore. Tastes like blood."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.99,
      "end_seconds": 93.15,
      "duration_seconds": 5.16,
      "text": "Have you banged your head, did you fall hard?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.36,
      "end_seconds": 105.71,
      "duration_seconds": 11.35,
      "text": "I don't think so. I don't remember, but nothing hurts on my head except the headache. No bump that I can feel."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.71,
      "end_seconds": 113.65,
      "duration_seconds": 5.94,
      "text": "Have you been unwell lately, any fever, any infection?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.6,
      "end_seconds": 121.17,
      "duration_seconds": 6.57,
      "text": "No fever. I've been fine. No, I've been fine all week."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.0,
      "end_seconds": 126.63,
      "duration_seconds": 2.63,
      "text": "Any allergies to medicines?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.96,
      "end_seconds": 129.88,
      "duration_seconds": 1.92,
      "text": "No. None."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.88,
      "end_seconds": 136.39,
      "duration_seconds": 3.51,
      "text": "What do you take, if anything?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.39,
      "end_seconds": 145.84,
      "duration_seconds": 6.45,
      "text": "Just my sertraline, 50 mg once a day. For anxiety."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.61,
      "end_seconds": 154.84,
      "duration_seconds": 6.23,
      "text": "And anxiety is the only condition you've been told about?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.78,
      "end_seconds": 162.94,
      "duration_seconds": 7.16,
      "text": "Yeah. Look, can I just go home? I've got work at four. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.5,
      "end_seconds": 175.96,
      "duration_seconds": 10.46,
      "text": "I'm afraid not today, Josh. When someone has a first seizure we need to check a few things first. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 177.89,
      "end_seconds": 186.79,
      "duration_seconds": 8.9,
      "text": "Doctor, I've got his mum on the phone. She wants to know if she can come in. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.72,
      "end_seconds": 193.19,
      "duration_seconds": 4.47,
      "text": "Yes please, Lin, bring her straight through. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 195.07,
      "end_seconds": 199.31,
      "duration_seconds": 4.24,
      "text": "I'll go and meet her at reception. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 202.17,
      "end_seconds": 204.9,
      "duration_seconds": 2.73,
      "text": "Doctor, Josh's observations. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.32,
      "end_seconds": 209.67,
      "duration_seconds": 2.35,
      "text": "Go on. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 231.45,
      "end_seconds": 242.17,
      "duration_seconds": 10.72,
      "text": "Blood pressure 128 over 78, pulse 96, temperature 36.9, oxygen 98 percent, respiratory rate 16, and a sugar of 5.4."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.79,
      "end_seconds": 252.5,
      "duration_seconds": 7.71,
      "text": "Thanks. Josh, I'm going to check your eyes, your strength, and your balance. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.7,
      "end_seconds": 256.7,
      "duration_seconds": 2.0,
      "text": "Fine. Whatever. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.65,
      "end_seconds": 289.87,
      "duration_seconds": 6.22,
      "text": "Follow my finger. Good. Squeeze both my hands. And touch your nose."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.61,
      "end_seconds": 294.38,
      "duration_seconds": 2.77,
      "text": "Is that all right? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.82,
      "end_seconds": 308.34,
      "duration_seconds": 11.52,
      "text": "You're awake and oriented, you've bitten the side of your tongue, and your strength, reflexes and coordination are all normal."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.25,
      "end_seconds": 314.45,
      "duration_seconds": 3.2,
      "text": "So what was it? ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.74,
      "end_seconds": 325.89,
      "duration_seconds": 10.15,
      "text": "I can't say yet. A first seizure has a number of possible causes, and I don't want to guess. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.3,
      "end_seconds": 330.04,
      "duration_seconds": 1.74,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.43,
      "end_seconds": 343.96,
      "duration_seconds": 11.53,
      "text": "I'd like to arrange a CT scan of your head, and the neurology team will see you before you leave."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.85,
      "end_seconds": 350.17,
      "duration_seconds": 3.32,
      "text": "Do I need a scan? ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.56,
      "end_seconds": 363.46,
      "duration_seconds": 10.9,
      "text": "Yes. Even though you seem well, it's standard after a first seizure. Your mum can come with you. ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 364.36,
      "end_seconds": 367.38,
      "duration_seconds": 3.02,
      "text": "Okay. I guess. ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.85,
      "end_seconds": 378.03,
      "duration_seconds": 9.18,
      "text": "Until the neurologists have seen you, you must not drive, and no baths on your own, showers only."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 379.07,
      "end_seconds": 384.53,
      "duration_seconds": 5.46,
      "text": "I can't drive? I need the car for work. ~"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 386.5,
      "end_seconds": 394.19,
      "duration_seconds": 7.69,
      "text": "I know it's hard. But until they say otherwise, no driving. ~"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 396.97,
      "end_seconds": 399.05,
      "duration_seconds": 2.08,
      "text": "Right. Ugh. ~"
    }
  ]
}
