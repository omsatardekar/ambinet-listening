{
  "schema_version": "1.0",
  "encounter_id": "00822",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 0.39,
      "end_seconds": 11.55,
      "duration_seconds": 11.16,
      "text": "Mr Hegarty? Hello! I'm Mairead. Roll up that sleeve and I'll do your blood pressure, and your temperature, and so on. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.64,
      "end_seconds": 28.89,
      "duration_seconds": 15.25,
      "text": "Ah, grand, grand. I'll tell you everything while you do it. I've had this throat for months, and I'll talk about the weather, I don't mind. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 45.53,
      "end_seconds": 53.23,
      "duration_seconds": 7.7,
      "text": "Blood pressure 136 over 82, pulse 74, temperature 36.7, oxygen 98 percent, weight 80 kilos."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.67,
      "end_seconds": 62.54,
      "duration_seconds": 6.87,
      "text": "Good morning, Mr Hegarty. It's the sore throat, isn't it? How is it now?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.38,
      "end_seconds": 76.69,
      "duration_seconds": 13.31,
      "text": "Still there. It's five months now, the sore throat, on and off, and sometimes it's hard to swallow, like there's a lump in it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.59,
      "end_seconds": 79.53,
      "duration_seconds": 1.94,
      "text": "Which side?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.09,
      "end_seconds": 87.48,
      "duration_seconds": 6.39,
      "text": "The right, mainly. And I've a hoarse voice, as well, since Christmas."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.33,
      "end_seconds": 92.27,
      "duration_seconds": 3.94,
      "text": "Any pain going to your ear? ~"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.84,
      "end_seconds": 97.11,
      "duration_seconds": 3.27,
      "text": "Sometimes, the right ear. ~"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.88,
      "end_seconds": 103.54,
      "duration_seconds": 4.66,
      "text": "Any blood in your spit, or weight loss?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.68,
      "end_seconds": 108.81,
      "duration_seconds": 3.13,
      "text": "No blood. No weight loss."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.96,
      "end_seconds": 115.52,
      "duration_seconds": 4.56,
      "text": "Any lump in your neck that you've noticed?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.85,
      "end_seconds": 121.39,
      "duration_seconds": 3.54,
      "text": "No lump. I've felt, nothing."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.95,
      "end_seconds": 126.38,
      "duration_seconds": 3.43,
      "text": "What tablets are you taking?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.4,
      "end_seconds": 137.35,
      "duration_seconds": 8.95,
      "text": "Omeprazole, 20 mg, every morning. Amlodipine, 5 mg. And a statin, simvastatin, 20 mg, at night."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.88,
      "end_seconds": 141.33,
      "duration_seconds": 1.45,
      "text": "Any allergies?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.9,
      "end_seconds": 146.71,
      "duration_seconds": 3.81,
      "text": "Penicillin. I came out in a rash."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.63,
      "end_seconds": 150.01,
      "duration_seconds": 2.38,
      "text": "And your history?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.58,
      "end_seconds": 157.45,
      "duration_seconds": 4.87,
      "text": "Acid reflux, high blood pressure, and high cholesterol."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.35,
      "end_seconds": 166.41,
      "duration_seconds": 7.06,
      "text": "Do you have a family history of throat or neck cancer?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.37,
      "end_seconds": 176.62,
      "duration_seconds": 8.25,
      "text": "My father had cancer of the voice box, he smoked eighty a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.52,
      "end_seconds": 182.47,
      "duration_seconds": 3.95,
      "text": "And do you smoke or drink?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.44,
      "end_seconds": 194.12,
      "duration_seconds": 10.68,
      "text": "I gave it up in 2015, after the heart scare. And a few pints at the weekend."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.74,
      "end_seconds": 207.85,
      "duration_seconds": 11.11,
      "text": "Right. Because it's been five months, and you have a hoarse voice, I need to look properly. Let me feel your neck. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.42,
      "end_seconds": 230.51,
      "duration_seconds": 2.09,
      "text": "Go on."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 232.14,
      "end_seconds": 236.88,
      "duration_seconds": 4.74,
      "text": "I'll get the camera ready, doctor. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.67,
      "end_seconds": 242.51,
      "duration_seconds": 4.84,
      "text": "Thanks, Mairead. There's no lump in your neck. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.65,
      "end_seconds": 246.01,
      "duration_seconds": 2.36,
      "text": "That's a relief. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.87,
      "end_seconds": 269.85,
      "duration_seconds": 21.98,
      "text": "But the hoarseness and the sore throat for that long, in someone with a smoking history, need a proper look with a camera. I'd say this could be reflux irritating the voice box, but I can't rule out something more serious, like a growth."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.18,
      "end_seconds": 273.01,
      "duration_seconds": 1.83,
      "text": "Cancer? ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.73,
      "end_seconds": 291.31,
      "duration_seconds": 17.58,
      "text": "I don't think so, but I must be sure. I'd like to refer you urgently to the ENT clinic, to have a camera passed through your nose to see your voice box."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.45,
      "end_seconds": 295.41,
      "duration_seconds": 1.96,
      "text": "When? ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.26,
      "end_seconds": 299.42,
      "duration_seconds": 3.16,
      "text": "Within two weeks. They'll write. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.67,
      "end_seconds": 303.57,
      "duration_seconds": 1.9,
      "text": "Fine. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.6,
      "end_seconds": 314.39,
      "duration_seconds": 9.79,
      "text": "In the meantime, keep taking the omeprazole, avoid late meals, alcohol and spicy food, and don't clear your throat or whisper."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.32,
      "end_seconds": 319.16,
      "duration_seconds": 1.84,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.98,
      "end_seconds": 328.93,
      "duration_seconds": 7.95,
      "text": "I'd also like a chest X-ray, as a precaution, because of your smoking history."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.26,
      "end_seconds": 331.97,
      "duration_seconds": 1.71,
      "text": "Fine. ~"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.28,
      "end_seconds": 342.62,
      "duration_seconds": 8.34,
      "text": "I'd like to see you again in three weeks, once ENT have seen you."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.52,
      "end_seconds": 347.01,
      "duration_seconds": 3.49,
      "text": "Three weeks. Thank you. ~"
    }
  ]
}
