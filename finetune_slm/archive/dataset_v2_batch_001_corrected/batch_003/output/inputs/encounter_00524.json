{
  "schema_version": "1.0",
  "encounter_id": "00524",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 1.05,
      "end_seconds": 15.98,
      "duration_seconds": 14.93,
      "text": "Come in, sit down. I have the note here from your last visit, and the letter from the hospital about your father. I'm very sorry for your loss."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.05,
      "end_seconds": 21.35,
      "duration_seconds": 4.3,
      "text": "Thanks. It's been a rough few weeks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.12,
      "end_seconds": 33.86,
      "duration_seconds": 9.74,
      "text": "I'm sure it has. You asked for this appointment yourself. What was on your mind when you booked it?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.68,
      "end_seconds": 40.37,
      "duration_seconds": 3.69,
      "text": "Sleep, mostly. I'm not getting any."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.94,
      "end_seconds": 51.32,
      "duration_seconds": 8.38,
      "text": "Tell me what the sleep is like. Do you struggle to get off, or do you wake?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.44,
      "end_seconds": 63.14,
      "duration_seconds": 9.7,
      "text": "I get off grand. Then I'm awake at four in the morning, wide awake, and that's me for the day."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.81,
      "end_seconds": 73.53,
      "duration_seconds": 8.72,
      "text": "Awake at four and not getting back. How long has that been going on?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.12,
      "end_seconds": 79.19,
      "duration_seconds": 4.07,
      "text": "Since the funeral. Three weeks, near enough."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.34,
      "end_seconds": 88.21,
      "duration_seconds": 6.87,
      "text": "Okay. And what happens in your head at four in the morning?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.98,
      "end_seconds": 100.02,
      "duration_seconds": 9.04,
      "text": "Just going over things. The last week in the hospital. Whether I should have pushed them more."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.7,
      "end_seconds": 113.06,
      "duration_seconds": 10.36,
      "text": "That's a heavy thing to go over in the dark. Apart from the sleep, how's your mood in general?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.05,
      "end_seconds": 119.01,
      "duration_seconds": 3.96,
      "text": "Low. I'm feeling low, I suppose."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.05,
      "end_seconds": 129.7,
      "duration_seconds": 8.65,
      "text": "When did you first notice the low feeling? Was it after your father died, or before it?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.75,
      "end_seconds": 142.09,
      "duration_seconds": 10.34,
      "text": "I couldn't tell you. It might've been there before, when he was getting worse. I don't know."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.14,
      "end_seconds": 154.08,
      "duration_seconds": 9.94,
      "text": "That's fair enough, it's hard to separate out. We'll leave the date open and not force it."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.44,
      "end_seconds": 156.71,
      "duration_seconds": 1.27,
      "text": "Yeah."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.99,
      "end_seconds": 167.13,
      "duration_seconds": 9.14,
      "text": "I have to ask this of everyone in your position. Have you had any thoughts of harming yourself?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.18,
      "end_seconds": 172.81,
      "duration_seconds": 4.63,
      "text": "No. Never. I've the kids to think of."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.97,
      "end_seconds": 182.95,
      "duration_seconds": 8.98,
      "text": "Good, I'm glad you told me. Now, your health in general. Anything long-term I should know about?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.15,
      "end_seconds": 189.04,
      "duration_seconds": 4.89,
      "text": "Asthma. Since I was a child. It's been quiet."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.58,
      "end_seconds": 202.06,
      "duration_seconds": 11.48,
      "text": "Asthma, quiet at the moment. Good. And family history, what did your father die of, if you don't mind me asking?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.06,
      "end_seconds": 208.4,
      "duration_seconds": 4.34,
      "text": "Lung cancer. He smoked all his life."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.3,
      "end_seconds": 217.64,
      "duration_seconds": 6.34,
      "text": "I'm sorry. Anyone else in the family with a serious illness?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.23,
      "end_seconds": 224.41,
      "duration_seconds": 5.18,
      "text": "My sister had breast cancer. She's well now, thank God."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.71,
      "end_seconds": 235.24,
      "duration_seconds": 9.53,
      "text": "Glad to hear she's well. What about work and home, who's around you at the moment?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.96,
      "end_seconds": 244.57,
      "duration_seconds": 8.61,
      "text": "I run the farm with my husband. Two kids at home, they're ten and thirteen."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.66,
      "end_seconds": 258.5,
      "duration_seconds": 11.84,
      "text": "So you're busy with the farm and the children. And are you leaning on anything to get through the evenings, drink or otherwise?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.5,
      "end_seconds": 267.35,
      "duration_seconds": 7.85,
      "text": "I'm drinking a bit more in the evenings. A glass of whiskey, maybe two."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.38,
      "end_seconds": 279.13,
      "duration_seconds": 10.75,
      "text": "Thank you for being straight with me. That's common after a death, but it can make the four a.m. waking worse."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.41,
      "end_seconds": 283.32,
      "duration_seconds": 2.91,
      "text": "I'd say it does."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.56,
      "end_seconds": 307.21,
      "duration_seconds": 21.65,
      "text": "Right, let me lay out the options. One, we talk about sleep habits and I give you some practical things to try. Two, I refer you to the bereavement counselling service. Three, we check your bloods in case something physical is adding to it."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.62,
      "end_seconds": 313.79,
      "duration_seconds": 4.17,
      "text": "What would the bloods be looking for?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.7,
      "end_seconds": 327.31,
      "duration_seconds": 11.61,
      "text": "Mainly your thyroid and your iron, and a general screen. Tiredness and low mood can have a physical side, and it's easy to rule out."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.24,
      "end_seconds": 331.09,
      "duration_seconds": 2.85,
      "text": "Do the bloods, then."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.79,
      "end_seconds": 343.7,
      "duration_seconds": 10.91,
      "text": "I'll order the blood tests for you, and you can have them done at the front desk before you go."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.36,
      "end_seconds": 347.58,
      "duration_seconds": 2.22,
      "text": "Grand. And the counselling?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.97,
      "end_seconds": 361.02,
      "duration_seconds": 12.05,
      "text": "I'd recommend it. I'll refer you to the bereavement service, and they'll ring you within a fortnight. Would you be happy to talk to someone?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 362.76,
      "end_seconds": 369.67,
      "duration_seconds": 6.91,
      "text": "I'd rather not, but I'll give it a go. Mam says I should."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.57,
      "end_seconds": 388.95,
      "duration_seconds": 17.38,
      "text": "Your mam sounds sensible. Now, on the sleep. No screens in the last hour, same time to bed every night, and keep the whiskey for the weekend, if at all."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 391.16,
      "end_seconds": 393.91,
      "duration_seconds": 2.75,
      "text": "I can try that."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 394.61,
      "end_seconds": 411.65,
      "duration_seconds": 17.04,
      "text": "Don't lie in bed fighting it either. If you're awake at four, get up, have a cup of tea in the kitchen and sit with a book, then go back when you're drowsy."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 412.87,
      "end_seconds": 418.78,
      "duration_seconds": 5.91,
      "text": "The cows would be glad of the company anyway."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 421.28,
      "end_seconds": 434.63,
      "duration_seconds": 13.35,
      "text": "Ha, they would. And I'm not going to put you on tablets today. It's early, and the first thing is to give the other steps a fair try."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 436.01,
      "end_seconds": 439.51,
      "duration_seconds": 3.5,
      "text": "That suits me. I don't like tablets."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 441.9,
      "end_seconds": 455.23,
      "duration_seconds": 13.33,
      "text": "Understood. I'd like to see you again in three weeks, to see how the sleep is, and to go through the blood results."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 457.18,
      "end_seconds": 462.05,
      "duration_seconds": 4.87,
      "text": "Three weeks. I'll have the hay in by then."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 464.43,
      "end_seconds": 473.02,
      "duration_seconds": 8.59,
      "text": "Good. If things feel worse before that, ring the surgery and ask for me. Don't wait it out."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 475.04,
      "end_seconds": 476.93,
      "duration_seconds": 1.89,
      "text": "I will."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 479.44,
      "end_seconds": 485.34,
      "duration_seconds": 5.9,
      "text": "Is there anything you wanted to ask that we haven't covered?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 487.0,
      "end_seconds": 491.65,
      "duration_seconds": 4.65,
      "text": "Not really. It's helped to say it out loud."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 493.88,
      "end_seconds": 497.46,
      "duration_seconds": 3.58,
      "text": "I'm glad. It often does."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 499.67,
      "end_seconds": 504.64,
      "duration_seconds": 4.97,
      "text": "Right so. I'll head and get the bloods."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 506.74,
      "end_seconds": 511.41,
      "duration_seconds": 4.67,
      "text": "Go on, mind yourself. See you in three weeks."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 512.16,
      "end_seconds": 513.88,
      "duration_seconds": 1.72,
      "text": "Thanks, doctor."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 515.68,
      "end_seconds": 517.27,
      "duration_seconds": 1.59,
      "text": "Safe home."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 520.04,
      "end_seconds": 521.64,
      "duration_seconds": 1.6,
      "text": "Bye now."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 524.06,
      "end_seconds": 525.02,
      "duration_seconds": 0.96,
      "text": "Bye."
    }
  ]
}
