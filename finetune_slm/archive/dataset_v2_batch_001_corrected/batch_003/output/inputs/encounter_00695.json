{
  "schema_version": "1.0",
  "encounter_id": "00695",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 0.95,
      "end_seconds": 10.96,
      "duration_seconds": 10.01,
      "text": "Mr Chandra, I've put your driving licence details on the system, the doctor will ask about that. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.44,
      "end_seconds": 20.47,
      "duration_seconds": 7.03,
      "text": "Thank you. I am a taxi driver, so this matters very much. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.21,
      "end_seconds": 29.29,
      "duration_seconds": 6.08,
      "text": "Good morning, Mr Chandra. Tell me what's been happening. ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.05,
      "end_seconds": 42.78,
      "duration_seconds": 12.73,
      "text": "Doctor, I have strange episodes. I get a feeling of dÃ©jÃ  vu, like I have lived this moment before. It lasts a minute, maybe two."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.41,
      "end_seconds": 47.81,
      "duration_seconds": 3.4,
      "text": "How often does that happen?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.53,
      "end_seconds": 54.72,
      "duration_seconds": 5.19,
      "text": "Four or five times, since January. Last week, twice."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.68,
      "end_seconds": 58.66,
      "duration_seconds": 2.98,
      "text": "Does anything come with it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.64,
      "end_seconds": 69.59,
      "duration_seconds": 8.95,
      "text": "A smell. Like burning toast, but there is no toast. It comes right before the feeling."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.68,
      "end_seconds": 77.89,
      "duration_seconds": 7.21,
      "text": "And during the episode, are you aware of what's going on around you?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.89,
      "end_seconds": 91.33,
      "duration_seconds": 12.44,
      "text": "Partly. I am staring, my wife says. I do not answer her for a minute or so. And I feel confused, a bit, afterwards."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.42,
      "end_seconds": 96.32,
      "duration_seconds": 3.9,
      "text": "Have you ever lost consciousness, or collapsed?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.27,
      "end_seconds": 105.23,
      "duration_seconds": 5.96,
      "text": "No. I did not fall. I always stayed on my feet."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.78,
      "end_seconds": 110.56,
      "duration_seconds": 3.78,
      "text": "Any biting your tongue, or wetting yourself?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.55,
      "end_seconds": 116.74,
      "duration_seconds": 3.19,
      "text": "No. None of that."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.65,
      "end_seconds": 123.61,
      "duration_seconds": 4.96,
      "text": "Any headache after, or a head injury before this started?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.47,
      "end_seconds": 128.59,
      "duration_seconds": 3.12,
      "text": "No headache. No injury."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.87,
      "end_seconds": 133.3,
      "duration_seconds": 3.43,
      "text": "What about your health in general?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.09,
      "end_seconds": 145.07,
      "duration_seconds": 9.98,
      "text": "High blood pressure for ten years, and I had meningitis as a boy, at nine years old."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.17,
      "end_seconds": 151.14,
      "duration_seconds": 3.97,
      "text": "Interesting, that's relevant. And your medicines?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.89,
      "end_seconds": 159.73,
      "duration_seconds": 6.84,
      "text": "Amlodipine, 5 mg once a day, and atorvastatin, 20 mg at night."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.25,
      "end_seconds": 167.95,
      "duration_seconds": 6.7,
      "text": "Who do you live with, and how many hours do you drive?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.02,
      "end_seconds": 179.71,
      "duration_seconds": 10.69,
      "text": "I live with my wife and daughter. And I drive twelve hours a day, six days a week."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.15,
      "end_seconds": 185.79,
      "duration_seconds": 4.64,
      "text": "I'll look at your reflexes and balance. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.05,
      "end_seconds": 213.94,
      "duration_seconds": 1.89,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.53,
      "end_seconds": 219.83,
      "duration_seconds": 4.3,
      "text": "Your coordination, strength and reflexes are normal."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.87,
      "end_seconds": 223.58,
      "duration_seconds": 2.71,
      "text": "So what is it? ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.7,
      "end_seconds": 234.54,
      "duration_seconds": 9.84,
      "text": "Brief episodes with a smell beforehand, dÃ©jÃ  vu, staring and confusion afterwards, they sound like focal seizures from the temporal lobe."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.77,
      "end_seconds": 238.97,
      "duration_seconds": 2.2,
      "text": "Seizures? Epilepsy? ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.68,
      "end_seconds": 250.85,
      "duration_seconds": 11.17,
      "text": "I can't confirm that without tests. I'd like to arrange an EEG, a brainwave recording, and an MRI scan of your brain."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 253.42,
      "end_seconds": 259.65,
      "duration_seconds": 6.23,
      "text": "I'll book them both for the coming weeks, Mr Chandra. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.19,
      "end_seconds": 268.87,
      "duration_seconds": 7.68,
      "text": "The important thing is driving. Until you've seen the neurologist, I'm advising you not to drive."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.47,
      "end_seconds": 274.47,
      "duration_seconds": 4.0,
      "text": "Doctor, it is my living. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.05,
      "end_seconds": 285.2,
      "duration_seconds": 9.15,
      "text": "I know. I'm sorry. The rules are firm, and it protects you and your passengers. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 287.45,
      "end_seconds": 296.02,
      "duration_seconds": 8.57,
      "text": "I can give you the DVLA leaflet and our letter for your insurance, if it helps. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.36,
      "end_seconds": 300.99,
      "duration_seconds": 2.63,
      "text": "Thank you. Yes. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.76,
      "end_seconds": 312.54,
      "duration_seconds": 10.78,
      "text": "If you have another episode, or any collapse, don't wait, come in or go to the emergency department."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.45,
      "end_seconds": 315.83,
      "duration_seconds": 2.38,
      "text": "I understand. ~"
    }
  ]
}
