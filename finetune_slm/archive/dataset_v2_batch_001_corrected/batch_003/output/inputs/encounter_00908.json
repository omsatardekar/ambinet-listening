{
  "schema_version": "1.0",
  "encounter_id": "00908",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.36,
      "end_seconds": 10.81,
      "duration_seconds": 9.45,
      "text": "Morning. I want to stop smoking, and I need help, because I can't do it on my own."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.42,
      "end_seconds": 23.9,
      "duration_seconds": 10.48,
      "text": "That's a great decision, and I'm glad you came. How much do you smoke at the moment?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.45,
      "end_seconds": 31.18,
      "duration_seconds": 5.73,
      "text": "About twenty a day. Sometimes more when I'm stressed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.21,
      "end_seconds": 35.46,
      "duration_seconds": 3.25,
      "text": "How long have you been smoking?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.99,
      "end_seconds": 41.38,
      "duration_seconds": 4.39,
      "text": "Since I was seventeen. So, twenty-two years."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.79,
      "end_seconds": 48.76,
      "duration_seconds": 4.97,
      "text": "Have you tried to quit before? ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.53,
      "end_seconds": 60.4,
      "duration_seconds": 8.87,
      "text": "Twice. Once with patches, and once cold turkey. I lasted a week each time. ~"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.56,
      "end_seconds": 65.49,
      "duration_seconds": 3.93,
      "text": "What made you go back? ~"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.2,
      "end_seconds": 71.87,
      "duration_seconds": 4.67,
      "text": "Stress at work, and my partner smokes too. ~"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.73,
      "end_seconds": 80.04,
      "duration_seconds": 6.31,
      "text": "Do you cough in the mornings, or get breathless on the stairs?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.56,
      "end_seconds": 90.22,
      "duration_seconds": 7.66,
      "text": "A bit breathless on the stairs, yes. And a smoker's cough in the morning."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.05,
      "end_seconds": 96.21,
      "duration_seconds": 4.16,
      "text": "Any chest pain, or coughing up blood?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.52,
      "end_seconds": 100.96,
      "duration_seconds": 2.44,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.94,
      "end_seconds": 109.17,
      "duration_seconds": 5.23,
      "text": "Are you on any medication at the moment?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.29,
      "end_seconds": 115.1,
      "duration_seconds": 4.81,
      "text": "Just an inhaler, the blue one, when I'm wheezy."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.17,
      "end_seconds": 123.4,
      "duration_seconds": 5.23,
      "text": "Let me check your pulse, pressure and oxygen level. ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.98,
      "end_seconds": 137.2,
      "duration_seconds": 1.22,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.57,
      "end_seconds": 145.57,
      "duration_seconds": 7.0,
      "text": "Pulse 80, blood pressure 130 over 84, oxygen saturation 97 percent, temperature 36.6."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.19,
      "end_seconds": 151.58,
      "duration_seconds": 3.39,
      "text": "Is that all right? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.72,
      "end_seconds": 162.16,
      "duration_seconds": 8.44,
      "text": "Reasonable. I'd like to listen to your chest. Take a few deep breaths for me. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.62,
      "end_seconds": 183.03,
      "duration_seconds": 2.41,
      "text": "In and out?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.72,
      "end_seconds": 196.7,
      "duration_seconds": 10.98,
      "text": "There is a mild wheeze at the bottom of both lungs, and the breath sounds are otherwise normal."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.69,
      "end_seconds": 202.42,
      "duration_seconds": 3.73,
      "text": "That's the smoking, isn't it? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.74,
      "end_seconds": 210.21,
      "duration_seconds": 6.47,
      "text": "It is likely to be contributing. Stopping will help it settle."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.05,
      "end_seconds": 215.23,
      "duration_seconds": 3.18,
      "text": "What are my options, doctor? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.77,
      "end_seconds": 229.93,
      "duration_seconds": 12.16,
      "text": "There are nicotine patches and gum together, or a tablet called varenicline. I'd suggest we start with varenicline and combine it with support."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.06,
      "end_seconds": 235.02,
      "duration_seconds": 3.96,
      "text": "Does it have side effects? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.71,
      "end_seconds": 247.92,
      "duration_seconds": 11.21,
      "text": "Some people get nausea or strange dreams. Take it after food with a full glass of water. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.94,
      "end_seconds": 254.21,
      "duration_seconds": 3.27,
      "text": "I can manage that. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.32,
      "end_seconds": 265.25,
      "duration_seconds": 7.93,
      "text": "I'll prescribe varenicline, 0.5 mg once a day for three days, then it goes up."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.42,
      "end_seconds": 270.37,
      "duration_seconds": 3.95,
      "text": "And when do I stop smoking? ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.0,
      "end_seconds": 283.18,
      "duration_seconds": 10.18,
      "text": "Pick a quit date in the second week, and take the tablets for the first week before that."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.48,
      "end_seconds": 289.41,
      "duration_seconds": 4.93,
      "text": "Okay. I'm going to say the fifteenth. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.37,
      "end_seconds": 299.91,
      "duration_seconds": 9.54,
      "text": "That's good. I'd also like to see you again in two weeks, to see how it is going."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.05,
      "end_seconds": 306.01,
      "duration_seconds": 3.96,
      "text": "Two weeks, then. Thanks, doctor. ~"
    }
  ]
}
