{
  "schema_version": "1.0",
  "encounter_id": "00901",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 3.41,
      "end_seconds": 13.87,
      "duration_seconds": 10.46,
      "text": "I'm here for the follow-up after my kidney stone procedure. I don't have long, so can we get on with it?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.63,
      "end_seconds": 23.18,
      "duration_seconds": 5.55,
      "text": "Of course. Can you remind me when the procedure was?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.59,
      "end_seconds": 36.08,
      "duration_seconds": 8.49,
      "text": "A few weeks ago. Maybe three, maybe four. I've lost track since the stent came out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.84,
      "end_seconds": 45.6,
      "duration_seconds": 5.76,
      "text": "How have you been since then? Any pain in the side?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.39,
      "end_seconds": 53.95,
      "duration_seconds": 4.56,
      "text": "No pain in the side. Not like before."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.32,
      "end_seconds": 61.51,
      "duration_seconds": 3.19,
      "text": "Any blood in the urine?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.97,
      "end_seconds": 69.67,
      "duration_seconds": 4.7,
      "text": "Pink the first few days, but it's gone now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.21,
      "end_seconds": 78.02,
      "duration_seconds": 3.81,
      "text": "Any burning when passing urine, or fever?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.94,
      "end_seconds": 84.19,
      "duration_seconds": 2.25,
      "text": "No burning. No fever."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.54,
      "end_seconds": 91.73,
      "duration_seconds": 4.19,
      "text": "How often are you passing urine?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.32,
      "end_seconds": 100.91,
      "duration_seconds": 4.59,
      "text": "More often than usual, and urgent. It's irritating."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.41,
      "end_seconds": 111.17,
      "duration_seconds": 5.76,
      "text": "That can happen after a stent. What medicines are you taking?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.74,
      "end_seconds": 119.67,
      "duration_seconds": 4.93,
      "text": "Just tamsulosin, 400 micrograms, once a day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.35,
      "end_seconds": 127.51,
      "duration_seconds": 4.16,
      "text": "Do you have any allergies to medicines?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.88,
      "end_seconds": 135.05,
      "duration_seconds": 3.17,
      "text": "No, I don't have any."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.16,
      "end_seconds": 141.73,
      "duration_seconds": 2.57,
      "text": "Any other conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.36,
      "end_seconds": 148.43,
      "duration_seconds": 3.07,
      "text": "Gout, and high blood pressure."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 152.61,
      "end_seconds": 158.83,
      "duration_seconds": 6.22,
      "text": "Doctor, I've taken his pulse and pressure, 74 and 132 over 80."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.26,
      "end_seconds": 169.72,
      "duration_seconds": 6.46,
      "text": "Thank you. That's fine. Have you been drinking plenty of water? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.51,
      "end_seconds": 177.66,
      "duration_seconds": 4.15,
      "text": "I try to, about two litres. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.18,
      "end_seconds": 192.06,
      "duration_seconds": 9.88,
      "text": "That's good. The stone went to the lab. The result came back as a calcium oxalate stone."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.26,
      "end_seconds": 200.52,
      "duration_seconds": 4.26,
      "text": "What does that mean for me? ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.88,
      "end_seconds": 214.18,
      "duration_seconds": 9.3,
      "text": "It's the most common type. Drinking enough water, less salt, and moderate animal protein all help."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.63,
      "end_seconds": 221.45,
      "duration_seconds": 3.82,
      "text": "Fine. I can do that. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.84,
      "end_seconds": 231.23,
      "duration_seconds": 5.39,
      "text": "I'd like to examine your tummy and loin now. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.78,
      "end_seconds": 248.55,
      "duration_seconds": 1.77,
      "text": "Go on."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.83,
      "end_seconds": 259.05,
      "duration_seconds": 6.22,
      "text": "No tenderness in either loin, and your abdomen is soft."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.4,
      "end_seconds": 266.69,
      "duration_seconds": 3.29,
      "text": "Good. Are we done? ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.03,
      "end_seconds": 278.85,
      "duration_seconds": 7.82,
      "text": "Nearly. I'd like to arrange a scan in three months, to check for any new stones."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.56,
      "end_seconds": 286.31,
      "duration_seconds": 3.75,
      "text": "Three months. All right. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.67,
      "end_seconds": 299.18,
      "duration_seconds": 8.51,
      "text": "If you get severe pain, fever, or can't pass urine, come in straight away."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.01,
      "end_seconds": 306.02,
      "duration_seconds": 3.01,
      "text": "I will. Thank you. ~"
    }
  ]
}
