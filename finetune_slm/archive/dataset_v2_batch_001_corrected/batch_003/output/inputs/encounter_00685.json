{
  "schema_version": "1.0",
  "encounter_id": "00685",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 0.88,
      "end_seconds": 10.39,
      "duration_seconds": 9.51,
      "text": "Hi, I'm Dr Okafor. How would you like me to address you, Ms Reyes, or Dana? ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.15,
      "end_seconds": 21.89,
      "duration_seconds": 8.74,
      "text": "Dana's fine. I've got about twenty minutes before my next meeting, so, can we get into it? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.15,
      "end_seconds": 29.6,
      "duration_seconds": 5.45,
      "text": "Of course. Tell me what's going on. ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.11,
      "end_seconds": 44.78,
      "duration_seconds": 13.67,
      "text": "My periods are awful. Painful periods, since I was fourteen. I've put up with it for years, but it's getting worse and I'm missing work."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.29,
      "end_seconds": 48.77,
      "duration_seconds": 1.48,
      "text": "Worse how?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.43,
      "end_seconds": 64.81,
      "duration_seconds": 13.38,
      "text": "It used to be a day of cramps. Now it's three, four days, and I'm on the bathroom floor on the second one."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.64,
      "end_seconds": 71.36,
      "duration_seconds": 3.72,
      "text": "How heavy is the bleeding?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.02,
      "end_seconds": 81.56,
      "duration_seconds": 7.54,
      "text": "Heavy. Soaking through a pad every hour or two on day two."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.04,
      "end_seconds": 85.89,
      "duration_seconds": 2.85,
      "text": "Any pain with sex?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.12,
      "end_seconds": 92.5,
      "duration_seconds": 5.38,
      "text": "Yes. Deep inside, it's why I stopped a while back."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.8,
      "end_seconds": 100.57,
      "duration_seconds": 5.77,
      "text": "Interesting. Since when, roughly, has the sex been painful? ~"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.04,
      "end_seconds": 108.94,
      "duration_seconds": 6.9,
      "text": "Maybe two years? Look, can we stick to the periods? ~"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.15,
      "end_seconds": 114.25,
      "duration_seconds": 4.1,
      "text": "Sure. Do you bleed between periods?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.39,
      "end_seconds": 118.76,
      "duration_seconds": 2.37,
      "text": "No. Never between."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.66,
      "end_seconds": 122.93,
      "duration_seconds": 3.27,
      "text": "Any unusual discharge or a smell?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.84,
      "end_seconds": 126.44,
      "duration_seconds": 2.6,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.18,
      "end_seconds": 135.12,
      "duration_seconds": 5.94,
      "text": "Any trouble when you pass a stool during your period?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.59,
      "end_seconds": 142.51,
      "duration_seconds": 4.92,
      "text": "No, my bowels are normal, that's the one thing."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.16,
      "end_seconds": 147.96,
      "duration_seconds": 3.8,
      "text": "Do you take anything for it? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.79,
      "end_seconds": 157.43,
      "duration_seconds": 6.64,
      "text": "Just ibuprofen, but that's ancient history now. It stopped helping. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.43,
      "end_seconds": 161.14,
      "duration_seconds": 2.71,
      "text": "Any allergies to medicines?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.99,
      "end_seconds": 167.72,
      "duration_seconds": 3.73,
      "text": "Sulfa drugs. I broke out in hives."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.77,
      "end_seconds": 174.3,
      "duration_seconds": 5.53,
      "text": "Good to know. What else is in your medical history?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.36,
      "end_seconds": 182.15,
      "duration_seconds": 6.79,
      "text": "Migraines with aura, anxiety, and I was anemic last year."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.71,
      "end_seconds": 185.46,
      "duration_seconds": 1.75,
      "text": "Any procedures?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.09,
      "end_seconds": 195.21,
      "duration_seconds": 7.12,
      "text": "A laparoscopy, four years ago, to look for... something. They didn't find anything."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.41,
      "end_seconds": 200.77,
      "duration_seconds": 4.36,
      "text": "Anyone in the family with period problems?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.95,
      "end_seconds": 209.31,
      "duration_seconds": 6.36,
      "text": "My mother had endometriosis. She was diagnosed in her thirties."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.9,
      "end_seconds": 213.39,
      "duration_seconds": 2.49,
      "text": "Tell me about work."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.5,
      "end_seconds": 222.48,
      "duration_seconds": 6.98,
      "text": "I'm a paralegal. Back-to-back meetings, which is why I'm checking the clock."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.83,
      "end_seconds": 226.69,
      "duration_seconds": 1.86,
      "text": "And exercise?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.31,
      "end_seconds": 234.69,
      "duration_seconds": 6.38,
      "text": "I run three times a week, except when I'm in pain."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.28,
      "end_seconds": 257.1,
      "duration_seconds": 10.82,
      "text": "Let me take a few numbers. Your blood pressure is 112 over 70, pulse 76, and weight 59 kilos."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.36,
      "end_seconds": 260.16,
      "duration_seconds": 1.8,
      "text": "Fine? ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.03,
      "end_seconds": 277.28,
      "duration_seconds": 7.25,
      "text": "Fine. I'm going to press on your abdomen. Tell me if it hurts."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.27,
      "end_seconds": 281.6,
      "duration_seconds": 3.33,
      "text": "Ah. Lower left, there. ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.54,
      "end_seconds": 288.09,
      "duration_seconds": 5.55,
      "text": "There's tenderness in the lower left abdomen, but no guarding."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.05,
      "end_seconds": 293.05,
      "duration_seconds": 2.0,
      "text": "What's guarding? ~"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.99,
      "end_seconds": 304.29,
      "duration_seconds": 9.3,
      "text": "When the muscles tense up against my hand. They aren't. The uterus feels normal in size."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.65,
      "end_seconds": 308.74,
      "duration_seconds": 3.09,
      "text": "So, not big? ~"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.0,
      "end_seconds": 316.65,
      "duration_seconds": 6.65,
      "text": "Not big. And I can feel some tenderness behind the uterus too."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.36,
      "end_seconds": 323.36,
      "duration_seconds": 4.0,
      "text": "That's the part that hurts, yes. ~"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.05,
      "end_seconds": 328.99,
      "duration_seconds": 2.94,
      "text": "Any trouble with your bladder?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.05,
      "end_seconds": 333.95,
      "duration_seconds": 2.9,
      "text": "No, nothing there. It's fine."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.65,
      "end_seconds": 350.46,
      "duration_seconds": 13.81,
      "text": "This pattern, pain since your teens, deep pain with sex, your mother's history, it looks like endometriosis. I can't rule out fibroids until we scan."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.61,
      "end_seconds": 355.33,
      "duration_seconds": 2.72,
      "text": "Which means? ~"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.25,
      "end_seconds": 369.48,
      "duration_seconds": 11.23,
      "text": "I'd like to arrange a pelvic ultrasound, a ferritin blood test for the iron, and a pregnancy test today."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 370.41,
      "end_seconds": 374.29,
      "duration_seconds": 3.88,
      "text": "Pregnancy, no, there's no chance. ~"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 375.93,
      "end_seconds": 387.43,
      "duration_seconds": 11.5,
      "text": "It's routine before starting medication. I'd also like to start norethindrone 5 mg once a day, no estrogen because of the migraines with aura."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 389.71,
      "end_seconds": 394.38,
      "duration_seconds": 4.67,
      "text": "Right, that makes sense. Anything for the cramps? ~"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 395.11,
      "end_seconds": 402.89,
      "duration_seconds": 7.78,
      "text": "Yes, let's start naproxen 500 mg twice a day with food during your period."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 405.29,
      "end_seconds": 408.83,
      "duration_seconds": 3.54,
      "text": "Okay, I'll take that. ~"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 410.34,
      "end_seconds": 420.24,
      "duration_seconds": 9.9,
      "text": "If the pain isn't better in three months, I'll refer you to a specialist for a closer look."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 421.82,
      "end_seconds": 425.82,
      "duration_seconds": 4.0,
      "text": "Three months. Fine, I have to run. ~"
    }
  ]
}
