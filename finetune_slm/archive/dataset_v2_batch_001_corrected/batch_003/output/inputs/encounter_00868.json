{
  "schema_version": "1.0",
  "encounter_id": "00868",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 1.91,
      "end_seconds": 9.27,
      "duration_seconds": 7.36,
      "text": "Mr Winters? I'm Alan, the nurse. Let me take your observations first. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.38,
      "end_seconds": 17.24,
      "duration_seconds": 5.86,
      "text": "Right. I don't mind. I itch, that's all. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 34.54,
      "end_seconds": 43.2,
      "duration_seconds": 8.66,
      "text": "Blood pressure 152 over 88, pulse 74, temperature 36.6, oxygen 97 percent, weight 71 kilos."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.01,
      "end_seconds": 52.81,
      "duration_seconds": 6.8,
      "text": "Hello Mr Winters. It's the itching, isn't it? Tell me about it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.95,
      "end_seconds": 65.17,
      "duration_seconds": 10.22,
      "text": "All over. Mostly my back, my legs, my arms. Worse at night. I scratch until I bleed."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.34,
      "end_seconds": 71.96,
      "duration_seconds": 3.62,
      "text": "How long has it been going on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.15,
      "end_seconds": 80.12,
      "duration_seconds": 4.97,
      "text": "Two months. Since my kidneys got worse, I think."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.56,
      "end_seconds": 85.94,
      "duration_seconds": 2.38,
      "text": "Is there a rash?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.04,
      "end_seconds": 93.96,
      "duration_seconds": 4.92,
      "text": "No rash. Just the itch. My skin's dry."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.1,
      "end_seconds": 99.48,
      "duration_seconds": 3.38,
      "text": "Any jaundice, or dark urine?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.63,
      "end_seconds": 104.89,
      "duration_seconds": 3.26,
      "text": "No. Nothing like that."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.79,
      "end_seconds": 110.16,
      "duration_seconds": 3.37,
      "text": "Remind me of your history."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.39,
      "end_seconds": 118.67,
      "duration_seconds": 5.28,
      "text": "Chronic kidney disease, for about eight years, and diabetes."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.26,
      "end_seconds": 123.32,
      "duration_seconds": 3.06,
      "text": "Do you smoke or drink?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.09,
      "end_seconds": 127.64,
      "duration_seconds": 2.55,
      "text": "Neither. Not for years."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.29,
      "end_seconds": 131.22,
      "duration_seconds": 1.93,
      "text": "Any allergies?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.92,
      "end_seconds": 135.66,
      "duration_seconds": 2.74,
      "text": "Codeine. Makes me vomit."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.35,
      "end_seconds": 142.82,
      "duration_seconds": 5.47,
      "text": "Thank you. Let me look at your skin. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.24,
      "end_seconds": 163.84,
      "duration_seconds": 1.6,
      "text": "Go on."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.37,
      "end_seconds": 174.54,
      "duration_seconds": 9.17,
      "text": "There's dry, scaly skin, and scratch marks on his back and arms, but no rash, and no signs of infection."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 176.88,
      "end_seconds": 185.38,
      "duration_seconds": 8.5,
      "text": "Doctor, his last bloods came back this morning. Creatinine's up a bit, and phosphate is high. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.32,
      "end_seconds": 202.7,
      "duration_seconds": 14.38,
      "text": "Thank you, Alan. Mr Winters, the itch is very common in kidney disease, uraemic itch. I'd say that's what you've got, with dry skin adding to it."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.5,
      "end_seconds": 207.86,
      "duration_seconds": 3.36,
      "text": "Can it be treated? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.88,
      "end_seconds": 223.38,
      "duration_seconds": 12.5,
      "text": "Yes. First, moisturise twice a day with a plain thick cream, keep your showers short and lukewarm, and avoid scented soaps."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.09,
      "end_seconds": 226.78,
      "duration_seconds": 1.69,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.19,
      "end_seconds": 241.07,
      "duration_seconds": 11.88,
      "text": "I'd also like to start you on a tablet to lower your phosphate, calcium acetate, 500 mg, three times a day, with meals."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.38,
      "end_seconds": 247.01,
      "duration_seconds": 3.63,
      "text": "Will that help the itch? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.27,
      "end_seconds": 255.23,
      "duration_seconds": 5.96,
      "text": "Often, yes, because a high phosphate drives it. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 257.77,
      "end_seconds": 263.81,
      "duration_seconds": 6.04,
      "text": "I'll go through the diet sheet with you, Mr Winters. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.89,
      "end_seconds": 279.01,
      "duration_seconds": 13.12,
      "text": "Thank you, Alan. I'd also like to arrange more blood tests, for your parathyroid hormone, calcium and liver tests, and a review with the kidney team."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.58,
      "end_seconds": 283.12,
      "duration_seconds": 1.54,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.66,
      "end_seconds": 289.32,
      "duration_seconds": 4.66,
      "text": "Keep your nails short, and wear cotton at night."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.41,
      "end_seconds": 293.54,
      "duration_seconds": 2.13,
      "text": "I'll try. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.83,
      "end_seconds": 300.97,
      "duration_seconds": 5.14,
      "text": "I'd like to see you again in four weeks."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.52,
      "end_seconds": 305.97,
      "duration_seconds": 3.45,
      "text": "Four weeks. Thank you. ~"
    }
  ]
}
