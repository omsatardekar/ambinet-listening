{
  "schema_version": "1.0",
  "encounter_id": "00875",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.82,
      "end_seconds": 13.25,
      "duration_seconds": 12.43,
      "text": "Hello. We've been trying for a baby for a year now and nothing has happened, so I wanted to talk about it."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.56,
      "end_seconds": 29.95,
      "duration_seconds": 14.39,
      "text": "Thank you for coming. A year is the point where we usually start looking into it, so you are right to ask. Is your partner with you? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.55,
      "end_seconds": 38.42,
      "duration_seconds": 6.87,
      "text": "No, he's at work. He said he'd come to the next one. ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.09,
      "end_seconds": 48.84,
      "duration_seconds": 7.75,
      "text": "That's fine. Can you tell me about your periods? Are they regular?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.29,
      "end_seconds": 55.24,
      "duration_seconds": 4.95,
      "text": "Mostly. Every twenty-eight to thirty days, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.44,
      "end_seconds": 61.0,
      "duration_seconds": 4.56,
      "text": "Any pain with the periods, or with intercourse?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.48,
      "end_seconds": 68.08,
      "duration_seconds": 4.6,
      "text": "Quite painful periods, yes. Intercourse is fine."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.16,
      "end_seconds": 74.23,
      "duration_seconds": 4.07,
      "text": "Have you ever been pregnant before?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.12,
      "end_seconds": 80.37,
      "duration_seconds": 5.25,
      "text": "No, never. This is the first time we've tried."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.65,
      "end_seconds": 88.94,
      "duration_seconds": 6.29,
      "text": "Any previous problems with your womb or ovaries, like cysts or fibroids?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.79,
      "end_seconds": 98.85,
      "duration_seconds": 7.06,
      "text": "My mother had fibroids. I've never been told I have any."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.57,
      "end_seconds": 105.32,
      "duration_seconds": 3.75,
      "text": "Do you smoke, or drink alcohol?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.13,
      "end_seconds": 115.58,
      "duration_seconds": 8.45,
      "text": "I don't smoke. I only drink a glass of wine at weekends, that's all."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.57,
      "end_seconds": 124.61,
      "duration_seconds": 7.04,
      "text": "Good. Today my colleague will take your blood pressure, pulse and weight. ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 126.23,
      "end_seconds": 132.08,
      "duration_seconds": 5.85,
      "text": "If you sit here, I'll put the cuff on. ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.68,
      "end_seconds": 144.75,
      "duration_seconds": 1.07,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 145.47,
      "end_seconds": 152.2,
      "duration_seconds": 6.73,
      "text": "Blood pressure 118 over 74, pulse 70, weight 62 kilograms, height 165 centimetres."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.21,
      "end_seconds": 164.05,
      "duration_seconds": 10.84,
      "text": "Thank you. Those are all good. Now I'd like to examine your tummy gently, if that's all right. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.91,
      "end_seconds": 179.0,
      "duration_seconds": 2.09,
      "text": "Yes, of course."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.72,
      "end_seconds": 186.85,
      "duration_seconds": 7.13,
      "text": "Your tummy is soft and not tender, and I don't feel any lumps."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.91,
      "end_seconds": 192.11,
      "duration_seconds": 3.2,
      "text": "Is that good? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.74,
      "end_seconds": 207.65,
      "duration_seconds": 13.91,
      "text": "Yes. I'd also like to do an internal examination, but I can do that at the next visit when you're more comfortable. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 210.61,
      "end_seconds": 214.54,
      "duration_seconds": 3.93,
      "text": "I'll note that for the next appointment. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.29,
      "end_seconds": 231.63,
      "duration_seconds": 14.34,
      "text": "There may be several reasons it hasn't happened yet. It could be ovulation, the tubes, the womb, or sperm, and it could be more than one. I can't say which today."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.6,
      "end_seconds": 238.08,
      "duration_seconds": 4.48,
      "text": "Could it be the painful periods? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.47,
      "end_seconds": 248.49,
      "duration_seconds": 9.02,
      "text": "It might, if there's a condition such as endometriosis, but I wouldn't want to guess without more information."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.97,
      "end_seconds": 253.87,
      "duration_seconds": 2.9,
      "text": "What happens next? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.73,
      "end_seconds": 265.55,
      "duration_seconds": 10.82,
      "text": "We'll arrange a scan of your pelvis, and blood tests for hormones. Your partner would also need a semen test."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.31,
      "end_seconds": 271.03,
      "duration_seconds": 2.72,
      "text": "I'll tell him. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.8,
      "end_seconds": 281.58,
      "duration_seconds": 8.78,
      "text": "Try to have intercourse every two to three days through the month, not just around ovulation."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.63,
      "end_seconds": 285.79,
      "duration_seconds": 3.16,
      "text": "Okay, that sounds easier. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.16,
      "end_seconds": 294.98,
      "duration_seconds": 6.82,
      "text": "And please start folic acid, 400 micrograms a day, as soon as you can."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.43,
      "end_seconds": 301.14,
      "duration_seconds": 4.71,
      "text": "I'll buy some on the way home. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.06,
      "end_seconds": 312.19,
      "duration_seconds": 9.13,
      "text": "Good. The scan and bloods come first, then we'll talk at the next visit. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.41,
      "end_seconds": 315.66,
      "duration_seconds": 2.25,
      "text": "Thank you, doctor. ~"
    }
  ]
}
