{
  "schema_version": "1.0",
  "encounter_id": "00824",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 2.7,
      "end_seconds": 15.67,
      "duration_seconds": 12.97,
      "text": "Hi, doctor. I've been, oh, what's the word, I've got that pain all over, fibromyalgia, and I'm tired all the time, and I wanted to review my tablets."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.92,
      "end_seconds": 27.47,
      "duration_seconds": 7.55,
      "text": "Of course. Tell me how the pain and the tiredness have been."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.48,
      "end_seconds": 40.01,
      "duration_seconds": 9.53,
      "text": "Aching everywhere, mostly my back, shoulders and hips, and heavy tired, I wake up unrefreshed. It's worse when it's cold."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.23,
      "end_seconds": 47.49,
      "duration_seconds": 4.26,
      "text": "When did it flare up this time?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.27,
      "end_seconds": 59.12,
      "duration_seconds": 7.85,
      "text": "A few weeks ago? Or longer, it's difficult to say, it creeps up on me."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.76,
      "end_seconds": 67.7,
      "duration_seconds": 4.94,
      "text": "That's understandable. Any fevers, swollen joints, or rashes?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.6,
      "end_seconds": 73.37,
      "duration_seconds": 1.77,
      "text": "No. None."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.17,
      "end_seconds": 81.01,
      "duration_seconds": 3.84,
      "text": "Any weight loss, or night sweats?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.41,
      "end_seconds": 87.74,
      "duration_seconds": 3.33,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.87,
      "end_seconds": 94.18,
      "duration_seconds": 3.31,
      "text": "Let's go through the tablets."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.91,
      "end_seconds": 106.09,
      "duration_seconds": 9.18,
      "text": "Amitriptyline, 10 mg at night. Duloxetine, 60 mg once a day, and paracetamol, 1 gram, when I need it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.62,
      "end_seconds": 112.87,
      "duration_seconds": 3.25,
      "text": "And are they helping? ~"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.33,
      "end_seconds": 122.45,
      "duration_seconds": 6.12,
      "text": "The amitriptyline helps me sleep. The duloxetine, I'm not sure. ~"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.05,
      "end_seconds": 130.62,
      "duration_seconds": 4.57,
      "text": "Any side effects, dry mouth, nausea, constipation? ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.98,
      "end_seconds": 142.56,
      "duration_seconds": 8.58,
      "text": "A dry mouth, and a bit of nausea when I started. That's settled. ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.28,
      "end_seconds": 148.53,
      "duration_seconds": 2.25,
      "text": "Any other conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.22,
      "end_seconds": 156.31,
      "duration_seconds": 4.09,
      "text": "Irritable bowel. And I get low in winter."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.7,
      "end_seconds": 164.25,
      "duration_seconds": 4.55,
      "text": "Let me check your pulse and blood pressure. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.17,
      "end_seconds": 168.9,
      "duration_seconds": 1.73,
      "text": "Of course. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.69,
      "end_seconds": 183.81,
      "duration_seconds": 4.12,
      "text": "Pulse 70, blood pressure 124 over 78."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.81,
      "end_seconds": 189.08,
      "duration_seconds": 2.27,
      "text": "All right? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.84,
      "end_seconds": 204.36,
      "duration_seconds": 12.52,
      "text": "Fine. Nothing about the examination or your history suggests a different cause, so I'd say this is a flare of your fibromyalgia."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.89,
      "end_seconds": 210.45,
      "duration_seconds": 2.56,
      "text": "It's so frustrating. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.8,
      "end_seconds": 226.88,
      "duration_seconds": 13.08,
      "text": "I know. I'd like to arrange a blood test, to check your thyroid, vitamin D and inflammation markers, just to make sure there's nothing else contributing."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.15,
      "end_seconds": 232.05,
      "duration_seconds": 1.9,
      "text": "Fine. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.24,
      "end_seconds": 247.31,
      "duration_seconds": 11.07,
      "text": "And I'd like to refer you to the pain management programme, which teaches pacing, gentle exercise, and coping strategies."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.45,
      "end_seconds": 253.95,
      "duration_seconds": 3.5,
      "text": "Does that really help? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.76,
      "end_seconds": 265.87,
      "duration_seconds": 8.11,
      "text": "Yes, evidence shows that regular gentle exercise, like swimming, walking and yoga, helps more than most tablets."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.83,
      "end_seconds": 271.86,
      "duration_seconds": 3.03,
      "text": "I used to swim. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.02,
      "end_seconds": 281.76,
      "duration_seconds": 6.74,
      "text": "Start with ten minutes, and build slowly. Don't push on bad days. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.75,
      "end_seconds": 286.72,
      "duration_seconds": 1.97,
      "text": "I'll try. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.68,
      "end_seconds": 298.99,
      "duration_seconds": 9.31,
      "text": "I'd like to see you again in six weeks, to see how the plan is going."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.0,
      "end_seconds": 305.99,
      "duration_seconds": 3.99,
      "text": "Six weeks. Thank you, doctor. ~"
    }
  ]
}
