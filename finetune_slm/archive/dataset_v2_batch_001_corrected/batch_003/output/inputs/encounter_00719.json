{
  "schema_version": "1.0",
  "encounter_id": "00719",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.54,
      "end_seconds": 14.32,
      "duration_seconds": 13.78,
      "text": "Sorry we're late, doctor. Rosa got lost in the parking lot, and I wouldn't have come at all, it's just a foot check. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.02,
      "end_seconds": 24.38,
      "duration_seconds": 9.36,
      "text": "No problem, Mr Dale. How are you feeling about the feet, from your side? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.19,
      "end_seconds": 38.3,
      "duration_seconds": 11.11,
      "text": "They're fine. I have a little blister on the left heel, that's all, it came up last week from my work boots."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 39.55,
      "end_seconds": 51.13,
      "duration_seconds": 11.58,
      "text": "It's been a week, doctor, and it's not healing. And his heels are cracked, they've been cracked all winter."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.52,
      "end_seconds": 59.77,
      "duration_seconds": 7.25,
      "text": "Rosa, thank you. Any numbness or tingling in the feet, Mr Dale?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.72,
      "end_seconds": 66.74,
      "duration_seconds": 4.02,
      "text": "No, no numbness. My feet feel fine."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 68.72,
      "end_seconds": 82.13,
      "duration_seconds": 13.41,
      "text": "Frank, you couldn't feel the bathwater yesterday, I had to tell you it was too hot. You never feel it on your feet."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.09,
      "end_seconds": 89.54,
      "duration_seconds": 6.45,
      "text": "I felt it. It was a bit warm, that's all. ~"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.52,
      "end_seconds": 96.74,
      "duration_seconds": 4.22,
      "text": "I'll write both down. Any fever or chills?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.72,
      "end_seconds": 101.63,
      "duration_seconds": 1.91,
      "text": "No fever."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.32,
      "end_seconds": 106.72,
      "duration_seconds": 3.4,
      "text": "What about the legs, cramps?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.11,
      "end_seconds": 113.63,
      "duration_seconds": 5.52,
      "text": "Cramps in the calves at night, on and off."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.5,
      "end_seconds": 116.84,
      "duration_seconds": 2.34,
      "text": "And your energy?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.45,
      "end_seconds": 122.56,
      "duration_seconds": 3.11,
      "text": "Tired. But I'm old."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.65,
      "end_seconds": 127.71,
      "duration_seconds": 3.06,
      "text": "Let's go through your medications."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.87,
      "end_seconds": 142.2,
      "duration_seconds": 13.33,
      "text": "Insulin glargine, 20 units, at bedtime. Metformin, 1000 mg, twice a day, I never miss it. Atorvastatin, 40 mg, at night. And lisinopril, 10 mg, once a day."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 143.06,
      "end_seconds": 154.32,
      "duration_seconds": 11.26,
      "text": "The insulin is 24 units, Frank, I draw it up myself. And you skip the evening metformin, at least three times a week."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.29,
      "end_seconds": 160.45,
      "duration_seconds": 4.16,
      "text": "It's 20. And I take the metformin. Mostly."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.18,
      "end_seconds": 173.11,
      "duration_seconds": 9.93,
      "text": "So the insulin dose is 20 or 24 units, and I'll check with the pharmacy. Any allergies, Mr Dale?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.62,
      "end_seconds": 179.03,
      "duration_seconds": 3.41,
      "text": "Sulfa. I got hives from it."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.76,
      "end_seconds": 182.63,
      "duration_seconds": 2.87,
      "text": "What conditions do you have?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.41,
      "end_seconds": 190.28,
      "duration_seconds": 6.87,
      "text": "Type 2 diabetes, fifteen years. High blood pressure. And high cholesterol."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.08,
      "end_seconds": 192.98,
      "duration_seconds": 1.9,
      "text": "Any operations?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.15,
      "end_seconds": 198.14,
      "duration_seconds": 3.99,
      "text": "My right second toe was amputated, in 2021."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.59,
      "end_seconds": 202.65,
      "duration_seconds": 3.06,
      "text": "Diabetes in the family?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.19,
      "end_seconds": 207.76,
      "duration_seconds": 2.57,
      "text": "My mother had it."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.57,
      "end_seconds": 212.98,
      "duration_seconds": 2.41,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.05,
      "end_seconds": 218.9,
      "duration_seconds": 3.85,
      "text": "I quit smoking six years ago."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.62,
      "end_seconds": 222.69,
      "duration_seconds": 1.07,
      "text": "Alcohol?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.46,
      "end_seconds": 227.29,
      "duration_seconds": 2.83,
      "text": "A beer on Fridays."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.77,
      "end_seconds": 232.94,
      "duration_seconds": 3.17,
      "text": "What did you do for work?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.16,
      "end_seconds": 237.7,
      "duration_seconds": 2.54,
      "text": "Trucker, thirty years. Retired."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.04,
      "end_seconds": 241.19,
      "duration_seconds": 2.15,
      "text": "And at home?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.58,
      "end_seconds": 248.35,
      "duration_seconds": 5.77,
      "text": "I live with Rosa, she's my daughter-in-law, she looks after me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.93,
      "end_seconds": 277.58,
      "duration_seconds": 12.65,
      "text": "Let me check you. Blood pressure 138 over 82, pulse 78, temperature 36.9, oxygen 97 percent, breathing 16, and weight 98 kilos."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.92,
      "end_seconds": 281.13,
      "duration_seconds": 2.21,
      "text": "All good. ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.92,
      "end_seconds": 298.77,
      "duration_seconds": 4.85,
      "text": "Take your socks off, please. Rosa, can you help?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 301.75,
      "end_seconds": 303.96,
      "duration_seconds": 2.21,
      "text": "Of course. ~"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.53,
      "end_seconds": 313.53,
      "duration_seconds": 7.0,
      "text": "There's a blister on the left heel, about two centimetres, with no redness around it."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 314.84,
      "end_seconds": 317.23,
      "duration_seconds": 2.39,
      "text": "Is it infected? ~"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.81,
      "end_seconds": 328.52,
      "duration_seconds": 8.71,
      "text": "Not that I can see. The skin on both heels is dry and cracked."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.49,
      "end_seconds": 332.68,
      "duration_seconds": 3.19,
      "text": "Told you, nothing serious. ~"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.54,
      "end_seconds": 356.78,
      "duration_seconds": 8.24,
      "text": "Now I'll touch your soles with a thin plastic fibre. Tell me when you feel it."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.38,
      "end_seconds": 362.07,
      "duration_seconds": 2.69,
      "text": "Yes. Yes. Hm. ~"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.91,
      "end_seconds": 377.8,
      "duration_seconds": 13.89,
      "text": "You couldn't feel it on the left sole at all, and only some of the right. So the sensation in the feet is reduced."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 378.59,
      "end_seconds": 380.38,
      "duration_seconds": 1.79,
      "text": "Is it? ~"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 382.86,
      "end_seconds": 386.19,
      "duration_seconds": 3.33,
      "text": "That's what I said. ~"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 387.25,
      "end_seconds": 389.24,
      "duration_seconds": 1.99,
      "text": "Any trouble breathing?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 390.59,
      "end_seconds": 393.71,
      "duration_seconds": 3.12,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 395.3,
      "end_seconds": 406.83,
      "duration_seconds": 11.53,
      "text": "This blister looks like a pressure blister from the boots, but because of your diabetes I want to be careful."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 409.33,
      "end_seconds": 412.53,
      "duration_seconds": 3.2,
      "text": "What do we do? ~"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 414.97,
      "end_seconds": 422.21,
      "duration_seconds": 7.24,
      "text": "I'd like to arrange an HbA1c, and an X-ray of the left foot."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 424.42,
      "end_seconds": 425.96,
      "duration_seconds": 1.54,
      "text": "Fine. ~"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 428.45,
      "end_seconds": 439.29,
      "duration_seconds": 10.84,
      "text": "Wear soft shoes, check your feet every day, Rosa too. I'd like to see you again in two weeks."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 440.56,
      "end_seconds": 446.21,
      "duration_seconds": 5.65,
      "text": "Two weeks. I'll keep an eye on it. ~"
    }
  ]
}
