{
  "schema_version": "1.0",
  "encounter_id": "00549",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.74,
      "end_seconds": 11.33,
      "duration_seconds": 10.59,
      "text": "Doctor, I am getting breathless even on flat ground. Since long time only, and now it is more."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.67,
      "end_seconds": 20.18,
      "duration_seconds": 6.51,
      "text": "Okay, sit, sit. How long is long time? Months, or years?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.29,
      "end_seconds": 25.65,
      "duration_seconds": 3.36,
      "text": "Three years. Maybe little more."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.47,
      "end_seconds": 35.44,
      "duration_seconds": 7.97,
      "text": "How far can you walk on the flat before you have to stop?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.57,
      "end_seconds": 40.36,
      "duration_seconds": 3.79,
      "text": "One block, maybe. Then I stop."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.75,
      "end_seconds": 46.21,
      "duration_seconds": 4.46,
      "text": "And when you stop, does anything help?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.38,
      "end_seconds": 53.74,
      "duration_seconds": 6.36,
      "text": "Sitting for a while. Five minutes, then it is okay."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.0,
      "end_seconds": 60.71,
      "duration_seconds": 4.71,
      "text": "Good. Is there any cough with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.82,
      "end_seconds": 66.16,
      "duration_seconds": 4.34,
      "text": "Yes, cough in the morning. White phlegm comes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.66,
      "end_seconds": 72.43,
      "duration_seconds": 3.77,
      "text": "When did the cough start?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.22,
      "end_seconds": 80.75,
      "duration_seconds": 7.53,
      "text": "I don't know, doctor. Maybe last year, maybe before that also. I cannot say exactly."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.64,
      "end_seconds": 93.3,
      "duration_seconds": 9.66,
      "text": "No problem, we will not worry about the date. Do you get any whistling in the chest?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.42,
      "end_seconds": 100.89,
      "duration_seconds": 5.47,
      "text": "Yes, wheezing at night, sometimes. It wakes me up."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.47,
      "end_seconds": 107.1,
      "duration_seconds": 4.63,
      "text": "Any swelling in the ankles or feet?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.68,
      "end_seconds": 117.62,
      "duration_seconds": 7.94,
      "text": "Little bit, swelling in my feet, in the evening. By morning it is gone."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.4,
      "end_seconds": 130.48,
      "duration_seconds": 10.08,
      "text": "Okay. Now a few things I must rule out. Any chest pain, any fever, or any blood when you cough?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.72,
      "end_seconds": 136.68,
      "duration_seconds": 3.96,
      "text": "No chest pain. No fever. No blood also."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.88,
      "end_seconds": 142.2,
      "duration_seconds": 4.32,
      "text": "Good. What medicines are you taking at present?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.13,
      "end_seconds": 155.86,
      "duration_seconds": 12.73,
      "text": "Blue inhaler, salbutamol, when needed. Amlodipine 5 mg once a day. Metformin 500 mg twice a day. And atorvastatin 20 mg at night."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.87,
      "end_seconds": 163.97,
      "duration_seconds": 6.1,
      "text": "Fine. Those three tablets, are they for diabetes, blood pressure and cholesterol?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.65,
      "end_seconds": 173.49,
      "duration_seconds": 7.84,
      "text": "Yes. Diabetes, high blood pressure, high cholesterol. All three. Diabetes is ten years now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.02,
      "end_seconds": 178.26,
      "duration_seconds": 3.24,
      "text": "Understood. Any allergy to any medicine?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.17,
      "end_seconds": 182.43,
      "duration_seconds": 3.26,
      "text": "Penicillin. Rash all over the body."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.79,
      "end_seconds": 188.94,
      "duration_seconds": 4.15,
      "text": "Noted. Any operations in the past?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.58,
      "end_seconds": 192.99,
      "duration_seconds": 2.41,
      "text": "Hernia operation, in 2015."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.04,
      "end_seconds": 200.19,
      "duration_seconds": 6.15,
      "text": "Anyone in the family with heart or lung problems?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.44,
      "end_seconds": 206.97,
      "duration_seconds": 4.53,
      "text": "Father had heart attack, at sixty. Lungs, nobody."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.8,
      "end_seconds": 211.38,
      "duration_seconds": 3.58,
      "text": "Do you smoke, or have you smoked?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.25,
      "end_seconds": 220.65,
      "duration_seconds": 7.4,
      "text": "Used to. Beedi, fifteen a day, for many years. Stopped in 2018."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.17,
      "end_seconds": 228.59,
      "duration_seconds": 5.42,
      "text": "Well done for stopping. And what work did you do?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.76,
      "end_seconds": 233.74,
      "duration_seconds": 3.98,
      "text": "Cement factory, thirty years. Retired now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.75,
      "end_seconds": 243.13,
      "duration_seconds": 7.38,
      "text": "Hmm. Cement dust is not good for the lungs. Stomach and bowels, all okay?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.52,
      "end_seconds": 247.8,
      "duration_seconds": 3.28,
      "text": "All fine, no problem there."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.16,
      "end_seconds": 265.98,
      "duration_seconds": 6.82,
      "text": "Good. Let me do your vitals now. Please don't talk for a minute."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.5,
      "end_seconds": 298.66,
      "duration_seconds": 17.16,
      "text": "Blood pressure is 138/86, pulse 92 bpm, respiratory rate 22 breaths/min, oxygen saturation 93 %, and temperature 37.1 °C. Now open your shirt, I will listen to your chest."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.35,
      "end_seconds": 303.89,
      "duration_seconds": 2.54,
      "text": "Cold stethoscope, doctor."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.58,
      "end_seconds": 333.48,
      "duration_seconds": 14.9,
      "text": "Sorry, sorry. Breathe in deeply, and out. I can hear wheeze on both sides when you breathe out, and the air entry is reduced at both bases."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.15,
      "end_seconds": 339.94,
      "duration_seconds": 3.79,
      "text": "What is it, doctor? Is it serious?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.78,
      "end_seconds": 356.29,
      "duration_seconds": 15.51,
      "text": "Let me be clear. With your smoking history and the cement dust, this looks most likely like chronic obstructive pulmonary disease. That is my working impression, not final."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.84,
      "end_seconds": 363.87,
      "duration_seconds": 5.03,
      "text": "COPD? My neighbour has that. He is on oxygen."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.85,
      "end_seconds": 377.94,
      "duration_seconds": 12.09,
      "text": "He may be a more advanced case. Yours we will assess properly, and I do not want you to jump ahead."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 380.03,
      "end_seconds": 382.38,
      "duration_seconds": 2.35,
      "text": "Okay. What tests?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 383.23,
      "end_seconds": 398.94,
      "duration_seconds": 15.71,
      "text": "I'd like to arrange a chest X-ray, spirometry, which is a blowing test to measure your lungs, and a blood count. All three today if the lab has time."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 399.73,
      "end_seconds": 401.96,
      "duration_seconds": 2.23,
      "text": "Spirometry, is it painful?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 403.5,
      "end_seconds": 411.99,
      "duration_seconds": 8.49,
      "text": "Not painful. You blow hard into a tube, three times. A little tiring, that is all."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 414.09,
      "end_seconds": 417.16,
      "duration_seconds": 3.07,
      "text": "Okay, I can do that."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 418.45,
      "end_seconds": 431.59,
      "duration_seconds": 13.14,
      "text": "Good. Keep using your blue inhaler when needed, and keep your tablets as they are for now. Do not change anything before the tests."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 432.35,
      "end_seconds": 434.68,
      "duration_seconds": 2.33,
      "text": "Yes, doctor. Same only."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 437.2,
      "end_seconds": 452.3,
      "duration_seconds": 15.1,
      "text": "Also, if the breathlessness suddenly becomes much worse, or your lips turn blue, or you have chest pain, go to the emergency department straight away."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 453.38,
      "end_seconds": 456.31,
      "duration_seconds": 2.93,
      "text": "Emergency, straight away. Okay."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 457.81,
      "end_seconds": 467.93,
      "duration_seconds": 10.12,
      "text": "Come back and see me in two weeks, with the reports, and we will decide the treatment then."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 470.1,
      "end_seconds": 479.01,
      "duration_seconds": 8.91,
      "text": "Two weeks. I will tell my son to bring me, I don't like to take the bus now."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 481.0,
      "end_seconds": 484.75,
      "duration_seconds": 3.75,
      "text": "Very good idea. Any other questions?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 486.45,
      "end_seconds": 493.25,
      "duration_seconds": 6.8,
      "text": "One thing. Can I climb stairs to the second floor, to my daughter's house?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 495.83,
      "end_seconds": 504.65,
      "duration_seconds": 8.82,
      "text": "Go slowly, stop on the landing. If you get too breathless, rest. No hero work."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 506.72,
      "end_seconds": 511.13,
      "duration_seconds": 4.41,
      "text": "No hero work. Okay, doctor, thank you."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 512.13,
      "end_seconds": 519.93,
      "duration_seconds": 7.8,
      "text": "Welcome. Ask the front desk for the lab forms on your way out."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 521.64,
      "end_seconds": 525.02,
      "duration_seconds": 3.38,
      "text": "Forms from front desk. Thank you."
    }
  ]
}
