{
  "schema_version": "1.0",
  "encounter_id": "00797",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.72,
      "end_seconds": 21.81,
      "duration_seconds": 20.09,
      "text": "Morning! I'll tell you what, I woke up three mornings in a row with a face like a balloon. Puffy eyes, puffy cheeks. By lunchtime it's gone down. My wife said I should come."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.67,
      "end_seconds": 30.4,
      "duration_seconds": 5.73,
      "text": "Thank you for coming. When did you first notice it?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.86,
      "end_seconds": 42.51,
      "duration_seconds": 8.65,
      "text": "Last Monday. So, five days. It's worse in the morning, and it settles by the afternoon."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.41,
      "end_seconds": 50.44,
      "duration_seconds": 5.03,
      "text": "Any other swelling, like your ankles or your tummy?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.26,
      "end_seconds": 59.67,
      "duration_seconds": 7.41,
      "text": "My ankles are a bit puffy at night, now you mention it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.84,
      "end_seconds": 71.87,
      "duration_seconds": 9.03,
      "text": "Have you noticed any change in your urine, foamy, dark, or less of it? ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.11,
      "end_seconds": 83.31,
      "duration_seconds": 9.2,
      "text": "It's a bit frothy, the last week or so. I thought it was the new loo cleaner."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.89,
      "end_seconds": 87.72,
      "duration_seconds": 2.83,
      "text": "What tablets are you on?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.59,
      "end_seconds": 95.5,
      "duration_seconds": 5.91,
      "text": "Amlodipine, 5 mg once a day, for my blood pressure."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.6,
      "end_seconds": 103.41,
      "duration_seconds": 4.81,
      "text": "Right. Pulse, pressure, and so on. ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.2,
      "end_seconds": 107.63,
      "duration_seconds": 2.43,
      "text": "Go on. ~"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.81,
      "end_seconds": 133.14,
      "duration_seconds": 9.33,
      "text": "Pulse 74, blood pressure 148 over 92, temperature 36.7, oxygen 98 percent, weight 88 kilos."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.99,
      "end_seconds": 138.67,
      "duration_seconds": 2.68,
      "text": "Is that bad? ~"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.79,
      "end_seconds": 150.42,
      "duration_seconds": 9.63,
      "text": "The pressure is a bit higher than I'd like. Let me look at your face and ankles. ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.19,
      "end_seconds": 169.17,
      "duration_seconds": 0.98,
      "text": "Fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.05,
      "end_seconds": 180.13,
      "duration_seconds": 9.08,
      "text": "You have a puffy, slightly swollen look around both eyes, and there's pitting swelling above both ankles."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.0,
      "end_seconds": 186.16,
      "duration_seconds": 3.16,
      "text": "What's causing it? ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.84,
      "end_seconds": 205.87,
      "duration_seconds": 18.03,
      "text": "I'm not going to put a name on it yet. Puffy eyes in the morning, swollen ankles, frothy urine, and raised blood pressure together could point to the kidneys, so I'd like to look properly. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.72,
      "end_seconds": 211.04,
      "duration_seconds": 2.32,
      "text": "The kidneys? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.2,
      "end_seconds": 224.31,
      "duration_seconds": 10.11,
      "text": "It's one of the possibilities, and not the only one. I'd like to arrange a urine test today, to measure protein."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.25,
      "end_seconds": 228.33,
      "duration_seconds": 2.08,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.01,
      "end_seconds": 235.61,
      "duration_seconds": 5.6,
      "text": "I'd also like to take blood tests, for kidney function."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.4,
      "end_seconds": 239.01,
      "duration_seconds": 1.61,
      "text": "Fine. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.61,
      "end_seconds": 252.11,
      "duration_seconds": 10.5,
      "text": "Meanwhile, cut the salt, put your feet up in the evening, and don't take any anti-inflammatory painkillers like ibuprofen."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.53,
      "end_seconds": 260.08,
      "duration_seconds": 4.55,
      "text": "I take ibuprofen for my back, sometimes. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.92,
      "end_seconds": 267.6,
      "duration_seconds": 5.68,
      "text": "Please don't, until we've seen the results. Paracetamol's fine. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.04,
      "end_seconds": 272.89,
      "duration_seconds": 1.85,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.04,
      "end_seconds": 281.79,
      "duration_seconds": 5.75,
      "text": "I'd like to see you again in three days, with the results."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.75,
      "end_seconds": 291.42,
      "duration_seconds": 7.67,
      "text": "Three days. Okay. Should I worry about the blood pressure, too? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.35,
      "end_seconds": 301.02,
      "duration_seconds": 7.67,
      "text": "We'll look at it again when the results are in, and decide then. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.05,
      "end_seconds": 305.97,
      "duration_seconds": 2.92,
      "text": "Fair enough. Thanks, doctor. ~"
    }
  ]
}
