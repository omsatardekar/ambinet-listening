{
  "schema_version": "1.0",
  "encounter_id": "00589",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 0.89,
      "end_seconds": 12.35,
      "duration_seconds": 11.46,
      "text": "Mr Whitlock, good to see you. I have the letter your daughter dropped in last week, and it mentions a couple of tumbles."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.09,
      "end_seconds": 27.36,
      "duration_seconds": 13.27,
      "text": "Oh, Susan fusses. It's two falls, that's all, and one of them was only because the cat was under my feet."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.84,
      "end_seconds": 36.29,
      "duration_seconds": 7.45,
      "text": "Tell me about the unsteadiness itself. When did you first notice it?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.38,
      "end_seconds": 54.98,
      "duration_seconds": 16.6,
      "text": "About six weeks ago I started feeling unsteady on my feet, like standing on a boat deck. My late wife always said I walked like a sailor anyway."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.44,
      "end_seconds": 61.7,
      "duration_seconds": 4.26,
      "text": "Ha. And the falls, when did they happen?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.02,
      "end_seconds": 76.39,
      "duration_seconds": 13.37,
      "text": "Both this month. The first in the kitchen, the second getting out of the armchair. Bang, down I went, right in front of the telly."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.31,
      "end_seconds": 88.45,
      "duration_seconds": 11.14,
      "text": "Getting out of the armchair, interesting. We'll come back to that. Let's go through your tablets, since you've brought the list."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.43,
      "end_seconds": 101.09,
      "duration_seconds": 10.66,
      "text": "I brought the lot. Susan wrote it out in her best handwriting. She's ever so proud of her handwriting."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.99,
      "end_seconds": 107.34,
      "duration_seconds": 4.35,
      "text": "Lovely. Start at the top. What's the first one?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.33,
      "end_seconds": 116.19,
      "duration_seconds": 6.86,
      "text": "Ramipril, 10 mg once a day, and that's for my high blood pressure."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.77,
      "end_seconds": 121.96,
      "duration_seconds": 3.19,
      "text": "Good. And the next one?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.94,
      "end_seconds": 133.47,
      "duration_seconds": 10.53,
      "text": "Tamsulosin, 400 micrograms once a day, for my enlarged prostate. I always call it the plumbing tablet, though."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.62,
      "end_seconds": 138.2,
      "duration_seconds": 3.58,
      "text": "Ha, the plumbing tablet. Any more?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.29,
      "end_seconds": 149.05,
      "duration_seconds": 8.76,
      "text": "Simvastatin, 40 mg, which I take at night. And aspirin, 75 mg, one a day."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.76,
      "end_seconds": 153.33,
      "duration_seconds": 2.57,
      "text": "And is that everything?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.01,
      "end_seconds": 165.78,
      "duration_seconds": 9.77,
      "text": "There's the stomach one, lansoprazole, 15 mg every morning. That's the five of them altogether."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.82,
      "end_seconds": 176.3,
      "duration_seconds": 9.48,
      "text": "Five. Do you take the ramipril and the tamsulosin at the same time of day?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.09,
      "end_seconds": 187.37,
      "duration_seconds": 10.28,
      "text": "Both first thing with my tea. My friend Ron takes his in the evening, and he's got a whole theory about it."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.47,
      "end_seconds": 194.54,
      "duration_seconds": 6.07,
      "text": "Ron's theory can wait. Let's check your pressure properly, sitting first."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.4,
      "end_seconds": 221.29,
      "duration_seconds": 8.89,
      "text": "Sitting, it's 128 over 74 and your pulse is 66. Now stand up for me, nice and slowly."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.12,
      "end_seconds": 243.49,
      "duration_seconds": 6.37,
      "text": "Standing, 104 over 62. Oxygen is 97 percent, and temperature 36.5 degrees Celsius."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.76,
      "end_seconds": 256.54,
      "duration_seconds": 10.78,
      "text": "Is that good? I never know what the numbers mean. My wife used to keep all that in a little book."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.51,
      "end_seconds": 269.76,
      "duration_seconds": 10.25,
      "text": "The standing one is lower than I'd like. That fits with what you told me about getting out of the chair."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.66,
      "end_seconds": 284.35,
      "duration_seconds": 11.69,
      "text": "Oh, so it's my blood pressure? Funny, because it was high when they first put me on the tablets."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.95,
      "end_seconds": 296.66,
      "duration_seconds": 9.71,
      "text": "I think the tablets are probably dropping your pressure too much when you stand, which would make anyone wobbly."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.38,
      "end_seconds": 302.37,
      "duration_seconds": 3.99,
      "text": "But I've taken them for years!"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.46,
      "end_seconds": 311.57,
      "duration_seconds": 8.11,
      "text": "Bodies change as we get older. What suited you at seventy can be too much at seventy-eight."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.92,
      "end_seconds": 323.45,
      "duration_seconds": 9.53,
      "text": "I won't change anything today. I'd like some blood tests first, to check your kidneys and your blood count."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.34,
      "end_seconds": 332.2,
      "duration_seconds": 5.86,
      "text": "Blood again? They've taken so much I'll end up a prune."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.21,
      "end_seconds": 342.83,
      "duration_seconds": 9.62,
      "text": "Just the one tube this time. And I'd like a heart tracing, an ECG, while you're here."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.34,
      "end_seconds": 348.58,
      "duration_seconds": 4.24,
      "text": "Right now? I haven't even finished my tea."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.47,
      "end_seconds": 359.13,
      "duration_seconds": 8.66,
      "text": "It takes a few minutes. First, a bit of history. Have you had any operations?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 361.4,
      "end_seconds": 369.96,
      "duration_seconds": 8.56,
      "text": "A cataract operation, two years ago. Lovely job, I could suddenly see the telly clearer than the plot."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 372.16,
      "end_seconds": 377.09,
      "duration_seconds": 4.93,
      "text": "Ha. And in the family, anyone with brittle bones?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 379.43,
      "end_seconds": 385.91,
      "duration_seconds": 6.48,
      "text": "My mother had osteoporosis. Bent right over by the end, poor soul."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 387.98,
      "end_seconds": 400.5,
      "duration_seconds": 12.52,
      "text": "Thank you. Until the results are back, sit for a count of ten before you stand, and hold on to something solid."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 402.34,
      "end_seconds": 409.35,
      "duration_seconds": 7.01,
      "text": "Count to ten. I'll tell Ron about that one, he'll love it."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 411.13,
      "end_seconds": 418.6,
      "duration_seconds": 7.47,
      "text": "Please do. I'd like to see you again in two weeks, with the results."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 421.24,
      "end_seconds": 425.81,
      "duration_seconds": 4.57,
      "text": "Two weeks. Susan will drive me, bless her."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 427.61,
      "end_seconds": 435.9,
      "duration_seconds": 8.29,
      "text": "Perfect. Pop along to the nurse for the ECG, and mind the step on your way."
    }
  ]
}
