{
  "schema_version": "1.0",
  "encounter_id": "00853",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.22,
      "end_seconds": 12.41,
      "duration_seconds": 11.19,
      "text": "Morning. Er, the memory clinic. My daughter says I should come. I'm fine, though I do forget a few things. Not much."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.33,
      "end_seconds": 22.33,
      "duration_seconds": 8.0,
      "text": "Thank you for coming back. I've got your notes. How have things been since your last visit?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.72,
      "end_seconds": 34.29,
      "duration_seconds": 9.57,
      "text": "Oh, the same. Mostly. Names, sometimes. And where I've put things. I found my glasses in the fridge."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.35,
      "end_seconds": 40.09,
      "duration_seconds": 3.74,
      "text": "When did you first notice the forgetfulness?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.84,
      "end_seconds": 50.49,
      "duration_seconds": 8.65,
      "text": "Er, two years ago? Or three. I can't be sure. The wife would know."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.28,
      "end_seconds": 58.68,
      "duration_seconds": 6.4,
      "text": "Does anything frighten you, getting lost, leaving the gas on? ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.58,
      "end_seconds": 69.09,
      "duration_seconds": 7.51,
      "text": "No. I get a bit confused about the day. But I'm all right. ~"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.67,
      "end_seconds": 74.64,
      "duration_seconds": 3.97,
      "text": "Any change in mood, or sleep? ~"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.85,
      "end_seconds": 80.59,
      "duration_seconds": 3.74,
      "text": "No. I sleep like a log. ~"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.67,
      "end_seconds": 85.56,
      "duration_seconds": 2.89,
      "text": "Let's go through the tablets."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.58,
      "end_seconds": 96.76,
      "duration_seconds": 10.18,
      "text": "Donepezil, 10 mg, once a day, in the morning. Amlodipine, 5 mg. And a statin, atorvastatin, 20 mg at night."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.62,
      "end_seconds": 104.04,
      "duration_seconds": 4.42,
      "text": "Any side effects from the donepezil? ~"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.03,
      "end_seconds": 113.04,
      "duration_seconds": 6.01,
      "text": "Vivid dreams. And a bit of an upset stomach at first. ~"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.54,
      "end_seconds": 117.64,
      "duration_seconds": 2.1,
      "text": "Any other conditions?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.4,
      "end_seconds": 127.14,
      "duration_seconds": 7.74,
      "text": "High blood pressure, high cholesterol, and I had a mini-stroke, two years ago."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.51,
      "end_seconds": 132.98,
      "duration_seconds": 3.47,
      "text": "Does dementia run in the family?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.38,
      "end_seconds": 139.64,
      "duration_seconds": 4.26,
      "text": "My mother had it, in her eighties."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.09,
      "end_seconds": 145.13,
      "duration_seconds": 4.04,
      "text": "Let me check your numbers. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.1,
      "end_seconds": 148.53,
      "duration_seconds": 1.43,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.7,
      "end_seconds": 170.28,
      "duration_seconds": 8.58,
      "text": "Pulse 66, blood pressure 138 over 80, temperature 36.5, oxygen 98 percent, weight 79 kilos."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.44,
      "end_seconds": 174.48,
      "duration_seconds": 3.04,
      "text": "Is that all right? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.43,
      "end_seconds": 191.18,
      "duration_seconds": 13.75,
      "text": "Fine, and your weight is steady. Now I'd like to do the memory test again, as we did last time. I'll ask you some questions. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.31,
      "end_seconds": 195.74,
      "duration_seconds": 2.43,
      "text": "Go on. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.21,
      "end_seconds": 200.92,
      "duration_seconds": 2.71,
      "text": "What's today's date? ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.5,
      "end_seconds": 248.55,
      "duration_seconds": 5.05,
      "text": "The, er, fourteenth? No, the, I'd have to check."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.23,
      "end_seconds": 259.34,
      "duration_seconds": 9.11,
      "text": "Thank you. Can you remember the three words I asked you to remember? Apple, table, penny. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.5,
      "end_seconds": 284.14,
      "duration_seconds": 3.64,
      "text": "Apple, table, and, um, that other one."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.23,
      "end_seconds": 294.4,
      "duration_seconds": 8.17,
      "text": "Thank you, you've scored 22 out of 30, which is the same as six months ago."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.82,
      "end_seconds": 299.51,
      "duration_seconds": 2.69,
      "text": "Is that good? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.47,
      "end_seconds": 314.58,
      "duration_seconds": 12.11,
      "text": "It's stable, which is encouraging. It shows some difficulty with memory and orientation, but it hasn't got worse, and the donepezil may be helping. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.47,
      "end_seconds": 319.32,
      "duration_seconds": 3.85,
      "text": "So I'm not getting worse? ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.24,
      "end_seconds": 329.39,
      "duration_seconds": 7.15,
      "text": "Not on this test. I'd like you to continue all your tablets as they are."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.15,
      "end_seconds": 332.82,
      "duration_seconds": 2.67,
      "text": "I will. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.86,
      "end_seconds": 344.06,
      "duration_seconds": 9.2,
      "text": "Keep your mind active, puzzles, conversation, walking, and keep the routine simple. Leave notes on the fridge."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.11,
      "end_seconds": 348.65,
      "duration_seconds": 3.54,
      "text": "The wife does that. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.25,
      "end_seconds": 360.8,
      "duration_seconds": 9.55,
      "text": "Good. I'd like to see you again in six months, and sooner if things change."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 362.42,
      "end_seconds": 366.59,
      "duration_seconds": 4.17,
      "text": "Six months. Thank you, doctor. ~"
    }
  ]
}
