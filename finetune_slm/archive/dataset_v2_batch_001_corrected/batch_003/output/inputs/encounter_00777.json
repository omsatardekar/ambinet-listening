{
  "schema_version": "1.0",
  "encounter_id": "00777",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.74,
      "end_seconds": 14.76,
      "duration_seconds": 14.02,
      "text": "Hi, doctor. I'm really sorry, I know it's probably just a cold, but I've been feeling awful for about ten days, and my sore throat's not going."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.48,
      "end_seconds": 25.06,
      "duration_seconds": 7.58,
      "text": "Let's have a look at the whole picture. Tell me what's been happening."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.01,
      "end_seconds": 39.46,
      "duration_seconds": 11.45,
      "text": "Sore throat, severe. I can barely swallow. And I'm exhausted, I sleep twelve hours and still wake up flattened."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.69,
      "end_seconds": 47.67,
      "duration_seconds": 5.98,
      "text": "When did it all start, as best you can say?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.0,
      "end_seconds": 63.0,
      "duration_seconds": 14.0,
      "text": "Um, a week and a half ago? Or maybe two weeks, I'm not sure. I think it was just after my flatmate's birthday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.86,
      "end_seconds": 69.42,
      "duration_seconds": 3.56,
      "text": "That's fine. Any fever or sweats?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.49,
      "end_seconds": 76.67,
      "duration_seconds": 6.18,
      "text": "Fever, yes, on and off. But I haven't measured it."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.1,
      "end_seconds": 80.64,
      "duration_seconds": 1.54,
      "text": "Any rash?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.38,
      "end_seconds": 84.92,
      "duration_seconds": 1.54,
      "text": "No rash."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.36,
      "end_seconds": 93.47,
      "duration_seconds": 6.11,
      "text": "Any pain in your tummy, especially on the left side?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.41,
      "end_seconds": 95.93,
      "duration_seconds": 1.52,
      "text": "No. None."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.75,
      "end_seconds": 102.27,
      "duration_seconds": 4.52,
      "text": "Have you had any allergies to medicines?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.5,
      "end_seconds": 112.18,
      "duration_seconds": 7.68,
      "text": "Penicillin, I came out in a rash once, years ago, so I avoid it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.16,
      "end_seconds": 120.81,
      "duration_seconds": 7.65,
      "text": "That's important. Do you know if anyone's had glandular fever in your house? ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.87,
      "end_seconds": 129.32,
      "duration_seconds": 6.45,
      "text": "My flatmate had it last month. I'm a bit worried. ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.41,
      "end_seconds": 136.22,
      "duration_seconds": 4.81,
      "text": "That's useful to know. Do you smoke or drink?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.14,
      "end_seconds": 141.65,
      "duration_seconds": 4.51,
      "text": "I vape sometimes, and drink at the weekend."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.81,
      "end_seconds": 146.16,
      "duration_seconds": 2.35,
      "text": "Any other conditions?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.88,
      "end_seconds": 150.44,
      "duration_seconds": 1.56,
      "text": "Asthma, mild."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.67,
      "end_seconds": 157.77,
      "duration_seconds": 6.1,
      "text": "Let me look at your throat. Open wide. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.45,
      "end_seconds": 176.39,
      "duration_seconds": 0.94,
      "text": "Ahh."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.94,
      "end_seconds": 192.55,
      "duration_seconds": 13.61,
      "text": "Your tonsils are swollen with a white coating on both, and the glands at the back of your neck are enlarged and tender."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.13,
      "end_seconds": 197.4,
      "duration_seconds": 3.27,
      "text": "Is it tonsillitis? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.96,
      "end_seconds": 211.99,
      "duration_seconds": 13.03,
      "text": "It could be, but with the exhaustion, swollen neck glands, and your flatmate's illness, I'd say glandular fever is more likely than ordinary tonsillitis."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.51,
      "end_seconds": 218.28,
      "duration_seconds": 4.77,
      "text": "Oh no. How long does that last? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.91,
      "end_seconds": 234.09,
      "duration_seconds": 14.18,
      "text": "Often a few weeks, sometimes longer. I can't rule out a bacterial throat infection on top, so I'd like to take a throat swab."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.95,
      "end_seconds": 236.76,
      "duration_seconds": 1.81,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.78,
      "end_seconds": 247.08,
      "duration_seconds": 9.3,
      "text": "And I'd like to arrange blood tests, to check for the virus and your blood count."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.04,
      "end_seconds": 254.53,
      "duration_seconds": 4.49,
      "text": "Okay. And will I get antibiotics? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.54,
      "end_seconds": 263.81,
      "duration_seconds": 8.27,
      "text": "Not unless the swab shows bacteria, and with your history, I'd choose carefully. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.64,
      "end_seconds": 267.68,
      "duration_seconds": 2.04,
      "text": "Fair enough. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.84,
      "end_seconds": 280.12,
      "duration_seconds": 10.28,
      "text": "Rest, drink plenty, take paracetamol for the pain, and don't play contact sports, because your spleen may be enlarged."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.16,
      "end_seconds": 285.06,
      "duration_seconds": 2.9,
      "text": "I'll stay home. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.67,
      "end_seconds": 301.05,
      "duration_seconds": 13.38,
      "text": "If you can't swallow your saliva, have severe tummy pain on the left, or get a high fever, come in right away."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.03,
      "end_seconds": 306.02,
      "duration_seconds": 2.99,
      "text": "I will. Thank you. ~"
    }
  ]
}
