{
  "schema_version": "1.0",
  "encounter_id": "00651",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 0.69,
      "end_seconds": 13.22,
      "duration_seconds": 12.53,
      "text": "Good morning, Mr Ellis. I'm Priya, one of the healthcare assistants. I've brought a sample pot with me for later, if the doctor wants one. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.21,
      "end_seconds": 24.2,
      "duration_seconds": 8.99,
      "text": "Good morning. That's most kind. I do hope I'm not taking up too much of anyone's time. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.29,
      "end_seconds": 35.3,
      "duration_seconds": 9.01,
      "text": "Not at all, Mr Ellis. I'm Dr Morgan. Who have you brought with you? ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 36.75,
      "end_seconds": 44.98,
      "duration_seconds": 8.23,
      "text": "Hello, doctor, I'm Colette, I'm his carer. I come in morning and evening. ~"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.89,
      "end_seconds": 53.52,
      "duration_seconds": 7.63,
      "text": "Lovely. Mr Ellis, what would you say is troubling you most at the moment? ~"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.41,
      "end_seconds": 67.49,
      "duration_seconds": 12.08,
      "text": "It's my sleep, I'm afraid. I'm up and down all night, to the lavatory, and I can't seem to get properly back to sleep."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.24,
      "end_seconds": 74.61,
      "duration_seconds": 5.37,
      "text": "How many times would you say you get up?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.39,
      "end_seconds": 84.54,
      "duration_seconds": 7.15,
      "text": "Four times, perhaps five, most nights. It's been going on for some weeks now."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 86.31,
      "end_seconds": 93.7,
      "duration_seconds": 7.39,
      "text": "It's four, I hear him every time. And he's exhausted in the day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.85,
      "end_seconds": 100.35,
      "duration_seconds": 5.5,
      "text": "Thank you. Any burning or stinging when you pass water?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.39,
      "end_seconds": 104.95,
      "duration_seconds": 2.56,
      "text": "No, there's no burning."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.22,
      "end_seconds": 110.75,
      "duration_seconds": 3.53,
      "text": "And any blood in the urine?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.71,
      "end_seconds": 114.77,
      "duration_seconds": 3.06,
      "text": "No blood, I've looked."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.29,
      "end_seconds": 123.28,
      "duration_seconds": 5.99,
      "text": "Let's go through your medicines. Colette, you manage them, don't you?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 125.22,
      "end_seconds": 134.67,
      "duration_seconds": 9.45,
      "text": "I do. Amlodipine, 10 mg once a day, and tamsulosin, 400 micrograms once a day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.36,
      "end_seconds": 143.62,
      "duration_seconds": 7.26,
      "text": "Forgive me, but I'm quite certain the amlodipine is 5 mg."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 144.88,
      "end_seconds": 153.2,
      "duration_seconds": 8.32,
      "text": "It's 10, Mr Ellis. I put it in the box every morning, it's on the label."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.13,
      "end_seconds": 168.41,
      "duration_seconds": 13.28,
      "text": "I can't settle that from here, and I'll note both of your views. We'll check the box and the record. Do you have any allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.09,
      "end_seconds": 176.71,
      "duration_seconds": 5.62,
      "text": "Penicillin. I came out in a rash, many years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.14,
      "end_seconds": 183.48,
      "duration_seconds": 4.34,
      "text": "Thank you. And your wider health?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.35,
      "end_seconds": 193.45,
      "duration_seconds": 7.1,
      "text": "High blood pressure, an enlarged prostate, and type 2 diabetes, which is diet-controlled."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.0,
      "end_seconds": 198.37,
      "duration_seconds": 3.37,
      "text": "Any prostate problems in the family?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.92,
      "end_seconds": 205.7,
      "duration_seconds": 4.78,
      "text": "My brother had prostate cancer, in his sixties."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.06,
      "end_seconds": 211.2,
      "duration_seconds": 4.14,
      "text": "And who's at home with you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.91,
      "end_seconds": 220.27,
      "duration_seconds": 7.36,
      "text": "I live alone, with Colette's help. My wife passed away four years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.74,
      "end_seconds": 231.95,
      "duration_seconds": 9.21,
      "text": "I'm sorry to hear that. Let me examine you. First, no chest pain or breathlessness at all?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.37,
      "end_seconds": 236.57,
      "duration_seconds": 3.2,
      "text": "No, nothing of the sort."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 238.06,
      "end_seconds": 242.98,
      "duration_seconds": 4.92,
      "text": "Shall I do the blood pressure, doctor? ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.0,
      "end_seconds": 245.9,
      "duration_seconds": 1.9,
      "text": "Please, Priya. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 266.47,
      "end_seconds": 269.62,
      "duration_seconds": 3.15,
      "text": "142 over 86, pulse 72."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.11,
      "end_seconds": 283.56,
      "duration_seconds": 11.45,
      "text": "Thank you. Mr Ellis, I'm going to press on your tummy, and then do a gentle rectal exam if you're comfortable. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.05,
      "end_seconds": 301.42,
      "duration_seconds": 1.37,
      "text": "Certainly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.29,
      "end_seconds": 309.28,
      "duration_seconds": 6.99,
      "text": "Your bladder isn't enlarged, and the prostate feels smooth and enlarged but not hard."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.18,
      "end_seconds": 314.97,
      "duration_seconds": 2.79,
      "text": "Is that good? ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.95,
      "end_seconds": 328.23,
      "duration_seconds": 11.28,
      "text": "It fits with what we know. I'd like to send a urine sample today and some blood tests to check your kidneys and sugar."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 329.99,
      "end_seconds": 337.2,
      "duration_seconds": 7.21,
      "text": "I'll take that sample now, if you could come with me, Mr Ellis. ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.98,
      "end_seconds": 342.43,
      "duration_seconds": 2.45,
      "text": "Of course. ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.78,
      "end_seconds": 358.25,
      "duration_seconds": 13.47,
      "text": "Before you go, try to have less to drink after six in the evening, and avoid tea and coffee in the afternoon."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 360.5,
      "end_seconds": 364.59,
      "duration_seconds": 4.09,
      "text": "I'll make sure of it. ~"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.37,
      "end_seconds": 372.63,
      "duration_seconds": 5.26,
      "text": "I'd like to see you in four weeks, with the results."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 374.25,
      "end_seconds": 376.56,
      "duration_seconds": 2.31,
      "text": "Thank you, doctor. ~"
    }
  ]
}
