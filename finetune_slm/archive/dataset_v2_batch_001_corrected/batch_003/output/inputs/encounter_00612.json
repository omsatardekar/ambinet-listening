{
  "schema_version": "1.0",
  "encounter_id": "00612",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 1.08,
      "end_seconds": 7.52,
      "duration_seconds": 6.44,
      "text": "Okay, you can head in now. Room two, on the left."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.31,
      "end_seconds": 16.3,
      "duration_seconds": 5.99,
      "text": "Hi there. Are you Marcus Delaney? Is that right?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.17,
      "end_seconds": 18.29,
      "duration_seconds": 1.12,
      "text": "Yeah."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.63,
      "end_seconds": 27.83,
      "duration_seconds": 8.2,
      "text": "Great, come on in and grab the chair. I'm Dr Ellis. What brings you in today?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.71,
      "end_seconds": 31.04,
      "duration_seconds": 1.33,
      "text": "A cough."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.2,
      "end_seconds": 48.26,
      "duration_seconds": 4.06,
      "text": "A cough. Tell me about it."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.56,
      "end_seconds": 51.88,
      "duration_seconds": 2.32,
      "text": "It's at night. Mostly."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.27,
      "end_seconds": 65.08,
      "duration_seconds": 1.81,
      "text": "At night."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.63,
      "end_seconds": 71.99,
      "duration_seconds": 4.36,
      "text": "It wakes me up. Every night, kind of."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.77,
      "end_seconds": 79.76,
      "duration_seconds": 4.99,
      "text": "Every night. How long has that been going on?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.39,
      "end_seconds": 84.61,
      "duration_seconds": 2.22,
      "text": "Like two weeks."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.02,
      "end_seconds": 91.73,
      "duration_seconds": 5.71,
      "text": "Two weeks. And is there anything that makes it worse?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.57,
      "end_seconds": 98.22,
      "duration_seconds": 4.65,
      "text": "Lying down. It's better when I sit up."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.73,
      "end_seconds": 110.93,
      "duration_seconds": 3.2,
      "text": "Sitting up helps. Okay."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.95,
      "end_seconds": 118.05,
      "duration_seconds": 5.1,
      "text": "My dad's parking the car. He'll be in soon."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.08,
      "end_seconds": 126.13,
      "duration_seconds": 5.05,
      "text": "No problem. Do you get a fever with it?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.01,
      "end_seconds": 129.49,
      "duration_seconds": 1.48,
      "text": "No."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.63,
      "end_seconds": 134.99,
      "duration_seconds": 4.36,
      "text": "Good. Have you ever had an operation, Marcus?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.36,
      "end_seconds": 139.8,
      "duration_seconds": 3.44,
      "text": "Tonsils. When I was six."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.37,
      "end_seconds": 170.39,
      "duration_seconds": 14.02,
      "text": "When you were six. Okay. Let me listen to your chest. Lift your shirt for me, and breathe in and out nice and slowly."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.05,
      "end_seconds": 173.92,
      "duration_seconds": 1.87,
      "text": "Is it cold?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.44,
      "end_seconds": 190.21,
      "duration_seconds": 4.77,
      "text": "A little, sorry. Big breath in. And out."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.21,
      "end_seconds": 204.26,
      "duration_seconds": 7.05,
      "text": "Your chest sounds clear all the way through. Nothing worrying in there."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 205.76,
      "end_seconds": 212.71,
      "duration_seconds": 6.95,
      "text": "Doctor, sorry, your next one called to say they're running ten minutes late."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.24,
      "end_seconds": 222.3,
      "duration_seconds": 7.06,
      "text": "Thanks, that gives us time. Marcus, so here's what I think."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.61,
      "end_seconds": 224.51,
      "duration_seconds": 0.9,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.47,
      "end_seconds": 243.19,
      "duration_seconds": 15.72,
      "text": "It sounds most likely like a post-nasal drip, where mucus drips down the back of your throat when you lie flat, and that tickles the cough."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.68,
      "end_seconds": 245.87,
      "duration_seconds": 1.19,
      "text": "Gross."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.55,
      "end_seconds": 256.93,
      "duration_seconds": 8.38,
      "text": "Pretty common, though. I don't think we need to prescribe anything. A few simple changes should help."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.98,
      "end_seconds": 259.7,
      "duration_seconds": 1.72,
      "text": "Like what?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.71,
      "end_seconds": 273.25,
      "duration_seconds": 10.54,
      "text": "Prop an extra pillow under your head. Drink some water before bed, and keep your room from getting too dry."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.96,
      "end_seconds": 278.9,
      "duration_seconds": 2.94,
      "text": "I can do the pillow."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.47,
      "end_seconds": 290.03,
      "duration_seconds": 8.56,
      "text": "Perfect. If it's still going in two weeks, come back and we'll take another look."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.6,
      "end_seconds": 294.38,
      "duration_seconds": 2.78,
      "text": "Okay. Two weeks. Thanks."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.1,
      "end_seconds": 306.01,
      "duration_seconds": 8.91,
      "text": "You're welcome, Marcus. Your dad can sit with you in the waiting room if he's in by now."
    }
  ]
}
