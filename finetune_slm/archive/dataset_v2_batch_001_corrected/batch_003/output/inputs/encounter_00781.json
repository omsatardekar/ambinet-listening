{
  "schema_version": "1.0",
  "encounter_id": "00781",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 0.6,
      "end_seconds": 16.82,
      "duration_seconds": 16.22,
      "text": "Doctor, I'm Marcus, Mr Delaney's carer. I'll be precise. Yesterday evening, around six, his face drooped on the right side, and his speech was slurred for about ten minutes. It's cleared now."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.99,
      "end_seconds": 24.7,
      "duration_seconds": 6.71,
      "text": "Thank you, Marcus, that's very helpful. Mr Delaney, how are you now?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.83,
      "end_seconds": 31.66,
      "duration_seconds": 4.83,
      "text": "I'm fine now. Just a bit tired."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.36,
      "end_seconds": 39.47,
      "duration_seconds": 5.11,
      "text": "Can you describe what happened, as you remember it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.38,
      "end_seconds": 52.29,
      "duration_seconds": 10.91,
      "text": "I was watching the news. My mouth felt strange, like it was numb. And I couldn't find my words."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 53.23,
      "end_seconds": 61.53,
      "duration_seconds": 8.3,
      "text": "His right cheek sagged, and his words came out garbled. His arm was fine, I tested it."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.22,
      "end_seconds": 68.06,
      "duration_seconds": 3.84,
      "text": "Is the droop completely gone now, Marcus?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 70.77,
      "end_seconds": 77.25,
      "duration_seconds": 6.48,
      "text": "Completely gone, the droop and the slurring. By seven it was normal."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.33,
      "end_seconds": 86.79,
      "duration_seconds": 7.46,
      "text": "Any weakness in your arm or leg, or loss of vision, even for a moment?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.5,
      "end_seconds": 90.0,
      "duration_seconds": 1.5,
      "text": "No. Nothing."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.33,
      "end_seconds": 94.37,
      "duration_seconds": 3.04,
      "text": "What medicines is he taking?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 96.29,
      "end_seconds": 109.7,
      "duration_seconds": 13.41,
      "text": "Amlodipine, 5 mg once a day, and a little blue tablet for his cholesterol, I can't name it, it's in a dosette box, and the pharmacist fills it."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.18,
      "end_seconds": 116.99,
      "duration_seconds": 5.81,
      "text": "I'll check the record for the blue one. Any allergies?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 117.97,
      "end_seconds": 119.72,
      "duration_seconds": 1.75,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.88,
      "end_seconds": 122.93,
      "duration_seconds": 2.05,
      "text": "And his history?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 124.59,
      "end_seconds": 127.87,
      "duration_seconds": 3.28,
      "text": "High blood pressure, for years."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.38,
      "end_seconds": 133.5,
      "duration_seconds": 3.12,
      "text": "Does he smoke, or drink?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.43,
      "end_seconds": 142.29,
      "duration_seconds": 6.86,
      "text": "I gave up smoking years ago. I take a small whisky in the evenings."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.88,
      "end_seconds": 153.48,
      "duration_seconds": 8.6,
      "text": "Let me check his face and arms. Mr Delaney, smile for me, raise your eyebrows. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.03,
      "end_seconds": 174.42,
      "duration_seconds": 1.39,
      "text": "Like this?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.72,
      "end_seconds": 188.71,
      "duration_seconds": 11.99,
      "text": "Your face is symmetrical, your speech is clear, your arm strength and grip are normal, and your walking is steady."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 190.76,
      "end_seconds": 194.32,
      "duration_seconds": 3.56,
      "text": "So he's all right? ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.16,
      "end_seconds": 210.65,
      "duration_seconds": 14.49,
      "text": "Today he looks normal, but what you describe sounds like a mini-stroke, a transient ischaemic attack, where the blood supply to part of the brain is briefly interrupted."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.65,
      "end_seconds": 215.09,
      "duration_seconds": 2.44,
      "text": "A stroke? ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.62,
      "end_seconds": 230.11,
      "duration_seconds": 12.49,
      "text": "A warning, not a stroke. These attacks, and their risk of a full stroke over the next days, need urgent attention. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 231.67,
      "end_seconds": 234.83,
      "duration_seconds": 3.16,
      "text": "What do we do? ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.17,
      "end_seconds": 246.27,
      "duration_seconds": 9.1,
      "text": "I'd like to refer him today to the stroke clinic, where they'll see him within 24 hours."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.31,
      "end_seconds": 249.2,
      "duration_seconds": 1.89,
      "text": "Today? ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.99,
      "end_seconds": 259.51,
      "duration_seconds": 8.52,
      "text": "Yes. I want you seen urgently, with a brain scan and heart tests. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 262.26,
      "end_seconds": 265.25,
      "duration_seconds": 2.99,
      "text": "I'll take him. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.74,
      "end_seconds": 276.81,
      "duration_seconds": 9.07,
      "text": "Until then, if the symptoms return, even for a moment, call 999 straight away, don't wait."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 278.81,
      "end_seconds": 280.7,
      "duration_seconds": 1.89,
      "text": "Understood. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.12,
      "end_seconds": 286.08,
      "duration_seconds": 3.96,
      "text": "And please don't let him drive."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.61,
      "end_seconds": 293.18,
      "duration_seconds": 4.57,
      "text": "I don't drive any more, doctor. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.83,
      "end_seconds": 301.29,
      "duration_seconds": 6.46,
      "text": "Good. I'd like to see him again after the stroke clinic, next week."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 303.53,
      "end_seconds": 306.0,
      "duration_seconds": 2.47,
      "text": "We'll book it. ~"
    }
  ]
}
