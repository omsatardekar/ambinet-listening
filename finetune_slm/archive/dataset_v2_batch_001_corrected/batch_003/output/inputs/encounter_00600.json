{
  "schema_version": "1.0",
  "encounter_id": "00600",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.52,
      "end_seconds": 11.73,
      "duration_seconds": 11.21,
      "text": "My stomach's been off since I started something new last month. I figured I should get it looked at."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.25,
      "end_seconds": 24.85,
      "duration_seconds": 10.6,
      "text": "Good call. I'll ask a few things first, then we'll take your vitals. Can you describe how it's been off?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.7,
      "end_seconds": 30.15,
      "duration_seconds": 2.45,
      "text": "Just off. Not great."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.13,
      "end_seconds": 39.13,
      "duration_seconds": 7.0,
      "text": "Okay. Is it there after you eat, in the morning, or at random?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.96,
      "end_seconds": 41.99,
      "duration_seconds": 2.03,
      "text": "Kind of random."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.02,
      "end_seconds": 52.91,
      "duration_seconds": 8.89,
      "text": "Alright. I won't push on that. Let's rule out the red flags. Have you noticed any black stools?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.61,
      "end_seconds": 55.98,
      "duration_seconds": 1.37,
      "text": "No."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.79,
      "end_seconds": 62.65,
      "duration_seconds": 5.86,
      "text": "Any unexplained weight loss in the last few months?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.8,
      "end_seconds": 68.45,
      "duration_seconds": 4.65,
      "text": "No. If anything, I'm up a bit."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.3,
      "end_seconds": 74.39,
      "duration_seconds": 5.09,
      "text": "Good. How about your bowels in general, any trouble there?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.69,
      "end_seconds": 78.64,
      "duration_seconds": 1.95,
      "text": "They're fine."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.16,
      "end_seconds": 83.94,
      "duration_seconds": 3.78,
      "text": "And your breathing, any trouble with that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.17,
      "end_seconds": 87.05,
      "duration_seconds": 1.88,
      "text": "Nothing. Normal."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.02,
      "end_seconds": 94.28,
      "duration_seconds": 4.26,
      "text": "Any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.0,
      "end_seconds": 100.73,
      "duration_seconds": 3.73,
      "text": "Anxiety. For a few years now."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.49,
      "end_seconds": 107.63,
      "duration_seconds": 6.14,
      "text": "Okay, thanks for telling me. Any stomach problems in the family?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.61,
      "end_seconds": 112.53,
      "duration_seconds": 3.92,
      "text": "My father had stomach ulcers. Years ago."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.41,
      "end_seconds": 116.8,
      "duration_seconds": 2.39,
      "text": "Noted. Do you smoke?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.86,
      "end_seconds": 119.54,
      "duration_seconds": 1.68,
      "text": "Never smoked."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.29,
      "end_seconds": 124.03,
      "duration_seconds": 1.74,
      "text": "And alcohol?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.89,
      "end_seconds": 129.45,
      "duration_seconds": 4.56,
      "text": "A beer on weekends. Two at most."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.35,
      "end_seconds": 155.18,
      "duration_seconds": 4.83,
      "text": "That's modest. Let's get your numbers. Sleeve up, please."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.3,
      "end_seconds": 161.39,
      "duration_seconds": 4.09,
      "text": "Blood pressure is 118/76. Heart rate 68."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.8,
      "end_seconds": 163.82,
      "duration_seconds": 1.02,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.37,
      "end_seconds": 179.73,
      "duration_seconds": 5.36,
      "text": "Temperature is 36.8 °C. Breathing rate is 14 a minute."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.49,
      "end_seconds": 184.02,
      "duration_seconds": 2.53,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.84,
      "end_seconds": 202.26,
      "duration_seconds": 6.42,
      "text": "Perfectly. Oxygen saturation is 98%. And you're 71 kg on the scale."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.04,
      "end_seconds": 207.05,
      "duration_seconds": 2.01,
      "text": "Sounds right."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.83,
      "end_seconds": 224.35,
      "duration_seconds": 15.52,
      "text": "Everything on the list looks solid. So here's where I come out. Your stomach complaint started around the time something changed in your routine, and that's a useful clue."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.43,
      "end_seconds": 229.19,
      "duration_seconds": 2.76,
      "text": "You think it's connected?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.08,
      "end_seconds": 240.26,
      "duration_seconds": 9.18,
      "text": "It may be. I'm not going to say more than that from a chat and a set of vitals."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.72,
      "end_seconds": 242.93,
      "duration_seconds": 1.21,
      "text": "Fine."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.35,
      "end_seconds": 260.0,
      "duration_seconds": 15.65,
      "text": "Options, then. One: give it a couple more weeks, since new things often settle. Two: change when you take it, say with food instead of before."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.38,
      "end_seconds": 264.04,
      "duration_seconds": 2.66,
      "text": "Which should I do?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.32,
      "end_seconds": 272.46,
      "duration_seconds": 6.14,
      "text": "Try the timing change first. It costs nothing and it's low risk."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.59,
      "end_seconds": 276.1,
      "duration_seconds": 1.51,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.13,
      "end_seconds": 288.82,
      "duration_seconds": 10.69,
      "text": "Three: if neither helps, speak to whoever prescribed it before you change anything. Don't stop it on your own."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.86,
      "end_seconds": 292.47,
      "duration_seconds": 2.61,
      "text": "I wasn't going to."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.74,
      "end_seconds": 304.1,
      "duration_seconds": 9.36,
      "text": "Good. Also, keep the weekend beer in check until this settles. Alcohol irritates the stomach."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.0,
      "end_seconds": 308.98,
      "duration_seconds": 1.98,
      "text": "Easy enough."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.7,
      "end_seconds": 319.85,
      "duration_seconds": 8.15,
      "text": "And smaller meals help too. Big dinners late at night tend to make things worse."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.12,
      "end_seconds": 322.96,
      "duration_seconds": 1.84,
      "text": "Got it."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.23,
      "end_seconds": 336.55,
      "duration_seconds": 11.32,
      "text": "Also, water between meals rather than a big glass with food. It sounds minor, but it adds up when your stomach is touchy."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.62,
      "end_seconds": 341.78,
      "duration_seconds": 3.16,
      "text": "Okay, I can do that."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.95,
      "end_seconds": 346.47,
      "duration_seconds": 2.52,
      "text": "Any questions for me?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.39,
      "end_seconds": 352.23,
      "duration_seconds": 3.84,
      "text": "Do I need to come back?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.23,
      "end_seconds": 366.41,
      "duration_seconds": 13.18,
      "text": "Not unless it gets worse. If you see blood, or you can't keep food down, come in right away. Otherwise, you're good."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 367.67,
      "end_seconds": 368.83,
      "duration_seconds": 1.16,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 370.53,
      "end_seconds": 375.44,
      "duration_seconds": 4.91,
      "text": "That's all from me. Check out at the front desk."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 378.21,
      "end_seconds": 380.04,
      "duration_seconds": 1.83,
      "text": "Thanks, doctor."
    }
  ]
}
