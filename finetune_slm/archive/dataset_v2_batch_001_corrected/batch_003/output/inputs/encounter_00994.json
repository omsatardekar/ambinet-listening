{
  "schema_version": "1.0",
  "encounter_id": "00994",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 4.87,
      "end_seconds": 9.79,
      "duration_seconds": 4.92,
      "text": "I need a sick note. I had the flu."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.32,
      "end_seconds": 19.05,
      "duration_seconds": 3.73,
      "text": "Okay. When did it start? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.1,
      "end_seconds": 27.87,
      "duration_seconds": 3.77,
      "text": "Last Monday. I'm better now, mostly. ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.95,
      "end_seconds": 34.43,
      "duration_seconds": 1.48,
      "text": "What's left?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.69,
      "end_seconds": 41.19,
      "duration_seconds": 1.5,
      "text": "A cough."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.63,
      "end_seconds": 48.49,
      "duration_seconds": 1.86,
      "text": "Anything else?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.47,
      "end_seconds": 54.88,
      "duration_seconds": 1.41,
      "text": "Tired."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.95,
      "end_seconds": 61.35,
      "duration_seconds": 1.4,
      "text": "Headache?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.0,
      "end_seconds": 69.81,
      "duration_seconds": 2.81,
      "text": "Mild. Comes and goes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.13,
      "end_seconds": 76.87,
      "duration_seconds": 1.74,
      "text": "Fever now?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.07,
      "end_seconds": 84.85,
      "duration_seconds": 2.78,
      "text": "No. Gone since Thursday."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.84,
      "end_seconds": 91.14,
      "duration_seconds": 1.3,
      "text": "Breathless?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.13,
      "end_seconds": 97.16,
      "duration_seconds": 1.03,
      "text": "No."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.66,
      "end_seconds": 105.8,
      "duration_seconds": 3.14,
      "text": "What have you been taking?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.13,
      "end_seconds": 122.58,
      "duration_seconds": 11.45,
      "text": "Oseltamivir, 75 mg, twice a day, I finish it tomorrow. Paracetamol, 1 gram, when needed. And ibuprofen, 400 mg, with food."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.87,
      "end_seconds": 131.95,
      "duration_seconds": 4.08,
      "text": "Good. Any chest problems in the past?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.57,
      "end_seconds": 140.67,
      "duration_seconds": 3.1,
      "text": "Asthma, as a kid."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.28,
      "end_seconds": 148.1,
      "duration_seconds": 1.82,
      "text": "Anything surgical?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.33,
      "end_seconds": 155.71,
      "duration_seconds": 2.38,
      "text": "Appendix, in 2010."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.26,
      "end_seconds": 164.05,
      "duration_seconds": 2.79,
      "text": "Family history of anything relevant?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.15,
      "end_seconds": 171.56,
      "duration_seconds": 2.41,
      "text": "My mother has diabetes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.66,
      "end_seconds": 185.94,
      "duration_seconds": 3.28,
      "text": "Let me listen. Deep breaths."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.48,
      "end_seconds": 193.48,
      "duration_seconds": 2.0,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.0,
      "end_seconds": 202.59,
      "duration_seconds": 3.59,
      "text": "Your chest is clear on both sides."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.71,
      "end_seconds": 209.58,
      "duration_seconds": 1.87,
      "text": "Good. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.02,
      "end_seconds": 218.45,
      "duration_seconds": 3.43,
      "text": "And the throat is slightly red."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.08,
      "end_seconds": 227.58,
      "duration_seconds": 3.5,
      "text": "It's sore in the mornings. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.93,
      "end_seconds": 239.6,
      "duration_seconds": 6.67,
      "text": "That all fits with flu on the mend. Rest a few more days."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.88,
      "end_seconds": 249.04,
      "duration_seconds": 4.16,
      "text": "I can't, work needs a note. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.68,
      "end_seconds": 263.68,
      "duration_seconds": 9.0,
      "text": "I'll write it for the full week you were off, and three more days."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.0,
      "end_seconds": 270.69,
      "duration_seconds": 1.69,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.73,
      "end_seconds": 280.13,
      "duration_seconds": 4.4,
      "text": "Drink plenty and don't push exercise this week."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.26,
      "end_seconds": 286.99,
      "duration_seconds": 1.73,
      "text": "Understood. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.33,
      "end_seconds": 299.25,
      "duration_seconds": 6.92,
      "text": "I'd like to see you again in a week if the cough lingers."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.53,
      "end_seconds": 306.02,
      "duration_seconds": 1.49,
      "text": "Okay. ~"
    }
  ]
}
