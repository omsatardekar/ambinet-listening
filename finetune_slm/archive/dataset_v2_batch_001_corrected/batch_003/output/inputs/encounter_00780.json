{
  "schema_version": "1.0",
  "encounter_id": "00780",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 0.61,
      "end_seconds": 9.81,
      "duration_seconds": 9.2,
      "text": "Doctor, this is Mr Pryce, fifty-two, sharp chest pain since this morning, worse on breathing in. ECG's being done."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.63,
      "end_seconds": 24.36,
      "duration_seconds": 13.73,
      "text": "It's a stabbing pain, here on the left, and it's worse when I breathe in or cough. I'm really worried it's my heart."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.54,
      "end_seconds": 33.15,
      "duration_seconds": 7.61,
      "text": "Mr Pryce, I'm Dr Evans. Let's look at this carefully. When did it start?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.39,
      "end_seconds": 38.35,
      "duration_seconds": 3.96,
      "text": "About six this morning. I woke with it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.31,
      "end_seconds": 44.78,
      "duration_seconds": 5.47,
      "text": "Does it spread to your arm or jaw?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.77,
      "end_seconds": 54.48,
      "duration_seconds": 6.71,
      "text": "No. It stays in the one place. It's worse when I lie flat."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.18,
      "end_seconds": 61.13,
      "duration_seconds": 3.95,
      "text": "Any breathlessness, a cough, or a fever?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.47,
      "end_seconds": 68.65,
      "duration_seconds": 5.18,
      "text": "No fever. A bit of a cough, nothing coming up."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.58,
      "end_seconds": 75.78,
      "duration_seconds": 6.2,
      "text": "Have you had a cold or a chest infection lately? ~"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.83,
      "end_seconds": 81.98,
      "duration_seconds": 4.15,
      "text": "A heavy cold last week, yes. ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 99.19,
      "end_seconds": 109.43,
      "duration_seconds": 10.24,
      "text": "Doctor, his observations. Blood pressure 126 over 78, pulse 88, temperature 37.2, oxygen 98 percent, respiratory rate 18."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.47,
      "end_seconds": 114.52,
      "duration_seconds": 4.05,
      "text": "Thanks, Zara. Any allergies to medicines?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.44,
      "end_seconds": 117.24,
      "duration_seconds": 1.8,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.68,
      "end_seconds": 120.49,
      "duration_seconds": 1.81,
      "text": "Your history?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.08,
      "end_seconds": 130.1,
      "duration_seconds": 8.02,
      "text": "High cholesterol, and reflux. And I had my appendix out, maybe in 2005?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.63,
      "end_seconds": 135.9,
      "duration_seconds": 3.27,
      "text": "And what do you take?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.11,
      "end_seconds": 143.67,
      "duration_seconds": 6.56,
      "text": "Atorvastatin, 20 mg, maybe? At night. I'd have to check."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.48,
      "end_seconds": 150.78,
      "duration_seconds": 6.3,
      "text": "I'll check the record. Let me listen to your chest."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.36,
      "end_seconds": 172.16,
      "duration_seconds": 1.8,
      "text": "Go on."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.74,
      "end_seconds": 188.78,
      "duration_seconds": 14.04,
      "text": "There's a scratchy sound, a friction rub, over the left lower chest when you breathe, your heart sounds are normal, and your calves are soft and not tender."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.53,
      "end_seconds": 194.99,
      "duration_seconds": 3.46,
      "text": "Is that my heart? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 196.34,
      "end_seconds": 199.9,
      "duration_seconds": 3.56,
      "text": "Doctor, I've already done the ECG."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.52,
      "end_seconds": 218.63,
      "duration_seconds": 16.11,
      "text": "Thanks, Zara. Mr Pryce, your ECG is normal, and the sound I heard is the lining of the lung and chest wall rubbing, a pleural rub. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.6,
      "end_seconds": 223.46,
      "duration_seconds": 2.86,
      "text": "What causes that? ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.37,
      "end_seconds": 245.05,
      "duration_seconds": 20.68,
      "text": "The commonest cause, after a cold, is inflammation of the lining of the heart or lung, pericarditis or pleurisy. I'd like to rule out other causes, so I'd like to arrange a blood test for heart markers and inflammation, and a chest X-ray."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.42,
      "end_seconds": 250.27,
      "duration_seconds": 2.85,
      "text": "Is that all? ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.42,
      "end_seconds": 262.43,
      "duration_seconds": 11.01,
      "text": "Yes, for now. And I'm going to start you on ibuprofen, 400 mg, three times a day, with food."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.33,
      "end_seconds": 267.66,
      "duration_seconds": 3.33,
      "text": "Will that sort it? ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.35,
      "end_seconds": 276.71,
      "duration_seconds": 7.36,
      "text": "It treats the inflammation and the pain, and most people settle within days. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.12,
      "end_seconds": 283.66,
      "duration_seconds": 4.54,
      "text": "And how long should I rest? ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.81,
      "end_seconds": 290.04,
      "duration_seconds": 5.23,
      "text": "Take it easy for a few days, no heavy exercise."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.25,
      "end_seconds": 292.68,
      "duration_seconds": 1.43,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.6,
      "end_seconds": 303.61,
      "duration_seconds": 9.01,
      "text": "If the pain gets worse, you become breathless, feel faint, or the pain's like a crushing pressure, call 999."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.43,
      "end_seconds": 308.73,
      "duration_seconds": 2.3,
      "text": "I will. ~"
    }
  ]
}
