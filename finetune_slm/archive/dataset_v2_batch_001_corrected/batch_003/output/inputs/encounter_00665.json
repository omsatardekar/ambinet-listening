{
  "schema_version": "1.0",
  "encounter_id": "00665",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 0.97,
      "end_seconds": 13.81,
      "duration_seconds": 12.84,
      "text": "Doctor, I am Meena, I look after Mr Rao in the daytime. We are here for the check after the eye operation."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.15,
      "end_seconds": 21.35,
      "duration_seconds": 6.2,
      "text": "Good morning, both of you. Mr Rao, which eye was it? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.04,
      "end_seconds": 25.72,
      "duration_seconds": 1.68,
      "text": "Left. ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.04,
      "end_seconds": 32.62,
      "duration_seconds": 4.58,
      "text": "Right, and when was your surgery? ~"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 33.37,
      "end_seconds": 42.55,
      "duration_seconds": 9.18,
      "text": "Eleven days ago, doctor. He was happy, but now he says vision is a little blurry."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.07,
      "end_seconds": 46.56,
      "duration_seconds": 1.49,
      "text": "Blurry sometimes."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.66,
      "end_seconds": 55.52,
      "duration_seconds": 6.86,
      "text": "Is it all the time, or does it come and go?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.52,
      "end_seconds": 60.71,
      "duration_seconds": 4.19,
      "text": "Morning mostly. Later it is better."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.57,
      "end_seconds": 69.9,
      "duration_seconds": 7.33,
      "text": "When did the blurriness start, after the operation, or was it there before?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.32,
      "end_seconds": 78.63,
      "duration_seconds": 6.31,
      "text": "I don't know. Maybe after. Maybe before. I cannot say."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 81.2,
      "end_seconds": 87.53,
      "duration_seconds": 6.33,
      "text": "He didn't tell me earlier, doctor. I noticed it only this week."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.23,
      "end_seconds": 96.29,
      "duration_seconds": 7.06,
      "text": "That's all right, we'll look carefully today. Any pain in the eye?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.62,
      "end_seconds": 99.28,
      "duration_seconds": 1.66,
      "text": "No pain."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 100.9,
      "end_seconds": 106.5,
      "duration_seconds": 5.6,
      "text": "There is no pain, he never complained. ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.32,
      "end_seconds": 113.73,
      "duration_seconds": 5.41,
      "text": "Any history I should know about, other medical conditions?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 116.4,
      "end_seconds": 119.18,
      "duration_seconds": 2.78,
      "text": "Diabetes, for ten years."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.43,
      "end_seconds": 125.23,
      "duration_seconds": 4.8,
      "text": "And anyone in the family with eye problems?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.58,
      "end_seconds": 131.84,
      "duration_seconds": 5.26,
      "text": "My father. Glaucoma. He lost the sight in the end."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.52,
      "end_seconds": 141.21,
      "duration_seconds": 7.69,
      "text": "Thank you. And how are you managing at home, Mr Rao? Who do you live with?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.28,
      "end_seconds": 153.94,
      "duration_seconds": 10.66,
      "text": "My son and daughter-in-law. Meena comes in the day. I like to watch cricket on the television."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.05,
      "end_seconds": 164.72,
      "duration_seconds": 9.67,
      "text": "Good. I'd like to check your vision with the chart now, please read the lowest line you can."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.65,
      "end_seconds": 184.92,
      "duration_seconds": 2.27,
      "text": "E. F. P."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.95,
      "end_seconds": 194.13,
      "duration_seconds": 7.18,
      "text": "Good, that's the sixth line, which is good for a recovering eye. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 196.27,
      "end_seconds": 199.21,
      "duration_seconds": 2.94,
      "text": "Is it normal? ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.74,
      "end_seconds": 232.32,
      "duration_seconds": 12.58,
      "text": "Very normal for this stage. Now, I'll use the light microscope to look at the eye. Chin on the rest, Mr Rao, and look straight at me."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.35,
      "end_seconds": 235.3,
      "duration_seconds": 1.95,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.28,
      "end_seconds": 247.22,
      "duration_seconds": 8.94,
      "text": "The eye is calm, the cornea is clear, and the new lens is sitting in a good position."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 248.07,
      "end_seconds": 252.76,
      "duration_seconds": 4.69,
      "text": "Doctor, then why is it blurry? ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.24,
      "end_seconds": 271.53,
      "duration_seconds": 17.29,
      "text": "It's common to have some blur at this stage, as the eye settles. Another possibility is a slight film behind the lens, but that usually comes later. For now, I'm not worried. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.64,
      "end_seconds": 275.23,
      "duration_seconds": 1.59,
      "text": "Good. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.16,
      "end_seconds": 281.59,
      "duration_seconds": 4.43,
      "text": "Any headaches, or eye strain with the television?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.25,
      "end_seconds": 286.9,
      "duration_seconds": 3.65,
      "text": "No, no headache. TV is fine."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.26,
      "end_seconds": 294.77,
      "duration_seconds": 6.51,
      "text": "Good. Keep your eye clean, avoid rubbing it, and wear your sunglasses outdoors."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 296.37,
      "end_seconds": 302.38,
      "duration_seconds": 6.01,
      "text": "I will make sure he doesn't rub it. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.47,
      "end_seconds": 317.14,
      "duration_seconds": 12.67,
      "text": "If the blurriness gets worse, or the eye becomes painful or red, or you see flashing lights, please come in the same day."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 319.66,
      "end_seconds": 322.02,
      "duration_seconds": 2.36,
      "text": "Same day, understood. ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.28,
      "end_seconds": 327.32,
      "duration_seconds": 4.04,
      "text": "Otherwise, I'm happy. Thank you both. ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.33,
      "end_seconds": 331.59,
      "duration_seconds": 3.26,
      "text": "Thank you, doctor. ~"
    }
  ]
}
