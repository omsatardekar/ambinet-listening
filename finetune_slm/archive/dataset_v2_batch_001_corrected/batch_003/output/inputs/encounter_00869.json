{
  "schema_version": "1.0",
  "encounter_id": "00869",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.68,
      "end_seconds": 13.28,
      "duration_seconds": 12.6,
      "text": "I'm so sorry I'm late, doctor, the parking structure was full. I'm here because I got a reminder letter about my cervical screening."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.0,
      "end_seconds": 25.28,
      "duration_seconds": 11.28,
      "text": "No harm done. It's a good letter to answer. Before we start, any problems at all, or is it purely routine? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.26,
      "end_seconds": 31.93,
      "duration_seconds": 5.67,
      "text": "Mostly routine. Although, well, I have noticed some spotting."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.94,
      "end_seconds": 34.81,
      "duration_seconds": 1.87,
      "text": "Spotting when?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.38,
      "end_seconds": 43.12,
      "duration_seconds": 6.74,
      "text": "After intercourse, a couple of times in the last month. Light, pink."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.61,
      "end_seconds": 47.81,
      "duration_seconds": 3.2,
      "text": "Any discomfort in the pelvis?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.04,
      "end_seconds": 56.13,
      "duration_seconds": 6.09,
      "text": "A bit of a dull ache, low down, on and off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.5,
      "end_seconds": 59.92,
      "duration_seconds": 2.42,
      "text": "Any change in discharge?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.86,
      "end_seconds": 65.57,
      "duration_seconds": 3.71,
      "text": "A little more than usual, watery."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.54,
      "end_seconds": 70.95,
      "duration_seconds": 3.41,
      "text": "Is there pain during sex?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.62,
      "end_seconds": 76.5,
      "duration_seconds": 3.88,
      "text": "No, no pain. Just the spotting."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.92,
      "end_seconds": 80.42,
      "duration_seconds": 1.5,
      "text": "Any fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.42,
      "end_seconds": 84.44,
      "duration_seconds": 2.02,
      "text": "No fever."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.99,
      "end_seconds": 88.91,
      "duration_seconds": 1.92,
      "text": "Weight loss?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.19,
      "end_seconds": 93.18,
      "duration_seconds": 2.99,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.77,
      "end_seconds": 101.92,
      "duration_seconds": 7.15,
      "text": "Any allergies, particularly to latex, before I use gloves and the speculum?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.66,
      "end_seconds": 104.27,
      "duration_seconds": 1.61,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.75,
      "end_seconds": 112.38,
      "duration_seconds": 5.63,
      "text": "Good. Have you had any operations on the pelvis?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.87,
      "end_seconds": 117.3,
      "duration_seconds": 3.43,
      "text": "A tubal ligation, five years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 118.47,
      "end_seconds": 123.46,
      "duration_seconds": 4.99,
      "text": "Doctor, do you want me to take the observations? ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.19,
      "end_seconds": 127.16,
      "duration_seconds": 1.97,
      "text": "Yes, please. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 139.61,
      "end_seconds": 145.95,
      "duration_seconds": 6.34,
      "text": "Blood pressure 116 over 72, pulse 74, weight 63 kilos."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.53,
      "end_seconds": 156.12,
      "duration_seconds": 7.59,
      "text": "Thank you, nurse. That's all normal. Now, I'll examine you in a moment. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.91,
      "end_seconds": 162.23,
      "duration_seconds": 4.32,
      "text": "Do I need to undress completely? ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.85,
      "end_seconds": 188.34,
      "duration_seconds": 4.49,
      "text": "Only from the waist down, there's a sheet."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.99,
      "end_seconds": 191.74,
      "duration_seconds": 1.75,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.47,
      "end_seconds": 202.06,
      "duration_seconds": 8.59,
      "text": "Let me start with an external check. Nothing unusual on the outside. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.36,
      "end_seconds": 205.52,
      "duration_seconds": 2.16,
      "text": "Good. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.95,
      "end_seconds": 227.54,
      "duration_seconds": 4.59,
      "text": "Now the speculum. A little cold, a little pressure."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.48,
      "end_seconds": 230.26,
      "duration_seconds": 1.78,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.64,
      "end_seconds": 238.02,
      "duration_seconds": 5.38,
      "text": "The cervix looks healthy overall, no lesions, no unusual growths."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.41,
      "end_seconds": 242.7,
      "duration_seconds": 2.29,
      "text": "That's good. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.02,
      "end_seconds": 259.19,
      "duration_seconds": 14.17,
      "text": "There's a small red area on the surface at the edge, called an ectropion, which is common, and it bleeds easily on contact."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.05,
      "end_seconds": 263.54,
      "duration_seconds": 2.49,
      "text": "Is it dangerous? ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.49,
      "end_seconds": 274.49,
      "duration_seconds": 8.0,
      "text": "No, it's very common. I can see a little clear mucus, but no abnormal discharge."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.83,
      "end_seconds": 277.75,
      "duration_seconds": 1.92,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.09,
      "end_seconds": 289.87,
      "duration_seconds": 9.78,
      "text": "That could explain the spotting after sex. It looks like a cervical ectropion causing the spotting."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.49,
      "end_seconds": 295.34,
      "duration_seconds": 2.85,
      "text": "Good, I was worried. ~"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.22,
      "end_seconds": 306.37,
      "duration_seconds": 9.15,
      "text": "Let's do the screening test now, the Pap smear, and send it to the lab."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.22,
      "end_seconds": 309.97,
      "duration_seconds": 2.75,
      "text": "Will it hurt? ~"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.75,
      "end_seconds": 325.8,
      "duration_seconds": 4.05,
      "text": "A brief scrape. Nurse, the brush, please."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 328.48,
      "end_seconds": 331.28,
      "duration_seconds": 2.8,
      "text": "Here you are. ~"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.16,
      "end_seconds": 341.95,
      "duration_seconds": 7.79,
      "text": "All done. You can get dressed. The result will arrive by post. ~"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.81,
      "end_seconds": 346.58,
      "duration_seconds": 2.77,
      "text": "Thank you both. ~"
    }
  ]
}
