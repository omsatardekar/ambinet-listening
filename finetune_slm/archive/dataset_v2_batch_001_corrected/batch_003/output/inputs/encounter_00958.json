{
  "schema_version": "1.0",
  "encounter_id": "00958",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.73,
      "end_seconds": 15.5,
      "duration_seconds": 14.77,
      "text": "Um, hi. I twisted my ankle playing football last night. It's, um, swollen, and I'm not sure if I should have come, my mates said I'm being soft."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.34,
      "end_seconds": 22.85,
      "duration_seconds": 4.51,
      "text": "Not soft at all. Tell me what happened."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.18,
      "end_seconds": 40.64,
      "duration_seconds": 16.46,
      "text": "I went to tackle someone and my foot got stuck in the turf and sort of rolled outwards. It went, um, on the outside of the left ankle."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.35,
      "end_seconds": 45.93,
      "duration_seconds": 2.58,
      "text": "When was this? ~"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.3,
      "end_seconds": 50.07,
      "duration_seconds": 2.77,
      "text": "Yesterday evening, about eight."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.93,
      "end_seconds": 56.5,
      "duration_seconds": 3.57,
      "text": "And how's it been since?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.73,
      "end_seconds": 63.82,
      "duration_seconds": 6.09,
      "text": "It swelled up quickly, like an egg, on the outside."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.91,
      "end_seconds": 68.0,
      "duration_seconds": 2.09,
      "text": "Any bruising?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.12,
      "end_seconds": 73.53,
      "duration_seconds": 4.41,
      "text": "It's gone a bit purple this morning."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.76,
      "end_seconds": 80.39,
      "duration_seconds": 4.63,
      "text": "Did you hear a crack or a snap?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.97,
      "end_seconds": 87.23,
      "duration_seconds": 5.26,
      "text": "Um, no. No crack. Just a sort of pull."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.83,
      "end_seconds": 92.79,
      "duration_seconds": 3.96,
      "text": "Any numbness or tingling in the foot?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.25,
      "end_seconds": 96.87,
      "duration_seconds": 1.62,
      "text": "No numbness."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.28,
      "end_seconds": 104.49,
      "duration_seconds": 5.21,
      "text": "Any pain higher up, in the shin or the knee?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.36,
      "end_seconds": 109.51,
      "duration_seconds": 3.15,
      "text": "No, it's only the ankle."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.38,
      "end_seconds": 115.31,
      "duration_seconds": 2.93,
      "text": "What have you taken?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.34,
      "end_seconds": 129.66,
      "duration_seconds": 13.32,
      "text": "Ibuprofen, 400 mg, three times a day. Paracetamol, 1 gram, when it's bad. Cetirizine, 10 mg, every morning. And my blue inhaler, salbutamol, when I need it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.59,
      "end_seconds": 133.7,
      "duration_seconds": 2.11,
      "text": "Good. Any allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.66,
      "end_seconds": 147.23,
      "duration_seconds": 11.57,
      "text": "Um. I think I came out in a rash once from some tablets I got abroad, in Spain. I don't know what they were."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.08,
      "end_seconds": 155.08,
      "duration_seconds": 5.0,
      "text": "That's fine, I'll note it as possible. Any health conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.41,
      "end_seconds": 160.65,
      "duration_seconds": 3.24,
      "text": "Asthma, and hay fever."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.48,
      "end_seconds": 164.39,
      "duration_seconds": 1.91,
      "text": "Any operations?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.77,
      "end_seconds": 171.67,
      "duration_seconds": 4.9,
      "text": "I had my left knee done, the cruciate, in 2019."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.96,
      "end_seconds": 177.24,
      "duration_seconds": 4.28,
      "text": "Anything in the family I should know about?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.03,
      "end_seconds": 181.58,
      "duration_seconds": 2.55,
      "text": "My dad has arthritis."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.54,
      "end_seconds": 185.83,
      "duration_seconds": 3.29,
      "text": "What do you do for work?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.35,
      "end_seconds": 190.34,
      "duration_seconds": 2.99,
      "text": "I'm a student, final year."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.18,
      "end_seconds": 195.83,
      "duration_seconds": 3.65,
      "text": "How often do you play football?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.23,
      "end_seconds": 202.27,
      "duration_seconds": 4.04,
      "text": "Twice a week. Saturdays and Wednesdays."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.32,
      "end_seconds": 205.19,
      "duration_seconds": 1.87,
      "text": "Do you drink?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.07,
      "end_seconds": 209.44,
      "duration_seconds": 3.37,
      "text": "At weekends, a few pints."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.83,
      "end_seconds": 237.25,
      "duration_seconds": 11.42,
      "text": "Let me check you. Pulse 72, blood pressure 118 over 74, temperature 36.7, oxygen 99 percent, breathing 14, weight 74 kilos."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.33,
      "end_seconds": 241.77,
      "duration_seconds": 2.44,
      "text": "Is that okay? ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.77,
      "end_seconds": 261.34,
      "duration_seconds": 6.57,
      "text": "Perfect. Let me look at the ankle. Tell me if it hurts."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.4,
      "end_seconds": 265.56,
      "duration_seconds": 2.16,
      "text": "Ah. There. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.52,
      "end_seconds": 279.38,
      "duration_seconds": 10.86,
      "text": "There's swelling and tenderness over the ligaments on the outside of the left ankle, but no tenderness over the bony bumps."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.0,
      "end_seconds": 284.38,
      "duration_seconds": 2.38,
      "text": "Is that good? ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.67,
      "end_seconds": 295.06,
      "duration_seconds": 8.39,
      "text": "It's good. And you can take a few steps, I watched you come in. ~"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.85,
      "end_seconds": 300.91,
      "duration_seconds": 4.06,
      "text": "Yeah, limping, but I could. ~"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.98,
      "end_seconds": 305.99,
      "duration_seconds": 4.01,
      "text": "Any wheeze or chest tightness today?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.11,
      "end_seconds": 310.97,
      "duration_seconds": 3.86,
      "text": "No, nothing. My chest is fine."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.6,
      "end_seconds": 322.95,
      "duration_seconds": 9.35,
      "text": "So here's what I think. This looks like a sprained ankle, a ligament sprain, probably a moderate one."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.73,
      "end_seconds": 327.31,
      "duration_seconds": 2.58,
      "text": "Is it broken? ~"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.16,
      "end_seconds": 341.47,
      "duration_seconds": 11.31,
      "text": "Unlikely, given you could walk and there's no bony tenderness. But I'd like to arrange an X-ray of the ankle to be sure."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.71,
      "end_seconds": 345.72,
      "duration_seconds": 2.01,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.49,
      "end_seconds": 355.6,
      "duration_seconds": 9.11,
      "text": "And I'd like to arrange an ultrasound of the ankle ligaments, to see how much damage there is."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 357.45,
      "end_seconds": 361.44,
      "duration_seconds": 3.99,
      "text": "How long will I be out? ~"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.49,
      "end_seconds": 369.92,
      "duration_seconds": 6.43,
      "text": "A few weeks. I'd like to arrange physiotherapy to get you back faster."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 370.8,
      "end_seconds": 372.8,
      "duration_seconds": 2.0,
      "text": "That's good. ~"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 375.4,
      "end_seconds": 381.95,
      "duration_seconds": 6.55,
      "text": "Rest, ice, compression and elevation for the first few days."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 383.55,
      "end_seconds": 385.89,
      "duration_seconds": 2.34,
      "text": "Got it. ~"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 387.21,
      "end_seconds": 395.3,
      "duration_seconds": 8.09,
      "text": "If you can't put your weight on it by next week, come back and see me."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 397.09,
      "end_seconds": 400.13,
      "duration_seconds": 3.04,
      "text": "Okay, thanks, doctor. ~"
    }
  ]
}
