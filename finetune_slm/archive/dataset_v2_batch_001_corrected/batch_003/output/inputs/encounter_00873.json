{
  "schema_version": "1.0",
  "encounter_id": "00873",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 1.28,
      "end_seconds": 14.27,
      "duration_seconds": 12.99,
      "text": "Doctor, I'm Ellen, I look after Mr Doyle in the evenings. He's up passing water five or six times every night, and neither of us is sleeping."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.39,
      "end_seconds": 21.4,
      "duration_seconds": 4.01,
      "text": "It's not that many. Three, maybe."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 24.05,
      "end_seconds": 30.0,
      "duration_seconds": 5.95,
      "text": "It's five, Walter. I count them, I hear you every time."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.44,
      "end_seconds": 45.49,
      "duration_seconds": 14.05,
      "text": "So three, says Mr Doyle, and Ellen counts five or six. I'll note it as three to six. How long has it been going on?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.44,
      "end_seconds": 49.25,
      "duration_seconds": 1.81,
      "text": "A few months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.86,
      "end_seconds": 55.57,
      "duration_seconds": 4.71,
      "text": "Are you drinking a lot in the evening? ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.17,
      "end_seconds": 64.63,
      "duration_seconds": 7.46,
      "text": "A pot of tea, and a glass of water with my pills. ~"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.74,
      "end_seconds": 71.95,
      "duration_seconds": 4.21,
      "text": "Any burning, or blood in the urine?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.86,
      "end_seconds": 75.75,
      "duration_seconds": 1.89,
      "text": "No. None."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.92,
      "end_seconds": 84.94,
      "duration_seconds": 6.02,
      "text": "Do you find it hard to start, or a weak stream?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.85,
      "end_seconds": 91.19,
      "duration_seconds": 4.34,
      "text": "Yes, a weak stream. And I dribble afterwards."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.24,
      "end_seconds": 97.57,
      "duration_seconds": 3.33,
      "text": "What tablets are you on?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 100.08,
      "end_seconds": 105.71,
      "duration_seconds": 5.63,
      "text": "Tamsulosin, 400 micrograms, once a day, in the morning."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.96,
      "end_seconds": 111.81,
      "duration_seconds": 2.85,
      "text": "Is that helping? ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.05,
      "end_seconds": 116.57,
      "duration_seconds": 2.52,
      "text": "A little. ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.11,
      "end_seconds": 121.29,
      "duration_seconds": 2.18,
      "text": "Any other conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 122.56,
      "end_seconds": 128.33,
      "duration_seconds": 5.77,
      "text": "An enlarged prostate. That's what the tamsulosin is for."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.54,
      "end_seconds": 134.1,
      "duration_seconds": 4.56,
      "text": "Any breathlessness, or swelling of the legs?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.89,
      "end_seconds": 139.37,
      "duration_seconds": 2.48,
      "text": "No. Nothing like that."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.82,
      "end_seconds": 144.16,
      "duration_seconds": 3.34,
      "text": "Pulse and pressure, please. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.61,
      "end_seconds": 147.88,
      "duration_seconds": 2.27,
      "text": "Go on. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.96,
      "end_seconds": 165.69,
      "duration_seconds": 3.73,
      "text": "Pulse 70, blood pressure 138 over 82."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 168.94,
      "end_seconds": 172.59,
      "duration_seconds": 3.65,
      "text": "Is that all right? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.71,
      "end_seconds": 186.35,
      "duration_seconds": 10.64,
      "text": "Yes. Mr Doyle, I'd like to examine your tummy and then do a prostate check, if you agree. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.77,
      "end_seconds": 215.3,
      "duration_seconds": 2.53,
      "text": "If you must."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.13,
      "end_seconds": 225.2,
      "duration_seconds": 8.07,
      "text": "Your bladder isn't enlarged, and the prostate is smooth and enlarged, but not hard."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 226.8,
      "end_seconds": 230.81,
      "duration_seconds": 4.01,
      "text": "Is it the prostate, then? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.08,
      "end_seconds": 251.12,
      "duration_seconds": 17.04,
      "text": "Most likely, together with the weak stream and the dribbling. I'd like to confirm that with a urine test and blood tests, including a kidney test and a PSA."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.23,
      "end_seconds": 258.34,
      "duration_seconds": 5.11,
      "text": "The PSA, is that the cancer test? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.71,
      "end_seconds": 272.35,
      "duration_seconds": 12.64,
      "text": "It's one marker, and it can be raised by an enlarged prostate too. I'll explain the result with you, whatever it is. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.73,
      "end_seconds": 275.11,
      "duration_seconds": 1.38,
      "text": "Fine. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.72,
      "end_seconds": 283.37,
      "duration_seconds": 6.65,
      "text": "Cut down on tea and fluids after six, and avoid caffeine in the evening."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 286.26,
      "end_seconds": 290.1,
      "duration_seconds": 3.84,
      "text": "I'll make his supper earlier. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.25,
      "end_seconds": 301.11,
      "duration_seconds": 7.86,
      "text": "I'd like to see you again in two weeks, when the results are back."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 302.5,
      "end_seconds": 305.99,
      "duration_seconds": 3.49,
      "text": "Two weeks. We'll come. ~"
    }
  ]
}
