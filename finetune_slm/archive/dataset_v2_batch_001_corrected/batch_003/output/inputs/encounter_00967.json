{
  "schema_version": "1.0",
  "encounter_id": "00967",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.83,
      "end_seconds": 18.59,
      "duration_seconds": 17.76,
      "text": "Doctor, please, I have a terrible headache. It came on suddenly, about thirty minutes ago, while I was lifting weights at the gym. It's the worst headache of my life."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.11,
      "end_seconds": 25.69,
      "duration_seconds": 4.58,
      "text": "I'm taking this very seriously. Where is it?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.5,
      "end_seconds": 40.04,
      "duration_seconds": 11.54,
      "text": "At the back of my head, like a blow. It reached the worst in seconds, I have never had anything like it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.8,
      "end_seconds": 47.33,
      "duration_seconds": 4.53,
      "text": "Do you have any neck pain or stiffness?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.36,
      "end_seconds": 57.14,
      "duration_seconds": 6.78,
      "text": "Yes, my neck is stiff and sore. I can't put my chin down."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.88,
      "end_seconds": 62.62,
      "duration_seconds": 2.74,
      "text": "Do you feel sick?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.22,
      "end_seconds": 70.19,
      "duration_seconds": 4.97,
      "text": "Very nauseous. I vomited once in the car park."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.12,
      "end_seconds": 78.23,
      "duration_seconds": 6.11,
      "text": "Did you hit your head, or have an injury?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.12,
      "end_seconds": 86.2,
      "duration_seconds": 5.08,
      "text": "No, no injury. I did not hit my head."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.22,
      "end_seconds": 91.31,
      "duration_seconds": 3.09,
      "text": "Do you have any allergies?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.82,
      "end_seconds": 97.22,
      "duration_seconds": 3.4,
      "text": "Penicillin, I developed a rash."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.24,
      "end_seconds": 104.57,
      "duration_seconds": 5.33,
      "text": "I'll note that. What do you do for work?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.36,
      "end_seconds": 110.42,
      "duration_seconds": 3.06,
      "text": "I am a software developer."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.22,
      "end_seconds": 134.82,
      "duration_seconds": 11.6,
      "text": "Let me check your numbers quickly. Blood pressure 168 over 98, pulse 92, temperature 36.9, oxygen 98 percent, breathing 18."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.63,
      "end_seconds": 140.02,
      "duration_seconds": 2.39,
      "text": "Is that serious? ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.87,
      "end_seconds": 156.41,
      "duration_seconds": 6.54,
      "text": "It's raised, from the pain. Now, please touch your chin to your chest."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.77,
      "end_seconds": 162.76,
      "duration_seconds": 3.99,
      "text": "I cannot. It's very painful. ~"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.14,
      "end_seconds": 168.93,
      "duration_seconds": 4.79,
      "text": "Your neck is stiff when I bend it forward."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.77,
      "end_seconds": 175.28,
      "duration_seconds": 3.51,
      "text": "Yes, that is exactly it. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.43,
      "end_seconds": 182.92,
      "duration_seconds": 5.49,
      "text": "And your pupils are equal and react to light."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.65,
      "end_seconds": 189.18,
      "duration_seconds": 3.53,
      "text": "That is a relief. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.97,
      "end_seconds": 211.38,
      "duration_seconds": 19.41,
      "text": "Let me tell you what I'm thinking. A sudden, severe headache like this can be a bleed around the brain, called a subarachnoid haemorrhage. I can't rule that out, and I won't take any risks."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.96,
      "end_seconds": 217.61,
      "duration_seconds": 3.65,
      "text": "Oh my God. Is that likely? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.78,
      "end_seconds": 232.17,
      "duration_seconds": 12.39,
      "text": "It's not the most likely cause, but it's the one we must exclude. I'd like to arrange a CT scan of your head, right now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.31,
      "end_seconds": 238.04,
      "duration_seconds": 2.73,
      "text": "Of course. Anything. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.66,
      "end_seconds": 253.44,
      "duration_seconds": 13.78,
      "text": "If the CT scan is normal, I might do a lumbar puncture, a test of the fluid around the spine, because the scan can miss small bleeds."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.07,
      "end_seconds": 257.76,
      "duration_seconds": 2.69,
      "text": "Is that painful? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.98,
      "end_seconds": 267.19,
      "duration_seconds": 7.21,
      "text": "Uncomfortable, but quick. I'd also like to do blood tests, including a clotting profile."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.35,
      "end_seconds": 272.9,
      "duration_seconds": 4.55,
      "text": "I will do whatever you need. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.8,
      "end_seconds": 282.84,
      "duration_seconds": 8.04,
      "text": "Please lie flat, and don't eat or drink anything until we have the scan."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.96,
      "end_seconds": 287.74,
      "duration_seconds": 1.78,
      "text": "Yes, doctor. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.91,
      "end_seconds": 298.81,
      "duration_seconds": 7.9,
      "text": "If the headache gets worse, or you become drowsy or confused, tell the nurse immediately."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.02,
      "end_seconds": 305.98,
      "duration_seconds": 5.96,
      "text": "I will. Thank you for taking this seriously. ~"
    }
  ]
}
