{
  "schema_version": "1.0",
  "encounter_id": "00718",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 3.4,
      "end_seconds": 9.29,
      "duration_seconds": 5.89,
      "text": "He's been barking all night. Like a seal. I've not slept."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.48,
      "end_seconds": 18.54,
      "duration_seconds": 5.06,
      "text": "Poor you both. How old is he? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 22.57,
      "end_seconds": 26.4,
      "duration_seconds": 3.83,
      "text": "Two. Two and a bit. ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.29,
      "end_seconds": 33.29,
      "duration_seconds": 3.0,
      "text": "When did the cough start?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 36.86,
      "end_seconds": 40.35,
      "duration_seconds": 3.49,
      "text": "Last night. After a runny nose."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "UNKNOWN",
      "start_seconds": 45.1,
      "end_seconds": 51.49,
      "duration_seconds": 6.39,
      "text": "[from the corridor] It started the night before, Tuesday night!"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.75,
      "end_seconds": 63.51,
      "duration_seconds": 7.76,
      "text": "I'll go with Mum's account unless she says otherwise. Is he breathing normally now?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 68.1,
      "end_seconds": 72.23,
      "duration_seconds": 4.13,
      "text": "Yes, now. It's worse at night."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.9,
      "end_seconds": 82.19,
      "duration_seconds": 5.29,
      "text": "Does he make a noisy sound when he breathes in? ~"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 86.98,
      "end_seconds": 90.75,
      "duration_seconds": 3.77,
      "text": "Only when he's crying. ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.53,
      "end_seconds": 97.8,
      "duration_seconds": 3.27,
      "text": "Any allergies that you know of?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 102.2,
      "end_seconds": 110.62,
      "duration_seconds": 8.42,
      "text": "Egg. He came up in hives, once, when he had scrambled egg. Since then, none."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.28,
      "end_seconds": 118.3,
      "duration_seconds": 4.02,
      "text": "Thanks, that's important. Does he go to nursery?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 122.33,
      "end_seconds": 125.12,
      "duration_seconds": 2.79,
      "text": "Three days a week."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.73,
      "end_seconds": 131.09,
      "duration_seconds": 2.36,
      "text": "Mummy, cough. ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.12,
      "end_seconds": 152.71,
      "duration_seconds": 5.59,
      "text": "I know, it's yucky. Let me listen, sweetheart."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.19,
      "end_seconds": 168.83,
      "duration_seconds": 11.64,
      "text": "His breathing is calm, with no sucking in at the ribs, and he's got a loud barky cough but only when he's upset."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 172.63,
      "end_seconds": 175.69,
      "duration_seconds": 3.06,
      "text": "Is it serious? ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.34,
      "end_seconds": 190.84,
      "duration_seconds": 10.5,
      "text": "Not today. It's a typical picture for a viral croup, and it's normally worst on the second and third nights. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 195.43,
      "end_seconds": 199.25,
      "duration_seconds": 3.82,
      "text": "What do I do? ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.65,
      "end_seconds": 213.91,
      "duration_seconds": 10.26,
      "text": "Keep him calm, since crying makes it worse. Steamy bathrooms don't actually help, but cuddles do. Plenty of fluids."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 218.72,
      "end_seconds": 221.93,
      "duration_seconds": 3.21,
      "text": "Okay. And at night? ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.39,
      "end_seconds": 232.24,
      "duration_seconds": 5.85,
      "text": "Prop him up a little, and sleep near him, listening. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 236.61,
      "end_seconds": 239.24,
      "duration_seconds": 2.63,
      "text": "I will. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.1,
      "end_seconds": 256.68,
      "duration_seconds": 13.58,
      "text": "Please bring him back, or call 999, if he's struggling to breathe, making a high noisy sound at rest, drooling, or turning blue around the lips."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 261.12,
      "end_seconds": 263.42,
      "duration_seconds": 2.3,
      "text": "I understand. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.75,
      "end_seconds": 276.21,
      "duration_seconds": 8.46,
      "text": "And if it hasn't settled in four or five days, bring him back anyway. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 279.95,
      "end_seconds": 282.38,
      "duration_seconds": 2.43,
      "text": "Thank you. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.32,
      "end_seconds": 289.83,
      "duration_seconds": 3.51,
      "text": "Hope you both sleep tonight. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 294.47,
      "end_seconds": 298.94,
      "duration_seconds": 4.47,
      "text": "Fingers crossed. Say bye-bye, Max. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.24,
      "end_seconds": 305.99,
      "duration_seconds": 2.75,
      "text": "Bye bye, doctor. ~"
    }
  ]
}
