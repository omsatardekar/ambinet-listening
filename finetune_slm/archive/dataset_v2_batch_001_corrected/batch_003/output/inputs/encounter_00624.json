{
  "schema_version": "1.0",
  "encounter_id": "00624",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 0.38,
      "end_seconds": 10.15,
      "duration_seconds": 9.77,
      "text": "Sorry, we're a bit early. This is Poppy, and Jade here looks after her in the daytime. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.19,
      "end_seconds": 22.33,
      "duration_seconds": 11.14,
      "text": "Not at all, come in. Hello Poppy! Jade, hello. Who wants to tell me how we're getting on since the ear? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_4",
      "role": "CAREGIVER",
      "start_seconds": 24.11,
      "end_seconds": 33.22,
      "duration_seconds": 9.11,
      "text": "I can start, I've had her four days this week. She's much happier, aren't you, poppet? ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.23,
      "end_seconds": 36.38,
      "duration_seconds": 2.15,
      "text": "Ear better. ~"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.74,
      "end_seconds": 47.38,
      "duration_seconds": 8.64,
      "text": "That's what I like to hear. Mum, remind me what happened last week? ~"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 49.13,
      "end_seconds": 63.95,
      "duration_seconds": 14.82,
      "text": "She was tugging at her ear and screaming half the night, Tuesday and Wednesday. Then she gave her the pink stuff. Oh, what's it called."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "CAREGIVER",
      "start_seconds": 65.37,
      "end_seconds": 75.71,
      "duration_seconds": 10.34,
      "text": "Amoxicillin, it's on the bottle. 250 mg, three times a day. We're on the last two days of it."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 77.22,
      "end_seconds": 84.16,
      "duration_seconds": 6.94,
      "text": "That's it. I give the morning and teatime ones, and Jade does lunch."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.0,
      "end_seconds": 89.33,
      "duration_seconds": 4.33,
      "text": "Brilliant. And is the tugging still happening?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 90.44,
      "end_seconds": 98.4,
      "duration_seconds": 7.96,
      "text": "No, that's gone completely. She hasn't touched it since Friday, I think. It's gone now."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.75,
      "end_seconds": 104.06,
      "duration_seconds": 4.31,
      "text": "Good. Any fever since you started it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 105.19,
      "end_seconds": 108.77,
      "duration_seconds": 3.58,
      "text": "No fever, not since the first night."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.74,
      "end_seconds": 116.12,
      "duration_seconds": 4.38,
      "text": "Any fluid or gunk coming out of the ear?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "CAREGIVER",
      "start_seconds": 117.85,
      "end_seconds": 124.69,
      "duration_seconds": 6.84,
      "text": "No, nothing. I check her pillow every nap, there's never anything on it."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.34,
      "end_seconds": 133.59,
      "duration_seconds": 7.25,
      "text": "Lovely. Does she have anything for pain, or has she needed anything?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "CAREGIVER",
      "start_seconds": 135.03,
      "end_seconds": 144.39,
      "duration_seconds": 9.36,
      "text": "Just ibuprofen, 5 ml at bedtime, if she's grizzly. She hasn't needed it for two days."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.4,
      "end_seconds": 151.55,
      "duration_seconds": 6.15,
      "text": "Good. Is she allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 153.66,
      "end_seconds": 160.0,
      "duration_seconds": 6.34,
      "text": "No, none. She's eaten everything and been fine on the amoxicillin."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.72,
      "end_seconds": 166.68,
      "duration_seconds": 4.96,
      "text": "Wonderful. And remind me of her health background?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 168.55,
      "end_seconds": 177.52,
      "duration_seconds": 8.97,
      "text": "She has eczema, mostly on her elbows. And she's had a few ear infections, this is the third."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.0,
      "end_seconds": 187.02,
      "duration_seconds": 8.02,
      "text": "Right. Poppy, shall I have a look in your ears? It's like a little torch. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.14,
      "end_seconds": 191.18,
      "duration_seconds": 2.04,
      "text": "Torch! ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.83,
      "end_seconds": 208.58,
      "duration_seconds": 4.75,
      "text": "Ooh, you're brilliant. Hold really still, that's it."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 210.17,
      "end_seconds": 213.36,
      "duration_seconds": 3.19,
      "text": "Is she being good? ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.36,
      "end_seconds": 221.61,
      "duration_seconds": 7.25,
      "text": "She's being perfect. Her temperature is 36.8 and she weighs 14.2 kilos."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "CAREGIVER",
      "start_seconds": 222.83,
      "end_seconds": 226.53,
      "duration_seconds": 3.7,
      "text": "Was she heavier last time? ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.76,
      "end_seconds": 246.94,
      "duration_seconds": 11.18,
      "text": "Not that I can see, she's right on track. Now, the right eardrum looks normal. Pink and shiny, no redness."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 247.83,
      "end_seconds": 250.62,
      "duration_seconds": 2.79,
      "text": "And the left? ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.95,
      "end_seconds": 263.56,
      "duration_seconds": 11.61,
      "text": "The left is the one that was infected, and it's looking much calmer. I think the ear infection has settled."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 265.35,
      "end_seconds": 270.12,
      "duration_seconds": 4.77,
      "text": "Oh, thank goodness. So she's all done? ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.14,
      "end_seconds": 284.72,
      "duration_seconds": 13.58,
      "text": "Nearly. Finish the last two days of the amoxicillin, then stop. It's worth checking how she hears after a few infections, so I'd like to arrange a hearing check."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "CAREGIVER",
      "start_seconds": 286.33,
      "end_seconds": 289.77,
      "duration_seconds": 3.44,
      "text": "Does that hurt her? ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.56,
      "end_seconds": 297.53,
      "duration_seconds": 5.97,
      "text": "Not at all, it's a game with headphones and beeps. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 298.38,
      "end_seconds": 301.89,
      "duration_seconds": 3.51,
      "text": "And when would that be? ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.26,
      "end_seconds": 320.9,
      "duration_seconds": 16.64,
      "text": "The appointment will come by post. And I'd like to see her again in six weeks, so we can check the ear and talk about the hearing test."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 322.91,
      "end_seconds": 327.48,
      "duration_seconds": 4.57,
      "text": "Six weeks, I'll put it in the calendar. ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.6,
      "end_seconds": 337.36,
      "duration_seconds": 8.76,
      "text": "Bring her back sooner if she's pulling at it again or has a temperature."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "CAREGIVER",
      "start_seconds": 339.27,
      "end_seconds": 342.66,
      "duration_seconds": 3.39,
      "text": "We will. Say bye-bye, Poppy. ~"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.4,
      "end_seconds": 346.57,
      "duration_seconds": 2.17,
      "text": "Bye, doctor! ~"
    }
  ]
}
