{
  "schema_version": "1.0",
  "encounter_id": "00640",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 0.65,
      "end_seconds": 12.01,
      "duration_seconds": 11.36,
      "text": "Hello, doctor. I'm Gail, Ruby's foster carer. We've had her since she was three weeks old, and the health visitor sent us. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.31,
      "end_seconds": 26.79,
      "duration_seconds": 12.48,
      "text": "Welcome, Gail. And hello Ruby! Who's the little one with the big eyes? Tell me what the health visitor was worried about. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.61,
      "end_seconds": 30.52,
      "duration_seconds": 1.91,
      "text": "Ba ba. ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 31.72,
      "end_seconds": 43.11,
      "duration_seconds": 11.39,
      "text": "She isn't putting on weight, doctor. She's nine months and she's been flat for about two months, on the chart, I mean."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.67,
      "end_seconds": 48.54,
      "duration_seconds": 3.87,
      "text": "Flat, meaning her line's stopped climbing?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 49.76,
      "end_seconds": 60.65,
      "duration_seconds": 10.89,
      "text": "Yes, it's levelled off. And she's so hungry, she takes every bottle, but it doesn't seem to go on her."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.46,
      "end_seconds": 68.29,
      "duration_seconds": 6.83,
      "text": "How is she feeding at the moment? Milk and solids? ~"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 70.97,
      "end_seconds": 79.16,
      "duration_seconds": 8.19,
      "text": "Formula, six bottles a day, and she's started on porridge and fruit. She's never refused anything. ~"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.64,
      "end_seconds": 84.53,
      "duration_seconds": 2.89,
      "text": "Good. Any vomiting after feeds?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 87.22,
      "end_seconds": 95.28,
      "duration_seconds": 8.06,
      "text": "No, she doesn't vomit. Well, no, not now. She was sicky when she was tiny."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.78,
      "end_seconds": 103.19,
      "duration_seconds": 5.41,
      "text": "What do you mean by sicky when she was tiny?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 104.39,
      "end_seconds": 111.36,
      "duration_seconds": 6.97,
      "text": "She had reflux, they said. It settled a bit at about four months."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.17,
      "end_seconds": 118.63,
      "duration_seconds": 6.46,
      "text": "Okay. Any loose stools, runny poos, or poos that smell very bad?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 121.34,
      "end_seconds": 126.56,
      "duration_seconds": 5.22,
      "text": "No, nothing runny. Normal nappies, I'd say, no problem."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.93,
      "end_seconds": 131.88,
      "duration_seconds": 3.95,
      "text": "Is she on any medicine, drops, anything?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 134.71,
      "end_seconds": 139.86,
      "duration_seconds": 5.15,
      "text": "Vitamin D drops, 400 units, once a day. That's all."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.51,
      "end_seconds": 145.91,
      "duration_seconds": 4.4,
      "text": "Good. What do you know of her birth?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 146.83,
      "end_seconds": 161.78,
      "duration_seconds": 14.95,
      "text": "She was born at 34 weeks. A few weeks in the special care unit. And her tongue-tie was snipped at two weeks old, before we got her."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.45,
      "end_seconds": 174.21,
      "duration_seconds": 9.76,
      "text": "That's very helpful. I'll have a look at her. Can you pop her on the couch? ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 176.52,
      "end_seconds": 179.42,
      "duration_seconds": 2.9,
      "text": "There you go, sweetheart. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.83,
      "end_seconds": 183.77,
      "duration_seconds": 1.94,
      "text": "Aaah. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.25,
      "end_seconds": 209.84,
      "duration_seconds": 5.59,
      "text": "Ruby, you're lovely. Let me listen, and feel her tummy."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 211.5,
      "end_seconds": 214.64,
      "duration_seconds": 3.14,
      "text": "Is she okay? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.04,
      "end_seconds": 227.21,
      "duration_seconds": 11.17,
      "text": "She looks well, she's alert, and she smiles at me. I don't see anything worrying on the outside. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 228.82,
      "end_seconds": 232.85,
      "duration_seconds": 4.03,
      "text": "It's just she's not growing. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.22,
      "end_seconds": 243.71,
      "duration_seconds": 9.49,
      "text": "I understand. I can't rule out milk protein intolerance, because it can cause poor weight gain even without vomiting."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 245.38,
      "end_seconds": 248.75,
      "duration_seconds": 3.37,
      "text": "What would that mean? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.64,
      "end_seconds": 264.49,
      "duration_seconds": 14.85,
      "text": "It means her body might not be taking up the milk well. It's treatable, and there are different milks, but I want to check first, rather than guess. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 267.36,
      "end_seconds": 269.44,
      "duration_seconds": 2.08,
      "text": "What checks? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.21,
      "end_seconds": 281.02,
      "duration_seconds": 10.81,
      "text": "I'd like to arrange some blood tests, to look for anaemia and check her nutrition and her gut."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 283.93,
      "end_seconds": 287.65,
      "duration_seconds": 3.72,
      "text": "Will she need a needle? ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.52,
      "end_seconds": 301.7,
      "duration_seconds": 13.18,
      "text": "Yes, a tiny one, in her hand. I'll book it with the children's nurse, and we'll ring you with results. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 303.51,
      "end_seconds": 306.0,
      "duration_seconds": 2.49,
      "text": "I'll hold her. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.76,
      "end_seconds": 321.36,
      "duration_seconds": 13.6,
      "text": "And in the meantime, offer her solids before the bottle, so she's hungry for them, and write down everything she eats for a week."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 323.93,
      "end_seconds": 328.96,
      "duration_seconds": 5.03,
      "text": "I can do a diary. Will that help? ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.94,
      "end_seconds": 336.65,
      "duration_seconds": 6.71,
      "text": "It'll help a lot. Bring it when we see you. ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 338.15,
      "end_seconds": 346.16,
      "duration_seconds": 8.01,
      "text": "Thank you, doctor. I've been so worried that I'm doing something wrong. ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.14,
      "end_seconds": 355.79,
      "duration_seconds": 6.65,
      "text": "You're doing a very good job. She's lucky to have you. ~"
    }
  ]
}
