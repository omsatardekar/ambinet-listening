{
  "schema_version": "1.0",
  "encounter_id": "00920",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 2.71,
      "end_seconds": 14.48,
      "duration_seconds": 11.77,
      "text": "Doctor, I'm worried about my heart rhythm, and I'm on warfarin for it. I want to make sure I'm doing everything right."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.66,
      "end_seconds": 24.46,
      "duration_seconds": 6.8,
      "text": "That's a good reason to come. Tell me how you've been feeling."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.19,
      "end_seconds": 37.66,
      "duration_seconds": 9.47,
      "text": "Every now and then my heart flutters, like a bird in my chest. It lasts a few minutes."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.58,
      "end_seconds": 43.88,
      "duration_seconds": 3.3,
      "text": "How often does that happen?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.02,
      "end_seconds": 52.06,
      "duration_seconds": 4.04,
      "text": "Maybe once or twice a week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.32,
      "end_seconds": 60.37,
      "duration_seconds": 5.05,
      "text": "Any dizziness, chest pain, or fainting with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.52,
      "end_seconds": 71.67,
      "duration_seconds": 7.15,
      "text": "No chest pain. No fainting. I do feel a bit breathless sometimes."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.64,
      "end_seconds": 78.68,
      "duration_seconds": 4.04,
      "text": "How is the breathlessness? When does it happen?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.71,
      "end_seconds": 88.36,
      "duration_seconds": 5.65,
      "text": "When I climb the stairs, mostly. It settles after a rest."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.51,
      "end_seconds": 100.55,
      "duration_seconds": 8.04,
      "text": "Good to know. Tell me about the warfarin. What dose are you on? ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.66,
      "end_seconds": 108.8,
      "duration_seconds": 5.14,
      "text": "Warfarin 3 mg, once a day in the evening."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.14,
      "end_seconds": 118.39,
      "duration_seconds": 5.25,
      "text": "Any missed doses, or bleeding, like nosebleeds or bruising?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.42,
      "end_seconds": 126.27,
      "duration_seconds": 3.85,
      "text": "No bleeding. I've not missed a dose."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.6,
      "end_seconds": 136.84,
      "duration_seconds": 6.24,
      "text": "Thank you. When was your last INR blood test? ~"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.19,
      "end_seconds": 146.16,
      "duration_seconds": 5.97,
      "text": "Three weeks ago. The nurse said it was in range. ~"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.61,
      "end_seconds": 153.82,
      "duration_seconds": 4.21,
      "text": "Do you have any allergies to medicines?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.99,
      "end_seconds": 164.98,
      "duration_seconds": 6.99,
      "text": "I'm allergic to sulfa drugs. I got a rash with them years ago."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.84,
      "end_seconds": 170.9,
      "duration_seconds": 3.06,
      "text": "Noted. Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.58,
      "end_seconds": 178.77,
      "duration_seconds": 4.19,
      "text": "One or two glasses of wine a week."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.63,
      "end_seconds": 190.52,
      "duration_seconds": 8.89,
      "text": "Good. Now, with your fluttering and breathlessness, I'd like to record your heart over a few days."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.51,
      "end_seconds": 198.49,
      "duration_seconds": 3.98,
      "text": "How do you do that? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.27,
      "end_seconds": 209.69,
      "duration_seconds": 7.42,
      "text": "You wear a small monitor, a Holter, for forty-eight hours, and it records every heartbeat."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.86,
      "end_seconds": 217.72,
      "duration_seconds": 3.86,
      "text": "Will I be able to shower? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.87,
      "end_seconds": 231.68,
      "duration_seconds": 9.81,
      "text": "Not with the monitor on, but you can wash around it. I'll arrange it for next week."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.76,
      "end_seconds": 239.79,
      "duration_seconds": 4.03,
      "text": "And what about the blood test? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.09,
      "end_seconds": 253.61,
      "duration_seconds": 10.52,
      "text": "I'd like to repeat the INR in two weeks, because small changes in diet can move it."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.9,
      "end_seconds": 262.45,
      "duration_seconds": 4.55,
      "text": "Right. Should I change anything in my diet? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.04,
      "end_seconds": 274.35,
      "duration_seconds": 8.31,
      "text": "Keep your green vegetables steady rather than stopping them, and tell me about any new medicines. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.7,
      "end_seconds": 280.86,
      "duration_seconds": 2.16,
      "text": "I will. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.43,
      "end_seconds": 296.33,
      "duration_seconds": 11.9,
      "text": "The new plan is to keep the warfarin as it is for now, and we'll decide after the monitor. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.73,
      "end_seconds": 306.02,
      "duration_seconds": 6.29,
      "text": "Thank you, doctor. That puts my mind at rest. ~"
    }
  ]
}
