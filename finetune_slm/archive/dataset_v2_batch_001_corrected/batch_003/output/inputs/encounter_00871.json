{
  "schema_version": "1.0",
  "encounter_id": "00871",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.75,
      "end_seconds": 20.86,
      "duration_seconds": 20.11,
      "text": "Good morning. I'll be exact. Three weeks ago I had a heart attack, a stent was placed, and I'm now on aspirin and clopidogrel, and I'm bruising a great deal. I wish to know if that is expected."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.1,
      "end_seconds": 29.62,
      "duration_seconds": 6.52,
      "text": "That's a very clear summary, thank you. Where are the bruises?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.58,
      "end_seconds": 41.5,
      "duration_seconds": 10.92,
      "text": "Mostly on my forearms and shins. Some quite large, the size of a palm. I haven't knocked myself."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.39,
      "end_seconds": 49.68,
      "duration_seconds": 7.29,
      "text": "Any other bleeding, nosebleeds, gum bleeding, blood in your urine, or black stools?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.66,
      "end_seconds": 60.22,
      "duration_seconds": 9.56,
      "text": "No nosebleeds. Occasionally a little blood when I brush my teeth. No black stools. No blood in the urine."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.89,
      "end_seconds": 65.38,
      "duration_seconds": 3.49,
      "text": "Any chest pain since discharge?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.16,
      "end_seconds": 68.53,
      "duration_seconds": 1.37,
      "text": "No. None."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.35,
      "end_seconds": 75.0,
      "duration_seconds": 4.65,
      "text": "What are you taking? Please list everything."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.41,
      "end_seconds": 87.44,
      "duration_seconds": 11.03,
      "text": "Aspirin, 75 mg, once a day. Clopidogrel, 75 mg, once a day. And atorvastatin, 80 mg, at night."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.18,
      "end_seconds": 92.59,
      "duration_seconds": 2.41,
      "text": "Any other conditions?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.92,
      "end_seconds": 98.39,
      "duration_seconds": 4.47,
      "text": "High blood pressure, until the heart attack."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.89,
      "end_seconds": 103.87,
      "duration_seconds": 2.98,
      "text": "And the procedure itself?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.96,
      "end_seconds": 111.5,
      "duration_seconds": 6.54,
      "text": "A stent in the right coronary artery, three weeks ago."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.35,
      "end_seconds": 115.39,
      "duration_seconds": 3.04,
      "text": "Any shortness of breath, palpitations?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.07,
      "end_seconds": 119.98,
      "duration_seconds": 1.91,
      "text": "No. Neither."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.7,
      "end_seconds": 125.24,
      "duration_seconds": 2.54,
      "text": "Any breathlessness lying flat?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.59,
      "end_seconds": 128.41,
      "duration_seconds": 1.82,
      "text": "No, nothing."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.27,
      "end_seconds": 133.19,
      "duration_seconds": 2.92,
      "text": "Pulse and pressure. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.9,
      "end_seconds": 136.32,
      "duration_seconds": 2.42,
      "text": "Of course. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.14,
      "end_seconds": 160.58,
      "duration_seconds": 7.44,
      "text": "Pulse 68, blood pressure 124 over 74, temperature 36.5, oxygen 98 percent, weight 80 kilos."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.39,
      "end_seconds": 163.37,
      "duration_seconds": 1.98,
      "text": "Fine? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.59,
      "end_seconds": 186.59,
      "duration_seconds": 3.0,
      "text": "Excellent. Show me the bruises."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.06,
      "end_seconds": 203.4,
      "duration_seconds": 14.34,
      "text": "There are several flat purple bruises on the forearms and shins, the largest about eight centimetres, and the skin is otherwise intact, no tenderness."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.26,
      "end_seconds": 208.49,
      "duration_seconds": 3.23,
      "text": "Is that dangerous? ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.47,
      "end_seconds": 223.98,
      "duration_seconds": 13.51,
      "text": "No. Bruising is expected on two blood-thinning drugs, and it's not a sign that something is wrong. I'd say these are medication-related bruises, and your other bleeding is minor."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.89,
      "end_seconds": 229.86,
      "duration_seconds": 4.97,
      "text": "Should I stop one of them? ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.45,
      "end_seconds": 245.82,
      "duration_seconds": 14.37,
      "text": "Absolutely not. The stent needs both, usually for at least a year, to stop it clotting. Stopping early can cause another heart attack. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.4,
      "end_seconds": 251.76,
      "duration_seconds": 3.36,
      "text": "Understood. I'll carry on. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.25,
      "end_seconds": 261.21,
      "duration_seconds": 7.96,
      "text": "Use a soft toothbrush, wear long sleeves for gardening, and avoid ibuprofen and other anti-inflammatory painkillers."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.92,
      "end_seconds": 268.58,
      "duration_seconds": 4.66,
      "text": "I do take ibuprofen for my knee. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.62,
      "end_seconds": 272.91,
      "duration_seconds": 3.29,
      "text": "Please stop, and use paracetamol instead."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.73,
      "end_seconds": 275.76,
      "duration_seconds": 2.03,
      "text": "I shall. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.68,
      "end_seconds": 292.03,
      "duration_seconds": 15.35,
      "text": "Your heart clinic will check your tablets. If you bleed heavily, vomit blood, pass black stools, or get a severe headache, go to the emergency department at once."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.78,
      "end_seconds": 296.64,
      "duration_seconds": 2.86,
      "text": "Right. Thank you. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.0,
      "end_seconds": 305.47,
      "duration_seconds": 7.47,
      "text": "I'd like to see you again in four weeks, to check on the bruising."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.85,
      "end_seconds": 311.76,
      "duration_seconds": 3.91,
      "text": "Four weeks. Thank you, doctor. ~"
    }
  ]
}
