{
  "schema_version": "1.0",
  "encounter_id": "00850",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.01,
      "end_seconds": 14.98,
      "duration_seconds": 13.97,
      "text": "Right, I've got twenty minutes. I've been feeling low for two months and I've lost interest in everything, and my sister says I need to see someone."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.48,
      "end_seconds": 23.39,
      "duration_seconds": 5.91,
      "text": "Thank you for coming. Low for two months. Tell me more."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.69,
      "end_seconds": 32.88,
      "duration_seconds": 8.19,
      "text": "I just feel flat. Nothing's wrong, exactly. Work's fine. I get home and do nothing."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.59,
      "end_seconds": 38.74,
      "duration_seconds": 4.15,
      "text": "What have you lost interest in?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.81,
      "end_seconds": 47.74,
      "duration_seconds": 7.93,
      "text": "The gym, mostly. I used to go five times a week. I haven't been since March."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.72,
      "end_seconds": 51.77,
      "duration_seconds": 2.05,
      "text": "How's your sleep?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.15,
      "end_seconds": 60.19,
      "duration_seconds": 6.04,
      "text": "Terrible. I wake at three and my brain starts going."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.76,
      "end_seconds": 64.66,
      "duration_seconds": 1.9,
      "text": "And your energy?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.92,
      "end_seconds": 69.05,
      "duration_seconds": 3.13,
      "text": "Gone. I'm exhausted by lunch."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.56,
      "end_seconds": 71.72,
      "duration_seconds": 1.16,
      "text": "Concentration?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.61,
      "end_seconds": 76.81,
      "duration_seconds": 4.2,
      "text": "Hopeless. I read an email four times."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.28,
      "end_seconds": 83.8,
      "duration_seconds": 4.52,
      "text": "Have you had any thoughts of harming yourself?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.27,
      "end_seconds": 88.79,
      "duration_seconds": 2.52,
      "text": "No. Not at all."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.81,
      "end_seconds": 92.6,
      "duration_seconds": 1.79,
      "text": "Panic attacks?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.39,
      "end_seconds": 96.56,
      "duration_seconds": 3.17,
      "text": "No panic. Just flat."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.79,
      "end_seconds": 103.56,
      "duration_seconds": 4.77,
      "text": "Are you taking anything at the moment?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.81,
      "end_seconds": 117.83,
      "duration_seconds": 12.02,
      "text": "Just the pill, Microgynon, once a day. I take it every day. Well, mostly. I miss the odd one when I'm travelling for work."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.38,
      "end_seconds": 122.85,
      "duration_seconds": 2.47,
      "text": "Okay. Any allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.99,
      "end_seconds": 128.81,
      "duration_seconds": 3.82,
      "text": "Codeine. It makes me vomit."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.09,
      "end_seconds": 132.05,
      "duration_seconds": 0.96,
      "text": "History?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.21,
      "end_seconds": 137.15,
      "duration_seconds": 3.94,
      "text": "Migraines. PCOS. And eczema as a kid."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.35,
      "end_seconds": 140.35,
      "duration_seconds": 1.0,
      "text": "Surgery?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.48,
      "end_seconds": 144.55,
      "duration_seconds": 2.07,
      "text": "Wisdom teeth, 2017."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.37,
      "end_seconds": 149.58,
      "duration_seconds": 4.21,
      "text": "Anyone in the family with low mood?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.16,
      "end_seconds": 155.21,
      "duration_seconds": 3.05,
      "text": "My mother had depression."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.26,
      "end_seconds": 159.19,
      "duration_seconds": 2.93,
      "text": "What do you do?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.56,
      "end_seconds": 166.09,
      "duration_seconds": 5.53,
      "text": "Solicitor. Sixty-hour weeks, so don't suggest I take time off."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.49,
      "end_seconds": 168.4,
      "duration_seconds": 0.91,
      "text": "Drinking?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.66,
      "end_seconds": 173.47,
      "duration_seconds": 3.81,
      "text": "Wine most nights. Two glasses, maybe three."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.57,
      "end_seconds": 177.87,
      "duration_seconds": 2.3,
      "text": "And the gym?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.86,
      "end_seconds": 183.55,
      "duration_seconds": 3.69,
      "text": "I've stopped, as I said."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.06,
      "end_seconds": 204.44,
      "duration_seconds": 7.38,
      "text": "Let me check you. Blood pressure 118 over 74, pulse 72, weight 61 kilos."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.42,
      "end_seconds": 209.43,
      "duration_seconds": 3.01,
      "text": "Is that it? ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.53,
      "end_seconds": 218.07,
      "duration_seconds": 7.54,
      "text": "For now. You look tearful to me, even though you say flat."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.21,
      "end_seconds": 224.74,
      "duration_seconds": 5.53,
      "text": "I'm not tearful. I'm just tired. Okay, maybe a bit. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.58,
      "end_seconds": 235.31,
      "duration_seconds": 7.73,
      "text": "And your speech is slow, compared to how you started, when you were rattling through."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.92,
      "end_seconds": 240.38,
      "duration_seconds": 2.46,
      "text": "Is it? ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.45,
      "end_seconds": 244.57,
      "duration_seconds": 3.12,
      "text": "Any problems with your heart, palpitations?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.48,
      "end_seconds": 250.56,
      "duration_seconds": 3.08,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.37,
      "end_seconds": 258.06,
      "duration_seconds": 6.69,
      "text": "What I'm hearing fits a depressive episode, a moderate one."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.42,
      "end_seconds": 262.68,
      "duration_seconds": 3.26,
      "text": "Depression. Great. What happens now? ~"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.96,
      "end_seconds": 277.98,
      "duration_seconds": 14.02,
      "text": "I'd like to arrange blood tests for your thyroid and a blood count, and a ferritin level, to make sure nothing physical is behind it."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.95,
      "end_seconds": 282.72,
      "duration_seconds": 2.77,
      "text": "Fine. And treatment? ~"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.08,
      "end_seconds": 290.14,
      "duration_seconds": 6.06,
      "text": "I'd like to start sertraline, 50 mg, once a day."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.85,
      "end_seconds": 294.0,
      "duration_seconds": 2.15,
      "text": "Side effects? ~"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.03,
      "end_seconds": 304.73,
      "duration_seconds": 8.7,
      "text": "Some nausea at first, usually settles in a week or two. The wine isn't helping the mood."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.05,
      "end_seconds": 309.28,
      "duration_seconds": 2.23,
      "text": "I know. ~"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.07,
      "end_seconds": 314.79,
      "duration_seconds": 4.72,
      "text": "I'd like to see you again in two weeks."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.58,
      "end_seconds": 321.98,
      "duration_seconds": 4.4,
      "text": "Two weeks. Fine. I have to go. ~"
    }
  ]
}
