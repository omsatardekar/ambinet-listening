{
  "schema_version": "1.0",
  "encounter_id": "00961",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 2.46,
      "end_seconds": 19.46,
      "duration_seconds": 17.0,
      "text": "Good morning, doctor. Thank you for seeing me on short notice. My blood pressure is still up, even on my usual treatment, and my carer here thought I should come."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 22.13,
      "end_seconds": 35.9,
      "duration_seconds": 13.77,
      "text": "I'm Lina, I look after Mr Hartley mornings. I take his pressure every day with the home machine, and it's been 160 over 95, most days this week."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.53,
      "end_seconds": 48.39,
      "duration_seconds": 8.86,
      "text": "Thank you, Lina, that's very helpful. Mr Hartley, have you noticed any symptoms from it? ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.84,
      "end_seconds": 57.87,
      "duration_seconds": 7.03,
      "text": "Headaches, mostly in the mornings, at the back of my head."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.66,
      "end_seconds": 64.72,
      "duration_seconds": 3.06,
      "text": "How about when you stand up?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.04,
      "end_seconds": 72.54,
      "duration_seconds": 5.5,
      "text": "A bit dizzy, yes. I hold the bench for a second."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.71,
      "end_seconds": 76.62,
      "duration_seconds": 1.91,
      "text": "Any chest pain?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.43,
      "end_seconds": 82.43,
      "duration_seconds": 3.0,
      "text": "No, no chest pain."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.06,
      "end_seconds": 87.95,
      "duration_seconds": 1.89,
      "text": "Any blurred vision?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.66,
      "end_seconds": 94.27,
      "duration_seconds": 3.61,
      "text": "No, my eyes are fine."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.76,
      "end_seconds": 101.41,
      "duration_seconds": 3.65,
      "text": "Any swelling of the ankles?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.27,
      "end_seconds": 107.16,
      "duration_seconds": 1.89,
      "text": "No swelling."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.32,
      "end_seconds": 115.05,
      "duration_seconds": 4.73,
      "text": "And your history, apart from the blood pressure?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.83,
      "end_seconds": 122.86,
      "duration_seconds": 5.03,
      "text": "Just the blood pressure, for fifteen years."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.98,
      "end_seconds": 145.34,
      "duration_seconds": 6.36,
      "text": "Let me check it now. Blood pressure 158 over 94, and pulse 76."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 148.9,
      "end_seconds": 153.68,
      "duration_seconds": 4.78,
      "text": "That's the same as at home. ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.29,
      "end_seconds": 173.26,
      "duration_seconds": 7.97,
      "text": "It is. Which is why I believe the home machine. Let me listen to your heart."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.47,
      "end_seconds": 178.59,
      "duration_seconds": 2.12,
      "text": "Go ahead. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.85,
      "end_seconds": 185.51,
      "duration_seconds": 4.66,
      "text": "Heart sounds are normal, with no murmurs."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.77,
      "end_seconds": 190.49,
      "duration_seconds": 1.72,
      "text": "Good. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.79,
      "end_seconds": 197.12,
      "duration_seconds": 3.33,
      "text": "Any trouble with your breathing?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.91,
      "end_seconds": 202.93,
      "duration_seconds": 3.02,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.45,
      "end_seconds": 215.45,
      "duration_seconds": 9.0,
      "text": "What I'm seeing is blood pressure above target, which is consistent with your home readings."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.6,
      "end_seconds": 221.04,
      "duration_seconds": 3.44,
      "text": "What does that mean? ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.74,
      "end_seconds": 236.59,
      "duration_seconds": 11.85,
      "text": "It means the treatment isn't doing enough. Before I change anything, I'd like to arrange a blood test for your kidney function and salts."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 238.99,
      "end_seconds": 242.73,
      "duration_seconds": 3.74,
      "text": "When can he do that? ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.45,
      "end_seconds": 253.01,
      "duration_seconds": 7.56,
      "text": "Today, if he's willing. I'd like to check it's safe to adjust things. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.48,
      "end_seconds": 257.65,
      "duration_seconds": 2.17,
      "text": "Of course. ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.51,
      "end_seconds": 270.6,
      "duration_seconds": 9.09,
      "text": "Lina, can you keep recording the morning readings, and bring the diary back? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 274.45,
      "end_seconds": 276.57,
      "duration_seconds": 2.12,
      "text": "I will. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.0,
      "end_seconds": 284.03,
      "duration_seconds": 5.03,
      "text": "And try to cut the salt in his meals."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 287.23,
      "end_seconds": 289.89,
      "duration_seconds": 2.66,
      "text": "I'll do that. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.71,
      "end_seconds": 298.99,
      "duration_seconds": 6.28,
      "text": "I'd like to see you again in two weeks with the diary."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.53,
      "end_seconds": 305.98,
      "duration_seconds": 4.45,
      "text": "Two weeks. Thank you very much. ~"
    }
  ]
}
