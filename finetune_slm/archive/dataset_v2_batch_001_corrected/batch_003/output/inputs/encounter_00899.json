{
  "schema_version": "1.0",
  "encounter_id": "00899",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 0.46,
      "end_seconds": 12.73,
      "duration_seconds": 12.27,
      "text": "Good morning. The booking says an eczema flare in Ivy. Hello, Ivy! Mum, give me the headlines, I know you're busy. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.64,
      "end_seconds": 28.7,
      "duration_seconds": 14.06,
      "text": "Thanks. It's a flare. Behind her knees and in her elbows, red and rough, for about a week. I've got to be at the bank by eleven."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.7,
      "end_seconds": 33.98,
      "duration_seconds": 3.28,
      "text": "A week. And is she itchy?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 36.3,
      "end_seconds": 40.84,
      "duration_seconds": 4.54,
      "text": "Very. She rubs her legs on the carpet."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 43.55,
      "end_seconds": 48.98,
      "duration_seconds": 5.43,
      "text": "[from the doorway] She was scratching all night, I heard her!"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.04,
      "end_seconds": 56.95,
      "duration_seconds": 5.91,
      "text": "Sorry, who was that? I didn't catch it. ~"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 57.79,
      "end_seconds": 63.84,
      "duration_seconds": 6.05,
      "text": "I think that's my sister, she's waiting outside. Ignore her. ~"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.12,
      "end_seconds": 74.36,
      "duration_seconds": 9.24,
      "text": "Noted, a voice from the doorway says she scratched through the night. Ivy, show me your legs, sweetheart?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.49,
      "end_seconds": 78.02,
      "duration_seconds": 1.53,
      "text": "Itchy! ~"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.12,
      "end_seconds": 88.67,
      "duration_seconds": 8.55,
      "text": "I can see they're itchy. Nurse, can you do her obs while I write? ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 106.28,
      "end_seconds": 116.43,
      "duration_seconds": 10.15,
      "text": "Of course. Temperature 36.8, pulse 110, breathing 24, oxygen 98 percent, weight 13.1 kilos, and height 88 centimetres."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.14,
      "end_seconds": 123.05,
      "duration_seconds": 3.91,
      "text": "Thank you. Mum, any weeping, crusting, fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 125.29,
      "end_seconds": 128.76,
      "duration_seconds": 3.47,
      "text": "No, nothing wet, and no fever."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.15,
      "end_seconds": 134.85,
      "duration_seconds": 4.7,
      "text": "And what are you using on it?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 137.35,
      "end_seconds": 151.28,
      "duration_seconds": 13.93,
      "text": "Epaderm ointment, twice a day, all over. Hydrocortisone cream, once a day on the flares. And cetirizine, maybe 2.5 mg at night, I'd have to look at the bottle."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.16,
      "end_seconds": 159.38,
      "duration_seconds": 5.22,
      "text": "Okay. We'll check the bottle. Any history in Ivy?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 162.05,
      "end_seconds": 169.67,
      "duration_seconds": 7.62,
      "text": "Eczema since she was six months old. And she had bronchiolitis at one."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.66,
      "end_seconds": 174.84,
      "duration_seconds": 3.18,
      "text": "Does she go to nursery?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 176.73,
      "end_seconds": 179.02,
      "duration_seconds": 2.29,
      "text": "Three days a week."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.69,
      "end_seconds": 185.05,
      "duration_seconds": 3.36,
      "text": "And what does she eat?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 187.58,
      "end_seconds": 192.01,
      "duration_seconds": 4.43,
      "text": "Mostly home-cooked. I'm a bit boring that way."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.87,
      "end_seconds": 212.61,
      "duration_seconds": 7.74,
      "text": "Let me see. Ivy, can I look at your knees, like a doctor in a film?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.1,
      "end_seconds": 216.02,
      "duration_seconds": 1.92,
      "text": "No. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 218.85,
      "end_seconds": 223.24,
      "duration_seconds": 4.39,
      "text": "Ivy, be good for the doctor. ~"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.53,
      "end_seconds": 233.93,
      "duration_seconds": 9.4,
      "text": "I can see dry, red, scaly patches behind both knees and in the elbow creases, with a few scratch marks."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 234.88,
      "end_seconds": 237.45,
      "duration_seconds": 2.57,
      "text": "Is it infected? ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.86,
      "end_seconds": 243.47,
      "duration_seconds": 3.61,
      "text": "Any wheeze or cough with it?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 244.33,
      "end_seconds": 248.68,
      "duration_seconds": 4.35,
      "text": "No, nothing, her chest has been fine."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.13,
      "end_seconds": 255.05,
      "duration_seconds": 4.92,
      "text": "And her tummy, any vomiting or loose stools?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 256.45,
      "end_seconds": 260.1,
      "duration_seconds": 3.65,
      "text": "No, nothing like that, everything's normal."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.75,
      "end_seconds": 267.28,
      "duration_seconds": 4.53,
      "text": "This looks like an eczema flare, nothing more."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 269.16,
      "end_seconds": 274.79,
      "duration_seconds": 5.63,
      "text": "Phew. So no change in what we use? ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.8,
      "end_seconds": 288.7,
      "duration_seconds": 12.9,
      "text": "Keep the emollient going, and the hydrocortisone only on the red areas, for up to a week. Pat her dry after baths, don't rub."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 289.43,
      "end_seconds": 291.33,
      "duration_seconds": 1.9,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.24,
      "end_seconds": 300.95,
      "duration_seconds": 6.71,
      "text": "I'd like to see you again in four weeks to make sure it's settled."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 302.37,
      "end_seconds": 307.97,
      "duration_seconds": 5.6,
      "text": "Four weeks. I'll book at the desk. Come on, Ivy. ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.92,
      "end_seconds": 312.75,
      "duration_seconds": 1.83,
      "text": "Bye-bye. ~"
    }
  ]
}
