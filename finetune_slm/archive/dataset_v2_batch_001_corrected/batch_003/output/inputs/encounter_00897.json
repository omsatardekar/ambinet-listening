{
  "schema_version": "1.0",
  "encounter_id": "00897",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 0.73,
      "end_seconds": 9.62,
      "duration_seconds": 8.89,
      "text": "Morning, Mrs Calloway. Is it still raining out there? I've been in since seven and haven't looked. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.33,
      "end_seconds": 17.66,
      "duration_seconds": 6.33,
      "text": "Pouring. And the car park is a lottery. Never mind that. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.09,
      "end_seconds": 24.45,
      "duration_seconds": 4.36,
      "text": "Right, what brings you in today? ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.99,
      "end_seconds": 40.88,
      "duration_seconds": 14.89,
      "text": "It's probably nothing. I'm fifty and I get these hot flushes. I wouldn't be here, but my daughter said it's silly to put up with it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.78,
      "end_seconds": 43.44,
      "duration_seconds": 1.66,
      "text": "How often?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.98,
      "end_seconds": 52.26,
      "duration_seconds": 6.28,
      "text": "Five or six times a day. Started about eight months ago."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.43,
      "end_seconds": 56.66,
      "duration_seconds": 2.23,
      "text": "And at night?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.48,
      "end_seconds": 67.4,
      "duration_seconds": 7.92,
      "text": "Night sweats, yes. I have to change the T-shirt, once or twice a night."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.5,
      "end_seconds": 71.83,
      "duration_seconds": 2.33,
      "text": "How's your mood?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.17,
      "end_seconds": 83.78,
      "duration_seconds": 9.61,
      "text": "A bit short-tempered. The staff would tell you. I'm the head teacher, I'm not supposed to snap."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.3,
      "end_seconds": 88.7,
      "duration_seconds": 2.4,
      "text": "Any weight loss?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.61,
      "end_seconds": 94.4,
      "duration_seconds": 3.79,
      "text": "No, if anything I've put it on."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.01,
      "end_seconds": 99.29,
      "duration_seconds": 3.28,
      "text": "Any lumps in the breasts?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.58,
      "end_seconds": 104.4,
      "duration_seconds": 2.82,
      "text": "No lumps. I check."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.83,
      "end_seconds": 109.73,
      "duration_seconds": 3.9,
      "text": "What do you take at the moment?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.07,
      "end_seconds": 126.04,
      "duration_seconds": 13.97,
      "text": "Levothyroxine, 100 micrograms, once a day. Atorvastatin, 20 mg, at night. Vitamin D, 1000 units, once a day. And ibuprofen, 200 mg, when my knees are bad."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.89,
      "end_seconds": 129.91,
      "duration_seconds": 2.02,
      "text": "Good. Any allergies?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.84,
      "end_seconds": 134.48,
      "duration_seconds": 1.64,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.33,
      "end_seconds": 138.09,
      "duration_seconds": 1.76,
      "text": "Medical history?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.01,
      "end_seconds": 143.01,
      "duration_seconds": 4.0,
      "text": "Underactive thyroid, high cholesterol, and migraines."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.71,
      "end_seconds": 146.68,
      "duration_seconds": 0.97,
      "text": "Operations?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.63,
      "end_seconds": 152.28,
      "duration_seconds": 2.65,
      "text": "Appendix out, in 2002."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.49,
      "end_seconds": 159.09,
      "duration_seconds": 4.6,
      "text": "When did your mother go through the menopause?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.56,
      "end_seconds": 164.14,
      "duration_seconds": 2.58,
      "text": "Early, at forty-five."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.11,
      "end_seconds": 168.11,
      "duration_seconds": 2.0,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.62,
      "end_seconds": 170.94,
      "duration_seconds": 1.32,
      "text": "Never."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.66,
      "end_seconds": 172.93,
      "duration_seconds": 1.27,
      "text": "Drink?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.56,
      "end_seconds": 178.08,
      "duration_seconds": 3.52,
      "text": "Two glasses of wine, most evenings."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.07,
      "end_seconds": 182.61,
      "duration_seconds": 1.54,
      "text": "Exercise?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.87,
      "end_seconds": 188.3,
      "duration_seconds": 3.43,
      "text": "I walk the dog, forty minutes."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.44,
      "end_seconds": 193.21,
      "duration_seconds": 3.77,
      "text": "And work, you said head teacher?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.15,
      "end_seconds": 198.98,
      "duration_seconds": 2.83,
      "text": "Yes, a primary school."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.31,
      "end_seconds": 227.02,
      "duration_seconds": 10.71,
      "text": "Let me take your numbers. Pulse 74, blood pressure 128 over 80, temperature 36.7, oxygen 99 percent, breathing 14, and weight 72 kilos."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.2,
      "end_seconds": 231.66,
      "duration_seconds": 3.46,
      "text": "That's more than last year. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.46,
      "end_seconds": 247.89,
      "duration_seconds": 5.43,
      "text": "A couple of kilos. Let me listen to your heart."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.49,
      "end_seconds": 256.29,
      "duration_seconds": 6.8,
      "text": "Heart sounds are normal, and your thyroid feels normal in size, no lumps."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.8,
      "end_seconds": 259.18,
      "duration_seconds": 1.38,
      "text": "Good. ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.87,
      "end_seconds": 266.12,
      "duration_seconds": 4.25,
      "text": "Any trouble with your heart, palpitations?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.16,
      "end_seconds": 270.81,
      "duration_seconds": 2.65,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.25,
      "end_seconds": 275.81,
      "duration_seconds": 3.56,
      "text": "Any trouble with your waterworks?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.79,
      "end_seconds": 280.88,
      "duration_seconds": 3.09,
      "text": "No, nothing. It's all normal."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.99,
      "end_seconds": 294.06,
      "duration_seconds": 11.07,
      "text": "Your symptoms sound like the perimenopause, I'd say, but I can't rule out your thyroid dose being off."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.62,
      "end_seconds": 299.44,
      "duration_seconds": 2.82,
      "text": "Is it the thyroid? ~"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.09,
      "end_seconds": 309.28,
      "duration_seconds": 8.19,
      "text": "Possibly. I'd like to arrange blood tests for your thyroid and hormone levels, and a blood count."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.72,
      "end_seconds": 312.65,
      "duration_seconds": 1.93,
      "text": "Fine. ~"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.08,
      "end_seconds": 324.12,
      "duration_seconds": 9.04,
      "text": "And since your mother had an early menopause, I'd like to arrange a bone density scan."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.22,
      "end_seconds": 329.27,
      "duration_seconds": 4.05,
      "text": "Right. And what about treatment? ~"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.71,
      "end_seconds": 341.96,
      "duration_seconds": 10.25,
      "text": "We'll talk about the options once the results are back. Until then, keep cool at night, and cut the wine."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.01,
      "end_seconds": 349.42,
      "duration_seconds": 6.41,
      "text": "I'll try, though the wine is the hard part. ~"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.1,
      "end_seconds": 356.55,
      "duration_seconds": 5.45,
      "text": "I'd like to see you again in six weeks."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.27,
      "end_seconds": 362.56,
      "duration_seconds": 3.29,
      "text": "Six weeks. Thank you. ~"
    }
  ]
}
