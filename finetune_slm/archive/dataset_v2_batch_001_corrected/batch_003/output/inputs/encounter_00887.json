{
  "schema_version": "1.0",
  "encounter_id": "00887",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 1.85,
      "end_seconds": 11.74,
      "duration_seconds": 9.89,
      "text": "Doctor, he fell off his bike outside the house, and cut his lip, and one of his front teeth is loose."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.04,
      "end_seconds": 21.03,
      "duration_seconds": 5.99,
      "text": "Thank you. Is that right, Dev? You came off your bike? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.25,
      "end_seconds": 26.74,
      "duration_seconds": 3.49,
      "text": "Yeah. I hit the kerb. ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.18,
      "end_seconds": 32.85,
      "duration_seconds": 2.67,
      "text": "When did it happen?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 36.14,
      "end_seconds": 41.87,
      "duration_seconds": 5.73,
      "text": "About an hour ago. I brought him straight here."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.43,
      "end_seconds": 50.42,
      "duration_seconds": 5.99,
      "text": "Did you hit your head, Dev, or black out at all?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.0,
      "end_seconds": 59.24,
      "duration_seconds": 6.24,
      "text": "No. I put my hands out and my mouth hit the ground."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 60.99,
      "end_seconds": 67.04,
      "duration_seconds": 6.05,
      "text": "He was awake the whole time, he was crying straight away."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.88,
      "end_seconds": 75.3,
      "duration_seconds": 5.42,
      "text": "Good. Any neck pain, or pain anywhere else?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.97,
      "end_seconds": 82.26,
      "duration_seconds": 5.29,
      "text": "My wrist hurts a bit. The left one."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.28,
      "end_seconds": 87.96,
      "duration_seconds": 3.68,
      "text": "Any vomiting or dizziness since?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.04,
      "end_seconds": 95.68,
      "duration_seconds": 5.64,
      "text": "No, nothing like that. I feel okay, just my mouth hurts."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.29,
      "end_seconds": 102.07,
      "duration_seconds": 3.78,
      "text": "Has he taken anything for the pain?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 103.82,
      "end_seconds": 111.55,
      "duration_seconds": 7.73,
      "text": "I gave him a spoonful of that pink medicine for children, I don't know the name."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.0,
      "end_seconds": 117.12,
      "duration_seconds": 3.12,
      "text": "Do you know how much?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 120.36,
      "end_seconds": 123.63,
      "duration_seconds": 3.27,
      "text": "Just a teaspoon, I think."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.14,
      "end_seconds": 130.22,
      "duration_seconds": 4.08,
      "text": "Thank you. Does he have any medical conditions?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 133.33,
      "end_seconds": 136.37,
      "duration_seconds": 3.04,
      "text": "Asthma, mild. Nothing else."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.97,
      "end_seconds": 143.38,
      "duration_seconds": 5.41,
      "text": "Let me check his pulse, oxygen and temperature. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.09,
      "end_seconds": 157.22,
      "duration_seconds": 1.13,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.96,
      "end_seconds": 162.95,
      "duration_seconds": 3.99,
      "text": "Pulse 96, oxygen 99 percent, temperature 36.8."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 166.15,
      "end_seconds": 169.35,
      "duration_seconds": 3.2,
      "text": "Is it all right? ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.47,
      "end_seconds": 179.79,
      "duration_seconds": 7.32,
      "text": "All normal. Dev, can you open your mouth wide for me? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.71,
      "end_seconds": 196.88,
      "duration_seconds": 1.17,
      "text": "Ahh."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.75,
      "end_seconds": 208.96,
      "duration_seconds": 9.21,
      "text": "There's a cut on the inside of the upper lip, about a centimetre long, and it's stopped bleeding."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 210.65,
      "end_seconds": 213.83,
      "duration_seconds": 3.18,
      "text": "What about the tooth? ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.85,
      "end_seconds": 228.34,
      "duration_seconds": 11.49,
      "text": "The upper left front tooth is loose, and slightly pushed back. It looks like a baby tooth, so we need to be careful."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.0,
      "end_seconds": 233.8,
      "duration_seconds": 2.8,
      "text": "Will it fall out? ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.14,
      "end_seconds": 249.34,
      "duration_seconds": 13.2,
      "text": "Possibly. I'd like you to see a dentist today, and if they think it is needed, they may do an X-ray of the tooth."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 251.49,
      "end_seconds": 255.14,
      "duration_seconds": 3.65,
      "text": "I'll take him straight there. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.99,
      "end_seconds": 266.21,
      "duration_seconds": 9.22,
      "text": "The cut doesn't need stitches. Rinse with salt water, and give soft foods for a few days."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.26,
      "end_seconds": 269.65,
      "duration_seconds": 1.39,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.82,
      "end_seconds": 286.38,
      "duration_seconds": 13.56,
      "text": "And his wrist is tender but he can move it. If the pain gets worse, or it swells, we should X-ray it."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 287.89,
      "end_seconds": 290.81,
      "duration_seconds": 2.92,
      "text": "We'll watch it. ~"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.28,
      "end_seconds": 301.61,
      "duration_seconds": 8.33,
      "text": "If he vomits, becomes sleepy, or the bleeding starts again, come back to us immediately."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 303.16,
      "end_seconds": 305.98,
      "duration_seconds": 2.82,
      "text": "Thank you, doctor. ~"
    }
  ]
}
