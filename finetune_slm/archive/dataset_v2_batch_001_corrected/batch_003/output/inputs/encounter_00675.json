{
  "schema_version": "1.0",
  "encounter_id": "00675",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 0.97,
      "end_seconds": 15.1,
      "duration_seconds": 14.13,
      "text": "Morning, doctor. Sorry, we're a few minutes early. Mia won't say it, so I will, it's the trains. She had another bad one on Monday. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.29,
      "end_seconds": 25.16,
      "duration_seconds": 8.87,
      "text": "Thanks, Gareth. Mia, I'd like to hear it from you, whenever you're ready. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.06,
      "end_seconds": 37.64,
      "duration_seconds": 10.58,
      "text": "Well. It's... the commute. I get these panic attacks on the Northern line. Monday, no, Tuesday. Gareth says Monday."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.14,
      "end_seconds": 43.18,
      "duration_seconds": 4.04,
      "text": "Take your time. What happens in one?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.58,
      "end_seconds": 58.58,
      "duration_seconds": 13.0,
      "text": "My heart races, it feels like it's going to burst out of my chest. And then I can't get my breath, and I have to get off."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.58,
      "end_seconds": 63.22,
      "duration_seconds": 2.64,
      "text": "How often does this happen?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.95,
      "end_seconds": 74.11,
      "duration_seconds": 8.16,
      "text": "About twice a week at the moment. It was every day in March."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.96,
      "end_seconds": 80.49,
      "duration_seconds": 4.53,
      "text": "Do you feel anything else, dizzy, sweaty?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.36,
      "end_seconds": 87.11,
      "duration_seconds": 3.75,
      "text": "Dizzy, yes. The platform sort of tilts."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.6,
      "end_seconds": 92.54,
      "duration_seconds": 2.94,
      "text": "And how are you sleeping?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.1,
      "end_seconds": 101.82,
      "duration_seconds": 7.72,
      "text": "Badly. I wake up at three and just lie there thinking about the journey."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.65,
      "end_seconds": 109.06,
      "duration_seconds": 5.41,
      "text": "Have you had any chest pain during these?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.8,
      "end_seconds": 115.74,
      "duration_seconds": 5.94,
      "text": "No chest pain. It's the racing that frightens me, not pain."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.57,
      "end_seconds": 121.06,
      "duration_seconds": 3.49,
      "text": "Any thoughts of harming yourself?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.31,
      "end_seconds": 125.63,
      "duration_seconds": 3.32,
      "text": "No, no, nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 128.17,
      "end_seconds": 131.53,
      "duration_seconds": 3.36,
      "text": "She'd tell you, honestly. ~"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.61,
      "end_seconds": 136.54,
      "duration_seconds": 3.93,
      "text": "Thank you, Gareth. Mia, any fainting?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.08,
      "end_seconds": 142.18,
      "duration_seconds": 4.1,
      "text": "I've never fainted. Never actually fallen."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.26,
      "end_seconds": 148.18,
      "duration_seconds": 3.92,
      "text": "What are you taking at the moment?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.73,
      "end_seconds": 162.7,
      "duration_seconds": 12.97,
      "text": "Sertraline, 100 mg, once a day. Propranolol, 40 mg, when I'm panicky, on the train mostly. And melatonin, 2 mg, at night."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.18,
      "end_seconds": 167.25,
      "duration_seconds": 3.07,
      "text": "Good. Any allergies to anything?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.0,
      "end_seconds": 174.05,
      "duration_seconds": 6.05,
      "text": "No, no allergies. Gareth's allergic to everything, not me."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 176.71,
      "end_seconds": 179.82,
      "duration_seconds": 3.11,
      "text": "That's true, I am. ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.61,
      "end_seconds": 185.84,
      "duration_seconds": 3.23,
      "text": "Anything in your past health?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.85,
      "end_seconds": 193.7,
      "duration_seconds": 6.85,
      "text": "Depression, years ago, which is why the sertraline. And irritable bowel syndrome."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.61,
      "end_seconds": 199.1,
      "duration_seconds": 2.49,
      "text": "Ever had surgery?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.06,
      "end_seconds": 205.43,
      "duration_seconds": 4.37,
      "text": "Just my tonsils, when I was eight."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.91,
      "end_seconds": 212.04,
      "duration_seconds": 4.13,
      "text": "Does anxiety run in the family?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.59,
      "end_seconds": 221.61,
      "duration_seconds": 7.02,
      "text": "My mother has always been a worrier, she was treated for anxiety."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.38,
      "end_seconds": 226.8,
      "duration_seconds": 2.42,
      "text": "What's your job?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.63,
      "end_seconds": 235.22,
      "duration_seconds": 6.59,
      "text": "I'm an accountant. Quarter end is hellish, which doesn't help."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.24,
      "end_seconds": 238.23,
      "duration_seconds": 0.99,
      "text": "Coffee?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.69,
      "end_seconds": 243.59,
      "duration_seconds": 3.9,
      "text": "Four cups a day. I know."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.63,
      "end_seconds": 276.65,
      "duration_seconds": 16.02,
      "text": "Let me check your pulse and blood pressure. Pulse 88, blood pressure 124 over 80, temperature 36.6, oxygen 99 percent, breathing 16, and weight 62 kilos."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.44,
      "end_seconds": 280.24,
      "duration_seconds": 2.8,
      "text": "Is the pulse high? ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.3,
      "end_seconds": 302.45,
      "duration_seconds": 10.15,
      "text": "A bit quick but you're nervous, which is fair. I'm going to listen to your heart."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 304.47,
      "end_seconds": 307.39,
      "duration_seconds": 2.92,
      "text": "Shall I wait outside? ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.27,
      "end_seconds": 314.0,
      "duration_seconds": 5.73,
      "text": "Stay, it's fine if Mia's happy. Heart sounds are normal, regular rhythm."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.07,
      "end_seconds": 318.4,
      "duration_seconds": 2.33,
      "text": "Oh good. ~"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.24,
      "end_seconds": 331.52,
      "duration_seconds": 12.28,
      "text": "And I can see slightly dilated pupils, which fits with a racing heart. Any trouble with your breathing between attacks?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.56,
      "end_seconds": 337.25,
      "duration_seconds": 3.69,
      "text": "No, nothing. I'm fine between attacks."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.3,
      "end_seconds": 343.11,
      "duration_seconds": 3.81,
      "text": "Headaches or vision changes, anything neurological?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.71,
      "end_seconds": 349.67,
      "duration_seconds": 4.96,
      "text": "No, nothing. No headaches, my vision's normal."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.91,
      "end_seconds": 363.55,
      "duration_seconds": 12.64,
      "text": "Here's my thinking. This looks like panic attacks, and given the coffee and the racing heart, I can't rule out an overactive thyroid."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 366.55,
      "end_seconds": 370.09,
      "duration_seconds": 3.54,
      "text": "Is it my thyroid? ~"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.73,
      "end_seconds": 382.57,
      "duration_seconds": 10.84,
      "text": "Possibly not, but I'd like to arrange a thyroid blood test, a blood count, and an ECG today to be sure."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 383.54,
      "end_seconds": 389.05,
      "duration_seconds": 5.51,
      "text": "And the monitor thing, the one for 24 hours? ~"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 390.02,
      "end_seconds": 397.42,
      "duration_seconds": 7.4,
      "text": "Good thought. I'd like to arrange a 24-hour heart monitor as well."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 399.94,
      "end_seconds": 403.5,
      "duration_seconds": 3.56,
      "text": "How long does that take? ~"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 404.33,
      "end_seconds": 413.81,
      "duration_seconds": 9.48,
      "text": "You wear it for a day, you carry on as normal. Also try cutting the coffee down gradually."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 415.25,
      "end_seconds": 417.66,
      "duration_seconds": 2.41,
      "text": "To what? ~"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 419.07,
      "end_seconds": 427.02,
      "duration_seconds": 7.95,
      "text": "Two cups to start. And keep the propranolol for the train for now. ~"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 428.58,
      "end_seconds": 430.37,
      "duration_seconds": 1.79,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 431.75,
      "end_seconds": 440.9,
      "duration_seconds": 9.15,
      "text": "If the attacks haven't eased in four weeks, come back and we'll talk about talking therapy."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 443.87,
      "end_seconds": 446.86,
      "duration_seconds": 2.99,
      "text": "We'll make an appointment. ~"
    }
  ]
}
