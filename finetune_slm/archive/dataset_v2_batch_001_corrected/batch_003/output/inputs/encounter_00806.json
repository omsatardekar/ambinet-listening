{
  "schema_version": "1.0",
  "encounter_id": "00806",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.08,
      "end_seconds": 17.41,
      "duration_seconds": 16.33,
      "text": "Hello, doctor. Oh dear, I've got this double vision, since yesterday, and it's the oddest thing. I see two of everything, when I look to the left."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.15,
      "end_seconds": 20.98,
      "duration_seconds": 2.83,
      "text": "When exactly did it start?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.75,
      "end_seconds": 31.77,
      "duration_seconds": 8.02,
      "text": "Yesterday afternoon, about three. I was watching the telly, and I thought there were two screens."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.22,
      "end_seconds": 39.69,
      "duration_seconds": 6.47,
      "text": "Is it there all the time, or does it come and go?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.52,
      "end_seconds": 49.09,
      "duration_seconds": 8.57,
      "text": "All the time, if I look left. If I close one eye, it vanishes."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.68,
      "end_seconds": 57.73,
      "duration_seconds": 6.05,
      "text": "Any pain behind the eye, headache, or drooping of the eyelid?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.72,
      "end_seconds": 64.09,
      "duration_seconds": 5.37,
      "text": "No pain, no droop. Just the double vision."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.18,
      "end_seconds": 71.65,
      "duration_seconds": 5.47,
      "text": "You had your cataract surgery recently, didn't you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.7,
      "end_seconds": 80.98,
      "duration_seconds": 8.28,
      "text": "Yes, the right eye, six weeks ago. They said it went very well."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.56,
      "end_seconds": 87.23,
      "duration_seconds": 4.67,
      "text": "Right. What are you taking at the moment?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.99,
      "end_seconds": 102.72,
      "duration_seconds": 13.73,
      "text": "Drops in the eye, still, one drop, three times a day. And my blood pressure tablet, I can't remember the name, it's a small white one."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.7,
      "end_seconds": 114.86,
      "duration_seconds": 9.16,
      "text": "Let me check, I've got it here. Amlodipine, 5 mg once a day. That one?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.99,
      "end_seconds": 117.82,
      "duration_seconds": 1.83,
      "text": "That's the one."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.69,
      "end_seconds": 123.43,
      "duration_seconds": 2.74,
      "text": "And your medical history?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.67,
      "end_seconds": 128.82,
      "duration_seconds": 4.15,
      "text": "High blood pressure. And I get migraines."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.53,
      "end_seconds": 133.19,
      "duration_seconds": 2.66,
      "text": "Do you live alone?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.24,
      "end_seconds": 140.83,
      "duration_seconds": 6.59,
      "text": "With my husband. He's at the bus stop, he'll be along."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.77,
      "end_seconds": 147.99,
      "duration_seconds": 5.22,
      "text": "Let me take your pulse and pressure. ~"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.02,
      "end_seconds": 151.39,
      "duration_seconds": 2.37,
      "text": "Go on. ~"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.45,
      "end_seconds": 170.62,
      "duration_seconds": 5.17,
      "text": "Pulse 76, blood pressure 156 over 94, temperature 36.7."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.49,
      "end_seconds": 175.74,
      "duration_seconds": 2.25,
      "text": "Is that high? ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.78,
      "end_seconds": 205.37,
      "duration_seconds": 8.59,
      "text": "It's higher than I'd like. Let me check your eye movements. Follow my finger with your eyes."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.54,
      "end_seconds": 209.91,
      "duration_seconds": 2.37,
      "text": "Like that? ~"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.33,
      "end_seconds": 225.3,
      "duration_seconds": 13.97,
      "text": "You can't move your right eye outwards fully, it stops short on looking to the right, and your pupils are equal and react normally."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.56,
      "end_seconds": 230.99,
      "duration_seconds": 3.43,
      "text": "Is that why it's double? ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.57,
      "end_seconds": 245.73,
      "duration_seconds": 12.16,
      "text": "Yes, one of the muscles that moves the eye isn't working properly, and the two eyes aren't lining up. ~"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.01,
      "end_seconds": 249.25,
      "duration_seconds": 2.24,
      "text": "What causes it? ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.09,
      "end_seconds": 270.75,
      "duration_seconds": 19.66,
      "text": "It can be due to a nerve problem, sometimes related to high blood pressure or diabetes, and sometimes something more serious. I can't rule out a nerve palsy caused by a vascular problem, but I need tests."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.78,
      "end_seconds": 275.79,
      "duration_seconds": 4.01,
      "text": "Is it from the operation? ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.81,
      "end_seconds": 282.97,
      "duration_seconds": 5.16,
      "text": "Unlikely, it's the eye muscles, not the lens. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.17,
      "end_seconds": 285.66,
      "duration_seconds": 1.49,
      "text": "Right. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.92,
      "end_seconds": 299.07,
      "duration_seconds": 12.15,
      "text": "Because it's sudden, I want to be sure, so I'd like you to go to the eye clinic today for a full assessment. ~"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.96,
      "end_seconds": 303.24,
      "duration_seconds": 2.28,
      "text": "Today? Oh. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.89,
      "end_seconds": 315.42,
      "duration_seconds": 9.53,
      "text": "Yes. I'll ring ahead. And I'd like to take your blood pressure again after ten minutes."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.32,
      "end_seconds": 318.67,
      "duration_seconds": 1.35,
      "text": "Fine. ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.1,
      "end_seconds": 331.2,
      "duration_seconds": 11.1,
      "text": "Don't drive, and if you get a drooping eyelid, a severe headache, or weakness in your face or limbs, call 999."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.31,
      "end_seconds": 335.69,
      "duration_seconds": 2.38,
      "text": "I will. ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.78,
      "end_seconds": 342.76,
      "duration_seconds": 4.98,
      "text": "I'd like to see you again in three days."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.62,
      "end_seconds": 349.03,
      "duration_seconds": 3.41,
      "text": "Three days. Thank you, doctor. ~"
    }
  ]
}
