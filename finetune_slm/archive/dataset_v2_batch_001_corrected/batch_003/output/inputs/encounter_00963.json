{
  "schema_version": "1.0",
  "encounter_id": "00963",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.69,
      "end_seconds": 5.1,
      "duration_seconds": 3.41,
      "text": "Sorry I'm late. Parking. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.92,
      "end_seconds": 14.63,
      "duration_seconds": 6.71,
      "text": "No problem at all. Come in. What can I do for you today? ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.17,
      "end_seconds": 21.51,
      "duration_seconds": 4.34,
      "text": "Eye drops. I want to check them."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.57,
      "end_seconds": 25.91,
      "duration_seconds": 2.34,
      "text": "Which eye drops? ~"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.96,
      "end_seconds": 32.24,
      "duration_seconds": 3.28,
      "text": "The ones I'm using. For dryness."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.07,
      "end_seconds": 37.97,
      "duration_seconds": 2.9,
      "text": "What are they called?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.7,
      "end_seconds": 46.49,
      "duration_seconds": 6.79,
      "text": "Artificial tears. Four times a day. Maybe two drops each time? I'm not sure."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.9,
      "end_seconds": 53.18,
      "duration_seconds": 4.28,
      "text": "How long have you used them? ~"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.88,
      "end_seconds": 57.59,
      "duration_seconds": 2.71,
      "text": "A few months. ~"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.57,
      "end_seconds": 64.34,
      "duration_seconds": 4.77,
      "text": "And what made you want to check them? ~"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.86,
      "end_seconds": 72.62,
      "duration_seconds": 4.76,
      "text": "I think I'm allergic to something in them."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.25,
      "end_seconds": 78.32,
      "duration_seconds": 3.07,
      "text": "Why do you say that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.09,
      "end_seconds": 84.78,
      "duration_seconds": 4.69,
      "text": "Red eyes. Itchy. After I put them in."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.3,
      "end_seconds": 93.11,
      "duration_seconds": 4.81,
      "text": "Do you know what the reaction is to?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.43,
      "end_seconds": 100.88,
      "duration_seconds": 4.45,
      "text": "The preservative, I think. The label says so."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.02,
      "end_seconds": 111.28,
      "duration_seconds": 8.26,
      "text": "That would make sense. Do you have any allergies that I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.82,
      "end_seconds": 116.74,
      "duration_seconds": 2.92,
      "text": "Just that. And penicillin."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.8,
      "end_seconds": 124.33,
      "duration_seconds": 5.53,
      "text": "Penicillin, I'll note that, too. Can you tell me about it?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.77,
      "end_seconds": 130.51,
      "duration_seconds": 2.74,
      "text": "Rash. As a kid."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.74,
      "end_seconds": 137.2,
      "duration_seconds": 4.46,
      "text": "Right. I'll put both on your file. ~"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.59,
      "end_seconds": 141.46,
      "duration_seconds": 1.87,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.43,
      "end_seconds": 148.24,
      "duration_seconds": 4.81,
      "text": "Anything in your health history I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.26,
      "end_seconds": 154.16,
      "duration_seconds": 2.9,
      "text": "Dry eye. That's it."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.66,
      "end_seconds": 160.95,
      "duration_seconds": 3.29,
      "text": "Have you had any eye surgery?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.0,
      "end_seconds": 166.5,
      "duration_seconds": 2.5,
      "text": "LASIK. In 2016."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.22,
      "end_seconds": 173.2,
      "duration_seconds": 3.98,
      "text": "Do you work on a computer?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.11,
      "end_seconds": 178.98,
      "duration_seconds": 2.87,
      "text": "Graphic designer. All day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.13,
      "end_seconds": 183.8,
      "duration_seconds": 2.67,
      "text": "How many hours? ~"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.12,
      "end_seconds": 187.63,
      "duration_seconds": 1.51,
      "text": "Ten. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.58,
      "end_seconds": 203.25,
      "duration_seconds": 12.67,
      "text": "Right. Let me explain. Many eye drops contain a preservative, to keep the bottle fresh. In some people it irritates the eye with regular use. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.04,
      "end_seconds": 208.11,
      "duration_seconds": 3.07,
      "text": "That's what I thought. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.54,
      "end_seconds": 222.63,
      "duration_seconds": 12.09,
      "text": "I think your eyes are being irritated by the preservative, probably on top of the dry eye from screens and from the LASIK."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.64,
      "end_seconds": 226.07,
      "duration_seconds": 1.43,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.92,
      "end_seconds": 235.16,
      "duration_seconds": 7.24,
      "text": "There are preservative-free versions, in single-use vials. You could ask the pharmacy for those."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.39,
      "end_seconds": 240.08,
      "duration_seconds": 2.69,
      "text": "Are they expensive? ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.29,
      "end_seconds": 247.62,
      "duration_seconds": 4.33,
      "text": "A bit more, but they're much gentler. ~"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.82,
      "end_seconds": 252.73,
      "duration_seconds": 1.91,
      "text": "Fine. ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.15,
      "end_seconds": 264.69,
      "duration_seconds": 9.54,
      "text": "And take a break from the screen every twenty minutes, look out the window for twenty seconds."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.34,
      "end_seconds": 268.22,
      "duration_seconds": 1.88,
      "text": "I forget. ~"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.95,
      "end_seconds": 274.86,
      "duration_seconds": 3.91,
      "text": "Set a timer on your computer. ~"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.31,
      "end_seconds": 279.52,
      "duration_seconds": 2.21,
      "text": "Good idea. ~"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.68,
      "end_seconds": 291.07,
      "duration_seconds": 9.39,
      "text": "I'd like to see you again in six weeks to see how your eyes are."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.73,
      "end_seconds": 296.55,
      "duration_seconds": 2.82,
      "text": "Okay. Six weeks. ~"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.72,
      "end_seconds": 301.14,
      "duration_seconds": 2.42,
      "text": "Anything else? ~"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.76,
      "end_seconds": 306.04,
      "duration_seconds": 2.28,
      "text": "No. Thanks. ~"
    }
  ]
}
