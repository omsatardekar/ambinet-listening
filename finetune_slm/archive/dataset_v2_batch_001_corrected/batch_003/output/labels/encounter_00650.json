  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Very sensible. How is the knee, since we sent you for the scan?",
      "start_timestamp": "00:13",
      "end_timestamp": "00:21",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "The scan is consistent with a small tear in the meniscus, which is the cartilage cushion in the knee, on the inner side.",
      "start_timestamp": "00:54",
      "end_timestamp": "01:07",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I thought it might be. I did my knee in at Sunday football, I told you. Twisted it in the mud, my own fault.",
      "start_timestamp": "01:09",
      "end_timestamp": "01:23",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Football's a young man's game. Tell me about your tablets, so I can check against the record.",
      "start_timestamp": "01:48",
      "end_timestamp": "01:57",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Ibuprofen, 400 mg, when it twinges. And paracetamol, 1 gram, when the ibuprofen's not enough. I only use them after the match.",
      "start_timestamp": "01:59",
      "end_timestamp": "02:11",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Not at this stage, no. I'd like you to do the physiotherapy exercises I'll print out, daily, and avoid twisting on that leg.",
      "start_timestamp": "03:19",
      "end_timestamp": "03:33",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let's see how it feels in six weeks. I'd like to see you then to review it.",
      "start_timestamp": "04:30",
      "end_timestamp": "04:38",
