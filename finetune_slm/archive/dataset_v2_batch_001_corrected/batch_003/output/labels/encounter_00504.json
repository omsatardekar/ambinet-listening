  "clinical_uncertainties": [],
  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It's the left one. I keep seeing these little floaters, like specks of dirt or tiny cobwebs drifting about. About two weeks now, I think.",
      "start_timestamp": "00:28",
      "end_timestamp": "00:40",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Mostly they're there. They float off when I look at them, which is rather maddening. And then there are the flashes, as well. Little flickers of light at the side, like someone taking a photograph. That began last Tuesday.",
      "start_timestamp": "00:53",
      "end_timestamp": "01:14",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, the left. Is that terrible? It sounds terrible. My friend Pauline said a flash can mean you're going blind.",
      "start_timestamp": "01:24",
      "end_timestamp": "01:35",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I know it's frightening to hear, so let me ask a few things to put it into context. Has a dark curtain or shadow come across any part of your vision?",
      "start_timestamp": "01:37",
      "end_timestamp": "01:54",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, no curtain. Nothing like that. It's all still there, just with the specks in it.",
      "start_timestamp": "01:55",
      "end_timestamp": "02:03",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. And any pain in the eye, or redness?",
      "start_timestamp": "02:06",
      "end_timestamp": "02:11",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No pain at all. No redness either, I looked in the mirror this morning, twice.",
      "start_timestamp": "02:13",
      "end_timestamp": "02:21",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Quite right to look. Now, I'm going to ask a wider question. Any problems with your nerves or your head, like weakness, numbness, or trouble speaking?",
      "start_timestamp": "02:23",
      "end_timestamp": "02:39",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, nothing like that, I'd have gone straight to A&E, wouldn't I?",
      "start_timestamp": "02:40",
      "end_timestamp": "02:47",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I take atorvastatin, 20 mg, in the evening. Ramipril, that's 5 mg, in the morning. And levothyroxine, 50 micrograms, first thing before breakfast. For my underactive thyroid. Have I forgotten anything? I think that's all of them.",
      "start_timestamp": "02:59",
      "end_timestamp": "03:16",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medications[0]",
        "medications[1]",
        "medications[2]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, that's the only thing really. I had a rash with penicillin when I was a child, my mother always told me. I haven't touched it since, so I suppose I'm allergic.",
      "start_timestamp": "03:28",
      "end_timestamp": "03:43",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you, that's useful and I'll note it down. Do you smoke, or drink at all?",
      "start_timestamp": "03:44",
      "end_timestamp": "03:52",
      "supports": [
        "medical_history.social_history[0]",
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I've never smoked, never even tried it, my father would have had a fit. And I have a glass of wine on Fridays, sometimes two if Pauline's visiting.",
      "start_timestamp": "03:55",
      "end_timestamp": "04:12",
      "supports": [
        "medical_history.social_history[0]",
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's very moderate. Let me read your numbers, now that you've cooled down from your bus dash. Blood pressure is 148 over 90, a little higher than usual.",
      "start_timestamp": "04:14",
      "end_timestamp": "04:30",
      "supports": [
        "vital_signs[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Quite likely. Your pulse is 78, oxygen saturation is 98 percent, temperature 36.6, and you weigh 71 kilos.",
      "start_timestamp": "04:50",
      "end_timestamp": "05:01",
      "supports": [
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "No, you're perfectly fine. Now, I'll tell you what I think. What you describe, floaters and flashes arriving in one eye with no curtain and no pain, most likely means the jelly inside the eye is shrinking and pulling away from the back of the eye. It's called a posterior vitreous detachment, and it's very common at your age.",
      "start_timestamp": "05:12",
      "end_timestamp": "05:39",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If you notice a lot more floaters suddenly, a curtain or shadow, or your vision going blurry, come straight to the eye casualty that same day. Don't wait for an appointment.",
      "start_timestamp": "06:24",
      "end_timestamp": "06:42",
      "supports": [
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "A sticky note on the fridge might be kinder to your hand. And I'd like to see you again in two weeks to check how things are changing.",
      "start_timestamp": "06:53",
      "end_timestamp": "07:10",
      "supports": [
        "clinical_actions[1]",
        "follow_up[0]"
      ]
    }
  ],
