      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No blood, no.",
      "start_timestamp": "01:15",
      "end_timestamp": "01:17",
      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Which tablet is it, Gemma?",
      "start_timestamp": "01:20",
      "end_timestamp": "01:23",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Lisinopril, 10 mg, once a day. Started three weeks ago.",
      "start_timestamp": "01:27",
      "end_timestamp": "01:33",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you. Any allergies, Alan?",
