  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Morning, doctor. It's his cough, you see. Mr Whitfield, Alan, has had this dry cough for three weeks, ever since he started the new blood pressure tablet. I'm Gemma, his carer.",
      "start_timestamp": "00:02",
      "end_timestamp": "00:20",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you, Gemma. Alan, is it a dry cough?",
      "start_timestamp": "00:23",
      "end_timestamp": "00:29",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Dry as a bone. Tickly. Right at the back of my throat.",
      "start_timestamp": "00:33",
      "end_timestamp": "00:39",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "It's worse at night, and he's up half the night coughing. We've both been up.",
      "start_timestamp": "00:41",
      "end_timestamp": "00:49",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any fever?",
      "start_timestamp": "00:51",
      "end_timestamp": "00:53",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No fever.",
      "start_timestamp": "00:55",
      "end_timestamp": "00:57",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Short of breath?",
      "start_timestamp": "00:59",
      "end_timestamp": "01:01",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, I'm not breathless. Just coughing.",
      "start_timestamp": "01:03",
      "end_timestamp": "01:07",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Coughing up blood?",
      "start_timestamp": "01:10",
