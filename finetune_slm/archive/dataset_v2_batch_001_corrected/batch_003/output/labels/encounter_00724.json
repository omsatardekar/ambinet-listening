  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Good morning. I'm Pauline, Mia's foster carer. We're here for her twelve-month jabs, and I've got her red book.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:10",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "She's had a snuffly nose since Monday, but she's feeding well and playing.",
      "start_timestamp": "00:34",
      "end_timestamp": "00:42",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any fever or temperature?",
      "start_timestamp": "00:44",
