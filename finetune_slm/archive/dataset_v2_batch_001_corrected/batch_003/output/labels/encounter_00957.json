  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "nurse",
      "transcript_text": "Morning, Dr Pritchard. I've done Mr Ashworth's obs: blood pressure 128 over 82, pulse 74, weight 92 kilos. He's a bit worried about his liver test.",
      "start_timestamp": "00:02",
      "end_timestamp": "00:17",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you, nurse. Come in, Mr Ashworth. I understand there's an abnormal liver test from your insurance check?",
      "start_timestamp": "00:20",
      "end_timestamp": "00:29",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I get tired, but I'm fifty-eight, and I work too much.",
      "start_timestamp": "00:56",
      "end_timestamp": "01:03",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any pain, anywhere in the tummy?",
      "start_timestamp": "01:06",
      "end_timestamp": "01:09",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A dull ache on the right side, under the ribs, mostly after a fatty meal. I had a fish and chip supper last week and it was there all night.",
      "start_timestamp": "01:11",
      "end_timestamp": "01:29",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any bloating?",
      "start_timestamp": "01:31",
      "end_timestamp": "01:33",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, a bit, after big meals.",
      "start_timestamp": "01:37",
      "end_timestamp": "01:40",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any yellowing of the skin or eyes?",
      "start_timestamp": "01:43",
      "end_timestamp": "01:47",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No. My wife would've said.",
      "start_timestamp": "01:50",
      "end_timestamp": "01:53",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What medicines do you take?",
      "start_timestamp": "01:57",
      "end_timestamp": "02:00",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "One tablet for cholesterol. A little blue one. I couldn't tell you the name, I'm sorry. My wife usually knows.",
      "start_timestamp": "02:03",
      "end_timestamp": "02:13",
      "supports": [
        "medications[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "We'll find it on your record. How's your general health?",
      "start_timestamp": "02:16",
      "end_timestamp": "02:21",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "High cholesterol, as I said, and I'm overweight, I know.",
      "start_timestamp": "02:24",
      "end_timestamp": "02:30",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "There's no tenderness over the liver, and I can't feel it enlarged.",
      "start_timestamp": "02:56",
      "end_timestamp": "03:03",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any problem with your bowels, anything different?",
      "start_timestamp": "03:11",
      "end_timestamp": "03:15",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, nothing, they're normal.",
      "start_timestamp": "03:18",
      "end_timestamp": "03:20",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Here's what I think. Mild liver test abnormalities with high cholesterol and extra weight is most often a fatty liver. That's my provisional thinking.",
      "start_timestamp": "03:23",
      "end_timestamp": "03:35",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. The main treatment is gradual weight loss, about five to ten percent of your weight, and cutting down on fatty and sugary foods.",
      "start_timestamp": "04:00",
      "end_timestamp": "04:13",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Roughly. Slowly, over the next six months. Walk for half an hour every day.",
      "start_timestamp": "04:21",
      "end_timestamp": "04:29",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to see you again in six weeks.",
      "start_timestamp": "04:54",
      "end_timestamp": "04:59",
