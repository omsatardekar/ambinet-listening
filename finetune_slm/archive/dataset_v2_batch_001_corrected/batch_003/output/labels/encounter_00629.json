  "clinical_uncertainties": [],
  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_4",
      "speaker_role": "caregiver",
      "transcript_text": "I'm Tunde, I'm his carer, I'm with him four days a week. He gets tight in the chest on the stairs and he hates making a fuss.",
      "start_timestamp": "00:22",
      "end_timestamp": "00:38",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good, thank you both. Mr Okafor, tell me about this tightness, when does it happen?",
      "start_timestamp": "00:48",
      "end_timestamp": "00:56",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "When I go up the stairs, to the bedroom. It's a squeezing, sort of, in the middle of the chest. It goes if I stop and rest a minute.",
      "start_timestamp": "00:57",
      "end_timestamp": "01:12",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How many steps before it comes?",
      "start_timestamp": "01:15",
      "end_timestamp": "01:19",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_4",
      "speaker_role": "caregiver",
      "transcript_text": "About half a flight. Then he stops on the landing and holds the banister. I've seen it.",
      "start_timestamp": "01:20",
      "end_timestamp": "01:29",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Does it spread to your arm or your jaw?",
      "start_timestamp": "01:30",
      "end_timestamp": "01:35",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, no, not to the arm. Not the jaw either.",
      "start_timestamp": "01:36",
      "end_timestamp": "01:42",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you get breathless or sweaty with it, or any fainting?",
      "start_timestamp": "01:43",
      "end_timestamp": "01:50",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No. It's just the squeezing. I don't faint or anything.",
      "start_timestamp": "01:52",
      "end_timestamp": "01:57",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you had anything like this before? What's your heart history?",
      "start_timestamp": "01:59",
      "end_timestamp": "02:05",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I was told I had angina, back in 2020. They gave me a spray and some tablets.",
      "start_timestamp": "02:07",
      "end_timestamp": "02:16",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let's go through the tablets, then.",
      "start_timestamp": "02:18",
      "end_timestamp": "02:23",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "The spray is, um, GTN, 400 micrograms, under the tongue when I get the pain. And atorvastatin, 40 mg once a day.",
      "start_timestamp": "02:25",
      "end_timestamp": "02:35",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_4",
      "speaker_role": "caregiver",
      "transcript_text": "And his aspirin, 75 mg, once a day, with breakfast. I give him that one.",
      "start_timestamp": "02:37",
      "end_timestamp": "02:45",
      "supports": [
        "medications[2]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And how often are you needing the spray lately?",
      "start_timestamp": "02:47",
      "end_timestamp": "02:52",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_4",
      "speaker_role": "caregiver",
      "transcript_text": "Three times this week. It used to be once a month.",
      "start_timestamp": "02:54",
      "end_timestamp": "03:00",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's a change, thank you for telling me. Anyone in the family with heart trouble?",
      "start_timestamp": "03:01",
      "end_timestamp": "03:08",
      "supports": [
        "medical_history.family_history[0]",
        "clinical_actions[2]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My father, he had a heart attack at fifty-eight.",
      "start_timestamp": "03:10",
      "end_timestamp": "03:15",
      "supports": [
        "medical_history.family_history[0]",
        "clinical_actions[2]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_3",
      "speaker_role": "nurse",
      "transcript_text": "Blood pressure 138 over 84, pulse 76, and oxygen 97 percent.",
      "start_timestamp": "03:52",
      "end_timestamp": "03:58",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you, Claire. Mr Okafor, the spray use going up is what makes me want to look more closely at your heart. I'd like to arrange an exercise ECG at the hospital, where we record your heart while you walk on a treadmill.",
      "start_timestamp": "04:11",
      "end_timestamp": "04:35",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If it's still there five minutes after the second spray, or it's worse, call 999. Don't wait, and don't walk to the phone.",
      "start_timestamp": "05:13",
      "end_timestamp": "05:24",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. And I'd like to see you again in two weeks, before the test, to check how it's going.",
      "start_timestamp": "05:32",
      "end_timestamp": "05:41",
      "supports": [
        "medical_history.family_history[0]",
        "clinical_actions[2]",
        "follow_up[0]"
      ]
    }
