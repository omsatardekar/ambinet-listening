  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It's the shoulder pain again, doctor. Eased off for a couple of weeks, then crept back.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:08",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Aching, deep inside. Worse at night, lying on it.",
      "start_timestamp": "00:22",
      "end_timestamp": "00:28",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That sounds miserable, your sleep must be suffering. Where exactly would you point to?",
      "start_timestamp": "00:30",
      "end_timestamp": "00:38",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Here. Top of the arm, at the front, a bit round the back.",
      "start_timestamp": "00:39",
      "end_timestamp": "00:47",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Stiffness too. In the mornings. Takes an hour to loosen.",
      "start_timestamp": "01:01",
      "end_timestamp": "01:07",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "An hour, I see. And how would you rate the stiffness, mild, moderate, or worse than that?",
      "start_timestamp": "01:10",
      "end_timestamp": "01:18",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Moderate. Getting dressed is the worst bit.",
      "start_timestamp": "01:20",
      "end_timestamp": "01:24",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Right. And what are you taking for it at the moment?",
      "start_timestamp": "01:45",
      "end_timestamp": "01:51",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Paracetamol. When it's bad.",
      "start_timestamp": "01:52",
      "end_timestamp": "01:55",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Fair enough. Any allergies to medicines I should know about, before we talk about anything else?",
      "start_timestamp": "02:09",
      "end_timestamp": "02:19",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "None.",
      "start_timestamp": "02:21",
      "end_timestamp": "02:22",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. And the rest of you, any trouble with your breathing at the moment?",
      "start_timestamp": "02:24",
      "end_timestamp": "02:32",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Fine.",
      "start_timestamp": "02:33",
      "end_timestamp": "02:35",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your shoulder movement is limited, it stops about halfway and the joint feels tight when I move it for you.",
      "start_timestamp": "03:12",
      "end_timestamp": "03:23",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Not bad as such, but I can't rule out a frozen shoulder at this stage. Picture the joint capsule like a jumper that shrank in the wash.",
      "start_timestamp": "03:30",
      "end_timestamp": "03:44",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Meanwhile, keep it moving. Gentle pendulum swings with the arm hanging down, a few minutes each day, and sleep on your other side hugging a pillow.",
      "start_timestamp": "04:06",
      "end_timestamp": "04:20",
      "supports": [
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to see you again in six weeks, to check how much it has loosened.",
      "start_timestamp": "04:27",
      "end_timestamp": "04:34",
      "supports": [
        "clinical_actions[1]",
        "follow_up[0]"
      ]
    }
