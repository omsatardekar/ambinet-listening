  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "When I climb the stairs to my daughter's flat, third floor only, I get a tightness here in the middle. Then I stop, wait, and it goes.",
      "start_timestamp": "00:33",
      "end_timestamp": "00:46",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "For about one month only. Before that I was climbing like a goat. My grandson says I am slowing down.",
      "start_timestamp": "01:01",
      "end_timestamp": "01:11",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you been short of breath with it?",
      "start_timestamp": "01:43",
      "end_timestamp": "01:48",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, no. Breath is fine. Only the tightness, and my heart doesn't flutter or anything like that.",
      "start_timestamp": "01:51",
      "end_timestamp": "02:01",
      "supports": [
        "negative_findings[0]",
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes. Years ago, I took some antibiotic for my throat and I reacted to it. My wife was there, she remembers more than me.",
      "start_timestamp": "02:40",
      "end_timestamp": "02:54",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "That is the problem, I cannot recall. I only remember the doctor said, never take that antibiotic again. Hospital people made a note.",
      "start_timestamp": "03:04",
      "end_timestamp": "03:15",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Please bring whatever you find. Also, if the old GP's surgery still exists, we can ask them for the note.",
      "start_timestamp": "04:42",
      "end_timestamp": "04:53",
      "supports": [
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Then the papers at home are our best chance. What did you do for work, Venkat?",
      "start_timestamp": "05:05",
      "end_timestamp": "05:13",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I am a retired bank manager. Thirty-five years in the State Bank. Many files, I know the value of a record.",
      "start_timestamp": "05:14",
      "end_timestamp": "05:27",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let's say in four weeks. That gives you time to search the almirah and ask around.",
      "start_timestamp": "06:24",
      "end_timestamp": "06:33",
      "supports": [
        "clinical_actions[1]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Take the lift if there is one, and rest when the tightness comes. If it lasts longer than ten minutes, call an ambulance.",
      "start_timestamp": "07:00",
      "end_timestamp": "07:12",
      "supports": [
        "clinical_actions[2]"
      ]
    }
