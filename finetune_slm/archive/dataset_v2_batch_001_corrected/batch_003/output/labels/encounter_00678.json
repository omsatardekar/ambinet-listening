      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Try not to scratch, keep cool, and wear gloves when you cut the fruit.",
      "start_timestamp": "04:40",
      "end_timestamp": "04:46",
      "supports": [
        "clinical_actions[3]"
      ]
    },
