      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thanks. There are raised red wheals on his forearms and upper back, some joining up, and no swelling of the lips or tongue.",
      "start_timestamp": "03:03",
      "end_timestamp": "03:16",
      "supports": [
        "physical_examination[1]",
        "physical_examination[2]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What you describe, itchy raised weals that come and go, is typical of urticaria, hives.",
      "start_timestamp": "03:22",
      "end_timestamp": "03:29",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'm going to start you on cetirizine, 10 mg once a day, taken at night. It blocks the itch.",
      "start_timestamp": "03:38",
      "end_timestamp": "03:48",
      "supports": [
        "medications[0]",
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd also like to arrange a blood test, to look for anything underlying, like thyroid or infection.",
      "start_timestamp": "04:09",
