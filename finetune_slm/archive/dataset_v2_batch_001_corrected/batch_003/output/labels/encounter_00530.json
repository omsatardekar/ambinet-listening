      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I have them here. Metformin, 500 mg twice a day. Lisinopril, 10 mg once a day. And atorvastatin, 20 mg at bedtime.",
