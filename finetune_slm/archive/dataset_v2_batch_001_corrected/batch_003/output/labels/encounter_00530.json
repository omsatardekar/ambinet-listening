  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Good morning. I made a list so I wouldn't forget anything. Short version, I can't read my newspaper anymore, and it's driving me up the wall.",
