      "end_timestamp": "00:58",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, straight lines look wavy. The tiles in the bathroom, the door frame. Marisol noticed me running my hand along the wall.",
      "start_timestamp": "01:09",
      "end_timestamp": "01:20",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Headlights at night are blinding. The glare is much worse than before. And I tripped on the curb twice, last Tuesday and Friday.",
      "start_timestamp": "01:58",
      "end_timestamp": "02:11",
      "supports": [
        "symptoms[2]",
        "symptoms[3]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Twice in one week is important. Did you hurt yourself?",
      "start_timestamp": "02:12",
      "end_timestamp": "02:18",
      "supports": [
        "symptoms[3]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Okay. Any flashing lights or floaters, anything like curtains coming across?",
