  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I can't concentrate on anything lately. I think I might have ADHD, because I've always been a bit like this.",
      "start_timestamp": "00:02",
      "end_timestamp": "00:13",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thanks for telling me. Let's talk it through. What happens when you try to concentrate?",
      "start_timestamp": "00:16",
      "end_timestamp": "00:23",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My mind just wanders off. I start something and then I forget what I was doing.",
      "start_timestamp": "00:27",
      "end_timestamp": "00:35",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long has this been a problem?",
      "start_timestamp": "00:38",
      "end_timestamp": "00:42",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Since school, really. But it's worse now that I'm working from home.",
      "start_timestamp": "00:45",
      "end_timestamp": "00:52",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How are you sleeping?",
      "start_timestamp": "01:10",
      "end_timestamp": "01:13",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Badly. I lie awake until two or three in the morning.",
      "start_timestamp": "01:16",
      "end_timestamp": "01:23",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any low mood or worry that could be contributing?",
      "start_timestamp": "01:26",
      "end_timestamp": "01:32",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, I'm not low. I'm not particularly anxious either.",
      "start_timestamp": "01:36",
      "end_timestamp": "01:41",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Are you taking any medicines at the moment?",
      "start_timestamp": "01:43",
      "end_timestamp": "01:48",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Just a multivitamin. And occasionally a sleeping tablet, I think it's zolpidem, 5 mg, but I'm not sure of the dose.",
      "start_timestamp": "01:51",
      "end_timestamp": "02:02",
      "supports": [
        "medications[0]",
        "medications[1]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How often do you take the sleeping tablet?",
      "start_timestamp": "02:05",
      "end_timestamp": "02:09",
      "supports": [
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Maybe once a week.",
      "start_timestamp": "02:13",
      "end_timestamp": "02:16",
      "supports": [
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you. Do you have any allergies to medicines?",
      "start_timestamp": "02:19",
      "end_timestamp": "02:25",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "When I was a child I reacted badly to penicillin and I've avoided it since.",
      "start_timestamp": "02:28",
      "end_timestamp": "02:36",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Noted. Do you drink coffee or alcohol?",
      "start_timestamp": "02:40",
      "end_timestamp": "02:44",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Coffee, yes. Six or seven cups a day.",
      "start_timestamp": "02:47",
      "end_timestamp": "02:52",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 78, blood pressure 122 over 76, temperature 36.7, oxygen 99 percent, breathing 14.",
      "start_timestamp": "03:18",
      "end_timestamp": "03:25",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Normal. Let me ask a few more things about school. Did your teachers ever comment on your attention?",
      "start_timestamp": "03:33",
      "end_timestamp": "03:44",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes. My reports always said I was easily distracted and daydreaming.",
      "start_timestamp": "03:46",
      "end_timestamp": "03:53",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That history matters, because ADHD has to start in childhood.",
      "start_timestamp": "03:56",
      "end_timestamp": "04:01",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It's possible, but poor sleep and six or seven coffees can look very much the same. I can't tell yet.",
      "start_timestamp": "04:11",
      "end_timestamp": "04:24",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Cut the coffee to two cups, and aim for a regular sleep time. We'll see how much changes.",
      "start_timestamp": "04:34",
      "end_timestamp": "04:43",
      "supports": [
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_024",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If it doesn't help, I'd refer you for a specialist assessment, rather than start any medicine today.",
      "start_timestamp": "04:51",
      "end_timestamp": "04:59",
      "supports": [
        "clinical_actions[1]"
      ]
    }
