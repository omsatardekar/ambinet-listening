    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Not odd, no. Overnight, your liver puts out sugar. What are you taking for the diabetes at the moment?",
      "start_timestamp": "00:45",
      "end_timestamp": "00:55",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Metformin, 500 mg, twice a day, with meals, for my diabetes. And that's it.",
