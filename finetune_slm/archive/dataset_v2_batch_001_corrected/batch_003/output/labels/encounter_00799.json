      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. Looking at the pattern, the morning readings are high, and the daytime ones are mostly fine. Your diabetes isn't as well controlled as I'd like at the moment.",
      "start_timestamp": "01:56",
      "end_timestamp": "02:10",
      "supports": [
