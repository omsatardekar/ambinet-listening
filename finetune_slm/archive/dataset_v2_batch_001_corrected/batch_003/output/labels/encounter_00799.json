      "speaker_role": "doctor",
      "transcript_text": "I'd suggest dropping the cereal, and having a small protein snack if you're hungry, like a boiled egg or some nuts.",
      "start_timestamp": "02:59",
      "end_timestamp": "03:10",
      "supports": [
        "clinical_actions[2]"
