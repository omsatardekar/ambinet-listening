  "clinical_uncertainties": [],
  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My heart. It races. Palpitations, the pharmacist called it. It happens after I've had too much coffee.",
      "start_timestamp": "00:32",
      "end_timestamp": "00:41",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Tell me about it. What does it feel like?",
      "start_timestamp": "00:43",
      "end_timestamp": "00:49",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Like a little bird in my chest, thumping and fluttering. It goes on for a few minutes, then it settles.",
      "start_timestamp": "00:50",
      "end_timestamp": "01:00",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's a lot of caffeine. Do you feel anything else when it happens?",
      "start_timestamp": "01:26",
      "end_timestamp": "01:34",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My hands go jittery. I can't hold a pen.",
      "start_timestamp": "01:35",
      "end_timestamp": "01:41",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you had any chest pain?",
      "start_timestamp": "01:44",
      "end_timestamp": "01:47",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No chest pain. Never.",
      "start_timestamp": "01:48",
      "end_timestamp": "01:51",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Most likely, yes. The pattern fits, it comes after the coffee, settles in minutes, and you feel shaky as well. I think caffeine is the most likely trigger.",
      "start_timestamp": "02:57",
      "end_timestamp": "03:12",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Not completely. Cut it to two cups a day, and drop the energy drinks. Do it gradually over a week, so you don't get a headache.",
      "start_timestamp": "03:22",
      "end_timestamp": "03:37",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd also like to give you propranolol, 10 mg, to take when it happens, up to twice a day.",
      "start_timestamp": "03:46",
      "end_timestamp": "03:55",
      "supports": [
        "medications[0]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. Keep a note of when the episodes happen and what you've had.",
      "start_timestamp": "04:19",
      "end_timestamp": "04:28",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If they carry on after two weeks of cutting down the coffee, come back and see me.",
      "start_timestamp": "04:36",
      "end_timestamp": "04:44",
      "supports": [
        "clinical_actions[0]",
        "follow_up[0]"
      ]
    }
