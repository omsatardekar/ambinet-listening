  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "That I won't go to school. But it's not that I won't, I can't.",
      "start_timestamp": "00:20",
      "end_timestamp": "00:28",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Tell me what happens when you try.",
      "start_timestamp": "00:31",
      "end_timestamp": "00:35",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My heart goes crazy, my stomach drops, and I feel sick. Sometimes I can't breathe properly, and I sit on the stairs and cry.",
      "start_timestamp": "00:36",
      "end_timestamp": "00:47",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long has this been going on?",
      "start_timestamp": "01:05",
      "end_timestamp": "01:09",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Since September. I've missed about six weeks.",
      "start_timestamp": "01:11",
      "end_timestamp": "01:16",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you ever have thoughts of harming yourself, or not wanting to be here?",
      "start_timestamp": "01:32",
      "end_timestamp": "01:39",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No. No, nothing like that. I'm just scared.",
      "start_timestamp": "01:40",
      "end_timestamp": "01:45",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you for telling me. Do you take any medicines at the moment?",
      "start_timestamp": "01:47",
      "end_timestamp": "01:54",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Propranolol, 10 mg, when I'm really bad. My doctor in Delhi gave me them, and I only take them when I need to.",
      "start_timestamp": "01:56",
      "end_timestamp": "02:10",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any allergies to medicines, to anything?",
      "start_timestamp": "02:11",
      "end_timestamp": "02:14",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, nothing.",
      "start_timestamp": "02:16",
      "end_timestamp": "02:17",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is there anyone in the family who has anxiety?",
      "start_timestamp": "02:19",
      "end_timestamp": "02:24",
      "supports": [
        "medical_history.family_history[0]",
        "clinical_actions[2]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My mum does. She has panic attacks. She says it runs in the family.",
      "start_timestamp": "02:26",
      "end_timestamp": "02:34",
      "supports": [
        "medical_history.family_history[0]",
        "clinical_actions[2]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Who do you live with, and what year are you in?",
      "start_timestamp": "02:36",
      "end_timestamp": "02:41",
      "supports": [
        "medical_history.social_history[0]",
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Mum, dad and my little sister. I'm in Year 10.",
      "start_timestamp": "02:43",
      "end_timestamp": "02:48",
      "supports": [
        "medical_history.social_history[0]",
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And what do you do in your free time?",
      "start_timestamp": "02:50",
      "end_timestamp": "02:55",
      "supports": [
        "medical_history.social_history[2]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Games, mostly. Four, five hours a day. I don't go out much.",
      "start_timestamp": "02:57",
      "end_timestamp": "03:03",
      "supports": [
        "medical_history.social_history[2]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Okay. Did you fill in the questionnaire the receptionist gave you, about how you've been feeling?",
      "start_timestamp": "03:05",
      "end_timestamp": "03:14",
      "supports": [
        "procedures_and_investigations[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yeah, I already did it in the waiting room.",
      "start_timestamp": "03:16",
      "end_timestamp": "03:21",
      "supports": [
        "procedures_and_investigations[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Not all at once. We'd start small, with an agreed plan with your school, one lesson, a quiet room, a person you can go to.",
      "start_timestamp": "03:58",
      "end_timestamp": "04:10",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd also like to arrange a blood test, to rule out any physical cause for the racing heart, like your thyroid.",
      "start_timestamp": "04:17",
      "end_timestamp": "04:28",
      "supports": [
        "procedures_and_investigations[1]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And I'd like to refer you to the young people's mental health service for talking therapy, which works really well for this.",
      "start_timestamp": "04:45",
      "end_timestamp": "04:57",
      "supports": [
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to see you again in two weeks, to see how you're getting on, and you can bring your mum if you want to.",
      "start_timestamp": "05:18",
      "end_timestamp": "05:31",
      "supports": [
        "medical_history.family_history[0]",
