  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Right. I get terrible cramps in my calves at night, mostly the left, waking me up around two in the morning. They've been going on for six weeks.",
      "start_timestamp": "00:27",
      "end_timestamp": "00:42",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Let me see. Three or four nights a week. Last week it was four, Monday, Tuesday, Thursday and Saturday.",
      "start_timestamp": "00:48",
      "end_timestamp": "00:57",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Severe. I have to get out of bed and stand on the cold floor. I'd put it at eight out of ten, and there's a sore ache left behind the next day.",
      "start_timestamp": "01:04",
      "end_timestamp": "01:18",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "They're worse after a day of gardening. Stretching the calf against the wall is the only thing that eases it.",
      "start_timestamp": "01:26",
      "end_timestamp": "01:35",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My ankles swell by the evening. And I'm tired, a heavy sort of tired, which is new since the autumn.",
      "start_timestamp": "01:42",
      "end_timestamp": "01:50",
      "supports": [
        "symptoms[1]",
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Swollen ankles and tiredness, noted. Now, a few safety questions. Any chest pain, or shortness of breath on the stairs?",
      "start_timestamp": "01:53",
      "end_timestamp": "02:02",
      "supports": [
        "negative_findings[0]",
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No chest pain. No shortness of breath either, I did the stairs at the library yesterday without any trouble.",
      "start_timestamp": "02:04",
      "end_timestamp": "02:12",
      "supports": [
        "negative_findings[0]",
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. Any numbness in the legs, or weakness, like your leg giving way?",
      "start_timestamp": "02:13",
      "end_timestamp": "02:19",
      "supports": [
        "negative_findings[2]",
        "negative_findings[3]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No numbness, and no weakness. Just the cramps.",
      "start_timestamp": "02:21",
      "end_timestamp": "02:25",
      "supports": [
        "negative_findings[2]",
        "negative_findings[3]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "The amlodipine, 5 mg once a day in the morning, for the blood pressure. And the water tablet, furosemide, 40 mg, once a day as well.",
      "start_timestamp": "02:33",
      "end_timestamp": "02:46",
      "supports": [
        "medical_history.past_medical_history[0]",
