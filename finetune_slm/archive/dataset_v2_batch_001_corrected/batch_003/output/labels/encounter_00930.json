  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hello. I've been very tired since the doctor put me on a new heart tablet, and I get out of breath. My daughter thinks I should say something.",
