      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No chest pain. No fainting.",
      "start_timestamp": "01:37",
      "end_timestamp": "01:41",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any wheeze, or swelling in the ankles?",
      "start_timestamp": "01:44",
