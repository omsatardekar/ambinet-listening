      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "No swelling. She does cough a little at night.",
      "start_timestamp": "01:52",
      "end_timestamp": "01:57",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Does anyone smoke at home, or have you smoked?",
