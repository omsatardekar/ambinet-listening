      "end_timestamp": "02:06",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I stopped when I had the heart attack.",
      "start_timestamp": "02:10",
      "end_timestamp": "02:14",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good for you. Do you have any allergies to medicines?",
      "start_timestamp": "02:18",
      "end_timestamp": "02:24",
      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, none.",
      "start_timestamp": "02:28",
      "end_timestamp": "02:30",
      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your heart rate is slow, around fifty, and regular. Your lungs are clear, and your ankles are not swollen.",
      "start_timestamp": "03:04",
      "end_timestamp": "03:15",
      "supports": [
        "physical_examination[0]",
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "A bit slow, which can make people feel tired. It may be the beta-blocker, and her heart condition may also play a part.",
      "start_timestamp": "03:26",
      "end_timestamp": "03:40",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'll arrange a heart tracing today, and a blood test for anaemia and thyroid.",
      "start_timestamp": "04:11",
      "end_timestamp": "04:19",
      "supports": [
        "procedures_and_investigations[0]",
        "procedures_and_investigations[1]",
        "clinical_actions[0]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Depending on the results, I might lower the dose, or discuss it with her cardiologist.",
      "start_timestamp": "04:28",
      "end_timestamp": "04:36",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'll phone you with the results. If you become faint, get chest pain, or are very breathless, call an ambulance.",
