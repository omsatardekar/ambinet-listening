        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "I'm her daughter. She's been much slower since the tablet. She naps all afternoon now.",
      "start_timestamp": "00:21",
      "end_timestamp": "00:30",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A beta-blocker, I think. It's called bisoprolol.",
      "start_timestamp": "00:44",
      "end_timestamp": "00:49",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Two months ago, after the heart attack.",
      "start_timestamp": "01:02",
      "end_timestamp": "01:06",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'm sorry to hear that. When does the breathlessness happen?",
      "start_timestamp": "01:10",
      "end_timestamp": "01:16",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Climbing stairs, and when I walk to the shops. I used to manage it fine.",
      "start_timestamp": "01:20",
      "end_timestamp": "01:27",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any chest pain, palpitations, or fainting?",
      "start_timestamp": "01:31",
      "end_timestamp": "01:35",
