      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I live alone. Sheila here pops in every day.",
      "start_timestamp": "02:32",
      "end_timestamp": "02:36",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "With the heart failure history, and the ankle swelling, I'd say this is likely her heart failure getting worse, with fluid building up.",
      "start_timestamp": "03:24",
      "end_timestamp": "03:34",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It's treatable. I'd like to arrange blood tests and a heart scan, an echocardiogram, to see how the heart is pumping.",
      "start_timestamp": "03:43",
      "end_timestamp": "03:55",
      "supports": [
        "procedures_and_investigations[0]",
        "procedures_and_investigations[1]",
