        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Her heart, she has heart failure, and high blood pressure.",
