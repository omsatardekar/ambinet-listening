      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Not today, if you can both watch her closely. The blood tests today, and the scan in the next two weeks.",
      "start_timestamp": "04:07",
      "end_timestamp": "04:18",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Please weigh her each morning, and ring me if her weight rises by two kilos in three days, or she's breathless at rest.",
      "start_timestamp": "04:26",
      "end_timestamp": "04:40",
      "supports": [
        "clinical_actions[3]"
