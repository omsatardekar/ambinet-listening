        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Oh, a while ago. A month? Two? I don't keep track.",
      "start_timestamp": "00:55",
      "end_timestamp": "01:02",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "I'd say it's been six weeks, since the cold, but I'm not certain either, Mum was already slow before it.",
      "start_timestamp": "01:04",
      "end_timestamp": "01:16",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'll note that neither of you is sure. Any chest pain?",
