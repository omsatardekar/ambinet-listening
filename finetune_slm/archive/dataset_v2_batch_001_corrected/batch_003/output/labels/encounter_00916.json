  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Hello doctor! I'm Mrs Okafor's friend, I drive her to appointments. She says she's got something stuck in her throat, and it's been bothering her for weeks.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:14",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you for bringing her. Mrs Okafor, can you describe it for me?",
      "start_timestamp": "00:17",
      "end_timestamp": "00:24",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It feels like a lump, right in the middle, here. Even when I haven't eaten.",
      "start_timestamp": "00:26",
      "end_timestamp": "00:34",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "When did you first notice it?",
      "start_timestamp": "00:36",
      "end_timestamp": "00:40",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "About six weeks ago.",
      "start_timestamp": "00:43",
      "end_timestamp": "00:45",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "She told me at book club, and that was in the spring.",
      "start_timestamp": "00:48",
      "end_timestamp": "00:54",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any weight loss, hoarseness, or coughing up blood?",
      "start_timestamp": "01:14",
      "end_timestamp": "01:18",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No weight loss. My voice is the same. No blood.",
      "start_timestamp": "01:20",
      "end_timestamp": "01:27",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you have any heartburn or a sour taste?",
      "start_timestamp": "01:29",
      "end_timestamp": "01:34",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Sometimes, yes. A burning after dinner.",
      "start_timestamp": "01:35",
      "end_timestamp": "01:38",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What medicines are you taking?",
      "start_timestamp": "01:40",
      "end_timestamp": "01:43",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Amlodipine, 5 mg, once a day. And a thyroid tablet, levothyroxine, 100 micrograms.",
      "start_timestamp": "01:45",
      "end_timestamp": "01:53",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any other conditions?",
      "start_timestamp": "01:55",
      "end_timestamp": "01:58",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "High blood pressure, underactive thyroid, and I'm a bit anxious, I admit.",
      "start_timestamp": "02:00",
      "end_timestamp": "02:07",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's understandable. Do you smoke or drink alcohol?",
      "start_timestamp": "02:16",
      "end_timestamp": "02:21",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No smoking. A glass of wine now and then.",
      "start_timestamp": "02:24",
      "end_timestamp": "02:29",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 74, blood pressure 130 over 80, temperature 36.6, oxygen 99 percent, breathing 14.",
      "start_timestamp": "02:55",
      "end_timestamp": "03:04",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Nothing I can see. What you describe is a feeling called globus, which is common and usually harmless, and acid reflux can be involved.",
      "start_timestamp": "03:57",
      "end_timestamp": "04:08",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It is a relief, mostly. I'd like to arrange a blood test for your thyroid and a check of your iron levels, just to be thorough.",
      "start_timestamp": "04:17",
      "end_timestamp": "04:31",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Try smaller meals, avoid late dinners, and cut down on strong coffee and spicy food.",
      "start_timestamp": "04:38",
      "end_timestamp": "04:45",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_021",
