      "speaker_role": "doctor",
      "transcript_text": "Sit forward, please, and keep pinching the soft part of your nose. I'm Dr Reilly. Which side is bleeding?",
      "start_timestamp": "00:12",
      "end_timestamp": "00:22",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
