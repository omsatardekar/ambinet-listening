    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "There's an active bleed from the front of the septum on the right side, a visible vessel, and a lot of clot in the nostril.",
      "start_timestamp": "03:18",
      "end_timestamp": "03:31",
      "supports": [
        "physical_examination[0]",
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's slowed it a lot. I'd say this is a bleed from a vessel at the front of the nose, made worse by high blood pressure and the aspirin.",
      "start_timestamp": "04:22",
      "end_timestamp": "04:38",
      "supports": [
