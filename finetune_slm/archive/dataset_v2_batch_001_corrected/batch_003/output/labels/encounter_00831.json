    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It might, so I'm going to cauterise the vessel with silver nitrate, a small sting, and then I'll put a small dressing in.",
      "start_timestamp": "04:45",
      "end_timestamp": "04:57",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Done. Keep your head forward, don't blow your nose for a few days, and avoid hot drinks and alcohol for 24 hours.",
      "start_timestamp": "05:30",
      "end_timestamp": "05:42",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Don't take any more aspirin until I've checked with your heart doctor, and I'll see you in the morning to check the nose and your blood pressure.",
