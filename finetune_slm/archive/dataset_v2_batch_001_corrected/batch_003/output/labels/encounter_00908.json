  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Morning. I want to stop smoking, and I need help, because I can't do it on my own.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:10",
      "supports": [
        "chief_complaint",
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's a great decision, and I'm glad you came. How much do you smoke at the moment?",
      "start_timestamp": "00:13",
      "end_timestamp": "00:23",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "About twenty a day. Sometimes more when I'm stressed.",
      "start_timestamp": "00:25",
      "end_timestamp": "00:31",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long have you been smoking?",
      "start_timestamp": "00:32",
      "end_timestamp": "00:35",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Since I was seventeen. So, twenty-two years.",
      "start_timestamp": "00:36",
      "end_timestamp": "00:41",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you cough in the mornings, or get breathless on the stairs?",
      "start_timestamp": "01:13",
      "end_timestamp": "01:20",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A bit breathless on the stairs, yes. And a smoker's cough in the morning.",
      "start_timestamp": "01:22",
      "end_timestamp": "01:30",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any chest pain, or coughing up blood?",
      "start_timestamp": "01:32",
      "end_timestamp": "01:36",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, nothing like that.",
      "start_timestamp": "01:38",
      "end_timestamp": "01:40",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Are you on any medication at the moment?",
      "start_timestamp": "01:43",
      "end_timestamp": "01:49",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Just an inhaler, the blue one, when I'm wheezy.",
      "start_timestamp": "01:50",
      "end_timestamp": "01:55",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 80, blood pressure 130 over 84, oxygen saturation 97 percent, temperature 36.6.",
      "start_timestamp": "02:18",
      "end_timestamp": "02:25",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "There is a mild wheeze at the bottom of both lungs, and the breath sounds are otherwise normal.",
      "start_timestamp": "03:05",
      "end_timestamp": "03:16",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It is likely to be contributing. Stopping will help it settle.",
      "start_timestamp": "03:23",
      "end_timestamp": "03:30",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'll prescribe varenicline, 0.5 mg once a day for three days, then it goes up.",
      "start_timestamp": "04:17",
      "end_timestamp": "04:25",
      "supports": [
        "medications[1]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pick a quit date in the second week, and take the tablets for the first week before that.",
      "start_timestamp": "04:33",
      "end_timestamp": "04:43",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's good. I'd also like to see you again in two weeks, to see how it is going.",
