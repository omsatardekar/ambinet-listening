  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I'm only here because the health visitor insisted. I've been a bit thirsty lately, that's all, it's nothing really.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:11",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Two weeks, give or take. I just put it down to being up in the night with the baby.",
      "start_timestamp": "00:21",
      "end_timestamp": "00:30",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Okay. Any blurred vision, with it? Print going fuzzy, that sort of thing?",
      "start_timestamp": "00:51",
      "end_timestamp": "00:59",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, my eyes are all right.",
      "start_timestamp": "01:00",
      "end_timestamp": "01:04",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, metformin. 500 mg, twice a day, with food.",
      "start_timestamp": "01:15",
      "end_timestamp": "01:19",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Twice a day, every day?",
      "start_timestamp": "01:22",
      "end_timestamp": "01:25",
      "supports": [
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Every day, yes.",
      "start_timestamp": "01:26",
      "end_timestamp": "01:28",
      "supports": [
        "medications[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Well... the evening one, sometimes. When the baby's fussing at bedtime, it slips my mind. Maybe two or three nights a week.",
      "start_timestamp": "01:41",
      "end_timestamp": "01:51",
      "supports": [
        "medications[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It matters a little, which is why I'm asking. Your records also show you had gestational diabetes in your pregnancy.",
      "start_timestamp": "02:07",
      "end_timestamp": "02:17",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, that's right. They told me it might go away after the birth.",
      "start_timestamp": "02:19",
      "end_timestamp": "02:26",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It often does, but it can come back, which is why we recheck. And you've an underactive thyroid too, for about five years?",
      "start_timestamp": "02:28",
      "end_timestamp": "02:40",
      "supports": [
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Five years, yes. That's all quiet, it never bothers me.",
      "start_timestamp": "02:43",
      "end_timestamp": "02:48",
      "supports": [
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Blood pressure is 124/78. And your weight is 84 kg.",
      "start_timestamp": "03:21",
      "end_timestamp": "03:27",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "There's no swelling around the ankles, and the skin on your feet looks healthy.",
      "start_timestamp": "04:16",
      "end_timestamp": "04:23",
      "supports": [
        "physical_examination[0]",
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "The second. I'd like to arrange an HbA1c blood test, which shows your average sugar over the last few months. The nurse can do it before you leave.",
      "start_timestamp": "04:50",
      "end_timestamp": "05:05",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes, carry on with it, and try to build in the evening dose. Put it next to the baby's bottles, so you trip over it.",
      "start_timestamp": "05:45",
      "end_timestamp": "05:59",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to see you again in three months, once the results are back and we've decided.",
      "start_timestamp": "06:07",
      "end_timestamp": "06:16",
      "supports": [
        "clinical_actions[1]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Then you're ahead of most. Keep drinking water for the thirst, rather than juice.",
      "start_timestamp": "06:47",
      "end_timestamp": "06:54",
      "supports": [
        "clinical_actions[2]"
      ]
    }
