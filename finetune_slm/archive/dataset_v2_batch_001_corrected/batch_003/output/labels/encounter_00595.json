    },
    {
      "evidence_id": "EV_025",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Three things. One, a blood test for your iron stores, which I'll arrange today. Two, cut the coffee after dinner, and try a warm bath and some calf stretching before bed. Three, there are medicines for this, but I would rather not start one until the bloods are back.",
      "start_timestamp": "06:33",
