      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, that is all quite normal, thank you.",
      "start_timestamp": "05:26",
      "end_timestamp": "05:31",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Reflexes are normal at the knees and ankles. Strength is normal in both legs, and there is no swelling around the ankles.",
