  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Thank you. It's my legs, I'm afraid. In the evenings they become quite impossible to keep still.",
      "start_timestamp": "00:23",
      "end_timestamp": "00:33",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A sort of crawling, creeping sensation deep inside, from the knee down to the ankle. Moving is the only relief. I have to get up and walk about the kitchen.",
      "start_timestamp": "00:39",
      "end_timestamp": "00:55",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "About four months, I should say, though it has been worse since the spring.",
      "start_timestamp": "01:02",
      "end_timestamp": "01:09",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Nearly every night. Most evenings from around nine o'clock.",
      "start_timestamp": "01:16",
      "end_timestamp": "01:20",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And what does it do to your sleep?",
      "start_timestamp": "01:23",
      "end_timestamp": "01:27",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Rather a lot, I'm afraid. I lie awake for an hour or two before I can drop off, and then I am exhausted in the daytime. I nodded off over my book only yesterday afternoon.",
      "start_timestamp": "01:29",
      "end_timestamp": "01:49",
      "supports": [
        "symptoms[1]",
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A strong cup of coffee after dinner, I think. I have a weakness for it. And sitting through the evening news.",
      "start_timestamp": "01:58",
      "end_timestamp": "02:10",
      "supports": [
        "symptoms[0]",
        "medical_history.social_history[2]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any numbness, weakness in the legs, or back pain?",
      "start_timestamp": "02:12",
      "end_timestamp": "02:17",
      "supports": [
        "negative_findings[0]",
        "negative_findings[1]",
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, none of those. Nothing of that sort at all.",
      "start_timestamp": "02:18",
      "end_timestamp": "02:24",
      "supports": [
        "negative_findings[0]",
        "negative_findings[1]",
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Well, I have high blood pressure, eight years now. And acid reflux. And arthritis in my knees, although that is more of a nuisance than anything. Oh, and migraines. I thought I had grown out of them, but I still get one once in a while.",
      "start_timestamp": "02:35",
      "end_timestamp": "02:58",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]",
        "medical_history.past_medical_history[3]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "The amlodipine, 5 milligrams every morning, for the blood pressure. And a small white tablet for the stomach acid, at night. I am so sorry, I can never remember what it is called.",
      "start_timestamp": "03:07",
      "end_timestamp": "03:25",
      "supports": [
        "medications[0]",
        "medications[1]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Don't worry, the pharmacy list will tell us. Do you have any allergies to medicines?",
      "start_timestamp": "03:26",
      "end_timestamp": "03:35",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, penicillin. I came out in a rash all over when I was given it, years ago.",
      "start_timestamp": "03:36",
      "end_timestamp": "03:45",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I had my gallbladder removed, about twelve years ago.",
      "start_timestamp": "03:51",
      "end_timestamp": "03:56",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My mother had restless legs, quite badly, in her seventies. And my brother has diabetes, though I don't suppose that is relevant.",
      "start_timestamp": "04:08",
      "end_timestamp": "04:21",
      "supports": [
        "medical_history.family_history[0]",
        "medical_history.family_history[1]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you smoke, and how much alcohol do you drink?",
      "start_timestamp": "04:23",
      "end_timestamp": "04:28",
      "supports": [
        "medical_history.social_history[0]",
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I have never smoked. I drink a glass of wine on Saturdays, no more than that.",
      "start_timestamp": "04:30",
      "end_timestamp": "04:39",
      "supports": [
        "medical_history.social_history[0]",
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_3",
      "speaker_role": "nurse",
      "transcript_text": "Of course. If you would roll up your sleeve for me. That's lovely. Blood pressure is 138/84 mmHg.",
      "start_timestamp": "04:51",
      "end_timestamp": "05:01",
      "supports": [
        "vital_signs[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_3",
      "speaker_role": "nurse",
      "transcript_text": "Pulse is 72 bpm. Temperature is 36.7 degrees Celsius, and oxygen saturation is 98 percent.",
      "start_timestamp": "05:03",
      "end_timestamp": "05:10",
      "supports": [
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_3",
      "speaker_role": "nurse",
      "transcript_text": "And you weigh 71 kilograms with your shoes off.",
      "start_timestamp": "05:12",
      "end_timestamp": "05:17",
      "supports": [
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you, nurse. Mrs Okonjo-Reyes, any trouble passing water?",
      "start_timestamp": "05:19",
      "end_timestamp": "05:24",
      "supports": [
