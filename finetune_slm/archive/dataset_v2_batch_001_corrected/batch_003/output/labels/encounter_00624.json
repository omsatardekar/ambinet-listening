  "clinical_uncertainties": [],
  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "She was tugging at her ear and screaming half the night, Tuesday and Wednesday. Then she gave her the pink stuff. Oh, what's it called.",
      "start_timestamp": "00:49",
      "end_timestamp": "01:03",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_4",
      "speaker_role": "caregiver",
      "transcript_text": "Amoxicillin, it's on the bottle. 250 mg, three times a day. We're on the last two days of it.",
      "start_timestamp": "01:05",
      "end_timestamp": "01:15",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "That's it. I give the morning and teatime ones, and Jade does lunch.",
      "start_timestamp": "01:17",
      "end_timestamp": "01:24",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Brilliant. And is the tugging still happening?",
      "start_timestamp": "01:25",
      "end_timestamp": "01:29",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "No, that's gone completely. She hasn't touched it since Friday, I think. It's gone now.",
      "start_timestamp": "01:30",
      "end_timestamp": "01:38",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. Any fever since you started it?",
      "start_timestamp": "01:39",
      "end_timestamp": "01:44",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "No fever, not since the first night.",
      "start_timestamp": "01:45",
      "end_timestamp": "01:48",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any fluid or gunk coming out of the ear?",
      "start_timestamp": "01:51",
      "end_timestamp": "01:56",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_4",
      "speaker_role": "caregiver",
      "transcript_text": "No, nothing. I check her pillow every nap, there's never anything on it.",
      "start_timestamp": "01:57",
      "end_timestamp": "02:04",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Lovely. Does she have anything for pain, or has she needed anything?",
      "start_timestamp": "02:06",
      "end_timestamp": "02:13",
      "supports": [
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_4",
      "speaker_role": "caregiver",
      "transcript_text": "Just ibuprofen, 5 ml at bedtime, if she's grizzly. She hasn't needed it for two days.",
      "start_timestamp": "02:15",
      "end_timestamp": "02:24",
      "supports": [
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. Is she allergic to anything? Any allergies to medicines or foods?",
      "start_timestamp": "02:25",
      "end_timestamp": "02:31",
      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "No, none. She's eaten everything and been fine on the amoxicillin.",
      "start_timestamp": "02:33",
      "end_timestamp": "02:40",
      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Wonderful. And remind me of her health background?",
      "start_timestamp": "02:41",
      "end_timestamp": "02:46",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "She has eczema, mostly on her elbows. And she's had a few ear infections, this is the third.",
      "start_timestamp": "02:48",
      "end_timestamp": "02:57",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "She's being perfect. Her temperature is 36.8 and she weighs 14.2 kilos.",
      "start_timestamp": "03:34",
      "end_timestamp": "03:41",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Not that I can see, she's right on track. Now, the right eardrum looks normal. Pink and shiny, no redness.",
      "start_timestamp": "03:55",
      "end_timestamp": "04:06",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "The left is the one that was infected, and it's looking much calmer. I think the ear infection has settled.",
      "start_timestamp": "04:11",
      "end_timestamp": "04:23",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Nearly. Finish the last two days of the amoxicillin, then stop. It's worth checking how she hears after a few infections, so I'd like to arrange a hearing check.",
      "start_timestamp": "04:31",
      "end_timestamp": "04:44",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "The appointment will come by post. And I'd like to see her again in six weeks, so we can check the ear and talk about the hearing test.",
      "start_timestamp": "05:04",
      "end_timestamp": "05:20",
      "supports": [
        "clinical_actions[2]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Bring her back sooner if she's pulling at it again or has a temperature.",
      "start_timestamp": "05:28",
      "end_timestamp": "05:37",
      "supports": [
        "clinical_actions[1]"
      ]
