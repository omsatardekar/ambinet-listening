  "clinical_uncertainties": [],
  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hi there! I get these terrible headaches every spring, always around the same time, and I've finally decided to ask someone about it.",
      "start_timestamp": "00:02",
      "end_timestamp": "00:13",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'm glad you did. Tell me what they feel like.",
      "start_timestamp": "00:17",
      "end_timestamp": "00:23",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Like a hot poker behind my right eye. It's the worst pain I've ever had, honestly.",
      "start_timestamp": "00:25",
      "end_timestamp": "00:34",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long does an attack last?",
      "start_timestamp": "00:38",
      "end_timestamp": "00:42",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "About an hour, sometimes 90 minutes. Then it goes.",
      "start_timestamp": "00:45",
      "end_timestamp": "00:50",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How many times a day?",
      "start_timestamp": "00:53",
      "end_timestamp": "00:56",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Two or three, and often at night. It wakes me up.",
      "start_timestamp": "01:00",
      "end_timestamp": "01:06",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long does the run of headaches go on for?",
      "start_timestamp": "01:10",
      "end_timestamp": "01:16",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Six weeks or so, then they just stop.",
      "start_timestamp": "01:19",
      "end_timestamp": "01:23",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any watering of the eye, or a blocked nose on that side during the attack?",
      "start_timestamp": "01:26",
      "end_timestamp": "01:33",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes! The eye waters like a tap, and my nose runs on the right side. How did you know?",
      "start_timestamp": "01:37",
      "end_timestamp": "01:47",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "This sounds like cluster headache, which comes in runs, often in the same season each year.",
      "start_timestamp": "03:09",
      "end_timestamp": "03:18",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes. There are treatments for stopping an attack, and ones for preventing the run. I'd like to refer you to a neurologist to plan it properly.",
      "start_timestamp": "03:50",
      "end_timestamp": "04:05",
      "supports": [
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Meanwhile, avoid alcohol during a run, as it can set off an attack.",
      "start_timestamp": "04:31",
      "end_timestamp": "04:38",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If the pain changes, or you get weakness, confusion or a stiff neck, come in at once.",
      "start_timestamp": "04:49",
      "end_timestamp": "04:58",
      "supports": [
        "clinical_actions[2]",
        "follow_up[0]"
      ]
    }
  ],
