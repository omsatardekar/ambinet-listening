    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's the best sort of visit. Have you had any symptoms at all since I saw you last?",
      "start_timestamp": "00:16",
      "end_timestamp": "00:26",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Not a thing, really. Well, I get a bit tired going up the hill by the church, but at my age I'd expect that.",
      "start_timestamp": "00:30",
      "end_timestamp": "00:42",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 62 and regular, blood pressure 130 over 78.",
      "start_timestamp": "01:29",
      "end_timestamp": "01:34",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Very good. I've already checked your pacemaker with the programmer this morning, before you came in.",
      "start_timestamp": "01:44",
      "end_timestamp": "01:52",
      "supports": [
        "procedures_and_investigations[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "You weren't even here. The device has been talking to the machine since eight.",
      "start_timestamp": "02:02",
      "end_timestamp": "02:11",
      "supports": [
        "procedures_and_investigations[0]"
