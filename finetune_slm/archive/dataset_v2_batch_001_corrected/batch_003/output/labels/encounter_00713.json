    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Good morning, doctor. Nothing to report, really, I'm only here because the letter said it was time for the pacemaker check.",
      "start_timestamp": "00:03",
      "end_timestamp": "00:12",
      "supports": [
        "chief_complaint"
