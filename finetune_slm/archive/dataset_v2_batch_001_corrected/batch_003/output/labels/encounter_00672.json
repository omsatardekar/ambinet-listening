      "end_timestamp": "00:47",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. And how are your energy levels through the day?",
      "start_timestamp": "00:49",
      "end_timestamp": "00:55",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Tired in the afternoons, about three days a week. I note it in the diary.",
      "start_timestamp": "00:57",
      "end_timestamp": "01:05",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any swelling around the ankles?",
      "start_timestamp": "01:08",
      "end_timestamp": "01:11",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A little at night, on the left. It's gone by the morning.",
      "start_timestamp": "01:12",
      "end_timestamp": "01:20",
      "supports": [
        "symptoms[2]"
      ]
