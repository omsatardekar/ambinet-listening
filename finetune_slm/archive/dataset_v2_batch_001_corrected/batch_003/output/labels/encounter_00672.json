      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Breathlessness on the stairs is much better. In January I had to stop halfway, now I can do the lot at home without stopping.",
