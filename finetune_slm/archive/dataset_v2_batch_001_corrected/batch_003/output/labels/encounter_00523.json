      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "New. I used to sleep straight through.",
      "start_timestamp": "02:01",
      "end_timestamp": "02:05",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Got it. Any blurry vision, like you can't quite focus on the page?",
      "start_timestamp": "02:08",
      "end_timestamp": "02:15",
      "supports": [
