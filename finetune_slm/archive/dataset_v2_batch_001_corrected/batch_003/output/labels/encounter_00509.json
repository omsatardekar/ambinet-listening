  "follow_up": [],
  "clinical_uncertainties": [],
  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Sorry, sorry, I don't want to make a fuss, but my chest has gone really tight, and the walk from the car park was far longer than I remembered. Is it always that far? I swear they've moved the entrance.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:23",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let's get you sitting up properly. Sam, can you grab a chair with arms for him? Right, tell me about the tightness.",
      "start_timestamp": "00:26",
      "end_timestamp": "00:38",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Thanks. It's a tight chest, like someone's pulled a belt round it, and it always happens on cold days. It's been like that since the cold snap started last week, and today it's been worse than ever, I even had my scarf over my mouth.",
      "start_timestamp": "00:48",
      "end_timestamp": "01:09",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And are you short of breath with it?",
      "start_timestamp": "01:11",
      "end_timestamp": "01:15",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, a bit. Well, a lot, on the stairs. And there's a whistling noise when I breathe out, my mate on the site said it sounded like a kettle. Oh, I should say, the lads call me Whistler now, which is not a nickname I wanted.",
      "start_timestamp": "01:18",
      "end_timestamp": "01:39",
      "supports": [
        "symptoms[1]",
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Ha. You work on a building site, then?",
      "start_timestamp": "01:41",
      "end_timestamp": "01:46",
      "supports": [
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Fifteen years now. Brickwork mostly, outdoors all day, which is why the cold gets me. My brother-in-law keeps telling me to get a desk job, but I'd be bored stiff.",
      "start_timestamp": "01:48",
      "end_timestamp": "02:03",
      "supports": [
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And do you smoke?",
      "start_timestamp": "02:06",
      "end_timestamp": "02:08",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I know, I know. About ten cigarettes a day, I keep saying I'll cut down. Actually, I did cut down in January, then I had a bad week.",
      "start_timestamp": "02:10",
      "end_timestamp": "02:24",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Asthma, since I was a boy. It was quiet for years but it's been waking up with this cold weather.",
      "start_timestamp": "02:39",
      "end_timestamp": "02:51",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "The brown inhaler, twice a day, in the morning and at night. Though I missed a few days this week because I left it in my other jacket. I've got the blue one as well but that's actually my mate's, I borrowed it, so ignore that.",
      "start_timestamp": "02:59",
      "end_timestamp": "03:26",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Right, so the brown one is yours, thank you. Do you have any allergies to medicines or anything else?",
      "start_timestamp": "03:28",
      "end_timestamp": "03:38",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, none at all. Not even hay fever, which is a miracle on a building site.",
      "start_timestamp": "03:40",
      "end_timestamp": "03:48",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you. So oxygen saturation is 94 percent, pulse 104, and his breathing rate is 22. A bit fast, but he's talking in full sentences, which is reassuring.",
      "start_timestamp": "04:00",
      "end_timestamp": "04:13",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "There's a clear wheeze through both lungs, more at the bases, and air is going in reasonably well.",
      "start_timestamp": "04:56",
      "end_timestamp": "05:05",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "This looks most likely like an asthma flare brought on by the cold, but with your age and smoking, I want to make sure we're not missing anything. That's why I'd like to get a chest X-ray done today.",
      "start_timestamp": "05:20",
      "end_timestamp": "05:40",
      "supports": [
        "clinical_assessment[0]",
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you. And Sam, please get a peak flow reading as well, so we can see how tight it is. We'll do that now.",
      "start_timestamp": "05:52",
      "end_timestamp": "06:04",
      "supports": [
        "procedures_and_investigations[1]",
        "clinical_actions[1]"
      ]
    }
