      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I've got an underactive thyroid, and asthma since I was a kid. And anxiety, on and off. That's it.",
