  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I've just been a bit queasy. Since I found out I was pregnant, really. It's what everyone gets, isn't it?",
      "start_timestamp": "00:19",
      "end_timestamp": "00:31",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It's pretty constant, I suppose, though worse in the mornings. It's only been about two weeks.",
      "start_timestamp": "00:40",
      "end_timestamp": "00:48",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Three weeks, Em. It started the weekend we went to your mum's. That's three weeks on Saturday.",
      "start_timestamp": "00:50",
      "end_timestamp": "00:57",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Is it? I thought two weeks. Maybe it is three.",
      "start_timestamp": "00:58",
      "end_timestamp": "01:03",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "So somewhere between two and three weeks. And the being sick, how often is that happening?",
      "start_timestamp": "01:04",
      "end_timestamp": "01:12",
      "supports": [
        "symptoms[0]",
        "symptoms[1]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Um, three or four times a day. Sometimes more. It's not that bad, honestly.",
      "start_timestamp": "01:13",
      "end_timestamp": "01:20",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Just tired. Wiped out, really. I fell asleep on the sofa at seven o'clock last night, which isn't like me.",
      "start_timestamp": "01:44",
      "end_timestamp": "01:53",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Anything when you stand up, or move around?",
      "start_timestamp": "01:56",
      "end_timestamp": "02:00",
      "supports": [
        "symptoms[3]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A bit dizzy when I get up quickly. It passes.",
      "start_timestamp": "02:02",
      "end_timestamp": "02:07",
      "supports": [
        "symptoms[3]"
      ]
    },
    {
