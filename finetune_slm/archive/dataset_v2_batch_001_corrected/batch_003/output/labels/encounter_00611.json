      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Amlodipine, 5 mg every morning.",
      "start_timestamp": "02:03",
      "end_timestamp": "02:06",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Aspirin, 75 mg, once a day, with his breakfast.",
      "start_timestamp": "02:14",
      "end_timestamp": "02:19",
      "supports": [
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Co-codamol, for the arthritis in his hips. Two when it's bad, usually in the evening.",
      "start_timestamp": "02:46",
      "end_timestamp": "02:54",
      "supports": [
        "medications[2]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Co-codamol, as needed, for arthritis. Noted. Harry, what other health problems have you had?",
      "start_timestamp": "02:56",
      "end_timestamp": "03:03",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A stroke. That's why I'm in the bed. It was... a few years ago. Four? Six?",
      "start_timestamp": "03:05",
      "end_timestamp": "03:14",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Five. Yes. And the blood pressure, the high blood pressure. And the arthritis.",
      "start_timestamp": "03:20",
      "end_timestamp": "03:27",
      "supports": [
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Right. And who lives here with him?",
      "start_timestamp": "03:41",
      "end_timestamp": "03:45",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Mum died, so it's just Dad here. I stay over, three nights a week. A carer pops in as well.",
      "start_timestamp": "03:46",
      "end_timestamp": "03:56",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. How are your waterworks, Harry? Passing water without trouble?",
      "start_timestamp": "03:59",
      "end_timestamp": "04:05",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Fine. Fine, thank you. Normal.",
      "start_timestamp": "04:06",
      "end_timestamp": "04:09",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Blood pressure 142 over 80. Pulse 78. Temperature 36.6. Oxygen 96 percent. Breathing 16.",
      "start_timestamp": "04:36",
      "end_timestamp": "04:44",
      "supports": [
