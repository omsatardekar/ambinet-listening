  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Constipation. I haven't been, um, for days. Four days. No, five. Gwen?",
      "start_timestamp": "00:40",
      "end_timestamp": "00:47",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Right. And did it start suddenly, or has it been creeping up?",
      "start_timestamp": "00:57",
      "end_timestamp": "01:04",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It was last week. Or the week before. I really couldn't say.",
      "start_timestamp": "01:06",
      "end_timestamp": "01:12",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "I couldn't give you a date either. He's always been a bit slow, but it got worse some time ago.",
      "start_timestamp": "01:15",
      "end_timestamp": "01:25",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Fine, we'll leave the start date. Any bloating or tummy discomfort now?",
      "start_timestamp": "01:28",
      "end_timestamp": "01:35",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I feel bloated. Like a drum. Like a football, really.",
      "start_timestamp": "01:36",
      "end_timestamp": "01:42",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any vomiting?",
      "start_timestamp": "01:45",
      "end_timestamp": "01:47",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, no vomiting. Just full.",
      "start_timestamp": "01:50",
      "end_timestamp": "01:53",
      "supports": [
