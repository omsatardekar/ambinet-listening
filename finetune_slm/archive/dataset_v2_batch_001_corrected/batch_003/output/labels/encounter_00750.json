  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hello, doctor. I'm not sure what I've come about, to be honest. The hospital said to come back and see you after I was in.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:13",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Grand, grand. Only I've no appetite. None at all. I push the food around the plate.",
      "start_timestamp": "00:27",
      "end_timestamp": "00:36",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long has that been going on?",
      "start_timestamp": "00:38",
      "end_timestamp": "00:41",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Since the hospital? Or before it? Honestly, I couldn't say. I've been off my food a while.",
      "start_timestamp": "00:44",
      "end_timestamp": "00:53",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you lost weight?",
      "start_timestamp": "00:55",
      "end_timestamp": "00:58",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My trousers are loose, so I must have. A couple of stone, maybe? I don't weigh myself.",
      "start_timestamp": "01:01",
      "end_timestamp": "01:10",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What tablets are you on?",
      "start_timestamp": "01:29",
      "end_timestamp": "01:33",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Mirtazapine, 15 mg, maybe? At bedtime, the little white one. And omeprazole, 20 mg in the morning.",
      "start_timestamp": "01:36",
      "end_timestamp": "01:44",
      "supports": [
        "medications[0]",
        "medications[1]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is the mirtazapine 15 mg, do you think? You said maybe.",
      "start_timestamp": "01:46",
      "end_timestamp": "01:53",
      "supports": [
        "medications[0]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It could be 30. The chemist knows. I only take what they give me.",
      "start_timestamp": "01:55",
      "end_timestamp": "02:02",
      "supports": [
        "medications[0]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "For my mood, after my wife died. Two years ago.",
      "start_timestamp": "02:11",
      "end_timestamp": "02:17",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'm very sorry. Any operations?",
      "start_timestamp": "02:19",
      "end_timestamp": "02:22",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Gallbladder, in the nineties.",
      "start_timestamp": "02:24",
      "end_timestamp": "02:26",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 82, blood pressure 118 over 72, temperature 36.6, oxygen 96 percent, and you weigh 64 kilos.",
      "start_timestamp": "02:59",
      "end_timestamp": "03:07",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your record says 74 kilos a year ago, so you've lost about ten kilos, which is significant. Any cough or breathlessness left from the chest infection?",
      "start_timestamp": "03:16",
      "end_timestamp": "03:30",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A little cough in the morning. No breathlessness.",
      "start_timestamp": "03:32",
      "end_timestamp": "03:37",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd say the main thing is poor appetite after your recent illness, in the setting of low mood, so I'd call it reduced appetite following illness.",
      "start_timestamp": "03:40",
      "end_timestamp": "03:53",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It's likely part of it, but with that much weight loss, I don't want to assume. I'd like to arrange blood tests, to look for anaemia, thyroid, and other causes.",
      "start_timestamp": "04:00",
      "end_timestamp": "04:16",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Meanwhile, small meals and snacks, six times a day, and a build-up drink between meals, rather than big plates.",
      "start_timestamp": "04:23",
      "end_timestamp": "04:33",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's the idea. And try to eat with someone, if you can, a neighbour or a friend.",
      "start_timestamp": "04:39",
      "end_timestamp": "04:47",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. I'd like to see you again in two weeks, and weigh you again.",
      "start_timestamp": "04:54",
      "end_timestamp": "05:02",
      "supports": [
        "clinical_actions[1]",
        "follow_up[0]"
      ]
    }
