    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes, I'd like to arrange a blood test, to check your iron stores, your blood count and your thyroid.",
      "start_timestamp": "03:34",
      "end_timestamp": "03:45",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Today, if you can pop in to the nurse after this.",
      "start_timestamp": "03:55",
      "end_timestamp": "04:01",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Meanwhile, get gentle exercise back slowly, a walk, not the gym, and eat iron-rich foods, with something with vitamin C.",
