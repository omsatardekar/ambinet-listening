      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Ferrous sulphate, 200 mg once a day, since my iron was low last year. And vitamin D, 1000 units, every day.",
