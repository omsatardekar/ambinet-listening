  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hello. It's probably nothing. I had COVID last month, and I feel run down, that's all.",
      "start_timestamp": "00:03",
      "end_timestamp": "00:12",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Five weeks ago. I was in bed for a week, and since then I've just been flat. I used to go to the gym twice a week and I can't face it.",
      "start_timestamp": "00:24",
      "end_timestamp": "00:43",
      "supports": [
        "symptoms[0]",
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is it tiredness, or low energy, or something else?",
      "start_timestamp": "00:47",
      "end_timestamp": "00:53",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Tired by mid-afternoon, mostly. Not sleepy exactly, just heavy.",
      "start_timestamp": "00:57",
      "end_timestamp": "01:01",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any fever, cough or breathlessness left over?",
      "start_timestamp": "01:05",
      "end_timestamp": "01:10",
      "supports": [
        "negative_findings[0]",
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No fever, no cough, and my breathing's fine.",
      "start_timestamp": "01:15",
      "end_timestamp": "01:19",
      "supports": [
        "negative_findings[0]",
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What are you taking at the moment?",
      "start_timestamp": "01:23",
