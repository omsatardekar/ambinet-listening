  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Good morning, dear. I do hope I'm not wasting your time, I only came because my daughter said I must, I keep forgetting my tablets.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:13",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Well, I have the morning ones and the evening ones, and in the morning I get distracted, there's the cat, and the radio, and the phone goes, and then at night I find the morning ones still on the saucer.",
      "start_timestamp": "00:25",
      "end_timestamp": "00:45",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How often would you say you miss them?",
      "start_timestamp": "00:47",
      "end_timestamp": "00:52",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Oh, three or four mornings a week, I should think. I've written it on the calendar, but then I forget to look at the calendar!",
      "start_timestamp": "00:54",
      "end_timestamp": "01:09",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "You're certainly not alone. Have you had any falls lately?",
      "start_timestamp": "01:10",
      "end_timestamp": "01:17",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, no falls. I'm very careful with the stairs.",
      "start_timestamp": "01:20",
      "end_timestamp": "01:25",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any dizziness, light-headedness?",
      "start_timestamp": "01:27",
      "end_timestamp": "01:29",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, none. I'm steady as a rock, ask my daughter.",
      "start_timestamp": "01:32",
      "end_timestamp": "01:38",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you remember what the tablets are for?",
      "start_timestamp": "01:39",
      "end_timestamp": "01:44",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "They're for my blood pressure, the two of them. High blood pressure, I've had it since my fifties.",
      "start_timestamp": "01:45",
      "end_timestamp": "01:55",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any allergies to medicines, that we should know about?",
      "start_timestamp": "01:56",
      "end_timestamp": "02:01",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Penicillin. I came out in a rash, as a girl, and my mother said never again.",
      "start_timestamp": "02:03",
      "end_timestamp": "02:11",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 68 and regular, blood pressure 148 over 84, temperature 36.5, oxygen 97 percent, weight 61 kilos.",
      "start_timestamp": "02:47",
      "end_timestamp": "02:55",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]",
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "The pressure's a little high, which fits with missing doses. And your pulse is regular. Any breathlessness or chest tightness?",
      "start_timestamp": "03:01",
      "end_timestamp": "03:12",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, I walk to the shops and back without trouble.",
      "start_timestamp": "03:15",
      "end_timestamp": "03:20",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'm going to start you on ramipril, 5 mg once a day, for your blood pressure, and stop the other two.",
      "start_timestamp": "03:46",
      "end_timestamp": "03:56",
      "supports": [
        "medications[0]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "The pharmacist will take them back. And we'll get a pill organiser, a box with the days of the week, so you can see at a glance.",
      "start_timestamp": "04:03",
      "end_timestamp": "04:18",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Exactly. Keep it by the kettle, so you see it when you make your morning tea.",
      "start_timestamp": "04:29",
      "end_timestamp": "04:38",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd also like to check your kidney function with a blood test, since you're starting a new tablet.",
      "start_timestamp": "04:47",
      "end_timestamp": "04:58",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes, at reception. If you feel dizzy, or your face or lips swell, or you develop a dry cough that won't go, stop it and let us know.",
      "start_timestamp": "05:07",
      "end_timestamp": "05:22",
      "supports": [
        "clinical_actions[4]"
      ]
    }
