  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "So I got a call from your office about my blood work, the kidney number was up, and I'm here because, uh, they said it might be the pills I take for my back.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:16",
      "supports": [
        "chief_complaint",
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "The back pain? Three months. No, sorry, four months. It started when I was moving my sister's couch in the spring, or maybe the summer, anyway.",
      "start_timestamp": "00:36",
      "end_timestamp": "00:52",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Mostly it's there when I bend. Tying my boots is the worst part of the day.",
      "start_timestamp": "01:06",
      "end_timestamp": "01:14",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Ibuprofen. The 600 mg ones, I take them two or three times a day. Well, two, usually, but three on the bad days. I've got a bottle in the truck, one in the kitchen, one in my jacket.",
      "start_timestamp": "01:25",
      "end_timestamp": "01:43",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "The pills are the likely culprit, yes. From what I'm seeing, it looks like the anti-inflammatories are straining your kidneys. It's early, and it's usually reversible.",
      "start_timestamp": "02:17",
      "end_timestamp": "02:31",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Well, your number is up, but you're not in trouble yet. That's why I wanted you in. Any blood in your urine? Dark, or red, or like tea?",
      "start_timestamp": "02:39",
      "end_timestamp": "02:56",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No. Nothing like that. It's yellow like always. Well, darker in the morning, but everybody's is.",
      "start_timestamp": "02:58",
      "end_timestamp": "03:07",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I get kidney stones, every few years. I passed one on a fishing trip once, worst day of my life.",
      "start_timestamp": "03:20",
      "end_timestamp": "03:30",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "High blood pressure. I'm supposed to watch it. Oh, and I had my appendix out as a teenager, you were going to ask that.",
      "start_timestamp": "03:44",
      "end_timestamp": "03:56",
      "supports": [
        "medical_history.past_medical_history[1]",
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I was heading there. Appendix as a teenager. What do you do for work, with that back?",
      "start_timestamp": "03:57",
      "end_timestamp": "04:07",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Construction. Framing houses, I've done it for twenty-two years. No, twenty-three. Whichever, long enough.",
      "start_timestamp": "04:09",
      "end_timestamp": "04:17",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Heavy on the back, that explains it. And any alcohol?",
      "start_timestamp": "04:18",
      "end_timestamp": "04:24",
      "supports": [
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A beer or two after work. Weekends maybe four.",
      "start_timestamp": "04:27",
      "end_timestamp": "04:32",
      "supports": [
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Blood pressure is 138 over 84, and your pulse is 70. Not bad at all.",
      "start_timestamp": "04:41",
      "end_timestamp": "04:50",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Fewer cups never hurts. So, here's the plan. I'd like to repeat the creatinine blood test, so we can see whether the number is moving. I'll order that today.",
      "start_timestamp": "05:02",
      "end_timestamp": "05:15",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "No fasting needed. I'd also like a urine test, to check whether any protein is leaking through the filter.",
      "start_timestamp": "05:23",
      "end_timestamp": "05:33",
      "supports": [
        "procedures_and_investigations[1]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Stop the ibuprofen, all of it, including the bottle in the truck. Use heat on the back in the evening, keep moving, and I'll have the physiotherapist's number for you at the desk.",
      "start_timestamp": "06:00",
      "end_timestamp": "06:16",
      "supports": [
        "clinical_actions[2]"
      ]
    }
