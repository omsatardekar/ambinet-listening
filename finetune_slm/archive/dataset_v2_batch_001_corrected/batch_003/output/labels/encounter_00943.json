  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Doctor, it's the urine infections. She's had three since Christmas, and each time she gets muddled. This week she's confused again.",
      "start_timestamp": "01:06",
      "end_timestamp": "01:16",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How is the confusion different from her usual?",
      "start_timestamp": "01:17",
      "end_timestamp": "01:21",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_4",
      "speaker_role": "caregiver",
      "transcript_text": "She didn't know me on Monday. She asked who I was, and then she thought it was morning when it was evening.",
      "start_timestamp": "01:24",
      "end_timestamp": "01:36",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I see. Mrs Lowe, any burning when you pass water?",
      "start_timestamp": "01:44",
      "end_timestamp": "01:49",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A bit of a sting, yes. Down below.",
      "start_timestamp": "01:52",
      "end_timestamp": "01:57",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "And she's going all the time, doctor. Every hour, Priya says.",
      "start_timestamp": "01:58",
      "end_timestamp": "02:04",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_4",
      "speaker_role": "caregiver",
      "transcript_text": "Every hour or so, yes. Even at night.",
      "start_timestamp": "02:07",
      "end_timestamp": "02:11",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any fever, shivering?",
      "start_timestamp": "02:13",
      "end_timestamp": "02:15",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_4",
      "speaker_role": "caregiver",
      "transcript_text": "No, her temperature's been normal, I check it with the ear thermometer.",
      "start_timestamp": "02:17",
      "end_timestamp": "02:25",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any falls?",
      "start_timestamp": "02:27",
      "end_timestamp": "02:29",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "No falls, thank goodness.",
      "start_timestamp": "02:30",
      "end_timestamp": "02:33",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What medicines is she on?",
      "start_timestamp": "02:34",
      "end_timestamp": "02:37",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Trimethoprim, 100 mg, at night, to prevent the infections. Amlodipine, 5 mg, once a day. And paracetamol, 500 mg, when she needs it.",
      "start_timestamp": "02:40",
      "end_timestamp": "02:53",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you. Any conditions, Jean?",
      "start_timestamp": "02:54",
      "end_timestamp": "02:57",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Recurrent urinary infections, obviously, and high blood pressure.",
      "start_timestamp": "02:59",
      "end_timestamp": "03:03",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Dementia in the family, anything like that?",
      "start_timestamp": "03:06",
      "end_timestamp": "03:11",
      "supports": [
        "medical_history.family_history[0]",
        "clinical_actions[0]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Her sister had dementia, yes.",
      "start_timestamp": "03:13",
      "end_timestamp": "03:16",
      "supports": [
        "medical_history.family_history[0]",
        "clinical_actions[0]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Who's at home with her?",
      "start_timestamp": "03:19",
      "end_timestamp": "03:22",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_4",
      "speaker_role": "caregiver",
      "transcript_text": "She lives alone, with us coming in four times a day.",
      "start_timestamp": "03:24",
      "end_timestamp": "03:31",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And what did she do for work?",
      "start_timestamp": "03:34",
      "end_timestamp": "03:38",
      "supports": [
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I was a nurse, dear, for forty years. I'd know a urine infection if I saw one.",
      "start_timestamp": "03:41",
      "end_timestamp": "03:49",
      "supports": [
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'm sure you would. Let me check you. Pulse 82, blood pressure 138 over 76, temperature 36.9, oxygen 96 percent, breathing 16, and weight 59 kilos.",
      "start_timestamp": "04:07",
      "end_timestamp": "04:23",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]",
        "vital_signs[5]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "There's tenderness just above the pubic bone, in the lower tummy.",
      "start_timestamp": "04:54",
      "end_timestamp": "05:01",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_024",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Given the sting, the going every hour, and the confusion, this looks like another urine infection.",
      "start_timestamp": "05:08",
      "end_timestamp": "05:18",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_025",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It's very common at her age. Make sure she drinks plenty of water through the day.",
      "start_timestamp": "05:25",
      "end_timestamp": "05:33",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_026",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If she's still muddled in three days, or she gets a fever, get in touch and we'll see her again.",
