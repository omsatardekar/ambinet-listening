  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Morning, doctor! I'm Donna, I'm Leo's foster carer, we've had him eight months. He's two and a half, and I'm worried because he's not talking.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:12",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "That's about it, doctor. He says car, brum, no, and mama, which he says to everyone. Not much else.",
      "start_timestamp": "00:38",
      "end_timestamp": "00:47",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Does he put two words together, like 'more juice' or 'big car'?",
      "start_timestamp": "00:50",
      "end_timestamp": "00:57",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Never. He points, and grunts, and gets frustrated and throws things.",
      "start_timestamp": "00:58",
      "end_timestamp": "01:04",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Does he follow instructions, like 'give me the ball' or 'where's your shoe'?",
      "start_timestamp": "01:06",
      "end_timestamp": "01:12",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Sometimes. If you show him. If you just say it, he doesn't always seem to understand.",
      "start_timestamp": "01:14",
      "end_timestamp": "01:22",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Has he had a hearing test, or lots of ear infections?",
      "start_timestamp": "01:24",
      "end_timestamp": "01:31",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "He had loads of ear infections before he came to me, and grommets put in at eighteen months.",
      "start_timestamp": "01:33",
      "end_timestamp": "01:43",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any other medical history, or anything about his birth I should know?",
      "start_timestamp": "01:44",
      "end_timestamp": "01:51",
      "supports": [
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "He was born early, at thirty-two weeks. That's in his notes.",
      "start_timestamp": "01:53",
      "end_timestamp": "01:59",
      "supports": [
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is he on any medicines?",
      "start_timestamp": "02:00",
      "end_timestamp": "02:03",
      "supports": [
        "medications[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Vitamin D drops, once a day. I give them every morning.",
      "start_timestamp": "02:05",
      "end_timestamp": "02:11",
      "supports": [
        "medications[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Hmm, I'm not sure I give them every day, if I'm honest. When it's chaos in the morning, I forget.",
      "start_timestamp": "02:17",
      "end_timestamp": "02:29",
      "supports": [
        "medications[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's very normal. I'll note that they're meant to be daily and that some days are missed. Does he go to nursery, or have other children around?",
      "start_timestamp": "02:32",
      "end_timestamp": "02:44",
      "supports": [
        "medical_history.social_history[0]",
        "medications[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Nursery three days a week, and his foster brother is five.",
      "start_timestamp": "02:46",
      "end_timestamp": "02:51",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "The grommets are in place, both ears look clean and dry, and I can see no fluid behind the eardrums.",
      "start_timestamp": "03:55",
      "end_timestamp": "04:04",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It might be partly. With his history of ear infections, hearing is the first thing to check. Overall, I think this is speech delay, probably related to the early ear problems and prematurity.",
      "start_timestamp": "04:11",
      "end_timestamp": "04:30",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Many children do, especially with support. I'd like to arrange a hearing test, an audiology assessment, and a referral to the speech and language therapist.",
      "start_timestamp": "04:37",
      "end_timestamp": "04:52",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "A few weeks for the hearing test. Meanwhile, talk to him constantly, name things, read picture books, and don't finish his sentences for him.",
      "start_timestamp": "04:59",
      "end_timestamp": "05:14",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And reduce screen time. If he loses words he already has, or seems not to respond to loud sounds, come back sooner.",
      "start_timestamp": "05:21",
      "end_timestamp": "05:34",
      "supports": [
        "clinical_actions[2]",
        "follow_up[0]"
      ]
    }
  ],
