      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No. No blood.",
      "start_timestamp": "01:51",
      "end_timestamp": "01:53",
      "supports": [
