    {
      "evidence_id": "EV_002",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Dad won't make a fuss, so I'm going to. His bowels have changed, doctor. He's sixty, and he's been going more often.",
      "start_timestamp": "00:55",
      "end_timestamp": "01:05",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Mr Webb, how long has this been?",
      "start_timestamp": "01:15",
      "end_timestamp": "01:19",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Two months. Perhaps three.",
      "start_timestamp": "01:22",
      "end_timestamp": "01:25",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How has it changed?",
      "start_timestamp": "01:28",
      "end_timestamp": "01:31",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Looser. More often, three or four times a day instead of once. And I get this urgency, I have to run.",
      "start_timestamp": "01:33",
      "end_timestamp": "01:44",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any blood in the stool?",
      "start_timestamp": "01:45",
