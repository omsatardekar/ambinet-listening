      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any weight loss?",
      "start_timestamp": "01:55",
      "end_timestamp": "01:57",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Not that I've noticed.",
      "start_timestamp": "02:01",
      "end_timestamp": "02:03",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "He's lost weight, doctor, his trousers are loose.",
      "start_timestamp": "02:06",
      "end_timestamp": "02:10",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'll weigh him, and I'll note that you each said different things. What tablets are you on?",
      "start_timestamp": "02:13",
      "end_timestamp": "02:22",
      "supports": [
        "medications[0]",
