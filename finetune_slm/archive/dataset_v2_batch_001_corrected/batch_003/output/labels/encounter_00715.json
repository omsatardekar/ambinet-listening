  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hello, doctor! I've come for my heart scan results, the echo. I've been worried sick, to be honest, and I told my sister I'd ring her straight after.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:15",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Palpitations, mostly. My heart flutters, like a bird in my chest, a few times a week.",
      "start_timestamp": "00:28",
      "end_timestamp": "00:38",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And anything else along with it?",
      "start_timestamp": "00:40",
      "end_timestamp": "00:43",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Breathless, when I climb the stairs at work. Third floor, no lift. And a bit dizzy sometimes, when it happens.",
      "start_timestamp": "00:44",
      "end_timestamp": "00:54",
      "supports": [
        "symptoms[1]",
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any chest pain?",
      "start_timestamp": "00:55",
      "end_timestamp": "00:58",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No pain. Thank God.",
      "start_timestamp": "01:00",
      "end_timestamp": "01:03",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any fainting?",
      "start_timestamp": "01:05",
      "end_timestamp": "01:06",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Never fainted, no.",
      "start_timestamp": "01:08",
      "end_timestamp": "01:11",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 84, blood pressure 112 over 70, temperature 36.7, oxygen 99 percent, respiratory rate 14.",
      "start_timestamp": "02:35",
      "end_timestamp": "02:43",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "There's a click in mid-beat, which is the valve, and no murmur. Your lungs are clear, and there's no swelling of your ankles.",
      "start_timestamp": "03:24",
      "end_timestamp": "03:35",
      "supports": [
        "physical_examination[0]",
        "physical_examination[1]",
        "physical_examination[2]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It does. I'd say what you're feeling is most likely due to the mitral valve prolapse.",
      "start_timestamp": "03:41",
      "end_timestamp": "03:50",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Mostly nothing. Cut down on caffeine, and keep hydrated. But I'd like to be sure the palpitations are benign, so I'd like to arrange a 48-hour heart rhythm monitor.",
      "start_timestamp": "03:58",
      "end_timestamp": "04:11",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to see you again in four weeks, when the monitor results are back.",
