  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "G'day, doctor. I'll be honest, I'm a bit freaked out. My wife filmed me sleeping and I stop breathing.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:10",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That would worry anyone. Tell me what the video showed.",
      "start_timestamp": "00:13",
      "end_timestamp": "00:19",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I snore like a chainsaw, and then it goes quiet for, I don't know, ten seconds, then I make this awful snorting gasp. Over and over.",
      "start_timestamp": "00:20",
      "end_timestamp": "00:35",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long has the snoring been going on?",
      "start_timestamp": "00:36",
      "end_timestamp": "00:41",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Years, but the pauses are new, she only noticed this month.",
      "start_timestamp": "00:43",
      "end_timestamp": "00:50",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you wake up tired?",
      "start_timestamp": "00:53",
      "end_timestamp": "00:56",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Wrecked. I'm dozing at traffic lights. That's what really scares me.",
      "start_timestamp": "00:58",
      "end_timestamp": "01:03",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any morning headaches, or a dry mouth when you wake?",
      "start_timestamp": "01:04",
      "end_timestamp": "01:10",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No headaches, no. Dry mouth, yeah, a bit, but no headaches.",
      "start_timestamp": "01:13",
      "end_timestamp": "01:20",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you ever wake up choking or gasping?",
      "start_timestamp": "01:22",
      "end_timestamp": "01:28",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, I don't think I wake up. She says I just gasp and carry on.",
      "start_timestamp": "01:30",
      "end_timestamp": "01:39",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is your nose blocked at night?",
      "start_timestamp": "01:41",
      "end_timestamp": "01:44",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Always. Both sides. I breathe through my mouth.",
      "start_timestamp": "01:47",
      "end_timestamp": "01:51",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any allergies, to medicines especially?",
      "start_timestamp": "01:53",
      "end_timestamp": "01:57",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Oh, something gave me a swollen lip once, years ago, but I don't know what it was. A tablet, I think. Or maybe food.",
      "start_timestamp": "01:58",
      "end_timestamp": "02:10",
      "supports": [
        "allergies[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "So possibly an allergic reaction, but you can't say what to. I'll note it as uncertain. Do you drink in the evenings?",
      "start_timestamp": "02:12",
      "end_timestamp": "02:25",
      "supports": [
        "medical_history.social_history[0]",
        "allergies[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A couple of beers, most nights. I know, I know.",
      "start_timestamp": "02:26",
      "end_timestamp": "02:31",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What you describe, loud snoring, pauses in breathing, and daytime sleepiness, looks most like obstructive sleep apnoea.",
      "start_timestamp": "03:20",
      "end_timestamp": "03:29",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'll refer you to the sleep clinic for a proper sleep study.",
      "start_timestamp": "03:54",
      "end_timestamp": "04:02",
      "supports": [
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "A few weeks, I'm afraid. Meanwhile, I'd like to start you on a nasal spray, fluticasone, two sprays in each nostril once a day, to open your nose up.",
      "start_timestamp": "04:10",
      "end_timestamp": "04:24",
      "supports": [
        "medications[0]",
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Please don't drive when you feel drowsy, pull over and take a break. And cut the beer in the evenings.",
      "start_timestamp": "04:50",
      "end_timestamp": "05:01",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to see you again in three weeks, to see how the nose is and where the sleep clinic has got to.",
      "start_timestamp": "05:07",
      "end_timestamp": "05:20",
      "supports": [
        "clinical_actions[1]",
        "follow_up[0]"
      ]
    }
