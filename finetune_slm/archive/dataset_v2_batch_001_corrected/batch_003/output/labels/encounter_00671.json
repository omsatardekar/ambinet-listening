  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Morning. It's these patches. Itchy ones, on my elbows and knees. I've had them a few months.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:12",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Tell me more about them. What do they look like?",
      "start_timestamp": "00:15",
      "end_timestamp": "00:21",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Red, with a silvery flaky bit on top. They look daft.",
      "start_timestamp": "00:23",
      "end_timestamp": "00:30",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do they flake a lot?",
      "start_timestamp": "00:33",
      "end_timestamp": "00:36",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Aye, I find bits in the bed. And they itch like mad, mainly at night.",
      "start_timestamp": "00:40",
      "end_timestamp": "00:50",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any changes to your nails, pitting, ridges, anything?",
      "start_timestamp": "01:07",
      "end_timestamp": "01:11",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, nails are fine.",
      "start_timestamp": "01:14",
      "end_timestamp": "01:17",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And are your joints okay, any pain or stiffness, especially in the morning?",
      "start_timestamp": "01:19",
      "end_timestamp": "01:27",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, nothing. Joints are fine.",
      "start_timestamp": "01:30",
      "end_timestamp": "01:33",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What work do you do?",
      "start_timestamp": "01:36",
      "end_timestamp": "01:40",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I'm a scaffolder. I'm outdoors most days, and gloves and knee pads, so the knees are rubbed a lot.",
      "start_timestamp": "01:43",
      "end_timestamp": "01:55",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to start you on a steroid cream, betamethasone, apply it to the patches once a day for two weeks, thinly.",
      "start_timestamp": "02:55",
      "end_timestamp": "03:05",
      "supports": [
        "medications[0]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It usually does within a few days. And I'd like to arrange a skin scraping from one patch, to make sure it's not a fungal infection.",
      "start_timestamp": "03:29",
      "end_timestamp": "03:42",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Done. You'll hear if anything shows. Moisturise every day, with a plain thick cream, even when they're better.",
      "start_timestamp": "04:18",
      "end_timestamp": "04:30",
      "supports": [
        "clinical_actions[2]"
      ]
