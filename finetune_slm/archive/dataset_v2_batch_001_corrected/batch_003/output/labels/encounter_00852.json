  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Doctor, thank you. It's Rory, he's fifteen, he did his knee playing rugby six weeks ago, and he's still limping.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:10",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Hello Rory. Which knee, and what happened?",
      "start_timestamp": "00:13",
      "end_timestamp": "00:17",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "The left. I got tackled from the side, and my knee twisted, and I felt a pop.",
      "start_timestamp": "00:17",
      "end_timestamp": "00:28",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Was there swelling, immediately?",
      "start_timestamp": "00:30",
      "end_timestamp": "00:33",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yeah. Within an hour. It was huge.",
      "start_timestamp": "00:35",
      "end_timestamp": "00:40",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "It was like a balloon. We took him to the emergency department, they said sprain, gave him a brace.",
      "start_timestamp": "00:43",
      "end_timestamp": "00:53",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How is it now?",
      "start_timestamp": "00:56",
      "end_timestamp": "00:59",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It's better, but it gives way on stairs, and it clicks, and I can't straighten it fully.",
      "start_timestamp": "01:02",
      "end_timestamp": "01:10",
      "supports": [
        "symptoms[0]",
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is there any locking, where it gets stuck?",
      "start_timestamp": "01:13",
      "end_timestamp": "01:18",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Once or twice. It catches.",
      "start_timestamp": "01:19",
      "end_timestamp": "01:23",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any numbness, or any pain at night?",
      "start_timestamp": "01:24",
      "end_timestamp": "01:29",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No. Nothing like that.",
      "start_timestamp": "01:31",
      "end_timestamp": "01:34",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any fever, or redness on the knee?",
      "start_timestamp": "01:35",
      "end_timestamp": "01:39",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No.",
      "start_timestamp": "01:40",
      "end_timestamp": "01:41",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What have you been taking for the pain?",
      "start_timestamp": "01:44",
      "end_timestamp": "01:48",
      "supports": [
        "medications[0]",
        "medications[1]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Ibuprofen, 200 mg, three times a day, with food.",
      "start_timestamp": "01:51",
      "end_timestamp": "01:56",
      "supports": [
        "medications[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "No, it's 400 mg, Rory. I gave him two tablets. And paracetamol, 500 mg, when he needs it.",
      "start_timestamp": "01:57",
      "end_timestamp": "02:07",
      "supports": [
        "medications[0]",
        "medications[1]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'll note that you and Mum gave different doses of ibuprofen, and I'll check which. Any other conditions?",
      "start_timestamp": "02:10",
      "end_timestamp": "02:18",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "He has mild asthma, hay fever, and eczema.",
      "start_timestamp": "02:20",
      "end_timestamp": "02:25",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 72, blood pressure 118 over 70, temperature 36.6, weight 62 kilos.",
      "start_timestamp": "02:52",
      "end_timestamp": "02:58",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "There's a little fluid in the left knee, and tenderness over the inner side of the joint line, and when I twist it, I get a click and pain. The ligaments feel stable.",
      "start_timestamp": "03:39",
      "end_timestamp": "03:56",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It suggests a tear in the cartilage, the meniscus, rather than a ligament. Considering the twist and the locking, I'd say this is a probable meniscal tear.",
      "start_timestamp": "04:01",
      "end_timestamp": "04:17",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Possibly. I'd like to arrange an MRI scan of the left knee, to see exactly what's torn.",
      "start_timestamp": "04:22",
      "end_timestamp": "04:31",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_024",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "No rugby for now. Keep the knee moving, gentle exercises, and no twisting or running.",
      "start_timestamp": "04:39",
      "end_timestamp": "04:46",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_025",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I know, Rory, and I'm sorry. But playing on a torn meniscus can make it worse. I'll refer you to the physio as well.",
      "start_timestamp": "04:54",
      "end_timestamp": "05:05",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_026",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to see you again in three weeks, with the MRI result.",
      "start_timestamp": "05:12",
      "end_timestamp": "05:20",
      "supports": [
