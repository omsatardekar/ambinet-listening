  "clinical_uncertainties": [],
  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Well, doctor, you know, the hand is still doing it. It was a Tuesday when I wrote to you. No, a Wednesday, the bins had gone out.",
      "start_timestamp": "00:19",
      "end_timestamp": "00:32",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My right one. It shakes when I'm sitting with it in my lap, watching the television, and then it stops when I pick up the paper. Or is it the left? No, right, definitely right.",
      "start_timestamp": "00:45",
      "end_timestamp": "01:01",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Right hand, shaking at rest, and it settles when you use it. That's useful to know. How long has it been going on?",
      "start_timestamp": "01:02",
      "end_timestamp": "01:13",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Four months. No, five. My daughter says six months, and she keeps a diary, so we'll say six months.",
      "start_timestamp": "01:15",
      "end_timestamp": "01:25",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, my daughter says I'm walking slower. I think I'm walking at the same speed, but she says that when we go to the shops I'm always three paces behind her.",
      "start_timestamp": "01:38",
      "end_timestamp": "01:54",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A bit, going up the road to the post box. I used to do it in five minutes and now it's more like ten, and I do have to stop for a breath.",
      "start_timestamp": "02:10",
      "end_timestamp": "02:28",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you. Now I need to ask, have you had any falls?",
      "start_timestamp": "02:29",
      "end_timestamp": "02:37",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, no falls. A stumble on the kerb once, but I caught myself on the lamppost. No falls.",
      "start_timestamp": "02:38",
      "end_timestamp": "02:48",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. So no falls, just a stumble you caught yourself from. What medicines do you take at the moment?",
      "start_timestamp": "02:50",
      "end_timestamp": "03:01",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Just the one, ramipril, 5 mg once a day, for the blood pressure. I put it next to the kettle so I don't forget it.",
      "start_timestamp": "03:02",
      "end_timestamp": "03:13",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, only that. Oh, and I'm to avoid codeine. I was allergic to it years ago, made me violently sick, and I've never touched it since.",
      "start_timestamp": "03:23",
      "end_timestamp": "03:35",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I live alone in a bungalow, since my wife passed. The daughter comes on Sundays. I smoked thirty a day till 1989, then I gave it up overnight.",
      "start_timestamp": "03:49",
      "end_timestamp": "04:02",
      "supports": [
        "medical_history.social_history[0]",
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Just the blood pressure, since I was about fifty. And the hearing, I've got hearing loss, you'll have to speak up a bit, doctor.",
      "start_timestamp": "04:24",
      "end_timestamp": "04:36",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your left for the cuff, please. Your blood pressure is 146 over 84, pulse 72 bpm, oxygen saturation 97 %, temperature 36.6 °C and you weigh 69 kg.",
      "start_timestamp": "05:25",
      "end_timestamp": "05:41",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I can feel cogwheel rigidity in your right arm, a ratchet-like stiffness as I move it. Now, stand up and walk to the door and back for me.",
      "start_timestamp": "06:21",
      "end_timestamp": "06:37",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "You've got reduced arm swing when you walk, mostly on the right, and your steps are small. Sit down again, you did well.",
      "start_timestamp": "06:38",
      "end_timestamp": "06:48",
      "supports": [
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Most likely early Parkinson's disease. That's my provisional view, not a final answer, and it's a condition we can manage well for many years.",
      "start_timestamp": "07:23",
      "end_timestamp": "07:34",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to arrange a blood test today, to check a few other things that can mimic this, and then I'll see you again in six weeks to go through it.",
      "start_timestamp": "08:07",
      "end_timestamp": "08:22",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]",
        "clinical_actions[1]",
        "follow_up[0]"
      ]
    }
