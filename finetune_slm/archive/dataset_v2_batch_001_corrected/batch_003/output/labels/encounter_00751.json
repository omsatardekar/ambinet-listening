    {
      "evidence_id": "EV_016",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Asthma since he was a boy, and high blood pressure. He takes his blue inhaler and a brown one twice a day, but he's run out of the brown one.",
