      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you. Declan, I'm going to give you salbutamol through a nebuliser mask, and steroid tablets, prednisolone, 40 mg once a day, for five days.",
