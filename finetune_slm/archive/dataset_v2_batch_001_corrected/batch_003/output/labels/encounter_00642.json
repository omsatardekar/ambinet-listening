  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Early is fine. Come in, Maya. It's six weeks since we started the antidepressant, so I'd like to hear how it's been.",
      "start_timestamp": "00:17",
      "end_timestamp": "00:29",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I'm crying less, which my sister has noticed. But I'm still waking at four every morning, and I can't get back to sleep.",
      "start_timestamp": "00:44",
      "end_timestamp": "00:56",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Four every morning, and then you lie awake?",
      "start_timestamp": "00:57",
      "end_timestamp": "01:02",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, my mind starts going over work, and by seven I'm shattered.",
      "start_timestamp": "01:03",
      "end_timestamp": "01:10",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any side effects from the tablets, anything you've noticed since starting?",
      "start_timestamp": "01:12",
      "end_timestamp": "01:18",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I'm sweating more at night, which is a bit gross, and it makes the waking worse.",
      "start_timestamp": "01:20",
      "end_timestamp": "01:29",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you. Now I have to ask: any thoughts of harming yourself?",
      "start_timestamp": "01:32",
      "end_timestamp": "01:39",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No. Not at all. That was never, no.",
      "start_timestamp": "01:41",
      "end_timestamp": "01:45",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any panic attacks, or racing heart?",
      "start_timestamp": "01:48",
      "end_timestamp": "01:52",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, nothing like that.",
      "start_timestamp": "01:55",
      "end_timestamp": "01:57",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And any dizziness, especially standing up?",
      "start_timestamp": "01:59",
      "end_timestamp": "02:03",
      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No dizziness. I did feel strange in the first week, but that's gone.",
      "start_timestamp": "02:05",
      "end_timestamp": "02:12",
      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. Tell me what you're taking, to check it matches the record.",
      "start_timestamp": "02:13",
      "end_timestamp": "02:20",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Sertraline, 100 mg once a day, in the morning. And mirtazapine, 15 mg at night, which I started with the sertraline.",
      "start_timestamp": "02:21",
      "end_timestamp": "02:31",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Right. And any allergies?",
      "start_timestamp": "02:33",
      "end_timestamp": "02:36",
      "supports": [
        "negative_findings[3]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No known allergies, no.",
      "start_timestamp": "02:38",
      "end_timestamp": "02:41",
      "supports": [
        "negative_findings[3]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And in terms of other conditions?",
      "start_timestamp": "02:42",
      "end_timestamp": "02:46",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Depression, obviously, first diagnosed at nineteen. And I get migraines.",
      "start_timestamp": "02:48",
      "end_timestamp": "02:55",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any operations in the past?",
      "start_timestamp": "02:57",
      "end_timestamp": "03:00",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Just my tonsils, when I was six.",
      "start_timestamp": "03:03",
      "end_timestamp": "03:08",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_3",
      "speaker_role": "nurse",
      "transcript_text": "Blood pressure 116 over 72, pulse 74, temperature 36.6, oxygen 99 percent, weight 63 kilos.",
      "start_timestamp": "03:44",
      "end_timestamp": "03:51",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse is regular, and no tremor in your hands.",
      "start_timestamp": "04:23",
      "end_timestamp": "04:28",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It's what I wanted. So, thinking about it all, this looks like depression that's partly responding to treatment, so I'm not changing the antidepressant today.",
      "start_timestamp": "04:36",
      "end_timestamp": "04:50",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_024",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "The early waking is a common thing in depression. But I can't rule out an underactive thyroid contributing, so I'd like to check that.",
      "start_timestamp": "04:57",
      "end_timestamp": "05:09",
      "supports": [
        "clinical_assessment[1]"
      ]
    },
    {
      "evidence_id": "EV_025",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to arrange a thyroid blood test, and a sodium level, as the sertraline can lower sodium.",
      "start_timestamp": "05:15",
      "end_timestamp": "05:24",
      "supports": [
        "procedures_and_investigations[0]",
        "procedures_and_investigations[1]",
        "clinical_actions[0]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_026",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Please, Amy. And since you're on two medicines that can affect the heart rhythm, I'd also like an ECG while you're here.",
      "start_timestamp": "05:33",
      "end_timestamp": "05:44",
      "supports": [
        "procedures_and_investigations[2]",
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_027",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to see you in four weeks to go over the results and see how the sleep is.",
