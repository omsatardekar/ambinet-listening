  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Good morning, doctor. I'm Bimla, I look after Mrs Mehta every day, and she's got this cough and she keeps clearing her throat. It's driving us both mad.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:17",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Namaste, doctor. Yes, doctor. This cough.",
      "start_timestamp": "00:20",
      "end_timestamp": "00:24",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long has it been, Mrs Mehta?",
      "start_timestamp": "00:25",
      "end_timestamp": "00:30",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Since the pneumonia, doctor. After the hospital. Three months.",
      "start_timestamp": "00:32",
      "end_timestamp": "00:38",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "She had a chest infection in July, and ever since, she's been clearing her throat, all day, and coughing.",
      "start_timestamp": "00:41",
      "end_timestamp": "00:49",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is it a dry cough, or does it bring up phlegm?",
      "start_timestamp": "00:50",
      "end_timestamp": "00:58",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Dry, mostly. A tickle in the throat. And the throat clearing.",
      "start_timestamp": "00:59",
      "end_timestamp": "01:07",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "When is it worst?",
      "start_timestamp": "01:07",
      "end_timestamp": "01:10",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "After meals. And lying down.",
      "start_timestamp": "01:12",
      "end_timestamp": "01:15",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What are you taking?",
      "start_timestamp": "01:18",
      "end_timestamp": "01:21",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Omeprazole, 20 mg, once a day, and a blood pressure tablet, amlodipine, 5 mg.",
      "start_timestamp": "01:22",
      "end_timestamp": "01:30",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any other health conditions?",
      "start_timestamp": "01:31",
      "end_timestamp": "01:35",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "She had pneumonia, as I said. And high blood pressure. And her thyroid, she had an operation on it, in 2005.",
      "start_timestamp": "01:37",
      "end_timestamp": "01:47",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let me ask about the operation. What was it?",
      "start_timestamp": "01:48",
      "end_timestamp": "01:53",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Half her thyroid taken out, in 2005.",
      "start_timestamp": "01:55",
      "end_timestamp": "01:59",
      "supports": [
        "medical_history.past_medical_history[1]",
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Does she smoke or drink?",
      "start_timestamp": "02:01",
      "end_timestamp": "02:04",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "No. Never.",
      "start_timestamp": "02:06",
      "end_timestamp": "02:08",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "I've taken them, doctor. Pulse 78, blood pressure 138 over 82, oxygen 97 percent, temperature 36.6, weight 58 kilos.",
      "start_timestamp": "02:16",
      "end_timestamp": "02:25",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your chest is clear, and your throat is slightly red at the back, with some cobblestoning, but nothing worrying.",
      "start_timestamp": "02:59",
      "end_timestamp": "03:10",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "The chest X-ray they did in hospital after pneumonia was clear, and so is my examination today. The pattern, a dry tickly cough, throat clearing, worse after meals and lying down, makes me think of reflux, silent reflux, or a post-infection cough.",
      "start_timestamp": "03:18",
      "end_timestamp": "03:39",
      "supports": [
        "clinical_assessment[0]",
        "clinical_assessment[1]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "She's already on omeprazole once a day. I'd like to increase it to twice a day, and see if that helps.",
      "start_timestamp": "04:03",
      "end_timestamp": "04:13",
      "supports": [
        "clinical_actions[4]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And I'd like to arrange a blood test, to check your thyroid and blood count, because of the operation, and a repeat chest X-ray, and a breathing test, to be thorough.",
      "start_timestamp": "04:17",
      "end_timestamp": "04:32",
      "supports": [
        "procedures_and_investigations[0]",
        "procedures_and_investigations[1]",
        "procedures_and_investigations[2]",
        "clinical_actions[0]",
        "clinical_actions[1]",
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Avoid eating late, raise the head of the bed, and avoid spicy food, tea and coffee after lunch.",
      "start_timestamp": "04:48",
      "end_timestamp": "04:59",
      "supports": [
        "clinical_actions[5]"
      ]
    },
    {
      "evidence_id": "EV_024",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to see her again in four weeks. If she coughs up blood, loses weight, or gets breathless, come back sooner.",
      "start_timestamp": "05:07",
      "end_timestamp": "05:19",
      "supports": [
        "clinical_actions[3]",
        "follow_up[0]"
      ]
