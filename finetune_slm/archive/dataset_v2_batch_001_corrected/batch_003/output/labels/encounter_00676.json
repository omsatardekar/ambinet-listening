  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hello. Er, it's a bit embarrassing, so it is. There's been blood on the toilet paper.",
      "start_timestamp": "00:02",
      "end_timestamp": "00:11",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "You're not the first, and you're right to come. How long has that been happening?",
      "start_timestamp": "00:13",
      "end_timestamp": "00:21",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "About a week, I'd say. Every time I go, nearly. Bright red, on the paper. Not in the pan, mind.",
      "start_timestamp": "00:23",
      "end_timestamp": "00:33",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And is it mixed in with the stool, or only on the paper?",
      "start_timestamp": "00:36",
      "end_timestamp": "00:44",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Just on the paper, after I wipe.",
      "start_timestamp": "00:47",
      "end_timestamp": "00:51",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any pain when you go?",
      "start_timestamp": "00:54",
      "end_timestamp": "00:57",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A bit of a sting, yes. And an itch around there, which is awful.",
      "start_timestamp": "01:00",
      "end_timestamp": "01:07",
      "supports": [
        "symptoms[1]",
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any change in how often you go, or in the stool, black, loose, or anything unusual?",
      "start_timestamp": "01:28",
      "end_timestamp": "01:36",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, it's much the same as always, hard and slow.",
      "start_timestamp": "01:39",
      "end_timestamp": "01:44",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What's your diet like?",
      "start_timestamp": "01:46",
      "end_timestamp": "01:49",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Terrible. Takeaways, mostly. Hardly any veg. My mother would be mortified.",
      "start_timestamp": "01:52",
      "end_timestamp": "01:57",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And what do you do for work?",
      "start_timestamp": "02:00",
      "end_timestamp": "02:04",
      "supports": [
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I'm at a desk all day, I do the accounts for a haulage firm.",
      "start_timestamp": "02:06",
      "end_timestamp": "02:15",
      "supports": [
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any past operations?",
      "start_timestamp": "02:17",
      "end_timestamp": "02:19",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A hernia repair, years ago, on the right. Ten years, maybe.",
      "start_timestamp": "02:22",
      "end_timestamp": "02:29",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 70, blood pressure 130 over 80.",
      "start_timestamp": "02:54",
      "end_timestamp": "02:59",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. Now, from what you describe, bright red blood only on the paper, a sting and itch, and hard stools, this sounds like haemorrhoids, piles.",
      "start_timestamp": "03:07",
      "end_timestamp": "03:19",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Very common. But at your age, I'd like to be sure, so I'd like to arrange a proctoscopy, a short look inside with a small tube.",
      "start_timestamp": "03:27",
      "end_timestamp": "03:41",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "In the meantime, have more fibre, fruit and veg, and drink lots of water, so the stools soften.",
      "start_timestamp": "04:09",
      "end_timestamp": "04:19",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Everyone does it. Come back and see me in two weeks, once you've had the proctoscopy, to go over it.",
      "start_timestamp": "04:48",
      "end_timestamp": "05:00",
      "supports": [
        "clinical_actions[1]",
        "follow_up[0]"
      ]
    }
