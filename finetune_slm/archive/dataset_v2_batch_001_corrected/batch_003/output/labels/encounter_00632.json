  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Oh, it's probably nothing. It's just a, well, a little spot, on my nose. It's been there for a while.",
      "start_timestamp": "00:24",
      "end_timestamp": "00:35",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let me see. Can you tell me a bit more about it?",
      "start_timestamp": "00:37",
      "end_timestamp": "00:44",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It's rough, a bit scaly, like a bit of dry skin that won't go. I keep picking at it, and it comes back.",
      "start_timestamp": "00:45",
      "end_timestamp": "00:59",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long has it been there?",
      "start_timestamp": "01:00",
      "end_timestamp": "01:04",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Months. Maybe since the spring. I really can't say exactly.",
      "start_timestamp": "01:05",
      "end_timestamp": "01:11",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Does it bleed, or itch, or hurt?",
      "start_timestamp": "01:13",
      "end_timestamp": "01:17",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It bled once when I scratched it with my fingernail. Otherwise no, it doesn't hurt.",
      "start_timestamp": "01:20",
      "end_timestamp": "01:29",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you have any other skin problems?",
      "start_timestamp": "02:01",
      "end_timestamp": "02:05",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I get eczema on my hands, but it's been quiet this year.",
      "start_timestamp": "02:07",
      "end_timestamp": "02:14",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It's a rough, scaly patch about six millimetres across, on the side of the nose, with a slightly pearly edge.",
      "start_timestamp": "03:14",
      "end_timestamp": "03:25",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thanks. Mrs Harding, this is very common, and it fits with sun damage. But I can't rule out a basal cell carcinoma, which is a slow-growing, very treatable skin cancer.",
      "start_timestamp": "03:35",
      "end_timestamp": "03:50",
      "supports": [
        "clinical_assessment[0]",
        "clinical_assessment[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Meanwhile, please don't pick at it, and use a high-factor sun cream on your face when you're out.",
      "start_timestamp": "05:04",
      "end_timestamp": "05:15",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "A hat's excellent. If it grows, bleeds more, or hasn't settled in four weeks, come back and see me sooner.",
      "start_timestamp": "05:25",
      "end_timestamp": "05:36",
      "supports": [
        "clinical_actions[0]",
        "follow_up[0]"
      ]
    }
