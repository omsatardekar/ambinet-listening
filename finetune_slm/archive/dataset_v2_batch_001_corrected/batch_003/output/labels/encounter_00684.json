  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Good morning, doctor. Thank you for seeing me. I have been having pain in the upper right of my abdomen, after I eat fatty food.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:13",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good morning, Mr Reddy. Tell me more about the pain. When does it come on?",
      "start_timestamp": "00:16",
      "end_timestamp": "00:24",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Usually an hour after a heavy meal, fried food especially. It is quite sharp, and it lasts for about two hours.",
      "start_timestamp": "00:27",
      "end_timestamp": "00:38",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Does it spread anywhere?",
      "start_timestamp": "00:39",
      "end_timestamp": "00:42",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Sometimes to my right shoulder blade. And I feel nauseous along with it.",
      "start_timestamp": "00:44",
      "end_timestamp": "00:51",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How often does it happen?",
      "start_timestamp": "00:54",
      "end_timestamp": "00:58",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Perhaps once a week, since about three months.",
      "start_timestamp": "00:59",
      "end_timestamp": "01:03",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you been vomiting?",
      "start_timestamp": "01:05",
      "end_timestamp": "01:08",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Not vomiting, but nausea, yes.",
      "start_timestamp": "01:10",
      "end_timestamp": "01:13",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any yellowing of your eyes or skin, or dark urine?",
      "start_timestamp": "01:14",
      "end_timestamp": "01:21",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, no yellowing. And my urine is normal.",
      "start_timestamp": "01:22",
      "end_timestamp": "01:27",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any fever with the attacks?",
      "start_timestamp": "01:30",
      "end_timestamp": "01:33",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No fever, no.",
      "start_timestamp": "01:35",
      "end_timestamp": "01:37",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Are you taking anything at the moment?",
      "start_timestamp": "01:38",
      "end_timestamp": "01:43",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Just omeprazole, 20 mg once a day, for acidity.",
      "start_timestamp": "01:46",
      "end_timestamp": "01:51",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any other conditions?",
      "start_timestamp": "01:52",
      "end_timestamp": "01:55",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I have type 2 diabetes, high cholesterol, and high blood pressure.",
      "start_timestamp": "01:57",
      "end_timestamp": "02:03",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you have any family history of gallstones?",
      "start_timestamp": "02:05",
      "end_timestamp": "02:09",
      "supports": [
        "medical_history.family_history[0]",
        "clinical_actions[2]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, my mother had her gallbladder removed, I believe in her fifties.",
      "start_timestamp": "02:11",
      "end_timestamp": "02:17",
      "supports": [
        "medical_history.family_history[0]",
        "clinical_actions[2]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And your diet, do you eat a lot of fried food?",
      "start_timestamp": "02:18",
      "end_timestamp": "02:24",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I confess I love samosas and pakoras. I eat them most evenings.",
      "start_timestamp": "02:27",
      "end_timestamp": "02:34",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you drink alcohol?",
      "start_timestamp": "02:37",
      "end_timestamp": "02:40",
      "supports": [
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, I do not drink.",
      "start_timestamp": "02:41",
      "end_timestamp": "02:45",
      "supports": [
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_024",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 76, blood pressure 138 over 86, temperature 36.7, oxygen 98 percent, weight 88 kilos.",
      "start_timestamp": "03:08",
      "end_timestamp": "03:15",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_025",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "You are tender under the right ribs, especially when you breathe in.",
      "start_timestamp": "03:59",
      "end_timestamp": "04:06",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_026",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "The pattern fits, and I will want to see it properly. I'd like to arrange an ultrasound scan of your abdomen, to look at the gallbladder and the liver.",
      "start_timestamp": "04:12",
      "end_timestamp": "04:27",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_027",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Within two weeks. I'd also like a blood test to check your liver, pancreas and sugar.",
      "start_timestamp": "04:35",
      "end_timestamp": "04:43",
      "supports": [
        "procedures_and_investigations[1]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_028",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Until then, please avoid fried and fatty food, and eat smaller, lighter meals.",
      "start_timestamp": "04:49",
      "end_timestamp": "04:57",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_029",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If the pain lasts more than six hours, or you develop a fever, or your skin turns yellow, come in the same day or go to the emergency department.",
