    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hi, quickly please, I'm on my lunch break. I slipped on ice this morning on the way to the car and landed on my left hand. My wrist is killing me.",
