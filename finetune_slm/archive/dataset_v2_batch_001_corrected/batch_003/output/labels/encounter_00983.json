        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Sharp, right at the base of the thumb side, worse if I try to turn the hand over.",
      "start_timestamp": "00:27",
