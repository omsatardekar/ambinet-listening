  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Good afternoon, doctor. Thank you for seeing me again so promptly. I'm afraid the boil has not gone away entirely.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:11",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "The boil under my right arm has gone down a bit, but it's still there, about ten days now. And it remains rather painful.",
      "start_timestamp": "00:25",
      "end_timestamp": "00:37",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How painful? Is it worse at particular times?",
      "start_timestamp": "00:39",
      "end_timestamp": "00:43",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Moderate, I should say. It catches when I lift my arm, putting on a jacket, for instance.",
      "start_timestamp": "00:44",
      "end_timestamp": "00:52",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any fever or shivers?",
      "start_timestamp": "00:53",
      "end_timestamp": "00:56",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No fever, no.",
      "start_timestamp": "00:58",
      "end_timestamp": "01:01",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And any similar lumps elsewhere, under the other arm or in the groin?",
      "start_timestamp": "01:03",
      "end_timestamp": "01:12",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "None in either place. This is the only one at present, though I've had others over the years.",
      "start_timestamp": "01:12",
      "end_timestamp": "01:23",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let's go through the treatment. What are you using?",
      "start_timestamp": "01:24",
      "end_timestamp": "01:29",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "The tablets you gave me, doxycycline, 100 mg twice a day, which I've nearly finished. And the antiseptic wash, chlorhexidine, every day in the shower.",
      "start_timestamp": "01:31",
      "end_timestamp": "01:43",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. What else is on your record, medically?",
      "start_timestamp": "01:46",
      "end_timestamp": "01:51",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Type 2 diabetes, acne when I was younger which I believe has persisted a little, and high cholesterol.",
      "start_timestamp": "01:53",
      "end_timestamp": "02:02",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And you said you've had others over the years. Have you had any of them drained?",
      "start_timestamp": "02:03",
      "end_timestamp": "02:12",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "One, last year. The abscess drained under local anaesthetic, in the other armpit.",
      "start_timestamp": "02:15",
      "end_timestamp": "02:23",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you smoke?",
      "start_timestamp": "02:23",
      "end_timestamp": "02:26",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I'm afraid so. About ten a day.",
      "start_timestamp": "02:27",
      "end_timestamp": "02:31",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_3",
      "speaker_role": "nurse",
      "transcript_text": "Blood pressure 134 over 84, pulse 80, temperature 36.7, oxygen 98 percent, weight 92 kilos.",
      "start_timestamp": "03:00",
      "end_timestamp": "03:08",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "There's a tender swelling about three centimetres across under the right arm, with no spreading redness around it.",
      "start_timestamp": "03:35",
      "end_timestamp": "03:44",
      "supports": [
        "physical_examination[0]",
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It's improving, which is what I hoped for. Given that you've had repeated boils in the armpits, the pattern fits hidradenitis suppurativa, a condition of the sweat glands and hair follicles.",
      "start_timestamp": "03:49",
      "end_timestamp": "04:06",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to arrange an HbA1c blood test to see how your sugar control has been.",
      "start_timestamp": "04:38",
      "end_timestamp": "04:47",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Keep using the wash, wear loose cotton clothing, and avoid shaving the area for now.",
      "start_timestamp": "04:53",
      "end_timestamp": "05:03",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to see you again in two weeks, once the antibiotics are done, to check the area and talk about longer-term options.",
