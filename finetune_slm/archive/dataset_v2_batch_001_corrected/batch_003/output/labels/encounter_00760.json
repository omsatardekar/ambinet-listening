    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How often do you get them?",
      "start_timestamp": "00:12",
      "end_timestamp": "00:16",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Every few weeks. One or two at a time, on the inside of my lips and cheeks. They sting like mad when I eat.",
      "start_timestamp": "00:20",
      "end_timestamp": "00:33",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long do they last?",
      "start_timestamp": "00:37",
      "end_timestamp": "00:40",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A week or ten days. And then another turns up. I can't tell you when I got the first one, years ago.",
      "start_timestamp": "00:43",
      "end_timestamp": "00:54",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any fever or sore throat with them?",
