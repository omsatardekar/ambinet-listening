    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Mouthwash, a medicated one, twice a day. A vitamin B12 tablet, 1000 micrograms once a day, and my statin, atorvastatin, 20 mg at night.",
