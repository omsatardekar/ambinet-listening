    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hello. It's my mouth. Ulcers. They keep coming back, and I'm fed up.",
      "start_timestamp": "00:02",
