  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I'm so thirsty all the time and I'm passing a huge amount of urine. I wondered if it might be diabetes.",
