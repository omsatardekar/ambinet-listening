  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Good morning, doctor. I'm Niamh, I look after Mr Hegarty. He took a tumble on Sunday, so I thought we'd best have his tablets looked at.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:16",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Did he hit his head, Niamh?",
      "start_timestamp": "00:39",
      "end_timestamp": "00:43",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "No, thank God. He went down on his side, and no, he didn't hit his head at all.",
      "start_timestamp": "00:46",
      "end_timestamp": "00:55",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's the main thing, on a blood thinner. Let's go through all his medicines.",
      "start_timestamp": "00:58",
      "end_timestamp": "01:05",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "There's the apixaban, 5 mg twice a day, the blood thinner. And bisoprolol, 2.5 mg once a day.",
      "start_timestamp": "01:07",
      "end_timestamp": "01:16",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Right. And the third?",
      "start_timestamp": "01:20",
      "end_timestamp": "01:22",
      "supports": [
        "medications[2]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "A little yellow tablet, round, small. I give it in the morning, but I can't tell you the name, it's come out of the blister packs.",
      "start_timestamp": "01:25",
      "end_timestamp": "01:38",
      "supports": [
        "medications[2]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'll check our record to see what the yellow one is. Mr Hegarty, do you know what it's for?",
      "start_timestamp": "01:41",
      "end_timestamp": "01:52",
      "supports": [
        "medications[2]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Something for the heart, I think. Or the water. I leave it to Niamh.",
      "start_timestamp": "01:53",
      "end_timestamp": "02:00",
      "supports": [
        "medications[2]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Fair enough, I'll find out and ring you. Any allergies to medicines?",
      "start_timestamp": "02:03",
      "end_timestamp": "02:09",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "None, no. He has never had a problem.",
      "start_timestamp": "02:12",
      "end_timestamp": "02:17",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let me ask about his other conditions.",
      "start_timestamp": "02:20",
      "end_timestamp": "02:24",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Atrial fibrillation, which is what the blood thinner's for, high blood pressure, and arthritis in the hips.",
      "start_timestamp": "02:27",
      "end_timestamp": "02:37",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Because he's on a blood thinner, any fall needs care. If he hits his head, vomits, becomes drowsy or confused, he needs the emergency department straight away, even if he seems fine.",
      "start_timestamp": "03:41",
      "end_timestamp": "03:59",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And I'd like to see him again in a week, to review the tablets, once I've found out what the yellow one is.",
      "start_timestamp": "04:08",
      "end_timestamp": "04:20",
      "supports": [
        "clinical_actions[0]",
