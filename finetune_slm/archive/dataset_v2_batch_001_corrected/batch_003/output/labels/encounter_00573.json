  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "That's it, a routine check. Sure, the wife says I'm due an MOT, like the car.",
      "start_timestamp": "00:24",
      "end_timestamp": "00:33",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "A wise policy. Let's go through the basics. What tablets are you on at the moment?",
      "start_timestamp": "00:54",
      "end_timestamp": "01:03",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Ramipril, 5 milligrams, one every morning. And a small aspirin, 75 milligrams, with my breakfast.",
      "start_timestamp": "01:06",
      "end_timestamp": "01:14",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Grand. Any allergies to medicines, or to anything else?",
      "start_timestamp": "01:34",
      "end_timestamp": "01:39",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "None at all.",
      "start_timestamp": "01:41",
      "end_timestamp": "01:43",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. Have you had any operations in the past?",
      "start_timestamp": "01:46",
      "end_timestamp": "01:51",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "One. They trimmed the cartilage in my left knee, a keyhole job, in 2014.",
      "start_timestamp": "01:53",
      "end_timestamp": "02:00",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good man. Do you get any chest pain, say when you're out walking?",
      "start_timestamp": "02:23",
      "end_timestamp": "02:30",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, never. I walk the dog up the hill every morning, forty minutes, and I come back in great form.",
      "start_timestamp": "02:32",
      "end_timestamp": "02:44",
      "supports": [
        "negative_findings[1]",
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any dizzy spells, or feeling faint?",
      "start_timestamp": "02:45",
      "end_timestamp": "02:49",
      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, not at all.",
      "start_timestamp": "02:50",
      "end_timestamp": "02:53",
      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Lovely. Now a couple of questions about how things are working inside. How are your digestion and bowels?",
      "start_timestamp": "02:55",
      "end_timestamp": "03:04",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Fine, regular as the clock on the church.",
      "start_timestamp": "03:06",
      "end_timestamp": "03:11",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And the waterworks, passing urine all right?",
      "start_timestamp": "03:13",
      "end_timestamp": "03:18",
      "supports": [
        "review_of_systems[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Fine, fine. Nothing to report there at all.",
      "start_timestamp": "03:20",
      "end_timestamp": "03:24",
      "supports": [
        "review_of_systems[1]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. Do you drink much alcohol?",
      "start_timestamp": "03:25",
      "end_timestamp": "03:29",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A couple of pints of Guinness on a Saturday night, down in the club. Two and home.",
      "start_timestamp": "03:31",
      "end_timestamp": "03:40",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pressure is 128 over 80, pulse 68, and you weigh 79 kilograms.",
      "start_timestamp": "04:20",
      "end_timestamp": "04:26",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Now, since it's your yearly service, I'd like to check a few things I can't see from here. I'll order blood tests, for your cholesterol and your sugar.",
      "start_timestamp": "04:54",
      "end_timestamp": "05:11",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Not for these. And I'd like to book an ECG too, a tracing of your heart, while you're here. The nurse can do it today.",
      "start_timestamp": "05:20",
      "end_timestamp": "05:35",
      "supports": [
        "procedures_and_investigations[1]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Ten minutes, a few stickers on your chest, nothing to it. Then I'd like to see you in two weeks, when the results are in.",
      "start_timestamp": "05:41",
      "end_timestamp": "05:56",
      "supports": [
        "clinical_actions[2]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And keep up the walking. The dog is doing you good, and you're doing the dog good.",
