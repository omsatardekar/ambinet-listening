  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hi. My eyes feel, I don't know, dry and gritty. Mostly when I'm on my computer.",
      "start_timestamp": "00:02",
      "end_timestamp": "00:11",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long has that been happening?",
      "start_timestamp": "00:14",
      "end_timestamp": "00:18",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Months, probably. It's been getting worse. By the end of the day they're burning, and I'm squinting.",
      "start_timestamp": "00:21",
      "end_timestamp": "00:30",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "In the meantime, follow the twenty-twenty-twenty rule: every twenty minutes, look at something twenty feet away for twenty seconds.",
      "start_timestamp": "03:06",
      "end_timestamp": "03:17",
      "supports": [
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Make sure your screen is slightly below eye level, and about an arm's length away.",
      "start_timestamp": "03:45",
      "end_timestamp": "03:53",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "A warm compress on your closed eyes for a few minutes in the evening helps as well.",
      "start_timestamp": "04:25",
      "end_timestamp": "04:33",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If you get pain, redness, or blurred vision that doesn't clear when you blink, see your optician urgently.",
      "start_timestamp": "04:43",
      "end_timestamp": "04:53",
      "supports": [
        "clinical_actions[3]"
      ]
    }
