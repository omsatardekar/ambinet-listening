  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hi, doctor. It's my toe, and I'm a bit squeamish about all this, sorry. It's an ingrown toenail, I think. It's really sore.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:12",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "No need to apologise. Which toe?",
      "start_timestamp": "00:13",
      "end_timestamp": "00:17",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "The big toe on my left foot, the outside edge. It's red, swollen, and a bit yellowy at the corner.",
      "start_timestamp": "00:19",
      "end_timestamp": "00:29",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long has it been like that?",
      "start_timestamp": "00:30",
      "end_timestamp": "00:34",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A week. It got much worse in the last three days. It throbs at night.",
      "start_timestamp": "00:37",
      "end_timestamp": "00:44",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any fever, or shivering?",
      "start_timestamp": "00:46",
      "end_timestamp": "00:49",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No fever. I've felt fine, otherwise.",
      "start_timestamp": "00:50",
      "end_timestamp": "00:54",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Some pus, yes, a little. But no blood.",
      "start_timestamp": "01:01",
      "end_timestamp": "01:06",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "The outer edge of the nail is digging into the skin, there's redness and swelling around it, and a little pus at the corner, but the redness doesn't spread up the toe.",
      "start_timestamp": "02:11",
      "end_timestamp": "02:30",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes, it's mildly infected, an infected ingrown toenail.",
      "start_timestamp": "02:37",
      "end_timestamp": "02:41",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Not today. I'd like to start with antibiotics, flucloxacillin, 500 mg, four times a day, for seven days. Have you had it before?",
      "start_timestamp": "02:49",
      "end_timestamp": "03:01",
      "supports": [
        "medications[0]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. Take it on an empty stomach, half an hour before food.",
      "start_timestamp": "03:12",
      "end_timestamp": "03:19",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And I'd like to send a swab of the pus to the lab, to be sure the antibiotic's right.",
      "start_timestamp": "03:24",
      "end_timestamp": "03:35",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Done. Now, soak the toe in warm salty water for ten minutes, twice a day, and keep it clean and dry.",
      "start_timestamp": "04:01",
      "end_timestamp": "04:12",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If you get a fever, redness spreading up your foot, or the pain gets worse, see us the same day.",
      "start_timestamp": "04:49",
      "end_timestamp": "05:00",
      "supports": [
        "clinical_actions[4]"
      ]
    }
