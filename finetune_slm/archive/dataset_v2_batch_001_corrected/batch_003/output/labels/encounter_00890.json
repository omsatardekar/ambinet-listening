  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Good morning. I'd like to review my situation. I have stress-related stomach upset and headaches, and I want to know whether my medication is the right one.",
      "start_timestamp": "00:02",
      "end_timestamp": "00:15",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good morning. Tell me which medication you're currently taking for this.",
      "start_timestamp": "00:17",
      "end_timestamp": "00:24",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Propranolol, 40 mg, twice a day. It was started by my previous doctor.",
      "start_timestamp": "00:27",
      "end_timestamp": "00:34",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long have you been taking it?",
      "start_timestamp": "00:37",
      "end_timestamp": "00:41",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "About four months.",
      "start_timestamp": "00:43",
      "end_timestamp": "00:46",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you have any other health conditions I should record?",
      "start_timestamp": "01:51",
      "end_timestamp": "01:56",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Asthma, since childhood. It's been quiet for years.",
      "start_timestamp": "01:59",
      "end_timestamp": "02:03",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I agree. I'd suggest we stop the propranolol gradually and switch to something else, but I'd like to check some bloods first.",
      "start_timestamp": "03:07",
      "end_timestamp": "03:21",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "A full blood count and a check on your liver, thyroid and kidneys, to make sure there's nothing else behind the symptoms.",
      "start_timestamp": "03:30",
      "end_timestamp": "03:43",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Please do not stop the propranolol suddenly, because that can cause problems.",
      "start_timestamp": "03:53",
      "end_timestamp": "04:00",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd also like you to have a proper lunch each day, and try to leave work on time at least twice a week.",
      "start_timestamp": "04:06",
      "end_timestamp": "04:19",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to see you again in two weeks, when the results are in, and we'll decide on the new medicine together.",
      "start_timestamp": "04:30",
      "end_timestamp": "04:43",
      "supports": [
        "clinical_actions[1]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "In the meantime, if you notice any wheeze or breathlessness, come in at once.",
      "start_timestamp": "04:52",
