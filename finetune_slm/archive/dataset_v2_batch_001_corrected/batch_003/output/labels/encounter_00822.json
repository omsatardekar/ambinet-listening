    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Penicillin. I came out in a rash.",
      "start_timestamp": "02:22",
      "end_timestamp": "02:26",
      "supports": [
