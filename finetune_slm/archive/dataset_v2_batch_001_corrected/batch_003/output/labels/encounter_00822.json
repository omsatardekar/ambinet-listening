        "medications[1]",
        "medications[2]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Omeprazole, 20 mg, every morning. Amlodipine, 5 mg. And a statin, simvastatin, 20 mg, at night.",
      "start_timestamp": "02:08",
      "end_timestamp": "02:17",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any allergies?",
